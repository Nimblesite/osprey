// The GPUI probe's C boundary, exported as `osprey_app_start` and
// `osprey_app_dispatch` ([GPUI-HOST-BOUNDARY]). Strings the host passes in
// are borrowed for the call; `native_slice` answers host-held slices.
namespace app

import ui::Runtime
import probe::App

extern native_slice (key : string) -> string

start source =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::start (source, App::initial, App::regions, App::save, App::theme ())

dispatch (saved, event) =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::dispatch (saved, event, App::update, App::regions, App::save, App::restore)
