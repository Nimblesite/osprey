// Plan 0036 phase 1 step 5: the per-frame cost of the framework on its own,
// without a host. A flock of `count` birds moves once per frame event; every
// dispatch parses the session, runs `update`, re-encodes the store and emits
// a scene of `count` sprites. `mode` selects what the run times: 0 starts
// only, 1 dispatches `frames` frames, 2 parses the start envelope `frames`
// times (the share the host's decoder would pay, not Osprey), 3 runs `frames`
// frames of a resident session whose sprites stream ([UI-RESIDENT],
// [UI-SCENE-STREAM]): no store round trip and no scene JSON.
namespace bench

import ui::Ui
import ui::Doc
import ui::Keyed
import ui::Runtime
import ui::Messages
import ui::Scenes

type Bird =
    bx : float
    by : float
    vx : float
    vy : float

type Flock =
    birds : List<Bird>
    frame : int

type Store =
    flock : Flock

type Act = Play

count = 5000

frames = 120

mode = 3

white () = Scenes::rgb (255, 255, 255)

// A grid of 100 columns; saturating integer arithmetic raises no effect.
bird i = Bird(bx = toFloat (satSub i (satMul (intDiv i 100) 100)) * 3.2, by = toFloat (intDiv i 100) * 4.0, vx = 1.0, vy = 0.5)

wrap (value, limit) = match value > limit
    true => value - limit
    false => value

move (b, elapsed) = Bird(bx = wrap (b.bx + b.vx * elapsed * 60.0, 320.0), by = wrap (b.by + b.vy * elapsed * 60.0, 200.0), vx = b.vx, vy = b.vy)

flockSlice () = perform Signal<Flock>.read ()

frameJson value = JsonInt value.frame

fieldView () = Ui::zoomed (0.0, 320.0, 200.0, ["bird"], mapList ((flockSlice ()).birds, \b => Scenes::sprite (0, b.bx, b.by, 2.0, 2.0, atan2 b.vy b.vx, white (), 0)), Play)

regions (before, store, frames, _) =
    handle static Signal<Flock>
        read => store.flock
    changed = signalChanges before.flock store.flock frameJson (signalDependencies flockSlice)
    [Keyed::region (frames, "field", changed, fieldView)]

init _ = Runtime::step (Store(flock = Flock(birds = range (0, count) |> fold [] (\(out, i) => listAppend out (bird i)), frame = 0)))

advanced (store, elapsed) = Runtime::step (Store(flock = Flock(birds = mapList (store.flock.birds, \b => move (b, elapsed)), frame = satAdd store.flock.frame 1)))

update (_, store, message) = Messages::route (message, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \elapsed => advanced (store, elapsed), \(_, _) => Runtime::step store)

birdJson b = JsonArray [JsonFloat b.bx, JsonFloat b.by, JsonFloat b.vx, JsonFloat b.vy]

save store = JsonObject [JsonMember "birds" (JsonArray (mapList (store.flock.birds, \b => birdJson b))), Doc::num ("frame", store.flock.frame)]

at (item, index) = jsonFloat (jsonIndex item index ?: JsonNull) ?: 0.0

restore doc = Store(flock = Flock(birds = mapList (Doc::items (Doc::field (doc, "birds")), \item => Bird(bx = at (item, 0), by = at (item, 1), vx = at (item, 2), vy = at (item, 3))), frame = Doc::number (doc, "frame")))

theme = ui::Theme(tokens = [], spacing = [4, 8], feedback = 120, settle = 220)

frameEvent = "{\"kind\":\"frame\",\"now\":2,\"elapsed\":0.0083}"

stateOf text = Doc::text (Doc::parse text, "state")

tick saved = stateOf (Runtime::dispatch (saved, frameEvent, update, regions, save, restore))

// The stream's answer in this bench: a count of the sprites the host would have received.
mut streamed = 0

proceeded (session, _) = (Runtime::proceed (session, frameEvent, update, regions)).residentSession

resident () =
    handle ui::SceneStream
        shape _ => streamed := satAdd streamed 1
    first = Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\"}", init, regions, theme)
    last = range (0, frames) |> fold first.residentSession proceeded
    satAdd (length last.sessionStore.flock.birds) streamed

run (started, which) = match which
    3 => resident ()
    1 => length (range (0, frames) |> fold (stateOf started) (\(saved, _) => tick saved))
    2 => range (0, frames) |> fold 0 (\(total, _) => satAdd total (length (Doc::text (Doc::parse started, "state"))))
    _ => length (stateOf started)

main () =
    started = Runtime::start ("{\"now\":1,\"offset\":0,\"platform\":\"macos\"}", init, regions, save, theme)
    print "mode ${mode} frames ${frames} birds ${count} envelope ${length started} bytes result ${run (started, mode)}"
    0
