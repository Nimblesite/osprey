// @osprey/uitest end to end ([UI-MACHINE-CANVAS], [UI-MACHINE-EACH],
// [UI-MACHINE-MENU], [UI-MACHINE-A11Y], [UI-MACHINE-TEST]): a real machine
// document driven without an application, session, host or window.

import ui::Canvases
import ui::Doc
import ui::MachineDocs
import ui::Machines
import ui::Runtime
import ui::Templates
import ui::Values
import uitest::Events
import uitest::Read
import uitest::Semantics
import uitest::Views

loaded work = match MachineDocs::load (readFile "packages/uitest/tests/fixture.machine.json" ?: "")
    Success machine => work machine
    Error problem => expect ("fixture loads: ${problem}", "fixture loads")

withFixture work = Runtime::guarded (\() => loaded work)

seen machine = Read::tree (Runtime::tree (Templates::view machine))

labels machine = Semantics::labels (Canvases::semantics machine)

element (machine, label) = Semantics::element (Canvases::semantics machine, label)

offered (machine, label) = Semantics::offered (Canvases::semantics machine, label)

role (machine, label) = Semantics::role (Canvases::semantics machine, label)

value machine = Semantics::value (Canvases::semantics machine, "Level")

letters (machine, text) = Views::letters (seen machine, text)

feed (machine, name, text) = Machines::feed (machine, [Machines::fact (name, Values::text text)])

releasedAt (machine, label, fraction) =
    p = Semantics::point (element (machine, label), fraction)
    Canvases::released (machine, p.pointX, p.pointY)

// An event as the host's wire carries it, for checking the encoder's contract.
wire event = Doc::parse event

test ("the canvas use case: accessible controls, geometry, sliders, repeated menus, dismissal and live lettering", \() => withFixture (\fresh =>
    expect (labels fresh, "Menu|Press|Level")
    expect (offered (fresh, "Menu"), true)
    expect (offered (fresh, "Dismiss"), false)
    expect (role (fresh, "Menu"), "popup")
    expect (role (fresh, "Press"), "button")
    expect (role (fresh, "Level"), "slider")
    expect (role (fresh, "Missing"), "none")
    expect (value fresh, 0.25)
    expect (letters (fresh, "Hello"), true)
    slider = element (fresh, "Level")
    start = Semantics::point (slider, 0.0)
    middle = Semantics::point (slider, 0.5)
    end = Semantics::point (slider, 1.0)
    expect (start.pointX, 20.0)
    expect (start.pointY, 315.0)
    expect (middle.pointX, 120.0)
    expect (middle.pointY, 315.0)
    expect (end.pointX, 220.0)
    expect (end.pointY, 315.0)
    pressed = Canvases::act (fresh, "Press", 0.5)
    expect (letters (pressed, "Pressed"), true)
    expect (letters (pressed, "Hello"), false)
    zero = Canvases::act (pressed, "Level", 0.0)
    expect (value zero, 0.0)
    half = Canvases::act (zero, "Level", 0.5)
    expect (value half, 0.5)
    full = Canvases::act (half, "Level", 1.0)
    expect (value full, 1.0)
    released = releasedAt (full, "Level", 0.75)
    expect (value released, 0.75)
    opened = Canvases::act (released, "Menu", 0.5)
    expect (labels opened, "One|Two|Three|Menu|Press|Level")
    expect (offered (opened, "Dismiss"), false)
    expect (role (opened, "One"), "menuitem")
    expect (letters (opened, "One"), true)
    expect (letters (opened, "Two"), true)
    expect (letters (opened, "Three"), true)
    dismissed = Canvases::released (opened, 5.0, 5.0)
    expect (labels dismissed, "Menu|Press|Level")
    reopened = Canvases::act (dismissed, "Menu", 0.5)
    chosen = Canvases::act (reopened, "Two", 0.5)
    expect (labels chosen, "Menu|Press|Level")
    expect (letters (chosen, "Choice two"), true)
    updated = feed (chosen, "caption", "Updated")
    expect (letters (updated, "Updated"), true)
    expect (letters (updated, "Pressed"), false)
    again = feed (updated, "caption", "Second input")
    expect (letters (again, "Second input"), true)
    expect (letters (again, "Updated"), false)
    expect (value again, 0.75)))

test ("native views are found by what they say, and every host event keeps its wire contract", \() => withFixture (\fresh =>
    native = Machines::feed (fresh, [Machines::fact ("skin", Values::text "plain"), Machines::fact ("caption", Values::text "Native"), Machines::fact ("selected", Values::text "two")])
    shown = seen native
    expect (length shown.renderedControls > 1, true)
    expect (length (Views::labelled (shown, "Native")), 1)
    expect (Views::shows (shown, "Native action"), true)
    expect ((Views::control (shown, "Native action")).controlKind, "button")
    expect ((Views::control (shown, "Missing")).controlKind, "")
    expect (Views::shows (shown, "Missing"), false)
    expect (Views::texts shown, "Native|Native action|two")
    expect (Views::lettered shown, "")
    asked = Read::envelope (Read::blank (), "{\"requests\":[{\"kind\":\"run\"},{\"kind\":\"animate\"}]}")
    expect (Views::requested (asked, "run"), true)
    expect (Views::requested (asked, "animate"), true)
    expect (Views::requested (asked, "choose-file"), false)
    expect (asked.renderedRevision, 0)
    press = wire (Events::press (4, 2, 10))
    expect (Doc::text (press, "kind"), "ui")
    expect (Doc::text (press, "region"), "root")
    expect (Doc::number (press, "revision"), 4)
    expect (Doc::number (press, "ordinal"), 2)
    expect (Doc::kind (Doc::field (press, "value")), "null")
    expect (Doc::number (press, "now"), 10)
    choose = wire (Events::choose (5, 3, "two \"quoted\"", 11))
    expect (Doc::text (choose, "value"), "two \"quoted\"")
    pointer = Doc::field (wire (Events::pointer (6, 4, 12.5, 20.0, true, 12)), "value")
    expect (Doc::decimal (pointer, "x"), 12.5)
    expect (Doc::decimal (pointer, "y"), 20.0)
    expect (Doc::flag (pointer, "down"), true)
    chosen = wire (Events::chosen ("choose", "/music/a \"b\".mp3", 13))
    expect (Doc::text (chosen, "kind"), "completed")
    expect (Doc::text (chosen, "ticket"), "choose")
    expect (Doc::flag (chosen, "ok"), true)
    expect (Doc::text (Doc::field (chosen, "result"), "path"), "/music/a \"b\".mp3")
    expect (Doc::flag (Doc::field (wire (Events::cancelled ("choose", 14)), "result"), "cancelled"), true)
    ran = Doc::field (wire (Events::ran ("discover", 2, "no route", 15)), "result")
    expect (Doc::number (ran, "status"), 2)
    expect (Doc::text (ran, "stderr"), "no route")
    expect (Doc::decimal (wire (Events::frame (0.25, 16)), "elapsed"), 0.25)
    expect (Doc::text (wire (Events::lifecycle ("resume", 17)), "phase"), "resume")
    expect (Doc::text (wire (Events::open ("/tmp/example.mp3", 18)), "phase"), "open:/tmp/example.mp3")))

test ("a broken document is refused with every problem named by its path", \() => Runtime::guarded (\() =>
    refused = match MachineDocs::load "not json"
        Success _ => "loaded"
        Error problem => problem
    expect (refused, "the machine document is not JSON")
    broken = "{\"schema\":2,\"inputs\":{\"a\":{\"type\":\"colour\"},\"b\":{\"type\":\"number\",\"value\":\"x\"}},\"layers\":[{\"name\":\"l\",\"initial\":\"gone\",\"states\":{\"s\":{}},\"transitions\":[{\"from\":\"q\",\"to\":\"s\"}]}],\"view\":{\"kind\":\"button\",\"colour\":\"red\",\"on\":{\"fire\":\"nope\"},\"children\":[{\"kind\":\"widget\"}]}}"
    expect (join (MachineDocs::problems (Doc::parse broken)) "\n", join ["schema: expected 1", "inputs.a.type: expected one of bool, number, text, trigger, list", "inputs.b.value: not a number", "layers[0].initial: no state named \"gone\"", "layers[0].transitions[0].from: no state named \"q\"", "view.colour: not a member of button", "view.on: no input named \"nope\"", "view.children[0].kind: no node kind \"widget\""] "\n")
    faulty = MachineDocs::faulty "boom"
    expect (faulty.machineFault, "boom")
    expect (Views::texts (seen faulty), "This interface could not load")))
