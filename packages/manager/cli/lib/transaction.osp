namespace registry_cli;
import registry_host::Host
import registry_cli::Reports
import registry_cli::Project
import registry_cli::Overlay
import registry_cli::Lock

/// One atomic file-and-lock update, the shape of `add`, `remove`,
/// `update --breaking` and `use` ([PACKAGE-API], [PACKAGE-LOCAL-OVERRIDE]):
/// the new text of the manifest or the overlay is written, `lock` recomputes
/// the lock from it, and when the lock fails (which writes nothing) the
/// previous text is written back, so either both files change or neither does.
module Transaction {
    /// Where and how to relock: registry, project, the vanished-release
    /// policy, whether the current lock's choices are sticky (`fresh` drops
    /// them so `update` moves to the newest releases), and whether the
    /// development lock is the target (`local`).
    export type Settings = { base: string, project: string, acceptRemovals: bool, fresh: bool, local: bool }

    let failStatus = 1
    let restoreCode = "transaction.restore"

    // `Report` shares `status` and `lines`; issue #273 needs typed receivers.
    fn statusOf(r: Reports::Report) = r.status
    fn linesOf(r: Reports::Report) = r.lines
    fn projectOf(s: Settings) = s.project

    fn failed(lines) = Reports::Report { status: failStatus, lines: lines }

    /// Relock without touching any file; `update` without `--breaking`.
    export fn relock(s: Settings) = Lock::relock(s.base, s.project, s.fresh, s.acceptRemovals, s.local)

    fn restored(path, previous, locked) = match perform Host::Files.write(path, previous) {
        Error { message } => failed(listAppend(linesOf(locked), "${restoreCode} ${message}"))
        Success => locked
    }

    fn relocked(s, path, previous, prefix) = {
        let locked = relock(s)
        if statusOf(locked) == 0 { Reports::success(listConcat(prefix, linesOf(locked))) } else { restored(path, previous, locked) }
    }

    fn commitAt(s, path, previous, text, prefix) = match perform Host::Files.write(path, text) {
        Error { message } => failed([message])
        Success => relocked(s, path, previous, prefix)
    }

    /// Write `text` as the manifest and relock; on success `prefix` heads the
    /// lock's delta lines, on failure `previous` is written back and the
    /// lock's refusal is the report.
    export fn commit(s, previous, text, prefix) = commitAt(s, Project::manifestPathAt(projectOf(s)), previous, text, prefix)

    /// The same for the overlay `osprey.local.toml` and the development lock.
    export fn commitOverlay(s, previous, text, prefix) = commitAt(s, Overlay::pathAt(projectOf(s)), previous, text, prefix)
}
