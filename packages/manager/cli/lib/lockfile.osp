namespace registry_cli;
import registry::Checked
import registry::Canonical
import registry::Digests
import registry::Identity
import registry::Json
import registry::JsonRead
import registry::ManifestModel
import registry::Names
import registry::Maybe
import registry::Order

/// The folder-lock document `osprey.lock` in format `0`: RFC 8785 canonical
/// JSON pinning the root's manifest digest and dependency edges plus every
/// selected release and its Runtime/Build edges, ordered by `ReleaseId`.
/// A folder registry cannot sign a `ReleaseLockfile` ([PACKAGE-FOLDER-REGISTRY]),
/// so this lock is integrity-only. The edge projection is byte-identical to
/// `ManifestJson` ([PACKAGE-MANIFEST]); the `ReleaseId` JSON is the
/// `package`/`epoch`/`ordinal`/`digest` record of
/// `schemas/package-registry.td`.
module Lockfile {
    /// The root's manifest digest and its dependency edges.
    export type Root = { manifestDigest: string, dependencies: List<ManifestModel::Edge> }
    /// One selected release, its Runtime/Build edges and its pinned capability
    /// surface ([PACKAGE-CAPABILITY-CONFINEMENT]), a canonical set.
    export type Package = { release: Identity::ReleaseId, dependencies: List<ManifestModel::Edge>, surface: List<string> }
    /// A key the development lock takes from a local checkout instead of the
    /// registry: its path, epoch and the digest of the local manifest the lock
    /// was computed from ([PACKAGE-LOCAL-OVERRIDE]).
    export type Override = { package: Names::Key, path: string, epoch: int, manifestDigest: string }
    /// The uv plane's pins ([PACKAGE-PYTHON-UV]): plain `sha256:` digests of
    /// the composed `.osprey/python/pyproject.toml` and its `uv.lock`,
    /// written under `root.python` only when the graph uses Python interop.
    export type PythonPins = { pyprojectDigest: string, uvLockDigest: string }
    /// A format-0 folder lock: the root's manifest pin plus every selected
    /// release; `overrides` is empty in `osprey.lock` and names the local keys
    /// of the development lock `osprey.local.lock`.
    export type Lock = { root: Root, packages: List<Package>, overrides: List<Override>, python: Maybe::Maybe<PythonPins> }

    /// A release lock: no overrides, no Python plane.
    export fn release(root, packages) = Lock { root: root, packages: packages, overrides: [], python: Maybe::none() }

    // `Override` shares `package` and `path`; issue #273 needs typed receivers.
    /// The checkout path of an override.
    export fn overridePathOf(o: Override) = o.path

    /// The override of `key` among `overrides`, if the lock takes it locally.
    export fn overrideFor(overrides, key) -> Result<Override, string> = foldList(overrides, Error { message: "none" }, fn(acc, o: Override) => match acc {
        Success => acc
        Error => if Names::same(o.package, key) { Success { value: o } } else { acc }
    })

    // `ReleaseId` shares `key`, `epoch`, `ordinal` and `digest` with other
    // records; issue #273 needs the receiver spelled out.
    /// `@scope/name e1.r2 sha256:…`: the release spelling of every line the
    /// lock-consuming commands print ([PACKAGE-FOLDER-REGISTRY]).
    export fn compact(id: Identity::ReleaseId) = "${Names::display(id.key)} e${id.epoch}.r${id.ordinal} ${id.digest}"

    /// The package no lock has: the `?:` fallback of package lookups.
    export fn blankPackage() = Package { release: Identity::blank(), dependencies: [], surface: [] }

    /// The package pinned for `key` among `packages`, if one is.
    export fn packageFor(packages, key) -> Result<Package, string> = foldList(packages, Error { message: "none" }, fn(acc, p: Package) => match acc {
        Success => acc
        Error => if Names::same(p.release.key, key) { Success { value: p } } else { acc }
    })

    let formatValue = 0
    let formatCode = "lock.format"
    let shapeCode = "lock.shape"
    let duplicateCode = "lock.duplicate-key"
    let orderCode = "lock.order"

    fn member(key, value) = Json::Member { key: key, value: value }
    fn str(text) = Json::Str { text: text }
    fn num(value) = Json::Num { value: value }
    fn obj(members) = Json::Obj { members: members }
    fn arr(items) = Json::Arr { items: items }

    // The edge/requirement/key projection matches `ManifestJson` member for
    // member; the canonical serializer sorts members, so spelling order below
    // is irrelevant to the bytes.
    fn keyJson(k: Names::Key) = obj([member("name", str(k.name)), member("scope", str(k.scope))])

    fn requirementJson(r) = obj([
        member("epoch", num(r.epoch)),
        member("minimumOrdinal", num(r.minimumOrdinal)),
        member("package", keyJson(r.package))
    ])

    fn edgeJson(e) = match e {
        ManifestModel::Runtime { requirement } => obj([member("Runtime", obj([member("requirement", requirementJson(requirement))]))])
        ManifestModel::Build { requirement } => obj([member("Build", obj([member("requirement", requirementJson(requirement))]))])
        ManifestModel::Test { requirement } => obj([member("Test", obj([member("requirement", requirementJson(requirement))]))])
    }

    fn dependenciesJson(edges) = arr(mapList(edges, edgeJson))

    /// The RFC 8785 bytes of an edge list, for the lock and for comparing the
    /// lock's root edges against a manifest's. Implements [PACKAGE-MANIFEST].
    export fn dependenciesCanonical(edges) = Canonical::serialize(dependenciesJson(edges)) ?: ""

    fn releaseJson(id: Identity::ReleaseId) = obj([
        member("package", keyJson(id.key)),
        member("epoch", num(id.epoch)),
        member("ordinal", num(id.ordinal)),
        member("digest", str(id.digest))
    ])

    fn packageJson(p: Package) = obj([
        member("dependencies", dependenciesJson(p.dependencies)),
        member("release", releaseJson(p.release)),
        member("surface", arr(mapList(p.surface, str)))
    ])

    fn pinsJson(p: PythonPins) = obj([member("pyprojectDigest", str(p.pyprojectDigest)), member("uvLockDigest", str(p.uvLockDigest))])

    fn pythonMembers(python) = Maybe::fold(python, [], fn(p) => [member("python", pinsJson(p))])

    fn rootJson(root: Root, python) = obj(listConcat([
        member("dependencies", dependenciesJson(root.dependencies)),
        member("manifestDigest", str(root.manifestDigest))
    ], pythonMembers(python)))

    // `Package` shares `dependencies` with `Root` and `ManifestModel::Manifest`;
    // issue #273 needs the receiver spelled out.
    fn releaseOfPackage(p: Package) = p.release

    fn packageAt(packages, i) = listGet(packages, i) ?: blankPackage()

    fn packageRelease(packages, i) = releaseOfPackage(packageAt(packages, i))

    /// `packages` written sorted by `Identity::compare`.
    fn sortedPackages(packages) = mapList(
        Order::permutation(length(packages), fn(i, j) => Identity::compare(packageRelease(packages, i), packageRelease(packages, j))),
        fn(i) => packageAt(packages, i))

    fn blankOverride() = Override { package: Names::blank(), path: "", epoch: 0, manifestDigest: "" }
    fn overrideAt(overrides, i) -> Override = listGet(overrides, i) ?: blankOverride()
    fn overrideKey(o: Override) = o.package

    fn overrideJson(o: Override) = obj([
        member("epoch", num(o.epoch)),
        member("manifestDigest", str(o.manifestDigest)),
        member("package", keyJson(o.package)),
        member("path", str(o.path))
    ])

    fn sortedOverrides(overrides) = mapList(
        Order::permutation(length(overrides), fn(i, j) => Names::compare(overrideKey(overrideAt(overrides, i)), overrideKey(overrideAt(overrides, j)))),
        fn(i) => overrideAt(overrides, i))

    /// `overrides` is written only when the lock has any, so a release lock's
    /// bytes never carry the member.
    fn overridesMembers(lock: Lock) = if isEmpty(lock.overrides) { [] } else { [member("overrides", arr(mapList(sortedOverrides(lock.overrides), overrideJson)))] }

    fn encodeValue(lock: Lock) = obj(listConcat([
        member("format", num(formatValue)),
        member("packages", arr(mapList(sortedPackages(lock.packages), packageJson))),
        member("root", rootJson(lock.root, lock.python))
    ], overridesMembers(lock)))

    /// The RFC 8785 bytes of `lock`.
    export fn encode(lock) = Canonical::serialize(encodeValue(lock))

    fn textMember(object, key) = match JsonRead::field(object, key) {
        Json::Str { text } => Success { value: text }
        _ => Error { message: shapeCode }
    }

    fn intMember(object, key) = match JsonRead::field(object, key) {
        Json::Num { value } => Success { value: value }
        _ => Error { message: shapeCode }
    }

    fn objMember(object, key) = match JsonRead::field(object, key) {
        Json::Obj { members } => Success { value: Json::Obj { members: members } }
        _ => Error { message: shapeCode }
    }

    fn arrMember(object, key) = match JsonRead::field(object, key) {
        Json::Arr { items } => Success { value: items }
        _ => Error { message: shapeCode }
    }

    fn formatOf(root) = match JsonRead::field(root, "format") {
        Json::Num { value } => if value == formatValue { Success { value: 0 } } else { Error { message: formatCode } }
        _ => Error { message: formatCode }
    }

    fn readKey(object) = Checked::andThen(textMember(object, "scope"), fn(value) => readName(object, value))

    /// A key only when scope and name pass [PACKAGE-NAMES]; anything else is
    /// `lock.shape`, so no lock string reaches a filesystem path
    /// ([PACKAGE-HARDENING] C3).
    fn keyOf(scope, name) = if Names::scopeCode(scope) == "" && Names::nameCode(name) == "" {
        Success { value: Names::Key { scope: scope, name: name } }
    } else { Error { message: shapeCode } }

    fn readName(object, scope) = Checked::andThen(textMember(object, "name"), fn(value) => keyOf(scope, value))

    fn parsedDigest(text) = match Digests::parse(text) {
        Success { value } => Success { value: value }
        Error => Error { message: shapeCode }
    }

    /// A member that must be a well-formed `sha256:` envelope ([PACKAGE-HARDENING] C3).
    fn digestMember(object, key) = Checked::andThen(textMember(object, key), fn(value) => parsedDigest(value))

    fn readRelease(object) = Checked::andThen(objMember(object, "package"), fn(value) => readReleaseWithKey(object, readKey(value)))

    fn readReleaseWithKey(object, key) = Checked::andThen(key, fn(value) => readEpoch(object, value))

    fn readEpoch(object, key) = Checked::andThen(intMember(object, "epoch"), fn(value) => readOrdinal(object, key, value))

    fn readOrdinal(object, key, epoch) = Checked::andThen(intMember(object, "ordinal"), fn(value) => readDigest(object, key, epoch, value))

    fn readDigest(object, key, epoch, ordinal) = Checked::andThen(digestMember(object, "digest"), fn(value) => Success { value: Identity::ReleaseId { key: key, epoch: epoch, ordinal: ordinal, digest: value } })

    fn readRequirement(object) = Checked::andThen(objMember(object, "package"), fn(value) => readRequirementWithKey(object, readKey(value)))

    fn readRequirementWithKey(object, key) = Checked::andThen(key, fn(value) => readReqEpoch(object, value))

    fn readReqEpoch(object, key) = Checked::andThen(intMember(object, "epoch"), fn(value) => readReqFloor(object, key, value))

    fn readReqFloor(object, key, epoch) = Checked::andThen(intMember(object, "minimumOrdinal"), fn(value) => Success { value: ManifestModel::Requirement { package: key, epoch: epoch, minimumOrdinal: value } })

    // The variant is chosen by the union member key; any other name is `lock.shape`.
    fn readEdgeNamed(kind, requirement) = match kind {
        "Runtime" => Success { value: ManifestModel::Runtime { requirement: requirement } }
        "Build" => Success { value: ManifestModel::Build { requirement: requirement } }
        "Test" => Success { value: ManifestModel::Test { requirement: requirement } }
        _ => Error { message: shapeCode }
    }

    fn firstMember(object) = match object {
        Json::Obj { members } => listGet(members, 0) ?: Json::Member { key: "", value: Json::Null }
        _ => Json::Member { key: "", value: Json::Null }
    }

    // `Json::Member` shares `key`/`value` with other records; the member is
    // spelled out by `firstMember`.
    fn edgeOfValue(object) = {
        let m = firstMember(object)
        Checked::andThen(objMember(m.value, "requirement"), fn(value) => edgeFromRequirement(m, value))
    }

    fn edgeFromRequirement(m, reqObj) = Checked::andThen(readRequirement(reqObj), fn(value) => readEdgeNamed(m.key, value))

    // A recursive accumulator avoids `foldList` over a `Result<List<…>>`.
    fn edgesAt(items, i, acc) -> Result<List<ManifestModel::Edge>, string> = match i >= length(items) {
        true => Success { value: acc }
        false => Checked::andThen(edgeOfValue(listGet(items, i) ?: Json::Null), fn(value) => edgesAt(items, i + 1, listAppend(acc, value)))
    }

    fn edgesOf(object) = Checked::andThen(arrMember(object, "dependencies"), fn(value) => edgesAt(value, 0, []))

    fn readRoot(object) = Checked::andThen(digestMember(object, "manifestDigest"), fn(value) => readRootWithDeps(object, value))

    fn readRootWithDeps(object, digest) = Checked::andThen(edgesOf(object), fn(value) => Success { value: Root { manifestDigest: digest, dependencies: value } })

    fn packageOf(pkg) = Checked::andThen(objMember(pkg, "release"), fn(value) => packageWithRelease(pkg, readRelease(value)))

    fn packageWithRelease(pkg, release) = Checked::andThen(release, fn(value) => packageWithDeps(pkg, value))

    fn packageWithDeps(pkg, release) = Checked::andThen(edgesOf(pkg), fn(value) => packageWithSurface(pkg, release, value))

    fn textsOf(items) = foldList(items, Success { value: [] }, fn(acc, item) => match acc {
        Error => acc
        Success { value } => match item {
            Json::Str { text } => Success { value: listAppend(value, text) }
            _ => Error { message: shapeCode }
        }
    })

    /// A surface is a canonical set: sorted, distinct strings; anything else is `lock.shape`.
    fn canonicalSurface(texts) = match Order::canonicalSet(texts) {
        Success { value } => if join(value, "\n") == join(texts, "\n") { Success { value: texts } } else { Error { message: shapeCode } }
        Error => Error { message: shapeCode }
    }

    fn surfaceOf(pkg) = match arrMember(pkg, "surface") {
        Error { message } => Error { message: message }
        Success { value } => Checked::andThen(textsOf(value), fn(value) => canonicalSurface(value))
    }

    fn packageWithSurface(pkg, release, deps) = Checked::andThen(surfaceOf(pkg), fn(value) => Success { value: Package { release: release, dependencies: deps, surface: value } })

    fn packagesAt(items, i, acc) -> Result<List<Package>, string> = match i >= length(items) {
        true => Success { value: acc }
        false => Checked::andThen(packageOf(listGet(items, i) ?: Json::Null), fn(value) => packagesAt(items, i + 1, listAppend(acc, value)))
    }

    fn packageKeyText(p: Package) = Names::display(p.release.key)

    fn keysUnique(packages) = Order::strictlyAscending(listSort(mapList(packages, packageKeyText)))

    fn inOrder(packages) = fold(range(1, length(packages)), true, fn(ok, i) =>
        ok && Identity::compare(packageRelease(packages, i - 1), packageRelease(packages, i)) < 0)

    // ---- overrides of a development lock ----

    fn overridePath(object, key) = Checked::andThen(textMember(object, "path"), fn(value) => if value == "" { Error { message: shapeCode } } else { overrideEpoch(object, key, value) })

    fn overrideEpoch(object, key, path) = Checked::andThen(intMember(object, "epoch"), fn(value) => if value < 1 { Error { message: shapeCode } } else { overrideDigest(object, key, path, value) })

    fn overrideDigest(object, key, path, epoch) = Checked::andThen(digestMember(object, "manifestDigest"), fn(value) => Success { value: Override { package: key, path: path, epoch: epoch, manifestDigest: value } })

    fn overrideOf(object) = match objMember(object, "package") {
        Error { message } => Error { message: message }
        Success { value } => Checked::andThen(readKey(value), fn(value) => overridePath(object, value))
    }

    fn overridesAt(items, i, acc) -> Result<List<Override>, string> = match i >= length(items) {
        true => Success { value: acc }
        false => Checked::andThen(overrideOf(listGet(items, i) ?: Json::Null), fn(value) => overridesAt(items, i + 1, listAppend(acc, value)))
    }

    /// `overrides` is optional: absent means none; present, it is an array of
    /// well-formed overrides sorted by key.
    fn overridesOf(root) = {
        let value = JsonRead::field(root, "overrides")
        if Json::isNull(value) { Success { value: [] } } else { match value {
            Json::Arr { items } => overridesAt(items, 0, [])
            _ => Error { message: shapeCode }
        } }
    }

    fn overrideKeyText(o: Override) = Names::display(o.package)

    fn overridesOrdered(overrides) = Order::strictlyAscending(mapList(overrides, overrideKeyText))

    fn pinsWith(object, pyprojectDigest) = Checked::andThen(digestMember(object, "uvLockDigest"), fn(value) => Success { value: Maybe::some(PythonPins { pyprojectDigest: pyprojectDigest, uvLockDigest: value }) })

    /// `root.python` is optional: absent means no Python plane; present, it
    /// holds the two well-formed digests.
    fn pythonOf(rootValue) = {
        let value = JsonRead::field(rootValue, "python")
        if Json::isNull(value) { Success { value: Maybe::none() } } else { Checked::andThen(digestMember(value, "pyprojectDigest"), fn(value) => pinsWith(JsonRead::field(rootValue, "python"), value)) }
    }

    fn finish(packages, root, overrides, python) = if !keysUnique(packages) { Error { message: duplicateCode } }
        else if !inOrder(packages) { Error { message: orderCode } }
        else if !overridesOrdered(overrides) { Error { message: shapeCode } }
        else { Success { value: Lock { root: root, packages: packages, overrides: overrides, python: python } } }

    /// Strictly parse a folder-lock document; the first problem is one of
    /// `lock.format`, `lock.shape`, `lock.duplicate-key` or `lock.order`.
    export fn decode(text) = match Json::parse(text) {
        Error => Error { message: shapeCode }
        Success { value } => decodeValue(value)
    }

    fn decodeValue(root) = match formatOf(root) {
        Error { message } => Error { message: message }
        Success => decodePackages(root)
    }

    fn decodePackages(root) = Checked::andThen(arrMember(root, "packages"), fn(value) => decodePackageItems(root, value))

    fn decodePackageItems(root, items) = Checked::andThen(packagesAt(items, 0, []), fn(value) => decodeRoot(root, value))

    fn decodeRoot(root, packages) = Checked::andThen(objMember(root, "root"), fn(value) => decodeRootValue(root, packages, value))

    fn decodeRootValue(document, packages, rootValue) = Checked::andThen(readRoot(rootValue), fn(value) => withPython(document, packages, value, rootValue))

    fn withPython(document, packages, root, rootValue) = Checked::andThen(pythonOf(rootValue), fn(value) => withOverrides(document, packages, root, value))

    fn withOverrides(document, packages, root, python) = Checked::andThen(overridesOf(document), fn(value) => finish(packages, root, value, python))
}
