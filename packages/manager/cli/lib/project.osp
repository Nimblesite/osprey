namespace registry_cli;
import registry_host::Host
import registry_cli::Fetch
import registry_cli::Lockfile
import registry::Manifest

/// The local project files a command consumes: `./osprey.toml` through
/// `Manifest::parse` and `./osprey.lock` through `Lockfile::decode`. Every
/// failure is a string a report can print as-is (the OS reason, or
/// `Manifest::describe` of a rejected manifest). Implements the client side
/// of [PACKAGE-FOLDER-REGISTRY] and the manifest rule of [PACKAGE-MANIFEST].
module Project {
    let manifestPath = "osprey.toml"
    let lockPath = "osprey.lock"
    let localLockPath = "osprey.local.lock"

    /// `dir`-relative path; the cwd spellings "" and "." keep the bare name so
    /// fixture handlers that answer the bare paths keep matching.
    export fn pathAt(dir, name) = if isEmpty(dir) || dir == "." { name } else { "${dir}/${name}" }

    /// The path of the folder lock at `dir`; `lock` writes it, the others read it.
    export fn lockPathAt(dir) = pathAt(dir, lockPath)

    /// The path of the development lock at `dir`; `lock --local` writes it.
    export fn localLockPathAt(dir) = pathAt(dir, localLockPath)

    /// A local checkout named by an overlay, relative to `dir`.
    export fn localDirAt(dir, path) = pathAt(dir, path)

    /// The decoded development lock at `dir`, or the OS reason / its first rejection code.
    export fn readLocalLockAt(dir) = match perform Host::Files.read(localLockPathAt(dir)) {
        Error { message } => Error { message: message }
        Success { value } => Lockfile::decode(value)
    }

    // `Package.release` and `Override.path` are shared names; typed receivers (issue #273).
    /// Where a locked package's tree lives: the local checkout when the lock
    /// overrides its key, else its installed directory ([PACKAGE-LOCAL-OVERRIDE]).
    export fn treeDirAt(project, lock: Lockfile::Lock, pkg: Lockfile::Package) = match Lockfile::overrideFor(lock.overrides, pkg.release.key) {
        Success { value } => localDirAt(project, value.path)
        Error => Fetch::installDirAt(project, pkg.release)
    }

    /// The path of the manifest at `dir`; `add`, `remove` and `update` rewrite it.
    export fn manifestPathAt(dir) = pathAt(dir, manifestPath)

    /// The manifest text at `dir`, or the OS reason.
    export fn manifestTextAt(dir) = perform Host::Files.read(manifestPathAt(dir))

    /// The parsed manifest at `dir`, or the OS reason / `Manifest::describe(problem)`.
    export fn readAt(dir) = match manifestTextAt(dir) {
        Error { message } => Error { message: message }
        Success { value } => Manifest::accepted(Manifest::parse(value))
    }

    /// The decoded folder lock at `dir`, or the OS reason / its first rejection code.
    export fn readLockAt(dir) = match perform Host::Files.read(lockPathAt(dir)) {
        Error { message } => Error { message: message }
        Success { value } => Lockfile::decode(value)
    }

    /// The parsed manifest, or the OS reason / `Manifest::describe(problem)`.
    export fn read() = readAt("")

    /// The decoded folder lock, or the OS reason / its first rejection code.
    export fn readLock() = readLockAt("")
}
