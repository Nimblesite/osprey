namespace registry_tests;
import registry_cli::Fetch
import registry_cli::Lockfile
import registry_cli::PythonPlane
import registry_tests::Fixture
import registry_tests::RegistryFixture
import registry::Digests

/// The uv plane ([PACKAGE-PYTHON-UV]) against the fixture registry with a
/// fixture `uv`: a release declaring `python/interop` makes `lock` compose
/// `.osprey/python/pyproject.toml` with that release as a path dependency,
/// run `uv lock` and pin both digests under `root.python`; target-less
/// `fetch` runs `uv sync --frozen`; `verify --offline` regenerates the
/// project, compares both digests, runs `uv lock --check --offline` and
/// requires the environment; a graph without the plane never touches uv.
/// The Python plane rules P1–P3 of [PACKAGE-HARDENING] are asserted at the
/// `lock` gate: the generated project, a member's indexes and sources, and
/// the hashes of `uv.lock`.
module PythonTests {
    let project = "/abs"
    let pythonDir = "/abs/.osprey/python"
    let numpyHead = "[[package]]\nname = \"numpy\"\nversion = \"2.2.0\"\nsource = { registry = \"https://pypi.org/simple\" }\nsdist = { url = \"https://files.pythonhosted.org/numpy-2.2.0.tar.gz\", hash = \"sha256:aa\", size = 1 }\nwheels = [\n"
    let hashedWheel = "    { url = \"https://files.pythonhosted.org/numpy-2.2.0-py3-none-any.whl\", hash = \"sha256:bb\", size = 1 },\n]\n"
    let bareWheel = "    { url = \"https://files.pythonhosted.org/numpy-2.2.0-py3-none-any.whl\", size = 1 },\n]\n"

    /// What `uv lock` leaves behind: the member by directory, numpy from the index with hashes.
    fn uvLockOf(wheel) = "version = 1\nrevision = 2\nrequires-python = \">=3.12\"\n\n[[package]]\nname = \"demo-py\"\nversion = \"0.1.0\"\nsource = { directory = \"${pyPath()}\" }\ndependencies = [\n    { name = \"numpy\" },\n]\n\n[package.metadata]\nrequires-dist = [{ name = \"numpy\" }]\n\n" + numpyHead + wheel

    fn uvLockText() = uvLockOf(hashedWheel)

    fn pyManifest() = RegistryFixture::manifestText("py") + "\n[system.python]\ncapability = \"python/interop\"\nmin_revision = 31200\n"

    fn pyproject() = "[project]\nname = \"demo-py\"\nversion = \"0.1.0\"\nrequires-python = \">=3.12\"\ndependencies = [\"numpy\"]\n"

    /// The release ships its own `pyproject.toml` and `uv.lock` as ordinary tree entries.
    fn pyWith(pyprojectText) = Fixture::served("@demo/py/1.1", [
        Fixture::file("osprey.toml", pyManifest()),
        Fixture::file("src/py.osp", "fn add(a, b) = a + b\n"),
        Fixture::file("pyproject.toml", pyprojectText),
        Fixture::file("uv.lock", "version = 1\nrevision = 2\n")
    ])

    fn py() = pyWith(pyproject())

    fn rootText() = RegistryFixture::manifestText("app") + "\n[dependencies]\n\"@demo/py\" = { epoch = 1, min_release = 1 }\n"

    fn pathOf(served) = "../packages/@demo/py/${Digests::hexOf(Fixture::digestOf(served))}"

    fn pyPath() = pathOf(py())

    /// The composed project: one path dependency on the release, the declared
    /// floor, no index and `first-index` (P1).
    fn expectedPyproject() = "[project]\nname = \"osprey-python\"\nversion = \"0.0.0\"\nrequires-python = \">=3.12\"\ndependencies = [\"demo-py\"]\n\n[tool.uv]\nindex-strategy = \"first-index\"\n\n[tool.uv.sources]\ndemo-py = { path = \"${pyPath()}\" }\n"

    fn composesVersion(floor, version) = contains(PythonPlane::compose([PythonPlane::Member { name: "demo-py", path: "./demo", floor: floor }]), "requires-python = \">=${version}\"\n")

    fn floorComposition() = checkAll("Python version floors use integer components", [
        composesVersion(31200, "3.12"),
        composesVersion(31307, "3.13.7"),
        composesVersion(10000, "1.0")
    ])

    fn pins() = Lockfile::PythonPins { pyprojectDigest: PythonPlane::digestOf(expectedPyproject()), uvLockDigest: PythonPlane::digestOf(uvLockText()) }

    fn pyPackage() = RegistryFixture::pkgWith(py(), [], ["python/interop"])

    fn expectedLock() = RegistryFixture::pythonLockText(rootText(), [pyPackage()], pins())

    fn uvLockRead(text) = Fixture::readRoute("${pythonDir}/uv.lock", text)

    /// `lock` over one served release whose `uv lock` leaves `uvLock` behind.
    fn lockOver(served, uvLock) = RegistryFixture::runWith(listAppend(RegistryFixture::reads(rootText(), [served]), uvLockRead(uvLock)), [], RegistryFixture::websOf([served]), ["lock", "--project", project])

    fn bar(xs) = join(xs, " | ")

    /// What a run wrote and said, for a failing check's label.
    fn pyprojectPath() = "${pythonDir}/pyproject.toml"

    fn observed(a) = "pyproject<<${RegistryFixture::writtenTo(a, pyprojectPath())}>> lock<<${RegistryFixture::writtenTo(a, RegistryFixture::lockPath)}>> ran<<${bar(RegistryFixture::ranOf(a))}>> lines<<${bar(RegistryFixture::linesOf(a))}>>"

    /// `lock` composes the project, runs `uv lock` and pins both digests.
    fn lockPins() = {
        let a = lockOver(py(), uvLockText())
        checkAll("lock composes the uv project and pins both digests: ${observed(a)} expectedPyproject<<${expectedPyproject()}>> expectedLock<<${expectedLock()}>>", [
            RegistryFixture::statusOf(a) == 0,
            RegistryFixture::writtenTo(a, "${pythonDir}/pyproject.toml") == expectedPyproject(),
            RegistryFixture::writtenTo(a, RegistryFixture::lockPath) == expectedLock(),
            structuralEquals(RegistryFixture::ranOf(a), ["cd '${pythonDir}' && uv lock"]),
            RegistryFixture::lineOf(a, 0) == "+ ${RegistryFixture::compact(py())}",
            RegistryFixture::lineOf(a, 1) == "python: locked ${pythonDir}"
        ])
    }

    fn indexed() = pyWith(pyproject() + "\n[[tool.uv.index]]\nname = \"mirror\"\nurl = \"https://mirror.example/simple\"\n")

    fn gitSourced() = pyWith(pyproject() + "\n[tool.uv.sources]\nnumpy = { git = \"https://example.com/numpy\" }\n")

    fn climbing() = pyWith(pyproject() + "\n[tool.uv.sources]\nnumpy = { path = \"../../elsewhere\" }\n")

    /// P2: a member naming an index or an outside source stops `lock` before uv runs.
    fn forbiddenMembers() = {
        let index = lockOver(indexed(), uvLockText())
        let git = lockOver(gitSourced(), uvLockText())
        let climb = lockOver(climbing(), uvLockText())
        checkAll("python.index-forbidden and python.source-forbidden name the member and run no uv", [
            RegistryFixture::statusOf(index) == 1,
            RegistryFixture::lineOf(index, 0) == "python.index-forbidden ${pathOf(indexed())}",
            RegistryFixture::statusOf(git) == 1,
            RegistryFixture::lineOf(git, 0) == "python.source-forbidden ${pathOf(gitSourced())}",
            RegistryFixture::statusOf(climb) == 1,
            RegistryFixture::lineOf(climb, 0) == "python.source-forbidden ${pathOf(climbing())}",
            isEmpty(RegistryFixture::ranOf(index)),
            RegistryFixture::writesTo(index, RegistryFixture::lockPath) == 0
        ])
    }

    /// P3: a `uv.lock` with a hashless wheel is refused and no folder lock is written.
    fn unhashedLock() = {
        let a = lockOver(py(), uvLockOf(bareWheel))
        checkAll("python.uv-lock-hashes refuses the lock", [
            RegistryFixture::statusOf(a) == 1,
            RegistryFixture::lineOf(a, 0) == "python.uv-lock-hashes",
            RegistryFixture::writesTo(a, RegistryFixture::lockPath) == 0
        ])
    }

    /// A graph without the plane never writes a project or runs uv.
    fn noPlane() = {
        let served = [RegistryFixture::one(), RegistryFixture::two()]
        let a = RegistryFixture::runWith(RegistryFixture::reads(RegistryFixture::rootManifest(1), served), [], RegistryFixture::websOf(served), ["lock", "--project", project])
        checkAll("without python/interop uv is never run", [
            RegistryFixture::statusOf(a) == 0,
            RegistryFixture::writesTo(a, "${pythonDir}/pyproject.toml") == 0,
            isEmpty(RegistryFixture::ranOf(a)),
            RegistryFixture::writtenTo(a, RegistryFixture::lockPath) == RegistryFixture::expectedLock(RegistryFixture::rootManifest(1), RegistryFixture::one(), RegistryFixture::two())
        ])
    }

    fn installedDir() = "${project}/${Fetch::installDir(Fixture::idOf(py()))}"

    fn installedReads() = mapList(Fixture::filesOf(py()), fn(f) => Fixture::readRoute("${installedDir()}/${f.relPath}", f.content))

    fn installedWalk() = Fixture::walkRoute(installedDir(), mapList(Fixture::filesOf(py()), fn(f) => f.relPath))

    fn venvWalk() = Fixture::walkRoute("${pythonDir}/.venv", ["pyvenv.cfg"])

    fn planeReads(projectText, uvLock) = listConcat([Fixture::readRoute(RegistryFixture::manifestPath, rootText()), Fixture::readRoute(RegistryFixture::lockPath, expectedLock()), Fixture::readRoute(pyprojectPath(), projectText), uvLockRead(uvLock)], installedReads())

    fn verifyReads(uvLock) = planeReads(expectedPyproject(), uvLock)

    fn tamperedInput(command, projectText, uvLock, code) = {
        let a = RegistryFixture::runWith(planeReads(projectText, uvLock), [installedWalk(), venvWalk()], [], [command, "--project", project])
        checkAll("${command} rejects ${code} before running uv: ${observed(a)}", [
            RegistryFixture::statusOf(a) == 1,
            listContains(RegistryFixture::linesOf(a), code),
            isEmpty(RegistryFixture::ranOf(a))
        ])
    }

    fn tamperedInputs() = forEachList(["fetch", "verify"], fn(command) => {
        tamperedInput(command, "# edited\n", uvLockText(), PythonPlane::workspaceDigest)
        tamperedInput(command, expectedPyproject(), "# edited\n", PythonPlane::uvLockStale)
    })

    /// `verify --offline` regenerates, compares, checks the environment and runs the offline check.
    fn verifyClean() = {
        let a = RegistryFixture::runWith(verifyReads(uvLockText()), [installedWalk(), venvWalk()], [], ["verify", "--offline", "--project", project])
        checkAll("a pinned plane verifies with one offline uv check: ${observed(a)}", [
            RegistryFixture::statusOf(a) == 0,
            RegistryFixture::lineOf(a, 0) == "verified 1 packages",
            structuralEquals(RegistryFixture::ranOf(a), ["cd '${pythonDir}' && uv lock --check --offline"])
        ])
    }

    /// A changed `uv.lock` and a missing environment are their codes.
    fn verifyFindings() = {
        let stale = RegistryFixture::runWith(verifyReads("# edited\n"), [installedWalk(), venvWalk()], [], ["verify", "--offline", "--project", project])
        let noEnv = RegistryFixture::runWith(verifyReads(uvLockText()), [installedWalk()], [], ["verify", "--offline", "--project", project])
        checkAll("python.uv-lock-stale and python.environment-missing: stale ${observed(stale)} noEnv ${observed(noEnv)}", [
            RegistryFixture::statusOf(stale) == 1,
            RegistryFixture::lineOf(stale, 0) == "python.uv-lock-stale",
            isEmpty(RegistryFixture::ranOf(stale)),
            RegistryFixture::statusOf(noEnv) == 1,
            RegistryFixture::lineOf(noEnv, 0) == "python.environment-missing"
        ])
    }

    /// Target-less `fetch` syncs the environment after installing.
    fn fetchSyncs() = {
        let a = RegistryFixture::runWith(verifyReads(uvLockText()), [installedWalk()], [], ["fetch", "--project", project])
        checkAll("fetch runs uv sync --frozen once the trees are present", [
            RegistryFixture::statusOf(a) == 0,
            RegistryFixture::lineOf(a, 0) == "= ${RegistryFixture::compact(py())}",
            RegistryFixture::lineOf(a, 1) == "python: synced ${pythonDir}",
            structuralEquals(RegistryFixture::ranOf(a), ["cd '${pythonDir}' && uv sync --frozen"])
        ])
    }

    /// Every Python-plane test.
    export fn run() = {
        test("python: version floor components", floorComposition)
        test("python: lock composes and pins the uv project", lockPins)
        test("python: forbidden indexes and sources", forbiddenMembers)
        test("python: unhashed uv.lock", unhashedLock)
        test("python: no plane, no uv", noPlane)
        test("python: verify a pinned plane", verifyClean)
        test("python: verify findings", verifyFindings)
        test("python: fetch syncs", fetchSyncs)
        test("python: tampered generated inputs never run uv", tamperedInputs)
    }
}
