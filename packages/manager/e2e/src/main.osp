namespace registry_e2e;
import registry::Policy
import registry_host::Native
import registry_e2e::Probes

/// The end-to-end demo of plan 0020 Milestone 0, run by `make -C packages registry-test`
/// after the suites: start the Osprey server over the sample registry on a
/// loopback port, request every endpoint over HTTP, fetch the packages with
/// the client, build a consumer project against them, and stop the server.
/// All IO runs in one native session; assertions run on what it observed.
/// Implements the exit criterion of [PACKAGE-FOLDER-REGISTRY].
fn observed() = Native::session(Probes::observe)

fn stage() = {
    forEachList(observed(), fn(p) => test(p.label, fn() => check(p.label, p.expected, p.actual)))
    0
}

fn main() = Policy::guarded(stage)
