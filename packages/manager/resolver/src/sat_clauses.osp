namespace registry;
import registry::Order

/// Literal and clause algebra of the propositional engine under
/// [PACKAGE-RESOLUTION]. A variable is an int in 1..n; a literal is `v` for
/// positive and `-v` for negative, never 0; a clause is a list of literals.
/// This module holds the pure helpers shared by `SatSearch` and the public
/// `Sat` entry points, including the model oracle and the canonical spelling
/// rules that keep the solver deterministic.
module SatClauses {
    /// The negation of a literal, total on every int.
    export fn neg(l) = wrapSub(0, l)

    /// The variable of a literal, so 0 marks a malformed literal.
    export fn absLit(l) = if l < 0 { wrapSub(0, l) } else { l }

    /// The literal that asserts variable `v` to value `val` (-1 or 1).
    export fn litOf(v, val) = if val > 0 { v } else { wrapSub(0, v) }

    /// The canonical spelling of a derived clause: literals sorted by
    /// absolute variable value. Ties cannot occur (each variable appears at
    /// most once in a derived clause), so the order is total.
    export fn canonical(lits) = mapList(Order::sortedIndexes(mapList(lits, fn(l) => Order::intKey(absLit(l)))), fn(i) => listGet(lits, i) ?: 0)

    /// Root ids (input clause indexes, or negative assumption references)
    /// deduplicated and sorted ascending, the canonical spelling of a core.
    export fn canonicalInts(xs) = {
        let seen = foldList(xs, Map(), fn(m, x) => mapSet(m, "${x}", x))
        listSort(mapList(mapKeys(seen), fn(k) => parseInt(k) ?: 0))
    }

    /// Every literal refers to a variable in 1..vars; 0 is never a literal.
    export fn wellFormed(vars, clauses) = foldList(clauses, true, fn(ok, c) =>
        ok && foldList(c, true, fn(good, l) => good && absLit(l) >= 1 && absLit(l) <= vars))

    /// The unit clauses whose conjunction negates clause `c`, used to check
    /// that a learned clause is implied by a formula.
    export fn negated(c) = mapList(c, fn(l) => [neg(l)])

    /// Variable-to-sign map of a model given as one literal per variable.
    export fn valueMap(model) = foldList(model, Map(), fn(m, l) =>
        mapSet(m, "${absLit(l)}", if l > 0 { 1 } else { -1 }))

    fn litTrueUnder(m, l) = (mapGet(m, "${absLit(l)}") ?: 0) == (if l > 0 { 1 } else { -1 })

    fn litTrueAt(m, c, i) = if i >= length(c) { false }
        else if litTrueUnder(m, listGet(c, i) ?: 0) { true }
        else { litTrueAt(m, c, i + 1) }

    /// Oracle: every clause has a true literal under the model. An empty
    /// clause fails, an unassigned or missing variable never satisfies.
    export fn satisfiedBy(model, clauses) = foldList(clauses, true, fn(ok, c) =>
        ok && litTrueAt(valueMap(model), c, 0))
}
