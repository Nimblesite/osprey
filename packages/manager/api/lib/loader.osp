namespace registry_api;
import registry::Catalog
import registry::Folder
import registry::Release
import registry::ReleaseFiles
import registry_host::Host

/// Builds the catalog of a folder-registry root: walk it, read every release
/// directory's files, and assemble each release with the shared core. A
/// directory that cannot be read or assembled is refused with its reason.
/// Implements "Catalog" of [PACKAGE-FOLDER-REGISTRY].
module Loader {
    type Tally = { served: List<Release::Served>, refused: List<Release::Refused> }

    fn fileAt(root, dir, rel) = "${root}/${dir}/${rel}"

    fn readNext(root, pending: Folder::Pending, i, files, rel) = match perform Host::Files.read(fileAt(root, pending.releaseDir, rel)) {
        Success { value } => readFiles(root, pending, i + 1, listAppend(files, Release::File { relPath: rel, content: value }))
        Error { message } => Error { message: "host.read: ${rel}: ${message}" }
    }

    fn readFiles(root, pending: Folder::Pending, i, files) -> Result<List<Release::File>, string> =
        if i >= length(pending.relPaths) { Success { value: files } }
        else { readNext(root, pending, i, files, listGet(pending.relPaths, i) ?: "") }

    fn outcome(root, pending: Folder::Pending) = match readFiles(root, pending, 0, []) {
        Success { value } => ReleaseFiles::assemble(pending.releaseDir, value)
        Error { message } => Error { message: message }
    }

    // `Tally` shares `served`/`refused` with `Release::Catalog`: annotated for issue #273.
    fn record(tally: Tally, pending: Folder::Pending, result) = match result {
        Success { value } => Tally { served: listAppend(tally.served, value), refused: tally.refused }
        Error { message } => Tally { served: tally.served, refused: listAppend(tally.refused, Release::Refused { dir: pending.releaseDir, code: message }) }
    }

    fn fromWalk(root, walk: Host::Walk) = {
        let plan = Folder::plan(walk.regular, walk.executable, walk.special)
        let tally = foldList(plan.pending, Tally { served: [], refused: plan.refused }, fn(t, p) => record(t, p, outcome(root, p)))
        Catalog::of(tally.served, tally.refused)
    }

    /// The catalog of `root`, or `host.tree.unreadable` when it cannot be walked.
    export fn load(root) = match perform Host::Tree.walk(root) {
        Success { value } => Success { value: fromWalk(root, value) }
        Error { message } => Error { message: message }
    }
}
