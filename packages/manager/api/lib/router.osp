namespace registry_api;
import registry::Bundle
import registry::Canonical
import registry::Catalog
import registry::Json

/// The folder-registry HTTP surface as one pure function: method, path and
/// catalog in, status, content type, ETag and canonical body out. GET only;
/// every error is `application/problem+json` with a stable code. Implements
/// the endpoints of [PACKAGE-FOLDER-REGISTRY] and [PACKAGE-API].
module Router {
    /// One HTTP response; `etag` is "" when the body carries none.
    export type Response = { status: int, contentType: string, etag: string, body: string }

    let okStatus = 200
    let notFoundStatus = 404
    let methodStatus = 405
    let getMethod = "GET"
    let jsonType = "application/json"
    let problemType = "application/problem+json"
    let notFoundCode = "api.not-found"
    let methodCode = "api.method-not-allowed"
    let unknownReleaseCode = "catalog.unknown-release"
    let unknownPackageCode = "catalog.unknown-package"
    let nosniff = "X-Content-Type-Options: nosniff"
    let csp = "Content-Security-Policy: default-src 'none'"
    let referrer = "Referrer-Policy: no-referrer"
    let immutableCache = "Cache-Control: public, max-age=31536000, immutable"
    let noCache = "Cache-Control: no-cache"
    let allowGet = "Allow: GET"

    fn member(key, value) = Json::Member { key: key, value: value }
    fn str(text) = Json::Str { text: text }
    fn num(value) = Json::Num { value: value }

    fn okResponse(body) = Response { status: okStatus, contentType: jsonType, etag: "", body: body }

    fn problemResponse(code, status, title) = Response {
        status: status,
        contentType: problemType,
        etag: "",
        body: Canonical::serialize(Json::Obj { members: [
            member("code", str(code)),
            member("status", num(status)),
            member("title", str(title))
        ] }) ?: ""
    }

    fn notFound() = problemResponse(notFoundCode, notFoundStatus, "Not found")

    fn methodNotAllowed() = problemResponse(methodCode, methodStatus, "Method not allowed")

    fn cacheHeader(response: Response) = if response.etag == "" { noCache } else { immutableCache }

    fn allowHeaders(response: Response) -> List<string> = if response.status == methodStatus { [allowGet] } else { [] }

    /// The hardening headers beyond `Content-Type` and `ETag`, in a fixed
    /// order: a digest-addressed response is immutable, every other response
    /// is revalidated, and a 405 names the one allowed method. Implements S2
    /// and S3 of [PACKAGE-HARDENING].
    export fn hardeningHeaders(response: Response) = listConcat([nosniff, csp, referrer, cacheHeader(response)], allowHeaders(response))

    /// A reason code from the catalog, as its problem response.
    fn problemOf(code) = match code {
        "catalog.unknown-release" => problemResponse(unknownReleaseCode, notFoundStatus, "Unknown release")
        "catalog.unknown-package" => problemResponse(unknownPackageCode, notFoundStatus, "Unknown package")
        _ => notFound()
    }

    fn withoutQuery(path) = match indexOf(path, "?") {
        Success { value } => take(path, value)
        Error => path
    }

    fn segments(path) = split(path, "/") ?: [path]

    fn seg(parts, i) = listGet(parts, i) ?: ""

    /// The one pure routing function: `GET` only, query strings ignored,
    /// anything unrecognized 404. Implements [PACKAGE-FOLDER-REGISTRY].
    export fn respond(catalog, method, path) = match method == getMethod {
        false => methodNotAllowed()
        true => route(catalog, segments(withoutQuery(path)))
    }

    fn route(catalog, parts) = {
        let section = seg(parts, 2)
        if seg(parts, 0) != "" || seg(parts, 1) != "v1" { notFound() }
        else if section == "health" && length(parts) == 3 { okResponse(Catalog::healthJson(catalog) ?: "") }
        else if section == "packages" { packages(catalog, parts) }
        else if section == "releases" { releases(catalog, parts) }
        else { notFound() }
    }

    fn packages(catalog, parts) = {
        let n = length(parts)
        if n == 3 { okResponse(Catalog::packagesJson(catalog) ?: "") }
        else if n == 5 { onePackage(catalog, seg(parts, 3), seg(parts, 4)) }
        else { notFound() }
    }

    /// The scope segment, with or without its leading "@".
    fn scope(segment) = if startsWith(segment, "@") { drop(segment, 1) } else { segment }

    fn onePackage(catalog, scopeSegment, name) = match Catalog::packageJson(catalog, scope(scopeSegment), name) {
        Success { value } => okResponse(value)
        Error { message } => problemOf(message)
    }

    fn releases(catalog, parts) = {
        let n = length(parts)
        if n == 4 { release(catalog, seg(parts, 3)) }
        else if n == 5 && seg(parts, 4) == "source" { source(catalog, seg(parts, 3)) }
        else { notFound() }
    }

    fn etagOf(digest) = "\"${digest}\""

    fn release(catalog, digest) = match Catalog::byDigest(catalog, digest) {
        Success { value } => Response { status: okStatus, contentType: jsonType, etag: etagOf(digest), body: Catalog::releaseJson(value) ?: "" }
        Error { message } => problemOf(message)
    }

    fn source(catalog, digest) = match Catalog::byDigest(catalog, digest) {
        Success { value } => sourced(value, digest)
        Error { message } => problemOf(message)
    }

    fn sourced(served, digest) = match Bundle::encode(served) {
        Success { value } => Response { status: okStatus, contentType: jsonType, etag: etagOf(digest), body: value }
        Error { message } => problemOf(message)
    }
}
