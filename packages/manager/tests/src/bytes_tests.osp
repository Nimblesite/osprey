namespace registry_tests;
import registry::Bytes
import registry::Order

/// Byte encodings from [PACKAGE-SOURCE-CANONICAL] and canonical list rules.
module BytesTests {
    fn ints(xs) = join(mapList(xs, fn(b) => "${b}"), ",")
    fn strs(xs) = join(xs, ",")

    fn encodings() = checkAll("big-endian widths and hex spelling", [
        ints(Bytes::u32be(0)) == "0,0,0,0",
        ints(Bytes::u32be(1)) == "0,0,0,1",
        ints(Bytes::u32be(258)) == "0,0,1,2",
        ints(Bytes::u32be(4294967295)) == "255,255,255,255",
        ints(Bytes::u64be(0)) == "0,0,0,0,0,0,0,0",
        ints(Bytes::u64be(4294967296)) == "0,0,0,1,0,0,0,0",
        ints(Bytes::u64be(9223372036854775807)) == "127,255,255,255,255,255,255,255",
        Bytes::hex([0, 15, 16, 171, 255]) == "000f10abff",
        Bytes::hex([]) == "",
        ints(Bytes::ofString("abc")) == "97,98,99",
        ints(Bytes::ofString("")) == "",
        ints(Bytes::concatAll([[1], [], [2, 3]])) == "1,2,3",
        Bytes::wellFormed([0, 255]),
        !Bytes::wellFormed([256]),
        !Bytes::wellFormed([-1])
    ])

    fn intsAt(xs) = fn(i, j) => Order::compareInts(listGet(xs, i) ?: 0, listGet(xs, j) ?: 0)

    fn sorting() = checkAll("index sorts are stable and total", [
        ints(Order::permutation(3, intsAt([3, 1, 2]))) == "1,2,0",
        ints(Order::permutation(3, intsAt([2, 2, 1]))) == "2,0,1",
        ints(Order::permutation(0, intsAt([]))) == "",
        ints(Order::permutation(1, intsAt([5]))) == "0",
        ints(Order::sortedIndexes(["b", "a", "Z", "aa"])) == "2,1,3,0",
        ints(Order::sortedIndexes(["b", "a", "b"])) == "1,0,2",
        ints(Order::sortedIndexes([])) == "",
        ints(Order::sortedIndexes(mapList([10, 9, 100], Order::intKey))) == "1,0,2",
        Order::intKey(42) == "0000000042",
        Order::thenCompare(0, -1) == -1,
        Order::thenCompare(1, -1) == 1
    ])

    fn sets() = checkAll("set-like string lists are sorted and duplicate-free", [
        strs(Order::canonicalSet(["b", "a"]) ?: []) == "a,b",
        match Order::canonicalSet(["a", "a"]) {
            Success => false
            Error { message } => message == "list.duplicate"
        },
        Order::strictlyAscending(["a", "b", "c"]),
        !Order::strictlyAscending(["a", "a"]),
        !Order::strictlyAscending(["b", "a"]),
        Order::strictlyAscending([])
    ])

    export fn run() = {
        test("bytes: encodings", encodings)
        test("order: sorting", sorting)
        test("order: canonical sets", sets)
    }
}
