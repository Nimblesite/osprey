namespace registry_tests;
import registry::Digests
import registry::Identity
import registry::Names
import registry::Order
import registry::Domains

/// [PACKAGE-IDENTITY] display grammar, digest envelopes and release order.
module IdentityTests {
    let hex = "7c4a8d09ca3762af61e59520943dc26494f8941b7c4a8d09ca3762af61e59520"
    let digest = "sha256:7c4a8d09ca3762af61e59520943dc26494f8941b7c4a8d09ca3762af61e59520"

    fn ints(xs) = join(mapList(xs, fn(b) => "${b}"), ",")

    fn code(result) = match result {
        Success => ""
        Error { message } => message
    }

    fn shown(text) = match Identity::parse(text) {
        Success { value } => Identity::display(value)
        Error { message } => message
    }

    fn digests() = checkAll("digest envelopes carry one algorithm and 64 lowercase hex digits", [
        (Digests::parse(digest) ?: "") == digest,
        code(Digests::parse("sha512:${hex}")) == "digest.algorithm",
        code(Digests::parse(hex)) == "digest.algorithm",
        code(Digests::parse("sha256:${take(hex, 63)}")) == "digest.length",
        code(Digests::parse("sha256:${toUpperCase(hex)}")) == "digest.hex",
        code(Digests::parse("sha256:${take(hex, 63)}g")) == "digest.hex",
        Digests::format([0, 255]) == "sha256:00ff",
        Digests::hexOf(digest) == hex,
        Digests::algorithmName() == "sha256",
        ints(Digests::preimage("d", [9])) == "100,0,0,0,0,0,0,0,0,1,9",
        ints(Digests::preimage("", [])) == "0,0,0,0,0,0,0,0,0"
    ])

    fn displayForms() = checkAll("release ids round-trip and reject every malformed part", [
        shown("@finch/ledger@e3.r42#${digest}") == "@finch/ledger@e3.r42#${digest}",
        shown("@finch/ledger@e1.r1#${digest}") == "@finch/ledger@e1.r1#${digest}",
        shown("@finch/ledger@e3.r42") == "release.missing-digest",
        shown("@finch/ledger@e3.r42#${digest}#x") == "release.missing-digest",
        shown("@finch/ledger@e3.r42#sha1:${hex}") == "digest.algorithm",
        shown("@finch/ledger#${digest}") == "release.missing-version",
        shown("@finch/ledger@3.r42#${digest}") == "release.version",
        shown("@finch/ledger@e3r42#${digest}") == "release.version",
        shown("@finch/ledger@e3.r42.x#${digest}") == "release.ordinal",
        shown("@finch/ledger@e0.r42#${digest}") == "release.epoch",
        shown("@finch/ledger@e03.r42#${digest}") == "release.epoch",
        shown("@finch/ledger@e3.r0#${digest}") == "release.ordinal",
        shown("@finch/ledger@e3.r+4#${digest}") == "release.ordinal",
        shown("@finch/ledger@e3.rx#${digest}") == "release.ordinal",
        shown("@Finch/ledger@e3.r42#${digest}") == "name.scope.chars",
        shown("finch/ledger@e3.r42#${digest}") == "name.missing-at"
    ])

    fn id(scope, name, epoch, ordinal, d) = Identity::ReleaseId { key: Names::Key { scope: scope, name: name }, epoch: epoch, ordinal: ordinal, digest: d }

    fn ordering() = {
        let ids = [id("b", "a", 1, 1, "sha256:aa"), id("a", "a", 2, 1, "sha256:aa"), id("a", "a", 1, 9, "sha256:aa"), id("a", "a", 1, 9, "sha256:ab"), id("a", "a", 1, 2, "sha256:zz")]
        let at = fn(i) => listGet(ids, i) ?: id("", "", 0, 0, "")
        let sorted = mapList(Order::permutation(length(ids), fn(i, j) => Identity::compare(at(i), at(j))), at)
        checkAll("releases order by (package, epoch, ordinal, digest)", [
            join(mapList(sorted, Identity::display), " ") == "@a/a@e1.r2#sha256:zz @a/a@e1.r9#sha256:aa @a/a@e1.r9#sha256:ab @a/a@e2.r1#sha256:aa @b/a@e1.r1#sha256:aa",
            Identity::compare(id("a", "a", 1, 1, "sha256:aa"), id("a", "a", 1, 1, "sha256:aa")) == 0
        ])
    }

    /// Goldens from packages/manager/tests/fixtures/digests.json, computed independently.
    fn domainHashes() = checkAll("H(d, x) matches the independently computed fixtures", [
        Digests::hashText("osprey.manifest.v1", "{}") == "sha256:093779013e49dd05655baaa226991f473ee20b565ec4e1e6bb928e35168834ce",
        Digests::hashText("osprey.release.v1", "") == "sha256:aafe09e1f2092a5b3c0069c66242d6c13be0c745d0cbc55da67715a037cd33d4",
        Digests::hashText("", "abc") == "sha256:3ff3f22b0f8c2a1553022e4cba10e16915655cf0d3f4c908c950ab539ec2d9b6"
    ])

    fn spec0031Domains() = {
        let all = Domains::all()
        checkAll("every H(d, x) domain is spelled as spec 0031 writes it, once", [
            length(all) == 26,
            length(Order::canonicalSet(all) ?: []) == 26,
            foldList(all, true, fn(ok, d) => ok && startsWith(d, "osprey.") && endsWith(d, ".v1")),
            Domains::manifestDomain() == "osprey.manifest.v1",
            Domains::buildPlanDomain() == "osprey.build-plan.v1",
            Domains::releaseDomain() == "osprey.release.v1",
            Domains::releaseLockDomain() == "osprey.release-lock.v1",
            Domains::developmentLockDomain() == "osprey.development-lock.v1",
            Domains::logCheckpointRecordDomain() == "osprey.log-checkpoint-record.v1",
            Domains::developmentBuildReceiptDomain() == "osprey.development-build-receipt.v1",
            Domains::releaseStatusDomain() == "osprey.release-status.v1",
            Domains::envelopeDomain() == "osprey.envelope.v1",
            Domains::webAuthnDomain() == "osprey.webauthn.v1",
            Domains::sourceTreeDomain() == "osprey.source.v1"
        ])
    }

    export fn run() = {
        test("digests: envelopes and preimages", digests)
        test("domains: spec 0031 spellings", spec0031Domains)
        test("digests: domain-separated hashes", domainHashes)
        test("identity: display grammar", displayForms)
        test("identity: canonical order", ordering)
    }
}
