namespace registry_tests;

/// `schemas/package-registry.td` is the canonical typeDiagram model and spec
/// 0031 renders the same block; this keeps the two byte-identical so neither
/// can drift. Implements the schema rule of [PACKAGE-TYPES]. Runs from the
/// repository root, where `make -C packages registry-test` runs it.
module SchemaTests {
    let specPath = "docs/specs/ecosystem/0031-PackageDomainModel.md"
    let schemaPath = "schemas/package-registry.td"
    let opening = "```typediagram\n"
    let closing = "\n```"

    fn after(text, marker) = match indexOf(text, marker) {
        Success { value } => drop(text, value + byteLength(marker))
        Error => ""
    }

    fn before(text, marker) = match indexOf(text, marker) {
        Success { value } => take(text, value)
        Error => ""
    }

    fn specBlock() = before(after(readFile(specPath) ?: "", opening), closing)

    fn blockMatchesSchema() = {
        let block = trimEnd(specBlock())
        let schema = trimEnd(readFile(schemaPath) ?: "")
        checkAll("spec 0031 typeDiagram block equals schemas/package-registry.td", [
            startsWith(block, "typeDiagram\n"),
            byteLength(block) == byteLength(schema),
            block == schema
        ])
    }

    export fn run() = test("schema: spec block equals canonical file", blockMatchesSchema)
}
