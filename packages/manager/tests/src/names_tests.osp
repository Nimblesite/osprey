namespace registry_tests;
import registry::Names
import registry::Order

/// [PACKAGE-NAMES] grammar, reason codes and canonical key order.
module NamesTests {
    fn code(text) = match Names::parse(text) {
        Success => ""
        Error { message } => message
    }

    fn shown(text) = match Names::parse(text) {
        Success { value } => Names::display(value)
        Error { message } => message
    }

    fn longest(n) = repeat("a", n) ?: ""

    fn acceptsCanonicalKeys() = checkAll("canonical keys parse and round-trip", [
        shown("@finch/ledger") == "@finch/ledger",
        shown("@osprey/http") == "@osprey/http",
        shown("@a1/b-2") == "@a1/b-2",
        shown("@${longest(39)}/${longest(63)}") == "@${longest(39)}/${longest(63)}",
        shown("@a/a--b") == "@a/a--b"
    ])

    fn rejectsWithReasonCodes() = checkAll("every rejection names one stable reason code", [
        code("finch/ledger") == "name.missing-at",
        code("@finch") == "name.unscoped-or-missing-slash",
        code("@finch/ledger/extra") == "name.extra-slash",
        code("@/ledger") == "name.scope.length",
        code("@finch/") == "name.name.length",
        code("@${longest(40)}/x") == "name.scope.length",
        code("@x/${longest(64)}") == "name.name.length",
        code("@Finch/ledger") == "name.scope.chars",
        code("@finch/Ledger") == "name.name.chars",
        code("@finch/-ledger") == "name.name.chars",
        code("@finch-/ledger") == "name.scope.chars",
        code("@finch/led_ger") == "name.name.chars",
        code("@finch/lédger") == "name.name.chars",
        code("@finch/led ger") == "name.name.chars"
    ])

    fn key(scope, name) = Names::Key { scope: scope, name: name }

    fn ordersByScopeThenName() = {
        let keys = [key("b", "a"), key("a", "z"), key("a", "b"), key("a-b", "a")]
        let at = fn(i) => listGet(keys, i) ?: key("", "")
        let sorted = mapList(Order::permutation(length(keys), fn(i, j) => Names::compare(at(i), at(j))), at)
        checkAll("keys order by (scope, name) bytes", [
            join(mapList(sorted, Names::display), " ") == "@a/b @a/z @a-b/a @b/a",
            Names::compare(key("a", "b"), key("a", "b")) == 0,
            Names::compare(key("a", "b"), key("a", "c")) < 0,
            Names::compare(key("b", "a"), key("a", "z")) > 0
        ])
    }

    export fn run() = {
        test("package names: canonical keys", acceptsCanonicalKeys)
        test("package names: reason codes", rejectsWithReasonCodes)
        test("package names: canonical order", ordersByScopeThenName)
    }
}
