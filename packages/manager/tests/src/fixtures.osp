namespace registry_tests;
import registry::Json
import registry::JsonRead

/// Reading the declarative fixtures under packages/manager/tests/fixtures: every
/// suite loads, walks and reports fixture tables through these helpers so no
/// suite carries its own copy. A fixture is the normative table; code only
/// interprets it. Implements the fixture rule of [PACKAGE-CONFORMANCE].
module Fixtures {
    let root = "packages/manager/tests/fixtures"

    /// The parsed fixture at `name` under the fixture root; an unreadable or
    /// malformed file becomes a string value naming the problem, so every
    /// assertion over it fails visibly.
    export fn load(name) = match Json::parse(readFile("${root}/${name}") ?: "") {
        Success { value } => value
        Error { message } => Json::Str { text: "fixture ${name} unreadable: ${message}" }
    }

    /// The member `key` of an object, or `Json::Null`.
    export fn field(value, key) = JsonRead::field(value, key)

    /// The text of a string value, or "".
    export fn text(value) = JsonRead::text(value)

    /// The integer of a number value, or -1.
    export fn number(value) = JsonRead::number(value)

    /// The items of an array value, or [].
    export fn items(value) = JsonRead::items(value)

    /// The texts of an array of strings.
    export fn texts(value) = JsonRead::texts(value)

    /// The cases for which `run` is false.
    export fn failures(cases, run) = foldList(cases, [], fn(bad, case) => if run(case) { bad } else { listAppend(bad, case) })

    /// One assertion over a whole table: every case must pass.
    export fn report(label, cases, run) = {
        let bad = failures(cases, run)
        check("${label}: ${length(bad)} of ${length(cases)} failed", 0, length(bad))
    }

    /// The error message of a result, or "" for success.
    export fn code(result) = match result {
        Success => ""
        Error { message } => message
    }
}
