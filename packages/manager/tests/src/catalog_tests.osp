namespace registry_tests;
import registry::Catalog
import registry::Identity
import registry::Names
import registry::Release

/// Catalog ordering, digest and package lookups, and the byte-exact canonical
/// JSON views the API serves. Implements [PACKAGE-FOLDER-REGISTRY] and
/// [PACKAGE-API]. The fixture is shared with the router suite.
module CatalogTests {
    export fn digestA() = "sha256:" + (repeat("a", 64) ?: "")
    fn digestB() = "sha256:" + (repeat("b", 64) ?: "")
    export fn digestC() = "sha256:" + (repeat("c", 64) ?: "")

    fn id(scope, name, epoch, ordinal, digest) = Identity::ReleaseId {
        key: Names::Key { scope: scope, name: name },
        epoch: epoch,
        ordinal: ordinal,
        digest: digest
    }

    fn file(path) = Release::File { relPath: path, content: "" }

    export fn ledgerEarly() = Release::Served { id: id("finch", "ledger", 1, 1, digestA()), files: [file("osprey.toml"), file("src/lib.osp")] }
    fn ledgerLate() = Release::Served { id: id("finch", "ledger", 2, 5, digestB()), files: [file("osprey.toml")] }
    fn utilOnly() = Release::Served { id: id("finch", "util", 1, 1, digestC()), files: [file("osprey.toml")] }

    /// Two packages, three releases, one refusal — served out of order.
    export fn fixture() = Catalog::of([ledgerLate(), utilOnly(), ledgerEarly()], [Release::Refused { dir: "@broken/pkg/1.1", code: "source.symlink" }])

    // `Served` shares `id` with `Capabilities::Blocked` and `ReleaseId`
    // shares `digest` with `Source::Entry`; issue #273 needs those receivers
    // spelled out when reading the shared fields.
    fn digestOf(id: Identity::ReleaseId) = id.digest
    fn servedDigest(s: Release::Served) = digestOf(s.id)
    fn servedDisplay(s: Release::Served) = Identity::display(s.id)

    fn digestsOf(served) = join(mapList(served, servedDigest), ",")

    fn ordering() = check("catalog: releases ordered by key, then epoch, then ordinal",
        join([digestA(), digestB(), digestC()], ","),
        digestsOf(fixture().served))

    fn lookupByDigest() = checkAll("catalog: byDigest", [
        match Catalog::byDigest(fixture(), digestB()) {
            Success { value } => servedDisplay(value) == "@finch/ledger@e2.r5#${digestB()}"
            Error => false
        },
        match Catalog::byDigest(fixture(), "sha256:zz") {
            Success => false
            Error { message } => message == "catalog.unknown-release"
        }
    ])

    fn releases() = checkAll("catalog: releasesOf", [
        digestsOf(Catalog::releasesOf(fixture(), "finch", "ledger")) == join([digestA(), digestB()], ","),
        digestsOf(Catalog::releasesOf(fixture(), "finch", "util")) == digestC(),
        isEmpty(Catalog::releasesOf(fixture(), "nope", "ledger"))
    ])

    fn health() = check("catalog: healthJson byte-exact",
        "{\"refused\":1,\"releases\":3,\"status\":\"ok\"}",
        Catalog::healthJson(fixture()) ?: "?")

    fn packages() = check("catalog: packagesJson byte-exact",
        "{\"packages\":[{\"key\":\"@finch/ledger\",\"releases\":[{\"digest\":\"${digestA()}\",\"epoch\":1,\"ordinal\":1},{\"digest\":\"${digestB()}\",\"epoch\":2,\"ordinal\":5}]},{\"key\":\"@finch/util\",\"releases\":[{\"digest\":\"${digestC()}\",\"epoch\":1,\"ordinal\":1}]}]}",
        Catalog::packagesJson(fixture()) ?: "?")

    fn onePackage() = checkAll("catalog: packageJson", [
        (Catalog::packageJson(fixture(), "finch", "util") ?: "?") == "{\"key\":\"@finch/util\",\"releases\":[{\"digest\":\"${digestC()}\",\"epoch\":1,\"ordinal\":1}]}",
        match Catalog::packageJson(fixture(), "finch", "gone") {
            Success => false
            Error { message } => message == "catalog.unknown-package"
        }
    ])

    fn oneRelease() = check("catalog: releaseJson byte-exact",
        "{\"digest\":\"${digestA()}\",\"epoch\":1,\"files\":[\"osprey.toml\",\"src/lib.osp\"],\"key\":\"@finch/ledger\",\"ordinal\":1}",
        Catalog::releaseJson(ledgerEarly()) ?: "?")

    export fn run() = {
        test("catalog: ordering", ordering)
        test("catalog: byDigest", lookupByDigest)
        test("catalog: releasesOf", releases)
        test("catalog: healthJson", health)
        test("catalog: packagesJson", packages)
        test("catalog: packageJson", onePackage)
        test("catalog: releaseJson", oneRelease)
    }
}
