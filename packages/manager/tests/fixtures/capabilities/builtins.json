{
  "spec": "[PACKAGE-CAPABILITY-CONFINEMENT]",
  "description": "The ambient builtin to capability map the surface scan applies: every builtin the compiler lets any function call without declaring an effect, and the capability it belongs to. Every http* and websocket* builtin is io/network by prefix; a builtin absent here is io/unknown and rejects publication.",
  "capabilities": ["io/files", "io/network", "io/process", "io/terminal"],
  "builtins": [
    {"builtin": "awaitProcess", "capability": "io/process"},
    {"builtin": "cleanupProcess", "capability": "io/process"},
    {"builtin": "gpuLoad", "capability": "io/files"},
    {"builtin": "gpuLoadTensor", "capability": "io/files"},
    {"builtin": "httpCloseClient", "capability": "io/network"},
    {"builtin": "httpDelete", "capability": "io/network"},
    {"builtin": "httpGet", "capability": "io/network"},
    {"builtin": "httpListen", "capability": "io/network"},
    {"builtin": "httpPost", "capability": "io/network"},
    {"builtin": "httpPostResponse", "capability": "io/network"},
    {"builtin": "httpPut", "capability": "io/network"},
    {"builtin": "httpResponseFree", "capability": "io/network"},
    {"builtin": "httpStopServer", "capability": "io/network"},
    {"builtin": "input", "capability": "io/terminal"},
    {"builtin": "loadTensor", "capability": "io/files"},
    {"builtin": "readFile", "capability": "io/files"},
    {"builtin": "spawnProcess", "capability": "io/process"},
    {"builtin": "termClear", "capability": "io/terminal"},
    {"builtin": "termCols", "capability": "io/terminal"},
    {"builtin": "termHideCursor", "capability": "io/terminal"},
    {"builtin": "termMoveCursor", "capability": "io/terminal"},
    {"builtin": "termRawMode", "capability": "io/terminal"},
    {"builtin": "termReadKey", "capability": "io/terminal"},
    {"builtin": "termRows", "capability": "io/terminal"},
    {"builtin": "termShowCursor", "capability": "io/terminal"},
    {"builtin": "websocketClose", "capability": "io/network"},
    {"builtin": "writeFile", "capability": "io/files"}
  ]
}
