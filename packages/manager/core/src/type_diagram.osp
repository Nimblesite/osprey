namespace registry;

/// Parses a typeDiagram document — `typeDiagram`, then `alias X = T`,
/// `type X { ... }`, and `union X { Variant { ... } ... }` declarations whose
/// fields are whitespace-separated `name: Type` pairs — into the model that
/// `SchemaCheck` validates parsed JSON against. A declaration that names a
/// type which is neither a builtin scalar nor declared is rejected with
/// `schema.unknown-type`. Implements the schema-reading side of
/// [PACKAGE-TYPE-INVARIANTS].
module TypeDiagram {
    /// A type expression: a name, `List<T>`, or `Option<T>`.
    export type TypeRef = Named { name: string } | ListOf { element: TypeRef } | OptionOf { element: TypeRef }
    /// One `name: Type` field of a `type` or a union variant.
    export type Field = { name: string, typ: TypeRef }
    /// One named payload of a `union`.
    export type Variant = { name: string, payload: List<Field> }
    /// One top-level declaration.
    export type Decl = Alias { name: string, target: TypeRef } | Struct { name: string, fields: List<Field> } | Union { name: string, variants: List<Variant> }
    /// The parsed document: every declaration, in source order.
    export type Model = { decls: List<Decl> }

    type RefStep = { ref: TypeRef, next: int }
    type FieldsStep = { parsed: List<Field>, next: int }
    type VariantsStep = { variants: List<Variant>, next: int }
    type TokenState = { tokens: List<string>, wordStart: int }

    let unknownType = "schema.unknown-type"

    fn isWordByte(b) = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
    fn isPunct(b) = b == 123 || b == 125 || b == 58 || b == 61 || b == 60 || b == 62

    fn finishWord(text, i, acc) = if acc.wordStart < 0 { acc.tokens } else {
        listAppend(acc.tokens, substring(text, acc.wordStart, i) ?: "")
    }

    fn tokenBoundary(text, i, acc, b) = {
        let words = finishWord(text, i, acc)
        TokenState { tokens: if isPunct(b) { listAppend(words, substring(text, i, i + 1) ?: "") } else { words }, wordStart: -1 }
    }

    fn tokenStep(text, acc, i) = match byteAt(text, i) {
        Error => tokenBoundary(text, i, acc, 0)
        Success { value } => if isWordByte(value) {
            TokenState { tokens: acc.tokens, wordStart: if acc.wordStart < 0 { i } else { acc.wordStart } }
        } else { tokenBoundary(text, i, acc, value) }
    }

    /// Visit each byte and one final boundary without accumulating native call frames.
    fn tokenize(text) = fold(range(0, byteLength(text) + 1), TokenState { tokens: [], wordStart: -1 }, fn(acc, i) => tokenStep(text, acc, i)).tokens

    fn peek(tokens, i) = listGet(tokens, i) ?: ""

    fn listStep(tokens, i) = {
        let inner = parseTypeRef(tokens, i + 2)
        RefStep { ref: ListOf { element: inner.ref }, next: inner.next + 1 }
    }

    fn optionStep(tokens, i) = {
        let inner = parseTypeRef(tokens, i + 2)
        RefStep { ref: OptionOf { element: inner.ref }, next: inner.next + 1 }
    }

    fn parseTypeRef(tokens, i) = {
        let name = peek(tokens, i)
        if name == "List" { listStep(tokens, i) }
        else if name == "Option" { optionStep(tokens, i) }
        else { RefStep { ref: Named { name: name }, next: i + 1 } }
    }

    fn fieldStep(tokens, i, tok, out) = {
        let typ = parseTypeRef(tokens, i + 2)
        parseFields(tokens, typ.next, listAppend(out, Field { name: tok, typ: typ.ref }))
    }

    fn parseFields(tokens, i, out) = {
        let tok = peek(tokens, i)
        if tok == "}" || tok == "" { FieldsStep { parsed: out, next: i + 1 } }
        else { fieldStep(tokens, i, tok, out) }
    }

    fn variantStep(tokens, i, tok, out) = {
        let fs = parseFields(tokens, i + 2, [])
        parseVariants(tokens, fs.next, listAppend(out, Variant { name: tok, payload: fs.parsed }))
    }

    fn parseVariants(tokens, i, out) = {
        let tok = peek(tokens, i)
        if tok == "}" || tok == "" { VariantsStep { variants: out, next: i + 1 } }
        else { variantStep(tokens, i, tok, out) }
    }

    fn aliasStep(tokens, i, out) = {
        let t = parseTypeRef(tokens, i + 3)
        parseDecls(tokens, t.next, listAppend(out, Alias { name: peek(tokens, i + 1), target: t.ref }))
    }

    fn structStep(tokens, i, out) = {
        let fs = parseFields(tokens, i + 3, [])
        parseDecls(tokens, fs.next, listAppend(out, Struct { name: peek(tokens, i + 1), fields: fs.parsed }))
    }

    fn unionStep(tokens, i, out) = {
        let vs = parseVariants(tokens, i + 3, [])
        parseDecls(tokens, vs.next, listAppend(out, Union { name: peek(tokens, i + 1), variants: vs.variants }))
    }

    fn parseDecls(tokens, i, out) = {
        let tok = peek(tokens, i)
        if tok == "" { out }
        else if tok == "alias" { aliasStep(tokens, i, out) }
        else if tok == "type" { structStep(tokens, i, out) }
        else if tok == "union" { unionStep(tokens, i, out) }
        else { out }
    }

    fn declName(decl) = match decl {
        Alias { name } => name
        Struct { name } => name
        Union { name } => name
    }

    fn isBuiltin(name) = name == "String" || name == "Int" || name == "Bool" || name == "DateTime" || name == "Uuid"

    fn refKnown(names, ref) = match ref {
        Named { name } => isBuiltin(name) || listContains(names, name)
        ListOf { element } => refKnown(names, element)
        OptionOf { element } => refKnown(names, element)
    }

    fn fieldKnown(names, field) = refKnown(names, field.typ)
    fn fieldsKnown(names, fields) = foldList(fields, true, fn(ok, f) => ok && fieldKnown(names, f))
    fn variantsKnown(names, variants) = foldList(variants, true, fn(ok, v) => ok && fieldsKnown(names, v.payload))

    fn declKnown(names, decl) = match decl {
        Alias { target } => refKnown(names, target)
        Struct { fields } => fieldsKnown(names, fields)
        Union { variants } => variantsKnown(names, variants)
    }

    /// The parsed model, or `schema.unknown-type` when any declaration
    /// references a name that is neither builtin nor declared.
    export fn parse(text) = {
        let tokens = tokenize(text)
        let decls = parseDecls(tokens, 1, [])
        let names = mapList(decls, declName)
        match foldList(decls, true, fn(ok, d) => ok && declKnown(names, d)) {
            true => Success { value: Model { decls: decls } }
            false => Error { message: unknownType }
        }
    }

    /// The declaration named `name`, or `schema.unknown-type`.
    export fn lookup(model, name) = foldList(model.decls, Error { message: unknownType }, fn(acc, d) => match acc {
        Success => acc
        Error => if declName(d) == name { Success { value: d } } else { acc }
    })
}
