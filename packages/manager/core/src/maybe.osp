namespace registry;

/// An optional value, the `Option<T>` of the typeDiagram model. A field that
/// is `Absent` is omitted from canonical JSON and is never `null`
/// ([PACKAGE-TYPE-INVARIANTS]). Other modules never match `Absent` directly:
/// a qualified payload-free constructor is not a pattern in Osprey, so they
/// go through `fold`, `isPresent` and `orElse`.
module Maybe {
    export type Maybe<T> = Present { value: T } | Absent

    /// `present(value)` when present, else `absent`.
    export fn fold(maybe, absent, present) = match maybe {
        Present { value } => present(value)
        Absent => absent
    }

    /// True when a value is present.
    export fn isPresent(maybe) = match maybe {
        Present => true
        Absent => false
    }

    /// The value, or `fallback` when absent.
    export fn orElse(maybe, fallback) = match maybe {
        Present { value } => value
        Absent => fallback
    }

    /// `Present` of a successful result, or the failure unchanged.
    export fn ofResult(result) = match result {
        Success { value } => Success { value: Present { value: value } }
        Error { message } => Error { message: message }
    }

    /// A present value.
    export fn some(value) = Present { value: value }

    /// No value.
    export fn none() = Absent
}
