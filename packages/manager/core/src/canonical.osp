namespace registry;
import registry::Bytes
import registry::Json
import registry::Order

/// RFC 8785 (JSON Canonicalization Scheme) over Json values: no whitespace,
/// object members ordered by their keys' UTF-16 code unit sequences, and only
/// the escapes section 3.2.2.2 names. Recursion is monomorphic over the
/// concrete Json::Value tree, strings and ints (issue #277). Implements
/// [PACKAGE-TYPE-INVARIANTS].
module Canonical {
    let duplicateKey = "canonical.duplicate-key"
    let dquote = 34
    let backslashCp = 92
    let backspace = 8
    let tabCp = 9
    let lineFeed = 10
    let formFeed = 12
    let carriageReturn = 13
    let controlLimit = 32
    let planeBase = 65536
    let planeShift = 1024
    let highBase = 55296
    let lowBase = 56320

    /// The RFC 8785 3.2.2.2 escape of a quote, backslash or C0 control.
    fn escapeCodePoint(cp) = {
        if cp == dquote { "\\\"" }
        else if cp == backslashCp { "\\\\" }
        else if cp == backspace { "\\b" }
        else if cp == tabCp { "\\t" }
        else if cp == lineFeed { "\\n" }
        else if cp == formFeed { "\\f" }
        else if cp == carriageReturn { "\\r" }
        else { "\\u00" + Bytes::hexByte(cp) }
    }

    /// A byte copied to the output unchanged: anything but the quote, the
    /// backslash and C0 controls, so non-ASCII UTF-8 bytes pass through.
    fn literalByte(b) = b >= controlLimit && b != dquote && b != backslashCp

    /// Indices come from the string's byte range; literal UTF-8 bytes are copied unchanged.
    fn renderByte(s, i) = match byteAt(s, i) {
        Error => ""
        Success { value } => if literalByte(value) {
            match substring(s, i, i + 1) {
                Success { value } => value
                Error => ""
            }
        } else { escapeCodePoint(value) }
    }

    /// Join once instead of recursing and repeatedly copying a growing prefix.
    fn renderString(s) = "\"" + join(range(0, byteLength(s)) |> map(fn(i) => renderByte(s, i)) |> toList, "") + "\""

    /// Infallible rendering; `serialize` proves the tree has no duplicate keys.
    fn render(value) = match value {
        Json::Bool { flag } => if flag { "true" } else { "false" }
        Json::Num { value } => toString(value)
        Json::Str { text } => renderString(text)
        Json::Arr { items } => "[" + join(mapList(items, render), ",") + "]"
        Json::Obj { members } => "{" + join(mapList(sortMembers(members), renderMember), ",") + "}"
        _ => "null"
    }

    fn renderMember(m) = renderString(m.key) + ":" + render(m.value)

    /// An astral code point widens to its surrogate pair, high unit first.
    fn appendAstral(out, cp) = {
        let offset = cp - planeBase
        listAppend(listAppend(out, highBase + intDiv(offset, planeShift)), lowBase + (offset % planeShift))
    }

    /// The UTF-16 code units of a key, the RFC 8785 ordering key.
    fn utf16Units(s, i, out) = match i >= byteLength(s) {
        true => out
        false => {
            let cp = codePointAt(s, i) ?: 63
            let w = codePointWidth(cp) ?: 1
            if cp < planeBase {
                utf16Units(s, i + w, listAppend(out, cp))
            } else {
                utf16Units(s, i + w, appendAstral(out, cp))
            }
        }
    }

    fn units(s) = utf16Units(s, 0, [])

    fn unitHex(u) = Bytes::hexByte(intDiv(u, 256)) + Bytes::hexByte(u % 256)

    /// Four hex digits per UTF-16 code unit: byte order of this key is the
    /// RFC 8785 member order, and a strict prefix sorts first.
    fn memberKey(m) = join(mapList(units(m.key), unitHex), "")

    fn missingMember() = Json::Member { key: "", value: Json::Null }

    fn sortMembers(members) = mapList(Order::sortedIndexes(mapList(members, memberKey)), fn(i) => listGet(members, i) ?: missingMember())

    fn noDuplicateKeys(members) = Order::strictlyAscending(listSort(mapList(members, fn(m) => m.key)))

    /// A tree is serializable when no object repeats a key, at any depth.
    fn wellFormed(value) = match value {
        Json::Obj { members } => noDuplicateKeys(members) && foldList(members, true, fn(ok, m) => ok && wellFormed(m.value))
        Json::Arr { items } => foldList(items, true, fn(ok, v) => ok && wellFormed(v))
        _ => true
    }

    /// The RFC 8785 canonical form of `value`, or `"canonical.duplicate-key"`.
    /// Implements [PACKAGE-TYPE-INVARIANTS].
    export fn serialize(value) = match wellFormed(value) {
        true => Success { value: render(value) }
        false => Error { message: duplicateKey }
    }

    /// Parse strict JSON, then serialize canonically; a parse problem maps to
    /// its described form. Implements [PACKAGE-TYPE-INVARIANTS].
    export fn canonicalize(text) = match Json::parse(text) {
        Success { value } => serialize(value)
        Error { message } => Error { message: Json::describe(message) }
    }
}
