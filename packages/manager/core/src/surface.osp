namespace registry;
import registry::Order
import registry::Release

/// The capability surface of a release ([PACKAGE-CAPABILITY-CONFINEMENT]):
/// the ambient capabilities whose builtins its source names, plus its
/// `[system.*]` capabilities. Osprey has no reflection, string dispatch or
/// evaluation. The scan skips comments and literal text, descends into
/// executable interpolations and matches whole identifiers. A
/// builtin's name declared or called anywhere counts, so shadowing cannot
/// hide a call. `tests/fixtures/capabilities/builtins.json` carries the same
/// builtin-to-capability table as data.
module Surface {
    export let files = "io/files"
    export let process = "io/process"
    export let network = "io/network"
    export let terminal = "io/terminal"

    /// One ambient builtin and the capability it belongs to.
    export type Named = { builtin: string, capability: string }

    fn named(builtin, capability) = Named { builtin: builtin, capability: capability }

    /// The builtin-to-capability map of [PACKAGE-CAPABILITY-CONFINEMENT];
    /// every `http*` and `websocket*` builtin is `io/network` by prefix.
    export fn table() = [
        named("readFile", files), named("writeFile", files), named("gpuLoad", files), named("gpuLoadTensor", files), named("loadTensor", files),
        named("spawnProcess", process), named("awaitProcess", process), named("cleanupProcess", process),
        named("httpGet", network), named("httpPost", network), named("httpPostResponse", network), named("httpPut", network), named("httpDelete", network),
        named("httpListen", network), named("httpStopServer", network), named("httpCloseClient", network), named("httpResponseFree", network),
        named("websocketClose", network),
        named("input", terminal), named("termRawMode", terminal), named("termReadKey", terminal),
        named("termCols", terminal), named("termRows", terminal), named("termClear", terminal),
        named("termMoveCursor", terminal), named("termHideCursor", terminal), named("termShowCursor", terminal)
    ]

    fn builtinOf(n: Named) = n.builtin
    fn capabilityIn(n: Named) = n.capability

    fn listed(word) = foldList(table(), "", fn(found, n) => if found == "" && builtinOf(n) == word { capabilityIn(n) } else { found })

    /// The capability an identifier names, or "" for an ordinary name.
    export fn capabilityOf(word) = {
        let found = listed(word)
        if found != "" { found } else if startsWith(word, "http") || startsWith(word, "websocket") { network } else if startsWith(word, "term") && (byteAt(word, 4) ?: 0) >= 65 && (byteAt(word, 4) ?: 0) <= 90 { "io/unknown" } else { "" }
    }

    // Lex executable expressions, retaining the enclosing string on a stack
    // while an interpolation (and any nested braces or strings) is scanned.
    let quote = 34
    let apostrophe = 39
    let backslash = 92
    let slash = 47
    let newline = 10
    let carriageReturn = 13
    let horizontalWhitespace = [9, 11, 12, 32]
    // Literal U+FEFF: unsupported string escapes are preserved by the language.
    let bom = "﻿"
    let pythonMarker = "# osprey: flavor=python"
    let codeMode = 0
    let commentMode = 1
    let blockCommentMode = 2
    let tripleOffset = 100
    let formattedOffset = 200
    let declarers = ["fn", "let", "mut", "def"]

    // Default syntax also permits identifiers named extern; classify declarations, not references.
    let nativeDeclaration = "<extern>"
    let continuation = "<expression>"
    let expressionDelimiters = [61, 62, 60, 43, 45, 42, 47, 37, 38, 124, 94, 33, 63, 40, 91, 44, 58]
    type Scan = { mode: int, start: int, previous: string, found: List<string>, declared: List<string>, frames: List<int>, skip: int, python: bool, ml: bool, boundary: bool }

    fn begin(text) = Scan { mode: codeMode, start: -1, previous: "", found: [], declared: [], frames: [], skip: if startsWith(text, bom) { byteLength(bom) } else { 0 }, python: startsWith(text, pythonMarker) || startsWith(text, bom + pythonMarker), ml: false, boundary: true }

    fn identByte(s, b) = (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || ((s.ml || s.python) && b >= 128)

    fn lineBreak(b) = b == newline || b == carriageReturn

    fn between(text, from, to) = take(drop(text, from), to - from)

    fn declares(s: Scan, capability) = capability != "" && listContains(declarers, s.previous)

    fn closedWord(s, word) = {
        // Implements [PACKAGE-CAPABILITY-CONFINEMENT]: native calls have no classified grant.
        let capability = if s.previous == nativeDeclaration || (s.python && word == "extern" && s.previous == "@") { "io/unknown" } else { capabilityOf(word) }
        s {
            start: -1, previous: if !s.python && word == "extern" && s.boundary { nativeDeclaration } else { word },
            boundary: s.boundary && word == "export",
            found: if capability == "" { s.found } else { listAppend(s.found, capability) },
            declared: if declares(s, capability) { listAppend(s.declared, word) } else { s.declared }
        }
    }

    fn closed(text, s, i) = if s.start < 0 { s } else { closedWord(s, between(text, s.start, i)) }

    fn moved(s: Scan, mode, start, frames, skip) = s { mode: mode, start: start, frames: frames, skip: skip }

    fn separated(text, s, i, b) = {
        let c = closed(text, s, i)
        if lineBreak(b) { c { boundary: c.previous != continuation } }
        else if listContains(horizontalWhitespace, b) { c }
        else { c {
            boundary: b == 123 || b == 125 || b == 59,
            previous: if listContains(expressionDelimiters, b) && !(listContains(declarers, c.previous) && (b == 40 || b == 91)) { continuation }
                else if c.previous == nativeDeclaration || c.previous == continuation { "" } else { c.previous }
        } }
    }

    fn pushed(s, mode, skip) = moved(s, mode, -1, listPrepend(s.frames, s.mode), skip)

    fn popped(s, skip) = moved(s, listGet(s.frames, 0) ?: codeMode, -1, fold(range(1, length(s.frames)), [], fn(acc, j) => listAppend(acc, listGet(s.frames, j) ?: codeMode)), skip)

    fn atBoundary(s: Scan) = s { boundary: s.previous != continuation }

    fn byte(text, i) = byteAt(text, i) ?: 0

    fn triple(text, i, delimiter) = byte(text, i + 1) == delimiter && byte(text, i + 2) == delimiter

    fn bomAt(text, i) = byte(text, i) == byte(bom, 0) && byte(text, i + 1) == byte(bom, 1) && byte(text, i + 2) == byte(bom, 2)

    // The vendored Python lexer also accepts U+200B and U+2060 between tokens.
    fn pythonSpaceAt(text, i) = bomAt(text, i) || (byte(text, i) == 226 &&
        ((byte(text, i + 1) == 128 && byte(text, i + 2) == 139) || (byte(text, i + 1) == 129 && byte(text, i + 2) == 160)))

    fn formattedPrefix(word) = {
        let prefix = toLowerCase(word)
        fold(range(0, byteLength(prefix)), false, fn(found, i) => found || byte(prefix, i) == 102) &&
            fold(range(0, byteLength(prefix)), true, fn(valid, i) => valid && listContains([102, 114, 117], byte(prefix, i)))
    }

    fn stringStart(text, s, i, delimiter) = {
        let c = separated(text, s, i, delimiter)
        let formatted = s.python && s.start >= 0 && formattedPrefix(c.previous)
        let wide = s.python && triple(text, i, delimiter)
        pushed(c, delimiter + (if wide { tripleOffset } else { 0 }) + (if formatted { formattedOffset } else { 0 }), if wide { 2 } else { 0 })
    }

    fn inCode(text, s, i, b) = if s.python && pythonSpaceAt(text, i) { moved(closed(text, s, i), codeMode, -1, s.frames, 2) }
        else if identByte(s, b) { moved(s, codeMode, if s.start < 0 { i } else { s.start }, s.frames, 0) }
        else if s.python && b == 64 { closedWord(closed(text, s, i), "@") }
        else if s.ml && b == 40 && byte(text, i + 1) == 42 { pushed(closed(text, s, i), blockCommentMode, 1) }
        else if b == quote || (s.python && b == apostrophe) { stringStart(text, s, i, b) }
        else if (b == slash && byte(text, i + 1) == slash) || (s.python && b == 35) { pushed(closed(text, s, i), commentMode, 0) }
        else if b == 123 { pushed(separated(text, s, i, b), codeMode, 0) }
        else if b == 125 { popped(separated(text, s, i, b), 0) }
        else { separated(text, s, i, b) }

    fn inString(text, s, i, b) = {
        let delimiter = s.mode % tripleOffset
        let wide = s.mode % formattedOffset >= tripleOffset
        let formatted = s.mode >= formattedOffset
        if b == delimiter && (!wide || triple(text, i, delimiter)) { popped(s, if wide { 2 } else { 0 }) }
        else if b == backslash && !(formatted && byte(text, i + 1) == 123) && !(!s.python && byte(text, i + 1) == 36) { moved(s, s.mode, -1, s.frames, 1) }
        else if formatted && b == 123 && byte(text, i + 1) == 123 { moved(s, s.mode, -1, s.frames, 1) }
        else if formatted && b == 123 { pushed(s, codeMode, 0) }
        else if !s.python && b == 36 && byte(text, i + 1) == 123 { pushed(s, codeMode, 1) }
        else { s }
    }

    fn inBlockComment(text, s, i, b) = if b == 40 && byte(text, i + 1) == 42 { pushed(s, blockCommentMode, 1) }
        else if b == 42 && byte(text, i + 1) == 41 { popped(s, 1) }
        else if lineBreak(b) { atBoundary(s) } else { s }

    fn step(text, s, i) = {
        let b = byte(text, i)
        if s.skip > 0 { moved(s, s.mode, s.start, s.frames, s.skip - 1) }
        else if s.mode == commentMode { if lineBreak(b) { atBoundary(popped(s, 0)) } else { s } }
        else if s.mode == blockCommentMode { inBlockComment(text, s, i, b) }
        else if s.mode == codeMode { inCode(text, s, i, b) }
        else { inString(text, s, i, b) }
    }

    fn declaredIn(s: Scan) = s.declared

    fn foundIn(s: Scan) = s.found

    fn distinct(capabilities) = foldList(capabilities, [], fn(acc, c) => if listContains(acc, c) { acc } else { listAppend(acc, c) })

    /// Sorted and duplicate-free: a surface is a set.
    fn canonicalOrEmpty(capabilities) = listSort(distinct(capabilities))

    fn scanFrom(text, initial) = {
        let n = byteLength(text)
        closed(text, fold(range(0, n), initial, fn(s, i) => step(text, s, i)), n)
    }

    fn scanned(text) = scanFrom(text, begin(text))

    // Implements [FLAVOR-SELECT]: valid file markers agree with the extension.
    fn fileStart(f) = {
        let first = begin(contentOf(f))
        first { python: endsWith(pathOf(f), ".py"), ml: endsWith(pathOf(f), ".ospml") }
    }

    fn scannedFile(f) = scanFrom(contentOf(f), fileStart(f))

    /// The capabilities one source text names, as a canonical set.
    export fn ofText(text) = canonicalOrEmpty(foundIn(scanned(text)))

    /// The builtin names one source text declares with `fn`, `let` or `mut`,
    /// as a canonical set; a published package may declare none.
    export fn declaredBuiltins(text) = canonicalOrEmpty(declaredIn(scanned(text)))

    /// Whether any source file of a tree declares a builtin's name.
    export fn shadowsBuiltin(fileList) = foldList(fileList, false, fn(found, f) => found || shadowsFile(f))

    fn shadowsFile(f) = isSource(pathOf(f)) && !isEmpty(declaredIn(scannedFile(f)))

    fn isSource(path) = endsWith(path, ".osp") || endsWith(path, ".ospml") || endsWith(path, ".py")

    // `Release::File` shares no field name, but the receiver is typed like the
    // other readers (issue #273).
    fn pathOf(f: Release::File) = f.relPath
    fn contentOf(f: Release::File) = f.content

    /// The capabilities a tree's source files name, as a canonical set.
    export fn ofFiles(fileList) = canonicalOrEmpty(foldList(fileList, [], fn(acc, f) => if isSource(pathOf(f)) { listConcat(acc, foundIn(scannedFile(f))) } else { acc }))

    /// The surface of a release: its source scan plus its `[system.*]`
    /// capabilities, as a canonical set.
    export fn ofRelease(fileList, systemCapabilities) = canonicalOrEmpty(listConcat(ofFiles(fileList), systemCapabilities))
}
