namespace registry;
import registry::Bytes
import registry::Digests
import registry::Paths
import registry::Order
import registry::Sha256
import registry::Domains

/// The canonical source envelope hashed into `SourceDigest`:
/// `entry = u32be(length(path)) || path || 0x00 || u64be(length(file)) || SHA256(file)`
/// over entries sorted by unsigned path bytes, under
/// `"osprey.source.v1\0" || u32be(entryCount)`. The sole v1 file-mode class
/// is `0x00`, regular and non-executable. Implements [PACKAGE-SOURCE-CANONICAL].
module Source {
    export type Entry = { path: string, byteLength: int, digest: List<int> }

    let regularFile = 0
    let regularKind = "regular"
    // `special` is what a directory walk reports when it cannot tell a
    // symlink, device, FIFO or socket apart; every one of them rejects.
    let forbiddenKinds = ["symlink", "submodule", "device", "fifo", "socket", "executable", "hardlink", "special"]
    let lfsPrefix = "version https://git-lfs.github.com/spec/v1"
    let maxFiles = 10000
    let maxTotalBytes = 52428800
    let maxAssetBytes = 26214400

    /// Why a collected entry of this kind rejects the tree; `""` for a regular file.
    export fn kindCode(kind) = if kind == regularKind { "" }
        else if listContains(forbiddenKinds, kind) { "source.kind.${kind}" }
        else { "source.kind.unknown" }

    /// True when the bytes are a Git LFS pointer instead of the file ([PACKAGE-IDENTITY]).
    export fn lfsPointer(content) = startsWith(content, lfsPrefix)

    /// Why a submission exceeds the fixed bounds of [PACKAGE-PUBLISH]; `""` within them.
    export fn limitCode(fileCount, totalBytes, assetBytes) = if fileCount > maxFiles { "source.too-many-files" }
        else if totalBytes > maxTotalBytes { "source.too-large" }
        else if assetBytes > maxAssetBytes { "source.assets-too-large" }
        else { "" }

    // `Entry` shares `digest` with `Identity::ReleaseId`; issue #273 makes an
    // untracked receiver a codegen error, so these spell the record out.
    fn entryBytes(entry: Entry) = Bytes::concatAll([
        Bytes::u32be(byteLength(entry.path)),
        Bytes::ofString(entry.path),
        [regularFile],
        Bytes::u64be(entry.byteLength),
        entry.digest
    ])

    fn entryCode(entry: Entry) = match Paths::validate(entry.path) {
        Error { message } => message
        Success => if Paths::excluded(entry.path) { "source.excluded-path" }
            else if entry.byteLength < 0 { "source.negative-length" }
            else if !Digests::rawWellFormed(entry.digest) { "source.digest-length" }
            else { "" }
    }

    fn firstCode(entries) = foldList(entries, "", fn(code, entry) => if code == "" { entryCode(entry) } else { code })

    fn pathKey(entry: Entry) = Bytes::hex(Bytes::ofString(entry.path))

    fn missingEntry() = Entry { path: "", byteLength: 0, digest: [] }

    /// Entries in unsigned path-byte order: hex keys sort exactly as the bytes do.
    fn byPath(entries) = mapList(Order::sortedIndexes(mapList(entries, pathKey)), fn(i) => listGet(entries, i) ?: missingEntry())

    fn header(count) = listConcat(Bytes::ofString(Domains::sourceTreeDomain()), listConcat([0], Bytes::u32be(count)))

    fn encode(sorted) = listConcat(header(length(sorted)), Bytes::concatAll(mapList(sorted, entryBytes)))

    fn sortedUnique(entries) = match Paths::canonicalSet(mapList(entries, fn(e) => e.path)) {
        Error { message } => Error { message: message }
        Success => Success { value: byPath(entries) }
    }

    /// One entry from a path and the file's bytes.
    export fn entryOf(path, content) = Entry { path: path, byteLength: length(content), digest: Sha256::digest(content) }

    /// `SourceDigest`: the `sha256:` envelope of the tree envelope, or a reason code.
    export fn digest(entries) = match envelope(entries) {
        Success { value } => Success { value: Digests::format(Sha256::digest(value)) }
        Error { message } => Error { message: message }
    }

    /// The envelope bytes for a validated, sorted, collision-free tree.
    export fn envelope(entries) = match firstCode(entries) {
        "" => match sortedUnique(entries) {
            Success { value } => Success { value: encode(value) }
            Error { message } => Error { message: message }
        }
        code => Error { message: code }
    }
}
