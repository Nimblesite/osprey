namespace registry;
import registry::Bytes
import registry::Sha256

/// Digest envelopes `sha256:<64 lowercase hex>` and the domain-separated
/// preimage `ASCII(d) || 0x00 || u64be(length(x)) || x` behind every
/// `H(d, x)` in [PACKAGE-TYPE-INVARIANTS]. The algorithm prefix lets a later
/// format revision add another algorithm without reinterpreting identifiers
/// ([PACKAGE-IDENTITY]).
module Digests {
    let algorithm = "sha256"
    let prefix = "sha256:"
    let hexLength = 64
    let digestBytes = 32

    fn allLowerHex(s) = Bytes::lowerHexBetween(s, 0, byteLength(s))

    /// The envelope of raw digest bytes.
    export fn format(bytes) = prefix + Bytes::hex(bytes)

    fn checkHex(hex) = match byteLength(hex) == hexLength {
        false => Error { message: "digest.length" }
        true => match allLowerHex(hex) {
            true => Success { value: prefix + hex }
            false => Error { message: "digest.hex" }
        }
    }

    /// A well-formed envelope, or the reason it is not.
    export fn parse(text) = match startsWith(text, prefix) {
        false => Error { message: "digest.algorithm" }
        true => checkHex(drop(text, byteLength(prefix)))
    }

    /// The bare hex of a well-formed envelope.
    export fn hexOf(envelope) = drop(envelope, byteLength(prefix))

    /// True for exactly 32 well-formed bytes.
    export fn rawWellFormed(bytes) = length(bytes) == digestBytes && Bytes::wellFormed(bytes)

    /// `ASCII(domain) || 0x00 || u64be(length(payload)) || payload`.
    export fn preimage(domain, payload) = Bytes::concatAll([
        Bytes::ofString(domain),
        [0],
        Bytes::u64be(length(payload)),
        payload
    ])

    /// `H(domain, payload)`: the envelope of SHA-256 over the domain-separated preimage.
    export fn hash(domain, payload) = format(Sha256::digest(preimage(domain, payload)))

    /// `H(domain, text)` over a string's bytes, for canonical JSON payloads.
    export fn hashText(domain, text) = hash(domain, Bytes::ofString(text))

    /// The algorithm name every v1 envelope carries.
    export fn algorithmName() = algorithm
}
