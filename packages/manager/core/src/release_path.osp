namespace registry;
import registry::Identity
import registry::Names

/// Release directory paths `@scope/name/<epoch>.<ordinal>` relative to the
/// registry root. The key reuses [PACKAGE-NAMES]; the version is the epoch
/// and ordinal of [PACKAGE-IDENTITY], parsed by `Identity::numbers`.
/// Failures are stable reason codes. Implements [PACKAGE-FOLDER-REGISTRY].
module ReleasePath {
    let segmentsCode = "release-path.segments"
    let versionCode = "release-path.version"
    let slashByte = 47
    fn slashCount(text) = fold(range(0, byteLength(text)), 0, fn(n, i) => n + (if (byteAt(text, i) ?: 0) == slashByte { 1 } else { 0 }))

    fn keyText(dir, first, second) = take(dir, first + 1 + second)
    fn versionText(dir, first, second) = drop(dir, first + 2 + second)

    fn afterFirst(dir, first) = match indexOf(drop(dir, first + 1), "/") {
        Error => Error { message: segmentsCode }
        Success { value } => build(keyText(dir, first, value), versionText(dir, first, value))
    }

    fn build(keyText, versionText) = match Names::parse(keyText) {
        Error { message } => Error { message: message }
        Success { value } => withVersion(value, versionText)
    }

    fn withVersion(key, versionText) = match version(versionText) {
        Success { value } => Success { value: Identity::ReleaseId { key: key, epoch: listGet(value, 0) ?: 0, ordinal: listGet(value, 1) ?: 0, digest: "" } }
        Error { message } => Error { message: message }
    }

    /// `ReleaseId` and `Json::Member` share `key`; issue #273 needs the
    /// receiver spelled out when reading that shared field.
    export fn format(id: Identity::ReleaseId) = "${Names::display(id.key)}/${id.epoch}.${id.ordinal}"

    /// Parse a release directory into its identity, or a stable reason code.
    export fn parse(dir) = match slashCount(dir) == 2 {
        false => Error { message: segmentsCode }
        true => match indexOf(dir, "/") {
            Error => Error { message: segmentsCode }
            Success { value } => afterFirst(dir, value)
        }
    }

    fn version(text) = match split(text, ".") {
        Success { value } => if length(value) == 2 { Identity::numbers(listGet(value, 0) ?: "", listGet(value, 1) ?: "") } else { Error { message: versionCode } }
        Error => Error { message: versionCode }
    }
}
