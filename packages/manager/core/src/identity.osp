namespace registry;
import registry::Names
import registry::Order
import registry::Digests

/// Release identity `@scope/name@e3.r42#sha256:…`: a registry-assigned
/// compatibility epoch, a package-wide strictly increasing ordinal and the
/// authoritative digest. Tags, branches and SemVer never appear.
/// Implements [PACKAGE-IDENTITY].
module Identity {
    export type ReleaseId = { key: Names::Key, epoch: int, ordinal: int, digest: string }

    let firstEpoch = 1
    let firstOrdinal = 1

    // `ReleaseId` and `Source::Entry` both declare `digest`; until issue #273
    // lands, codegen needs the receiver's record spelled out.
    /// The display form.
    export fn display(id: ReleaseId) = "${Names::display(id.key)}@e${id.epoch}.r${id.ordinal}#${id.digest}"

    /// Identity equality: same key, epoch, ordinal and digest.
    export fn same(a: ReleaseId, b: ReleaseId) = Names::same(a.key, b.key) && a.epoch == b.epoch && a.ordinal == b.ordinal && a.digest == b.digest

    /// The identity no release has: the `?:` fallback of every release lookup.
    export fn blank() = ReleaseId { key: Names::blank(), epoch: 0, ordinal: 0, digest: "" }

    fn positive(text, floor, code) = match parseInt(text) {
        Success { value } => if value >= floor && !startsWith(text, "+") && !startsWith(text, "0") { Success { value: value } } else { Error { message: code } }
        Error => Error { message: code }
    }

    fn version(text) = match startsWith(text, "e") {
        false => Error { message: "release.version" }
        true => match split(drop(text, 1), ".r") {
            Success { value } => versionParts(value)
            Error => Error { message: "release.version" }
        }
    }

    fn versionParts(parts) = match length(parts) == 2 {
        false => Error { message: "release.version" }
        true => numbers(listGet(parts, 0) ?: "", listGet(parts, 1) ?: "")
    }

    /// `[epoch, ordinal]` from their decimal spellings: positive, no sign, no
    /// leading zero; otherwise `release.epoch` or `release.ordinal`. Shared by
    /// every textual form of a release version.
    export fn numbers(epochText, ordinalText) = match positive(epochText, firstEpoch, "release.epoch") {
        Success { value } => ordinalWith(value, ordinalText)
        Error { message } => Error { message: message }
    }

    fn ordinalWith(epoch, text) = match positive(text, firstOrdinal, "release.ordinal") {
        Success { value } => Success { value: [epoch, value] }
        Error { message } => Error { message: message }
    }

    fn assemble(key, numbers, digest) = ReleaseId {
        key: key,
        epoch: listGet(numbers, 0) ?: 0,
        ordinal: listGet(numbers, 1) ?: 0,
        digest: digest
    }

    fn withKey(head, digest) = match indexOf(drop(head, 1), "@") {
        Error => Error { message: "release.missing-version" }
        Success { value } => withParts(take(head, value + 1), drop(head, value + 2), digest)
    }

    fn withParts(keyText, versionText, digest) = match Names::parse(keyText) {
        Error { message } => Error { message: message }
        Success { value } => withVersion(value, versionText, digest)
    }

    fn withVersion(key, versionText, digest) = match version(versionText) {
        Success { value } => Success { value: assemble(key, value, digest) }
        Error { message } => Error { message: message }
    }

    /// Parse a display form; failures are reason codes.
    export fn parse(text) = match split(text, "#") {
        Error => Error { message: "release.missing-digest" }
        Success { value } => match length(value) == 2 {
            false => Error { message: "release.missing-digest" }
            true => parseHalves(listGet(value, 0) ?: "", listGet(value, 1) ?: "")
        }
    }

    fn parseHalves(head, digestText) = match Digests::parse(digestText) {
        Error { message } => Error { message: message }
        Success { value } => withKey(head, value)
    }

    /// Canonical `(package, epoch, ordinal, digest)` order.
    export fn compare(a: ReleaseId, b: ReleaseId) = Order::thenCompare(Names::compare(a.key, b.key),
        Order::thenCompare(Order::compareInts(a.epoch, b.epoch),
            Order::thenCompare(Order::compareInts(a.ordinal, b.ordinal), Order::compareStrings(a.digest, b.digest))))
}
