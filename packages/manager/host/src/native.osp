namespace registry_host;
import registry_host::Host

/// Operating-system handlers for `Host`, built only on Osprey builtins.
/// Process output is captured through shell redirection into `.osprey/scratch`
/// because `spawnProcess` streams chunks to a callback and Osprey has no
/// mutable accumulator outside handler arms.
module Native {
    let scratch = ".osprey/scratch"

    fn relay(result) = match result {
        Success { value } => Success { value: value }
        Error { message } => Error { message: message }
    }

    /// Files answered by `readFile`/`writeFile`.
    export fn files() = handler Host::Files {
        read path => relay(readFile(path))
        write path content => relay(writeFile(path, content))
    }

    fn quiet(_pid, _kind, text) = {
        let _dropped = text
    }

    fn status(spawned) = match spawned {
        Success { value } => awaitProcess(value)
        Error => -1
    }

    fn capture(command) = {
        let tag = "${random()}"
        let out = "${scratch}/${tag}.out"
        let err = "${scratch}/${tag}.err"
        let code = status(spawnProcess("mkdir -p ${scratch} && ( ${command} ) >${out} 2>${err}", quiet))
        Host::Run { status: code, stdout: readFile(out) ?: "", stderr: readFile(err) ?: "" }
    }

    /// Process answered by the system shell.
    export fn process() = handler Host::Process {
        run command => capture(command)
    }

    fn relative(line) = if startsWith(line, "./") { drop(line, 2) } else { line }

    fn listed(run) = listSort(mapList(filterList(split(run.stdout, "\n") ?: [], fn(l) => l != ""), relative))

    fn found(root, test) = capture("cd ${Host::shellWord(root)} && find . ${test}")

    /// The walk, or `host.tree.unreadable` with the OS reason. Osprey has no
    /// directory builtin yet (`files.directory`), so `find` lists the entries.
    fn walked(root) = {
        let regular = found(root, "-type f -links 1 ! -perm -u+x")
        let executable = found(root, "-type f -links 1 -perm -u+x")
        let special = found(root, "! -type d ! -type f -o -type f ! -links 1")
        let failed = if regular.status != 0 { regular } else if executable.status != 0 { executable } else { special }
        if failed.status != 0 { Error { message: "host.tree.unreadable: ${trim(failed.stderr)}" } }
        else { Success { value: Host::Walk { regular: listed(regular), executable: listed(executable), special: listed(special) } } }
    }

    fn ensured(dir) = {
        let made = capture("mkdir -p ${Host::shellWord(dir)}")
        if made.status == 0 { Success { value: 0 } } else { Error { message: "host.mkdir: ${trim(made.stderr)}" } }
    }

    /// Tree answered by the system `find` and `mkdir -p`.
    export fn tree() = handler Host::Tree {
        walk root => walked(root)
        ensure dir => ensured(dir)
    }

    let timeoutMs = 10000

    fn replyOf(response) = {
        let reply = Host::Reply {
            status: httpResponseStatus(response),
            etag: httpResponseHeader(response, "etag") ?: "",
            body: httpResponseBody(response) ?: ""
        }
        let _freed = httpResponseFree(response)
        Success { value: reply }
    }

    fn fetched(base, path) = {
        let client = httpCreateClient(base, timeoutMs)
        let answer = match httpGetResponse(client, path, "") {
            Success { value } => replyOf(value)
            Error { message } => Error { message: "http.transport: ${message}" }
        }
        let _closed = httpCloseClient(client)
        answer
    }

    /// Web answered by the runtime HTTP client.
    export fn web() = handler Host::Web {
        get base path => fetched(base, path)
    }

    /// Console answered by standard output.
    export fn console() = handler Host::Console {
        line text => print(text)
    }

    /// Run `body` with every native handler installed.
    export fn session(body) = files()(fn() => process()(fn() => tree()(fn() => web()(fn() => console()(body)))))
}
