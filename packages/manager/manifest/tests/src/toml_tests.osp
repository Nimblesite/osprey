namespace registry_tests;
import registry::Toml
import registry::TomlLexer

/// The TOML subset parser from [PACKAGE-MANIFEST]: the exact spec manifest,
/// array-of-tables and dotted-key documents, accessors, escape decoding,
/// integer edges and every rejection reason with its byte position.
module TomlTests {
    fn render(v) = match v {
        Toml::Str { text } => "\"${text}\""
        Toml::Int { value } => toString(value)
        Toml::Bool { flag } => if flag { "true" } else { "false" }
        Toml::Arr { items } => "[" + join(mapList(items, render), ",") + "]"
        Toml::Table { pairs } => "{" + join(mapList(pairs, fn(p) => "${p.key}=${render(p.value)}"), ",") + "}"
    }

    fn renderRoot(result) = match result {
        Success { value } => render(value)
        Error { message } => message
    }

    fn codeAt(result) = match result {
        Success => ""
        Error { message } => message
    }

    fn getCode(result) = match result {
        Success => ""
        Error { message } => message
    }

    fn firstText(result) = match result {
        Success { value } => match Toml::get(value, "a") {
            Success { value } => match value {
                Toml::Str { text } => text
                _ => ""
            }
            Error => ""
        }
        Error => ""
    }

    fn ctrl1() = fromCodePoint(1) ?: ""

    let manifest = "[project]\nname = \"ledger\"\nsource_roots = [\"src\"]\n[package]\nname = \"@finch/ledger\"\nlicense = \"Apache-2.0\"\nsummary = \"Immutable ledger primitives\"\nkeywords = [\"ledger\", \"transactions\"]\n[dependencies]\n\"@osprey/http\" = { epoch = 2, min_release = 17 }\n[system.sqlite]\ncapability = \"sqlite/c-api\"\nmin_revision = 3045000\n"

    fn manifestDoc() = checkAll("the [PACKAGE-MANIFEST] example parses into the typed tree", [
        renderRoot(Toml::parse(manifest)) == "{project={name=\"ledger\",source_roots=[\"src\"]},package={name=\"@finch/ledger\",license=\"Apache-2.0\",summary=\"Immutable ledger primitives\",keywords=[\"ledger\",\"transactions\"]},dependencies={@osprey/http={epoch=2,min_release=17}},system={sqlite={capability=\"sqlite/c-api\",min_revision=3045000}}}",
        join(Toml::keys(Toml::parse(manifest) ?: Toml::Table { pairs: [] }), ",") == "project,package,dependencies,system"
    ])

    fn arrayTables() = checkAll("[[assets]] appends one table per header", [
        renderRoot(Toml::parse("[[assets]]\nname = \"logo\"\npath = \"logo.png\"\n\n[[assets]]\nname = \"icon\"\npath = \"icon.png\"\n")) == "{assets=[{name=\"logo\",path=\"logo.png\"},{name=\"icon\",path=\"icon.png\"}]}"
    ])

    fn dottedKeys() = checkAll("dotted keys create nested tables", [
        renderRoot(Toml::parse("a.b.c = 1\na.b.d = 2\na.e = 3\n")) == "{a={b={c=1,d=2},e=3}}"
    ])

    fn accessors() = {
        let root = Toml::parse(manifest) ?: Toml::Table { pairs: [] }
        let project = Toml::get(root, "project") ?: Toml::Table { pairs: [] }
        let name = Toml::get(project, "name") ?: Toml::Str { text: "" }
        checkAll("get/keys follow document order and reason codes", [
            render(name) == "\"ledger\"",
            getCode(Toml::get(root, "project")) == "",
            getCode(Toml::get(root, "nope")) == "toml.missing-key",
            getCode(Toml::get(name, "x")) == "toml.not-a-table",
            join(Toml::keys(project), ",") == "name,source_roots"
        ])
    }

    fn escapes() = checkAll("escapes and raw UTF-8 decode to the right bytes", [
        byteLength(firstText(Toml::parse("a = \"é\""))) == 2,
        byteLength(firstText(Toml::parse("a = \"\\u00E9\""))) == 2,
        byteLength(firstText(Toml::parse("a = \"\\U0001F600\""))) == 4,
        firstText(Toml::parse("a = \"\\n\"")) == "\n",
        firstText(Toml::parse("a = \"x\\ty\"")) == "x\ty",
        firstText(Toml::parse("a = \"\\\"\"")) == "\"",
        firstText(Toml::parse("a = \"\\\\\"")) == "\\"
    ])

    fn integers() = checkAll("decimal integers, separators and the 64-bit edges", [
        renderRoot(Toml::parse("a = 9223372036854775807\n")) == "{a=9223372036854775807}",
        renderRoot(Toml::parse("a = -9223372036854775808\n")) == "{a=-9223372036854775808}",
        renderRoot(Toml::parse("a = 1_000\n")) == "{a=1000}",
        renderRoot(Toml::parse("a = +5\n")) == "{a=5}",
        renderRoot(Toml::parse("a = -0\n")) == "{a=0}",
        Toml::describe(Toml::Problem { code: "toml.duplicate-key", line: 2, column: 7 }) == "toml.duplicate-key at 2:7"
    ])

    fn arrays() = checkAll("arrays allow trailing commas, blank lines and comments", [
        renderRoot(Toml::parse("a = [1, 2,]\n")) == "{a=[1,2]}",
        renderRoot(Toml::parse("a = [\n  1, # one\n  2,\n]\n")) == "{a=[1,2]}",
        renderRoot(Toml::parse("a = []\n")) == "{a=[]}",
        renderRoot(Toml::parse("a = ['lit', \"str\", true, false]\n")) == "{a=[\"lit\",\"str\",true,false]}"
    ])

    fn rejections() = checkAll("every rejection reason names its byte position", [
        codeAt(Toml::parse("a = 3.14")) == "toml.unsupported-float at 1:5",
        codeAt(Toml::parse("a = 1979-05-27")) == "toml.unsupported-datetime at 1:5",
        codeAt(Toml::parse("a = \"\"\"x\"\"\"")) == "toml.unsupported-multiline-string at 1:5",
        codeAt(Toml::parse("a = 1\na = 2")) == "toml.duplicate-key at 2:1",
        codeAt(Toml::parse("a = 1\na.b = 2")) == "toml.not-a-table at 2:1",
        codeAt(Toml::parse("a = \"\\q\"")) == "toml.bad-escape at 1:7",
        codeAt(Toml::parse("a = \"x" + ctrl1() + "\"")) == "toml.control-character at 1:7",
        codeAt(Toml::parse("a = \"abc")) == "toml.unterminated-string at 1:5",
        codeAt(Toml::parse("a 1")) == "toml.expected-equals at 1:3",
        codeAt(Toml::parse("a =")) == "toml.expected-value at 1:4",
        codeAt(Toml::parse("a = 1 x")) == "toml.trailing-text at 1:7",
        codeAt(Toml::parse("a = [1, 2")) == "toml.unterminated-array at 1:5",
        codeAt(Toml::parse("a = {b = 1")) == "toml.unterminated-inline-table at 1:5",
        codeAt(Toml::parse("a@b = 1")) == "toml.bad-key at 1:2",
        codeAt(Toml::parse("= 1")) == "toml.empty-key at 1:1",
        codeAt(Toml::parse("a = 9223372036854775808")) == "toml.integer-range at 1:5",
        codeAt(Toml::parse("a = 1_")) == "toml.bad-integer at 1:5",
        codeAt(Toml::parse("a = {b = 1\nc = 2}")) == "toml.inline-table-newline at 1:11",
        codeAt(Toml::parse("a = {b = 1, }")) == "toml.inline-table-trailing-comma at 1:13",
        codeAt(Toml::parse("a = " + (fromCodePoint(233) ?: ""))) == "toml.non-ascii at 1:5",
        codeAt(Toml::parse("a = @")) == "toml.unexpected-token at 1:5"
    ])

    fn scannedMatches(result, expected, offset) = match result {
        Success { value } => value.text == expected && value.at.at == offset && value.at.line == 1 && value.at.column == offset + 1
        Error => false
    }

    fn longQuotedStrings() = {
        let plain = repeat("s", 4096) ?: ""
        let escaped = repeat("\\t", 4096) ?: ""
        let unicode = repeat("\\u0073", 4096) ?: ""
        checkAll("long strings retain decoded bytes, cursors and exact failures", [
            byteLength(plain) == 4096,
            scannedMatches(TomlLexer::basicString(TomlLexer::start("\"${plain}\" trailing")), plain, 4098),
            scannedMatches(TomlLexer::basicString(TomlLexer::start("\"${escaped}\"")), repeat("\t", 4096) ?: "", 8194),
            scannedMatches(TomlLexer::basicString(TomlLexer::start("\"${unicode}\"")), plain, 24578),
            scannedMatches(TomlLexer::literalString(TomlLexer::start("'${plain}' trailing")), plain, 4098),
            codeAt(TomlLexer::basicString(TomlLexer::start("\"${plain}"))) == "toml.unterminated-string at 1:1",
            codeAt(TomlLexer::literalString(TomlLexer::start("'${plain}\n"))) == "toml.unterminated-string at 1:1",
            codeAt(TomlLexer::basicString(TomlLexer::start("\"${plain}${fromCodePoint(1) ?: ""}\""))) == "toml.control-character at 1:4098"
        ])
    }

    fn cursorIs(c, offset, line, column) = c.at == offset && c.line == line && c.column == column

    fn longByteRuns() = {
        let plain = repeat("x", 8192) ?: ""
        checkAll("long byte runs preserve boundaries and positions", [
            cursorIs(TomlLexer::skipSpaces(TomlLexer::start("${repeat(" ", 8192) ?: ""}x")), 8192, 1, 8193),
            cursorIs(TomlLexer::skipTrivia(TomlLexer::start("#${plain}\nx")), 8194, 2, 1),
            cursorIs(TomlLexer::skipTrivia(TomlLexer::start("${repeat("\n", 4096) ?: ""}x")), 4096, 4097, 1),
            match TomlLexer::scanBare(TomlLexer::start("${plain}#tail")) {
                Success { value } => value.token == plain && cursorIs(value.at, 8192, 1, 8193)
                Error => false
            },
            codeAt(TomlLexer::scanBare(TomlLexer::start("${plain}${fromCodePoint(233) ?: ""}"))) == "toml.non-ascii at 1:8193"
        ])
    }

    export fn run() = {
        test("toml: manifest example", manifestDoc)
        test("toml: array-of-tables", arrayTables)
        test("toml: dotted keys", dottedKeys)
        test("toml: accessors", accessors)
        test("toml: escapes", escapes)
        test("toml: integers", integers)
        test("toml: arrays", arrays)
        test("toml: rejections", rejections)
        test("toml: long quoted strings", longQuotedStrings)
        test("toml: long byte runs", longByteRuns)
    }
}
