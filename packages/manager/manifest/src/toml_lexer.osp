namespace registry;

/// Character-level scanning for the TOML subset Osprey manifests use: a byte
/// cursor with 1-based byte line/column, whitespace/comment trivia, bare-token
/// scanning and single-line string decoding with escape expansion. This module
/// knows nothing about the document structure; it only moves over bytes.
/// Failures are `code at line:column` strings, never prose.
/// Implements the lexical half of [PACKAGE-MANIFEST].
module TomlLexer {
    export type Cursor = { text: string, at: int, line: int, column: int }
    export type Scan = { token: string, at: Cursor }
    export type Text = { text: string, at: Cursor }

    let space = 32
    let tab = 9
    let cr = 13
    let newline = 10
    let quote = 34
    let apostrophe = 39
    let backslash = 92
    let hash = 35
    let comma = 44
    let eq = 61
    let rbracket = 93
    let rbrace = 125
    let nonAsciiFloor = 128
    let del = 127

    fn failStr(code, c) = "${code} at ${c.line}:${c.column}"

    /// The cursor at the first byte of `text`, line 1, column 1.
    export fn start(text) = Cursor { text: text, at: 0, line: 1, column: 1 }

    /// True once the cursor has passed the last byte.
    export fn eof(c) = c.at >= byteLength(c.text)

    /// The byte under the cursor, or -1 past the end.
    export fn cur(c) = byteAt(c.text, c.at) ?: -1

    /// The byte `n` positions ahead of the cursor, or -1 past the end.
    export fn peek(c, n) = byteAt(c.text, c.at + n) ?: -1

    /// Advance one byte within the current line.
    export fn advance(c) = Cursor { text: c.text, at: c.at + 1, line: c.line, column: c.column + 1 }

    /// Advance past one newline byte onto the next line.
    export fn breakLine(c) = Cursor { text: c.text, at: c.at + 1, line: c.line + 1, column: 1 }

    fn isSpaceByte(b) = b == space || b == tab || b == cr

    /// Skip horizontal whitespace (space, tab, carriage return).
    export fn skipSpaces(c) = skipSpacesUpTo(c)
    fn skipSpacesUpTo(c) = match isSpaceByte(cur(c)) {
        true => skipSpacesUpTo(advance(c))
        false => c
    }

    fn commentEnd(c) = match cur(c) == newline || eof(c) {
        true => c
        false => commentEnd(advance(c))
    }

    /// Skip whitespace, `#` comments and whole newlines; the cursor lands on
    /// the first significant byte or at EOF.
    export fn skipTrivia(c) = skipTriviaUpTo(c)
    fn skipTriviaUpTo(c) = {
        let c1 = skipSpaces(c)
        match cur(c1) == hash {
            true => skipTriviaUpTo(commentEnd(c1))
            false => match cur(c1) == newline {
                true => skipTriviaUpTo(breakLine(c1))
                false => c1
            }
        }
    }

    /// After a value or header: whitespace and one `#` comment are allowed;
    /// the cursor is left at the newline or EOF. Anything else is a reason.
    export fn skipLineTail(c) = skipLineTailUpTo(skipSpaces(c))
    fn skipLineTailUpTo(c) = match cur(c) == hash {
        true => Success { value: commentEnd(c) }
        false => match cur(c) == newline || eof(c) {
            true => Success { value: c }
            false => match cur(c) >= nonAsciiFloor {
                true => Error { message: failStr("toml.non-ascii", c) }
                false => Error { message: failStr("toml.trailing-text", c) }
            }
        }
    }

    fn oneByte(c) = substring(c.text, c.at, c.at + 1) ?: ""

    fn bareTerm(b) = b == space || b == tab || b == cr || b == newline || b == comma || b == rbracket || b == rbrace || b == hash || b == eq || b == -1

    /// The bare token up to the next value terminator; a non-ASCII byte fails.
    export fn scanBare(c) = scanBareUpTo(c, "")
    fn scanBareUpTo(c, acc) -> Result<Scan, string> = match bareTerm(cur(c)) {
        true => Success { value: Scan { token: acc, at: c } }
        false => match cur(c) >= nonAsciiFloor {
            true => Error { message: failStr("toml.non-ascii", c) }
            false => scanBareUpTo(advance(c), acc + oneByte(c))
        }
    }

    fn controlByte(b) = (b < 32 && b != tab) || b == del

    /// A basic `"..."` string from its opening quote, escapes decoded. Control
    /// bytes other than tab, newlines and the end of input are rejected.
    export fn basicString(c) = basicStringUpTo(advance(c), "", c)
    // Recursive scanners spell out their return types: codegen cannot infer a
    // recursive function's result type on its own.
    fn basicStringUpTo(c, acc, start) -> Result<Text, string> = match eof(c) {
        true => Error { message: failStr("toml.unterminated-string", start) }
        false => match cur(c) == quote {
            true => Success { value: Text { text: acc, at: advance(c) } }
            false => match cur(c) == backslash {
                true => basicEscape(advance(c), acc, start)
                false => match cur(c) == newline {
                    true => Error { message: failStr("toml.unterminated-string", start) }
                    false => match controlByte(cur(c)) {
                        true => Error { message: failStr("toml.control-character", c) }
                        false => basicStringUpTo(advance(c), acc + oneByte(c), start)
                    }
                }
            }
        }
    }

    fn basicEscape(c, acc, start) = match eof(c) {
        true => Error { message: failStr("toml.unterminated-string", start) }
        false => escapeByte(cur(c), c, acc, start)
    }

    fn escapeByte(b, c, acc, start) =
        if b == quote { basicStringUpTo(advance(c), acc + "\"", start) }
        else if b == backslash { basicStringUpTo(advance(c), acc + "\\", start) }
        else if b == 98 { basicStringUpTo(advance(c), acc + (fromCodePoint(8) ?: ""), start) }
        else if b == 116 { basicStringUpTo(advance(c), acc + "\t", start) }
        else if b == 110 { basicStringUpTo(advance(c), acc + "\n", start) }
        else if b == 102 { basicStringUpTo(advance(c), acc + (fromCodePoint(12) ?: ""), start) }
        else if b == 114 { basicStringUpTo(advance(c), acc + "\r", start) }
        else if b == 117 { unicodeEscape(advance(c), acc, start, 4) }
        else if b == 85 { unicodeEscape(advance(c), acc, start, 8) }
        else { Error { message: failStr("toml.bad-escape", c) } }

    fn hexVal(b) = if b >= 48 && b <= 57 { b - 48 }
        else if b >= 97 && b <= 102 { b - 87 }
        else if b >= 65 && b <= 70 { b - 55 }
        else { -1 }

    fn readHex(c, n, acc) -> Result<int, string> = match n == 0 {
        true => Success { value: acc }
        false => match eof(c) {
            true => Error { message: failStr("toml.bad-escape", c) }
            false => {
                let d = hexVal(cur(c))
                match d == -1 {
                    true => Error { message: failStr("toml.bad-escape", c) }
                    false => readHex(advance(c), n - 1, acc * 16 + d)
                }
            }
        }
    }

    fn unicodeEscape(c, acc, start, n) = match readHex(c, n, 0) {
        Error { message } => Error { message: message }
        Success { value } => unicodeEscapeChar(c, n, acc, start, value)
    }

    fn unicodeEscapeChar(c, n, acc, start, cp) = match fromCodePoint(cp) {
        Success { value } => basicStringUpTo(afterHex(c, n), acc + value, start)
        Error => Error { message: failStr("toml.bad-escape", start) }
    }

    fn afterHex(c, n) = match n == 0 {
        true => c
        false => afterHex(advance(c), n - 1)
    }

    /// A `'...'` literal string from its opening quote: no escapes, same
    /// control-byte and termination rules as a basic string.
    export fn literalString(c) = literalUpTo(advance(c), "", c)
    fn literalUpTo(c, acc, start) -> Result<Text, string> = match eof(c) {
        true => Error { message: failStr("toml.unterminated-string", start) }
        false => match cur(c) == apostrophe {
            true => Success { value: Text { text: acc, at: advance(c) } }
            false => match cur(c) == newline {
                true => Error { message: failStr("toml.unterminated-string", start) }
                false => match controlByte(cur(c)) {
                    true => Error { message: failStr("toml.control-character", c) }
                    false => literalUpTo(advance(c), acc + oneByte(c), start)
                }
            }
        }
    }
}
