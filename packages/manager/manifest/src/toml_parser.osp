namespace registry;
import registry::TomlLexer
import registry::Toml
import registry::TomlTree
import registry::TomlValues

/// Statements of the TOML subset: `[table]` and `[[array-of-tables]]`
/// headers, key/value lines, and the document loop that folds them into a
/// root table. Fails are located reason codes from `Toml::fail`. Implements
/// [PACKAGE-MANIFEST].
module TomlParser {
    type Step = { doc: TomlTree::Doc, at: TomlLexer::Cursor }

    let initialFocus = TomlTree::Focus { keys: [], index: TomlTree::noIndex }

    /// The span of a table header is the `[` itself, so a manifest error
    /// names the header's line and column rather than the key after it.
    fn headerSegs(segs, start) = mapList(segs, fn(s) => TomlValues::KeySeg { name: s.name, span: Toml::spanOf(start) })

    // -- statements ---------------------------------------------------------

    fn expectClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == TomlValues::byteRBracket {
            true => Success { value: TomlLexer::advance(c1) }
            false => Error { message: Toml::fail(c1, "toml.unexpected-token") }
        }
    }

    fn expectDoubleClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == TomlValues::byteRBracket && TomlLexer::peek(c1, 1) == TomlValues::byteRBracket {
            true => Success { value: TomlLexer::advance(TomlLexer::advance(c1)) }
            false => Error { message: Toml::fail(c1, "toml.unexpected-token") }
        }
    }

    fn parseStatement(doc, c) = match TomlLexer::cur(c) == TomlValues::byteLBracket {
        true => parseHeader(doc, c)
        false => parseKeyValue(doc, c)
    }

    fn parseHeader(doc, c) = {
        let c1 = TomlLexer::advance(c)
        match TomlLexer::cur(c1) == TomlValues::byteLBracket {
            true => parseArrayHeader(doc, TomlLexer::advance(c1), c)
            false => parseTableHeader(doc, c1, c)
        }
    }

    fn parseTableHeader(doc, c, start) = match TomlValues::parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderClose(doc, value, start)
    }

    fn tableHeaderClose(doc, path, start) = match expectClose(path.at) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderTail(doc, path, value, start)
    }

    fn tableHeaderTail(doc, path, close, start) = match TomlLexer::skipLineTail(close) {
        Error { message } => Error { message: message }
        Success { value } => tableHeaderDefine(doc, path, value, start)
    }

    fn tableHeaderDefine(doc, path, tail, start) = {
        let segs = headerSegs(path.segs, start)
        match TomlTree::defineTable(doc.root, segs) {
            Success { value } => Success { value: Step { doc: TomlTree::Doc { root: value, focus: TomlTree::Focus { keys: mapList(segs, fn(s) => s.name), index: TomlTree::noIndex } }, at: tail } }
            Error { message } => Error { message: message }
        }
    }

    fn parseArrayHeader(doc, c, start) = match TomlValues::parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderClose(doc, value, start)
    }

    fn arrayHeaderClose(doc, path, start) = match expectDoubleClose(path.at) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderTail(doc, path, value, start)
    }

    fn arrayHeaderTail(doc, path, close, start) = match TomlLexer::skipLineTail(close) {
        Error { message } => Error { message: message }
        Success { value } => arrayHeaderDefine(doc, path, value, start)
    }

    fn arrayHeaderDefine(doc, path, tail, start) = {
        let segs = headerSegs(path.segs, start)
        match TomlTree::defineArrayTable(doc.root, segs) {
            Success { value } => Success { value: Step { doc: TomlTree::Doc { root: value.root, focus: TomlTree::Focus { keys: mapList(segs, fn(s) => s.name), index: value.index } }, at: tail } }
            Error { message } => Error { message: message }
        }
    }

    fn parseKeyValue(doc, c) = match TomlValues::parseKeyPath(c) {
        Error { message } => Error { message: message }
        Success { value } => kvEquals(doc, value)
    }

    fn kvEquals(doc, path) = match TomlValues::expectEquals(path.at) {
        Error { message } => Error { message: message }
        Success { value } => kvValue(doc, path, value)
    }

    fn kvValue(doc, path, eq) = {
        let c1 = TomlLexer::skipSpaces(eq)
        match TomlValues::missingValueAt(c1) {
            true => Error { message: Toml::fail(c1, "toml.expected-value") }
            false => match TomlValues::parseValue(c1) {
                Error { message } => Error { message: message }
                Success { value } => kvTail(doc, path, value)
            }
        }
    }

    fn kvTail(doc, path, v) = match TomlLexer::skipLineTail(v.at) {
        Error { message } => Error { message: message }
        Success { value } => kvInsert(doc, path, v.value, value)
    }

    fn kvInsert(doc, path, val, tail) = match TomlTree::insertAtFocus(doc, path.segs, val) {
        Success { value } => Success { value: Step { doc: value, at: tail } }
        Error { message } => Error { message: message }
    }

    fn parseDocument(doc, c) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Success { value: doc.root }
            false => match parseStatement(doc, c1) {
                Success { value } => parseDocument(value.doc, value.at)
                Error { message } => Error { message: message }
            }
        }
    }

    /// Parse a TOML document into its root table, or the first problem.
    export fn parse(text) -> Result<Toml::Value, Toml::Problem> = parseDocument(TomlTree::Doc { root: Toml::emptyTable, focus: initialFocus }, TomlLexer::start(text))
}
