namespace registry;
import registry::Toml
import registry::Names
import registry::Paths
import registry::Spdx
import registry::Utf8
import registry::Order
import registry::Maybe
import registry::ManifestModel

/// `[project]`, `[modules]` and `[package]` as `[PACKAGE-MANIFEST]` and the
/// canonical-manifest rule of [PACKAGE-TYPE-INVARIANTS] define them. Each
/// failure is a stable reason code at the offending pair's span, encoded as
/// `code at line:column` inside `Error` until `Manifest` decodes it.
module ManifestSections {
    export type Project = { name: string, sourceRoots: List<string>, defaultNamespace: Maybe::Maybe<string>, entry: Maybe::Maybe<string>, flavor: Maybe::Maybe<ManifestModel::Flavor>, testRoots: List<string>, pythonSources: List<string> }

    let projectKeys = ["name", "source_roots", "default_namespace", "entry", "flavor", "test_roots", "python_sources"]
    let modulesKeys = ["allow_wildcard_imports", "published_library"]
    let packageKeys = ["name", "license", "summary", "keywords"]
    let defaultRoots = ["src"]
    let summaryMax = 512
    let keywordMax = 12
    let keywordBytes = 32

    /// `code at line:column`, the one encoding `Toml` and `Manifest::problemOf` share.
    export fn fail(code, span: Toml::Span) = Error { message: "${code} at ${span.line}:${span.column}" }

    /// The span of a document without a better anchor.
    export fn rootSpan() = Toml::Span { line: 1, column: 1 }

    /// The pairs of a table value, or none.
    export fn pairsOf(value) = match value {
        Toml::Table { pairs } => pairs
        _ => []
    }

    // `span` and `value` are shared field names (issue #273): the pair
    // receiver is spelled out once here.
    fn spanOfPair(pair: Toml::Pair) = pair.span

    fn valueOf(pair: Toml::Pair) = pair.value

    /// The pair named `key`, if present.
    export fn find(pairs, key) = foldList(pairs, Error { message: "absent" }, fn(found, pair: Toml::Pair) => if pair.key == key { Success { value: pair } } else { found })

    /// The span of pair `key`, or `fallback`.
    export fn spanOf(pairs, key, fallback) = match find(pairs, key) {
        Success { value } => spanOfPair(value)
        Error => fallback
    }

    /// True when pair `key` exists.
    export fn has(pairs, key) = match find(pairs, key) {
        Success => true
        Error => false
    }

    /// The first pair whose key is not allowed, as `code`.
    export fn unknownKeys(pairs, allowed, code) = foldList(pairs, Success { value: 0 }, fn(acc, pair: Toml::Pair) => match acc {
        Error { message } => Error { message: message }
        Success => if listContains(allowed, pair.key) { Success { value: 0 } } else { fail(code, pair.span) }
    })

    /// The string of a pair, else `code` at its span.
    export fn stringOf(pair: Toml::Pair, code) = match pair.value {
        Toml::Str { text } => Success { value: text }
        _ => fail(code, pair.span)
    }

    /// The integer of a pair, else `code` at its span.
    export fn intOf(pair: Toml::Pair, code) = match pair.value {
        Toml::Int { value } => Success { value: value }
        _ => fail(code, pair.span)
    }

    /// A required string pair; a missing one fails at `span`.
    export fn requiredString(pairs, key, code, span) = match find(pairs, key) {
        Success { value } => stringOf(value, code)
        Error => fail(code, span)
    }

    fn optionalString(pairs, key, code) = match find(pairs, key) {
        Success { value } => Maybe::ofResult(stringOf(value, code))
        Error => Success { value: Maybe::none() }
    }

    fn stringItems(items, span, code) = foldList(items, Success { value: [] }, fn(acc, item) => match acc {
        Error { message } => Error { message: message }
        Success { value } => match item {
            Toml::Str { text } => Success { value: listAppend(value, text) }
            _ => fail(code, span)
        }
    })

    /// A string array pair, `fallback` when absent.
    export fn stringList(pairs, key, fallback, code) = match find(pairs, key) {
        Error => Success { value: fallback }
        Success { value } => match valueOf(value) {
            Toml::Arr { items } => stringItems(items, spanOfPair(value), code)
            _ => fail(code, spanOfPair(value))
        }
    }

    fn allValidPaths(paths) = foldList(paths, true, fn(ok, path) => ok && match Paths::validate(path) {
        Success => true
        Error => false
    })

    // Roots follow path rules: exact duplicates and case-fold collisions
    // both fail ([PACKAGE-SOURCE-CANONICAL]).
    fn uniqueStrings(xs) = match Paths::canonicalSet(xs) {
        Success => true
        Error => false
    }

    fn roots(pairs, key, fallback, code, span) = match stringList(pairs, key, fallback, code) {
        Error { message } => Error { message: message }
        Success { value } => if allValidPaths(value) && uniqueStrings(value) { Success { value: value } } else { fail(code, spanOf(pairs, key, span)) }
    }

    fn flavorOf(pairs) = match optionalString(pairs, "flavor", "manifest.project.flavor") {
        Error { message } => Error { message: message }
        // The closure's return type is written so codegen sees a concrete
        // function type (issue: a still-generic closure value is refused).
        Success { value } => Maybe::fold(value, Success { value: Maybe::none() }, fn(text) -> Result<Maybe::Maybe<ManifestModel::Flavor>, string> => flavorNamed(text, spanOf(pairs, "flavor", rootSpan())))
    }

    fn flavorNamed(text, span) = match ManifestModel::flavorOf(text) {
        Success { value } => Success { value: Maybe::some(value) }
        Error { message } => fail(message, span)
    }

    fn entryOf(pairs) = match optionalString(pairs, "entry", "manifest.project.entry") {
        Error { message } => Error { message: message }
        // The closure's return type is written so codegen sees a concrete
        // function type (issue: a still-generic closure value is refused).
        Success { value } => Maybe::fold(value, Success { value: Maybe::none() }, fn(text) -> Result<Maybe::Maybe<string>, string> => entryNamed(text, spanOf(pairs, "entry", rootSpan())))
    }

    fn entryNamed(text, span) = match Paths::validate(text) {
        Success => Success { value: Maybe::some(text) }
        Error => fail("manifest.project.entry", span)
    }

    fn assembleProject(name, sourceRoots, ns, entry, flavor, testRoots, pythonSources) = Project {
        name: name, sourceRoots: sourceRoots, defaultNamespace: ns, entry: entry, flavor: flavor, testRoots: testRoots, pythonSources: pythonSources
    }

    fn projectBody(pairs, span) = match requiredString(pairs, "name", "manifest.project.name", span) {
        Error { message } => Error { message: message }
        Success { value } => if value == "" { fail("manifest.project.name", spanOf(pairs, "name", span)) } else { projectRoots(pairs, span, value) }
    }

    fn projectRoots(pairs, span, name) = match roots(pairs, "source_roots", defaultRoots, "manifest.project.source-roots", span) {
        Error { message } => Error { message: message }
        Success { value } => projectNamespace(pairs, span, name, value)
    }

    fn projectNamespace(pairs, span, name, sourceRoots) = match optionalString(pairs, "default_namespace", "manifest.project.default-ns") {
        Error { message } => Error { message: message }
        Success { value } => projectEntry(pairs, span, name, sourceRoots, value)
    }

    fn projectEntry(pairs, span, name, sourceRoots, ns) = match entryOf(pairs) {
        Error { message } => Error { message: message }
        Success { value } => projectFlavor(pairs, span, name, sourceRoots, ns, value)
    }

    fn projectFlavor(pairs, span, name, sourceRoots, ns, entry) = match flavorOf(pairs) {
        Error { message } => Error { message: message }
        Success { value } => projectEnd(pairs, span, name, sourceRoots, ns, entry, value)
    }

    // Python-flavor sources are root-confined relative paths ending in `.py`
    // ([PACKAGE-MANIFEST]); the `.py` rule shares the roots failure's code and span.
    fn allEndInPy(paths) = foldList(paths, true, fn(ok, path) => ok && endsWith(path, ".py"))

    fn pythonSourcesOf(pairs, span, name, sourceRoots, ns, entry, flavor, testRoots) = match roots(pairs, "python_sources", [], "manifest.project.python-sources", span) {
        Error { message } => Error { message: message }
        Success { value } => if allEndInPy(value) { Success { value: assembleProject(name, sourceRoots, ns, entry, flavor, testRoots, value) } } else { fail("manifest.project.python-sources", spanOf(pairs, "python_sources", span)) }
    }

    fn projectEnd(pairs, span, name, sourceRoots, ns, entry, flavor) = match roots(pairs, "test_roots", [], "manifest.project.test-roots", span) {
        Error { message } => Error { message: message }
        Success { value } => pythonSourcesOf(pairs, span, name, sourceRoots, ns, entry, flavor, value)
    }

    /// `[project]`: required, with validated roots, entry and flavor.
    export fn project(root) = match find(pairsOf(root), "project") {
        Error => fail("manifest.project.missing", rootSpan())
        Success { value } => match unknownKeys(pairsOf(valueOf(value)), projectKeys, "manifest.project.unknown-key") {
            Error { message } => Error { message: message }
            Success => projectBody(pairsOf(valueOf(value)), spanOfPair(value))
        }
    }

    fn boolOf(pairs, key, fallback, code) = match find(pairs, key) {
        Error => Success { value: fallback }
        Success { value } => match valueOf(value) {
            Toml::Bool { flag } => Success { value: flag }
            _ => fail(code, spanOfPair(value))
        }
    }

    /// `[modules]`: the wildcard-import policy; `published_library` is advice only.
    export fn modules(root) = match find(pairsOf(root), "modules") {
        Error => Success { value: false }
        Success { value } => match unknownKeys(pairsOf(valueOf(value)), modulesKeys, "manifest.modules.unknown-key") {
            Error { message } => Error { message: message }
            Success => modulesBody(pairsOf(valueOf(value)))
        }
    }

    fn modulesBody(pairs) = match boolOf(pairs, "published_library", false, "manifest.modules.published-library") {
        Error { message } => Error { message: message }
        Success => boolOf(pairs, "allow_wildcard_imports", false, "manifest.modules.allow-wildcard-imports")
    }

    fn keywordByte(b) = (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45
    fn keywordOk(k) = byteLength(k) >= 1 && byteLength(k) <= keywordBytes && !startsWith(k, "-")
        && fold(range(0, byteLength(k)), true, fn(ok, i) => ok && keywordByte(byteAt(k, i) ?: 0))

    fn keywordsOk(keywords, span) = if length(keywords) > keywordMax { fail("manifest.keywords.count", span) }
        else if !foldList(keywords, true, fn(ok, k) => ok && keywordOk(k)) { fail("manifest.keyword.grammar", span) }
        else if !Order::strictlyAscending(keywords) { fail("manifest.keywords.order", span) }
        else { Success { value: keywords } }

    fn summaryOk(summary, span) = if byteLength(summary) > summaryMax { fail("manifest.summary.length", span) }
        else if !Utf8::wellFormed(summary) || !Utf8::noControls(summary) { fail("manifest.summary.text", span) }
        else { Success { value: summary } }

    fn parsedKey(text, span) = match Names::parse(text) {
        Success { value } => Success { value: value }
        Error { message } => fail(message, span)
    }

    fn packageName(pairs, span) = match requiredString(pairs, "name", "manifest.package.name", span) {
        Error { message } => Error { message: message }
        Success { value } => parsedKey(value, spanOf(pairs, "name", span))
    }

    fn license(pairs, span) = match requiredString(pairs, "license", "manifest.license", span) {
        Error { message } => Error { message: message }
        Success { value } => match Spdx::validate(value) {
            Success => Success { value: value }
            Error { message } => fail(message, spanOf(pairs, "license", span))
        }
    }

    fn keywords(pairs, span) = if !has(pairs, "keywords") { fail("manifest.keywords.missing", span) }
        else { match stringList(pairs, "keywords", [], "manifest.keyword.grammar") {
            Error { message } => Error { message: message }
            Success { value } => keywordsOk(value, spanOf(pairs, "keywords", span))
        } }

    fn discovery(pairs, span) = match requiredString(pairs, "summary", "manifest.summary.missing", span) {
        Error { message } => Error { message: message }
        Success { value } => match summaryOk(value, spanOf(pairs, "summary", span)) {
            Error { message } => Error { message: message }
            Success => discoveryWith(pairs, span, value)
        }
    }

    fn discoveryWith(pairs, span, summary) = match keywords(pairs, span) {
        Error { message } => Error { message: message }
        Success { value } => Success { value: ManifestModel::Discovery { summary: summary, keywords: value } }
    }

    fn packageBody(pairs, span) = match packageName(pairs, span) {
        Error { message } => Error { message: message }
        Success { value } => packageLicensed(pairs, span, value)
    }

    fn packageLicensed(pairs, span, key) = match license(pairs, span) {
        Error { message } => Error { message: message }
        Success { value } => packageEnd(pairs, span, key, value)
    }

    fn packageEnd(pairs, span, key, licenseText) = match discovery(pairs, span) {
        Error { message } => Error { message: message }
        Success { value } => Success { value: Maybe::some(ManifestModel::Publication { package: key, licenseExpression: licenseText, discovery: value }) }
    }

    /// `[package]`: optional for application roots; complete when present.
    export fn publication(root) = match find(pairsOf(root), "package") {
        Error => Success { value: Maybe::none() }
        Success { value } => match unknownKeys(pairsOf(valueOf(value)), packageKeys, "manifest.package.unknown-key") {
            Error { message } => Error { message: message }
            Success => packageBody(pairsOf(valueOf(value)), spanOfPair(value))
        }
    }
}
