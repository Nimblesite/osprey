namespace json_tests

import ui::Doc

sample () = Doc::parse "{\"text\":\"hello\\n\\\"world\\\"\",\"empty\":\"\",\"integer\":-42,\"decimal\":2.5,\"yes\":true,\"no\":false,\"nothing\":null,\"list\":[null,true,1,1.5,\"x\",[],{}],\"object\":{\"first\":1,\"second\":2}}"

test ("parse reads complete documents and falls back to null for malformed input", \() =>
    doc = sample ()
    expect (Doc::kind doc, "object")
    expect (Doc::text (doc, "text"), "hello\n\"world\"")
    expect (Doc::number (doc, "integer"), 0 - 42)
    expect (Doc::decimal (doc, "decimal"), 2.5)
    expect (Doc::flag (doc, "yes"), true)
    expect (Doc::flag (doc, "no"), false)
    expect (Doc::kind (Doc::field (doc, "nothing")), "null")
    expect (length (Doc::items (Doc::field (doc, "list"))), 7)
    expect (join (Doc::keys (Doc::field (doc, "object"))) ",", "first,second")
    expect (Doc::kind (Doc::parse "{not json"), "null")
    expect (Doc::write (Doc::parse "{not json"), "null")
    expect (Doc::kind (Doc::parse ""), "null")
    expect (Doc::kind (Doc::parse "[]"), "list")
    expect (Doc::kind (Doc::parse "{}"), "object"))

test ("field and has distinguish absent members from present null and reject non-objects", \() =>
    doc = sample ()
    expect (Doc::has (doc, "nothing"), true)
    expect (Doc::has (doc, "missing"), false)
    expect (Doc::has (doc, "text"), true)
    expect (Doc::has (doc, ""), false)
    expect (Doc::kind (Doc::field (doc, "missing")), "null")
    expect (Doc::kind (Doc::field (doc, "nothing")), "null")
    expect (Doc::text (Doc::field (doc, "object"), "first"), "")
    expect (Doc::number (Doc::field (doc, "object"), "first"), 1)
    expect (Doc::has (JsonNull, "x"), false)
    expect (Doc::has (JsonArray [JsonInt 1], "0"), false)
    expect (Doc::has (JsonString "x", "x"), false)
    expect (Doc::kind (Doc::field (JsonArray [JsonInt 1], "x")), "null")
    expect (Doc::kind (Doc::field (JsonInt 1, "x")), "null"))

test ("typed member readers return values only for their kinds and neutral values otherwise", \() =>
    doc = sample ()
    expect (Doc::text (doc, "text"), "hello\n\"world\"")
    expect (Doc::text (doc, "empty"), "")
    expect (Doc::text (doc, "missing"), "")
    expect (Doc::text (doc, "integer"), "")
    expect (Doc::text (doc, "nothing"), "")
    expect (Doc::text (doc, "object"), "")
    expect (Doc::number (doc, "integer"), 0 - 42)
    expect (Doc::number (doc, "missing"), 0)
    expect (Doc::number (doc, "decimal"), 0)
    expect (Doc::number (doc, "text"), 0)
    expect (Doc::number (doc, "yes"), 0)
    expect (Doc::decimal (doc, "decimal"), 2.5)
    expect (Doc::decimal (doc, "integer"), 0.0 - 42.0)
    expect (Doc::decimal (doc, "missing"), 0.0)
    expect (Doc::decimal (doc, "text"), 0.0)
    expect (Doc::decimal (doc, "yes"), 0.0)
    expect (Doc::flag (doc, "yes"), true)
    expect (Doc::flag (doc, "no"), false)
    expect (Doc::flag (doc, "missing"), false)
    expect (Doc::flag (doc, "integer"), false)
    expect (Doc::flag (doc, "text"), false)
    expect (Doc::flag (doc, "nothing"), false))

test ("kind and real and string handle every JSON variant including numeric widening", \() =>
    expect (Doc::kind JsonNull, "null")
    expect (Doc::kind (JsonBool false), "bool")
    expect (Doc::kind (JsonInt (0 - 9)), "number")
    expect (Doc::kind (JsonFloat (0.0 - 0.25)), "number")
    expect (Doc::kind (JsonString ""), "text")
    expect (Doc::kind (JsonArray []), "list")
    expect (Doc::kind (JsonObject []), "object")
    expect (Doc::real JsonNull, 0.0)
    expect (Doc::real (JsonBool true), 0.0)
    expect (Doc::real (JsonInt (0 - 9)), 0.0 - 9.0)
    expect (Doc::real (JsonFloat 3.75), 3.75)
    expect (Doc::real (JsonString "3.75"), 0.0)
    expect (Doc::real (JsonArray [JsonInt 1]), 0.0)
    expect (Doc::real (JsonObject []), 0.0)
    expect (Doc::string (JsonString "value"), "value")
    expect (Doc::string (JsonString ""), "")
    expect (Doc::string JsonNull, "")
    expect (Doc::string (JsonBool true), "")
    expect (Doc::string (JsonInt 3), "")
    expect (Doc::string (JsonFloat 3.0), "")
    expect (Doc::string (JsonArray []), "")
    expect (Doc::string (JsonObject []), ""))

test ("items and at traverse arrays totally across empty negative and out-of-range cases", \() =>
    doc = Doc::field (sample (), "list")
    values = Doc::items doc
    expect (length values, 7)
    expect (Doc::kind (Doc::at (doc, 0)), "null")
    expect (Doc::flag (Doc::parse "{\"v\":${Doc::write (Doc::at (doc, 1))}}", "v"), true)
    expect (Doc::real (Doc::at (doc, 2)), 1.0)
    expect (Doc::real (Doc::at (doc, 3)), 1.5)
    expect (Doc::string (Doc::at (doc, 4)), "x")
    expect (Doc::kind (Doc::at (doc, 5)), "list")
    expect (Doc::kind (Doc::at (doc, 6)), "object")
    expect (Doc::kind (Doc::at (doc, 7)), "null")
    expect (Doc::kind (Doc::at (doc, 0 - 1)), "null")
    expect (Doc::kind (Doc::at (JsonArray [], 0)), "null")
    expect (Doc::kind (Doc::at (JsonObject [], 0)), "null")
    expect (Doc::kind (Doc::at (JsonString "x", 0)), "null")
    expect (length (Doc::items (JsonArray [])), 0)
    expect (length (Doc::items JsonNull), 0)
    expect (length (Doc::items (JsonObject [])), 0)
    expect (length (Doc::items (JsonString "abc")), 0))

test ("members and keys preserve object order and return none for other kinds", \() =>
    doc = Doc::parse "{\"z\":null,\"a\":1,\"middle\":2,\"nested\":{\"k\":true}}"
    members = Doc::members doc
    expect (length members, 4)
    expect (join (Doc::keys doc) ",", "z,a,middle,nested")
    expect (Doc::number (doc, "a"), 1)
    expect (Doc::flag (Doc::field (doc, "nested"), "k"), true)
    expect (length (Doc::members (JsonObject [])), 0)
    expect (join (Doc::keys (JsonObject [])) ",", "")
    expect (length (Doc::members (JsonArray [JsonInt 1])), 0)
    expect (length (Doc::members JsonNull), 0)
    expect (length (Doc::members (JsonString "{}")), 0)
    expect (join (Doc::keys (JsonArray [JsonInt 1])) ",", ""))

test ("texts maps arrays member-wise and substitutes empty strings for wrong element kinds", \() =>
    doc = Doc::parse "{\"mixed\":[\"a\",1,null,true,2.5,{},\"b\"],\"empty\":[],\"wrong\":\"ab\"}"
    mixed = Doc::texts (doc, "mixed")
    expect (length mixed, 7)
    expect (join mixed ",", "a,,,,,,b")
    expect (join (Doc::texts (doc, "empty")) ",", "")
    expect (length (Doc::texts (doc, "empty")), 0)
    expect (length (Doc::texts (doc, "wrong")), 0)
    expect (length (Doc::texts (doc, "missing")), 0)
    expect (length (Doc::texts (JsonNull, "mixed")), 0)
    expect (join (Doc::texts (Doc::parse "{\"v\":[\"\",\"x\\ny\",\"λ\"]}", "v")) "|", "|x\ny|λ"))

test ("member and array builders compose into exact compact JSON", \() =>
    doc = JsonObject [Doc::str ("s", "x\n\""), Doc::num ("n", 0 - 7), Doc::dec ("d", 0.0 - 0.25), Doc::bit ("b", false), JsonMember "items" (Doc::strings ["a", "", "λ"])]
    expect (Doc::write doc, "{\"s\":\"x\\n\\\"\",\"n\":-7,\"d\":-0.25,\"b\":false,\"items\":[\"a\",\"\",\"λ\"]}")
    expect (Doc::text (doc, "s"), "x\n\"")
    expect (Doc::number (doc, "n"), 0 - 7)
    expect (Doc::decimal (doc, "d"), 0.0 - 0.25)
    expect (Doc::flag (doc, "b"), false)
    expect (join (Doc::texts (doc, "items")) ",", "a,,λ")
    expect (Doc::write (Doc::strings []), "[]")
    expect (Doc::write (Doc::strings ["\"", "\\", "\n"]), "[\"\\\"\",\"\\\\\",\"\\n\"]")
    expect (Doc::write (JsonObject []), "{}")
    expect (Doc::write (JsonArray []), "[]")
    expect (Doc::write JsonNull, "null")
    expect (Doc::write (JsonBool true), "true")
    expect (Doc::write (JsonInt (0 - 1)), "-1")
    expect (Doc::write (JsonFloat 0.5), "0.5")
    expect (Doc::write (JsonString "ok"), "\"ok\""))

test ("a realistic nested document survives reading rebuilding and writing without losing types", \() =>
    source = "{\"user\":{\"name\":\"Ada\",\"active\":true,\"score\":9,\"ratio\":0.5},\"tags\":[\"admin\",\"ops\"],\"attempts\":-2,\"note\":null}"
    doc = Doc::parse source
    user = Doc::field (doc, "user")
    rebuilt = JsonObject [Doc::str ("name", Doc::text (user, "name")), Doc::bit ("active", Doc::flag (user, "active")), Doc::num ("score", Doc::number (user, "score")), Doc::dec ("ratio", Doc::decimal (user, "ratio")), JsonMember "tags" (Doc::field (doc, "tags")), Doc::num ("attempts", Doc::number (doc, "attempts")), JsonMember "note" (Doc::field (doc, "note"))]
    expect (Doc::text (user, "name"), "Ada")
    expect (Doc::flag (user, "active"), true)
    expect (Doc::number (user, "score"), 9)
    expect (Doc::decimal (user, "ratio"), 0.5)
    expect (join (Doc::texts (doc, "tags")) "+", "admin+ops")
    expect (Doc::number (doc, "attempts"), 0 - 2)
    expect (Doc::has (doc, "note"), true)
    expect (Doc::kind (Doc::field (doc, "note")), "null")
    expect (Doc::write rebuilt, "{\"name\":\"Ada\",\"active\":true,\"score\":9,\"ratio\":0.5,\"tags\":[\"admin\",\"ops\"],\"attempts\":-2,\"note\":null}")
    expect (join (Doc::keys rebuilt) ",", "name,active,score,ratio,tags,attempts,note"))
