// Signal-flow end to end ([UI-MACHINE], [UI-MACHINE-TEST], [UI-MACHINE-CANVAS]):
// the real document and adapter, driven entirely by pointer events aimed through
// each canvas control's accessible label, with its inputs, states and lettering read back.

import ui::Runtime
import ui::Streams
import ui::Canvases
import ui::MachineDocs
import ui::Machines
import uitest::Drive
import uitest::Semantics
import signalflow::App

(** The bench's only write: the driven session. *)
effect Bench
    drive : uitest::Driven<signalflow::Store> => Unit

mut driven = Drive::idle (Runtime::idle (signalflow::Flow::store (MachineDocs::faulty "")))

kept (resident : ui::Resident<signalflow::Store>) = perform Bench.drive (Drive::moved (driven, resident))

// Every sprite the renders streamed, as atlas index, x and y, latest last: the host's view of where each node is.
mut sprites = [[0.0]]

streamedSprite primitive = match Streams::code primitive == 3
    true => [[toFloat (Streams::index primitive), Streams::value (primitive, 0), Streams::value (primitive, 1)]]
    false => []

hosted work =
    handle ui::Slices
        fetch _ => ""
    handle ui::SceneStream
        shape primitive => sprites := listConcat sprites (streamedSprite primitive)
    work ()

bench work =
    handle Bench
        drive d => driven := d
    Runtime::guarded work

begun skin =
    perform Bench.drive (Drive::idle driven.drivenSession)
    hosted (\() => kept (Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\",\"arguments\":[\"--skin\",\"${skin}\"]}", App::initial, App::regions, App::theme skin)))

post event = hosted (\() => kept (Runtime::proceed (driven.drivenSession, event, App::update, App::regions)))

pointer (x, y, down) = post (Drive::pointer (driven, x, y, down))

// A click at `fraction` across the element labelled `label`, as a pointer or a screen reader would.
tapAt (label, fraction) =
    at = Semantics::point (element label, fraction)
    pointer (at.pointX, at.pointY, true)
    pointer (at.pointX, at.pointY, false)

tap label = tapAt (label, 0.5)

machine () = driven.drivenSession.sessionStore.screen.screenMachine

elements () = Canvases::semantics (machine ())

labels () = Semantics::labels (elements ())

element label = Semantics::element (elements (), label)

offers label = Drive::offers (elements (), label)

letters text = Drive::letters (driven, text)

offered label = expect (offers label, true)

missing label = expect (Semantics::offered (elements (), label), false)

flag (name, expected) = expect (Machines::flag (machine (), name), expected)

knobText (name, expected) = expect (Machines::text (machine (), name), expected)

knobNumber (name, expected) =
    actual = Machines::number (machine (), name)
    expect (actual - expected < 0.000001 && expected - actual < 0.000001, true)

layer (name, expected) = expect (Machines::current (machine (), name), expected)

topologyInitial () =
    expect (labels (), "Skin: Topology|Bypass Policy|Bypass Client|Bypass Gateway|Bypass Service|Bypass Telemetry|Policy Threshold|Gateway Rate limit|Inspector: Bypass Gateway|Inspector: Rate limit|Select Policy|Select Client|Select Gateway|Select Service|Select Telemetry")
    expect (letters "70%", true)
    expect (letters "490 r/s", true)
    expect (letters "Healthy", true)
    expect (letters "Gateway", true)
    expect (letters "Connections (4)", true)
    knobText ("skin", "topology")
    knobText ("selected", "process")
    knobNumber ("control", 0.7)
    knobNumber ("process", 0.7)
    knobNumber ("level", 0.49)
    layer ("commands", "idle")
    layer ("menu", "closed")
    flag ("canUndo", false)
    flag ("canRedo", false)
    expect (MachineDocs::folder "C:\\Program Files\\Osprey\\app\\signal_flow.machine.json", "C:/Program Files/Osprey/app")
    expect (MachineDocs::folder "/opt/osprey/signal_flow.machine.json", "/opt/osprey")
    expect (MachineDocs::folder "signal_flow.machine.json", "")

topologyBypass () =
    tap "Bypass Gateway"
    flag ("processOn", false)
    knobText ("processHealth", "Bypassed")
    knobNumber ("process", 0.7)
    knobNumber ("level", 1.0)
    expect (letters "1000 r/s", true)
    offered "Undo"
    tapAt ("Gateway Rate limit", 0.25)
    knobNumber ("process", 0.25)
    flag ("processOn", false)
    knobText ("processHealth", "Bypassed")
    knobNumber ("level", 1.0)
    expect (letters "25%", true)
    expect (Semantics::value (elements (), "Gateway Rate limit"), 0.25)

topologyUndo () =
    tap "Undo"
    knobNumber ("process", 0.7)
    flag ("processOn", false)
    expect (letters "70%", true)
    tap "Undo"
    knobNumber ("process", 0.7)
    flag ("processOn", true)
    knobText ("processHealth", "Healthy")
    knobNumber ("level", 0.49)
    flag ("canUndo", false)
    flag ("canRedo", true)

topologyRedo () =
    tap "Redo"
    flag ("processOn", false)
    knobNumber ("process", 0.7)
    knobNumber ("level", 1.0)
    offered "Enable Gateway"
    tap "Enable Gateway"
    flag ("processOn", true)
    knobNumber ("level", 0.49)

topologySelection () =
    tap "Select Client"
    knobText ("selected", "source")
    expect (letters "Client", true)
    expect (letters "Connections (1)", true)
    expect (letters "No parameters", true)
    offered "Inspector: Bypass Client"
    missing "Inspector: Rate limit"
    tap "Select Telemetry"
    knobText ("selected", "monitor")
    expect (letters "Telemetry", true)
    expect (letters "Connections (1)", true)
    expect (letters "No parameters", true)
    offered "Inspector: Bypass Telemetry"
    tap "Select Policy"
    knobText ("selected", "control")
    expect (letters "Policy", true)
    expect (letters "Connections (1)", true)
    offered "Inspector: Threshold"
    offered "Inspector: Bypass Policy"

topologySignal () =
    tapAt ("Inspector: Threshold", 0.5)
    knobNumber ("control", 0.5)
    knobNumber ("level", 0.35)
    expect (letters "350 r/s", true)
    tap "Bypass Client"
    flag ("sourceOn", false)
    knobText ("sourceHealth", "Bypassed")
    knobText ("processHealth", "Offline")
    knobText ("outputHealth", "Offline")
    knobText ("monitorHealth", "Offline")
    knobNumber ("level", 0.0)
    expect (letters "0 r/s", true)
    tap "Enable Client"
    flag ("sourceOn", true)
    knobText ("processHealth", "Healthy")
    tapAt ("Gateway Rate limit", 0.2)
    knobNumber ("process", 0.2)
    knobNumber ("level", 0.1)
    knobText ("processHealth", "Degraded")
    expect (letters "100 r/s", true)

menuOpened () =
    begun "topology"
    tapAt ("Policy Threshold", 0.6)
    tap "Select Client"
    knobNumber ("control", 0.6)
    knobNumber ("process", 0.7)
    knobText ("selected", "source")
    flag ("canUndo", true)
    tap "Skin: Topology"
    layer ("menu", "skins")
    expect (take (labels ()) 29, "Topology|Notation|Paper|Prism")
    offered "Topology"
    offered "Notation"
    offered "Paper"
    offered "Prism"

menuChoice () =
    pointer (1400.0, 700.0, true)
    pointer (1400.0, 700.0, false)
    layer ("menu", "closed")
    missing "Topology"
    tap "Skin: Topology"
    tap "Prism"
    knobText ("skin", "prism")
    layer ("menu", "closed")
    layer ("commands", "idle")
    expect (take (labels ()) 11, "Skin: Prism")
    knobNumber ("control", 0.6)
    knobNumber ("process", 0.7)
    knobText ("selected", "source")
    flag ("canUndo", true)
    flag ("canRedo", false)
    expect (letters "+60%", true)
    expect (letters "2.5 kHz", true)

menuCycle () =
    tap "Skin: Prism"
    tap "Notation"
    knobText ("skin", "notation")
    layer ("menu", "closed")
    expect (letters "0.60", true)
    expect (letters "H(s)", true)
    tap "Skin: Notation"
    tap "Paper"
    knobText ("skin", "paper")
    layer ("menu", "closed")
    expect (letters "0.60", true)
    expect (letters "Transform.in", true)
    knobNumber ("control", 0.6)
    knobNumber ("process", 0.7)
    knobText ("selected", "source")
    flag ("canUndo", true)

freshSkin skin =
    begun skin
    knobText ("skin", skin)
    knobText ("selected", "process")
    layer ("commands", "idle")
    layer ("menu", "closed")
    knobNumber ("control", 0.7)
    knobNumber ("process", 0.7)
    flag ("canUndo", false)
    flag ("canRedo", false)

exercise (name, role) =
    tapAt ("Select ${name}", 0.1)
    knobText ("selected", role)
    offered "Inspector: Bypass ${name}"
    tap "Bypass ${name}"
    flag ("${role}On", false)
    knobText ("${role}Health", "Bypassed")
    offered "Enable ${name}"
    offered "Inspector: Enable ${name}"
    tap "Enable ${name}"
    flag ("${role}On", true)
    knobText ("${role}Health", "Healthy")
    offered "Inspector: Bypass ${name}"

skinJourney (skin, control, source, process, output, monitor) =
    freshSkin skin
    exercise (control, "control")
    exercise (source, "source")
    exercise (process, "process")
    exercise (output, "output")
    exercise (monitor, "monitor")

notationInspector () =
    begun "notation"
    knobText ("selected", "process")
    offered "Inspector enabled: Bypass H(s)"
    offered "Inspector: Cutoff  ωc"
    tap "Inspector enabled: Bypass H(s)"
    flag ("processOn", false)
    knobText ("processHealth", "Bypassed")
    offered "Inspector enabled: Enable H(s)"
    tap "Inspector enabled: Enable H(s)"
    flag ("processOn", true)
    knobText ("processHealth", "Healthy")
    tapAt ("Inspector: Cutoff  ωc", 0.5)
    knobNumber ("process", 0.5)
    knobNumber ("level", 0.35)
    expect (letters "0.50", true)

prismInspector () =
    begun "prism"
    knobText ("selected", "process")
    offered "Inspector bypass: Bypass Filter"
    tap "Inspector bypass: Bypass Filter"
    flag ("processOn", false)
    knobText ("processHealth", "Bypassed")
    offered "Inspector bypass: Enable Filter"
    missing "Inspector bypass: Bypass Filter"
    offered "Inspector: Enable Filter"
    tap "Inspector bypass: Enable Filter"
    flag ("processOn", true)
    knobText ("processHealth", "Healthy")
    tapAt ("Filter Cutoff", 0.5)
    knobNumber ("process", 0.5)
    knobNumber ("level", 0.35)
    knobNumber ("delivered", 0.2625)
    expect (letters "0.6 kHz", true)
    expect (letters "+70%", true)
    expect (letters "-6.0 dB", true)
    expect (letters "-17.7", true)
    tap "Bypass Master"
    knobText ("outputHealth", "Bypassed")
    knobNumber ("delivered", 0.0)
    expect (letters "-24.0", true)
    tap "Undo"
    flag ("outputOn", true)
    expect (letters "-17.7", true)
    offered "Redo"
    tap "Redo"
    flag ("outputOn", false)
    missing "Redo"

prismInitial () =
    begun "prism"
    expect (labels (), "Skin: Prism|LFO Rate: 1/4|Oscillator Wave: Sine|Bypass LFO|Bypass Oscillator|Bypass Filter|Bypass Master|Bypass Scope|Filter Cutoff|Master Level|Inspector: Bypass Filter|Inspector bypass: Bypass Filter|Inspector: Cutoff|Select LFO|Select Oscillator|Select Filter|Select Master|Select Scope")
    knobText ("rate", "1/4")
    knobText ("wave", "Sine")
    knobNumber ("volume", 0.75)
    knobNumber ("delivered", 0.3675)
    expect (letters "1/4", true)
    expect (letters "Sine", true)
    expect (letters "-6.0 dB", true)
    expect (letters "2.5 kHz", true)
    expect (letters "-15.2", true)
    layer ("menu", "closed")

// Opens a chooser, checks its choices lead the tree, picks `choice` and checks it took and was recorded.
chosen (popup, menu, knob, choices, choice, after) =
    tap popup
    layer ("menu", menu)
    expect (take (labels ()) (length choices), choices)
    tap choice
    layer ("menu", "closed")
    knobText (knob, choice)
    offered after
    expect (letters choice, true)
    flag ("canUndo", true)

prismRates () =
    chosen ("LFO Rate: 1/4", "rates", "rate", "1/1|1/2|1/4|1/8|1/16", "1/16", "LFO Rate: 1/16")
    chosen ("LFO Rate: 1/16", "rates", "rate", "1/1|1/2|1/4|1/8|1/16", "1/1", "LFO Rate: 1/1")
    chosen ("LFO Rate: 1/1", "rates", "rate", "1/1|1/2|1/4|1/8|1/16", "1/8", "LFO Rate: 1/8")
    tap "Undo"
    knobText ("rate", "1/1")
    offered "LFO Rate: 1/1"
    tap "Redo"
    knobText ("rate", "1/8")
    tap "LFO Rate: 1/8"
    layer ("menu", "rates")
    pointer (900.0, 700.0, true)
    pointer (900.0, 700.0, false)
    layer ("menu", "closed")
    knobText ("rate", "1/8")
    missing "1/16"

prismWaves () =
    chosen ("Oscillator Wave: Sine", "waves", "wave", "Sine|Triangle|Saw|Square", "Triangle", "Oscillator Wave: Triangle")
    chosen ("Oscillator Wave: Triangle", "waves", "wave", "Sine|Triangle|Saw|Square", "Saw", "Oscillator Wave: Saw")
    chosen ("Oscillator Wave: Saw", "waves", "wave", "Sine|Triangle|Saw|Square", "Square", "Oscillator Wave: Square")
    tap "Oscillator Wave: Square"
    layer ("menu", "waves")
    tap "LFO Rate: 1/8"
    layer ("menu", "rates")
    offered "1/2"
    missing "Triangle"
    tap "LFO Rate: 1/8"
    layer ("menu", "closed")
    knobText ("wave", "Square")
    tap "Undo"
    knobText ("wave", "Saw")
    expect (letters "Saw", true)

prismLevels () =
    tapAt ("Master Level", 1.0)
    knobNumber ("volume", 1.0)
    knobNumber ("delivered", 0.49)
    expect (letters "0.0 dB", true)
    expect (letters "-12.2", true)
    tapAt ("Master Level", 0.0)
    knobNumber ("volume", 0.0)
    knobNumber ("delivered", 0.0)
    expect (letters "-24.0 dB", true)
    tap "Select Master"
    knobText ("selected", "output")
    offered "Inspector: Level"
    missing "Inspector: Cutoff"
    expect (letters "Level", true)
    tapAt ("Inspector: Level", 0.5)
    knobNumber ("volume", 0.5)
    knobNumber ("delivered", 0.245)
    expect (letters "-12.0 dB", true)
    tap "Undo"
    knobNumber ("volume", 0.0)
    tap "Redo"
    knobNumber ("volume", 0.5)

prismParameters () =
    tap "Select LFO"
    knobText ("selected", "control")
    offered "Inspector: Depth"
    tapAt ("Inspector: Depth", 0.3)
    knobNumber ("control", 0.3)
    knobNumber ("level", 0.21)
    expect (letters "+30%", true)
    tap "Select Filter"
    tapAt ("Inspector: Cutoff", 1.0)
    knobNumber ("process", 1.0)
    expect (letters "20.0 kHz", true)
    tapAt ("Filter Cutoff", 0.0)
    knobNumber ("process", 0.0)
    knobText ("processHealth", "Degraded")
    tap "Select Oscillator"
    expect (letters "No parameters", true)
    tap "Select Scope"
    expect (letters "No parameters", true)
    missing "Inspector: Level"

test ("topology: pointer editing, history, inspectors and signal health", \() => bench (\() =>
    begun "topology"
    topologyInitial ()
    topologyBypass ()
    topologyUndo ()
    topologyRedo ()
    topologySelection ()
    topologySignal ()))

test ("the skin menu dismisses, switches skins and preserves the session", \() => bench (\() =>
    menuOpened ()
    menuChoice ()
    menuCycle ()))

test ("every skin: every node selects, bypasses, enables and tracks its inspector", \() => bench (\() =>
    skinJourney ("topology", "Policy", "Client", "Gateway", "Service", "Telemetry")
    skinJourney ("notation", "k", "x(t)", "H(s)", "y(t)", "Scope")
    skinJourney ("paper", "Parameter", "Source", "Transform", "Output", "Monitor")
    skinJourney ("prism", "LFO", "Oscillator", "Filter", "Master", "Scope")))

test ("notation and prism inspector switches and parameter lettering", \() => bench (\() =>
    notationInspector ()
    prismInspector ()))

test ("prism: every chooser, slider, switch and the history drive the patch", \() => bench (\() =>
    prismInitial ()
    prismRates ()
    prismWaves ()
    prismLevels ()
    prismParameters ()))

test ("prism: nodes drag with their cables, controls and sprites; clicks, hovers and slider drags act once", \() => bench (\() =>
    begun "prism"
    hovering ()
    filterDrag ()
    movedControls ()
    scopeDrag ()
    sliderDrag ()))

test ("prism: a larger window moves the inspector, undo and legend to its edges at their size and leaves more grid; a smaller one spares none", \() => bench (\() =>
    grown ()
    grownControls ()
    shrunk ()))
