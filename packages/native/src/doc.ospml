// Total readers and member builders over Osprey's built-in `Json`. Use these
// for the framework's own trusted state; validate hostile input with the
// built-in `Result` readers (`jsonText (Doc::field (doc, key))`).
namespace ui

(** Total readers and member builders over Osprey's built-in `Json`, for the framework's own trusted state. Validate hostile input with the built-in `Result` readers instead. *)
module Doc
    (** `source` as JSON, or `JsonNull` when it is not JSON. *)
    export parse source = jsonDecode source ?: JsonNull

    (** The member `key` of an object, or `JsonNull` when it is absent or `doc` is not an object. *)
    export field (doc, key) = jsonField doc key ?: JsonNull

    (** True when the object `doc` has a member named `key`, whatever its value. *)
    export has (doc, key) = match jsonField doc key
        Success _ => true
        Error _ => false

    (** The string member `key`, or an empty string when it is absent or not a string. *)
    export text (doc, key) = jsonText (field (doc, key)) ?: ""

    (** The integer member `key`, or 0 when it is absent or not an integer. *)
    export number (doc, key) = jsonInt (field (doc, key)) ?: 0

    (** The boolean member `key`, or false when it is absent or not a boolean. *)
    export flag (doc, key) = jsonBool (field (doc, key)) ?: false

    (** The elements of an array, or none when `doc` is not an array. *)
    export items doc = match doc
        JsonArray values => values
        _ => []

    (** The members of an object, or none when `doc` is not an object. *)
    export members doc = match doc
        JsonObject values => values
        _ => []

    (** The array member `key` as strings; an element that is not a string reads as an empty string. *)
    export texts (doc, key) = mapList (items (field (doc, key)), \item => jsonText item ?: "")

    (** A string member for building an object. *)
    export str (key, value) = JsonMember key (JsonString value)

    (** An integer member for building an object. *)
    export num (key, value) = JsonMember key (JsonInt value)

    (** A boolean member for building an object. *)
    export bit (key, value) = JsonMember key (JsonBool value)

    (** A JSON array of `values`. *)
    export strings values = JsonArray (mapList (values, \value => JsonString value))

    (** `doc` as compact JSON text. *)
    export write doc = jsonEncode doc ?: "null"
