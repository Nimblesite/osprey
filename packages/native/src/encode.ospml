// Implements [UI-PROTOCOL] and [UI-EVENTS]: one depth-first walk encodes a
// region and collects its bindings, so an event ordinal always names the
// control that was drawn with it. The walk is mutually recursive, so a
// program instantiates it at one action type (Nimblesite/osprey#278).
namespace ui


(** Encoded nodes and the bindings collected while encoding them, in ordinal order. *)
type Walked A =
    bindings : List<Binding<A>>
    nodes : List<Json>

(** Encodes a region's node tree for the protocol and collects its bindings in one depth-first walk, so an event ordinal always names the control drawn with it ([UI-PROTOCOL], [UI-EVENTS]). *)
module Encode
    (** The protocol name of a tone. *)
    export tone value = match value
        Primary => "primary"
        Secondary => "secondary"
        Accent => "accent"
        Good => "good"
        Caution => "caution"
        Danger => "danger"

    role value = match value
        Display => "display"
        Large => "large"
        Title => "title"
        Heading => "heading"
        Lead => "lead"
        Headline => "headline"
        Body => "body"
        Callout => "callout"
        Caption => "caption"
        Eyebrow => "eyebrow"
        Mono => "mono"

    buttonRole value = match value
        Filled => "filled"
        Prominent => "prominent"
        Plain => "plain"
        Destructive => "destructive"

    axis value = match value
        Vertical => "vertical"
        Horizontal => "horizontal"

    side value = match value
        Leading => "leading"
        Trailing => "trailing"

    commit value = match value
        OnEdit => "edit"
        OnSubmit => "submit"

    str key value = Doc::str (key, value)

    num key value = Doc::num (key, value)

    bit key value = Doc::bit (key, value)

    kind name members = JsonObject (listPrepend members (str "kind" name))

    one<A> : (List<Binding<A>>, Json) -> Walked<A>
    one (bindings, json) = Walked(bindings = bindings, nodes = [json])

    // A control: its binding takes the next ordinal.
    bound<A> : (List<Binding<A>>, Binding<A>, string, List<JsonMember>) -> Walked<A>
    bound (bindings, binding, name, members) = one (listAppend bindings binding, kind name (listAppend members (num "event" (length bindings))))

    childAt<A> : (Walked<A>, List<Node<A>>, int) -> Walked<A>
    childAt (walked, children, index) = match listGet children index
        Success child =>
            next = walk (walked.bindings, child)
            Walked(bindings = next.bindings, nodes = listConcat walked.nodes next.nodes)
        Error _ => walked

    (** Encodes `children` in order; their bindings continue after `bindings`, so ordinals follow drawing order. *)
    export all<A> : (List<Binding<A>>, List<Node<A>>) -> Walked<A>
    all (bindings, children) = range (0, length children) |> fold (Walked(bindings = bindings, nodes = [])) (\(walked, index) => childAt (walked, children, index))

    // A container: its children continue the parent's ordinals.
    nested<A> : (List<Binding<A>>, string, List<JsonMember>, List<Node<A>>) -> Walked<A>
    nested (bindings, name, members, children) =
        inner = all (bindings, children)
        one (inner.bindings, kind name (listAppend members (JsonMember "children" (JsonArray inner.nodes))))

    first<A> : Walked<A> -> Json
    first walked = listGet walked.nodes 0 ?: JsonNull

    entryAt<A> : (Walked<A>, List<Tab<A>>, int) -> Walked<A>
    entryAt (walked, tabs, index) = match listGet tabs index
        Success tab =>
            inner = walk (walked.bindings, tab.page)
            json = JsonObject [str "key" tab.tabKey, str "label" tab.tabLabel, str "symbol" tab.tabSymbol, JsonMember "child" (first inner)]
            Walked(bindings = inner.bindings, nodes = listAppend walked.nodes json)
        Error _ => walked

    rowAt<A> : (Walked<A>, List<Row<A>>, int) -> Walked<A>
    rowAt (walked, rows, index) = match listGet rows index
        Success item =>
            inner = walk (walked.bindings, item.cell)
            json = JsonObject [str "key" item.rowKey, str "symbol" item.rowSymbol, str "group" item.rowGroup, JsonMember "child" (first inner)]
            Walked(bindings = inner.bindings, nodes = listAppend walked.nodes json)
        Error _ => walked

    tabs<A> : (List<Binding<A>>, List<Tab<A>>, string, A) -> Walked<A>
    tabs (bindings, entries, selected, action) =
        inner = range (0, length entries) |> fold (Walked(bindings = bindings, nodes = [])) (\(walked, index) => entryAt (walked, entries, index))
        bound (inner.bindings, ChoiceInput(action = action), "tabs", [str "selected" selected, JsonMember "tabs" (JsonArray inner.nodes)])

    rows<A> : (List<Binding<A>>, List<Row<A>>, string, A) -> Walked<A>
    rows (bindings, entries, selected, action) =
        inner = range (0, length entries) |> fold (Walked(bindings = bindings, nodes = [])) (\(walked, index) => rowAt (walked, entries, index))
        bound (inner.bindings, ChoiceInput(action = action), "rows", [str "selected" selected, JsonMember "rows" (JsonArray inner.nodes)])

    choiceJson item = JsonObject [str "key" item.choiceKey, str "label" item.choiceLabel]

    choices items = JsonArray (mapList (items, \item => choiceJson item))

    toneList values = JsonArray (mapList (values, \value => JsonString (tone value)))

    screen<A> : (List<Binding<A>>, string, string, List<Node<A>>, List<Node<A>>) -> Walked<A>
    screen (bindings, title, subtitle, toolbar, children) =
        tools = all (bindings, toolbar)
        body = all (tools.bindings, children)
        one (body.bindings, kind "screen" [str "title" title, str "subtitle" subtitle, JsonMember "toolbar" (JsonArray tools.nodes), JsonMember "children" (JsonArray body.nodes)])

    // A control with content: its binding takes the next ordinal, then its children continue.
    disclosure<A> : (List<Binding<A>>, string, bool, A, List<Node<A>>) -> Walked<A>
    disclosure (bindings, title, expanded, action, children) =
        inner = all (listAppend bindings (FlagInput(action = action)), children)
        one (inner.bindings, kind "disclosure" [str "title" title, bit "expanded" expanded, num "event" (length bindings), JsonMember "children" (JsonArray inner.nodes)])

    // Two columns: the pane's controls take ordinals before the aside's, and the splitter between them takes the next.
    aside<A> : (List<Binding<A>>, Side, Node<A>, Node<A>, int, int, int, int, A) -> Walked<A>
    aside (bindings, place, column, pane, width, least, most, keep, action) =
        content = walk (bindings, pane)
        beside = walk (content.bindings, column)
        limits = [num "width" width, num "least" least, num "most" most, num "keep" keep]
        bound (beside.bindings, SizeInput(action = action), "aside", listConcat [str "side" (side place), JsonMember "pane" (first content), JsonMember "aside" (first beside)] limits)

    contextMenu<A> : (List<Binding<A>>, Node<A>, List<Node<A>>) -> Walked<A>
    contextMenu (bindings, content, actions) =
        body = walk (bindings, content)
        menu = all (body.bindings, actions)
        one (menu.bindings, kind "context-menu" [JsonMember "body" (first body), JsonMember "items" (JsonArray menu.nodes)])

    markJson item = JsonObject [num "line" item.markLine, bit "underlined" item.underlined, str "tone" (tone item.markTone), str "badge" item.markBadge, str "note" item.markNote]

    // [UI-COMPONENTS-EDITOR] Two controls in one: the text binding takes the next ordinal, the cursor binding the one after.
    editor<A> : (List<Binding<A>>, string, string, bool, int, List<Mark>, A, A) -> Walked<A>
    editor (bindings, label, value, inline, cursor, marks, edit, place) =
        texted = listAppend bindings (TextInput(action = edit))
        members = [str "label" label, str "value" value, bit "inline" inline, num "cursor" cursor, JsonMember "marks" (JsonArray (mapList (marks, \item => markJson item))), num "event" (length bindings), num "placeEvent" (length texted)]
        one (listAppend texted (PlaceInput(action = place)), kind "editor" members)

    // [UI-COMPONENTS-BOARD] Camera binding follows the existing stroke and lasso ordinals.
    board<A> : (List<Binding<A>>, string, int, bool, string, bool, bool, A, A, A) -> Walked<A>
    board (bindings, slice, count, lassoing, backdrop, panning, camera, pan, stroke, lasso) =
        stroked = listAppend bindings (StrokeInput(action = stroke))
        lassoed = listAppend stroked (LassoInput(action = lasso))
        members = [str "slice" slice, num "count" count, bit "lasso" lassoing, str "backdrop" backdrop, bit "panning" panning, num "event" (length bindings), num "lassoEvent" (length stroked)]
        match camera
            false => one (lassoed, kind "board" members)
            true => one (listAppend lassoed (TextInput(action = pan)), kind "board" (listAppend members (num "panEvent" (length lassoed))))

    leaf<A> : (List<Binding<A>>, string, List<JsonMember>) -> Walked<A>
    leaf (bindings, name, members) = one (bindings, kind name members)

    runJson run = JsonObject [str "text" run.runText, str "ink" run.runInk, bit "italic" run.runItalic]

    frameJson style = JsonObject [str "name" style.frameName, num "width" style.frameWidth, num "height" style.frameHeight, num "top" style.frameTop, num "right" style.frameRight, num "bottom" style.frameBottom, num "left" style.frameLeft, num "radius" style.frameRadius, num "gap" style.frameGap, str "fill" style.frameFill, str "ink" style.frameInk, str "line" style.frameLine, str "lineEdge" style.frameLineEdge, bit "grow" style.frameGrow, str "font" style.frameFont, num "textSize" style.frameTextSize, JsonMember "mathScale" (JsonFloat style.frameMathScale), JsonMember "lineHeight" (JsonFloat style.frameLineHeight), JsonMember "tracking" (JsonFloat style.frameTracking), bit "italic" style.frameItalic, bit "hug" style.frameHug, str "align" style.frameAlign, str "cross" style.frameCross, num "controlHeight" style.frameControlHeight, num "controlPadding" style.frameControlPadding, bit "quietControls" style.frameQuietControls, bit "iconOnly" style.frameIconOnly, bit "fadeBackdrop" style.frameFadeBackdrop, bit "trailingSymbols" style.frameTrailingSymbols, bit "flatRows" style.frameFlatRows, str "shadow" style.frameShadow]

    framed<A> : (List<Binding<A>>, FrameStyle, Node<A>) -> Walked<A>
    framed (bindings, style, content) =
        inner = walk (bindings, content)
        one (inner.bindings, kind "framed" [JsonMember "style" (frameJson style), JsonMember "body" (first inner)])

    dialog (bindings, title, content, action) =
        dismissing = listAppend bindings (Tap(action = action))
        inner = walk (dismissing, content)
        one (inner.bindings, kind "dialog" [str "title" title, num "event" (length bindings), JsonMember "body" (first inner)])

    themed (bindings, theme, content) =
        inner = walk (bindings, content)
        one (inner.bindings, kind "themed" [JsonMember "theme" (Themes::encode theme), JsonMember "body" (first inner)])

    // Exhaustive: a new component cannot be encoded by accident as something else.
    (** Encodes `node` and collects its bindings after `bindings`, depth first, so each control's ordinal is the index of its binding. *)
    export walk<A> : (List<Binding<A>>, Node<A>) -> Walked<A>
    walk (bindings, node) = match node
        RichText runs textRole => leaf (bindings, "rich-text", [JsonMember "runs" (JsonArray (mapList (runs, runJson))), str "role" (role textRole)])
        Text value textRole textTone => leaf (bindings, "text", [str "text" value, str "role" (role textRole), str "tone" (tone textTone)])
        Evidence label value => leaf (bindings, "evidence", [str "label" label, str "value" value])
        Badge label symbol badgeTone => leaf (bindings, "badge", [str "label" label, str "symbol" symbol, str "tone" (tone badgeTone)])
        Label label symbol => leaf (bindings, "label", [str "label" label, str "symbol" symbol])
        Icon symbol => leaf (bindings, "icon", [str "symbol" symbol])
        Link label address => leaf (bindings, "link", [str "label" label, str "url" address])
        Spacer => leaf (bindings, "spacer", [])
        Divider => leaf (bindings, "divider", [])
        Segments values label => leaf (bindings, "segments", [JsonMember "tones" (toneList values), str "label" label])
        Empty symbol title detail => leaf (bindings, "empty", [str "symbol" symbol, str "title" title, str "detail" detail])
        Progress label detail => leaf (bindings, "progress", [str "label" label, str "detail" detail])
        Swatch name light dark => leaf (bindings, "swatch", [str "name" name, str "light" light, str "dark" dark])
        Slot key => leaf (bindings, "slot", [str "key" key])
        Brand => leaf (bindings, "brand", [])
        Button label symbol buttonKind enabled action => bound (bindings, Tap(action = action), "button", [str "label" label, str "symbol" symbol, str "role" (buttonRole buttonKind), bit "enabled" enabled])
        Field label value prompt secure multiline policy action => bound (bindings, TextInput(action = action), "field", [str "label" label, str "value" value, str "prompt" prompt, bit "secure" secure, bit "multiline" multiline, str "commit" (commit policy)])
        Toggle label on action => bound (bindings, FlagInput(action = action), "toggle", [str "label" label, bit "on" on])
        Picker label items selected action => bound (bindings, ChoiceInput(action = action), "picker", [str "label" label, JsonMember "choices" (choices items), str "selected" selected])
        Disclosure title expanded action children => disclosure (bindings, title, expanded, action, children)
        Alert title message visible action => bound (bindings, Tap(action = action), "alert", [str "title" title, str "message" message, bit "visible" visible])
        Stack direction children => nested (bindings, "stack", [str "axis" (axis direction)], children)
        Section title footer children => nested (bindings, "section", [str "title" title, str "footer" footer], children)
        Screen title subtitle toolbar children => screen (bindings, title, subtitle, toolbar, children)
        Split panes => nested (bindings, "split", [], panes)
        Layer children => nested (bindings, "layer", [], children)
        Framed style content => framed (bindings, style, content)
        Themed theme content => themed (bindings, theme, content)
        Dialog title content dismiss => dialog (bindings, title, content, dismiss)
        ContextMenu content actions => contextMenu (bindings, content, actions)
        Aside place column pane width least most keep action => aside (bindings, place, column, pane, width, least, most, keep, action)
        Tabs entries selected action => tabs (bindings, entries, selected, action)
        Rows entries selected action => rows (bindings, entries, selected, action)
        Typeset tree text => leaf (bindings, "math", [JsonMember "math" (Maths::encode tree), str "spoken" text])
        Image source alt width height => leaf (bindings, "image", [str "source" source, str "alt" alt, num "width" width, num "height" height])
        Video source poster captions alt seconds => leaf (bindings, "video", [str "source" source, str "poster" poster, str "captions" captions, str "alt" alt, num "seconds" seconds])
        Editor label value inline cursor marks edit place => editor (bindings, label, value, inline, cursor, marks, edit, place)
        Board slice count lassoing backdrop panning camera pan stroke lasso => board (bindings, slice, count, lassoing, backdrop, panning, camera, pan, stroke, lasso)
