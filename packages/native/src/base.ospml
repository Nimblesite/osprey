// List helpers Osprey has no built-in for yet (Nimblesite/osprey#276): a
// stable comparator sort until `listSortBy` ships, slices, flattening,
// distinctness and positions. Lists are transformed with the built-in
// `mapList`, `filterList`, `foldList` and `forEachList`.
namespace ui

(** The state of one merge step: the next index in each half and the items merged so far. *)
type Merge T =
    mergeLeft : int
    mergeRight : int
    merged : List<T>

(** List helpers Osprey has no built-in for yet: finding, testing, flattening, slicing, positions, distinctness and a stable sort (Nimblesite/osprey#276). *)
module Lists
    // Append the item at `index` when it exists.
    kept<T> : (List<T>, List<T>, int) -> List<T>
    kept (out, items, index) = match listGet items index
        Success item => listAppend out item
        Error _ => out

    (** The first item that `matches`, or an error when none does. *)
    export find<T> : (List<T>, (T) -> bool) -> Result<T, Error>
    find (items, matches) = listGet (filterList (items, matches)) 0

    locate<T> : (int, List<T>, (T) -> bool, int) -> int
    locate (found, items, matches, index) = match found >= 0
        true => found
        false => match listGet items index
            Success item => match matches item
                true => index
                false => found
            Error _ => found

    (** The index of the first item that matches, or -1. *)
    export position<T> : (List<T>, (T) -> bool) -> int
    position (items, matches) = range (0, length items) |> fold (0 - 1) (\(found, index) => locate (found, items, matches, index))

    (** True when at least one item matches. *)
    export any<T> : (List<T>, (T) -> bool) -> bool
    any (items, matches) = length (filterList (items, matches)) > 0

    (** True when every item matches; an empty list holds vacuously. *)
    export all<T> : (List<T>, (T) -> bool) -> bool
    all (items, matches) = length (filterList (items, matches)) == length items

    (** The groups' items in order, as one list. *)
    export flatten<T> : List<List<T>> -> List<T>
    flatten groups = range (0, length groups) |> fold [] (\(out, index) => listConcat out (listGet groups index ?: []))

    (** The items from index `start` up to but excluding `stop`; indexes past the end contribute nothing. *)
    export slice<T> : (List<T>, int, int) -> List<T>
    slice (items, start, stop) = range (start, stop) |> fold [] (\(out, index) => kept (out, items, index))

    (** True when no two keys repeat. *)
    export distinct keys = length (mapKeys (range (0, length keys) |> fold (Map ()) (\(seen, index) => mapSet seen (listGet keys index ?: "") true))) == length keys

    takeLeft<T> : (Merge<T>, List<T>) -> Merge<T>
    takeLeft (merging, left) = Merge(mergeLeft = satAdd merging.mergeLeft 1, mergeRight = merging.mergeRight, merged = kept (merging.merged, left, merging.mergeLeft))

    takeRight<T> : (Merge<T>, List<T>) -> Merge<T>
    takeRight (merging, right) = Merge(mergeLeft = merging.mergeLeft, mergeRight = satAdd merging.mergeRight 1, merged = kept (merging.merged, right, merging.mergeRight))

    // Stable: on a tie the left element goes first.
    leftFirst<T> : (Merge<T>, List<T>, List<T>, (T, T) -> bool) -> bool
    leftFirst (merging, left, right, before) = match listGet right merging.mergeRight
        Error _ => true
        Success r => match listGet left merging.mergeLeft
            Error _ => false
            Success l => before (r, l) == false

    step<T> : (Merge<T>, List<T>, List<T>, (T, T) -> bool) -> Merge<T>
    step (merging, left, right, before) = match leftFirst (merging, left, right, before)
        true => takeLeft (merging, left)
        false => takeRight (merging, right)

    merge<T> : (List<T>, List<T>, (T, T) -> bool) -> List<T>
    merge (left, right, before) = (range (0, satAdd (length left) (length right)) |> fold (Merge(mergeLeft = 0, mergeRight = 0, merged = [])) (\(merging, _) => step (merging, left, right, before))).merged

    (** Stable merge sort; `before (a, b)` holds when `a` sorts ahead of `b`. *)
    export sortBy<T> : (List<T>, (T, T) -> bool) -> List<T>
    sortBy (items, before) = match length items <= 1
        true => items
        false =>
            middle = intDiv (length items) 2
            merge (sortBy (slice (items, 0, middle), before), sortBy (slice (items, middle, length items), before), before)

(** Choosing between two already-evaluated values without a `match`. *)
module Pick
    (** `yes` when `flag` holds, otherwise `no`; both are already evaluated. *)
    export either<T> : (bool, T, T) -> T
    either (flag, yes, no) = match flag
        true => yes
        false => no
