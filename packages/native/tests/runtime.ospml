// A minimal consumer of the framework: two slices, two regions. Verifies
// [UI-SIGNALS], [UI-REGIONS], [UI-EVENTS] and [UI-PROTOCOL] through the real
// start/dispatch path.
namespace uitests

import ui::Ui
import ui::Doc
import ui::Keyed
import ui::Runtime
import ui::Requests
import ui::Lists
import ui::Messages

type Tally =
    tally : int

type Memo =
    memo : string

type Probe =
    counter : Tally
    note : Memo

// One action union per program until Nimblesite/osprey#278 generalizes the
// mutually recursive encoder.
type Act = Increment | Typed | Load

tallied () = (perform Signal<Tally>.read ()).tally

memoed () = (perform Signal<Memo>.read ()).memo

// The Go buttons deliberately look identical while changing meaning with the
// count: at 0 the first tap increments, at 1 the increment is withdrawn and
// Load shifts to the first ordinal.
goButtons () = match tallied ()
    1 => [Ui::button ("Go", "play", Load)]
    _ => [Ui::button ("Go", "play", Increment), Ui::button ("Go", "play", Load)]

rootView () = Ui::column (listConcat [Ui::text "Count ${tallied ()}"] (goButtons ()))

noteView () = Ui::column [ui::Field(label = "Note", value = memoed (), prompt = "", secure = false, multiline = false, commit = ui::OnEdit, bind = Typed), Ui::button ("Load", "tray", Load), Ui::button ("Load", "tray", Load)]

tallySlice () = perform Signal<Tally>.read ()

memoSlice () = perform Signal<Memo>.read ()

regions (before, store, frames, _) =
    handle static Signal<Tally>
        read => store.counter
    handle static Signal<Memo>
        read => store.note
    changed = listConcat (signalChanges before.counter store.counter countJson (signalDependencies tallySlice)) (signalChanges before.note store.note memoJson (signalDependencies memoSlice))
    [Keyed::region (frames, "root", changed, rootView), Keyed::region (frames, "note", changed, noteView)]

probe count text = Probe(counter = Tally(tally = count), note = Memo(memo = text))

initial context = Runtime::step (probe 0 context.platform)

loaded outcome = match outcome
    Success result => jsonText result ?: "?"
    Error problem => problem

// Typed text is kept in the store and echoed to a host-held slice, so the envelope carries a slice write.
typed (store, text) = ui::Step(stepStore = probe store.counter.tally text, requests = [], writes = [Requests::write ("echo", text)])

tapped (store, action) = match action
    Increment => Runtime::step (probe (satAdd store.counter.tally 1) store.note.memo)
    Load => Runtime::asking (store, [Requests::ask ("load:1", ui::StoreRead(readName = "memo.txt", readLimit = 100, readSlice = "memo"))])
    Typed => Runtime::step store

update (_, store, message) = Messages::route (message, \action => tapped (store, action), \(_, text) => typed (store, text), \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, outcome) => Runtime::step (probe store.counter.tally (loaded outcome)), \_ => Runtime::step store)

save store = JsonObject [Doc::num ("tally", store.counter.tally), Doc::str ("memo", store.note.memo)]

restore doc = probe (Doc::number (doc, "tally")) (Doc::text (doc, "memo"))

countJson value = JsonInt value.tally

memoJson value = JsonString value.memo

theme = ui::Theme(tokens = [ui::Token(tokenName = "canvas", tokenLight = "#FFFFFF", tokenDark = "#000000")], spacing = [4, 8], feedback = 120, settle = 220)

(** Drives the probe application through the real start and dispatch path, and reads its envelopes. *)
module Probes
    (** The probe application's first envelope. *)
    export started () = Doc::parse (Runtime::start ("{\"now\":1,\"offset\":0,\"platform\":\"macos\"}", initial, regions, save, theme))

    (** The envelope after delivering `event` to the session `envelope` left. *)
    export post (envelope, event) = Doc::parse (Runtime::dispatch (Doc::text (envelope, "state"), event, update, regions, save, restore))

    (** The keys of the regions an envelope patched, in order. *)
    export keys envelope = join (mapList (Doc::items (Doc::field (envelope, "patches")), \item => Doc::text (item, "key"))) ","

    (** A tap on control `ordinal` of `region` as drawn at `revision`. *)
    export tap (region, revision, ordinal) = "{\"kind\":\"ui\",\"region\":\"${region}\",\"revision\":${revision},\"ordinal\":${ordinal},\"value\":null,\"now\":5}"

    (** Text typed into the note field as drawn at `revision`. *)
    export typed (revision, text) = "{\"kind\":\"ui\",\"region\":\"note\",\"revision\":${revision},\"ordinal\":0,\"value\":${jsonQuote text ?: "null"},\"now\":6}"

    (** The opaque state of `envelope`, quoted for embedding in an event document. *)
    export saved envelope = jsonQuote (Doc::text (envelope, "state")) ?: "\"\""

    (** A trusted-host edit of the control `ordinal` as it was drawn in `prior` at `revision`, with `value` as JSON text. *)
    export edit (prior, region, revision, ordinal, value) = "{\"kind\":\"ui-edit\",\"prior\":${prior},\"region\":\"${region}\",\"revision\":${revision},\"ordinal\":${ordinal},\"value\":${value},\"now\":7}"

    (** The restored store of `envelope`'s session. *)
    export stored envelope = Doc::field (Doc::parse (Doc::text (envelope, "state")), "store")

    (** An envelope's diagnostics, joined by `;`. *)
    export problems envelope = join (Doc::texts (envelope, "diagnostics")) ";"

    (** The probe application's theme. *)
    export palette () = theme
