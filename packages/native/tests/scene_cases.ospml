codeAt (shapes, index) = jsonInt (jsonIndex (listGet shapes index ?: JsonNull) 0 ?: JsonNull) ?: 0 - 1

arityAt (shapes, index) = length (Doc::items (listGet shapes index ?: JsonNull))

// [UI-SCENE]: a scene encodes flat: one small array per primitive, a type code first, sprites by
// atlas index, glyph text inline, and one input binding.
(** a scene encodes its primitives as flat typed arrays. *)
sceneCaseASceneEncodesItsPrimitivesAsFlat () =
    drawn = [Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, Scenes::rgb (255, 0, 0), 0), Scenes::disc (5.0, 6.0, 7.0, Scenes::rgba (0, 0, 255, 128), 1), Scenes::strip ([0.0, 0.0, 10.0, 10.0], Scenes::rgb (0, 255, 0), 2.0, 1), Scenes::sprite (1, 8.0, 9.0, 2.0, 2.0, 0.0, Scenes::rgb (255, 255, 255), 2), Scenes::glyphs ("Score 3", 1.0, 1.0, 12.0, Scenes::rgb (0, 0, 0), 3)]
    walked = Encode::walk ([], Ui::column [Ui::button ("Pause", "pause", Load), Ui::scene (320.0, 200.0, ["bird", "hawk"], drawn, Typed)])
    doc = listGet walked.nodes 0 ?: JsonNull
    scene = jsonIndex (jsonField doc "children" ?: JsonNull) 1 ?: JsonNull
    shapes = Doc::items (Doc::field (scene, "shapes"))
    expect (Doc::text (scene, "kind"), "scene")
    expect (Doc::decimal (scene, "width"), 320.0)
    expect (Doc::decimal (scene, "height"), 200.0)
    expect (Doc::decimal (scene, "zoom"), 1.0)
    expect (join (Doc::texts (scene, "atlas")) ",", "bird,hawk")
    zoomed = listGet (Encode::walk ([], Ui::zoomed (0.75, 1536.0, 828.0, [], drawn, Typed))).nodes 0 ?: JsonNull
    expect (Doc::decimal (zoomed, "zoom"), 0.75)
    expect (Doc::decimal (zoomed, "width"), 1536.0)
    expect (length shapes, 5)
    expect (codeAt (shapes, 0), 0)
    expect (arityAt (shapes, 0), 8)
    expect (jsonInt (jsonIndex (listGet shapes 0 ?: JsonNull) 6 ?: JsonNull) ?: 0 - 1, Scenes::rgb (255, 0, 0))
    expect (codeAt (shapes, 1), 1)
    expect (arityAt (shapes, 1), 6)
    expect (codeAt (shapes, 2), 2)
    expect (arityAt (shapes, 2), 9)
    expect (jsonInt (jsonIndex (listGet shapes 2 ?: JsonNull) 1 ?: JsonNull) ?: 0 - 1, 2)
    expect (codeAt (shapes, 3), 3)
    expect (arityAt (shapes, 3), 9)
    expect (jsonInt (jsonIndex (listGet shapes 3 ?: JsonNull) 1 ?: JsonNull) ?: 0 - 1, 1)
    expect (codeAt (shapes, 4), 4)
    expect (arityAt (shapes, 4), 7)
    expect (jsonText (jsonIndex (listGet shapes 4 ?: JsonNull) 1 ?: JsonNull) ?: "", "Score 3")
    expect (Doc::number (scene, "event"), 1)
    expect (length walked.bindings, 2)

(** colours pack as RRGGBBAA. *)
sceneCaseColoursPackAsRrggbbaa () =
    expect (Scenes::rgba (1, 2, 3, 4), 16909060)
    expect (Scenes::rgb (255, 255, 255), 4294967295)

controlled value = Messages::route (Events::bind (ui::SceneInput(action = Typed), value) ?: ui::Act(act = Load), \_ => "tap", \(_, _) => "text", \(_, _) => "flag", \(_, _) => "size", \(_, _) => "done", \_ => "phase", \(_, _) => "stroke", \(_, _) => "lasso", \_ => "frame", \(_, input) => Inputs::route (input, \(name, down) => "key ${name} ${down}", \(x, y, down, shift) => "pointer ${x} ${y} ${down} ${shift}"))

// [UI-SCENE]: a scene's binding delivers keys and pointer positions and refuses anything else.
stepCode (steps, index) = jsonInt (jsonIndex (listGet steps index ?: JsonNull) 0 ?: JsonNull) ?: 0 - 1

// [UI-SCENE]: a path carries its builder commands, outline, paint and transform in the order a
// host's path builder takes them, with float colours a host can use without rounding.
(** a path encodes its steps, outline, paint and transform. *)
sceneCaseAPathEncodesItsStepsOutlinePaint () =
    steps = [ui::MoveTo(toX = 1.0, toY = 2.0), ui::LineTo(toX = 3.0, toY = 4.0), ui::CurveTo(toX = 5.0, toY = 6.0, ctrlX = 7.0, ctrlY = 8.0), ui::CubicTo(toX = 1.0, toY = 1.0, ctrlAX = 2.0, ctrlAY = 2.0, ctrlBX = 3.0, ctrlBY = 3.0), ui::ArcTo(radiusX = 30.0, radiusY = 30.0, rotation = 0.0, large = false, sweep = true, toX = 9.0, toY = 9.0), ui::Polygon(corners = [0.0, 0.0, 4.0, 0.0, 4.0, 4.0], closed = false), ui::Close]
    gradient = ui::Linear(angle = 180.0, from = Scenes::hex (16436245, 1.0), fromAt = 0.7, to = ui::Hsl(hue = 0.0, saturation = 1.0, lightness = 0.5, opacity = 1.0), toAt = 1.0, oklab = true)
    drawn = [Scenes::path (steps, ui::Fill, gradient, 0), Scenes::moved ([ui::MoveTo(toX = 0.0, toY = 0.0)], ui::Line(width = 1.0, dashes = [4.0, 2.0], bevel = true), ui::Solid(tint = Scenes::hex (16711680, 0.5)), 10.0, 200.0, 0.9, 1)]
    walked = Encode::walk ([], Ui::canvas (drawn, Typed))
    scene = listGet walked.nodes 0 ?: JsonNull
    shapes = Doc::items (Doc::field (scene, "shapes"))
    expect (Doc::decimal (scene, "width"), 0.0)
    filled = listGet shapes 0 ?: JsonNull
    expect (codeAt (shapes, 0), 5)
    encodedSteps = Doc::items (jsonIndex filled 1 ?: JsonNull)
    expect (join (mapList (range (0, 7) |> fold [] (\(out, i) => listAppend out i), \i => "${stepCode (encodedSteps, i)}")) ",", "0,1,2,3,4,5,6")
    expect (Doc::write (listGet encodedSteps 4 ?: JsonNull), "[4,30.0,30.0,0.0,0,1,9.0,9.0]")
    expect (Doc::write (jsonIndex filled 2 ?: JsonNull), "[0]")
    expect (Doc::write (jsonIndex filled 4 ?: JsonNull), "[]")
    paint = jsonIndex filled 3 ?: JsonNull
    expect (jsonInt (jsonIndex paint 0 ?: JsonNull) ?: 0, 1)
    expect (Doc::write (jsonIndex paint 4 ?: JsonNull), "[1,0.0,1.0,0.5,1.0]")
    stroked = listGet shapes 1 ?: JsonNull
    expect (Doc::write (jsonIndex stroked 2 ?: JsonNull), "[1,1.0,1,4.0,2.0]")
    expect (Doc::write (jsonIndex stroked 3 ?: JsonNull), "[0,[0,1.0,0.0,0.0,0.5]]")
    expect (Doc::write (jsonIndex stroked 4 ?: JsonNull), "[10.0,200.0,0.9]")

(** a scene binding delivers keys and pointer positions in scene units. *)
sceneCaseASceneBindingDeliversKeysAndPointer () =
    expect (controlled (JsonObject [Doc::str ("key", "ArrowLeft"), Doc::bit ("down", true)]), "key ArrowLeft true")
    expect (controlled (JsonObject [JsonMember "x" (JsonFloat 12.5), JsonMember "y" (JsonInt 3), Doc::bit ("down", false)]), "pointer 12.5 3.0 false false")
    expect (controlled (JsonObject [JsonMember "x" (JsonFloat 1.0), JsonMember "y" (JsonFloat 2.0), Doc::bit ("down", true), Doc::bit ("shift", true)]), "pointer 1.0 2.0 true true")
    expect (controlled (JsonString "left"), "tap")
    forEachList ([JsonObject [], JsonObject [Doc::str ("key", "ArrowLeft")], JsonObject [Doc::num ("key", 1), Doc::bit ("down", true)], JsonObject [Doc::num ("x", 1), Doc::bit ("down", true)], JsonObject [Doc::num ("x", 1), Doc::num ("y", 2), Doc::str ("down", "false")], JsonObject [Doc::num ("x", 1), Doc::num ("y", 2), Doc::bit ("down", true), Doc::str ("shift", "false")]], \value =>
        expect (boundAs (ui::SceneInput(action = Typed), value), "A scene control sent a value of the wrong kind"))

framed : ui::Message<Act> -> float
framed message = Messages::route (message, \_ => 0.0 - 1.0, \(_, _) => 0.0 - 2.0, \(_, _) => 0.0 - 3.0, \(_, _) => 0.0 - 4.0, \(_, _) => 0.0 - 5.0, \_ => 0.0 - 6.0, \(_, _) => 0.0 - 7.0, \(_, _) => 0.0 - 8.0, \elapsed => elapsed, \(_, _) => 0.0 - 9.0)

// [UI-SCENE]: a frame event reaches `update` as the seconds since the previous frame, and
// an application that ignores it changes no region.
eventRefusal source = match Events::decode source
    Error problem => problem
    Success _ => "accepted"

(** a frame event delivers its elapsed seconds and patches nothing when ignored. *)
sceneCaseAFrameEventDeliversItsElapsedSeconds () =
    expect (framed (ui::Frame(elapsed = 0.016)), 0.016)
    forEachList (["{\"kind\":\"frame\"}", "{\"kind\":\"frame\",\"elapsed\":\"slow\"}", "{\"kind\":\"frame\",\"elapsed\":-1}"], \source =>
        expect (eventRefusal source, "Invalid frame elapsed time"))
    started = Probes::started ()
    after = Probes::post (started, "{\"kind\":\"frame\",\"now\":9,\"elapsed\":0.016}")
    expect (Probes::problems after, "")
    expect (Probes::keys after, "")

// [UI-SCENE]: the animate request turns the host's frame clock on or off.
(** an animate request carries its on flag. *)
sceneCaseAnAnimateRequestCarriesItsOnFlag () =
    doc = Requests::encode (Requests::ask ("clock:1", ui::Animate(animated = true)))
    expect (Doc::text (doc, "kind"), "animate")
    expect (Doc::flag (doc, "on"), true)
    expect (Doc::text (doc, "ticket"), "clock:1")

occurrences (names, name) = length (range (0, length names) |> fold [] (\(found, index) => Pick::either ((listGet names index ?: "") == name, listAppend found index, found)))

symbolAt (parts, index) = Doc::text (listGet parts index ?: JsonNull, "symbol")

symbols () = [ui::NoSymbol, ui::Add, ui::Delete, ui::Dismiss, ui::Check, ui::Warning, ui::Info, ui::Question, ui::Search, ui::Settings, ui::Star, ui::Play, ui::Pause, ui::Stop, ui::Refresh, ui::Folder, ui::Document, ui::Package, ui::Inbox, ui::Globe, ui::External, ui::Lock, ui::Shield, ui::Branch, ui::Tag, ui::Clock, ui::Person, ui::Cursor, ui::Chevron]

// [UI-COMPONENTS-SYMBOLS]: every symbol has its own lowercase wire name, and only `NoSymbol` is empty.
(** every symbol encodes as a distinct host-neutral name. *)
sceneCaseEverySymbolEncodesAsADistinctHost () =
    names = mapList (symbols (), \symbol => Symbols::name symbol)
    expect (join names ",", ",add,delete,dismiss,check,warning,info,question,search,settings,star,play,pause,stop,refresh,folder,document,package,inbox,globe,external,lock,shield,branch,tag,clock,person,cursor,chevron")
    expect (Lists::any (names, \name => occurrences (names, name) != 1), false)

// [UI-COMPONENTS-SYMBOLS]: every node that shows a symbol sends its name, and a row without one sends none.
(** labels, icons, badges, empty states, buttons, tabs and rows send their symbol names. *)
sceneCaseLabelsIconsBadgesEmptyStatesButtonsTabs () =
    parts = Doc::items (Doc::field (listGet (Encode::walk ([], Ui::column [Ui::label ("L", "folder"), Ui::icon "globe", Ui::badge ("B", "shield", ui::Good), Ui::empty ("search", "E", "D"), Ui::button ("Go", "refresh", Increment), ui::Tabs(tabs = [Ui::tab ("t", "T", "clock", Ui::text "page")], selected = "t", bind = Load), Ui::rows ([Ui::item ("plain", Ui::text "p"), Ui::entry ("led", "person", "G", Ui::text "q")], "plain", Load)])).nodes 0 ?: JsonNull, "children"))
    expect (join (mapList ([0, 1, 2, 3, 4], \index => symbolAt (parts, index))) ",", "folder,globe,shield,search,refresh")
    expect (Doc::text (listGet (Doc::items (Doc::field (listGet parts 5 ?: JsonNull, "tabs"))) 0 ?: JsonNull, "symbol"), "clock")
    rows = Doc::items (Doc::field (listGet parts 6 ?: JsonNull, "rows"))
    expect (join (mapList (rows, \row => Doc::text (row, "symbol"))) ",", ",person")

// [UI-COMPONENTS]: a pair sends its label and value and takes no ordinal.
(** a pair encodes its label and value without a binding. *)
sceneCaseAPairEncodesItsLabelAndValue () =
    walked = Encode::walk ([], Ui::column [Ui::pair ("Digest", "sha256:ab"), Ui::button ("Go", "play", Increment)])
    parts = Doc::items (Doc::field (listGet walked.nodes 0 ?: JsonNull, "children"))
    doc = listGet parts 0 ?: JsonNull
    expect ("${Doc::text (doc, "kind")} ${Doc::text (doc, "label")}=${Doc::text (doc, "value")}", "pair Digest=sha256:ab")
    expect (Doc::has (doc, "event"), false)
    expect (Doc::number (listGet parts 1 ?: JsonNull, "event"), 0)
    expect (length walked.bindings, 1)

isLinux platform = match platform
    ui::Linux => true
    _ => false

otherName platform = match platform
    ui::OtherPlatform name => name
    _ => ""

platformRound text = Symbols::platformText (Symbols::platform text)

// [UI-CONTEXT-PLATFORM]: every known platform round-trips, and an unknown host name survives as `OtherPlatform`.
(** platforms decode to the union and encode back to their names. *)
sceneCasePlatformsDecodeToTheUnionAndEncode () =
    expect (join (mapList (["macos", "ios", "linux", "windows", "android", "web", "vscode", ""], platformRound)) ",", "macos,ios,linux,windows,android,web,vscode,")
    expect (isLinux (Symbols::platform "linux"), true)
    expect (otherName (Symbols::platform "haiku"), "haiku")
    expect (otherName (Symbols::platform "windows"), "")

// [UI-CONTEXT-PLATFORM]: the start context decodes its platform into the union and echoes it unchanged.
(** a start context carries a linux or windows platform. *)
sceneCaseAStartContextCarriesALinuxOr () =
    linux = Runtime::context (Doc::parse "{\"now\":5,\"offset\":0,\"platform\":\"linux\",\"home\":\"/home/me\",\"arguments\":[]}")
    expect (linux.platform, "linux")
    windows = Runtime::context (Doc::parse "{\"now\":5,\"offset\":0,\"platform\":\"windows\",\"home\":\"C:/Users/me\",\"arguments\":[]}")
    expect (windows.platform, "windows")

// [UI-EFFECTS]: work only one product or operating system can do travels as a host call, never as a framework capability.
(** product-specific work is a host call with its namespace and arguments. *)
sceneCaseProductSpecificWorkIsAHostCall () =
    expect (requestText (ui::HostCall(hostNamespace = "probe", hostOperation = "read-config", hostArguments = JsonObject [JsonMember "paths" (Doc::strings ["app.toml"])], hostTimeout = 500, hostLimit = 128, hostSlice = "prefs")), "{\"ticket\":\"job:7\",\"kind\":\"host-call\",\"namespace\":\"probe\",\"operation\":\"read-config\",\"arguments\":{\"paths\":[\"app.toml\"]},\"timeout\":500,\"limit\":128,\"slice\":\"prefs\"}")

// [UI-SCENE-STREAM] A file-scope cell of the suite's entry, written only by the stream handler's arm.


// [UI-RESIDENT] The probe application's first resident envelope and the session it leaves, and the
// step after `event`; the probe draws no scene, so its stream stays empty.


streamScene () = Ui::column [Ui::button ("Pause", "pause", Load), Ui::scene (320.0, 200.0, ["bird"], [Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, Scenes::rgb (255, 0, 0), 1), Scenes::strip ([0.0, 0.0, 10.0, 10.0], Scenes::rgb (0, 255, 0), 2.0, 1), Scenes::disc (5.0, 6.0, 7.0, Scenes::rgb (0, 0, 255), 2), Scenes::glyphs ("Score 3", 1.0, 1.0, 12.0, Scenes::rgb (0, 0, 0), 3), Scenes::sprite (1, 8.0, 9.0, 2.0, 2.0, 0.25, Scenes::rgb (255, 255, 255), 4)], Typed)]

// [UI-SCENE-STREAM]: rects, discs and sprites leave the envelope in drawing order; strips and glyphs stay, and the scene counts what it streamed.
(** a split scene streams its fixed-size primitives in order and keeps the rest. *)
sceneCaseASplitSceneStreamsItsFixedSize () =
    walked = Encode::walk ([], streamedFrom (streamScene ()))
    expect (streamedTrace, "0@1;1@2;3@4;")
    scene = jsonIndex (jsonField (listGet walked.nodes 0 ?: JsonNull) "children" ?: JsonNull) 1 ?: JsonNull
    shapes = Doc::items (Doc::field (scene, "shapes"))
    expect (Doc::number (scene, "streamed"), 3)
    expect (join (mapList (shapes, \shape => "${jsonInt (jsonIndex shape 0 ?: JsonNull) ?: 0 - 1}")) ",", "2,4")
    expect (Doc::number (scene, "event"), 1)
    expect (length walked.bindings, 2)

// [UI-SCENE-STREAM]: an unsplit scene streams nothing and says so.
(** an enveloped scene reports nothing streamed. *)
sceneCaseAnEnvelopedSceneReportsNothingStreamed () =
    scene = jsonIndex (jsonField (listGet (Encode::walk ([], streamScene ())).nodes 0 ?: JsonNull) "children" ?: JsonNull) 1 ?: JsonNull
    expect (Doc::number (scene, "streamed"), 0)
    expect (length (Doc::items (Doc::field (scene, "shapes"))), 5)

streamedFields primitive = "${Streams::code primitive} ${Streams::index primitive} ${Streams::value (primitive, 0)} ${Streams::value (primitive, 1)} ${Streams::value (primitive, 2)} ${Streams::value (primitive, 3)} ${Streams::value (primitive, 4)} ${Streams::colour primitive} ${Streams::depth primitive}"

// [UI-SCENE-STREAM]: the accessors a host import reads give each kind's code, atlas index, floats, colour and depth.
(** streamed primitives read back every field a host import takes. *)
sceneCaseStreamedPrimitivesReadBackEveryFieldA () =
    expect (streamedFields (Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, 7, 1)), "0 0 1.0 2.0 3.0 4.0 0.5 7 1")
    expect (streamedFields (Scenes::disc (5.0, 6.0, 7.0, 8, 2)), "1 0 5.0 6.0 7.0 0.0 0.0 8 2")
    expect (streamedFields (Scenes::sprite (3, 8.0, 9.0, 2.0, 1.0, 0.25, 9, 4)), "3 3 8.0 9.0 2.0 1.0 0.25 9 4")
    expect (Streams::streamed (Scenes::glyphs ("x", 0.0, 0.0, 1.0, 0, 0)), false)

// [UI-RESIDENT]: a resident session's envelope carries a marker, never the store, and the session itself moves on.
(** a resident session keeps its store out of the envelope. *)
sceneCaseAResidentSessionKeepsItsStoreOut () =
    first = begun ()
    doc = Doc::parse first.residentEnvelope
    expect (Doc::text (doc, "state"), "resident")
    expect (Probes::keys doc, "root,note")
    expect (first.residentSession.sessionContext.platform, "linux")
    tapped = proceeded (first.residentSession, Probes::tap ("root", 1, 0))
    expect (Probes::keys (Doc::parse tapped.residentEnvelope), "root")
    expect (tapped.residentSession.sessionStore.counter.tally, 1)
    expect (Doc::text (Doc::parse tapped.residentEnvelope, "state"), "resident")

// [UI-RESIDENT]: stale controls are refused as in a saved session, and an edit against a prior state cannot be recovered.
(** a resident session refuses stale controls and prior-state edits without change. *)
sceneCaseAResidentSessionRefusesStaleControlsAnd () =
    first = begun ()
    moved = proceeded (first.residentSession, Probes::tap ("root", 1, 0))
    stale = proceeded (moved.residentSession, Probes::tap ("root", 1, 0))
    expect (Probes::keys (Doc::parse stale.residentEnvelope), "")
    expect (contains (Probes::problems (Doc::parse stale.residentEnvelope)) "Stale control", true)
    expect (stale.residentSession.sessionStore.counter.tally, 1)
    edited = proceeded (moved.residentSession, Probes::edit ("\"resident\"", "root", 1, 0, "null"))
    expect (contains (Probes::problems (Doc::parse edited.residentEnvelope)) "keeps no prior state", true)
    expect (edited.residentSession.sessionStore.counter.tally, 1)

// One scene holding a single disc at `layer`, so the stream's order names the container it was found in.
dot layer = Ui::scene (10.0, 10.0, [], [Scenes::disc (1.0, 1.0, 1.0, 0, layer)], Typed)

everyContainer () = Ui::split [
    Ui::screen ("T", "", [dot 1], [ui::Section(title = "S", footer = "", children = [dot 2])]),
    Ui::layer [Ui::contextMenu (dot 3, [dot 4]), Ui::aside (dot 5, ui::Leading, dot 6, 300, Typed)],
    ui::Tabs(tabs = [Ui::tab ("t", "T", "tag", dot 7)], selected = "t", bind = Load),
    Ui::rows ([Ui::entry ("r", "star", "", dot 8)], "r", Load),
    Ui::disclosure ("D", true, Load, [dot 9]),
]

// [UI-SCENE-STREAM]: every container is walked in the encoder's order: a screen's toolbar before its
// children, a context menu's body before its actions, an aside's pane before its column.
(** a split streams scenes from every container in the encoder's order. *)
sceneCaseASplitStreamsScenesFromEveryContainer () =
    walked = Encode::walk ([], streamedFrom (everyContainer ()))
    expect (length walked.nodes, 1)
    expect (contains streamedTrace "1@1;1@2;1@3;1@4;1@5;1@6;1@7;1@8;1@9;", true)

// [UI-SCENE-STREAM]: primitives that never stream read back neutral fields.
(** primitives that do not stream read back zero fields. *)
sceneCasePrimitivesThatDoNotStreamReadBack () =
    strip = Scenes::strip ([0.0, 0.0, 1.0, 1.0], 9, 1.0, 4)
    expect ("${Streams::value (strip, 0)} ${Streams::colour strip} ${Streams::depth strip} ${Streams::index strip}", "0.0 0 0 0")
    expect (Streams::streamed strip, false)

frameEvent = "{\"kind\":\"frame\",\"now\":9,\"elapsed\":0.5}"

// [UI-RESIDENT]: completions, lifecycle phases and frames reach `update` in a resident session, and text
// that is not an event is refused without change.
(** a resident session delivers completions, phases and frames and refuses malformed text. *)
sceneCaseAResidentSessionDeliversCompletionsPhasesAnd () =
    first = begun ()
    done = proceeded (first.residentSession, "{\"kind\":\"completed\",\"ticket\":\"load:1\",\"ok\":true,\"result\":\"saved\",\"now\":7}")
    expect (done.residentSession.sessionStore.note.memo, "saved")
    phased = proceeded (done.residentSession, "{\"kind\":\"lifecycle\",\"phase\":\"active\",\"now\":8}")
    expect (Probes::problems (Doc::parse phased.residentEnvelope), "")
    framed = proceeded (phased.residentSession, frameEvent)
    expect (framed.residentSession.sessionContext.now, 9)
    broken = proceeded (framed.residentSession, "not json")
    expect (contains (Probes::problems (Doc::parse broken.residentEnvelope)) "not JSON", true)
    expect (broken.residentSession.sessionStore.note.memo, "saved")

// [UI-RESIDENT]: an idle session holds the store with no host facts and no regions yet.
(** an idle session holds only its store. *)
sceneCaseAnIdleSessionHoldsOnlyItsStore () =
    held = Runtime::idle 3
    expect ("${held.sessionStore} ${length held.sessionFrames} ${held.sessionContext.now}", "3 0 0")

routed : ui::Message<Act> -> string
routed message = Messages::route (message, \_ => "tap", \(_, text) => "text ${text}", \(_, on) => "flag ${on}", \(_, width) => "size ${width}", \(ticket, _) => "done ${ticket}", \phase => "phase ${phase}", \(_, _) => "stroke", \(_, _) => "lasso", \_ => "frame", \(_, _) => "input")

boundAs (binding, value) = match Events::bind (binding, value)
    Success delivered => routed delivered
    Error problem => problem

// [UI-EVENTS]: toggles deliver flags, pickers deliver keys, and a value of the wrong kind is refused.
(** toggles and pickers deliver their own value kinds and refuse others. *)
sceneCaseTogglesAndPickersDeliverTheirOwnValue () =
    expect (boundAs (ui::FlagInput(action = Typed), JsonBool true), "flag true")
    expect (boundAs (ui::FlagInput(action = Typed), JsonString "on"), "A toggle control sent a value of the wrong kind")
    expect (boundAs (ui::ChoiceInput(action = Load), JsonString "b"), "text b")
    expect (boundAs (ui::ChoiceInput(action = Load), JsonInt 1), "A choice control sent a value of the wrong kind")
    expect (routed (ui::Phase(phase = "active")), "phase active")

// [UI-COMPONENTS]: progress, swatches, alerts, prominent buttons and leading asides keep their protocol spellings.
(** progress, swatches, alerts, prominent buttons and leading asides encode. *)
sceneCaseProgressSwatchesAlertsProminentButtonsAndLeading () =
    parts = Doc::items (Doc::field (listGet (Encode::walk ([], Ui::column [ui::Progress(label = "P", detail = "d"), ui::Swatch(name = "S", light = "#fff", dark = "#000"), ui::Alert(title = "A", message = "m", visible = true, dismiss = Load), Ui::action ("Go", "play", ui::Prominent, true, Increment), Ui::aside (Ui::text "p", ui::Leading, Ui::text "c", 300, Typed)])).nodes 0 ?: JsonNull, "children"))
    expect (join (mapList (parts, \part => Doc::text (part, "kind"))) ",", "progress,swatch,alert,button,aside")
    expect (Doc::text (listGet parts 3 ?: JsonNull, "role"), "prominent")
    expect (Doc::text (listGet parts 4 ?: JsonNull, "side"), "leading")

// Pinned to the suite's action union: the encoder is instantiated at one action type (#278).
meterAt (amount, total) =
    walked = Encode::walk ([], Ui::column [Ui::meter ("Used", amount, total, ui::Caution), Ui::button ("Go", "play", Increment)])
    jsonEncode (listGet (Doc::items (Doc::field (listGet walked.nodes 0 ?: JsonNull, "children"))) 0 ?: JsonNull) ?: "encode failed"

// [UI-COMPONENTS-METER]: a meter's amount is clamped into its total, and its total is never below 1.
(** a meter sends its amount clamped into a total of at least one. *)
sceneCaseAMeterSendsItsAmountClampedInto () =
    expect (meterAt (30, 120), "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":30,\"total\":120,\"tone\":\"caution\"}")
    expect (meterAt (500, 120), "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":120,\"total\":120,\"tone\":\"caution\"}")
    expect (meterAt (0 - 4, 120), "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":0,\"total\":120,\"tone\":\"caution\"}")
    expect (meterAt (3, 0), "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":1,\"total\":1,\"tone\":\"caution\"}")
