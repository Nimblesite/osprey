type Ranked =
    name : string
    rank : int
// [UI-COMPONENTS-MATH]: each layout variant preserves its semantic children.
mathSamples () = [
    { layout = ui::Sym "x", encoded = "{\"kind\":\"sym\",\"text\":\"x\"}" },
    { layout = ui::Num "2", encoded = "{\"kind\":\"num\",\"text\":\"2\"}" },
    { layout = ui::Seq [], encoded = "{\"kind\":\"seq\",\"items\":[]}" },
    { layout = ui::Sup (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sup\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" },
    { layout = ui::Sub (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sub\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" },
    { layout = ui::Frac (ui::Num "2") (ui::Sym "x"), encoded = "{\"kind\":\"frac\",\"top\":{\"kind\":\"num\",\"text\":\"2\"},\"bottom\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Root (ui::Sym "x"), encoded = "{\"kind\":\"root\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Binder "∀" [ui::Sym "x"] (ui::Sym "x"), encoded = "{\"kind\":\"binder\",\"symbol\":\"∀\",\"names\":[{\"kind\":\"sym\",\"text\":\"x\"}],\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Op "=" (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"op\",\"symbol\":\"=\",\"left\":{\"kind\":\"sym\",\"text\":\"x\"},\"right\":{\"kind\":\"num\",\"text\":\"2\"}}" },
    { layout = ui::Paren (ui::Sym "x"), encoded = "{\"kind\":\"paren\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Big "∑" (ui::Num "0") (ui::Sym "n") (ui::Sym "x"), encoded = "{\"kind\":\"big\",\"symbol\":\"∑\",\"lower\":{\"kind\":\"num\",\"text\":\"0\"},\"upper\":{\"kind\":\"sym\",\"text\":\"n\"},\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
]
test ("mathematics encodes every layout variant without flattening", \() =>
    forEachList (mathSamples (), \sample => expect (Doc::write (Maths::encode sample.layout), sample.encoded)))
test ("mathematics keeps accessibility text and consumes no control ordinal", \() =>
    built = Ui::column [Ui::button ("Before", "", Increment), Maths::typeset (ui::Seq [ui::Sym "α", ui::Sym "<", ui::Num "2"], "α < 2 \"quoted\"\n"), Ui::button ("After", "", Load)]
    walked = Encode::walk ([], built)
    doc = listGet walked.nodes 0 ?: JsonNull
    children = Doc::items (Doc::field (doc, "children"))
    maths = listGet children 1 ?: JsonNull
    expect (Doc::text (maths, "kind"), "math")
    expect (Doc::text (maths, "spoken"), "α < 2 \"quoted\"\n")
    expect (Doc::text (Doc::field (maths, "math"), "kind"), "seq")
    expect (length (Doc::items (Doc::field (Doc::field (maths, "math"), "items"))), 3)
    expect (Doc::has (maths, "event"), false)
    expect (Doc::number (listGet children 2 ?: JsonNull, "event"), 1)
    expect (length walked.bindings, 2))

tree () = Ui::column [
    Ui::text "Title \"quoted\"\n",
    Ui::button ("Go", "play", Increment),
    Ui::section ("S", "", [ui::Field(label = "Q", value = "", prompt = "", secure = false, multiline = false, commit = ui::OnSubmit, bind = Typed)]),
    ui::Picker(label = "P", choices = [Ui::choice ("a", "A")], selected = "a", bind = Load),
]

encoded () = jsonEncode (listGet (Encode::walk ([], tree ())).nodes 0 ?: JsonNull) ?: ""

kindAt doc path = jsonText (jsonField (jsonIndex (jsonField doc "children" ?: JsonNull) path ?: JsonNull) "kind" ?: JsonNull) ?: "missing"
// [UI-COMPONENTS]: a disclosure binds before the controls it reveals.
revealed () = Ui::layer [Ui::disclosure ("Limits", false, Load, [Ui::label ("Scope", "info"), ui::Spacer, Ui::button ("Go", "play", Increment)]), Ui::slot "alert"]
test ("a disclosure takes its ordinal before the controls it reveals", \() =>
    walked = Encode::walk ([], revealed ())
    doc = listGet walked.nodes 0 ?: JsonNull
    disclosure = jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull
    go = jsonIndex (jsonField disclosure "children" ?: JsonNull) 2 ?: JsonNull
    expect (length walked.bindings, 2)
    expect (kindAt doc 0, "disclosure")
    expect (jsonInt (jsonField disclosure "event" ?: JsonNull) ?: 0 - 1, 0)
    expect (jsonInt (jsonField go "event" ?: JsonNull) ?: 0 - 1, 1))
// [UI-EVENTS]: a screen's toolbar controls are bound before its children.
test ("a screen's toolbar controls take ordinals before its children", \() =>
    walked = Encode::walk ([], Ui::screen ("T", "", [Ui::field ("F", "", "p", Typed)], [Ui::button ("Go", "play", Increment)]))
    doc = listGet walked.nodes 0 ?: JsonNull
    field = jsonIndex (jsonField doc "toolbar" ?: JsonNull) 0 ?: JsonNull
    button = jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull
    expect (jsonInt (jsonField field "event" ?: JsonNull) ?: 0 - 1, 0)
    expect (jsonInt (jsonField button "event" ?: JsonNull) ?: 0 - 1, 1))
// [UI-COMPONENTS]: an aside's pane binds before its column; rows carry their symbol and group.
inspected () = Ui::aside (Ui::rows ([Ui::entry ("a", "star", "Recent", Ui::text "A")], "a", Load), ui::Trailing, Ui::column [Ui::icon "info", ui::Divider, Ui::button ("Go", "play", Increment)], 420, Typed)
test ("an aside's pane takes ordinals before its column and rows keep their symbol and group", \() =>
    walked = Encode::walk ([], inspected ())
    doc = listGet walked.nodes 0 ?: JsonNull
    pane = jsonField doc "pane" ?: JsonNull
    row = jsonIndex (jsonField pane "rows" ?: JsonNull) 0 ?: JsonNull
    go = jsonIndex (jsonField (jsonField doc "aside" ?: JsonNull) "children" ?: JsonNull) 2 ?: JsonNull
    expect (jsonText (jsonField doc "side" ?: JsonNull) ?: "", "trailing")
    expect (jsonInt (jsonField pane "event" ?: JsonNull) ?: 0 - 1, 0)
    expect (jsonInt (jsonField go "event" ?: JsonNull) ?: 0 - 1, 1)
    expect (jsonText (jsonField row "symbol" ?: JsonNull) ?: "", "star")
    expect (jsonText (jsonField row "group" ?: JsonNull) ?: "", "Recent"))
// [UI-COMPONENTS-SPLITTER]: the splitter between an aside's pane and its column carries the column's width and
// limits, and binds after both columns so their controls keep their ordinals.
test ("an aside's splitter carries the column width and its limits and binds after both columns", \() =>
    walked = Encode::walk ([], inspected ())
    doc = listGet walked.nodes 0 ?: JsonNull
    expect (length walked.bindings, 3)
    expect (Doc::number (doc, "width"), 420)
    expect (Doc::number (doc, "least"), Splitters::least)
    expect (Doc::number (doc, "most"), Splitters::most)
    expect (Doc::number (doc, "keep"), Splitters::keep)
    expect (Doc::number (doc, "event"), 2))

resized value = Messages::route (Events::bind (ui::SizeInput(action = Typed), value) ?: ui::Act(act = Load), \_ => 0 - 1, \(_, _) => 0 - 2, \(_, _) => 0 - 3, \(_, points) => points, \(_, _) => 0 - 4, \_ => 0 - 5, \(_, _) => 0 - 6, \(_, _) => 0 - 7, \_ => 0 - 8, \(_, _) => 0 - 9)
// [UI-COMPONENTS-SPLITTER]: a dragged width reaches the application only within the splitter's limits, and only as a whole number of points.
test ("a splitter delivers its dragged width clamped to its limits", \() =>
    expect (resized (JsonInt 420), 420)
    expect (resized (JsonInt 9000), Splitters::most)
    expect (resized (JsonInt 10), Splitters::least)
    expect (resized (JsonInt (0 - 50)), Splitters::least)
    expect (resized (JsonString "wide"), 0 - 1)
    expect (resized JsonNull, 0 - 1))
// [UI-COMPONENTS]: a link names its web destination and binds nothing; the host opens it in the browser.
test ("a link carries its label and web address and takes no ordinal", \() =>
    walked = Encode::walk ([], Ui::column [Ui::link ("Osprey guide", "https://example.test/guide"), Ui::button ("Go", "play", Increment)])
    doc = listGet walked.nodes 0 ?: JsonNull
    link = jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull
    go = jsonIndex (jsonField doc "children" ?: JsonNull) 1 ?: JsonNull
    expect (kindAt doc 0, "link")
    expect (jsonText (jsonField link "label" ?: JsonNull) ?: "", "Osprey guide")
    expect (jsonText (jsonField link "url" ?: JsonNull) ?: "", "https://example.test/guide")
    expect (jsonInt (jsonField link "event" ?: JsonNull) ?: 0 - 1, 0 - 1)
    expect (length walked.bindings, 1)
    expect (jsonInt (jsonField go "event" ?: JsonNull) ?: 0 - 1, 0))
test ("controls take depth-first ordinals in drawing order", \() =>
    expect (length (Encode::walk ([], tree ())).bindings, 3))
test ("an encoded region decodes with its components and text intact", \() =>
    doc = jsonDecode (encoded ()) ?: JsonNull
    expect (kindAt doc 2, "section")
    title = jsonText (jsonField (jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull) "text" ?: JsonNull) ?: "missing"
    expect (title, "Title \"quoted\"\n"))
test ("a control carries the ordinal of its binding", \() =>
    doc = jsonDecode (encoded ()) ?: JsonNull
    picker = jsonIndex (jsonField doc "children" ?: JsonNull) 3 ?: JsonNull
    expect (jsonInt (jsonField picker "event" ?: JsonNull) ?: 0 - 1, 2))
test ("start sends every region once with the theme", \() =>
    first = Probes::started ()
    expect (Probes::keys first, "root,note")
    expect (Doc::number (first, "version"), 1)
    expect (Doc::text (Doc::field (first, "theme"), "feedback") == "", true)
    expect (Doc::number (Doc::field (first, "theme"), "settle"), 220))
test ("a tap refreshes only the region whose signal changed", \() =>
    second = Probes::post (Probes::started (), Probes::tap ("root", 1, 0))
    expect (Probes::keys second, "root")
    expect (Probes::problems second, "")
    root = Doc::field (listGet (Doc::items (Doc::field (second, "patches"))) 0 ?: JsonNull, "node")
    label = Doc::text (listGet (Doc::items (Doc::field (root, "children"))) 0 ?: JsonNull, "text")
    expect (label, "Count 1"))
test ("text input reaches update through its binding and patches its own region", \() =>
    second = Probes::post (Probes::started (), Probes::typed (1, "hello"))
    expect (Probes::keys second, "note")
    echo = listGet (Doc::items (Doc::field (second, "slices"))) 0 ?: JsonNull
    expect ("${Doc::text (echo, "key")}=${Doc::text (echo, "text")}", "echo=hello")
    third = Probes::post (second, Probes::tap ("root", 1, 0))
    expect (Probes::keys third, "root"))
test ("stale, unknown and mismatched events are rejected without change", \() =>
    second = Probes::post (Probes::started (), Probes::tap ("root", 1, 0))
    stale = Probes::post (second, Probes::tap ("root", 1, 0))
    expect (contains (Probes::problems stale) "Stale control", true)
    expect (Probes::keys stale, "")
    unknown = Probes::post (second, Probes::tap ("root", 2, 9))
    expect (contains (Probes::problems unknown) "Unknown control", true)
    wrongKind = Probes::post (second, "{\"kind\":\"ui\",\"region\":\"note\",\"revision\":1,\"ordinal\":1,\"value\":\"x\",\"now\":6}")
    expect (contains (Probes::problems wrongKind) "wrong kind", true)
    gone = Probes::post (second, Probes::tap ("missing", 1, 0))
    expect (contains (Probes::problems gone) "Stale control", true))
// [UI-EVENTS]: a trusted-host edit resolves the control the prior state meant through its typed binding, not its stale ordinal.
test ("an edit from prior state keeps its meaning when ordinals shift", \() =>
    first = Probes::started ()
    // At count 0 the Go buttons are [Increment, Load]; the host taps ordinal 0.
    counted = Probes::post (first, Probes::edit (Probes::saved (first), "root", 1, 0, "null"))
    expect (Probes::problems counted, "")
    expect (Probes::keys counted, "root")
    root = Doc::field (listGet (Doc::items (Doc::field (counted, "patches"))) 0 ?: JsonNull, "node")
    expect (Doc::text (listGet (Doc::items (Doc::field (root, "children"))) 0 ?: JsonNull, "text"), "Count 1")
    // At count 1 the buttons are [Load]; the host's ordinal 0 (Increment in prior) still means Increment, but it is withdrawn now.
    shifted = Probes::post (counted, Probes::edit (Probes::saved (first), "root", 1, 0, "null"))
    expect (Probes::keys shifted, "")
    expect (Doc::number (Probes::stored counted, "tally"), 1)
    // Prior ordinal 1 (Load) still means Load even though it now sits at ordinal 0.
    loaded = Probes::post (counted, Probes::edit (Probes::saved (first), "root", 1, 1, "null"))
    expect (Probes::problems loaded, "")
    expect (Doc::text (listGet (Doc::items (Doc::field (loaded, "requests"))) 0 ?: JsonNull, "ticket"), "load:1"))
// [UI-EVENTS]: identical-looking controls are told apart by their typed actions; a withdrawn action refuses.
test ("an edit whose typed action is gone or ambiguous refuses without change", \() =>
    first = Probes::started ()
    // Prior ordinal 1 is Load; the note region draws two identical Load buttons.
    duped = Probes::post (first, Probes::edit (Probes::saved (first), "note", 1, 1, "null"))
    expect (contains (Probes::problems duped) "More than one", true)
    expect (Probes::keys duped, "")
    expect (length (Doc::items (Doc::field (duped, "patches"))), 0)
    // At count 1 only Load is drawn; the withdrawn Increment (prior ordinal 0) refuses instead of dispatching Load.
    counted = Probes::post (first, Probes::edit (Probes::saved (first), "root", 1, 0, "null"))
    gone = Probes::post (counted, Probes::edit (Probes::saved (first), "root", 1, 0, "null"))
    expect (contains (Probes::problems gone) "no longer exists", true)
    expect (Probes::keys gone, "")
    expect (length (Doc::items (Doc::field (gone, "patches"))), 0)
    // The refusal changed nothing: the current session still answers its own controls.
    intact = Probes::post (gone, Probes::tap ("root", 2, 0))
    expect (Probes::problems intact, "")
    expect (Doc::text (listGet (Doc::items (Doc::field (intact, "requests"))) 0 ?: JsonNull, "ticket"), "load:1")
    expect (Doc::number (Probes::stored intact, "tally"), 1))
// [UI-EVENTS]: an edit is refused when its original revision, region or ordinal cannot be recovered from the prior state.
test ("an edit with an impossible original refuses without change", \() =>
    first = Probes::started ()
    outdated = Probes::post (first, Probes::edit (Probes::saved (first), "root", 9, 0, "null"))
    expect (contains (Probes::problems outdated) "Stale control", true)
    expect (Probes::keys outdated, "")
    absent = Probes::post (first, Probes::edit (Probes::saved (first), "gone", 1, 0, "null"))
    expect (contains (Probes::problems absent) "Stale control", true)
    unknown = Probes::post (first, Probes::edit (Probes::saved (first), "root", 1, 9, "null"))
    expect (contains (Probes::problems unknown) "Unknown control", true)
    unreadable = Probes::post (first, Probes::edit ("\"not a session\"", "root", 1, 0, "null"))
    expect (contains (Probes::problems unreadable) "Stale control", true)
    wrongKind = Probes::post (first, Probes::edit (Probes::saved (first), "note", 1, 0, "7"))
    expect (contains (Probes::problems wrongKind) "wrong kind", true)
    expect (Probes::keys wrongKind, "")
    expect (length (Doc::items (Doc::field (wrongKind, "requests"))), 0)
    // Every refusal left the session whole.
    after = Probes::post (first, Probes::tap ("root", 1, 0))
    expect (Probes::problems after, "")
    expect (Doc::number (Probes::stored after, "tally"), 1))
// [UI-EVENTS]: a resolved edit runs update on the current session, never on the prior state.
test ("a resolved edit updates the current state", \() =>
    first = Probes::started ()
    typed = Probes::post (first, Probes::typed (1, "hello"))
    counted = Probes::post (typed, Probes::tap ("root", 1, 0))
    edited = Probes::post (counted, Probes::edit (Probes::saved (first), "note", 1, 0, "\"world\""))
    expect (Probes::problems edited, "")
    expect (Doc::text (Probes::stored edited, "memo"), "world")
    expect (Doc::text (Probes::stored typed, "memo"), "hello")
    // The carried-over tally proves the prior state was not restored.
    expect (Doc::number (Probes::stored edited, "tally"), 1))
test ("capability requests carry tickets and completions return to update", \() =>
    asked = Probes::post (Probes::started (), Probes::tap ("note", 1, 1))
    request = listGet (Doc::items (Doc::field (asked, "requests"))) 0 ?: JsonNull
    expect (Doc::text (request, "ticket"), "load:1")
    expect (Doc::text (request, "kind"), "store-read")
    done = Probes::post (asked, "{\"kind\":\"completed\",\"ticket\":\"load:1\",\"ok\":true,\"result\":\"from disk\",\"now\":9}")
    expect (Probes::keys done, "note")
    field = listGet (Doc::items (Doc::field (Doc::field (listGet (Doc::items (Doc::field (done, "patches"))) 0 ?: JsonNull, "node"), "children"))) 0 ?: JsonNull
    expect (Doc::text (field, "value"), "from disk"))
test ("malformed events are diagnosed, never guessed", \() =>
    bad = Probes::post (Probes::started (), "{not json")
    expect (Probes::problems bad, "The host sent an event that is not JSON")
    odd = Probes::post (Probes::started (), "{\"kind\":\"telepathy\",\"now\":1}")
    expect (Probes::problems odd, "Unknown event kind: telepathy"))
test ("contrast follows WCAG relative luminance", \() =>
    expect (Contrast::ratio ("#000000", "#FFFFFF") > 20.99, true)
    expect (Contrast::ratio ("#777777", "#777777") < 1.0001, true))
test ("sorting is stable and lists stay total", \() =>
    pairs = [Ranked(name = "b", rank = 1), Ranked(name = "a", rank = 2), Ranked(name = "b", rank = 3)]
    sorted = Lists::sortBy (pairs, \(x, y) => x.name < y.name)
    expect (join (mapList (sorted, \pair => "${pair.name}${pair.rank}")) ",", "a2,b1,b3")
    expect (Lists::distinct ["a", "b", "a"], false)
    expect (Lists::position (["a", "b", "b"], \item => item == "b"), 1)
    expect (Lists::position (["a"], \item => item == "z"), 0 - 1))
// [UI-COMPONENTS] [UI-EVENTS]: tabs encode their pages and bind as one choice after the pages' controls; segments carry their tones.
tabbed () = Ui::column [
    ui::Tabs(tabs = [Ui::tab ("one", "One", "1.circle", Ui::button ("Go", "play", Increment)), Ui::tab ("two", "Two", "2.circle", Ui::caption "Second")], selected = "two", bind = Load),
    ui::Segments(tones = [ui::Good, ui::Danger], label = "2 states"),
]
test ("tabs carry their pages and bind after the pages' controls, and segments carry their tones", \() =>
    walked = Encode::walk ([], tabbed ())
    doc = listGet walked.nodes 0 ?: JsonNull
    tabs = jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull
    second = jsonIndex (jsonField tabs "tabs" ?: JsonNull) 1 ?: JsonNull
    segments = jsonIndex (jsonField doc "children" ?: JsonNull) 1 ?: JsonNull
    expect (length walked.bindings, 2)
    expect (Doc::text (tabs, "kind"), "tabs")
    expect (Doc::text (tabs, "selected"), "two")
    expect (Doc::number (tabs, "event"), 1)
    expect (Doc::text (second, "label"), "Two")
    expect (Doc::text (second, "symbol"), "2.circle")
    expect (Doc::text (Doc::field (second, "child"), "text"), "Second")
    expect (Doc::text (Doc::field (second, "child"), "role"), "caption")
    expect (join (Doc::texts (segments, "tones")) ",", "good,danger")
    expect (Doc::text (segments, "label"), "2 states"))
// [UI-COMPONENTS]: every constructor encodes as the component it names, with its role, tone, axis and enabled state.
built () = Ui::split [Ui::row [Ui::styled ("H", ui::Heading, ui::Accent), Ui::evidence ("Label", "Value"), Ui::badge ("Partial", "info", ui::Caution), Ui::empty ("inbox", "Nothing", "Why"), Ui::action ("Stop", "stop", ui::Destructive, false, Load), Ui::toggle ("AI", true, Typed), Ui::picker ("Model", [Ui::choice ("a", "A")], "a", Load), Ui::rows ([Ui::item ("k", Ui::text "cell")], "k", Load)]]
test ("every constructor encodes as the component it names", \() =>
    doc = listGet (Encode::walk ([], built ())).nodes 0 ?: JsonNull
    row = jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull
    parts = Doc::items (Doc::field (row, "children"))
    expect (Doc::text (doc, "kind"), "split")
    expect (Doc::text (row, "axis"), "horizontal")
    expect (join (mapList (parts, \child => Doc::text (child, "kind"))) ",", "text,evidence,badge,empty,button,toggle,picker,rows")
    expect (Doc::text (listGet parts 0 ?: JsonNull, "role"), "heading")
    expect (Doc::text (listGet parts 0 ?: JsonNull, "tone"), "accent")
    expect (Doc::text (listGet parts 2 ?: JsonNull, "tone"), "caution")
    expect (Doc::text (listGet parts 3 ?: JsonNull, "detail"), "Why")
    expect (Doc::text (listGet parts 4 ?: JsonNull, "role"), "destructive")
    expect (Doc::flag (listGet parts 4 ?: JsonNull, "enabled"), false)
    expect (Doc::flag (listGet parts 5 ?: JsonNull, "on"), true)
    expect (Doc::text (listGet (Doc::items (Doc::field (listGet parts 7 ?: JsonNull, "rows"))) 0 ?: JsonNull, "key"), "k"))
// [UI-EFFECTS]: a run and an HTTP request encode their bounds, headers and the slices their output lands in.
runRequest plist = Requests::encode (Requests::ask ("ps", ui::Run(executable = "/bin/ps", arguments = ["-axo", "pid="], timeout = 10000, outputLimit = 8000000, plist = plist, runSlice = "work/run")))
test ("run and http requests encode their bounds, headers and slices", \() =>
    run = runRequest false
    expect (Doc::text (run, "ticket"), "ps")
    expect (Doc::text (run, "kind"), "run")
    expect (join (Doc::texts (run, "arguments")) " ", "-axo pid=")
    expect (Doc::number (run, "timeout"), 10000)
    expect (Doc::number (run, "limit"), 8000000)
    expect (Doc::flag (run, "plist"), false)
    expect (Doc::has (run, "plist"), true)
    expect (Doc::flag (runRequest true, "plist"), true)
    expect (Doc::has (runRequest true, "plist"), true)
    expect (Doc::text (run, "slice"), "work/run")
    http = Requests::encode (Requests::ask ("kev", ui::Http(method = "GET", url = "https://example.test/feed", headers = [ui::Header(headerName = "Accept", headerValue = "application/json")], body = "", responseLimit = 1000, deadline = 30000, httpSlice = "work/http")))
    header = listGet (Doc::items (Doc::field (http, "headers"))) 0 ?: JsonNull
    expect (Doc::text (http, "method"), "GET")
    expect ("${Doc::text (header, "name")}: ${Doc::text (header, "value")}", "Accept: application/json")
    expect (Doc::number (http, "limit"), 1000)
    expect (Doc::number (http, "timeout"), 30000)
    expect (Doc::text (http, "slice"), "work/http")
    write = Requests::write ("echo", "text")
    expect ("${write.sliceKey}=${write.sliceText}", "echo=text"))

named key = match Themes::named (Probes::palette (), key)
    Success token => token.tokenLight
    Error _ => "none"
// [UI-SIGNALS] [UI-THEME]: documents, lists and themes read totally, and a host-held slice counts as changed only when written.
test ("documents, lists, themes and slice writes are read totally", \() =>
    doc = Doc::parse "{\"a\":1,\"b\":null}"
    expect (Doc::has (doc, "b"), true)
    expect (Doc::has (doc, "c"), false)
    expect (length (Doc::members doc), 2)
    expect (length (Doc::members JsonNull), 0)
    expect (Lists::all ([2, 4], \n => n > 1), true)
    expect (Lists::all ([2, 0], \n => n > 1), false)
    expect (join (Lists::flatten [["a"], [], ["b", "c"]]) "", "abc")
    expect (named "canvas", "#FFFFFF")
    expect (named "ink", "none")
    expect (join (Signals::written ([Requests::write ("echo", "x")], "echo", ["Memo"])) ",", "Memo")
    expect (length (Signals::written ([], "echo", ["Memo"])), 0))

requestText capability = jsonEncode (Requests::encode (Requests::ask ("job:7", capability))) ?: "encode failed"
// [UI-EFFECTS]: the complete host payload retains the ticket and every requested argument.
test ("filesystem and store requests preserve paths bounds and slices", \() =>
    expect (requestText (ui::Fingerprint(file = "a.txt", fileLimit = 64)), "{\"ticket\":\"job:7\",\"kind\":\"fingerprint\",\"path\":\"a.txt\",\"limit\":64}")
    expect (requestText (ui::ReadPropertyLists(plists = ["app.plist"], plistKeys = ["CFBundleName"], plistSuffixes = [".plist"], plistLimit = 128, plistSlice = "prefs")), "{\"ticket\":\"job:7\",\"kind\":\"read-plists\",\"paths\":[\"app.plist\"],\"keys\":[\"CFBundleName\"],\"suffixes\":[\".plist\"],\"limit\":128,\"slice\":\"prefs\"}")
    expect (requestText (ui::ListDirectories(directories = ["/tmp", "/Users/me"], entryLimit = 12, listSlice = "listing")), "{\"ticket\":\"job:7\",\"kind\":\"list-directories\",\"paths\":[\"/tmp\",\"/Users/me\"],\"limit\":12,\"slice\":\"listing\"}")
    expect (requestText (ui::ReadTexts(texts = ["a.txt", "b.txt"], textLimit = 256, textSlice = "text")), "{\"ticket\":\"job:7\",\"kind\":\"read-texts\",\"paths\":[\"a.txt\",\"b.txt\"],\"limit\":256,\"slice\":\"text\"}")
    expect (requestText (ui::StoreWrite(writeName = "note.txt", writeSlice = "draft")), "{\"ticket\":\"job:7\",\"kind\":\"store-write\",\"name\":\"note.txt\",\"slice\":\"draft\"}")
    expect (requestText (ui::StoreList(folder = "notes")), "{\"ticket\":\"job:7\",\"kind\":\"store-list\",\"name\":\"notes\"}")
    expect (requestText (ui::StoreDelete(deleteName = "old.txt")), "{\"ticket\":\"job:7\",\"kind\":\"store-delete\",\"name\":\"old.txt\"}")
    expect (requestText (ui::MeasureFolders(measureFolders = ["C:\\Users", "/home/me"], measureLimit = 5000, measureDeadline = 60000, measureSlice = "measured")), "{\"ticket\":\"job:7\",\"kind\":\"measure-folders\",\"folders\":[\"C:\\\\Users\",\"/home/me\"],\"limit\":5000,\"timeout\":60000,\"slice\":\"measured\"}"))
// [UI-EFFECTS]: the complete host payload retains the ticket and every requested argument.
test ("desktop requests preserve picker export and cancellation payloads", \() =>
    expect (requestText (ui::OpenSettings(pane = "privacy")), "{\"ticket\":\"job:7\",\"kind\":\"open-settings\",\"pane\":\"privacy\"}")
    expect (requestText (ui::RunningApplications), "{\"ticket\":\"job:7\",\"kind\":\"running-applications\"}")
    expect (requestText (ui::ChooseFile(types = ["txt", "md"], chosenLimit = 2, chosenSlice = "picked")), "{\"ticket\":\"job:7\",\"kind\":\"choose-file\",\"types\":[\"txt\",\"md\"],\"limit\":2,\"slice\":\"picked\"}")
    expect (requestText (ui::ChooseFolder), "{\"ticket\":\"job:7\",\"kind\":\"choose-folder\"}")
    expect (requestText (ui::SaveFile(suggested = "report.txt", exportSlice = "export")), "{\"ticket\":\"job:7\",\"kind\":\"save-file\",\"name\":\"report.txt\",\"slice\":\"export\"}")
    expect (requestText (ui::Reveal(revealPath = "/tmp/report.txt")), "{\"ticket\":\"job:7\",\"kind\":\"reveal\",\"path\":\"/tmp/report.txt\"}")
    expect (requestText (ui::Cancel(cancelled = "old:7")), "{\"ticket\":\"job:7\",\"kind\":\"cancel\",\"target\":\"old:7\"}"))

roleText role =
    doc = listGet (Encode::walk ([], Ui::column [ui::Text(content = "sample", role = role, tone = ui::Primary), Ui::button ("Go", "play", Increment)])).nodes 0 ?: JsonNull
    Doc::text (listGet (Doc::items (Doc::field (doc, "children"))) 0 ?: JsonNull, "role")
// [UI-COMPONENTS]: every semantic text role keeps its protocol spelling.
test ("semantic text roles preserve every protocol spelling", \() =>
    roles = [ui::Display, ui::Large, ui::Title, ui::Heading, ui::Lead, ui::Headline, ui::Body, ui::Callout, ui::Caption, ui::Eyebrow, ui::Mono]
    expect (join (mapList (roles, roleText)) ",", "display,large,title,heading,lead,headline,body,callout,caption,eyebrow,mono"))
// [UI-EFFECTS-HOST]: host extensions retain the same bounded request envelope.
test ("host capabilities preserve namespace operation arguments and bounds", \() =>
    request = ui::HostCall(hostNamespace = "vscode", hostOperation = "workspace.snapshot", hostArguments = JsonObject [Doc::str ("workspace", "file:///app")], hostTimeout = 1000, hostLimit = 4096, hostSlice = "workspace")
    doc = Requests::encode (Requests::ask ("host:1", request))
    expect (Doc::text (doc, "kind"), "host-call")
    expect (Doc::text (doc, "namespace"), "vscode")
    expect (Doc::text (doc, "operation"), "workspace.snapshot")
    expect (Doc::number (doc, "timeout"), 1000)
    expect (Doc::number (doc, "limit"), 4096)
    expect (Doc::text (doc, "slice"), "workspace")
    expect (Doc::text (Doc::field (doc, "arguments"), "workspace"), "file:///app"))
// [UI-COMPONENTS-CONTEXT-MENU]: menu commands use the same issued binding IDs.
test ("context menus bind actions after their content controls", \() =>
    built = Ui::contextMenu (Ui::button ("Select", "package", Increment), [Ui::button ("Remove", "delete", Load)])
    walked = Encode::walk ([], built)
    doc = listGet walked.nodes 0 ?: JsonNull
    item = listGet (Doc::items (Doc::field (doc, "items"))) 0 ?: JsonNull
    expect (Doc::text (doc, "kind"), "context-menu")
    expect (Doc::number (Doc::field (doc, "body"), "event"), 0)
    expect (Doc::number (item, "event"), 1)
    expect (length walked.bindings, 2))

mut streamedTrace = ""

streamedFrom node =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive}@${Streams::depth primitive};"
    Streams::split node

begun () =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive};"
    Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"linux\"}", initial, regions, theme)

proceeded (session, event) =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive};"
    Runtime::proceed (session, event, update, regions)

test ("a scene encodes its primitives as flat typed arrays", sceneCaseASceneEncodesItsPrimitivesAsFlat)
test ("colours pack as RRGGBBAA", sceneCaseColoursPackAsRrggbbaa)
test ("a path encodes its steps, outline, paint and transform", sceneCaseAPathEncodesItsStepsOutlinePaint)
test ("a scene binding delivers keys and pointer positions in scene units", sceneCaseASceneBindingDeliversKeysAndPointer)
test ("a frame event delivers its elapsed seconds and patches nothing when ignored", sceneCaseAFrameEventDeliversItsElapsedSeconds)
test ("an animate request carries its on flag", sceneCaseAnAnimateRequestCarriesItsOnFlag)
test ("every symbol encodes as a distinct host-neutral name", sceneCaseEverySymbolEncodesAsADistinctHost)
test ("labels, icons, badges, empty states, buttons, tabs and rows send their symbol names", sceneCaseLabelsIconsBadgesEmptyStatesButtonsTabs)
test ("a pair encodes its label and value without a binding", sceneCaseAPairEncodesItsLabelAndValue)
test ("platforms decode to the union and encode back to their names", sceneCasePlatformsDecodeToTheUnionAndEncode)
test ("a start context carries a linux or windows platform", sceneCaseAStartContextCarriesALinuxOr)
test ("product-specific work is a host call with its namespace and arguments", sceneCaseProductSpecificWorkIsAHostCall)
test ("a split scene streams its fixed-size primitives in order and keeps the rest", sceneCaseASplitSceneStreamsItsFixedSize)
test ("an enveloped scene reports nothing streamed", sceneCaseAnEnvelopedSceneReportsNothingStreamed)
test ("streamed primitives read back every field a host import takes", sceneCaseStreamedPrimitivesReadBackEveryFieldA)
test ("a resident session keeps its store out of the envelope", sceneCaseAResidentSessionKeepsItsStoreOut)
test ("a resident session refuses stale controls and prior-state edits without change", sceneCaseAResidentSessionRefusesStaleControlsAnd)
test ("a split streams scenes from every container in the encoder's order", sceneCaseASplitStreamsScenesFromEveryContainer)
test ("primitives that do not stream read back zero fields", sceneCasePrimitivesThatDoNotStreamReadBack)
test ("a resident session delivers completions, phases and frames and refuses malformed text", sceneCaseAResidentSessionDeliversCompletionsPhasesAnd)
test ("an idle session holds only its store", sceneCaseAnIdleSessionHoldsOnlyItsStore)
test ("toggles and pickers deliver their own value kinds and refuse others", sceneCaseTogglesAndPickersDeliverTheirOwnValue)
test ("progress, swatches, alerts, prominent buttons and leading asides encode", sceneCaseProgressSwatchesAlertsProminentButtonsAndLeading)
test ("a meter sends its amount clamped into a total of at least one", sceneCaseAMeterSendsItsAmountClampedInto)
test ("an editor binds text then cursor after earlier controls and preserves its marks", AdditionCases::editorEncoding)
test ("a cursor binding delivers placed offsets, clamps negatives and refuses text", AdditionCases::cursorValues)
test ("a board names its host slice and binds strokes before its lasso", AdditionCases::boardEncoding)
test ("a board stroke decodes two ordered points with their width and time", AdditionCases::strokeDecoding)
test ("empty negative and non-pair stroke points are refused with the exact diagnostic", AdditionCases::strokeRefusals)
test ("a lasso delivers stroke indices and refuses strings and negative indices", AdditionCases::lassoValues)
test ("a recognition request names its stroke slices and output limit", AdditionCases::recognitionEncoding)
test ("message routing delivers placed stroked and lassoed values to their handlers", AdditionCases::messageRouting)
test ("board themes name the board and chalk tokens", AdditionCases::boardTokens)
test ("mathematics decodes back to the tree it encodes across every constructor", AdditionCases::mathRoundTrip)
test ("mathematics decoding refuses unknown kinds missing children non-arrays and non-objects", AdditionCases::mathRefusals)
test ("image and video encode as leaves with their media fields and no ordinal", AdditionCases::mediaEncoding)
test ("presentation frames explicitly disable viewport sizing by default", \() =>
    walked = Encode::walk ([], Ui::framed (plain, Ui::button ("Continue", "", Increment)))
    style = Doc::field (listGet walked.nodes 0 ?: JsonNull, "style")
    expect (Doc::has (style, "viewportHeightInset"), true)
    expect (Doc::number (style, "viewportHeightInset"), -1)
    expect (Doc::has (style, "scrollY"), true)
    expect (Doc::flag (style, "scrollY"), false))

test ("presentation frames preserve exact dimensions and inner control provenance", \() =>
    style = plain(frameName = "solution-column", frameWidth = 430, frameHeight = 440, frameViewportHeightInset = 270, frameScrollY = true, frameTop = 34, frameRight = 30, frameBottom = 30, frameLeft = 30, frameGap = 24, frameFill = "canvas", frameFont = "serif", frameTextSize = 27, frameItalic = true, frameHug = true, frameAlign = "center", frameCross = "end", frameControlHeight = 40, frameControlPadding = 12, frameMathScale = 1.08, frameLineHeight = 34.72, frameTracking = -0.6, frameQuietControls = true, frameFadeBackdrop = true, frameTrailingSymbols = true, frameShadow = "floating", frameSymbolSize = 13)
    walked = Encode::walk ([], Ui::framed (style, Ui::button ("Continue", "", Increment)))
    encoded = listGet walked.nodes 0 ?: JsonNull
    geometry = Doc::field (encoded, "style")
    expect (Doc::text (encoded, "kind"), "framed")
    expect (Doc::number (geometry, "width"), 430)
    expect (Doc::number (geometry, "height"), 440)
    expect (Doc::number (geometry, "viewportHeightInset"), 270)
    expect (Doc::flag (geometry, "scrollY"), true)
    expect (Doc::number (geometry, "left"), 30)
    expect (Doc::number (geometry, "gap"), 24)
    expect (Doc::text (geometry, "fill"), "canvas")
    expect (Doc::has (geometry, "symbolSize"), true)
    expect (Doc::number (geometry, "symbolSize"), 13)
    AdditionCases::frameTypography geometry
    expect (length walked.bindings, 1)
    expect (Doc::number (Doc::field (encoded, "body"), "event"), 0))

test ("scoped themes and dialogs retain their inner controls and dismissal provenance", \() =>
    theme = ui::Theme(tokens = [ui::Token(tokenName = "canvas", tokenLight = "#202723", tokenDark = "#202723")], spacing = [8], feedback = 140, settle = 240)
    walked = Encode::walk ([], Ui::themed (theme, Ui::dialog ("Review transcription", Ui::button ("Insert", "", Increment), Load)))
    scoped = listGet walked.nodes 0 ?: JsonNull
    dialog = Doc::field (scoped, "body")
    expect (Doc::text (scoped, "kind"), "themed")
    expect (Doc::text (dialog, "kind"), "dialog")
    expect (Doc::text (dialog, "title"), "Review transcription")
    expect (Doc::number (dialog, "event"), 0)
    expect (Doc::number (Doc::field (dialog, "body"), "event"), 1)
    expect (length walked.bindings, 2))

richDocument : ui::Node<Act>
richDocument = Ui::rich ([Ui::run ("For all ", "", false), Ui::run ("p", "sourceType", true)], ui::Lead)
test ("inline text retains mathematical emphasis and semantic source colours without bindings", \() =>
    walked = Encode::walk ([], richDocument)
    node = listGet walked.nodes 0 ?: JsonNull
    runs = Doc::items (Doc::field (node, "runs"))
    variable = listGet runs 1 ?: JsonNull
    expect (Doc::text (node, "kind"), "rich-text")
    expect (Doc::text (variable, "text"), "p")
    expect (Doc::text (variable, "ink"), "sourceType")
    expect (Doc::flag (variable, "italic"), true)
    expect (length walked.bindings, 0)
    branded = listGet (Encode::walk ([], Ui::column [ui::Brand, Ui::button ("Continue", "", Increment)])).nodes 0 ?: JsonNull
    expect (Doc::text (listGet (Doc::items (Doc::field (branded, "children"))) 0 ?: JsonNull, "kind"), "brand"))

