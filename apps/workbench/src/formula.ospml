// Implements [WORKBENCH-FORMULA]: propositional formulas read from symbols and
// sentences in one grammar, written back in Unicode with minimal parentheses.
// A `Result`'s error channel stores only a message ([TYPE-SYSTEM] phantom `E`),
// so a reading that fails is the `Faulted` variant carrying a typed `Fault`.
namespace workbench

(** A propositional formula over named propositions ([WORKBENCH-FORMULA]). *)
type Formula = Var string | Top | Bot | Not Formula | And Formula Formula | Or Formula Formula | Imp Formula Formula | Iff Formula Formula | Forall (List<string>) Formula

(** Where a text stopped being a formula and the shortest thing that would have made it one. *)
type Fault =
    column : int
    expected : string

(** A formula read from text, or the fault that stopped the reading. *)
type Reading = Read Formula | Faulted Fault

(** What a token is: a name, a reserved word of the sentence forms, a symbol, a character no formula holds, or the end. *)
type Kind = Name | Word | Mark | Stray | End

(** One token with its 1-based column, counted in characters. *)
type Token =
    kind : Kind
    text : string
    column : int

(** A partial reading: the formula so far and the index of the next token, or the fault. *)
type Parse = Parsed Formula int | Failed Fault

(** The end of a name: the byte after it and its length in characters. *)
type Run =
    stop : int
    count : int

(** How a binary connective groups with itself. *)
type Grouping = Leftward | Rightward

(** The binary connective a precedence level builds. *)
type Connective = Biconditional | Conditional | Disjunction | Conjunction

(** One precedence level of the climber: its spellings, its connective and its grouping. *)
type Level =
    spellings : List<List<string>>
    connective : Connective
    grouping : Grouping

(** Splits text into the tokens of [WORKBENCH-FORMULA]; total, ending with an `End` token. *)
module Lexer
    reserved = ["and", "or", "not", "if", "then", "iff", "implies", "only", "true", "false", "for", "all", "every", "it", "is", "the", "case", "that"]

    marks = ["∧", "∨", "→", "↔", "¬", "∀", "⊤", "⊥", "(", ")", ","]

    letter code = (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || (code >= 48 && code <= 57) || code == 95 || code == 39

    // Greek letters and sub- and superscript digits are part of a name, as in `α₁`.
    named code = letter code || (code >= 945 && code <= 969) || (code >= 8320 && code <= 8329) || (code >= 8304 && code <= 8313) || code == 185 || code == 178 || code == 179

    blank code = code == 32 || code == 9 || code == 10 || code == 13

    width code = codePointWidth code ?: 1

    codeAt (text, at) = codePointAt (text, at) ?: 0

    // The byte just past the run of name characters starting at `at`, and its length in characters.
    nameEnd (text, at, count) = match at < length text && named (codeAt (text, at))
        true => nameEnd (text, satAdd at (width (codeAt (text, at))), satAdd count 1)
        false => Run(stop = at, count = count)

    word text = match listContains (reserved, toLowerCase text)
        true => Token(kind = Word, text = toLowerCase text, column = 0)
        false => Token(kind = Name, text = text, column = 0)

    (** The tokens of `text`, the last one `End` at the column after the text. *)
    export tokens text = scan (text, 0, 1, [])

    scan (text, at, column, done) = match at >= length text
        true => listReverse (listPrepend (done, Token(kind = End, text = "", column = column)))
        false => step (text, at, column, done)

    step (text, at, column, done) =
        code = codeAt (text, at)
        next = satAdd at (width code)
        glyph = substring (text, at, next) ?: ""
        match blank code
            true => scan (text, next, satAdd column 1, done)
            false => match named code
                true => nameToken (text, at, column, done)
                false => scan (text, next, satAdd column 1, listPrepend (done, Token(kind = classed glyph, text = glyph, column = column)))

    classed glyph = match listContains (marks, glyph)
        true => Mark
        false => Stray

    nameToken (text, at, column, done) =
        run = nameEnd (text, at, 0)
        found = word (substring (text, at, run.stop) ?: "")
        scan (text, run.stop, satAdd column run.count, listPrepend (done, found(column = column)))

(** Reads, writes and compares formulas ([WORKBENCH-FORMULA]). *)
module Formulas
    // Loosest first: `↔`, `→` (right associative), `∨`, `∧`; `¬` and the atoms are below the table.
    levels () = [
        Level(spellings = [["↔"], ["iff"], ["if", "and", "only", "if"]], connective = Biconditional, grouping = Leftward),
        Level(spellings = [["→"], ["implies"]], connective = Conditional, grouping = Rightward),
        Level(spellings = [["∨"], ["or"]], connective = Disjunction, grouping = Leftward),
        Level(spellings = [["∧"], ["and"]], connective = Conjunction, grouping = Leftward),
    ]

    negations = [["¬"], ["not"], ["it", "is", "not", "the", "case", "that"]]

    binders = [["∀"], ["for", "all"], ["for", "every"]]

    (** The token at `at`, or the closing `End` token past the last one. *)
    export token (tokens, at) = listGet tokens at ?: (listGet tokens (satSub (length tokens) 1) ?: Token(kind = End, text = "", column = 1))

    // How many tokens from `at` spell `words`, or 0.
    spells (tokens, at, words) = match foldList (words, at, \(next, word) => advance (tokens, next, word))
        stop => match stop < 0
            true => 0
            false => satSub stop at

    advance (tokens, next, word) = match next >= 0 && (token (tokens, next)).kind != Name && (token (tokens, next)).text == word
        true => satAdd next 1
        false => satSub 0 1

    (** How many tokens from `at` spell one of `phrases`, or 0 when none does. *)
    export phrase (tokens, at, phrases) = foldList (phrases, 0, \(found, words) => larger (found, spells (tokens, at, words)))

    larger (first, second) = match first > second
        true => first
        false => second

    fault (tokens, at, expected) = Failed (Fault(column = (token (tokens, at)).column, expected = expected))

    // What a missing proposition at `at` should have been, naming the token before it.
    missing (tokens, at) = match at == 0
        true => fault (tokens, at, "a proposition")
        false => fault (tokens, at, "a proposition after `" + (token (tokens, satSub at 1)).text + "`")

    climb (tokens, at, depth) = match listGet (levels ()) depth
        Error _ => unary (tokens, at)
        Success level => match climb (tokens, at, satAdd depth 1)
            Failed problem => Failed problem
            Parsed left next => further (tokens, depth, level, left, next)

    further (tokens, depth, level, left, at) =
        width = phrase (tokens, at, level.spellings)
        match width == 0
            true => Parsed left at
            false => joined (tokens, depth, level, left, climb (tokens, satAdd at width, operandDepth (level, depth)))

    operandDepth (level, depth) = match level.grouping
        Rightward => depth
        Leftward => satAdd depth 1

    build (connective, left, right) = match connective
        Biconditional => Iff left right
        Conditional => Imp left right
        Disjunction => Or left right
        Conjunction => And left right

    joined (tokens, depth, level, left, right) = match right
        Failed problem => Failed problem
        Parsed formula next => match level.grouping
            Rightward => Parsed (build (level.connective, left, formula)) next
            Leftward => further (tokens, depth, level, build (level.connective, left, formula), next)

    unary (tokens, at) =
        width = phrase (tokens, at, negations)
        match width == 0
            true => atom (tokens, at)
            false => match unary (tokens, satAdd at width)
                Failed problem => Failed problem
                Parsed inner next => Parsed (Not inner) next

    atom (tokens, at) =
        here = token (tokens, at)
        match here.kind
            Name => Parsed (Var here.text) (satAdd at 1)
            _ => keyword (tokens, at, here.text)

    keyword (tokens, at, text) = match text
        "true" => Parsed Top (satAdd at 1)
        "⊤" => Parsed Top (satAdd at 1)
        "false" => Parsed Bot (satAdd at 1)
        "⊥" => Parsed Bot (satAdd at 1)
        "(" => grouped (tokens, at)
        "if" => conditional (tokens, at)
        _ => quantified (tokens, at)

    grouped (tokens, at) = match climb (tokens, satAdd at 1, 0)
        Failed problem => Failed problem
        Parsed inner next => match (token (tokens, next)).kind == Mark && (token (tokens, next)).text == ")"
            true => Parsed inner (satAdd next 1)
            false => fault (tokens, next, "`)`")

    conditional (tokens, at) = match climb (tokens, satAdd at 1, 0)
        Failed problem => Failed problem
        Parsed condition next => match phrase (tokens, next, [["then"]]) == 1
            true => consequence (condition, climb (tokens, satAdd next 1, 0))
            false => fault (tokens, next, "`then` after the condition")

    consequence (condition, parsed) = match parsed
        Failed problem => Failed problem
        Parsed result next => Parsed (Imp condition result) next

    quantified (tokens, at) =
        width = phrase (tokens, at, binders)
        match width == 0
            true => missing (tokens, at)
            false => bound (tokens, satAdd at width, [])

    isName here = here.kind == Name

    bound (tokens, at, names) =
        here = token (tokens, at)
        match isName here
            true => bound (tokens, satAdd at 1, listAppend (names, here.text))
            false => body (tokens, at, names)

    body (tokens, at, names) = match isEmpty names
        true => fault (tokens, at, "a name to bind")
        false => match phrase (tokens, at, [[","]]) == 1
            true => scoped (names, climb (tokens, satAdd at 1, 0))
            false => fault (tokens, at, "`,` after the bound names")

    scoped (names, parsed) = match parsed
        Failed problem => Failed problem
        Parsed inner next => Parsed (Forall names inner) next

    whole (tokens, parsed) = match parsed
        Failed problem => Faulted problem
        Parsed formula next => match (token (tokens, next)).kind
            End => Read formula
            Stray => Faulted (Fault(column = (token (tokens, next)).column, expected = "a connective in place of `" + (token (tokens, next)).text + "`"))
            _ => Faulted (Fault(column = (token (tokens, next)).column, expected = "the end of the formula or a connective before `" + (token (tokens, next)).text + "`"))

    (** Reads a formula written in symbols, sentences or both; `p ∧ q → q ∧ p` and `if p and q then q and p` are the same value. *)
    export read text =
        tokens = Lexer::tokens text
        whole (tokens, climb (tokens, 0, 0))

    rank formula = match formula
        Iff _ _ => 1
        Imp _ _ => 2
        Or _ _ => 3
        And _ _ => 4
        Not _ => 5
        Forall _ _ => 0
        _ => 6

    // The text of `formula` where the context binds as tightly as `context`; `open` says nothing
    // follows it, and a `∀`, which reaches to the end of the text, is bare only there.
    bare (formula, context, open) = rank formula >= context || (rank formula == 0 && open)

    placed (formula, context, open) = match bare (formula, context, open)
        true => written (formula, open)
        false => "(" + written (formula, true) + ")"

    // Only the right operand can be last, so only it inherits `open`.
    infix (left, symbol, right, sides, open) = placed (left, sides.left, false) + " " + symbol + " " + placed (right, sides.right, open)

    written (formula, open) = match formula
        Var name => name
        Top => "⊤"
        Bot => "⊥"
        Not inner => "¬" + placed (inner, 5, open)
        And left right => infix (left, "∧", right, { left = 4, right = 5 }, open)
        Or left right => infix (left, "∨", right, { left = 3, right = 4 }, open)
        Imp left right => infix (left, "→", right, { left = 3, right = 2 }, open)
        Iff left right => infix (left, "↔", right, { left = 1, right = 2 }, open)
        Forall names inner => "∀ " + join (names, " ") + ", " + written (inner, true)

    (** The Unicode form with the fewest parentheses that read back to the same formula. *)
    export show formula = written (formula, true)

    // Implements [WORKBENCH-MATH]: share the writer's precedence and scope;
    // retain operators as layout nodes rather than passing prose to a host.
    layoutAt (formula, context, open) = match bare (formula, context, open)
        true => layout (formula, open)
        false => ui::Paren (layout (formula, true))

    layoutOp (left, symbol, right, sides, open) = ui::Op symbol (layoutAt (left, sides.left, false)) (layoutAt (right, sides.right, open))

    layout (formula, open) = match formula
        Var name => ui::Sym name
        Top => ui::Sym "⊤"
        Bot => ui::Sym "⊥"
        Not inner => ui::Seq [ui::Sym "¬", layoutAt (inner, 5, open)]
        And left right => layoutOp (left, "∧", right, { left = 4, right = 5 }, open)
        Or left right => layoutOp (left, "∨", right, { left = 3, right = 4 }, open)
        Imp left right => layoutOp (left, "→", right, { left = 3, right = 2 }, open)
        Iff left right => layoutOp (left, "↔", right, { left = 1, right = 2 }, open)
        Forall names inner => ui::Binder "∀" (mapList (names, \name => ui::Sym name)) (layout (inner, true))

    (** A typed mathematics tree with the same grouping as `show`; pass `show formula` as its accessible text to `Ui::math`. *)
    export typeset formula = layout (formula, true)

    (** Structural equality: `show` is injective because `read (show f) = f`, so equal texts are equal formulas. *)
    export equal (first, second) = show first == show second
