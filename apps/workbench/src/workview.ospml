// Implements [WORKBENCH-REGIONS] and [LESSONS-MODE]: the Work regions. Each
// view reads only the slices it shows, so a keystroke in the document
// re-sends `document`, `goal` and `generated` and nothing else.
namespace workbench

import ui::Ui
import workbench::Statements
import workbench::Steps
import workbench::Goals
import workbench::Formulas
import workbench::Emit
import workbench::Reviews
import workbench::Lists
import workbench::Notation

(** The Work regions of [WORKBENCH-REGIONS] and the root that holds every region. *)
module WorkViews
    draft () = perform Signal<Draft>.read ()

    sketch () = perform Signal<Sketch>.read ()

    layout () = perform Signal<Layout>.read ()

    shelf () = perform Signal<Shelf>.read ()

    working mode = match mode
        Working => true
        Learning => false

    picked on = match on
        true => ui::Prominent
        false => ui::Plain

    (** [WORKBENCH-REGIONS] [LESSONS-MODE] The Work and Learn segment over the surface the mode shows. *)
    export root () =
        current = layout ()
        Ui::column [Ui::row [Ui::action ("Work", "pencil.and.outline", picked (working current.mode), true, ToWork), Ui::action ("Learn", "graduationcap", picked (!working current.mode), true, ToLearn)], surface current]

    surface current = match current.mode
        Learning => Ui::aside (learned (), ui::Trailing, Ui::slot "board", current.sideWidth, Widen)
        Working => worked current

    learned () = match isEmpty (shelf ()).openSlug
        true => Ui::slot "catalogue"
        false => Ui::slot "lesson"

    // Board first: the board fills the window with the columns trailing; paper puts the document first.
    worked current = match current.paperFirst
        false => Ui::aside (Ui::slot "board", ui::Trailing, Ui::column (listPrepend (panes current) (Ui::slot "document")), current.sideWidth, Widen)
        true => Ui::aside (Ui::column [Ui::button ("Board first", "rectangle.and.pencil.and.ellipsis", ToBoard), Ui::slot "document"], ui::Trailing, Ui::column (panes current), current.sideWidth, Widen)

    panes current = [Ui::disclosure ("Goal", current.goalOpen, ToggleGoal, [Ui::slot "goal"]), Ui::disclosure ("Source", current.generatedOpen, ToggleGenerated, [Ui::slot "generated"]), Ui::disclosure ("Library", current.libraryOpen, ToggleLibrary, [Ui::slot "library"]), paperButton current]

    paperButton current = match current.paperFirst
        true => Ui::caption ""
        false => Ui::button ("Paper first", "doc.text", ToPaper)

    toneOf tone = match tone
        "checked" => ui::Good
        "rejected" => ui::Danger
        _ => ui::Caution

    badgeOf tone = match tone
        "checked" => "Checked"
        "rejected" => "Refused"
        _ => "Unchecked"

    rowOf check = match check.checkLine < 0
        true => check.checkHead
        false => check.checkLine

    marked check = Ui::mark (satAdd (rowOf check) 1, check.checkLine >= 0, toneOf check.checkTone, badgeOf check.checkTone, check.checkNote)

    (** [WORKBENCH-VERDICT] The document as an editor, each declaration marked with the kernel's verdict on its line. *)
    export document () =
        text = draft ()
        Ui::editor ("Proof", text.draftText, text.caret, mapList ((perform Signal<Reviewed>.read ()).checks, \check => marked check), Edit, Place)

    caretRow text = satSub (length (lines (take text.draftText text.caret))) 1

    // The declaration whose heading is the last one at or above the caret, and the steps written above the caret.
    (** [WORKBENCH-GOALS] The hypotheses and target after the steps above the caret, or why a step does not fit. *)
    export goalPane () =
        text = draft ()
        rows = lines text.draftText
        heads = filterList (Reviews::starts rows, \head => head <= caretRow text)
        match listGet (Statements::document text.draftText) (satSub (length heads) 1)
            Error _ => Ui::caption "Write a theorem to see its goal."
            Success found => declared (found, rows, listGet heads (satSub (length heads) 1) ?: 0, caretRow text)

    declared (found, rows, head, row) = match listGet found.problems 0
        Success problem => Ui::badge (problem.message, "exclamationmark.triangle", ui::Caution)
        Error _ => outcome (Goals::run (found.statement, Lists::first (mapList (Steps::sentences found.proof, \sentence => Steps::read sentence), above (rows, head, row))))

    above (rows, head, row) = (foldList (rows, { at = 0, count = 0 }, \(walk, line) => { at = satAdd walk.at 1, count = satAdd walk.count (within (walk.at, head, row, line)) })).count

    within (at, head, row, line) = match at > head && at <= row
        true => Reviews::counted line
        false => 0

    shown formula = Ui::math (Formulas::typeset formula, Formulas::show formula)

    outcome found = match found
        Stuck mismatch => Ui::column [Ui::badge ("This step does not fit the goal", "exclamationmark.circle", ui::Caution), Ui::text mismatch.reason, Ui::caption "Needed", shown mismatch.expected, Ui::caption "Offered", shown mismatch.found]
        Advanced progress => match listGet progress.open 0
            Error _ => Ui::badge ("No goals left in this sketch; the kernel's verdict is on the document", "circle", ui::Secondary)
            Success open => opened (open, length progress.open)

    opened (open, count) = Ui::column (listConcat (mapList (open.hypotheses, \held => Ui::row [Ui::styled (held.name + " :", ui::Mono, ui::Secondary), shown held.formula]), [Ui::row [Ui::styled ("⊢", ui::Headline, ui::Accent), shown open.target], Ui::caption "${count} open"]))

    proofs text = mapList (filterList (Statements::document text, \found => isEmpty found.problems), \found => Proof(statement = found.statement, steps = mapList (Steps::sentences found.proof, \sentence => Steps::read sentence)))

    (** [WORKBENCH-EMIT] The generated Lean module, read only. *)
    export generated () = Ui::styled (Emit::document (proofs (draft ()).draftText), ui::Mono, ui::Primary)

    controls current = match current.clearing
        true => Ui::row [Ui::text "Clear every stroke?", Ui::action ("Clear", "trash", ui::Destructive, true, ConfirmClear), Ui::button ("Keep", "arrow.uturn.backward", KeepBoard)]
        false => Ui::row [Ui::action ("Undo", "arrow.uturn.backward", ui::Plain, current.strokeTotal > 0, Undo), Ui::action ("Clear", "trash", ui::Plain, current.strokeTotal > 0, AskClear)]

    notice current = match current.lassoing
        true => Ui::caption "Circle strokes with the lasso to read them as text."
        false => Ui::caption "Handwriting recognition is not available here; the board is scratch paper."

    (** [WORKBENCH-BOARD] The board, its undo and clear controls, and whether the lasso can read handwriting. *)
    export board () =
        current = sketch ()
        Ui::column [Ui::board ("board", current.strokeTotal, current.lassoing, Stroke, Lasso), controls current, notice current]

    rules () = [{ ruleName = "and_intro", ruleSays = "p → q → p ∧ q" }, { ruleName = "and_cases", ruleSays = "p ∧ q → (p → q → r) → r" }, { ruleName = "or_inl", ruleSays = "p → p ∨ q" }, { ruleName = "or_inr", ruleSays = "q → p ∨ q" }, { ruleName = "or_cases", ruleSays = "p ∨ q → (p → r) → (q → r) → r" }, { ruleName = "iff_intro", ruleSays = "(p → q) → (q → p) → (p ↔ q)" }, { ruleName = "absurd", ruleSays = "p → ¬p → r" }]

    ruled item = match Formulas::read item.ruleSays
        Read formula => Ui::row [Ui::styled (item.ruleName, ui::Mono, ui::Accent), shown formula]
        Faulted _ => Ui::row [Ui::styled (item.ruleName, ui::Mono, ui::Accent), Ui::text item.ruleSays]

    (** [WORKBENCH-REGIONS] The prelude's rules, which the kernel itself checked, and the symbol abbreviations, read only. *)
    export library () = Ui::column [Ui::section ("Rules", "Checked by the kernel when the workbench starts.", mapList (rules (), \item => ruled item)), Ui::section ("Typing symbols", "Type a backslash and the name.", mapList (Notation::table, \entry => Ui::caption ("\\" + entry.abbreviation + "  " + entry.symbol)))]
