// Implements [WORKBENCH-STORE], [WORKBENCH-REGIONS] and [LESSONS-MODE]: the
// application's start and dispatch. Each slice is its own signal, and each
// challenge region refreshes only when its own attempt changed.
namespace workbench

import ui::Runtime
import ui::Keyed
import ui::Doc
import vscode::Webview
import workbench::Benches
import workbench::Update
import workbench::Shelves
import workbench::WorkViews
import workbench::GoalViews
import workbench::LearnViews
import workbench::Palettes
import workbench::Lessons
import workbench::Blocks
import workbench::Boards

(** The signal identities each region depends on, compared slice by slice ([UI-SIGNALS]). *)
module Changes
    draftSlice () = perform Signal<Draft>.read ()

    checksSlice () = perform Signal<Reviewed>.read ()

    sketchSlice () = perform Signal<Sketch>.read ()

    layoutSlice () = perform Signal<Layout>.read ()

    shelfSlice () = perform Signal<Shelf>.read ()

    importedSlice () = perform Signal<ImportedState>.read ()

    importedJson current = JsonArray [JsonString current.exportText, JsonBool current.exportLarge, JsonString current.exportSelected, JsonString current.exportProblem, JsonBool current.exportExpanded, JsonInt current.exportRevision, JsonString current.libraryCatalogue, JsonString current.libraryProblem, JsonString current.libraryPending, JsonString current.libraryTicket, JsonBool current.libraryExpanded]

    doneSlice () = perform Signal<Achieved>.read ()

    draftJson draft = JsonArray [JsonString draft.draftTitle, JsonString draft.draftText, JsonInt draft.caret, JsonInt draft.selectedStep]

    checkJson check = JsonArray [JsonInt check.checkHead, JsonInt check.checkLine, JsonString check.checkTone, JsonString check.checkNote]

    checksJson found = JsonArray (mapList (found.checks, \check => checkJson check))

    sketchJson sketch = JsonArray [JsonInt sketch.strokeTotal, JsonBool sketch.lassoing, JsonBool sketch.clearing, JsonInt sketch.boardScale, JsonInt sketch.boardPanX, JsonInt sketch.boardPanY, JsonString sketch.boardNotes, JsonBool sketch.notesVisible, JsonBool sketch.panMode]

    learning mode = match mode
        Learning => true
        Working => false
        ReadingPage => false

    reading mode = match mode
        ReadingPage => true
        _ => false

    layoutJson layout = JsonArray [JsonBool (learning layout.mode), JsonBool (reading layout.mode), JsonBool layout.paperFirst, JsonBool layout.goalOpen, JsonBool layout.generatedOpen, JsonBool layout.libraryOpen, JsonInt layout.sideWidth, JsonBool layout.slate, JsonBool layout.guided, JsonBool layout.boardFocused, JsonString layout.previewText, JsonBool layout.previewSample, JsonString layout.noticeText, JsonBool layout.noticeBad]

    // The focused challenge is not shown, so it is not compared: focusing one never refreshes a region.
    shelfJson shelf = JsonArray [JsonString shelf.openSlug, JsonString shelf.openSource, JsonString shelf.shelfProblem, JsonArray (mapList (shelf.entries, \entry => JsonArray [JsonString entry.entrySlug, JsonString entry.entryTitle, JsonString entry.entryFault]))]

    doneJson done = JsonArray (mapList (done.doneKeys, \key => JsonString key))

    (** The completed keys of `bench`, the catalogue's signal. *)
    export done bench = Achieved(doneKeys = bench.tutor.tutorCompleted)

    pair (first, second) = listConcat (first, second)

    (** The identities whose slice differs between `before` and `after`; the tutor's are left to each challenge. *)
    export slices (before, after) = pair (pair (pair (signalChanges before.draft after.draft draftJson (signalDependencies draftSlice), signalChanges before.verdicts after.verdicts checksJson (signalDependencies checksSlice)), pair (signalChanges before.sketch after.sketch sketchJson (signalDependencies sketchSlice), signalChanges before.layout after.layout layoutJson (signalDependencies layoutSlice))), pair (signalChanges before.shelf after.shelf shelfJson (signalDependencies shelfSlice), pair (signalChanges (done before) (done after) doneJson (signalDependencies doneSlice), signalChanges before.imports after.imports importedJson (signalDependencies importedSlice))))

    (** The challenge identifiers of the open lesson in `bench`, none when no lesson is open. *)
    export challenges bench = match Lessons::read bench.shelf.openSource
        Error _ => []
        Success found => mapList (Blocks::challenges found.lessonBlocks, \item => item.challengeId)

(** The workbench application: start, dispatch and the host boundary ([WORKBENCH-STORE]). *)
module App
    // At start the board's metadata slice is written, and the catalogue and the learner's progress are asked for; the lessons follow the catalogue.
    initial _ = ui::Step(stepStore = Benches::fresh (), requests = [Shelves::catalogue (), Shelves::progress ()], writes = [Boards::metadataWrite ("board", Boards::empty ())])

    // [LESSONS-VERIFICATION]: named callbacks retain precise compiler-derived dependencies.
    challengeRegion (before, current, frames, id) =
        next = LearnViews::challengeState (current, id)
        handle static Signal<ChallengeState>
            read => next
        changed = match structuralEquals (LearnViews::challengeState (before, id)) next
            true => []
            false => signalDependencies LearnViews::challenge
        Keyed::region (frames, "challenge:" + id, changed, LearnViews::challenge)

    regions (before, current, frames, _) =
        handle static Signal<Draft>
            read => current.draft
        handle static Signal<Reviewed>
            read => current.verdicts
        handle static Signal<Sketch>
            read => current.sketch
        handle static Signal<Layout>
            read => current.layout
        handle static Signal<Shelf>
            read => current.shelf
        handle static Signal<ImportedState>
            read => current.imports
        handle static Signal<Achieved>
            read => Changes::done current
        changed = Changes::slices (before, current)
        listConcat ([Keyed::region (frames, "root", changed, WorkViews::root), Keyed::region (frames, "heading", changed, WorkViews::header), Keyed::region (frames, "document", changed, WorkViews::document), Keyed::region (frames, "goal", changed, GoalViews::pane), Keyed::region (frames, "generated", changed, WorkViews::generated), Keyed::region (frames, "board", changed, WorkViews::board), Keyed::region (frames, "library", changed, WorkViews::library), Keyed::region (frames, "catalogue", changed, LearnViews::catalogue), Keyed::region (frames, "lesson", changed, LearnViews::lesson)], mapList (Changes::challenges current, \id => challengeRegion (before, current, frames, id)))

    (** A new session: the empty store, the chalk theme, and the lesson and progress reads ([WORKBENCH-STORE]). *)
    export start context = Runtime::start (context, initial, regions, Benches::save, Palettes::initial ())

    (** One host event through `update`, re-sending only the regions whose signals changed. *)
    export dispatch (saved, event) = Runtime::dispatch (saved, event, Update::apply, regions, Benches::save, Benches::restore)

    // The VS Code host keeps host-held slices and sends them in the frame's `slices` object; an unknown key reads as empty.
    (** The VS Code command boundary: one frame in, one envelope out, host-held slices read from the frame ([VSCODE-SDK-WASM]). *)
    export respond frame =
        held = Doc::field (Doc::parse frame, "slices")
        handle ui::Slices
            fetch key => Doc::text (held, key)
        Webview::respond (frame, start, dispatch)
