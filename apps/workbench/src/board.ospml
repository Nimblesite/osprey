// Implements [WORKBENCH-BOARD] and [WORKBENCH-DESIGN-SURFACES]: board working
// is application state, shared by browser and native hosts. It carries no verdict.
namespace workbench

import ui::Doc
import ui::Lists
import ui::Strokes
import ui::Requests

(** Scratch strokes, notes and board framing; clear confirmation is transient session state. *)
type BoardState =
    boardStrokes : List<ui::Stroke>
    boardNotes : string
    boardClearing : bool
    boardWidth : int
    boardHeight : int
    boardPanX : int
    boardPanY : int
    boardZoom : int

(** The board's shared state transitions and versioned host-held slice representation. *)
module Boards
    (** A blank 1536 × 1024 board, at 100 percent, with no pending clear. *)
    export empty () = BoardState(boardStrokes = [], boardNotes = "", boardClearing = false, boardWidth = 1536, boardHeight = 1024, boardPanX = 0, boardPanY = 0, boardZoom = 100)

    (** Append one finished stroke without discarding notes or framing. *)
    export append (board, stroke) = board(boardStrokes = listAppend (board.boardStrokes, stroke), boardClearing = false)

    (** Remove only the most recent stroke; an empty board stays empty. *)
    export undo board = board(boardStrokes = Lists::slice (board.boardStrokes, 0, satSub (length board.boardStrokes) 1), boardClearing = false)

    (** Ask for clear confirmation, leaving the working intact. *)
    export requestClear board = board(boardClearing = true)

    (** Cancel clear confirmation, leaving the working intact. *)
    export cancelClear board = board(boardClearing = false)

    (** Clear strokes only after confirmation; notes and framing remain. *)
    export clear board = match board.boardClearing
        true => board(boardStrokes = [], boardClearing = false)
        false => board

    (** Replace the author's unverified working notes. *)
    export notes (board, text) = board(boardNotes = text)

    clamp (value, least, most) = match value < least
        true => least
        false => match value > most
            true => most
            false => value

    (** Set pan in board points and zoom in percent, within the supported framing bounds. *)
    export frame (board, x, y, scale) = board(boardPanX = clamp (x, -1000000, 1000000), boardPanY = clamp (y, -1000000, 1000000), boardZoom = clamp (scale, 25, 400))

    point value = JsonArray [JsonInt value.pointX, JsonInt value.pointY]

    stroke value = JsonObject [JsonMember "points" (JsonArray (mapList (value.strokePoints, point))), Doc::num ("width", value.strokeWidth), Doc::num ("at", value.strokeAt)]

    (** The base runtime slice: notes, dimensions and framing. Strokes live in separately indexed slices. *)
    export metadata board = JsonObject [
        Doc::num ("version", 1), Doc::str ("notes", board.boardNotes),
        JsonMember "size" (JsonObject [Doc::num ("width", board.boardWidth), Doc::num ("height", board.boardHeight)]),
        JsonMember "view" (JsonObject [Doc::num ("x", board.boardPanX), Doc::num ("y", board.boardPanY), Doc::num ("scale", board.boardZoom)]),
    ]

    (** A complete saved board. `view.scale` is percent; no confirmation or verification status is persisted. *)
    export encode board = JsonObject (listAppend (Doc::members (metadata board), JsonMember "strokes" (JsonArray (mapList (board.boardStrokes, stroke)))))

    (** One framing/notes write; it does not resend the strokes. *)
    export metadataWrite (base, board) = Requests::write (base, Doc::write (metadata board))

    (** One finished stroke's runtime write, under its stable zero-based index. *)
    export strokeWrite (base, index, value) = Requests::write (base + ":" + toString index, Doc::write (stroke value))

    (** Restore/import writes: the base metadata followed by each separate stroke slice. *)
    export sliceWrites (base, board) = foldList (board.boardStrokes, [metadataWrite (base, board)], \(writes, value) => listAppend (writes, strokeWrite (base, satSub (length writes) 1, value)))

    (** The complete board slice for a host-held write or workspace save. *)
    export write board = Doc::write (encode board)

    integer (doc, key, least, most) = match jsonInt (Doc::field (doc, key))
        Success value => value >= least && value <= most
        Error _ => false

    isText value = match value
        JsonString _ => true
        _ => false

    isArray value = match value
        JsonArray _ => true
        _ => false

    withinBoard point = point.pointX <= 16384 && point.pointY <= 16384

    validStroke value = match Strokes::decode value
        Error _ => false
        Success stroke => length stroke.strokePoints <= 8192 && Lists::all (stroke.strokePoints, withinBoard) && stroke.strokeWidth <= 128 && stroke.strokeAt <= 9007199254740991

    valid doc =
        size = Doc::field (doc, "size")
        view = Doc::field (doc, "view")
        strokes = Doc::field (doc, "strokes")
        integer (doc, "version", 1, 1) && isText (Doc::field (doc, "notes")) && isArray strokes && length (Doc::items strokes) <= 10000 && Lists::all (Doc::items strokes, validStroke) && integer (size, "width", 1, 16384) && integer (size, "height", 1, 16384) && integer (view, "x", -1000000, 1000000) && integer (view, "y", -1000000, 1000000) && integer (view, "scale", 25, 400)

    nextStroke (previous, value) = match previous
        Error message => Error(message = message)
        Success strokes => match Strokes::decode value
            Error message => Error(message = message)
            Success found => Success(value = listAppend (strokes, found))

    decoded doc = match foldList (Doc::items (Doc::field (doc, "strokes")), Success(value = []), nextStroke)
        Error message => Error(message = message)
        Success strokes =>
            size = Doc::field (doc, "size")
            view = Doc::field (doc, "view")
            Success(value = BoardState(boardStrokes = strokes, boardNotes = Doc::text (doc, "notes"), boardClearing = false, boardWidth = Doc::number (size, "width"), boardHeight = Doc::number (size, "height"), boardPanX = Doc::number (view, "x"), boardPanY = Doc::number (view, "y"), boardZoom = Doc::number (view, "scale")))

    (** Restore a saved board only when its version, strokes, notes and framing are valid. *)
    export read source = match jsonDecode source
        Error _ => Error(message = "The saved board is not JSON")
        Success doc => match valid doc
            false => Error(message = "The saved board has an unsupported version or malformed working")
            true => decoded doc
