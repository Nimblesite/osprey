// Implements [WORKBENCH-STORE] and [LESSONS-STORE]: one store, one slice per
// concern, each its own record type so that each is its own signal. Derived
// state (parsed declarations, goals, generated code) is computed in views from
// `Draft`; only the kernel's verdicts are kept, because they cost a check.
namespace workbench

import ui::Doc
import workbench::Tutors
import workbench::Tries

(** Which side of the application leads: the proof workbench or Learn mode ([LESSONS-MODE]). *)
type Mode = Working | Learning

(** The document text and the caret's byte offset ([WORKBENCH-STORE]). *)
type Draft =
    draftText : string
    caret : int

(** The kernel's word on one declaration: its heading line, the line to underline (`-1` for none), the tone and the note ([WORKBENCH-VERDICT]). *)
type Check =
    checkHead : int
    checkLine : int
    checkTone : string
    checkNote : string

(** The kernel's verdicts on the document, one per declaration ([WORKBENCH-STORE]). *)
type Reviewed =
    checks : List<Check>

(** The board as the store sees it: how many strokes the host holds, whether the lasso is offered, a pending clear, and the current recognition ticket ([WORKBENCH-BOARD]). *)
type Sketch =
    strokeTotal : int
    lassoing : bool
    clearing : bool
    inkTicket : string
    inkCount : int

(** Which surface and panes are shown, and the side column's width ([WORKBENCH-STORE]). *)
type Layout =
    mode : Mode
    paperFirst : bool
    goalOpen : bool
    generatedOpen : bool
    libraryOpen : bool
    sideWidth : int

(** One catalogue entry as listed: slug, title, summary, stage, minutes, its challenge keys, and the reader's fault, empty when it reads ([LESSONS-FILES]). *)
type Listing =
    entrySlug : string
    entryTitle : string
    entrySummary : string
    entryStage : int
    entryMinutes : int
    entryChallenges : List<string>
    entryFault : string

(** The lesson catalogue, the open lesson's slug and text, the challenge last typed into, and why lessons failed to load ([LESSONS-STORE]). *)
type Shelf =
    entries : List<Listing>
    openSlug : string
    openSource : string
    focused : string
    shelfProblem : string

(** The whole store ([WORKBENCH-STORE], [LESSONS-STORE]). *)
type Bench =
    draft : Draft
    verdicts : Reviewed
    sketch : Sketch
    layout : Layout
    shelf : Shelf
    tutor : Tutor

// One action union per program until Nimblesite/osprey#278; grouped by the value each binding delivers.
(** Every action a control can deliver: document and caret, board, panes and modes, lessons and challenges. *)
type Act = Edit | Place | Stroke | Lasso | Undo | AskClear | ConfirmClear | KeepBoard | ToWork | ToLearn | ToBoard | ToPaper | ToggleGoal | ToggleGenerated | ToggleLibrary | Widen | Open string | Close | Answer string | Pick string | Submit string | Hint string | Reveal string | Carry string

(** Creates, saves and restores the store. *)
module Benches
    (** An empty document, no verdicts, a blank board, the board-first layout and no lessons yet. *)
    export fresh () = Bench(draft = Draft(draftText = "", caret = 0), verdicts = Reviewed(checks = []), sketch = Sketch(strokeTotal = 0, lassoing = true, clearing = false, inkTicket = "", inkCount = 0), layout = Layout(mode = Working, paperFirst = false, goalOpen = true, generatedOpen = false, libraryOpen = false, sideWidth = 340), shelf = Shelf(entries = [], openSlug = "", openSource = "", focused = "", shelfProblem = ""), tutor = Tutors::empty ())

    flag (key, value) = JsonMember key (JsonBool value)

    learning layout = match layout.mode
        Learning => true
        Working => false

    (** The saved store: every slice, because small slices round-trip through the host with each event ([UI-STORE]). *)
    export save bench = JsonObject [Doc::str ("text", bench.draft.draftText), Doc::num ("caret", bench.draft.caret), Doc::num ("strokes", bench.sketch.strokeTotal), flag ("lassoing", bench.sketch.lassoing), flag ("clearing", bench.sketch.clearing), Doc::str ("ink", bench.sketch.inkTicket), Doc::num ("inks", bench.sketch.inkCount), Doc::str ("problem", bench.shelf.shelfProblem), flag ("learning", learning bench.layout), flag ("paper", bench.layout.paperFirst), flag ("goal", bench.layout.goalOpen), flag ("generated", bench.layout.generatedOpen), flag ("library", bench.layout.libraryOpen), Doc::num ("width", bench.layout.sideWidth), Doc::str ("lesson", bench.shelf.openSlug), Doc::str ("source", bench.shelf.openSource), Doc::str ("focused", bench.shelf.focused), JsonMember "entries" (JsonArray (mapList (bench.shelf.entries, \entry => entryJson entry))), JsonMember "tutor" (Tries::save bench.tutor), JsonMember "checks" (JsonArray (mapList (bench.verdicts.checks, \check => checkJson check)))]

    entryJson entry = JsonObject [Doc::str ("slug", entry.entrySlug), Doc::str ("title", entry.entryTitle), Doc::str ("summary", entry.entrySummary), Doc::num ("stage", entry.entryStage), Doc::num ("minutes", entry.entryMinutes), JsonMember "challenges" (Doc::strings entry.entryChallenges), Doc::str ("fault", entry.entryFault)]

    checkJson check = JsonObject [Doc::num ("head", check.checkHead), Doc::num ("line", check.checkLine), Doc::str ("tone", check.checkTone), Doc::str ("note", check.checkNote)]

    entryOf doc = Listing(entrySlug = Doc::text (doc, "slug"), entryTitle = Doc::text (doc, "title"), entrySummary = Doc::text (doc, "summary"), entryStage = Doc::number (doc, "stage"), entryMinutes = Doc::number (doc, "minutes"), entryChallenges = Doc::texts (doc, "challenges"), entryFault = Doc::text (doc, "fault"))

    checkOf doc = Check(checkHead = Doc::number (doc, "head"), checkLine = Doc::number (doc, "line"), checkTone = Doc::text (doc, "tone"), checkNote = Doc::text (doc, "note"))

    modeOf learning = match learning
        true => Learning
        false => Working

    (** The store saved by `save`. *)
    export restore doc = Bench(draft = Draft(draftText = Doc::text (doc, "text"), caret = Doc::number (doc, "caret")), verdicts = Reviewed(checks = mapList (Doc::items (Doc::field (doc, "checks")), \item => checkOf item)), sketch = Sketch(strokeTotal = Doc::number (doc, "strokes"), lassoing = Doc::flag (doc, "lassoing"), clearing = Doc::flag (doc, "clearing"), inkTicket = Doc::text (doc, "ink"), inkCount = Doc::number (doc, "inks")), layout = Layout(mode = modeOf (Doc::flag (doc, "learning")), paperFirst = Doc::flag (doc, "paper"), goalOpen = Doc::flag (doc, "goal"), generatedOpen = Doc::flag (doc, "generated"), libraryOpen = Doc::flag (doc, "library"), sideWidth = Doc::number (doc, "width")), shelf = Shelf(entries = mapList (Doc::items (Doc::field (doc, "entries")), \item => entryOf item), openSlug = Doc::text (doc, "lesson"), openSource = Doc::text (doc, "source"), focused = Doc::text (doc, "focused"), shelfProblem = Doc::text (doc, "problem")), tutor = Tries::restore (Doc::field (doc, "tutor")))
