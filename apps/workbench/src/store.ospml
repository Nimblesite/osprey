// Implements [WORKBENCH-STORE] and [LESSONS-STORE]: one store, one slice per
// concern, each its own record type so that each is its own signal. Derived
// state (parsed declarations, goals, generated code) is computed in views from
// `Draft`; only the kernel's verdicts are kept, because they cost a check.
namespace workbench

import ui::Doc
import workbench::Tutors
import workbench::Tries

(** Which side of the application leads: the proof workbench or Learn mode ([LESSONS-MODE]). *)
type Mode = Working | Learning | ReadingPage

(** The document text and the caret's byte offset ([WORKBENCH-STORE]). *)
type Draft =
    draftTitle : string
    draftText : string
    caret : int
    selectedStep : int

(** The kernel's word on one declaration: its heading line, the line to underline (`-1` for none), the tone and the note ([WORKBENCH-VERDICT]). *)
type Check =
    checkHead : int
    checkLine : int
    checkTone : string
    checkNote : string

(** The kernel's verdicts on the document, one per declaration ([WORKBENCH-STORE]). *)
type Reviewed =
    checks : List<Check>

(** The retired board as saved data keeps it: the stroke count, lasso and clear flags, the last recognition ticket, the frame and its notes. Kept so saved workspaces still open and re-save ([WORKBENCH-BOARD]). *)
type Sketch =
    strokeTotal : int
    lassoing : bool
    clearing : bool
    inkTicket : string
    inkCount : int
    boardScale : int
    boardPanX : int
    boardPanY : int
    boardNotes : string
    notesVisible : bool
    panMode : bool

(** Which surface and panes are shown, and the side column's width ([WORKBENCH-STORE]). *)
type Layout =
    mode : Mode
    paperFirst : bool
    goalOpen : bool
    generatedOpen : bool
    libraryOpen : bool
    sideWidth : int
    slate : bool
    guided : bool
    boardFocused : bool
    previewText : string
    previewSample : bool
    noticeText : string
    noticeBad : bool

(** One catalogue entry as listed: slug, title, summary, stage, minutes, its challenge keys, and the reader's fault, empty when it reads ([LESSONS-FILES]). *)
type Listing =
    entrySlug : string
    entryTitle : string
    entrySummary : string
    entryStage : int
    entryMinutes : int
    entryChallenges : List<string>
    entryFault : string

(** The lesson catalogue, the open lesson's slug and text, the challenge last typed into, and why lessons failed to load ([LESSONS-STORE]). *)
type Shelf =
    entries : List<Listing>
    openSlug : string
    openSource : string
    focused : string
    shelfProblem : string

(** Current imported source and selection, without cached proof acceptance. *)
type ImportedState =
    exportText : string
    exportLarge : bool
    exportSelected : string
    exportProblem : string
    exportExpanded : bool
    exportRevision : int
    libraryCatalogue : string
    libraryProblem : string
    libraryPending : string
    libraryTicket : string
    libraryExpanded : bool

(** The whole store ([WORKBENCH-STORE], [LESSONS-STORE]). *)
type Bench =
    draft : Draft
    verdicts : Reviewed
    sketch : Sketch
    layout : Layout
    shelf : Shelf
    tutor : Tutor
    exampleBackup : Json
    imports : ImportedState

// One action union per program until Nimblesite/osprey#278; grouped by the value each binding delivers.
(** Every action a control can deliver: document and caret, panes and modes, lessons and challenges. *)
type Act = Rename | Edit | Place | NextProofLine | InsertExample | SelectStep | StepEdit | StepPlace | ToWork | ToLearn | ToPaper | ToRead | SaveWorkspace | OpenWorkspace | ExportSource | OpenProofLibrary | OpenBundledProof string | SelectProof | EditProofSource | ToggleProofSource | ToggleProofLibraries | DismissNotice | StartExample | RestartExample | LeaveExample | ToggleTheme | ToggleGoal | ToggleGenerated | ToggleLibrary | Widen | Open string | Close | Answer string | FormulaPlace string | Key string string | Pick string | Submit string | Hint string | Reveal string | Carry string

(** Creates, saves and restores the store. *)
module Benches
    (** An empty document, no verdicts, a legacy board record, the mathematical document layout and no lessons yet. *)
    export fresh () = Bench(draft = Draft(draftTitle = "Untitled solution", draftText = "", caret = 0, selectedStep = -1), verdicts = Reviewed(checks = []), sketch = Sketch(strokeTotal = 0, lassoing = true, clearing = false, inkTicket = "", inkCount = 0, boardScale = 100, boardPanX = 0, boardPanY = 0, boardNotes = "", notesVisible = false, panMode = false), layout = Layout(mode = Working, paperFirst = true, goalOpen = true, generatedOpen = false, libraryOpen = false, sideWidth = 430, slate = false, guided = false, boardFocused = false, previewText = "", previewSample = false, noticeText = "", noticeBad = false), shelf = Shelf(entries = [], openSlug = "", openSource = "", focused = "", shelfProblem = ""), tutor = Tutors::empty (), exampleBackup = JsonNull, imports = emptyImports ())

    flag (key, value) = JsonMember key (JsonBool value)

    learning layout = match layout.mode
        Learning => true
        Working => false
        ReadingPage => false

    reading layout = match layout.mode
        ReadingPage => true
        _ => false

    (** The saved store: every slice, because small slices round-trip through the host with each event ([UI-STORE]). *)
    export save bench = JsonObject [Doc::str ("title", bench.draft.draftTitle), Doc::str ("text", bench.draft.draftText), Doc::num ("caret", bench.draft.caret), Doc::num ("selectedStep", bench.draft.selectedStep), Doc::num ("strokes", bench.sketch.strokeTotal), flag ("lassoing", bench.sketch.lassoing), flag ("clearing", bench.sketch.clearing), Doc::str ("ink", bench.sketch.inkTicket), Doc::num ("inks", bench.sketch.inkCount), Doc::num ("scale", bench.sketch.boardScale), Doc::num ("panX", bench.sketch.boardPanX), Doc::num ("panY", bench.sketch.boardPanY), Doc::str ("notes", bench.sketch.boardNotes), flag ("notesVisible", bench.sketch.notesVisible), flag ("panMode", bench.sketch.panMode), Doc::str ("problem", bench.shelf.shelfProblem), flag ("learning", learning bench.layout), flag ("reading", reading bench.layout), flag ("paper", bench.layout.paperFirst), flag ("goal", bench.layout.goalOpen), flag ("generated", bench.layout.generatedOpen), flag ("library", bench.layout.libraryOpen), Doc::num ("width", bench.layout.sideWidth), flag ("slate", bench.layout.slate), flag ("guided", bench.layout.guided), flag ("boardFocused", bench.layout.boardFocused), Doc::str ("preview", bench.layout.previewText), flag ("samplePreview", bench.layout.previewSample), Doc::str ("notice", bench.layout.noticeText), flag ("noticeBad", bench.layout.noticeBad), Doc::str ("lesson", bench.shelf.openSlug), Doc::str ("source", bench.shelf.openSource), Doc::str ("focused", bench.shelf.focused), JsonMember "entries" (JsonArray (mapList (bench.shelf.entries, \entry => entryJson entry))), JsonMember "imports" (importsJson bench.imports), JsonMember "exampleBackup" bench.exampleBackup, JsonMember "tutor" (Tries::save bench.tutor), JsonMember "checks" (JsonArray (mapList (bench.verdicts.checks, \check => checkJson check)))]

    entryJson entry = JsonObject [Doc::str ("slug", entry.entrySlug), Doc::str ("title", entry.entryTitle), Doc::str ("summary", entry.entrySummary), Doc::num ("stage", entry.entryStage), Doc::num ("minutes", entry.entryMinutes), JsonMember "challenges" (Doc::strings entry.entryChallenges), Doc::str ("fault", entry.entryFault)]

    checkJson check = JsonObject [Doc::num ("head", check.checkHead), Doc::num ("line", check.checkLine), Doc::str ("tone", check.checkTone), Doc::str ("note", check.checkNote)]

    entryOf doc = Listing(entrySlug = Doc::text (doc, "slug"), entryTitle = Doc::text (doc, "title"), entrySummary = Doc::text (doc, "summary"), entryStage = Doc::number (doc, "stage"), entryMinutes = Doc::number (doc, "minutes"), entryChallenges = Doc::texts (doc, "challenges"), entryFault = Doc::text (doc, "fault"))

    checkOf doc = Check(checkHead = Doc::number (doc, "head"), checkLine = Doc::number (doc, "line"), checkTone = Doc::text (doc, "tone"), checkNote = Doc::text (doc, "note"))

    modeOf doc = match Doc::flag (doc, "reading")
        true => ReadingPage
        false => match Doc::flag (doc, "learning")
            true => Learning
            false => Working

    (** The store saved by `save`. *)
    export restore doc = Bench(draft = Draft(draftTitle = titleOf doc, draftText = Doc::text (doc, "text"), caret = Doc::number (doc, "caret"), selectedStep = selectedOf doc), verdicts = Reviewed(checks = mapList (Doc::items (Doc::field (doc, "checks")), \item => checkOf item)), sketch = Sketch(strokeTotal = Doc::number (doc, "strokes"), lassoing = Doc::flag (doc, "lassoing"), clearing = Doc::flag (doc, "clearing"), inkTicket = Doc::text (doc, "ink"), inkCount = Doc::number (doc, "inks"), boardScale = scaleOf doc, boardPanX = Doc::number (doc, "panX"), boardPanY = Doc::number (doc, "panY"), boardNotes = Doc::text (doc, "notes"), notesVisible = Doc::flag (doc, "notesVisible"), panMode = Doc::flag (doc, "panMode")), layout = Layout(mode = modeOf doc, paperFirst = Doc::flag (doc, "paper"), goalOpen = Doc::flag (doc, "goal"), generatedOpen = Doc::flag (doc, "generated"), libraryOpen = Doc::flag (doc, "library"), sideWidth = Doc::number (doc, "width"), slate = Doc::flag (doc, "slate"), guided = Doc::flag (doc, "guided"), boardFocused = Doc::flag (doc, "boardFocused"), previewText = Doc::text (doc, "preview"), previewSample = Doc::flag (doc, "samplePreview"), noticeText = Doc::text (doc, "notice"), noticeBad = Doc::flag (doc, "noticeBad")), shelf = Shelf(entries = mapList (Doc::items (Doc::field (doc, "entries")), \item => entryOf item), openSlug = Doc::text (doc, "lesson"), openSource = Doc::text (doc, "source"), focused = Doc::text (doc, "focused"), shelfProblem = Doc::text (doc, "problem")), tutor = Tries::restore (Doc::field (doc, "tutor")), exampleBackup = Doc::field (doc, "exampleBackup"), imports = importsOf (Doc::field (doc, "imports")))

    titleOf doc = match isEmpty (Doc::text (doc, "title"))
        true => "Untitled solution"
        false => Doc::text (doc, "title")


    scaleOf doc = match Doc::number (doc, "scale") >= 25 && Doc::number (doc, "scale") <= 400
        true => Doc::number (doc, "scale")
        false => 100


    selectedOf doc = match jsonInt (Doc::field (doc, "selectedStep"))
        Success index => index
        Error _ => -1

    emptyImports () = ImportedState(exportText = "", exportLarge = false, exportSelected = "", exportProblem = "", exportExpanded = false, exportRevision = 0, libraryCatalogue = "", libraryProblem = "", libraryPending = "", libraryTicket = "", libraryExpanded = true)

    importsJson current = JsonObject [Doc::str ("source", current.exportText), Doc::str ("selected", current.exportSelected), Doc::str ("problem", current.exportProblem), flag ("large", current.exportLarge), flag ("expanded", current.exportExpanded), Doc::num ("revision", current.exportRevision), Doc::str ("catalogue", current.libraryCatalogue), Doc::str ("catalogueProblem", current.libraryProblem), Doc::str ("pending", current.libraryPending), Doc::str ("ticket", current.libraryTicket), flag ("librariesExpanded", current.libraryExpanded)]

    importsOf doc = ImportedState(exportText = Doc::text (doc, "source"), exportLarge = Doc::flag (doc, "large"), exportSelected = Doc::text (doc, "selected"), exportProblem = Doc::text (doc, "problem"), exportExpanded = Doc::flag (doc, "expanded"), exportRevision = Doc::number (doc, "revision"), libraryCatalogue = Doc::text (doc, "catalogue"), libraryProblem = Doc::text (doc, "catalogueProblem"), libraryPending = Doc::text (doc, "pending"), libraryTicket = Doc::text (doc, "ticket"), libraryExpanded = !Doc::has (doc, "librariesExpanded") || Doc::flag (doc, "librariesExpanded"))
