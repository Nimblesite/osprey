// [WORKBENCH-FORMULA] cases: sentence forms, precedence, round trip and faults.
namespace workbenchtests

import workbench::Formulas
import ui::Maths
import ui::Doc
import workbenchtests::FixtureFiles

(** The formula cases of [WORKBENCH-VERIFICATION]. *)
module FormulaCases
    shown text = match Formulas::read text
        workbench::Read formula => Formulas::show formula
        workbench::Faulted fault => "fault ${fault.column}: ${fault.expected}"

    (** A formula fixture that does not read is a broken test, never `⊥`; the
        shared fixture helper returns a typed failure to the case boundary. *)
    formula text = FixtureFiles::formula ("fixture", text)

    // Both sentences must read; the first typed fixture failure reaches the case unchanged.
    equalTexts (first, second) =
        FixtureFiles::bind (formula first, \left => FixtureFiles::bind (formula second, \right => FixtureFiles::ok (Formulas::equal (left, right))))

    // The `(sentence, symbols)` pairs of the formula table that do not read to the same text.
    differing pairs = filterList (pairs, \pair => shown pair.sentence != pair.symbols)

    (** [WORKBENCH-FORMULA]: every sentence form of the formula table reads to its symbols. *)
    export sentences () =
        rows = [
            { sentence = "p and q", symbols = "p ∧ q" },
            { sentence = "p or q", symbols = "p ∨ q" },
            { sentence = "not p", symbols = "¬p" },
            { sentence = "it is not the case that p", symbols = "¬p" },
            { sentence = "if p then q", symbols = "p → q" },
            { sentence = "p implies q", symbols = "p → q" },
            { sentence = "p if and only if q", symbols = "p ↔ q" },
            { sentence = "p iff q", symbols = "p ↔ q" },
            { sentence = "for all p q, p and q", symbols = "∀ p q, p ∧ q" },
            { sentence = "for every p, p", symbols = "∀ p, p" },
            { sentence = "true", symbols = "⊤" },
            { sentence = "false", symbols = "⊥" },
            { sentence = "If p AND q Then q and p", symbols = "p ∧ q → q ∧ p" },
        ]
        expect (join (mapList (differing rows, \pair => pair.sentence + " => " + shown pair.sentence), "; "), "")

    (** [WORKBENCH-FORMULA]: `↔` loosest, `→` right associative, `∧` tightest, parentheses override. *)
    export precedence () =
        FixtureFiles::bind (formula "p → q → r", \associative =>
        FixtureFiles::bind (formula "(p → q) → r", \grouped =>
        FixtureFiles::bind (formula "p ∧ q ∨ r", \tightest =>
        FixtureFiles::bind (formula "p ∧ (q ∨ r)", \overridden =>
        FixtureFiles::bind (formula "¬(p ∧ q)", \negated =>
        FixtureFiles::bind (formula "p ↔ q → r", \loosest =>
        FixtureFiles::bind (formula "((p))", \redundant =>
        FixtureFiles::bind (formula "(∀ p, p) ∧ q", \scoped =>
            expect (Formulas::show associative, "p → q → r")
            expect (Formulas::show grouped, "(p → q) → r")
            expect (Formulas::show tightest, "p ∧ q ∨ r")
            expect (Formulas::show overridden, "p ∧ (q ∨ r)")
            expect (Formulas::show negated, "¬(p ∧ q)")
            expect (Formulas::show loosest, "p ↔ q → r")
            expect (Formulas::show redundant, "p")
            FixtureFiles::ok (expect (Formulas::show scoped, "(∀ p, p) ∧ q"))))))))))

    (** [WORKBENCH-FORMULA]: a fault names the column and the shortest fix. *)
    export faults () =
        expect (shown "p ∧", "fault 4: a proposition after `∧`")
        expect (shown "p and", "fault 6: a proposition after `and`")
        expect (shown "", "fault 1: a proposition")
        expect (shown "(p ∧ q", "fault 7: `)`")
        expect (shown "if p q", "fault 6: `then` after the condition")
        expect (shown "for all, p", "fault 8: a name to bind")
        expect (shown "∀ p q p", "fault 8: `,` after the bound names")
        expect (shown "p q", "fault 3: the end of the formula or a connective before `q`")
        expect (shown "p $ q", "fault 3: a connective in place of `$`")

    (** [WORKBENCH-FORMULA]: equality is structural. *)
    export equality () =
        FixtureFiles::bind (equalTexts ("p ∧ q", "p and q"), \andEqual =>
        FixtureFiles::bind (equalTexts ("p ∧ q", "q ∧ p"), \commutedEqual =>
            variable = workbench::Var "¬p"
            negation = workbench::Not (workbench::Var "p")
            expect (andEqual, true)
            expect (commutedEqual, false)
            expect (Formulas::equal (variable, negation), false)
            expect (Formulas::equal (negation, negation), true)
            expect (Formulas::equal (workbench::Var "p → q", workbench::Imp (workbench::Var "p", workbench::Var "q")), false)
            expect (Formulas::equal (workbench::Var "⊤", workbench::Top), false)
            expect (Formulas::equal (workbench::Forall (["a b"], workbench::Var "a"), workbench::Forall (["a", "b"], workbench::Var "a")), false)
            expect (Formulas::equal (workbench::Forall (["x"], workbench::Var "x"), workbench::Forall (["x"], workbench::Var "x")), true)
            expect (Formulas::equal (negation, workbench::Imp (workbench::Var "p", workbench::Bot)), false)
            FixtureFiles::ok (expect (Formulas::equivalent (negation, workbench::Imp (workbench::Var "p", workbench::Bot)), true))))

    layout text =
        FixtureFiles::bind (formula text, \read =>
            FixtureFiles::ok (Maths::encode (Formulas::typeset read)))

    (** [WORKBENCH-MATH]: connective trees preserve grouping and binder scope. *)
    export typesetting () =
        FixtureFiles::bind (layout "(p → q) ∧ (q ∨ p)", \tree =>
        FixtureFiles::bind (layout "(∀ p, p) ∧ q", \forall =>
        FixtureFiles::bind (layout "p → ∀ q, q", \withBinder =>
        FixtureFiles::bind (layout "p → q → p", \arrow =>
        FixtureFiles::bind (layout "⊤", \top =>
        FixtureFiles::bind (layout "⊥", \bottom =>
        FixtureFiles::bind (layout "α₁", \alpha =>
            trailing = Doc::field (withBinder, "right")
            expect (Doc::text (tree, "symbol"), "∧")
            expect (Doc::text (Doc::field (tree, "left"), "kind"), "paren")
            expect (Doc::text (Doc::field (tree, "right"), "kind"), "paren")
            expect (Doc::text (Doc::field (Doc::field (forall, "left"), "body"), "kind"), "binder")
            expect (Doc::text (trailing, "kind"), "binder")
            expect (Doc::text (trailing, "symbol"), "∀")
            expect (Doc::text (listGet (Doc::items (Doc::field (trailing, "names"))) 0 ?: JsonNull, "text"), "q")
            expect (Doc::text (Doc::field (arrow, "right"), "symbol"), "→")
            expect (Doc::text (top, "text"), "⊤")
            expect (Doc::text (bottom, "text"), "⊥")
            FixtureFiles::ok (expect (Doc::text (alpha, "text"), "α₁")))))))))
