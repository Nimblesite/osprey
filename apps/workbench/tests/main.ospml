// The workbench suite ([WORKBENCH-VERIFICATION]): one file per module, each
// case through the real modules; this file is the entry the manifest names,
// because a test statement is only legal in the entry source.
namespace workbenchtests

import workbenchtests::NotationCases
import workbenchtests::StepCases
import workbenchtests::CorpusCases
import workbenchtests::GoalCases
import workbenchtests::EmitCases
import workbenchtests::StatementCases
import workbenchtests::BoardCases
import workbenchtests::ThemeCases
import workbenchtests::TypesetCases
import workbenchtests::VerdictCases
import workbenchtests::AppCases
import workbenchtests::WorkflowCases
import workbenchtests::ImportedCases
import workbenchtests::ImportMemoCases
import workbenchtests::ImportedFlowCases
import workbenchtests::ProofTermCases
import workbenchtests::FixtureFiles

test ("imported id_imp exposes its actual statement and no assumptions", FixtureFiles::checked (FixtureFiles::unit ImportedCases::valid))
test ("imported run_work presents its exact natural arithmetic and second projection", FixtureFiles::checked (FixtureFiles::unit ProofTermCases::runWork))
test ("imported arithmetic notation preserves grouping and refuses incorrect dictionaries", FixtureFiles::checked (FixtureFiles::unit ProofTermCases::runWorkGuards))
test ("imported product notation requires complete checked declaration identities", FixtureFiles::checked (FixtureFiles::unit ProofTermCases::runWorkIdentities))
test ("corrupting the current imported proof is refused", FixtureFiles::checked (FixtureFiles::unit ImportedCases::corrupted))
test ("a missing selected imported theorem is refused", FixtureFiles::checked (FixtureFiles::unit ImportedCases::missing))
test ("an imported axiom is never presented as a proved theorem", FixtureFiles::checked (FixtureFiles::unit ImportedCases::assumption))
test ("unused export assumptions do not contaminate the selected proof", FixtureFiles::checked (FixtureFiles::unit ImportedCases::unused))
test ("a checked catalogue includes each theorem's own assumptions", FixtureFiles::checked (FixtureFiles::unit ImportedCases::catalogue))
test ("an empty export is not an empty successful proof catalogue", FixtureFiles::checked (FixtureFiles::unit ImportedCases::empty))
test ("oversized proof exports are refused before parsing", FixtureFiles::checked (FixtureFiles::unit ImportedCases::oversized))
test ("each frame checks every exact proof source once and discards the memo afterward", FixtureFiles::checked (FixtureFiles::unit ImportMemoCases::run))

test ("every row of the notation table expands to its symbol", FixtureFiles::checked (FixtureFiles::unit NotationCases::everyRow))
test ("expanding every expanded row again changes nothing", FixtureFiles::checked (FixtureFiles::unit NotationCases::idempotentRow))
test ("the table holds every abbreviation of the notation section", FixtureFiles::checked (FixtureFiles::unit NotationCases::tableComplete))
test ("an abbreviation followed by a space becomes its symbol", FixtureFiles::checked (FixtureFiles::unit NotationCases::completed))
test ("an abbreviation at the end of the buffer is not yet replaced", FixtureFiles::checked (FixtureFiles::unit NotationCases::unfinished))
test ("\\to completes and \\top stays as typed", FixtureFiles::checked (FixtureFiles::unit NotationCases::toVersusTop))
test ("the longest complete abbreviation wins", FixtureFiles::checked (FixtureFiles::unit NotationCases::longest))
test ("a punctuation abbreviation completes immediately", FixtureFiles::checked (FixtureFiles::unit NotationCases::arrow))
test ("subscript digits chain into a run", FixtureFiles::checked (FixtureFiles::unit NotationCases::subscripts))
test ("text without an abbreviation is unchanged and expanding twice changes nothing", FixtureFiles::checked (FixtureFiles::unit NotationCases::total))
test ("the palette lists the rows that start with what was typed", FixtureFiles::checked (FixtureFiles::unit NotationCases::palette))
import workbenchtests::FormulaCases
import workbenchtests::LessonCases
import workbenchtests::IntegrityCases

test ("every sentence form reads to the same formula as its symbols", FixtureFiles::checked (FixtureFiles::unit FormulaCases::sentences))
test ("precedence and grouping read as the formula table says", FixtureFiles::checked FormulaCases::precedence)
test ("a malformed formula names the column and what was expected", FixtureFiles::checked (FixtureFiles::unit FormulaCases::faults))
test ("formula equality is structural", FixtureFiles::checked FormulaCases::equality)
test ("formula layouts preserve grouping and binder scope", FixtureFiles::checked FormulaCases::typesetting)
test ("clearing a board requires confirmation and preserves notes and framing", FixtureFiles::checked (FixtureFiles::unit BoardCases::clearing))
test ("undo removes only the last stroke and is total on an empty board", FixtureFiles::checked (FixtureFiles::unit BoardCases::undoing))
test ("saved boards retain strokes notes and framing without restoring confirmation", FixtureFiles::checked (FixtureFiles::unit BoardCases::reopening))
test ("invalid saved boards are refused without invented values", FixtureFiles::checked (FixtureFiles::unit BoardCases::malformed))
test ("board runtime slices retain framing and write each stroke separately", FixtureFiles::checked (FixtureFiles::unit BoardCases::slices))
test ("workbench exposes typed mathematics without freehand drawing", FixtureFiles::checked (FixtureFiles::unit BoardCases::mathematicalWorkspaceOnly))

test ("every written form of the step table reads to its step", FixtureFiles::checked (FixtureFiles::unit StepCases::written))
test ("the ten near-misses of the step table stay unknown", FixtureFiles::checked (FixtureFiles::unit StepCases::nearMisses))
test ("a proof body splits into its step sentences", FixtureFiles::checked (FixtureFiles::unit StepCases::proofBody))
test ("every step constructor becomes its tactic", FixtureFiles::checked (FixtureFiles::unit StepCases::tactics))

test ("every generated formula survives its shown round trip", FixtureFiles::checked (FixtureFiles::unit CorpusCases::roundTrip))
test ("the generated formula corpus has the exact derived count", FixtureFiles::checked (FixtureFiles::unit CorpusCases::generatedCount))
test ("every generated parenthesis is needed to preserve the formula", FixtureFiles::checked (FixtureFiles::unit CorpusCases::minimalParentheses))

test ("the spec's and_swap document reads to one declaration with its claim, variables and proof", FixtureFiles::checked (FixtureFiles::unit StatementCases::andSwap))
test ("all four heading words open declarations and unnamed headings take t_<n>", FixtureFiles::checked (FixtureFiles::unit StatementCases::headings))
test ("two declarations in one buffer split at the second heading", FixtureFiles::checked (FixtureFiles::unit StatementCases::split))
test ("an atom outside the bound variables reports the exact problem and fix", FixtureFiles::checked (FixtureFiles::unit StatementCases::undeclared))
test ("a claim that is not a formula is Bot with the fault's column and expectation", FixtureFiles::checked (FixtureFiles::unit StatementCases::malformed))

test ("and_swap closes under the goal engine and every goal is shown", FixtureFiles::checked GoalCases::andSwap)
test ("every row of the tactic table advances the goal it names", FixtureFiles::checked GoalCases::rows)
test ("every failing step reports the exact mismatch", FixtureFiles::checked GoalCases::mismatches)
test ("unrecognised prose is unsupported input rather than a mathematical mismatch", FixtureFiles::checked GoalCases::unsupportedProse)
test ("unsupported prose preserves context and stops later goal evaluation", FixtureFiles::checked GoalCases::unsupportedProgress)
test ("refused sentences retain the last understood goals and step count", FixtureFiles::checked GoalCases::retainedGoal)
test ("missing premises and premature completion never supply an invented truth", FixtureFiles::checked GoalCases::noInventedTruth)
test ("a fifty-step proof closes", FixtureFiles::checked (FixtureFiles::unit GoalCases::fifty))

test ("and_swap emits byte-identical to its golden", FixtureFiles::checked EmitCases::andSwap)
test ("an unknown step becomes a sorry with the text as a comment", FixtureFiles::checked EmitCases::holes)
test ("leading assumptions become binders", FixtureFiles::checked EmitCases::binders)
test ("two proofs share one header and are separated by a blank line", FixtureFiles::checked EmitCases::layout)
test ("body text and source roles reach 4.5:1 on every surface in both appearances", FixtureFiles::checked (FixtureFiles::unit ThemeCases::bodyText))
test ("selection and diagnostic surfaces keep their foregrounds at 4.5:1", FixtureFiles::checked (FixtureFiles::unit ThemeCases::states))
test ("the control outline reaches 3.0:1 on every surface", FixtureFiles::checked (FixtureFiles::unit ThemeCases::outlines))
test ("chalk strokes reach 4.5:1 against the board", FixtureFiles::checked (FixtureFiles::unit ThemeCases::chalkOnBoard))
test ("every theme holds each colour token exactly once", FixtureFiles::checked (FixtureFiles::unit ThemeCases::tokens))

test ("every generated math tree flattens to its minimal Unicode formula", FixtureFiles::checked (FixtureFiles::unit TypesetCases::corpus))
test ("and_swap has the exact binder and operator math tree", FixtureFiles::checked (FixtureFiles::unit TypesetCases::andSwap))
test ("a negated conjunction has a math parenthesis", FixtureFiles::checked (FixtureFiles::unit TypesetCases::negatedConjunction))
test ("only the antecedent of a nested implication has a math parenthesis", FixtureFiles::checked (FixtureFiles::unit TypesetCases::conditionalAntecedent))

test ("the prelude is admitted by the kernel", FixtureFiles::checked (FixtureFiles::unit VerdictCases::prelude))
test ("and_swap is checked by the kernel", FixtureFiles::checked (FixtureFiles::unit VerdictCases::andSwap))
test ("swapping the last two steps is rejected at the step the engine refuses", FixtureFiles::checked (FixtureFiles::unit VerdictCases::swapped))
test ("one passing proof per row of the goal table is checked", FixtureFiles::checked (FixtureFiles::unit VerdictCases::rows))
test ("the goal engine and the kernel agree on every right and wrong proof", FixtureFiles::checked (FixtureFiles::unit VerdictCases::agreement))
test ("an unknown step is unchecked with its sentence quoted", FixtureFiles::checked (FixtureFiles::unit VerdictCases::unknownStep))
test ("a proof that stops with a goal open is unchecked", FixtureFiles::checked (FixtureFiles::unit VerdictCases::openGoal))
test ("a step after the proof is complete is unchecked", FixtureFiles::checked (FixtureFiles::unit VerdictCases::surplus))
test ("an undeclared atom is rejected on the statement", FixtureFiles::checked (FixtureFiles::unit VerdictCases::undeclaredAtom))
test ("a kernel-checked answer is right, a refused one is wrong at its line, an unknown sentence is unfinished", FixtureFiles::checked (FixtureFiles::unit LessonCases::prove))
test ("a stated formula is right when the kernel finds it the same proposition by definition", FixtureFiles::checked LessonCases::stated)
test ("a judgement is right exactly when it agrees with the kernel's verdict", FixtureFiles::checked (FixtureFiles::unit LessonCases::judge))
test ("wrong submissions count attempts and reveal hints up to their number", FixtureFiles::checked (FixtureFiles::unit LessonCases::attempts))
test ("the solution is offered after three wrong attempts and counts only once submitted", FixtureFiles::checked (FixtureFiles::unit LessonCases::reveal))
test ("editing an answer clears its mark and an empty answer cannot be submitted", FixtureFiles::checked (FixtureFiles::unit LessonCases::clearing))
test ("progress saves only completed challenges and unreadable progress is none", FixtureFiles::checked (FixtureFiles::unit LessonCases::progress))
test ("a lesson with every block and challenge kind reads in order", FixtureFiles::checked (FixtureFiles::unit LessonCases::everyBlock))
test ("each broken lesson form is refused with its path and rule", FixtureFiles::checked (FixtureFiles::unit LessonCases::refusals))
test ("every shipped lesson reads, its solutions check, its questions are decided and its media exist", FixtureFiles::checked (FixtureFiles::unit IntegrityCases::shipped))
test ("starting the app draws every region and requests lessons and progress", FixtureFiles::checked (FixtureFiles::unit AppCases::start))
test ("typing redraws only the document goal and source regions", FixtureFiles::checked (FixtureFiles::unit AppCases::keystroke))
test ("kernel verdicts mark the actual proof line", FixtureFiles::checked (FixtureFiles::unit AppCases::underline))
test ("the paper fills the content viewport with no authored board height", FixtureFiles::checked (FixtureFiles::unit AppCases::paperViewport))
test ("a saved working's legacy strokes arrive as host slices while the retired board writes nothing", FixtureFiles::checked (FixtureFiles::unit AppCases::strokes))
test ("the retired board requests no recognition and a stray reply changes nothing", FixtureFiles::checked (FixtureFiles::unit AppCases::lasso))
test ("catalogue loading restores saved learner progress", FixtureFiles::checked (FixtureFiles::unit AppCases::loading))
test ("editing a lesson answer redraws only its challenge", FixtureFiles::checked (FixtureFiles::unit AppCases::challenge))
test ("only a kernel checked lesson submission saves progress", FixtureFiles::checked (FixtureFiles::unit AppCases::submit))
test ("a stray legacy ink answer cannot overwrite the focused lesson answer", FixtureFiles::checked (FixtureFiles::unit AppCases::inked))
test ("a lesson challenge opens in the workbench", FixtureFiles::checked (FixtureFiles::unit AppCases::carry))
test ("typeset row edits preserve the complete source and caret", FixtureFiles::checked (FixtureFiles::unit AppCases::rowEditing))
test ("unsupported wording stays neutral and unchecked through the app", FixtureFiles::checked (FixtureFiles::unit AppCases::unsupportedFeedback))
test ("naming and reading preserve free form working without an editor", FixtureFiles::checked (FixtureFiles::unit AppCases::namedReading))
test ("returning from a guided example restores the complete original working", FixtureFiles::checked (FixtureFiles::unit AppCases::exampleRoundTrip))
test ("lessons retain one natural scrolling page around all challenges", FixtureFiles::checked (FixtureFiles::unit AppCases::lessonPageScroll))

test ("the retired board draws no tools while a saved working keeps its strokes notes and framing", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::boardTools))
test ("Source Read and Proof transitions preserve one mathematical document", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::sourceModes))
test ("the real example walkthrough inserts its step and returns the working unmarked", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::sampleReview))
test ("no ink review exists so a stray completion approves no statement", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::inkReview))
test ("workspace save open and source export preserve actual host slices", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::files))
test ("workspace cancellations malformed files and host failures stay explicit", FixtureFiles::checked (FixtureFiles::unit WorkflowCases::fileFailures))

test ("proof library file import displays its actual checked statement", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::fileImport))
test ("imported assumption receipts cannot hide an axiom named none", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::ledgerBoundaries))
test ("imported proof inspection uses full width and preserves working state", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::inspectionLayout))
test ("opening an example from an imported library reveals its proof", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::exampleAfterImport))
test ("imported theorem selection refuses missing and axiom roots", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::selection))
test ("current imported source corruption revokes checking until repaired", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::currentSource))
test ("proof import cancellation malformed source and host errors stay explicit", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::refusals))
test ("each selected imported theorem reports only its used axioms", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::axioms))
test ("large imported sources require actual retained host data", FixtureFiles::checked (FixtureFiles::unit ImportedFlowCases::largeSource))

test ("fixture failures are typed and never fabricate text or formulae", FixtureFiles::checked (FixtureFiles::unit FixtureFiles::failures))
