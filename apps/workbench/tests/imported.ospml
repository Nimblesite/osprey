namespace workbenchtests

import workbenchtests::Drive
import workbenchtests::AppCases
import workbench::Benches
import workbench::BundledLibraries
import ui::Doc
import ui::Maths
import proof::ImportedProofs
import proof::CachedImports
import proof::Fixtures
import proof::Trust
import workbenchtests::ProofTermCases

(** Current imported source is checked by the shared kernel, including
    refusals and assumptions. Implements [WORKBENCH-VERDICT]. *)
module ImportedCases
    export run () =
        test ("imported id_imp exposes its actual statement and no assumptions", valid)
        test ("corrupting the current imported proof is refused", corrupted)
        test ("a missing selected imported theorem is refused", missing)
        test ("an imported axiom is never presented as a proved theorem", assumption)
        test ("unused export assumptions do not contaminate the selected proof", unused)
        test ("a checked catalogue includes each theorem's own assumptions", catalogue)
        test ("an empty export is not an empty successful proof catalogue", empty)
        test ("oversized proof exports are refused before parsing", oversized)

    export valid () =
        expect (described (ImportedProofs::check (Fixtures::idImp (), "id_imp")), "id_imp | (∀ (p : Prop), (p → p)) | none")
        ProofTermCases::run ()

    export corrupted () = expect (startsWith (described (ImportedProofs::check (Fixtures::idImpBad (), "id_imp")), "error: type mismatch:"), true)

    export missing () = expect (described (ImportedProofs::check (Fixtures::idImp (), "missing")), "error: the export declares no `missing`")

    export assumption () =
        expect (described (ImportedProofs::check (withUnused (), "unusedAssumption")), "error: `unusedAssumption` is not a theorem")
        definition = replace (Fixtures::idImp (), "\"thm\":", "\"def\":") ?: ""
        expect (described (ImportedProofs::check (definition, "id_imp")), "error: `id_imp` is not a theorem")

    export unused () = expect (described (ImportedProofs::check (withUnused (), "id_imp")), "id_imp | (∀ (p : Prop), (p → p)) | none")

    export catalogue () = match ImportedProofs::catalogue (withUnused ())
        Success entries =>
            expect (length entries, 1)
            expect (join (mapList (entries, \entry => entry.importedName), ","), "id_imp")
        Error message => expect (message, "a checked theorem catalogue")

    export empty () = expect (catalogueError (ImportedProofs::catalogue ""), "the export declares no theorems")

    export oversized () = match repeat ("x", 8388609)
        Error message => expect (message, "an allocated oversized input")
        Success text =>
            expect (byteLength text, 8388609)
            expect (described (ImportedProofs::check (text, "id_imp")), "error: the proof export exceeds 8 MiB")
            expect (catalogueError (ImportedProofs::catalogue text), "the proof export exceeds 8 MiB")

    catalogueError outcome = match outcome
        Success entries => "unexpected success"
        Error message => message

    described outcome = match outcome
        Success entry => "${entry.importedName} | ${entry.importedStatement} | ${assumptions entry.importedAxioms}"
        Error message => "error: ${message}"

    assumptions names = match Trust::described (Success(value = names))
        Success text => text
        Error message => "refused: ${message}"

    export withUnused () = "${Fixtures::idImp ()}{\"in\":16,\"str\":{\"pre\":0,\"str\":\"unusedAssumption\"}}\n{\"axiom\":{\"isUnsafe\":false,\"levelParams\":[],\"name\":16,\"type\":0}}\n"

(** The real shared host flow checks current source, selection, and refusal states. *)
module ImportedFlowCases
    pane envelope = Drive::node (envelope, "library")

    actions envelope = Drive::node (envelope, "library-actions")

    shown envelope = Drive::visibleText (pane envelope)

    current envelope = Doc::field (Drive::stored envelope, "imports")

    ask () =
        first = Drive::started ()
        asked (first, first)

    asked (first, _issued) =
        visible = Drive::activate (first, first, "root", "Notation")
        requested = Drive::activate (visible, visible, "library-actions", "Open proof library")
        expect (Drive::tickets requested, "proof:opened")
        requested

    loaded (requested, source) = Drive::postHeld (requested, Drive::done ("proof:opened", "{\"path\":\"proof.ndjson\"}"), JsonObject [Doc::str ("proof:import", source)])

    picked (before, name) =
        rows = Drive::findLabel ("Theorem", pane before)
        expect (Doc::has (rows, "event"), true)
        Drive::post (before, Drive::control ("library", Drive::revision (before, "library"), Doc::number (rows, "event"), Drive::quoted name))

    expanded before =
        disclosure = Drive::findTitle ("Imported source", pane before)
        Drive::post (before, Drive::control ("library", Drive::revision (before, "library"), Doc::number (disclosure, "event"), "true"))

    edited (before, source) = Drive::post (before, Drive::labelled (before, before, "library", "Current proof export", Drive::quoted source))

    export ledgerBoundaries () =
        selected = picked (loaded (ask (), receiptSource ()), "root")
        expect (Doc::text (current selected, "selected"), "root")
        expect (AppCases::has (shown selected, "Axioms: \"none\""), true)

    receiptSource () = (replace (ImportedCases::withUnused (), "unusedAssumption", "none") ?: "") + "{\"ie\":1000,\"const\":{\"name\":16,\"us\":[]}}\n{\"ie\":1001,\"forallE\":{\"name\":0,\"type\":1000,\"body\":1000,\"binderInfo\":\"default\"}}\n{\"ie\":1002,\"lam\":{\"name\":0,\"type\":1000,\"body\":1,\"binderInfo\":\"default\"}}\n{\"in\":17,\"str\":{\"pre\":0,\"str\":\"root\"}}\n{\"thm\":{\"name\":17,\"levelParams\":[],\"type\":1001,\"value\":1002,\"all\":[]}}\n"

    export fileImport () =
        source = Fixtures::idImp ()
        after = loaded (ask (), source)
        expect (Doc::text (current after, "source"), source)
        expect (Doc::text (current after, "selected"), "id_imp")
        expect (AppCases::has (shown after, "Checked theorem"), true)
        expect (AppCases::has (shown after, "(∀ (p : Prop), (p → p))"), true)
        expect (AppCases::has (shown after, "Axioms: none"), true)
        expect (Doc::text (selectedMath after, "kind"), "math")
        expect (Doc::text (Drive::stored after, "text"), "")
        arithmetic ()
        customEquality ()
        customAddition ()
        bundled ()

    export inspectionLayout () =
        initial = Drive::started ()
        before = asked (AppCases::stroked (AppCases::typed (initial, "Keep this free-form argument.")), initial)
        expect (Doc::text (Drive::findNamed ("proof-library-inspection", Drive::node (before, "root")), "kind"), "")
        after = loaded (before, Fixtures::idImp ())
        root = Drive::node (after, "root")
        expect (Doc::text (Drive::findNamed ("proof-library-inspection", root), "kind"), "framed")
        expect (Doc::text (Drive::findNode ("aside", root), "kind"), "")
        closed = Drive::activate (after, after, "root", "Close proof library")
        expect (Doc::text (Drive::findNode ("aside", Drive::node (closed, "root")), "kind"), "aside")
        expect (Doc::write (current closed), Doc::write (current after))
        expect (Doc::text (Drive::stored closed, "text"), "Keep this free-form argument.")
        expect (Doc::number (Drive::stored closed, "strokes"), 1)
        reopened = Drive::activate (closed, closed, "root", "Notation")
        expect (Doc::text (Drive::findNamed ("proof-library-inspection", Drive::node (reopened, "root")), "kind"), "framed")
        expect (Doc::text (Drive::stored reopened, "text"), Doc::text (Drive::stored before, "text"))

    export exampleAfterImport () =
        initial = Drive::started ()
        catalogue = Drive::post (initial, Drive::done ("lessons:catalogue", "{}"))
        ready = Drive::post (catalogue, Drive::done ("lessons:texts", "{}"))
        imported = loaded (asked (ready, initial), Fixtures::idImp ())
        opened = Drive::activate (imported, imported, "root", "Examples")
        started = Drive::activate (opened, opened, "catalogue", "Open conjunction example")
        root = Drive::node (started, "root")
        expect (Doc::text (Drive::findNamed ("proof-library-inspection", root), "kind"), "")
        expect (Doc::text (Drive::findNamed ("example-context", root), "kind"), "framed")
        expect (AppCases::has (Doc::text (Drive::stored started, "text"), "Theorem and_swap"), true)
        expect (Doc::text (current started, "selected"), "id_imp")

    customEquality () = forEachList ([counterfeitEquality (), counterfeitEqualityRenamed ()], \source => customRelation (source, "claimed_equality", "Eq", "="))

    customAddition () = customRelation (counterfeitAddition (), "claimed_left", "HAdd.hAdd", "+")

    customRelation (source, name, head, symbol) =
        imported = loaded (ask (), source)
        chosen = picked (imported, name)
        expect (AppCases::has (shown chosen, "Checked theorem"), true)
        expect (AppCases::has (Doc::text (selectedMath chosen, "spoken"), head), true)
        expect (AppCases::has (Doc::write (Doc::field (selectedMath chosen, "math")), "\"symbol\":\"${symbol}\""), false)

    arithmetic () =
        imported = loaded (ask (), Fixtures::natAddComm ())
        chosen = picked (imported, "Nat.add_comm")
        typeset = selectedMath chosen
        expect (Doc::write (Doc::field (typeset, "math")), Doc::write (Maths::encode (arithmeticTree ())))
        expect (AppCases::has (Doc::text (typeset, "spoken"), "HAdd.hAdd"), true)
        revealed = expanded chosen
        formal = Drive::findNamed ("proof-library-formal", pane revealed)
        expect (Doc::text (Drive::findNode ("text", formal), "text"), Doc::text (typeset, "spoken"))

    selectedMath envelope = Drive::findNode ("math", Drive::findNamed ("proof-library-result", pane envelope))

    arithmeticTree () = ui::Binder "∀" [ui::Paren (ui::Op ":" (ui::Sym "n") (ui::Sym "Nat"))] (ui::Binder "∀" [ui::Paren (ui::Op ":" (ui::Sym "m") (ui::Sym "Nat"))] (ui::Op "=" (ui::Op "+" (ui::Sym "n") (ui::Sym "m")) (ui::Op "+" (ui::Sym "m") (ui::Sym "n"))))

    export selection () =
        after = loaded (ask (), ImportedCases::withUnused ())
        chosen = picked (after, "id_imp")
        expect (AppCases::has (shown chosen, "Axioms: none"), true)
        missing = picked (after, "not_present")
        expect (AppCases::has (shown missing, "Import refused"), true)
        expect (AppCases::has (shown missing, "Checked theorem"), false)
        axiom = picked (after, "unusedAssumption")
        expect (AppCases::has (shown axiom, "not a theorem"), true)
        expect (AppCases::has (shown axiom, "Checked theorem"), false)
        expect (Doc::text (Drive::stored axiom, "text"), "")

    export currentSource () =
        after = expanded (loaded (ask (), Fixtures::idImp ()))
        broken = edited (after, Fixtures::idImpBad ())
        expect (Doc::text (current broken, "source"), Fixtures::idImpBad ())
        expect (AppCases::has (shown broken, "Import refused"), true)
        expect (AppCases::has (shown broken, "Checked theorem"), false)
        repaired = edited (broken, Fixtures::idImp ())
        expect (AppCases::has (shown repaired, "Checked theorem"), true)
        expect (Doc::text (current repaired, "selected"), "id_imp")
        empty = edited (repaired, "")
        expect (AppCases::has (shown empty, "Import refused"), true)
        expect (AppCases::has (shown empty, "Checked theorem"), false)

    export refusals () =
        pendingFile ()
        requested = ask ()
        cancelled = Drive::post (requested, Drive::done ("proof:opened", "{\"cancelled\":true}"))
        expect (Doc::text (current cancelled, "source"), "")
        malformed = loaded (requested, "not NDJSON")
        expect (AppCases::has (shown malformed, "Import refused"), true)
        expect (AppCases::has (shown malformed, "Checked theorem"), false)
        missing = Drive::post (requested, Drive::done ("proof:opened", "{}"))
        expect (Doc::flag (Drive::stored missing, "noticeBad"), true)
        failed = Drive::post (requested, Drive::failed ("proof:opened", "Permission denied"))
        expect (AppCases::has (Doc::text (Drive::stored failed, "notice"), "Permission denied"), true)

    pendingFile () =
        previous = loaded (ask (), Fixtures::idImp ())
        requested = Drive::activate (previous, previous, "library-actions", "Open proof library")
        expect (AppCases::has (shown requested, "Reading the selected proof library…"), true)
        expect (AppCases::has (shown requested, "Checked theorem"), false)
        cancelled = Drive::post (requested, Drive::done ("proof:opened", "{\"cancelled\":true}"))
        expect (AppCases::has (shown cancelled, "Checked theorem"), true)
        expect (Doc::text (current cancelled, "source"), Fixtures::idImp ())
        failed = Drive::post (requested, Drive::failed ("proof:opened", "Permission denied"))
        expect (AppCases::has (shown failed, "Checked theorem"), true)
        expect (Doc::text (current failed, "source"), Fixtures::idImp ())

    withUsed () = "${Fixtures::idImp ()}{\"in\":16,\"str\":{\"pre\":0,\"str\":\"trusted_assumption\"}}\n{\"axiom\":{\"levelParams\":[],\"name\":16,\"type\":4}}\n{\"ie\":7,\"const\":{\"name\":16,\"us\":[]}}\n{\"in\":17,\"str\":{\"pre\":0,\"str\":\"uses_assumption\"}}\n{\"thm\":{\"levelParams\":[],\"name\":17,\"type\":4,\"value\":7}}\n"

    export axioms () =
        after = loaded (ask (), withUsed ())
        clean = picked (after, "id_imp")
        expect (AppCases::has (shown clean, "Axioms: none"), true)
        assumed = picked (after, "uses_assumption")
        expect (AppCases::has (shown assumed, "Checked theorem"), true)
        expect (AppCases::has (shown assumed, "Axioms: trusted_assumption"), true)
        expect (Doc::text (current assumed, "selected"), "uses_assumption")

    export largeSource () = match repeat ("\n", 1048577)
        Error problem => expect (problem, "allocated fixture padding")
        Success padding =>
            source = Fixtures::idImp () + padding
            after = loaded (ask (), source)
            expect (Doc::flag (current after, "large"), true)
            expect (Doc::text (current after, "source"), "")
            expect (AppCases::has (shown after, "Checked theorem"), true)
            lost = picked (after, "id_imp")
            expect (AppCases::has (shown lost, "Checked theorem"), false)
            expect (AppCases::has (shown lost, "Import refused"), true)
            expect (AppCases::has (shown lost, "The imported source is unavailable. Open the proof export again."), true)

    bundled () =
        first = Drive::started ()
        requested = Drive::activate (first, first, "root", "Notation")
        expect (Drive::tickets requested, "proof:catalogue")
        manifest = "{\"libraries\":[{\"title\":\"Identity fixture\",\"path\":\"proof-libraries/identity.ndjson\"}]}"
        listed = readCompleted (requested, "proof:catalogue", "proof-libraries.json", manifest)
        expect (Doc::has (Drive::findLabel ("Identity fixture", actions listed), "event"), true)
        expect (AppCases::has (shown listed, "Checked theorem"), false)
        selected = Drive::activate (listed, listed, "library-actions", "Identity fixture")
        expect (Drive::tickets selected, "proof:bundled:2")
        checked = readCompleted (selected, "proof:bundled:2", "proof-libraries/identity.ndjson", Fixtures::idImp ())
        expect (AppCases::has (shown checked, "Checked theorem"), true)
        expect (AppCases::has (shown checked, "Axioms: none"), true)
        bundledLarge selected
        bundledRefused selected
        bundledRaces selected
        catalogueRefusals requested
        restoredCatalogue ()

    bundledLarge selected = match repeat (" ", 1048577)
        Error message => expect (message, "allocated large valid JSON fixture")
        Success padding => retainedBundled (selected, padding + Fixtures::idImp (), padding + Fixtures::idImpBad ())

    retainedBundled (selected, source, corrupted) =
        large = readCompleted (selected, "proof:bundled:2", "proof-libraries/identity.ndjson", source)
        held = Drive::hostSlices [large]
        expect (Doc::flag (current large, "large"), true)
        expect (Doc::text (current large, "selected"), "id_imp")
        expect (Doc::text (held, "proof:import"), source)
        expect (AppCases::has (shown large, "Checked theorem"), true)
        event = Drive::labelled (large, large, "library", "Theorem", Drive::quoted "id_imp")
        retained = Drive::postHeld (large, event, held)
        expect (AppCases::has (shown retained, "Checked theorem"), true)
        damaged = Drive::postHeld (large, event, JsonObject [Doc::str ("proof:import", corrupted)])
        expect (AppCases::has (shown damaged, "Checked theorem"), false)
        expect (AppCases::has (shown damaged, "type mismatch"), true)

    readCompleted (before, ticket, path, source) =
        file = JsonObject [Doc::str ("path", path), Doc::str ("error", ""), Doc::str ("text", source)]
        held = JsonObject [Doc::str (ticket, Doc::write (JsonObject [JsonMember "files" (JsonArray [file])]))]
        Drive::postHeld (before, Drive::done (ticket, "{}"), held)

    bundledRefused selected =
        invalid = readCompleted (selected, "proof:bundled:2", "proof-libraries/identity.ndjson", Fixtures::idImpBad ())
        expect (AppCases::has (shown invalid, "Import refused"), true)
        expect (AppCases::has (shown invalid, "Checked theorem"), false)
        missing = readCompleted (selected, "proof:bundled:2", "proof-libraries/identity.ndjson", "")
        expect (AppCases::has (shown missing, "Import refused"), true)
        expect (AppCases::has (shown missing, "Checked theorem"), false)

    bundledRaces selected =
        choice = Drive::findTitle ("Bundled proof libraries", actions selected)
        reopened = Drive::post (selected, Drive::control ("library-actions", Drive::revision (selected, "library-actions"), Doc::number (choice, "event"), "true"))
        newer = Drive::activate (reopened, reopened, "library-actions", "Identity fixture")
        expect (Drive::tickets newer, "proof:bundled:3")
        stale = readCompleted (newer, "proof:bundled:2", "proof-libraries/identity.ndjson", Fixtures::idImpBad ())
        expect (Drive::keys stale, "")
        checked = readCompleted (stale, "proof:bundled:3", "proof-libraries/identity.ndjson", Fixtures::idImp ())
        expect (AppCases::has (shown checked, "Checked theorem"), true)
        manual = loaded (Drive::activate (selected, selected, "library-actions", "Open proof library"), Fixtures::idImp ())
        late = readCompleted (manual, "proof:bundled:2", "proof-libraries/identity.ndjson", Fixtures::idImpBad ())
        expect (Drive::keys late, "")
        expect (AppCases::has (shown manual, "Checked theorem"), true)
        wrong = readCompleted (selected, "proof:bundled:2", "proof-libraries/wrong.ndjson", Fixtures::idImp ())
        expect (AppCases::has (shown wrong, "Import refused"), true)
        expect (AppCases::has (shown wrong, "Checked theorem"), false)
        failed = Drive::post (selected, Drive::failed ("proof:bundled:2", "file unavailable"))
        expect (AppCases::has (shown failed, "Import refused"), true)

    catalogueRefusals requested =
        sources = ["{", "{}", "{\"libraries\":[]}", "{\"libraries\":[{\"title\":\"Escape\",\"path\":\"proof-libraries/../secret.ndjson\"}]}"]
        forEachList (sources, \source =>
            refused = readCompleted (requested, "proof:catalogue", "proof-libraries.json", source)
            expect (AppCases::has (Drive::visibleText (actions refused), "Bundled libraries could not be loaded"), true)
            expect (AppCases::has (shown refused, "Checked theorem"), false))
        wrong = readCompleted (requested, "proof:catalogue", "wrong.json", "{}")
        expect (AppCases::has (Drive::visibleText (actions wrong), "different library catalogue"), true)
        absent = Drive::postHeld (requested, Drive::done ("proof:catalogue", "{}"), JsonObject [])
        expect (AppCases::has (Drive::visibleText (actions absent), "library read result is invalid"), true)

    restoredCatalogue () =
        path = "proof-libraries/../../secrets.ndjson"
        entry = JsonObject [Doc::str ("title", "Forged restored entry"), Doc::str ("path", path)]
        catalogue = Doc::write (JsonObject [JsonMember "libraries" (JsonArray [entry])])
        saved = JsonObject [JsonMember "imports" (JsonObject [Doc::str ("catalogue", catalogue)])]
        restored = Benches::restore saved
        asked = BundledLibraries::open (restored, path)
        expect (length asked.requests, 0)
        expect (isEmpty asked.stepStore.imports.exportProblem, false)

    // A custom Eq with a constructor for every pair; checked but not standard equality.
    // Implements [WORKBENCH-VERDICT].
