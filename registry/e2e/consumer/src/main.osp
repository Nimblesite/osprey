namespace consumer;
import demo_report::Report

/// A project that uses a package fetched from the folder registry, and,
/// through it, the two packages it depends on. registry/e2e writes this
/// project's osprey.toml with the fetched source roots and runs it.
fn line() = Report::line("Ada", 3)

/// Checked arithmetic in the fetched `Maths` needs a handler at the entry. An
/// overflow answers 0, so a fault prints a wrong line the e2e check rejects.
fn checked(body) = {
    let arithmetic = handler Arith {
        overflow _op _lhs _rhs _wrapped => 0
        remainderByZero _lhs => 0
    }
    arithmetic(body)
}

print(checked(line))
