      "value": "items/*",
      "typeField": "element",
      "order": true
    },
    {
      "files": "schema/accepts.json",
      "each": "cases/*",
      "value": "value",
      "typeField": "type",
      "order": true
    },
    {
      "files": "transitions/release-status.json",
      "each": "chains/*/steps/*",
      "value": "previous",
      "type": "ReleaseStatus",
      "order": true
    },
    {
      "files": "transitions/release-status.json",
      "each": "chains/*/steps/*",
      "value": "next",
