{
  "spec": "[PACKAGE-TYPE-INVARIANTS]",
  "description": "Which values inside which fixtures are model objects, and of which schemas/package-registry.td type. `files` is a path prefix under registry/tests/fixtures; `each` selects rows; `value` selects the typed value inside a row (`*` is every array item); the type is `type` or the row's `typeField`; `order` also checks every list's canonical order. `rawGoldens` are byte-exact canonical outputs that cannot carry a `spec` member.",
  "rawGoldens": [
    "manifests/ledger/canonical.json"
  ],
  "entries": [
    {
      "files": "canonical/",
      "each": "",
      "value": "value",
      "typeField": "type",
      "order": true
    },
    {
      "files": "manifests/ledger/canonical.json",
      "each": "",
      "value": "",
      "type": "PackageManifest",
      "order": true
    },
    {
      "files": "order/lists.json",
