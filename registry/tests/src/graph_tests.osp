namespace registry_tests;
import registry::Json
import registry::Canonical
import registry::Identity
import registry::Names
import registry::Resolve
import registry::Resolution
import registry_tests::GraphModel
import registry_tests::GraphOracle
import registry_tests::Fixtures

/// Every bounded dependency-graph fixture is solved by both the real CDCL
/// resolver and the exhaustive oracle, and each result is compared, byte for
/// byte, with the hand-written expected lock or explanation. A differential
/// assertion checks the resolver and the oracle agree on every fixture, and
/// the index is asserted to list exactly the checked-in fixtures. Implements
/// [PACKAGE-RESOLUTION].
module GraphTests {

    fn member(key, value) = Json::Member { key: key, value: value }
    fn str(text) = Json::Str { text: text }
    fn num(value) = Json::Num { value: value }
    fn obj(members) = Json::Obj { members: members }
    fn arr(items) = Json::Arr { items: items }

    fn keyJson(k: Names::Key) = obj([member("scope", str(k.scope)), member("name", str(k.name))])

    fn releaseJson(r: Identity::ReleaseId) = obj([
        member("package", keyJson(r.key)),
        member("epoch", num(r.epoch)),
        member("ordinal", num(r.ordinal)),
        member("digest", str(r.digest))
    ])

    fn lockJson(releases) = arr(mapList(releases, releaseJson))

    fn explainJson(code, packages) = obj([
        member("code", str(code)),
        member("packages", arr(mapList(packages, keyJson)))
    ])

    fn canonEq(a, b) = (Canonical::serialize(a) ?: "left-error") == (Canonical::serialize(b) ?: "right-error")

    fn outcomeJson(outcome) = match outcome {
        Resolution::Lock { releases } => lockJson(releases)
        Resolution::Explain { code, packages } => explainJson(code, packages)
    }

    /// A solver result equals the fixture expectation byte for byte.
    fn matchesFixture(name, solve) = {
        let fx = Fixtures::load("graphs/${name}.json")
        let graph = GraphModel::graphOf(fx)
        let expected = Fixtures::field(fx, "expect")
        let want = match Json::get(expected, "lock") {
            Success { value } => value
            Error => Fixtures::field(expected, "explanation")
        }
        canonEq(outcomeJson(solve(graph)), want)
    }

    fn oracleMatches(name) = matchesFixture(name, GraphOracle::solve)

    fn resolverMatches(name) = matchesFixture(name, Resolve::solve)

    /// The resolver and the oracle agree on one fixture.
    fn agree(name) = {
        let graph = GraphModel::graphOf(Fixtures::load("graphs/${name}.json"))
        canonEq(outcomeJson(Resolve::solve(graph)), outcomeJson(GraphOracle::solve(graph)))
    }

    fn agreeAll(names) = foldList(names, true, fn(ok, name) => ok && agree(name))

    fn expectedCases() = [
        "satisfiable",
        "unsatisfiable",
        "downgrade",
        "epoch",
        "target",
        "capability",
        "revocation",
        "revoked",
        "technical-lag",
        "cycle",
        "test-edge-not-activated",
        "minimum-ordinal-floor",
        "tie-break",
        "missing-package"
    ]

    fn indexCheck() = {
        let fx = Fixtures::load("graphs/index.json")
        let cases = mapList(Fixtures::items(Fixtures::field(fx, "cases")), Fixtures::text)
        checkAll("graphs: index lists exactly the checked-in fixtures", [
            structuralEquals(listSort(cases), listSort(expectedCases())),
            length(cases) == length(expectedCases())
        ])
    }

    /// Every graph case as one oracle test and one resolver test, plus the
    /// differential assertion and the index assertion.
    export fn run() = {
        forEachList(expectedCases(), fn(name) => test("graphs oracle: ${name}", fn() => expectTrue(oracleMatches(name))))
        forEachList(expectedCases(), fn(name) => test("graphs resolver: ${name}", fn() => expectTrue(resolverMatches(name))))
        test("graphs: resolver agrees with oracle", fn() => expectTrue(agreeAll(expectedCases())))
        test("graphs: index", indexCheck)
    }
}
