namespace registry_tests;
import registry::Canonical
import registry::Json
import registry::JsonRead
import registry::ManifestJson
import registry::ManifestModel
import registry::Maybe
import registry::Names
import registry_cli::Lockfile

/// The folder-lock document against the declarative fixtures: decode then
/// encode reproduces the exact canonical bytes, every rejection input names
/// its stable code, and the edge projection is byte-identical to
/// `ManifestJson`. Implements [PACKAGE-FOLDER-REGISTRY] and [PACKAGE-MANIFEST].
module LockfileTests {
    let fixtureRoot = "registry/tests/fixtures/lock"

    fn load(name) = match Json::parse(readFile("${fixtureRoot}/${name}.json") ?: "") {
        Success { value } => value
        Error { message } => Json::Str { text: "fixture ${name} unreadable: ${message}" }
    }

    fn textOf(value) = JsonRead::text(JsonRead::field(value, "text"))
    fn nameOf(value) = JsonRead::text(JsonRead::field(value, "name"))
    fn codeOf(value) = JsonRead::text(JsonRead::field(value, "code"))

    fn roundtrip() = {
        let text = textOf(load("roundtrip"))
        let decoded = Lockfile::decode(text)
        let reencoded = match decoded {
            Success { value } => Lockfile::encode(value)
            Error { message } => Error { message: message }
        }
        let decodedOk = match decoded {
            Success => true
            Error => false
        }
        let reencodedOk = match reencoded {
            Success { value } => value == text
            Error => false
        }
        checkAll("lockfile decode then encode reproduces the fixture bytes", [decodedOk, reencodedOk])
    }

    fn rejected(case) = {
        let expected = codeOf(case)
        let actual = Lockfile::decode(textOf(case))
        match actual {
            Error { message } => message == expected
            Success => false
        }
    }

    fn rejections() = {
        let cases = JsonRead::items(JsonRead::field(load("rejections"), "cases"))
        let bad = foldList(cases, [], fn(acc, case) => if rejected(case) { acc } else { listAppend(acc, nameOf(case)) })
        check("lockfile rejection codes: ${length(bad)} of ${length(cases)} failed", 0, length(bad))
    }

    fn manifestWith(edges) = ManifestModel::Manifest {
        projectName: "app",
        sourceRoots: ["src"],
        defaultNamespace: Maybe::none(),
        entry: Maybe::none(),
        flavor: Maybe::none(),
        allowWildcardImports: false,
        publication: Maybe::none(),
        testRoots: [],
        pythonSources: [],
        dependencies: edges,
        grants: [],
        systemRequirements: [],
        assets: []
    }

    fn dependenciesText(manifest) = match Json::get(ManifestJson::toJson(manifest), "dependencies") {
        Success { value } => Canonical::serialize(value) ?: ""
        Error => ""
    }

    fn edgeProjection() = {
        let requirement = ManifestModel::Requirement { package: Names::Key { scope: "finch", name: "http" }, epoch: 2, minimumOrdinal: 17 }
        let edge = ManifestModel::Runtime { requirement: requirement }
        checkAll("lockfile edge JSON is byte-identical to ManifestJson's projection", [
            Lockfile::dependenciesCanonical([edge]) == dependenciesText(manifestWith([edge]))
        ])
    }

    /// Every lockfile test.
    export fn run() = {
        test("lockfile: decode then encode is the fixture's exact bytes", roundtrip)
        test("lockfile: every rejection code", rejections)
        test("lockfile: edge JSON matches ManifestJson", edgeProjection)
    }
}
