namespace registry_tests;
import registry_host::Host
import registry_cli::Dispatch
import registry::Capabilities

/// The frontend against fixture hosts: no process, file or terminal is touched.
module DispatchTests {
    fn healthyProcess() = handler Host::Process {
        run command => match command {
            "printf ok" => Host::Run { status: 0, stdout: "ok", stderr: "" }
            "command -v osprey" => Host::Run { status: 0, stdout: "/usr/local/bin/osprey\n", stderr: "" }
            _ => Host::Run { status: 127, stdout: "", stderr: "not found" }
        }
    }

    fn healthyFiles() = handler Host::Files {
        read _path => Success { value: "osprey doctor probe" }
        write _path content => Success { value: byteLength(content) }
    }

    fn brokenProcess() = handler Host::Process {
        run _command => Host::Run { status: 1, stdout: "", stderr: "denied" }
    }

    fn brokenFiles() = handler Host::Files {
        read _path => Error { message: "readFile: denied" }
        write _path _content => Error { message: "writeFile: denied" }
    }

    fn healthyTree() = handler Host::Tree {
        walk _root => Error { message: "fixture: no walk" }
        ensure _dir => Success { value: 0 }
    }

    fn healthyWeb() = handler Host::Web {
        get _base _path => Error { message: "http.transport: fixture offline" }
    }

    fn doctor() = Dispatch::run(["doctor"])

    /// `Dispatch::run` may perform host effects on any argument, so every call
    /// runs under fixture handlers even when the command touches none.
    fn onHealthyHost(body) = healthyFiles()(fn() => healthyProcess()(fn() => healthyTree()(fn() => healthyWeb()(body))))

    fn line(report, i) = listGet(report.lines, i) ?: ""

    fn helpAndUnknown() = {
        let help = onHealthyHost(fn() => Dispatch::run([]))
        let explicit = onHealthyHost(fn() => Dispatch::run(["help"]))
        let unknown = onHealthyHost(fn() => Dispatch::run(["frobnicate"]))
        let planned = onHealthyHost(fn() => Dispatch::run(["add", "@finch/ledger"]))
        let release = onHealthyHost(fn() => Dispatch::run(["build", "--release"]))
        checkAll("help is the default, unknown commands are usage errors, specified ones say not implemented", [
            help.status == 0,
            line(help, 0) == "usage: osprey-pkg <command>",
            explicit.status == 0,
            length(explicit.lines) == length(help.lines),
            unknown.status == 2,
            line(unknown, 0) == "unknown command: frobnicate",
            line(unknown, 1) == "usage: osprey-pkg <command>",
            planned.status == 3,
            line(planned, 0) == "not implemented: add (plan 0020, Milestone A)",
            release.status == 2,
            line(release, 0) == "build.usage"
        ])
    }

    fn doctorHealthy() = {
        let report = onHealthyHost(doctor)
        checkAll("doctor reports a healthy host and every blocked capability", [
            report.status == 0,
            line(report, 0) == "process: ok",
            line(report, 1) == "files: ok",
            line(report, 2) == "compiler: /usr/local/bin/osprey",
            length(report.lines) == 3 + length(Capabilities::blocked()),
            startsWith(line(report, 3), "blocked: process.argv")
        ])
    }

    fn doctorBroken() = {
        let report = brokenFiles()(fn() => brokenProcess()(fn() => healthyTree()(fn() => healthyWeb()(doctor))))
        checkAll("doctor names each failing probe", [
            line(report, 0) == "process: failed (status 1)",
            line(report, 1) == "files: write failed: writeFile: denied",
            line(report, 2) == "compiler: missing (osprey is not on PATH)"
        ])
    }

    export fn run() = {
        test("dispatch: help and unknown commands", helpAndUnknown)
        test("dispatch: doctor on a healthy host", doctorHealthy)
        test("dispatch: doctor on a broken host", doctorBroken)
    }
}
