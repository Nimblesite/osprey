namespace registry_cli;
import registry_cli::Fetch
import registry_cli::Reports
import registry_cli::Doctor
import registry_cli::Install
import registry_cli::Verify
import registry_cli::Build
import registry_cli::Lock

/// Command routing for the Osprey package frontend. Implements the command
/// surface of [PACKAGE-API] one command at a time: a command the
/// specification lists but this build lacks says so with its own status,
/// which is different from a command the specification does not know.
module Dispatch {
    let notImplementedStatus = 3
    let planned = ["login", "package", "add", "remove", "update", "use", "tree", "why", "audit", "publish", "yank"]
    let usage = [
        "usage: osprey-pkg <command>",
        "commands: help, doctor, fetch, verify, build, lock",
        "specified, not yet implemented: login, package init, add, remove, update, use, tree, why, audit, publish, yank"
    ]

    fn unknown(command) = Reports::usage(listPrepend(usage, "unknown command: ${command}"))

    fn notImplemented(command) = Reports::Report {
        status: notImplementedStatus,
        lines: ["not implemented: ${command} (plan 0020, Milestone A)"]
    }

    fn other(command) = if listContains(planned, command) { notImplemented(command) } else { unknown(command) }

    /// The words after one argument, as its command's argument vector.
    fn rest(args) = range(1, length(args)) |> map(fn(i) => listGet(args, i) ?: "") |> toList

    /// A target-less `fetch` (no positional target word) installs the lock.
    fn fetchIsInstall(args) = isEmpty(args) || startsWith(listGet(args, 0) ?: "", "--")

    /// Route one argument vector to its command.
    export fn run(args) = match listGet(args, 0) ?: "help" {
        "help" => Reports::success(usage)
        "doctor" => Doctor::report()
        "fetch" => if fetchIsInstall(rest(args)) { Install::run(rest(args)) } else { Fetch::run(rest(args)) }
        "verify" => Verify::run(rest(args))
        "build" => Build::run(rest(args))
        "lock" => Lock::run(rest(args))
        command => other(command)
    }
}
