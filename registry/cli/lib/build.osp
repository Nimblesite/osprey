namespace registry_cli;
import registry_host::Host
import registry_cli::Reports
import registry_cli::Project
import registry_cli::Lockfile
import registry_cli::Fetch
import registry_cli::Verify
import registry::Identity
import registry::Manifest
import registry::ManifestModel
import registry::Maybe
import registry::Names

/// `osprey-pkg build [--run] [--compiler <path>] [--project <absolute dir>]`:
/// run the offline verify first (its failure is the build's failure), then
/// compile through the existing compiler with a derived project whose source
/// roots are the root's own roots plus every installed package's own
/// `source_roots`, in lock order, and whose `python_sources` are the root's
/// plus every package's. Only a dependency's `source_roots` and
/// `python_sources` enter the derived project; its `entry`, `[modules]` and
/// `[system]` never do ([PACKAGE-HARDENING] C6). Implements the build half of
/// [PACKAGE-FOLDER-REGISTRY].
module Build {
    let failStatus = 1
    let usageCode = "build.usage"
    let defaultCompiler = "./target/release/osprey"
    let defaultProject = "."
    let buildDir = ".osprey/build"
    let buildManifest = ".osprey/build/osprey.toml"

    type CommandLine = { run: bool, compiler: string, project: string }
    type PackageManifest = { release: Identity::ReleaseId, manifest: ManifestModel::Manifest }

    let usageText = ["usage: osprey-pkg build [--run] [--compiler <path>] [--project <absolute dir>]"]

    fn usageReport() = Reports::usage(listPrepend(usageText, usageCode))

    fn withRun(cmd) = CommandLine { run: true, compiler: cmd.compiler, project: cmd.project }
    fn withCompiler(cmd, path) = CommandLine { run: cmd.run, compiler: path, project: cmd.project }
    fn withProject(cmd, dir) = CommandLine { run: cmd.run, compiler: cmd.compiler, project: dir }

    fn parseArgs(args, i, cmd) -> Result<CommandLine, string> = match i >= length(args) {
        true => Success { value: cmd }
        false => match listGet(args, i) ?: "" {
            "--run" => parseArgs(args, i + 1, withRun(cmd))
            "--compiler" => if i + 1 >= length(args) { Error { message: usageCode } } else { parseArgs(args, i + 2, withCompiler(cmd, listGet(args, i + 1) ?: "")) }
            "--project" => if i + 1 >= length(args) { Error { message: usageCode } } else { parseArgs(args, i + 2, withProject(cmd, listGet(args, i + 1) ?: "")) }
            _ => Error { message: usageCode }
        }
    }

    fn escaped(text) = replace(text, "\\", "\\\\") ?: text

    /// A TOML basic string: backslashes and quotes escaped, so no manifest
    /// value can break out of the derived document ([PACKAGE-HARDENING] C6).
    fn quote(text) = "\"" + (replace(escaped(text), "\"", "\\\"") ?: escaped(text)) + "\""

    /// Roots resolve against `--project`, which the caller passes as an
    /// absolute directory so the derived manifest's roots stay absolute.
    fn rootPath(project, root) = "${project}/${root}"

    fn missingPackage() = Lockfile::Package {
        release: Identity::ReleaseId { key: Names::Key { scope: "", name: "" }, epoch: 0, ordinal: 0, digest: "" },
        dependencies: []
    }

    /// A package's manifest, or `build.manifest @scope/name <code at line:column>`.
    fn packageManifestAt(project, p) = match perform Host::Files.read("${Fetch::installDirAt(project, p.release)}/osprey.toml") {
        Error { message } => Error { message: "build.manifest ${Names::display(p.release.key)} ${message}" }
        Success { value } => acceptedPackageManifest(p, value)
    }

    fn acceptedPackageManifest(p, text) = match Manifest::accepted(Manifest::parse(text)) {
        Error { message } => Error { message: "build.manifest ${Names::display(p.release.key)} ${message}" }
        Success { value } => Success { value: PackageManifest { release: p.release, manifest: value } }
    }

    fn packageManifestsAt(project, packages, i, acc) -> Result<List<PackageManifest>, string> = match i >= length(packages) {
        true => Success { value: acc }
        false => match packageManifestAt(project, listGet(packages, i) ?: missingPackage()) {
            Error { message } => Error { message: message }
            Success { value } => packageManifestsAt(project, packages, i + 1, listAppend(acc, value))
        }
    }

    fn packageManifests(project, lock) = packageManifestsAt(project, lock.packages, 0, [])

    fn packageRootsOf(project, pm) = mapList(pm.manifest.sourceRoots, fn(r) => "${Fetch::installDirAt(project, pm.release)}/${r}")

    fn packageRoots(project, pms) = foldList(pms, [], fn(acc, pm) => listConcat(acc, packageRootsOf(project, pm)))

    fn derivedRoots(manifest, project, pms) = listConcat(mapList(manifest.sourceRoots, fn(r) => rootPath(project, r)), packageRoots(project, pms))

    fn packagePythonSources(project, pms) = foldList(pms, [], fn(acc, pm) =>
        listConcat(acc, mapList(pm.manifest.pythonSources, fn(p) => "${Fetch::installDirAt(project, pm.release)}/${p}")))

    fn pythonSources(manifest, project, pms) = listConcat(mapList(manifest.pythonSources, fn(p) => rootPath(project, p)), packagePythonSources(project, pms))

    fn rootsLine(roots) = "source_roots = [${join(mapList(roots, quote), ", ")}]"

    fn pythonLine(sources) = "python_sources = [${join(mapList(sources, quote), ", ")}]"

    fn namespaceLine(manifest) = Maybe::fold(manifest.defaultNamespace, [], fn(ns) => ["default_namespace = ${quote(ns)}"])

    fn entryLine(manifest, project) = Maybe::fold(manifest.entry, [], fn(e) => ["entry = ${quote(rootPath(project, e))}"])

    fn flavorText(flavor) = toLowerCase(ManifestModel::flavorName(flavor))

    fn flavorLine(manifest) = Maybe::fold(manifest.flavor, [], fn(f) => ["flavor = ${quote(flavorText(f))}"])

    fn boolText(flag) = if flag { "true" } else { "false" }

    fn projectLines(manifest, project, pms) = {
        let header = ["[project]", "name = ${quote(manifest.projectName)}", rootsLine(derivedRoots(manifest, project, pms)), pythonLine(pythonSources(manifest, project, pms))]
        let options = listConcat(namespaceLine(manifest), listConcat(entryLine(manifest, project), flavorLine(manifest)))
        let modules = ["[modules]", "allow_wildcard_imports = ${boolText(manifest.allowWildcardImports)}"]
        listConcat(listConcat(header, options), modules)
    }

    fn derivedText(manifest, project, pms) = join(projectLines(manifest, project, pms), "\n")

    fn writeDerived(cmd, manifest, pms) = match perform Host::Tree.ensure(buildDir) {
        Error { message } => Error { message: message }
        Success => match perform Host::Files.write(buildManifest, derivedText(manifest, cmd.project, pms)) {
            Error { message } => Error { message: message }
            Success => Success { value: 0 }
        }
    }

    /// The compiler invocation, every variable word shell-quoted ([PACKAGE-HARDENING] C6).
    fn command(cmd, manifest) = if cmd.run {
        "${Host::shellWord(cmd.compiler)} ${buildDir} --run"
    } else {
        "${Host::shellWord(cmd.compiler)} build ${buildDir} -o ${Host::shellWord(buildDir + "/" + manifest.projectName)}"
    }

    fn stdoutLines(stdout) = filterList(split(stdout, "\n") ?: [], fn(l) => l != "")

    fn runCompiler(cmd, manifest) = {
        let run = perform Host::Process.run(command(cmd, manifest))
        Reports::Report { status: run.status, lines: stdoutLines(run.stdout) }
    }

    fn compile(cmd) = match Project::readLockAt(cmd.project) {
        Error { message } => Reports::Report { status: failStatus, lines: [message] }
        Success { value } => compileWithLock(cmd, value)
    }

    fn compileWithLock(cmd, lock) = match Project::readAt(cmd.project) {
        Error { message } => Reports::Report { status: failStatus, lines: [message] }
        Success { value } => compileWithManifest(cmd, lock, value)
    }

    fn compileWithManifest(cmd, lock, manifest) = match packageManifests(cmd.project, lock) {
        Error { message } => Reports::Report { status: failStatus, lines: [message] }
        Success { value } => compileWithPackages(cmd, manifest, value)
    }

    fn compileWithPackages(cmd, manifest, pms) = match writeDerived(cmd, manifest, pms) {
        Error { message } => Reports::Report { status: failStatus, lines: [message] }
        Success => runCompiler(cmd, manifest)
    }

    fn build(cmd) = {
        let verified = Verify::verifyOfflineAt(cmd.project)
        if verified.status == 0 { compile(cmd) } else { verified }
    }

    /// The whole command: verify, then compile; `--run` runs the built program.
    export fn run(args) = match parseArgs(args, 0, CommandLine { run: false, compiler: defaultCompiler, project: defaultProject }) {
        Error => usageReport()
        Success { value } => build(value)
    }
}
