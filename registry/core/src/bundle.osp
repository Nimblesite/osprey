namespace registry;
import registry::Canonical
import registry::Identity
import registry::Json
import registry::Names
import registry::Release
import registry::ReleaseFiles
import registry::ReleasePath

/// The source bundle: one RFC 8785 canonical JSON document carrying a
/// release's key, epoch, ordinal, digest and every file as UTF-8 text. Decode
/// is strict; verify recomputes the `SourceDigest` from the files so an
/// untrusted mirror can serve the bytes without being believed.
/// Implements [PACKAGE-FOLDER-REGISTRY].
module Bundle {
    let shapeError = "bundle.shape"
    let tooLarge = "bundle.too-large"
    let maxBytes = 134217728

    fn fileValue(file) = Json::Obj { members: [
        Json::Member { key: "path", value: Json::Str { text: file.relPath } },
        Json::Member { key: "text", value: Json::Str { text: file.content } }
    ] }

    fn filesValue(files) = Json::Arr { items: mapList(files, fileValue) }

    // `Release::Served` is spelled out for issue #273: its `id` fields
    // (`key`, `digest`, ...) are shared with other records.
    fn encodeValue(served: Release::Served) = Json::Obj { members: [
        Json::Member { key: "digest", value: Json::Str { text: served.id.digest } },
        Json::Member { key: "epoch", value: Json::Num { value: served.id.epoch } },
        Json::Member { key: "files", value: filesValue(served.files) },
        Json::Member { key: "key", value: Json::Str { text: Names::display(served.id.key) } },
        Json::Member { key: "ordinal", value: Json::Num { value: served.id.ordinal } }
    ] }

    /// The canonical JSON text of a served release.
    export fn encode(served) = Canonical::serialize(encodeValue(served))

    fn shaped(result) = match result {
        Success { value } => Success { value: value }
        Error => Error { message: shapeError }
    }

    fn stringField(root, field) = shaped(Json::textAt(root, field))

    fn intField(root, field) = shaped(Json::intAt(root, field))

    fn fileOf(root) = match stringField(root, "path") {
        Error { message } => Error { message: message }
        Success { value } => withText(root, value)
    }

    fn withText(root, path) = match stringField(root, "text") {
        Error { message } => Error { message: message }
        Success { value } => Success { value: Release::File { relPath: path, content: value } }
    }

    // A recursive accumulator avoids `foldList` over a `Result<List<…>>`,
    // which crashes the runtime under the current codegen.
    fn filesAt(items, i, acc) -> Result<List<Release::File>, string> = match i >= length(items) {
        true => Success { value: acc }
        false => match fileOf(listGet(items, i) ?: Json::Null) {
            Error { message } => Error { message: message }
            Success { value } => filesAt(items, i + 1, listAppend(acc, value))
        }
    }

    fn filesOf(items) = {
        let empty: List<Release::File> = []
        filesAt(items, 0, empty)
    }

    fn filesField(root) = match Json::itemsAt(root, "files") {
        Success { value } => filesOf(value)
        Error => Error { message: shapeError }
    }

    fn ofValue(root) = match stringField(root, "digest") {
        Error { message } => Error { message: message }
        Success { value } => withEpoch(root, value)
    }

    fn withEpoch(root, digest) = match intField(root, "epoch") {
        Error { message } => Error { message: message }
        Success { value } => withFiles(root, digest, value)
    }

    fn withFiles(root, digest, epoch) = match filesField(root) {
        Error { message } => Error { message: message }
        Success { value } => withKey(root, digest, epoch, value)
    }

    fn withKey(root, digest, epoch, files) = match stringField(root, "key") {
        Error { message } => Error { message: message }
        Success { value } => withOrdinal(root, digest, epoch, files, value)
    }

    fn withOrdinal(root, digest, epoch, files, keyText) = match intField(root, "ordinal") {
        Error { message } => Error { message: message }
        Success { value } => makeServed(digest, epoch, files, keyText, value)
    }

    fn makeServed(digest, epoch, files, keyText, ordinal) = match Names::parse(keyText) {
        Error => Error { message: shapeError }
        Success { value } => Success { value: Release::Served {
            id: Identity::ReleaseId { key: value, epoch: epoch, ordinal: ordinal, digest: digest },
            files: files
        } }
    }

    /// Strictly parse a bundle; parse problems render through `Json::describe`,
    /// and any missing or mistyped field is `"bundle.shape"`.
    export fn decode(text) = match Json::parse(text) {
        Error { message } => Error { message: Json::describe(message) }
        Success { value } => ofValue(value)
    }

    fn checkClaim(served, expectedDigest) = match ReleaseFiles::assemble(ReleasePath::format(served.id), served.files) {
        Error { message } => Error { message: message }
        Success { value } => compare(served, value.id.digest, expectedDigest)
    }

    fn compare(served: Release::Served, recomputed, expectedDigest) = match recomputed == served.id.digest {
        false => Error { message: "bundle.digest-mismatch" }
        true => match served.id.digest == expectedDigest {
            false => Error { message: "bundle.unexpected-digest" }
            true => Success { value: served }
        }
    }

    /// Why a body of `byteCount` bytes is refused before it is parsed: no
    /// valid release exceeds 128 MiB of bundle text (C1 of
    /// [PACKAGE-HARDENING]); `""` within the bound.
    export fn sizeCode(byteCount) = if byteCount > maxBytes { tooLarge } else { "" }

    fn verifyParsed(text, expectedDigest) = match decode(text) {
        Error { message } => Error { message: message }
        Success { value } => checkClaim(value, expectedDigest)
    }

    /// Bound the body, decode, recompute the digest from the files and return
    /// the release only when the recomputed digest equals both the bundle's
    /// claim and the digest the client requested.
    export fn verify(text, expectedDigest) = match sizeCode(byteLength(text)) == "" {
        false => Error { message: tooLarge }
        true => verifyParsed(text, expectedDigest)
    }
}
