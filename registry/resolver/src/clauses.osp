namespace registry;
import registry::Names
import registry::SatClauses
import registry::ManifestModel
import registry::Candidates
import registry::Resolution

/// The hard clauses of [PACKAGE-RESOLUTION] over one Boolean variable per
/// candidate. Candidates are variables 1..n in catalog order; key-level
/// reachability variables follow for the acyclicity encoding. The clauses
/// carry no origin tags yet, so a refutation is explained by `Explain` from
/// the graph rather than from an UNSAT core (plan 0020 Phase 3, open).
module Clauses {
    /// The hard formula: candidates as variables 1..n in catalog order, the
    /// sorted distinct package keys, the clauses, and the variable count
    /// including the key-level reachability grid.
    export type Problem = {
        entries: List<Resolution::Entry>,
        keys: List<Names::Key>,
        clauses: List<List<int>>,
        vars: int
    }

    // Field accessors for records whose field names are shared across types
    // (issue #273): the receivers are spelled out.
    fn entryAt(xs, i) -> Resolution::Entry = listGet(xs, i) ?: Resolution::blankEntry()
    fn keyAt(xs, i) -> Names::Key = listGet(xs, i) ?: Names::blank()

    fn reqOf(edge) = ManifestModel::requirementOf(edge)
    fn reqKeyOf(edge) = ManifestModel::requirementOf(edge).package

    fn indexes(xs) = range(0, length(xs)) |> toList

    /// Distinct keys of the root deps, catalog releases and their deps,
    /// sorted by canonical key order.
    fn collectKeys(graph) = {
        let roots = ManifestModel::targets(graph.rootDeps)
        let catalogKeys = mapList(graph.catalog, fn(e) => e.release.key)
        let depKeys = foldList(graph.catalog, [], fn(acc, e) => listConcat(acc, ManifestModel::targets(e.dependencies)))
        Names::sorted(Names::distinct(listConcat(listConcat(roots, catalogKeys), depKeys)))
    }

    fn keyIndexOf(keys, k) = foldList(indexes(keys), -1, fn(acc, i) => if acc >= 0 { acc } else if Names::same(keyAt(keys, i), k) { i } else { acc })

    fn matches(entry, req) = Names::same(entry.release.key, req.package) && entry.release.epoch == req.epoch && entry.release.ordinal >= req.minimumOrdinal

    /// Candidate variables whose release satisfies `req`.
    fn matchingVars(entries, req) = foldList(indexes(entries), [], fn(acc, i) => if matches(entryAt(entries, i), req) { listAppend(acc, i + 1) } else { acc })

    /// Root edge clauses: OR of matching candidates per root edge.
    fn rootClauses(graph, entries) = mapList(graph.rootDeps, fn(e) => matchingVars(entries, reqOf(e)))

    /// Candidate edge clauses: -x OR (matching candidates) per Runtime/Build
    /// edge; non-root Test edges are never activated.
    fn edgeClauses(entries) = foldList(indexes(entries), [], fn(acc, i) => {
        let deps = ManifestModel::activeEdges(entryAt(entries, i).dependencies)
        listConcat(acc, mapList(deps, fn(d) => listPrepend(matchingVars(entries, reqOf(d)), SatClauses::neg(i + 1))))
    })

    /// One release per package key across all epochs: pairwise at-most-one.
    fn uniquenessClauses(entries) = foldList(indexes(entries), [], fn(acc, i) =>
        foldList(range(i + 1, length(entries)) |> toList, acc, fn(acc2, j) =>
            if Names::same(entryAt(entries, i).release.key, entryAt(entries, j).release.key) {
                listAppend(acc2, [SatClauses::neg(i + 1), SatClauses::neg(j + 1)])
            } else { acc2 }))

    fn requires(entry, key) = Names::includes(ManifestModel::activeTargets(entry.dependencies), key)

    /// Candidates of a key that carry a Runtime/Build edge to it; a selected
    /// release must be supported by a root edge or one of these.
    fn supportersOf(entries, key) = foldList(indexes(entries), [], fn(acc, i) =>
        if requires(entryAt(entries, i), key) { listAppend(acc, i + 1) } else { acc })

    fn rootSupports(graph, key) = Names::includes(ManifestModel::targets(graph.rootDeps), key)

    /// Anti-spurious closure clauses: a candidate with no root edge and no
    /// selected supporter may not be selected.
    fn supportClauses(graph, entries) = foldList(indexes(entries), [], fn(acc, i) => {
        let key = entryAt(entries, i).release.key
        if rootSupports(graph, key) { acc } else { listAppend(acc, listPrepend(supportersOf(entries, key), SatClauses::neg(i + 1))) }
    })

    fn reachVar(n, k, u, v) = n + u * k + v + 1

    /// Edge clauses of the reachability grid: a selected candidate reaches
    /// every key its active edges require.
    fn reachEdges(entries, keys) = {
        let n = length(entries)
        let k = length(keys)
        foldList(indexes(entries), [], fn(acc, i) => {
            let u = keyIndexOf(keys, entryAt(entries, i).release.key)
            let deps = ManifestModel::activeEdges(entryAt(entries, i).dependencies)
            listConcat(acc, mapList(deps, fn(d) => [SatClauses::neg(i + 1), reachVar(n, k, u, keyIndexOf(keys, reqKeyOf(d)))]))
        })
    }

    /// Transitivity clauses of the reachability grid.
    fn reachTransitive(n, k) = foldList(range(0, k) |> toList, [], fn(acc, a) =>
        foldList(range(0, k) |> toList, acc, fn(acc2, b) =>
            foldList(range(0, k) |> toList, acc2, fn(acc3, c) =>
                if a == b || b == c { acc3 } else { listAppend(acc3, [SatClauses::neg(reachVar(n, k, a, b)), SatClauses::neg(reachVar(n, k, b, c)), reachVar(n, k, a, c)]) })))

    /// Acyclicity: key-level reachability variables with edge, transitivity
    /// and irreflexivity clauses.
    fn acyclicClauses(entries, keys) = {
        let n = length(entries)
        let k = length(keys)
        let irrefl = mapList(range(0, k) |> toList, fn(a) => [SatClauses::neg(reachVar(n, k, a, a))])
        listConcat(listConcat(reachEdges(entries, keys), reachTransitive(n, k)), irrefl)
    }

    /// Build the hard formula for one graph.
    export fn build(graph) = {
        let entries = Candidates::all(graph)
        let keys = collectKeys(graph)
        let clauses = listConcat(listConcat(rootClauses(graph, entries), edgeClauses(entries)),
            listConcat(listConcat(uniquenessClauses(entries), supportClauses(graph, entries)), acyclicClauses(entries, keys)))
        Problem { entries: entries, keys: keys, clauses: clauses, vars: length(entries) + length(keys) * length(keys) }
    }
}
