namespace registry_tests;
import registry::Manifest
import registry::ManifestModel
import registry::ManifestJson
import registry::ManifestDeps
import registry::Names
import registry::Maybe

/// [PACKAGE-MANIFEST]: the spec example is accepted and projected to the
/// fixture's canonical JSON and digest; every forbidden input fails before
/// hashing with one located reason code.
module ManifestTests {
    let ledger = "registry/tests/fixtures/manifests/ledger/osprey.toml"
    let canonicalFixture = "registry/tests/fixtures/manifests/ledger/canonical.json"
    let digestFixture = "sha256:351b1baf6c7a8f1fd411226b83d3f5e22abc546c5bd7bda26e7beabac6375eb7"

    fn verdict(text) = match Manifest::accepted(Manifest::parse(text)) {
        Success => "accepted"
        Error { message } => message
    }

    fn manifestOf(text) = Manifest::accepted(Manifest::parse(text))

    fn project(body) = "[project]\nname = \"app\"\n${body}"
    fn package(body) = "[project]\nname = \"ledger\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\"]\n${body}"

    fn edgeText(e) = {
        let r = ManifestModel::requirementOf(e)
        "${ManifestModel::edgeRank(e)}:${Names::display(r.package)}@e${r.epoch}.r${r.minimumOrdinal}"
    }

    fn edges(text) = match manifestOf(text) {
        Success { value } => join(mapList(value.dependencies, edgeText), " ")
        Error { message } => message
    }

    fn publicationKey(m: ManifestModel::Manifest) = Maybe::fold(m.publication, "none", fn(p: ManifestModel::Publication) => Names::display(p.package))

    fn acceptsLedger() = {
        let text = readFile(ledger) ?: ""
        let parsed = manifestOf(text)
        let canonical = match parsed {
            Success { value } => ManifestJson::canonical(value) ?: "serialize failed"
            Error { message } => message
        }
        let digest = match parsed {
            Success { value } => ManifestJson::digest(value) ?: "digest failed"
            Error { message } => message
        }
        checkAll("the spec 0029 manifest is accepted and hashes like the fixture", [
            verdict(text) == "accepted",
            canonical == (readFile(canonicalFixture) ?: ""),
            digest == digestFixture,
            edges(text) == "0:@osprey/http@e2.r17",
            match parsed {
                Success { value } => publicationKey(value) == "@finch/ledger" && join(value.sourceRoots, ",") == "src" && value.projectName == "ledger" && length(value.systemRequirements) == 1
                Error => false
            }
        ])
    }

    fn acceptsApplications() = checkAll("application roots, defaults and the three dependency tables", [
        verdict("[project]\nname = \"app\"\n") == "accepted",
        match manifestOf("[project]\nname = \"app\"\n") {
            Success { value } => join(value.sourceRoots, ",") == "src" && !value.allowWildcardImports && !Maybe::isPresent(value.publication) && length(value.testRoots) == 0
            Error => false
        },
        verdict(project("source_roots = [\"src\", \"lib\"]\nentry = \"src/main.osp\"\nflavor = \"ml\"\ndefault_namespace = \"app\"\ntest_roots = [\"test\"]\npython_sources = [\"src/model.py\"]\n[modules]\nallow_wildcard_imports = true\npublished_library = true\n")) == "accepted",
        edges(project("[dependencies]\n\"@b/b\" = { epoch = 1 }\n\"@a/a\" = { epoch = 2, min_release = 3 }\n[test-dependencies]\n\"@a/a\" = { epoch = 2, min_release = 9 }\n[build-dependencies]\n\"@c/c\" = { epoch = 1, min_release = 0 }\n")) == "0:@a/a@e2.r3 0:@b/b@e1.r0 1:@c/c@e1.r0 2:@a/a@e2.r9",
        match manifestOf(project("[system.sqlite]\ncapability = \"sqlite/c-api\"\nmin_revision = 3045000\n[system.zlib]\ncapability = \"zlib\"\nmin_revision = 0\n")) {
            Success { value } => join(mapList(value.systemRequirements, fn(r) => "${r.capability}:${r.minimumRevision}"), " ") == "sqlite/c-api:3045000 zlib:0"
            Error => false
        },
        match manifestOf(project("[[assets]]\npath = \"docs/intro.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 12\ndigest = \"sha256:7c4a8d09ca3762af61e59520943dc26494f8941b7c4a8d09ca3762af61e59520\"\n[[assets]]\npath = \"data/seed.json\"\nrole = \"runtime-data\"\nkind = \"json\"\nbyte_length = 0\ndigest = \"sha256:7c4a8d09ca3762af61e59520943dc26494f8941b7c4a8d09ca3762af61e59520\"\nrequired_capability = \"asset.read\"\n")) {
            Success { value } => join(mapList(value.assets, fn(a: ManifestModel::Asset) => a.path), " ") == "data/seed.json docs/intro.md"
            Error => false
        },
        verdict(project("source_roots = [\"src\"]\npython_sources = [\"src/model.py\"]\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\"]\n")) == "accepted",
        match manifestOf(project("python_sources = [\"src/model.py\"]\n")) {
            Success { value } => match indexOf(ManifestJson::canonical(value) ?: "", "\"pythonSources\":[\"src/model.py\"]") {
                Success => true
                Error => false
            }
            Error => false
        }
    ])

    fn rejectsStructure() = checkAll("structure: tables, keys, project fields", [
        verdict("") == "manifest.project.missing at 1:1",
        verdict("[projekt]\nname = \"x\"\n") == "manifest.unknown-table at 1:1",
        verdict("[project]\nname = \"x\"\n[wasm]\nx = 1\n") == "manifest.unknown-table at 3:1",
        verdict("[project]\nname = \"x\"\nversion = \"1.0\"\n") == "manifest.project.unknown-key at 3:1",
        verdict("[project]\nname = 7\n") == "manifest.project.name at 2:1",
        verdict("[project]\nname = \"\"\n") == "manifest.project.name at 2:1",
        verdict("[project]\nsource_roots = [\"src\"]\n") == "manifest.project.name at 1:1",
        verdict(project("source_roots = [\"../up\"]\n")) == "manifest.project.source-roots at 3:1",
        verdict(project("source_roots = [\"src\", \"src\"]\n")) == "manifest.project.source-roots at 3:1",
        verdict(project("source_roots = \"src\"\n")) == "manifest.project.source-roots at 3:1",
        verdict(project("entry = \"/abs/main.osp\"\n")) == "manifest.project.entry at 3:1",
        verdict(project("flavor = \"python\"\n")) == "manifest.project.flavor at 3:1",
        verdict(project("test_roots = [\"test\", \"TEST\"]\n")) == "manifest.project.test-roots at 3:1",
        verdict(project("[modules]\nallow_wildcard_imports = \"yes\"\n")) == "manifest.modules.allow-wildcard-imports at 4:1",
        verdict(project("[modules]\nstrict = true\n")) == "manifest.modules.unknown-key at 4:1",
        verdict(project("source_roots = [\"src\"]\npython_sources = [\"lib/model.py\"]\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\"]\n")) == "manifest.python-source-unrooted at 1:1",
        verdict(project("python_sources = [\"py\"]\n")) == "manifest.project.python-sources at 3:1",
        verdict(project("python_sources = \"src/model.py\"\n")) == "manifest.project.python-sources at 3:1"
    ])

    fn rejectsPackage() = checkAll("[package]: names, licenses, summaries, keywords", [
        verdict("[project]\nname = \"x\"\n[package]\nname = \"ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = []\n") == "name.missing-at at 4:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@Finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = []\n") == "name.scope.chars at 4:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nsummary = \"s\"\nkeywords = []\n") == "manifest.license at 3:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT AND\"\nsummary = \"s\"\nkeywords = []\n") == "manifest.license at 5:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"(MIT OR Apache-2.0\"\nsummary = \"s\"\nkeywords = []\n") == "manifest.license at 5:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nkeywords = []\n") == "manifest.summary.missing at 3:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"${repeat("s", 513) ?: ""}\"\nkeywords = []\n") == "manifest.summary.length at 6:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"tab\\there\"\nkeywords = []\n") == "manifest.summary.text at 6:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\n") == "manifest.keywords.missing at 3:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"b\", \"a\"]\n") == "manifest.keywords.order at 7:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\", \"a\"]\n") == "manifest.keywords.order at 7:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"Ledger\"]\n") == "manifest.keyword.grammar at 7:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"-a\"]\n") == "manifest.keyword.grammar at 7:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\", \"i\", \"j\", \"k\", \"l\", \"m\"]\n") == "manifest.keywords.count at 7:1",
        verdict("[project]\nname = \"x\"\n[package]\nname = \"@finch/ledger\"\nlicense = \"MIT\"\nsummary = \"s\"\nkeywords = [\"a\"]\nhomepage = \"x\"\n") == "manifest.package.unknown-key at 8:1"
    ])

    fn rejectsDependencies() = checkAll("dependencies: SemVer, paths, forges, peers, options, epochs", [
        verdict(project("[dependencies]\n\"@osprey/http\" = \"^2.0\"\n")) == "manifest.dependency.version at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { version = \"2.0\" }\n")) == "manifest.dependency.version at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, max_release = 9 }\n")) == "manifest.dependency.version at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { path = \"../http\" }\n")) == "manifest.dependency.path at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { git = \"https://x\" }\n")) == "manifest.dependency.forge at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, tag = \"v2\" }\n")) == "manifest.dependency.forge at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, peer = true }\n")) == "manifest.dependency.peer at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, optional = true }\n")) == "manifest.dependency.optional at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, features = [\"tls\"] }\n")) == "manifest.dependency.optional at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, color = \"blue\" }\n")) == "manifest.dependency.unknown-key at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { min_release = 1 }\n")) == "manifest.dependency.epoch at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 0 }\n")) == "manifest.dependency.epoch at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2, min_release = -1 }\n")) == "manifest.dependency.min-release at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = 2\n")) == "manifest.dependency.shape at 4:1",
        verdict(project("[dependencies]\nhttp = { epoch = 2 }\n")) == "name.missing-at at 4:1",
        verdict(project("[dependencies]\n\"@osprey/http\" = { epoch = 2 }\n[test-dependencies]\n\"@osprey/http\" = { epoch = 3 }\n")) == "manifest.dependency.epoch-conflict at 3:1"
    ])

    fn rejectsSystemsAndAssets() = checkAll("system capabilities and asset declarations", [
        verdict(project("[system.sqlite]\ncapability = \"SQLite/C-API\"\nmin_revision = 1\n")) == "manifest.system.capability at 3:1",
        verdict(project("[system.sqlite]\ncapability = \"sqlite//c\"\nmin_revision = 1\n")) == "manifest.system.capability at 3:1",
        verdict(project("[system.sqlite]\ncapability = \"sqlite/c-api\"\n")) == "manifest.system.min-revision at 3:1",
        verdict(project("[system.sqlite]\ncapability = \"sqlite/c-api\"\nmin_revision = -1\n")) == "manifest.system.min-revision at 5:1",
        verdict(project("[system.sqlite]\ncapability = \"sqlite/c-api\"\nmin_revision = 1\nprovider = \"brew\"\n")) == "manifest.system.unknown-key at 6:1",
        verdict(project("[system.a]\ncapability = \"sqlite/c-api\"\nmin_revision = 1\n[system.b]\ncapability = \"sqlite/c-api\"\nmin_revision = 2\n")) == "manifest.system.duplicate at 3:1",
        ManifestDeps::capabilityOk("sqlite/c-api") && ManifestDeps::capabilityOk("zlib") && !ManifestDeps::capabilityOk("") && !ManifestDeps::capabilityOk("/x") && !ManifestDeps::capabilityOk("a/.b") && !ManifestDeps::capabilityOk("${repeat("a", 65) ?: ""}"),
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\nmime = \"text/markdown\"\n")) == "manifest.asset.unknown-key at 9:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"html\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.kind at 6:1",
        verdict(project("[[assets]]\npath = \"x.html\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.extension at 4:1",
        verdict(project("[[assets]]\npath = \"../x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.path at 4:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = -1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.byte-length at 7:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"md5:${repeat("a", 64) ?: ""}\"\n")) == "digest.algorithm at 8:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"attachment\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.role at 5:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\nrequired_capability = \"asset.read\"\n")) == "manifest.asset.capability at 5:1",
        verdict(project("[[assets]]\npath = \"x.json\"\nrole = \"runtime-data\"\nkind = \"json\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "manifest.asset.capability at 5:1",
        verdict(project("[[assets]]\npath = \"x.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n[[assets]]\npath = \"X.md\"\nrole = \"documentation\"\nkind = \"text\"\nbyte_length = 1\ndigest = \"sha256:${repeat("a", 64) ?: ""}\"\n")) == "path.case-collision at 3:1"
    ])

    export fn run() = {
        test("manifest: accepts the spec example", acceptsLedger)
        test("manifest: accepts application roots", acceptsApplications)
        test("manifest: rejects structure", rejectsStructure)
        test("manifest: rejects package metadata", rejectsPackage)
        test("manifest: rejects dependency selectors", rejectsDependencies)
        test("manifest: rejects systems and assets", rejectsSystemsAndAssets)
    }
}
