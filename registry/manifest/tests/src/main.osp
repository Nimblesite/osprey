namespace registry_tests;
import registry::Policy
import registry_tests::TomlTests
import registry_tests::ManifestTests

/// The manifest suites, kept apart from `registry/tests` until the type
/// checker handles the TOML parser in seconds (plan 0020 Phase 1).
fn suites() = {
    TomlTests::run()
    ManifestTests::run()
    0
}

fn main() = Policy::guarded(suites)
