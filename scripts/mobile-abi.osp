// The scalar C boundary both mobile targets must honour, exercised by
// scripts/mobile-abi.c on a real iPhone/simulator link and on Android.
// Implements [IOS-HOST-ABI] [IOS-TARGET-ENTRY] [ANDROID-HOST-ABI].
//
// Every export here exists to pin one property of the boundary the header
// cannot state: the width and sign of an integer, that a double survives
// round-tripping, that a C bool arrives canonical under both bool ABIs, that
// a UTF-8 string crosses intact in both directions, that Osprey copies a
// borrowed host string instead of aliasing it, and that an opaque host handle
// comes back unchanged.

extern fn hostRecord(value: int, ready: bool, label: string) -> Unit
extern fn hostNegate(value: bool) -> bool
extern fn hostMeasure(text: string) -> int
extern fn hostResolve(window: Ptr) -> int
extern fn hostBorrowedText(version: int) -> string

let seed = "persisted ${41}"
let importedSeed = hostBorrowedText(0)

/// The first imports live in a global nested record. The host reuses one
/// buffer, so these bytes survive later callbacks only if initialization
/// copied every borrowed import into Osprey ownership. [IOS-HOST-IMPORTS]
type ImportSample = { text: string }
type ImportSnapshot = { seed: ImportSample, blank: ImportSample, first: ImportSample, second: ImportSample, wide: ImportSample, values: List<string> }
let importedSnapshot = ImportSnapshot {
    seed: ImportSample { text: hostBorrowedText(0) },
    blank: ImportSample { text: hostBorrowedText(-1) },
    first: ImportSample { text: hostBorrowedText(1) },
    second: ImportSample { text: hostBorrowedText(2) },
    wide: ImportSample { text: hostBorrowedText(1000) },
    values: [hostBorrowedText(0), hostBorrowedText(-1), hostBorrowedText(1), hostBorrowedText(2)]
}

/// [IOS-HOST-IMPORTS] A borrowed import becomes an Osprey-owned string before
/// the host is called again, including values retained across exported calls.
fn retainedImport() = importedSeed
fn readTwoImports() = {
    let first = hostBorrowedText(1)
    let second = hostBorrowedText(2)
    "${first}|${second}"
}

/// Re-import an arbitrary payload: empty (-1), Unicode (0-2), or a distinct
/// 8192-byte changing value (>=1000).
fn changingImport(version) = hostBorrowedText(version)
let referencedImport = {
    let reader = hostBorrowedText
    reader(1)
}
fn importByReference() = referencedImport

/// Irrefutable nested record patterns, never a fallback value for a failed
/// read. Each accessor returns the exact bytes captured at initialization.
fn retainedSeedImport() = match importedSnapshot { { seed, .. } => match seed { { text } => text } }
fn retainedBlankImport() = match importedSnapshot { { blank, .. } => match blank { { text } => text } }
fn retainedFirstImport() = match importedSnapshot { { first, .. } => match first { { text } => text } }
fn retainedSecondImport() = match importedSnapshot { { second, .. } => match second { { text } => text } }
fn retainedLongImport() = match importedSnapshot { { wide, .. } => match wide { { text } => text } }
fn retainedListJoin() = join(importedSnapshot.values, "|")

/// Real joins over the retained nested values; the C oracle compares these.
fn retainedNestedJoin() = retainedSeedImport() + "|" + retainedBlankImport() + "|" + retainedFirstImport() + "|" + retainedSecondImport()

fn stored() = seed
fn greet(name: string) = "Hello ${name}"
fn invert(value) = !value
fn invertViaHost(value) = hostNegate(value)
fn both(left, right) = left && right
fn big() = 9223372036854775807
fn small() = 0 - 9223372036854775807 - 1
fn overflowDefault() = {
    handle Arith { overflow _ _ _ _ => -1 }
    big() + 1
}
fn negate(value) = wrapSub(0, value)
fn scale(value: float) = value * 1.5
fn half(value: float) = value / 2.0

/// Parameter annotations resolve the scalar signatures the C boundary carries;
/// return types remain inferred. A
/// function left generic is inlined at its call sites, has no symbol, and is
/// therefore absent from the header — the boundary reports what codegen
/// emitted, never what a caller hoped for. [IOS-HOST-ABI]
fn spanOf(text: string) = length(text)
fn bytes(text) = byteLength(text)
fn upper(text) = toUpperCase(text)
// Host inputs retained or returned must survive caller-buffer reuse. [IOS-HOST-ABI]
mut retainedHostInput = ""
effect RetainHostInput { save: fn(string) -> Unit }
fn retainHostInput(text) = {
    handle RetainHostInput { save value => { retainedHostInput = value } }
    perform RetainHostInput.save(text)
}
fn retainedInput() = retainedHostInput
fn identityInput(text: string) = text
fn identitySecond(_first: string, text: string) = text
fn retainSecond(_first: string, text) = retainHostInput(text)
fn joinWith(left: string, right: string) = "${left}|${right}"

/// An Osprey-allocated string crossing into C, rather than a literal.
fn measured(text) = hostMeasure(toUpperCase(text))

fn emit(value, ready, label) = hostRecord(value, ready, label)

/// A host handle held and returned without being inspected [FFI-PTR]. Identity
/// is polymorphic, so the annotation is what gives it a C symbol.
fn passBack(window: Ptr) = window
fn resolve(window) = hostResolve(window)

hostRecord(41, true, "boot")
