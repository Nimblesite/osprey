// Turns the hunt corpus sweep's `target/hunt-corpus-report.json` into a
// self-contained HTML report at `target/hunt-corpus-report.html`. Run from the
// repo root after `make -C src/osprey/tests/hunt hunt-corpus` and the report
// aggregation:
//
//     osprey scripts/hunt/report_html.ospml --run
//
// Decode happens only here at the edge, over the built-in Json values; every
// reader names its default, so a truncated or hand-edited report still
// renders instead of crashing.

namespace hunt

IN = "target/hunt-corpus-report.json"
OUT = "target/hunt-corpus-report.html"

// --- edge: JSON readers over the built-in Json values -----------------------

parse (source) = match jsonDecode (source)
    Success doc => doc
    Error _ => JsonNull

field (doc, key) = jsonField doc key ?: JsonNull
text (doc, key) = jsonText (field (doc, key)) ?: ""
int (doc, key) = jsonInt (field (doc, key)) ?: 0
items doc = match doc
    JsonArray values => values
    _ => []

// --- rendering --------------------------------------------------------------

// Every text the sweep carries — file paths, engine messages — reaches the
// markup, so everything escapes before it interpolates.
amp s = replace (s, "&", "&amp;") ?: s
lt s = replace (s, "<", "&lt;") ?: s
gt s = replace (s, ">", "&gt;") ?: s
quoted s = replace (s, "\"", "&quot;") ?: s
escape s = quoted (gt (lt (amp s)))

// A missing line number renders as "-", never as a fake 0.
lineText f = match int (f, "line")
    0 => "-"
    n => toString n

at f = match text (f, "file")
    "" => ""
    file => " at ${escape file}:${lineText f}"

findingText f = "<div class='f ${text (f, "class")}'>${escape (text (f, "class"))}${at f} — ${escape (text (f, "message"))}</div>"

chip status = match status
    "clean" => "<span class='chip ok'>clean</span>"
    "engine_limitation" => "<span class='chip warn'>engine limitation</span>"
    "tool_error" => "<span class='chip bad'>tool error</span>"
    other => "<span class='chip bad'>${escape other}</span>"

pathsText p = match int (p, "explored")
    0 => "-"
    explored => "${toString explored} paths"

findingsCell p = match items (field (p, "findings"))
    [] => "<td></td>"
    fs => "<td>${join (mapList (fs, findingText), "")}</td>"

programRow p = "<tr><td>${escape (text (p, "program"))}</td><td>${chip (text (p, "status"))}</td><td>${toString (int (p, "exit"))}</td><td>${pathsText p}</td>${findingsCell p}</tr>"

card (label, count, css) = "<div class='card ${css}'><div class='n'>${toString count}</div><div class='l'>${label}</div></div>"

cards s = join ([
    card ("hunted", int (s, "clean") + int (s, "engine_limitation") + int (s, "tool_error"), ""),
    card ("clean", int (s, "clean"), "ok"),
    card ("engine limitations", int (s, "engine_limitation"), "warn"),
    card ("tool errors", int (s, "tool_error"), "bad"),
    card ("crash findings", int (s, "osprey_level_crash_findings"), "bad"),
], "")

runLine r = "${escape (text (r, "command"))} · ${escape (text (r, "engine"))} · ${toString (int (r, "budget_seconds"))}s budget · ${toString (int (r, "parallel_jobs"))} jobs · ${toString (int (r, "programs_hunted"))} hunted of ${toString (int (r, "programs_enumerated"))} enumerated · ${toString (int (r, "skipped"))} skipped (${escape (text (r, "skipped_reason"))})"

styles = "
body { font-family: -apple-system, sans-serif; margin: 2rem; color: #1a1a1a; background: #fafafa; }
h1 { font-size: 1.4rem; } .meta { color: #666; font-size: .85rem; margin-bottom: 1.5rem; }
.cards { display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
.card { border: 1px solid #ddd; border-radius: 8px; padding: .6rem 1.2rem; background: #fff; }
.card .n { font-size: 1.6rem; font-weight: 700; } .card .l { font-size: .8rem; color: #666; }
.card.ok { border-color: #2e7d32; } .card.ok .n { color: #2e7d32; }
.card.warn { border-color: #b26a00; } .card.warn .n { color: #b26a00; }
.card.bad { border-color: #c62828; } .card.bad .n { color: #c62828; }
table { border-collapse: collapse; width: 100%; font-size: .85rem; background: #fff; }
th, td { border: 1px solid #e3e3e3; padding: .35rem .6rem; text-align: left; vertical-align: top; }
th { background: #f0f0f0; } td:nth-child(3), td:nth-child(4) { white-space: nowrap; }
.chip { padding: .1rem .5rem; border-radius: 10px; font-size: .75rem; white-space: nowrap; }
.chip.ok { background: #e8f5e9; color: #2e7d32; } .chip.warn { background: #fff3e0; color: #b26a00; }
.chip.bad { background: #ffebee; color: #c62828; }
.f { margin: .1rem 0; } .f.unmodelled { color: #b26a00; } .f.tool_error, .f.memory, .f.abort, .f.arith { color: #c62828; }
"

page doc = "<!doctype html><html><head><meta charset='utf-8'><title>Hunt corpus report</title><style>${styles}</style></head><body><h1>Hunt corpus report</h1><p class='meta'>${runLine (field (doc, "run"))}</p><div class='cards'>${cards (field (doc, "summary"))}</div><table><tr><th>program</th><th>status</th><th>exit</th><th>paths</th><th>findings</th></tr>${join (mapList (items (field (doc, "programs")), programRow), "")}</table></body></html>"

render doc = match writeFile (OUT, page doc)
    Success bytes => print "wrote ${OUT}: ${toString bytes} bytes, ${toString (length (items (field (doc, "programs"))))} programs"
    Error message => print "hunt-report: cannot write ${OUT}: ${message}"
main () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
    match readFile (IN)
        Success source => render (parse (source))
        Error message => print "hunt-report: cannot read ${IN}: ${message}"
