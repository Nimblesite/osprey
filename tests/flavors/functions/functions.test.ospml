// ML function twin covering currying, higher-order calls, and recursion.

(** Capture an offset in a RETURNED lambda: one parameter whose body is a
    closure, the form-for-form mirror of the Default twin's
    `fn closureAdder(n) = fn(x) => …`. Spelled `closureAdder n x = …` it is an
    ordinary two-parameter function; both spellings lower to the same IR, which
    is exactly the [FLAVOR-IR-EQUIV] claim — but only this one puts the ML
    closure-returning binding through the front end, and after the ml/ example
    suite was deleted no file in tests/ did. The signature is load-bearing: it
    keeps the returned closure concrete. *)
closureAdder n = \x => x + n ?: 0

(** Verify independent closures and direct application. *)
closuresCase () =
    add10 = closureAdder 10
    add100 = closureAdder 100

    // Preserve the complete rendered result. `(closureAdder 3) 4` is the
    // stepwise call the Default twin writes `closureAdder(3)(4)`: apply the
    // factory, then apply the closure it handed back.
    checkAll "closures legacy rendered lines" [
        "a=${add10 5} b=${add100 5} c=${(closureAdder 3) 4}" == "a=15 b=105 c=7"
    ]
    // Check each captured call independently.
    checkAll "closures legacy constituent values" [
        add10 5 == 15,
        add100 5 == 105,
        (closureAdder 3) 4 == 7
    ]
    // Exercise identity, cancellation, and capture independence.
    checkAll "closures capture edge cases" [
        add10 ((0 - 10) ?: 0) == 0,
        add100 0 == 100,
        (closureAdder 0) 9 == 9,
        (add10 5 == add100 5) == false
    ]

(** Return an explicitly curried addition closure, mirroring the Default twin's
    `fn partialAdd(a) = fn(b) => …`: `partialAdd 5` yields a function, not a
    number. *)
partialAdd a = \b => a + b ?: 0

(** Verify partially and fully applied addition. *)
curryPartialCase () =
    add5 = partialAdd 5
    add100 = partialAdd 100

    // Preserve the complete rendered result.
    checkAll "partial application legacy rendered lines" [
        "a=${add5 10} b=${add5 0} c=${add100 23} full=${(partialAdd 7) 8}" ==
            "a=15 b=5 c=123 full=15"
    ]
    // Check each application independently.
    checkAll "partial application legacy constituent values" [
        add5 10 == 15,
        add5 0 == 5,
        add100 23 == 123,
        (partialAdd 7) 8 == 15
    ]
    // Exercise identity, cancellation, and equivalent sums.
    checkAll "partial application edge cases" [
        add5 ((0 - 5) ?: 0) == 0,
        add100 0 == 100,
        (partialAdd 0) 9 == 9,
        (partialAdd 5) 5 == (partialAdd 8) 2
    ]

(** Apply a supplied function once. *)
hofApply f x = f x

(** Apply a supplied function twice. *)
hofTwice f x = f (f x)

(** Double an integer as a first-class function. *)
hofDouble n = n + n ?: 0

(** Increment an integer as a first-class function. *)
hofInc n = n + 1 ?: 0

(** Verify higher-order application and composition. *)
higherOrderCase () =
    // Preserve the complete rendered result.
    checkAll "higher-order legacy rendered lines" [
        "a=${hofApply hofDouble 5} b=${hofApply hofInc 9} t=${hofTwice hofDouble 3} ti=${hofTwice hofInc 40}" ==
            "a=10 b=10 t=12 ti=42"
    ]
    // Check each application independently.
    checkAll "higher-order legacy constituent values" [
        hofApply hofDouble 5 == 10,
        hofApply hofInc 9 == 10,
        hofTwice hofDouble 3 == 12,
        hofTwice hofInc 40 == 42
    ]
    // Exercise zero, repetition, and nested higher-order calls.
    checkAll "higher-order edge cases" [
        hofApply hofDouble 0 == 0,
        hofTwice hofInc 0 == 2,
        hofTwice hofDouble 1 == 4,
        hofApply hofInc (hofApply hofDouble 3) == 7
    ]

(** Increment values in nested call expressions. *)
nestedInc x = x + 1 ?: 0

(** Double values in nested call expressions. *)
nestedDouble x = x + x ?: 0

(** Negate values in nested call expressions. *)
nestedNeg x = 0 - x ?: 0

(** Verify evaluation through nested unary calls. *)
nestedCallsCase () =
    deep = nestedInc (nestedDouble (nestedInc (nestedDouble 3)))

    // Preserve the complete rendered result.
    checkAll "nested calls legacy rendered lines" [
        "deep=${deep} mix=${nestedNeg (nestedInc (nestedDouble 5))} two=${nestedDouble (nestedDouble 4)}" ==
            "deep=15 mix=-11 two=16"
    ]
    // Check each nested result independently.
    checkAll "nested calls legacy constituent values" [
        deep == 15,
        nestedNeg (nestedInc (nestedDouble 5)) == ((0 - 11) ?: 0),
        nestedDouble (nestedDouble 4) == 16
    ]
    // Exercise each helper and additional zero paths.
    checkAll "nested calls edge cases" [
        nestedInc 0 == 1,
        nestedDouble 0 == 0,
        nestedNeg 0 == 0,
        nestedInc (nestedDouble 2) == 5,
        nestedNeg (nestedInc (nestedDouble 0)) == ((0 - 1) ?: 0)
    ]

(** Sum positive integers with adjacent pattern clauses. *)
recursiveSumTo 0 = 0
recursiveSumTo n = n + recursiveSumTo ((n - 1) ?: 0) ?: 0

(** Verify the base and recursive paths. *)
recursionCase () =
    // Preserve the complete rendered result.
    checkAll "recursion legacy rendered lines" [
        "sum5=${recursiveSumTo 5} sum10=${recursiveSumTo 10} sum1=${recursiveSumTo 1}" ==
            "sum5=15 sum10=55 sum1=1"
    ]
    // Check each sum independently.
    checkAll "recursion legacy constituent values" [
        recursiveSumTo 5 == 15,
        recursiveSumTo 10 == 55,
        recursiveSumTo 1 == 1
    ]
    // Exercise the base, short, long, and recurrence cases.
    checkAll "recursion edge cases" [
        recursiveSumTo 0 == 0,
        recursiveSumTo 2 == 3,
        recursiveSumTo 6 == 21,
        recursiveSumTo 6 == (recursiveSumTo 5 + 6 ?: 0)
    ]

test "closures retain independent captured state" closuresCase
test "partial application retains every curried golden" curryPartialCase
test "higher-order functions retain every application golden" higherOrderCase
test "nested calls retain evaluation structure" nestedCallsCase
test "recursion retains base and recursive branches" recursionCase
