// ML matching twin covering literals, booleans, and wildcards.

(** Classify literals through adjacent pattern clauses. *)
tourClassify 0 = "zero"
tourClassify 1 = "one"
tourClassify _ = "many"

(** Verify every literal and wildcard branch. *)
matchTourCase () =
    // Preserve each rendered branch result.
    checkAll "match tour legacy rendered lines" [
        tourClassify 0 == "zero",
        tourClassify 1 == "one",
        tourClassify 9 == "many"
    ]
    // Check each dynamic result independently.
    checkAll "match tour legacy constituent values" [
        tourClassify 0 == "zero",
        tourClassify 1 == "one",
        tourClassify 9 == "many"
    ]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "match tour wildcard edge cases" [
        tourClassify 2 == "many",
        tourClassify ((0 - 1) ) == "many",
        tourClassify 100 == "many",
        (tourClassify 0 == tourClassify 1) == false
    ]

(** Convert a threshold comparison to a grade label. *)
matchGrade n =
    match n >= 50
        true => "pass"
        false => "fail"

(** Convert parity to an even-or-odd label. *)
matchEven n =
    match (n % 2 ) == 0
        true => "even"
        false => "odd"

(** Verify boolean scrutinees for grading and parity. *)
matchBooleanCase () =
    // Preserve the complete rendered result.
    checkAll "boolean match legacy rendered lines" [
        "g80=${matchGrade 80} g20=${matchGrade 20} e4=${matchEven 4} e7=${matchEven 7}" ==
            "g80=pass g20=fail e4=even e7=odd"
    ]
    // Check each label independently.
    checkAll "boolean match legacy constituent values" [
        matchGrade 80 == "pass",
        matchGrade 20 == "fail",
        matchEven 4 == "even",
        matchEven 7 == "odd"
    ]
    // Exercise threshold and parity boundaries.
    checkAll "boolean match boundaries" [
        matchGrade 50 == "pass",
        matchGrade 49 == "fail",
        matchEven 0 == "even",
        matchEven 9 == "odd"
    ]

(** Label integer literals through adjacent pattern clauses. *)
matchLabel 0 = "none"
matchLabel 1 = "single"
matchLabel 2 = "pair"
matchLabel _ = "many"

(** Verify literal and wildcard integer matching. *)
matchIntegerCase () =
    // Preserve the complete rendered result.
    checkAll "integer match legacy rendered lines" [
        "a=${matchLabel 0} b=${matchLabel 1} c=${matchLabel 2} d=${matchLabel 7}" ==
            "a=none b=single c=pair d=many"
    ]
    // Check each label independently.
    checkAll "integer match legacy constituent values" [
        matchLabel 0 == "none",
        matchLabel 1 == "single",
        matchLabel 2 == "pair",
        matchLabel 7 == "many"
    ]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "integer match wildcard boundaries" [
        matchLabel 3 == "many",
        matchLabel ((0 - 1) ) == "many",
        matchLabel 100 == "many"
    ]

test "literal matching retains every printed arm" matchTourCase
test "boolean matching covers thresholds and parity" matchBooleanCase
test "integer matching covers literals and wildcard" matchIntegerCase

(** [PATTERN-BINDING-SCOPE] Every pattern introduces names in its own arm. *)
type Choice = Pick int | Other
type Coordinates =
    x : int
    y : int

resultScope input =
    value = 100
    message = "outer"
    selected = match input
        Success value => "${value}:${message}"
        Error message => "${value}:${message}"
    "${selected}:${value}:${message}"

unionScope input =
    value = 100
    selected = match input
        Pick value => value
        Other => value
    "${selected}:${value}"

listScope input =
    head = 100
    tail = [8, 9]
    selected = match input
        [] => head
        [head, ...tail] => wrapAdd (head, listLength tail)
    "${selected}:${head}:${listLength tail}"

structuralScope : Coordinates -> string
structuralScope input =
    x = 100
    selected = match input
        { x, .. } => wrapAdd (x, 1)
    "${selected}:${x}"

erasedScope : any -> string
erasedScope input =
    x = 100
    selected = match input
        { x, .. } => "${x}"
        _ => "none"
    "${selected}:${x}"

bindingScope () =
    value = 100
    selected = match 2
        value => value
    checkAll ("a catch-all binding leaves its outer value intact", [
        selected == 2, value == 100
    ])

siblingScopeCase () = checkAll ("pattern arms have independent bindings", [
    resultScope (Success(value = 2)) == "2:outer:100:outer",
    resultScope (Error(message = "bad")) == "100:bad:100:outer",
    unionScope (Pick 2) == "2:100",
    unionScope Other == "100:100",
    listScope [2, 3] == "3:100:2",
    listScope [] == "100:100:2",
    structuralScope (Coordinates(x = 2, y = 3)) == "3:100",
    erasedScope (Coordinates(x = 2, y = 3)) == "2:100",
    erasedScope 0 == "none:100"
])

capturedPattern input =
    value = 100
    reader = match input
        Pick value => \() => value
        Other => \() => value
    "${reader ()}:${value}"

capturedPatternCase () = checkAll ("closures retain the selected arm's binding", [
    capturedPattern (Pick 2) == "2:100",
    capturedPattern Other == "100:100"
])

test ("catch-all bindings remain inside their arm", bindingScope)
test ("pattern arms retain their own lexical bindings", siblingScopeCase)
test ("escaping closures retain pattern bindings", capturedPatternCase)

nestedPatternCase () =
    value = 100
    selected = match Pick 2
        Pick value =>
            inner = match Pick 3
                Pick value => value
                Other => value
            "${inner}:${value}"
        Other => "none"
    checkAll ("nested matches restore the containing arm", [selected == "3:2", value == 100])

effect PatternCounter
    set : int => int
mutablePatternCase () =
    mut value = 100
    handle PatternCounter
        set next =>
            value := next
            value
    readOuter = \() => value
    selected = match Pick 2
        Pick value => value
        Other => value
    updated = perform PatternCounter.set 101
    checkAll ("pattern values shadow cell storage without changing it", [
        selected == 2, updated == 101, value == 101, readOuter () == 101
    ])

test ("nested matches restore enclosing pattern bindings", nestedPatternCase)
test ("pattern bindings shadow captured mutable cells", mutablePatternCase)
