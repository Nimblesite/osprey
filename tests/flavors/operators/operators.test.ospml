// ML operator twin covering precedence, grouping, and boolean composition.

// Verify arithmetic precedence and grouping.
arithmeticOperatorsCase () =
    a = 2 + 3 * 4
    b = (2 + 3) * 4
    c = 20 - 6 * 2
    d = 2 * 3 + 4 * 5

    // Preserve the complete rendered result.
    checkAll "arithmetic legacy rendered lines" [
        "a=${a} b=${b} c=${c} d=${d}" == "a=14 b=20 c=8 d=26"
    ]
    // Check each derived number independently.
    checkAll "arithmetic legacy constituent values" [
        a == 14,
        b == 20,
        c == 8,
        d == 26
    ]
    // Exercise associativity, grouping, zero, and negative results.
    checkAll "arithmetic precedence edge cases" [
        20 - 6 - 2 == 12,
        20 - (6 - 2) == 16,
        7 + 9 * 0 == 7,
        0 - 5 * 2 == -10
    ]

// Verify logical operators, comparisons, and composition.
booleanOperatorsCase () =
    t = true
    f = false

    // Preserve the complete rendered result.
    checkAll "boolean legacy rendered lines" [
        "and=${t && f} or=${t || f} not=${!t} lt=${3 < 5} ge=${5 >= 5} eq=${4 == 4} chain=${(3 < 5) && !(2 > 9)}" ==
            "and=false or=true not=false lt=true ge=true eq=true chain=true"
    ]
    // Check each boolean result independently.
    checkAll "boolean legacy constituent values" [
        (t && f) == false,
        (t || f) == true,
        !t == false,
        (3 < 5) == true,
        (5 >= 5) == true,
        (4 == 4) == true,
        ((3 < 5) && !(2 > 9)) == true
    ]
    // Exercise complementary values and a composed true expression.
    checkAll "boolean composition edge cases" [
        !f == true,
        (5 < 3) == false,
        (4 == 5) == false,
        (t && !f) == true
    ]

test "operator precedence retains every arithmetic golden" arithmeticOperatorsCase
test "boolean composition retains every logical golden" booleanOperatorsCase
