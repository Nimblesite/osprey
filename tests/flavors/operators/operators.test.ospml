// ML operator twin covering precedence, grouping, and boolean composition.

(** Verify arithmetic precedence and grouping. *)
arithmeticOperatorsCase () =
    a = 2 + 3 * 4
    b = (2 + 3) * 4
    c = 20 - 6 * 2
    d = 2 * 3 + 4 * 5

    // Preserve the complete rendered result.
    checkAll "arithmetic legacy rendered lines" [
        "a=${a} b=${b} c=${c} d=${d}" == "a=Success(14) b=Success(20) c=Success(8) d=Success(26)"
    ]
    // Check each derived number independently.
    checkAll "arithmetic legacy constituent values" [
        (a ?: 0) == 14,
        (b ?: 0) == 20,
        (c ?: 0) == 8,
        (d ?: 0) == 26
    ]
    // Exercise associativity, grouping, zero, and negative results.
    checkAll "arithmetic precedence edge cases" [
        (20 - 6 - 2 ?: 0) == 12,
        (20 - (6 - 2) ?: 0) == 16,
        (7 + 9 * 0 ?: 0) == 7,
        (0 - 5 * 2 ?: 0) == ((0 - 10) ?: 0)
    ]

(** Verify logical operators, comparisons, and composition. *)
booleanOperatorsCase () =
    t = true
    f = false

    // Preserve the complete rendered result.
    checkAll "boolean legacy rendered lines" [
        "and=${t && f} or=${t || f} not=${!t} lt=${3 < 5} ge=${5 >= 5} eq=${4 == 4} chain=${(3 < 5) && !(2 > 9)}" ==
            "and=false or=true not=false lt=true ge=true eq=true chain=true"
    ]
    // Check each boolean result independently.
    checkAll "boolean legacy constituent values" [
        (t && f) == false,
        (t || f) == true,
        !t == false,
        (3 < 5) == true,
        (5 >= 5) == true,
        (4 == 4) == true,
        ((3 < 5) && !(2 > 9)) == true
    ]
    // Exercise complementary values and a composed true expression.
    checkAll "boolean composition edge cases" [
        !f == true,
        (5 < 3) == false,
        (4 == 5) == false,
        (t && !f) == true
    ]

test "operator precedence retains every arithmetic golden" arithmeticOperatorsCase
test "boolean composition retains every logical golden" booleanOperatorsCase

(** [FLOAT-OPERANDS] One constrained helper accepts int and float callers. *)
numericScale x = x * 1.5
(** Division accepts either numeric type independently in each operand. *)
numericQuotient left right = left / right
(** Passes a numeric helper through a higher-order argument. *)
runNumeric f x = f x
(** Pins numeric obligations at calls, aliases and higher-order slots. *)
numericPolymorphismCase () =
    alias = numericScale
    checkAll "numeric helper polymorphism" [
        numericScale 2 == 3.0,
        numericScale 2.5 == 3.75,
        alias 4 == 6.0,
        alias 4.5 == 6.75,
        runNumeric numericScale 5 == 7.5,
        runNumeric numericScale 5.5 == 8.25,
        (numericQuotient 3 1.5 ?: 0.0) == 2.0,
        (numericQuotient 2.5 2 ?: 0.0) == 1.25,
        (((4.0 / 2.0) * 1.5) ?: 0.0) == 3.0,
        (((4.0 / 0.0) * 1.5) ?: -1.0) == -1.0
    ]
test "numeric constraints retain mixed arithmetic and error propagation" numericPolymorphismCase
