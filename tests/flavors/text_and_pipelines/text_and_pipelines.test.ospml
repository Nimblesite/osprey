// ML text-and-pipeline twin covering composition and interpolation.

(** Increment a pipeline value. *)
pipeInc x = x + 1 ?: 0

(** Double a pipeline value. *)
pipeDouble x = x + x ?: 0

(** Square a pipeline value. *)
pipeSquare x = x * x ?: 0

(** Verify left-to-right pipeline composition. *)
pipeChainCase () =
    p1 = 5 |> pipeInc |> pipeDouble
    p2 = 3 |> pipeDouble |> pipeSquare |> pipeInc
    p3 = 10 |> pipeInc |> pipeInc |> pipeDouble

    // Preserve the complete rendered result.
    checkAll "pipe chain legacy rendered lines" [
        "p1=${p1} p2=${p2} p3=${p3}" == "p1=12 p2=37 p3=24"
    ]
    // Check each pipeline result independently.
    checkAll "pipe chain legacy constituent values" [
        p1 == 12,
        p2 == 37,
        p3 == 24
    ]
    // Exercise intermediate, zero, and reordered stages.
    checkAll "pipe chain composition edges" [
        (5 |> pipeInc) == 6,
        p1 == pipeDouble (pipeInc 5),
        (0 |> pipeInc |> pipeDouble) == 2,
        (3 |> pipeSquare |> pipeDouble) == 18
    ]

(** Append an exclamation mark. *)
stringShout s = s + "!"

(** Prefix a name with a greeting. *)
stringGreet who = "Hi " + who

(** Verify string calls, concatenation, and interpolation. *)
stringsCase () =
    name = "Ada"
    hello = stringGreet name

    // Preserve the complete rendered result.
    checkAll "strings legacy rendered lines" [
        "plain=${hello} loud=${stringShout hello} both=${stringShout (stringGreet name)} concat=${hello + name}" ==
            "plain=Hi Ada loud=Hi Ada! both=Hi Ada! concat=Hi AdaAda"
    ]
    // Check each dynamic string independently.
    checkAll "strings legacy constituent values" [
        hello == "Hi Ada",
        stringShout hello == "Hi Ada!",
        stringShout (stringGreet name) == "Hi Ada!",
        hello + name == "Hi AdaAda"
    ]
    // Exercise empty inputs, nested calls, and reversed concatenation.
    checkAll "strings composition edges" [
        stringGreet "" == "Hi ",
        stringShout "" == "!",
        stringShout hello == stringShout (stringGreet name),
        name + hello == "AdaHi Ada"
    ]

test "pipelines retain each stage and complete chain" pipeChainCase
test "string calls retain interpolation and concatenation" stringsCase
