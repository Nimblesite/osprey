(** ML surface for [MODULES-STATE], [MODULES-STATE-MODULE],
    [MODULES-STATE-SOURCE-OF-TRUTH] and [MODULES-INIT]: durable module-owned
    cells live only inside a qualifying installer, are reachable only through
    the module's own exported effect, and are allocated fresh per installer
    call. ML writes a cell with `:=`, which the checker allows only in a
    handler arm. *)

namespace metrics

state Tally
    (** The assembler removes these cells from module scope and injects a fresh
        pair into every call of the installer below. *)
    mut total = 0
    mut calls = 0

    export effect Counter
        add : int => int
        reads : Unit => int
        reset : Unit => int

    (** The one lexical handler that owns the cells [MODULES-STATE-MODULE]. *)
    export withTally body =
        handle Counter
            add amount =>
                total := (total + amount) ?: total
                calls := (calls + 1) ?: calls
                total
            reads => calls
            reset =>
                seen = total
                total := 0
                seen
        in body ()

(** Sums three additions inside one installed scope. *)
threeAdds () =
    a = perform Tally::Counter.add 1
    b = perform Tally::Counter.add 10
    c = perform Tally::Counter.add 100
    "${a}/${b}/${c}"

(** Reports the call counter alongside the running total. *)
addThenCount () =
    sum = perform Tally::Counter.add 5
    "${sum}:${perform Tally::Counter.reads ()}"

(** Clears the cell and reports the value it held. *)
addThenReset () =
    ignored = perform Tally::Counter.add 9
    cleared = perform Tally::Counter.reset ()
    "${cleared}->${perform Tally::Counter.reads ()}"

(** Cell writes accumulate across operations inside one installed scope. *)
accumulationCase () = checkAll ("state accumulates within one scope", [
    Tally::withTally threeAdds == "1/11/111",
    Tally::withTally addThenCount == "5:1",
    Tally::withTally addThenReset == "9->1"
])

(** Every installer call allocates its own cells [MODULES-STATE-MODULE]. *)
freshCellsCase () = checkAll ("each installer call gets fresh cells", [
    Tally::withTally threeAdds == Tally::withTally threeAdds,
    Tally::withTally addThenCount == "5:1",
    Tally::withTally addThenCount == "5:1",
    Tally::withTally threeAdds == "1/11/111",
    Tally::withTally addThenReset == "9->1"
])

(** Reading through the effect is the only route to the owned state. *)
effectMediatedCase () = checkAll ("all access is effect-mediated", [
    Tally::withTally (\() => perform Tally::Counter.reads ()) == 0,
    Tally::withTally (\() => perform Tally::Counter.reset ()) == 0,
    Tally::withTally (\() => perform Tally::Counter.add 3) == 3,
    Tally::withTally (\() => "${perform Tally::Counter.add 2}") == "2"
])

print "${Tally::withTally threeAdds} ${Tally::withTally addThenCount} ${Tally::withTally addThenReset}"
test ("owned cells accumulate inside one installer scope", accumulationCase)
test ("installer calls do not share cells", freshCellsCase)
test ("owned state is reachable only through the effect", effectMediatedCase)
