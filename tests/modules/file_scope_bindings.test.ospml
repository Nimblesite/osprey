(** ML surface for [MODULES-FILE-SCOPE-BINDING] and [MODULES-INIT]: a file-scope
    binding or `mut` cell is a declaration whose initializer runs where it is
    written, in source order, before the entry's statements. A function body
    reading one reads module storage, so it observes the value the handler arms
    most recently wrote rather than a copy taken at declaration time. *)

effect Counter
    tick : int => int

(** Performs two operations the file-scope handler below discharges. *)
run () = (perform Counter.tick 3 + perform Counter.tick 4) ?: 0

(** A plain file-scope constant, readable from every function below it. *)
base = 100

(** A cell the file-scope handler arm owns [EFFECTS-HANDLER-STATE]. *)
mut hits = 0

(** The initializer runs here, in source order, before any entry statement. *)
total = handle Counter
    tick amount =>
        hits := (hits + amount) ?: hits
        hits
in run ()

(** Records the order in which the file-scope initializers completed. *)
trace = "base=${base},hits=${hits},total=${total}"

(** Reads the live cell and the finished total, from outside the entry. *)
summary () = "${hits} hits, total ${total}"

(** A later function still reads the same module storage, not a copy. *)
scaled () = (hits * base) ?: 0

(** Both file-scope bindings are readable from ordinary function bodies. *)
constantReadCase () = checkAll ("functions read file-scope bindings", [
    base == 100,
    total == 10,
    scaled () == 700,
    ((base + total) ?: 0) == 110,
    "${base}" == "100"
])

(** The handler arms ran during initialization, so the cell holds their writes. *)
handlerOwnedCellCase () = checkAll ("handler-owned cell is one shared storage", [
    hits == 7,
    summary () == "7 hits, total 10",
    total == 10,
    ((hits * 2) ?: 0) == 14,
    summary () == "${hits} hits, total ${total}"
])

(** Initializers completed in source order, before the entry ran a statement. *)
initializationOrderCase () = checkAll ("initializers run in source order", [
    trace == "base=100,hits=7,total=10",
    trace == "base=${base},hits=${hits},total=${total}",
    total == 10,
    hits == 7
])

print "${summary ()} ${scaled ()} ${trace}"
test ("file-scope constants are readable from functions", constantReadCase)
test ("a handler-owned cell is one shared storage", handlerOwnedCellCase)
test ("file-scope initializers run in source order", initializationOrderCase)
