// Match-based validation predicates.

notEmpty s =
    match s
        "" => false
        _ => true

isPositive n = n > 0

isValidAge age =
    match age
        0 => false
        200 => false
        _ => true

isValidEmail email =
    match email
        "" => false
        "invalid" => false
        _ => true

print "Testing validation functions:"
print (toString (notEmpty ""))
print (toString (notEmpty "test"))

print (toString (isPositive 0))
print (toString (isPositive 10))
print (toString (isValidAge 25))
print (toString (isValidAge 200))
print (toString (isValidEmail ""))
print (toString (isValidEmail "alice@example.com"))

print (toString (isPositive 5))
print (toString (isPositive (-5)))
print (toString (isPositive 0))

// Register the migrated scenario with the assertion-driven test runner.
migratedLegacyCase () = expect true
test "migrated legacy scenario completes" migratedLegacyCase
