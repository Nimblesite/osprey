(** Audit supplies numbered values and records unwind order. *)
effect Audit
    step : string => int

(** Perform two ordered steps and combine their supplied values. *)
pipeline : Unit -> int ! Audit
pipeline () =
    a = perform Audit.step "load"
    b = perform Audit.step "parse"
    a + b

(** Verify FIFO operations and LIFO post-resume work. *)
resumeLifoAuditCase () =
    mut n = 0
    mut issued = ""
    mut settled = ""
    mut transcript = ""

    total =
        handle Audit
            step label =>
                n := n + 1
                issued := "${issued}${label}:${toString n}|"
                answer = resume n
                settled := "${settled}${label}:${toString answer}|"
                transcript := "${transcript}after ${label}: answer=${toString answer}\n"
                answer
        in pipeline ()
    legacyTranscript = "${transcript}total=${toString total}\n"

    (* Preserve the three-line unwind transcript. *)
    checkAll "LIFO legacy observations" [
        legacyTranscript == "after parse: answer=3\nafter load: answer=3\ntotal=3\n",
        startsWith legacyTranscript "after parse: answer=3\n",
        contains legacyTranscript "after load: answer=3\n",
        endsWith legacyTranscript "total=3\n"
    ]

    (* Check FIFO issue, LIFO settlement, and the combined answer. *)
    checkAll "LIFO internal state" [
        total == 3,
        n == 2,
        issued == "load:1|parse:2|",
        settled == "parse:3|load:3|",
        issued != settled,
        total == 1 + 2
    ]

test "post-resume code unwinds in reverse operation order" resumeLifoAuditCase
