(** Audit supplies numbered values and observes continuation unwind order. *)
effect Audit
    (** Request the numbered value for `label`, recording the visit. *)
    step : string => int

(** This helper performs two ordered steps and combines their supplied values. *)
pipeline () =
    a = perform Audit.step "load"
    b = perform Audit.step "parse"
    a + b ?: 0

(** This case proves operations enter FIFO and post-resume code exits LIFO. *)
resumeLifoAuditCase () =
    mut n = 0
    mut issued = ""
    mut settled = ""
    mut transcript = ""

    total =
        handle Audit
            step label =>
                n := n + 1 ?: n
                issued := "${issued}${label}:${toString n}|"
                answer = resume n
                settled := "${settled}${label}:${toString answer}|"
                transcript := "${transcript}after ${label}: answer=${toString answer}\n"
                answer
        in pipeline ()
    legacyTranscript = "${transcript}total=${toString total}\n"

    (* Preserve all three legacy lines and their exact unwind ordering. *)
    checkAll "LIFO legacy observations" [
        legacyTranscript == "after parse: answer=3\nafter load: answer=3\ntotal=3\n"
    ]

    (* Assert issue order, settle order, operation count, and combined answer. *)
    checkAll "LIFO internal state" [
        total == 3,
        n == 2,
        issued == "load:1|parse:2|",
        settled == "parse:3|load:3|"
    ]

(* Register the post-resume LIFO regression. *)
test "post-resume code unwinds in reverse operation order" resumeLifoAuditCase

(** Alpha, Beta, Gamma and Delta are single-operation channels, one per nesting
    depth, so every transcript entry names both the region that answered an
    operation and the position at which it did so. *)
effect Alpha
    (** Supply Alpha's numbered value for `label`. *)
    alpha : string => int

(** Beta is the second channel; a nested region claims it on its own. *)
effect Beta
    (** Supply Beta's numbered value for `label`. *)
    beta : string => int

(** Gamma is the third channel, and also serves as a never-performed spectator. *)
effect Gamma
    (** Supply Gamma's numbered value for `label`. *)
    gamma : string => int

(** Delta is the fourth channel, claimed by the innermost of four regions. *)
effect Delta
    (** Supply Delta's numbered value for `label`. *)
    delta : string => int

(** Two regions, two effects, four operations performed a-b-a-b. Spec 0017
    [EFFECTS-RESUME] says `resume` "runs the rest of the handled computation" and
    "evaluates to that computation's answer", so an arm's post-resume code only
    runs once the computation it resumed has produced one.
    [EFFECTS-RESUME-NESTING] settles which computation that is: a continuation
    reaches out to the handler that ANSWERS the operation, so `a2` — which
    crosses the Beta region to reach Alpha — has its arm installed OUTSIDE the
    still-live `b1` arm, and `resume` puts `b1` back inside it. Settlement
    therefore follows the live arm nesting, `b2 b1 a2 a1`, and NOT the plain
    reverse of the entry order, `b2 a2 b1 a1`. The inner arm doubles its answer
    and the outer arm increments its own, so the final number is reachable
    through exactly one settlement order. Per [EFFECTS-OPERATION-MAILBOX] a
    resumed body may perform again while an arm is still live, which is exactly
    the interleaving below. [EFFECTS-HANDLER-STATE]: both arms write the same
    four cells, so the transcripts are one shared ordering, not two private ones. *)
nestedInterleavedDepthTwoCase () =
    mut alphaCalls = 0
    mut betaCalls = 0
    mut entered = ""
    mut settled = ""
    mut supplies = ""
    mut answers = ""

    total =
        handle Alpha
            alpha label =>
                alphaCalls := alphaCalls + 1 ?: alphaCalls
                supplied = alphaCalls * 10 ?: 0
                entered := "${entered}a:${label}|"
                supplies := "${supplies}${label}=${toString supplied}|"
                answer = resume supplied
                settled := "${settled}a:${label}|"
                answers := "${answers}${label}:${toString answer}|"
                answer + 1 ?: answer
        in
            handle Beta
                beta label =>
                    betaCalls := betaCalls + 1 ?: betaCalls
                    supplied = betaCalls * 100 ?: 0
                    entered := "${entered}b:${label}|"
                    supplies := "${supplies}${label}=${toString supplied}|"
                    answer = resume supplied
                    settled := "${settled}b:${label}|"
                    answers := "${answers}${label}:${toString answer}|"
                    answer * 2 ?: answer
            in
                p = perform Alpha.alpha "a1"
                q = perform Beta.beta "b1"
                r = perform Alpha.alpha "a2"
                s = perform Beta.beta "b2"
                (p + q ?: 0) + (r + s ?: 0) ?: 0

    (* Operations enter in the order the body performs them, whichever depth
       answers them: the outer region answers first and third. *)
    checkAll "two nested depths enter in perform order" [
        entered == "a:a1|b:b1|a:a2|b:b2|",
        alphaCalls == 2,
        betaCalls == 2
    ]

    (* Settlement follows the live arm nesting: `a2` crossed the Beta region on
       its way out, so its arm sits OUTSIDE `b1`'s and settles after it. A plain
       reverse of `entered` would predict `b:b2|a:a2|b:b1|a:a1|`, which is not
       what this transcript says [EFFECTS-RESUME-NESTING]. *)
    checkAll "two nested depths settle innermost suspension first" [
        settled == "b:b2|b:b1|a:a2|a:a1|"
    ]

    (* Each region supplies its own magnitude — tens from Alpha, hundreds from
       Beta — so a value handed to the wrong performer changes the body's sum. *)
    checkAll "each nested depth supplies its own magnitude" [
        supplies == "a1=10|b1=100|a2=20|b2=200|"
    ]

    (* The first arm to settle sees the body's own answer, 330. Every later arm
       sees what the arm below it returned. Both Beta arms double, then both
       Alpha arms increment: 330 -> 660 -> 1320 -> 1321 -> 1322. *)
    checkAll "nested settled answers chain through the arms" [
        answers == "b2:330|b1:660|a2:1320|a1:1321|",
        total == 1322
    ]

(* Register the two-depth interleaved settlement audit. *)
test "interleaved performs across two nested regions settle innermost first" nestedInterleavedDepthTwoCase

(** Three regions, rotated: the OUTERMOST region handles Gamma, the middle one
    Alpha and the innermost one Beta, while the body performs them in a third
    order entirely. Spec 0017 [EFFECTS-RESUME-NESTING] ties settlement to the
    LIVE ARM NESTING, not to the entry order: every operation that crosses
    outward installs its arm outside the arms it crossed, so both Beta
    suspensions settle first, then both Alpha, then both Gamma — the rotation in
    the body's perform order leaves no trace in the settle order. Each depth
    applies a different, non-commutative transform to the answer it receives
    ([EFFECTS-HANDLER-ARMS]: the arm's value is what it supplies to the
    suspension below it), so 119936 is reachable through exactly one order. *)
nestedDepthThreeRotationCase () =
    mut gammaCalls = 0
    mut alphaCalls = 0
    mut betaCalls = 0
    mut entered = ""
    mut settled = ""
    mut answers = ""

    total =
        handle Gamma
            gamma label =>
                gammaCalls := gammaCalls + 1 ?: gammaCalls
                supplied = gammaCalls * 1000 ?: 0
                entered := "${entered}d1:${label}|"
                answer = resume supplied
                settled := "${settled}d1:${label}|"
                answers := "${answers}${label}:${toString answer}|"
                answer * 2 ?: answer
        in
            handle Alpha
                alpha label =>
                    alphaCalls := alphaCalls + 1 ?: alphaCalls
                    supplied = alphaCalls * 10 ?: 0
                    entered := "${entered}d2:${label}|"
                    answer = resume supplied
                    settled := "${settled}d2:${label}|"
                    answers := "${answers}${label}:${toString answer}|"
                    answer + 7 ?: answer
            in
                handle Beta
                    beta label =>
                        betaCalls := betaCalls + 1 ?: betaCalls
                        supplied = betaCalls * 100 ?: 0
                        entered := "${entered}d3:${label}|"
                        answer = resume supplied
                        settled := "${settled}d3:${label}|"
                        answers := "${answers}${label}:${toString answer}|"
                        answer * 3 ?: answer
                in
                    g0 = perform Gamma.gamma "g0"
                    a1 = perform Alpha.alpha "a1"
                    b1 = perform Beta.beta "b1"
                    g1 = perform Gamma.gamma "g1"
                    b2 = perform Beta.beta "b2"
                    a2 = perform Alpha.alpha "a2"
                    (g0 + a1 ?: 0) + (b1 + g1 ?: 0) + (b2 + a2 ?: 0) ?: 0

    (* Six operations, three depths, entered in body order: d1 d2 d3 d1 d3 d2. *)
    checkAll "three rotated depths enter in perform order" [
        entered == "d1:g0|d2:a1|d3:b1|d1:g1|d3:b2|d2:a2|",
        gammaCalls == 2,
        alphaCalls == 2,
        betaCalls == 2
    ]

    (* Settlement does NOT reverse that sequence: each crossing operation put
       its arm outside the arms it crossed, so the deepest live arms settle
       first and each region's later suspension settles before its earlier one.
       Reversing `entered` would predict `d2:a2|d3:b2|d1:g1|d3:b1|d2:a1|d1:g0|`. *)
    checkAll "three rotated depths settle by live arm nesting" [
        settled == "d3:b2|d3:b1|d2:a2|d2:a1|d1:g1|d1:g0|"
    ]

    (* Body sum: 1000 + 10 + 100 + 2000 + 200 + 20 = 3330. Each arm then folds
       its own transform over the answer below it, deepest live arm first. *)
    checkAll "three rotated depths chain their answers" [
        answers == "b2:3330|b1:9990|a2:29970|a1:29977|g1:29984|g0:59968|"
    ]

    (* 3330 *3 -> 9990 *3 -> 29970 +7 -> 29977 +7 -> 29984 *2 -> 59968 *2. The
       reverse-entry order would fold +7 *3 *2 *3 +7 *2 over the same body sum
       and reach 120146, so the total alone separates the two orders. *)
    checkAll "three rotated depths fold in exactly one order" [
        total == 119936
    ]

(* Register the three-depth rotated settlement audit. *)
test "three rotated regions settle by live arm nesting, not by perform order" nestedDepthThreeRotationCase

(** Four nested regions, one effect each, performed 1-2-3-4-4-3-2-1 so the depth
    pattern is a palindrome while the labels are not. Spec 0017 [EFFECTS-RESUME]
    makes each `resume` return only after the whole remaining computation —
    including every suspension opened inside it — has produced an answer, and
    [EFFECTS-RESUME-NESTING] puts an outward-crossing operation's arm outside
    every arm it crossed. The eight arms therefore settle deepest region first,
    each region's later suspension before its earlier one — NOT in reverse entry
    order. Every arm adds its own power of ten to the answer it received, which
    makes the digits of the answer each arm SAW a staircase that names the
    settling depth; the total alone cannot detect a reordering, which is why
    each step is pinned individually.
    [EFFECTS-OPERATION-MAILBOX] covers the four live suspensions at once: a
    nested suspension installs its own mailbox rather than overwriting one still
    in use. *)
nestedDepthFourStaircaseCase () =
    mut alphaCalls = 0
    mut betaCalls = 0
    mut gammaCalls = 0
    mut deltaCalls = 0
    mut entered = ""
    mut settled = ""
    mut supplies = ""
    mut answers = ""

    total =
        handle Alpha
            alpha label =>
                alphaCalls := alphaCalls + 1 ?: alphaCalls
                supplied = alphaCalls
                entered := "${entered}1:${label}|"
                supplies := "${supplies}${label}=${toString supplied}|"
                answer = resume supplied
                settled := "${settled}1:${label}|"
                answers := "${answers}${label}:${toString answer}|"
                answer + 1 ?: answer
        in
            handle Beta
                beta label =>
                    betaCalls := betaCalls + 1 ?: betaCalls
                    supplied = betaCalls * 10 ?: 0
                    entered := "${entered}2:${label}|"
                    supplies := "${supplies}${label}=${toString supplied}|"
                    answer = resume supplied
                    settled := "${settled}2:${label}|"
                    answers := "${answers}${label}:${toString answer}|"
                    answer + 10 ?: answer
            in
                handle Gamma
                    gamma label =>
                        gammaCalls := gammaCalls + 1 ?: gammaCalls
                        supplied = gammaCalls * 100 ?: 0
                        entered := "${entered}3:${label}|"
                        supplies := "${supplies}${label}=${toString supplied}|"
                        answer = resume supplied
                        settled := "${settled}3:${label}|"
                        answers := "${answers}${label}:${toString answer}|"
                        answer + 100 ?: answer
                in
                    handle Delta
                        delta label =>
                            deltaCalls := deltaCalls + 1 ?: deltaCalls
                            supplied = deltaCalls * 1000 ?: 0
                            entered := "${entered}4:${label}|"
                            supplies := "${supplies}${label}=${toString supplied}|"
                            answer = resume supplied
                            settled := "${settled}4:${label}|"
                            answers := "${answers}${label}:${toString answer}|"
                            answer + 1000 ?: answer
                    in
                        a1 = perform Alpha.alpha "a1"
                        b1 = perform Beta.beta "b1"
                        g1 = perform Gamma.gamma "g1"
                        x1 = perform Delta.delta "x1"
                        x2 = perform Delta.delta "x2"
                        g2 = perform Gamma.gamma "g2"
                        b2 = perform Beta.beta "b2"
                        a2 = perform Alpha.alpha "a2"
                        firstHalf = (a1 + b1 ?: 0) + (g1 + x1 ?: 0) ?: 0
                        secondHalf = (x2 + g2 ?: 0) + (b2 + a2 ?: 0) ?: 0
                        firstHalf + secondHalf ?: 0

    (* Eight operations descend the four depths and climb back out. *)
    checkAll "four nested depths enter in perform order" [
        entered == "1:a1|2:b1|3:g1|4:x1|4:x2|3:g2|2:b2|1:a2|",
        alphaCalls == 2,
        betaCalls == 2,
        gammaCalls == 2,
        deltaCalls == 2
    ]

    (* Deepest live arm first: both Delta suspensions, then both Gamma, then
       both Beta, then both Alpha. The second Alpha suspension was opened LAST
       and settles seventh, because every operation it crossed put its arm
       inside it. Reversing `entered` would instead predict
       `1:a2|2:b2|3:g2|4:x2|4:x1|3:g1|2:b1|1:a1|`. *)
    checkAll "four nested depths settle deepest live arm first" [
        settled == "4:x2|4:x1|3:g2|3:g1|2:b2|2:b1|1:a2|1:a1|"
    ]

    (* Each depth supplies its own power of ten, twice, so a value crossing to a
       neighbouring region would move the body's sum by a whole digit. *)
    checkAll "four nested depths supply distinct magnitudes" [
        supplies == "a1=1|b1=10|g1=100|x1=1000|x2=2000|g2=200|b2=20|a2=2|"
    ]

    (* The staircase: 3333 -> 4333 -> 5333 -> 5433 -> 5533 -> 5543 -> 5553 ->
       5554, one digit per settling depth, in the order the arms unwound — the
       thousands digit first because the Delta arms settle first. *)
    checkAll "four nested depths climb a digit staircase" [
        answers == "x2:3333|x1:4333|g2:5333|g1:5433|b2:5533|b1:5543|a2:5553|a1:5554|"
    ]

    (* Body sum 1111 + 2222 = 3333; the arms then add 2 * (1 + 10 + 100 + 1000). *)
    checkAll "four nested depths total their halves and transforms" [
        total == 5555
    ]

(* Register the four-depth nested settlement audit. *)
test "four nested regions settle by live arm nesting, deepest arm first" nestedDepthFourStaircaseCase

(** Twin gives two nested regions something to divide between them. *)
effect Twin
    (** The inner region claims `near`; the outer arm for it must stay unused. *)
    near : int => int
    (** Only the outer region carries `far`, so it crosses the inner region. *)
    far : int => int

(** One effect, two depths, one partial inner region. Spec 0017's Handlers
    section says "the innermost matching arm wins and an outer arm remains
    available for operations not handled by the inner region", and
    [EFFECTS-STATIC-DISCHARGE] adds that "complementary nested partial handlers
    may each discharge the operation they cover". So `near` is answered by the
    inner region and `far` reaches the outer one while inner suspensions are
    still live — and by [EFFECTS-RESUME-NESTING] each crossing `far` installs
    its arm OUTSIDE the live `near` arms it crossed, so both `near` arms settle
    before either `far` arm does. Settlement is therefore not the reverse of the
    entry order. The unused outer `near` arm supplies a millionfold value, so
    any leak past the inner region is visible. *)
nestedPartialInnerResumeCase () =
    mut outerNear = 0
    mut outerFar = 0
    mut innerNear = 0
    mut entered = ""
    mut settled = ""
    mut supplies = ""
    mut answers = ""

    total =
        handle Twin
            near amount =>
                outerNear := outerNear + 1 ?: outerNear
                supplied = amount * 1000000 ?: amount
                entered := "${entered}OUTERnear:${toString amount}|"
                supplies := "${supplies}N${toString amount}=${toString supplied}|"
                answer = resume supplied
                settled := "${settled}OUTERnear:${toString amount}|"
                answers := "${answers}OUTERnear:${toString answer}|"
                answer
            far amount =>
                outerFar := outerFar + 1 ?: outerFar
                supplied = amount * 1000 ?: amount
                entered := "${entered}far:${toString amount}|"
                supplies := "${supplies}f${toString amount}=${toString supplied}|"
                answer = resume supplied
                settled := "${settled}far:${toString amount}|"
                answers := "${answers}far:${toString answer}|"
                answer * 2 ?: answer
        in
            handle Twin
                near amount =>
                    innerNear := innerNear + 1 ?: innerNear
                    supplied = amount * 10 ?: amount
                    entered := "${entered}near:${toString amount}|"
                    supplies := "${supplies}n${toString amount}=${toString supplied}|"
                    answer = resume supplied
                    settled := "${settled}near:${toString amount}|"
                    answers := "${answers}near:${toString answer}|"
                    answer + 5 ?: answer
            in
                p = perform Twin.near 1
                q = perform Twin.far 2
                r = perform Twin.near 3
                s = perform Twin.far 4
                (p + q ?: 0) + (r + s ?: 0) ?: 0

    (* The inner region answered both `near` operations; the outer one answered
       both `far` operations and never saw a `near`. *)
    checkAll "a partial inner region keeps only its own operation" [
        innerNear == 2,
        outerFar == 2,
        outerNear == 0
    ]

    (* Entry order is the body's order, alternating between the two depths. *)
    checkAll "a crossing operation enters between inner suspensions" [
        entered == "near:1|far:2|near:3|far:4|",
        supplies == "n1=10|f2=2000|n3=30|f4=4000|"
    ]

    (* Both inner `near` arms settle first: each `far` crossed them on its way
       out, so its arm sits outside theirs. Reversing `entered` would predict
       `far:4|near:3|far:2|near:1|` [EFFECTS-RESUME-NESTING]. *)
    checkAll "partial nesting settles its live inner arms first" [
        settled == "near:3|near:1|far:4|far:2|"
    ]

    (* Body sum 10 + 2000 + 30 + 4000 = 6040, then both `near` arms add five and
       both `far` arms double: 6040 -> 6045 -> 6050 -> 12100 -> 24200. *)
    checkAll "partial nesting chains answers across both depths" [
        answers == "near:6040|near:6045|far:6050|far:12100|",
        total == 24200
    ]

(* Register the partial-inner-region settlement audit. *)
test "a partial inner region resumes while its uncovered operation crosses outward" nestedPartialInnerResumeCase

(** Layer is handled twice at two depths, the inner region covering only part of
    the outer body. *)
effect Layer
    (** Supply the value for `label`; the innermost matching arm answers. *)
    pick : string => int

(** The inner region wraps only the middle of the outer body, so it must produce
    a value before the outer body can perform again. Spec 0017 [EFFECTS-RESUME]:
    `resume` "evaluates to that computation's answer", and the answer of the
    inner `handle` expression is a value the outer body consumes — so both inner
    suspensions settle BEFORE the outer region's later operation is even
    performed. Settlement is therefore not the plain reverse of the entry
    transcript: it is reverse order of the live suspension stack. The Handlers
    section supplies the other half: the inner arm shadows the outer one only
    inside its lexical region, and the outer arm is restored after it. *)
sameEffectTwoDepthsCase () =
    mut outerCalls = 0
    mut innerCalls = 0
    mut entered = ""
    mut settled = ""
    mut supplies = ""
    mut answers = ""

    total =
        handle Layer
            pick label =>
                outerCalls := outerCalls + 1 ?: outerCalls
                supplied = outerCalls * 1000 ?: 0
                entered := "${entered}out:${label}|"
                supplies := "${supplies}${label}=${toString supplied}|"
                answer = resume supplied
                settled := "${settled}out:${label}|"
                answers := "${answers}${label}:${toString answer}|"
                answer * 2 ?: answer
        in
            before = perform Layer.pick "before"
            middle =
                handle Layer
                    pick label =>
                        innerCalls := innerCalls + 1 ?: innerCalls
                        supplied = innerCalls * 10 ?: 0
                        entered := "${entered}in:${label}|"
                        supplies := "${supplies}${label}=${toString supplied}|"
                        answer = resume supplied
                        settled := "${settled}in:${label}|"
                        answers := "${answers}${label}:${toString answer}|"
                        answer + 3 ?: answer
                in
                    m1 = perform Layer.pick "in1"
                    m2 = perform Layer.pick "in2"
                    m1 + m2 ?: 0
            after = perform Layer.pick "after"
            (before + middle ?: 0) + after ?: 0

    (* Shadow and restore: the inner arm answered exactly the two operations
       inside its region, the outer arm the one before it and the one after it. *)
    checkAll "an inner region shadows only its own lexical region" [
        outerCalls == 2,
        innerCalls == 2,
        entered == "out:before|in:in1|in:in2|out:after|"
    ]

    (* Each depth kept its own magnitude. Had the inner region failed to shadow,
       the outer counter would have supplied 2000 and 3000 to in1 and in2. *)
    checkAll "two depths of one effect supply their own values" [
        supplies == "before=1000|in1=10|in2=20|after=2000|"
    ]

    (* The inner region settles completely before `after` is performed, so the
       settle transcript is NOT the reverse of the entry transcript. *)
    checkAll "the inner region settles before the outer body continues" [
        settled == "in:in2|in:in1|out:after|out:before|"
    ]

    (* 10 + 20 = 30 is the inner body's answer; the inner arms add three each,
       so the inner region evaluates to 36 and the outer body sums to 3036. *)
    checkAll "the inner region's answer feeds the outer body" [
        answers == "in2:30|in1:33|after:3036|before:6072|",
        total == 12144
    ]

(* Register the same-effect two-depth settlement audit. *)
test "an inner region settles fully before the outer region's later operation" sameEffectTwoDepthsCase
