/// Staged effects: an effect declared `static` is answered by the compiler and
/// leaves nothing behind ([STAGE-DECL], [STAGE-RESIDUE],
/// docs/specs/0035-StagedEffects.md). This suite pins the four consequences —
/// compile-time answers, a GPU kernel that performs an effect, one function
/// serving both stages, and a dynamic effect still behaving exactly as before.
static effect Tile {
    /// The tile edge every kernel scales by; answered at compile time.
    size: fn() -> int
}

/// A second static effect, to prove discharge is per effect and per operation.
static effect Alloc {
    /// Bytes of scratch a stage requests; answered at compile time.
    scratch: fn(int) -> int
}

/// A reactive value is a generic static effect, and its identity is the
/// INSTANTIATION: `Signal<Count>` and `Signal<Cursor>` are two dependencies
/// sharing one declaration, not one dependency ([STAGE-SIGNALS],
/// [STAGE-SIGNALS-EXACT]).
static effect Signal<T> {
    /// The current value of this signal, answered at compile time.
    read: fn() -> T
}

/// One signal's payload. A distinct type per signal is the surface contract
/// [STAGE-SIGNALS-EXACT] states until a dedicated declaration form exists.
type Count = {
    value: int
}

/// A second signal's payload, so the two instantiations are distinguishable.
type Cursor = {
    at: int
}

/// An ordinary runtime effect, unchanged by staging ([STAGE-COMPAT]).
effect Log {
    /// Record one line through whichever handler is active.
    write: fn(string) -> Unit
}

/// A helper reached from a static region: discharge follows calls, not syntax.
fn tiled(n) = (n * perform Tile.size()) ?: 0

/// Two views, each reading exactly one signal. Neither declares a dependency
/// array; the row it carries IS its dependency set ([STAGE-SIGNALS-DIRTY]).
fn counterLabel() = "count: ${(perform Signal<Count>.read()).value}"

fn cursorLabel() = "at: ${(perform Signal<Cursor>.read()).at}"

/// A helper reached from a dynamic region, for the shared-callee case.
fn logged(n) = {
    let next = (n + 1) ?: n
    perform Log.write("step ${n} -> ${next}")
    next
}

/// ONE definition applied in both worlds — the shared function of
/// [STAGE-FALSIFY], with no stage annotation and no stage inference.
fn twice(f, x) = f(f(x))

/// Static handlers answer through helpers, nest, and compose with each other.
fn staticDischargeCase() = {
    let scaled = handle static Tile
        size => 8
    in tiled(2)
    let both = handle static Alloc
        scratch bytes => (bytes * 4) ?: 0
    in handle static Tile
        size => 3
    in "${tiled(5)}/${perform Alloc.scratch(16)}"
    checkAll("static handlers answer at compile time", [
        scaled == 16,
        both == "15/64"
    ])
}

/// The same `twice`, once with a compile-time callback and once with a runtime
/// one. Implements the [STAGE-FALSIFY] gate.
fn sharedAcrossStagesCase() = {
    mut transcript = ""
    let early = handle static Tile
        size => 8
    in twice(tiled, 2)
    let late = handle Log
        write message => { transcript = "${transcript}${message};" }
    in twice(logged, 0)
    checkAll("one function serves both stages", [
        early == 128,
        late == 2,
        transcript == "step 0 -> 1;step 1 -> 2;"
    ])
}

/// A kernel that performs an effect. The purity gate
/// ([GPU-KERNEL-PURE]) sees an empty row because discharge ran first —
/// [STAGE-GPU-LEGAL] needs no separate check.
fn stagedKernelCase() = {
    let scaled = handle static Tile
        size => 3
    in toGpu([1, 2, 3, 4]) |> gpuMap(tiled)
    checkAll("a static effect is legal inside a GPU kernel", [
        gpuFold(scaled, 0, fn(a, v) => (a + v) ?: a) == 30,
        gpuLength(scaled) == 4
    ])
}

/// `kernel` is a handler region, not a magic block: ONE region supplies the
/// static handlers for several device dialects, where `handle` answers exactly
/// one ([STAGE-GPU-KERNEL]). Its body carries the extra obligation that nothing
/// is left to answer at runtime ([STAGE-GPU-LEGAL]).
fn kernelRegionCase() = {
    let frame = kernel
        Tile size => 8
        Alloc scratch bytes => (bytes * 2) ?: 0
    in "${tiled(3)}/${perform Alloc.scratch(16)}"
    checkAll("a kernel region answers several dialects at once", [
        frame == "24/32"
    ])
}

/// Two signals sharing one operation stay two dependencies, so a region
/// answering one leaves the other untouched ([STAGE-SIGNALS-EXACT]).
fn signalIdentityCase() = {
    let labels = handle static Signal<Count>
        read => Count { value: 7 }
    in handle static Signal<Cursor>
        read => Cursor { at: 2 }
    in "${counterLabel()} ${cursorLabel()}"
    checkAll("signal identity is the generic instantiation", [
        labels == "count: 7 at: 2"
    ])
}

test("static handlers are discharged before the program runs", staticDischargeCase)
test("one function serves the static and dynamic stages", sharedAcrossStagesCase)
test("a GPU kernel may perform a static effect", stagedKernelCase)
test("a kernel region supplies its own device dialects", kernelRegionCase)
test("two signal instantiations are two dependencies", signalIdentityCase)
