(** One transformer block written once against a static `Tensor` effect and
    run by two interpretations: a handler over plain lists and a handler over
    GPU buffers. The model never names a buffer type; the handler decides how
    each operation executes, and both answers must agree bit for bit with each
    other and with the oracle values tests/core/gpu/transformer pins.
    Implements [STAGE-BACKEND], [STAGE-POLY], [EFFECTS-GENERIC-INSTANTIATION],
    [GPU-KERNEL-PURE]. *)

namespace backends

(** The statically selected tensor dialect used by both interpretations. *)
module Backends
    (** The dense-tensor dialect a model is written in. `B` is the buffer
        representation an interpretation chooses; the model leaves it to
        inference everywhere. *)
    export static effect Tensor B
        build : (int, (int) -> float) => B
        get : (B, int) => float
        length : B => int
        zipWith : (B, B, (float, float) -> float) => B
        reduce : (B, float, (float, float) -> float) => float
        matMul : (B, B, int, int, int) => B
        fromList : List<float> => B
        device : Unit => string

    (** Every operation as host list code; the product accumulates in k order from 0.0. *)
    export onLists work =
        handle static Tensor<List<float>>
            build n f => range 0 n |> map f |> toList
            get b i => listGet b i ?: 0.0
            length b => listLength b
            zipWith a b f => range 0 (listLength a) |> map (\i => f (listGet a i ?: 0.0, listGet b i ?: 0.0)) |> toList
            reduce b seed f => range 0 (listLength b) |> fold seed (\(a, i) => f (a, listGet b i ?: 0.0))
            matMul a b rows inner cols => range 0 (rows * cols) |> map (\i => range 0 inner |> fold 0.0 (\(acc, k) => acc + (listGet a (intDiv i cols * inner + k) ?: 0.0) * (listGet b (k * cols + i % cols) ?: 0.0))) |> toList
            fromList xs => xs
            device => "lists"
        work ()

    (** Every operation as a GPU kernel or product; the arms forward the model's callbacks. *)
    export onGpu work =
        handle static Tensor<GpuBuffer<float>>
            build n f => toGpu (range (0, n)) |> gpuMap f
            get b i => gpuGet b i ?: 0.0
            length b => gpuLength b
            zipWith a b f => gpuZipWith a b f
            reduce b seed f => b |> gpuFold seed f
            matMul a b rows inner cols => gpuMatMul a b rows inner cols ?: toGpu []
            fromList xs => toGpu xs
            device => gpuDevice ()
        work ()

width = 4
widthF = 4.0
heads = 2
headWidth = 2
qkvWidth = 12
mlpWidth = 8
vocab = 5
epsilon = 0.00001
scoreScale = 0.5
geluScale = 0.7978845608028654
geluCubic = 0.044715
tolerance = 0.000000001

at (m, i) = perform Backends::Tensor.get m i
size m = perform Backends::Tensor.length m
vector xs = perform Backends::Tensor.fromList xs
device () = perform Backends::Tensor.device ()
product (a, b, rows, inner, cols) = perform Backends::Tensor.matMul a b rows inner cols
total b = perform Backends::Tensor.reduce b 0.0 addF
addF (a, x) = a + x
maxF (a, x) = match x > a
    true => x
    false => a
near (actual, expected) = abs (actual - expected) < tolerance
gelu x = 0.5 * x * (1.0 + tanh (geluScale * (x + geluCubic * x * x * x)))

(** Deterministic test weights: ((i * step) % modulus - shift) / scale for element i. *)
weight (n, step, modulus, shift, scale) = perform Backends::Tensor.build n (\i => toFloat ((i * step) % modulus - shift) / scale)
ln1g () = weight (width, 3, 5, 1, 2.0)
ln1b () = weight (width, 5, 7, 3, 4.0)
qkvW () = weight (width * qkvWidth, 7, 11, 5, 8.0)
qkvB () = weight (qkvWidth, 3, 7, 3, 8.0)
projW () = weight (width * width, 5, 13, 6, 8.0)
projB () = weight (width, 7, 5, 2, 4.0)
ln2g () = weight (width, 7, 9, 4, 4.0)
ln2b () = weight (width, 2, 5, 2, 8.0)
fcW () = weight (width * mlpWidth, 11, 13, 6, 8.0)
fcB () = weight (mlpWidth, 5, 11, 5, 8.0)
outW () = weight (mlpWidth * width, 13, 17, 8, 16.0)
outB () = weight (width, 3, 7, 3, 4.0)
tokenTable () = weight (vocab * width, 9, 17, 8, 4.0)
positionTable () = weight (3 * width, 4, 9, 4, 8.0)

sumRange (x, start, n) = range start (start + n) |> fold 0.0 (\(a, i) => a + at (x, i))
squaredDeviation (x, start, n, mean) = range start (start + n) |> fold 0.0 (\(a, i) => a + (at (x, i) - mean) * (at (x, i) - mean))
rowMeans (x, t) = perform Backends::Tensor.build t (\r => sumRange (x, r * width, width) / widthF)
rowVariances (x, t, means) = perform Backends::Tensor.build t (\r => squaredDeviation (x, r * width, width, at (means, r)) / widthF)
normalised (x, means, variances, g, b, i) = (at (x, i) - at (means, intDiv i width)) / sqrt (at (variances, intDiv i width) + epsilon) * at (g, i % width) + at (b, i % width)

(** LayerNorm over each of the t rows of x [t, width]. *)
layerNorm (x, t, g, b) =
    means = rowMeans (x, t)
    variances = rowVariances (x, t, means)
    perform Backends::Tensor.build (t * width) (\i => normalised (x, means, variances, g, b, i))

(** x [rows, inner] times w [inner, cols], plus the bias on every row. *)
linear (x, rows, inner, cols, w, bias) =
    value = product (x, w, rows, inner, cols)
    perform Backends::Tensor.build (rows * cols) (\i => at (value, i) + at (bias, i % cols))

qAt (qkv, r, h, d) = at (qkv, r * qkvWidth + h * headWidth + d)
kAt (qkv, r, h, d) = at (qkv, r * qkvWidth + width + h * headWidth + d)
vAt (qkv, r, h, d) = at (qkv, r * qkvWidth + 2 * width + h * headWidth + d)
score (qkv, h, r, c) = (range 0 headWidth |> fold 0.0 (\(a, d) => a + qAt (qkv, r, h, d) * kAt (qkv, c, h, d))) * scoreScale
causalScore (qkv, h, r, c) = match c <= r
    true => score (qkv, h, r, c)
    false => 0.0
rowMax (scores, row, t) = range 0 (row % t + 1) |> fold (at (scores, row * t)) (\(a, c) => maxF (a, at (scores, row * t + c)))
causalWeight (scores, peaks, t, i) = match i % t <= intDiv i t % t
    true => exp (at (scores, i) - at (peaks, intDiv i t))
    false => 0.0
weighted (probs, qkv, t, r, h, d) = range 0 (r + 1) |> fold 0.0 (\(a, c) => a + at (probs, (h * t + r) * t + c) * vAt (qkv, c, h, d))

(** Softmax of every causal row of the [heads, t, t] scores. *)
probsOf (scores, t) =
    peaks = perform Backends::Tensor.build (heads * t) (\row => rowMax (scores, row, t))
    weights = perform Backends::Tensor.build (heads * t * t) (\i => causalWeight (scores, peaks, t, i))
    sums = perform Backends::Tensor.build (heads * t) (\row => sumRange (weights, row * t, t))
    perform Backends::Tensor.build (heads * t * t) (\i => at (weights, i) / at (sums, intDiv i t))

(** Causal multi-head self-attention over qkv [t, qkvWidth], as [t, width]. *)
attention (qkv, t) =
    probs = probsOf (perform Backends::Tensor.build (heads * t * t) (\i => causalScore (qkv, intDiv i (t * t), intDiv (i % (t * t)) t, i % t)), t)
    perform Backends::Tensor.build (t * width) (\i => weighted (probs, qkv, t, intDiv i width, intDiv (i % width) headWidth, i % headWidth))

(** One pre-norm block: attention and MLP, each with a residual. *)
block (x, t) =
    qkv = linear (layerNorm (x, t, ln1g (), ln1b ()), t, width, qkvWidth, qkvW (), qkvB ())
    x2 = perform Backends::Tensor.zipWith x (linear (attention (qkv, t), t, width, width, projW (), projB ())) addF
    f = linear (layerNorm (x2, t, ln2g (), ln2b ()), t, width, mlpWidth, fcW (), fcB ())
    hidden = perform Backends::Tensor.build (size f) (\i => gelu (at (f, i)))
    perform Backends::Tensor.zipWith x2 (linear (hidden, t, mlpWidth, width, outW (), outB ())) addF

(** Token plus position embeddings of the host-side ids, [t, width]. *)
embed (tokens, positions, ids, t) = perform Backends::Tensor.build (t * width) (\i => at (tokens, (listGet ids (intDiv i width) ?: 0) * width + i % width) + at (positions, i))
blockOutput () = block (embed (tokenTable (), positionTable (), [3, 1], 2), 2)
rendered y = range 0 (size y) |> fold "" (\(acc, i) => acc + " " + toString (at (y, i)))

(** The oracle values of the block, plus which interpretation answered. *)
blockChecks (name, expectedDevice) =
    y = blockOutput ()
    checkAll name [
        size y == 8, device () == expectedDevice,
        near (at (y, 0), -1.6005739040598597), near (at (y, 1), 1.6570609567125532),
        near (at (y, 2), 0.7819120177177687), near (at (y, 3), 2.600026966458822),
        near (at (y, 4), -1.4874618953251921), near (at (y, 5), 0.04813056859620782),
        near (at (y, 6), -0.6083624491502386), near (at (y, 7), 1.4214195552139615),
        near (total y, 2.8121518161640227)
    ]

listsCase () = Backends::onLists (\() => blockChecks ("the block over lists matches the reference pass", "lists"))
gpuCase () = Backends::onGpu (\() => blockChecks ("the same block over GPU buffers matches the reference pass", "host"))

(** Both interpretations print every element identically: the products
    accumulate in the same order, so the answers are the same doubles. *)
agreementCase () =
    lists = Backends::onLists (\() => rendered (blockOutput ()))
    gpu = Backends::onGpu (\() => rendered (blockOutput ()))
    checkAll "both interpretations compute the same doubles" [
        lists == gpu, lists != "", length lists > 8 * 4
    ]

(** A request that leaves its instantiation to inference is answered by the
    innermost region, through helpers that never name a buffer type. *)
inferenceCase () = checkAll "an inferred instantiation selects the innermost region" [
    Backends::onLists (\() => Backends::onGpu device) == "host",
    Backends::onGpu (\() => Backends::onLists device) == "lists",
    Backends::onGpu (\() => at (vector [1.0, 2.0], 1)) == 2.0,
    Backends::onLists (\() => total (vector [1.0, 2.0, 3.0])) == 6.0
]

(** A static arm forwards the model's callback to the kernel it builds: an
    inline lambda, a named function and a closure over a local all run. *)
doubled n = perform Backends::Tensor.build n (\i => toFloat i * 2.0)
scaled (n, scale) = perform Backends::Tensor.build n (\i => toFloat i * scale)
smoothed x = perform Backends::Tensor.build (size x) (\i => gelu (at (x, i)))
forwardedKernelCase () =
    scale = 3.0
    checkAll "a static arm forwards the model's callback to its kernel" [
        Backends::onGpu (\() => at (doubled 3, 2)) == 4.0,
        Backends::onGpu (\() => at (smoothed (vector [1.0, 2.0]), 1)) == gelu 2.0,
        Backends::onGpu (\() => at (scaled (2, scale), 1)) == 3.0,
        Backends::onLists (\() => at (scaled (2, scale), 1)) == 3.0,
        Backends::onGpu (\() => at (product (vector [1.0, 2.0, 3.0, 4.0], vector [5.0, 6.0, 7.0, 8.0], 2, 2, 2), 3)) == 50.0,
        Backends::onLists (\() => at (product (vector [1.0, 2.0, 3.0, 4.0], vector [5.0, 6.0, 7.0, 8.0], 2, 2, 2), 3)) == 50.0
    ]

(** An operation's declared callback type survives discharge inside a generic
    function: a kernel that returns a parameter, or a parameter times a
    literal, is checked against `fn(float, float) -> float` and keeps that type
    in the residual — instead of being re-inferred polymorphic and reading each
    float back as a raw word. *)
firstOf (a, b) = perform Backends::Tensor.zipWith a b (\(g, _x) => g)
secondDoubled (a, b) = perform Backends::Tensor.zipWith a b (\(_g, x) => x * 2.0)
declaredTypes () = "${total (firstOf (doubled 3, scaled (3, 3.0)))} ${total (secondDoubled (doubled 3, scaled (3, 3.0)))}"
declaredTypesCase () = checkAll "a kernel keeps the operation's declared element types inside a generic function" [
    Backends::onGpu declaredTypes == "6.0 18.0",
    Backends::onLists declaredTypes == "6.0 18.0"
]

(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()

test "the block over lists matches the reference pass" (\() => exactArithmetic listsCase)
test "the same block over GPU buffers matches the reference pass" (\() => exactArithmetic gpuCase)
test "both interpretations compute the same doubles" (\() => exactArithmetic agreementCase)
test "an inferred instantiation selects the innermost region" (\() => exactArithmetic inferenceCase)
test "a static arm forwards the model's callback to its kernel" (\() => exactArithmetic forwardedKernelCase)
test "a kernel keeps the operation's declared element types inside a generic function" (\() => exactArithmetic declaredTypesCase)
