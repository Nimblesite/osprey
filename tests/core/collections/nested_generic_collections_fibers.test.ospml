(** Native-only cross-contract oracle. [CONCURRENCY-SPAWN-AWAIT] and
    [CONCURRENCY-CHANNEL] deliberately sequester this file from wasm32, while
    [TYPE-GENERICS-FN], [FLAVOR-ML-GENERICS], [TYPE-LIST], [TYPE-MAP],
    [BUILTIN-LIST-GET], [BUILTIN-MAP-GET], [EFFECTS-GENERIC-INSTANTIATION],
    and [EFFECTS-GENERIC-RUNTIME] define the values crossing those boundaries. *)
effect FiberDepot T
    fetch : string => T

nestedAt<T> : (List (List T), int, int, List T, T) -> T
nestedAt (matrix, row, column, fallbackRow, fallback) =
    listGet (listGet matrix row ?: fallbackRow) column ?: fallback

groupAt<T> : (Map string (List T), string, int, List T, T) -> T
groupAt (groups, key, index, fallbackList, fallback) =
    listGet (mapGet groups key ?: fallbackList) index ?: fallback

intMatrix () = [[1, 2], [3, 4, 5]]
stringMatrix () = [["ant", "bee"], ["cat", "dog", "eel"]]
floatGroups () = Map () |> mapSet "small" [0.5, 1.25] |> mapSet "large" [8.5, 9.75]
boolGroups () = Map () |> mapSet "left" [true, false] |> mapSet "right" [false, true]

(** A channel reached through a PARAMETER is the seam no send-site knowledge
    can cover: the callee sees only the declared `Channel T`, so the element
    representation has to come from inference, and what crossed the wire has to
    be a real collection rather than a literal's flat `{length, data}` header.
    Reading that header as a list ran off the end of a 16-byte block.
    Implements [CONCURRENCY-CHANNEL]. *)
type MatrixHub =
    channel : Channel (List (List int))

drainMatrix : Channel (List (List int)) -> List (List int)
drainMatrix channel = recv channel
drainGroups : Channel (Map string (List float)) -> Map string (List float)
drainGroups channel = recv channel

requestIntMatrix : Unit -> List (List int)
requestIntMatrix () = perform FiberDepot.fetch "ints"
requestBoolGroups : Unit -> Map string (List bool)
requestBoolGroups () = perform FiberDepot.fetch "bools"

fiberEffectIntMatrix () =
    handle FiberDepot
        fetch key => intMatrix ()
    in await (spawn (requestIntMatrix ()))

fiberEffectBoolGroups () =
    handle FiberDepot
        fetch key => boolGroups ()
    in await (spawn (requestBoolGroups ()))

(** A value crosses constructor inference -> nested collection storage -> fiber
    result erasure -> out-of-order await -> channel element erasure -> `Result`
    extraction -> persistent rebuild. This jointly enforces
    [CONCURRENCY-SPAWN-AWAIT], [CONCURRENCY-CHANNEL], [BUILTIN-LIST-GET],
    [BUILTIN-MAP-GET], and [TYPE-GENERICS-FN]. *)
fiberChannelCollectionCase () =
    intFiber = spawn (intMatrix ())
    stringFiber = spawn (stringMatrix ())
    floatFiber = spawn (floatGroups ())
    boolFiber = spawn (boolGroups ())
    strings = await stringFiber
    ints = await intFiber
    bools = await boolFiber
    floats = await floatFiber
    matrixChannel = Channel 2
    groupChannel = Channel 2
    send matrixChannel ints
    send matrixChannel (listAppend ints [6, 7])
    send groupChannel floats
    send groupChannel (mapSet floats "extra" [6.25, 7.5])
    firstMatrix = recv matrixChannel
    secondMatrix = recv matrixChannel
    firstGroups = recv groupChannel
    secondGroups = recv groupChannel
    send matrixChannel secondMatrix
    send groupChannel secondGroups
    matrixViaParameter = drainMatrix matrixChannel
    groupsViaParameter = drainGroups groupChannel
    hub = MatrixHub(channel = Channel 1)
    send hub.channel matrixViaParameter
    matrixViaField = recv hub.channel
    (** ABANDONED on purpose: a managed value that is sent and never received
       still holds the reference `send` transferred to the channel, and nothing
       can hand it back — the runtime's completed-result cleanup walks fibers,
       not channels. Program teardown has to release it, and the ARC corpus
       harness fails this file if a single object survives exit. *)
    abandonedMatrices = Channel 2
    abandonedGroups = Channel 2
    send abandonedMatrices (listAppend matrixViaField [8, 9])
    send abandonedGroups (mapSet floats "orphan" [1.5])

    checkAll "spawn and out-of-order await reconstruct nested collection owners" [
        nestedAt (ints, 0, 0, [99], 99) == 1,
        nestedAt (ints, 0, 1, [99], 99) == 2,
        nestedAt (ints, 1, 0, [99], 99) == 3,
        nestedAt (ints, 1, 2, [99], 99) == 5,
        nestedAt (strings, 0, 0, ["row"], "item") == "ant",
        nestedAt (strings, 0, 1, ["row"], "item") == "bee",
        nestedAt (strings, 1, 0, ["row"], "item") == "cat",
        nestedAt (strings, 1, 2, ["row"], "item") == "eel",
        groupAt (floats, "small", 0, [9.0], 9.5) == 0.5,
        groupAt (floats, "small", 1, [9.0], 9.5) == 1.25,
        groupAt (floats, "large", 1, [9.0], 9.5) == 9.75,
        groupAt (bools, "left", 0, [false], false),
        !(groupAt (bools, "left", 1, [true], true)),
        !(groupAt (bools, "right", 0, [true], true)),
        groupAt (bools, "right", 1, [false], false),
        listLength ints == 2,
        listLength strings == 2,
        mapLength floats == 2,
        mapLength bools == 2,
        fiberDone intFiber == 1,
        fiberDone stringFiber == 1,
        fiberDone floatFiber == 1,
        fiberDone boolFiber == 1
    ]

    checkAll "Channel<collection> round trips full nested descriptors in FIFO order" [
        listLength firstMatrix == 2,
        listLength secondMatrix == 3,
        nestedAt (firstMatrix, 0, 0, [99], 99) == 1,
        nestedAt (firstMatrix, 1, 2, [99], 99) == 5,
        nestedAt (secondMatrix, 0, 0, [99], 99) == 1,
        nestedAt (secondMatrix, 2, 0, [99], 99) == 6,
        nestedAt (secondMatrix, 2, 1, [99], 99) == 7,
        mapLength firstGroups == 2,
        mapLength secondGroups == 3,
        groupAt (firstGroups, "small", 0, [9.0], 9.5) == 0.5,
        groupAt (firstGroups, "large", 1, [9.0], 9.5) == 9.75,
        groupAt (secondGroups, "small", 1, [9.0], 9.5) == 1.25,
        groupAt (secondGroups, "extra", 0, [9.0], 9.5) == 6.25,
        groupAt (secondGroups, "extra", 1, [9.0], 9.5) == 7.5,
        nestedAt (ints, 1, 2, [99], 99) == 5,
        groupAt (floats, "small", 0, [9.0], 9.5) == 0.5,
        listLength ints == 2,
        mapLength floats == 2,
        listLength matrixViaParameter == 3,
        nestedAt (matrixViaParameter, 0, 0, [99], 99) == 1,
        nestedAt (matrixViaParameter, 1, 2, [99], 99) == 5,
        nestedAt (matrixViaParameter, 2, 0, [99], 99) == 6,
        nestedAt (matrixViaParameter, 2, 1, [99], 99) == 7,
        mapLength groupsViaParameter == 3,
        groupAt (groupsViaParameter, "small", 0, [9.0], 9.5) == 0.5,
        groupAt (groupsViaParameter, "extra", 0, [9.0], 9.5) == 6.25,
        groupAt (groupsViaParameter, "extra", 1, [9.0], 9.5) == 7.5,
        listLength matrixViaField == 3,
        nestedAt (matrixViaField, 0, 1, [99], 99) == 2,
        nestedAt (matrixViaField, 1, 2, [99], 99) == 5,
        nestedAt (matrixViaField, 2, 1, [99], 99) == 7
    ]

(** A generic effect is performed inside a spawned body, answered by an
    inherited handler, returned as a fiber result, then fed through persistent
    list/map producers. This jointly enforces [EFFECTS-GENERIC-RUNTIME],
    [CONCURRENCY-SPAWN-AWAIT], [BUILTIN-LIST-APPEND], and [BUILTIN-MAP-SET]. *)
fiberEffectCollectionCase () =
    ints = fiberEffectIntMatrix ()
    bools = fiberEffectBoolGroups ()
    grownInts = ints |> listAppend [6, 7] |> listReverse
    grownBools = bools |> mapSet "extra" [true, false] |> mapRemove "left"

    checkAll "inherited generic handlers preserve collection results from fibers" [
        listLength ints == 2,
        mapLength bools == 2,
        nestedAt (ints, 0, 0, [99], 99) == 1,
        nestedAt (ints, 0, 1, [99], 99) == 2,
        nestedAt (ints, 1, 2, [99], 99) == 5,
        groupAt (bools, "left", 0, [false], false),
        !(groupAt (bools, "left", 1, [true], true)),
        !(groupAt (bools, "right", 0, [true], true)),
        groupAt (bools, "right", 1, [false], false),
        listLength grownInts == 3,
        nestedAt (grownInts, 0, 0, [99], 99) == 6,
        nestedAt (grownInts, 0, 1, [99], 99) == 7,
        nestedAt (grownInts, 2, 0, [99], 99) == 1,
        mapLength grownBools == 2,
        !(mapContains grownBools "left"),
        mapContains grownBools "right",
        mapContains grownBools "extra",
        groupAt (grownBools, "extra", 0, [false], false),
        !(groupAt (grownBools, "extra", 1, [true], true)),
        listLength ints == 2,
        mapContains bools "left",
        !(mapContains bools "extra")
    ]

(* The channel case was parked with a Skip verdict while `Channel<collection>`
    lost its element type in transit: the wire word is a uniform `i64`, `recv`
    never unboxed it back, and a `List<List<int>>` came back readable only as
    `List<int>` — every nested access answered its fallback. `send` now records
    the element on the channel binding and `recv` unboxes to it, and the
    let-bound handle no longer generalizes, so the two ends can no longer
    disagree. Both cases run for real, identically to the Default twin. *)
(** A channel reached through a CLOSURE — passed as a function-value parameter,
    or captured — is the route no declaration covers: a lambda's lowered
    signature is all the callee has, and it carried no return owner, so `recv`'s
    nested descriptor was lost and `listGet` on the result met an `i64` payload
    against an `i8*` default. The program was rejected with `match arms disagree
    on type`, naming no user construct. Implements [CONCURRENCY-CHANNEL],
    [BUILTIN-LIST-GET], [TYPE-GENERICS-FN]. *)
drainVia f channel = f channel

channelThroughClosureCase () =
    matrices = Channel 4
    send matrices (intMatrix ())
    send matrices (listAppend (intMatrix ()) [6, 7])
    viaLambdaParameter = drainVia (\c => recv c) matrices
    takeNext = \() => recv matrices
    viaCapture = takeNext ()
    groups = Channel 2
    send groups (floatGroups ())
    groupsViaLambdaParameter = drainVia (\c => recv c) groups
    checkAll "a channel reached through a closure keeps its element descriptor" [
            listLength viaLambdaParameter == 2,
            nestedAt (viaLambdaParameter, 0, 0, [99], 99) == 1,
            nestedAt (viaLambdaParameter, 0, 1, [99], 99) == 2,
            nestedAt (viaLambdaParameter, 1, 2, [99], 99) == 5,
            listLength (listGet viaLambdaParameter 1 ?: [99]) == 3,
            listLength viaCapture == 3,
            nestedAt (viaCapture, 0, 0, [99], 99) == 1,
            nestedAt (viaCapture, 2, 0, [99], 99) == 6,
            nestedAt (viaCapture, 2, 1, [99], 99) == 7,
            listLength (listGet viaCapture 2 ?: [99]) == 2,
            mapLength groupsViaLambdaParameter == 2,
            groupAt (groupsViaLambdaParameter, "small", 0, [9.0], 9.5) == 0.5,
            groupAt (groupsViaLambdaParameter, "large", 1, [9.0], 9.5) == 9.75
    ]

type Verdict = Pass | Fail string | Skip string

test "fibers channels Results and persistence retain generic collection types" fiberChannelCollectionCase
test "generic effects inside fibers retain nested collection types" fiberEffectCollectionCase
test "a channel reached through a closure keeps its element descriptor" channelThroughClosureCase
