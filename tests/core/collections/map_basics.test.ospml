// ML twin of the assertion-driven persistent Map migration.

// constructionAndOverwriteCase preserves empty, set, contains, overwrite, and source-isolation observations.
constructionAndOverwriteCase () =
    empty = Map ()
    m1 = mapSet empty "alice" 25
    m2 = mapSet m1 "bob" 30
    m3 = mapSet m2 "charlie" 35
    m4 = mapSet m3 "alice" 99
    m4Missing = match mapGet m4 "dave"
        Success value => false
        Error message => message == "mapGet: key not found"

    // Every legacy empty, growth, contains, and overwrite-length observation remains independent.
    checkAll "legacy map construction observations" [
        mapLength empty == 0,
        !(mapContains empty "missing"),
        mapLength m1 == 1,
        mapLength m2 == 2,
        mapLength m3 == 3,
        mapContains m3 "alice",
        mapContains m3 "bob",
        mapContains m3 "charlie",
        !(mapContains m3 "dave"),
        mapLength m4 == 3,
        mapLength m3 == 3
    ]

    // Added value checks ensure correct bindings and persistence rather than length-only success.
    checkAll "map construction values and isolation" [
        (mapGet m1 "alice" ?: (0 - 999)) == 25,
        !(mapContains m1 "bob"),
        (mapGet m2 "alice" ?: (0 - 999)) == 25,
        (mapGet m2 "bob" ?: (0 - 999)) == 30,
        !(mapContains m2 "charlie"),
        (mapGet m3 "alice" ?: (0 - 999)) == 25,
        (mapGet m3 "bob" ?: (0 - 999)) == 30,
        (mapGet m3 "charlie" ?: (0 - 999)) == 35,
        (mapGet m4 "alice" ?: (0 - 999)) == 99,
        (mapGet m4 "bob" ?: (0 - 999)) == 30,
        (mapGet m4 "charlie" ?: (0 - 999)) == 35,
        (mapGet m3 "alice" ?: (0 - 999)) == 25,
        m4Missing
    ]

// generationsAndBranchesCase preserves the five-generation chain and validates sibling branch isolation.
generationsAndBranchesCase () =
    g0 = Map ()
    g1 = mapSet g0 "k1" 1
    g2 = mapSet g1 "k2" 2
    g3 = mapSet g2 "k3" 3
    g4 = mapSet g3 "k4" 4
    g5 = mapSet g4 "k5" 5
    xa = mapSet g3 "X" 100
    xb = mapSet g3 "Y" 200

    // The six generation lengths and every legacy branch-membership result remain asserted.
    checkAll "persistent map generation and branch observations" [
        mapLength g0 == 0,
        mapLength g1 == 1,
        mapLength g2 == 2,
        mapLength g3 == 3,
        mapLength g4 == 4,
        mapLength g5 == 5,
        mapContains g2 "k1",
        !(mapContains g2 "k4"),
        mapContains xa "X",
        !(mapContains xa "Y"),
        !(mapContains xb "X"),
        mapContains xb "Y",
        mapLength g3 == 3
    ]

    // Value-level checks prove old generations retain bindings after descendant creation.
    checkAll "persistent map generation values" [
        !(mapContains g0 "k1"),
        (mapGet g1 "k1" ?: (0 - 999)) == 1,
        !(mapContains g1 "k2"),
        (mapGet g2 "k1" ?: (0 - 999)) == 1,
        (mapGet g2 "k2" ?: (0 - 999)) == 2,
        !(mapContains g2 "k3"),
        (mapGet g3 "k3" ?: (0 - 999)) == 3,
        !(mapContains g3 "k4"),
        (mapGet g4 "k4" ?: (0 - 999)) == 4,
        !(mapContains g4 "k5"),
        (mapGet g5 "k1" ?: (0 - 999)) == 1,
        (mapGet g5 "k5" ?: (0 - 999)) == 5,
        mapLength g2 == 2,
        mapLength g3 == 3
    ]

    // Branch-specific values and absences catch aliasing between siblings and their parent.
    checkAll "persistent map branch values and isolation" [
        (mapGet xa "X" ?: (0 - 999)) == 100,
        (mapGet xb "Y" ?: (0 - 999)) == 200,
        (mapGet xa "k1" ?: (0 - 999)) == 1,
        (mapGet xb "k3" ?: (0 - 999)) == 3,
        !(mapContains xa "Y"),
        !(mapContains xb "X"),
        !(mapContains g3 "X"),
        !(mapContains g3 "Y"),
        mapLength xa == 4,
        mapLength xb == 4
    ]

// removalAndMergeCase preserves removal and merge lengths while adding exact right-biased value checks.
removalAndMergeCase () =
    g0 = Map ()
    g1 = mapSet g0 "k1" 1
    g2 = mapSet g1 "k2" 2
    g3 = mapSet g2 "k3" 3
    g4 = mapSet g3 "k4" 4
    g5 = mapSet g4 "k5" 5
    removed = mapRemove g5 "k3"
    absentRemoved = mapRemove g5 "nonexistent"
    a = mapSet (mapSet (mapSet (Map ()) "x" 1) "y" 2) "z" 3
    b = mapSet (mapSet (mapSet (Map ()) "y" 20) "z" 30) "w" 40
    mergedAB = mapMerge a b
    mergedBA = mapMerge b a
    mergedPlus = a + b
    removedMissing = match mapGet removed "k3"
        Success value => false
        Error message => message == "mapGet: key not found"

    // All four legacy removal observations remain direct predicates.
    checkAll "persistent removal legacy observations" [
        mapLength removed == 4,
        !(mapContains removed "k3"),
        mapContains g5 "k3",
        mapLength absentRemoved == 5
    ]

    // Added removal checks validate retained values, exact failure, original preservation, and absent-key identity behavior.
    checkAll "persistent removal values and isolation" [
        (mapGet removed "k1" ?: (0 - 999)) == 1,
        (mapGet removed "k2" ?: (0 - 999)) == 2,
        (mapGet removed "k4" ?: (0 - 999)) == 4,
        (mapGet removed "k5" ?: (0 - 999)) == 5,
        removedMissing,
        (mapGet g5 "k3" ?: (0 - 999)) == 3,
        (mapGet absentRemoved "k1" ?: (0 - 999)) == 1,
        (mapGet absentRemoved "k5" ?: (0 - 999)) == 5,
        mapContains absentRemoved "k3",
        !(mapContains g4 "k5")
    ]

    // Every legacy merge length, operator-alias, membership, and identity observation remains asserted.
    checkAll "map merge legacy observations" [
        mapLength mergedAB == 4,
        mapLength mergedBA == 4,
        mapLength mergedPlus == 4,
        mapContains mergedAB "w",
        mapLength (mapMerge (Map ()) a) == 3,
        mapLength (mapMerge a a) == 3
    ]

    // Exact lookups pin right-biased merge semantics in both directions and through the plus alias.
    checkAll "map merge right-biased values" [
        (mapGet mergedAB "x" ?: (0 - 999)) == 1,
        (mapGet mergedAB "y" ?: (0 - 999)) == 20,
        (mapGet mergedAB "z" ?: (0 - 999)) == 30,
        (mapGet mergedAB "w" ?: (0 - 999)) == 40,
        (mapGet mergedBA "x" ?: (0 - 999)) == 1,
        (mapGet mergedBA "y" ?: (0 - 999)) == 2,
        (mapGet mergedBA "z" ?: (0 - 999)) == 3,
        (mapGet mergedBA "w" ?: (0 - 999)) == 40,
        (mapGet mergedPlus "x" ?: (0 - 999)) == 1,
        (mapGet mergedPlus "y" ?: (0 - 999)) == 20,
        (mapGet mergedPlus "z" ?: (0 - 999)) == 30,
        (mapGet mergedPlus "w" ?: (0 - 999)) == 40,
        (mapGet a "y" ?: (0 - 999)) == 2,
        (mapGet b "y" ?: (0 - 999)) == 20
    ]

// viewsAndCrossCollectionCase preserves keys, values, and list/map coexistence observations.
viewsAndCrossCollectionCase () =
    g0 = Map ()
    g1 = mapSet g0 "k1" 1
    g2 = mapSet g1 "k2" 2
    g3 = mapSet g2 "k3" 3
    g4 = mapSet g3 "k4" 4
    g5 = mapSet g4 "k5" 5
    keys = mapKeys g5
    values = mapValues g5
    xs = listAppend (listAppend (listAppend (List ()) 100) 200) 300
    xs2 = listAppend xs 400
    mm2 = mapSet g3 "d" 4

    // The three legacy view lengths and five cross-collection lengths remain independent.
    checkAll "map views and cross-collection legacy lengths" [
        listLength keys == 5,
        listLength values == 5,
        listLength (mapKeys (Map ())) == 0,
        listLength xs2 == 4,
        mapLength mm2 == 4,
        listLength xs == 3,
        mapLength g3 == 3,
        listLength (mapKeys g3 + xs) == 6
    ]

    // Key and value membership checks validate view content without assuming hash iteration order.
    checkAll "map key and value view contents" [
        listContains keys "k1",
        listContains keys "k2",
        listContains keys "k3",
        listContains keys "k4",
        listContains keys "k5",
        !(listContains keys "missing"),
        listContains values 1,
        listContains values 2,
        listContains values 3,
        listContains values 4,
        listContains values 5,
        !(listContains values 99)
    ]

    // Added cross-collection checks prove list and map descendants remain isolated from both source structures.
    checkAll "list and map cross-collection isolation" [
        (listGet xs 0 ?: (0 - 999)) == 100,
        (listGet xs 2 ?: (0 - 999)) == 300,
        (listGet xs2 3 ?: (0 - 999)) == 400,
        !(listContains xs 400),
        (mapGet mm2 "d" ?: (0 - 999)) == 4,
        !(mapContains g3 "d"),
        (mapGet g3 "k3" ?: (0 - 999)) == 3,
        (mapGet g5 "k5" ?: (0 - 999)) == 5,
        mapLength g5 == listLength keys,
        mapLength g5 == listLength values
    ]

// literalsAndDispatchCase preserves literal lookup, duplicate-key, and receiver-directed builtin behavior.
literalsAndDispatchCase () =
    empty = Map ()
    prices = ["apple" => 2, "banana" => 3, "cherry" => 5]
    duplicate = ["key" => 1, "key" => 2]
    priceMissing = match mapGet prices "mango"
        Success value => false
        Error message => message == "mapGet: key not found"

    // All three legacy literal lookup outcomes remain asserted with exact missing-key behavior.
    checkAll "map literal lookup behavior" [
        (mapGet prices "apple" ?: (0 - 999)) == 2,
        priceMissing,
        (mapGet duplicate "key" ?: (0 - 999)) == 2,
        (mapGet prices "banana" ?: (0 - 999)) == 3,
        (mapGet prices "cherry" ?: (0 - 999)) == 5,
        (["apple" => 2, "banana" => 3]["apple"] ?: (0 - 999)) == 2,
        (["key" => 1, "key" => 2]["key"] ?: (0 - 999)) == 2,
        mapLength prices == 3,
        mapLength duplicate == 1,
        mapContains duplicate "key"
    ]

    // The old composite bare-length row is split into constituent map assertions.
    checkAll "receiver-directed map length dispatch" [
        length prices == 3,
        length duplicate == 1,
        length empty == 0
    ]

    // The old composite bare-isEmpty row is split and extended across literal and derived maps.
    checkAll "receiver-directed map isEmpty dispatch" [
        isEmpty empty,
        !(isEmpty prices),
        !(isEmpty duplicate),
        isEmpty (mapRemove duplicate "key")
    ]

// Register empty, set, overwrite, and source-isolation behavior.
test "maps construct, overwrite, and retain source bindings" constructionAndOverwriteCase

// Register generation-chain and sibling-branch persistence behavior.
test "map generations and sibling branches remain isolated" generationsAndBranchesCase

// Register persistent removal and right-biased merge behavior.
test "map removal and merge preserve values and bias" removalAndMergeCase

// Register key/value views beside independent persistent lists.
test "map views and list interactions preserve both collections" viewsAndCrossCollectionCase

// Register literal lookup, duplicate keys, and receiver-directed dispatch.
test "map literals and receiver dispatch preserve lookup semantics" literalsAndDispatchCase
