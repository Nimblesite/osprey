(** ML pipe-side oracle for the receiver-first call contract in
    [BUILTIN-STRING-UFCS] and [BUILTIN-ITER-PIPE], crossed with [TYPE-LIST],
    [TYPE-MAP], [BUILTIN-LIST-GET], [BUILTIN-MAP-GET],
    [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
    ML deliberately has no dot-UFCS surface; its `value |> function args`
    form must remain semantically identical to Default `value.function(args)`. *)
effect CallSupply T
    groups : Unit => Map string (List T)

intGroups () = Map () |> mapSet "low" [1, 2] |> mapSet "high" [30, 40, 50]
stringGroups () = Map () |> mapSet "short" ["a", "bb"] |> mapSet "long" ["three", "seven"]

requestIntGroups : Unit -> Map string (List int)
requestIntGroups () = perform CallSupply.groups ()
requestStringGroups : Unit -> Map string (List string)
requestStringGroups () = perform CallSupply.groups ()

suppliedInts () =
    handle CallSupply
        groups => intGroups ()
    in requestIntGroups ()

suppliedStrings () =
    handle CallSupply
        groups => stringGroups ()
    in requestStringGroups ()

groupAt<T> : (Map string (List T), string, int, List T, T) -> T
groupAt (groups, key, index, fallbackList, fallback) =
    (groups |> mapGet key ?: fallbackList) |> listGet index ?: fallback

(** One call chain crosses generic effect erasure, Map<string,List<T>> lookup,
    `Result` recovery, persistent operations, view conversion, reversal, and
    leaf extraction. This jointly enforces [BUILTIN-ITER-PIPE],
    [EFFECTS-GENERIC-RUNTIME], [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET]. *)
receiverFirstCollectionCase () =
    ints = suppliedInts ()
    strings = suppliedStrings ()
    high = ints |> mapGet "high" ?: [99]
    long = strings |> mapGet "long" ?: ["missing"]
    grownInts = ints |> mapSet "extra" [6, 7] |> mapRemove "low"
    grownStrings = strings |> mapSet "long" ["eight", "nine"]
    intValues = ints |> mapValues |> listReverse
    stringKeys = strings |> mapKeys |> listReverse

    checkAll "ML receiver-first pipes preserve nested generic descriptors" [
        (ints |> mapLength) == mapLength ints,
        (ints |> length) == 2,
        !((ints |> isEmpty)),
        (strings |> mapLength) == 2,
        (strings |> length) == 2,
        !((strings |> isEmpty)),
        (high |> listLength) == 3,
        (high |> length) == 3,
        !((high |> isEmpty)),
        (high |> listGet 0 ?: 99) == 30,
        (high |> listGet 1 ?: 99) == 40,
        (high |> listGet 2 ?: 99) == 50,
        (long |> listLength) == 2,
        (long |> listGet 0 ?: "missing") == "three",
        (long |> listGet 1 ?: "missing") == "seven",
        length (long |> listGet 0 ?: "missing") == 5,
        groupAt (ints, "low", 0, [91], 99) == 1,
        groupAt (ints, "low", 1, [91], 99) == 2,
        groupAt (strings, "short", 0, ["row"], "item") == "a",
        groupAt (strings, "short", 1, ["row"], "item") == "bb"
    ]

    checkAll "pipe chains preserve persistence views and source isolation" [
        mapLength grownInts == 2,
        !(mapContains grownInts "low"),
        mapContains grownInts "high",
        mapContains grownInts "extra",
        groupAt (grownInts, "high", 2, [91], 99) == 50,
        groupAt (grownInts, "extra", 0, [91], 99) == 6,
        groupAt (grownInts, "extra", 1, [91], 99) == 7,
        mapContains ints "low",
        !(mapContains ints "extra"),
        mapLength grownStrings == 2,
        groupAt (grownStrings, "long", 0, ["row"], "item") == "eight",
        groupAt (grownStrings, "long", 1, ["row"], "item") == "nine",
        groupAt (strings, "long", 0, ["row"], "item") == "three",
        listLength intValues == 2,
        listLength (listGet intValues 0 ?: [99]) >= 2,
        listLength (listGet intValues 1 ?: [99]) >= 2,
        listLength stringKeys == 2,
        listContains stringKeys "short",
        listContains stringKeys "long",
        !(listContains stringKeys "missing"),
        ((Map () |> mapSet "one" [1] |> mapGet "one" ?: [99]) |> listGet 0 ?: 99) == 1,
        ((List () |> listAppend [8, 9] |> listGet 0 ?: [99]) |> listGet 1 ?: 99) == 9
    ]

test "receiver-first collection call syntax composes over nested generics" receiverFirstCollectionCase
