// ML twin for unary, abs, Result chains, first-error propagation, defaults, and matches.
// Every Result is discharged by an exhaustive match or an explicit `?:` fallback —
// never implicitly unwrapped ([FAILURE-EXPLICIT]). The wasm32 corpus run pins the
// 32-bit Result repack path byte-for-byte ([WASM-TARGET-WIDTH]).
// Observer helpers rely on inference and every test remains independently named.

observeArithmeticResult001 () = match 10 + 3
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult002 () = match 20 + 4
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult003 () = match 30 + 5
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult004 () = match 40 + 6
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult005 () = match 50 + 7
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult006 () = match 6 / 0
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult007 () = match 9223372036854775807 + 7
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult008 () = match 8 / 0
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult009 () = match 9223372036854775807 + 9
    Success value => "value=${toString value}"
    Error message => "error=${message}"

observeArithmeticResult010 () = match 10 / 0
    Success value => "value=${toString value}"
    Error message => "error=${message}"

test "unary negation 001" (\() => check "unary negation 001" "-1" (toString (-1)))
test "double unary negation 001" (\() => check "double unary negation 001" "1" (toString (--1)))
test "unary negation 002" (\() => check "unary negation 002" "-2" (toString (-2)))
