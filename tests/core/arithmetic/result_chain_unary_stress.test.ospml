(** Negating a LITERAL folds to the literal and stays a plain int, so `-1` is
    usable wherever an int is required. Negating a runtime VALUE stays checked,
    because `-i64::MIN` genuinely overflows. [ARITH-NEG-LITERAL], [ARITH-CHECKED] *)
negateValue n = -n

test "literal negation is a plain int" (\() => check "literal negation is a plain int" "-7" (toString (-7)))
test "runtime negation stays a Result" (\() => check "runtime negation stays a Result" "Success(-7)" (toString (negateValue 7)))
