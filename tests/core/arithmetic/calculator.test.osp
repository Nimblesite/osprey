/// Adds two integers through curried application.
fn add(a: int) -> (int) -> int = fn(b) => a + b ?: 0
/// Doubles an integer for reusable pipeline stages.
fn double(x) = x * 2 ?: 0
/// Classifies an integer through modulo Result unwrapping and boolean matching.
fn parity(n) = match (n % 2 ?: 1) == 0 {
    true => "even"
    false => "odd"
}

/// Checks positive, negative, nested, boundary, and relational arithmetic together.
fn additionCase() = {
    let subtotal = add(10)(20)
    // One batch keeps seven independent arithmetic assertions compact.
    checkAll("addition state", [
        add(2)(3) == 5,
        add((0 - 1) ?: 0)(1) == 0,
        add(subtotal)((0 - 5) ?: 0) == 25,
        add(0)(0) == 0,
        add(1000)((0 - 250) ?: 0) == 750,
        add(4)(5) > add(2)(3),
        !(add((0 - 2) ?: 0)(1) > 0)
    ])
}

/// Checks chained functions, inline lambdas, negatives, and derived predicates.
fn pipelineCase() = {
    let six = 3 |> double
    // Every condition is reported separately even though the syntax is grouped.
    checkAll("pipeline state", [
        (10 |> double |> double) == 40,
        (5 |> fn(x) => x + 100 ?: 0) == 105,
        (six |> fn(x) => add(x)(4)) == 10,
        (((0 - 2) ?: 0) |> double |> double) == ((0 - 8) ?: 0),
        (6 |> double |> fn(x) => x == 12),
        (1 |> double |> double) > 0
    ])
}

/// Checks pattern branches alongside computed inputs and interpolation.
fn patternCase() = {
    // The batch covers both branches and several cross-feature compositions.
    checkAll("pattern state", [
        parity(4) == "even",
        parity(7) == "odd",
        parity(add(5)(5)) == "even",
        "${parity(3)}:${double(3)}" == "odd:6",
        parity(double(9)) == "even",
        parity(3) != parity(4)
    ])
}

// Register the mixed arithmetic interaction.
test("arithmetic composes across calls", additionCase)
// Register the multi-stage pipeline interaction.
test("pipes and lambdas compose", pipelineCase)
// Register the matching and rendering interaction.
test("matching, interpolation and calls interact", patternCase)
