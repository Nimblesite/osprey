test("maximum plus one overflows", fn() => check("maximum plus one overflows", "Error(integer overflow)", toString(9223372036854775807 + 1)))
test("maximum times two overflows", fn() => check("maximum times two overflows", "Error(integer overflow)", toString(9223372036854775807 * 2)))
test("square above signed root overflows", fn() => check("square above signed root overflows", "Error(integer overflow)", toString(3037000500 * 3037000500)))
test("minimum minus one overflows", fn() => check("minimum minus one overflows", "Error(integer overflow)", toString((((0 - 9223372036854775807) - 1)) - 1)))
test("minimum times negative one overflows", fn() => check("minimum times negative one overflows", "Error(integer overflow)", toString((((0 - 9223372036854775807) - 1)) * -1)))
test("negating minimum overflows", fn() => check("negating minimum overflows", "Error(integer overflow)", toString(-(((0 - 9223372036854775807) - 1)))))
test("absolute minimum overflows", fn() => check("absolute minimum overflows", "Error(integer overflow)", toString(abs(((((0 - 9223372036854775807) - 1)) ?: 0)))))
test("minimum remainder negative one is representable", fn() => check("minimum remainder negative one is representable", "Success(0)", toString((((0 - 9223372036854775807) - 1)) % -1)))
test("minimum remainder one is zero", fn() => check("minimum remainder one is zero", "Success(0)", toString((((0 - 9223372036854775807) - 1)) % 1)))
test("minimum float division by negative one is finite", fn() => check("minimum float division by negative one is finite", "Success(9.223372036854776e+18)", toString((((0 - 9223372036854775807) - 1)) / -1)))
test("integer division minimum by negative one overflows", fn() => check("integer division minimum by negative one overflows", "Error(integer overflow)", toString(intDiv((((0 - 9223372036854775807) - 1)) ?: 0, (0 - 1) ?: 0))))
test("integer division minimum by one succeeds", fn() => check("integer division minimum by one succeeds", "Success(-9223372036854775808)", toString(intDiv((((0 - 9223372036854775807) - 1)) ?: 0, 1))))
test("checkedAdd success", fn() => check("checkedAdd success", "Success(5)", toString(checkedAdd(2, 3))))
test("checkedSub negative success", fn() => check("checkedSub negative success", "Success(-1)", toString(checkedSub(2, 3))))
test("checkedMul success", fn() => check("checkedMul success", "Success(42)", toString(checkedMul(6, 7))))
test("checkedAdd maximum overflow", fn() => check("checkedAdd maximum overflow", "Error(integer overflow)", toString(checkedAdd(9223372036854775807, 1))))
test("checkedSub minimum overflow", fn() => check("checkedSub minimum overflow", "Error(integer overflow)", toString(checkedSub((((0 - 9223372036854775807) - 1)) ?: 0, 1))))
test("checkedMul wide overflow", fn() => check("checkedMul wide overflow", "Error(integer overflow)", toString(checkedMul(4294967296, 4294967296))))
test("checkedAdd reaches maximum", fn() => check("checkedAdd reaches maximum", "Success(9223372036854775807)", toString(checkedAdd(9223372036854775806, 1))))
test("checkedSub reaches minimum", fn() => check("checkedSub reaches minimum", "Success(-9223372036854775808)", toString(checkedSub(((((0 - 9223372036854775807) - 1)) + 1) ?: 0, 1))))
test("checkedMul maximum identity", fn() => check("checkedMul maximum identity", "Success(9223372036854775807)", toString(checkedMul(9223372036854775807, 1))))
test("checkedMul minimum identity", fn() => check("checkedMul minimum identity", "Success(-9223372036854775808)", toString(checkedMul((((0 - 9223372036854775807) - 1)) ?: 0, 1))))
