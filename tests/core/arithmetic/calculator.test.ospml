(** Add two integers; the caller's `Arith` policy answers an overflow.
# Examples
```osprey
wrapping = handler Arith
    overflow _ _ _ wrapped => wrapped
print "${wrapping (\() => add (2, 3))}"
```
```output
5
```
```osprey
saturating = handler Arith
    overflow _ _ _ _ => 9223372036854775807
total = saturating (\() => add (1, 2))
```
*)
add (a, b) = a + b
(** Double an integer for pipeline stages.
# Examples
```osprey
wrapping = handler Arith
    overflow _ _ _ wrapped => wrapped
print "${wrapping (\() => double 3)}"
```
```output
6
```
*)
double x = x * 2
(** Classify an integer through total modulo and boolean matching. *)
parity n =
    match n % 2 == 0
        true => "even"
        false => "odd"

(** Exercise positive, negative, nested, and relational arithmetic. *)
additionCase () =
    subtotal = add (10, 20)
    // Check arithmetic values and ordering.
    checkAll "addition state" [
        add (2, 3) == 5,
        add (-1, 1) == 0,
        add (subtotal, -5) == 25,
        add (0, 0) == 0,
        add (1000, -250) == 750,
        add (4, 5) > add (2, 3),
        !(add (-2, 1) > 0)
    ]

(** Exercise pipelines, lambdas, negatives, and derived predicates. *)
pipelineCase () =
    six = 3 |> double
    // Check every pipeline stage independently.
    checkAll "pipeline state" [
        (10 |> double |> double) == 40,
        (5 |> \x => x + 100) == 105,
        (six |> \x => add (x, 4)) == 10,
        (-2 |> double |> double) == -8,
        (6 |> double |> \x => x == 12),
        (1 |> double |> double) > 0
    ]

(** Exercise both parity branches with calls and interpolation. *)
patternCase () =
    // Check branch selection and composed results.
    checkAll "pattern state" [
        parity 4 == "even",
        parity 7 == "odd",
        parity (add (5, 5)) == "even",
        "${parity 3}:${double 3}" == "odd:6",
        parity (double 9) == "even",
        parity 3 != parity 4
    ]

(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic = handler Arith
    overflow op _ _ wrapped =>
        check "unexpected arithmetic overflow" "none" op
        wrapped

test "arithmetic composes across calls" (\() => exactArithmetic additionCase)
test "pipes and lambdas compose" (\() => exactArithmetic pipelineCase)
test "matching, interpolation and calls interact" (\() => exactArithmetic patternCase)
