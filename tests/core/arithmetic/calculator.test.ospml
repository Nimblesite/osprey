add (a, b) = a + b
double x = x * 2
parity n =
    match n % 2 == 0
        true => "even"
        false => "odd"

additionCase () =
    expect (add (2, 3)) 5
    expect (add (-1, 1)) 0
    subtotal = add (10, 20)
    expect (add (subtotal, -5)) 25
    expect (add (0, 0)) 0
    expect (add (1000, -250)) 750
    expectTrue (add (4, 5) > add (2, 3))
    expectFalse (add (-2, 1) > 0)

pipelineCase () =
    expect (10 |> double |> double) 40
    expect (5 |> \x => x + 100) 105
    six = 3 |> double
    expect (six |> \x => add (x, 4)) 10
    expect (-2 |> double |> double) (0 - 8)
    check "pipe into comparison" true (6 |> double |> \x => x == 12)
    checkTrue "pipeline remains positive" (1 |> double |> double > 0)

patternCase () =
    expect (parity 4) "even"
    expect (parity 7) "odd"
    expect (parity (add (5, 5))) "even"
    expect "${parity 3}:${double 3}" "odd:6"
    checkTrue "even result is stable" (parity (double 9) == "even")
    checkFalse "odd and even labels differ" (parity 3 == parity 4)

test "arithmetic composes across calls" additionCase
test "pipes and lambdas compose" pipelineCase
test "matching, interpolation and calls interact" patternCase
