test("overflow precedes division error 001", fn() => check("overflow precedes division error 001", "Error(integer overflow)", toString((9223372036854775807 + 1) + (1 / 0))))
test("remainder error precedes overflow 001", fn() => check("remainder error precedes overflow 001", "Error(division by zero)", toString((1 % 0) * (9223372036854775807 + 1))))
test("multiply overflow precedes remainder error 001", fn() => check("multiply overflow precedes remainder error 001", "Error(integer overflow)", toString((9223372036854775807 * 2) % 0)))
test("division error precedes multiply overflow 001", fn() => check("division error precedes multiply overflow 001", "Error(division by zero)", toString((1 / 0) + (9223372036854775807 * 2))))
test("late maximum overflow short circuits right error 001", fn() => check("late maximum overflow short circuits right error 001", "Error(integer overflow)", toString(((9223372036854775807 - 1) + 1 + 1) * (1 % 0))))
test("overflow precedes division error 002", fn() => check("overflow precedes division error 002", "Error(integer overflow)", toString((9223372036854775807 + 2) + (2 / 0))))
test("remainder error precedes overflow 002", fn() => check("remainder error precedes overflow 002", "Error(division by zero)", toString((2 % 0) * (9223372036854775807 + 2))))
