test("mixed integer Result chain 001", fn() => check("mixed integer Result chain 001", "Success(9)", toString((((11 + 3) * 4 - 1) % 6) + 8)))
test("mixed integer Result chain 002", fn() => check("mixed integer Result chain 002", "Success(10)", toString((((12 + 4) * 5 - 2) % 7) + 9)))
