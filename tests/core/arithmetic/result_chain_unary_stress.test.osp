test("division error precedes multiply overflow 002", fn() => check("division error precedes multiply overflow 002", "Error(division by zero)", toString((2 / 0) + (9223372036854775807 * 2))))
test("late maximum overflow short circuits right error 002", fn() => check("late maximum overflow short circuits right error 002", "Error(integer overflow)", toString(((9223372036854775807 - 2) + 2 + 1) * (2 % 0))))
