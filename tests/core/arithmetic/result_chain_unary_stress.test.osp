test("absolute positive 001", fn() => check("absolute positive 001", "Success(1)", toString(abs(1))))
test("absolute negative 001", fn() => check("absolute negative 001", "Success(1)", toString(abs((-1) ?: 0))))
test("absolute positive 002", fn() => check("absolute positive 002", "Success(2)", toString(abs(2))))
