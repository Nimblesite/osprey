// Unary, abs, mixed Result chains, first-error propagation, defaults, and matches.
// Observer helpers omit needless return annotations and each test remains independently named.

fn observeArithmeticResult001() = match 10 + 3 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult002() = match 20 + 4 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult003() = match 30 + 5 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult004() = match 40 + 6 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult005() = match 50 + 7 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult006() = match 6 / 0 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult007() = match 9223372036854775807 + 7 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult008() = match 8 / 0 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult009() = match 9223372036854775807 + 9 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

fn observeArithmeticResult010() = match 10 / 0 {
    Success { value } => "value=${toString(value)}"
    Error { message } => "error=${message}"
}

test("unary negation 001", fn() => check("unary negation 001", "Success(-1)", toString(-1)))
test("double unary negation 001", fn() => check("double unary negation 001", "Success(1)", toString(--1)))
