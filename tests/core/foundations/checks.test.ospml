(** Subtract two integers through a curried call. *)
sub : int -> int -> int
sub a b = a - b ?: 0
(** Classify exact integers before the wildcard case. *)
classify 0 = "zero"
classify 1 = "one"
classify _ = "many"

(** Exercise arithmetic values and relational properties. *)
arithmeticCase () =
    // Check results and ordering independently.
    checkAll "arithmetic foundations" [
        sub 7 3 == 4,
        (6 * 7 ?: 0) == 42,
        sub 20 (2 * 4 ?: 0) == 12,
        sub 8 3 > 4,
        sub 100 1 > 0,
        sub 9 4 != sub 4 9
    ]

(** Exercise every classification clause with literal and computed inputs. *)
classifyCase () =
    // Check exact clauses, the wildcard, and a string consumer.
    checkAll "classification foundations" [
        classify 0 == "zero",
        classify 1 == "one",
        classify 9 == "many",
        classify (sub 4 3) == "one",
        startsWith (classify 20) "m",
        classify 99 != classify 0
    ]

(** Exercise strings, fallible operations, and list state together. *)
stringsAndListsCase () =
    // Check the combined standard-library behavior.
    checkAll "string and list foundations" [
        contains "talon bank" "bank",
        (repeat "ab" 3 ?: "") == "ababab",
        trim "  Osprey  " == "Osprey",
        toUpperCase "Osprey" == "OSPREY",
        startsWith "osprey language" "osprey",
        !(endsWith "osprey language" "compiler"),
        listLength [10, 20, 30] == 3
    ]

test "arithmetic checks share derived values" arithmeticCase
test "classification checks include computed inputs" classifyCase
test "strings and lists mix with matching" stringsAndListsCase
