(** Model three exhaustive priority levels. *)
type Pri = Low | Med | High
(** Model three colors for independent clause groups. *)
type Color = Red | Green | Blue
(** Carry one positional integer payload. *)
type Wrapped = Wrapped int

(** Convert each priority to its weight. *)
priWeight Low = 1
priWeight Med = 5
priWeight High = 9
(** Convert each color to its display name. *)
colorName Red = "red"
colorName Green = "green"
colorName Blue = "blue"
(** Call a function declared later in the file. *)
callerOfLater _ = calleeLater 10
(** Supply the forward-referenced arithmetic implementation. *)
calleeLater n = n * 4 ?: 0

(** Parse an integer or use the caller's fallback. *)
parseOr : string -> int -> int
parseOr text fallback = parseInt text ?: fallback
(** Render both parse Result branches. *)
parseStatus text = match parseInt text
    Success value => "parsed ${value}"
    Error message => "parseInt rejected ${text}"

(** Add an integer through handled state. *)
effect Counter
    (** Advance the counter the handler owns. *)
    increment : int => Unit

(** Exercise unions, Results, interpolation, arithmetic, and ordering. *)
unionsResultsAndScalars () =
    wrapped = Wrapped 42
    wrappedValue = match wrapped
        Wrapped n => n
    // Check union, Result, and scalar state.
    checkAll "union/result/scalar state" [
        "=== omnibus ===" == "=== omnibus ===",
        priWeight High == 9,
        priWeight Med == 5,
        priWeight Low == 1,
        "${colorName Green} wrapped ${wrappedValue}" == "green wrapped 42",
        "next ${25 + 1} half ${25 / 2}" == "next Success(26) half Success(12.5)",
        1.5 == 1.5,
        parseStatus "oops" == "parseInt rejected oops",
        parseStatus "123" == "parsed 123",
        parseOr "oops" 77 == 77,
        parseOr "123" 77 == 123,
        priWeight High > priWeight Med && priWeight Med > priWeight Low,
        colorName Red != colorName Blue
    ]

(** Exercise forward calls, lambdas, pipelines, and union-derived data. *)
functionsPipesAndBooleans () =
    chained = 5 |> (\x => x + 100 ?: 0) |> (\x => x * 2 ?: 0)
    single = 7 |> \x => x * 3 ?: 0
    // Check function, pipeline, and boolean state.
    checkAll "function/pipe/boolean state" [
        5 == 5,
        5 != 6,
        "hi" + " " + "world" == "hi world",
        "forward call -> ${callerOfLater 0}" == "forward call -> 40",
        chained == 210,
        single == 21,
        (5 |> \x => x + 100 ?: 0) == 105,
        callerOfLater 999 == callerOfLater ((0 - 1) ?: 0),
        chained > single,
        (single + priWeight Med ?: 0) == 26
    ]

(** Exercise handled mutation beside persistent collections and lookup. *)
effectsAndCollections () =
    mut counter = 0
    // Check state before handling effects.
    checkAll "effect precondition" [counter == 0]
    handle Counter
        increment amount =>
            counter := counter + amount ?: counter
    in
        perform Counter.increment 1
        perform Counter.increment 1
        perform Counter.increment 1
    xs = listAppend (listAppend (listAppend (List ()) 10) 20) 30
    ys = listAppend (List ()) 99
    combined = xs + ys
    m = mapSet (mapSet (Map ()) "a" 1) "b" 2
    scoreAtOne = [85, 92, 78][1] ?: ((0 - 1) ?: 0)
    bananaPrice = ["apple" => 2, "banana" => 3]["banana"] ?: ((0 - 1) ?: 0)
    // Check post-handler and collection state.
    checkAll "effect/collection state" [
        "counter ${counter}" == "counter 3",
        counter == 3,
        "list len ${listLength combined}" == "list len 4",
        "contains 20 ${listContains xs 20}" == "contains 20 true",
        listContains xs 20,
        listLength xs == 3,
        listLength ys == 1,
        listLength combined == 4,
        "map len ${mapLength m}" == "map len 2",
        "map has a ${mapContains m "a"}" == "map has a true",
        mapContains m "a",
        !(mapContains m "missing"),
        "scores[1] ${scoreAtOne}" == "scores[1] 92",
        scoreAtOne == 92,
        "banana ${bananaPrice}" == "banana 3",
        bananaPrice == 3,
        ([85, 92, 78][9] ?: ((0 - 1) ?: 0)) == ((0 - 1) ?: 0),
        (["apple" => 2]["pear"] ?: ((0 - 1) ?: 0)) == ((0 - 1) ?: 0)
    ]

(** Exercise string transforms over values from other features. *)
stringInteractions () =
    s = "  Hello  "
    // Check string and cross-feature composition.
    checkAll "string/composed state" [
        trim s == "Hello",
        toUpperCase s == "  HELLO  ",
        length s == 9,
        toUpperCase (trim s) == "HELLO",
        startsWith s "  ",
        !(startsWith (trim s) " "),
        "${toUpperCase (colorName Green)}:${toUpperCase (trim s)}:${parseOr "42" 0}" == "GREEN:HELLO:42",
        "=== omnibus done ===" == "=== omnibus done ==="
    ]

test "unions, Results and scalar operations compose" unionsResultsAndScalars
test "functions, forward calls, booleans and pipes compose" functionsPipesAndBooleans
test "effects mutate handled state beside persistent collections" effectsAndCollections
test "string transformations consume values from other features" stringInteractions
