/// Converted from tests/regressions/basics/feature_omnibus. Every dynamic golden
/// value is asserted, then combined paths assert intermediate state as well.
/// Priority is a payload-free union used to document exhaustive matching.
type Pri = Low | Med | High
/// Color supplies a second union so independent matches can compose.
type Color = Red | Green | Blue
/// Wrapped demonstrates extracting a positional union payload.
type Wrapped = Wrapped(int)
/// Pair carries a NAMED payload destructured positionally, pinning that a binder
/// takes its column and not its like-named field.
type Pair = Pair { first: string, second: int }

/// Converts every priority constructor into its business weight.
fn priWeight(p) = match p { Low => 1 Med => 5 High => 9 }
/// Converts every color constructor into a stable display label.
fn colorName(c) = match c { Red => "red" Green => "green" Blue => "blue" }
/// Exercises a call to a function declared later in the source file.
fn callerOfLater(_) = calleeLater(10)
/// Supplies the forward-referenced arithmetic implementation.
fn calleeLater(n) = n * 4 ?: 0

/// Unwraps a parsed integer or returns the caller's fallback through currying.
fn parseOr(text: string) -> (int) -> int = fn(fallback) => parseInt(text) ?: fallback
/// Converts both Result branches into user-facing status text.
fn parseStatus(text) = match parseInt(text) {
    Success { value } => "parsed ${value}"
    Error { message } => "parseInt rejected ${text}"
}

/// Counter models a handled state-changing capability with an integer payload.
effect Counter {
    /// Advance the counter the handler owns.
    increment: fn(int) -> Unit
}

/// Verifies unions, Results, interpolation, arithmetic, and ordering together.
fn unionsResultsAndScalars() = {
    let wrapped = Wrapped(42)
    let wrappedValue = match wrapped { Wrapped(n) => n }
    let pair = Pair { first: "ada", second: 36 }
    /// `a` and `b` name no declared field, so only column order can resolve them.
    let bySlot = match pair { Pair(a, b) => "${a}/${b}" }
    /// Here every binder IS a field name, spelled in the opposite order. The
    /// column still wins, so `first` takes slot 1. Resolving by name instead
    /// handed back slot 0's string pointer as an int.
    let swapped = match pair { Pair(second, first) => "${first}/${second}" }
    // One grouped call records every former golden value plus new branch state.
    checkAll("union/result/scalar state", [
        "=== omnibus ===" == "=== omnibus ===",
        priWeight(High) == 9,
        priWeight(Med) == 5,
        priWeight(Low) == 1,
        "${colorName(Green)} wrapped ${wrappedValue}" == "green wrapped 42",
        bySlot == "ada/36",
        swapped == "36/ada",
        "next ${25 + 1} half ${25 / 2}" == "next Success(26) half Success(12.5)",
        1.5 == 1.5,
        parseStatus("oops") == "parseInt rejected oops",
        parseStatus("123") == "parsed 123",
        parseOr("oops")(77) == 77,
        parseOr("123")(77) == 123,
        priWeight(High) > priWeight(Med) && priWeight(Med) > priWeight(Low),
        colorName(Red) != colorName(Blue)
    ])
}

/// Verifies forward calls, lambdas, pipelines, booleans, and union-derived data.
fn functionsPipesAndBooleans() = {
    let chained = 5 |> (fn(x) => x + 100 ?: 0) |> (fn(x) => x * 2 ?: 0)
    let single = 7 |> fn(x) => x * 3 ?: 0
    // The batch preserves each legacy result and asserts intermediate pipeline state.
    checkAll("function/pipe/boolean state", [
        5 == 5,
        5 != 6,
        "hi" + " " + "world" == "hi world",
        "forward call -> ${callerOfLater(0)}" == "forward call -> 40",
        chained == 210,
        single == 21,
        (5 |> fn(x) => x + 100 ?: 0) == 105,
        callerOfLater(999) == callerOfLater((0 - 1) ?: 0),
        chained > single,
        (single + priWeight(Med) ?: 0) == 26
    ])
}

/// Verifies handled mutation alongside persistent lists, maps, and Result lookup.
fn effectsAndCollections() = {
    mut counter = 0
    // Establishes the state precondition before any handled interaction occurs.
    checkAll("effect precondition", [counter == 0])
    handle Counter
        increment amount => { counter = counter + amount ?: counter }
    in {
        perform Counter.increment(1)
        perform Counter.increment(1)
        perform Counter.increment(1)
    }
    let xs = listAppend(listAppend(listAppend(List(), 10), 20), 30)
    let ys = listAppend(List(), 99)
    let combined = xs + ys
    let m = mapSet(mapSet(Map(), "a", 1), "b", 2)
    let scoreAtOne = [85, 92, 78][1] ?: ((0 - 1) ?: 0)
    let bananaPrice = { "apple": 2, "banana": 3 }["banana"] ?: ((0 - 1) ?: 0)
    // Checks every post-handler and collection invariant without repetitive calls.
    checkAll("effect/collection state", [
        "counter ${counter}" == "counter 3",
        counter == 3,
        "list len ${listLength(combined)}" == "list len 4",
        "contains 20 ${listContains(xs, 20)}" == "contains 20 true",
        listContains(xs, 20),
        listLength(xs) == 3,
        listLength(ys) == 1,
        listLength(combined) == 4,
        "map len ${mapLength(m)}" == "map len 2",
        "map has a ${mapContains(m, "a")}" == "map has a true",
        mapContains(m, "a"),
        !mapContains(m, "missing"),
        "scores[1] ${scoreAtOne}" == "scores[1] 92",
        scoreAtOne == 92,
        "banana ${bananaPrice}" == "banana 3",
        bananaPrice == 3,
        ([85, 92, 78][9] ?: ((0 - 1) ?: 0)) == ((0 - 1) ?: 0),
        ({ "apple": 2 }["pear"] ?: ((0 - 1) ?: 0)) == ((0 - 1) ?: 0)
    ])
}

/// Verifies string transforms while consuming values produced by other features.
fn stringInteractions() = {
    let s = "  Hello  "
    // Preserves all former string outputs and adds composition invariants.
    checkAll("string/composed state", [
        s.trim() == "Hello",
        s.toUpperCase() == "  HELLO  ",
        length(s) == 9,
        s.trim().toUpperCase() == "HELLO",
        startsWith(s, "  "),
        !startsWith(s.trim(), " "),
        "${colorName(Green).toUpperCase()}:${s.trim().toUpperCase()}:${parseOr("42")(0)}" == "GREEN:HELLO:42",
        "=== omnibus done ===" == "=== omnibus done ==="
    ])
}

// Register the union, Result, and scalar interaction.
test("unions, Results and scalar operations compose", unionsResultsAndScalars)
// Register the function, boolean, and pipeline interaction.
test("functions, forward calls, booleans and pipes compose", functionsPipesAndBooleans)
// Register the effect and persistent-collection interaction.
test("effects mutate handled state beside persistent collections", effectsAndCollections)
// Register the cross-feature string interaction.
test("string transformations consume values from other features", stringInteractions)
