// Converted from examples/tested/basics/feature_omnibus. Every dynamic golden
// value is asserted, then combined paths assert intermediate state as well.
type Pri = Low | Med | High
type Color = Red | Green | Blue
type Wrapped = Wrapped(int)

fn priWeight(p) = match p { Low => 1 Med => 5 High => 9 }
fn colorName(c) = match c { Red => "red" Green => "green" Blue => "blue" }
fn callerOfLater(_) = calleeLater(10)
fn calleeLater(n) = n * 4

fn parseOr(text, fallback) = parseInt(text) ?: fallback
fn parseStatus(text) = match parseInt(text) {
    Success { value } => "parsed ${value}"
    Error { message } => "parseInt rejected ${text}"
}

effect Counter { increment: fn(int) -> Unit }

fn unionsResultsAndScalars() = {
    let wrapped = Wrapped(42)
    let wrappedValue = match wrapped { Wrapped(n) => n }
    checkAll("union/result/scalar state", [
        priWeight(High) == 9,
        priWeight(Med) == 5,
        priWeight(Low) == 1,
        "${colorName(Green)} wrapped ${wrappedValue}" == "green wrapped 42",
        "next ${25 + 1} half ${25 / 2}" == "next 26 half 12.5",
        1.5 == 1.5,
        parseStatus("oops") == "parseInt rejected oops",
        parseStatus("123") == "parsed 123",
        parseOr("oops", 77) == 77,
        parseOr("123", 77) == 123,
        priWeight(High) > priWeight(Med) && priWeight(Med) > priWeight(Low),
        colorName(Red) != colorName(Blue)
    ])
}

fn functionsPipesAndBooleans() = {
    let chained = 5 |> (fn(x) => x + 100) |> (fn(x) => x * 2)
    let single = 7 |> fn(x) => x * 3
    checkAll("function/pipe/boolean state", [
        5 == 5,
        5 != 6,
        "hi" + " " + "world" == "hi world",
        "forward call -> ${callerOfLater(0)}" == "forward call -> 40",
        chained == 210,
        single == 21,
        (5 |> fn(x) => x + 100) == 105,
        callerOfLater(999) == callerOfLater(-1),
        chained > single,
        single + priWeight(Med) == 26
    ])
}

fn effectsAndCollections() = {
    mut counter = 0
    checkAll("effect precondition", [counter == 0])
    handle Counter
        increment amount => { counter = counter + amount }
    in {
        perform Counter.increment(1)
        perform Counter.increment(1)
        perform Counter.increment(1)
    }
    let xs = listAppend(listAppend(listAppend(List(), 10), 20), 30)
    let ys = listAppend(List(), 99)
    let combined = xs + ys
    let m = mapSet(mapSet(Map(), "a", 1), "b", 2)
    checkAll("effect/collection state", [
        "counter ${counter}" == "counter 3",
        counter == 3,
        "list len ${listLength(combined)}" == "list len 4",
        listContains(xs, 20),
        listLength(xs) == 3,
        listLength(ys) == 1,
        listLength(combined) == 4,
        "map len ${mapLength(m)}" == "map len 2",
        mapContains(m, "a"),
        !mapContains(m, "missing"),
        ([85, 92, 78][1] ?: -1) == 92,
        ({ "apple": 2, "banana": 3 }["banana"] ?: -1) == 3,
        ([85, 92, 78][9] ?: -1) == -1,
        ({ "apple": 2 }["pear"] ?: -1) == -1
    ])
}

fn stringInteractions() = {
    let s = "  Hello  "
    checkAll("string/composed state", [
        s.trim() == "Hello",
        s.toUpperCase() == "  HELLO  ",
        length(s) == 9,
        s.trim().toUpperCase() == "HELLO",
        startsWith(s, "  "),
        !startsWith(s.trim(), " "),
        "${colorName(Green).toUpperCase()}:${s.trim().toUpperCase()}:${parseOr("42", 0)}" == "GREEN:HELLO:42",
        "=== omnibus done ===" == "=== omnibus done ==="
    ])
}

test("unions, Results and scalar operations compose", unionsResultsAndScalars)
test("functions, forward calls, booleans and pipes compose", functionsPipesAndBooleans)
test("effects mutate handled state beside persistent collections", effectsAndCollections)
test("string transformations consume values from other features", stringInteractions)
