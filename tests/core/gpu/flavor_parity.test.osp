// Aspirational GPU frontend parity. Flavor-equivalent programs must reach the
// same typed GPU IR, including the full int domain and negative arguments
// ([GPU-BUFFER-ELEM], [GPU-IOTA], [GPU-KERNEL-EXTRACT]).

fn minimumIntCase() = {
    let minimum = -9223372036854775808
    let buf = toGpu([minimum])
    checkAll("minimum int literal crosses the GPU boundary", [
        gpuLength(buf) == 1,
        (gpuGet(buf, 0) ?: 0) == minimum,
        (listGet(fromGpu(buf), 0) ?: 0) == minimum
    ])
}

fn negativeIotaCase() = {
    let direct = gpuIota(-3)
    let piped = -7 |> gpuIota()
    checkAll("negative gpuIota arguments are empty", [
        gpuLength(direct) == 0,
        gpuLength(piped) == 0,
        listLength(fromGpu(direct)) == 0,
        listLength(fromGpu(piped)) == 0
    ])
}

test("minimum int literals are flavor-equivalent in GPU buffers", minimumIntCase)
test("negative gpuIota arguments are flavor-equivalent", negativeIotaCase)

fn denseFloatCombinatorsCase() = {
    let values: List<float32> = [0.5, 1.0, 1.5]
    let buffer = toGpu(values)
    let scan = gpuScan(buffer, toFloat32(0.0), fn(acc, value) => acc + value)
    let kept = gpuFilter(buffer, fn(value) => value > toFloat32(0.5))
    let zipped = gpuZipWith(buffer, buffer, fn(a, b) => a + b)
    checkAll("dense float32 combinators", [
        gpuFold(buffer, toFloat32(0.0), fn(acc, value) => acc + value) == toFloat32(3.0),
        join(mapList(fromGpu(scan), toString), ",") == "0.5,1.5,3.0",
        join(mapList(fromGpu(kept), toString), ",") == "1.0,1.5",
        join(mapList(fromGpu(zipped), toString), ",") == "1.0,2.0,3.0"
    ])
}

test("float32 reductions scans filters and zip keep their width", denseFloatCombinatorsCase)
