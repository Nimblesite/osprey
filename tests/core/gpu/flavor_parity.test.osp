// Aspirational GPU frontend parity. Flavor-equivalent programs must reach the
// same typed GPU IR, including the full int domain and negative arguments
// ([GPU-BUFFER-ELEM], [GPU-IOTA], [GPU-KERNEL-EXTRACT]).

fn minimumIntCase() = {
    let minimum = -9223372036854775808
    let buf = toGpu([minimum])
    checkAll("minimum int literal crosses the GPU boundary", [
        gpuLength(buf) == 1,
        (gpuGet(buf, 0) ?: 0) == minimum,
        (listGet(fromGpu(buf), 0) ?: 0) == minimum
    ])
}

fn negativeIotaCase() = {
    let direct = gpuIota(-3)
    let piped = -7 |> gpuIota()
    checkAll("negative gpuIota arguments are empty", [
        gpuLength(direct) == 0,
        gpuLength(piped) == 0,
        listLength(fromGpu(direct)) == 0,
        listLength(fromGpu(piped)) == 0
    ])
}

test("minimum int literals are flavor-equivalent in GPU buffers", minimumIntCase)
test("negative gpuIota arguments are flavor-equivalent", negativeIotaCase)

fn denseOutOfBounds(buffer, index) = match gpuGet(buffer, index) { Error _ => true Success _ => false }

// [GPU-BUFFER-ELEM]: list words narrow into dense storage and widen back exactly.
fn denseRoundTrip(label, values) = {
    let buffer = toGpu(values)
    let mapped = gpuMap(buffer, fn(value) => value)
    checkAll(label, [
        gpuLength(buffer) == length(values),
        structuralEquals(fromGpu(buffer), values),
        structuralEquals(fromGpu(mapped), values),
        denseOutOfBounds(buffer, -1),
        denseOutOfBounds(buffer, length(values))
    ])
}

fn denseIntegerWidthsCase() = {
    let i8: List<int8> = [-128, 0, 127]
    let u8: List<uint8> = [0, 128, 255]
    let i16: List<int16> = [-32768, 0, 32767]
    let u16: List<uint16> = [0, 32768, 65535]
    let i32: List<int32> = [-2147483648, 0, 2147483647]
    let u32: List<uint32> = [0, 2147483648, 4294967295]
    denseRoundTrip("dense int8", i8)
    denseRoundTrip("dense uint8", u8)
    denseRoundTrip("dense int16", i16)
    denseRoundTrip("dense uint16", u16)
    denseRoundTrip("dense int32", i32)
    denseRoundTrip("dense uint32", u32)
}

fn denseWidthsCase() = {
    denseIntegerWidthsCase()
    let f16: List<float16> = [-0.5, 0.0, 1.5]
    let f32: List<float32> = [-0.5, 0.0, 1.5]
    denseRoundTrip("dense float16", f16)
    denseRoundTrip("dense float32", f32)
    denseRoundTrip("dense bool", [true, false, true])
    denseRoundTrip("dense int", [-9223372036854775808, 0, 9223372036854775807])
    denseRoundTrip("dense float", [-0.5, 0.0, 1.5])
}

fn denseFloatCombinatorsCase() = {
    let values: List<float32> = [0.5, 1.0, 1.5]
    let buffer = toGpu(values)
    let scan = gpuScan(buffer, toFloat32(0.0), fn(acc, value) => acc + value)
    let kept = gpuFilter(buffer, fn(value) => value > toFloat32(0.5))
    let zipped = gpuZipWith(buffer, buffer, fn(a, b) => a + b)
    checkAll("dense float32 combinators", [
        gpuFold(buffer, toFloat32(0.0), fn(acc, value) => acc + value) == toFloat32(3.0),
        join(mapList(fromGpu(scan), toString), ",") == "0.5,1.5,3.0",
        join(mapList(fromGpu(kept), toString), ",") == "1.0,1.5",
        join(mapList(fromGpu(zipped), toString), ",") == "1.0,2.0,3.0"
    ])
}

test("every scalar width survives dense storage and a generic identity kernel", denseWidthsCase)
test("float32 reductions scans filters and zip keep their width", denseFloatCombinatorsCase)
