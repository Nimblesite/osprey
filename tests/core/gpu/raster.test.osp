// Graphics on the GPU surface: a fragment-shader-shaped renderer. Every
// scene is one pure kernel dispatched over `gpuIota(width * height)` — the
// flat pixel grid — and layers composite with a single elementwise pass
// ([GPU-IOTA], [GPU-MAP], [GPU-ZIPWITH], [GPU-FILTER], [GPU-FOLD],
// [GPU-GET], [GPU-DEVICE] — docs/specs/0034-GPUComputation.md).
//
// Shading is deliberately fixed-point integer arithmetic — the workload a
// fragment shader actually runs — and the kernels reach recursive helpers
// (`escape`, `isqrtIter`) to prove [GPU-KERNEL-FORM]'s claim that a kernel is
// gated on purity, not on shape. Execution is the host backend
// [GPU-BACKEND-HOST]; the same program is what a device target runs unchanged.

/// scale is the fixed-point unit: one whole number is 4096 sub-units.
fn scale() = 4096

/// frameWidth and frameHeight size every raster in this file.
fn frameWidth() = 64
fn frameHeight() = 24

/// ramp is the brightness palette, darkest first.
fn ramp() = " .:-=+*#%@"

/// glyph turns a 0..9 brightness level into its palette character.
fn glyph(level: int) -> string = substring(ramp(), level, (level + 1) ?: level) ?: " "

/// clampLevel keeps a computed brightness inside the palette, never below `low`.
fn clampLevel(v: int, low: int) -> int = match v < low {
    true => low
    false => match v > 9 { true => 9 false => v }
}

/// isqrtIter is Newton's method on integers, converging from above.
fn isqrtIter(n: int, guess: int) -> int = {
    let next = intDiv((guess + (intDiv(n, guess) ?: guess)) ?: guess, 2) ?: guess
    match next >= guess { true => guess false => isqrtIter(n, next) }
}

/// isqrt is the floor of the square root, total on zero and negatives.
fn isqrt(n: int) -> int = match n <= 0 { true => 0 false => isqrtIter(n, n) }

/// escape counts Mandelbrot iterations before z leaves the radius-2 disc.
fn escape(zr: int, zi: int, cr: int, ci: int, i: int) -> int = match i >= 24 {
    true => 24
    false => {
        let zr2 = intDiv((zr * zr) ?: 0, scale()) ?: 0
        let zi2 = intDiv((zi * zi) ?: 0, scale()) ?: 0
        match ((zr2 + zi2) ?: 0) > ((4 * scale()) ?: 0) {
            true => i
            false => escape(
                ((zr2 - zi2) ?: 0) + cr ?: 0,
                (intDiv((2 * zr * zi) ?: 0, scale()) ?: 0) + ci ?: 0,
                cr, ci, (i + 1) ?: i)
        }
    }
}

/// mandelPixel is a fragment kernel: flat pixel index in, brightness out.
/// The complex plane is sampled at pixel centers over [-2.25, 0.75] x [-1.25, 1.25].
fn mandelPixel(idx: int) -> int = {
    let x = (idx % frameWidth()) ?: 0
    let y = intDiv(idx, frameWidth()) ?: 0
    let sx = ((2 * x) ?: 0) + 1 - frameWidth() ?: 0
    let sy = ((2 * y) ?: 0) + 1 - frameHeight() ?: 0
    let cr = (intDiv((sx * 12288) ?: 0, (2 * frameWidth()) ?: 0) ?: 0) - 3072 ?: 0
    let ci = intDiv((sy * 10240) ?: 0, (2 * frameHeight()) ?: 0) ?: 0
    clampLevel(intDiv((escape(0, 0, cr, ci, 0) * 10) ?: 0, 24) ?: 0, 0)
}

/// sphereRadiusX and sphereRadiusY are the silhouette radii in half-cells;
/// the 2:1 ratio corrects for character cells being twice as tall as wide.
fn sphereRadiusX() = 44
fn sphereRadiusY() = 22

/// lightAxis is one axis of the unit light direction, 1/sqrt(3) fixed-point.
fn lightAxis() = 2365

/// lambert is the diffuse term for a surface point, in fixed-point units.
fn lambert(nx: int, ny: int, dd: int) -> int = {
    let nz = isqrt(((scale() - dd) ?: 0) * scale() ?: 0)
    let axis = (0 - lightAxis()) ?: 0
    intDiv(((nx * axis) ?: 0) + ((ny * axis) ?: 0) + ((nz * lightAxis()) ?: 0) ?: 0, scale()) ?: 0
}

/// spherePixel shades a unit sphere, one ray per character cell. The surface
/// normal is recovered from the disc equation and lit from the upper left;
/// cells outside the silhouette stay at background level zero.
fn spherePixel(idx: int) -> int = {
    let sx = ((2 * ((idx % frameWidth()) ?: 0)) ?: 0) + 1 - frameWidth() ?: 0
    let sy = ((2 * (intDiv(idx, frameWidth()) ?: 0)) ?: 0) + 1 - frameHeight() ?: 0
    let nx = intDiv((sx * scale()) ?: 0, sphereRadiusX()) ?: 0
    let ny = intDiv((sy * scale()) ?: 0, sphereRadiusY()) ?: 0
    let dd = intDiv(((nx * nx) ?: 0) + ((ny * ny) ?: 0) ?: 0, scale()) ?: 0
    match dd > scale() {
        true => 0
        false => clampLevel(intDiv((lambert(nx, ny, dd) * 9) ?: 0, scale()) ?: 0, 1)
    }
}

/// overLayer composites a lit foreground pixel over a background pixel.
fn overLayer(bg: int, fg: int) -> int = match fg > 0 { true => fg false => bg }

/// litPixel selects the cells a scene actually drew.
fn litPixel(level) = level > 0

/// interiorPixel selects the cells that never escaped.
fn interiorPixel(level) = level >= 9

/// addLevels totals brightness across a frame.
fn addLevels(a: int, b: int) -> int = (a + b) ?: a

/// pixelGrid is the flat index buffer every kernel is dispatched over.
fn pixelGrid() = gpuIota((frameWidth() * frameHeight()) ?: 0)

/// mandelFrame and sphereFrame are the two rendered layers.
fn mandelFrame() = pixelGrid() |> gpuMap(mandelPixel)
fn sphereFrame() = pixelGrid() |> gpuMap(spherePixel)

/// row renders one scanline of a rendered buffer.
fn row(pixels, y) =
    range(0, frameWidth()) |> fold("", |acc, x| =>
        acc + glyph(gpuGet(pixels, ((y * frameWidth()) ?: 0) + x ?: 0) ?: 0))

/// canvas renders every scanline of a buffer into one printable frame.
fn canvas(pixels) =
    range(0, frameHeight()) |> fold("", |acc, y| => acc + row(pixels, y) + "\n")

/// gallery renders all three layers and their buffer statistics as one frame
/// of output — one dispatch per scene, one elementwise pass to composite.
fn gallery() = {
    let mandel = mandelFrame()
    let sphere = sphereFrame()
    let composite = gpuZipWith(mandel, sphere, overLayer)
    "== mandelbrot ${gpuLength(mandel)}px on ${gpuDevice()} ==\n${canvas(mandel)}" +
    "== lambert sphere ==\n${canvas(sphere)}" +
    "== composite ==\n${canvas(composite)}" +
    "interior=${gpuLength(mandel |> gpuFilter(interiorPixel))} " +
    "lit=${gpuLength(sphere |> gpuFilter(litPixel))} " +
    "light=${sphere |> gpuFold(0, addLevels)}"
}

/// dispatchCase pins the grid one kernel dispatch covers.
fn dispatchCase() = checkAll("dispatch", [
    gpuLength(pixelGrid()) == 1536,
    gpuLength(mandelFrame()) == 1536,
    gpuLength(sphereFrame()) == 1536,
    gpuDevice() == "host"
])

/// paletteCase pins the brightness-to-character mapping and its clamps.
fn paletteCase() = checkAll("palette", [
    glyph(0) == " ",
    glyph(9) == "@",
    glyph(clampLevel(99, 0)) == "@",
    glyph(clampLevel((0 - 4) ?: 0, 0)) == " ",
    clampLevel(0, 1) == 1
])

/// mirrorRow counts a scanline that matches its mirror across the real axis.
fn mirrorRow(pixels, acc, y) =
    match row(pixels, y) == row(pixels, ((frameHeight() - 1) ?: 0) - y ?: 0) {
        true => (acc + 1) ?: acc
        false => acc
    }

/// symmetryCase pins that the fractal is mirror-symmetric about the real
/// axis — a whole-frame property only a correct kernel produces.
fn symmetryCase() = {
    let mandel = mandelFrame()
    let mirrored = range(0, frameHeight()) |> fold(0, |acc, y| => mirrorRow(mandel, acc, y))
    checkAll("symmetry", [mirrored == 24, gpuLength(mandel |> gpuFilter(interiorPixel)) == 344])
}

/// shadingCase pins the sphere: a lit silhouette, a dark background, and a
/// brightest cell on the side the light comes from.
fn shadingCase() = {
    let sphere = sphereFrame()
    checkAll("shading", [
        (gpuGet(sphere, 0) ?: 9) == 0,
        (gpuGet(sphere, 1535) ?: 9) == 0,
        (gpuGet(sphere, ((5 * frameWidth()) ?: 0) + 19 ?: 0) ?: 0) == 9,
        gpuLength(sphere |> gpuFilter(litPixel)) == 764,
        (sphere |> gpuFold(0, addLevels)) == 2928
    ])
}

/// compositeCase pins that one elementwise pass layers sphere over fractal.
fn compositeCase() = {
    let mandel = mandelFrame()
    let sphere = sphereFrame()
    let composite = gpuZipWith(mandel, sphere, overLayer)
    checkAll("composite", [
        gpuLength(composite) == 1536,
        (gpuGet(composite, 0) ?: 9) == (gpuGet(mandel, 0) ?: 8),
        (gpuGet(composite, ((5 * frameWidth()) ?: 0) + 19 ?: 0) ?: 0) == 9,
        gpuLength(composite |> gpuFilter(litPixel)) ==
            gpuLength(gpuZipWith(mandel, sphere, overLayer) |> gpuFilter(litPixel))
    ])
}

print(gallery())

test("one kernel dispatch covers the whole pixel grid", dispatchCase)
test("brightness levels map onto the palette", paletteCase)
test("the fractal kernel renders a symmetric frame", symmetryCase)
test("the sphere kernel shades a lit silhouette", shadingCase)
test("zipWith composites two rendered layers", compositeCase)
