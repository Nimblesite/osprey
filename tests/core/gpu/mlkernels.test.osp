// AI/ML workloads on the GPU surface and the closure captures they are made
// of: dot products, SAXPY, weighted sums, mean and variance, normalisation,
// activations, a softmax-shaped pipeline, dense layers, matrix-vector products
// via gather, and a gradient-descent training loop ([GPU-KERNEL-FORM],
// [GPU-MAP], [GPU-ZIPWITH], [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-IOTA],
// [GPU-GET], [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
//
// The capture is the load-bearing shape. [GPU-KERNEL-FORM] names "a closure
// capturing enclosing locals (a folded scalar piped back into a gpuMap)" as a
// kernel form the purity proof must accept, so every statistic below is folded
// out of one buffer and spent inside a kernel over another: a mean into a
// centering pass, a maximum into a softmax shift, a weight total into a
// normalising divide — values staged beside the buffer, never shared state.

/// addF is the float reduction shared by every sum below; mulF is the
/// elementwise product behind every dot product.
fn addF(a: float32, x: float32) = a + x
fn mulF(x: float32, y: float32) = x * y
/// floats packs a float list into a float32 buffer, so every buffer literal
/// names its width once ([GPU-BUFFER-ELEM]).
fn floats(xs) = toGpu(mapList(xs, toFloat32))

/// maxF and minF fold a buffer to its extremes: the seeds a softmax shift and
/// a min-max rescale capture.
fn maxF(a, x: float32) = match x > a { true => x false => a }
fn minF(a, x: float32) = match x < a { true => x false => a }

/// relu clamps negative inputs to zero; isActive marks what a relu layer lets
/// through.
fn relu(x) = match x > toFloat32(0.0) { true => x false => toFloat32(0.0) }
fn isActive(x) = x > toFloat32(0.0)

/// at reads a matrix element, treating out of bounds as zero padding; sumOf and
/// meanOf are the folded statistics the kernels capture, and meanOf's checked
/// division is what keeps an empty buffer total instead of partial.
fn at(m, i) = gpuGet(m, i) ?: toFloat32(0.0)
fn sumOf(xs) = xs |> gpuFold(toFloat32(0.0), addF)
/// Empty statistics and zero-spread normalisation choose an explicit boundary value.
fn degenerate(value, work) = {
    handle Arith { divideByZero _ _ => value }
    work()
}
fn meanOf(xs) = degenerate(0.0, fn() => sumOf(xs) / toFloat32(gpuLength(xs)))

/// dot is BLAS level 1: fuse an elementwise product into a reduction, which is
/// the shape varianceOf reuses twice — fold a mean, then capture it inside the
/// kernel measuring squared deviation from it.
fn dot(xs, ys) = gpuZipWith(xs, ys, mulF) |> gpuFold(toFloat32(0.0), addF)
fn varianceOf(xs) = {
    let mean = meanOf(xs)
    meanOf(xs |> gpuMap(fn(v) => (v - mean) * (v - mean)))
}

/// saxpy is the classic a*x + y with a = 2.0.
fn saxpy(x: float32, y: float32) = toFloat32(2.0) * x + y

/// softWeight weights a score already shifted by the batch maximum, so d >= 0.
fn softWeight(d) = (toFloat32(1.0) / (toFloat32(1.0) + d + d * d)) 

/// softmax is four stages, two of them captures: fold the maximum, spend it in
/// the shift, fold the partition function, spend that in the divide.
fn softmax(scores) = {
    let peak = scores |> gpuFold(gpuGet(scores, 0) ?: toFloat32(0.0), maxF)
    let weights = scores |> gpuMap(fn(s) => softWeight(peak - s))
    let partition = sumOf(weights)
    weights |> gpuMap(fn(w) => (w / partition) )
}

/// rowDot walks one row of a flat row-major matrix against a vector. The
/// annotations are load-bearing: only a concrete signature is emitted as a real
/// definition, which recursion requires.
fn rowDot(m, v, cols, r, c) = match c == cols {
    true => toFloat32(0.0)
    false => at(m, (((r * cols) ) + c) ) * at(v, c)
        + rowDot(m, v, cols, r, (c + 1) )
}

/// matVec gathers every row's dot product: one kernel invocation per row.
fn matVec(m, v, cols, rows) = gpuIota(rows) |> gpuMap(fn(r) => rowDot(m, v, cols, r, 0))

/// dense is one MLP layer: gather rows, add bias elementwise, then activate.
fn dense(m, v, cols, rows, bias) = gpuZipWith(matVec(m, v, cols, rows), bias, addF) |> gpuMap(relu)

/// mse is the loss the training loop descends; w is captured by the residual.
fn mse(w: float32, xs: GpuBuffer<float32>, ys: GpuBuffer<float32>) =
    meanOf(gpuZipWith(xs, ys, fn(x, y) => (w * x - y) * (w * x - y)))

/// gradStep is one epoch of least-squares descent on y = w * x; the annotation
/// types the captured w inside the kernel lambda.
fn gradStep(w: float32, xs: GpuBuffer<float32>, ys: GpuBuffer<float32>) = w - toFloat32(0.05) * (((gpuZipWith(xs, ys,
    fn(x, y) => toFloat32(2.0) * (w * x - y) * x) |> gpuFold(toFloat32(0.0), addF)) / toFloat32(3.0)) )

/// train iterates gradStep n times, keeping the loop on buffers. Annotated for
/// the same recursion-emission reason as rowDot.
fn train(w, xs, ys, n) = match n {
    0 => w
    _ => train(gradStep(w, xs, ys), xs, ys, (n - 1) )
}

/// dotCase pins the fused product-and-reduce over orthogonal, negated, zeroed,
/// singleton, empty and ragged operands.
fn dotCase() = {
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let ys = floats([toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)])
    checkAll("dot product", [
        dot(xs, ys) == toFloat32(32.0),
        dot(ys, xs) == toFloat32(32.0),
        dot(xs, xs) == toFloat32(14.0),
        dot(floats([]), floats([])) == toFloat32(0.0),
        dot(xs, floats([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)])) == toFloat32(0.0),
        dot(floats([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0)]), floats([toFloat32(1.0), toFloat32(2.0), toFloat32(1.0)])) == toFloat32(0.0),
        dot(floats([toFloat32(0.0) - toFloat32(1.0), toFloat32(2.0)]), floats([toFloat32(3.0), toFloat32(0.0) - toFloat32(4.0)])) == toFloat32(0.0) - toFloat32(11.0),
        dot(xs, floats([toFloat32(2.0), toFloat32(2.0)])) == toFloat32(6.0),
        dot(floats([toFloat32(0.5)]), floats([toFloat32(0.5)])) == toFloat32(0.25),
        dot(floats([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0)]), ys) == toFloat32(4.0),
        gpuLength(gpuZipWith(xs, ys, mulF)) == 3,
        gpuLength(gpuZipWith(xs, floats([toFloat32(1.0)]), mulF)) == 1
    ])
}

/// saxpyCase pins BLAS saxpy, then the same shape with the scale factor
/// captured — including alphas zero and one, which reduce to projections.
fn saxpyCase() = {
    let alpha = toFloat32(0.5)
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let out = gpuZipWith(xs, floats([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)]), saxpy)
    let axpy = gpuZipWith(xs, floats([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)]), fn(x, y) => alpha * x + y)
    checkAll("saxpy", [
        sumOf(out) == toFloat32(72.0),
        (gpuGet(out, 0) ?: toFloat32(0.0)) == toFloat32(12.0),
        (gpuGet(out, 2) ?: toFloat32(0.0)) == toFloat32(36.0),
        gpuLength(out) == 3,
        sumOf(axpy) == toFloat32(6.0),
        (gpuGet(axpy, 0) ?: toFloat32(0.0)) == toFloat32(1.5),
        (gpuGet(axpy, 2) ?: toFloat32(0.0)) == toFloat32(2.5),
        sumOf(gpuZipWith(xs, xs, fn(x, y) => toFloat32(0.0) * x + y)) == toFloat32(6.0),
        sumOf(gpuZipWith(xs, xs, fn(x, y) => toFloat32(1.0) * x + y)) == toFloat32(12.0),
        sumOf(gpuZipWith(xs, floats([toFloat32(10.0), toFloat32(20.0)]), saxpy)) == toFloat32(36.0),
        gpuLength(gpuZipWith(floats([]), xs, saxpy)) == 0,
        sumOf(gpuZipWith(xs, floats([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(x, y) => alpha * x + y)) == toFloat32(3.0)
    ])
}

/// captureScalarCase is the first acceptance shape: one host scalar closed over
/// by a kernel, spent by map, filter, fold and scan, empty buffer included.
fn captureScalarCase() = {
    let k = toFloat32(3.0)
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let scaled = xs |> gpuMap(fn(x) => k * x)
    let twice = xs |> gpuMap(fn(x) => k * x + k)
    checkAll("captured scalar", [
        sumOf(scaled) == toFloat32(18.0),
        (gpuGet(scaled, 1) ?: toFloat32(0.0)) == toFloat32(6.0),
        gpuLength(scaled) == 3,
        sumOf(twice) == toFloat32(27.0),
        (gpuGet(twice, 2) ?: toFloat32(0.0)) == toFloat32(12.0),
        sumOf(scaled |> gpuMap(fn(y) => k * y)) == toFloat32(54.0),
        sumOf(xs |> gpuMap(fn(x) => k + x)) == toFloat32(15.0),
        gpuLength(xs |> gpuFilter(fn(x) => x > k)) == 0,
        gpuLength(xs |> gpuFilter(fn(x) => k > x)) == 2,
        gpuLength(floats([]) |> gpuMap(fn(x) => k * x)) == 0,
        (xs |> gpuFold(toFloat32(0.0), fn(a, x) => a + k * x)) == toFloat32(18.0),
        (gpuGet(xs |> gpuScan(toFloat32(0.0), fn(a, x) => a + k * x), 2) ?: toFloat32(0.0)) == toFloat32(18.0)
    ])
}

/// captureManyCase puts several distinct captures inside one kernel, in
/// different orders and arities, so no single-capture shortcut can pass it.
fn captureManyCase() = {
    let a = toFloat32(2.0)
    let b = toFloat32(5.0)
    let c = toFloat32(0.5)
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let affine = xs |> gpuMap(fn(x) => (a * x + b) * c)
    checkAll("several captures", [
        (gpuGet(affine, 0) ?: toFloat32(0.0)) == toFloat32(3.5),
        (gpuGet(affine, 1) ?: toFloat32(0.0)) == toFloat32(4.5),
        (gpuGet(affine, 2) ?: toFloat32(0.0)) == toFloat32(5.5),
        sumOf(affine) == toFloat32(13.5),
        gpuLength(affine) == 3,
        sumOf(xs |> gpuMap(fn(x) => c * x + b - a)) == toFloat32(12.0),
        sumOf(xs |> gpuMap(fn(x) => a * x + b * c)) == toFloat32(19.5),
        sumOf(xs |> gpuMap(fn(x) => a * c * x)) == toFloat32(6.0),
        sumOf(xs |> gpuMap(fn(x) => b - a * x - c)) == toFloat32(1.5),
        sumOf(gpuZipWith(xs, xs, fn(x, y) => a * x + c * y)) == toFloat32(15.0),
        (xs |> gpuFold(b, fn(acc, x) => acc + c * x)) == toFloat32(8.0)
    ])
}

/// captureSharedCase spends one capture across every combinator and then again
/// in a chained pass, so it must survive being staged more than once.
fn captureSharedCase() = {
    let t = toFloat32(2.0)
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)])
    let scanned = xs |> gpuScan(toFloat32(0.0), fn(acc, x) => acc + t * x)
    let kept = xs |> gpuFilter(fn(x) => x > t)
    checkAll("shared capture", [
        sumOf(xs |> gpuMap(fn(x) => t * x)) == toFloat32(20.0),
        gpuLength(kept) == 2,
        sumOf(kept) == toFloat32(7.0),
        (gpuGet(kept, 0) ?: toFloat32(0.0)) == toFloat32(3.0),
        (xs |> gpuFold(toFloat32(0.0), fn(acc, x) => acc + t * x)) == toFloat32(20.0),
        (gpuGet(scanned, 0) ?: toFloat32(0.0)) == toFloat32(2.0),
        (gpuGet(scanned, 3) ?: toFloat32(0.0)) == toFloat32(20.0),
        gpuLength(scanned) == 4,
        sumOf(gpuZipWith(xs, xs, fn(x, y) => t * x * y)) == toFloat32(60.0),
        sumOf(gpuIota(4) |> gpuMap(fn(i) => t * toFloat32(i))) == toFloat32(12.0),
        gpuLength(xs |> gpuFilter(fn(x) => t > x)) == 1,
        sumOf(xs |> gpuMap(fn(x) => t * x) |> gpuFilter(fn(y) => y > t)) == toFloat32(18.0)
    ])
}

/// captureFoldedCase is the shape [GPU-KERNEL-FORM] spells out: the capture is
/// itself a fold over another buffer — a sum, a maximum and a minimum off `ws`.
fn captureFoldedCase() = {
    let ws = floats([toFloat32(1.0), toFloat32(3.0), toFloat32(4.0), toFloat32(8.0)])
    let total = sumOf(ws)
    let peak = ws |> gpuFold(gpuGet(ws, 0) ?: toFloat32(0.0), maxF)
    let xs = floats([toFloat32(2.0), toFloat32(4.0)])
    checkAll("capture folded from another buffer", [
        total == toFloat32(16.0),
        peak == toFloat32(8.0),
        sumOf(xs |> gpuMap(fn(x) => (x / total) )) == toFloat32(0.375),
        (gpuGet(xs |> gpuMap(fn(x) => (x / total) ), 0) ?: toFloat32(0.0)) == toFloat32(0.125),
        sumOf(xs |> gpuMap(fn(x) => x - peak)) == toFloat32(0.0) - toFloat32(10.0),
        sumOf(xs |> gpuMap(fn(x) => peak * x)) == toFloat32(48.0),
        (ws |> gpuFold(toFloat32(0.0), minF)) == toFloat32(0.0),
        (ws |> gpuFold(gpuGet(ws, 0) ?: toFloat32(0.0), minF)) == toFloat32(1.0),
        sumOf(ws |> gpuMap(fn(w) => (w / total) )) == toFloat32(1.0),
        gpuLength(ws |> gpuFilter(fn(w) => w * toFloat32(4.0) >= total)) == 2,
        sumOf(gpuZipWith(xs, xs, mulF) |> gpuMap(fn(p) => (p / total) )) == toFloat32(1.25),
        (floats([]) |> gpuFold(total, addF)) == toFloat32(16.0)
    ])
}

/// captureShapeCase pushes on the form a capture arrives in: a buffer captured
/// for gather (out-of-range reads padding to zero), a capture read from a nested
/// lambda, one reached only through a match branch, and a shadowing parameter.
fn captureShapeCase() = {
    let k = toFloat32(3.0)
    let w = floats([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)])
    let gathered = gpuIota(5) |> gpuMap(fn(i) => gpuGet(w, i) ?: toFloat32(0.0))
    let branch = fn(x) => match x > toFloat32(15.0) { true => k false => x }
    checkAll("capture forms", [
        sumOf(gathered) == toFloat32(60.0),
        (gpuGet(gathered, 3) ?: toFloat32(9.9)) == toFloat32(0.0),
        (gpuGet(gathered, 4) ?: toFloat32(9.9)) == toFloat32(0.0),
        gpuLength(gathered) == 5,
        sumOf(w |> gpuMap(branch)) == toFloat32(16.0),
        sumOf(gpuIota(3) |> gpuMap(fn(i) => k * (gpuGet(w, i) ?: toFloat32(0.0)))) == toFloat32(180.0),
        (gpuGet(gpuIota(3) |> gpuMap(fn(i) => k * (gpuGet(w, i) ?: toFloat32(0.0))), 2) ?: toFloat32(0.0)) == toFloat32(90.0),
        sumOf(w |> gpuMap(fn(x) => (fn(z) => k * z)(x))) == toFloat32(180.0),
        sumOf(w |> gpuMap(fn(k) => toFloat32(2.0) * k)) == toFloat32(120.0),
        sumOf(gpuZipWith(w, gpuIota(3) |> gpuMap(toFloat32), fn(x, i) => x - k * i)) == toFloat32(51.0),
        (w |> gpuFold(toFloat32(0.0), fn(a, x) => a + (fn(z) => toFloat32(0.5) * z)(x))) == toFloat32(30.0),
        gpuLength(w |> gpuFilter(fn(x) => (fn(z) => z > k)(x))) == 3
    ])
}

/// captureDegenerateCase is the boundary sweep: a captured zero divisor whose
/// checked division must surface as its fallback rather than an infinity, the
/// identity captures, an unread capture, and empty/ragged operands under one.
fn captureDegenerateCase() = {
    let zero = toFloat32(0.0)
    let one = toFloat32(1.0)
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let guarded = degenerate(-1.0, fn() => xs |> gpuMap(fn(x) => x / zero))
    checkAll("degenerate captures", [
        sumOf(guarded) == toFloat32(0.0) - toFloat32(3.0),
        (gpuGet(guarded, 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(1.0),
        sumOf(xs |> gpuMap(fn(x) => zero * x)) == toFloat32(0.0),
        sumOf(xs |> gpuMap(fn(x) => one * x)) == toFloat32(6.0),
        sumOf(xs |> gpuMap(fn(x) => zero + x)) == toFloat32(6.0),
        sumOf(xs |> gpuMap(fn(_x) => one)) == toFloat32(3.0),
        gpuLength(floats([]) |> gpuFilter(fn(x) => x > zero)) == 0,
        (floats([]) |> gpuFold(one, fn(a, x) => a + zero * x)) == toFloat32(1.0),
        sumOf(floats([toFloat32(5.0)]) |> gpuMap(fn(x) => one * x)) == toFloat32(5.0),
        gpuLength(gpuZipWith(xs, floats([]), fn(x, y) => zero * x + y)) == 0,
        gpuLength(gpuZipWith(floats([toFloat32(7.0)]), xs, fn(x, y) => one * x + y)) == 1,
        sumOf(gpuIota(0) |> gpuMap(fn(i) => one * toFloat32(i))) == toFloat32(0.0)
    ])
}

/// weightedSumCase pins weighted sum and weighted mean: the weight total is
/// folded once, captured by the normalising kernel, and both routes must agree.
fn weightedSumCase() = {
    let vals = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)])
    let ws = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(4.0), toFloat32(1.0)])
    let wtot = sumOf(ws)
    let normw = ws |> gpuMap(fn(w) => (w / wtot) )
    checkAll("weighted sums", [
        wtot == toFloat32(8.0),
        dot(vals, ws) == toFloat32(21.0),
        ((dot(vals, ws) / wtot) ) == toFloat32(2.625),
        sumOf(normw) == toFloat32(1.0),
        (gpuGet(normw, 2) ?: toFloat32(0.0)) == toFloat32(0.5),
        (gpuGet(normw, 0) ?: toFloat32(0.0)) == toFloat32(0.125),
        dot(vals, normw) == toFloat32(2.625),
        dot(floats([toFloat32(2.0), toFloat32(4.0), toFloat32(8.0), toFloat32(16.0)]), floats([toFloat32(0.5), toFloat32(0.25), toFloat32(0.125), toFloat32(0.125)])) == toFloat32(5.0),
        dot(vals, floats([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)])) == toFloat32(0.0),
        dot(vals, floats([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)])) == sumOf(vals),
        sumOf(gpuZipWith(vals, ws, fn(v, w) => wtot * v * w)) == toFloat32(168.0),
        sumOf(vals |> gpuMap(fn(v) => (v / wtot) )) == toFloat32(1.25)
    ])
}

/// meanCase centers a feature column: the folded mean is captured by the
/// centering kernel, and the centered column's own mean vanishes.
fn meanCase() = {
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(6.0)])
    let mean = meanOf(xs)
    let centered = xs |> gpuMap(fn(v) => v - mean)
    checkAll("mean centering", [
        mean == toFloat32(3.0),
        sumOf(centered) == toFloat32(0.0),
        (gpuGet(centered, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(2.0),
        (gpuGet(centered, 3) ?: toFloat32(0.0)) == toFloat32(3.0),
        gpuLength(centered) == 4,
        meanOf(centered) == toFloat32(0.0),
        meanOf(floats([])) == toFloat32(0.0),
        meanOf(floats([toFloat32(5.0)])) == toFloat32(5.0),
        meanOf(floats([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)])) == toFloat32(5.0),
        meanOf(xs |> gpuMap(fn(v) => mean + v)) == toFloat32(6.0),
        meanOf(gpuIota(9) |> gpuMap(toFloat32)) == toFloat32(4.0),
        gpuLength(xs |> gpuFilter(fn(v) => v > mean)) == 1
    ])
}

/// varianceCase pins two-pass variance and the z-scores built on it: a
/// normalised column has mean zero and variance one, and a constant column's
/// zero deviation must fall back rather than divide.
fn varianceCase() = {
    let xs = floats([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)])
    let mean = meanOf(xs)
    let sd = toFloat32(2.0)
    let z = xs |> gpuMap(fn(v) => ((v - mean) / sd) )
    checkAll("variance and z-scores", [
        mean == toFloat32(5.0),
        varianceOf(xs) == toFloat32(4.0),
        sd * sd == toFloat32(4.0),
        sumOf(z) == toFloat32(0.0),
        (gpuGet(z, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(1.5),
        (gpuGet(z, 4) ?: toFloat32(9.9)) == toFloat32(0.0),
        (gpuGet(z, 7) ?: toFloat32(0.0)) == toFloat32(2.0),
        meanOf(z) == toFloat32(0.0),
        varianceOf(z) == toFloat32(1.0),
        varianceOf(floats([toFloat32(3.0), toFloat32(3.0), toFloat32(3.0)])) == toFloat32(0.0),
        varianceOf(floats([])) == toFloat32(0.0),
        degenerate(0.0, fn() => sumOf(floats([toFloat32(3.0), toFloat32(3.0)]) |> gpuMap(fn(v) => (v - toFloat32(3.0)) / toFloat32(0.0)))) == toFloat32(0.0)
    ])
}

/// normalizeCase pins the min-max rescale: both extremes are folded out and
/// captured, and a constant column's zero range falls back instead of dividing.
fn normalizeCase() = {
    let xs = floats([toFloat32(1.0), toFloat32(3.0), toFloat32(5.0), toFloat32(9.0)])
    let lo = xs |> gpuFold(gpuGet(xs, 0) ?: toFloat32(0.0), minF)
    let hi = xs |> gpuFold(gpuGet(xs, 0) ?: toFloat32(0.0), maxF)
    let scaled = xs |> gpuMap(fn(v) => ((v - lo) / (hi - lo)) )
    checkAll("normalisation", [
        lo == toFloat32(1.0),
        hi == toFloat32(9.0),
        (gpuGet(scaled, 0) ?: toFloat32(9.9)) == toFloat32(0.0),
        (gpuGet(scaled, 1) ?: toFloat32(0.0)) == toFloat32(0.25),
        (gpuGet(scaled, 2) ?: toFloat32(0.0)) == toFloat32(0.5),
        (gpuGet(scaled, 3) ?: toFloat32(0.0)) == toFloat32(1.0),
        sumOf(scaled) == toFloat32(1.75),
        meanOf(scaled) == toFloat32(0.4375),
        sumOf(xs |> gpuMap(fn(v) => ((hi - v) / (hi - lo)) )) == toFloat32(2.25),
        (xs |> gpuFold(hi, minF)) == toFloat32(1.0),
        gpuLength(xs |> gpuFilter(fn(v) => v > lo)) == 3,
        degenerate(0.5, fn() => sumOf(floats([toFloat32(4.0), toFloat32(4.0)]) |> gpuMap(fn(v) => (v - toFloat32(4.0)) / toFloat32(0.0)))) == toFloat32(1.0)
    ])
}

/// reluCase pins clamping, active-unit counting, and a leaky variant whose
/// slope is captured — spelled as a match and as arithmetic, which must agree.
fn reluCase() = {
    let slope = toFloat32(0.5)
    let cap = toFloat32(2.0)
    let acts = floats([toFloat32(0.0) - toFloat32(1.5), toFloat32(2.5), toFloat32(0.0) - toFloat32(0.5), toFloat32(1.0)])
    let leaky = fn(x) => match x > toFloat32(0.0) { true => x false => slope * x }
    checkAll("activations", [
        sumOf(acts |> gpuMap(relu)) == toFloat32(3.5),
        (gpuGet(acts |> gpuMap(relu), 0) ?: toFloat32(9.9)) == toFloat32(0.0),
        gpuLength(acts |> gpuFilter(isActive)) == 2,
        sumOf(acts |> gpuMap(leaky)) == toFloat32(2.5),
        (gpuGet(acts |> gpuMap(leaky), 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(0.75),
        (gpuGet(acts |> gpuMap(leaky), 1) ?: toFloat32(0.0)) == toFloat32(2.5),
        (gpuGet(acts |> gpuMap(leaky), 2) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(0.25),
        sumOf(acts |> gpuMap(fn(x) => relu(x) - slope * relu(toFloat32(0.0) - x))) == toFloat32(2.5),
        sumOf(acts |> gpuMap(fn(x) => cap - relu(cap - relu(x)))) == toFloat32(3.0),
        sumOf(floats([toFloat32(0.0) - toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)]) |> gpuMap(relu)) == toFloat32(0.0),
        sumOf(floats([toFloat32(1.0), toFloat32(2.0)]) |> gpuMap(relu)) == toFloat32(3.0),
        sumOf(acts |> gpuMap(fn(x) => slope * relu(x))) == toFloat32(1.75)
    ])
}

/// softmaxCase pins the pipeline by its properties, not its digits: a
/// distribution, order-preserving, shift-invariant, uniform on a flat vector.
fn softmaxCase() = {
    let scores = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let probs = softmax(scores)
    let shifted = softmax(scores |> gpuMap(fn(s) => toFloat32(10.0) + s))
    let flat = softmax(floats([toFloat32(5.0), toFloat32(5.0), toFloat32(5.0)]))
    checkAll("softmax pipeline", [
        gpuLength(probs) == 3,
        sumOf(probs) > toFloat32(0.9999999),
        sumOf(probs) < toFloat32(1.0000001),
        (gpuGet(probs, 0) ?: toFloat32(0.0)) > toFloat32(0.0),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) < toFloat32(1.0),
        (gpuGet(probs, 1) ?: toFloat32(0.0)) > (gpuGet(probs, 0) ?: toFloat32(0.0)),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) > (gpuGet(probs, 1) ?: toFloat32(0.0)),
        (gpuGet(probs, 0) ?: toFloat32(0.0)) == (gpuGet(shifted, 0) ?: toFloat32(9.9)),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) == (gpuGet(shifted, 2) ?: toFloat32(9.9)),
        gpuLength(probs |> gpuFilter(fn(p) => p > toFloat32(0.5))) == 1,
        (gpuGet(flat, 0) ?: toFloat32(0.0)) == (gpuGet(flat, 2) ?: toFloat32(9.9)),
        sumOf(flat) > toFloat32(0.9999999)
    ])
}

/// matVecCase multiplies through iota + gather: identity, zero matrix, 1x1, a
/// zero-column walk, and a row past the end, which pads to zero.
fn matVecCase() = {
    let m = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)])
    let v = floats([toFloat32(1.0), toFloat32(1.0), toFloat32(2.0)])
    let eye = floats([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0)])
    let out = matVec(m, v, 3, 2)
    checkAll("matrix-vector", [
        gpuLength(out) == 2,
        (gpuGet(out, 0) ?: toFloat32(0.0)) == toFloat32(9.0),
        (gpuGet(out, 1) ?: toFloat32(0.0)) == toFloat32(21.0),
        sumOf(out) == toFloat32(30.0),
        sumOf(matVec(eye, floats([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)]), 3, 3)) == toFloat32(24.0),
        (gpuGet(matVec(eye, floats([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)]), 3, 3), 1) ?: toFloat32(0.0)) == toFloat32(8.0),
        sumOf(matVec(floats([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), floats([toFloat32(5.0), toFloat32(5.0)]), 2, 2)) == toFloat32(0.0),
        (gpuGet(matVec(floats([toFloat32(5.0)]), floats([toFloat32(3.0)]), 1, 1), 0) ?: toFloat32(0.0)) == toFloat32(15.0),
        (gpuGet(matVec(m, v, 3, 3), 2) ?: toFloat32(9.9)) == toFloat32(0.0),
        gpuLength(matVec(m, v, 3, 0)) == 0,
        sumOf(matVec(m, v, 0, 2)) == toFloat32(0.0),
        (gpuGet(matVec(m, v, 3, 2), 0) ?: toFloat32(0.0)) == dot(floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), v)
    ])
}

/// layerCase runs a two-layer forward pass; the first layer's negative unit must
/// be silenced by relu before the second layer sees it.
fn layerCase() = {
    let w1 = floats([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0), toFloat32(0.5), toFloat32(0.5), toFloat32(0.5)])
    let x = floats([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)])
    let h = dense(w1, x, 3, 2, floats([toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)]))
    let out = dense(floats([toFloat32(2.0), toFloat32(0.25)]), h, 2, 1, floats([toFloat32(0.5)]))
    checkAll("dense layers", [
        gpuLength(h) == 2,
        (gpuGet(h, 0) ?: toFloat32(9.9)) == toFloat32(0.0),
        (gpuGet(h, 1) ?: toFloat32(0.0)) == toFloat32(4.0),
        sumOf(h) == toFloat32(4.0),
        gpuLength(h |> gpuFilter(isActive)) == 1,
        gpuLength(out) == 1,
        (gpuGet(out, 0) ?: toFloat32(0.0)) == toFloat32(1.5),
        (gpuGet(matVec(w1, x, 3, 2), 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(4.0),
        (gpuGet(matVec(w1, x, 3, 2), 1) ?: toFloat32(0.0)) == toFloat32(6.0),
        sumOf(dense(w1, x, 3, 2, floats([toFloat32(0.0), toFloat32(0.0)]))) == toFloat32(6.0),
        sumOf(dense(w1, floats([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), 3, 2, floats([toFloat32(1.0), toFloat32(2.0)]))) == toFloat32(3.0),
        gpuLength(dense(w1, x, 3, 0, floats([toFloat32(1.0)]))) == 0
    ])
}

/// trainCase descends from both sides of the true weight and pins the loss
/// surface: the optimum is a fixed point, the loss is symmetric about it.
fn trainCase() = {
    let xs = floats([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
    let ys = floats([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)])
    let w = train(toFloat32(0.0), xs, ys, 40)
    let hi = train(toFloat32(5.0), xs, ys, 40)
    checkAll("gradient descent", [
        w - toFloat32(2.0) < toFloat32(0.01),
        toFloat32(2.0) - w < toFloat32(0.01),
        w > toFloat32(1.0),
        hi - toFloat32(2.0) < toFloat32(0.01),
        toFloat32(2.0) - hi < toFloat32(0.01),
        hi < toFloat32(3.0),
        train(toFloat32(2.0), xs, ys, 0) == toFloat32(2.0),
        train(toFloat32(2.0), xs, ys, 10) == toFloat32(2.0),
        gradStep(toFloat32(2.0), xs, ys) == toFloat32(2.0),
        mse(toFloat32(2.0), xs, ys) == toFloat32(0.0),
        mse(toFloat32(3.0), xs, ys) == mse(toFloat32(1.0), xs, ys),
        mse(toFloat32(0.0), xs, ys) > mse(w, xs, ys)
    ])
}

/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}


test("dot product fuses zip and fold", fn() => exactArithmetic(dotCase))
test("saxpy runs elementwise over buffer pairs", fn() => exactArithmetic(saxpyCase))
test("a kernel closes over one host scalar", fn() => exactArithmetic(captureScalarCase))
test("one kernel closes over several distinct scalars", fn() => exactArithmetic(captureManyCase))
test("one capture is spent by every combinator", fn() => exactArithmetic(captureSharedCase))
test("a capture folded from one buffer drives a kernel over another", fn() => exactArithmetic(captureFoldedCase))
test("captures survive gather, nesting, branching and shadowing", fn() => exactArithmetic(captureShapeCase))
test("degenerate captures stay total on empty and ragged buffers", fn() => exactArithmetic(captureDegenerateCase))
test("weighted sums normalise through a captured weight total", fn() => exactArithmetic(weightedSumCase))
test("mean centering pipes a scalar back into a kernel", fn() => exactArithmetic(meanCase))
test("variance and z-scores normalise a feature column", fn() => exactArithmetic(varianceCase))
test("min-max rescaling captures both folded extremes", fn() => exactArithmetic(normalizeCase))
test("relu clamps, leaks and counts active units", fn() => exactArithmetic(reluCase))
test("a softmax-shaped pipeline is a shift-invariant distribution", fn() => exactArithmetic(softmaxCase))
test("matrix-vector product gathers rows via iota", fn() => exactArithmetic(matVecCase))
test("dense layers stack bias and activation over gathered rows", fn() => exactArithmetic(layerCase))
test("gradient descent converges on the true weight", fn() => exactArithmetic(trainCase))
