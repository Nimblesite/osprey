fn elementCaseUploaded(ints, floats, flags) = {
    checkAll("scalar element words survive identity", [
            (gpuGet(ints |> gpuMap(same), 0) ?: 0) == -9, (gpuGet(ints |> gpuMap(same), 1) ?: 9) == 0, (gpuGet(ints |> gpuMap(same), 2) ?: 0) == 9,
            (gpuGet(floats |> gpuMap(same), 0) ?: 9.5) == -0.5, (gpuGet(floats |> gpuMap(same), 1) ?: 9.5) == 0.0, (gpuGet(floats |> gpuMap(same), 2) ?: 9.5) == 0.125,
            (gpuGet(flags |> gpuMap(same), 0) ?: true) == false, (gpuGet(flags |> gpuMap(same), 1) ?: false) == true, readback(ints, 0) == "-9", readback(ints, 1) == "0",
            readback(floats, 0) == "-0.5", readback(floats, 1) == "0.0", readback(floats, 2) == "0.125", readback(flags, 0) == "false", (ints |> gpuFold(0, addInts)) == 0,
            (floats |> gpuFold(0.0, addFloats)) == -0.375, (flags |> gpuFold(0, countOdd)) == 1, gpuLength(floats |> gpuMap(same)) == 3, widthOf(flags |> gpuMap(same)) == 2,
            gpuSatisfies(fromGpu(ints |> gpuMap(same)), fn(checked0) => listLength(checked0) == 3), gpuSatisfies(toGpu([2.0]), fn(uploaded22) => (uploaded22 |> gpuFold(0.0, addFloats)) == 2.0),
            (lastOf(floats |> gpuMap(same)) ?: 9.5) == 0.125
    ])
