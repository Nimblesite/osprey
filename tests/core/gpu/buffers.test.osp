/// flowCase pins the handle and its element tag through all four binding forms a value takes — a let, a pipe, a function parameter and a function return — plus a match arm and a lambda parameter. A float buffer that lost its tag anywhere along the way would read back as raw bits.
fn flowCase() = {
    match toGpu([1.5, 2.5, 3.5]) { Success { value } => { let held = value
            let piped = held |> gpuMap(scale)
            let returned = scaledFloats(held)
            let chosen = chooseBuffer(true, held, piped)
            let twice = scaledFloats(returned)
            let lamLength = fn(b) => gpuLength(b)
            checkAll("buffers flow through every binding form", [
                    (gpuGet(held, 0) ?: 9.5) == 1.5, (gpuGet(piped, 0) ?: 9.5) == 2.25, (gpuGet(piped, 2) ?: 9.5) == 5.25, (gpuGet(returned, 0) ?: 9.5) == 2.25,
                    (gpuGet(returned, 2) ?: 9.5) == 5.25, (lastOf(returned) ?: 9.5) == 5.25, (gpuGet(chosen, 1) ?: 9.5) == 2.5, (lastOf(chosen) ?: 9.5) == 3.5,
                    (gpuGet(chooseBuffer(false, held, piped), 1) ?: 9.5) == 3.75, (gpuGet(twice, 0) ?: 9.5) == 3.375, (lastOf(twice) ?: 9.5) == 7.875, widthOf(held) == 3,
                    widthOf(piped) == 3, widthOf(returned) == 3, widthOf(chosen) == 3, lamLength(held) == 3, lamLength(twice) == 3, (held |> gpuFold(0.0, addFloats)) == 7.5,
                    (piped |> gpuFold(0.0, addFloats)) == 11.25, (returned |> gpuFold(0.0, addFloats)) == 11.25, (twice |> gpuFold(0.0, addFloats)) == 16.875,
                    readback(held, 0) == "1.5", readback(returned, 0) == "2.25", readback(returned, 3) == oobMessage(), readback(twice, -1) == oobMessage(),
                    gpuSatisfies(fromGpu(held), fn(checked0) => listLength(checked0) == 3)
            ])
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// aliasCase pins two bindings onto one buffer. Buffers are immutable values [GPU-BUFFER], so a kernel run through one alias publishes a new buffer and leaves every alias of the source reading what it read before.
fn aliasCase() = {
    match toGpu([1, 2, 3, 4]) { Success { value } => { let source = value
            let alias = source
            let alsoAlias = alias
            let derived = doubledInts(alias)
            checkAll("aliased bindings share one immutable buffer", [
                    gpuLength(source) == 4, gpuLength(alias) == 4, gpuLength(alsoAlias) == 4, widthOf(alias) == widthOf(source), (gpuGet(alias, 0) ?: 0) == 1,
                    (gpuGet(alsoAlias, 0) ?: 0) == 1, (gpuGet(alias, 3) ?: 0) == 4, (gpuGet(alsoAlias, 3) ?: 0) == 4, (lastOf(alias) ?: 0) == (lastOf(source) ?: 0),
                    (source |> gpuFold(0, addInts)) == 10, (alias |> gpuFold(0, addInts)) == 10, (alsoAlias |> gpuFold(0, addInts)) == 10, gpuLength(derived) == 4,
                    (derived |> gpuFold(0, addInts)) == 20, (gpuGet(derived, 1) ?: 0) == 4, (gpuGet(source, 1) ?: 0) == 2, (gpuGet(alias, 1) ?: 0) == 2,
                    (gpuGet(alsoAlias, 1) ?: 0) == 2, readback(alias, 4) == oobMessage(), readback(alsoAlias, -1) == oobMessage(), readback(source, 4) == readback(alias, 4),
                    gpuSatisfies(fromGpu(alias), fn(checked0) => listLength(checked0) == 4), gpuSatisfies(fromGpu(alsoAlias), fn(checked0) => (listGet(checked0, 2) ?: 0) == 3)
            ])
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// fusionCase pins [GPU-BUFFER-FUSE] from the indexing side: whatever the pipeline fused into the buffer has to be addressable element by element, the published length has to bound gpuGet exactly, and a one-element or empty range has to land on a buffer of that size.
fn fusionCase() = {
    match toGpu(range(0, 6)) { Success { value } => { let uploaded16 = value
            let straight =uploaded16
            match toGpu(range(1, 5) |> map(square)) { Success { value } => { let uploaded17 = value
                    let squares =uploaded17
                    match toGpu(range(4, 5)) { Success { value } => { let uploaded18 = value
                            let lone =uploaded18
                            match toGpu(range(3, 3)) { Success { value } => { let uploaded19 = value
                                    let empty =uploaded19
                                    checkAll("iterator fusion fills the buffer directly", [
                                            gpuLength(straight) == 6, (gpuGet(straight, 0) ?: 9) == 0, (gpuGet(straight, 5) ?: 0) == 5, (lastOf(straight) ?: 0) == 5, readback(straight, 6) == oobMessage(),
                                            readback(straight, -1) == oobMessage(), gpuLength(squares) == 4, (gpuGet(squares, 0) ?: 0) == 1, (gpuGet(squares, 1) ?: 0) == 4, (gpuGet(squares, 2) ?: 0) == 9,
                                            (gpuGet(squares, 3) ?: 0) == 16, (lastOf(squares) ?: 0) == 16, readback(squares, 4) == oobMessage(), gpuLength(lone) == 1, (gpuGet(lone, 0) ?: 0) == 4,
                                            readback(lone, 1) == oobMessage(), gpuLength(empty) == 0, readback(empty, 0) == oobMessage(), (empty |> gpuFold(5, addInts)) == 5, widthOf(empty) == 0,
                                            gpuSatisfies(fromGpu(straight), fn(checked0) => listLength(checked0) == 6), gpuSatisfies(fromGpu(squares), fn(checked0) => (listGet(checked0, 1) ?: 0) == 4),
                                            gpuSatisfies(fromGpu(squares), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded15) => (uploaded15 |> gpuFold(0, addInts)) == 30))
                                    ])
                                } Error { message } => check("GPU allocation", "success", toString(message)) }
                        } Error { message } => check("GPU allocation", "success", toString(message)) }
                } Error { message } => check("GPU allocation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// intKernelCase pipes a buffer through a named kernel and folds it away, including over negative elements and over no elements at all.
fn intKernelCase() = withIndices(0, fn(indices0) => intKernelWith(indices0))
fn intKernelWith(indices0) = {
    match toGpu([1, 2, 3, 4]) { Success { value } => { let total = value |> gpuMap(square) |> gpuFold(0, addInts)
            match toGpu([1, 2, 3]) { Success { value } => { let uploaded14 = value
                    match fromGpu(uploaded14 |> gpuMap(fn(x) => (x * x) )) { Success { value } => { let read0 = value
                            let squares = read0
                            match toGpu([-1, -2, -3]) { Success { value } => { let negatives = value |> gpuMap(square)
                                    checkAll("int kernels", [
                                            total == 30, listLength(squares) == 3, (listGet(squares, 0) ?: 0) == 1, (listGet(squares, 2) ?: 0) == 9, gpuSatisfies(toGpu([10, 20]), fn(uploaded11) => (uploaded11 |> gpuFold(5, addInts)) == 35),
                                            gpuLength(negatives) == 3, (gpuGet(negatives, 0) ?: 0) == 1, (gpuGet(negatives, 2) ?: 0) == 9, (negatives |> gpuFold(0, addInts)) == 14,
                                            gpuSatisfies(toGpu([7]), fn(uploaded10) => (uploaded10 |> gpuMap(square) |> gpuFold(0, addInts)) == 49), (indices0 |> gpuMap(square) |> gpuFold(0, addInts)) == 0
                                    ])
                                } Error { message } => check("GPU allocation", "success", toString(message)) }
                        } Error { message } => check("GPU operation", "success", toString(message)) }
                } Error { message } => check("GPU allocation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// floatKernelCase proves float words keep their bits through map and fold, including the [GPU-CONVERT] seed that widens an index buffer.
fn floatKernelCase() = withIndices(0, fn(indices0) => withIndices(4, fn(indices4) => floatKernelWith(indices0, indices4)))
fn floatKernelWith(indices0, indices4) = {
    match toGpu([1.0, 2.0, 3.0]) { Success { value } => { let sum = value |> gpuMap(scale) |> gpuFold(0.0, addFloats)
            match toGpu([0.5, 0.25, 0.125]) { Success { value } => { let halves = value
                    checkAll("float kernels", [
                            sum == 9.0, (halves |> gpuFold(0.0, addFloats)) == 0.875, (halves |> gpuMap(scale) |> gpuFold(0.0, addFloats)) == 1.3125,
                            (gpuGet(halves |> gpuMap(scale), 2) ?: 9.5) == 0.1875, gpuLength(halves |> gpuMap(scale)) == 3, gpuSatisfies(toGpu([0.5, 0.25]), fn(uploaded7) => (uploaded7 |> gpuFold(0.0, addFloats)) == 0.75),
                            (indices4 |> gpuMap(toFloat) |> gpuFold(0.0, addFloats)) == 6.0, (gpuGet(indices4 |> gpuMap(toFloat), 3) ?: 9.5) == 3.0,
                            (indices0 |> gpuMap(toFloat) |> gpuFold(2.5, addFloats)) == 2.5
                    ])
                } Error { message } => check("GPU allocation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// boolKernelCase maps int elements to bool elements and counts the odd ones, covering the all-true and all-false buffers beside the mixed one.
fn boolKernelCase() = withIndices(0, fn(indices0) => boolKernelWith(indices0))
fn boolKernelWith(indices0) = {
    match toGpu([1, 2, 3, 4, 5]) { Success { value } => { let odds = value |> gpuMap(isOdd)
            match toGpu([1, 3]) { Success { value } => { let allTrue = value |> gpuMap(isOdd)
                    match toGpu([2, 4]) { Success { value } => { let allFalse = value |> gpuMap(isOdd)
                            checkAll("bool kernels", [
                                    gpuLength(odds) == 5, (odds |> gpuFold(0, countOdd)) == 3, (gpuGet(odds, 0) ?: false) == true, (gpuGet(odds, 1) ?: true) == false,
                                    (gpuGet(odds, 4) ?: false) == true, (lastOf(odds) ?: false) == true, readback(odds, 1) == "false", readback(odds, 5) == oobMessage(), gpuLength(allTrue) == 2,
                                    (allTrue |> gpuFold(0, countOdd)) == 2, (allFalse |> gpuFold(0, countOdd)) == 0, gpuSatisfies(toGpu([true, true, false]), fn(uploaded3) => (uploaded3 |> gpuFold(0, countOdd)) == 2),
                                    gpuLength(indices0 |> gpuMap(isOdd)) == 0
                            ])
                        } Error { message } => check("GPU allocation", "success", toString(message)) }
                } Error { message } => check("GPU allocation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// bigCase pushes the copy path itself to scale: a hundred thousand elements out to a list and back into a buffer, boundary indices and closed-form sums checked on every hop.
fn bigCase() = withIndices(100000, fn(indicesWide) => bigWith(indicesWide))
fn bigWith(indicesWide) = {
    let wide = indicesWide
    let doubled = doubledInts(wide)
    match fromGpu(wide) { Success { value } => { let back = value
            match toGpu(back) { Success { value } => { let rebuilt = value
                    checkAll("hundred-thousand element copies", [
                            gpuLength(wide) == 100000, gpuLength(doubled) == 100000, listLength(back) == 100000, gpuLength(rebuilt) == 100000,
                            (wide |> gpuFold(0, addInts)) == 4999950000, (doubled |> gpuFold(0, addInts)) == 9999900000, (rebuilt |> gpuFold(0, addInts)) == 4999950000,
                            (gpuGet(wide, 0) ?: 9) == 0, (lastOf(wide) ?: 0) == 99999, (gpuGet(doubled, 99999) ?: 0) == 199998, (gpuGet(rebuilt, 99999) ?: 0) == 99999,
                            (listGet(back, 99999) ?: 0) == 99999, (listGet(back, 100000) ?: -1) == -1, readback(wide, 100000) == oobMessage(), readback(rebuilt, -1) == oobMessage(),
                            widthOf(rebuilt) == widthOf(wide)
                    ])
                } Error { message } => check("GPU allocation", "success", toString(message)) }
        } Error { message } => check("GPU operation", "success", toString(message)) }
}
/// A kernel whose body is a BLOCK with an internal `let`. Plan 0002 recorded this as failing with `unknown identifier \`base\`` — the inline-callback path was said to lose the block's local scope, with named kernels as the workaround. It lowers correctly; nothing pinned it, so the item could not be closed. Both lambda spellings are exercised because they reach the lowering by different routes, and the suite runs under BOTH `OSPREY_GPU_KERNELS=extract` and `=inline`, so this holds for the extracted and the inlined lowering alike. Implements [GPU-KERNEL-FORM].
fn blockBodiedKernelCase() = withIndices(4, fn(indices4) => withIndices(3, fn(indices3) => blockBodiedKernelWith(indices4, indices3)))
fn blockBodiedKernelWith(indices4, indices3) = {
    let fromFn = indices4 |> gpuMap(fn(r) => { let base = (r * 3)
            base + 1 })
    let fromLambda = indices4 |> gpuMap(|r| => { let tripled = (r * 3)
            tripled + 1 })
    let widened = indices3 |> gpuMap(fn(r) => { let asFloat = toFloat(r)
            asFloat * 0.5 })
    checkAll("a block-bodied kernel keeps its internal let bindings", [
            gpuLength(fromFn) == 4, (gpuGet(fromFn, 0) ?: 99) == 1, (gpuGet(fromFn, 1) ?: 99) == 4, (gpuGet(fromFn, 3) ?: 99) == 10, gpuLength(fromLambda) == 4,
            (gpuGet(fromLambda, 0) ?: 99) == 1, (gpuGet(fromLambda, 3) ?: 99) == 10, (fromFn |> gpuFold(0, addInts)) == 22, gpuLength(widened) == 3,
            (gpuGet(widened, 0) ?: 9.5) == 0.0, (gpuGet(widened, 2) ?: 9.5) == 1.0
    ])
}
/// [GPU-BUFFER-ELEM]: one index read back through gpuGet must equal the source list's element — the exact gpuGet round-trip for that index.
fn denseRead(buffer, values, i) = match gpuGet(buffer, i) {
    Success { actual } => match listGet(values, i) { Success { expected } => actual == expected Error _ => false }
    Error _ => false
}
/// [GPU-BUFFER-ELEM]: an out-of-bounds gpuGet errors rather than yielding a sentinel element.
fn denseOutOfBounds(buffer, index) = match gpuGet(buffer, index) {
    Error _ => true
    Success _ => false
}
/// [GPU-BUFFER-ELEM]: every scalar width narrows into dense storage and widens back exactly — gpuGet reads each index at the element's own width, the identity kernel and fromGpu both return the source list, and out-of-bounds reads error.
fn denseRoundTrip(label, values) = withIndices(length(values), fn(indices) => denseRoundTripWith(label, values, indices))
fn denseRoundTripWith(label, values, indices) = {
    match toGpu(values) { Success { value } => { let buffer = value
            let mapped = gpuMap(buffer, fn(value) => value)
            let gathered = gpuZipWith(indices, buffer, fn(index, value) => gpuGet(buffer, index) ?: value)
            checkAll(label, [
                    gpuLength(buffer) == length(values), gpuSatisfies(fromGpu(buffer), fn(checked0) => structuralEquals(checked0, values)),
                    gpuSatisfies(fromGpu(mapped), fn(checked0) => structuralEquals(checked0, values)),
                    gpuSatisfies(fromGpu(gathered), fn(checked0) => structuralEquals(checked0, values)),
                    range(0, length(values)) |> fold(true, fn(ok, i) => ok && denseRead(buffer, values, i)), denseOutOfBounds(buffer, -1), denseOutOfBounds(buffer, length(values))
            ])
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
fn denseIntegerWidthsCase() = {
    let i8: List<int8> = [-128, 0, 127]
    let u8: List<uint8> = [0, 128, 255]
    let i16: List<int16> = [-32768, 0, 32767]
    let u16: List<uint16> = [0, 32768, 65535]
    let i32: List<int32> = [-2147483648, 0, 2147483647]
    let u32: List<uint32> = [0, 2147483648, 4294967295]
    denseRoundTrip("dense int8", i8)
    denseRoundTrip("dense uint8", u8)
    denseRoundTrip("dense int16", i16)
    denseRoundTrip("dense uint16", u16)
    denseRoundTrip("dense int32", i32)
    denseRoundTrip("dense uint32", u32)
}
fn denseWidthsCase() = {
    denseIntegerWidthsCase()
    let f16: List<float16> = [-0.5, 0.0, 1.5]
    let f32: List<float32> = [-0.5, 0.0, 1.5]
    denseRoundTrip("dense float16", f16)
    denseRoundTrip("dense float32", f32)
    denseRoundTrip("dense bool", [true, false, true])
    denseRoundTrip("dense int", [-9223372036854775808, 0, 9223372036854775807])
    denseRoundTrip("dense float", [-0.5, 0.0, 1.5])
}
/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}
test("buffer literals store elements densely at constant indices", fn() => exactArithmetic(literalCase))
test("a list value copies into a buffer element for element", fn() => exactArithmetic(listCopyCase))
test("gpu buffers round-trip lists densely", fn() => exactArithmetic(roundTripCase))
test("the empty buffer answers every builtin without elements", fn() => exactArithmetic(emptyCase))
test("a one-element buffer bounds gpuGet to index zero", fn() => exactArithmetic(singletonCase))
test("gpuGet errors identically at both ends of every buffer", fn() => exactArithmetic(boundsCase))
test("gpuIota spans zero, one and two hundred thousand indices", fn() => exactArithmetic(iotaCase))
test("int, float and bool words survive the identity kernel", fn() => exactArithmetic(elementCase))
test("buffers keep their tag through lets, pipes, params and returns", fn() => exactArithmetic(flowCase))
test("aliased bindings observe one immutable buffer", fn() => exactArithmetic(aliasCase))
test("a fused iterator buffer is addressable element by element", fn() => exactArithmetic(fusionCase))
test("pure int kernels map and fold on buffers", fn() => exactArithmetic(intKernelCase))
test("float kernels keep element bits through map and fold", fn() => exactArithmetic(floatKernelCase))
test("kernels may change the element scalar type", fn() => exactArithmetic(boolKernelCase))
test("the copy path stays exact at a hundred thousand elements", fn() => exactArithmetic(bigCase))
test("a block-bodied kernel keeps its internal let bindings", fn() => exactArithmetic(blockBodiedKernelCase))
test("every scalar width survives dense storage and round-trips through gpuGet", fn() => exactArithmetic(denseWidthsCase))
