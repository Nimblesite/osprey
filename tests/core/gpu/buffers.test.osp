/// [FAILURE-EXPLICIT] Allocation failure stops the case before its consumer.
fn withBuffer(result, work) = match result {
    Success { value } => work(value)
    Error { message } => check("GPU allocation", "success", toString(message))
}
/// [FAILURE-EXPLICIT] A GPU failure fails the predicate with its reason.
fn gpuSatisfies(result, predicate) = match result {
    Success { value } => predicate(value)
    Error { message } => { check("GPU operation", "success", toString(message))
        false }
}
/// [FAILURE-EXPLICIT] Allocation errors fail the case before its consumer runs.
fn withIndices(n, work) = withBuffer(gpuIota(n), work)
fn iotaError(n) = match gpuIota(n) { Success { value } => "unexpected success ${gpuLength(value)}" Error { message } => toString(message) }
// Dense GPU construction, round-trips and bounds checks; element tags survive lets, pipes, calls, returns and aliases.
// Implements [GPU-BUFFER], [GPU-BUFFER-ELEM], [GPU-BUFFER-LITERAL], [GPU-BUFFER-FROM-LIST],
// [GPU-BUFFER-FUSE], [GPU-BUFFER-TO-LIST], [GPU-BUFFER-LENGTH], [GPU-IOTA], [GPU-GET]; see 0034-GPUComputation.md.
/// square is a pure int kernel; the checker proves it performs no effects.
fn square(x) = (x * x)
/// addInts keeps the checked-arithmetic Result inside the kernel.
fn addInts(acc, x) = (acc + x)
/// scale is a pure float kernel; the buffer's element tag types x as float.
fn scale(x) = x * 1.5
/// addFloats is the float reduction kernel for gpuFold's combine slot.
fn addFloats(a, x) = a + x
/// isOdd maps an int element to a bool element, changing the buffer's type.
fn isOdd(x) = (x % 2 ) == 1
/// countOdd counts the true elements of a bool buffer.
fn countOdd(acc, flag) = match flag {
    true => (acc + 1)
    false => acc
}
/// same is the identity kernel: every scalar word must come back out unchanged, at the element type its source buffer was tagged with.
fn same(x) = x
/// The exact payload [GPU-GET] contracts for a read outside the buffer, so a wrong gather is a visible failure and never a sentinel element.
fn oobMessage() = "gpuGet: index out of bounds"
/// readback renders one gpuGet outcome as text — the element for a hit, the error payload for a miss. Being polymorphic over the element type, it is itself the assertion that gpuGet recovers int, float and bool alike.
fn readback(b, i) = match gpuGet(b, i) {
    Success { value } => toString(value)
    Error { message } => message
}
/// lastOf computes the final index from the length: the read that sits exactly on the in-bounds boundary.
fn lastOf(b) = gpuGet(b, (gpuLength(b) - 1) )
/// widthOf takes a buffer as a plain parameter — the handle and its element tag have to survive the call.
fn widthOf(b) = gpuLength(b)
/// doubledInts both receives and returns a buffer, so the tag must survive a parameter and a return in one call.
fn doubledInts(b) = b |> gpuMap(fn(x) => (x * 2) )
/// scaledFloats is doubledInts' float twin: tags are per-buffer, so a float buffer must come back out of a return still reading as float.
fn scaledFloats(b) = b |> gpuMap(scale)
/// chooseBuffer returns a buffer out of a match arm — the fourth binding form a handle travels through.
fn chooseBuffer(flag, a, b) = match flag {
    true => a
    false => b
}
/// literalCase pins [GPU-BUFFER-LITERAL]: a literal argument stores its elements straight into the dense buffer at constant indices, with no list built at all. Every scalar element type [GPU-BUFFER-ELEM] is covered, plus the degenerate one- and zero-element literals and the sign and magnitude extremes an int word must hold.
fn literalCase() = withBuffer(toGpu([3, 1, 4, 1, 5]), fn(ints) => withBuffer(toGpu([0.25, 0.5, 0.75, 1.0]), fn(floats) => withBuffer(toGpu([true, false, true]), fn(flags) => withBuffer(toGpu([-3, 0, 7, -1]), fn(signed) => withBuffer(toGpu([4611686018427387904, -4611686018427387904]), fn(wide) => literalCaseUploaded(ints, floats, flags, signed, wide))))))
fn literalCaseUploaded(ints, floats, flags, signed, wide) = {
    checkAll("buffer literals", [
            gpuLength(ints) == 5, gpuLength(floats) == 4, gpuLength(flags) == 3, gpuLength(signed) == 4, gpuLength(wide) == 2, gpuSatisfies(toGpu([9]), fn(uploaded42) => gpuLength(uploaded42) == 1),
            gpuSatisfies(toGpu([]), fn(uploaded41: GpuBuffer<int>) => gpuLength(uploaded41) == 0), widthOf(ints) == 5, (gpuGet(ints, 0) ?: 0) == 3, (gpuGet(ints, 1) ?: 0) == 1, (gpuGet(ints, 2) ?: 0) == 4,
            (gpuGet(ints, 3) ?: 0) == 1, (gpuGet(ints, 4) ?: 0) == 5, (lastOf(ints) ?: 0) == 5, (gpuGet(floats, 0) ?: 9.5) == 0.25, (gpuGet(floats, 1) ?: 9.5) == 0.5,
            (gpuGet(floats, 2) ?: 9.5) == 0.75, (gpuGet(floats, 3) ?: 9.5) == 1.0, (gpuGet(flags, 0) ?: false) == true, (gpuGet(flags, 1) ?: true) == false,
            (gpuGet(flags, 2) ?: false) == true, (lastOf(flags) ?: false) == true, (gpuGet(signed, 0) ?: 0) == -3, (gpuGet(signed, 1) ?: 9) == 0,
            (gpuGet(signed, 2) ?: 0) == 7, (gpuGet(signed, 3) ?: 0) == -1, (gpuGet(wide, 0) ?: 0) == 4611686018427387904, (gpuGet(wide, 1) ?: 0) == -4611686018427387904,
            (lastOf(floats) ?: 9.5) == 1.0, gpuSatisfies(toGpu([9]), fn(uploaded40) => (gpuGet(uploaded40, 0) ?: 0) == 9), (ints |> gpuFold(0, addInts)) == 14, (signed |> gpuFold(0, addInts)) == 3,
            (floats |> gpuFold(0.0, addFloats)) == 2.5, (flags |> gpuFold(0, countOdd)) == 2
    ])
}
/// listCopyCase pins [GPU-BUFFER-FROM-LIST]: a list *value* takes the copy loop rather than the literal path and must land on a buffer indistinguishable from the literal one — same length, same elements, same reduction — down to the one- and zero-element lists.
fn listCopyCase() = withIndices(0, fn(indices0) => listCopyWith(indices0))
fn listCopyWith(indices0) = {
    let source = [2, 4, 6, 8]
    match toGpu(source) { Success { value } => { let copied = value
            match fromGpu(copied) { Success { value } => { let read0 = value
                    match toGpu(read0) { Success { value } => { let relayed = value
                            let lone = [11]
                            match fromGpu(indices0) { Success { value } => { let read1 = value
                                    let none = read1
                                    checkAll("list copy path", [
                                            listLength(source) == 4, gpuLength(copied) == 4, (gpuGet(copied, 0) ?: 0) == 2, (gpuGet(copied, 1) ?: 0) == 4, (gpuGet(copied, 2) ?: 0) == 6,
                                            (gpuGet(copied, 3) ?: 0) == 8, (lastOf(copied) ?: 0) == 8, readback(copied, 4) == oobMessage(), readback(copied, -1) == oobMessage(),
                                            readback(copied, 0) == "2", (copied |> gpuFold(0, addInts)) == 20, gpuLength(relayed) == 4, (gpuGet(relayed, 2) ?: 0) == 6,
                                            (relayed |> gpuFold(0, addInts)) == 20, gpuSatisfies(toGpu(lone), fn(uploaded37) => gpuLength(uploaded37) == 1), gpuSatisfies(toGpu(lone), fn(uploaded36) => (gpuGet(uploaded36, 0) ?: 0) == 11), gpuSatisfies(toGpu(lone), fn(uploaded35) => (lastOf(uploaded35) ?: 0) == 11),
                                            listLength(none) == 0, gpuSatisfies(toGpu(none), fn(uploaded34) => gpuLength(uploaded34) == 0), gpuSatisfies(toGpu(none), fn(uploaded33) => (uploaded33 |> gpuFold(7, addInts)) == 7), gpuSatisfies(toGpu(source), fn(uploaded32) => widthOf(uploaded32) == widthOf(copied)),
                                            gpuSatisfies(toGpu(source), fn(uploaded31) => (uploaded31 |> gpuFold(0, addInts)) == (copied |> gpuFold(0, addInts)))
                                    ])
                                } Error { message } => check("GPU operation", "success", toString(message)) }
                        } Error { message } => check("GPU allocation", "success", toString(message)) }
                } Error { message } => check("GPU operation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// roundTripCase pins toGpu/fromGpu as an order-preserving dense copy in both directions [GPU-BUFFER-TO-LIST]: list to buffer to list to buffer, every index checked at every hop, with a list index past the end still failing.
fn roundTripCase() = withIndices(0, fn(indices0) => withIndices(6, fn(indices6) => roundTripWith(indices0, indices6)))
fn roundTripWith(indices0, indices6) = {
    match toGpu([3, 1, 4, 1, 5]) { Success { value } => { let buf = value
            match fromGpu(buf) { Success { value } => { let back = value
                    match toGpu(back) { Success { value } => { let viaList = value
                            match fromGpu(viaList) { Success { value } => { let twice = value
                                    checkAll("round trip", [
                                            gpuLength(buf) == 5, listLength(back) == 5, (listGet(back, 0) ?: 0) == 3, (listGet(back, 1) ?: 0) == 1, (listGet(back, 2) ?: 0) == 4,
                                            (listGet(back, 3) ?: 0) == 1, (listGet(back, 4) ?: 0) == 5, (listGet(back, 5) ?: 99) == 99, (listGet(back, -1) ?: 99) == 99, gpuLength(viaList) == 5,
                                            (gpuGet(viaList, 0) ?: 0) == 3, (gpuGet(viaList, 2) ?: 0) == 4, (gpuGet(viaList, 4) ?: 0) == 5, readback(viaList, 5) == oobMessage(),
                                            (viaList |> gpuFold(0, addInts)) == 14, listLength(twice) == 5, (listGet(twice, 4) ?: 0) == 5, gpuSatisfies(toGpu(twice), fn(uploaded28) => (uploaded28 |> gpuFold(0, addInts)) == 14),
                                            gpuSatisfies(fromGpu(indices0), fn(checked0) => listLength(checked0) == 0),
                                            gpuSatisfies(fromGpu(indices6), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded27) => gpuLength(uploaded27) == 6)),
                                            gpuSatisfies(fromGpu(indices6), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded26) => (uploaded26 |> gpuFold(0, addInts)) == 15)),
                                            gpuSatisfies(fromGpu(indices6), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded25) => (gpuGet(uploaded25, 5) ?: 0) == 5))
                                    ])
                                } Error { message } => check("GPU operation", "success", toString(message)) }
                        } Error { message } => check("GPU allocation", "success", toString(message)) }
                } Error { message } => check("GPU operation", "success", toString(message)) }
        } Error { message } => check("GPU allocation", "success", toString(message)) }
}
/// emptyCase pins the zero-element buffer through every builtin that takes one: no element is readable at any index, it materializes as an empty list, maps to another empty buffer, and folds to its seed untouched.
fn emptyCase() = withIndices(0, fn(indices0) => emptyWith(indices0))
fn emptyWith(indices0) = {
    let none = indices0
    let mapped = none |> gpuMap(square)
    let flags = none |> gpuMap(isOdd)
    let widened = none |> gpuMap(toFloat)
    checkAll("empty buffers", [
            gpuLength(none) == 0, gpuLength(mapped) == 0, gpuLength(flags) == 0, gpuLength(widened) == 0, gpuSatisfies(toGpu([]), fn(uploaded24: GpuBuffer<int>) => gpuLength(uploaded24) == 0), widthOf(none) == 0,
            gpuSatisfies(fromGpu(none), fn(checked0) => listLength(checked0) == 0), gpuSatisfies(fromGpu(mapped), fn(checked0) => listLength(checked0) == 0),
            (none |> gpuFold(0, addInts)) == 0, (none |> gpuFold(-7, addInts)) == -7, (mapped |> gpuFold(3, addInts)) == 3, (flags |> gpuFold(0, countOdd)) == 0,
            (widened |> gpuFold(2.5, addFloats)) == 2.5, (gpuGet(none, 0) ?: 42) == 42, (gpuGet(none, 1) ?: 42) == 42, (gpuGet(none, -1) ?: 42) == 42,
            (gpuGet(none, 1000000) ?: 42) == 42, (lastOf(none) ?: 42) == 42, readback(none, 0) == oobMessage(), readback(none, -1) == oobMessage(),
            readback(mapped, 0) == oobMessage(), readback(flags, 0) == oobMessage(), readback(widened, 0) == oobMessage()
    ])
}
/// singletonCase pins the one-element buffer: index 0 is the only address in bounds, so both 1 and -1 fail, and a fold sees exactly one element.
fn singletonCase() = withIndices(1, fn(indices1) => singletonWith(indices1))
fn singletonWith(indices1) = withBuffer(toGpu([42]), fn(lone) => withBuffer(toGpu([2.5]), fn(loneF) => withBuffer(toGpu([false]), fn(loneB) => singletonWithUploaded(indices1, lone, loneF, loneB))))
fn singletonWithUploaded(indices1, lone, loneF, loneB) = {
    let doubled = doubledInts(lone)
    checkAll("single-element buffers", [
            gpuLength(lone) == 1, gpuLength(loneF) == 1, gpuLength(loneB) == 1, gpuLength(indices1) == 1, (gpuGet(indices1, 0) ?: 9) == 0, (gpuGet(lone, 0) ?: 0) == 42,
            (gpuGet(loneF, 0) ?: 9.5) == 2.5, (gpuGet(loneB, 0) ?: true) == false, (gpuGet(lone, 1) ?: 9) == 9, (gpuGet(lone, -1) ?: 9) == 9,
            (gpuGet(loneF, 1) ?: 9.5) == 9.5, (gpuGet(loneB, 1) ?: true) == true, readback(lone, 1) == oobMessage(), readback(loneF, -1) == oobMessage(),
            readback(loneB, 2) == oobMessage(), readback(lone, 0) == "42", (lastOf(lone) ?: 0) == 42, (lastOf(loneF) ?: 9.5) == 2.5, (lastOf(loneB) ?: true) == false,
            (lone |> gpuFold(0, addInts)) == 42, (loneF |> gpuFold(0.0, addFloats)) == 2.5, (loneB |> gpuFold(0, countOdd)) == 0, gpuLength(doubled) == 1,
            (gpuGet(doubled, 0) ?: 0) == 84, gpuSatisfies(fromGpu(lone), fn(checked0) => listLength(checked0) == 1),
            gpuSatisfies(fromGpu(lone), fn(checked0) => (listGet(checked0, 0) ?: 0) == 42), gpuSatisfies(fromGpu(lone), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded23) => gpuLength(uploaded23) == 1))
    ])
}
/// boundsCase pins [GPU-GET] at both ends and far outside them for every element type: an in-bounds read returns the element at the buffer's own scalar type, and index == length, index == -1 and indices a million past either edge all return the identical Error payload.
fn boundsCase() = withBuffer(toGpu([10, 20, 30]), fn(ints) => withBuffer(toGpu([1.25, 2.5]), fn(floats) => withBuffer(toGpu([true, false]), fn(flags) => boundsCaseUploaded(ints, floats, flags))))
fn boundsCaseUploaded(ints, floats, flags) = {
    checkAll("bounds", [
            (gpuGet(ints, 0) ?: 0) == 10, (gpuGet(ints, 2) ?: 0) == 30, (gpuGet(ints, (gpuLength(ints) - 1) ) ?: 0) == 30, readback(ints, 0) == "10",
            readback(ints, 2) == "30", readback(floats, 0) == "1.25", readback(floats, 1) == "2.5", readback(flags, 0) == "true", readback(flags, 1) == "false",
            readback(ints, 3) == oobMessage(), readback(ints, 4) == oobMessage(), readback(ints, 1000000) == oobMessage(), readback(ints, -1) == oobMessage(),
            readback(ints, -1000000) == oobMessage(), readback(floats, 2) == oobMessage(), readback(floats, -1) == oobMessage(), readback(flags, 2) == oobMessage(),
            readback(flags, -1) == oobMessage(), (gpuGet(ints, gpuLength(ints)) ?: -1) == -1, (gpuGet(ints, 3) ?: -1) == -1, (gpuGet(ints, -1) ?: -1) == -1,
            (gpuGet(floats, 2) ?: 9.5) == 9.5, (gpuGet(floats, -1) ?: 9.5) == 9.5, (gpuGet(flags, 2) ?: true) == true, (gpuGet(flags, -1) ?: false) == false,
            (lastOf(ints) ?: 0) == 30, (lastOf(floats) ?: 9.5) == 2.5, (lastOf(flags) ?: true) == false
    ])
}
/// iotaCase pins [GPU-IOTA] across its domain: the empty, one- and two-element index buffers, a large one whose closed-form sum a miscounted loop cannot match, and negative counts, which report allocation errors rather than successful empty buffers.
fn iotaCase() = withIndices(0, fn(indices0) => withIndices(1, fn(indices1) => withIndices(2, fn(indices2) => withIndices(7, fn(indices7) => withIndices(200000, fn(indicesWide) => iotaWith(indices0, indices1, indices2, indices7, indicesWide))))))
fn iotaWith(indices0, indices1, indices2, indices7, indicesWide) = {
    let one = indices1
    let pair = indices2
    let seven = indices7
    let wide = indicesWide
    checkAll("iota", [
            gpuLength(indices0) == 0, gpuLength(one) == 1, gpuLength(pair) == 2, gpuLength(seven) == 7, gpuLength(wide) == 200000,
            iotaError(-1) == "gpu: buffer allocation: a negative element count", iotaError(-200000) == "gpu: buffer allocation: a negative element count",
            widthOf(seven) == 7, iotaError(9223372036854775807) == "gpu: buffer allocation: element count overflows the byte size",
            iotaError(1152921504606846975) == "gpu: buffer allocation: out of memory", (gpuGet(one, 0) ?: 9) == 0, (gpuGet(pair, 0) ?: 9) == 0, (gpuGet(pair, 1) ?: 0) == 1,
            (gpuGet(seven, 0) ?: 9) == 0, (gpuGet(seven, 6) ?: 0) == 6, (lastOf(seven) ?: 0) == 6, (lastOf(wide) ?: 0) == 199999, (gpuGet(wide, 0) ?: 9) == 0,
            (gpuGet(wide, 100000) ?: 0) == 100000, readback(seven, 7) == oobMessage(), readback(one, 1) == oobMessage(), readback(wide, 200000) == oobMessage(),
            iotaError(-1) == "gpu: buffer allocation: a negative element count", (seven |> gpuFold(0, addInts)) == 21, (pair |> gpuFold(0, addInts)) == 1,
            (one |> gpuFold(0, addInts)) == 0, (wide |> gpuFold(0, addInts)) == 19999900000, (seven |> gpuMap(square) |> gpuFold(0, addInts)) == 91,
            gpuSatisfies(fromGpu(seven), fn(checked0) => listLength(checked0) == 7), gpuSatisfies(fromGpu(seven), fn(checked0) => (listGet(checked0, 3) ?: 0) == 3)
    ])
}
/// elementCase pins [GPU-BUFFER-ELEM]: int, float and bool words go through the identity kernel and come back bit-for-bit at their own type — a float buffer must never read back as the integer its bits spell.
