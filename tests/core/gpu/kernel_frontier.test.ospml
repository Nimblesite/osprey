// Kernel-frontier conformance ([GPU-KERNEL-ELEM-TYPING],
// [GPU-KERNEL-FORM], [GPU-KERNEL-EXTRACT]). The layout-bodied lambda below is
// intentionally the ML spelling required for parity with Default block bodies.

addFloats (a, x) = a + x

plus (a, x) = a + x

atFloat (xs, i) = gpuGet (xs, i) ?: 0.0

(** Deliberately unannotated: the concrete GpuBuffer<float> specialization and
    recursive self-call must be emitted from the call site. *)
rowDot (matrix, vector, cols, row, col) = match col == cols
    true => 0.0
    false => (atFloat (matrix, (((row * cols) ) + col) ) * atFloat (vector, col)
        + rowDot (matrix, vector, cols, row, (col + 1) ))

multiplicationOrderCase () =
    t = 2.0
    xs = toGpu [1.0, 2.0]
    ys = toGpu [3.0, 4.0]
    captureFirst = gpuZipWith (xs, ys, \(x, y) => t * x * y)
    captureLast = gpuZipWith (xs, ys, \(x, y) => x * y * t)
    checkAll "buffer slots type every multiplication order" [
        (captureFirst |> gpuFold 0.0 addFloats) == 22.0,
        (captureLast |> gpuFold 0.0 addFloats) == 22.0,
        (gpuGet (captureFirst, 0) ?: 0.0) == 6.0,
        (gpuGet (captureLast, 1) ?: 0.0) == 16.0
    ]

genericCombineCase () =
    xs = toGpu [1.0, 2.0, 3.0]
    checkAll "named generic float combines specialize from buffer slots" [
        (xs |> gpuFold 0.0 plus) == 6.0,
        (gpuGet (xs |> gpuScan 0.0 plus, 2) ?: 0.0) == 6.0
    ]

recursiveHelperCase () =
    matrix = toGpu [1.0, 2.0, 3.0, 4.0]
    vector = toGpu [10.0, 20.0]
    rows = gpuIota 2 |> gpuMap (\row => rowDot (matrix, vector, 2, row, 0))
    checkAll "recursive GPU helpers monomorphize from their call site" [
        gpuLength rows == 2,
        (gpuGet (rows, 0) ?: 0.0) == 50.0,
        (gpuGet (rows, 1) ?: 0.0) == 110.0,
        (rows |> gpuFold 0.0 addFloats) == 160.0
    ]

blockBodyCase () =
    t = 2.0
    xs = toGpu [1.0, 2.0, 3.0]
    mapped = xs |> gpuMap (\x =>
        y = t * x
        y + t)
    checkAll "block-bodied kernels preserve local bindings" [
        gpuLength mapped == 3,
        (gpuGet (mapped, 0) ?: 0.0) == 4.0,
        (gpuGet (mapped, 1) ?: 0.0) == 6.0,
        (gpuGet (mapped, 2) ?: 0.0) == 8.0,
        (mapped |> gpuFold 0.0 addFloats) == 18.0
    ]

(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()


test ("float kernel slots type both multiplication orders", \() => exactArithmetic (multiplicationOrderCase))
test ("named generic float combines specialize from buffer slots", \() => exactArithmetic (genericCombineCase))
test ("unannotated recursive helpers are valid GPU kernels", \() => exactArithmetic (recursiveHelperCase))
test ("block-bodied GPU kernels keep local bindings", \() => exactArithmetic (blockBodyCase))

builtinMapCase () =
    floats = gpuMap (toGpu [9007199254740993, -7]) toFloat
    positive = gpuMap (toGpu [-1.5, -0.0, 2.25]) abs
    abs = \x => x * 2.0
    shadowed = gpuMap (toGpu [3.0]) abs
    checkAll "builtin maps preserve scalar types and lexical shadowing" [
        (gpuGet (floats, 0) ?: 0.0) == 9007199254740992.0,
        (gpuGet (floats, 1) ?: 0.0) == -7.0,
        (gpuGet (positive, 0) ?: 0.0) == 1.5,
        toString (gpuGet (positive, 1) ?: 1.0) == "0.0",
        (gpuGet (positive, 2) ?: 0.0) == 2.25,
        (gpuGet (shadowed, 0) ?: 0.0) == 6.0
    ]

builtinZipCase () =
    left = toGpu [9223372036854775807, -9223372036854775808, 4000000000]
    right = toGpu [1, -1, 4000000000]
    added = gpuZipWith (left, right, wrapAdd)
    subtracted = gpuZipWith (left, right, wrapSub)
    multiplied = gpuZipWith (left, right, wrapMul)
    saturated = gpuZipWith (left, right, satMul)
    checkAll "builtin zip preserves wrapping and saturation boundaries" [
        (gpuGet (added, 0) ?: 0) == -9223372036854775808,
        (gpuGet (added, 1) ?: 0) == 9223372036854775807,
        (gpuGet (subtracted, 0) ?: 0) == 9223372036854775806,
        (gpuGet (subtracted, 1) ?: 0) == -9223372036854775807,
        (gpuGet (multiplied, 1) ?: 0) == -9223372036854775808,
        (gpuGet (multiplied, 2) ?: 0) == -2446744073709551616,
        (gpuGet (saturated, 1) ?: 0) == 9223372036854775807,
        (gpuGet (saturated, 2) ?: 0) == 9223372036854775807
    ]

builtinFoldCase () =
    source = toGpu [1, 1]
    lower = gpuScan (source, -9223372036854775808, satSub)
    upper = gpuScan (source, 9223372036854775807, satAdd)
    checkAll "builtin folds and scans preserve accumulator policy" [
        gpuFold (source, 9223372036854775807, wrapAdd) == -9223372036854775807,
        gpuFold (source, 9223372036854775807, satAdd) == 9223372036854775807,
        (gpuGet (lower, 1) ?: 0) == -9223372036854775808,
        (gpuGet (upper, 1) ?: 0) == 9223372036854775807
    ]

builtinPolicyCase () =
    mut faults = 0
    handle Arith
        overflow op left right wrapped =>
            faults := wrapAdd faults 1
            checkAll "extracted absolute overflow preserves operation arguments" [
                op == "abs", left == -9223372036854775808,
                right == 0, wrapped == -9223372036854775808
            ]
            77
    values = gpuMap (toGpu [-9223372036854775808, -4, 5]) abs
    checkAll "builtin kernel dispatches to the active arithmetic policy" [
        faults == 1, (gpuGet (values, 0) ?: 0) == 77,
        (gpuGet (values, 1) ?: 0) == 4, (gpuGet (values, 2) ?: 0) == 5
    ]

test "builtin maps specialize and respect shadowing" builtinMapCase
test "builtin zip pins wrapping and saturation" builtinZipCase
test "builtin folds and scans preserve accumulator policy" builtinFoldCase
test "builtin kernels preserve the active overflow policy" builtinPolicyCase

builtinDivisionCase () =
    mut faults = ""
    handle Arith
        overflow op left right wrapped =>
            checkAll "division overflow arguments" [op == "intDiv", left == -9223372036854775808, right == -1, wrapped == left]
            faults := faults + "overflow;"
            41
        remainderByZero left =>
            expect left 7
            faults := faults + "zero;"
            42
    values = gpuZipWith (toGpu [-9223372036854775808, 7, 9], toGpu [-1, 0, 2], intDiv)
    checkAll "builtin division dispatches once in element order" [faults == "overflow;zero;",
        (gpuGet (values, 0) ?: 0) == 41, (gpuGet (values, 1) ?: 0) == 42, (gpuGet (values, 2) ?: 0) == 4]

test "builtin integer division preserves ordered recovery" builtinDivisionCase
