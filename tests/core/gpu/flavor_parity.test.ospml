(** [FAILURE-EXPLICIT] A read error fails the predicate with its reason. *)
readSatisfies (result, predicate) = match result
    Success value => predicate value
    Error message =>
        check ("GPU readback", "success", toString message)
        false
iotaOutcome result = match result
    Success value => "unexpected success ${gpuLength value}"
    Error message => toString message
// Aspirational GPU frontend parity. In particular, unary minus must not turn
// the minimum int literal or a negative gpuIota argument into a different ML
// parse ([GPU-BUFFER-ELEM], [GPU-IOTA], [GPU-KERNEL-EXTRACT]).

minimumIntCase () =
    minimum = -9223372036854775808
    buf = toGpu [minimum]
    checkAll "minimum int literal crosses the GPU boundary" [
        gpuLength buf == 1,
        (gpuGet (buf, 0) ?: 0) == minimum,
        readSatisfies (fromGpu (buf), \checked0 => (listGet (checked0, 0) ?: 0) == minimum)
    ]
negativeIotaCase () =
    direct = gpuIota -3
    piped = -7 |> gpuIota
    checkAll "negative gpuIota arguments report allocation errors" [
        iotaOutcome direct == "gpu: buffer allocation: a negative element count",
        iotaOutcome piped == "gpu: buffer allocation: a negative element count",
        iotaOutcome direct == iotaOutcome piped,
        iotaOutcome (gpuIota (-9223372036854775808)) == "gpu: buffer allocation: a negative element count"
    ]


test ("minimum int literals are flavor-equivalent in GPU buffers", minimumIntCase)
test ("negative gpuIota arguments are flavor-equivalent", negativeIotaCase)

denseFloatCombinatorsCase () =
    values : List<float32>
    values = [0.5, 1.0, 1.5]
    buffer = toGpu values
    scan = gpuScan (buffer, toFloat32 0.0, \(acc, value) => acc + value)
    kept = gpuFilter (buffer, \value => value > toFloat32 0.5)
    zipped = gpuZipWith (buffer, buffer, \(a, b) => a + b)
    checkAll "dense float32 combinators" [
        gpuFold (buffer, toFloat32 0.0, \(acc, value) => acc + value) == toFloat32 3.0,
        readSatisfies (fromGpu (scan), \checked0 => join (mapList (checked0, toString), ",") == "0.5,1.5,3.0"),
        readSatisfies (fromGpu (kept), \checked0 => join (mapList (checked0, toString), ",") == "1.0,1.5"),
        readSatisfies (fromGpu (zipped), \checked0 => join (mapList (checked0, toString), ",") == "1.0,2.0,3.0")
    ]
test ("float32 reductions scans filters and zip keep their width", denseFloatCombinatorsCase)
