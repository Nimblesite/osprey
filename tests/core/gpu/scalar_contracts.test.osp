// Scalar transfer conformance: inferred element types survive runtime lists,
// GPU buffers and repeated crossings [GPU-BUFFER-ELEM] [GPU-BUFFER-FROM-LIST]
// [GPU-BUFFER-TO-LIST]. Host kernels retain [FLOAT-IEEE-RESULTS].

fn addFloats(a, x) = a + x

fn countTrue(a, x) = match x {
    true => (a + 1) 
    false => a
}

/// listReverse forces the runtime-list copy path; a direct literal would take
/// [GPU-BUFFER-LITERAL] and would not exercise the runtime element metadata.
fn floatListValue() = listReverse([2.5, 1.5])
fn boolListValue() = listReverse([true, false, false])

fn listValueTagsCase() = {
    let floats = toGpu(floatListValue())
    let flags = toGpu(boolListValue())
    checkAll("runtime list values keep GPU scalar tags", [
        gpuLength(floats) == 2,
        (gpuGet(floats, 0) ?: 99.0) == 1.5,
        (gpuGet(floats, 1) ?: 99.0) == 2.5,
        (floats |> gpuFold(0.0, addFloats)) == 4.0,
        gpuLength(flags) == 3,
        (gpuGet(flags, 0) ?: true) == false,
        (gpuGet(flags, 1) ?: true) == false,
        (gpuGet(flags, 2) ?: false) == true,
        (flags |> gpuFold(0, countTrue)) == 1
    ])
}

fn fromGpuScalarCase() = {
    let floats = fromGpu(toGpu([1.25, 2.5, 5.0]))
    let flags = fromGpu(toGpu([true, false, true]))
    checkAll("fromGpu preserves float and bool list elements", [
        listLength(floats) == 3,
        (listGet(floats, 0) ?: 99.0) == 1.25,
        (listGet(floats, 1) ?: 99.0) == 2.5,
        (listGet(floats, 2) ?: 99.0) == 5.0,
        listLength(flags) == 3,
        (listGet(flags, 0) ?: false) == true,
        (listGet(flags, 1) ?: true) == false,
        (listGet(flags, 2) ?: false) == true
    ])
}

fn repeatedCrossingCase() = {
    let floats = toGpu(fromGpu(toGpu(floatListValue())))
    let flags = toGpu(fromGpu(toGpu(boolListValue())))
    let floatsBack = fromGpu(floats)
    let flagsBack = fromGpu(flags)
    checkAll("repeated host and GPU crossings retain scalar types", [
        gpuLength(floats) == 2,
        (gpuGet(floats, 0) ?: 99.0) == 1.5,
        (gpuGet(floats, 1) ?: 99.0) == 2.5,
        (floats |> gpuFold(0.0, addFloats)) == 4.0,
        (listGet(floatsBack, 0) ?: 99.0) == 1.5,
        (listGet(floatsBack, 1) ?: 99.0) == 2.5,
        gpuLength(flags) == 3,
        (flags |> gpuFold(0, countTrue)) == 1,
        (listGet(flagsBack, 0) ?: true) == false,
        (listGet(flagsBack, 2) ?: false) == true
    ])
}

/// With no first element to inspect, lowering must use the inferred result type
/// rather than leave the owner bare and let gpuGet default the word to int.
fn emptyTypedLiteralCase() = checkAll("empty literals retain contextual scalar types", [
    gpuLength(toGpu([])) == 0,
    (gpuGet(toGpu([]), 0) ?: 9.5) == 9.5,
    (gpuGet(toGpu([]), 0) ?: true) == true,
    listLength(fromGpu(toGpu([]))) == 0
])

/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}


test("runtime list values retain float and bool GPU element tags", fn() => exactArithmetic(listValueTagsCase))
test("fromGpu reads float and bool elements at their source types", fn() => exactArithmetic(fromGpuScalarCase))
test("repeated List and GpuBuffer crossings preserve scalar types", fn() => exactArithmetic(repeatedCrossingCase))
test("empty GPU literals retain contextual scalar types", fn() => exactArithmetic(emptyTypedLiteralCase))

/// [FLOAT-IEEE-RESULTS]: host kernels obey the scalar arithmetic contract.
fn squareScalar(value) = value * value
fn subtractSelf(value) = value - value
fn divideZero(value) = value / 0.0
fn remainderZero(value) = value % -0.0

fn gpuIeeeCase() = {
    let seed = toGpu([10000000000000000.0])
    let fourth = seed |> gpuMap(squareScalar) |> gpuMap(squareScalar)
    let infinityBuffer = fourth |> gpuMap(squareScalar) |> gpuMap(squareScalar) |> gpuMap(squareScalar)
    let infinity = gpuGet(infinityBuffer, 0) ?: 0.0
    let nanBuffer = infinityBuffer |> gpuMap(subtractSelf)
    let nan = gpuGet(nanBuffer, 0) ?: 0.0
    let roundTrip = toGpu(listReverse(fromGpu(toGpu([infinity, nan, -0.0]))))
    checkAll("host GPU kernels preserve non-finite values and signed zero", [
        infinity > 10000000000000000.0, nan != nan,
        (infinityBuffer |> gpuFold(0.0, addFloats)) == infinity,
        (gpuGet(roundTrip, 2) ?: 0.0) == infinity,
        (gpuGet(roundTrip, 1) ?: 0.0) != (gpuGet(roundTrip, 1) ?: 0.0),
        toString(gpuGet(roundTrip, 0) ?: 1.0) == "-0.0"
    ])
}

fn gpuFloatZeroCase() = {
    mut faults = ""
    handle Arith { divideByZero op _ => { faults = faults + op
        0.25 } }
    let input = toGpu([1.0, 0.0, -1.0])
    let quotients = input |> gpuMap(divideZero)
    let remainders = input |> gpuMap(remainderZero)
    checkAll("host GPU zero divisors use the enclosing policy", [
        (quotients |> gpuFold(0.0, addFloats)) == 0.75,
        (remainders |> gpuFold(0.0, addFloats)) == 0.75,
        faults == "///%%%"
    ])
}

test("host GPU arithmetic preserves IEEE non-finite values", gpuIeeeCase)
test("host GPU float zero divisors use explicit recovery", gpuFloatZeroCase)

/// [BUILTIN-ABS]: builtin callbacks use their inferred scalar ABI and policy.
fn gpuAbsoluteCase() = {
    let floats = toGpu([-2.5, -0.0, 3.5]) |> gpuMap(abs)
    mut faults = ""
    handle Arith { overflow op lhs rhs wrapped => {
        checkAll("GPU abs overflow payload", [lhs == -9223372036854775808, rhs == 0, wrapped == lhs])
        faults = faults + op
        17
    } }
    let integers = toGpu([-9223372036854775808, -3, 4]) |> gpuMap(abs)
    checkAll("GPU abs keeps float and integer callback contracts", [
        (gpuGet(floats, 0) ?: 0.0) == 2.5,
        toString(gpuGet(floats, 1) ?: 1.0) == "0.0",
        (gpuGet(floats, 2) ?: 0.0) == 3.5,
        (gpuGet(integers, 0) ?: 0) == 17,
        (gpuGet(integers, 1) ?: 0) == 3,
        (gpuGet(integers, 2) ?: 0) == 4, faults == "abs"
    ])
}

test("host GPU abs callbacks retain numeric types and recovery", gpuAbsoluteCase)
