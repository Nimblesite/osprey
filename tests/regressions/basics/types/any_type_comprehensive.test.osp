// Erased compatibility values [TYPE-ANY].

fn getDynamicValue() -> any = 42

/// This should also pass - explicit any with parameter
fn processAnyValue(input) -> any = input + 10 ?: 0

/// Every `any` above carries a SCALAR, which is why erased HEAP values went
/// uncovered. Forwarding one through `any` must not disturb it: the erasure
/// carries no ownership either way, so `forward` merely borrows the word while
/// the caller's frame keeps owning the string it built.
///
/// A codegen rule that owned the recovered pointer broke exactly this — the
/// epilogue moved that invented owner out, released the real one, and returned
/// a dangling pointer, printing nothing under `--memory=arc`. Built at runtime
/// rather than written as a literal, or the pointer would be a global and never
/// counted at all. [GC-ARC-PERCEUS]
///
/// Erasure is one-way [TYPE-ANY], so the heap value is forwarded into another
/// `any` sink rather than recovered as a `string`: an annotation that
/// resurrects a pointer is rejected, and
/// `examples/failscompilation/any_recovery_by_annotation.ospo` pins every form
/// of it in both flavors.
fn forward(x: any) -> any = x

fn forwardedHeap() -> string = processAny(forward("dyn" + "amic"))

print("Explicit any return type works")
print("getDynamicValue() = ${getDynamicValue()}")
print("processAnyValue(5) = ${processAnyValue(5)}")

/// Test storing any values without auto-conversion
let result1 = getDynamicValue()
let result2 = processAnyValue(5)
print("Any values stored without auto-conversion")

/// Test getRegularArgumentPosition coverage
fn testArgs(a, b, c) = match a > 0 {
    true => b + " positive"
    false => b + " zero or negative " + toString(c)
}

let argResult = testArgs(a: 5, b: "value", c: true)
print("testArgs result: ${argResult}")

/// Test type inference edge cases with any
fn processAny(x: any) -> string = "Processed any"

let anyProcessed1 = processAny(42)
let anyProcessed2 = processAny("hello")
let anyProcessed3 = processAny(true)

print("processAny(42): Processed any")
print("processAny(\"hello\"): Processed any")
print("processAny(true): Processed any")

/// Test String() and Category() methods coverage with various types
type TestType = { value: string }

let testObj = TestType { value: "test data" }
let testObj2 = TestType { value: "123" }
let testObj3 = TestType { value: "false" }

/// Test field access on any types to trigger more coverage
fn getAnyField(obj) = {
    obj.value
}

let extracted1 = getAnyField(testObj)
let extracted2 = getAnyField(testObj2)
let extracted3 = getAnyField(testObj3)

print("Extracted any values:")
print("test data")
print("123")
print("false")

/// Test type comparison workaround since any comparison is complex
fn compareTypes(a: any, b: any) = "Type comparison tested"

let comp1 = compareTypes(a: 42, b: 42)
let comp2 = compareTypes(a: 42, b: "42")
let comp3 = compareTypes(a: "test", b: "test")

print("Type comparisons:")
print("Type comparison tested")
print("Type comparison tested")
print("Type comparison tested")

/// Test union type basic functionality
type Status = Active | Inactive

let status1 = Active
let status2 = Inactive

fn getStatusString(s) = match s {
    Active => "active"
    Inactive => "inactive"
}

let statusStr1 = getStatusString(status1)
let statusStr2 = getStatusString(status2)

print("Status types:")
print("${statusStr1}")
print("${statusStr2}")

/// Test basic union types for coverage - exercises NewUnionType, String(), Category(), Equals()
type SimpleUnion = A | B | C

fn processSimple(u) = match u {
    A => "Got A"
    B => "Got B"
    C => "Got C"
}

/// Test SimpleUnion
let simple1 = A
let simple2 = B
let simple3 = C
print("Simple union:")
print(processSimple(simple1))
print(processSimple(simple2))
print(processSimple(simple3))

/// Test union type equality
type Color = Red | Green | Blue

let color1 = Red
let color2 = Red
let color3 = Blue

fn compareColors(c1, c2) = match c1 {
    Red => match c2 {
        Red => "Both red"
        _ => "Different colors"
    }
    Green => match c2 {
        Green => "Both green"
        _ => "Different colors"
    }
    Blue => match c2 {
        Blue => "Both blue"
        _ => "Different colors"
    }
}

print("Union equality tests:")
print(compareColors(c1: color1, c2: color2))
print(compareColors(c1: color1, c2: color3))

/// --- Structural narrowing [PATTERN-STRUCTURAL] [PATTERN-TUPLE] ---
/// The ONLY read through an erased value is a structural match: arms select
/// by the value's runtime row, `..` opens a row to extensions, a tuple arm is
/// the positional spelling, and every scalar declines each field-naming arm
/// so the catch-all takes it. The heap recovery that annotations lost comes
/// back here as a narrowing: `held` reads a runtime-built string straight
/// back out of the erased record's row.
type Boxed = { held: string, tag: int }
type Pair = Pair(int, string)
type Point = { x: int, y: int }

fn describeAny(v: any) -> string = match v {
    { held, .. } => "held=${held}"
    { value }    => "value=${value}"
    (n, s)       => "pair=${n}:${s}"
    _            => "other=${v}"
}

/// Narrowing is stable: the same box selects the same arm every time.
fn describeTwice(v: any) -> string = "${describeAny(v)}/${describeAny(v)}"

/// Rendering reads through the shape descriptor, so an erased record prints
/// its row and an erased scalar prints itself — never a machine word.
fn erasedPoint() -> any = Point { x: 1, y: 2 }

/// Every descriptor kind renders through its own arm: a float, a bool, a
/// nullary union variant, a record-payload variant, a positional-payload
/// variant, a `Result` block, and the opaque handles a descriptor cannot see
/// into. All are reachable from ordinary source, and none of the union,
/// `Result`, float or opaque render paths had a single test — an erased float
/// would have printed its IEEE bits and nobody would have known [TYPE-ANY].
type Shape = Circle { radius: int } | Square { side: int }

fn erasedKinds() -> string =
    "${forward(1.5 + 0.25)}|${forward(1 < 2)}|${forward(Green)}|${forward(Circle { radius: 3 })}|${forward(intDiv(10, 2))}|${forward(listAppend(List(), 1))}|${forward(mapSet(Map(), "k", 1))}"

/// A container of erased values keeps them BOXED. Folding an `any` element
/// into the uniform integer word tagged the slots unmanaged and read each
/// box's ADDRESS back as an `int`, so a round-tripped element rendered as a
/// pointer and its payload was never released. Both list representations have
/// to survive it — the flat literal here, the runtime `List` below — and both
/// a scalar and a heap payload, since only the heap one moves the ARC oracle
/// off zero [TYPE-ANY].
fn erasedInList() -> string = match [forward("bo" + "xed"), forward(7)] {
    [a, b] => "${describeAny(a)}|${describeAny(b)}"
    _      => "miss"
}

fn erasedInRuntimeList() -> string =
    "${listGet(listAppend(listAppend(List(), forward("ap" + "pended")), forward(8)), 0)}"

/// A fold's loop-carried accumulator crosses a representation boundary as a
/// raw word, and its rebind carried its own hand-written "is this a string or
/// a handle" test, so it answered `no` for a box [GC-ARC-PERCEUS]. The fiber
/// result slot had the identical bug; it is covered in
/// tests/regressions/fiber/fiber_showcase, which spawns and so cannot link on
/// wasm32 — keeping it here would cost this file its wasm goldens.
fn foldAny() -> string =
    describeAny(range(0, 3) |> fold(forward("se" + "ed"), |acc, x| => forward(acc)))

/// An erased operand crosses an effect mailbox as the box it is, and replacing
/// a captured `mut any` must RELEASE the box it displaces. The rebind released
/// only strings and handles, so every handler operation left the previous box —
/// and any payload hanging off it — alive; the leak grows with the number of
/// operations, and the ARC oracle counts what survives.
///
/// No arm here uses `resume`, which is what keeps this file linkable on wasm32:
/// a value-carrying `resume` compiles to a captured continuation and pulls in
/// `__osprey_coro_suspend`, which that target has no port of. The resuming twin
/// of this case — an erased box routed through the mailbox and back out of a
/// suspend/resume round trip — lives in tests/regressions/effects/handler_scoping,
/// which is already pinned unportable for exactly that symbol.
/// [EFFECTS-OPERATION-MAILBOX]
effect Swap {
    swap: fn(any) -> Unit
}

fn swapWork() -> Unit !Swap = {
    perform Swap.swap(forward("re" + "placed"))
    perform Swap.swap(11)
}

fn swapped() -> string = {
    mut slot = forward("ini" + "tial")
    handle Swap
        swap item => { slot = item }
    in swapWork()
    describeAny(slot)
}

/// Built, boxed, never read: the erasure alone must not disturb ownership —
/// the ARC live-object oracle observes the drop. A statement discards it; a
/// `-> Unit` annotation could not, since even a discard of `any` counts as
/// recovery at an annotation.
forward("dis" + "carded")
print("narrowed: ${describeAny(Boxed { held: "print" + "ed", tag: 0 })}")
print("rendered: ${erasedPoint()}")

/// Verifies erased values still flow through fields, arguments, and union matches.
fn anyTypeBehaviorCase() = {
    let object = TestType { value: "payload" }
    checkAll("any values and inferred union behavior", [
        describeAny(Boxed { held: "dyn" + "amic", tag: 9 }) == "held=dynamic",
        describeAny(TestType { value: "via row" }) == "value=via row",
        describeAny(Pair(7, "seven")) == "pair=7:seven",
        describeAny(42) == "other=42",
        describeAny(forward("still" + "erased")) == "other=stillerased",
        erasedKinds() == "1.75|true|Green|Circle { radius: 3 }|Success(5)|<list>|<map>",
        erasedInList() == "other=boxed|other=7",
        erasedInRuntimeList() == "Success(appended)",
        swapped() == "other=11",
        foldAny() == "other=seed",
        describeTwice(Boxed { held: "twin", tag: 2 }) == "held=twin/held=twin",
        toString(erasedPoint()) == "{ x: 1, y: 2 }",
        toString(getDynamicValue()) == "42",
        toString(processAnyValue(5)) == "15",
        forwardedHeap() == "Processed any",
        processAny(42) == "Processed any",
        processAny("hello") == "Processed any",
        processAny(true) == "Processed any",
        getAnyField(object) == "payload",
        testArgs(a: 3, b: "value", c: false) == "value positive",
        testArgs(a: 0, b: "value", c: true) == "value zero or negative true",
        getStatusString(Active) == "active",
        getStatusString(Inactive) == "inactive",
        processSimple(A) == "Got A",
        processSimple(B) == "Got B",
        processSimple(C) == "Got C",
        compareColors(c1: Red, c2: Red) == "Both red",
        compareColors(c1: Red, c2: Blue) == "Different colors"
    ])
}
test("any values retain usable behavior across typed boundaries", anyTypeBehaviorCase)
