(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()

// ML-flavor twin of type_equality_comprehensive.osp — byte-identical IR.
// Generic records, function-type equality through HOFs, generic
// monomorphization, and union variants compared by tag.

print "=== TYPE EQUALITY ==="

(** --- Generic type equality --- *)
type Container T =
    value : T
type Pair T U =
    first : T
    second : U
type Triple T U V =
    first : T
    second : U
    third : V

makeContainer val = Container(value = val)
makePair (a, b) = Pair(first = a, second = b)
makeTriple (a, b, c) = Triple(first = a, second = b, third = c)

cInt1 = makeContainer 42
cInt2 = makeContainer 99
cStr = makeContainer "text"
pairIS1 = makePair (1, "test")
pairIS2 = makePair (2, "hello")
tIBI = makeTriple (1, "test", 42)

print "C<int>:  ${cInt1.value}, ${cInt2.value}"
print "C<str>:  ${cStr.value}"
print "P<I,S>:  ${pairIS1.first}/${pairIS1.second} | ${pairIS2.first}/${pairIS2.second}"
print "T<I,S,I>: ${tIBI.first}/${tIBI.second}/${tIBI.third}"
print ""

(** --- Function type equality via HOFs ---
    Inference keeps the function values concrete; threeArgAdd alone needs its
    signature to pin the operand types its checked arithmetic cannot. *)
addOne x = x + 1 
timesTwo x = x * 2 
minusOne x = x - 1 
excl s = s + "!"
ques s = s + "?"
intToString x = toString x
twoArgAdd (a, b) = a + b 
threeArgAdd : int -> int -> int -> int
threeArgAdd (a, b, c) = a + b + c 

applyInt (f, x) = f x
applyStr (f, s) = f s
applyToStr (f, x) = f x
applyTwo (f, a, b) = f (a, b)
applyThree (f, a, b, c) = f (a, b, c)

print "=== Same (int)->int passed via HOF ==="
exactArithmetic (\() =>
    print (toString (applyInt (addOne, 10))))
exactArithmetic (\() =>
    print (toString (applyInt (timesTwo, 10))))
exactArithmetic (\() =>
    print (toString (applyInt (minusOne, 10))))

print "=== Same (string)->string passed via HOF ==="
print (applyStr (excl, "hi"))
print (applyStr (ques, "hi"))

print "=== Different shapes ==="
print (applyToStr (intToString, 42))
exactArithmetic (\() =>
    print (toString (applyTwo (twoArgAdd, 5, 7))))
exactArithmetic (\() =>
    print (toString (applyThree (threeArgAdd, 1, 2, 3))))
print ""

(** --- Generic monomorphization via identity-like functions --- *)
identity x = x
duplicate x = x
print (toString (identity 42))
print (toString (duplicate 99))
print (identity "a")
print (duplicate "b")

(** --- Union type equality (same tag = same, different tag = different) --- *)
type Color =
    Red
    Green
    Blue
colorName c =
    match c
        Red => "red"
        Green => "green"
        Blue => "blue"
sameColor (a, b) =
    match a
        Red =>
            match b
                Red => true
                _ => false
        Green =>
            match b
                Green => true
                _ => false
        Blue =>
            match b
                Blue => true
                _ => false
c1 = Red
c2 = Red
c3 = Blue
print "color1=${colorName c1} color3=${colorName c3}"
print "sameRR=${toString (sameColor (c1, c2))}"
print "sameRB=${toString (sameColor (c1, c3))}"

(** --- Declaration-site variance: out T (covariant) / in T (contravariant) ---
    Variance is position-checked: `out T` may appear only where the payload
    flows out, `in T` only where it flows in (function parameters flip the
    polarity). Payload instantiations match exactly at the leaves; mkGate's
    signature pins the function payload's exact Result channel, and mkFeed's
    is inferred from its unchecked arithmetic.
    Implements [TYPE-VARIANCE-DECL], [TYPE-VARIANCE-ASSIGN],
    [FLAVOR-ML-GENERICS] *)
type Feed out T =
    Feed
        supply : T
    Dry
type Gate in T =
    Gate
        admit : T -> bool
    Open

label f = match f
    Feed _supply => "supplied"
    Dry => "dry"
mkFeed () = Feed(supply = \x => x * 2)
integerFeed () = Feed(supply = 7)
erasedFeedValue (feed : Feed<any>) = match feed
    Feed value => toString value
    Dry => "dry"
type Parcel out T =
    held : T
integerParcel () = Parcel(held = 11)
erasedParcelValue (parcel : Parcel<any>) = toString parcel.held
failedFeed : Unit -> Feed<Result<int, string>>
failedFeed () = Feed(supply = Error(message = "kept error"))
successfulFeed () = Feed(supply = Success(value = 13))
erasedResultFeedValue (feed : Feed<Result<any, string>>) = match feed
    Feed value => toString value
    Dry => "dry"
concreteFeedValue feed = match feed
    Feed value => value
    Dry => 0
integerFeedList () = [integerFeed ()]
erasedFeedListValue feeds = match feeds
    [first, ..._rest] => erasedFeedValue first
    _ => "empty"
integerFeedResult () = Success(value = integerFeed ())
failedFeedResult : Unit -> Result<Feed<int>, string>
failedFeedResult () = Error(message = "wrapped error")
erasedFeedResultValue (result : Result<Feed<any>, string>) = match result
    Success value => erasedFeedValue value
    Error message => message
covariantErasureCase () =
    original = integerFeed ()
    parcel = integerParcel ()
    foldList ([
        erasedFeedValue original == "7",
        concreteFeedValue original == 7,
        erasedFeedValue Dry == "dry",
        erasedParcelValue parcel == "11",
        parcel.held == 11,
        erasedResultFeedValue (failedFeed ()) == "Error(kept error)",
        erasedResultFeedValue (successfulFeed ()) == "Success(13)",
        erasedFeedListValue (integerFeedList ()) == "7",
        erasedFeedResultValue (integerFeedResult ()) == "7",
        erasedFeedResultValue (failedFeedResult ()) == "wrapped error"
    ], true, \(good, next) => good && next)
type Chain out T =
    ChainEnd
    ChainMore
        held : T
        tail : Chain<T>
integerChain () = ChainMore(held = 19, tail = ChainMore(held = 23, tail = ChainEnd))
erasedChainValue (chain : Chain<any>) = match chain
    ChainEnd => "end"
    ChainMore value rest => "${toString value},${erasedChainValue rest}"
functionFeed : Unit -> Feed<(int) -> int>
functionFeed () = Feed(supply = \_input => 17)
erasedFunctionFeedValue : Feed<(int) -> any> -> string
erasedFunctionFeedValue feed = match feed
    Feed value => toString (value 0)
    Dry => "dry"
acceptsAny (value : any) = toString value == "7"
anyGate () = Gate(admit = acceptsAny)
runGate gate = match gate
    Gate callback => callback 7
    Open => false
runAnyGate (gate : Gate<any>) = match gate
    Gate callback => callback "7"
    Open => false
anyGates () = [anyGate ()]
type Receiver in T =
    consume : (T) -> bool
anyReceiver () = Receiver(consume = acceptsAny)
runReceiver receiver = receiver.consume 7
runAnyReceiver (receiver : Receiver<any>) = receiver.consume "7"
runGates gates = match gates
    [first, ..._rest] => runGate first
    _ => false
anyGateResult : Unit -> Result<Gate<any>, string>
anyGateResult () = Success(value = anyGate ())
failedGateResult : Unit -> Result<Gate<any>, string>
failedGateResult () = Error(message = "gate error")
anyGateResults () = [anyGateResult ()]
runGateResults results = match results
    [first, ..._rest] => runGateResult first
    _ => false
runGateResult (result : Result<Gate<int>, string>) = match result
    Success value => runGate value
    Error message => message != "gate error"
contravariantErasureCase () =
    original = anyGate ()
    receiver = anyReceiver ()
    foldList ([
        runGate original,
        runAnyGate original,
        !(runGate Open),
        runGates (anyGates ()),
        runGateResult (anyGateResult ()),
        runGateResults (anyGateResults ()),
        runReceiver receiver,
        runAnyReceiver receiver,
        !(runGateResult (failedGateResult ()))
    ], true, \(good, next) => good && next)

describe g = match g
    Gate _admit => "guarded"
    Open => "open"
mkGate : Unit -> Gate<(int) -> Result<int, string>>
mkGate () = Gate(admit = \_f => true)

print "fn-payload feed accepted: ${label (mkFeed ())}"
print "fn-payload gate accepted: ${describe (mkGate ())}"

(** --- Variance positions: every legal shape, exercised end to end ---
    `out T` sits in a field, a function RESULT and a covariant built-in;
    `in T` sits in function parameters, including a callback result; an unannotated
    parameter sits in both at once. Each value is then USED, so a position that
    merely compiled but lowered wrongly is caught as well as one that was
    wrongly rejected. Assignment keeps the leaves exact under every marker.
    Implements [TYPE-VARIANCE-POSITIONS], [TYPE-VARIANCE-COERCION],
    [FLAVOR-ML-GENERICS] *)
type Source out T =
    produce : T
    make : (int) -> T
    items : List<T>
type Sink in T =
    admit : (T) -> bool
    hof : ((int) -> T) -> int
type Both T =
    slot : T
    consume : (T) -> int

srcInt : Unit -> Source<int>
srcInt () = Source(produce = 4, make = \n => n, items = [1, 2])
sinkInt : Unit -> Sink<int>
sinkInt () = Sink(admit = \_x => true, hof = \_f => 7)
bothInt : Unit -> Both<int>
bothInt () = Both(slot = 5, consume = \_x => 6)
keepSource s = s.produce
keepSink g = g.hof (\_n => 3)

print "variance produce=${(srcInt ()).produce} make=${(srcInt ()).make 9} items=${length (srcInt ()).items} admit=${toString ((sinkInt ()).admit 1)} slot=${(bothInt ()).slot} kept=${keepSource (srcInt ())}/${keepSink (sinkInt ())}"

(** --- Call-site type application: pinning an instantiation in the source ---
    A written type-argument list pins the callee's declared binders left to
    right and is checked against what the value arguments infer. `emptyOf`'s
    binder appears in NO parameter position, so nothing but the written
    argument can pin it, and `identityOf<List<int>>` closes two argument lists
    with one `>>`. Implements [TYPE-GENERICS-APPLY], [FLAVOR-ML-GENERICS] *)
identityOf<T> : T -> T
identityOf x = x
emptyOf<T> : Unit -> List<T>
emptyOf () = []
pickOf<T, U> : (T, U) -> T
pickOf (first, _second) = first
alsoOf<T> : (T, (T) -> T) -> T
alsoOf (x, f) = f x
headOr<T> : (List<T>, T) -> T
headOr (items, fallback) = listGet items 0 ?: fallback
repeatOf<T> : (T, int) -> T
repeatOf (value, times) = match times
    0 => value
    _ => repeatOf<T> (value, times - 1 )

appliedInt = identityOf<int> 5
appliedText = identityOf<string> "os"
appliedNested = length (identityOf<List<int>> [1, 2])
appliedEmpty = length (emptyOf<int> ())
appliedPair = pickOf<int, string> (7, "seven")
print "applied int=${appliedInt} text=${appliedText} nested=${appliedNested} empty=${appliedEmpty} pair=${appliedPair}"

print "=== TYPE EQUALITY COMPLETE ==="

(** Verify generic records, function shapes, union tags, and variant payload types. *)
typeEqualityCase () =
    container = makeContainer 7
    pair = makePair (8, "eight")
    triple = makeTriple (9, "nine", 10)
    checkAll "generic, function, and union type behavior" [
        container.value == 7,
        pair.first == 8,
        pair.second == "eight",
        triple.first == 9,
        triple.second == "nine",
        triple.third == 10,
        applyInt (addOne, 9) == 10,
        applyInt (timesTwo, 9) == 18,
        applyInt (minusOne, 9) == 8,
        applyStr (excl, "hi") == "hi!",
        applyStr (ques, "hi") == "hi?",
        applyToStr (intToString, 42) == "42",
        applyTwo (twoArgAdd, 5, 7) == 12,
        applyThree (threeArgAdd, 1, 2, 3) == 6,
        sameColor (Red, Red),
        !(sameColor (Red, Blue)),
        colorName Green == "green",
        label (mkFeed ()) == "supplied",
        covariantErasureCase (),
        erasedChainValue (integerChain ()) == "19,23,end",
        erasedFunctionFeedValue (functionFeed ()) == "17",
        contravariantErasureCase (),
        describe (mkGate ()) == "guarded",
        identityOf<int> 5 == 5,
        identityOf<string> "os" == "os",
        length (identityOf<List<int>> [1, 2]) == 2,
        length (emptyOf<int> ()) == 0,
        pickOf<int, string> (7, "seven") == 7,
        identityOf<bool> true,
        !(identityOf<bool> false),
        identityOf<float> 2.5 == 2.5,
        length (identityOf<List<string>> ["a", "b"]) == 2,
        mapLength (identityOf<Map<string, List<int>>> ["a" => [1], "b" => [2]]) == 2,
        (identityOf<Container<int>> (Container(value = 9))).value == 9,
        (identityOf<Container<string>> (Container(value = "c"))).value == "c",
        isEmpty (emptyOf<string> ()),
        pickOf<string, int> ("first", 2) == "first",
        pickOf<int, int> (3, 4) == 3,
        alsoOf<int> (21, timesTwo) == 42,
        (identityOf<(int) -> int> timesTwo) 21 == 42,
        applyInt (identityOf<(int) -> int> addOne, 9) == 10,
        ([4, 5] |> headOr 0) == 4,
        headOr<int> ([], 9) == 9,
        headOr<string> (["a"], "z") == "a",
        repeatOf<int> (7, 3) == 7,
        repeatOf<string> ("os", 2) == "os",
        (identityOf<Result<int, string>> (20 * 5) ?: 0) == 100,
        identityOf<int> (identityOf<int> 6) == 6,
        (srcInt ()).produce == 4,
        (srcInt ()).make 9 == 9,
        length (srcInt ()).items == 2,
        (listGet (srcInt ()).items 1 ?: 0) == 2,
        (sinkInt ()).admit 1,
        (sinkInt ()).hof (\_n => 3) == 7,
        (bothInt ()).slot == 5,
        (bothInt ()).consume 1 == 6,
        keepSource (srcInt ()) == 4,
        keepSink (sinkInt ()) == 7
    ]

test "equivalent type shapes compose while union tags remain distinct" (\() => exactArithmetic (typeEqualityCase))

(** A transparent alias is its representation everywhere it is written: a
    scalar, a function type and a record field alike unify with what they
    abbreviate, in a plain script as in a project ([MODULES-OPAQUE-TYPES] is
    the sealed form). Scripts used to skip the alias expansion and reported
    `cannot unify int with Score`. *)
type Score = int
type Kernel = (int) -> float
type Combine = (float, float) -> float
type Scored =
    label : string
    score : Score
applyKernel (k : Kernel, i) = k i
combine (c : Combine, a, b) = c (a, b)
aliasCase () = checkAll "transparent type aliases are their representation everywhere" [
        (Scored(label = "a", score = 41)).score + 1 == 42,
        applyKernel (\i => toFloat i * 0.5, 4) == 2.0,
        combine (\(a, b) => a + b, 1.5, 2.0) == 3.5
    ]

test "transparent type aliases are their representation everywhere" (\() => exactArithmetic (aliasCase))
