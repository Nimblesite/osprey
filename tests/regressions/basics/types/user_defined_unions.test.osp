// Cross-contract oracle for [TYPE-MATCH-EXHAUSTIVE], [TYPE-LIST],
// [TYPE-LIST-PATTERNS], [TYPE-MAP], [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS],
// [TYPE-GENERICS-FN], [BUILTIN-MAP-GET], [BUILTIN-MAP-SET],
// [BUILTIN-MAP-REMOVE], [BUILTIN-MAP-MERGE], [EFFECTS-OP-TYPING],
// [EFFECTS-HANDLER-STATE], [EFFECTS-GENERIC-DECL],
// [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].

type Outcome = Ok { value: string } | Err { message: string }

type Status = Active | Inactive

/// A union whose two variants carry payloads of different kinds. Construction
/// once wrote the variant into a stack `alloca` and returned that pointer, so a
/// value RETURNED from one function and passed straight into another read a
/// garbage int, or segfaulted the moment its string payload was dereferenced.
/// Heap allocation is what makes `render(classify(n))` well-defined.
type Grade = Score { points: int } | Reason { text: string }

effect OutcomeAudit {
    observe: fn(string) -> Unit
}

/// Audits whatever leaf type a lookup recovered, at every instantiation.
effect MapLookupAudit<T> {
    observe: fn(T) -> Unit
}

/// The two generic lookups an audited map needs: one recovers a value at any
/// leaf type, the other reaches through a map of lists. One definition each, so
/// the suite instantiates ONE generic body at int, string and List rather than
/// pinning three monomorphic copies.
fn valueOr<T>(items: Map<string, T>, key: string, fallback: T) -> T = mapGet(items, key) ?: fallback

fn listValueAt<T>(items: Map<string, List<T>>, key: string, index: int, fallback: T) -> T =
listGet(valueOr(items, key, [fallback]), index) ?: fallback

fn describe(o) = match o {
    Ok { value } => "ok: " + value
    Err { message } => "err: " + message
}

fn classify(points) = match points {
    0 => Reason { text: "empty" }
    _ => Score { points: points }
}

fn render(g) = match g {
    Score { points } => "score " + toString(points)
    Reason { text } => "reason " + text
}

fn label(s) = match s {
    Active => "active"
    Inactive => "inactive"
}

fn chooseOutcome<T>(outcome: Outcome, accepted: T, rejected: T) -> T = match outcome {
    Ok { value } => accepted
    Err { message } => rejected
}

fn outcomeShape(outcomes: List<Outcome>) = match outcomes {
    [] => "empty"
    [only] => "one:${describe(only)}"
    [first, second] => "two:${describe(first)}/${describe(second)}"
    [head, ...tail] => "many:${describe(head)}+${listLength(tail)}"
}

fn auditOutcomes(outcomes: List<Outcome>) = {
    mut trace = ""
    handle OutcomeAudit
    observe rendered => { trace = trace + rendered + "|" }
    in forEachList(outcomes, fn(outcome) => perform OutcomeAudit.observe(describe(outcome)))
    trace
}

fn auditIntKeys(items, keys) = {
    mut encoded = 0
    handle MapLookupAudit
    observe value => { encoded = encoded * 100 + value ?: encoded }
    in forEachList(keys, fn(key) => perform MapLookupAudit.observe(valueOr(items, key, 0)))
    encoded
}

fn auditStringKeys(items, keys) = {
    mut encoded = ""
    handle MapLookupAudit
    observe value => { encoded = encoded + value + "/" }
    in forEachList(keys, fn(key) => perform MapLookupAudit.observe(valueOr(items, key, "missing")))
    encoded
}

/// `topMap` is BUILT at runtime, so its handle is opaque. Indexing one used to
/// read that handle as the flat `{i64, i8*}` array a map LITERAL lowers to and
/// segfaulted; the index now routes through the same C runtime get as `mapGet`.
let seedValue = 9
let topMap = mapSet(mapSet(Map(), "a", seedValue), "b", 16)
let topProbe = match topMap["a"] {
    Success { value } => "a=${value}"
    Error { message } => "miss"
}

print("${describe(Ok { value: "loaded" })}\n${describe(Err { message: "missing" })}\n${label(Active)}\n${label(Inactive)}\n${render(classify(27))}\n${render(classify(0))}\n${topProbe}\nlen ${mapLength(topMap)}")

/// Stores union values in persistent generic collections, recovers lookups
/// through Result, and visits them through an effectful callback.
fn userDefinedUnionCase() = {
    let loaded = Ok { value: "loaded" }
    let missing = Err { message: "missing" }
    let cached = Ok { value: "cached" }
    let outcomes = [loaded, missing]
    let grown = listAppend(outcomes, cached)
    let prefixed = listPrepend(grown, Err { message: "offline" })
    let reversed = listReverse(prefixed)
    let byName = { "primary": loaded, "failure": missing }
    let updated = mapSet(byName, "cached", cached)
    let withoutFailure = mapRemove(updated, "failure")
    let merged = mapMerge(byName, { "primary": cached, "offline": Err { message: "offline" } })
    let fallback = Err { message: "fallback" }

    checkAll("union tags and payloads survive direct construction", [
            describe(loaded) == "ok: loaded",
            describe(missing) == "err: missing",
            describe(cached) == "ok: cached",
            describe(Err { message: "offline" }) == "err: offline",
            label(Active) == "active",
            label(Inactive) == "inactive",
            label(Active) != label(Inactive)
    ])

    checkAll("union lists preserve order patterns Results and persistence", [
            listLength(outcomes) == 2,
            listLength(grown) == 3,
            listLength(prefixed) == 4,
            listLength(reversed) == 4,
            describe(listGet(outcomes, 0) ?: fallback) == "ok: loaded",
            describe(listGet(outcomes, 1) ?: fallback) == "err: missing",
            describe(listGet(grown, 2) ?: fallback) == "ok: cached",
            describe(listGet(prefixed, 0) ?: fallback) == "err: offline",
            describe(listGet(reversed, 0) ?: fallback) == "ok: cached",
            describe(listGet(reversed, 3) ?: fallback) == "err: offline",
            describe(listGet(outcomes, 9) ?: fallback) == "err: fallback",
            listLength(outcomes) == 2,
            outcomeShape([]) == "empty",
            outcomeShape([loaded]) == "one:ok: loaded",
            outcomeShape(outcomes) == "two:ok: loaded/err: missing",
            outcomeShape(grown) == "many:ok: loaded+2",
            auditOutcomes(outcomes) == "ok: loaded|err: missing|",
            auditOutcomes(grown) == "ok: loaded|err: missing|ok: cached|"
    ])

    checkAll("union maps preserve replacement removal lookup and generic choices", [
            mapLength(byName) == 2,
            mapLength(updated) == 3,
            mapLength(withoutFailure) == 2,
            mapLength(merged) == 3,
            describe(mapGet(byName, "primary") ?: fallback) == "ok: loaded",
            describe(mapGet(byName, "failure") ?: fallback) == "err: missing",
            describe(mapGet(updated, "cached") ?: fallback) == "ok: cached",
            describe(mapGet(withoutFailure, "failure") ?: fallback) == "err: fallback",
            describe(mapGet(merged, "primary") ?: fallback) == "ok: cached",
            describe(mapGet(merged, "offline") ?: fallback) == "err: offline",
            mapContains(byName, "primary"),
            mapContains(updated, "cached"),
            !mapContains(withoutFailure, "failure"),
            listLength(mapKeys(merged)) == 3,
            listLength(mapValues(merged)) == 3,
            chooseOutcome(loaded, 41, 99) == 41,
            chooseOutcome(missing, "accepted", "rejected") == "rejected",
            chooseOutcome(cached, true, false),
            listLength(chooseOutcome(loaded, [[1], [2, 3]], [[9]])) == 2,
            listLength(listGet(chooseOutcome(loaded, [[1], [2, 3]], [[9]]), 1) ?: [99]) == 2
    ])

    checkAll("returned union values stay valid call arguments", [
            render(classify(27)) == "score 27",
            render(classify(0)) == "reason empty",
            render(classify((0 - 4) ?: 0)) == "score -4",
            render(Score { points: 9 }) == "score 9",
            render(Reason { text: "blocked" }) == "reason blocked"
    ])
}
test("user-defined union variants preserve their tags and payloads", userDefinedUnionCase)

/// Exercises generic lookup at scalar and nested collection types on maps BUILT
/// at runtime, then routes every recovered value through one generic effect.
fn builtMapIndexCase() = {
    let built = mapSet(mapSet(Map(), "a", 9), "b", 16)
    let replaced = mapSet(built, "a", 25)
    let removed = mapRemove(replaced, "b")
    let merged = mapMerge(built, { "b": 36, "c": 49 })
    let words = { "first": "ant", "second": "bee" }
    let wordGrowth = mapSet(words, "third", "cat")
    let buckets = { "odd": [1, 3, 5], "even": [2, 4, 6] }
    let bucketGrowth = mapSet(buckets, "prime", [2, 3, 5, 7])
    let stringBuckets = { "short": ["a", "bb"], "long": ["three", "seven"] }
    let nestedMaps = [buckets, bucketGrowth]
    let absent = match built["missing"] {
        Success { value } => false
        Error { message } => message != ""
    }

    checkAll("built scalar maps preserve lookup replacement and persistence", [
            (built["a"] ?: ((0 - 1) ?: 0)) == 9,
            (built["b"] ?: ((0 - 1) ?: 0)) == 16,
            valueOr(built, "a", ((0 - 1) ?: 0)) == 9,
            valueOr(built, "missing", ((0 - 1) ?: 0)) == ((0 - 1) ?: 0),
            mapLength(built) == 2,
            mapContains(built, "a"),
            mapContains(built, "b"),
            !mapContains(built, "missing"),
            absent,
            mapLength(replaced) == 2,
            valueOr(replaced, "a", 0) == 25,
            valueOr(built, "a", 0) == 9,
            mapLength(removed) == 1,
            mapContains(removed, "a"),
            !mapContains(removed, "b"),
            mapLength(merged) == 3,
            valueOr(merged, "a", 0) == 9,
            valueOr(merged, "b", 0) == 36,
            valueOr(merged, "c", 0) == 49,
            auditIntKeys(built, ["a", "b"]) == 916,
            auditIntKeys(merged, ["a", "b", "c"]) == 93649
    ])

    checkAll("generic lookup instantiations stay isolated across leaf types", [
            valueOr(words, "first", "missing") == "ant",
            valueOr(words, "second", "missing") == "bee",
            valueOr(words, "absent", "missing") == "missing",
            mapLength(words) == 2,
            mapLength(wordGrowth) == 3,
            valueOr(wordGrowth, "third", "missing") == "cat",
            valueOr(words, "third", "missing") == "missing",
            auditStringKeys(words, ["first", "second"]) == "ant/bee/",
            auditStringKeys(wordGrowth, ["third", "first"]) == "cat/ant/",
            listLength(mapKeys(wordGrowth)) == 3,
            listLength(mapValues(wordGrowth)) == 3
    ])

    checkAll("maps of lists retain their nested element descriptors", [
            mapLength(buckets) == 2,
            mapLength(bucketGrowth) == 3,
            listLength(valueOr(buckets, "odd", [99])) == 3,
            listLength(valueOr(bucketGrowth, "prime", [99])) == 4,
            listValueAt(buckets, "odd", 0, 99) == 1,
            listValueAt(buckets, "odd", 2, 99) == 5,
            listValueAt(buckets, "even", 0, 99) == 2,
            listValueAt(buckets, "even", 2, 99) == 6,
            listValueAt(bucketGrowth, "prime", 3, 99) == 7,
            listValueAt(buckets, "missing", 0, 99) == 99,
            listValueAt(buckets, "odd", 9, 99) == 99,
            listValueAt(stringBuckets, "short", 0, "missing") == "a",
            listValueAt(stringBuckets, "short", 1, "missing") == "bb",
            listValueAt(stringBuckets, "long", 0, "missing") == "three",
            listValueAt(stringBuckets, "long", 1, "missing") == "seven",
            listLength(nestedMaps) == 2,
            listValueAt(listGet(nestedMaps, 0) ?: { "fallback": [99] }, "odd", 2, 99) == 5,
            listValueAt(listGet(nestedMaps, 1) ?: { "fallback": [99] }, "prime", 3, 99) == 7
    ])
}
test("built maps support indexed lookup", builtMapIndexCase)
