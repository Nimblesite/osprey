// Functional pipeline showcase: range, forEach, map, filter, fold, pipe,
// stream-fusion ordering (map-then-filter vs filter-then-map), negative
// ranges, empty ranges, lambdas in the pipeline.

fn dbl(x)   = x * 2 ?: 0
fn sq(x: int)    = x * x ?: 0
fn inc(x)   = x + 1 ?: 0
fn gt4(x)   = x > 4
fn lt3(x)   = x < 3
fn even(x)  = (x % 2 ?: 1) == 0
fn add(a: int, b: int) = a + b ?: 0
fn mul(a, b) = a * b ?: 0

print("=== Functional Showcase ===")

// 1. forEach over a range
print("range 1..6 forEach print:")
range(1, 6) |> forEach(print)

// 2. negative + empty ranges
print("range -2..3 forEach print:")
range((0 - 2) ?: 0, 3) |> forEach(print)
print("range 5..5 (empty):")
range(5, 5) |> forEach(print)

// 3. map + forEach
print("map dbl over 1..5:")
range(1, 5) |> map(dbl) |> forEach(print)

// 4. filter + forEach
print("filter even over 1..7:")
range(1, 7) |> filter(even) |> forEach(print)

// 5. map-then-filter — filter sees mapped value
print("map dbl |> filter gt4 over 1..5:")
range(1, 5) |> map(dbl) |> filter(gt4) |> forEach(print)

// 6. filter-then-map — map applied after filtering raw values
print("filter lt3 |> map dbl over 1..6:")
range(1, 6) |> filter(lt3) |> map(dbl) |> forEach(print)

/// 7. fold (sum, product)
let s = range(1, 6) |> fold(0, add)
print("sum 1..5 = ${toString(s)}")
let p = range(1, 5) |> fold(1, mul)
print("prod 1..4 = ${toString(p)}")

/// 8. chained pipes on a single value
let r = 3 |> inc |> dbl |> sq
print("3|>inc|>dbl|>sq = ${toString(r)}")

/// 9. inline lambda in pipeline
let lr = 10 |> fn(x) => x + 5 ?: 0
print("10|>(x+5) = ${toString(lr)}")

/// 10. lambda chained twice (parens around each so the chain doesn't get swallowed)
let lr2 = 5 |> (fn(x) => x + 100 ?: 0) |> (fn(x) => x * 2 ?: 0)
print("5|>+100|>*2 = ${toString(lr2)}")

print("=== Showcase Complete ===")
// Exercises [BUILTIN-ITER], [BUILTIN-ITER-RANGE], [BUILTIN-ITER-MAP],
// [BUILTIN-ITER-FILTER], [BUILTIN-ITER-FOREACH], [BUILTIN-ITER-FOLD],
// [BUILTIN-ITER-CALLBACK], [BUILTIN-ITER-PIPE], and [BUILTIN-ITER-FUSION].

/// Verifies direct helpers and every scalar pipe from the showcase.
fn scalarPipelineCase() = checkAll("functional scalar pipelines", [
    dbl(7) == 14, sq(5) == 25, inc(9) == 10,
    gt4(5), !gt4(4), lt3(2), !lt3(3),
    even(2), !even(3), add(7, 8) == 15, mul(6, 7) == 42,
    (3 |> inc |> dbl |> sq) == 64,
    (10 |> fn(x) => x + 5 ?: 0) == 15,
    (5 |> (fn(x) => x + 100 ?: 0) |> (fn(x) => x * 2 ?: 0)) == 210
])

/// Verifies range boundaries and both map/filter orderings through folds.
fn iteratorPipelineCase() = checkAll("functional iterator pipelines", [
    (range(1, 6) |> fold(0, add)) == 15,
    (range(1, 5) |> fold(1, mul)) == 24,
    (range(5, 5) |> fold(9, add)) == 9,
    (range((0 - 2) ?: 0, 3) |> fold(0, add)) == 0,
    (range(1, 5) |> map(dbl) |> filter(gt4) |> fold(0, add)) == 14,
    (range(1, 6) |> filter(lt3) |> map(dbl) |> fold(0, add)) == 6
])

/// A `mut` a handler arm captures is promoted to a shared cell in EVERY
/// lowered body, not only a top-level function's: inside a closure the arm
/// wrote a private copy and the read after the `handle` returned 0. The list
/// literal handed to that closure must also escape to a runtime list, or the
/// body reads a foreign header and walks off the end.
/// Implements [EFFECTS-HANDLER-STATE], [BUILTIN-LIST-FOREACH].
effect Tally {
    /// Fold one digit into the running number.
    note: fn(int) -> Unit
}

/// A let-bound lambda leaves its arithmetic overload OPEN until the program
/// says which one it is: `let join = |a, b| => a + b` used only on strings is
/// concatenation, not the checked integer addition an eager default picked —
/// which printed `Success(<pointer>)`. One definition still gets ONE overload,
/// so `sum` beside it stays integer. Implements [ARITH-CHECKED].
fn lambdaOverloadCase() = {
    let join = |a, b| => a + b
    let curriedJoin = |a| => |b| => a + b
    let sum = |a, b| => a + b ?: 0
    checkAll("a let-bound lambda picks its overload from its use", [
        join("os", "prey") == "osprey",
        join("", "x") == "x",
        curriedJoin("os")("prey") == "osprey",
        curriedJoin("a")("") == "a",
        sum(20, 22) == 42,
        length(join("ab", "cde")) == 5
    ])
}

/// A handler region inside a closure, driven by a list literal the closure
/// receives as an argument.
fn closureHandlerCase() = {
    let digits = |keys| => {
        mut seen = 0
        handle Tally
        note value => { seen = seen * 10 + value ?: seen }
        in forEachList(keys, fn(k) => perform Tally.note(k))
        seen
    }
    checkAll("a handler inside a closure keeps its captured state", [
        digits([1, 2, 3]) == 123,
        digits([7]) == 7,
        digits([9, 0]) == 90
    ])
}

test("scalar pipes preserve helper composition", scalarPipelineCase)
test("iterator pipes preserve order and boundaries", iteratorPipelineCase)
test("a let-bound lambda picks its arithmetic overload from its use", lambdaOverloadCase)
test("a handler inside a closure keeps its captured state", closureHandlerCase)
