/// Pipe callbacks carry arbitrary chunks. This demo collects each stream until
/// exit and awaits each process before starting the next one.
mut stdoutText = ""
mut stderrText = ""

print("=== CALLBACK-BASED STDOUT COLLECTION DEMO ===")

fn outputTrace(processID, channel, data) =
    if data == "" { "" } else { "[CALLBACK] Process ${processID} ${channel}: ${data}\n" }

fn completeTrace(processID, data) = {
    let output = outputTrace(processID, "STDOUT", stdoutText)
    let errors = outputTrace(processID, "STDERR", stderrText)
    print("${output}${errors}[CALLBACK] Process ${processID} EXIT: ${data}")
}

effect CollectedOutput {
    stdout: fn(string) -> Unit
    stderr: fn(string) -> Unit
    finished: fn(int, string) -> Unit
}

fn processEventHandler(processID, eventType, data) = {
    handle CollectedOutput {
        stdout chunk => { stdoutText = stdoutText + chunk }
        stderr chunk => { stderrText = stderrText + chunk }
        finished processID data => {
            completeTrace(processID, data)
            stdoutText = ""
            stderrText = ""
        }
    }
    match eventType {
        1 => perform CollectedOutput.stdout(data)
        2 => perform CollectedOutput.stderr(data)
        3 => perform CollectedOutput.finished(processID, data)
        _ => print("[CALLBACK] Process ${toString(processID)} UNKNOWN EVENT ${toString(eventType)}: ${data}")
    }
}

// Test 1: Simple stdout callback demo
print("--- Test 1: Basic Stdout Callback ---")
let result1 = spawnProcess("echo Hello from callback!", processEventHandler)
match result1 {
    Success { value } => {
        print("✓ Process spawned with ID: ${toString(value)}")
        let exitCode = awaitProcess(value)
        print("✓ Process finished with exit code: ${toString(exitCode)}")
        cleanupProcess(value)
        print("✓ Process cleaned up")
    }
    Error => print("✗ Failed to spawn process")
}

// Test 2: Multiple output lines callback demo.
// Write boundaries do not determine callback boundaries. [BUILTIN-PROCESS]
print("--- Test 2: Multiple Lines Callback ---")
let result2 = spawnProcess("printf 'Line 1\\nLine 2\\nLine 3\\n'", processEventHandler)
match result2 {
    Success { value } => {
        print("✓ Multi-line process spawned with ID: ${toString(value)}")
        let _exitCode = awaitProcess(value)
        print("✓ Multi-line process finished")
        cleanupProcess(value)
    }
    Error => print("✗ Failed to spawn multi-line process")
}

// Test 3: Error process callback demo
print("--- Test 3: Error Process Callback ---")
let result3 = spawnProcess("echo Expected failure 1>&2 && exit 1", processEventHandler)
match result3 {
    Success { value } => {
        print("✓ Error process spawned with ID: ${toString(value)}")
        let exitCode = awaitProcess(value)
        print("✓ Error process finished with exit code: ${toString(exitCode)}")
        cleanupProcess(value)
    }
    Error => print("✗ Failed to spawn error process")
}

print("=== CALLBACK DEMO COMPLETE ===\nThe [CALLBACK] lines above show C runtime calling into Osprey!\n--- Fragmented stdout and stderr callbacks ---")
processEventHandler(99, 1, "Line 1\nLi")
processEventHandler(99, 2, "warn")
processEventHandler(99, 1, "ne 2\nLine 3\n")
processEventHandler(99, 2, "ing\n")
processEventHandler(99, 3, "0")

/// Drives stdout, exit callbacks, waits, and cleanup from inside the test body.
fn callbackLifecycleCase() = {
    let outputProbe = spawnProcess("echo asserted callback output", processEventHandler)
    let outputCompleted = match outputProbe {
        Success { value } => {
            let exitCode = awaitProcess(value)
            cleanupProcess(value)
            exitCode == 0
        }
        Error => false
    }
    let errorProbe = spawnProcess("echo asserted callback error 1>&2 && exit 1", processEventHandler)
    let errorCompleted = match errorProbe {
        Success { value } => {
            let exitCode = awaitProcess(value)
            cleanupProcess(value)
            exitCode == 1
        }
        Error => false
    }
    checkAll("callback process lifecycle state", [outputCompleted, errorCompleted])
}
test("callbacks accompany successful and failing process exits", callbackLifecycleCase)
