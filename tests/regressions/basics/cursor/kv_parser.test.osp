// Parses "k=v;k=v;k=v" with the O(1) string cursor primitives
// ([BUILTIN-STRING-CURSOR]) and Result error payloads ([ERR-PAYLOAD]). With no
// loop expression, processAll recurses over ';'-delimited entries; findEq uses
// byteAt to find '=' (ASCII 61). A missing '=' returns Error.

/// Named constants. Top-level `let` is not in scope inside functions, so the
/// idiomatic Osprey form for a shared constant is a zero-argument function.
fn semi()    = ";"   // entry separator
fn eqByte()  = 61    // ASCII code point for '='
fn notFound() = (0 - 1) ?: 0    // findEq sentinel: no '=' in the entry

/// --- Cursor scan: walk the entry one byte at a time with byteAt, returning the
///     index of the first '=' or the notFound sentinel. O(1) per byteAt, O(n)
///     total, no allocation.
fn findEq(seg, i) = match byteAt(seg, i) {
    Success { value } => stepEq(seg, i, value)
    Error   { message } => notFound()
}
fn stepEq(seg, i, b) = match b == eqByte() {
    true  => i
    false => findEq(seg, (i + 1) ?: i)
}

/// --- Parse one entry into a "key=value" report. The cursor scan locates '=';
///     a missing '=' becomes a Result Error carrying which entry was malformed.
fn parsePair(seg) = match findEq(seg, 0) == notFound() {
    true  => Error { message: "no '=' in entry '${seg}'" }
    false => buildPair(seg, findEq(seg, 0))
}
fn buildPair(seg, eq) = match substring(seg, 0, eq) {
    Success { value } => buildValue(value, seg, eq)
    Error   { message } => Error { message: message }
}
fn buildValue(k, seg, eq) =
    match substring(seg, (eq + 1) ?: eq, length(seg)) {
        Success { value } => Success { value: "key='${k}' value='${value}'" }
        Error   { message } => Error { message: message }
    }

/// --- Report a single parsed entry, exercising both Result arms.
fn report(seg) = match parsePair(seg) {
    Success { value } => emit("  ${value}")
    Error   { message } => emit("  ERROR: ${message}")
}
fn emit(line) = {
    print(line)
    0
}

/// --- Drive the parse recursively: split the config on ';' by hand using
///     indexOf to locate the next separator and drop to advance the cursor.
fn processAll(rest) = match indexOf(rest, semi()) {
    Success { value } => peel(rest, value)
    Error   { message } => report(rest)
}
fn peel(rest, sep) = match substring(rest, 0, sep) {
    Success { value } => advance(value, rest, sep)
    Error   { message } => emit("  ERROR: ${message}")
}
fn advance(seg, rest, sep) = {
    let done = report(seg)
    processAll(drop(rest, (sep + 1) ?: sep))
}

print("=== key=value config parser ===")

print("Parsing well-formed 'host=localhost;port=8080;tls=true':")
let good = processAll("host=localhost;port=8080;tls=true")

print("Parsing with a malformed entry 'a=1;bad_entry_no_equals;c=3':")
let mixed = processAll("a=1;bad_entry_no_equals;c=3")

// Direct error-path proof: a lone malformed entry yields an Error payload.
print("Direct parsePair on 'bad_entry_no_equals':")
match parsePair("bad_entry_no_equals") {
    Success { value } => print("  unexpected ${value}")
    Error   { message } => print("  rejected: ${message}")
}

// Cursor proof: findEq returns the byte index of '=' for a good entry,
// and the sentinel for a malformed one.
print("findEq('port=8080') = ${findEq("port=8080", 0)}")
print("findEq('bad_entry_no_equals') = ${findEq("bad_entry_no_equals", 0)}")

print("=== parser complete ===")

/// Confirms a successful pair carries the complete key/value rendering.
fn pairMatches(seg, expected) = match parsePair(seg) {
    Success { value } => value == expected
    Error { message } => false
}

/// Confirms malformed input carries the entry-specific rejection reason.
fn pairIsRejected(seg) = match parsePair(seg) {
    Success { value } => false
    Error { message } => message == "no '=' in entry '${seg}'"
}

/// Exercises cursor discovery, both Result arms, and recursive reporting.
fn keyValueParserCase() = checkAll("key/value parser behavior", [
    semi() == ";", eqByte() == 61,
    findEq("port=8080", 0) == 4,
    findEq("bad_entry_no_equals", 0) == notFound(),
    pairMatches("host=localhost", "key='host' value='localhost'"),
    pairMatches("empty=", "key='empty' value=''"),
    pairIsRejected("bad_entry_no_equals"),
    processAll("a=1;b=2") == 0,
    processAll("a=1;bad;c=3") == 0
])
test("cursor parser preserves values and rejection reasons", keyValueParserCase)
