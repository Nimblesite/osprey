/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

// [CALL-ARGUMENTS] also covers a reordered all-named call below.
// Boolean operators end-to-end: literals, comparisons (int/float/string),
// equality, logical && / ||, short-circuit, de Morgan, bool from match,
// bool from function, ternary, interpolation.

fn getTrue()  = true
fn getFalse() = false
fn reportTrue() = {
    print("unexpected right side")
    true
}
fn isEqual(x, y) = x == y
fn xor(a, b) = (a || b) && !(a && b)

print("=== Boolean Test ===")

// Function-returned bools
print(getTrue())
print(getFalse())

// Literals
print(false)
print(true)

// Integer comparisons
print(5 > 3)
print(10 == 10)
print(5 != 3)
print(10 <= 15)
print(8  >= 8)

// Equality via function (named args)
match isEqual(x: 5, y: 5) {
    true  => print("Equal")
    false => print("Not Equal")
}

/// Logical operators
let a = true && false
let b = true || false
let c = (5 > 3) && (10 == 10)
let d = (5 < 3) || (10 != 5)
print("&& ${toString(a)}  || ${toString(b)}  comp&& ${toString(c)}  comp|| ${toString(d)}")

// [BOOL-SHORT-CIRCUIT] The right side must not run in either expression. A broken eager lowering
// would print the sentinel labels and fail the golden output.
print(false && reportTrue())
print(true  || reportTrue())

/// Negation + de Morgan: !(p && q) == (!p || !q)
let p = true
let q = false
let lhs = !(p && q)
let rhs = (!p) || (!q)
print("deMorgan && ${toString(lhs == rhs)}")
let lhs2 = !(p || q)
let rhs2 = (!p) && (!q)
print("deMorgan || ${toString(lhs2 == rhs2)}")

// XOR via composition
print("xor T T ${toString(xor(a: true,  b: true))}")
print("xor T F ${toString(xor(a: true,  b: false))}")
print("xor F F ${toString(xor(a: false, b: false))}")

/// Bool from match expression
let parity = match 4 {
    0 => true
    2 => true
    4 => true
    _ => false
}
print("parity ${toString(parity)}")

/// Float comparison
let f1 = 1.5
let f2 = 2.5
print(f1 < f2)
print(f2 == f2)

// String comparison (strcmp semantics, lexicographic)
print("apple" < "banana")
print("hi"    == "hi")
print("hi"    != "bye")

/// Ternary on bool
let label = (3 < 5) ? "yes" : "no"
print(label)

print("=== Boolean Test Complete ===")

/// Exercises literals, comparison families, composition, and both short-circuit paths.
fn booleanBehaviorCase() = {
    let leftShortCircuits = !(false && reportTrue())
    let rightShortCircuits = true || reportTrue()
    let localParity = match 4 {
        0 => false
        4 => true
        _ => false
    }
    let localLabel = (3 < 5) ? "yes" : "no"
    checkAll("boolean operators and branches", [
        getTrue(),
        !getFalse(),
        isEqual(x: 5, y: 5),
        !isEqual(x: 5, y: 6),
        !xor(a: true, b: true),
        xor(a: true, b: false),
        !xor(a: false, b: false),
        leftShortCircuits,
        rightShortCircuits,
        !(true && false),
        true || false,
        !(true && false) == ((!true) || (!false)),
        !(true || false) == ((!true) && (!false)),
        (5 > 3) && (10 == 10),
        1.5 < 2.5,
        "apple" < "banana",
        localParity,
        localLabel == "yes"
    ])
}

test("boolean operators preserve values and short-circuiting", fn() => exactArithmetic(booleanBehaviorCase))

/// Produces infinity at runtime for the [FLOAT-COMPARE] truth tables.
fn growFloat(x, count) = match count {
    0 => x
    _ => growFloat(x * x, (count - 1) )
}
fn comparisonRow(left, right) = "${left == right},${left != right},${left < right},${left <= right},${left > right},${left >= right}"
fn checkFloatPair(label, left, right, expected) = checkAll(label, [
    comparisonRow(left, right) == expected,
    (left != right) == !(left == right)
])
fn nanComparisonsCase() = {
    let huge = growFloat(2.0, 10)
    let nan = huge - huge
    checkFloatPair("NaN/NaN", nan, nan, "false,true,false,false,false,false")
    checkFloatPair("NaN/float", nan, 1.0, "false,true,false,false,false,false")
    checkFloatPair("float/NaN", 1.0, nan, "false,true,false,false,false,false")
    checkFloatPair("NaN/zero", nan, 0.0, "false,true,false,false,false,false")
    checkFloatPair("zero/NaN", 0.0, nan, "false,true,false,false,false,false")
}
fn orderedFloatComparisonsCase() = {
    let huge = growFloat(2.0, 10)
    checkFloatPair("less", 1.0, 2.0, "false,true,true,true,false,false")
    checkFloatPair("greater", 2.0, 1.0, "false,true,false,false,true,true")
    checkFloatPair("equal", 2.0, 2.0, "true,false,false,true,false,true")
    checkFloatPair("positive infinity", huge, huge, "true,false,false,true,false,true")
    checkFloatPair("negative infinity", -huge, -huge, "true,false,false,true,false,true")
    checkFloatPair("opposite infinities", -huge, huge, "false,true,true,true,false,false")
    checkFloatPair("infinity/finite", huge, 1.0, "false,true,false,false,true,true")
    checkFloatPair("negative infinity/finite", -huge, 1.0, "false,true,true,true,false,false")
    checkFloatPair("signed zeros", -0.0, 0.0, "true,false,false,true,false,true")
}
test("NaN comparison truth table", fn() => exactArithmetic(nanComparisonsCase))
test("ordered float comparison controls", fn() => exactArithmetic(orderedFloatComparisonsCase))

/// [FLOAT-IEEE-RESULTS]: non-finite values require no overflow policy.
fn floatIdentity(value) = value
fn isNan(value) = value != value
let largeFinite = .0
let smallFinite = 0.
let literalInfinity = largeFinite * largeFinite

fn ieeeArithmeticCase() = {
    let large = floatIdentity(largeFinite)
    let infinity = large * large
    let nan = infinity - infinity
    checkAll("IEEE closure for arithmetic and supplied non-finite values", [
        infinity > large, literalInfinity == infinity,
        large + large == infinity, -large - large == -infinity,
        infinity + 1.0 == infinity, infinity * -2.0 == -infinity,
        isNan(infinity + -infinity), isNan(infinity * 0.0),
        isNan(nan + 1.0), isNan(1.0 - nan), isNan(nan * 2.0),
        isNan(-nan), -infinity < -large,
        (5 + 0.5) == 5.5, (0.5 * 5) == 2.5,
        toFloat(9223372036854775807) == 9223372036854775808.0,
        toFloat(-9223372036854775808) == -9223372036854775808.0
    ])
}

fn signedZeroAndUnderflowCase() = {
    let small = floatIdentity(smallFinite)
    checkAll("signed zeros and gradual underflow", [
        small * small == 0.0, -small * small == -0.0,
        toString(-small * small) == "-0.0", toString(-0.0 * 2.0) == "-0.0",
        toString(-0.0 - 0.0) == "-0.0", toString(-(-0.0)) == "0.0",
        smallFinite * 0.0000000001 > 0.0, -0.0 == 0.0,
        toString(-0.0 / 2.0) == "-0.0", toString(-0.0 % 2.0) == "-0.0",
        5.5 % 2.0 == 1.5, -5.5 % 2.0 == -1.5,
        5.5 % -2.0 == 1.5, -5.5 % -2.0 == -1.5
    ])
}

fn nonFiniteDivisionCase() = {
    let infinity = floatIdentity(largeFinite) * largeFinite
    let nan = infinity - infinity
    handle Arith { divideByZero _ _ => { expectFalse(true)
        0.0 } }
    checkAll("nonzero division and remainder retain IEEE results", [
        largeFinite / smallFinite == infinity,
        infinity / 2.0 == infinity, 2.0 / infinity == 0.0,
        toString(-2.0 / infinity) == "-0.0", isNan(infinity / infinity),
        isNan(nan / 2.0), isNan(2.0 / nan), isNan(nan / nan),
        isNan(infinity % 2.0), 2.0 % infinity == 2.0,
        isNan(nan % 2.0), isNan(2.0 % nan), isNan(infinity % infinity)
    ])
}

fn zeroDivisorCase() = {
    let infinity = floatIdentity(largeFinite) * largeFinite
    let nan = infinity - infinity
    mut faults = ""
    handle Arith { divideByZero op lhs => {
        faults = faults + op + (isNan(lhs) ? "n" : "v")
        7.25
    } }
    checkAll("zero divisors recover before IEEE division or remainder", [
        1.0 / 0.0 == 7.25, 1.0 / -0.0 == 7.25,
        0.0 / 0.0 == 7.25, infinity / -0.0 == 7.25, nan / 0.0 == 7.25,
        1.0 % 0.0 == 7.25, 1.0 % -0.0 == 7.25,
        0.0 % 0.0 == 7.25, infinity % -0.0 == 7.25, nan % 0.0 == 7.25
    ])
    expect(faults, "/v/v/v/v/n%v%v%v%v%n")
}

test("IEEE arithmetic preserves defined non-finite results", ieeeArithmeticCase)
test("float signed zero and underflow remain defined", signedZeroAndUnderflowCase)
test("nonzero float division and remainder preserve IEEE results", nonFiniteDivisionCase)
test("float zero divisors request explicit recovery even for NaN", zeroDivisorCase)

/// [BUILTIN-ABS]: float overload stays total through aliases and callbacks.
fn absoluteValue(value) = abs(value)
fn applyAbsolute(callback, value) = callback(value)
fn floatAbsoluteCase() = {
    let infinity = floatIdentity(largeFinite) * largeFinite
    let nan = infinity - infinity
    let magnitude = abs
    checkAll("float absolute value preserves its numeric type and IEEE values", [
        abs(-2.5) == 2.5, abs(2.5) == 2.5,
        toString(abs(-0.0)) == "0.0", toString(abs(0.0)) == "0.0",
        abs(-infinity) == infinity, abs(infinity) == infinity,
        isNan(abs(nan)), absoluteValue(-3.5) == 3.5,
        magnitude(-4.5) == 4.5, applyAbsolute(abs, -5.5) == 5.5
    ])
}
test("float absolute value is total through function values", floatAbsoluteCase)

type FloatOperation = { apply: fn(float) -> float }
fn returnedAbsolute() = abs
fn shadowedAbsolute(abs) = abs(-6.5)
fn absoluteTransportCase() = {
    let returned = returnedAbsolute()
    let record = FloatOperation { apply: abs }
    let functions = [abs]
    let selected = listGet(functions, 0) ?: fn(value) => value * 1.0
    let branch = true ? abs : fn(value) => value * 1.0
    checkAll("absolute function values retain float ABI and lexical bindings", [
        returned(-2.5) == 2.5, record.apply(-3.5) == 3.5,
        selected(-4.5) == 4.5, branch(-5.5) == 5.5,
        shadowedAbsolute(fn(value) => value * 2.0) == -13.0
    ])
}
test("float absolute values survive return and aggregate transport", absoluteTransportCase)

fn integerAbsoluteCase() = {
    mut faults = ""
    handle Arith { overflow op lhs rhs wrapped => {
        checkAll("integer abs overflow payload", [op == "abs", lhs == -9223372036854775808, rhs == 0, wrapped == lhs])
        faults = faults + op
        19
    } }
    let magnitude = abs
    checkAll("integer abs function values retain explicit recovery", [
        magnitude(-9223372036854775808) == 19,
        applyAbsolute(abs, -9223372036854775808) == 19,
        magnitude(-27) == 27, faults == "absabs"
    ])
}
test("integer absolute function values keep overflow recovery", integerAbsoluteCase)
