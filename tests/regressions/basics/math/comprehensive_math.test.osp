// Math: checked integer arithmetic, plain IEEE-754 float arithmetic,
// [BUILTIN-CHECKED-ARITH], division/remainder Results, and recursion.

fn power(base, exp) = match exp {
    0 => Success { value: 1 }
    1 => Success { value: base }
    2 => base * base
    3 => base * base * base
    _ => base * base * base * base
}

fn factorial(n) = match n {
    0 => 1
    1 => 1
    2 => 2
    3 => 6
    4 => 24
    5 => 120
    _ => 720
}

fn fibonacci(n) = match n {
    0 => 0
    1 => 1
    2 => 1
    3 => 2
    4 => 3
    5 => 5
    _ => 8
}

fn complex(a, b) = (a * 2) + (b * 3) - 1

fn isEven(x) = (x % 2 ?: 1) == 0

fn classify(n) = match n {
    0 => "Zero"
    1 => "One"
    _ => "Many"
}

fn safeDivide(a, b) = match b {
    0 => 999999
    _ => match a {
        10 => 5
        20 => 5
        _  => 0
    }
}

fn showDiv(a, b) = {
    let result = safeDivide(a: a, b: b)
    match result {
        999999 => print("Error: Cannot divide ${a} by ${b}!")
        _      => print("${a} / ${b} = ${result}")
    }
}

print("=== Math Showcase ===")

/// Result-preserving checked arithmetic in interpolation.
let age = 25
print("Next year: ${age + 1}")
print("Last year: ${age - 1}")
print("Double:    ${age * 2}")
print("Half:      ${age / 2}")

// Modulo + isEven
print("12 % 5  = ${12 % 5}")
print("isEven(8) = ${toString(isEven(8))}")
print("isEven(7) = ${toString(isEven(7))}")

// Integer division: intDiv truncates toward zero (contrast Half = 12.5 above);
// divide-by-zero yields a Result Error, matched on Success/Error.
// Truncation and zero-divisor behavior [BUILTIN-INTDIV].
print("intDiv(25,2) = ${intDiv(25, 2)}, intDiv(100,7) = ${intDiv(100, 7)}")
match intDiv(5, 0) {
    Success { value } => print("intDiv(5,0) = ${value}")
    Error { message } => print("intDiv(5,0): ${message}")
}

print("checked add=${toString(checkedAdd(2, 3))}, sub=${toString(checkedSub(2, 3))}, mul=${toString(checkedMul(6, 7))}")
print("checked overflow add=${toString(checkedAdd(9223372036854775807, 1))}")
print("checked overflow sub=${toString(checkedSub((0 - 9223372036854775807) ?: 0, 2))}")
print("checked overflow mul=${toString(checkedMul(4294967296, 4294967296))}")

// [BUILTIN-ABS] uses the language's i64 ABI, including values outside libc `int`.
// Its only unrepresentable magnitude returns Error instead of overflowing.
print("abs(-5000000000) = ${abs((0 - 5000000000) ?: 0)}")
print("abs(INT64_MIN) = ${abs(((0 - 9223372036854775807) - 1) ?: 0)}")

// [BUILTIN-INTDIV] rejects the one non-zero divisor pair whose signed
// quotient cannot be represented, rather than emitting LLVM `sdiv` poison.
match intDiv(((0 - 9223372036854775807) - 1) ?: 0, (0 - 1) ?: 0) {
    Success { value } => print("intDiv(INT64_MIN,-1) unexpected ${value}")
    Error { message } => print("intDiv(INT64_MIN,-1): ${message}")
}
match (((0 - 9223372036854775807) - 1) ?: 0) % ((0 - 1) ?: 0) {
    Success { value } => print("INT64_MIN % -1 = ${value}")
    Error { message } => print("INT64_MIN % -1 unexpected: ${message}")
}

/// Power, factorial, fibonacci
let n    = 5
let m    = 3
print("pow(5,2)   = ${power(base: n, exp: 2)}")
print("pow(5,3)   = ${power(base: n, exp: 3)}")
print("fact(5)    = ${factorial(n)}")
print("fib(5)     = ${fibonacci(n)}")
print("complex    = ${complex(a: n, b: m)}")

// Division — both branches
showDiv(a: 10, b: 2)
showDiv(a: 15, b: 0)
showDiv(a: 20, b: 4)

print("classify ${classify(0)} / ${classify(1)} / ${classify(n)}")

/// Cryptographic RNG + stdin reader. The drawn values vary every run, so only
/// the invariants are deterministic — assert those. stdin is empty under the
/// harness. Implements [BUILTIN-RANDOM], [BUILTIN-RANDOM-BELOW], [BUILTIN-INPUT].
let rNonNeg = match random() >= 0 { true => "yes"  false => "no" }
let rBounded = match randomBelow(100) {
    Success { value } => match (value >= 0) && (value < 100) { true => "in-range"  false => "OOB" }
    Error { message }  => "err"
}
let rGuard = match randomBelow(0) { Success { value } => "no-error"  Error { message } => "rejected" }
print("random>=0 ${rNonNeg}, randomBelow(100) ${rBounded}, randomBelow(0) ${rGuard}, stdin=[${input()}]")
print("=== Math Showcase Complete ===")

/// Recomputes the showcase branches and validates checked-arithmetic boundaries.
fn comprehensiveMathCase() = {
    let overflowRejected = match checkedAdd(9223372036854775807, 1) {
        Success { value } => false
        Error { message } => message != ""
    }
    let zeroDivisionRejected = match intDiv(5, 0) {
        Success { value } => false
        Error { message } => message != ""
    }
    let boundedRandom = match randomBelow(100) {
        Success { value } => (value >= 0) && (value < 100)
        Error { message } => false
    }
    let invalidRandomBound = match randomBelow(0) {
        Success { value } => false
        Error { message } => message != ""
    }
    checkAll("math values, branches, and checked errors", [
        (power(base: 2, exp: 0) ?: 0) == 1,
        (power(base: 2, exp: 1) ?: 0) == 2,
        (power(base: 2, exp: 2) ?: 0) == 4,
        (power(base: 2, exp: 3) ?: 0) == 8,
        (power(base: 2, exp: 4) ?: 0) == 16,
        factorial(0) == 1,
        factorial(5) == 120,
        factorial(9) == 720,
        fibonacci(0) == 0,
        fibonacci(5) == 5,
        fibonacci(9) == 8,
        (complex(a: 5, b: 3) ?: 0) == 18,
        isEven(8),
        !isEven(7),
        classify(0) == "Zero",
        classify(1) == "One",
        classify(5) == "Many",
        safeDivide(a: 10, b: 2) == 5,
        safeDivide(a: 20, b: 4) == 5,
        safeDivide(a: 15, b: 3) == 0,
        safeDivide(a: 15, b: 0) == 999999,
        (checkedAdd(2, 3) ?: 0) == 5,
        (checkedSub(2, 3) ?: 0) == ((0 - 1) ?: 0),
        (checkedMul(6, 7) ?: 0) == 42,
        (intDiv(25, 2) ?: 0) == 12,
        (abs((0 - 5000000000) ?: 0) ?: 0) == 5000000000,
        overflowRejected,
        zeroDivisionRejected,
        boundedRandom,
        invalidRandomBound,
        random() >= 0,
        // [BUILTIN-RANDOM]: "calls are not reproducible". Two draws that match
        // mean the source is not one -- an uninitialised stack word reused from
        // the same frame slot satisfies `>= 0` above and this catches it. A
        // genuine collision is one in 2^63.
        random() != random(),
        input() == ""
    ])
}
test("math showcase produces checked deterministic state", comprehensiveMathCase)
