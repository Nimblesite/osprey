// ML-flavor twin of file_io_json_workflow.osp. File builtins [BUILTIN-FILE].
// Layout match arms, whitespace
// application (`writeFile filename content`), and `x = e` bindings lower to the
// SAME canonical AST as the Default braces/parens form — byte-identical IR
// ([FLAVOR-IR-EQUIV]).
print "=== File I/O Workflow Test ==="

content = "Hello, Osprey file I/O!"
filename = "test_output.txt"

print "-- Step 1: Writing to file --"
writeResult = writeFile filename content
match writeResult
    Success value => print "File written successfully!"
    Error message => print "Write failed!"

print "-- Step 2: Reading from file --"
readResult = readFile filename
match readResult
    Success value => print "Read successful!"
    Error message => print "Read failed!"

print "-- Step 3: Testing Result<string> toString --"
print "Write Result toString: ${toString writeResult}"  // Tests Result<Unit> toString
print "Read Result toString: ${toString readResult}"    // Tests Result<string> toString

(** Test error case for Result<string> *)
errorResult = readFile "nonexistent_file_xyz123.txt"
print "Error Result toString: ${toString errorResult}"  // Should print "Error"

print "=== Test Complete ==="

(** Repeat the real write/read workflow and verify both Result payloads. *)
fileWorkflowCase () =
    expected = "Hello, Osprey file I/O!"
    written = writeFile "test_output.txt" expected
    readBack = readFile "test_output.txt"
    missing = readFile "nonexistent_file_xyz123.txt"
    writeMatches = match written
        Success value => value == byteLength expected
        Error message => false
    readMatches = match readBack
        Success value => value == expected
        Error message => false
    missingFails = match missing
        Success value => false
        Error message => length message > 0
    checkAll "file write/read Results" [
        writeMatches,
        readMatches,
        missingFails
    ]
test "file workflow persists content and reports missing files" fileWorkflowCase
