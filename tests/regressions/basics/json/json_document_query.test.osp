// JSON's six primitive value kinds form a recursive tagged union. Objects map
// names to JsonValue and arrays contain JsonValue, so traversal narrows every
// node with `match` before descending to the next level.

type JsonValue =
    JsonNull
    | JsonBoolean { value: bool }
    | JsonNumber { value: int }
    | JsonString { value: string }
    | JsonArray { values: List<JsonValue> }
    | JsonObject { fields: Map<string, JsonValue> }

fn describe(value) = match value {
    JsonNull => "null"
    JsonBoolean(_value) => "boolean"
    JsonNumber(_value) => "number"
    JsonString(_value) => "string"
    JsonArray(_values) => "array"
    JsonObject(_fields) => "object"
}

/// This is a recursive JSON walk: match the object/array container, then pass
/// each nested JsonValue to the same matcher. The document below has one root
/// field, making the path and its output deterministic.
fn reportDeepString(value) = match value {
    JsonObject { fields } => forEachList(mapValues(fields), reportDeepString)
    JsonArray { values } => forEachList(values, reportDeepString)
    JsonString { value } => print("deeply nested string = ${value}")
    JsonNull => print("unexpected null")
    JsonBoolean(_value) => print("unexpected boolean")
    JsonNumber(_value) => print("unexpected number")
}

let deepestValue = JsonString { value: "devon@osprey.dev" }
let innerArray = JsonArray { values: List() |> listAppend(deepestValue) }
let outerArray = JsonArray { values: List() |> listAppend(innerArray) }
let document = JsonObject { fields: Map() |> mapSet("workspace", outerArray) }

print("=== JSON value union ===")
match document {
    JsonObject { fields } => print("root is ${describe(document)} with ${toString(mapLength(fields))} field")
    _ => print("root is not an object")
}
reportDeepString(document)
print("types: ${describe(JsonNull)}, ${describe(JsonBoolean { value: true })}, ${describe(JsonNumber { value: 17 })}, ${describe(deepestValue)}, ${describe(outerArray)}, ${describe(document)}")
print("=== JSON value union complete ===")

/// Recursively follows the single object/array path to its string leaf.
fn deepString(value) = match value {
    JsonObject { fields } => match mapGet(fields, "workspace") {
        Success { value } => deepString(value)
        Error => ""
    }
    JsonArray { values } => match listGet(values, 0) {
        Success { value } => deepString(value)
        Error => ""
    }
    JsonString { value } => value
    _ => ""
}

/// Counts object fields while returning zero for non-object values.
fn objectFieldCount(value) = match value {
    JsonObject { fields } => mapLength(fields)
    _ => 0
}

/// Rebuilds and traverses the recursive document under the test runner.
fn jsonDocumentCase() = {
    let deepest = JsonString { value: "devon@osprey.dev" }
    let inner = JsonArray { values: List() |> listAppend(deepest) }
    let outer = JsonArray { values: List() |> listAppend(inner) }
    let root = JsonObject { fields: Map() |> mapSet("workspace", outer) }
    reportDeepString(root)
    checkAll("recursive JSON document", [
        describe(JsonNull) == "null",
        describe(JsonBoolean { value: true }) == "boolean",
        describe(JsonNumber { value: 17 }) == "number",
        describe(deepest) == "string", describe(outer) == "array",
        describe(root) == "object", objectFieldCount(root) == 1,
        deepString(root) == "devon@osprey.dev",
        deepString(JsonNull) == ""
    ])
}
test("recursive JSON traversal preserves the nested value", jsonDocumentCase)

let noScalar = "<none>"
let notAContainer = -1
let notReleased = -1

/// Reads one scalar by path, or a marker when the path names no scalar.
fn scalarAt(doc, path) = jsonGet(doc, path) ?: noScalar

/// Parses a document with the built-in JSON functions, reads scalars and
/// lengths by path, then releases the handle exactly once. [BUILTIN-JSON]
fn parsedDocumentCase() = match jsonParse("{\"owner\":\"devon\",\"tags\":[\"a\",\"b\",\"c\"],\"active\":true,\"stars\":17}") {
    Success { value } => checkAll("built-in JSON document", [
        scalarAt(value, "owner") == "devon", scalarAt(value, "tags[1]") == "b",
        scalarAt(value, "active") == "true", scalarAt(value, "stars") == "17",
        scalarAt(value, "tags") == noScalar, scalarAt(value, "absent") == noScalar,
        jsonLength(value, "") == 4, jsonLength(value, "tags") == 3,
        jsonLength(value, "owner") == notAContainer,
        (jsonFree(value) ?: notReleased) == 0,
        (jsonFree(value) ?: notReleased) == notReleased
    ])
    Error => checkAll("built-in JSON document", [false])
}
test("built-in JSON functions parse, query and release a document", parsedDocumentCase)
