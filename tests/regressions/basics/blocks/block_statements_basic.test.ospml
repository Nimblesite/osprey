(** Cross-contract oracle for [BLOCK-SCOPE], [PATTERN-RESULT-DEFAULT],
    [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [ARITH-CHECKED],
    [FLAVOR-ML-BLOCK], [FLAVOR-ML-LIST], [FLAVOR-ML-MAP],
    [FLAVOR-ML-INDEX], and [FLAVOR-ML-MATCH]. *)

print "=== Block Statements ==="

(** --- 1. Block with list access (single statement) --- *)
listHeadBlock () =
    nums = [42, 84, 126]
    match nums[0]
        Success value => value
        Error message => 0
r1 = listHeadBlock ()
print "1 list head: ${r1}"

(** --- 2. Block with map access + multiplication --- *)
mapProductBlock () =
    config = ["factor" => 2, "base" => 10]
    x = match config["base"]
        Success value => value
        Error message => 0
    factor = match config["factor"]
        Success value => value
        Error message => 1
    m = x * factor
    match m
        Success value => value
        Error message => 0
r2 = mapProductBlock ()
print "2 map factor*base: ${r2}"

(** --- 3. Nested blocks with shadowing --- *)
outer = 100
shadowedBlock () =
    config = ["multiplier" => 2, "offset" => 25]
    outer = match config["offset"]
        Success value => value
        Error message => 50
    inner =
        listData = [10, 20, 30]
        outer = match listData[2]
            Success value => value
            Error message => 25
        m = outer * 2
        match m
            Success value => value
            Error message => 0
    s = outer + inner
    match s
        Success value => value
        Error message => 0
r3 = shadowedBlock ()
print "3 shadowed inner+outer: ${r3}"

(** --- 4. Block inside a function --- *)
compute () =
    numbers = [5, 10, 15]
    base = match numbers[1]
        Success value => value
        Error message => 10
    multiplier = 3
    r = base * multiplier
    match r
        Success value => value
        Error message => 0
print "4 fn block: ${compute ()}"

(** --- 5. 2D list inside a block --- *)
matrixBlock () =
    matrix = [[1, 2], [3, 4]]
    firstRow = match matrix[0]
        Success value => value
        Error message => [0]
    match firstRow[1]
        Success value =>
            m = value * 10
            match m
                Success result => result
                Error message => 0
        Error message => 0
r5 = matrixBlock ()
print "5 2D matrix[0][1]*10: ${r5}"

(** --- 6. Conditional logic via nested match producing a block result --- *)
value = 42
conditionalBlock value =
    scoreMap = ["test1" => 84, "test2" => 90]
    doubled = value * 2
    match doubled
        Success dValue => match dValue
            84 => match scoreMap["test1"]
                Success sValue =>
                    added = sValue + 10
                    match added
                        Success value => value
                        Error message => 0
                Error message => 0
            _ => 0
        Error message => 0
r6 = conditionalBlock value
print "6 cond match block: ${r6}\n=== Done ==="

(** Verify every block result, including shadowing and the wildcard branch. *)
blockStatementsCase () =
    results = [r1, r2, r3, compute (), r5, r6]
    nestedResults = [results, [listHeadBlock (), matrixBlock ()], [conditionalBlock 10]]
    byName = [
        "head" => r1,
        "map" => r2,
        "shadow" => r3,
        "compute" => compute (),
        "matrix" => r5,
        "conditional" => r6
    ]

    checkAll "block statement values" [
        listHeadBlock () == 42,
        mapProductBlock () == 20,
        shadowedBlock () == 85,
        compute () == 30,
        matrixBlock () == 20,
        conditionalBlock 42 == 94,
        conditionalBlock 10 == 0
    ]

    checkAll "top-level bindings and lexical shadowing remain stable" [
        r1 == 42,
        r2 == 20,
        r3 == 85,
        r5 == 20,
        r6 == 94,
        outer == 100,
        value == 42,
        shadowedBlock () == r3,
        compute () == compute (),
        matrixBlock () == r5,
        conditionalBlock value == r6,
        conditionalBlock 0 == 0,
        conditionalBlock 41 == 0,
        conditionalBlock 43 == 0,
        conditionalBlock ((0 - 1) ?: 0) == 0
    ]

    checkAll "block results retain element types in nested lists" [
        listLength results == 6,
        (listGet results 0 ?: 99) == 42,
        (listGet results 1 ?: 99) == 20,
        (listGet results 2 ?: 99) == 85,
        (listGet results 3 ?: 99) == 30,
        (listGet results 4 ?: 99) == 20,
        (listGet results 5 ?: 99) == 94,
        (listGet results 9 ?: 99) == 99,
        listLength nestedResults == 3,
        listLength (listGet nestedResults 0 ?: [99]) == 6,
        listLength (listGet nestedResults 1 ?: [99]) == 2,
        listLength (listGet nestedResults 2 ?: [99]) == 1,
        (listGet (listGet nestedResults 0 ?: [99]) 2 ?: 99) == 85,
        (listGet (listGet nestedResults 1 ?: [99]) 1 ?: 99) == 20,
        (listGet (listGet nestedResults 2 ?: [99]) 0 ?: 99) == 0
    ]

    checkAll "block results remain coherent in maps and interpolation" [
        mapLength byName == 6,
        (mapGet byName "head" ?: 99) == 42,
        (mapGet byName "map" ?: 99) == 20,
        (mapGet byName "shadow" ?: 99) == 85,
        (mapGet byName "compute" ?: 99) == 30,
        (mapGet byName "matrix" ?: 99) == 20,
        (mapGet byName "conditional" ?: 99) == 94,
        (mapGet byName "missing" ?: 99) == 99,
        listLength (mapKeys byName) == 6,
        listLength (mapValues byName) == 6,
        "${r1}/${r2}/${r3}/${r5}/${r6}" == "42/20/85/20/94",
        "outer=${outer} inner=${shadowedBlock ()}" == "outer=100 inner=85"
    ]
test "blocks preserve values and lexical scope" blockStatementsCase
