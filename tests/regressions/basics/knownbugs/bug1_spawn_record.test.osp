type Job = { id: int, weight: int }
fn runJob(j) = j.id * j.weight ?: 0
let jHigh = Job { id: 3, weight: 9 }
print(toString(runJob(jHigh)))
let f = spawn runJob(jHigh)
print(toString(await(f)))

/// Verifies that record arguments survive both direct and spawned calls.
fn spawnRecordCase() = {
    let primary = Job { id: 3, weight: 9 }
    let another = Job { id: 4, weight: 7 }
    let future = spawn runJob(another)
    let spawnedResult = await(future)
    checkAll("record values cross the fiber boundary", [
        runJob(primary) == 27,
        runJob(another) == 28,
        spawnedResult == 28,
        primary.id == 3,
        primary.weight == 9
    ])
}
test("spawn preserves record arguments", spawnRecordCase)
