type Outcome =
    Done
        score : int
    Failed
        code : int

classify s =
    match s
        0 => Failed(code = 99)
        _ => Done(score = s)

describe o =
    match o
        Done score => "done " + toString score
        Failed code => "failed " + toString code

print (describe (Done(score = 27)))
print (describe (classify 27))
print (describe (classify 0))

(** Verify returned union values can immediately flow into another function. *)
unionReturnArgumentCase () = checkAll "union return and argument flow" [
    describe (Done(score = 27)) == "done 27",
    describe (classify 27) == "done 27",
    describe (classify 0) == "failed 99",
    describe (classify ((0 - 3) ?: 0)) == "done -3",
    describe (Failed(code = 7)) == "failed 7"
]
test "union returns remain valid call arguments" unionReturnArgumentCase
