type Outcome = Done { score: int } | Failed { reason: string }
fn classify(score) = match score {
    0 => Failed { reason: "empty" }
    _ => Done   { score: score }
}
fn describe(o) = match o {
    Done   { score }  => "done " + toString(score)
    Failed { reason } => "failed " + reason
}
print(describe(classify(27)))
print(describe(classify(0)))

/// Verifies both union variants retain their string and integer payloads.
fn stringUnionPayloadCase() = checkAll("union payload rendering", [
    describe(classify(27)) == "done 27",
    describe(classify(0)) == "failed empty",
    describe(classify((0 - 4) ?: 0)) == "done -4",
    describe(Done { score: 9 }) == "done 9",
    describe(Failed { reason: "blocked" }) == "failed blocked"
])
test("string union payloads survive matching", stringUnionPayloadCase)
