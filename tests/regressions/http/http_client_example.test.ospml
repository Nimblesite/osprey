// Deterministic loopback coverage for the status-only HTTP client.

localResponse : string -> string -> string -> string -> HttpResponse
localResponse (method, path, headers, body) = HttpResponse(
    status = 200,
    headers = "Content-Type: text/plain",
    contentType = "text/plain",
    streamFd = 0,
    isComplete = true,
    partialBody = "ok"
)

localHttpRoundTrip () =
    server = httpCreateServer 18108 "127.0.0.1"
    listening = httpListen server localResponse
    client = httpCreateClient "http://127.0.0.1:18108" 1000
    status = httpGet client "/health" ""
    closed = httpCloseClient client
    stopped = httpStopServer server
    checkAll "loopback HTTP round trip" [
        server != 0,
        listening == 0,
        client != 0,
        status == 200,
        closed == 0,
        stopped == 0
    ]

test "status-only HTTP client uses a local server" localHttpRoundTrip
