/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

// HTTP response-handle and JSON document integration. Each handle operation
// uses its own helper. Implements [HTTP-RESPONSE-HANDLE] and [BUILTIN-JSON].

fn handleRequest(_method: string, _path: string, _headers: string, _body: string) = HttpResponse {
    status: 200,
    headers: "Content-Type: application/json",
    contentType: "application/json",
    streamFd: (0 - 1) ,
    isComplete: true,
    partialBody: "[{\"name\":\"osprey\",\"stars\":1200,\"lang\":\"Go\"},{\"name\":\"llvm\",\"stars\":9001,\"lang\":\"C++\"},{\"name\":\"antlr\",\"stars\":4200,\"lang\":\"Java\"}]"
}

/// --- color + layout helpers ---
fn cyan(s) = "\e[36m${s}\e[0m"
fn bold(s) = "\e[1m${s}\e[0m"
fn yellow(s) = "\e[33m${s}\e[0m"
fn dim(s) = "\e[2m${s}\e[0m"
fn green(s) = "\e[32m${s}\e[0m"

fn pad(s, n) = {
    let r = padEnd(s, n, " ")
    match r {
        Success { value } => value
        Error => s
    }
}

fn field(doc, path) = {
    let r = jsonGet(doc, path)
    match r {
        Success { value } => value
        Error => "?"
    }
}

fn renderRow(doc, i, n) = {
    match i < n {
        true => {
            let name = field(doc: doc, path: "[${i}].name")
            let stars = field(doc: doc, path: "[${i}].stars")
            let lang = field(doc: doc, path: "[${i}].lang")
            let bullet = cyan("*")
            let nameCol = bold(pad(s: name, n: 12))
            let starsCol = yellow("* ${pad(s: stars, n: 5)}")
            let langCol = dim(lang)
            print("  ${bullet} ${nameCol} ${starsCol} ${langCol}")
            renderRow(doc: doc, i: (i + 1) , n: n)
        }
        false => print("")
    }
}

fn renderTable(doc) = {
    let count = jsonLength(doc, "")
    print(green("  Repositories (${count})"))
    print("  ----------------------------")
    renderRow(doc: doc, i: 0, n: count)
}

fn renderDoc(d) = {
    renderTable(d)
    let _fr = jsonFree(d)
    print(dim("  rendered"))
}

fn renderBody(bodyText) = {
    let doc = jsonParse(bodyText)
    match doc {
        Success { value } => renderDoc(value)
        Error => print("jsonfail")
    }
}

fn renderResponse(h) = {
    let body = httpResponseBody(h)
    match body {
        Success { value } => {
            renderBody(value)
            value
        }
        Error => {
            print("bodyfail")
            ""
        }
    }
}

fn run() = {
    let serverId = httpCreateServer(18099, "127.0.0.1")
    let _listenResult = httpListen(serverId, handleRequest)
    let clientId = httpCreateClient("http://127.0.0.1:18099", 5000)
    let resp = httpGetResponse(clientId, "/repos", "")
    let bodyText = match resp {
        Success { value } => {
            let rendered = renderResponse(value)
            let _freed = httpResponseFree(value)
            rendered
        }
        Error { message } => {
            print("reqfail ${message}")
            ""
        }
    }
    let _closeResult = httpCloseClient(clientId)
    let _stopResult = httpStopServer(serverId)
    bodyText
}

/// Fetches, renders, and validates the repository document over loopback HTTP.
fn repoTableCase() = {
    let bodyText = run()
    checkAll("repository table data", [
        contains(bodyText, "\"name\":\"osprey\""),
        contains(bodyText, "\"stars\":9001"),
        contains(bodyText, "\"lang\":\"Java\""),
        pad("Go", 4) == "Go  ",
        startsWith(cyan("*"), "\e[36m")
    ])
}

test("repository JSON renders after an HTTP response round trip", fn() => exactArithmetic(repoTableCase))
