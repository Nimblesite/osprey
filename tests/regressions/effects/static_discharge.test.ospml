// Static effect rows are inferred through direct calls, call chains, callbacks,
// closures, partial handlers, and generic effect instances. No function below
// needs a return-type or effect-row annotation.

effect Supply
    (** Request a value where the performer calls the operation itself. *)
    direct : int => int
    (** Request a value through an intermediate call, not directly. *)
    transitive : int => int
    (** Request a value from inside a callback passed to another function. *)
    callback : Unit => int
    (** Request a value from inside a closure invoked later. *)
    delayed : Unit => int

direct seed = perform Supply.direct seed
source seed = perform Supply.transitive seed
relay seed = source seed
invoke callback = callback ()

directValue =
    handle Supply
        direct seed => seed
    in direct 7

transitiveValue =
    handle Supply
        transitive seed => seed
    in relay 11

callbackValue =
    handle Supply
        callback => 13
    in invoke (\() => perform Supply.callback ())

delayed = \() => perform Supply.delayed ()
delayedValue =
    handle Supply
        delayed => 17
    in delayed ()

effect Pair
    (** Read the first of the two supplied integers. *)
    first : Unit => int
    (** Read the second of the two supplied integers. *)
    second : Unit => int

pairTotal () =
    first = perform Pair.first ()
    second = perform Pair.second ()
    first + second ?: 0

(** The inner partial handler discharges only `first`; `second` reaches the
    complementary outer handler. *)
partialValue =
    handle Pair
        second => 22
    in
        handle Pair
            first => 20
        in pairTotal ()

effect Stash T
    (** Store `value` in the stash for a later `take`. *)
    put : T => Unit
    (** Remove and return the stashed value of type `T`. *)
    take : Unit => T

storeText () = perform Stash.put "fresh"

genericValue =
    handle Stash
        put value => print ""
        take => "cached"
    in
        storeText ()
        19

test "inferred effect rows discharge only under matching handlers" (\() => checkAll "static discharge values" [
    directValue == 7,
    transitiveValue == 11,
    callbackValue == 13,
    delayedValue == 17,
    partialValue == 42,
    genericValue == 19
])
