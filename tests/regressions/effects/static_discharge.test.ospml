// Static effect rows are inferred through direct calls, call chains, callbacks,
// closures, partial handlers, and generic effect instances. No function below
// needs a return-type or effect-row annotation.

effect Supply
    direct : int => int
    transitive : int => int
    callback : Unit => int
    delayed : Unit => int

direct seed = perform Supply.direct seed
source seed = perform Supply.transitive seed
relay seed = source seed
invoke callback = callback ()

directValue =
    handle Supply
        direct seed => seed
    in direct 7

transitiveValue =
    handle Supply
        transitive seed => seed
    in relay 11

callbackValue =
    handle Supply
        callback => 13
    in invoke (\() => perform Supply.callback ())

delayed = \() => perform Supply.delayed ()
delayedValue =
    handle Supply
        delayed => 17
    in delayed ()

effect Pair
    first : Unit => int
    second : Unit => int

pairTotal () =
    first = perform Pair.first ()
    second = perform Pair.second ()
    first + second ?: 0

(** The inner partial handler discharges only `first`; `second` reaches the
    complementary outer handler. *)
partialValue =
    handle Pair
        second => 22
    in
        handle Pair
            first => 20
        in pairTotal ()

effect Stash T
    put : T => Unit
    take : Unit => T

storeText () = perform Stash.put "fresh"

genericValue =
    handle Stash
        put value => print ""
        take => "cached"
    in
        storeText ()
        19

test "inferred effect rows discharge only under matching handlers" (\() => checkAll "static discharge values" [
    directValue == 7,
    transitiveValue == 11,
    callbackValue == 13,
    delayedValue == 17,
    partialValue == 42,
    genericValue == 19
])
