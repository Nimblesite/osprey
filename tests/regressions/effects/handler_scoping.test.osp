// Handler scoping regressions:
//   1. Forward-reference pre-pass: helpers declared AFTER main(), each
//      performing an effect, must all reach the outer handle/in block.
//   2. Nested handler override: an inner handle/in for the same effect
//      replaces the outer handler for its body, then the outer handler is
//      restored for code that follows.

effect Logger {
    /// Record `message` in whatever log the installed handler owns.
    log: fn(string) -> Unit
    /// Record a diagnostic `message` kept out of normal output.
    debug: fn(string) -> Unit
}

/// ---- nested override helpers ----
fn innerOp() !Logger = {
    perform Logger.log("inner exec")
    perform Logger.debug("debug inner")
    42
}
fn outerOp() !Logger = {
    perform Logger.log("outer exec")
    perform Logger.debug("debug outer")
    21
}
fn testNested() !Logger = {
    perform Logger.log("before inner handler")

    let innerResult = handle Logger
        log msg   => print("[INNER-LOG] " + msg)
        debug msg => print("[INNER-DEBUG] " + msg)
    in {
        let r = innerOp()
        perform Logger.log("inner result: " + toString(r))
        r
    }

    perform Logger.log("after inner handler — back to outer")
    let outerResult = outerOp()
    perform Logger.log("outer result: " + toString(outerResult))
}

handle Logger
    log msg   => print("[OUTER-LOG] " + msg)
    debug msg => print("[OUTER-DEBUG] " + msg)
in {
    print("=== handler scoping ===")
    /// (1) forward-reference: nestedCall + deepNestedOp + performComplex are
    /// all defined AFTER main; every perform inside their chain must still
    /// reach this outer handle/in block.
    let r = nestedCall()
    print("forward chain result: " + toString(r))

    // (2) nested override
    testNested()
    print("=== done ===")
}

/// helpers defined AFTER main — exercises the forward-ref pre-pass
fn performComplex() !Logger = {
    perform Logger.log("complex starting")
    let v = 21 * 2
    perform Logger.log("complex intermediate: " + toString(v))
    v
}

fn deepNestedOp() !Logger = {
    perform Logger.log("deep op exec")
    performComplex()
}

fn nestedCall() !Logger = {
    perform Logger.log("before nested")
    let r = deepNestedOp()
    perform Logger.log("after nested")
    r
}

/// (3) RESUME under scoping — regression locks:
///     nested RESUMING handlers for different effects compose, and the
///     innermost handler of a shadowed effect wins for `resume` too.
effect Ask {
    /// Request a replacement for `value` from the installed handler.
    ask: fn(int) -> int
}
effect Tell {
    /// Hand `value` to the handler and use whatever it returns.
    tell: fn(int) -> int
}

fn askBoth(n) ![Ask, Tell] = {
    let a = perform Ask.ask(n)
    perform Tell.tell(a)
}

let nested = handle Ask
    ask v => resume((v + 1) ?: v)
in handle Tell
    tell v => resume((v * 2) ?: v)
in askBoth(4)

fn askOnce(n) !Ask = perform Ask.ask(n)

let shadowed = handle Ask
    ask v => resume((v + 100) ?: v)
in handle Ask
    ask v => resume((v + 1) ?: v)
in askOnce(1)
print("nested resuming " + toString(nested) + " shadowed resume " + toString(shadowed))
print("=== resume scoping done ===")

/// (4) RESUME carrying an ERASED operand — the box must survive the captured
///     continuation. A value-carrying `resume` suspends the performer and
///     restores it later, so an `any` operand crosses the mailbox, is narrowed
///     by the arm, and is released by whoever still owns it after the round
///     trip. Every ownership rule for a box is pinned in
///     tests/regressions/basics/types/any_type_comprehensive, but that file
///     stays free of `resume` so it keeps its wasm32 goldens; only a RESUMING
///     handler routes a box through a continuation, and that path is already
///     unportable here for `__osprey_coro_suspend`.
///     [TYPE-ANY] [EFFECTS-OPERATION-MAILBOX] [GC-ARC-PERCEUS]
type Boxed = { held: string, tag: int }

effect Audit {
    /// Narrow `item` and hand back the width of its rendering.
    note: fn(any) -> int
}

fn describeErased(v: any) = match v {
    { held, .. } => "held=${held}"
    _            => "other=${v}"
}

/// Both performs continue afterwards, so each one's box is live across a
/// suspend — the heap payload is built at runtime so ARC actually counts it.
fn auditWork() = {
    let a = perform Audit.note(Boxed { held: "eff" + "ect", tag: 3 })
    let b = perform Audit.note(5)
    (a + b) ?: 0
}

let audited = handle Audit
    note item => resume(length(describeErased(item)))
in auditWork()

/// Runs the forward-referenced chain under a quiet handler.
fn forwardResultForTest() = handle Logger
    log msg => 0
    debug msg => 0
in nestedCall()

// Re-enters the forward call chain and checks nested handler restoration.
test("nested handlers override locally and restore outer scope", fn() => checkAll("handler scope results", [
        (forwardResultForTest() ?: 0) == 42,
        nested == 10,
        shadowed == 2,
        nested != shadowed,
        audited == 18
]))

/// Counter proves handler-owned state is one shared cell no matter how deep the
/// performing call sits ([EFFECTS-HANDLER-STATE]).
effect Counter {
    /// Add `amount` to the handler's cell and answer the running total.
    bump: fn(int) -> int
    /// Read the handler's cell, offset by `offset`, without changing it.
    snapshot: fn(int) -> int
}

/// One nested helper level: the perform leaves the handled body's own frame.
fn bumpVia(n) !Counter = perform Counter.bump(n)

/// Two nested helper levels, so the operation is two calls from the region.
fn bumpTwice(n) !Counter = {
    let first = bumpVia(n)
    let second = bumpVia(n + 1 ?: n)
    (first + second) ?: 0
}

/// Three levels: [EFFECTS-HANDLER-STATE] does not stop at a call boundary.
fn deeplyNested(n) !Counter = bumpTwice(n)

// A handler region at file scope owns its cell exactly as one inside a
// function does — the spec's own example installs the handler at top level.
mut topCell = 0
mut topBumps = 0
let topSum = handle Counter
    bump amount => {
        topBumps = topBumps + 1 ?: topBumps
        topCell = topCell + amount ?: topCell
        topCell
    }
    snapshot offset => topCell + offset ?: topCell
in deeplyNested(2)

/// [EFFECTS-HANDLER-STATE] promotes a captured `mut` to a shared heap cell so
/// "every arm, the handled body, and code after the region observe the same
/// location". Nothing in that sentence is scoped to the frame that performs, so
/// a perform issued from a nested helper — or from a region installed at file
/// scope — must land on the same cell. Issues #178 and #156.
fn handlerStateThroughNestedCallsCase() = {
    mut cell = 0
    mut bumps = 0
    mut snapshots = 0
    mut lastAmount = 0
    let sum = handle Counter
        bump amount => {
            bumps = bumps + 1 ?: bumps
            cell = cell + amount ?: cell
            lastAmount = amount
            cell
        }
        snapshot offset => {
            snapshots = snapshots + 1 ?: snapshots
            cell + offset ?: cell
        }
    in {
        let nestedSum = deeplyNested(5)
        let live = perform Counter.snapshot(0)
        (nestedSum + live) ?: 0
    }
    let after = handle Counter
        bump amount => {
            bumps = bumps + 1 ?: bumps
            cell = cell + amount ?: cell
            cell
        }
        snapshot offset => cell + offset ?: cell
    in bumpVia(100)

    // The arm's own answers accumulate on one cell across three call levels.
    checkAll("nested performs share the handler cell", [
        sum == 27,
        cell == 111,
        bumps == 3,
        snapshots == 1,
        lastAmount == 6,
        after == 111,
        after == cell,
        sum != cell,
        bumps != snapshots,
        (bumps + snapshots ?: 0) == 4
    ])

    // Each intermediate total is observable, so a lost update cannot hide
    // behind a correct final sum.
    checkAll("handler cell reaches every intermediate total", [
        (5 + 11 ?: 0) == 16,
        sum == (16 + 11 ?: 0),
        cell == (11 + 100 ?: 0),
        lastAmount == (5 + 1 ?: 0),
        cell > 0,
        cell != 0,
        sum > 0,
        after > sum,
        after > lastAmount,
        bumps == 3
    ])

    // The file-scope region owns its own cell, on the same rule.
    checkAll("a top-level handler region owns its state", [
        topSum == 7,
        topCell == 5,
        topBumps == 2,
        topCell != cell,
        topSum != sum,
        topCell == (2 + 3 ?: 0),
        topSum == (2 + 5 ?: 0),
        topBumps != bumps,
        topCell > 0,
        topSum > topCell
    ])
}

// Register handler-owned state across nested performs and a file-scope region.
test("handler-owned state is one cell across nested calls and file scope", handlerStateThroughNestedCallsCase)
