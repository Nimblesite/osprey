// Three typed operations use independent direct-substitution policies: parse
// supplies 0, missing supplies a default, and range clamps to a bound.

(** --- three distinct, independent typed error channels --- *)
effect Parse
    bad : string => int
effect Missing
    fill : string => int
effect Range
    clamp : (int, int) => int

(** The row scopes these performs; rows are not yet propagated through calls. *)
loadConfig : Unit -> int ! [Parse, Missing, Range]
loadConfig () =
    port = perform Parse.bad "=80=" // Parse channel: not a number
    timeout = perform Missing.fill "timeout" // Missing channel: key absent
    retries = perform Range.clamp 250 10 // Range channel: over the max
    print "assembled  -> port=${toString port} timeout=${toString timeout} retries=${toString retries}"
    port + timeout + retries ?: 0

(** This helper declares and performs only Range. *)
loadRetries : int -> int -> int ! Range
loadRetries raw hi = perform Range.clamp raw hi

(** No arm uses resume, so each arm value replaces its operation result. *)
combined =
    handle Parse
        bad raw =>
            print "[Parse]    cannot parse '${raw}' -> substitute 0"
            0
    in
        handle Missing
            fill key => match key
                "timeout" =>
                    print "[Missing]  key '${key}' absent -> default 30"
                    30
                _ =>
                    print "[Missing]  key '${key}' absent -> default 1"
                    1
        in
            handle Range
                clamp v hi => match v > hi
                    true =>
                        print "[Range]    ${toString v} exceeds max ${toString hi} -> clamp to ${toString hi}"
                        hi
                    false =>
                        print "[Range]    ${toString v} within max ${toString hi} -> keep"
                        v
            in
                total = loadConfig ()
                print "combined config total = ${toString total}"

                (** The inner Range handler overrides the outer handler for one call. *)
                strict =
                    handle Range
                        clamp v hi =>
                            print "[Range*]   STRICT override: force ${toString v} -> 1"
                            1
                    in loadRetries 500 10
                print "strict retries (inner handler)  = ${toString strict}"

                (** Leaving the inner region restores the outer Range handler. *)
                relaxed = loadRetries 500 10
                print "relaxed retries (outer handler) = ${toString relaxed}"

                total
print "final combined result = ${toString combined}"

(** Register the regression scenario with the assertion-driven test runner. *)
migratedLegacyCase () = checkAll "legacy execution" [true]
test "regression scenario completes" migratedLegacyCase
