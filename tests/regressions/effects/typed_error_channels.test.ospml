(** Cross-contract oracle for [EFFECTS-OP-TYPING], [EFFECTS-STATIC-DISCHARGE],
    [EFFECTS-HANDLER-STATE], [TYPE-LIST], [TYPE-LIST-PATTERNS], [TYPE-MAP],
    [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], [PATTERN-RESULT-DEFAULT],
    [FLAVOR-ML-HANDLER], [FLAVOR-ML-LIST], [FLAVOR-ML-MAP], and
    [FLAVOR-ML-MATCH]. *)

(** --- three distinct, independent typed error channels --- *)
effect Parse
    (** Supply the integer to use for unparseable `text`. *)
    bad : string => int
effect Missing
    (** Supply the default for the absent field `name`. *)
    fill : string => int
effect Range
    (** Clamp `value` into range, returning the bound it was pinned to. *)
    clamp : (int, int) => int

(** The row scopes these performs; rows are not yet propagated through calls. *)
loadConfig : Unit -> int ! [Parse, Missing, Range]
loadConfig () =
    port = perform Parse.bad "=80=" // Parse channel: not a number
    timeout = perform Missing.fill "timeout" // Missing channel: key absent
    retries = perform Range.clamp 250 10 // Range channel: over the max
    print "assembled  -> port=${toString port} timeout=${toString timeout} retries=${toString retries}"
    port + timeout + retries ?: 0

(** This helper declares and performs only Range. *)
loadRetries : int -> int -> int ! Range
loadRetries raw hi = perform Range.clamp raw hi

(** No arm uses resume, so each arm value replaces its operation result. *)
combined =
    handle Parse
        bad raw =>
            print "[Parse]    cannot parse '${raw}' -> substitute 0"
            0
    in
        handle Missing
            fill key => match key
                "timeout" =>
                    print "[Missing]  key '${key}' absent -> default 30"
                    30
                _ =>
                    print "[Missing]  key '${key}' absent -> default 1"
                    1
        in
            handle Range
                clamp v hi => match v > hi
                    true =>
                        print "[Range]    ${toString v} exceeds max ${toString hi} -> clamp to ${toString hi}"
                        hi
                    false =>
                        print "[Range]    ${toString v} within max ${toString hi} -> keep"
                        v
            in
                total = loadConfig ()
                print "combined config total = ${toString total}"

                (** The inner Range handler overrides the outer handler for one call. *)
                strict =
                    handle Range
                        clamp v hi =>
                            print "[Range*]   STRICT override: force ${toString v} -> 1"
                            1
                    in loadRetries 500 10
                print "strict retries (inner handler)  = ${toString strict}"

                (** Leaving the inner region restores the outer Range handler. *)
                relaxed = loadRetries 500 10
                print "relaxed retries (outer handler) = ${toString relaxed}"

                total
print "final combined result = ${toString combined}"

(** Apply the strict inner Range policy in isolation. *)
strictRangeForTest () =
    handle Range
        clamp v hi => 1
    in loadRetries 500 10

(** Apply the ordinary clamping Range policy in isolation. *)
relaxedRangeForTest () =
    handle Range
        clamp v hi => hi
    in loadRetries 500 10

parseUnder (raw, replacement) =
    handle Parse
        bad text => replacement
    in perform Parse.bad raw

missingUnder key =
    handle Missing
        fill name => match name
            "timeout" => 30
            _ => 1
    in perform Missing.fill key

clampUnder (raw, high) =
    handle Range
        clamp value limit => match value > limit
            true => limit
            false => value
    in loadRetries raw high

forceUnder (raw, high, replacement) =
    handle Range
        clamp value limit => replacement
    in loadRetries raw high

rangePolicyTrace (raw, high) =
    handle Range
        clamp value limit => match value > limit
            true => limit
            false => value
    in
        before = loadRetries raw high
        strict =
            handle Range
                clamp value limit => 1
            in loadRetries raw high
        after = loadRetries raw high
        [before, strict, after]

traceShape values = match values
    [] => "empty"
    [only] => "one:${only}"
    [first, second] => "two:${first}/${second}"
    [head, ...tail] => "many:${head}+${listLength tail}"

(** Replay Range under two policies and check the composed channel result. *)
typedErrorChannelCase () =
    trace = rangePolicyTrace (500, 10)
    healthyTrace = rangePolicyTrace (5, 10)
    scalars = [
        "parse" => parseUnder ("bad", 7),
        "missing" => missingUnder "timeout",
        "range" => clampUnder (500, 10)
    ]
    nested = [
        "outer-inner-outer" => trace,
        "healthy-inner-healthy" => healthyTrace
    ]
    grown = nested |> mapSet "forced" [forceUnder (9, 10, 4), forceUnder (99, 10, 4)]

    checkAll "typed channel direct substitution policies" [
        combined == 40,
        strictRangeForTest () == 1,
        relaxedRangeForTest () == 10,
        strictRangeForTest () != relaxedRangeForTest (),
        parseUnder ("bad", 0) == 0,
        parseUnder ("bad", 7) == 7,
        parseUnder ("other", 99) == 99,
        missingUnder "timeout" == 30,
        missingUnder "retries" == 1,
        clampUnder (5, 10) == 5,
        clampUnder (10, 10) == 10,
        clampUnder (11, 10) == 10,
        clampUnder (500, 10) == 10,
        forceUnder (5, 10, 4) == 4,
        forceUnder (500, 10, 4) == 4
    ]

    checkAll "nested handlers restore outer policies around collection values" [
        listLength trace == 3,
        (listGet trace 0 ?: 99) == 10,
        (listGet trace 1 ?: 99) == 1,
        (listGet trace 2 ?: 99) == 10,
        listLength healthyTrace == 3,
        (listGet healthyTrace 0 ?: 99) == 5,
        (listGet healthyTrace 1 ?: 99) == 1,
        (listGet healthyTrace 2 ?: 99) == 5,
        traceShape [] == "empty",
        traceShape [7] == "one:7",
        traceShape [7, 8] == "two:7/8",
        traceShape trace == "many:10+2"
    ]

    checkAll "typed effect results remain coherent inside maps of lists" [
        mapLength scalars == 3,
        (mapGet scalars "parse" ?: 99) == 7,
        (mapGet scalars "missing" ?: 99) == 30,
        (mapGet scalars "range" ?: 99) == 10,
        (mapGet scalars "absent" ?: 99) == 99,
        mapLength nested == 2,
        mapLength grown == 3,
        listLength (mapGet nested "outer-inner-outer" ?: [99]) == 3,
        (listGet (mapGet nested "outer-inner-outer" ?: [99]) 1 ?: 99) == 1,
        (listGet (mapGet nested "healthy-inner-healthy" ?: [99]) 2 ?: 99) == 5,
        listLength (mapGet grown "forced" ?: [99]) == 2,
        (listGet (mapGet grown "forced" ?: [99]) 0 ?: 99) == 4,
        (listGet (mapGet grown "forced" ?: [99]) 1 ?: 99) == 4,
        !(mapContains nested "forced"),
        mapContains grown "forced",
        listLength (mapKeys grown) == 3,
        listLength (mapValues grown) == 3
    ]
test "typed error channels compose and restore shadowed handlers" typedErrorChannelCase
