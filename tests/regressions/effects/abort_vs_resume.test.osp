// Run one effectful pipeline under a handler that always resumes, then under a
// handler that aborts by returning without resume. [EFFECTS-RESUME]

effect Step {
    /// Run one pipeline stage over `value` under the active policy.
    run: fn(int) -> int
}

/// An aborted continuation omits observations after the poison step.
fn pipeline() -> int !Step = {
    let a = perform Step.run(1)
    print("pipeline saw step1 -> " + toString(a))
    let b = perform Step.run(2)
    print("pipeline saw step2 -> " + toString(b))
    let c = perform Step.run(3)
    print("pipeline saw step3 -> " + toString(c))
    a + b + c ?: 0
}

let sentinel = (0 - 99) ?: 0

// Every arm resumes; audit lines run as continuations unwind.
print("=== recovering handler: resume every step, drive to completion ===")
mut counter = 0
let recovered = handle Step
    run x => {
        let stepNo = counter + 1 ?: counter
        counter = stepNo
        let v = resume((x * 10) ?: 0)
        print("audit[recover]: step " + toString(stepNo) + " (input " + toString(x) + ") settled, downstream=" + toString(v))
        v
    }
in pipeline()
print("recovered result=" + toString(recovered))

// Returning at step 2 aborts the suspended computation.
print("=== stopping handler: step 2 stops the pipeline, then step 1 handler finishes ===")
mut counter2 = 0
let aborted = handle Step
    run x => {
        let stepNo = counter2 + 1 ?: counter2
        counter2 = stepNo
        match x == 2 {
            true => {
                // No resume: discard the rest of the pipeline.
                print("poison at step " + toString(stepNo) + " (input " + toString(x) + ") -> abort, discard the rest")
                sentinel
            }
            false => {
                let v = resume((x * 10) ?: 0)
                print("audit[abort-run]: step " + toString(stepNo) + " (input " + toString(x) + ") settled, downstream=" + toString(v))
                v
            }
        }
    }
in pipeline()
print("aborted result=" + toString(aborted))

// Verifies both continuation policies and their exact operation counts.
test("resuming completes while returning aborts the pipeline", fn() => checkAll("abort versus resume state", [
    recovered == 60,
    counter == 3,
    aborted == sentinel,
    counter2 == 2,
    recovered != aborted
]))
