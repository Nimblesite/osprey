(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()

(** One effectful order function runs under two recovery policies. Neither
    handler uses `resume`, so each arm value replaces the operation result and
    `fulfill` continues with the next order. [EFFECTS-HANDLER-STATE] *)
effect Recover
    (** Decide what an order for more than the balance receives. *)
    overdraw : (int, int) => int

drawOrder requested available = match requested > available
    true => perform Recover.overdraw requested available
    false => requested

fulfill orders stock = match orders
    [] => stock
    [requested, ...rest] =>
        drawn = drawOrder requested stock
        remaining = stock - drawn 
        print "  order ${requested}: from ${stock} in stock -> took ${drawn}, ${remaining} left"
        fulfill rest remaining

start = 20
batch = listAppend (listAppend (listAppend (listAppend (listAppend (List ()) 6) 30) 5) 8) 40

mut skipCount = 0
mut skipReason = ""
print "=== POLICY A: SKIP (substitute 0, preserve stock) ==="
skipFinal =
    exactArithmetic (\() =>
        handle Recover
            overdraw requested available =>
                skipCount := skipCount + 1 
                skipReason := skipReason + "skipped ${requested} (only ${available} left); "
                0
        fulfill batch start)
skipFilled = exactArithmetic (\() =>
    start - skipFinal)
print "SKIP done: recovered ${skipCount} orders, fulfilled ${skipFilled} units, ${skipFinal} left in stock\nSKIP log: [${skipReason}]"

mut capCount = 0
mut capReason = ""
print "=== POLICY B: CAP (substitute available, drain to fit) ==="
capFinal =
    exactArithmetic (\() =>
        handle Recover
            overdraw requested available =>
                capCount := capCount + 1 
                capReason := capReason + "capped ${requested} to ${available}; "
                available
        fulfill batch start)
capFilled = exactArithmetic (\() =>
    start - capFinal)
print "CAP done: recovered ${capCount} orders, fulfilled ${capFilled} units, ${capFinal} left in stock\nCAP log: [${capReason}]"

mut happyCount = 0
happyBatch = listAppend (listAppend (listAppend (listAppend (List ()) 3) 5) 2) 4
print "=== HAPPY PATH: SKIP handler, no over-draws ==="
happyFinal =
    exactArithmetic (\() =>
        handle Recover
            overdraw _requested _available =>
                happyCount := happyCount + 1 
                0
        fulfill happyBatch start)
happyFilled = exactArithmetic (\() =>
    start - happyFinal)
print "HAPPY done: recovered ${happyCount} orders, fulfilled ${happyFilled} units, ${happyFinal} left in stock\n=== all three batches completed ==="

// Verify skip, cap, and happy-path recovery policies independently.

test "recovery policies substitute values without stopping traversal" (\() => exactArithmetic ((\() => checkAll "recovery policy results" [
    skipCount == 2,
    skipFinal == 1,
    (skipFilled ) == 19,
    contains skipReason "skipped 30",
    capCount == 4,
    capFinal == 0,
    (capFilled ) == 20,
    contains capReason "capped 30 to 14",
    happyCount == 0,
    happyFinal == 6,
    (happyFilled ) == 14
])))
