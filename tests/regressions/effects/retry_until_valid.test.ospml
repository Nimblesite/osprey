// `readPositive` validates values supplied by Prompt. One handler keeps
// resuming with scripted values; another returns without resume to stop.

effect Prompt
    ask : string => int

// Each invalid value causes a fresh Prompt.ask operation.
readPositive : string -> int ! Prompt
readPositive label =
    value = perform Prompt.ask label
    match value > 0
        true => value
        false =>
            print "  business: rejected ${toString value} for ${label}, asking again"
            readPositive label

// Resume with -3, 0, then 7.
mut attempt = 0
accepted =
    handle Prompt
        ask label =>
            attempt := attempt + 1
            value = match attempt
                1 => 0 - 3
                2 => 0
                _ => 7
            print "attempt ${toString attempt}: handler feeds ${toString value}"
            resume value
    in readPositive "age"
print "SCENARIO 1 accepted=${toString accepted} after ${toString attempt} attempts"

// After three invalid values, return a sentinel without resuming.
mut tries = 0
outcome =
    handle Prompt
        ask label =>
            tries := tries + 1
            match tries > 3
                true =>
                    print "attempt ${toString tries}: handler GIVES UP, aborting with sentinel"
                    0 - 999
                false =>
                    value = 0 - tries
                    print "attempt ${toString tries}: handler feeds ${toString value}"
                    resume value
    in readPositive "quota"
verdict = match outcome > 0
    true => "valid ${toString outcome}"
    false => "gave up (sentinel ${toString outcome}) after ${toString (tries - 1)} bad answers"
print "SCENARIO 2 outcome: ${verdict}"

// Register the regression scenario with the assertion-driven test runner.
migratedLegacyCase () = checkAll "legacy execution" [true]
test "regression scenario completes" migratedLegacyCase
