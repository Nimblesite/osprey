/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

// Static effect rows are inferred through direct calls, call chains, callbacks,
// closures, partial handlers, partial runtime handlers nested inside a static
// interpretation, and generic effect instances. No function below
// needs a return-type or effect-row annotation.

effect Supply {
    /// Request a value where the performer calls the operation itself.
    direct: fn(int) -> int
    /// Request a value through an intermediate call, not directly.
    transitive: fn(int) -> int
    /// Request a value from inside a callback passed to another function.
    callback: fn() -> int
    /// Request a value from inside a closure invoked later.
    delayed: fn() -> int
}

fn direct(seed) = perform Supply.direct(seed)
fn source(seed) = perform Supply.transitive(seed)
fn relay(seed) = source(seed)
fn invoke(callback) = callback()

let directValue = {
    handle Supply {
        direct seed => seed
    }
    direct(7)
}

let transitiveValue = {
    handle Supply {
        transitive seed => seed
    }
    relay(11)
}

let callbackValue = {
    handle Supply {
        callback => 13
    }
    invoke(fn() => perform Supply.callback())
}

let delayed = fn() => perform Supply.delayed()
let delayedValue = {
    handle Supply {
        delayed => 17
    }
    delayed()
}

effect Pair {
    /// Read the first of the two supplied integers.
    first: fn() -> int
    /// Read the second of the two supplied integers.
    second: fn() -> int
}

fn pairTotal() = {
    let first = perform Pair.first()
    let second = perform Pair.second()
    first + second 
}

/// The inner partial handler discharges only `first`; `second` reaches the
/// complementary outer handler.
let partialValue = exactArithmetic(fn() => {
    handle Pair {
        second => 22
    }
    handle Pair {
        first => 20
    }
    pairTotal()
})

fn firstOnly() = {
    handle Pair {
        first => 2
    }
    pairTotal()
}

/// A partial runtime handler shadows only `first`; `second` still reaches the
/// enclosing static interpretation directly, through a helper called under the
/// runtime handler, and through a helper installing that handler itself.
let stagedValue = exactArithmetic(fn() => {
    handle static Pair {
        first => 1
        second => 40
    }
    let direct = {
        handle Pair {
            first => 2
        }
        (perform Pair.first() + perform Pair.second()) 
    }
    let helper = {
        handle Pair {
            first => 2
        }
        pairTotal()
    }
    let installer = firstOnly()
    "${direct}|${helper}|${installer}"
})

effect Stash<T> {
    /// Store `value` in the stash for a later `take`.
    put: fn(T) -> Unit
    /// Remove and return the stashed value of type `T`.
    take: fn() -> T
}

fn storeText() = perform Stash.put("fresh")

let genericValue = {
    handle Stash {
        put _value => print("")
        take => "cached"
    }
    storeText()
    19
}


test("inferred effect rows discharge only under matching handlers", fn() => exactArithmetic(fn() => checkAll("static discharge values", [
    directValue == 7,
    transitiveValue == 11,
    callbackValue == 13,
    delayedValue == 17,
    partialValue == 42,
    stagedValue == "42|42|42",
    genericValue == 19
])))
