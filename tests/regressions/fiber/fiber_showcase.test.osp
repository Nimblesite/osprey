/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

// Fiber + channel + yield + lambda coverage. [CONCURRENCY-SPAWN-AWAIT]
// [CONCURRENCY-CHANNEL] [CONCURRENCY-YIELD]
// Combines what fiber_concurrency_proof, fiber_isolation_test, fiber_test,
// fiber_final, fiber_advanced, simple_fiber were all proving piecemeal:
// — spawn/await produce real fiber IDs and out-of-order await works
// — yield returns the value passed back
// — Channel<T>+send/recv round-trip
// — fibers compose into a pipeline
// — lambdas work inside the program

fn simpleTask(value) = value * 100 
fn handleRequest(id) = id
fn queryDatabase(userId) = userId * 1000 

fn mapPhase(d) = d * d 
fn fetchUserData(id) = id * 1000 + 123 
fn fetchOrderData(id) = id * 100  + 45 

fn authService(uid) = match uid {
    0 => 401
    _ => 200
}
fn inventoryService(pid) = pid * 50 
fn paymentService(amt) = amt + 25 
fn streamProcessor(b) = b * 8 

fn stage1(x) = x + 100 
fn stage2(x) = x * 2 
fn stage3(x) = x - 50 
fn combine(a, b) = a * 100 + b 

/// A record argument crossing the fiber boundary. The spawned closure once
/// referenced the PARENT function's SSA values for any non-constant capture, so
/// `spawn runJob(job)` emitted `use of undefined value`; captures are now
/// spilled to per-spawn globals and reloaded inside the closure.
/// [CONCURRENCY-SPAWN-AWAIT] [TYPE-RECORD]
type Job = { id: int, weight: int }
fn runJob(j) = j.id * j.weight 

print("=== Fiber Showcase ===")

/// --- Out-of-order await proves fiber independence ---
let f1 = exactArithmetic(fn() => spawn simpleTask(1))
let f2 = exactArithmetic(fn() => spawn simpleTask(2))
let f3 = exactArithmetic(fn() => spawn simpleTask(3))
let f4 = exactArithmetic(fn() => spawn simpleTask(4))
print("ids ${f1} ${f2} ${f3} ${f4}")
print("await f3 = ${await(f3)}")
print("await f1 = ${await(f1)}")
print("await f4 = ${await(f4)}")
print("await f2 = ${await(f2)}")

/// --- Map-Reduce ---
let m1 = exactArithmetic(fn() => spawn mapPhase(10))
let m2 = exactArithmetic(fn() => spawn mapPhase(20))
let m3 = exactArithmetic(fn() => spawn mapPhase(30))
let mappedTotal = exactArithmetic(fn() => await(m1) + await(m2) + await(m3)) 
print("map-reduce total = ${mappedTotal}")

/// --- Microservices fan-out ---
let auth = spawn authService(123)
let inv  = exactArithmetic(fn() => spawn inventoryService(456))
let pay  = exactArithmetic(fn() => spawn paymentService(1000))
print("auth=${await(auth)} inv=${await(inv)} pay=${await(pay)}")

/// --- Pipeline (each stage = its own fiber) ---
let p = exactArithmetic(fn() => await(spawn stage3(await(spawn stage2(await(spawn stage1(25)))))))
print("pipeline = ${p}")

/// --- Yield ---
let y1 = yield 25
let y2 = yield 50
let y3 = yield 75
print("yield ${y1} ${y2} ${y3}")
let advYield = fiber_yield(200)
print("fiber_yield = ${advYield}")

/// --- Channel send/recv ---
let ch1 = Channel(1)
let ch2 = Channel(1)
send(ch1, 42)
print("recv ch1 = ${recv(ch1)}")
send(ch2, 123)
print("recv ch2 = ${recv(ch2)}")

/// --- Lambdas inline ---
let dbl   = fn(x) => x * 2 
let tri   = fn(x) => x * 3 
let addF  = fn(a, b) => a + b 
exactArithmetic(fn() => print("lam dbl=${dbl(10)} tri=${tri(7)} add=${addF(5, 8)}"))

/// --- Stream processing via yield ---
let b1 = exactArithmetic(fn() => yield streamProcessor(128))
let b2 = exactArithmetic(fn() => yield streamProcessor(256))
let b3 = exactArithmetic(fn() => yield streamProcessor(512))
print("stream ${b1} ${b2} ${b3}")

/// --- Simple request/db ---
let req = spawn handleRequest(1)
let db  = exactArithmetic(fn() => spawn queryDatabase(123))
print("req=${req} db=${await(db)}")

/// --- API parallel calls ---
let u = exactArithmetic(fn() => spawn fetchUserData(5))
let o = exactArithmetic(fn() => spawn fetchOrderData(5))
print("user=${await(u)} order=${await(o)}")

/// --- Captured-variable spawn + non-blocking completion probe ---
/// `capArg` is a local captured into the spawned closure through a NAMED
/// argument; fiberDone reports completion without blocking.
let capArg = 7
let capF = exactArithmetic(fn() => spawn combine(a: capArg, b: 5))
print("captured spawn = ${await(capF)} done=${fiberDone(capF)}")

/// --- Record captured into a spawned closure ---
let jobHigh = Job { id: 3, weight: 9 }
let jobWide = Job { id: 4, weight: 7 }
let spawnedJob = exactArithmetic(fn() => await(spawn runJob(jobWide)))
exactArithmetic(fn() => print("record spawn direct=${runJob(jobHigh)} spawned=${spawnedJob}"))

print("=== Fiber Showcase Complete ===")

/// A fiber whose result is an erased box. The spawn site's result-managed flag
/// is keyed on the STATIC type, and its hand-written "string or handle" test
/// answered `no` for a box, so the runtime never released the fiber's result.
/// This lives here rather than beside the other `any` ownership cases because a
/// spawn cannot link on wasm32, and hosting it there would cost that file its
/// wasm goldens. [GC-ARC-PERCEUS] [TYPE-ANY]
fn erasedFiberResult() -> any = "fib" + "er"

/// A still-generic lambda applied inside spawned bodies. A fiber's thunk is a
/// nested function, so it must capture what the lambda closed over where it
/// was defined; it used to fail with `unknown name`. Hosted here for the same
/// reason as the case above. [CONCURRENCY-SPAWN-AWAIT] [TYPE-GENERICS-FN]
fn spawnedGenericLambda() = {
    let prefix = "job-" + "7"
    let labelled = |x| => "${prefix}:${x}"
    "${await(spawn labelled(1))} ${await(spawn labelled("two"))}"
}

// Verifies each composed fiber/yield/lambda result instead of merely printing it.

test("fiber primitives compose into deterministic values", fn() => exactArithmetic(fn() => checkAll("fiber showcase results", [
    "${await(spawn erasedFiberResult())}" == "fiber",
    spawnedGenericLambda() == "job-7:1 job-7:two",
    mappedTotal == 1400,
    p == 200,
    y1 == 25,
    y2 == 50,
    y3 == 75,
    advYield == 200,
    dbl(10) == 20,
    tri(7) == 21,
    addF(5, 8) == 13,
    b1 == 1024,
    b2 == 2048,
    b3 == 4096,
    await(spawn fetchUserData(5)) == 5123,
    await(spawn fetchOrderData(5)) == 545,
    combine(capArg, 5) == 705,
    fiberDone(capF) == 1,
    runJob(jobHigh) == 27,
    runJob(jobWide) == 28,
    spawnedJob == 28,
    jobHigh.id == 3,
    jobHigh.weight == 9
])))
