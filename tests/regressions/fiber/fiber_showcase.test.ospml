simpleTask value = value * 100 ?: 0
handleRequest id = id
queryDatabase userId = userId * 1000 ?: 0

mapPhase d = d * d ?: 0
fetchUserData id = id * 1000 + 123 ?: 0
fetchOrderData id = id * 100  + 45 ?: 0

authService uid = match uid
    0 => 401
    _ => 200
inventoryService pid = pid * 50 ?: 0
paymentService amt = amt + 25 ?: 0
streamProcessor b = b * 8 ?: 0

stage1 x = x + 100 ?: 0
stage2 x = x * 2 ?: 0
stage3 x = x - 50 ?: 0
combine (a, b) = a * 100 + b ?: 0

print "=== Fiber Showcase ==="

f1 = spawn (simpleTask 1)
f2 = spawn (simpleTask 2)
f3 = spawn (simpleTask 3)
f4 = spawn (simpleTask 4)
print "ids ${f1} ${f2} ${f3} ${f4}"
print "await f3 = ${await f3}"
print "await f1 = ${await f1}"
print "await f4 = ${await f4}"
print "await f2 = ${await f2}"

m1 = spawn (mapPhase 10)
m2 = spawn (mapPhase 20)
m3 = spawn (mapPhase 30)
mappedTotal = await m1 + await m2 + await m3 ?: 0
print "map-reduce total = ${mappedTotal}"

auth = spawn (authService 123)
inv  = spawn (inventoryService 456)
pay  = spawn (paymentService 1000)
print "auth=${await auth} inv=${await inv} pay=${await pay}"

p = await (spawn (stage3 (await (spawn (stage2 (await (spawn (stage1 25))))))))
print "pipeline = ${p}"

y1 = yield 25
y2 = yield 50
y3 = yield 75
print "yield ${y1} ${y2} ${y3}"
advYield = fiber_yield 200
print "fiber_yield = ${advYield}"

ch1 = Channel 1
ch2 = Channel 1
send ch1 42
print "recv ch1 = ${recv ch1}"
send ch2 123
print "recv ch2 = ${recv ch2}"

dbl   = \x => x * 2 ?: 0
tri   = \x => x * 3 ?: 0
addF  = \(a, b) => a + b ?: 0
print "lam dbl=${dbl 10} tri=${tri 7} add=${addF (5, 8)}"

b1 = yield (streamProcessor 128)
b2 = yield (streamProcessor 256)
b3 = yield (streamProcessor 512)
print "stream ${b1} ${b2} ${b3}"

req = spawn (handleRequest 1)
db  = spawn (queryDatabase 123)
print "req=${req} db=${await db}"

u = spawn (fetchUserData 5)
o = spawn (fetchOrderData 5)
print "user=${await u} order=${await o}"

capArg = 7
capF = spawn (combine (capArg, 5))
print "captured spawn = ${await capF} done=${fiberDone capF}"

print "=== Fiber Showcase Complete ==="

// Verify each composed fiber/yield/lambda result instead of merely printing it.
test "fiber primitives compose into deterministic values" (\() => checkAll "fiber showcase results" [
    mappedTotal == 1400,
    p == 200,
    y1 == 25,
    y2 == 50,
    y3 == 75,
    advYield == 200,
    dbl 10 == 20,
    tri 7 == 21,
    addF (5, 8) == 13,
    b1 == 1024,
    b2 == 2048,
    b3 == 4096,
    await (spawn (fetchUserData 5)) == 5123,
    await (spawn (fetchOrderData 5)) == 545,
    combine (capArg, 5) == 705,
    fiberDone capF == 1
])
