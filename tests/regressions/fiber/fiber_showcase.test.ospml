(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()

simpleTask value = value * 100 
handleRequest id = id
queryDatabase userId = userId * 1000 

mapPhase d = d * d 
fetchUserData id = id * 1000 + 123 
fetchOrderData id = id * 100  + 45 

authService uid = match uid
    0 => 401
    _ => 200
inventoryService pid = pid * 50 
paymentService amt = amt + 25 
streamProcessor b = b * 8 

stage1 x = x + 100 
stage2 x = x * 2 
stage3 x = x - 50 
combine (a, b) = a * 100 + b 

(** A record argument crossing the fiber boundary. The spawned closure once
    referenced the PARENT function's SSA values for any non-constant capture, so
    `spawn (runJob job)` emitted `use of undefined value`; captures are now
    spilled to per-spawn globals and reloaded inside the closure.
    [CONCURRENCY-SPAWN-AWAIT] [TYPE-RECORD] *)
type Job =
    id : int
    weight : int

runJob j = j.id * j.weight 

print "=== Fiber Showcase ==="

f1 = exactArithmetic (\() =>
    spawn (simpleTask 1))
f2 = exactArithmetic (\() =>
    spawn (simpleTask 2))
f3 = exactArithmetic (\() =>
    spawn (simpleTask 3))
f4 = exactArithmetic (\() =>
    spawn (simpleTask 4))
print "ids ${f1} ${f2} ${f3} ${f4}"
print "await f3 = ${await f3}"
print "await f1 = ${await f1}"
print "await f4 = ${await f4}"
print "await f2 = ${await f2}"

m1 = exactArithmetic (\() =>
    spawn (mapPhase 10))
m2 = exactArithmetic (\() =>
    spawn (mapPhase 20))
m3 = exactArithmetic (\() =>
    spawn (mapPhase 30))
mappedTotal = exactArithmetic (\() =>
    await m1 + await m2 + await m3) 
print "map-reduce total = ${mappedTotal}"

auth = spawn (authService 123)
inv  = exactArithmetic (\() =>
    spawn (inventoryService 456))
pay  = exactArithmetic (\() =>
    spawn (paymentService 1000))
print "auth=${await auth} inv=${await inv} pay=${await pay}"

p = exactArithmetic (\() =>
    await (spawn (stage3 (await (spawn (stage2 (await (spawn (stage1 25)))))))))
print "pipeline = ${p}"

y1 = yield 25
y2 = yield 50
y3 = yield 75
print "yield ${y1} ${y2} ${y3}"
advYield = fiber_yield 200
print "fiber_yield = ${advYield}"

ch1 = Channel 1
ch2 = Channel 1
send ch1 42
print "recv ch1 = ${recv ch1}"
send ch2 123
print "recv ch2 = ${recv ch2}"

dbl   = \x => x * 2 
tri   = \x => x * 3 
addF  = \(a, b) => a + b 
exactArithmetic (\() =>
    print "lam dbl=${dbl 10} tri=${tri 7} add=${addF (5, 8)}")

b1 = exactArithmetic (\() =>
    yield (streamProcessor 128))
b2 = exactArithmetic (\() =>
    yield (streamProcessor 256))
b3 = exactArithmetic (\() =>
    yield (streamProcessor 512))
print "stream ${b1} ${b2} ${b3}"

req = spawn (handleRequest 1)
db  = exactArithmetic (\() =>
    spawn (queryDatabase 123))
print "req=${req} db=${await db}"

u = exactArithmetic (\() =>
    spawn (fetchUserData 5))
o = exactArithmetic (\() =>
    spawn (fetchOrderData 5))
print "user=${await u} order=${await o}"

capArg = 7
capF = exactArithmetic (\() =>
    spawn (combine (capArg, 5)))
print "captured spawn = ${await capF} done=${fiberDone capF}"

jobHigh = Job(id = 3, weight = 9)
jobWide = Job(id = 4, weight = 7)
spawnedJob = exactArithmetic (\() =>
    await (spawn (runJob jobWide)))
exactArithmetic (\() =>
    print "record spawn direct=${runJob jobHigh} spawned=${spawnedJob}")

print "=== Fiber Showcase Complete ==="

// Verify each composed fiber/yield/lambda result instead of merely printing it.
(** A fiber whose result is an erased box. The spawn site's result-managed flag
    is keyed on the STATIC type, and its hand-written "string or handle" test
    answered `no` for a box, so the runtime never released the fiber's result.
    This lives here rather than beside the other `any` ownership cases because a
    spawn cannot link on wasm32, and hosting it there would cost that file its
    wasm goldens. [GC-ARC-PERCEUS] [TYPE-ANY] *)
erasedFiberResult : Unit -> any
erasedFiberResult () = "fib" + "er"


test "fiber primitives compose into deterministic values" (\() => exactArithmetic ((\() => checkAll "fiber showcase results" [
    "${await (spawn (erasedFiberResult ()))}" == "fiber",
    mappedTotal == 1400,
    p == 200,
    y1 == 25,
    y2 == 50,
    y3 == 75,
    advYield == 200,
    dbl 10 == 20,
    tri 7 == 21,
    addF (5, 8) == 13,
    b1 == 1024,
    b2 == 2048,
    b3 == 4096,
    await (spawn (fetchUserData 5)) == 5123,
    await (spawn (fetchOrderData 5)) == 545,
    combine (capArg, 5) == 705,
    fiberDone capF == 1,
    runJob jobHigh == 27,
    runJob jobWide == 28,
    spawnedJob == 28,
    jobHigh.id == 3,
    jobHigh.weight == 9
])))
