/// Deliberately planted application invariants and unsafe C calls [SYMEX-CRASH-GATE].
extern fn abort() -> int
extern fn free(value: string) -> Unit
extern fn malloc(bytes: int) -> string
type Command = Delete | Read
type Bounds = { start: int, end: int }
fn descend(n) = if n == 0 { abort() } else { descend(checkedSub(n, 1) ?: 0) }
fn invalidFree() = {
    free("not-heap-allocated")
    0
}
fn released(value) = {
    free(value)
    value
}
let line = input()
let result = match line {
    "P" => match parseInt("not-a-number") { Success { value } => value  Error => abort() }
    "A" => match checkedAdd(9223372036854775807, 1) { Success { value } => value  Error => abort() }
    "L" => match listGet([10], 3) { Success { value } => value  Error => abort() }
    "K" => match mapGet(mapSet(Map(), "known", 7), "missing") { Success { value } => value  Error => abort() }
    "C" => {
        let callback = |value| => if value == line { abort() } else { 0 }
        callback("C")
    }
    "R" => descend(3)
    "U" => match Delete { Delete => abort()  Read => 0 }
    "B" => {
        let bounds = Bounds { start: 5, end: 2 }
        if bounds.end < bounds.start { abort() } else { 0 }
    }
    "J" => match jsonParse("{") { Success { value } => jsonFree(value) ?: 0  Error => abort() }
    "F" => if (readFile("hunt-payload.txt") ?: "") == "!" { abort() } else { 0 }
    "G" => invalidFree()
    "D" => {
        free(released(malloc(8)))
        0
    }
    _ => 0
}
print("result ${result}")
