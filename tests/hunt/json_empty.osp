/// Parsing an empty object and an empty array must be clean: closing an empty
/// container copies zero children, and must not form a pointer from null.
fn parses(text) = match jsonParse(text) {
    Success { value } => (jsonFree(value) ?: -1) == 0
    Error => false
}
let object = parses("{}")
let array = parses("[]")
let nested = parses("[[],{},[{}]]")
print("${object} ${array} ${nested}")
