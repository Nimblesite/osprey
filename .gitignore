# Coverage and test reports
coverage/
!src/toolchain/crates/osprey-codegen/src/coverage/
lcov.info
coverage-summary.json
TestResults/
test-results/

# Secrets / local overrides
# `!*.pub.key` must stay immediately after `*.key` — gitignore is last-match-wins.
.env
*.local
*.secret
*.pem
*.key
!*.pub.key

# Temporary
tmp/
*.log
# Logs are embargoed from the root; `make lint` fails on one, so keep it visible.
!/*.log

# Build output
target/
node_modules/
dist/
out/
.build/
src/osprey/examples/*/build/
# Build output the pre-src/ layout left at the root of existing checkouts:
# the nested ignore files that covered it moved into src/ with the sources.
/compiler/
/examples/
/hosts/
/packages/
/vscode-extension/
*.wasm
*.exe
*.dll
*.so
*.dylib

# Tool caches
.ruff_cache/
__pycache__/
.osprey/
.osprey-debug
