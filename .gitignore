# Terraform state and inputs hold secrets
src/osprey/packages/manager/ops/terraform/.terraform/
src/osprey/packages/manager/ops/terraform/*.tfstate
src/osprey/packages/manager/ops/terraform/*.tfstate.*
src/osprey/packages/manager/ops/terraform/*.tfplan
