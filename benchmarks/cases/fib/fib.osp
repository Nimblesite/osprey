// Naive recursive Fibonacci — exercises raw function-call + recursion overhead.
fn add(a, b) = a + b
fn sub(a, b) = a - b

fn fib(n) = match n {
    0 => 0
    1 => 1
    _ => add(fib(sub(n, 1)), fib(sub(n, 2)))
}

fn main() = {
    handle Arith { overflow _ _ _ wrapped => {
            print("unexpected integer overflow")
            wrapped
        } }
    print("${fib(35)}")
}
