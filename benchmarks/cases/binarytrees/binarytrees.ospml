// ML-flavor twin of binarytrees.osp — allocate + traverse many short-lived
// binary trees (allocation/memory stress). The inline union, equational
// clauses, grouped patterns and checked `+ -` all lower to the same canonical
// AST as the Default flavor's braces ([FLAVOR-IR-EQUIV]). Integer `+` and `-`
// are `Result` operations ([ARITH-CHECKED]), so each one is discharged with
// `?:` exactly where the Default twin discharges it.

type Tree = Leaf | Node Tree Tree

make 0 = Node Leaf Leaf
make d = Node (make ((d - 1) ?: 0)) (make ((d - 1) ?: 0))

check Leaf = 0
check (Node l r) = 1 + check l + check r ?: 0

print "${range 0 1200 |> fold 0 (\(acc, _) => acc + check (make 13) ?: 0)}"
