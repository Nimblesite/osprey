// Count coprime pairs (i,j), 1<=i,j<=N — nested iteration + Euclidean gcd.
fn add(a, b) = a + b
fn sub(a, b) = a - b
fn mod_(a, b) = a % b
fn gcd(a, b) = match b { 0 => a  _ => gcd(b, mod_(a, b)) }
fn loopJ(i, j, acc) = match j {
    0 => acc
    _ => match gcd(i, j) { 1 => loopJ(i, sub(j, 1), add(acc, 1))  _ => loopJ(i, sub(j, 1), acc) }
}
fn loopI(i, n, acc) = match i {
    0 => acc
    _ => loopI(sub(i, 1), n, loopJ(i, n, acc))
}
fn main() = {
    handle Arith {
        overflow _ _ _ wrapped => {
            print("unexpected integer overflow")
            wrapped
        }
        remainderByZero _ => {
            print("unexpected zero divisor")
            0
        }
    }
    print("${loopI(2000, 2000, 0)}")
}
