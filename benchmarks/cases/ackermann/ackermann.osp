// Ackermann–Péter function — deep, non-tail mutual self-recursion.
fn add(a, b) = a + b
fn sub(a, b) = a - b

fn ack(m, n) = match m {
    0 => add(n, 1)
    _ => match n {
        0 => ack(sub(m, 1), 1)
        _ => ack(sub(m, 1), ack(m, sub(n, 1)))
    }
}

fn main() = {
    handle Arith { overflow _ _ _ wrapped => {
            print("unexpected integer overflow")
            wrapped
        } }
    print("${ack(3, 10)}")
}
