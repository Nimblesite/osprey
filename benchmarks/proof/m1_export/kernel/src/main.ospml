namespace proof

import proof::Environment
import proof::Checked

// M1 of plan 0041 ([PROOF-SPEED]): both kernels re-check the same recorded
// export on the same machine in the same run. This program is the Osprey
// side: it reads id_imp.ndjson — the lean4export NDJSON 3.1.0 text that
// scripts/proof-export.sh records from tools/IdImp.lean — and puts every
// declaration through the kernel exactly as `exported` in
// examples/proof/kernel/src/main.ospml does. The Lean side is lean.cmd:
// lean4checker replays every declaration of the same module through Lean's
// kernel.

report (outcome) = match outcome
    Success env => print "checked: id_imp (export)"
    Error message => print "rejected: id_imp (export): ${message}"

main () = match readFile "id_imp.ndjson"
    Success text => report (Checked::exported (Environment::empty (), text))
    Error message => print "rejected: id_imp (export): ${message}"
