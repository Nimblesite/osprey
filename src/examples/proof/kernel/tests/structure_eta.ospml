namespace prooftests
import proof::Terms
import proof::Environment
import proof::Checked
import proof::Inductive
import proof::Infer
import proof::Reduce
import proof::Fixtures
import prooftests::Support
import proof
    Proj
    BVar
    Const
    App
    Lam
    Pi
    Sort
    Succ
    Zero
    Max
    Param
    Decl
    Axiom
    Definition
    Opaque
    Binder
(** Structure eta of [PROOF-KERNEL-THEORY]: one side a saturated constructor
    application of a one-constructor, zero-index, non-recursive family, the
    other side any term of the same type; they are definitionally equal when
    every field argument equals the corresponding projection of the other
    term. This is Lean 4.25.0's `try_eta_struct` (src/kernel/type_checker.cpp
    line 784, tag v4.25.0): the constructor must be saturated, the family
    must be `is_structure_like`, the two sides' types must themselves be
    definitionally equal, and then each field is compared with a kernel
    projection of the other side. Proof irrelevance answers first for
    propositions, so a Prop family never needs eta, and a rejected projection
    (forbidden Prop data) refuses eta instead of leaking. The positives run
    against a real Lean export: the recorded `StructureEta` module below, the
    Lean-defined product fixture with `prod_eta` and `prod_map_id`, both proved by `rfl`
    in Lean 4.25.0 and both rejected by this kernel until structure eta
    lands. Every control that must stay false stays false. *)
module StructureEtaTests
    (** Runs the structure-eta cases; the testing built-ins report TAP. *)
    export run () =
        recorded ()
        eta ()
        mapId ()
        dependent ()
        boundaries ()
        propositions ()
        core ()

    (** Core Prod.map pattern-matches through a recursor, unlike the
        projection-only fixture. Implements [PROOF-KERNEL-THEORY]. *)
    export core () =
        test ("core Prod.map_id rfl proof checks", \() =>
            expect (verdict (Fixtures::coreProdMap (), "Prod.map_id"), "declared"))
        test ("core Prod.map_id' rfl proof checks", \() =>
            expect (verdict (Fixtures::coreProdMap (), "Prod.map_id'"), "declared"))
        test ("core product composition proofs check with the full dependency export", \() =>
            expect (verdict (Fixtures::coreProdAll (), "Prod.map_comp_map"), "declared"))
        coreComparison (coreEnvironment ())
        propositionMajor (unitEnvironment ())

    coreComparison (env) =
        test ("core recursor map identity equals the identity function", \() =>
            expect (conversionIn (env, coreContext (), coreMap (coreId (BVar 1, "v")), coreIdentity ()), true))
        test ("core recursor map identity applied to a variable computes", \() =>
            expect (conversionIn (env, coreContext (), App (coreMap (coreId (BVar 1, "v"))) (BVar 0), BVar 0), true))
        test ("core recursor map with a distinct field function refuses identity", \() =>
            expect (conversionIn (coreDifferent env, coreContext (), coreMap (App (Const "k" [Param "v"]) (BVar 1)), coreIdentity ()), false))

    coreEnvironment () = match split (Fixtures::coreProdMap (), "\n")
        Success lines => declared (Checked::exportedDeclaring (Environment::empty (), join (filterList (lines, \line => !startsWith (line, "{\"thm\":")), "\n"), "Prod.map"), "the actual core definitions check")
        Error message => declared (Error(message = message), "the actual core export splits")

    coreContext () = [Binder(name = "p", ty = Terms::apps (Const "Prod" [Param "u", Param "v"], [BVar 1, BVar 0])), Binder(name = "β", ty = Sort (Succ (Param "v"))), Binder(name = "α", ty = Sort (Succ (Param "u")))]
    corePair () = Terms::apps (Const "Prod" [Param "u", Param "v"], [BVar 2, BVar 1])
    coreId (domain, level) = App (Const "id" [Succ (Param level)]) domain
    coreMap (second) = Terms::apps (Const "Prod.map" [Param "u", Param "u", Param "v", Param "v"], [BVar 2, BVar 2, BVar 1, BVar 1, coreId (BVar 2, "u"), second])
    coreIdentity () = App (Const "id" [Max (Succ (Param "u")) (Succ (Param "v"))]) (corePair ())
    coreDifferent (env) = declared (Checked::declare (env, Decl(name = "k", params = ["v"], ty = Pi "β" (Sort (Succ (Param "v"))) (Pi "x" (BVar 0) (BVar 1)), body = Axiom)), "the distinct field function checks")

    propositionMajor (env) =
        test ("a Prop structure recursor application remains well typed", \() =>
            expect (checkedIn (env, unitContext (), unitApplication (), Const "EtaData" []), "ok: EtaData"))
        test ("a Prop structure major is not eta-expanded for data computation", \() =>
            expect (conversionIn (env, unitContext (), unitApplication (), Const "etaValue" []), false))

    unitContext () = [Binder(name = "p", ty = Const "PUnit" [Zero])]
    unitApplication () = Terms::apps (Const "PUnit.rec" [Succ Zero, Zero], [Lam "p" (Const "PUnit" [Zero]) (Const "EtaData" []), Const "etaValue" [], BVar 0])
    unitEnvironment () = unitValue (declared (Checked::declare (declared (Checked::exported (Environment::empty (), Fixtures::punitRec ()), "the PUnit export checks"), Decl(name = "EtaData", params = [], ty = Sort (Succ Zero), body = Axiom)), "the result type checks"))
    unitValue (env) = declared (Checked::declare (env, Decl(name = "etaValue", params = [], ty = Const "EtaData" [], body = Axiom)), "the result value checks")
    // The recorded export, its two rfl theorems, and theorem-free twins --
    (** The recorded `StructureEta` module exactly as the pinned lean4export
        (tag v4.25.0) wrote it: NDJSON format 3.1.0, 285 lines, 15575 bytes,
        sha256 `2ba806e8da4160959f98f1338355b0d66e97dde7657c88c45eabab181a320605`,
        accepted by the pinned lean4checker. The Lean-defined product fixture
        (`Init/Prelude.lean:546`: one constructor `Prod.mk` of two fields, no
        indices, not recursive) beside core's `Eq`, `id` and `Prod.map`
        (`Init/Core.lean:214`), plus `prod_eta` and `prod_map_id`, whose
        `Eq.refl` proofs the Lean kernel accepts only through
        `try_eta_struct`. *)
    fixture () = "{\"meta\":{\"exporter\":{\"name\":\"lean4export\",\"version\":\"3.1.0\"},\"format\":{\"version\":\"3.1.0\"},\"lean\":{\"githash\":\"cdd38ac5115bdeec5f609e9126cce00f51ae88b3\",\"version\":\"4.25.0\"}}}\n{\"in\":1,\"str\":{\"pre\":0,\"str\":\"Eq\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"u\"}}\n{\"il\":1,\"param\":2}\n{\"in\":3,\"str\":{\"pre\":0,\"str\":\"α\"}}\n{\"ie\":0,\"sort\":1}\n{\"in\":4,\"str\":{\"pre\":0,\"str\":\"a\"}}\n{\"in\":5,\"str\":{\"pre\":4,\"str\":\"_@\"}}\n{\"in\":6,\"str\":{\"pre\":5,\"str\":\"_internal\"}}\n{\"in\":7,\"str\":{\"pre\":6,\"str\":\"_hyg\"}}\n{\"in\":8,\"num\":{\"i\":0,\"pre\":7}}\n{\"bvar\":0,\"ie\":1}\n{\"bvar\":1,\"ie\":2}\n{\"ie\":3,\"sort\":0}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":8,\"type\":2},\"ie\":4}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":4,\"name\":8,\"type\":1},\"ie\":5}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":5,\"name\":3,\"type\":0},\"ie\":6}\n{\"in\":9,\"str\":{\"pre\":1,\"str\":\"refl\"}}\n{\"const\":{\"name\":1,\"us\":[1]},\"ie\":7}\n{\"app\":{\"arg\":2,\"fn\":7},\"ie\":8}\n{\"app\":{\"arg\":1,\"fn\":8},\"ie\":9}\n{\"app\":{\"arg\":1,\"fn\":9},\"ie\":10}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":10,\"name\":4,\"type\":1},\"ie\":11}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":11,\"name\":3,\"type\":0},\"ie\":12}\n{\"in\":10,\"str\":{\"pre\":1,\"str\":\"rec\"}}\n{\"in\":11,\"str\":{\"pre\":0,\"str\":\"u_1\"}}\n{\"il\":2,\"param\":11}\n{\"in\":12,\"str\":{\"pre\":0,\"str\":\"motive\"}}\n{\"in\":13,\"str\":{\"pre\":0,\"str\":\"t\"}}\n{\"bvar\":2,\"ie\":13}\n{\"app\":{\"arg\":13,\"fn\":7},\"ie\":14}\n{\"app\":{\"arg\":2,\"fn\":14},\"ie\":15}\n{\"app\":{\"arg\":1,\"fn\":15},\"ie\":16}\n{\"ie\":17,\"sort\":2}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":17,\"name\":13,\"type\":16},\"ie\":18}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":18,\"name\":8,\"type\":2},\"ie\":19}\n{\"in\":14,\"str\":{\"pre\":0,\"str\":\"refl\"}}\n{\"app\