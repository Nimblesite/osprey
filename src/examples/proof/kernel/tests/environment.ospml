namespace prooftests

import proof::Environment
import proof
    Zero
    Succ
    Sort
    Axiom
    Definition
    Theorem
import prooftests::Support

(** Declaration order, duplicate rejection and opaque bodies. *)
module EnvironmentTests
    closed () = Sort (Succ Zero)

    export run () =
        test ("a name cannot be declared twice", \() =>
            expect (Support::messageOf (Support::twice "c"), "constant `c` is already declared"))

        test ("unfold refuses a theorem", \() =>
            expect (Support::unfolded (Support::envWith (Theorem (closed ())), "c"), "error: theorems are opaque"))

        test ("unfold returns a definition and refuses an axiom", \() =>
            expect (Support::unfolded (Support::envWith (Definition (closed ())), "c"), "Type")
            expect (Support::unfolded (Support::envWith Axiom, "c"), "error: axioms do not unfold"))

        test ("find locates a declared constant and nothing else", \() =>
            expect (Support::declares (Support::envWith Axiom, "c"), true)
            expect (Support::declares (Environment::empty (), "c"), false))
