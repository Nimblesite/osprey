// [GPU-KERNEL-PURE], [STAGE-BACKEND]: a static arm may forward the model's
// callback into the kernel it builds, so the callback is judged where it lands.
// One that performs a DYNAMIC effect is rejected by the row the kernel would
// need, exactly as an inline kernel is — the handler around the region makes
// `Log` dischargeable on the host, but a kernel body cannot leave the device.
static effect Build {
    build: fn(int, fn(int) -> float) -> GpuBuffer<float>
}
effect Log {
    write: fn(string) -> Unit
}

fn loud(i) = {
    perform Log.write("saw ${i}")
    toFloat(i)
}

fn twice(n) = perform Build.build(n, loud)

let out = {
    handle Log {
        write m => print(m)
    }
    handle static Build {
        build n f => gpuIota(n) |> gpuMap(f)
    }
    twice(3)
}
print("${gpuGet(out, 2) ?: 0.0}")
