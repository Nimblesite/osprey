// Field-call syntax resolves `a.add(10)` to the record's callable field.
// The initializer must still match that field's declared return type:
// checked addition returns Result<int, Error>, not int.
type Adder = {
    add: (int) -> int
}

fn main() -> Unit = {
    let a = Adder { add: fn(x: int) => checkedAdd(x, 5) }
    print(toString(a.add(10)))
}
