// osprey: flavor=ml
// [EFFECTS-PROVENANCE] ML twin of provenance_union_closure_unhandled_shallow:
// the stored closure is collected through `fold`, projected out with
// `listGet`, and invoked at program entry with no handler, so its operation
// must surface as unhandled (#275).
effect Log
    write : string => string

type Node A =
    Stack
        children : List<Node<A>>
    Field
        value : string
        edit : string -> A

type Binding A =
    Edit
        apply : string -> A

collect<A> : (List<Binding<A>>, Node<A>) -> List<Binding<A>>
collect (found, node) = match node
    Stack children => range (0, length children) |> fold found (\(acc, index) => collectAt (acc, children, index))
    Field _ edit => listAppend found (Edit(apply = edit))

collectAt<A> : (List<Binding<A>>, List<Node<A>>, int) -> List<Binding<A>>
collectAt (found, children, index) = match listGet children index
    Success child => collect (found, child)
    Error _ => found

screen query = Stack(children = [Field(value = query, edit = \text => perform Log.write text)])

dispatch text = match listGet (collect ([], screen "")) 0
    Success binding => match binding
        Edit apply => apply text
    Error _ => "rejected"

main () = print (dispatch "codesign")
