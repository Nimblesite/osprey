// osprey: flavor=ml
// [GPU-KERNEL-ELEM-TYPING]: one definition gets one overload in this flavor too.
plus (a, b) = a + b

main () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
    ints = toGpu [1, 2, 3] |> gpuFold 0 plus
    floats = toGpu [1.5, 2.5] |> gpuFold 0.0 plus
    print "${ints} ${floats}"
