// [GPU-KERNEL-ELEM-TYPING]: a named context-free helper leaves its arithmetic
// overload open and settles it ONCE after unification. It does not generalize
// over a numeric class, so one definition used at both int and float is a
// type error rather than a silent reinterpretation.
fn plus(a, b) = a + b

fn main() = {
    handle Arith { overflow _ _ _ wrapped => wrapped }
    let ints = toGpu([1, 2, 3]) |> gpuFold(0, plus)
    let floats = toGpu([1.5, 2.5]) |> gpuFold(0.0, plus)
    print("${ints} ${floats}")
}
