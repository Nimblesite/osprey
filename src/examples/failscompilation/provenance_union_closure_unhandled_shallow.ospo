// [EFFECTS-PROVENANCE] A closure stored in a recursive union keeps its effect
// provenance through `fold` and `listGet`: invoked at program entry with no
// handler, its operation surfaces as unhandled instead of the recursion's
// fixed point widening it away as pure (#275). The fail-closed twin of
// tests/effects/provenance/recursive_union_callable.
effect Log { write: fn(string) -> string }

type Node<A> = Stack { children: List<Node<A>> } | Field { value: string, edit: (string) -> A }
type Binding<A> = Edit { apply: (string) -> A }

fn collect<A>(found, node) = match node {
    Stack { children } => range(0, length(children)) |> fold(found, fn(acc, index) => match listGet(children, index) {
        Success { value } => collect(acc, value)
        Error(_) => acc
    })
    Field { edit } => listAppend(found, Edit { apply: edit })
}

fn screen(query) = Stack { children: [Field { value: query, edit: fn(text) => perform Log.write(text) }] }

fn dispatch(text) = match listGet(collect([], screen("")), 0) {
    Success { value } => match value { Edit { apply } => apply(text) }
    Error(_) => "rejected"
}

fn main() = print(dispatch("codesign"))
