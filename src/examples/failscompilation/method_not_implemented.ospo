// This should fail compilation: UFCS call to an undeclared function.
// `_.unknownMethod(...)` rewrites to `unknownMethod(_, ...)`, which must resolve.
// Implements [BUILTIN-STRING-UFCS]

type Person = { name: String, age: Int }

let person = Person { name: "Alice", age: 30 }
let result = person.unknownMethod()  // Method call not implemented
print(result)