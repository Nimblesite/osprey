// Each track call owns a request counter, accessed through MetricsFx arms.
// [MODULES-STATE-MODULE] [MODULES-STATE-SOURCE-OF-TRUTH]

namespace bank

signature MetricsApi
    effect MetricsFx
        (** Count one hit for `key` and return the running total. *)
        hit : string => int
        (** Read the total number of hits recorded so far. *)
        total : Unit => int
    track : (Unit -> int) -> int

state Metrics : MetricsApi
    mut served = 0

    effect MetricsFx
        (** Count one hit for `key` and return the running total. *)
        hit : string => int
        (** Read the total number of hits recorded so far. *)
        total : Unit => int

    // The handler installer: wraps a request-serving body in the one region
    // allowed to read and write `served`. The tally saturates with the total
    // `satAdd`: a counter at the int ceiling stays there instead of wrapping.
    track body =
        handle MetricsFx
            hit _path =>
                served := satAdd served 1
                served
            total => served
        body ()
