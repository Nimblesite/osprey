(** Subtract two integers through a curried call. *)
sub : int -> int -> int
sub a b = a - b 
(** Classify exact integers before the wildcard case. *)
classify 0 = "zero"
classify 1 = "one"
classify _ = "many"

(** Exercise arithmetic values and relational properties. *)
arithmeticCase () =
    // Check results and ordering independently.
    checkAll "arithmetic foundations" [
        sub 7 3 == 4,
        (6 * 7 ) == 42,
        sub 20 (2 * 4 ) == 12,
        sub 8 3 > 4,
        sub 100 1 > 0,
        sub 9 4 != sub 4 9
    ]

(** Exercise every classification clause with literal and computed inputs. *)
classifyCase () =
    // Check exact clauses, the wildcard, and a string consumer.
    checkAll "classification foundations" [
        classify 0 == "zero",
        classify 1 == "one",
        classify 9 == "many",
        classify (sub 4 3) == "one",
        startsWith (classify 20) "m",
        classify 99 != classify 0
    ]

(** Exercise strings, fallible operations, and list state together. *)
stringsAndListsCase () =
    // Check the combined standard-library behavior.
    checkAll "string and list foundations" [
        contains "talon bank" "bank",
        (repeat "ab" 3 ?: "") == "ababab",
        trim "  Osprey  " == "Osprey",
        toUpperCase "Osprey" == "OSPREY",
        startsWith "osprey language" "osprey",
        !(endsWith "osprey language" "compiler"),
        listLength [10, 20, 30] == 3
    ]

(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()


test "arithmetic checks share derived values" (\() => exactArithmetic (arithmeticCase))
test "classification checks include computed inputs" (\() => exactArithmetic (classifyCase))
test "strings and lists mix with matching" (\() => exactArithmetic (stringsAndListsCase))

(** Assertions are valid outside any case; a passing one prints nothing. *)
checkTrue "assertions run outside a test case" (startsWith "osprey" "osp")

(** Assertion operands compare by canonical rendering: values of different
    types that render alike are equal, a Success renders as its bare payload
    and an Error as `Error(<message>)`. [TESTING-EQUALITY]
    [TESTING-BUILTIN-EXPECT] [TESTING-BUILTIN-CHECK] *)
equalityCase () =
    expect 5 "5"
    expect "5" 5
    expect true "true"
    expect false "false"
    expect 1.5 "1.5"
    expect (satSub 0 7) "-7"
    expect (checkedAdd 2 3) 5
    expect (checkedAdd 2 3) "5"
    check "Success renders its bare payload" 42 (checkedMul 6 7)
    check "Error renders its message" "Error(integer overflow)" (checkedMul 4294967296 4294967296)
    check "subtraction overflow is an Error too" "Error(integer overflow)" (checkedSub (-9223372036854775808) 1)
    check "an interpolated Success keeps its constructor" "Success(5)" "${checkedAdd 2 3}"
    check "strings compare by content" "osprey" (toLowerCase "OSPREY")
    check "a float renders like its literal" "0.25" (toString 0.25)
    expectTrue (contains "talon" "al")
    expectFalse (contains "talon" "z")
    checkTrue "a computed true" (startsWith "osprey" "osp")
    checkFalse "a computed false" (endsWith "osprey" "osp")
    expectAll [listLength [1, 2] == 2, isEmpty "", !(isEmpty "a")]

(** A test call runs wherever it is evaluated, so a helper may declare cases. *)
declareFrom label = test "${label} case declared from a helper" (\() => checkAll "${label} helper case" [label != "", length label > 0])

test "assertions compare canonical renderings" equalityCase
declareFrom "first"
declareFrom "second"
