/// Subtracts integers through curried application.
fn sub(a: int) -> (int) -> int = fn(b) => a - b 
/// Classifies exact integer cases and a wildcard branch.
fn classify(n) = match n {
    0 => "zero"
    1 => "one"
    _ => "many"
}

/// tens is the three-element int list the length, index and readAt cases share.
let tens = [10, 20, 30]

/// Verifies arithmetic values and relational properties in one documented batch.
fn arithmeticCase() = {
    // Six independent soft assertions cover results and algebraic behavior.
    checkAll("arithmetic foundations", [
            sub(7)(3) == 4,
            (6 * 7 ) == 42,
            sub(20)(2 * 4 ) == 12,
            sub(8)(3) > 4,
            sub(100)(1) > 0,
            sub(9)(4) != sub(4)(9)
    ])
}

/// Verifies every match branch using literal and computed inputs.
fn classifyCase() = {
    // The conditions cover exact arms, wildcard behavior, and string consumers.
    checkAll("classification foundations", [
            classify(0) == "zero",
            classify(1) == "one",
            classify(9) == "many",
            classify(sub(4)(3)) == "one",
            startsWith(classify(20), "m"),
            classify(99) != classify(0)
    ])
}

/// Verifies strings, fallible operations, and list state in one interaction.
fn stringsAndListsCase() = {
    // Seven separately reported conditions document the combined standard-library behavior.
    checkAll("string and list foundations", [
            contains("talon bank", "bank"),
            (repeat("ab", 3) ?: "") == "ababab",
            trim("  Osprey  ") == "Osprey",
            toUpperCase("Osprey") == "OSPREY",
            startsWith("osprey language", "osprey"),
            !endsWith("osprey language", "compiler"),
            listLength(tens) == 3
    ])
}

// Register the arithmetic foundation interaction.
exactTests([
    { name: "arithmetic checks share derived values", work: arithmeticCase },
    // Register the classification interaction.
    { name: "classification checks include computed inputs", work: classifyCase },
    // Register the standard-library composition interaction.
    { name: "strings and lists mix with matching", work: stringsAndListsCase }
])

/// Assertions are valid outside any case; a passing one prints nothing.
checkTrue("assertions run outside a test case", startsWith("osprey", "osp"))

/// The two operands of an assertion have one inferred type; a bare value
/// stands for the `Success` of a Result operand, and a failure is asserted at
/// its own `E` with `expectError`. [TESTING-EQUALITY]
/// [TESTING-BUILTIN-EXPECT] [TESTING-BUILTIN-CHECK] [TESTING-BUILTIN-EXPECT-ERROR]
fn equalityCase() = {
    expect(toString(5), "5")
    expect("5", toString(5))
    expect(toString(true), "true")
    expect(toString(false), "false")
    expect(toString(1.5), "1.5")
    expect(satSub(0, 7), -7)
    expect(checkedAdd(2, 3), 5)
    expect(toString(checkedAdd(2, 3)), "Success(5)")
    check("a Success is decoded with ?:", 42, checkedMul(6, 7) ?: 0)
    check("an Error renders its payload", "Error(integer overflow)", toString(checkedMul(4294967296, 4294967296)))
    check("subtraction overflow is an Error too", "Error(integer overflow)", toString(checkedSub(-9223372036854775808, 1)))
    check("an interpolated Success keeps its constructor", "Success(5)", "${checkedAdd(2, 3)}")
    check("strings compare by content", "osprey", toLowerCase("OSPREY"))
    check("a float renders like its literal", "0.25", toString(0.25))
    expectTrue(contains("talon", "al"))
    expectFalse(contains("talon", "z"))
    checkTrue("a computed true", startsWith("osprey", "osp"))
    checkFalse("a computed false", endsWith("osprey", "osp"))
    expectAll([listLength([1, 2]) == 2, isEmpty(""), !isEmpty("a")])
}

/// A parse result whose Success payload is a record, which has no canonical rendering.
type Parsed = { project: string, region: string }

/// Parses a tiny command line: nothing is a usage error, one word a project.
fn parsed(argv) = match argv {
    [] => Error { message: "usage" }
    [project] => Success { value: Parsed { project: project, region: "all" } }
    _ => Error { message: "too many: ${listLength(argv)}" }
}

/// One line asserts a failed Result whatever its Success holds. [TESTING-BUILTIN-EXPECT-ERROR]
fn expectErrorCase() = {
    expectError(parsed([]), "usage")
    expectError(parsed(["a", "b"]), "too many: 2")
    expectError(parsed(["a", "b", "c"]), "too many: ${1 + 2}")
    expectError(checkedMul(4294967296, 4294967296), "integer overflow")
    expectError(checkedSub(-9223372036854775808, 1), "integer overflow")
    forEachList([["a", "b"], ["c", "d"]], |argv| => expectError(parsed(argv), "too many: 2"))
}

/// A refusal that carries several values, so its `E` is a record. [ERR-RESULT]
type ParseError = { code: int, why: string }

/// A failure with several cases, so its `E` is a union.
type MathError = DivZero | Overflow { by: int }

fn parseLen(s) = match s == "" {
    true => Error { message: ParseError { code: 1, why: "empty" } }
    false => Success { value: length(s) }
}

fn code(n) = match n < 0 {
    true => Error { message: n }
    false => Success { value: n }
}

fn ratio(n) = match n == 0 {
    true => Error { message: DivZero }
    false => match n > 99 {
        true => Error { message: Overflow { by: n } }
        false => Success { value: n }
    }
}

fn flag(n) = match n > 9 {
    true => Error { message: true }
    false => Success { value: n }
}

fn frac(n) = match n > 9 {
    true => Error { message: 2.5 }
    false => Success { value: n }
}

fn nested(n) = match n > 9 {
    true => Error { message: code(-3) }
    false => Success { value: n }
}

fn describe(e) = match e {
    DivZero => "div by zero"
    Overflow { by } => "overflow by ${by}"
}

fn rated(n) = match ratio(n) {
    Success { value } => "ok ${value}"
    Error { message } => describe(message)
}

fn parsedLen(s) = match parseLen(s) {
    Success { value } => "ok ${value}"
    Error { message } => "parse ${message.code}: ${message.why}"
}

/// A list read's value, or the index it asked for and the length it met.
/// [BUILTIN-LIST-GET]
fn readAt(xs, index) = match xs[index] {
    Success { value } => "got ${value}"
    Error { message } => "${message.index} of ${message.length}"
}

/// `E` is inferred from the payload and is that exact value on the way out:
/// through match, `?:`, toString, interpolation and closures. [ERR-PAYLOAD]
/// [ERR-RESULT-FORMAT] [TESTING-BUILTIN-EXPECT-ERROR]
fn typedErrorCase() = {
    expectError(code(-7), -7)
    expectError(flag(10), true)
    expectError(frac(10), 2.5)
    expectError(nested(12), code(-3))
    expectError(parseLen(""), ParseError { code: 1, why: "empty" })
    expectError(ratio(0), DivZero)
    expectError(ratio(500), Overflow { by: 500 })
    expect(code(7), 7)
    expect(code(-1) ?: 44, 44)
    expect(parsedLen(""), "parse 1: empty")
    expect(parsedLen("abc"), "ok 3")
    expect(rated(0), "div by zero")
    expect(rated(500), "overflow by 500")
    expect(rated(5), "ok 5")
    expect("${code(-7)} ${flag(10)} ${frac(10)} ${toString(nested(12))} ${code(3)}", "Error(-7) Error(true) Error(2.5) Error(Error(-3)) Success(3)")
    forEachList([-1, -2, -3], |n| => expectError(code(n), n))
    expect(range(-2, 3) |> fold(0, |sum, n| => satAdd(sum, code(n) ?: 100)), 203)
    expectError(listGet(tens, 7), IndexOutOfBounds { index: 7, length: 3 })
    expectError(listAppend(tens, 40)[-2], IndexOutOfBounds { index: -2, length: 4 })
    expect("${parseLen("")} ${ratio(500)} ${ratio(0)} ${toString(ParseError { code: 2, why: "odd" })}", "Error({ code: 1, why: \"empty\" }) Error(Overflow { by: 500 }) Error(DivZero) { code: 2, why: \"odd\" }")
    expect("${[Overflow { by: 1 }, DivZero]} ${[["a"], []]} ${[parseLen(""), parseLen("ab")]}", "[Overflow { by: 1 }, DivZero] [[\"a\"], []] [Error({ code: 1, why: \"empty\" }), Success(2)]")
    let inline = match listLength([1]) > 0 {
        true => Error { message: DivZero }
        false => Success { value: 1 }
    }
    expectError(inline, DivZero)
    expect(ParseError { code: 1, why: "x" }, ParseError { code: 1, why: "x" })
    check("lists and unions compare by rendering", [Overflow { by: 2 }, DivZero], [Overflow { by: 2 }, DivZero])
    check("a record payload compares whole", parseLen(""), parseLen(""))
    expect("${readAt(tens, 1)} ${readAt(tens, 3)} ${readAt(listAppend(List(), 5), 9)} ${[1, 2][4] ?: -1}", "got 20 3 of 3 9 of 1 -1")
    // A nested string reads as its literal: quoted, escapes spelled out. [BUILTIN-PRINT-FORM]
    expect("${["a\"b", "c\\d", "e\nf\tg"]} ${ParseError { code: 3, why: "say \"hi\"" }} ${[["\\"]]} ${toString("a\"b")}", "[\"a\\\"b\", \"c\\\\d\", \"e\\nf\\tg\"] { code: 3, why: \"say \\\"hi\\\"\" } [[\"\\\\\"]] a\"b")
}

/// A binary tree, taken apart several levels deep in one arm. [PATTERN-NESTED]
type Tree = Leaf | Node(Tree, Tree)

fn leftDepth(tree) = match tree {
    Node(Node(inner, _), _) => satAdd(2, leftDepth(inner))
    Node(Leaf, _) => 1
    Leaf => 0
}

/// A payload is matched where it sits: a literal, a variant, a binding.
fn explain(result) = match result {
    Success { value: 0 } => "zero"
    Success { value } => "got ${value}"
    Error { message: Overflow { by } } => "over by ${by}"
    Error { message: DivZero } => "divided by zero"
}

/// A Result inside a Result, three levels down, every arm a different test.
fn layered(r) = match r {
    Error { message: Error { message: -3 } } => "inner -3"
    Error { message: Error { message } } => "inner ${message}"
    Error { message: Success { value } } => "inner ok ${value}"
    Success { value: 7 } => "seven"
    Success { value } => "plain ${value}"
}

/// List elements, variants and Results nest into each other.
fn firstTwo(results) = match results {
    [Error { message: DivZero }, Error { message: Overflow { by } }] => "div then over ${by}"
    [Success { value: 1 }, ...rest] => "one then ${listLength(rest)}"
    [Success { value }, _] => "ok ${value} then any"
    _ => "other"
}

fn wrap(n) = match n > 0 {
    true => Error { message: code(satSub(n, 10)) }
    false => Success { value: n }
}

/// Patterns nest to any depth: each slot is tested as its own match would
/// test it, and the arm is taken only when the whole pattern matches.
/// [PATTERN-NESTED]
fn nestedPatternCase() = {
    let tree = Node(Node(Node(Leaf, Leaf), Leaf), Leaf)
    expect("${leftDepth(Leaf)} ${leftDepth(Node(Leaf, Leaf))} ${leftDepth(Node(Node(Leaf, Leaf), Leaf))} ${leftDepth(tree)}", "0 1 2 3")
    expect("${explain(ratio(5))} ${explain(Success { value: 0 })} ${explain(ratio(500))} ${explain(ratio(0))}", "got 5 zero over by 500 divided by zero")
    expect("${layered(nested(12))} ${layered(wrap(3))} ${layered(wrap(14))} ${layered(wrap(-1))} ${layered(Success { value: 7 })}", "inner -3 inner -7 inner ok 4 plain -1 seven")
    expect(firstTwo([ratio(0), ratio(700)]), "div then over 700")
    expect("${firstTwo([ratio(1), ratio(2), ratio(3)])} ${firstTwo([ratio(5), ratio(0)])} ${firstTwo([ratio(0)])}", "one then 2 ok 5 then any other")
    forEachList([1, 2, 9], |n| => expect(explain(ratio(satMul(n, 100))), "over by ${satMul(n, 100)}"))
}

/// A test call runs wherever it is evaluated, so a helper may declare cases.
fn declareFrom(label) = test("${label} case declared from a helper", fn() => checkAll("${label} helper case", [label != "", length(label) > 0]))

test("assertions compare canonical renderings", equalityCase)
test("expectError asserts a failed Result in one line", expectErrorCase)
test("an error payload keeps its type", typedErrorCase)
test("nested patterns match every slot at its own type", nestedPatternCase)
declareFrom("first")
declareFrom("second")
