// Every original case now checks both the value and the complete ordered fault payloads.

/// Boundary operands cross a function call so runtime dispatch is exercised.
fn runtimeValue(n) = n

/// The maximum and minimum boundary values, reached through the runtime call.
fn maxValue() = runtimeValue(9223372036854775807)
fn minValue() = (0 - maxValue()) - 1

/// The maximum and minimum boundary paths, one helper per repeated expression.
fn maxMinus(delta) = maxValue() - delta
fn maxRestored(delta) = maxMinus(delta) + delta
fn maxThenOverflow(delta) = maxRestored(delta) + 1
fn minPlus(delta) = minValue() + delta

/// The one fault the intermediate overflow raises for every delta.
let maxOverflowFault = "overflow(+,9223372036854775807,1,-9223372036854775808);"

/// Runs `work` under a recording Arith policy and checks value and fault order.
fn verify(work, expected, wantedFaults) = {
    mut faults = ""
    handle Arith {
        overflow op lhs rhs wrapped => {
            faults = faults + "overflow(${op},${lhs},${rhs},${wrapped});"
            wrapped
        }
        divideByZero op lhs => {
            faults = faults + "zero(${op},${lhs});"
            -0.5
        }
        remainderByZero lhs => {
            faults = faults + "remainder(${lhs});"
            0
        }
    }
    expect(work(), expected)
    expect(faults, wantedFaults)
}

/// A delta and the two boundary results that move with it.
type DeltaCase = { delta: int, minus: int, plus: int }

/// Deltas 001..015 with the subtraction and minimum-walk results they assert.
fn deltaCases() = [
    DeltaCase { delta: 1, minus: 9223372036854775806, plus: -9223372036854775807 },
    DeltaCase { delta: 2, minus: 9223372036854775805, plus: -9223372036854775806 },
    DeltaCase { delta: 3, minus: 9223372036854775804, plus: -9223372036854775805 },
    DeltaCase { delta: 4, minus: 9223372036854775803, plus: -9223372036854775804 },
    DeltaCase { delta: 5, minus: 9223372036854775802, plus: -9223372036854775803 },
    DeltaCase { delta: 6, minus: 9223372036854775801, plus: -9223372036854775802 },
    DeltaCase { delta: 7, minus: 9223372036854775800, plus: -9223372036854775801 },
    DeltaCase { delta: 8, minus: 9223372036854775799, plus: -9223372036854775800 },
    DeltaCase { delta: 9, minus: 9223372036854775798, plus: -9223372036854775799 },
    DeltaCase { delta: 10, minus: 9223372036854775797, plus: -9223372036854775798 },
    DeltaCase { delta: 11, minus: 9223372036854775796, plus: -9223372036854775797 },
    DeltaCase { delta: 12, minus: 9223372036854775795, plus: -9223372036854775796 },
    DeltaCase { delta: 13, minus: 9223372036854775794, plus: -9223372036854775795 },
    DeltaCase { delta: 14, minus: 9223372036854775793, plus: -9223372036854775794 },
    DeltaCase { delta: 15, minus: 9223372036854775792, plus: -9223372036854775793 }
]

/// The three-digit case suffix each sweep index carries, for indices 1..15.
fn caseSuffix(n) = if n < 10 { "00${toString(n)}" } else { "0${toString(n)}" }

/// The four maximum/minimum boundary cases, swept over every delta in order.
fn deltaSweep() = {
    let _ = forEachList(deltaCases(), fn(row) => {
        let suffix = caseSuffix(row.delta)
        test("maximum minus delta ${suffix}", fn() => verify(fn() => maxMinus(row.delta), row.minus, ""))
        test("maximum restored after subtraction ${suffix}", fn() => verify(fn() => maxRestored(row.delta), maxValue(), ""))
        test("maximum intermediate then overflow ${suffix}", fn() => verify(fn() => maxThenOverflow(row.delta), -9223372036854775808, maxOverflowFault))
        test("minimum plus delta ${suffix}", fn() => verify(fn() => minPlus(row.delta), row.plus, ""))
    })
}

/// Integer numerators 37..185 divided and remainded by a zero literal.
fn intZeroDivisorSweep() = {
    let _ = forEachList(toList(range(1, 6)), fn(k) => {
        let numerator = satMul(k, 37)
        test("division by zero ${caseSuffix(k)}", fn() => verify(fn() => numerator / 0, -0.5, "zero(/,${toString(numerator)}.0);"))
        test("remainder by zero ${caseSuffix(k)}", fn() => verify(fn() => numerator % 0, 0, "remainder(${toString(numerator)});"))
    })
}

/// Float divisors 6.5..10.5 divided and remainded by a zero literal.
fn floatZeroDivisorSweep() = {
    let divisors = [6.5, 7.5, 8.5, 9.5, 10.5]
    let _ = forEachList(toList(range(0, 5)), fn(k) => {
        let divisor = listGet(divisors, k) ?: 0.0
        let suffix = caseSuffix(satAdd(k, 6))
        test("division by zero ${suffix}", fn() => verify(fn() => divisor / 0.0, -0.5, "zero(/,${toString(divisor)});"))
        test("remainder by zero ${suffix}", fn() => verify(fn() => divisor % 0.0, -0.5, "zero(%,${toString(divisor)});"))
    })
}

/// checked* renders through `toString`, so its exact Result text is asserted.
fn assertRendered(label, work, expected) = test(label, fn() => verify(fn() => toString(work()), expected, ""))

deltaSweep()
intZeroDivisorSweep()
floatZeroDivisorSweep()

test("maximum plus one overflows", fn() => verify(fn() => maxValue() + 1, -9223372036854775808, maxOverflowFault))
test("maximum times two overflows", fn() => verify(fn() => maxValue() * 2, -2, "overflow(*,9223372036854775807,2,-2);"))
test("square above signed root overflows", fn() => verify(fn() => runtimeValue(3037000500) * runtimeValue(3037000500), -9223372036709301616, "overflow(*,3037000500,3037000500,-9223372036709301616);"))
test("minimum minus one overflows", fn() => verify(fn() => minValue() - 1, 9223372036854775807, "overflow(-,-9223372036854775808,1,9223372036854775807);"))
test("minimum times negative one overflows", fn() => verify(fn() => minValue() * -(1), -9223372036854775808, "overflow(*,-9223372036854775808,-1,-9223372036854775808);"))
test("negating minimum overflows", fn() => verify(fn() => -(minValue()), -9223372036854775808, "overflow(neg,-9223372036854775808,0,-9223372036854775808);"))
test("absolute minimum overflows", fn() => verify(fn() => abs(minValue()), -9223372036854775808, "overflow(abs,-9223372036854775808,0,-9223372036854775808);"))
test("minimum remainder negative one is representable", fn() => verify(fn() => minValue() % -(1), 0, ""))
test("minimum remainder one is zero", fn() => verify(fn() => minValue() % 1, 0, ""))
test("minimum float division by negative one is finite", fn() => verify(fn() => minValue() / -(1), 9223372036854775808.0, ""))
test("integer division minimum by negative one overflows", fn() => verify(fn() => intDiv(minValue(), (0 - 1)), -9223372036854775808, "overflow(intDiv,-9223372036854775808,-1,-9223372036854775808);"))
test("integer division minimum by one succeeds", fn() => verify(fn() => intDiv(minValue(), 1), -9223372036854775808, ""))

assertRendered("checkedAdd success", fn() => checkedAdd(2, 3), "Success(5)")
assertRendered("checkedSub negative success", fn() => checkedSub(2, 3), "Success(-1)")
assertRendered("checkedMul success", fn() => checkedMul(6, 7), "Success(42)")
assertRendered("checkedAdd maximum overflow", fn() => checkedAdd(maxValue(), 1), "Error(integer overflow)")
assertRendered("checkedSub minimum overflow", fn() => checkedSub(minValue(), 1), "Error(integer overflow)")
assertRendered("checkedMul wide overflow", fn() => checkedMul(runtimeValue(4294967296), runtimeValue(4294967296)), "Error(integer overflow)")
assertRendered("checkedAdd reaches maximum", fn() => checkedAdd(runtimeValue(9223372036854775806), 1), "Success(9223372036854775807)")
assertRendered("checkedSub reaches minimum", fn() => checkedSub(minValue() + 1, 1), "Success(-9223372036854775808)")
assertRendered("checkedMul maximum identity", fn() => checkedMul(maxValue(), 1), "Success(9223372036854775807)")
assertRendered("checkedMul minimum identity", fn() => checkedMul(minValue(), 1), "Success(-9223372036854775808)")
