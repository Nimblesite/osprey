// Every original case now checks both the value and the complete ordered fault payloads.

(** Boundary operands cross a function call so runtime dispatch is exercised. *)
runtimeValue n = n
negateValue n = -n

(** The maximum and minimum boundary paths, one helper per repeated expression. *)
maxMinus delta = runtimeValue 9223372036854775807 - delta
maxRestored delta = maxMinus delta + delta
maxThenOverflow delta = maxRestored delta + 1
minPlus delta = (0 - (runtimeValue 9223372036854775807)) - 1 + delta

verify (work, expected, wantedFaults) =
    mut faults = ""
    handle Arith
        overflow op lhs rhs wrapped =>
            faults := faults + "overflow(${op},${lhs},${rhs},${wrapped});"
            wrapped
        divideByZero op lhs =>
            faults := faults + "zero(${op},${lhs});"
            -0.5
        remainderByZero lhs =>
            faults := faults + "remainder(${lhs});"
            0
    expect (work ()) expected
    expect faults wantedFaults

test "maximum minus delta 001" (\() => verify ((\() => maxMinus 1), 9223372036854775806, ""))
test "maximum restored after subtraction 001" (\() => verify ((\() => maxRestored 1), 9223372036854775807, ""))
test "maximum intermediate then overflow 001" (\() => verify ((\() => maxThenOverflow 1), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
test "minimum plus delta 001" (\() => verify ((\() => minPlus 1), -9223372036854775807, ""))
test "maximum minus delta 002" (\() => verify ((\() => maxMinus 2), 9223372036854775805, ""))
test "maximum restored after subtraction 002" (\() => verify ((\() => maxRestored 2), 9223372036854775807, ""))
test "maximum intermediate then overflow 002" (\() => verify ((\() => maxThenOverflow 2), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
test "minimum plus delta 002" (\() => verify ((\() => minPlus 2), -9223372036854775806, ""))
test "maximum minus delta 003" (\() => verify ((\() => maxMinus 3), 9223372036854775804, ""))
test "maximum restored after subtraction 003" (\() => verify ((\() => maxRestored 3), 9223372036854775807, ""))
test "maximum intermediate then overflow 003" (\() => verify ((\() => maxThenOverflow 3), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
test "minimum plus delta 003" (\() => verify ((\() => minPlus 3), -9223372036854775805, ""))
