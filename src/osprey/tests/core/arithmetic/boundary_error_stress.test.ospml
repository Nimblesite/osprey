test "maximum plus one overflows" (\() => verify ((\() => ((runtimeValue (9223372036854775807)) + 1)), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
test "maximum times two overflows" (\() => verify ((\() => ((runtimeValue (9223372036854775807)) * 2)), -2, "overflow(*,9223372036854775807,2,-2);"))
test "square above signed root overflows" (\() => verify ((\() => ((runtimeValue (3037000500)) * (runtimeValue (3037000500)))), -9223372036709301616, "overflow(*,3037000500,3037000500,-9223372036709301616);"))
test "minimum minus one overflows" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) - 1)), 9223372036854775807, "overflow(-,-9223372036854775808,1,9223372036854775807);"))
test "minimum times negative one overflows" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) * -(1))), -9223372036854775808, "overflow(*,-9223372036854775808,-1,-9223372036854775808);"))
test "negating minimum overflows" (\() => verify ((\() => -(((0 - (runtimeValue (9223372036854775807))) - 1))), -9223372036854775808, "overflow(neg,-9223372036854775808,0,-9223372036854775808);"))
test "absolute minimum overflows" (\() => verify ((\() => (abs (((0 - (runtimeValue (9223372036854775807))) - 1)))), -9223372036854775808, "overflow(abs,-9223372036854775808,0,-9223372036854775808);"))
test "minimum remainder negative one is representable" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) % -(1))), 0, ""))
test "minimum remainder one is zero" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) % 1)), 0, ""))
test "minimum float division by negative one is finite" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) / -(1))), 9223372036854775808.0, ""))
test "integer division minimum by negative one overflows" (\() => verify ((\() => (intDiv (((0 - (runtimeValue (9223372036854775807))) - 1)) ((0 - 1)))), -9223372036854775808, "overflow(intDiv,-9223372036854775808,-1,-9223372036854775808);"))
test "integer division minimum by one succeeds" (\() => verify ((\() => (intDiv (((0 - (runtimeValue (9223372036854775807))) - 1)) (1))), -9223372036854775808, ""))
test "checkedAdd success" (\() => verify ((\() => (toString ((checkedAdd (2) (3))))), "Success(5)", ""))
test "checkedSub negative success" (\() => verify ((\() => (toString ((checkedSub (2) (3))))), "Success(-1)", ""))
test "checkedMul success" (\() => verify ((\() => (toString ((checkedMul (6) (7))))), "Success(42)", ""))
test "checkedAdd maximum overflow" (\() => verify ((\() => (toString ((checkedAdd ((runtimeValue (9223372036854775807))) (1))))), "Error(integer overflow)", ""))
test "checkedSub minimum overflow" (\() => verify ((\() => (toString ((checkedSub (((0 - (runtimeValue (9223372036854775807))) - 1)) (1))))), "Error(integer overflow)", ""))
test "checkedMul wide overflow" (\() => verify ((\() => (toString ((checkedMul ((runtimeValue (4294967296))) ((runtimeValue (4294967296))))))), "Error(integer overflow)", ""))
test "checkedAdd reaches maximum" (\() => verify ((\() => (toString ((checkedAdd ((runtimeValue (9223372036854775806))) (1))))), "Success(9223372036854775807)", ""))
test "checkedSub reaches minimum" (\() => verify ((\() => (toString ((checkedSub ((((0 - (runtimeValue (9223372036854775807))) - 1) + 1)) (1))))), "Success(-9223372036854775808)", ""))
test "checkedMul maximum identity" (\() => verify ((\() => (toString ((checkedMul ((runtimeValue (9223372036854775807))) (1))))), "Success(9223372036854775807)", ""))
test "checkedMul minimum identity" (\() => verify ((\() => (toString ((checkedMul (((0 - (runtimeValue (9223372036854775807))) - 1)) (1))))), "Success(-9223372036854775808)", ""))
