// ML precedence and associativity twin with identical expected observations.
// Paired parentheses make grouping differences explicit beside unparenthesized forms.

(** A sweep index rendered as its three-digit label suffix. *)
caseSuffix n = match n < 10
    true => "00${toString n}"
    false => "0${toString n}"

(** One unparenthesized mix `sum + productLeft * productRight - remainderLeft % remainderRight`. *)
type UnparenthesizedMix =
    n : int
    sum : int
    productLeft : int
    productRight : int
    remainderLeft : int
    remainderRight : int
    want : string

(** The thirty unparenthesized mixes with the exact text each must render. *)
unparenthesizedMixes () = [
    UnparenthesizedMix(n = 1, sum = 103, productLeft = 3, productRight = 4, remainderLeft = 41, remainderRight = 3, want = "113"),
    UnparenthesizedMix(n = 2, sum = 106, productLeft = 4, productRight = 5, remainderLeft = 42, remainderRight = 4, want = "124"),
    UnparenthesizedMix(n = 3, sum = 109, productLeft = 5, productRight = 6, remainderLeft = 43, remainderRight = 5, want = "136"),
    UnparenthesizedMix(n = 4, sum = 112, productLeft = 6, productRight = 7, remainderLeft = 44, remainderRight = 6, want = "152"),
    UnparenthesizedMix(n = 5, sum = 115, productLeft = 7, productRight = 3, remainderLeft = 45, remainderRight = 7, want = "133"),
    UnparenthesizedMix(n = 6, sum = 118, productLeft = 8, productRight = 4, remainderLeft = 46, remainderRight = 8, want = "144"),
    UnparenthesizedMix(n = 7, sum = 121, productLeft = 2, productRight = 5, remainderLeft = 47, remainderRight = 9, want = "129"),
    UnparenthesizedMix(n = 8, sum = 124, productLeft = 3, productRight = 6, remainderLeft = 48, remainderRight = 10, want = "134"),
    UnparenthesizedMix(n = 9, sum = 127, productLeft = 4, productRight = 7, remainderLeft = 49, remainderRight = 2, want = "154"),
    UnparenthesizedMix(n = 10, sum = 130, productLeft = 5, productRight = 3, remainderLeft = 50, remainderRight = 3, want = "143"),
    UnparenthesizedMix(n = 11, sum = 133, productLeft = 6, productRight = 4, remainderLeft = 51, remainderRight = 4, want = "154"),
    UnparenthesizedMix(n = 12, sum = 136, productLeft = 7, productRight = 5, remainderLeft = 52, remainderRight = 5, want = "169"),
    UnparenthesizedMix(n = 13, sum = 139, productLeft = 8, productRight = 6, remainderLeft = 53, remainderRight = 6, want = "182"),
    UnparenthesizedMix(n = 14, sum = 142, productLeft = 2, productRight = 7, remainderLeft = 54, remainderRight = 7, want = "151"),
    UnparenthesizedMix(n = 15, sum = 145, productLeft = 3, productRight = 3, remainderLeft = 55, remainderRight = 8, want = "147"),
    UnparenthesizedMix(n = 16, sum = 148, productLeft = 4, productRight = 4, remainderLeft = 56, remainderRight = 9, want = "162"),
    UnparenthesizedMix(n = 17, sum = 151, productLeft = 5, productRight = 5, remainderLeft = 57, remainderRight = 10, want = "169"),
    UnparenthesizedMix(n = 18, sum = 154, productLeft = 6, productRight = 6, remainderLeft = 58, remainderRight = 2, want = "190"),
    UnparenthesizedMix(n = 19, sum = 157, productLeft = 7, productRight = 7, remainderLeft = 59, remainderRight = 3, want = "204"),
    UnparenthesizedMix(n = 20, sum = 160, productLeft = 8, productRight = 3, remainderLeft = 60, remainderRight = 4, want = "184"),
    UnparenthesizedMix(n = 21, sum = 163, productLeft = 2, productRight = 4, remainderLeft = 61, remainderRight = 5, want = "170"),
    UnparenthesizedMix(n = 22, sum = 166, productLeft = 3, productRight = 5, remainderLeft = 62, remainderRight = 6, want = "179"),
    UnparenthesizedMix(n = 23, sum = 169, productLeft = 4, productRight = 6, remainderLeft = 63, remainderRight = 7, want = "193"),
    UnparenthesizedMix(n = 24, sum = 172, productLeft = 5, productRight = 7, remainderLeft = 64, remainderRight = 8, want = "207"),
    UnparenthesizedMix(n = 25, sum = 175, productLeft = 6, productRight = 3, remainderLeft = 65, remainderRight = 9, want = "191"),
    UnparenthesizedMix(n = 26, sum = 178, productLeft = 7, productRight = 4, remainderLeft = 66, remainderRight = 10, want = "200"),
    UnparenthesizedMix(n = 27, sum = 181, productLeft = 8, productRight = 5, remainderLeft = 67, remainderRight = 2, want = "220"),
    UnparenthesizedMix(n = 28, sum = 184, productLeft = 2, productRight = 6, remainderLeft = 68, remainderRight = 3, want = "194"),
    UnparenthesizedMix(n = 29, sum = 187, productLeft = 3, productRight = 7, remainderLeft = 69, remainderRight = 4, want = "207"),
    UnparenthesizedMix(n = 30, sum = 190, productLeft = 4, productRight = 3, remainderLeft = 70, remainderRight = 5, want = "202")
]

(** The thirty unparenthesized mixes, each registered under its sequential label. *)
unparenthesizedSweep () =
    _ = forEachList (unparenthesizedMixes ()) (\row =>
        label = "precedence unparenthesized ${caseSuffix row.n}"
        test label (exactly (\() => check label row.want (toString (row.sum + row.productLeft * row.productRight - row.remainderLeft % row.remainderRight)))))

(** One parenthesized grouping `(sum + addend) * (minuend - (remainderLeft % remainderRight))`. *)
type ParenthesizedGrouping =
    n : int
    sum : int
    addend : int
    minuend : int
    remainderLeft : int
    remainderRight : int
    want : string

(** The twenty parenthesized groupings with the exact text each must render. *)
parenthesizedGroupings () = [
    ParenthesizedGrouping(n = 1, sum = 21, addend = 3, minuend = 6, remainderLeft = 2, remainderRight = 3, want = "96"),
    ParenthesizedGrouping(n = 2, sum = 22, addend = 4, minuend = 7, remainderLeft = 3, remainderRight = 4, want = "104"),
    ParenthesizedGrouping(n = 3, sum = 23, addend = 5, minuend = 8, remainderLeft = 4, remainderRight = 5, want = "112"),
    ParenthesizedGrouping(n = 4, sum = 24, addend = 6, minuend = 9, remainderLeft = 1, remainderRight = 6, want = "240"),
    ParenthesizedGrouping(n = 5, sum = 25, addend = 7, minuend = 5, remainderLeft = 2, remainderRight = 7, want = "96"),
    ParenthesizedGrouping(n = 6, sum = 26, addend = 2, minuend = 6, remainderLeft = 3, remainderRight = 8, want = "84"),
    ParenthesizedGrouping(n = 7, sum = 27, addend = 3, minuend = 7, remainderLeft = 4, remainderRight = 2, want = "210"),
    ParenthesizedGrouping(n = 8, sum = 28, addend = 4, minuend = 8, remainderLeft = 1, remainderRight = 3, want = "224"),
    ParenthesizedGrouping(n = 9, sum = 29, addend = 5, minuend = 9, remainderLeft = 2, remainderRight = 4, want = "238"),
    ParenthesizedGrouping(n = 10, sum = 30, addend = 6, minuend = 5, remainderLeft = 3, remainderRight = 5, want = "72"),
    ParenthesizedGrouping(n = 11, sum = 31, addend = 7, minuend = 6, remainderLeft = 4, remainderRight = 6, want = "76"),
    ParenthesizedGrouping(n = 12, sum = 32, addend = 2, minuend = 7, remainderLeft = 1, remainderRight = 7, want = "204"),
    ParenthesizedGrouping(n = 13, sum = 33, addend = 3, minuend = 8, remainderLeft = 2, remainderRight = 8, want = "216"),
    ParenthesizedGrouping(n = 14, sum = 34, addend = 4, minuend = 9, remainderLeft = 3, remainderRight = 2, want = "304"),
    ParenthesizedGrouping(n = 15, sum = 35, addend = 5, minuend = 5, remainderLeft = 4, remainderRight = 3, want = "160"),
    ParenthesizedGrouping(n = 16, sum = 36, addend = 6, minuend = 6, remainderLeft = 1, remainderRight = 4, want = "210"),
    ParenthesizedGrouping(n = 17, sum = 37, addend = 7, minuend = 7, remainderLeft = 2, remainderRight = 5, want = "220"),
    ParenthesizedGrouping(n = 18, sum = 38, addend = 2, minuend = 8, remainderLeft = 3, remainderRight = 6, want = "200"),
    ParenthesizedGrouping(n = 19, sum = 39, addend = 3, minuend = 9, remainderLeft = 4, remainderRight = 7, want = "210"),
    ParenthesizedGrouping(n = 20, sum = 40, addend = 4, minuend = 5, remainderLeft = 1, remainderRight = 8, want = "176")
]

(** The twenty parenthesized groupings, each registered under its sequential label. *)
parenthesizedSweep () =
    _ = forEachList (parenthesizedGroupings ()) (\row =>
        label = "precedence parenthesized ${caseSuffix row.n}"
        test label (exactly (\() => check label row.want (toString ((row.sum + row.addend) * (row.minuend - (row.remainderLeft % row.remainderRight)))))))

(** One subtraction triple: `first - second - third` beside the grouped `first - (second - third)`. *)
type SubtractionPair =
    n : int
    first : int
    second : int
    third : int
    left : string
    right : string

(** The ten subtraction triples with both texts they must render. *)
subtractionPairs () = [
    SubtractionPair(n = 1, first = 311, second = 21, third = 4, left = "286", right = "294"),
    SubtractionPair(n = 2, first = 322, second = 22, third = 5, left = "295", right = "305"),
    SubtractionPair(n = 3, first = 333, second = 23, third = 6, left = "304", right = "316"),
    SubtractionPair(n = 4, first = 344, second = 24, third = 7, left = "313", right = "327"),
    SubtractionPair(n = 5, first = 355, second = 25, third = 8, left = "322", right = "338"),
    SubtractionPair(n = 6, first = 366, second = 26, third = 9, left = "331", right = "349"),
    SubtractionPair(n = 7, first = 377, second = 27, third = 10, left = "340", right = "360"),
    SubtractionPair(n = 8, first = 388, second = 28, third = 11, left = "349", right = "371"),
    SubtractionPair(n = 9, first = 399, second = 29, third = 12, left = "358", right = "382"),
    SubtractionPair(n = 10, first = 410, second = 30, third = 13, left = "367", right = "393")
]

(** The ten subtraction triples: left-associative and right-grouped registered in alternation. *)
subtractionSweep () =
    _ = forEachList (subtractionPairs ()) (\row =>
        leftLabel = "subtraction left associative ${caseSuffix row.n}"
        rightLabel = "subtraction right grouped ${caseSuffix row.n}"
        test leftLabel (exactly (\() => check leftLabel row.left (toString (row.first - row.second - row.third))))
        test rightLabel (exactly (\() => check rightLabel row.right (toString (row.first - (row.second - row.third))))))

(** One remainder mix `factorLeft * factorRight % modulus`. *)
type RemainderMix =
    n : int
    factorLeft : int
    factorRight : int
    modulus : int
    want : string

(** The ten remainder mixes with the exact text each must render. *)
remainderMixes () = [
    RemainderMix(n = 1, factorLeft = 18, factorRight = 10, modulus = 6, want = "0"),
    RemainderMix(n = 2, factorLeft = 19, factorRight = 11, modulus = 7, want = "6"),
    RemainderMix(n = 3, factorLeft = 20, factorRight = 12, modulus = 8, want = "0"),
    RemainderMix(n = 4, factorLeft = 21, factorRight = 13, modulus = 9, want = "3"),
    RemainderMix(n = 5, factorLeft = 22, factorRight = 14, modulus = 10, want = "8"),
    RemainderMix(n = 6, factorLeft = 23, factorRight = 15, modulus = 5, want = "0"),
    RemainderMix(n = 7, factorLeft = 24, factorRight = 16, modulus = 6, want = "0"),
    RemainderMix(n = 8, factorLeft = 25, factorRight = 17, modulus = 7, want = "5"),
    RemainderMix(n = 9, factorLeft = 26, factorRight = 18, modulus = 8, want = "4"),
    RemainderMix(n = 10, factorLeft = 27, factorRight = 19, modulus = 9, want = "0")
]

(** The ten remainder mixes, each registered under its sequential label. *)
remainderSweep () =
    _ = forEachList (remainderMixes ()) (\row =>
        label = "multiply remainder left associative ${caseSuffix row.n}"
        test label (exactly (\() => check label row.want (toString (row.factorLeft * row.factorRight % row.modulus)))))

(** One division mix `dividend / divisor * factor`. *)
type DivisionMix =
    n : int
    dividend : int
    divisor : int
    factor : int
    want : string

(** The ten division mixes with the exact text each must render. *)
divisionMixes () = [
    DivisionMix(n = 1, dividend = 8, divisor = 2, factor = 3, want = "12.0"),
    DivisionMix(n = 2, dividend = 15, divisor = 3, factor = 4, want = "20.0"),
    DivisionMix(n = 3, dividend = 24, divisor = 4, factor = 5, want = "30.0"),
    DivisionMix(n = 4, dividend = 35, divisor = 5, factor = 6, want = "42.0"),
    DivisionMix(n = 5, dividend = 48, divisor = 6, factor = 2, want = "16.0"),
    DivisionMix(n = 6, dividend = 63, divisor = 7, factor = 3, want = "27.0"),
    DivisionMix(n = 7, dividend = 80, divisor = 8, factor = 4, want = "40.0"),
    DivisionMix(n = 8, dividend = 99, divisor = 9, factor = 5, want = "55.0"),
    DivisionMix(n = 9, dividend = 120, divisor = 10, factor = 6, want = "72.0"),
    DivisionMix(n = 10, dividend = 143, divisor = 11, factor = 2, want = "26.0")
]

(** The ten division mixes, each registered under its sequential label. *)
divisionSweep () =
    _ = forEachList (divisionMixes ()) (\row =>
        label = "division multiplication left associative ${caseSuffix row.n}"
        test label (exactly (\() => check label row.want (toString (row.dividend / row.divisor * row.factor)))))

unparenthesizedSweep ()
parenthesizedSweep ()
subtractionSweep ()
remainderSweep ()
divisionSweep ()

