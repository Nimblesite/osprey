// Explicit checked builtins preserve Result data across direct value handlers.
// Ordinary operators dispatch their faults to a region's Arith policy.

effect ArithmeticFailure
    (** Decide what a failed calculation yields, preserving the original `Error`. *)
    decide : string => Result<int, Error>

(** Convert a successful sum to text while preserving the exact error branch. *)
renderSum (a, b) = match checkedAdd a b
    Success value => Success(value = toString value)
    Error message => Error(message = message)

(** Raise only after checked addition has produced an explicit Error value. *)
addThroughPolicy (a, b) = match checkedAdd a b
    Success value => Success(value = value)
    Error message => perform ArithmeticFailure.decide message

(** This handler preserves failure and its diagnostic verbatim. *)
preserveFailure (a, b) =
    handle ArithmeticFailure
        decide message => Error(message = message)
    addThroughPolicy (a, b)

(** This handler deliberately recovers, but still receives the exact reason. *)
recoverWith (a, b, fallback) =
    handle ArithmeticFailure
        decide message => match message == "integer overflow"
            true => Success(value = fallback)
            false => Error(message = message)
    addThroughPolicy (a, b)

(** Renders `work` through `toString` and asserts the exact Result text. *)
assertRendered (label, work, expected) = test label (\() => expect (toString (work ())) expected)

assertRendered ("success can be rendered without contextual coercion", (\() => renderSum (1, 1)), "Success(2)")
assertRendered ("rendering preserves the overflow error Result", (\() => renderSum (9223372036854775807, 1)), "Error(integer overflow)")
assertRendered ("effect policy bypasses its handler on success", (\() => preserveFailure (20, 22)), "Success(42)")
assertRendered ("effect policy can preserve the exact overflow Result", (\() => preserveFailure (9223372036854775807, 1)), "Error(integer overflow)")
assertRendered ("effect policy may deliberately recover from known overflow", (\() => recoverWith (9223372036854775807, 1, 7)), "Success(7)")
assertRendered ("healthy arithmetic never invokes the recovery decision", (\() => recoverWith (19, 23, 7)), "Success(42)")

(** #230: preserve the mathematical answer in a wider numeric representation. *)
maskedSquare x =
    mut answer = 0.0
    mut overflowed = false
    handle Arith
        overflow op lhs rhs wrapped =>
            checkAll "square overflow payload" [op == "*", lhs == 4000000000, rhs == 4000000000, wrapped == -2446744073709551616]
            overflowed := true
            answer := toFloat lhs * toFloat rhs
            wrapped
    narrow = x * x
    match overflowed
        true => answer
        false => toFloat narrow

test "masked square preserves the mathematical answer" (\() =>
    expect (maskedSquare 4000000000) 16000000000000000000.0)

(** Runs `work` under a policy that counts overflows and keeps the wrapped
    value, then asserts the exact fault count. *)
countingTotal (work, expected) =
    mut faults = 0
    handle Arith
        overflow _ _ _ wrapped =>
            faults := wrapAdd faults 1
            wrapped
    total = work ()
    expect faults expected
    total

(** The wrapped total of `work` after exactly two counted overflow faults. *)
wrappingTotal work = countingTotal (work, 2)

posting i = match i == 0
    true => 1
    false => -1

foldPostings () =
    postings = range (0, 2) |> map posting
    postings |> fold 9223372036854775807 (\(a, b) => a + b)

test "overflow must not reset the fold accumulator" (\() =>
    expect (wrappingTotal foldPostings) 9223372036854775807)

ledgerPostings () =
    balance = 9000000000000000000
    deposit = 1000000000000000000
    credited = balance + deposit
    credited - 2000000000000000000

test "overflow must not make a ledger deposit vanish" (\() =>
    expect (wrappingTotal ledgerPostings) 8000000000000000000)

(** #163: an annotation cannot select a different arithmetic representation. *)
inferredSum (a, b) = a + b
annotatedSum : (int, int) -> int
annotatedSum (a, b) = a + b

annotationParity () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
    checkAll "annotation preserves arithmetic values" [
        inferredSum (20, 22) == annotatedSum (20, 22),
        inferredSum (9223372036854775807, 1) == -9223372036854775808,
        annotatedSum (9223372036854775807, 1) == -9223372036854775808
    ]

test "arithmetic return annotation preserves output" annotationParity

applyPair (f, a, b) = f (a, b)

test "total helpers choose modular or saturating arithmetic" (\() => checkAll "total arithmetic helpers" [
    wrapAdd 9223372036854775807 1 == -9223372036854775808,
    wrapSub (-9223372036854775808) 1 == 9223372036854775807,
    satAdd 9223372036854775807 1 == 9223372036854775807,
    satMul (-9223372036854775808) (-1) == 9223372036854775807,
    applyPair (wrapSub, -9223372036854775808, 1) == 9223372036854775807,
    applyPair (satAdd, 9223372036854775807, 1) == 9223372036854775807,
    applyPair (satMul, -9223372036854775808, -1) == 9223372036854775807,
    wrapMul 9223372036854775807 2 == -2,
    satSub (-9223372036854775808) 1 == -9223372036854775808,
    satMul (-9223372036854775808) 2 == -9223372036854775808,
    satMul 7 (-6) == -42,
    applyPair (wrapAdd, 9223372036854775807, 1) == -9223372036854775808,
    applyPair (wrapMul, 9223372036854775807, 2) == -2,
    applyPair (satSub, -9223372036854775808, 1) == -9223372036854775808,
    (range (0, 3) |> fold 9223372036854775807 wrapAdd) == -9223372036854775806
])

literalDivisors x =
    checkAll "nonzero literal divisors are total" [x % -1 == 0, x / 4 == -2305843009213693952.0]

test "nonzero literal divisors need no policy" (\() => literalDivisors (-9223372036854775808))

outerRecovery () =
    nested = \() =>
        inner = handler Arith
            overflow _ lhs rhs _ => lhs + rhs - 1
        inner (\() => inferredSum (9223372036854775807, 1))
    answer = countingTotal (nested, 2)
    checkAll "recovery executes outside its own installation" [answer == 9223372036854775807]

test "recovery arithmetic forwards to the outer policy" outerRecovery

(** #183: direct calls preserve whole Result blocks, including float payloads. *)
effect ResultRelay
    integer : Result<int, Error> => Result<int, Error>
    fraction : Result<float, Error> => Result<float, Error>

(** Renders one relayed integer Result through the installed handler. *)
renderedInteger value = toString (perform ResultRelay.integer value)

(** Renders one relayed float Result through the installed handler. *)
renderedFraction value = toString (perform ResultRelay.fraction value)

resultRelay () =
    handle ResultRelay
        integer value => value
        fraction value => value
    checkAll "direct handler Result payloads" [
        renderedInteger (Success(value = 42)) == "Success(42)",
        renderedInteger (Error(message = "kept")) == "Error(kept)",
        renderedFraction (Success(value = 1.25)) == "Success(1.25)",
        renderedFraction (Error(message = "fraction")) == "Error(fraction)"
    ]

test "direct handler calls preserve Result operation values" resultRelay

(** A value policy that must stop work, as the graphics scenes need on a C ABI
    target: the arm records the fault and answers, a second handler reads the
    record, and the loop ends at its next boundary. *)
effect Halt
    stopped : Unit => bool

frames (n, last) = match (perform Halt.stopped () == false) && (n < 5)
    true => frames (n + 1, 9223372036854775807 + n)
    false => "${n} frames, last ${last}"

haltOnFault () =
    mut fault = ""
    handle Halt
        stopped => fault != ""
    handle Arith
        overflow op lhs rhs _ =>
            fault := "${lhs} ${op} ${rhs}"
            0
    ran = frames (0, 0)
    checkAll "a recorded fault stops the loop at its next boundary" [ran == "2 frames, last 0", fault == "9223372036854775807 + 1"]

test "a recorded fault stops a loop at its next boundary" haltOnFault
