// Every original case now checks both the value and the complete ordered fault payloads.

(** Boundary operands cross a function call so runtime dispatch is exercised. *)
runtimeValue n = n
negateValue n = -n

(** The maximum value, reached through the runtime call. *)
maxValue () = runtimeValue 9223372036854775807

(** A sweep index left-padded to two digits. *)
twoDigits n = match n < 10
    true => "0${toString n}"
    false => toString n

(** The three-digit case suffix each sweep index carries, for indices 1..15. *)
caseSuffix n = "0${twoDigits n}"

(** A checked row for one plain negation, which never faults. *)
negated (x, want) = faultsAre ((\() => -(x)), want, "")

(** A checked row for one doubled negation, which never faults. *)
doubleNegated (x, want) = faultsAre ((\() => -(-(x))), want, "")

(** A checked row for the magnitude of a plain literal, which never faults. *)
magnitude (x, want) = faultsAre ((\() => (abs (x))), want, "")

(** A checked row for the magnitude of a negated literal, which never faults. *)
magnitudeOfNegated (x, want) = faultsAre ((\() => (abs (-(x)))), want, "")

(** The ordered two-fault paths, one helper per repeated fault pair. *)
overflowThenDivision delta = faultsAre ((\() => ((maxValue () + delta) + (delta / 0))), -9223372036854775808.0, "overflow(+,9223372036854775807,${delta},${wrapAdd(9223372036854775807, delta)});zero(/,${delta}.0);")
remainderThenOverflow delta = faultsAre ((\() => ((delta % 0) * (maxValue () + delta))), 0, "remainder(${delta});overflow(+,9223372036854775807,${delta},${wrapAdd(9223372036854775807, delta)});")
multiplyThenRemainder () = faultsAre ((\() => ((maxValue () * 2) % 0)), 0, "overflow(*,9223372036854775807,2,-2);remainder(-2);")
divisionThenMultiply delta = faultsAre ((\() => ((delta / 0) + (maxValue () * 2))), -2.5, "zero(/,${delta}.0);overflow(*,9223372036854775807,2,-2);")
lateOverflowThenRemainder delta = faultsAre ((\() => ((((maxValue () - delta) + delta) + 1) * (delta % 0))), 0, "overflow(+,9223372036854775807,1,-9223372036854775808);remainder(${delta});")

faultsAre (work, expected, wantedFaults) =
    mut faults = ""
    handle Arith
        overflow op lhs rhs wrapped =>
            faults := faults + "overflow(${op},${lhs},${rhs},${wrapped});"
            wrapped
        divideByZero op lhs =>
            faults := faults + "zero(${op},${lhs});"
            -0.5
        remainderByZero lhs =>
            faults := faults + "remainder(${lhs});"
            0
    expect (work ()) expected
    expect faults wantedFaults

choose (work, replacement) =
    handle Arith
        overflow op lhs rhs wrapped =>
            _ = perform Arith.overflow op lhs rhs wrapped
            replacement
    work ()

(** Deltas 001..004 of the ordered two-fault pairs, in original case order. *)
twoFaultSweep () =
    _ = forEachList (toList (range 1 5)) (\delta =>
        suffix = caseSuffix delta
        test "overflow precedes division error ${suffix}" (\() => overflowThenDivision delta)
        test "remainder error precedes overflow ${suffix}" (\() => remainderThenOverflow delta)
        test "multiply overflow precedes remainder error ${suffix}" (\() => multiplyThenRemainder ())
        test "division error precedes multiply overflow ${suffix}" (\() => divisionThenMultiply delta)
        test "late maximum overflow dispatches before right fault ${suffix}" (\() => lateOverflowThenRemainder delta))

(** Indices 001..010 of the nested-policy pairs, healthy case first in each. *)
policySweep () =
    _ = forEachList (toList (range 1 11)) (\k =>
        suffix = caseSuffix k
        leftOperand = satMul k 4
        rightOperand = satAdd k 2
        sum = satAdd leftOperand rightOperand
        replacement = satAdd k 900
        test "healthy arithmetic bypasses nested policy ${suffix}" (\() => faultsAre ((\() => choose ((\() => leftOperand + rightOperand), sum)), sum, ""))
        test "nested overflow policy ${suffix}" (\() => faultsAre ((\() => choose ((\() => maxValue () + k), replacement)), replacement, "overflow(+,9223372036854775807,${k},${wrapAdd(9223372036854775807, k)});")))

test "unary negation 001" (\() => negated (1, -1))
test "double unary negation 001" (\() => doubleNegated (1, 1))
test "unary negation 002" (\() => negated (2, -2))
test "double unary negation 002" (\() => doubleNegated (2, 2))
test "unary negation 003" (\() => negated (3, -3))
test "double unary negation 003" (\() => doubleNegated (3, 3))
test "unary negation 004" (\() => negated (4, -4))
test "double unary negation 004" (\() => doubleNegated (4, 4))
test "unary negation 005" (\() => negated (5, -5))
test "double unary negation 005" (\() => doubleNegated (5, 5))
test "unary negation 006" (\() => negated (6, -6))
test "double unary negation 006" (\() => doubleNegated (6, 6))
test "unary negation 007" (\() => negated (7, -7))
test "double unary negation 007" (\() => doubleNegated (7, 7))
test "unary negation 008" (\() => negated (8, -8))
test "double unary negation 008" (\() => doubleNegated (8, 8))
test "unary negation 009" (\() => negated (9, -9))
test "double unary negation 009" (\() => doubleNegated (9, 9))
test "unary negation 010" (\() => negated (10, -10))
test "double unary negation 010" (\() => doubleNegated (10, 10))
test "absolute positive 001" (\() => magnitude (1, 1))
test "absolute negative 001" (\() => magnitudeOfNegated (1, 1))
test "absolute positive 002" (\() => magnitude (2, 2))
test "absolute negative 002" (\() => magnitudeOfNegated (2, 2))
test "absolute positive 003" (\() => magnitude (3, 3))
test "absolute negative 003" (\() => magnitudeOfNegated (3, 3))
test "absolute positive 004" (\() => magnitude (4, 4))
test "absolute negative 004" (\() => magnitudeOfNegated (4, 4))
test "absolute positive 005" (\() => magnitude (5, 5))
test "absolute negative 005" (\() => magnitudeOfNegated (5, 5))
test "absolute positive 006" (\() => magnitude (6, 6))
test "absolute negative 006" (\() => magnitudeOfNegated (6, 6))
test "absolute positive 007" (\() => magnitude (7, 7))
test "absolute negative 007" (\() => magnitudeOfNegated (7, 7))
test "absolute positive 008" (\() => magnitude (8, 8))
test "absolute negative 008" (\() => magnitudeOfNegated (8, 8))
test "absolute positive 009" (\() => magnitude (9, 9))
test "absolute negative 009" (\() => magnitudeOfNegated (9, 9))
test "absolute positive 010" (\() => magnitude (10, 10))
test "absolute negative 010" (\() => magnitudeOfNegated (10, 10))

test "mixed integer value chain 001" (\() => faultsAre ((\() => (((((11 + 3) * 4) - 1) % 6) + 8)), 9, ""))
test "mixed integer value chain 002" (\() => faultsAre ((\() => (((((12 + 4) * 5) - 2) % 7) + 9)), 10, ""))
test "mixed integer value chain 003" (\() => faultsAre ((\() => (((((13 + 5) * 6) - 3) % 8) + 10)), 11, ""))
test "mixed integer value chain 004" (\() => faultsAre ((\() => (((((14 + 2) * 7) - 4) % 9) + 11)), 11, ""))
test "mixed integer value chain 005" (\() => faultsAre ((\() => (((((15 + 3) * 3) - 5) % 10) + 12)), 21, ""))
test "mixed integer value chain 006" (\() => faultsAre ((\() => (((((16 + 4) * 4) - 6) % 11) + 13)), 21, ""))
test "mixed integer value chain 007" (\() => faultsAre ((\() => (((((17 + 5) * 5) - 7) % 5) + 14)), 17, ""))
test "mixed integer value chain 008" (\() => faultsAre ((\() => (((((18 + 2) * 6) - 8) % 6) + 15)), 19, ""))
test "mixed integer value chain 009" (\() => faultsAre ((\() => (((((19 + 3) * 7) - 9) % 7) + 16)), 21, ""))
test "mixed integer value chain 010" (\() => faultsAre ((\() => (((((20 + 4) * 3) - 10) % 8) + 17)), 23, ""))
test "mixed float value chain 001" (\() => faultsAre ((\() => ((6 / 2) + 5.0)), 8.0, ""))
test "mixed float value chain 002" (\() => faultsAre ((\() => ((12 / 3) + 6.0)), 10.0, ""))
test "mixed float value chain 003" (\() => faultsAre ((\() => ((20 / 4) + 7.0)), 12.0, ""))
test "mixed float value chain 004" (\() => faultsAre ((\() => ((30 / 5) + 8.0)), 14.0, ""))
test "mixed float value chain 005" (\() => faultsAre ((\() => ((42 / 6) + 9.0)), 16.0, ""))
test "mixed float value chain 006" (\() => faultsAre ((\() => ((56 / 7) + 10.0)), 18.0, ""))
test "mixed float value chain 007" (\() => faultsAre ((\() => ((72 / 8) + 11.0)), 20.0, ""))
test "mixed float value chain 008" (\() => faultsAre ((\() => ((90 / 9) + 12.0)), 22.0, ""))
test "mixed float value chain 009" (\() => faultsAre ((\() => ((110 / 10) + 13.0)), 24.0, ""))
test "mixed float value chain 010" (\() => faultsAre ((\() => ((132 / 11) + 14.0)), 26.0, ""))

twoFaultSweep ()
policySweep ()

test "policy observes arithmetic value and faults 001" (\() => faultsAre ((\() => (10 + 3)), 13, ""))
test "policy observes arithmetic value and faults 002" (\() => faultsAre ((\() => (20 + 4)), 24, ""))
test "policy observes arithmetic value and faults 003" (\() => faultsAre ((\() => (30 + 5)), 35, ""))
test "policy observes arithmetic value and faults 004" (\() => faultsAre ((\() => (40 + 6)), 46, ""))
test "policy observes arithmetic value and faults 005" (\() => faultsAre ((\() => (50 + 7)), 57, ""))
test "policy observes arithmetic value and faults 006" (\() => faultsAre ((\() => (6 / 0)), -0.5, "zero(/,6.0);"))
test "policy observes arithmetic value and faults 007" (\() => faultsAre ((\() => ((runtimeValue (9223372036854775807)) + 7)), -9223372036854775802, "overflow(+,9223372036854775807,7,-9223372036854775802);"))
test "policy observes arithmetic value and faults 008" (\() => faultsAre ((\() => (8 / 0)), -0.5, "zero(/,8.0);"))
test "policy observes arithmetic value and faults 009" (\() => faultsAre ((\() => ((runtimeValue (9223372036854775807)) + 9)), -9223372036854775800, "overflow(+,9223372036854775807,9,-9223372036854775800);"))
test "policy observes arithmetic value and faults 010" (\() => faultsAre ((\() => (10 / 0)), -0.5, "zero(/,10.0);"))
test "literal negation is a plain int" (\() => faultsAre ((\() => -(7)), -7, ""))
test "runtime negation is a plain int" (\() => faultsAre ((\() => (negateValue (7))), -7, ""))

