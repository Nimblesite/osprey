/// Adds two integers; the caller's `Arith` policy answers an overflow.
/// # Examples
/// ```osprey
/// let wrapping = handler Arith { overflow _ _ _ wrapped => wrapped }
/// print("${wrapping(fn() => add(2, 3))}")
/// ```
/// ```output
/// 5
/// ```
/// ```osprey
/// let saturating = handler Arith { overflow _ _ _ _ => 9223372036854775807 }
/// let total = saturating(fn() => add(1, 2))
/// ```
fn add(a, b) = a + b
/// Doubles an integer for reusable pipeline stages.
/// # Examples
/// ```osprey
/// let wrapping = handler Arith { overflow _ _ _ wrapped => wrapped }
/// print("${wrapping(fn() => double(3))}")
/// ```
/// ```output
/// 6
/// ```
fn double(x) = x * 2
/// Classifies an integer through total modulo arithmetic and boolean matching.
fn parity(n) = match n % 2 == 0 {
    true => "even"
    false => "odd"
}

/// Checks positive, negative, nested, boundary, and relational arithmetic together.
fn additionCase() = {
    let subtotal = add(10, 20)
    // One batch keeps seven independent arithmetic assertions compact.
    checkAll("addition state", [
        add(2, 3) == 5,
        add(-1, 1) == 0,
        add(subtotal, -5) == 25,
        add(0, 0) == 0,
        add(1000, -250) == 750,
        add(4, 5) > add(2, 3),
        !(add(-2, 1) > 0)
    ])
}

/// Checks chained functions, inline lambdas, negatives, and derived predicates.
fn pipelineCase() = {
    let six = 3 |> double
    // Every condition is reported separately even though the syntax is grouped.
    checkAll("pipeline state", [
        (10 |> double |> double) == 40,
        (5 |> fn(x) => x + 100) == 105,
        (six |> fn(x) => add(x, 4)) == 10,
        (-2 |> double |> double) == -8,
        (6 |> double |> fn(x) => x == 12),
        (1 |> double |> double) > 0
    ])
}

/// Checks pattern branches alongside computed inputs and interpolation.
fn patternCase() = {
    // The batch covers both branches and several cross-feature compositions.
    checkAll("pattern state", [
        parity(4) == "even",
        parity(7) == "odd",
        parity(add(5, 5)) == "even",
        "${parity(3)}:${double(3)}" == "odd:6",
        parity(double(9)) == "even",
        parity(3) != parity(4)
    ])
}

/// Exact-value tests record any arithmetic fault as a failed assertion.
let exactArithmetic = handler Arith {
    overflow op _ _ wrapped => {
        check("unexpected arithmetic overflow", "none", op)
        wrapped
    }
}

// Register the mixed arithmetic interaction.
test("arithmetic composes across calls", fn() => exactArithmetic(additionCase))
// Register the multi-stage pipeline interaction.
test("pipes and lambdas compose", fn() => exactArithmetic(pipelineCase))
// Register the matching and rendering interaction.
test("matching, interpolation and calls interact", fn() => exactArithmetic(patternCase))
