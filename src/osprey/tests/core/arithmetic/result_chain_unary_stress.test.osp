test("overflow precedes division error 001", fn() => verify(fn() => ((runtimeValue(9223372036854775807) + 1) + (1 / 0)), -9223372036854775808.0, "overflow(+,9223372036854775807,1,-9223372036854775808);zero(/,1.0);"))
test("remainder error precedes overflow 001", fn() => verify(fn() => ((1 % 0) * (runtimeValue(9223372036854775807) + 1)), 0, "remainder(1);overflow(+,9223372036854775807,1,-9223372036854775808);"))
test("multiply overflow precedes remainder error 001", fn() => verify(fn() => ((runtimeValue(9223372036854775807) * 2) % 0), 0, "overflow(*,9223372036854775807,2,-2);remainder(-2);"))
test("division error precedes multiply overflow 001", fn() => verify(fn() => ((1 / 0) + (runtimeValue(9223372036854775807) * 2)), -2.5, "zero(/,1.0);overflow(*,9223372036854775807,2,-2);"))
test("late maximum overflow dispatches before right fault 001", fn() => verify(fn() => ((((runtimeValue(9223372036854775807) - 1) + 1) + 1) * (1 % 0)), 0, "overflow(+,9223372036854775807,1,-9223372036854775808);remainder(1);"))
