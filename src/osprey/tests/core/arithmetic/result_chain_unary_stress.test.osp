// Every original case now checks both the value and the complete ordered fault payloads.

/// Boundary operands cross a function call so runtime dispatch is exercised.
fn runtimeValue(n) = n
fn negateValue(n) = -n

fn verify(work, expected, wantedFaults) = {
    mut faults = ""
    handle Arith {
        overflow op lhs rhs wrapped => {
            faults = faults + "overflow(${op},${lhs},${rhs},${wrapped});"
            wrapped
        }
        divideByZero op lhs => {
            faults = faults + "zero(${op},${lhs});"
            -0.5
        }
        remainderByZero lhs => {
            faults = faults + "remainder(${lhs});"
            0
        }
    }
    expect(work(), expected)
    expect(faults, wantedFaults)
}

fn choose(work, replacement) = {
    handle Arith {
        overflow op lhs rhs wrapped => {
            let _ = perform Arith.overflow(op, lhs, rhs, wrapped)
            replacement
        }
    }
    work()
}

test("unary negation 001", fn() => verify(fn() => -(1), -1, ""))
test("double unary negation 001", fn() => verify(fn() => -(-(1)), 1, ""))
