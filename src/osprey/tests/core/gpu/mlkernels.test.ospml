    withBuffer(gpuMap(acts, relu), \clamped => withBuffer(gpuMap(acts, leaky), \leaked => checkAll("activations", [
    sumIs(clamped, toFloat32(3.5)), elementIs(clamped, 0, toFloat32(9.9), toFloat32(0.0)), gpuLengthIs(gpuFilter(acts, isActive), 2), sumIs(leaked, toFloat32(2.5)), elementsFrom(leaked, 0, toFloat32(0.0), [toFloat32(0.0) - toFloat32(0.75), toFloat32(2.5), toFloat32(0.0) - toFloat32(0.25)]), sumsTo(gpuMap(acts, \x => relu(x) - slope * relu(toFloat32(0.0) - x)), toFloat32(2.5)), sumsTo(gpuMap(acts, \x => cap - relu(cap - relu(x))), toFloat32(3.0)), sumsTo(gpuMap(input1, relu), toFloat32(0.0)), sumsTo(gpuMap(input2, relu), toFloat32(3.0)), sumsTo(gpuMap(acts, \x => slope * relu(x)), toFloat32(1.75)), gpuSatisfies(gpuMap(acts, \x => relu(toFloat32(0.0) - x)), \reflected => gpuSatisfies(fromGpu(reflected), \values => structuralEquals(values, [toFloat32(1.5), toFloat32(0.0), toFloat32(0.5), toFloat32(0.0)])))
    ])))
(** softmaxCase pins the pipeline by its properties, not its digits: a *)
(** distribution, order-preserving, shift-invariant, uniform on a flat vector. *)
softmaxCase () = withBuffer(xs3(), \input0 => upload([toFloat32(5.0), toFloat32(5.0), toFloat32(5.0)], \input1 => softmaxCaseUploaded(input0, input1)))
softmaxCaseUploaded (input0, input1) =
    scores = input0
    softmaxEach(scores, \probs => withBuffer(gpuMap(scores, \s => toFloat32(10.0) + s), \raised => softmaxEach(raised, \shifted => softmaxEach(input1, \flat => checkAll("softmax pipeline", [
    lengthIs(probs, 3), sumOf(probs, \total => total > toFloat32(0.9999999)), sumOf(probs, \total => total < toFloat32(1.0000001)), at(probs, 0) > toFloat32(0.0), at(probs, 2) < toFloat32(1.0), at(probs, 1) > at(probs, 0), at(probs, 2) > at(probs, 1), elementIs(probs, 0, toFloat32(0.0), (gpuGet(shifted, 0) ?: toFloat32(9.9))), elementIs(probs, 2, toFloat32(0.0), (gpuGet(shifted, 2) ?: toFloat32(9.9))), gpuLengthIs(gpuFilter(probs, \p => p > toFloat32(0.5)), 1), elementIs(flat, 0, toFloat32(0.0), (gpuGet(flat, 2) ?: toFloat32(9.9))), sumOf(flat, \total => total > toFloat32(0.9999999))
    ])))))
(** matVecCase multiplies through iota + gather: identity, zero matrix, 1x1, a *)
(** zero-column walk, and a row past the end, which pads to zero. *)
matVecCase () = withIndices(0, \rows0 => withIndices(1, \rows1 => withIndices(2, \rows2 => withIndices(3, \rows3 => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)], \input0 => upload([toFloat32(1.0), toFloat32(1.0), toFloat32(2.0)], \input1 => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0)], \input2 => upload([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)], \input3 => upload([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)], \input4 => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], \input5 => upload([toFloat32(5.0), toFloat32(5.0)], \input6 => upload([toFloat32(5.0)], \input7 => upload([toFloat32(3.0)], \input8 => withBuffer(xs3(), \input9 => matVecCaseUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9)))))))))))))))
matVecCaseUploaded (rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9) =
    m = input0
    v = input1
    eye = input2
    matVecEach(m, v, 3, rows2, \out => checkAll("matrix-vector", [
    lengthIs(out, 2), elementsFrom(out, 0, toFloat32(0.0), [toFloat32(9.0), toFloat32(21.0)]), sumIs(out, toFloat32(30.0)), matVecOf(eye, input3, 3, rows3, \identity => sumIs(identity, toFloat32(24.0))), matVecOf(eye, input4, 3, rows3, \identity => elementIs(identity, 1, toFloat32(0.0), toFloat32(8.0))), matVecOf(input5, input6, 2, rows2, \zeros => sumIs(zeros, toFloat32(0.0))), matVecOf(input7, input8, 1, rows1, \single => elementIs(single, 0, toFloat32(0.0), toFloat32(15.0))), matVecOf(m, v, 3, rows3, \padded => elementIs(padded, 2, toFloat32(9.9), toFloat32(0.0))), matVecOf(m, v, 3, rows0, \noRows => lengthIs(noRows, 0)), matVecOf(m, v, 0, rows2, \noColumns => sumIs(noColumns, toFloat32(0.0))), gpuSatisfies(gpuZipWith(input9, v, mulF), \products => sumOf(products, \hand => matVecOf(m, v, 3, rows2, \first => elementIs(first, 0, toFloat32(0.0), hand))))
    ]))
(** layerCase runs a two-layer forward pass; the first layer's negative unit must *)
(** be silenced by relu before the second layer sees it. *)
layerCase () = withIndices(0, \rows0 => withIndices(1, \rows1 => withIndices(2, \rows2 => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0), toFloat32(0.5), toFloat32(0.5), toFloat32(0.5)], \input0 => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)], \input1 => upload([toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)], \input2 => upload([toFloat32(2.0), toFloat32(0.25)], \input3 => upload([toFloat32(0.5)], \input4 => upload([toFloat32(0.0), toFloat32(0.0)], \input5 => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], \input6 => upload([toFloat32(1.0), toFloat32(2.0)], \input7 => upload([toFloat32(1.0)], \input8 => layerCaseUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8)))))))))))))
layerCaseUploaded (rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8) =
    w1 = input0
    x = input1
    denseEach(w1, x, 3, rows2, input2, \h => denseEach(input3, h, 2, rows1, input4, \out => checkAll("dense layers", [
    lengthIs(h, 2), elementIs(h, 0, toFloat32(9.9), toFloat32(0.0)), elementIs(h, 1, toFloat32(0.0), toFloat32(4.0)), sumIs(h, toFloat32(4.0)), gpuLengthIs(gpuFilter(h, isActive), 1), lengthIs(out, 1), elementIs(out, 0, toFloat32(0.0), toFloat32(1.5)), matVecOf(w1, x, 3, rows2, \rows => elementIs(rows, 0, toFloat32(0.0), toFloat32(0.0) - toFloat32(4.0))), matVecOf(w1, x, 3, rows2, \rows => elementIs(rows, 1, toFloat32(0.0), toFloat32(6.0))), denseOf(w1, x, 3, rows2, input5, \zeros => sumIs(zeros, toFloat32(6.0))), denseOf(w1, input6, 3, rows2, input7, \shifted => sumIs(shifted, toFloat32(3.0))), denseOf(w1, x, 3, rows0, input8, \noRows => lengthIs(noRows, 0))
    ])))
(** trainCase descends from both sides of the true weight and pins the loss *)
(** surface: the optimum is a fixed point, the loss is symmetric about it. *)
trainCase () = withBuffer(xs3(), \input0 => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)], \input1 => trainCaseUploaded(input0, input1)))
trainCaseUploaded (input0, input1) =
    xs = input0
    ys = input1
    trainEach(toFloat32(0.0), xs, ys, 40, \w => trainEach(toFloat32(5.0), xs, ys, 40, \hi => checkAll("gradient descent", [
    w - toFloat32(2.0) < toFloat32(0.01), toFloat32(2.0) - w < toFloat32(0.01), w > toFloat32(1.0), hi - toFloat32(2.0) < toFloat32(0.01), toFloat32(2.0) - hi < toFloat32(0.01), hi < toFloat32(3.0), trainOf(toFloat32(2.0), xs, ys, 0, \start => start == toFloat32(2.0)), trainOf(toFloat32(2.0), xs, ys, 10, \settled => settled == toFloat32(2.0)), gradStepOf(toFloat32(2.0), xs, ys, \stepped => stepped == toFloat32(2.0)), mseOf(toFloat32(2.0), xs, ys, \loss => loss == toFloat32(0.0)), mseOf(toFloat32(3.0), xs, ys, \above => mseOf(toFloat32(1.0), xs, ys, \below => above == below)), mseOf(toFloat32(0.0), xs, ys, \unfit => mseOf(w, xs, ys, \fitted => unfit > fitted))
    ])))
exactTests [
{ name = "dot product fuses zip and fold", work = dotCase },
{ name = "saxpy runs elementwise over buffer pairs", work = saxpyCase },
{ name = "a kernel closes over one host scalar", work = captureScalarCase },
{ name = "one kernel closes over several distinct scalars", work = captureManyCase },
{ name = "one capture is spent by every combinator", work = captureSharedCase },
{ name = "a capture folded from one buffer drives a kernel over another", work = captureFoldedCase },
{ name = "captures survive gather, nesting, branching and shadowing", work = captureShapeCase },
{ name = "degenerate captures stay total on empty and ragged buffers", work = captureDegenerateCase },
{ name = "weighted sums normalise through a captured weight total", work = weightedSumCase },
{ name = "mean centering pipes a scalar back into a kernel", work = meanCase },
{ name = "variance and z-scores normalise a feature column", work = varianceCase },
{ name = "min-max rescaling captures both folded extremes", work = normalizeCase },
{ name = "relu clamps, leaks and counts active units", work = reluCase },
{ name = "a softmax-shaped pipeline is a shift-invariant distribution", work = softmaxCase },
{ name = "matrix-vector product gathers rows via iota", work = matVecCase },
{ name = "dense layers stack bias and activation over gathered rows", work = layerCase },
{ name = "gradient descent converges on the true weight", work = trainCase }
]
