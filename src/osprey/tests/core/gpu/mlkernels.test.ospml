(** [FAILURE-EXPLICIT] A failed allocation, combinator or reduction stops the case before its consumer. *)
withBuffer (result, work) = match result
    Success value => work value
    Error message => check ("GPU operation", "success", toString message)
(** [FAILURE-EXPLICIT] A GPU failure fails the predicate with its reason. *)
gpuSatisfies (result, predicate) = match result
    Success value => predicate value
    Error message =>
        check ("GPU operation", "success", toString message)
        false
(** Match allocation errors at the case boundary; no continuation or fallback buffer. *)
withIndices (n, work) = withBuffer (gpuIota n, work)
// AI/ML workloads on the GPU surface and the closure captures they are made
// of: dot products, SAXPY, weighted sums, mean and variance, normalisation,
// activations, a softmax-shaped pipeline, dense layers, matrix-vector products
// via gather, and a gradient-descent training loop ([GPU-KERNEL-FORM],
// [GPU-MAP], [GPU-ZIPWITH], [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-IOTA],
// [GPU-GET], [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
//
// The capture is the load-bearing shape. [GPU-KERNEL-FORM] names "a closure
// capturing enclosing locals (a folded scalar piped back into a gpuMap)" as a
// kernel form the purity proof must accept, so every statistic below is folded
// out of one buffer and spent inside a kernel over another: a mean into a
// centering pass, a maximum into a softmax shift, a weight total into a
// normalising divide — values staged beside the buffer, never shared state.
(** The float reduction and the elementwise product every sum and dot use. *)
addF (a, x) = a + x
mulF (x, y) = x * y
(** Fold a buffer to its extremes: what a shift and a rescale capture. *)
maxF (a, x: float32) =
    match x > a
        true => x
        false => a
minF (a, x: float32) =
    match x < a
        true => x
        false => a
(** relu clamps negatives to zero; isActive marks what a layer lets through. *)
relu x = match x > toFloat32 0.0
    true => x
    false => toFloat32 0.0
isActive x = x > toFloat32 0.0
(** at reads a matrix element, treating out of bounds as zero padding; sumOf and
    meanOf are the folded statistics the kernels capture, and meanOf's checked
    division is what keeps an empty buffer total instead of partial. *)
at (m, i) = gpuGet (m, i) ?: toFloat32 0.0
sumOf (xs, predicate) = gpuSatisfies(gpuFold (xs, toFloat32 0.0, addF), predicate)
(** Empty statistics and zero-spread normalisation choose an explicit boundary value. *)
degenerate (value, work) =
    handle Arith
        divideByZero _ _ => value
    work ()
meanOf (xs, predicate) = sumOf(xs, \total => predicate(degenerate(0.0, \() => total / toFloat32 (gpuLength xs))))
(** dotOf is BLAS level 1: fuse an elementwise product into a reduction, which is
    the shape varianceOf reuses twice — fold a mean, then capture it inside the
    kernel measuring squared deviation from it. *)
dotOf (xs, ys, predicate) = gpuSatisfies(gpuZipWith (xs, ys, mulF), \products => sumOf(products, predicate))
varianceOf (xs, predicate) = meanOf(xs, \mean => gpuSatisfies(gpuMap (xs, \v => (v - mean) * (v - mean)), \deviations => meanOf(deviations, predicate)))
(** saxpy is the classic a*x + y with a = 2.0. *)
saxpy (x, y) = toFloat32 2.0 * x + y
(** softWeight weights a score already shifted by the batch maximum, so d >= 0. *)
softWeight d = (toFloat32 1.0 / (toFloat32 1.0 + d + d * d))
(** softmaxEach is four stages, two of them captures: fold the maximum, spend it
    in the shift, fold the partition function, spend that in the divide. Each
    capture binds through a match, never through an enclosing closure. *)
softmaxEach (scores, work) =
    match gpuFold(scores, gpuGet(scores, 0) ?: toFloat32(0.0), maxF)
        Success peak => match gpuMap(scores, \s => softWeight(peak - s))
            Success weights => match gpuFold(weights, toFloat32(0.0), addF)
                Success partition => withBuffer(gpuMap(weights, \w => (w / partition) ), work)
                Error message => check("GPU operation", "success", toString(message))
            Error message => check("GPU operation", "success", toString(message))
        Error message => check("GPU operation", "success", toString(message))
(** rowDot walks one row of a flat row-major matrix against a vector. The
    recursion carries the same captured buffers through every column. *)
rowDot (m, v, cols, r, c) = match c == cols
    true => toFloat32 0.0
    false => (at (m, (((r * cols) ) + c) ) * at (v, c) + rowDot (m, v, cols, r, (c + 1) ))
(** matVecEach gathers every row's dot product: one kernel invocation per row. *)
matVecEach (m, v, cols, indices, work) = withBuffer(gpuMap (indices, \r => rowDot (m, v, cols, r, 0)), work)
matVecOf (m, v, cols, indices, predicate) = gpuSatisfies(gpuMap (indices, \r => rowDot (m, v, cols, r, 0)), predicate)
(** denseEach is one MLP layer: gather rows, add bias elementwise, then activate. *)
denseEach (m, v, cols, indices, bias, work) = matVecEach(m, v, cols, indices, \rows => withBuffer(gpuZipWith (rows, bias, addF), \biased => withBuffer(gpuMap (biased, relu), work)))
denseOf (m, v, cols, indices, bias, predicate) = matVecOf(m, v, cols, indices, \rows => gpuSatisfies(gpuZipWith (rows, bias, addF), \biased => gpuSatisfies(gpuMap (biased, relu), predicate)))
(** mseOf is the loss the training loop descends; w is captured by the residual. *)
mseOf (w, xs: GpuBuffer<float32>, ys, predicate) = gpuSatisfies(gpuZipWith (xs, ys, \(x, y) => (w * x - y) * (w * x - y)), \residuals => meanOf(residuals, predicate))
(** gradStepEach is one epoch of least-squares descent on y = w * x; its kernel
    captures the current weight. *)
gradStepEach (w, xs: GpuBuffer<float32>, ys, work) =
    match gpuZipWith(xs, ys, \(x, y) => toFloat32(2.0) * (w * x - y) * x)
        Success residuals => match gpuFold(residuals, toFloat32(0.0), addF)
            Success total => work(w - toFloat32(0.05) * (total / toFloat32(3.0)))
            Error message => check("GPU operation", "success", toString(message))
        Error message => check("GPU operation", "success", toString(message))
gradStepOf (w, xs: GpuBuffer<float32>, ys, predicate) = gpuSatisfies(gpuZipWith (xs, ys, \(x, y) => toFloat32 2.0 * (w * x - y) * x), \residuals => sumOf(residuals, \total => predicate(w - toFloat32 0.05 * (total / toFloat32 3.0))))
(** trainEach iterates gradStepEach n times, keeping the loop on buffers. *)
trainEach (w, xs, ys, n, work) = match n
    0 => work w
    _ => gradStepEach(w, xs, ys, \stepped => trainEach (stepped, xs, ys, (n - 1), work))
trainOf (w, xs, ys, n, predicate) = match n
    0 => predicate w
    _ => gradStepOf(w, xs, ys, \stepped => trainOf (stepped, xs, ys, (n - 1), predicate))
(** Pin the fused product-and-reduce over orthogonal, negated, zeroed, singleton,
    empty and ragged operands. *)
dotCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([toFloat32 4.0, toFloat32 5.0, toFloat32 6.0]), \input1 => withBuffer(toGpu ([]), \input2 => withBuffer(toGpu ([]), \input3 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0, toFloat32 0.0]), \input4 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 0.0, toFloat32 0.0 - toFloat32 1.0]), \input5 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 1.0]), \input6 => withBuffer(toGpu ([toFloat32 0.0 - toFloat32 1.0, toFloat32 2.0]), \input7 => withBuffer(toGpu ([toFloat32 3.0, toFloat32 0.0 - toFloat32 4.0]), \input8 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 2.0]), \input9 => withBuffer(toGpu ([toFloat32 0.5]), \input10 => withBuffer(toGpu ([toFloat32 0.5]), \input11 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 0.0, toFloat32 0.0]), \input12 => withBuffer(toGpu ([toFloat32 1.0]), \input13 => dotCaseUploaded(input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13)))))))))))))))
dotCaseUploaded (input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13) =
    xs = input0
    ys = input1
    checkAll "dot product" [
        dotOf(xs, ys, \total => total == toFloat32 32.0), dotOf(ys, xs, \total => total == toFloat32 32.0), dotOf(xs, xs, \total => total == toFloat32 14.0),
        dotOf(input2, input3, \total => total == toFloat32 0.0), dotOf(xs, input4, \total => total == toFloat32 0.0), dotOf(input5, input6, \total => total == toFloat32 0.0),
        dotOf(input7, input8, \total => total == toFloat32 0.0 - toFloat32 11.0), dotOf(xs, input9, \total => total == toFloat32 6.0),
        dotOf(input10, input11, \total => total == toFloat32 0.25), dotOf(input12, ys, \total => total == toFloat32 4.0),
        gpuSatisfies(gpuZipWith (xs, ys, mulF), \products => gpuLength products == 3), gpuSatisfies(gpuZipWith (xs, input13, mulF), \products => gpuLength products == 1)
    ]
(** Pin BLAS saxpy, then the same shape with the scale factor captured —
    including alphas zero and one, which reduce to projections. *)
saxpyCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([toFloat32 10.0, toFloat32 20.0, toFloat32 30.0]), \input1 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 1.0, toFloat32 1.0]), \input2 => withBuffer(toGpu ([toFloat32 10.0, toFloat32 20.0]), \input3 => withBuffer(toGpu ([]), \input4 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0, toFloat32 0.0]), \input5 => saxpyCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
saxpyCaseUploaded (input0, input1, input2, input3, input4, input5) =
    alpha = toFloat32 0.5
    xs = input0
    withBuffer(gpuZipWith (xs, input1, saxpy), \out => withBuffer(gpuZipWith (xs, input2, \(x, y) => alpha * x + y), \axpy => checkAll "saxpy" [
        sumOf(out, \total => total == toFloat32 72.0), (gpuGet (out, 0) ?: toFloat32 0.0) == toFloat32 12.0, (gpuGet (out, 2) ?: toFloat32 0.0) == toFloat32 36.0, gpuLength out == 3,
        sumOf(axpy, \total => total == toFloat32 6.0), (gpuGet (axpy, 0) ?: toFloat32 0.0) == toFloat32 1.5, (gpuGet (axpy, 2) ?: toFloat32 0.0) == toFloat32 2.5,
        gpuSatisfies(gpuZipWith (xs, xs, \(x, y) => toFloat32 0.0 * x + y), \zeros => sumOf(zeros, \total => total == toFloat32 6.0)),
        gpuSatisfies(gpuZipWith (xs, xs, \(x, y) => toFloat32 1.0 * x + y), \twice => sumOf(twice, \total => total == toFloat32 12.0)),
        gpuSatisfies(gpuZipWith (xs, input3, saxpy), \ragged => sumOf(ragged, \total => total == toFloat32 36.0)),
        gpuSatisfies(gpuZipWith (input4, xs, saxpy), \empty => gpuLength empty == 0),
        gpuSatisfies(gpuZipWith (xs, input5, \(x, y) => alpha * x + y), \projected => sumOf(projected, \total => total == toFloat32 3.0))
    ]))
(** The first acceptance shape: one host scalar closed over by a kernel, spent
    by map, filter, fold and scan, empty buffer included. *)
captureScalarCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([]), \input1 => captureScalarCaseUploaded(input0, input1)))
captureScalarCaseUploaded (input0, input1) =
    k = toFloat32 3.0
    xs = input0
    withBuffer(gpuMap (xs, \x => k * x), \scaled => withBuffer(gpuMap (xs, \x => k * x + k), \twice => checkAll "captured scalar" [
        sumOf(scaled, \total => total == toFloat32 18.0), (gpuGet (scaled, 1) ?: toFloat32 0.0) == toFloat32 6.0, gpuLength scaled == 3,
        sumOf(twice, \total => total == toFloat32 27.0), (gpuGet (twice, 2) ?: toFloat32 0.0) == toFloat32 12.0,
        gpuSatisfies(gpuMap (scaled, \y => k * y), \rescaled => sumOf(rescaled, \total => total == toFloat32 54.0)),
        gpuSatisfies(gpuMap (xs, \x => k + x), \bumped => sumOf(bumped, \total => total == toFloat32 15.0)),
        gpuSatisfies(gpuFilter (xs, \x => x > k), \above => gpuLength above == 0),
        gpuSatisfies(gpuFilter (xs, \x => k > x), \below => gpuLength below == 2),
        gpuSatisfies(gpuMap (input1, \x => k * x), \empty => gpuLength empty == 0),
        gpuSatisfies(gpuFold (xs, toFloat32 0.0, \(a, x) => a + k * x), \total => total == toFloat32 18.0),
        gpuSatisfies(gpuScan (xs, toFloat32 0.0, \(a, x) => a + k * x), \prefix => (gpuGet (prefix, 2) ?: toFloat32 0.0) == toFloat32 18.0)
    ]))
(** Put several distinct captures inside one kernel, in different orders and
    arities, so no single-capture shortcut can pass this. *)
captureManyCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => captureManyCaseUploaded(input0))
captureManyCaseUploaded (input0) =
    a = toFloat32 2.0
    b = toFloat32 5.0
    c = toFloat32 0.5
    xs = input0
    withBuffer(gpuMap (xs, \x => (a * x + b) * c), \affine => checkAll "several captures" [
        (gpuGet (affine, 0) ?: toFloat32 0.0) == toFloat32 3.5, (gpuGet (affine, 1) ?: toFloat32 0.0) == toFloat32 4.5,
        (gpuGet (affine, 2) ?: toFloat32 0.0) == toFloat32 5.5, sumOf(affine, \total => total == toFloat32 13.5), gpuLength affine == 3,
        gpuSatisfies(gpuMap (xs, \x => c * x + b - a), \shifted => sumOf(shifted, \total => total == toFloat32 12.0)),
        gpuSatisfies(gpuMap (xs, \x => a * x + b * c), \mixed => sumOf(mixed, \total => total == toFloat32 19.5)),
        gpuSatisfies(gpuMap (xs, \x => a * c * x), \oneScale => sumOf(oneScale, \total => total == toFloat32 6.0)),
        gpuSatisfies(gpuMap (xs, \x => b - a * x - c), \inverted => sumOf(inverted, \total => total == toFloat32 1.5)),
        gpuSatisfies(gpuZipWith (xs, xs, \(x, y) => a * x + c * y), \zipped => sumOf(zipped, \total => total == toFloat32 15.0)),
        gpuSatisfies(gpuFold (xs, b, \(acc, x) => acc + c * x), \total => total == toFloat32 8.0)
    ])
(** Spend one capture across every combinator and then again in a chained pass,
    so it must survive being staged more than once. *)
captureSharedCase () = withIndices(4, \indices4 => captureSharedWith(indices4))
captureSharedWith (indices4) = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0, toFloat32 4.0]), \input0 => captureSharedWithUploaded(indices4, input0))
captureSharedWithUploaded (indices4, input0) =
    t = toFloat32 2.0
    xs = input0
    withBuffer(gpuScan (xs, toFloat32 0.0, \(acc, x) => acc + t * x), \scanned => withBuffer(gpuFilter (xs, \x => x > t), \kept => checkAll "shared capture" [
        gpuSatisfies(gpuMap (xs, \x => t * x), \scaled => sumOf(scaled, \total => total == toFloat32 20.0)),
        gpuLength kept == 2, sumOf(kept, \total => total == toFloat32 7.0), (gpuGet (kept, 0) ?: toFloat32 0.0) == toFloat32 3.0,
        gpuSatisfies(gpuFold (xs, toFloat32 0.0, \(acc, x) => acc + t * x), \total => total == toFloat32 20.0),
        (gpuGet (scanned, 0) ?: toFloat32 0.0) == toFloat32 2.0, (gpuGet (scanned, 3) ?: toFloat32 0.0) == toFloat32 20.0, gpuLength scanned == 4,
        gpuSatisfies(gpuZipWith (xs, xs, \(x, y) => t * x * y), \products => sumOf(products, \total => total == toFloat32 60.0)),
        gpuSatisfies(gpuMap (indices4, \i => t * toFloat32 i), \scaledIndices => sumOf(scaledIndices, \total => total == toFloat32 12.0)),
        gpuSatisfies(gpuFilter (xs, \x => t > x), \small => gpuLength small == 1),
        gpuSatisfies(gpuMap (xs, \x => t * x), \scaled => gpuSatisfies(gpuFilter (scaled, \y => y > t), \keptScaled => sumOf(keptScaled, \total => total == toFloat32 18.0)))
    ]))
(** The shape [GPU-KERNEL-FORM] spells out: the capture is itself a fold over
    another buffer — a sum, a maximum and a minimum off `ws`. *)
captureFoldedCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 3.0, toFloat32 4.0, toFloat32 8.0]), \input0 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0]), \input1 => withBuffer(toGpu ([]), \input2 => captureFoldedCaseUploaded(input0, input1, input2))))
captureFoldedCaseUploaded (input0, input1, input2) =
    ws = input0
    xs = input1
    match gpuFold (ws, toFloat32 0.0, addF)
        Success total =>
            match gpuFold (ws, gpuGet (ws, 0) ?: toFloat32 0.0, maxF)
                Success peak =>
                    checkAll "capture folded from another buffer" [
                        total == toFloat32 16.0, peak == toFloat32 8.0,
                        gpuSatisfies(gpuMap (xs, \x => (x / total) ), \share => sumOf(share, \normalised => normalised == toFloat32 0.375)),
                        gpuSatisfies(gpuMap (xs, \x => (x / total) ), \share => (gpuGet (share, 0) ?: toFloat32 0.0) == toFloat32 0.125),
                        gpuSatisfies(gpuMap (xs, \x => x - peak), \centred => sumOf(centred, \total => total == toFloat32 0.0 - toFloat32 10.0)),
                        gpuSatisfies(gpuMap (xs, \x => peak * x), \amplified => sumOf(amplified, \total => total == toFloat32 48.0)),
                        gpuSatisfies(gpuFold (ws, toFloat32 0.0, minF), \low => low == toFloat32 0.0),
                        gpuSatisfies(gpuFold (ws, gpuGet (ws, 0) ?: toFloat32 0.0, minF), \low => low == toFloat32 1.0),
                        gpuSatisfies(gpuMap (ws, \w => (w / total) ), \share => sumOf(share, \unity => unity == toFloat32 1.0)),
                        gpuSatisfies(gpuFilter (ws, \w => w * toFloat32 4.0 >= total), \heavy => gpuLength heavy == 2),
                        gpuSatisfies(gpuZipWith (xs, xs, mulF), \products => gpuSatisfies(gpuMap (products, \p => (p / total) ), \share => sumOf(share, \part => part == toFloat32 1.25))),
                        gpuSatisfies(gpuFold (input2, total, addF), \empty => empty == toFloat32 16.0)
                    ]
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Push on the form a capture arrives in: a buffer captured for gather
    (out-of-range reads padding to zero), a capture read from a nested lambda,
    one reached only through a match branch, and a shadowing parameter. *)
captureShapeCase () = withIndices(5, \indices5 => withIndices(3, \indices3 => captureShapeWith(indices5, indices3)))
captureShapeWith (indices5, indices3) = withBuffer(toGpu ([toFloat32 10.0, toFloat32 20.0, toFloat32 30.0]), \input0 => captureShapeWithUploaded(indices5, indices3, input0))
captureShapeWithUploaded (indices5, indices3, input0) =
    k = toFloat32 3.0
    w = input0
    branch = \x => match x > toFloat32 15.0
        true => k
        false => x
    withBuffer(gpuMap (indices5, \i => gpuGet (w, i) ?: toFloat32 0.0), \gathered => checkAll "capture forms" [
        sumOf(gathered, \total => total == toFloat32 60.0), (gpuGet (gathered, 3) ?: toFloat32 9.9) == toFloat32 0.0,
        (gpuGet (gathered, 4) ?: toFloat32 9.9) == toFloat32 0.0, gpuLength gathered == 5,
        gpuSatisfies(gpuMap (w, branch), \branched => sumOf(branched, \total => total == toFloat32 16.0)),
        gpuSatisfies(gpuMap (indices3, \i => k * (gpuGet (w, i) ?: toFloat32 0.0)), \nested => sumOf(nested, \total => total == toFloat32 180.0)),
        gpuSatisfies(gpuMap (indices3, \i => k * (gpuGet (w, i) ?: toFloat32 0.0)), \nested => (gpuGet (nested, 2) ?: toFloat32 0.0) == toFloat32 90.0),
        gpuSatisfies(gpuMap (w, \x => (\z => k * z) x), \inner => sumOf(inner, \total => total == toFloat32 180.0)),
        gpuSatisfies(gpuMap (w, \k => toFloat32 2.0 * k), \shadowed => sumOf(shadowed, \total => total == toFloat32 120.0)),
        gpuSatisfies(gpuMap (indices3, toFloat32), \asFloats => gpuSatisfies(gpuZipWith (w, asFloats, \(x, i) => x - k * i), \differenced => sumOf(differenced, \total => total == toFloat32 51.0))),
        gpuSatisfies(gpuFold (w, toFloat32 0.0, \(a, x) => a + (\z => toFloat32 0.5 * z) x), \total => total == toFloat32 30.0),
        gpuSatisfies(gpuFilter (w, \x => (\z => z > k) x), \large => gpuLength large == 3)
    ])
(** The boundary sweep: a captured zero divisor whose checked division must
    surface as its fallback rather than an infinity, the identity captures, an
    unread capture, and empty/ragged operands under one. *)
captureDegenerateCase () = withIndices(0, \emptyIndices => captureDegenerateWith(emptyIndices))
captureDegenerateWith (emptyIndices) = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([]), \input1 => withBuffer(toGpu ([]), \input2 => withBuffer(toGpu ([toFloat32 5.0]), \input3 => withBuffer(toGpu ([]), \input4 => withBuffer(toGpu ([toFloat32 7.0]), \input5 => captureDegenerateWithUploaded(emptyIndices, input0, input1, input2, input3, input4, input5)))))))
captureDegenerateWithUploaded (emptyIndices, input0, input1, input2, input3, input4, input5) =
    zero = toFloat32 0.0
    one = toFloat32 1.0
    xs = input0
    withBuffer(degenerate(0.0 - 1.0, \() => gpuMap (xs, \x => x / zero)), \divided => checkAll "degenerate captures" [
        sumOf(divided, \total => total == toFloat32 0.0 - toFloat32 3.0), (gpuGet (divided, 0) ?: toFloat32 0.0) == toFloat32 0.0 - toFloat32 1.0,
        gpuSatisfies(gpuMap (xs, \x => zero * x), \zeroed => sumOf(zeroed, \total => total == toFloat32 0.0)),
        gpuSatisfies(gpuMap (xs, \x => one * x), \identity => sumOf(identity, \total => total == toFloat32 6.0)),
        gpuSatisfies(gpuMap (xs, \x => zero + x), \summed => sumOf(summed, \total => total == toFloat32 6.0)),
        gpuSatisfies(gpuMap (xs, \_x => one), \ones => sumOf(ones, \total => total == toFloat32 3.0)),
        gpuSatisfies(gpuFilter (input1, \x => x > zero), \kept => gpuLength kept == 0),
        gpuSatisfies(gpuFold (input2, one, \(a, x) => a + zero * x), \total => total == toFloat32 1.0),
        gpuSatisfies(gpuMap (input3, \x => one * x), \scaled => sumOf(scaled, \total => total == toFloat32 5.0)),
        gpuSatisfies(gpuZipWith (xs, input4, \(x, y) => zero * x + y), \empty => gpuLength empty == 0),
        gpuSatisfies(gpuZipWith (input5, xs, \(x, y) => one * x + y), \shortest => gpuLength shortest == 1),
        gpuSatisfies(gpuMap (emptyIndices, \i => one * toFloat32 i), \empty => sumOf(empty, \total => total == toFloat32 0.0))
    ])
(** Pin weighted sum and weighted mean: the weight total is folded once,
    captured by the normalising kernel, and both routes must agree. *)
weightedSumCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0, toFloat32 4.0]), \input0 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 4.0, toFloat32 1.0]), \input1 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0, toFloat32 8.0, toFloat32 16.0]), \input2 => withBuffer(toGpu ([toFloat32 0.5, toFloat32 0.25, toFloat32 0.125, toFloat32 0.125]), \input3 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0, toFloat32 0.0, toFloat32 0.0]), \input4 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 1.0, toFloat32 1.0, toFloat32 1.0]), \input5 => weightedSumCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
weightedSumCaseUploaded (input0, input1, input2, input3, input4, input5) =
    vals = input0
    ws = input1
    match gpuFold(ws, toFloat32(0.0), addF)
        Success wtot => match gpuMap(ws, \w => (w / wtot) )
            Success normw => checkAll("weighted sums", [
                wtot == toFloat32(8.0),
                dotOf(vals, ws, \total => total == toFloat32(21.0)),
                dotOf(vals, ws, \total => ((total / wtot) ) == toFloat32(2.625)),
                sumOf(normw, \total => total == toFloat32(1.0)),
                (gpuGet(normw, 2) ?: toFloat32(0.0)) == toFloat32(0.5),
                (gpuGet(normw, 0) ?: toFloat32(0.0)) == toFloat32(0.125),
                dotOf(vals, normw, \total => total == toFloat32(2.625)),
                dotOf(input2, input3, \total => total == toFloat32(5.0)),
                dotOf(vals, input4, \total => total == toFloat32(0.0)),
                dotOf(vals, input5, \total => sumOf(vals, \plain => total == plain)),
                gpuSatisfies(gpuZipWith(vals, ws, \(v, w) => wtot * v * w), \weighted => sumOf(weighted, \total => total == toFloat32(168.0))),
                gpuSatisfies(gpuMap(vals, \v => (v / wtot) ), \share => sumOf(share, \total => total == toFloat32(1.25)))
            ])
            Error message => check("GPU operation", "success", toString(message))
        Error message => check("GPU operation", "success", toString(message))
(** Center a feature column: the folded mean is captured by the centering
    kernel, and the centered column's own mean vanishes. *)
meanCase () = withIndices(9, \indices9 => meanWith(indices9))
meanWith (indices9) = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0, toFloat32 6.0]), \input0 => withBuffer(toGpu ([]), \input1 => withBuffer(toGpu ([toFloat32 5.0]), \input2 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0, toFloat32 4.0, toFloat32 4.0, toFloat32 5.0, toFloat32 5.0, toFloat32 7.0, toFloat32 9.0]), \input3 => meanWithUploaded(indices9, input0, input1, input2, input3)))))
meanWithUploaded (indices9, input0, input1, input2, input3) =
    xs = input0
    match gpuFold(xs, toFloat32(0.0), addF)
        Success folded =>
            mean = degenerate(0.0, \() => folded / toFloat32(gpuLength(xs)))
            match gpuMap(xs, \v => v - mean)
                Success centered => checkAll("mean centering", [
                    mean == toFloat32(3.0),
                    sumOf(centered, \total => total == toFloat32(0.0)),
                    (gpuGet(centered, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(2.0),
                    (gpuGet(centered, 3) ?: toFloat32(0.0)) == toFloat32(3.0),
                    gpuLength(centered) == 4,
                    meanOf(centered, \recentred => recentred == toFloat32(0.0)),
                    meanOf(input1, \empty => empty == toFloat32(0.0)),
                    meanOf(input2, \single => single == toFloat32(5.0)),
                    meanOf(input3, \column => column == toFloat32(5.0)),
                    gpuSatisfies(gpuMap(xs, \v => mean + v), \shifted => meanOf(shifted, \total => total == toFloat32(6.0))),
                    gpuSatisfies(gpuMap(indices9, toFloat32), \asFloats => meanOf(asFloats, \total => total == toFloat32(4.0))),
                    gpuSatisfies(gpuFilter(xs, \v => v > mean), \above => gpuLength(above) == 1)
                ])
                Error message => check("GPU operation", "success", toString(message))
        Error message => check("GPU operation", "success", toString(message))
(** Pin two-pass variance and the z-scores built on it: a normalised column has
    mean zero and variance one, and a constant column's zero deviation must fall
    back rather than divide. *)
varianceCase () = withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0, toFloat32 4.0, toFloat32 4.0, toFloat32 5.0, toFloat32 5.0, toFloat32 7.0, toFloat32 9.0]), \input0 => withBuffer(toGpu ([toFloat32 3.0, toFloat32 3.0, toFloat32 3.0]), \input1 => withBuffer(toGpu ([]), \input2 => withBuffer(toGpu ([toFloat32 3.0, toFloat32 3.0]), \input3 => varianceCaseUploaded(input0, input1, input2, input3)))))
varianceCaseUploaded (input0, input1, input2, input3) =
    xs = input0
    sd = toFloat32(2.0)
    match gpuFold(xs, toFloat32(0.0), addF)
        Success folded =>
            mean = degenerate(0.0, \() => folded / toFloat32(gpuLength(xs)))
            match gpuMap(xs, \v => ((v - mean) / sd) )
                Success z => checkAll("variance and z-scores", [
                    mean == toFloat32(5.0),
                    varianceOf(xs, \spread => spread == toFloat32(4.0)),
                    sd * sd == toFloat32(4.0),
                    sumOf(z, \total => total == toFloat32(0.0)),
                    (gpuGet(z, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(1.5),
                    (gpuGet(z, 4) ?: toFloat32(9.9)) == toFloat32(0.0),
                    (gpuGet(z, 7) ?: toFloat32(0.0)) == toFloat32(2.0),
                    meanOf(z, \centred => centred == toFloat32(0.0)),
                    varianceOf(z, \unit => unit == toFloat32(1.0)),
                    varianceOf(input1, \constant => constant == toFloat32(0.0)),
                    varianceOf(input2, \empty => empty == toFloat32(0.0)),
                    degenerate(0.0, \() => gpuSatisfies(gpuMap(input3, \v => (v - toFloat32(3.0)) / toFloat32(0.0)), \flat => sumOf(flat, \total => total == toFloat32(0.0))))
                ])
                Error message => check("GPU operation", "success", toString(message))
        Error message => check("GPU operation", "success", toString(message))
(** Pin the min-max rescale: both extremes are folded out and captured, and a
    constant column's zero range falls back instead of dividing. *)
normalizeCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 3.0, toFloat32 5.0, toFloat32 9.0]), \input0 => withBuffer(toGpu ([toFloat32 4.0, toFloat32 4.0]), \input1 => normalizeCaseUploaded(input0, input1)))
normalizeCaseUploaded (input0, input1) =
    xs = input0
    match gpuFold (xs, gpuGet (xs, 0) ?: toFloat32 0.0, minF)
        Success lo =>
            match gpuFold (xs, gpuGet (xs, 0) ?: toFloat32 0.0, maxF)
                Success hi =>
                    match gpuMap (xs, \v => ((v - lo) / (hi - lo)) )
                        Success scaled =>
                            checkAll "normalisation" [
                                lo == toFloat32 1.0, hi == toFloat32 9.0, (gpuGet (scaled, 0) ?: toFloat32 9.9) == toFloat32 0.0,
                                (gpuGet (scaled, 1) ?: toFloat32 0.0) == toFloat32 0.25, (gpuGet (scaled, 2) ?: toFloat32 0.0) == toFloat32 0.5,
                                (gpuGet (scaled, 3) ?: toFloat32 0.0) == toFloat32 1.0, sumOf(scaled, \total => total == toFloat32 1.75),
                                meanOf(scaled, \mean => mean == toFloat32 0.4375),
                                gpuSatisfies(gpuMap (xs, \v => ((hi - v) / (hi - lo)) ), \inverted => sumOf(inverted, \total => total == toFloat32 2.25)),
                                gpuSatisfies(gpuFold (xs, hi, minF), \lowest => lowest == toFloat32 1.0),
                                gpuSatisfies(gpuFilter (xs, \v => v > lo), \above => gpuLength above == 3),
                                degenerate(0.5, \() => gpuSatisfies(gpuMap (input1, \v => (v - toFloat32 4.0) / toFloat32 0.0), \flat => sumOf(flat, \total => total == toFloat32 1.0)))
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Pin clamping, active-unit counting, and a leaky variant whose slope is
    captured — spelled as a match and as arithmetic, which must agree. *)
reluCase () = withBuffer(toGpu ([toFloat32 0.0 - toFloat32 1.5, toFloat32 2.5, toFloat32 0.0 - toFloat32 0.5, toFloat32 1.0]), \input0 => withBuffer(toGpu ([toFloat32 0.0 - toFloat32 1.0, toFloat32 0.0 - toFloat32 2.0]), \input1 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0]), \input2 => reluCaseUploaded(input0, input1, input2))))
reluCaseUploaded (input0, input1, input2) =
    slope = toFloat32 0.5
    cap = toFloat32 2.0
    acts = input0
    leaky = \x => match x > toFloat32 0.0
        true => x
        false => slope * x
    withBuffer(gpuMap (acts, relu), \clamped => withBuffer(gpuMap (acts, leaky), \leaked => checkAll "activations" [
        sumOf(clamped, \total => total == toFloat32 3.5), (gpuGet (clamped, 0) ?: toFloat32 9.9) == toFloat32 0.0,
        gpuSatisfies(gpuFilter (acts, isActive), \active => gpuLength active == 2), sumOf(leaked, \total => total == toFloat32 2.5),
        (gpuGet (leaked, 0) ?: toFloat32 0.0) == toFloat32 0.0 - toFloat32 0.75, (gpuGet (leaked, 1) ?: toFloat32 0.0) == toFloat32 2.5,
        (gpuGet (leaked, 2) ?: toFloat32 0.0) == toFloat32 0.0 - toFloat32 0.25,
        gpuSatisfies(gpuMap (acts, \x => relu x - slope * relu (toFloat32 0.0 - x)), \blended => sumOf(blended, \total => total == toFloat32 2.5)),
        gpuSatisfies(gpuMap (acts, \x => cap - relu (cap - relu x)), \ceiling => sumOf(ceiling, \total => total == toFloat32 3.0)),
        gpuSatisfies(gpuMap (input1, relu), \negative => sumOf(negative, \total => total == toFloat32 0.0)),
        gpuSatisfies(gpuMap (input2, relu), \positive => sumOf(positive, \total => total == toFloat32 3.0)),
        gpuSatisfies(gpuMap (acts, \x => slope * relu x), \damped => sumOf(damped, \total => total == toFloat32 1.75)),
        gpuSatisfies(gpuMap (acts, \x => relu (toFloat32 0.0 - x)), \reflected => gpuSatisfies(fromGpu reflected, \values => structuralEquals(values, [toFloat32 1.5, toFloat32 0.0, toFloat32 0.5, toFloat32 0.0])))
    ]))
(** Pin the pipeline by its properties, not its digits: a distribution,
    order-preserving, shift-invariant, uniform on a flat vector. *)
softmaxCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([toFloat32 5.0, toFloat32 5.0, toFloat32 5.0]), \input1 => softmaxCaseUploaded(input0, input1)))
softmaxCaseUploaded (input0, input1) =
    scores = input0
    softmaxEach(scores, \probs => withBuffer(gpuMap(scores, \s => toFloat32(10.0) + s), \raised => softmaxEach(raised, \shifted => softmaxEach(input1, \flat => checkAll("softmax pipeline", [
        gpuLength(probs) == 3,
        gpuSatisfies(gpuFold(probs, toFloat32(0.0), addF), \total => total > toFloat32(0.9999999)),
        gpuSatisfies(gpuFold(probs, toFloat32(0.0), addF), \total => total < toFloat32(1.0000001)),
        (gpuGet(probs, 0) ?: toFloat32(0.0)) > toFloat32(0.0),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) < toFloat32(1.0),
        (gpuGet(probs, 1) ?: toFloat32(0.0)) > (gpuGet(probs, 0) ?: toFloat32(0.0)),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) > (gpuGet(probs, 1) ?: toFloat32(0.0)),
        (gpuGet(probs, 0) ?: toFloat32(0.0)) == (gpuGet(shifted, 0) ?: toFloat32(9.9)),
        (gpuGet(probs, 2) ?: toFloat32(0.0)) == (gpuGet(shifted, 2) ?: toFloat32(9.9)),
        gpuSatisfies(gpuFilter(probs, \p => p > toFloat32(0.5)), \peaked => gpuLength(peaked) == 1),
        (gpuGet(flat, 0) ?: toFloat32(0.0)) == (gpuGet(flat, 2) ?: toFloat32(9.9)),
        gpuSatisfies(gpuFold(flat, toFloat32(0.0), addF), \total => total > toFloat32(0.9999999))
    ])))))
(** Multiply through iota + gather: identity, zero matrix, 1x1, a zero-column
    walk, and a row past the end, which pads to zero. *)
matVecCase () = withIndices(0, \rows0 => withIndices(1, \rows1 => withIndices(2, \rows2 => withIndices(3, \rows3 => matVecWith(rows0, rows1, rows2, rows3)))))
matVecWith (rows0, rows1, rows2, rows3) = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0, toFloat32 4.0, toFloat32 5.0, toFloat32 6.0]), \input0 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 1.0, toFloat32 2.0]), \input1 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 0.0, toFloat32 0.0, toFloat32 0.0, toFloat32 1.0, toFloat32 0.0, toFloat32 0.0, toFloat32 0.0, toFloat32 1.0]), \input2 => withBuffer(toGpu ([toFloat32 7.0, toFloat32 8.0, toFloat32 9.0]), \input3 => withBuffer(toGpu ([toFloat32 7.0, toFloat32 8.0, toFloat32 9.0]), \input4 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0, toFloat32 0.0, toFloat32 0.0]), \input5 => withBuffer(toGpu ([toFloat32 5.0, toFloat32 5.0]), \input6 => withBuffer(toGpu ([toFloat32 5.0]), \input7 => withBuffer(toGpu ([toFloat32 3.0]), \input8 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input9 => matVecWithUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9)))))))))))
matVecWithUploaded (rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9) =
    m = input0
    v = input1
    eye = input2
    matVecEach(m, v, 3, rows2, \out => checkAll "matrix-vector" [
        gpuLength out == 2, (gpuGet (out, 0) ?: toFloat32 0.0) == toFloat32 9.0, (gpuGet (out, 1) ?: toFloat32 0.0) == toFloat32 21.0,
        sumOf(out, \total => total == toFloat32 30.0),
        matVecOf(eye, input3, 3, rows3, \identity => sumOf(identity, \total => total == toFloat32 24.0)),
        matVecOf(eye, input4, 3, rows3, \identity => (gpuGet (identity, 1) ?: toFloat32 0.0) == toFloat32 8.0),
        matVecOf(input5, input6, 2, rows2, \zeros => sumOf(zeros, \total => total == toFloat32 0.0)),
        matVecOf(input7, input8, 1, rows1, \single => (gpuGet (single, 0) ?: toFloat32 0.0) == toFloat32 15.0),
        matVecOf(m, v, 3, rows3, \padded => (gpuGet (padded, 2) ?: toFloat32 9.9) == toFloat32 0.0),
        matVecOf(m, v, 3, rows0, \noRows => gpuLength noRows == 0), matVecOf(m, v, 0, rows2, \noColumns => sumOf(noColumns, \total => total == toFloat32 0.0)),
        gpuSatisfies(gpuZipWith (input9, v, mulF), \products => sumOf(products, \hand => matVecOf(m, v, 3, rows2, \first => (gpuGet (first, 0) ?: toFloat32 0.0) == hand)))
    ])
(** Run a two-layer forward pass; the first layer's negative unit must be
    silenced by relu before the second layer sees it. *)
layerCase () = withIndices(0, \rows0 => withIndices(1, \rows1 => withIndices(2, \rows2 => layerWith(rows0, rows1, rows2))))
layerWith (rows0, rows1, rows2) = withBuffer(toGpu ([toFloat32 1.0, toFloat32 0.0, toFloat32 0.0 - toFloat32 1.0, toFloat32 0.5, toFloat32 0.5, toFloat32 0.5]), \input0 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0, toFloat32 6.0]), \input1 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 0.0 - toFloat32 2.0]), \input2 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 0.25]), \input3 => withBuffer(toGpu ([toFloat32 0.5]), \input4 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0]), \input5 => withBuffer(toGpu ([toFloat32 0.0, toFloat32 0.0, toFloat32 0.0]), \input6 => withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0]), \input7 => withBuffer(toGpu ([toFloat32 1.0]), \input8 => layerWithUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8))))))))))
layerWithUploaded (rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8) =
    w1 = input0
    x = input1
    denseEach(w1, x, 3, rows2, input2, \h => denseEach(input3, h, 2, rows1, input4, \out => checkAll "dense layers" [
        gpuLength h == 2, (gpuGet (h, 0) ?: toFloat32 9.9) == toFloat32 0.0, (gpuGet (h, 1) ?: toFloat32 0.0) == toFloat32 4.0,
        sumOf(h, \total => total == toFloat32 4.0), gpuSatisfies(gpuFilter (h, isActive), \active => gpuLength active == 1),
        gpuLength out == 1, (gpuGet (out, 0) ?: toFloat32 0.0) == toFloat32 1.5,
        matVecOf(w1, x, 3, rows2, \rows => (gpuGet (rows, 0) ?: toFloat32 0.0) == toFloat32 0.0 - toFloat32 4.0),
        matVecOf(w1, x, 3, rows2, \rows => (gpuGet (rows, 1) ?: toFloat32 0.0) == toFloat32 6.0),
        denseOf(w1, x, 3, rows2, input5, \zeros => sumOf(zeros, \total => total == toFloat32 6.0)),
        denseOf(w1, input6, 3, rows2, input7, \shifted => sumOf(shifted, \total => total == toFloat32 3.0)),
        denseOf(w1, x, 3, rows0, input8, \noRows => gpuLength noRows == 0)
    ]))
(** Descend from both sides of the true weight and pin the loss surface: the
    optimum is a fixed point, the loss is symmetric about it. *)
trainCase () = withBuffer(toGpu ([toFloat32 1.0, toFloat32 2.0, toFloat32 3.0]), \input0 => withBuffer(toGpu ([toFloat32 2.0, toFloat32 4.0, toFloat32 6.0]), \input1 => trainCaseUploaded(input0, input1)))
trainCaseUploaded (input0, input1) =
    xs = input0
    ys = input1
    trainEach(toFloat32 0.0, xs, ys, 40, \w => trainEach(toFloat32 5.0, xs, ys, 40, \hi => checkAll "gradient descent" [
        w - toFloat32 2.0 < toFloat32 0.01, toFloat32 2.0 - w < toFloat32 0.01, w > toFloat32 1.0, hi - toFloat32 2.0 < toFloat32 0.01,
        toFloat32 2.0 - hi < toFloat32 0.01, hi < toFloat32 3.0, trainOf(toFloat32 2.0, xs, ys, 0, \start => start == toFloat32 2.0),
        trainOf(toFloat32 2.0, xs, ys, 10, \settled => settled == toFloat32 2.0), gradStepOf(toFloat32 2.0, xs, ys, \stepped => stepped == toFloat32 2.0),
        mseOf(toFloat32 2.0, xs, ys, \loss => loss == toFloat32 0.0), mseOf(toFloat32 3.0, xs, ys, \above => mseOf(toFloat32 1.0, xs, ys, \below => above == below)),
        mseOf(toFloat32 0.0, xs, ys, \unfit => mseOf(w, xs, ys, \fitted => unfit > fitted))
    ]))
(** Exact-value tests record any arithmetic fault as a failed assertion. *)
test ("dot product fuses zip and fold", \() => exactArithmetic (dotCase))
test ("saxpy runs elementwise over buffer pairs", \() => exactArithmetic (saxpyCase))
test ("a kernel closes over one host scalar", \() => exactArithmetic (captureScalarCase))
test ("one kernel closes over several distinct scalars", \() => exactArithmetic (captureManyCase))
test ("one capture is spent by every combinator", \() => exactArithmetic (captureSharedCase))
test ("a capture folded from one buffer drives a kernel over another", \() => exactArithmetic (captureFoldedCase))
test ("captures survive gather, nesting, branching and shadowing", \() => exactArithmetic (captureShapeCase))
test ("degenerate captures stay total on empty and ragged buffers", \() => exactArithmetic (captureDegenerateCase))
test ("weighted sums normalise through a captured weight total", \() => exactArithmetic (weightedSumCase))
test ("mean centering pipes a scalar back into a kernel", \() => exactArithmetic (meanCase))
test ("variance and z-scores normalise a feature column", \() => exactArithmetic (varianceCase))
test ("min-max rescaling captures both folded extremes", \() => exactArithmetic (normalizeCase))
test ("relu clamps, leaks and counts active units", \() => exactArithmetic (reluCase))
test ("a softmax-shaped pipeline is a shift-invariant distribution", \() => exactArithmetic (softmaxCase))
test ("matrix-vector product gathers rows via iota", \() => exactArithmetic (matVecCase))
test ("dense layers stack bias and activation over gathered rows", \() => exactArithmetic (layerCase))
test ("gradient descent converges on the true weight", \() => exactArithmetic (trainCase))
