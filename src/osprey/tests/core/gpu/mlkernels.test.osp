// withBuffer, gpuSatisfies, withIndices and exactArithmetic are the testing
// prelude's [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the one
// shared copy, so this file declares none of its own.
// AI/ML workloads and their closure captures: dot products, SAXPY, weighted sums, mean and variance, normalisation,
// activations, a softmax-shaped pipeline, dense layers, matrix-vector products
// via gather, and a gradient-descent training loop ([GPU-KERNEL-FORM],
// [GPU-MAP], [GPU-ZIPWITH], [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-IOTA],
// [GPU-GET], [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
//
// The capture is the load-bearing shape. [GPU-KERNEL-FORM] names "a closure
// capturing enclosing locals (a folded scalar piped back into a gpuMap)" as a
// kernel form the purity proof must accept, so every statistic below is folded
// out of one buffer and spent inside a kernel over another: a mean into a
// centering pass, a maximum into a softmax shift, a weight total into a
// normalising divide — values staged beside the buffer, never shared state.
/// mulF is the elementwise product behind every dot product; sums use the
/// prelude's addF.
fn mulF(x, y) = x * y
/// maxF and minF fold a buffer to its extremes: the seeds a softmax shift and
/// a min-max rescale capture.
fn maxF(a, x: float32) = match x > a { true => x false => a }
fn minF(a, x: float32) = match x < a { true => x false => a }
/// relu clamps negative inputs to zero; isActive marks what a relu layer lets
/// through.
fn relu(x) = match x > toFloat32(0.0) { true => x false => toFloat32(0.0) }
fn isActive(x) = x > toFloat32(0.0)
/// at reads a buffer element, treating out of bounds as zero padding; sumOf and
/// meanOf are the folded statistics the kernels capture, and meanFrom's checked
/// division is what keeps an empty buffer total instead of partial.
fn at(m, i) = gpuGet(m, i) ?: toFloat32(0.0)
fn sumOf(xs, predicate) = gpuSatisfies(gpuFold(xs, toFloat32(0.0), addF), predicate)
/// sumIs is the float reduction of `b`, which must total `expected`.
fn sumIs(b, expected) = sumOf(b, fn(total) => total == expected)
/// sumsTo is sumIs over a kernel stage's Result — the stage's own kernel stays
/// inline at its combinator call, the prelude's gpuLengthIs judging a length.
fn sumsTo(result, expected) = gpuSatisfies(result, fn(out) => sumIs(out, expected))
/// dotIs is the fused product-and-reduce of `a` and `b`, which must total `expected`.
fn dotIs(a, b, expected) = dotOf(a, b, fn(total) => total == expected)
/// meanIs is the folded mean of `b`, which must be `expected`.
fn meanIs(b, expected) = meanOf(b, fn(mean) => mean == expected)
/// varianceIs is the two-pass variance of `b`, which must be `expected`.
fn varianceIs(b, expected) = varianceOf(b, fn(spread) => spread == expected)
/// Empty statistics and zero-spread normalisation choose an explicit boundary value.
fn degenerate(value, work) = {
    handle Arith { divideByZero _ _ => value }
    work()
}
fn meanFrom(xs, total) = degenerate(0.0, fn() => total / toFloat32(gpuLength(xs)))
fn meanOf(xs, predicate) = sumOf(xs, fn(total) => predicate(meanFrom(xs, total)))
/// dotOf is BLAS level 1: fuse an elementwise product into a reduction, which is
/// the shape varianceOf reuses twice — fold a mean, then capture it inside the
/// kernel measuring squared deviation from it.
fn dotOf(xs, ys, predicate) = gpuSatisfies(gpuZipWith(xs, ys, mulF), fn(products) => sumOf(products, predicate))
fn varianceOf(xs, predicate) = meanOf(xs, fn(mean) => gpuSatisfies(gpuMap(xs, fn(v) => (v - mean) * (v - mean)), fn(deviations) => meanOf(deviations, predicate)))
/// saxpy is the classic a*x + y with a = 2.0.
fn saxpy(x, y) = toFloat32(2.0) * x + y
/// softWeight weights a score already shifted by the batch maximum, so d >= 0.
fn softWeight(d) = (toFloat32(1.0) / (toFloat32(1.0) + d + d * d))
/// softmaxEach is four stages, two of them captures: fold the maximum, spend it in
/// the shift, fold the partition function, spend that in the divide.
fn softmaxEach(scores, work) = match gpuFold(scores, at(scores, 0), maxF) {
    Success { peak } => match gpuMap(scores, fn(s) => softWeight(peak - s)) {
        Success { weights } => match gpuFold(weights, toFloat32(0.0), addF) {
            Success { partition } => withBuffer(gpuMap(weights, fn(w) => w / partition), work)
            Error { message } => gpuFailed(message)
        }
        Error { message } => gpuFailed(message)
    }
    Error { message } => gpuFailed(message)
}
/// rowDot walks one row of a flat row-major matrix against a vector. The
/// recursion carries the same captured buffers through every column.
fn rowDot(m, v, cols, r, c) = match c == cols {
    true => toFloat32(0.0)
    false => at(m, r * cols + c) * at(v, c) + rowDot(m, v, cols, r, c + 1)
}
/// matVecEach gathers every row's dot product: one kernel invocation per row.
fn matVecEach(m, v, cols, indices, work) = withBuffer(gpuMap(indices, fn(r) => rowDot(m, v, cols, r, 0)), work)
fn matVecOf(m, v, cols, indices, predicate) = gpuSatisfies(gpuMap(indices, fn(r) => rowDot(m, v, cols, r, 0)), predicate)
/// denseEach is one MLP layer: gather rows, add bias elementwise, then activate.
fn denseEach(m, v, cols, indices, bias, work) = matVecEach(m, v, cols, indices, fn(rows) => withBuffer(gpuZipWith(rows, bias, addF), fn(biased) => withBuffer(gpuMap(biased, relu), work)))
fn denseOf(m, v, cols, indices, bias, predicate) = matVecOf(m, v, cols, indices, fn(rows) => gpuSatisfies(gpuZipWith(rows, bias, addF), fn(biased) => gpuSatisfies(gpuMap(biased, relu), predicate)))
/// mseOf is the loss the training loop descends; w is captured by the residual.
fn mseOf(w, xs: GpuBuffer<float32>, ys, predicate) = gpuSatisfies(gpuZipWith(xs, ys, fn(x, y) => (w * x - y) * (w * x - y)), fn(residuals) => meanOf(residuals, predicate))
/// gradResidual is the per-example gradient of y = w * x, and descended turns
/// its folded total into the next weight: the pieces both descent forms share.
fn gradResidual(w: float32, xs, ys) = gpuZipWith(xs, ys, fn(x, y) => toFloat32(2.0) * (w * x - y) * x)
fn descended(w, total) = w - toFloat32(0.05) * (total / toFloat32(3.0))
/// gradStepEach is one epoch of least-squares descent on y = w * x; its
/// kernel captures the current weight.
fn gradStepEach(w, xs, ys, work) = withBuffer(gradResidual(w, xs, ys), fn(residuals) => withBuffer(gpuFold(residuals, toFloat32(0.0), addF), fn(total) => work(descended(w, total))))
fn gradStepOf(w, xs, ys, predicate) = gpuSatisfies(gradResidual(w, xs, ys), fn(residuals) => sumOf(residuals, fn(total) => predicate(descended(w, total))))
/// trainEach iterates gradStepEach n times, keeping the loop on buffers.
fn trainEach(w, xs, ys, n, work) = match n {
    0 => work(w)
    _ => gradStepEach(w, xs, ys, fn(stepped) => trainEach(stepped, xs, ys, n - 1, work))
}
fn trainOf(w, xs, ys, n, predicate) = match n {
    0 => predicate(w)
    _ => gradStepOf(w, xs, ys, fn(stepped) => trainOf(stepped, xs, ys, n - 1, predicate))
}
/// upload stages a host list on the GPU and hands the buffer to work: the
/// shape every case below uploads its inputs with.
fn upload(values, work) = withBuffer(toGpu(values), work)
/// withMean stages xs's folded mean — zero on an empty buffer, like meanOf —
/// for the kernels that capture it.
fn withMean(xs, work) = withBuffer(gpuFold(xs, toFloat32(0.0), addF), fn(total) => work(meanFrom(xs, total)))
/// xs3 uploads the three-element [1, 2, 3] column that most kernels below run
/// over; each call allocates its own buffer.
fn xs3() = toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)])
/// dotCase pins the fused product-and-reduce over orthogonal, negated, zeroed,
/// singleton, empty and ragged operands.
fn dotCase() = withBuffer(xs3(), fn(input0) => upload([toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)], fn(input1) => upload([], fn(input2) => upload([], fn(input3) => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], fn(input4) => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0)], fn(input5) => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(1.0)], fn(input6) => upload([toFloat32(0.0) - toFloat32(1.0), toFloat32(2.0)], fn(input7) => upload([toFloat32(3.0), toFloat32(0.0) - toFloat32(4.0)], fn(input8) => upload([toFloat32(2.0), toFloat32(2.0)], fn(input9) => upload([toFloat32(0.5)], fn(input10) => upload([toFloat32(0.5)], fn(input11) => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0)], fn(input12) => upload([toFloat32(1.0)], fn(input13) => dotCaseUploaded(input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13)))))))))))))))
fn dotCaseUploaded(input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13) = {
    let xs = input0
    let ys = input1
    checkAll("dot product", [
            dotIs(xs, ys, toFloat32(32.0)), dotIs(ys, xs, toFloat32(32.0)), dotIs(xs, xs, toFloat32(14.0)), dotIs(input2, input3, toFloat32(0.0)), dotIs(xs, input4, toFloat32(0.0)), dotIs(input5, input6, toFloat32(0.0)), dotIs(input7, input8, toFloat32(0.0) - toFloat32(11.0)), dotIs(xs, input9, toFloat32(6.0)), dotIs(input10, input11, toFloat32(0.25)), dotIs(input12, ys, toFloat32(4.0)), gpuLengthIs(gpuZipWith(xs, ys, mulF), 3), gpuLengthIs(gpuZipWith(xs, input13, mulF), 1)
    ])
}
/// saxpyCase pins BLAS saxpy, then the same shape with the scale factor
/// captured — including alphas zero and one, which reduce to projections.
fn saxpyCase() = withBuffer(xs3(), fn(input0) => upload([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)], fn(input1) => upload([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)], fn(input2) => upload([toFloat32(10.0), toFloat32(20.0)], fn(input3) => upload([], fn(input4) => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], fn(input5) => saxpyCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
fn saxpyCaseUploaded(input0, input1, input2, input3, input4, input5) = {
    let alpha = toFloat32(0.5)
    let xs = input0
    withBuffer(gpuZipWith(xs, input1, saxpy), fn(out) =>
        withBuffer(gpuZipWith(xs, input2, fn(x, y) => alpha * x + y), fn(axpy) =>
            checkAll("saxpy", [
                    sumIs(out, toFloat32(72.0)), elementsAt(out, toFloat32(0.0), [0, 2], [toFloat32(12.0), toFloat32(36.0)]), lengthIs(out, 3), sumIs(axpy, toFloat32(6.0)), elementsAt(axpy, toFloat32(0.0), [0, 2], [toFloat32(1.5), toFloat32(2.5)]), sumsTo(gpuZipWith(xs, xs, fn(x, y) => toFloat32(0.0) * x + y), toFloat32(6.0)), sumsTo(gpuZipWith(xs, xs, fn(x, y) => toFloat32(1.0) * x + y), toFloat32(12.0)), sumsTo(gpuZipWith(xs, input3, saxpy), toFloat32(36.0)), gpuLengthIs(gpuZipWith(input4, xs, saxpy), 0), sumsTo(gpuZipWith(xs, input5, fn(x, y) => alpha * x + y), toFloat32(3.0))
    ])))
}
/// captureScalarCase is the first acceptance shape: one host scalar closed over
/// by a kernel, spent by map, filter, fold and scan, empty buffer included.
fn captureScalarCase() = withBuffer(xs3(), fn(input0) => upload([], fn(input1) => captureScalarCaseUploaded(input0, input1)))
fn captureScalarCaseUploaded(input0, input1) = {
    let k = toFloat32(3.0)
    let xs = input0
    withBuffer(gpuMap(xs, fn(x) => k * x), fn(scaled) =>
        withBuffer(gpuMap(xs, fn(x) => k * x + k), fn(twice) =>
            checkAll("captured scalar", [
                    sumIs(scaled, toFloat32(18.0)), elementIs(scaled, 1, toFloat32(0.0), toFloat32(6.0)), lengthIs(scaled, 3), sumIs(twice, toFloat32(27.0)), elementIs(twice, 2, toFloat32(0.0), toFloat32(12.0)), sumsTo(gpuMap(scaled, fn(y) => k * y), toFloat32(54.0)), sumsTo(gpuMap(xs, fn(x) => k * x - k), toFloat32(9.0)), sumsTo(gpuMap(xs, fn(x) => k + x), toFloat32(15.0)), gpuLengthIs(gpuFilter(xs, fn(x) => x > k), 0), gpuLengthIs(gpuFilter(xs, fn(x) => k > x), 2), gpuLengthIs(gpuMap(input1, fn(x) => k * x), 0), gpuEquals(gpuFold(xs, toFloat32(0.0), fn(a, x) => a + k * x), toFloat32(18.0)), gpuSatisfies(gpuScan(xs, toFloat32(0.0), fn(a, x) => a + k * x), fn(prefix) => elementIs(prefix, 2, toFloat32(0.0), toFloat32(18.0)))
    ])))
}
/// captureManyCase puts several distinct captures inside one kernel, in
/// different orders and arities, so no single-capture shortcut can pass it.
fn captureManyCase() = withBuffer(xs3(), fn(input0) => captureManyCaseUploaded(input0))
fn captureManyCaseUploaded(input0) = {
    let a = toFloat32(2.0)
    let b = toFloat32(5.0)
    let c = toFloat32(0.5)
    let xs = input0
    withBuffer(gpuMap(xs, fn(x) => (a * x + b) * c), fn(affine) =>
        checkAll("several captures", [
                elementsFrom(affine, 0, toFloat32(0.0), [toFloat32(3.5), toFloat32(4.5), toFloat32(5.5)]), sumIs(affine, toFloat32(13.5)), lengthIs(affine, 3), sumsTo(gpuMap(xs, fn(x) => c * x + b - a), toFloat32(12.0)), sumsTo(gpuMap(xs, fn(x) => a * x + b * c), toFloat32(19.5)), sumsTo(gpuMap(xs, fn(x) => a * c * x), toFloat32(6.0)), sumsTo(gpuMap(xs, fn(x) => b - a * x - c), toFloat32(1.5)), sumsTo(gpuZipWith(xs, xs, fn(x, y) => a * x + c * y), toFloat32(15.0)), gpuEquals(gpuFold(xs, b, fn(acc, x) => acc + c * x), toFloat32(8.0))
    ]))
}
/// captureSharedCase spends one capture across every combinator and then again
/// in a chained pass, so it must survive being staged more than once.
fn captureSharedCase() = withIndices(4, fn(indices4) => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)], fn(input0) => captureSharedCaseUploaded(indices4, input0)))
fn captureSharedCaseUploaded(indices4, input0) = {
    let t = toFloat32(2.0)
    let xs = input0
    withBuffer(gpuScan(xs, toFloat32(0.0), fn(acc, x) => acc + t * x), fn(scanned) =>
        withBuffer(gpuFilter(xs, fn(x) => x > t), fn(kept) =>
            checkAll("shared capture", [
                    sumsTo(gpuMap(xs, fn(x) => t * x), toFloat32(20.0)), lengthIs(kept, 2), sumIs(kept, toFloat32(7.0)), elementIs(kept, 0, toFloat32(0.0), toFloat32(3.0)), gpuEquals(gpuFold(xs, toFloat32(0.0), fn(acc, x) => acc + t * x), toFloat32(20.0)), elementsAt(scanned, toFloat32(0.0), [0, 3], [toFloat32(2.0), toFloat32(20.0)]), lengthIs(scanned, 4), sumsTo(gpuZipWith(xs, xs, fn(x, y) => t * x * y), toFloat32(60.0)), sumsTo(gpuMap(indices4, fn(i) => t * toFloat32(i)), toFloat32(12.0)), gpuLengthIs(gpuFilter(xs, fn(x) => t > x), 1), gpuSatisfies(gpuMap(xs, fn(x) => t * x), fn(scaled) => sumsTo(gpuFilter(scaled, fn(y) => y > t), toFloat32(18.0)))
    ])))
}
/// captureFoldedCase is the shape [GPU-KERNEL-FORM] spells out: the capture is
/// itself a fold over another buffer — a sum, a maximum and a minimum off `ws`.
fn captureFoldedCase() = upload([toFloat32(1.0), toFloat32(3.0), toFloat32(4.0), toFloat32(8.0)], fn(input0) => upload([toFloat32(2.0), toFloat32(4.0)], fn(input1) => upload([], fn(input2) => captureFoldedCaseUploaded(input0, input1, input2))))
fn captureFoldedCaseUploaded(input0, input1, input2) = {
    let ws = input0
    let xs = input1
    withBuffer(gpuFold(ws, toFloat32(0.0), addF), fn(total) =>
        withBuffer(gpuFold(ws, at(ws, 0), maxF), fn(peak) =>
            checkAll("capture folded from another buffer", [
                    total == toFloat32(16.0), peak == toFloat32(8.0), sumsTo(gpuMap(xs, fn(x) => x / total), toFloat32(0.375)), gpuSatisfies(gpuMap(xs, fn(x) => x / total), fn(share) => elementIs(share, 0, toFloat32(0.0), toFloat32(0.125))), sumsTo(gpuMap(xs, fn(x) => x - peak), toFloat32(0.0) - toFloat32(10.0)), sumsTo(gpuMap(xs, fn(x) => peak * x), toFloat32(48.0)), gpuEquals(gpuFold(ws, toFloat32(0.0), minF), toFloat32(0.0)), gpuEquals(gpuFold(ws, at(ws, 0), minF), toFloat32(1.0)), sumsTo(gpuMap(ws, fn(w) => w / total), toFloat32(1.0)), gpuLengthIs(gpuFilter(ws, fn(w) => w * toFloat32(4.0) >= total), 2), gpuSatisfies(gpuZipWith(xs, xs, mulF), fn(products) => sumsTo(gpuMap(products, fn(p) => p / total), toFloat32(1.25))), gpuEquals(gpuFold(input2, total, addF), toFloat32(16.0))
    ])))
}
/// captureShapeCase pushes on the form a capture arrives in: a buffer captured
/// for gather (out-of-range reads padding to zero), a capture read from a nested
/// lambda, one reached only through a match branch, and a shadowing parameter.
fn captureShapeCase() = withIndices(5, fn(indices5) => withIndices(3, fn(indices3) => upload([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)], fn(input0) => captureShapeCaseUploaded(indices5, indices3, input0))))
fn captureShapeCaseUploaded(indices5, indices3, input0) = {
    let k = toFloat32(3.0)
    let w = input0
    let branch = fn(x) => match x > toFloat32(15.0) { true => k false => x }
    withBuffer(gpuMap(indices5, fn(i) => at(w, i)), fn(gathered) =>
        checkAll("capture forms", [
                sumIs(gathered, toFloat32(60.0)), elementsFrom(gathered, 3, toFloat32(9.9), [toFloat32(0.0), toFloat32(0.0)]), lengthIs(gathered, 5), sumsTo(gpuMap(w, branch), toFloat32(16.0)), sumsTo(gpuMap(indices3, fn(i) => k * at(w, i)), toFloat32(180.0)), gpuSatisfies(gpuMap(indices3, fn(i) => k * at(w, i)), fn(nested) => elementIs(nested, 2, toFloat32(0.0), toFloat32(90.0))), sumsTo(gpuMap(w, fn(x) => (fn(z) => k * z)(x)), toFloat32(180.0)), sumsTo(gpuMap(w, fn(k) => toFloat32(2.0) * k), toFloat32(120.0)), gpuSatisfies(gpuMap(indices3, toFloat32), fn(asFloats) => sumsTo(gpuZipWith(w, asFloats, fn(x, i) => x - k * i), toFloat32(51.0))), gpuEquals(gpuFold(w, toFloat32(0.0), fn(a, x) => a + (fn(z) => toFloat32(0.5) * z)(x)), toFloat32(30.0)), gpuLengthIs(gpuFilter(w, fn(x) => (fn(z) => z > k)(x)), 3)
    ]))
}
/// captureDegenerateCase is the boundary sweep: a captured zero divisor whose
/// checked division must surface as its fallback rather than an infinity, the
/// identity captures, an unread capture, and empty/ragged operands under one.
fn captureDegenerateCase() = withIndices(0, fn(emptyIndices) => withBuffer(xs3(), fn(input0) => upload([], fn(input1) => upload([], fn(input2) => upload([toFloat32(5.0)], fn(input3) => upload([], fn(input4) => upload([toFloat32(7.0)], fn(input5) => captureDegenerateCaseUploaded(emptyIndices, input0, input1, input2, input3, input4, input5))))))))
fn captureDegenerateCaseUploaded(emptyIndices, input0, input1, input2, input3, input4, input5) = {
    let zero = toFloat32(0.0)
    let one = toFloat32(1.0)
    let xs = input0
    withBuffer(degenerate(0.0 - 1.0, fn() => gpuMap(xs, fn(x) => x / zero)), fn(divided) =>
        checkAll("degenerate captures", [
                sumIs(divided, toFloat32(0.0) - toFloat32(3.0)), elementIs(divided, 0, toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0)), sumsTo(gpuMap(xs, fn(x) => zero * x), toFloat32(0.0)), sumsTo(gpuMap(xs, fn(x) => one * x), toFloat32(6.0)), sumsTo(gpuMap(xs, fn(x) => zero + x), toFloat32(6.0)), sumsTo(gpuMap(xs, fn(_x) => one), toFloat32(3.0)), gpuLengthIs(gpuFilter(input1, fn(x) => x > zero), 0), gpuEquals(gpuFold(input2, one, fn(a, x) => a + zero * x), toFloat32(1.0)), sumsTo(gpuMap(input3, fn(x) => one * x), toFloat32(5.0)), gpuLengthIs(gpuZipWith(xs, input4, fn(x, y) => zero * x + y), 0), gpuLengthIs(gpuZipWith(input5, xs, fn(x, y) => one * x + y), 1), sumsTo(gpuMap(emptyIndices, fn(i) => one * toFloat32(i)), toFloat32(0.0))
    ]))
}
/// weightedSumCase pins weighted sum and weighted mean: the weight total is
/// folded once, captured by the normalising kernel, and both routes must agree.
fn weightedSumCase() = upload([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)], fn(input0) => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(4.0), toFloat32(1.0)], fn(input1) => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(8.0), toFloat32(16.0)], fn(input2) => upload([toFloat32(0.5), toFloat32(0.25), toFloat32(0.125), toFloat32(0.125)], fn(input3) => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], fn(input4) => upload([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)], fn(input5) => weightedSumCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
fn weightedSumCaseUploaded(input0, input1, input2, input3, input4, input5) = {
    let vals = input0
    let ws = input1
    withBuffer(gpuFold(ws, toFloat32(0.0), addF), fn(wtot) =>
        withBuffer(gpuMap(ws, fn(w) => w / wtot), fn(normw) =>
            checkAll("weighted sums", [
                    wtot == toFloat32(8.0), dotIs(vals, ws, toFloat32(21.0)), dotOf(vals, ws, fn(total) => total / wtot == toFloat32(2.625)), sumIs(normw, toFloat32(1.0)), elementsAt(normw, toFloat32(0.0), [2, 0], [toFloat32(0.5), toFloat32(0.125)]), dotIs(vals, normw, toFloat32(2.625)), dotIs(input2, input3, toFloat32(5.0)), dotIs(vals, input4, toFloat32(0.0)), dotOf(vals, input5, fn(total) => sumOf(vals, fn(plain) => total == plain)), sumsTo(gpuZipWith(vals, ws, fn(v, w) => wtot * v * w), toFloat32(168.0)), sumsTo(gpuMap(vals, fn(v) => v / wtot), toFloat32(1.25))
    ])))
