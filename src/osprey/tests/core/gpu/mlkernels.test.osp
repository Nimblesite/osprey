/// meanCase centers a feature column: the folded mean is captured by the
/// centering kernel, and the centered column's own mean vanishes.
fn meanCase() = withIndices(9, fn(indices9) => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(6.0)], fn(input0) => upload([], fn(input1) => upload([toFloat32(5.0)], fn(input2) => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)], fn(input3) => meanCaseUploaded(indices9, input0, input1, input2, input3))))))
fn meanCaseUploaded(indices9, input0, input1, input2, input3) = {
    let xs = input0
    withMean(xs, fn(mean) =>
        withBuffer(gpuMap(xs, fn(v) => v - mean), fn(centered) =>
            checkAll("mean centering", [
                    mean == toFloat32(3.0), sumIs(centered, toFloat32(0.0)), elementIs(centered, 0, toFloat32(9.9), toFloat32(0.0) - toFloat32(2.0)), elementIs(centered, 3, toFloat32(0.0), toFloat32(3.0)), lengthIs(centered, 4), meanIs(centered, toFloat32(0.0)), meanIs(input1, toFloat32(0.0)), meanIs(input2, toFloat32(5.0)), meanIs(input3, toFloat32(5.0)), gpuSatisfies(gpuMap(xs, fn(v) => mean + v), fn(shifted) => meanIs(shifted, toFloat32(6.0))), gpuSatisfies(gpuMap(indices9, toFloat32), fn(asFloats) => meanIs(asFloats, toFloat32(4.0))), gpuLengthIs(gpuFilter(xs, fn(v) => v > mean), 1)
    ])))
}
/// varianceCase pins two-pass variance and the z-scores built on it: a
/// normalised column has mean zero and variance one, and a constant column's
/// zero deviation must fall back rather than divide.
fn varianceCase() = upload([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)], fn(input0) => upload([toFloat32(3.0), toFloat32(3.0), toFloat32(3.0)], fn(input1) => upload([], fn(input2) => upload([toFloat32(3.0), toFloat32(3.0)], fn(input3) => varianceCaseUploaded(input0, input1, input2, input3)))))
fn varianceCaseUploaded(input0, input1, input2, input3) = {
    let xs = input0
    let sd = toFloat32(2.0)
    withMean(xs, fn(mean) =>
        withBuffer(gpuMap(xs, fn(v) => (v - mean) / sd), fn(z) =>
            checkAll("variance and z-scores", [
                    mean == toFloat32(5.0), varianceIs(xs, toFloat32(4.0)), sd * sd == toFloat32(4.0), sumIs(z, toFloat32(0.0)), elementsAt(z, toFloat32(9.9), [0, 4], [toFloat32(0.0) - toFloat32(1.5), toFloat32(0.0)]), elementIs(z, 7, toFloat32(0.0), toFloat32(2.0)), meanIs(z, toFloat32(0.0)), varianceIs(z, toFloat32(1.0)), varianceIs(input1, toFloat32(0.0)), varianceIs(input2, toFloat32(0.0)), degenerate(0.0, fn() => gpuSatisfies(gpuMap(input3, fn(v) => (v - toFloat32(3.0)) / toFloat32(0.0)), fn(flat) => sumIs(flat, toFloat32(0.0))))
    ])))
}
/// normalizeCase pins the min-max rescale: both extremes are folded out and
/// captured, and a constant column's zero range falls back instead of dividing.
fn normalizeCase() = upload([toFloat32(1.0), toFloat32(3.0), toFloat32(5.0), toFloat32(9.0)], fn(input0) => upload([toFloat32(4.0), toFloat32(4.0)], fn(input1) => normalizeCaseUploaded(input0, input1)))
fn normalizeCaseUploaded(input0, input1) = {
    let xs = input0
    withBuffer(gpuFold(xs, at(xs, 0), minF), fn(lo) =>
        withBuffer(gpuFold(xs, at(xs, 0), maxF), fn(hi) =>
            withBuffer(gpuMap(xs, fn(v) => (v - lo) / (hi - lo)), fn(scaled) =>
                checkAll("normalisation", [
                        lo == toFloat32(1.0), hi == toFloat32(9.0), elementIs(scaled, 0, toFloat32(9.9), toFloat32(0.0)), elementsFrom(scaled, 1, toFloat32(0.0), [toFloat32(0.25), toFloat32(0.5), toFloat32(1.0)]), sumIs(scaled, toFloat32(1.75)), meanIs(scaled, toFloat32(0.4375)), sumsTo(gpuMap(xs, fn(v) => (hi - v) / (hi - lo)), toFloat32(2.25)), gpuEquals(gpuFold(xs, hi, minF), toFloat32(1.0)), gpuLengthIs(gpuFilter(xs, fn(v) => v > lo), 3), degenerate(0.5, fn() => gpuSatisfies(gpuMap(input1, fn(v) => (v - toFloat32(4.0)) / toFloat32(0.0)), fn(flat) => sumIs(flat, toFloat32(1.0))))
    ]))))
}
/// Compare clamping and active-unit counts with captured slopes and reflected inputs.
fn reluCase() = upload([toFloat32(0.0) - toFloat32(1.5), toFloat32(2.5), toFloat32(0.0) - toFloat32(0.5), toFloat32(1.0)], fn(input0) => upload([toFloat32(0.0) - toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)], fn(input1) => upload([toFloat32(1.0), toFloat32(2.0)], fn(input2) => reluCaseUploaded(input0, input1, input2))))
fn reluCaseUploaded(input0, input1, input2) = {
    let slope = toFloat32(0.5)
    let cap = toFloat32(2.0)
    let acts = input0
    let leaky = fn(x) => match x > toFloat32(0.0) { true => x false => slope * x }
    withBuffer(gpuMap(acts, relu), fn(clamped) =>
        withBuffer(gpuMap(acts, leaky), fn(leaked) =>
            checkAll("activations", [
                    sumIs(clamped, toFloat32(3.5)), elementIs(clamped, 0, toFloat32(9.9), toFloat32(0.0)), gpuLengthIs(gpuFilter(acts, isActive), 2), sumIs(leaked, toFloat32(2.5)), elementsFrom(leaked, 0, toFloat32(0.0), [toFloat32(0.0) - toFloat32(0.75), toFloat32(2.5), toFloat32(0.0) - toFloat32(0.25)]), sumsTo(gpuMap(acts, fn(x) => relu(x) - slope * relu(toFloat32(0.0) - x)), toFloat32(2.5)), sumsTo(gpuMap(acts, fn(x) => cap - relu(cap - relu(x))), toFloat32(3.0)), sumsTo(gpuMap(input1, relu), toFloat32(0.0)), sumsTo(gpuMap(input2, relu), toFloat32(3.0)), sumsTo(gpuMap(acts, fn(x) => slope * relu(x)), toFloat32(1.75)), gpuSatisfies(gpuMap(acts, fn(x) => relu(toFloat32(0.0) - x)), fn(reflected) => gpuSatisfies(fromGpu(reflected), fn(values) => structuralEquals(values, [toFloat32(1.5), toFloat32(0.0), toFloat32(0.5), toFloat32(0.0)])))
    ])))
}
/// softmaxCase pins the pipeline by its properties, not its digits: a
/// distribution, order-preserving, shift-invariant, uniform on a flat vector.
fn softmaxCase() = withBuffer(xs3(), fn(input0) => upload([toFloat32(5.0), toFloat32(5.0), toFloat32(5.0)], fn(input1) => softmaxCaseUploaded(input0, input1)))
fn softmaxCaseUploaded(input0, input1) = {
    let scores = input0
    softmaxEach(scores, fn(probs) =>
        withBuffer(gpuMap(scores, fn(s) => toFloat32(10.0) + s), fn(raised) =>
            softmaxEach(raised, fn(shifted) =>
                softmaxEach(input1, fn(flat) =>
                    checkAll("softmax pipeline", [
                            lengthIs(probs, 3), sumOf(probs, fn(total) => total > toFloat32(0.9999999)), sumOf(probs, fn(total) => total < toFloat32(1.0000001)), at(probs, 0) > toFloat32(0.0), at(probs, 2) < toFloat32(1.0), at(probs, 1) > at(probs, 0), at(probs, 2) > at(probs, 1), elementIs(probs, 0, toFloat32(0.0), (gpuGet(shifted, 0) ?: toFloat32(9.9))), elementIs(probs, 2, toFloat32(0.0), (gpuGet(shifted, 2) ?: toFloat32(9.9))), gpuLengthIs(gpuFilter(probs, fn(p) => p > toFloat32(0.5)), 1), elementIs(flat, 0, toFloat32(0.0), (gpuGet(flat, 2) ?: toFloat32(9.9))), sumOf(flat, fn(total) => total > toFloat32(0.9999999))
    ])))))
}
/// matVecCase multiplies through iota + gather: identity, zero matrix, 1x1, a
/// zero-column walk, and a row past the end, which pads to zero.
fn matVecCase() = withIndices(0, fn(rows0) => withIndices(1, fn(rows1) => withIndices(2, fn(rows2) => withIndices(3, fn(rows3) => upload([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)], fn(input0) => upload([toFloat32(1.0), toFloat32(1.0), toFloat32(2.0)], fn(input1) => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0)], fn(input2) => upload([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)], fn(input3) => upload([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)], fn(input4) => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], fn(input5) => upload([toFloat32(5.0), toFloat32(5.0)], fn(input6) => upload([toFloat32(5.0)], fn(input7) => upload([toFloat32(3.0)], fn(input8) => withBuffer(xs3(), fn(input9) => matVecCaseUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9)))))))))))))))
fn matVecCaseUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9) = {
    let m = input0
    let v = input1
    let eye = input2
    matVecEach(m, v, 3, rows2, fn(out) =>
        checkAll("matrix-vector", [
                lengthIs(out, 2), elementsFrom(out, 0, toFloat32(0.0), [toFloat32(9.0), toFloat32(21.0)]), sumIs(out, toFloat32(30.0)), matVecOf(eye, input3, 3, rows3, fn(identity) => sumIs(identity, toFloat32(24.0))), matVecOf(eye, input4, 3, rows3, fn(identity) => elementIs(identity, 1, toFloat32(0.0), toFloat32(8.0))), matVecOf(input5, input6, 2, rows2, fn(zeros) => sumIs(zeros, toFloat32(0.0))), matVecOf(input7, input8, 1, rows1, fn(single) => elementIs(single, 0, toFloat32(0.0), toFloat32(15.0))), matVecOf(m, v, 3, rows3, fn(padded) => elementIs(padded, 2, toFloat32(9.9), toFloat32(0.0))), matVecOf(m, v, 3, rows0, fn(noRows) => lengthIs(noRows, 0)), matVecOf(m, v, 0, rows2, fn(noColumns) => sumIs(noColumns, toFloat32(0.0))), gpuSatisfies(gpuZipWith(input9, v, mulF), fn(products) => sumOf(products, fn(hand) => matVecOf(m, v, 3, rows2, fn(first) => elementIs(first, 0, toFloat32(0.0), hand))))
    ]))
}
/// layerCase runs a two-layer forward pass; the first layer's negative unit must
/// be silenced by relu before the second layer sees it.
fn layerCase() = withIndices(0, fn(rows0) => withIndices(1, fn(rows1) => withIndices(2, fn(rows2) => upload([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0), toFloat32(0.5), toFloat32(0.5), toFloat32(0.5)], fn(input0) => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)], fn(input1) => upload([toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)], fn(input2) => upload([toFloat32(2.0), toFloat32(0.25)], fn(input3) => upload([toFloat32(0.5)], fn(input4) => upload([toFloat32(0.0), toFloat32(0.0)], fn(input5) => upload([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)], fn(input6) => upload([toFloat32(1.0), toFloat32(2.0)], fn(input7) => upload([toFloat32(1.0)], fn(input8) => layerCaseUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8)))))))))))))
fn layerCaseUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8) = {
    let w1 = input0
    let x = input1
    denseEach(w1, x, 3, rows2, input2, fn(h) =>
        denseEach(input3, h, 2, rows1, input4, fn(out) =>
            checkAll("dense layers", [
                    lengthIs(h, 2), elementIs(h, 0, toFloat32(9.9), toFloat32(0.0)), elementIs(h, 1, toFloat32(0.0), toFloat32(4.0)), sumIs(h, toFloat32(4.0)), gpuLengthIs(gpuFilter(h, isActive), 1), lengthIs(out, 1), elementIs(out, 0, toFloat32(0.0), toFloat32(1.5)), matVecOf(w1, x, 3, rows2, fn(rows) => elementIs(rows, 0, toFloat32(0.0), toFloat32(0.0) - toFloat32(4.0))), matVecOf(w1, x, 3, rows2, fn(rows) => elementIs(rows, 1, toFloat32(0.0), toFloat32(6.0))), denseOf(w1, x, 3, rows2, input5, fn(zeros) => sumIs(zeros, toFloat32(6.0))), denseOf(w1, input6, 3, rows2, input7, fn(shifted) => sumIs(shifted, toFloat32(3.0))), denseOf(w1, x, 3, rows0, input8, fn(noRows) => lengthIs(noRows, 0))
    ])))
}
/// trainCase descends from both sides of the true weight and pins the loss
/// surface: the optimum is a fixed point, the loss is symmetric about it.
fn trainCase() = withBuffer(xs3(), fn(input0) => upload([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)], fn(input1) => trainCaseUploaded(input0, input1)))
fn trainCaseUploaded(input0, input1) = {
    let xs = input0
    let ys = input1
    trainEach(toFloat32(0.0), xs, ys, 40, fn(w) =>
        trainEach(toFloat32(5.0), xs, ys, 40, fn(hi) =>
            checkAll("gradient descent", [
                    w - toFloat32(2.0) < toFloat32(0.01), toFloat32(2.0) - w < toFloat32(0.01), w > toFloat32(1.0), hi - toFloat32(2.0) < toFloat32(0.01), toFloat32(2.0) - hi < toFloat32(0.01), hi < toFloat32(3.0), trainOf(toFloat32(2.0), xs, ys, 0, fn(start) => start == toFloat32(2.0)), trainOf(toFloat32(2.0), xs, ys, 10, fn(settled) => settled == toFloat32(2.0)), gradStepOf(toFloat32(2.0), xs, ys, fn(stepped) => stepped == toFloat32(2.0)), mseOf(toFloat32(2.0), xs, ys, fn(loss) => loss == toFloat32(0.0)), mseOf(toFloat32(3.0), xs, ys, fn(above) => mseOf(toFloat32(1.0), xs, ys, fn(below) => above == below)), mseOf(toFloat32(0.0), xs, ys, fn(unfit) => mseOf(w, xs, ys, fn(fitted) => unfit > fitted))
    ])))
}
exactTests([
        { name: "dot product fuses zip and fold", work: dotCase },
        { name: "saxpy runs elementwise over buffer pairs", work: saxpyCase },
        { name: "a kernel closes over one host scalar", work: captureScalarCase },
        { name: "one kernel closes over several distinct scalars", work: captureManyCase },
        { name: "one capture is spent by every combinator", work: captureSharedCase },
        { name: "a capture folded from one buffer drives a kernel over another", work: captureFoldedCase },
        { name: "captures survive gather, nesting, branching and shadowing", work: captureShapeCase },
        { name: "degenerate captures stay total on empty and ragged buffers", work: captureDegenerateCase },
        { name: "weighted sums normalise through a captured weight total", work: weightedSumCase },
        { name: "mean centering pipes a scalar back into a kernel", work: meanCase },
        { name: "variance and z-scores normalise a feature column", work: varianceCase },
        { name: "min-max rescaling captures both folded extremes", work: normalizeCase },
        { name: "relu clamps, leaks and counts active units", work: reluCase },
        { name: "a softmax-shaped pipeline is a shift-invariant distribution", work: softmaxCase },
        { name: "matrix-vector product gathers rows via iota", work: matVecCase },
        { name: "dense layers stack bias and activation over gathered rows", work: layerCase },
        { name: "gradient descent converges on the true weight", work: trainCase }
])
