// AI/ML workloads and their closure captures: dot products, SAXPY, weighted sums, mean and variance, normalisation,
// activations, a softmax-shaped pipeline, dense layers, matrix-vector products
// via gather, and a gradient-descent training loop ([GPU-KERNEL-FORM],
// [GPU-MAP], [GPU-ZIPWITH], [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-IOTA],
// [GPU-GET], [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
//
// The capture is the load-bearing shape. [GPU-KERNEL-FORM] names "a closure
// capturing enclosing locals (a folded scalar piped back into a gpuMap)" as a
// kernel form the purity proof must accept, so every statistic below is folded
// out of one buffer and spent inside a kernel over another: a mean into a
// centering pass, a maximum into a softmax shift, a weight total into a
// normalising divide — values staged beside the buffer, never shared state.
/// addF is the float reduction shared by every sum below; mulF is the
/// elementwise product behind every dot product.
fn addF(a, x) = a + x
fn mulF(x, y) = x * y
/// maxF and minF fold a buffer to its extremes: the seeds a softmax shift and
/// a min-max rescale capture.
fn maxF(a, x: float32) = match x > a { true => x false => a }
fn minF(a, x: float32) = match x < a { true => x false => a }
/// relu clamps negative inputs to zero; isActive marks what a relu layer lets
/// through.
fn relu(x) = match x > toFloat32(0.0) { true => x false => toFloat32(0.0) }
fn isActive(x) = x > toFloat32(0.0)
/// at reads a matrix element, treating out of bounds as zero padding; sumOf and
/// meanOf are the folded statistics the kernels capture, and meanOf's checked
/// division is what keeps an empty buffer total instead of partial.
fn at(m, i) = gpuGet(m, i) ?: toFloat32(0.0)
fn sumOf(xs, predicate) = gpuSatisfies(gpuFold(xs, toFloat32(0.0), addF), predicate)
/// equals32 is the predicate that a float32 result is exactly `expected`.
fn equals32(expected) = fn(actual) => actual == toFloat32(expected)
/// sumsTo is whether the buffer in `result` sums to exactly `expected`.
fn sumsTo(result, expected) = gpuSatisfies(result, fn(buffer) => sumOf(buffer, equals32(expected)))
/// lengthIs is whether the buffer in `result` has `expected` elements.
fn lengthIs(result, expected) = gpuSatisfies(result, fn(buffer) => gpuLength(buffer) == expected)
/// readsAt is whether element `index` of `buffer` is exactly `expected`.
fn readsAt(buffer, index, expected) = (gpuGet(buffer, index) ?: toFloat32(0.0)) == toFloat32(expected)
/// Empty statistics and zero-spread normalisation choose an explicit boundary value.
fn degenerate(value, work) = {
    handle Arith { divideByZero _ _ => value }
    work()
}
fn meanOf(xs, predicate) = sumOf(xs, fn(total) => predicate(degenerate(0.0, fn() => total / toFloat32(gpuLength(xs)))))
/// dotOf is BLAS level 1: fuse an elementwise product into a reduction, which is
/// the shape varianceOf reuses twice — fold a mean, then capture it inside the
/// kernel measuring squared deviation from it.
fn dotOf(xs, ys, predicate) = gpuSatisfies(gpuZipWith(xs, ys, mulF), fn(products) => sumOf(products, predicate))
fn varianceOf(xs, predicate) = meanOf(xs, fn(mean) => gpuSatisfies(gpuMap(xs, fn(v) => (v - mean) * (v - mean)), fn(deviations) => meanOf(deviations, predicate)))
/// saxpy is the classic a*x + y with a = 2.0.
fn saxpy(x, y) = toFloat32(2.0) * x + y
/// softWeight weights a score already shifted by the batch maximum, so d >= 0.
fn softWeight(d) = (toFloat32(1.0) / (toFloat32(1.0) + d + d * d))
/// softmaxEach is four stages, two of them captures: fold the maximum, spend it in
/// the shift, fold the partition function, spend that in the divide.
fn softmaxEach(scores, work) = match gpuFold(scores, gpuGet(scores, 0) ?: toFloat32(0.0), maxF) {
    Success { peak } => match gpuMap(scores, fn(s) => softWeight(peak - s)) {
        Success { weights } => match gpuFold(weights, toFloat32(0.0), addF) {
            Success { partition } => withBuffer(gpuMap(weights, fn(w) => (w / partition) ), work)
            Error { message } => gpuFailed(message)
        }
        Error { message } => gpuFailed(message)
    }
    Error { message } => gpuFailed(message)
}
/// rowDot walks one row of a flat row-major matrix against a vector. The
/// recursion carries the same captured buffers through every column.
fn rowDot(m, v, cols, r, c) = match c == cols {
    true => toFloat32(0.0)
    false => at(m, (((r * cols) ) + c) ) * at(v, c)
    + rowDot(m, v, cols, r, (c + 1) )
}
/// matVecEach gathers every row's dot product: one kernel invocation per row.
fn matVecEach(m, v, cols, indices, work) = withBuffer(gpuMap(indices, fn(r) => rowDot(m, v, cols, r, 0)), work)
fn matVecOf(m, v, cols, indices, predicate) = gpuSatisfies(gpuMap(indices, fn(r) => rowDot(m, v, cols, r, 0)), predicate)
/// denseEach is one MLP layer: gather rows, add bias elementwise, then activate.
fn denseEach(m, v, cols, indices, bias, work) = matVecEach(m, v, cols, indices, fn(rows) => withBuffer(gpuZipWith(rows, bias, addF), fn(biased) => withBuffer(gpuMap(biased, relu), work)))
fn denseOf(m, v, cols, indices, bias, predicate) = matVecOf(m, v, cols, indices, fn(rows) => gpuSatisfies(gpuZipWith(rows, bias, addF), fn(biased) => gpuSatisfies(gpuMap(biased, relu), predicate)))
/// mseOf is the loss the training loop descends; w is captured by the residual.
fn mseOf(w, xs: GpuBuffer<float32>, ys, predicate) = gpuSatisfies(gpuZipWith(xs, ys, fn(x, y) => (w * x - y) * (w * x - y)), fn(residuals) => meanOf(residuals, predicate))
/// gradStepEach is one epoch of least-squares descent on y = w * x; its
/// kernel captures the current weight.
fn gradStepEach(w, xs: GpuBuffer<float32>, ys, work) = match gpuZipWith(xs, ys,
    fn(x, y) => toFloat32(2.0) * (w * x - y) * x) {
    Success { residuals } => match gpuFold(residuals, toFloat32(0.0), addF) {
        Success { total } => work(w - toFloat32(0.05) * (total / toFloat32(3.0)))
        Error { message } => gpuFailed(message)
    }
    Error { message } => gpuFailed(message)
}
fn gradStepOf(w, xs: GpuBuffer<float32>, ys, predicate) = gpuSatisfies(gpuZipWith(xs, ys,
    fn(x, y) => toFloat32(2.0) * (w * x - y) * x), fn(residuals) => sumOf(residuals, fn(total) => predicate(w - toFloat32(0.05) * (total / toFloat32(3.0)))))
/// trainEach iterates gradStepEach n times, keeping the loop on buffers.
fn trainEach(w, xs, ys, n, work) = match n {
    0 => work(w)
    _ => gradStepEach(w, xs, ys, fn(stepped) => trainEach(stepped, xs, ys, (n - 1) , work))
}
fn trainOf(w, xs, ys, n, predicate) = match n {
    0 => predicate(w)
    _ => gradStepOf(w, xs, ys, fn(stepped) => trainOf(stepped, xs, ys, (n - 1) , predicate))
}
/// dotCase pins the fused product-and-reduce over orthogonal, negated, zeroed,
/// singleton, empty and ragged operands.
fn dotCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)]), fn(input1) => withBuffer(toGpu([]), fn(input2) => withBuffer(toGpu([]), fn(input3) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(input4) => withBuffer(toGpu([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0)]), fn(input5) => withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(1.0)]), fn(input6) => withBuffer(toGpu([toFloat32(0.0) - toFloat32(1.0), toFloat32(2.0)]), fn(input7) => withBuffer(toGpu([toFloat32(3.0), toFloat32(0.0) - toFloat32(4.0)]), fn(input8) => withBuffer(toGpu([toFloat32(2.0), toFloat32(2.0)]), fn(input9) => withBuffer(toGpu([toFloat32(0.5)]), fn(input10) => withBuffer(toGpu([toFloat32(0.5)]), fn(input11) => withBuffer(toGpu([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0)]), fn(input12) => withBuffer(toGpu([toFloat32(1.0)]), fn(input13) => dotCaseUploaded(input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13)))))))))))))))
fn dotCaseUploaded(input0, input1, input2, input3, input4, input5, input6, input7, input8, input9, input10, input11, input12, input13) = {
    let xs = input0
    let ys = input1
    checkAll("dot product", [
            dotOf(xs, ys, equals32(32.0)), dotOf(ys, xs, equals32(32.0)), dotOf(xs, xs, equals32(14.0)),
            dotOf(input2, input3, equals32(0.0)),
            dotOf(xs, input4, equals32(0.0)), dotOf(input5, input6, equals32(0.0)),
            dotOf(input7, input8, fn(total) => total == toFloat32(0.0) - toFloat32(11.0)),
            dotOf(xs, input9, equals32(6.0)), dotOf(input10, input11, equals32(0.25)),
            dotOf(input12, ys, equals32(4.0)), lengthIs(gpuZipWith(xs, ys, mulF), 3),
            lengthIs(gpuZipWith(xs, input13, mulF), 1)
    ])
}
/// saxpyCase pins BLAS saxpy, then the same shape with the scale factor
/// captured — including alphas zero and one, which reduce to projections.
fn saxpyCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)]), fn(input1) => withBuffer(toGpu([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)]), fn(input2) => withBuffer(toGpu([toFloat32(10.0), toFloat32(20.0)]), fn(input3) => withBuffer(toGpu([]), fn(input4) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(input5) => saxpyCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
fn saxpyCaseUploaded(input0, input1, input2, input3, input4, input5) = {
    let alpha = toFloat32(0.5)
    let xs = input0
    withBuffer(gpuZipWith(xs, input1, saxpy), fn(out) =>
        withBuffer(gpuZipWith(xs, input2, fn(x, y) => alpha * x + y), fn(axpy) =>
            checkAll("saxpy", [
                    sumOf(out, equals32(72.0)), readsAt(out, 0, 12.0), readsAt(out, 2, 36.0), gpuLength(out) == 3,
                    sumOf(axpy, equals32(6.0)), readsAt(axpy, 0, 1.5), readsAt(axpy, 2, 2.5),
                    sumsTo(gpuZipWith(xs, xs, fn(x, y) => toFloat32(0.0) * x + y), 6.0),
                    sumsTo(gpuZipWith(xs, xs, fn(x, y) => toFloat32(1.0) * x + y), 12.0),
                    sumsTo(gpuZipWith(xs, input3, saxpy), 36.0),
                    lengthIs(gpuZipWith(input4, xs, saxpy), 0),
                    sumsTo(gpuZipWith(xs, input5, fn(x, y) => alpha * x + y), 3.0)
            ])))
}
/// captureScalarCase is the first acceptance shape: one host scalar closed over
/// by a kernel, spent by map, filter, fold and scan, empty buffer included.
fn captureScalarCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([]), fn(input1) => captureScalarCaseUploaded(input0, input1)))
fn captureScalarCaseUploaded(input0, input1) = {
    let k = toFloat32(3.0)
    let xs = input0
    withBuffer(gpuMap(xs, fn(x) => k * x), fn(scaled) =>
        withBuffer(gpuMap(xs, fn(x) => k * x + k), fn(twice) =>
            checkAll("captured scalar", [
                    sumOf(scaled, equals32(18.0)), readsAt(scaled, 1, 6.0), gpuLength(scaled) == 3,
                    sumOf(twice, equals32(27.0)),
                    readsAt(twice, 2, 12.0),
                    sumsTo(gpuMap(scaled, fn(y) => k * y), 54.0),
                    sumsTo(gpuMap(xs, fn(x) => k + x), 15.0),
                    lengthIs(gpuFilter(xs, fn(x) => x > k), 0),
                    lengthIs(gpuFilter(xs, fn(x) => k > x), 2),
                    lengthIs(gpuMap(input1, fn(x) => k * x), 0),
                    gpuSatisfies(gpuFold(xs, toFloat32(0.0), fn(a, x) => a + k * x), equals32(18.0)),
                    gpuSatisfies(gpuScan(xs, toFloat32(0.0), fn(a, x) => a + k * x), fn(prefix) => readsAt(prefix, 2, 18.0))
            ])))
}
/// captureManyCase puts several distinct captures inside one kernel, in
/// different orders and arities, so no single-capture shortcut can pass it.
fn captureManyCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => captureManyCaseUploaded(input0))
fn captureManyCaseUploaded(input0) = {
    let a = toFloat32(2.0)
    let b = toFloat32(5.0)
    let c = toFloat32(0.5)
    let xs = input0
    withBuffer(gpuMap(xs, fn(x) => (a * x + b) * c), fn(affine) =>
        checkAll("several captures", [
                readsAt(affine, 0, 3.5), readsAt(affine, 1, 4.5),
                readsAt(affine, 2, 5.5), sumOf(affine, equals32(13.5)), gpuLength(affine) == 3,
                sumsTo(gpuMap(xs, fn(x) => c * x + b - a), 12.0),
                sumsTo(gpuMap(xs, fn(x) => a * x + b * c), 19.5),
                sumsTo(gpuMap(xs, fn(x) => a * c * x), 6.0),
                sumsTo(gpuMap(xs, fn(x) => b - a * x - c), 1.5),
                sumsTo(gpuZipWith(xs, xs, fn(x, y) => a * x + c * y), 15.0),
                gpuSatisfies(gpuFold(xs, b, fn(acc, x) => acc + c * x), equals32(8.0))
        ]))
}
/// captureSharedCase spends one capture across every combinator and then again
/// in a chained pass, so it must survive being staged more than once.
fn captureSharedCase() = withIndices(4, fn(indices4) => captureSharedWith(indices4))
fn captureSharedWith(indices4) = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)]), fn(input0) => captureSharedWithUploaded(indices4, input0))
fn captureSharedWithUploaded(indices4, input0) = {
    let t = toFloat32(2.0)
    let xs = input0
    withBuffer(gpuScan(xs, toFloat32(0.0), fn(acc, x) => acc + t * x), fn(scanned) =>
        withBuffer(gpuFilter(xs, fn(x) => x > t), fn(kept) =>
            checkAll("shared capture", [
                    sumsTo(gpuMap(xs, fn(x) => t * x), 20.0),
                    structuralEquals([gpuLength(kept), gpuLength(scanned)], [2, 4]),
                    sumOf(kept, equals32(7.0)),
                    readsAt(kept, 0, 3.0), gpuSatisfies(gpuFold(xs, toFloat32(0.0), fn(acc, x) => acc + t * x), equals32(20.0)),
                    readsAt(scanned, 0, 2.0), readsAt(scanned, 3, 20.0),
                    sumsTo(gpuZipWith(xs, xs, fn(x, y) => t * x * y), 60.0),
                    sumsTo(gpuMap(indices4, fn(i) => t * toFloat32(i)), 12.0),
                    lengthIs(gpuFilter(xs, fn(x) => t > x), 1),
                    gpuSatisfies(gpuMap(xs, fn(x) => t * x), fn(scaled) => sumsTo(gpuFilter(scaled, fn(y) => y > t), 18.0))
            ])))
}
/// captureFoldedCase is the shape [GPU-KERNEL-FORM] spells out: the capture is
/// itself a fold over another buffer — a sum, a maximum and a minimum off `ws`.
fn captureFoldedCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(3.0), toFloat32(4.0), toFloat32(8.0)]), fn(input0) => withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0)]), fn(input1) => withBuffer(toGpu([]), fn(input2) => captureFoldedCaseUploaded(input0, input1, input2))))
fn captureFoldedCaseUploaded(input0, input1, input2) = {
    let ws = input0
    let xs = input1
    withBuffer(gpuFold(ws, toFloat32(0.0), addF), fn(total) =>
        withBuffer(gpuFold(ws, gpuGet(ws, 0) ?: toFloat32(0.0), maxF), fn(peak) =>
            checkAll("capture folded from another buffer", [
                total == toFloat32(16.0), peak == toFloat32(8.0), sumsTo(gpuMap(xs, fn(x) => (x / total) ), 0.375),
                gpuSatisfies(gpuMap(xs, fn(x) => (x / total) ), fn(share) => readsAt(share, 0, 0.125)),
                gpuSatisfies(gpuMap(xs, fn(x) => x - peak), fn(centred) => sumOf(centred, fn(total) => total == toFloat32(0.0) - toFloat32(10.0))),
                sumsTo(gpuMap(xs, fn(x) => peak * x), 48.0),
                gpuSatisfies(gpuFold(ws, toFloat32(0.0), minF), equals32(0.0)), gpuSatisfies(gpuFold(ws, gpuGet(ws, 0) ?: toFloat32(0.0), minF), equals32(1.0)),
                sumsTo(gpuMap(ws, fn(w) => (w / total) ), 1.0),
                lengthIs(gpuFilter(ws, fn(w) => w * toFloat32(4.0) >= total), 2),
                gpuSatisfies(gpuZipWith(xs, xs, mulF), fn(products) => sumsTo(gpuMap(products, fn(p) => (p / total) ), 1.25)),
                    gpuSatisfies(gpuFold(input2, total, addF), equals32(16.0))
            ])))
}
/// captureShapeCase pushes on the form a capture arrives in: a buffer captured
/// for gather (out-of-range reads padding to zero), a capture read from a nested
/// lambda, one reached only through a match branch, and a shadowing parameter.
fn captureShapeCase() = withIndices(5, fn(indices5) => withIndices(3, fn(indices3) => captureShapeWith(indices5, indices3)))
fn captureShapeWith(indices5, indices3) = withBuffer(toGpu([toFloat32(10.0), toFloat32(20.0), toFloat32(30.0)]), fn(input0) => captureShapeWithUploaded(indices5, indices3, input0))
fn captureShapeWithUploaded(indices5, indices3, input0) = {
    let k = toFloat32(3.0)
    let w = input0
    let branch = fn(x) => match x > toFloat32(15.0) { true => k false => x }
    withBuffer(gpuMap(indices5, fn(i) => gpuGet(w, i) ?: toFloat32(0.0)), fn(gathered) =>
        checkAll("capture forms", [
                sumOf(gathered, equals32(60.0)), (gpuGet(gathered, 3) ?: toFloat32(9.9)) == toFloat32(0.0), (gpuGet(gathered, 4) ?: toFloat32(9.9)) == toFloat32(0.0),
                gpuLength(gathered) == 5, sumsTo(gpuMap(w, branch), 16.0),
                sumsTo(gpuMap(indices3, fn(i) => k * (gpuGet(w, i) ?: toFloat32(0.0))), 180.0),
                gpuSatisfies(gpuMap(indices3, fn(i) => k * (gpuGet(w, i) ?: toFloat32(0.0))), fn(nested) => readsAt(nested, 2, 90.0)),
                sumsTo(gpuMap(w, fn(x) => (fn(z) => k * z)(x)), 180.0),
                sumsTo(gpuMap(w, fn(k) => toFloat32(2.0) * k), 120.0),
                gpuSatisfies(gpuMap(indices3, toFloat32), fn(asFloats) => sumsTo(gpuZipWith(w, asFloats, fn(x, i) => x - k * i), 51.0)),
                gpuSatisfies(gpuFold(w, toFloat32(0.0), fn(a, x) => a + (fn(z) => toFloat32(0.5) * z)(x)), equals32(30.0)),
                lengthIs(gpuFilter(w, fn(x) => (fn(z) => z > k)(x)), 3)
        ]))
}
/// captureDegenerateCase is the boundary sweep: a captured zero divisor whose
/// checked division must surface as its fallback rather than an infinity, the
/// identity captures, an unread capture, and empty/ragged operands under one.
fn captureDegenerateCase() = withIndices(0, fn(emptyIndices) => captureDegenerateWith(emptyIndices))
fn captureDegenerateWith(emptyIndices) = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([]), fn(input1) => withBuffer(toGpu([]), fn(input2) => withBuffer(toGpu([toFloat32(5.0)]), fn(input3) => withBuffer(toGpu([]), fn(input4) => withBuffer(toGpu([toFloat32(7.0)]), fn(input5) => captureDegenerateWithUploaded(emptyIndices, input0, input1, input2, input3, input4, input5)))))))
fn captureDegenerateWithUploaded(emptyIndices, input0, input1, input2, input3, input4, input5) = {
    let zero = toFloat32(0.0)
    let one = toFloat32(1.0)
    let xs = input0
    withBuffer(degenerate(0.0 - 1.0, fn() => gpuMap(xs, fn(x) => x / zero)), fn(divided) =>
        checkAll("degenerate captures", [
                sumOf(divided, fn(total) => total == toFloat32(0.0) - toFloat32(3.0)), (gpuGet(divided, 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(1.0),
                sumsTo(gpuMap(xs, fn(x) => zero * x), 0.0),
                sumsTo(gpuMap(xs, fn(x) => one * x), 6.0),
                sumsTo(gpuMap(xs, fn(x) => zero + x), 6.0),
                sumsTo(gpuMap(xs, fn(_x) => one), 3.0),
                lengthIs(gpuFilter(input1, fn(x) => x > zero), 0),
                gpuSatisfies(gpuFold(input2, one, fn(a, x) => a + zero * x), equals32(1.0)),
                sumsTo(gpuMap(input3, fn(x) => one * x), 5.0),
                lengthIs(gpuZipWith(xs, input4, fn(x, y) => zero * x + y), 0),
                lengthIs(gpuZipWith(input5, xs, fn(x, y) => one * x + y), 1),
                sumsTo(gpuMap(emptyIndices, fn(i) => one * toFloat32(i)), 0.0)
        ]))
}
/// weightedSumCase pins weighted sum and weighted mean: the weight total is
/// folded once, captured by the normalising kernel, and both routes must agree.
fn weightedSumCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0)]), fn(input0) => withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(4.0), toFloat32(1.0)]), fn(input1) => withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0), toFloat32(8.0), toFloat32(16.0)]), fn(input2) => withBuffer(toGpu([toFloat32(0.5), toFloat32(0.25), toFloat32(0.125), toFloat32(0.125)]), fn(input3) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(input4) => withBuffer(toGpu([toFloat32(1.0), toFloat32(1.0), toFloat32(1.0), toFloat32(1.0)]), fn(input5) => weightedSumCaseUploaded(input0, input1, input2, input3, input4, input5)))))))
fn weightedSumCaseUploaded(input0, input1, input2, input3, input4, input5) = {
    let vals = input0
    let ws = input1
    match gpuFold(ws, toFloat32(0.0), addF) {
        Success { wtot } => match gpuMap(ws, fn(w) => (w / wtot) ) {
            Success { normw } => checkAll("weighted sums", [
                    wtot == toFloat32(8.0), dotOf(vals, ws, equals32(21.0)),
                    dotOf(vals, ws, fn(total) => ((total / wtot) ) == toFloat32(2.625)), sumOf(normw, equals32(1.0)),
                    readsAt(normw, 2, 0.5), readsAt(normw, 0, 0.125),
                    dotOf(vals, normw, equals32(2.625)),
                    dotOf(input2, input3, equals32(5.0)), dotOf(vals, input4, equals32(0.0)),
                    dotOf(vals, input5, fn(total) => sumOf(vals, fn(plain) => total == plain)),
                    sumsTo(gpuZipWith(vals, ws, fn(v, w) => wtot * v * w), 168.0),
                    sumsTo(gpuMap(vals, fn(v) => (v / wtot) ), 1.25)
            ])
            Error { message } => gpuFailed(message)
        }
        Error { message } => gpuFailed(message)
    }
}
/// meanCase centers a feature column: the folded mean is captured by the
/// centering kernel, and the centered column's own mean vanishes.
fn meanCase() = withIndices(9, fn(indices9) => meanWith(indices9))
fn meanWith(indices9) = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(6.0)]), fn(input0) => withBuffer(toGpu([]), fn(input1) => withBuffer(toGpu([toFloat32(5.0)]), fn(input2) => withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)]), fn(input3) => meanWithUploaded(indices9, input0, input1, input2, input3)))))
fn meanWithUploaded(indices9, input0, input1, input2, input3) = {
    let xs = input0
    match gpuFold(xs, toFloat32(0.0), addF) {
        Success { folded } => {
            let mean = degenerate(0.0, fn() => folded / toFloat32(gpuLength(xs)))
            match gpuMap(xs, fn(v) => v - mean) {
                Success { centered } => checkAll("mean centering", [
                        mean == toFloat32(3.0), sumOf(centered, equals32(0.0)), (gpuGet(centered, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(2.0),
                        readsAt(centered, 3, 3.0), gpuLength(centered) == 4,
                        meanOf(centered, equals32(0.0)), meanOf(input1, equals32(0.0)),
                        meanOf(input2, equals32(5.0)), meanOf(input3, equals32(5.0)),
                        gpuSatisfies(gpuMap(xs, fn(v) => mean + v), fn(shifted) => meanOf(shifted, equals32(6.0))),
                        gpuSatisfies(gpuMap(indices9, toFloat32), fn(asFloats) => meanOf(asFloats, equals32(4.0))),
                        lengthIs(gpuFilter(xs, fn(v) => v > mean), 1)
                ])
                Error { message } => gpuFailed(message)
            }
        }
        Error { message } => gpuFailed(message)
    }
}
/// varianceCase pins two-pass variance and the z-scores built on it: a
/// normalised column has mean zero and variance one, and a constant column's
/// zero deviation must fall back rather than divide.
fn varianceCase() = withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0), toFloat32(4.0), toFloat32(4.0), toFloat32(5.0), toFloat32(5.0), toFloat32(7.0), toFloat32(9.0)]), fn(input0) => withBuffer(toGpu([toFloat32(3.0), toFloat32(3.0), toFloat32(3.0)]), fn(input1) => withBuffer(toGpu([]), fn(input2) => withBuffer(toGpu([toFloat32(3.0), toFloat32(3.0)]), fn(input3) => varianceCaseUploaded(input0, input1, input2, input3)))))
fn varianceCaseUploaded(input0, input1, input2, input3) = {
    let xs = input0
    let sd = toFloat32(2.0)
    match gpuFold(xs, toFloat32(0.0), addF) {
        Success { folded } => {
            let mean = degenerate(0.0, fn() => folded / toFloat32(gpuLength(xs)))
            match gpuMap(xs, fn(v) => ((v - mean) / sd) ) {
                Success { z } => checkAll("variance and z-scores", [
                        mean == toFloat32(5.0), varianceOf(xs, equals32(4.0)), sd * sd == toFloat32(4.0), sumOf(z, equals32(0.0)),
                        (gpuGet(z, 0) ?: toFloat32(9.9)) == toFloat32(0.0) - toFloat32(1.5), (gpuGet(z, 4) ?: toFloat32(9.9)) == toFloat32(0.0),
                        readsAt(z, 7, 2.0), meanOf(z, equals32(0.0)),
                        varianceOf(z, equals32(1.0)), varianceOf(input1, equals32(0.0)),
                        varianceOf(input2, equals32(0.0)),
                        degenerate(0.0, fn() => sumsTo(gpuMap(input3, fn(v) => (v - toFloat32(3.0)) / toFloat32(0.0)), 0.0))
                ])
                Error { message } => gpuFailed(message)
            }
        }
        Error { message } => gpuFailed(message)
    }
}
/// normalizeCase pins the min-max rescale: both extremes are folded out and
/// captured, and a constant column's zero range falls back instead of dividing.
fn normalizeCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(3.0), toFloat32(5.0), toFloat32(9.0)]), fn(input0) => withBuffer(toGpu([toFloat32(4.0), toFloat32(4.0)]), fn(input1) => normalizeCaseUploaded(input0, input1)))
fn normalizeCaseUploaded(input0, input1) = {
    let xs = input0
    withBuffer(gpuFold(xs, gpuGet(xs, 0) ?: toFloat32(0.0), minF), fn(lo) =>
        withBuffer(gpuFold(xs, gpuGet(xs, 0) ?: toFloat32(0.0), maxF), fn(hi) =>
            withBuffer(gpuMap(xs, fn(v) => ((v - lo) / (hi - lo)) ), fn(scaled) =>
                checkAll("normalisation", [
                        lo == toFloat32(1.0), hi == toFloat32(9.0), (gpuGet(scaled, 0) ?: toFloat32(9.9)) == toFloat32(0.0), readsAt(scaled, 1, 0.25),
                        readsAt(scaled, 2, 0.5), readsAt(scaled, 3, 1.0), sumOf(scaled, equals32(1.75)),
                        meanOf(scaled, equals32(0.4375)),
                        sumsTo(gpuMap(xs, fn(v) => ((hi - v) / (hi - lo)) ), 2.25),
                        gpuSatisfies(gpuFold(xs, hi, minF), equals32(1.0)),
                        lengthIs(gpuFilter(xs, fn(v) => v > lo), 3),
                        degenerate(0.5, fn() => sumsTo(gpuMap(input1, fn(v) => (v - toFloat32(4.0)) / toFloat32(0.0)), 1.0))
                ]))))
}
/// Compare clamping and active-unit counts with captured slopes and reflected inputs.
fn reluCase() = withBuffer(toGpu([toFloat32(0.0) - toFloat32(1.5), toFloat32(2.5), toFloat32(0.0) - toFloat32(0.5), toFloat32(1.0)]), fn(input0) => withBuffer(toGpu([toFloat32(0.0) - toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)]), fn(input1) => withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0)]), fn(input2) => reluCaseUploaded(input0, input1, input2))))
fn reluCaseUploaded(input0, input1, input2) = {
    let slope = toFloat32(0.5)
    let cap = toFloat32(2.0)
    let acts = input0
    let leaky = fn(x) => match x > toFloat32(0.0) { true => x false => slope * x }
    withBuffer(gpuMap(acts, relu), fn(clamped) =>
        withBuffer(gpuMap(acts, leaky), fn(leaked) =>
            checkAll("activations", [
                    sumOf(clamped, equals32(3.5)), (gpuGet(clamped, 0) ?: toFloat32(9.9)) == toFloat32(0.0),
                    lengthIs(gpuFilter(acts, isActive), 2), sumOf(leaked, equals32(2.5)),
                    (gpuGet(leaked, 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(0.75), readsAt(leaked, 1, 2.5),
                    (gpuGet(leaked, 2) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(0.25),
                    sumsTo(gpuMap(acts, fn(x) => relu(x) - slope * relu(toFloat32(0.0) - x)), 2.5),
                    sumsTo(gpuMap(acts, fn(x) => cap - relu(cap - relu(x))), 3.0),
                    sumsTo(gpuMap(input1, relu), 0.0),
                    sumsTo(gpuMap(input2, relu), 3.0),
                    sumsTo(gpuMap(acts, fn(x) => slope * relu(x)), 1.75),
                    gpuSatisfies(gpuMap(acts, fn(x) => relu(toFloat32(0.0) - x)), fn(reflected) => gpuSatisfies(fromGpu(reflected), fn(values) => structuralEquals(values, [toFloat32(1.5), toFloat32(0.0), toFloat32(0.5), toFloat32(0.0)])))
            ])))
}
/// softmaxCase pins the pipeline by its properties, not its digits: a
/// distribution, order-preserving, shift-invariant, uniform on a flat vector.
fn softmaxCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([toFloat32(5.0), toFloat32(5.0), toFloat32(5.0)]), fn(input1) => softmaxCaseUploaded(input0, input1)))
fn softmaxCaseUploaded(input0, input1) = {
    let scores = input0
    softmaxEach(scores, fn(probs) =>
        withBuffer(gpuMap(scores, fn(s) => toFloat32(10.0) + s), fn(raised) =>
            softmaxEach(raised, fn(shifted) =>
                softmaxEach(input1, fn(flat) =>
                    checkAll("softmax pipeline", [
                            gpuLength(probs) == 3, gpuSatisfies(gpuFold(probs, toFloat32(0.0), addF), fn(total) => total > toFloat32(0.9999999)),
                            gpuSatisfies(gpuFold(probs, toFloat32(0.0), addF), fn(total) => total < toFloat32(1.0000001)), (gpuGet(probs, 0) ?: toFloat32(0.0)) > toFloat32(0.0),
                            (gpuGet(probs, 2) ?: toFloat32(0.0)) < toFloat32(1.0), (gpuGet(probs, 1) ?: toFloat32(0.0)) > (gpuGet(probs, 0) ?: toFloat32(0.0)),
                            (gpuGet(probs, 2) ?: toFloat32(0.0)) > (gpuGet(probs, 1) ?: toFloat32(0.0)), (gpuGet(probs, 0) ?: toFloat32(0.0)) == (gpuGet(shifted, 0) ?: toFloat32(9.9)),
                            (gpuGet(probs, 2) ?: toFloat32(0.0)) == (gpuGet(shifted, 2) ?: toFloat32(9.9)),
                            lengthIs(gpuFilter(probs, fn(p) => p > toFloat32(0.5)), 1),
                            (gpuGet(flat, 0) ?: toFloat32(0.0)) == (gpuGet(flat, 2) ?: toFloat32(9.9)),
                            gpuSatisfies(gpuFold(flat, toFloat32(0.0), addF), fn(total) => total > toFloat32(0.9999999))
                    ])))))
}
/// matVecCase multiplies through iota + gather: identity, zero matrix, 1x1, a
/// zero-column walk, and a row past the end, which pads to zero.
fn matVecCase() = withIndices(0, fn(rows0) => withIndices(1, fn(rows1) => withIndices(2, fn(rows2) => withIndices(3, fn(rows3) => matVecWith(rows0, rows1, rows2, rows3)))))
fn matVecWith(rows0, rows1, rows2, rows3) = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0), toFloat32(4.0), toFloat32(5.0), toFloat32(6.0)]), fn(input0) => withBuffer(toGpu([toFloat32(1.0), toFloat32(1.0), toFloat32(2.0)]), fn(input1) => withBuffer(toGpu([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(1.0)]), fn(input2) => withBuffer(toGpu([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)]), fn(input3) => withBuffer(toGpu([toFloat32(7.0), toFloat32(8.0), toFloat32(9.0)]), fn(input4) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(input5) => withBuffer(toGpu([toFloat32(5.0), toFloat32(5.0)]), fn(input6) => withBuffer(toGpu([toFloat32(5.0)]), fn(input7) => withBuffer(toGpu([toFloat32(3.0)]), fn(input8) => withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input9) => matVecWithUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9)))))))))))
fn matVecWithUploaded(rows0, rows1, rows2, rows3, input0, input1, input2, input3, input4, input5, input6, input7, input8, input9) = {
    let m = input0
    let v = input1
    let eye = input2
    matVecEach(m, v, 3, rows2, fn(out) =>
        checkAll("matrix-vector", [
                gpuLength(out) == 2, readsAt(out, 0, 9.0), readsAt(out, 1, 21.0), sumOf(out, equals32(30.0)),
                matVecOf(eye, input3, 3, rows3, fn(identity) => sumOf(identity, equals32(24.0))),
                matVecOf(eye, input4, 3, rows3, fn(identity) => readsAt(identity, 1, 8.0)),
                matVecOf(input5, input6, 2, rows2, fn(zeros) => sumOf(zeros, equals32(0.0))),
                matVecOf(input7, input8, 1, rows1, fn(single) => readsAt(single, 0, 15.0)),
                matVecOf(m, v, 3, rows3, fn(padded) => (gpuGet(padded, 2) ?: toFloat32(9.9)) == toFloat32(0.0)),
                matVecOf(m, v, 3, rows0, fn(noRows) => gpuLength(noRows) == 0), matVecOf(m, v, 0, rows2, fn(noColumns) => sumOf(noColumns, equals32(0.0))),
                gpuSatisfies(gpuZipWith(input9, v, mulF), fn(products) => sumOf(products, fn(hand) => matVecOf(m, v, 3, rows2, fn(first) => (gpuGet(first, 0) ?: toFloat32(0.0)) == hand)))
        ]))
}
/// layerCase runs a two-layer forward pass; the first layer's negative unit must
/// be silenced by relu before the second layer sees it.
fn layerCase() = withIndices(0, fn(rows0) => withIndices(1, fn(rows1) => withIndices(2, fn(rows2) => layerWith(rows0, rows1, rows2))))
fn layerWith(rows0, rows1, rows2) = withBuffer(toGpu([toFloat32(1.0), toFloat32(0.0), toFloat32(0.0) - toFloat32(1.0), toFloat32(0.5), toFloat32(0.5), toFloat32(0.5)]), fn(input0) => withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)]), fn(input1) => withBuffer(toGpu([toFloat32(1.0), toFloat32(0.0) - toFloat32(2.0)]), fn(input2) => withBuffer(toGpu([toFloat32(2.0), toFloat32(0.25)]), fn(input3) => withBuffer(toGpu([toFloat32(0.5)]), fn(input4) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0)]), fn(input5) => withBuffer(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0)]), fn(input6) => withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0)]), fn(input7) => withBuffer(toGpu([toFloat32(1.0)]), fn(input8) => layerWithUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8))))))))))
fn layerWithUploaded(rows0, rows1, rows2, input0, input1, input2, input3, input4, input5, input6, input7, input8) = {
    let w1 = input0
    let x = input1
    denseEach(w1, x, 3, rows2, input2, fn(h) =>
        denseEach(input3, h, 2, rows1, input4, fn(out) =>
            checkAll("dense layers", [
                    structuralEquals([gpuLength(h), gpuLength(out)], [2, 1]),
                    (gpuGet(h, 0) ?: toFloat32(9.9)) == toFloat32(0.0), readsAt(h, 1, 4.0), sumOf(h, equals32(4.0)),
                    lengthIs(gpuFilter(h, isActive), 1), readsAt(out, 0, 1.5),
                    matVecOf(w1, x, 3, rows2, fn(rows) => (gpuGet(rows, 0) ?: toFloat32(0.0)) == toFloat32(0.0) - toFloat32(4.0)),
                    matVecOf(w1, x, 3, rows2, fn(rows) => readsAt(rows, 1, 6.0)),
                    denseOf(w1, x, 3, rows2, input5, fn(zeros) => sumOf(zeros, equals32(6.0))),
                    denseOf(w1, input6, 3, rows2, input7, fn(shifted) => sumOf(shifted, equals32(3.0))),
                    denseOf(w1, x, 3, rows0, input8, fn(noRows) => gpuLength(noRows) == 0)
            ])))
}
/// trainCase descends from both sides of the true weight and pins the loss
/// surface: the optimum is a fixed point, the loss is symmetric about it.
fn trainCase() = withBuffer(toGpu([toFloat32(1.0), toFloat32(2.0), toFloat32(3.0)]), fn(input0) => withBuffer(toGpu([toFloat32(2.0), toFloat32(4.0), toFloat32(6.0)]), fn(input1) => trainCaseUploaded(input0, input1)))
fn trainCaseUploaded(input0, input1) = {
    let xs = input0
    let ys = input1
    trainEach(toFloat32(0.0), xs, ys, 40, fn(w) =>
        trainEach(toFloat32(5.0), xs, ys, 40, fn(hi) =>
            checkAll("gradient descent", [
                    w - toFloat32(2.0) < toFloat32(0.01), toFloat32(2.0) - w < toFloat32(0.01), w > toFloat32(1.0), hi - toFloat32(2.0) < toFloat32(0.01),
                    toFloat32(2.0) - hi < toFloat32(0.01), hi < toFloat32(3.0), trainOf(toFloat32(2.0), xs, ys, 0, equals32(2.0)),
                    trainOf(toFloat32(2.0), xs, ys, 10, equals32(2.0)), gradStepOf(toFloat32(2.0), xs, ys, equals32(2.0)),
                    mseOf(toFloat32(2.0), xs, ys, equals32(0.0)),
                    mseOf(toFloat32(3.0), xs, ys, fn(above) => mseOf(toFloat32(1.0), xs, ys, fn(below) => above == below)),
                    mseOf(toFloat32(0.0), xs, ys, fn(unfit) => mseOf(w, xs, ys, fn(fitted) => unfit > fitted))
            ])))
}
test("dot product fuses zip and fold", exactly(dotCase))
test("saxpy runs elementwise over buffer pairs", exactly(saxpyCase))
test("a kernel closes over one host scalar", exactly(captureScalarCase))
test("one kernel closes over several distinct scalars", exactly(captureManyCase))
test("one capture is spent by every combinator", exactly(captureSharedCase))
test("a capture folded from one buffer drives a kernel over another", exactly(captureFoldedCase))
test("captures survive gather, nesting, branching and shadowing", exactly(captureShapeCase))
test("degenerate captures stay total on empty and ragged buffers", exactly(captureDegenerateCase))
test("weighted sums normalise through a captured weight total", exactly(weightedSumCase))
test("mean centering pipes a scalar back into a kernel", exactly(meanCase))
test("variance and z-scores normalise a feature column", exactly(varianceCase))
test("min-max rescaling captures both folded extremes", exactly(normalizeCase))
test("relu clamps, leaks and counts active units", exactly(reluCase))
test("a softmax-shaped pipeline is a shift-invariant distribution", exactly(softmaxCase))
test("matrix-vector product gathers rows via iota", exactly(matVecCase))
test("dense layers stack bias and activation over gathered rows", exactly(layerCase))
test("gradient descent converges on the true weight", exactly(trainCase))
