        (gpuGet (signed, 3) ?: 0) == -1, (gpuGet (wide, 0) ?: 0) == 4611686018427387904, (gpuGet (wide, 1) ?: 0) == -4611686018427387904, (lastOf floats ?: 9.5) == 1.0, gpuSatisfies (toGpu ([9]), \uploaded40 => (gpuGet (uploaded40, 0) ?: 0) == 9),
        gpuSatisfies(gpuFold(ints, 0, addInts), \uploaded93 => (uploaded93) == 14), gpuSatisfies(gpuFold(signed, 0, addInts), \uploaded92 => (uploaded92) == 3), gpuSatisfies(gpuFold(floats, 0.0, addFloats), \uploaded91 => (uploaded91) == 2.5),
