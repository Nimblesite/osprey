(** [FAILURE-EXPLICIT] Allocation failure stops the case before its consumer. *)
withBuffer (result, work) = match result
    Success value => work value
    Error message => check ("GPU operation", "success", toString message)
(** [FAILURE-EXPLICIT] A GPU failure fails the predicate with its reason. *)
gpuSatisfies (result, predicate) = match result
    Success value => predicate value
    Error message =>
        check ("GPU operation", "success", toString message)
        false
