(** Pin [GPU-BUFFER-ELEM]: int, float and bool words go through the identity kernel and come back bit-for-bit at their own type — a float buffer must never read back as the integer its bits spell. *)
elementCase () = withBuffer(toGpu ([-9, 0, 9]), \ints => withBuffer(toGpu ([-0.5, 0.0, 0.125]), \floats => withBuffer(toGpu ([false, true]), \flags => elementCaseUploaded(ints, floats, flags))))
elementCaseUploaded (ints, floats, flags) =
    checkAll "scalar element words survive identity" [
        bufferReadsTo (gpuMap(ints, same), [0, 1, 2], 0, [-9, 0, 9]), bufferReadsTo (gpuMap(floats, same), [0, 1, 2], 9.5, [-0.5, 0.0, 0.125]), bufferReadsTo (gpuMap(flags, same), [0, 1], true, [false, true]),
        structuralEquals [readback (ints, 0), readback (ints, 1), readback (floats, 0)] ["-9", "0", "-0.5"],
        structuralEquals [readback (floats, 1), readback (floats, 2), readback (flags, 0)] ["0.0", "0.125", "false"],
        foldsIntsTo (ints, 0, 0), foldsFloatsTo (floats, 0.0, -0.375),
        foldsBoolsTo (flags, 0, 1), gpuLengthIs (gpuMap(floats, same), 3), gpuSatisfies(gpuMap(flags, same), \uploaded52 => widthOf (uploaded52) == 2),
        gpuSatisfies(gpuMap(ints, same), \uploaded51 => listLengthIs (fromGpu (uploaded51), 3)), foldsFloatsResultTo (toGpu ([2.0]), 0.0, 2.0),
        gpuSatisfies(gpuMap(floats, same), \uploaded49 => (lastOf (uploaded49) ?: 9.5) == 0.125)
