// withBuffer, gpuSatisfies, withIndices, iotaError and exactArithmetic are the
// testing prelude's [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the
// one shared copy, so this file declares none of its own.
// GPU buffer surface, dense construction, round-trips in both directions,
// bounds-checked reads at every degenerate index, and the element tag's
// survival through lets, pipes, parameters, returns and aliases
// ([GPU-BUFFER], [GPU-BUFFER-ELEM], [GPU-BUFFER-LITERAL],
// [GPU-BUFFER-FROM-LIST], [GPU-BUFFER-FUSE], [GPU-BUFFER-TO-LIST],
// [GPU-BUFFER-LENGTH], [GPU-IOTA], [GPU-GET] — 0034-GPUComputation.md).
(** Pure int kernel; the checker proves it performs no effects. *)
square x = (x * x)
(** Keep the checked-arithmetic Result inside the kernel. *)
addInts (acc, x) = (acc + x)
(** Pure float kernel; the buffer's element tag types x as float. *)
scale x = x * 1.5
(** Map an int element to a bool element, changing the buffer's type. *)
isOdd x = (x % 2 ) == 1
(** Count the true elements of a bool buffer. *)
countOdd (acc, flag) = match flag
    true => (acc + 1)
    false => acc
(** The identity kernel: every scalar word must come back out unchanged, at the element type its source buffer was tagged with. *)
same x = x
(** Render one gpuGet outcome as text — the element for a hit, the error payload for a miss. Being polymorphic over the element type, it is itself the assertion that gpuGet recovers int, float and bool alike. *)
readback (b, i) = match gpuGet (b, i)
    Success value => toString value
    Error message => message
(** Compute the final index from the length: the read that sits exactly on the in-bounds boundary. *)
lastOf b = gpuGet (b, (gpuLength b - 1) )
(** Take a buffer as a plain parameter — the handle and its element tag have to survive the call. *)
widthOf b = gpuLength b
(** Both receive and return a buffer, so the tag must survive a parameter and a return in one call. *)
doubledInts b =gpuMap(b, (\x => (x * 2) ))
(** doubledInts' float twin: tags are per-buffer, so a float buffer must come back out of a return still reading as float. *)
scaledFloats b =gpuMap(b, scale)
(** Return a buffer out of a match arm — the fourth binding form a handle travels through. *)
chooseBuffer (flag, a, b) = match flag
    true => a
    false => b
(** The read that sits on the in-bounds boundary: the final element, or `fallback` for an empty buffer. *)
lastIs (b, fallback, expected) = (lastOf b ?: fallback) == expected
(** The read [GPU-GET] must refuse: its payload is exactly the contracted message, never a sentinel element. *)
misses (b, index) = readback (b, index) == oobMessage ()
(** One gpuGet outcome as text, so an element's own scalar type stays visible. *)
rendersAs (b, index, text) = readback (b, index) == text
(** [GPU-FOLD] over int elements: `b` from `seed` totals `expected`. *)
sumsTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, addInts), expected)
(** sumsTo from the zero seed. *)
sumIs (b, expected) = sumsTo (b, 0, expected)
(** [GPU-FOLD] over bool elements: `b` holds `expected` true flags. *)
oddCountIs (b, expected) = gpuEquals(gpuFold(b, 0, countOdd), expected)
(** uploaded uploads `values` and checks the dense buffer it produces. *)
uploaded (values, check) = gpuSatisfies(toGpu (values), check)
(** withUpload runs `work` on the dense buffer `values` uploads. *)
withUpload (values, work) = withBuffer(toGpu (values), work)
(** Materialize `b` and hand its list to `check` — the [GPU-BUFFER-TO-LIST] scaffolding every read-back shares. *)
fromList (b, check) = gpuSatisfies(fromGpu (b), check)
(** Materialize `b`, upload its list again and hand the rebuilt buffer to `check`. *)
roundTripIs (b, check) = fromList (b, \values => gpuSatisfies(toGpu (values), check))
(** [GPU-BUFFER-TO-LIST]: `b` materializes as `expected` list elements. *)
readsBack (b, expected) = fromList (b, \values => listLengthIs (values, expected))
(** [GPU-BUFFER-TO-LIST] read at one index. *)
readsBackAt (b, index, fallback, expected) = fromList (b, \values => listHolds (values, index, fallback, expected))
(** The exact dense copy [GPU-BUFFER-TO-LIST] promises. *)
materializesAs (b, values) = fromList (b, \back => structuralEquals (back, values))
(** Send `b` through list and buffer again at `expected` elements. *)
survivesRoundTrip (b, expected) = roundTripIs (b, \again => lengthIs (again, expected))
(** Fold the buffer rebuilt from `b`'s own materialized list. *)
roundTripSumsTo (b, expected) = roundTripIs (b, \again => sumIs (again, expected))
(** Map `square` over `b` — the named-kernel route. *)
squared b = gpuMap(b, square)
(** Check the fold total of the buffer `square` maps `b` into. *)
squaredSumsTo (b, expected) = gpuSatisfies(squared(b), \squares => sumIs (squares, expected))
(** Widen `b`'s elements to float — the [GPU-CONVERT] route. *)
toFloats b = gpuMap(b, toFloat)
(** Check the buffer `toFloats` widens `b` into. *)
widenedAs (b, check) = gpuSatisfies(toFloats(b), check)
(** Check the buffer `scaledFloats` maps `b` into. *)
scaledAs (b, check) = gpuSatisfies(scaledFloats(b), check)
(** Check the buffer the identity kernel maps `b` into. *)
sameAs (b, check) = gpuSatisfies(gpuMap(b, same), check)
(** Read `b` through the identity kernel at one index. *)
sameReads (b, index, fallback, expected) = sameAs (b, \copy => elementIs (copy, index, fallback, expected))
(** Check every buffer in `buffers` against `check`. *)
eachOf (buffers, check) = foldList (buffers, true, \(ok, b) => ok && check b)
(** Check every index in `indices` against the same [GPU-GET] refusal. *)
missesAll (b, indices) = foldList (indices, true, \(ok, i) => ok && misses (b, i))
(** Check that count `count` reports exactly `expected`. *)
iotaRejects (count, expected) = iotaError (count) == expected
(** Pin [GPU-BUFFER-LITERAL]: a literal argument stores its elements straight into the dense buffer at constant indices, with no list built at all. Every scalar element type [GPU-BUFFER-ELEM] is covered, plus the degenerate one- and zero-element literals and the sign and magnitude extremes an int word must hold. *)
literalCase () = withUpload([3, 1, 4, 1, 5], \ints => withUpload([0.25, 0.5, 0.75, 1.0], \floats => withUpload([true, false, true], \flags => withUpload([-3, 0, 7, -1], \signed => withUpload([4611686018427387904, -4611686018427387904], \wide => literalCaseUploaded(ints, floats, flags, signed, wide))))))
literalCaseUploaded (ints, floats, flags, signed, wide) =
    checkAll("buffer literals", [
        lengthIs (ints, 5), lengthIs (floats, 4), lengthIs (flags, 3), lengthIs (signed, 4), lengthIs (wide, 2), uploaded ([9], \up => lengthIs (up, 1)), emptyUploads (), widthOf ints == 5, elementsFrom (ints, 0, 0, [3, 1, 4, 1, 5]), lastIs (ints, 0, 5), elementsFrom (floats, 0, 9.5, [0.25, 0.5, 0.75, 1.0]), lastIs (floats, 9.5, 1.0), elementIs (flags, 0, false, true), elementIs (flags, 1, true, false), elementIs (flags, 2, false, true), lastIs (flags, false, true), elementIs (signed, 0, 0, (-3)), elementIs (signed, 1, 9, 0), elementsFrom (signed, 2, 0, [7, (-1)]), elementsFrom (wide, 0, 0, [4611686018427387904, -4611686018427387904]), uploaded ([9], \up => elementIs (up, 0, 0, 9)), sumIs (ints, 14), sumIs (signed, 3), floatSumsTo (floats, 0.0, 2.5), oddCountIs (flags, 2)
    ])
(** Pin [GPU-BUFFER-FROM-LIST]: a list *value* takes the copy loop rather than the literal path and must land on a buffer indistinguishable from the literal one — same length, same elements, same reduction — down to the one- and zero-element lists. *)
listCopyCase () = withIndices (0, \indices0 =>
    source = [2, 4, 6, 8]
    lone = [11]
    withUpload(source, \asCopy => withBuffer(fromGpu (asCopy), \read0 => withUpload(read0, \relayed => withBuffer(fromGpu (indices0), \none => checkAll("list copy path", [listLengthIs (source, 4), lengthIs (asCopy, 4), elementsFrom (asCopy, 0, 0, [2, 4, 6, 8]), lastIs (asCopy, 0, 8), missesAll (asCopy, [4, (-1)]), rendersAs (asCopy, 0, "2"), sumIs (asCopy, 20), lengthIs (relayed, 4), elementIs (relayed, 2, 0, 6), sumIs (relayed, 20), uploaded (lone, \up => lengthIs (up, 1)), uploaded (lone, \up => elementIs (up, 0, 0, 11)), uploaded (lone, \up => lastIs (up, 0, 11)), listLengthIs (none, 0), uploaded (none, \up => lengthIs (up, 0)), uploaded (none, \up => sumsTo (up, 7, 7)), uploaded (source, \up => widthOf up == widthOf asCopy), uploaded (source, \up => gpuSatisfies(gpuFold(up, 0, addInts), \one => gpuSatisfies(gpuFold(asCopy, 0, addInts), \other => one == other)))]))))))
