roundTripCase () = withIndices (0, \indices0 => withIndices (6, \indices6 => withUpload([3, 1, 4, 1, 5], \buf => withBuffer(fromGpu (buf), \back => withUpload(back, \viaList => withBuffer(fromGpu (viaList), \twice => checkAll("round trip", [
    lengthIs (buf, 5), listLengthIs (back, 5), listHolds (back, 0, 0, 3), listHolds (back, 1, 0, 1), listHolds (back, 2, 0, 4), listHolds (back, 3, 0, 1), listHolds (back, 4, 0, 5), listHolds (back, 5, 99, 99), listHolds (back, (-1), 99, 99), lengthIs (viaList, 5), elementsAt (viaList, 0, [0, 2, 4], [3, 4, 5]), misses (viaList, 5), sumIs (viaList, 14), listLengthIs (twice, 5), listHolds (twice, 4, 0, 5), uploaded (twice, \up => sumsTo (up, 0, 14)), readsBack (indices0, 0), survivesRoundTrip (indices6, 6), roundTripSumsTo (indices6, 15), roundTripIs (indices6, \again => elementIs (again, 5, 0, 5))
