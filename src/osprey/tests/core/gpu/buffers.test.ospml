// GPU buffer surface: dense construction, round-trips in both directions,
// bounds-checked reads at every degenerate index, and the element tag's
// survival through lets, pipes, parameters, returns and aliases
// ([GPU-BUFFER], [GPU-BUFFER-ELEM], [GPU-BUFFER-LITERAL],
// [GPU-BUFFER-FROM-LIST], [GPU-BUFFER-FUSE], [GPU-BUFFER-TO-LIST],
// [GPU-BUFFER-LENGTH], [GPU-IOTA], [GPU-GET] — 0034-GPUComputation.md).
(** Pure int kernel; the checker proves it performs no effects. *)
square x = (x * x)
(** Keep the checked-arithmetic Result inside the kernel. *)
addInts (acc, x) = (acc + x)
(** Pure float kernel; the buffer's element tag types x as float. *)
scale x = x * 1.5
(** Float reduction kernel for gpuFold's uncurried combine slot. *)
addFloats (a, x) = a + x
(** Map an int element to a bool element, changing the buffer's type. *)
isOdd x = (x % 2 ) == 1
(** Count the true elements of a bool buffer. *)
countOdd (acc, flag) = match flag
    true => (acc + 1)
    false => acc
(** The identity kernel: every scalar word must come back out unchanged, at the element type its source buffer was tagged with. *)
same x = x
(** The exact payload [GPU-GET] contracts for a read outside the buffer, so a wrong gather is a visible failure and never a sentinel element. *)
oobMessage () = "gpuGet: index out of bounds"
(** Render one gpuGet outcome as text — the element for a hit, the error payload for a miss. Being polymorphic over the element type, it is itself the assertion that gpuGet recovers int, float and bool alike. *)
readback (b, i) = match gpuGet (b, i)
    Success value => toString value
    Error message => message
(** Compute the final index from the length: the read that sits exactly on the in-bounds boundary. *)
lastOf b = gpuGet (b, (gpuLength b - 1) )
(** Take a buffer as a plain parameter — the handle and its element tag have to survive the call. *)
widthOf b = gpuLength b
(** Both receive and return a buffer, so the tag must survive a parameter and a return in one call. *)
doubledInts b =gpuMap(b, (\x => (x * 2) ))
(** doubledInts' float twin: tags are per-buffer, so a float buffer must come back out of a return still reading as float. *)
scaledFloats b =gpuMap(b, scale)
(** Return a buffer out of a match arm — the fourth binding form a handle travels through. *)
chooseBuffer (flag, a, b) = match flag
    true => a
    false => b
(** The elements at [indices] in order, with [fallback] standing in for every out-of-bounds read: one gather pins a whole run of index reads. *)
valuesAt (buffer, indices, fallback) = mapList (indices, \i => gpuGet (buffer, i) ?: fallback)
(** Whether [buffer] reads exactly [expected] at [indices], out-of-bounds indices yielding [fallback]. *)
readsTo (buffer, indices, fallback, expected) = structuralEquals (valuesAt (buffer, indices, fallback), expected)
(** The same gather over a list, for the paths that hand back a list instead of a buffer. *)
listReadsTo (values, indices, fallback, expected) = structuralEquals (mapList (indices, \i => listGet (values, i) ?: fallback), expected)
(** Whether the list produced by [result] has [expected] elements. *)
listLengthIs (result, expected) = gpuSatisfies (result, \values => listLength values == expected)
(** Whether the list produced by [result] reads [expected] at [indices]. *)
listResultReadsTo (result, indices, fallback, expected) = gpuSatisfies (result, \values => listReadsTo (values, indices, fallback, expected))
(** The buffer-result form of the gathers above, for the operations that hand back a `Result` rather than a buffer. *)
bufferReadsTo (result, indices, fallback, expected) = gpuSatisfies (result, \buffer => readsTo (buffer, indices, fallback, expected))
(** A list round-trip relayed back onto the GPU, checked through the same gathers. *)
relayReadsTo (buffer, indices, fallback, expected) = gpuSatisfies (fromGpu (buffer), \values => bufferReadsTo (toGpu (values), indices, fallback, expected))
relayLengthIs (buffer, expected) = gpuSatisfies (fromGpu (buffer), \values => gpuLengthIs (toGpu (values), expected))
(** Whether every listed read of [b] renders as the out-of-bounds payload [GPU-GET]. *)
errorsAt (b, indices) = structuralEquals (mapList (indices, \i => readback (b, i)), mapList (indices, \i => oobMessage ()))
(** Whether folding [b] from [seed] with addInts publishes [expected]. *)
foldsIntsTo (b, seed, expected) = gpuEquals (gpuFold (b, seed, addInts), expected)
(** Whether folding [b] from [seed] with addFloats publishes [expected]. *)
foldsFloatsTo (b, seed, expected) = gpuEquals (gpuFold (b, seed, addFloats), expected)
(** Whether folding [b] from [seed] with countOdd publishes [expected]. *)
foldsBoolsTo (b, seed, expected) = gpuEquals (gpuFold (b, seed, countOdd), expected)
(** foldsIntsTo for an operation that hands back a `Result` rather than a buffer. *)
foldsIntsResultTo (result, seed, expected) = gpuSatisfies (result, \b => foldsIntsTo (b, seed, expected))
(** foldsFloatsTo for an operation that hands back a `Result` rather than a buffer. *)
foldsFloatsResultTo (result, seed, expected) = gpuSatisfies (result, \b => foldsFloatsTo (b, seed, expected))
(** foldsBoolsTo for an operation that hands back a `Result` rather than a buffer. *)
foldsBoolsResultTo (result, seed, expected) = gpuSatisfies (result, \b => foldsBoolsTo (b, seed, expected))
(** Fold a list round-trip relayed back onto the GPU through toGpu. *)
relayFoldIntsTo (buffer, seed, expected) = gpuSatisfies (fromGpu (buffer), \values => foldsIntsResultTo (toGpu (values), seed, expected))
(** Whether every listed gpuIota count fails with exactly [message]. *)
iotaErrorsAt (counts, message) = structuralEquals (mapList (counts, iotaError), mapList (counts, \count => message))
(** Whether uploading the empty int literal yields a zero-length buffer. *)
emptyLiteralIs () = gpuSatisfies (toGpu ([]), \(uploaded: GpuBuffer<int>) => gpuLength (uploaded) == 0)
(** Pin [GPU-BUFFER-LITERAL]: a literal argument stores its elements straight into the dense buffer at constant indices, with no list built at all. Every scalar element type [GPU-BUFFER-ELEM] is covered, plus the degenerate one- and zero-element literals and the sign and magnitude extremes an int word must hold. *)
literalCase () = withBuffer(toGpu ([3, 1, 4, 1, 5]), \ints => withBuffer(toGpu ([0.25, 0.5, 0.75, 1.0]), \floats => withBuffer(toGpu ([true, false, true]), \flags => withBuffer(toGpu ([-3, 0, 7, -1]), \signed => withBuffer(toGpu ([4611686018427387904, -4611686018427387904]), \wide => literalCaseUploaded(ints, floats, flags, signed, wide))))))
literalCaseUploaded (ints, floats, flags, signed, wide) =
    checkAll "buffer literals" [
        structuralEquals [gpuLength ints, gpuLength floats, gpuLength flags, gpuLength signed] [5, 4, 3, 4],
        structuralEquals [gpuLength wide, widthOf ints, (lastOf ints ?: 0)] [2, 5, 5],
        gpuLengthIs (toGpu ([9]), 1), emptyLiteralIs (),
        readsTo (ints, [0, 1, 2, 3, 4], 0, [3, 1, 4, 1, 5]), readsTo (floats, [0, 1, 2, 3], 9.5, [0.25, 0.5, 0.75, 1.0]), readsTo (flags, [0, 1, 2], false, [true, false, true]),
        (lastOf flags ?: false) == true, readsTo (signed, [0, 1, 2, 3], 9, [-3, 0, 7, -1]), readsTo (wide, [0, 1], 0, [4611686018427387904, -4611686018427387904]), (lastOf floats ?: 9.5) == 1.0,
        bufferReadsTo (toGpu ([9]), [0], 0, [9]), foldsIntsTo (ints, 0, 14), foldsIntsTo (signed, 0, 3), foldsFloatsTo (floats, 0.0, 2.5), foldsBoolsTo (flags, 0, 2)
    ]
(** Pin [GPU-BUFFER-FROM-LIST]: a list *value* takes the copy loop rather than the literal path and must land on a buffer indistinguishable from the literal one — same length, same elements, same reduction — down to the one- and zero-element lists. *)
listCopyCase () = withIndices (0, \indices0 => listCopyWith (indices0))
listCopyWith (indices0) =
    source = [2, 4, 6, 8]
    lone = [11]
    withBuffer (toGpu (source), \copied => withBuffer (fromGpu (copied), \read0 => withBuffer (toGpu (read0), \relayed => withBuffer (fromGpu (indices0), \none => checkAll "list copy path" [
                        structuralEquals [listLength source, gpuLength copied, (lastOf copied ?: 0)] [4, 4, 8],
                        structuralEquals [gpuLength relayed, listLength none] [4, 0],
                        readsTo (copied, [0, 1, 2, 3], 0, [2, 4, 6, 8]), errorsAt (copied, [4, -1]),
                        readback (copied, 0) == "2", foldsIntsTo (copied, 0, 20), readsTo (relayed, [2], 0, [6]), foldsIntsTo (relayed, 0, 20),
                        gpuLengthIs (toGpu (lone), 1), bufferReadsTo (toGpu (lone), [0], 0, [11]), gpuSatisfies (toGpu (lone), \uploaded35 => (lastOf (uploaded35) ?: 0) == 11), gpuLengthIs (toGpu (none), 0),
                        gpuSatisfies (toGpu (none), \uploaded33 => gpuEquals (gpuFold (uploaded33, 7, addInts), 7)), gpuSatisfies (toGpu (source), \uploaded32 => widthOf (uploaded32) == widthOf copied),
                        gpuSatisfies (toGpu (source), \uploaded31 => gpuSatisfies(gpuFold(uploaded31, 0, addInts), \uploaded85 => gpuSatisfies(gpuFold(copied, 0, addInts), \uploaded86 => (uploaded85) == (uploaded86))))
                    ]))))
(** Pin toGpu/fromGpu as an order-preserving dense copy in both directions [GPU-BUFFER-TO-LIST]: list to buffer to list to buffer, every index checked at every hop, with a list index past the end still failing. *)
roundTripCase () = withIndices (0, \indices0 => withIndices (6, \indices6 => roundTripWith (indices0, indices6)))
roundTripWith (indices0, indices6) =
    withBuffer (toGpu ([3, 1, 4, 1, 5]), \buf => withBuffer (fromGpu (buf), \back => withBuffer (toGpu (back), \viaList => withBuffer (fromGpu (viaList), \twice => checkAll "round trip" [
                        structuralEquals [gpuLength buf, listLength back] [5, 5],
                        structuralEquals [gpuLength viaList, listLength twice] [5, 5],
                        listReadsTo (back, [0, 1, 2, 3, 4, 5, -1], 99, [3, 1, 4, 1, 5, 99, 99]), readsTo (viaList, [0, 2, 4], 0, [3, 4, 5]), errorsAt (viaList, [5]),
                        foldsIntsTo (viaList, 0, 14), listReadsTo (twice, [4], 0, [5]), foldsIntsResultTo (toGpu (twice), 0, 14),
                        listLengthIs (fromGpu (indices0), 0), relayLengthIs (indices6, 6), relayFoldIntsTo (indices6, 0, 15),
                        relayReadsTo (indices6, [5], 0, [5])
                    ]))))
(** Pin the zero-element buffer through every builtin that takes one: no element is readable at any index, it materializes as an empty list, maps to another empty buffer, and folds to its seed untouched. *)
emptyCase () = withIndices (0, \indices0 => emptyWith (indices0))
emptyWith (indices0) =
    none = indices0
    withBuffer (gpuMap(none, square), \mapped => withBuffer (gpuMap(none, isOdd), \flags => withBuffer (gpuMap(none, toFloat), \widened => checkAll "empty buffers" [
                    structuralEquals [gpuLength none, gpuLength mapped, gpuLength flags] [0, 0, 0],
                    structuralEquals [gpuLength widened, widthOf none, (lastOf none ?: 42)] [0, 0, 42],
                    emptyLiteralIs (), listLengthIs (fromGpu (none), 0),
                    listLengthIs (fromGpu (mapped), 0), foldsIntsTo (none, 0, 0), foldsIntsTo (none, (-7), -7),
                    foldsIntsTo (mapped, 3, 3), foldsBoolsTo (flags, 0, 0), foldsFloatsTo (widened, 2.5, 2.5), readsTo (none, [0, 1, -1, 1000000], 42, [42, 42, 42, 42]),
                    errorsAt (none, [0, -1]), errorsAt (mapped, [0]),
                    errorsAt (flags, [0]), errorsAt (widened, [0])
