(** Pin [GPU-IOTA] across its domain: the empty, one- and two-element index buffers, a large one whose closed-form sum a miscounted loop cannot match, and negative counts, which report allocation errors rather than successful empty buffers. *)
iotaCase () = withIndices (0, \indices0 => withIndices (1, \indices1 => withIndices (2, \indices2 => withIndices (7, \indices7 => withIndices (200000, \indicesWide => iotaWith (indices0, indices1, indices2, indices7, indicesWide))))))
iotaWith (indices0, indices1, indices2, indices7, indicesWide) =
    one = indices1
    pair = indices2
    seven = indices7
    wide = indicesWide
    checkAll "iota" [
        structuralEquals [gpuLength (indices0), gpuLength one, gpuLength pair] [0, 1, 2],
        structuralEquals [gpuLength seven, gpuLength wide, widthOf seven] [7, 200000, 7],
        structuralEquals [(lastOf seven ?: 0), (lastOf wide ?: 0)] [6, 199999],
        iotaErrorsAt ([-1, -200000, -1], "gpu: buffer allocation: a negative element count"),
        iotaErrorsAt ([9223372036854775807], "gpu: buffer allocation: element count overflows the byte size"),
        iotaErrorsAt ([1152921504606846975], "gpu: buffer allocation: out of memory"),
        readsTo (one, [0], 9, [0]), readsTo (pair, [0, 1], 9, [0, 1]), readsTo (seven, [0, 6], 9, [0, 6]),
        readsTo (wide, [0, 100000], 9, [0, 100000]), errorsAt (seven, [7]), errorsAt (one, [1]), errorsAt (wide, [200000]),
        foldsIntsTo (seven, 0, 21), foldsIntsTo (pair, 0, 1),
        foldsIntsTo (one, 0, 0), foldsIntsTo (wide, 0, 19999900000),
        foldsIntsResultTo (gpuMap(seven, square), 0, 91), listLengthIs (fromGpu (seven), 7), listResultReadsTo (fromGpu (seven), [3], 0, [3])
