(** Pin [GPU-GET] at both ends and far outside them for every element type: an in-bounds read returns the element at the buffer's own scalar type, and index == length, index == -1 and indices a million past either edge all return the identical Error payload. *)
boundsCase () = withBuffer(toGpu ([10, 20, 30]), \ints => withBuffer(toGpu ([1.25, 2.5]), \floats => withBuffer(toGpu ([true, false]), \flags => boundsCaseUploaded(ints, floats, flags))))
boundsCaseUploaded (ints, floats, flags) =
    checkAll "bounds" [
        readsTo (ints, [0, 2, (gpuLength ints - 1)], 0, [10, 30, 30]),
        structuralEquals [readback (ints, 0), readback (ints, 2), readback (floats, 0)] ["10", "30", "1.25"],
        structuralEquals [readback (floats, 1), readback (flags, 0), readback (flags, 1)] ["2.5", "true", "false"],
        errorsAt (ints, [3, 4, 1000000, -1, -1000000]), errorsAt (floats, [2, -1]), errorsAt (flags, [2, -1]), readsTo (ints, [gpuLength ints, 3, -1], -1, [-1, -1, -1]), readsTo (floats, [2, -1], 9.5, [9.5, 9.5]),
        readsTo (flags, [2], true, [true]), readsTo (flags, [-1], false, [false]), (lastOf ints ?: 0) == 30, (lastOf floats ?: 9.5) == 2.5, (lastOf flags ?: true) == false
