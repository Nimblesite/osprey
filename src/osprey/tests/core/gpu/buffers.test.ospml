(** [GPU-BUFFER-ELEM]: one index read back through gpuGet equals the source. *)
denseRead (buffer, values, i) = match gpuGet (buffer, i)
    Success actual => match listGet (values, i)
        Success expected => actual == expected
        Error _ => false
    Error _ => false
(** [GPU-BUFFER-ELEM]: an out-of-bounds gpuGet errors, never a sentinel. *)
denseOutOfBounds (buffer, index) = match gpuGet (buffer, index)
    Error _ => true
    Success _ => false
(** [GPU-BUFFER-ELEM]: every scalar width narrows into dense storage and widens back exactly — gpuGet reads each index at the element's own width, the identity kernel and fromGpu both return the source list, and out-of-bounds reads error. *)
denseRoundTrip (label, values) = withIndices (length values, \indices => withUpload(values, \buffer => withBuffer(gpuMap (buffer, \value => value), \mapped => withBuffer(gpuZipWith (indices, buffer, \(index, value) => gpuGet (buffer, index) ?: value), \gathered => checkAll label [
    lengthIs (buffer, length values), materializesAs (buffer, values), materializesAs (mapped, values), materializesAs (gathered, values), range (0, length values) |> fold (true, \(ok, i) => ok && denseRead (buffer, values, i)), denseOutOfBounds (buffer, (-1)), denseOutOfBounds (buffer, length values)
]))))
denseWidthsCase () =
    i8 : List<int8>
    i8 = [-128, 0, 127]
    u8 : List<uint8>
    u8 = [0, 128, 255]
    i16 : List<int16>
    i16 = [-32768, 0, 32767]
    u16 : List<uint16>
    u16 = [0, 32768, 65535]
    i32 : List<int32>
    i32 = [-2147483648, 0, 2147483647]
    u32 : List<uint32>
    u32 = [0, 2147483648, 4294967295]
    f16 : List<float16>
    f16 = [-0.5, 0.0, 1.5]
    f32 : List<float32>
    f32 = [-0.5, 0.0, 1.5]
    denseRoundTrip ("dense int8", i8)
    denseRoundTrip ("dense uint8", u8)
    denseRoundTrip ("dense int16", i16)
    denseRoundTrip ("dense uint16", u16)
    denseRoundTrip ("dense int32", i32)
    denseRoundTrip ("dense uint32", u32)
    denseRoundTrip ("dense float16", f16)
    denseRoundTrip ("dense float32", f32)
    denseRoundTrip ("dense bool", [true, false, true])
    denseRoundTrip ("dense int", [-9223372036854775808, 0, 9223372036854775807])
    denseRoundTrip ("dense float", [-0.5, 0.0, 1.5])
(** [LLM-MATMUL-QUANT]: two Q4_K weight rows (scale 1.0, minimum 0, sub-block 0 at
    scale 1 then 2, weights 1 in the low nibbles of its first 32 bytes) against
    x = 0..255 give 496 and 992 on every backend; a wrong type name, an inner
    dimension off the block size and a short weight buffer are each an Error. *)
(** Build the `count`-long run of `value` a Q4_K block is laid out from. *)
repeated (value, count) = toList (range (0, count) |> map (\_ => value))
(** Lay out one 144-byte Q4_K weight row: scale 1.0 and minimum 0 in
    [0, 60, 0, 0], sub-block 0 at scale `scale` over zero scale bytes, then
    weights 1 in the low nibbles of its first 32 bytes (33) and zero weights
    beyond them. *)
q4KBlock scale =
    head : List<uint8>
    head = [0, 60, 0, 0, scale]
    listConcat(listConcat(listConcat(head, repeated(0, 11)), repeated(33, 32)), repeated(0, 96))
quantWeights () =
    bytes = listConcat(q4KBlock(1), q4KBlock(2))
    toGpu(bytes)
quantMessage (result) = match result
    Success value => "unexpected success ${gpuLength(value)}"
    Error message => toString(message)
(** The exact reason gpuMatMulQuant reports for `x` against the Q4_K weights `w` under `kind`, `rows`, `inner` and `cols` is `message`. *)
rejectsAs (x, w, kind, rows, inner, cols, message) = quantMessage (gpuMatMulQuant (x, w, kind, rows, inner, cols)) == message
quantCase () = withBuffer(toGpu(range(0, 256)), \ints => withBuffer(gpuMap(ints, \i => toFloat32(i)), \x => withBuffer(quantWeights(), \w => withBuffer(gpuMatMulQuant(x, w, "Q4_K", 1, 256, 2), \out => checkAll("quantized product", [
    lengthIs (out, 2), elementsFrom (out, 0, toFloat32(0.0), [toFloat32(496.0), toFloat32(992.0)]), rejectsAs (x, w, "Q2_K", 1, 256, 2, "gpuMatMulQuant: weights: unsupported tensor type; expected Q4_K, Q8_0, Q6_K, Q5_K, Q3_K, IQ4_NL, IQ4_XS, IQ3_S"), rejectsAs (x, w, "Q4_K", 1, 200, 2, "gpuMatMulQuant: inner: must be a positive multiple of 256"), rejectsAs (x, w, "Q4_K", 1, 256, 3, "gpuMatMulQuant: weights: has 288 elements, the stated shape needs 432"), rejectsAs (x, w, "Q4_K", 2, 256, 2, "gpuMatMulQuant: x operand: has 256 elements, the stated shape needs 512")
])))))
exactTests [
    { name = "buffer literals store elements densely at constant indices", work = literalCase },
    { name = "a list value copies into a buffer element for element", work = listCopyCase },
    { name = "gpu buffers round-trip lists densely", work = roundTripCase },
    { name = "the empty buffer answers every builtin without elements", work = emptyCase },
    { name = "a one-element buffer bounds gpuGet to index zero", work = singletonCase },
    { name = "gpuGet errors identically at both ends of every buffer", work = boundsCase },
    { name = "gpuIota spans zero, one and two hundred thousand indices", work = iotaCase },
    { name = "int, float and bool words survive the identity kernel", work = elementCase },
    { name = "buffers keep their tag through lets, pipes, params and returns", work = flowCase },
    { name = "aliased bindings observe one immutable buffer", work = aliasCase },
    { name = "a fused iterator buffer is addressable element by element", work = fusionCase },
    { name = "pure int kernels map and fold on buffers", work = intKernelCase },
    { name = "float kernels keep element bits through map and fold", work = floatKernelCase },
    { name = "kernels may change the element scalar type", work = boolKernelCase },
    { name = "the copy path stays exact at a hundred thousand elements", work = bigCase },
    { name = "a block-bodied kernel keeps its internal let bindings", work = blockBodiedKernelCase },
    { name = "every scalar width survives dense storage and round-trips through gpuGet", work = denseWidthsCase },
    { name = "the quantized product decodes Q4_K blocks in place on every backend", work = quantCase }
]
