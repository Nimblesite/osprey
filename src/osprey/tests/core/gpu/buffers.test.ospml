(** Pin the one-element buffer: index 0 is the only address in bounds, so both 1 and -1 fail, and a fold sees exactly one element. *)
singletonCase () = withIndices (1, \indices1 => singletonWith (indices1))
singletonWith (indices1) = withBuffer(toGpu ([42]), \lone => withBuffer(toGpu ([2.5]), \loneF => withBuffer(toGpu ([false]), \loneB => singletonWithUploaded(indices1, lone, loneF, loneB))))
singletonWithUploaded (indices1, lone, loneF, loneB) =
    withBuffer (doubledInts(lone), \doubled => checkAll "single-element buffers" [
            structuralEquals [gpuLength lone, gpuLength loneF, gpuLength loneB] [1, 1, 1],
            structuralEquals [gpuLength (indices1), (lastOf lone ?: 0), gpuLength doubled] [1, 42, 1],
            readsTo (indices1, [0], 9, [0]), readsTo (lone, [0, 1, -1], 9, [42, 9, 9]), readsTo (loneF, [0, 1], 9.5, [2.5, 9.5]), readsTo (loneB, [0, 1], true, [false, true]),
            errorsAt (lone, [1]), errorsAt (loneF, [-1]), errorsAt (loneB, [2]), readback (lone, 0) == "42",
            (lastOf loneF ?: 9.5) == 2.5, (lastOf loneB ?: true) == false, foldsIntsTo (lone, 0, 42), foldsFloatsTo (loneF, 0.0, 2.5),
            foldsBoolsTo (loneB, 0, 0), readsTo (doubled, [0], 0, [84]), listLengthIs (fromGpu (lone), 1),
