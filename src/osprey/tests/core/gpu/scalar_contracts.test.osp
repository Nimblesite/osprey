let emptyRead: List<int> = []
// Scalar transfer conformance: inferred element types survive runtime lists,
// GPU buffers and repeated crossings [GPU-BUFFER-ELEM] [GPU-BUFFER-FROM-LIST]
// [GPU-BUFFER-TO-LIST]. Host kernels retain [FLOAT-IEEE-RESULTS].

fn countTrue(a, x) = match x {
    true => (a + 1)
    false => a
}
/// listReverse forces the runtime-list copy path; a direct literal would take
/// [GPU-BUFFER-LITERAL] and would not exercise the runtime element metadata.
fn floatListValue() = listReverse([2.5, 1.5])
fn boolListValue() = listReverse([true, false, false])
fn listValueTagsCase() = withBuffer(toGpu(floatListValue()), fn(floats) => withBuffer(toGpu(boolListValue()), fn(flags) => checkAll("runtime list values keep GPU scalar tags", [
            gpuLength(floats) == 2, (gpuGet(floats, 0) ?: 99.0) == 1.5, (gpuGet(floats, 1) ?: 99.0) == 2.5, gpuSatisfies(gpuFold(floats, 0.0, addF), fn(uploaded15) => (uploaded15) == 4.0), gpuLength(flags) == 3, (gpuGet(flags, 0) ?: true) == false, (gpuGet(flags, 1) ?: true) == false, (gpuGet(flags, 2) ?: false) == true,
            gpuSatisfies(gpuFold(flags, 0, countTrue), fn(uploaded14) => (uploaded14) == 1)
    ])))
fn fromGpuScalarCase() = withBuffer(toGpu([1.25, 2.5, 5.0]), fn(uploaded17) => withBuffer(fromGpu(uploaded17), fn(read0) => {
            let floats = read0
            withBuffer(toGpu([true, false, true]), fn(uploaded16) => withBuffer(fromGpu(uploaded16), fn(read1) => {
                    let flags = read1
                    checkAll("fromGpu preserves float and bool list elements", [
                            listLength(floats) == 3, (listGet(floats, 0) ?: 99.0) == 1.25, (listGet(floats, 1) ?: 99.0) == 2.5, (listGet(floats, 2) ?: 99.0) == 5.0, listLength(flags) == 3, (listGet(flags, 0) ?: false) == true, (listGet(flags, 1) ?: true) == false, (listGet(flags, 2) ?: false) == true
                    ])
                }))
        }))
fn repeatedCrossingCase() = withBuffer(toGpu(floatListValue()), fn(uploaded15) => withBuffer(fromGpu(uploaded15), fn(read0) => withBuffer(toGpu(read0), fn(floats) => withBuffer(toGpu(boolListValue()), fn(uploaded14) => withBuffer(fromGpu(uploaded14), fn(read1) => withBuffer(toGpu(read1), fn(flags) => withBuffer(fromGpu(floats), fn(read2) => withBuffer(fromGpu(flags), fn(read3) => {
                                let floatsBack = read2
                                let flagsBack = read3
                                checkAll("repeated host and GPU crossings retain scalar types", [
                                        gpuLength(floats) == 2, (gpuGet(floats, 0) ?: 99.0) == 1.5, (gpuGet(floats, 1) ?: 99.0) == 2.5, gpuSatisfies(gpuFold(floats, 0.0, addF), fn(uploaded13) => (uploaded13) == 4.0), (listGet(floatsBack, 0) ?: 99.0) == 1.5, (listGet(floatsBack, 1) ?: 99.0) == 2.5,
                                        gpuLength(flags) == 3, gpuSatisfies(gpuFold(flags, 0, countTrue), fn(uploaded12) => (uploaded12) == 1), (listGet(flagsBack, 0) ?: true) == false, (listGet(flagsBack, 2) ?: false) == true
                                ])
                        }))))))))
/// With no first element to inspect, lowering must use the inferred result type
/// rather than leave the owner bare and let gpuGet default the word to int.
fn emptyTypedLiteralCase() = {
    checkAll("empty literals retain contextual scalar types", [
            gpuSatisfies(toGpu([]), fn(uploaded11: GpuBuffer<int>) => gpuLength(uploaded11) == 0), gpuSatisfies(toGpu([]), fn(uploaded10) => (gpuGet(uploaded10, 0) ?: 9.5) == 9.5), gpuSatisfies(toGpu([]), fn(uploaded9) => (gpuGet(uploaded9, 0) ?: true) == true),
            gpuSatisfies(toGpu(emptyRead), fn(uploaded8) => gpuSatisfies(fromGpu(uploaded8), fn(checked0) => listLength(checked0) == 0))
    ])
}
test("runtime list values retain float and bool GPU element tags", exactly(listValueTagsCase))
test("fromGpu reads float and bool elements at their source types", exactly(fromGpuScalarCase))
test("repeated List and GpuBuffer crossings preserve scalar types", exactly(repeatedCrossingCase))
test("empty GPU literals retain contextual scalar types", exactly(emptyTypedLiteralCase))
/// [FLOAT-IEEE-RESULTS]: host kernels obey the scalar arithmetic contract.
fn squareScalar(value) = value * value
fn subtractSelf(value) = value - value
fn divideZero(value) = value / 0.0
fn remainderZero(value) = value % -0.0
fn gpuIeeeCase() = withBuffer(toGpu([10000000000000000.0]), fn(seed) => withBuffer(gpuMap(seed, squareScalar), fn(uploaded9) => withBuffer(gpuMap(uploaded9, squareScalar), fn(fourth) => withBuffer(gpuMap(fourth, squareScalar), fn(uploaded10) => withBuffer(gpuMap(uploaded10, squareScalar), fn(uploaded17) => withBuffer(gpuMap(uploaded17, squareScalar), fn(infinityBuffer) => {
                            let infinity = gpuGet(infinityBuffer, 0) ?: 0.0
                            withBuffer(gpuMap(infinityBuffer, subtractSelf), fn(nanBuffer) => {
                                    let nan = gpuGet(nanBuffer, 0) ?: 0.0
                                    withBuffer(toGpu([infinity, nan, -0.0]), fn(uploaded7) => withBuffer(fromGpu(uploaded7), fn(read0) => withBuffer(toGpu(listReverse(read0)), fn(roundTrip) => checkAll("host GPU kernels preserve non-finite values and signed zero", [
                                            infinity > 10000000000000000.0, nan != nan, gpuSatisfies(gpuFold(infinityBuffer, 0.0, addF), fn(uploaded8) => (uploaded8) == infinity), (gpuGet(roundTrip, 2) ?: 0.0) == infinity, (gpuGet(roundTrip, 1) ?: 0.0) != (gpuGet(roundTrip, 1) ?: 0.0), toString(gpuGet(roundTrip, 0) ?: 1.0) == "-0.0"
                                    ]))))
                                })
                    }))))))
/// [GPU-DEVICE-FAULT] A selected device reports its fault without invoking host recovery.
fn deviceFault(result, reason) = match result {
    Success _ => false
    Error { message } => contains(message, "kernel: ") && contains(message, reason)
}
fn gpuFloatZeroCase() = {
    mut faults = ""
    handle Arith { divideByZero op _ => { faults = faults + op
            0.25 } }
    withBuffer(toGpu([1.0, 0.0, -1.0]), fn(input) => {
            let quotients = gpuMap(input, divideZero)
            let remainders = gpuMap(input, remainderZero)
            match gpuDevice() == "host" {
                true => checkAll("host GPU zero divisors use the enclosing policy", [
                        gpuSatisfies(quotients, fn(q) => gpuSatisfies(gpuFold(q, 0.0, addF), fn(total) => total == 0.75)),
                        gpuSatisfies(remainders, fn(r) => gpuSatisfies(gpuFold(r, 0.0, addF), fn(total) => total == 0.75)),
                        faults == "///%%%"
                ])
                false => checkAll("host GPU zero divisors use the enclosing policy", [
                        deviceFault(quotients, "division by zero"), deviceFault(remainders, "remainder by zero"), faults == ""
                ])
            }
        })
}
test("host GPU arithmetic preserves IEEE non-finite values", gpuIeeeCase)
test("host GPU float zero divisors use explicit recovery", gpuFloatZeroCase)
/// [BUILTIN-ABS]: builtin callbacks use their inferred scalar ABI and policy.
fn gpuAbsoluteCase() = {
    withBuffer(toGpu([-2.5, -0.0, 3.5]), fn(value) => withBuffer(gpuMap(value, abs), fn(floats) => {
                    mut faults = ""
                    handle Arith { overflow op lhs rhs wrapped => {
                            checkAll("GPU abs overflow payload", [
                                    lhs == -9223372036854775808, rhs == 0, wrapped == lhs
                            ])
                            faults = faults + op
                            17
                        } }
                    withBuffer(toGpu([-9223372036854775808, -3, 4]), fn(value) => {
                            match gpuMap(value, abs) {
                                Success { integers } => checkAll("GPU abs keeps float and integer callback contracts", [
                                        (gpuGet(floats, 0) ?: 0.0) == 2.5, toString(gpuGet(floats, 1) ?: 1.0) == "0.0", (gpuGet(floats, 2) ?: 0.0) == 3.5, (gpuGet(integers, 0) ?: 0) == 17, (gpuGet(integers, 1) ?: 0) == 3, (gpuGet(integers, 2) ?: 0) == 4, faults == "abs"
                                ])
                                Error { message } => checkAll("GPU abs keeps float and integer callback contracts", [
                                        (gpuGet(floats, 0) ?: 0.0) == 2.5, toString(gpuGet(floats, 1) ?: 1.0) == "0.0", (gpuGet(floats, 2) ?: 0.0) == 3.5,
                                        gpuDevice() != "host", contains(message, "integer overflow"), faults == "",
                                        gpuSatisfies(toGpu([-3, 4]), fn(safe) => gpuSatisfies(gpuMap(safe, abs), fn(integers) => (gpuGet(integers, 0) ?: 0) == 3 && (gpuGet(integers, 1) ?: 0) == 4))
                                ])
                            }
                        })
                }))
}
test("host GPU abs callbacks retain numeric types and recovery", gpuAbsoluteCase)
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 64.
fn remainder64Case() = gpuSatisfies(toGpu([toFloat(5.5), toFloat(-5.5), toFloat(-0.0), floatFromBits(1), floatFromBits(9218868437227405312), floatFromBits(9221120237041090560)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat(2.0)), fn(output) => gpuLength(output) == 6 && gpuSatisfies(gpuGet(output, 0), fn(x) => floatBits(x) == 4609434218613702656) && gpuSatisfies(gpuGet(output, 1), fn(x) => floatBits(x) == -4613937818241073152) && gpuSatisfies(gpuGet(output, 2), fn(x) => floatBits(x) == -9223372036854775808) && gpuSatisfies(gpuGet(output, 3), fn(x) => floatBits(x) == 1) && gpuSatisfies(gpuGet(output, 4), fn(x) => x != x) && gpuSatisfies(gpuGet(output, 5), fn(x) => x != x)))
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 32.
fn remainder32Case() = gpuSatisfies(toGpu([toFloat32(5.5), toFloat32(-5.5), toFloat32(-0.0), float32FromBits(1), float32FromBits(2139095040), float32FromBits(2143289344)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat32(2.0)), fn(output) => gpuLength(output) == 6 && gpuSatisfies(gpuGet(output, 0), fn(x) => float32Bits(x) == 1069547520) && gpuSatisfies(gpuGet(output, 1), fn(x) => float32Bits(x) == -1077936128) && gpuSatisfies(gpuGet(output, 2), fn(x) => float32Bits(x) == -2147483648) && gpuSatisfies(gpuGet(output, 3), fn(x) => float32Bits(x) == 1) && gpuSatisfies(gpuGet(output, 4), fn(x) => x != x) && gpuSatisfies(gpuGet(output, 5), fn(x) => x != x)))
/// [BUILTIN-MATH-FLOATDIV] floatDiv is the IEEE quotient at width 64 on the host and in a kernel: a zero divisor answers an infinity of the right sign or NaN, never an Arith operation.
fn floatDiv64Case() = gpuSatisfies(toGpu([toFloat(1.0), toFloat(-1.0), toFloat(0.0), toFloat(6.0), toFloat(1.0)]), fn(numerators) => gpuSatisfies(toGpu([toFloat(0.0), toFloat(0.0), toFloat(0.0), toFloat(4.0), toFloat(-0.0)]), fn(divisors) => gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)), fn(q) => gpuLength(q) == 5 && gpuSatisfies(gpuGet(q, 0), fn(x) => floatBits(x) == 9218868437227405312) && gpuSatisfies(gpuGet(q, 1), fn(x) => floatBits(x) == -4503599627370496) && gpuSatisfies(gpuGet(q, 2), fn(x) => x != x) && gpuSatisfies(gpuGet(q, 3), fn(x) => x == toFloat(1.5)) && gpuSatisfies(gpuGet(q, 4), fn(x) => floatBits(x) == -4503599627370496) && floatBits(floatDiv(toFloat(1.0), toFloat(0.0))) == 9218868437227405312 && floatDiv(toFloat(6.0), toFloat(4.0)) == toFloat(1.5))))
/// [BUILTIN-MATH-FLOATDIV] The same quotients at width 32, the width the Qwen kernels compute in.
fn floatDiv32Case() = gpuSatisfies(toGpu([toFloat32(1.0), toFloat32(-1.0), toFloat32(0.0), toFloat32(6.0), toFloat32(1.0)]), fn(numerators) => gpuSatisfies(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(4.0), toFloat32(-0.0)]), fn(divisors) => gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)), fn(q) => gpuLength(q) == 5 && gpuSatisfies(gpuGet(q, 0), fn(x) => float32Bits(x) == 2139095040) && gpuSatisfies(gpuGet(q, 1), fn(x) => float32Bits(x) == -8388608) && gpuSatisfies(gpuGet(q, 2), fn(x) => x != x) && gpuSatisfies(gpuGet(q, 3), fn(x) => x == toFloat32(1.5)) && gpuSatisfies(gpuGet(q, 4), fn(x) => float32Bits(x) == -8388608) && float32Bits(floatDiv(toFloat32(1.0), toFloat32(0.0))) == 2139095040 && floatDiv(toFloat32(6.0), toFloat32(4.0)) == toFloat32(1.5))))
/// [BUILTIN-MATH-FLOATDIV] The same quotients at width 16, which a kernel computes in binary32 and rounds back.
fn floatDiv16Case() = gpuSatisfies(toGpu([toFloat16(1.0), toFloat16(-1.0), toFloat16(0.0), toFloat16(6.0), toFloat16(1.0)]), fn(numerators) => gpuSatisfies(toGpu([toFloat16(0.0), toFloat16(0.0), toFloat16(0.0), toFloat16(4.0), toFloat16(-0.0)]), fn(divisors) => gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)), fn(q) => gpuLength(q) == 5 && gpuSatisfies(gpuGet(q, 0), fn(x) => float16Bits(x) == 31744) && gpuSatisfies(gpuGet(q, 1), fn(x) => float16Bits(x) == -1024) && gpuSatisfies(gpuGet(q, 2), fn(x) => x != x) && gpuSatisfies(gpuGet(q, 3), fn(x) => x == toFloat16(1.5)) && gpuSatisfies(gpuGet(q, 4), fn(x) => float16Bits(x) == -1024) && float16Bits(floatDiv(toFloat16(1.0), toFloat16(0.0))) == 31744 && floatDiv(toFloat16(6.0), toFloat16(4.0)) == toFloat16(1.5))))
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 16.
fn remainder16Case() = gpuSatisfies(toGpu([toFloat16(5.5), toFloat16(-5.5), toFloat16(-0.0), float16FromBits(1), float16FromBits(31744), float16FromBits(32256)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat16(2.0)), fn(output) => gpuLength(output) == 6 && gpuSatisfies(gpuGet(output, 0), fn(x) => float16Bits(x) == 15872) && gpuSatisfies(gpuGet(output, 1), fn(x) => float16Bits(x) == -16896) && gpuSatisfies(gpuGet(output, 2), fn(x) => float16Bits(x) == -32768) && gpuSatisfies(gpuGet(output, 3), fn(x) => float16Bits(x) == 1) && gpuSatisfies(gpuGet(output, 4), fn(x) => x != x) && gpuSatisfies(gpuGet(output, 5), fn(x) => x != x)))
/// The sized bit views run as kernels too: binary32 words through
/// float32FromBits/float32Bits and binary16 words through float16FromBits/float16Bits
/// come back as the words they were, on the host and on a device.
fn sized32BitsCase() = {
    let words = [toInt32(0), toInt32(-2147483648), toInt32(1065353216), toInt32(-1082130432), toInt32(2139095040), toInt32(2143289344), toInt32(-4194304), toInt32(1), toInt32(8388607)]
    gpuSatisfies(toGpu(words), fn(input) => gpuSatisfies(gpuMap(input, float32FromBits), fn(floats) => gpuSatisfies(gpuMap(floats, float32Bits), fn(restored) => gpuLength(restored) == listLength(words) && fold(range(0, listLength(words)), true, fn(ok, i) => ok && (gpuGet(restored, i) ?: toInt32(0)) == (listGet(words, i) ?: toInt32(1))))))
}
fn sized16BitsCase() = {
    let words = [toInt16(0), toInt16(-32768), toInt16(15360), toInt16(-17408), toInt16(31744), toInt16(32256), toInt16(1), toInt16(1023), toInt16(-1025)]
    gpuSatisfies(toGpu(words), fn(input) => gpuSatisfies(gpuMap(input, float16FromBits), fn(halves) => gpuSatisfies(gpuMap(halves, float16Bits), fn(restored) => gpuLength(restored) == listLength(words) && fold(range(0, listLength(words)), true, fn(ok, i) => ok && (gpuGet(restored, i) ?: toInt16(0)) == (listGet(words, i) ?: toInt16(1))))))
}
/// Emitted bit-conversion kernels must preserve signed zeros and NaN payloads.
fn gpuBitRoundTripCase() = {
    let words = [0, -9223372036854775808, 4607182418800017408, -4616189618054758400,
        9218868437227405312, -4503599627370496, 9221120237041090851, -2251799813684957,
        9218868437227405603, -4503599627370205, 1, -9223372036854775807]
    withBuffer(toGpu(words), fn(value) => withBuffer(gpuMap(value, floatFromBits), fn(uploaded1) => withBuffer(gpuMap(uploaded1, floatBits), fn(restored) => checkAll("GPU bit conversions retain every payload bit", [
                    remainder64Case(), remainder32Case(), remainder16Case(), floatDiv64Case(), floatDiv32Case(), floatDiv16Case(), sized32BitsCase(), sized16BitsCase(),
                    gpuLength(restored) == listLength(words), fold(range(0, listLength(words)), true, fn(ok, i) => ok && (gpuGet(restored, i) ?: 0) == (listGet(words, i) ?: 1))
            ]))))
}
test("GPU bit conversion kernels preserve exact words", exactly(gpuBitRoundTripCase))
