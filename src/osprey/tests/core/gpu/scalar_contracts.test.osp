let emptyRead: List<int> = []
// Scalar transfer conformance: inferred element types survive runtime lists,
// GPU buffers and repeated crossings [GPU-BUFFER-ELEM] [GPU-BUFFER-FROM-LIST]
// [GPU-BUFFER-TO-LIST]. Host kernels retain [FLOAT-IEEE-RESULTS].

fn countTrue(a, x) = match x {
    true => (a + 1)
    false => a
}
/// The shared float and bool reductions every case repeats.
fn floatsSum(floats) = gpuFold(floats, 0.0, addF)
fn trueCount(flags) = gpuFold(flags, 0, countTrue)
/// listReverse forces the runtime-list copy path; a direct literal would take
/// [GPU-BUFFER-LITERAL] and would not exercise the runtime element metadata.
fn floatListValue() = listReverse([2.5, 1.5])
fn boolListValue() = listReverse([true, false, false])
fn listValueTagsCase() = withBuffer(toGpu(floatListValue()), fn(floats) => withBuffer(toGpu(boolListValue()), fn(flags) => checkAll("runtime list values keep GPU scalar tags", [
            gpuLength(floats) == 2, (gpuGet(floats, 0) ?: 99.0) == 1.5, (gpuGet(floats, 1) ?: 99.0) == 2.5, gpuSatisfies(floatsSum(floats), fn(sum) => sum == 4.0), gpuLength(flags) == 3, (gpuGet(flags, 0) ?: true) == false, (gpuGet(flags, 1) ?: true) == false, (gpuGet(flags, 2) ?: false) == true,
            gpuSatisfies(trueCount(flags), fn(count) => count == 1)
    ])))
fn fromGpuScalarCase() = withBuffer(toGpu([1.25, 2.5, 5.0]), fn(uploaded17) => withBuffer(fromGpu(uploaded17), fromGpuScalarFloats))
fn fromGpuScalarFloats(read0) = {
    let floats = read0
    withBuffer(toGpu([true, false, true]), fn(uploaded16) => withBuffer(fromGpu(uploaded16), fn(read1) => fromGpuScalarFlags(floats, read1)))
}
fn fromGpuScalarFlags(floats, read1) = {
    let flags = read1
    checkAll("fromGpu preserves float and bool list elements", [
            listLength(floats) == 3, (listGet(floats, 0) ?: 99.0) == 1.25, (listGet(floats, 1) ?: 99.0) == 2.5, (listGet(floats, 2) ?: 99.0) == 5.0, listLength(flags) == 3, (listGet(flags, 0) ?: false) == true, (listGet(flags, 1) ?: true) == false, (listGet(flags, 2) ?: false) == true
    ])
}
fn repeatedCrossingCase() = {
    use uploaded15 <- withBuffer(toGpu(floatListValue()))
    use read0 <- withBuffer(fromGpu(uploaded15))
    use floats <- withBuffer(toGpu(read0))
    use uploaded14 <- withBuffer(toGpu(boolListValue()))
    use read1 <- withBuffer(fromGpu(uploaded14))
    use flags <- withBuffer(toGpu(read1))
    use read2 <- withBuffer(fromGpu(floats))
    use read3 <- withBuffer(fromGpu(flags))
    repeatedCrossingWith(floats, flags, read2, read3)
}
fn repeatedCrossingWith(floats, flags, read2, read3) = {
    let floatsBack = read2
    let flagsBack = read3
    checkAll("repeated host and GPU crossings retain scalar types", [
            gpuLength(floats) == 2, (gpuGet(floats, 0) ?: 99.0) == 1.5, (gpuGet(floats, 1) ?: 99.0) == 2.5, gpuSatisfies(floatsSum(floats), fn(sum) => sum == 4.0), (listGet(floatsBack, 0) ?: 99.0) == 1.5, (listGet(floatsBack, 1) ?: 99.0) == 2.5,
            gpuLength(flags) == 3, gpuSatisfies(trueCount(flags), fn(count) => count == 1), (listGet(flagsBack, 0) ?: true) == false, (listGet(flagsBack, 2) ?: false) == true
    ])
}
/// With no first element to inspect, lowering must use the inferred result type
/// rather than leave the owner bare and let gpuGet default the word to int.
fn emptyTypedLiteralCase() = {
    checkAll("empty literals retain contextual scalar types", [
            gpuSatisfies(toGpu([]), fn(uploaded11: GpuBuffer<int>) => gpuLength(uploaded11) == 0), gpuSatisfies(toGpu([]), fn(uploaded10) => (gpuGet(uploaded10, 0) ?: 9.5) == 9.5), gpuSatisfies(toGpu([]), fn(uploaded9) => (gpuGet(uploaded9, 0) ?: true) == true),
            gpuSatisfies(toGpu(emptyRead), fn(uploaded8) => gpuSatisfies(fromGpu(uploaded8), fn(checked0) => listLength(checked0) == 0))
    ])
}
exactTests([
    { name: "runtime list values retain float and bool GPU element tags", work: listValueTagsCase },
    { name: "fromGpu reads float and bool elements at their source types", work: fromGpuScalarCase },
    { name: "repeated List and GpuBuffer crossings preserve scalar types", work: repeatedCrossingCase },
    { name: "empty GPU literals retain contextual scalar types", work: emptyTypedLiteralCase }
])
/// [FLOAT-IEEE-RESULTS]: host kernels obey the scalar arithmetic contract.
fn squareScalar(value) = value * value
fn subtractSelf(value) = value - value
fn divideZero(value) = value / 0.0
fn remainderZero(value) = value % -0.0
fn gpuIeeeCase() = {
    use seed <- withBuffer(toGpu([10000000000000000.0]))
    use uploaded9 <- withBuffer(gpuMap(seed, squareScalar))
    use fourth <- withBuffer(gpuMap(uploaded9, squareScalar))
    use uploaded10 <- withBuffer(gpuMap(fourth, squareScalar))
    use uploaded17 <- withBuffer(gpuMap(uploaded10, squareScalar))
    withBuffer(gpuMap(uploaded17, squareScalar), gpuIeeeInfinity)
}
fn gpuIeeeInfinity(infinityBuffer) = {
    let infinity = gpuGet(infinityBuffer, 0) ?: 0.0
    withBuffer(gpuMap(infinityBuffer, subtractSelf), fn(nanBuffer) => gpuIeeeNaN(infinityBuffer, infinity, nanBuffer))
}
fn gpuIeeeNaN(infinityBuffer, infinity, nanBuffer) = {
    let nan = gpuGet(nanBuffer, 0) ?: 0.0
    withBuffer(toGpu([infinity, nan, -0.0]), fn(uploaded7) => withBuffer(fromGpu(uploaded7), fn(read0) => withBuffer(toGpu(listReverse(read0)), fn(roundTrip) => checkAll("host GPU kernels preserve non-finite values and signed zero", [
                        infinity > 10000000000000000.0, nan != nan, gpuSatisfies(floatsSum(infinityBuffer), fn(sum) => sum == infinity), (gpuGet(roundTrip, 2) ?: 0.0) == infinity, (gpuGet(roundTrip, 1) ?: 0.0) != (gpuGet(roundTrip, 1) ?: 0.0), toString(gpuGet(roundTrip, 0) ?: 1.0) == "-0.0"
                ]))))
}
/// gpuOpError turns a refused GPU operation into the failed check that names it.
fn gpuOpError(message) = check("GPU operation", "success", toString(message))
/// [GPU-DEVICE-FAULT] A selected device reports its fault without invoking host recovery.
fn deviceFault(result, reason) = match result {
    Success _ => false
    Error { message } => contains(message, "kernel: ") && contains(message, reason)
}
fn gpuFloatZeroCase() = {
    mut faults = ""
    handle Arith { divideByZero op _ => { faults = faults + op
            0.25 } }
    match toGpu([1.0, 0.0, -1.0]) { Success { input } => {
            let quotients = gpuMap(input, divideZero)
            let remainders = gpuMap(input, remainderZero)
            match gpuDevice() == "host" {
                true => checkAll("host GPU zero divisors use the enclosing policy", [
                        gpuSatisfies(quotients, fn(q) => gpuEquals(floatsSum(q), 0.75)),
                        gpuSatisfies(remainders, fn(r) => gpuEquals(floatsSum(r), 0.75)),
                        faults == "///%%%"
                ])
                false => checkAll("host GPU zero divisors use the enclosing policy", [
                        deviceFault(quotients, "division by zero"), deviceFault(remainders, "remainder by zero"), faults == ""
                ])
            }
        } Error { message } => gpuOpError(message) }
}
testCases([
    { name: "host GPU arithmetic preserves IEEE non-finite values", work: gpuIeeeCase },
    { name: "host GPU float zero divisors use explicit recovery", work: gpuFloatZeroCase }
])
/// [BUILTIN-ABS]: builtin callbacks use their inferred scalar ABI and policy.
fn absFloatsKept(floats) = (gpuGet(floats, 0) ?: 0.0) == 2.5 && toString(gpuGet(floats, 1) ?: 1.0) == "0.0" && (gpuGet(floats, 2) ?: 0.0) == 3.5
fn gpuAbsoluteCase() = {
    match toGpu([-2.5, -0.0, 3.5]) { Success { value } => {match gpuMap(value, abs) { Success { floats } => {
                    mut faults = ""
                    handle Arith { overflow op lhs rhs wrapped => {
                            checkAll("GPU abs overflow payload", [
                                    lhs == -9223372036854775808, rhs == 0, wrapped == lhs
                            ])
                            faults = faults + op
                            17
                        } }
                    match toGpu([-9223372036854775808, -3, 4]) { Success { value } => {match gpuMap(value, abs) { Success { integers } => {
                                    checkAll("GPU abs keeps float and integer callback contracts", [
                                            absFloatsKept(floats), (gpuGet(integers, 0) ?: 0) == 17, (gpuGet(integers, 1) ?: 0) == 3, (gpuGet(integers, 2) ?: 0) == 4, faults == "abs"
                                    ])
                                } Error { message } => checkAll("GPU abs keeps float and integer callback contracts", [
                                        absFloatsKept(floats),
                                        gpuDevice() != "host", contains(message, "integer overflow"), faults == "",
                                        gpuSatisfies(toGpu([-3, 4]), fn(safe) => gpuSatisfies(gpuMap(safe, abs), fn(integers) => (gpuGet(integers, 0) ?: 0) == 3 && (gpuGet(integers, 1) ?: 0) == 4))
                                ]) }
                        } Error { message } => gpuOpError(message) }
                } Error { message } => gpuOpError(message) }
        } Error { message } => gpuOpError(message) }
}
test("host GPU abs callbacks retain numeric types and recovery", gpuAbsoluteCase)
/// Shared element probes: per-width bit words behind one shape.
fn gpuWordMatches(values, at, word, toBits) = gpuSatisfies(gpuGet(values, at), fn(x) => toBits(x) == word)
fn gpuNanAt(values, at) = gpuSatisfies(gpuGet(values, at), fn(x) => x != x)
fn remaindersMatch(output, toBits, positive, negative, negativeZero, subnormal) =
    gpuLength(output) == 6 && gpuWordMatches(output, 0, positive, toBits) && gpuWordMatches(output, 1, negative, toBits)
        && gpuWordMatches(output, 2, negativeZero, toBits) && gpuWordMatches(output, 3, subnormal, toBits)
        && gpuNanAt(output, 4) && gpuNanAt(output, 5)
fn quotientsMatch(q, toBits, positiveInfinity, negativeInfinity, ordinary) =
    gpuLength(q) == 5 && gpuWordMatches(q, 0, positiveInfinity, toBits) && gpuWordMatches(q, 1, negativeInfinity, toBits)
        && gpuNanAt(q, 2) && gpuEquals(gpuGet(q, 3), ordinary)
        && gpuWordMatches(q, 4, negativeInfinity, toBits)
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 64.
fn remainder64Case() = gpuSatisfies(toGpu([toFloat(5.5), toFloat(-5.5), toFloat(-0.0), floatFromBits(1), floatFromBits(9218868437227405312), floatFromBits(9221120237041090560)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat(2.0)), fn(output) => remaindersMatch(output, floatBits, 4609434218613702656, -4613937818241073152, -9223372036854775808, 1)))
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 32.
fn remainder32Case() = gpuSatisfies(toGpu([toFloat32(5.5), toFloat32(-5.5), toFloat32(-0.0), float32FromBits(1), float32FromBits(2139095040), float32FromBits(2143289344)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat32(2.0)), fn(output) => remaindersMatch(output, float32Bits, 1069547520, -1077936128, -2147483648, 1)))
/// [BUILTIN-MATH-FLOATDIV] floatDiv is the IEEE quotient at width 64 on the host and in a kernel: a zero divisor answers an infinity of the right sign or NaN, never an Arith operation.
fn floatDiv64Case() = {
    use numerators <- gpuSatisfies(toGpu([toFloat(1.0), toFloat(-1.0), toFloat(0.0), toFloat(6.0), toFloat(1.0)]))
    use divisors <- gpuSatisfies(toGpu([toFloat(0.0), toFloat(0.0), toFloat(0.0), toFloat(4.0), toFloat(-0.0)]))
    use q <- gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)))
    quotientsMatch(q, floatBits, 9218868437227405312, -4503599627370496, toFloat(1.5))
        && floatBits(floatDiv(toFloat(1.0), toFloat(0.0))) == 9218868437227405312
        && floatDiv(toFloat(6.0), toFloat(4.0)) == toFloat(1.5)
}
/// [BUILTIN-MATH-FLOATDIV] The same quotients at width 32, the width the Qwen kernels compute in.
fn floatDiv32Case() = {
    use numerators <- gpuSatisfies(toGpu([toFloat32(1.0), toFloat32(-1.0), toFloat32(0.0), toFloat32(6.0), toFloat32(1.0)]))
    use divisors <- gpuSatisfies(toGpu([toFloat32(0.0), toFloat32(0.0), toFloat32(0.0), toFloat32(4.0), toFloat32(-0.0)]))
    use q <- gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)))
    quotientsMatch(q, float32Bits, 2139095040, -8388608, toFloat32(1.5))
        && float32Bits(floatDiv(toFloat32(1.0), toFloat32(0.0))) == 2139095040
        && floatDiv(toFloat32(6.0), toFloat32(4.0)) == toFloat32(1.5)
}
/// [BUILTIN-MATH-FLOATDIV] The same quotients at width 16, which a kernel computes in binary32 and rounds back.
fn floatDiv16Case() = {
    use numerators <- gpuSatisfies(toGpu([toFloat16(1.0), toFloat16(-1.0), toFloat16(0.0), toFloat16(6.0), toFloat16(1.0)]))
    use divisors <- gpuSatisfies(toGpu([toFloat16(0.0), toFloat16(0.0), toFloat16(0.0), toFloat16(4.0), toFloat16(-0.0)]))
    use q <- gpuSatisfies(gpuZipWith(numerators, divisors, fn(n, d) => floatDiv(n, d)))
    quotientsMatch(q, float16Bits, 31744, -1024, toFloat16(1.5))
        && float16Bits(floatDiv(toFloat16(1.0), toFloat16(0.0))) == 31744
        && floatDiv(toFloat16(6.0), toFloat16(4.0)) == toFloat16(1.5)
}
/// [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 16.
fn remainder16Case() = gpuSatisfies(toGpu([toFloat16(5.5), toFloat16(-5.5), toFloat16(-0.0), float16FromBits(1), float16FromBits(31744), float16FromBits(32256)]), fn(input) => gpuSatisfies(gpuMap(input, fn(x) => x % toFloat16(2.0)), fn(output) => remaindersMatch(output, float16Bits, 15872, -16896, -32768, 1)))
/// The sized bit views run as kernels too: binary32 words through
/// float32FromBits/float32Bits and binary16 words through float16FromBits/float16Bits
/// come back as the words they were, on the host and on a device.
/// Every bit-round-trip word list comes back unchanged, at any width.
fn wordsRestored(restored, words, zero, one) = gpuLength(restored) == listLength(words) && fold(range(0, listLength(words)), true, fn(ok, i) => ok && (gpuGet(restored, i) ?: zero) == (listGet(words, i) ?: one))
fn sized32BitsCase() = {
    let words = [toInt32(0), toInt32(-2147483648), toInt32(1065353216), toInt32(-1082130432), toInt32(2139095040), toInt32(2143289344), toInt32(-4194304), toInt32(1), toInt32(8388607)]
    gpuSatisfies(toGpu(words), fn(input) => gpuSatisfies(gpuMap(input, float32FromBits), fn(floats) => gpuSatisfies(gpuMap(floats, float32Bits), fn(restored) => wordsRestored(restored, words, toInt32(0), toInt32(1)))))
}
fn sized16BitsCase() = {
    let words = [toInt16(0), toInt16(-32768), toInt16(15360), toInt16(-17408), toInt16(31744), toInt16(32256), toInt16(1), toInt16(1023), toInt16(-1025)]
    gpuSatisfies(toGpu(words), fn(input) => gpuSatisfies(gpuMap(input, float16FromBits), fn(halves) => gpuSatisfies(gpuMap(halves, float16Bits), fn(restored) => wordsRestored(restored, words, toInt16(0), toInt16(1)))))
}
/// Emitted bit-conversion kernels must preserve signed zeros and NaN payloads.
fn gpuBitRoundTripCase() = {
    let words = [0, -9223372036854775808, 4607182418800017408, -4616189618054758400,
        9218868437227405312, -4503599627370496, 9221120237041090851, -2251799813684957,
        9218868437227405603, -4503599627370205, 1, -9223372036854775807]
    withBuffer(toGpu(words), fn(value) => withBuffer(gpuMap(value, floatFromBits), fn(uploaded1) => withBuffer(gpuMap(uploaded1, floatBits), fn(restored) => checkAll("GPU bit conversions retain every payload bit", [
                    remainder64Case(), remainder32Case(), remainder16Case(), floatDiv64Case(), floatDiv32Case(), floatDiv16Case(), sized32BitsCase(), sized16BitsCase(),
                    wordsRestored(restored, words, 0, 1)
            ]))))
}
test("GPU bit conversion kernels preserve exact words", exactly(gpuBitRoundTripCase))
