            gpuSatisfies(gpuFold(one, 0, addInts), fn(uploaded67) => (uploaded67) == 0), gpuSatisfies(gpuFold(wide, 0, addInts), fn(uploaded66) => (uploaded66) == 19999900000), gpuSatisfies(gpuMap(seven, square), fn(uploaded65) => gpuSatisfies(gpuFold(uploaded65, 0, addInts), fn(uploaded101) => (uploaded101) == 91)),
