// withBuffer, gpuSatisfies, withIndices, iotaError and exactArithmetic are the
// testing prelude's [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the
// one shared copy, so this file declares none of its own.
// Dense GPU construction, round-trips and bounds checks; element tags survive lets, pipes, calls, returns and aliases.
// Implements [GPU-BUFFER], [GPU-BUFFER-ELEM], [GPU-BUFFER-LITERAL], [GPU-BUFFER-FROM-LIST],
// [GPU-BUFFER-FUSE], [GPU-BUFFER-TO-LIST], [GPU-BUFFER-LENGTH], [GPU-IOTA], [GPU-GET]; see 0034-GPUComputation.md.
/// square is a pure int kernel; the checker proves it performs no effects.
fn square(x) = (x * x)
/// addInts keeps the checked-arithmetic Result inside the kernel.
fn addInts(acc, x) = (acc + x)
/// scale is a pure float kernel; the buffer's element tag types x as float.
fn scale(x) = x * 1.5
/// addFloats is the float reduction kernel for gpuFold's combine slot.
fn addFloats(a, x) = a + x
/// isOdd maps an int element to a bool element, changing the buffer's type.
fn isOdd(x) = (x % 2 ) == 1
/// countOdd counts the true elements of a bool buffer.
fn countOdd(acc, flag) = match flag {
    true => (acc + 1)
    false => acc
}
/// same is the identity kernel: every scalar word must come back out unchanged, at the element type its source buffer was tagged with.
fn same(x) = x
/// readback renders one gpuGet outcome as text — the element for a hit, the error payload for a miss. Being polymorphic over the element type, it is itself the assertion that gpuGet recovers int, float and bool alike.
fn readback(b, i) = match gpuGet(b, i) {
    Success { value } => toString(value)
    Error { message } => message
}
/// lastOf computes the final index from the length: the read that sits exactly on the in-bounds boundary.
fn lastOf(b) = gpuGet(b, (gpuLength(b) - 1) )
/// widthOf takes a buffer as a plain parameter — the handle and its element tag have to survive the call.
fn widthOf(b) = gpuLength(b)
/// doubledInts both receives and returns a buffer, so the tag must survive a parameter and a return in one call.
fn doubledInts(b) =gpuMap(b, fn(x) => (x * 2) )
/// scaledFloats is doubledInts' float twin: tags are per-buffer, so a float buffer must come back out of a return still reading as float.
fn scaledFloats(b) =gpuMap(b, scale)
/// chooseBuffer returns a buffer out of a match arm — the fourth binding form a handle travels through.
fn chooseBuffer(flag, a, b) = match flag {
    true => a
    false => b
}
/// lastIs is the read that sits on the in-bounds boundary: the final element, or `fallback` for an empty buffer.
fn lastIs(b, fallback, expected) = (lastOf(b) ?: fallback) == expected
/// misses is the read [GPU-GET] must refuse: its payload is exactly the contracted message, never a sentinel element.
fn misses(b, index) = readback(b, index) == oobMessage()
/// rendersAs is one gpuGet outcome as text, so an element's own scalar type stays visible.
fn rendersAs(b, index, text) = readback(b, index) == text
/// listLengthIs is the length of a materialized list.
fn listLengthIs(values, expected) = listLength(values) == expected
/// listHolds is one list read, or `fallback` past either end.
fn listHolds(values, index, fallback, expected) = (listGet(values, index) ?: fallback) == expected
/// sumsTo is [GPU-FOLD] over int elements: `b` from `seed` totals `expected`.
fn sumsTo(b, seed, expected) = gpuSatisfies(gpuFold(b, seed, addInts), fn(total) => total == expected)
/// sumIs is sumsTo from the zero seed.
fn sumIs(b, expected) = sumsTo(b, 0, expected)
/// floatSumsTo is [GPU-FOLD] over float elements: `b` from `seed` totals `expected`.
fn floatSumsTo(b, seed, expected) = gpuSatisfies(gpuFold(b, seed, addFloats), fn(total) => total == expected)
/// oddCountIs is [GPU-FOLD] over bool elements: `b` holds `expected` true flags.
fn oddCountIs(b, expected) = gpuSatisfies(gpuFold(b, 0, countOdd), fn(count) => count == expected)
/// copied runs the identity kernel and checks its output: every scalar word must come back unchanged.
fn copied(b, check) = gpuSatisfies(gpuMap(b, same), check)
/// squared maps square over `b` and checks the result.
fn squared(b, check) = gpuSatisfies(gpuMap(b, square), check)
/// scaled maps scale over `b` and checks the float result.
fn scaled(b, check) = gpuSatisfies(gpuMap(b, scale), check)
/// widened widens `b` to float and checks the result ([GPU-CONVERT]).
fn widened(b, check) = gpuSatisfies(gpuMap(b, toFloat), check)
/// oddFlags maps isOdd over `b` and checks the bool buffer it publishes.
fn oddFlags(b, check) = gpuSatisfies(gpuMap(b, isOdd), check)
/// uploaded uploads `values` and checks the dense buffer it produces.
fn uploaded(values, check) = gpuSatisfies(toGpu(values), check)
/// readsBack is [GPU-BUFFER-TO-LIST]: `b` materializes as `expected` list elements.
fn readsBack(b, expected) = gpuSatisfies(fromGpu(b), fn(values) => listLengthIs(values, expected))
/// readsBackAt is [GPU-BUFFER-TO-LIST] read at one index.
fn readsBackAt(b, index, fallback, expected) = gpuSatisfies(fromGpu(b), fn(values) => listHolds(values, index, fallback, expected))
/// materializesAs is the exact dense copy [GPU-BUFFER-TO-LIST] promises.
fn materializesAs(b, values) = gpuSatisfies(fromGpu(b), fn(back) => structuralEquals(back, values))
/// survivesRoundTrip sends `b` through list and buffer again at `expected` elements.
fn survivesRoundTrip(b, expected) = gpuSatisfies(fromGpu(b), fn(values) => gpuSatisfies(toGpu(values), fn(again) => lengthIs(again, expected)))
/// roundTripSumsTo folds the buffer rebuilt from `b`'s own materialized list.
fn roundTripSumsTo(b, expected) = gpuSatisfies(fromGpu(b), fn(values) => gpuSatisfies(toGpu(values), fn(again) => sumIs(again, expected)))
/// roundTripReads reads the buffer rebuilt from `b`'s own materialized list.
fn roundTripReads(b, index, fallback, expected) = gpuSatisfies(fromGpu(b), fn(values) => gpuSatisfies(toGpu(values), fn(again) => elementIs(again, index, fallback, expected)))
/// literalCase pins [GPU-BUFFER-LITERAL]: a literal argument stores its elements straight into the dense buffer at constant indices, with no list built at all. Every scalar element type [GPU-BUFFER-ELEM] is covered, plus the degenerate one- and zero-element literals and the sign and magnitude extremes an int word must hold.
fn literalCase() = withBuffer(toGpu([3, 1, 4, 1, 5]), fn(ints) => withBuffer(toGpu([0.25, 0.5, 0.75, 1.0]), fn(floats) => withBuffer(toGpu([true, false, true]), fn(flags) => withBuffer(toGpu([-3, 0, 7, -1]), fn(signed) => withBuffer(toGpu([4611686018427387904, -4611686018427387904]), fn(wide) => literalCaseUploaded(ints, floats, flags, signed, wide))))))
