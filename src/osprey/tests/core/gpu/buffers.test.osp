                                            listLength(none) == 0, gpuSatisfies(toGpu(none), fn(uploaded34) => gpuLength(uploaded34) == 0), gpuSatisfies(toGpu(none), fn(uploaded33) => gpuSatisfies(gpuFold(uploaded33, 7, addInts), fn(uploaded87) => (uploaded87) == 7)), gpuSatisfies(toGpu(source), fn(uploaded32) => widthOf(uploaded32) == widthOf(copied)),
