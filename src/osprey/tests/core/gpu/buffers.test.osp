    lengthIs(ints, 5), lengthIs(floats, 4), lengthIs(flags, 3), lengthIs(signed, 4), lengthIs(wide, 2), uploaded([9], fn(up) => lengthIs(up, 1)), emptyUploads(), widthOf(ints) == 5, elementIs(ints, 0, 0, 3), elementIs(ints, 1, 0, 1), elementIs(ints, 2, 0, 4), elementIs(ints, 3, 0, 1), elementIs(ints, 4, 0, 5), lastIs(ints, 0, 5), elementIs(floats, 0, 9.5, 0.25), elementIs(floats, 1, 9.5, 0.5), elementIs(floats, 2, 9.5, 0.75), elementIs(floats, 3, 9.5, 1.0), lastIs(floats, 9.5, 1.0), elementIs(flags, 0, false, true), elementIs(flags, 1, true, false), elementIs(flags, 2, false, true), lastIs(flags, false, true), elementIs(signed, 0, 0, -3), elementIs(signed, 1, 9, 0), elementIs(signed, 2, 0, 7), elementIs(signed, 3, 0, -1), elementIs(wide, 0, 0, 4611686018427387904), elementIs(wide, 1, 0, -4611686018427387904), uploaded([9], fn(up) => elementIs(up, 0, 0, 9)), sumIs(ints, 14), sumIs(signed, 3), floatSumsTo(floats, 0.0, 2.5), oddCountIs(flags, 2)
])
/// listCopyCase pins [GPU-BUFFER-FROM-LIST]: a list *value* takes the copy loop rather than the literal path and must land on a buffer indistinguishable from the literal one — same length, same elements, same reduction — down to the one- and zero-element lists.
fn listCopyCase() = withIndices(0, fn(indices0) => listCopyWith(indices0))
fn listCopyWith(indices0) = {
    let source = [2, 4, 6, 8]
    let lone = [11]
    withBuffer(toGpu(source), fn(asCopy) => withBuffer(fromGpu(asCopy), fn(read0) => withBuffer(toGpu(read0), fn(relayed) => withBuffer(fromGpu(indices0), fn(none) => checkAll("list copy path", [
    listLengthIs(source, 4), lengthIs(asCopy, 4), elementIs(asCopy, 0, 0, 2), elementIs(asCopy, 1, 0, 4), elementIs(asCopy, 2, 0, 6), elementIs(asCopy, 3, 0, 8), lastIs(asCopy, 0, 8), misses(asCopy, 4), misses(asCopy, -1), rendersAs(asCopy, 0, "2"), sumIs(asCopy, 20), lengthIs(relayed, 4), elementIs(relayed, 2, 0, 6), sumIs(relayed, 20), uploaded(lone, fn(up) => lengthIs(up, 1)), uploaded(lone, fn(up) => elementIs(up, 0, 0, 11)), uploaded(lone, fn(up) => lastIs(up, 0, 11)), listLengthIs(none, 0), uploaded(none, fn(up) => lengthIs(up, 0)), uploaded(none, fn(up) => sumsTo(up, 7, 7)), uploaded(source, fn(up) => widthOf(up) == widthOf(asCopy)), uploaded(source, fn(up) => gpuSatisfies(gpuFold(up, 0, addInts), fn(one) => gpuSatisfies(gpuFold(asCopy, 0, addInts), fn(other) => one == other)))
])))))
}
