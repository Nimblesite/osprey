emptyRead : List<int>
emptyRead = []
// Scalar transfer conformance: inferred element types survive runtime lists,
// GPU buffers and repeated crossings [GPU-BUFFER-ELEM] [GPU-BUFFER-FROM-LIST]
// [GPU-BUFFER-TO-LIST]. Host kernels retain [FLOAT-IEEE-RESULTS].

countTrue (a, x) = match x
    true => (a + 1)
    false => a
(** The shared float and bool reductions every case repeats. *)
floatsSum floats = gpuFold(floats, 0.0, addF)
trueCount flags = gpuFold(flags, 0, countTrue)
(** listReverse forces the runtime-list copy path rather than literal lowering. *)
floatListValue () = listReverse [2.5, 1.5]
boolListValue () = listReverse [true, false, false]
listValueTagsCase () = withBuffer(toGpu (floatListValue ()), \floats => withBuffer(toGpu (boolListValue ()), \flags => checkAll "runtime list values keep GPU scalar tags" [
            gpuLength floats == 2, (gpuGet (floats, 0) ?: 99.0) == 1.5, (gpuGet (floats, 1) ?: 99.0) == 2.5, gpuSatisfies(floatsSum(floats), \sum => sum == 4.0), gpuLength flags == 3, (gpuGet (flags, 0) ?: true) == false, (gpuGet (flags, 1) ?: true) == false, (gpuGet (flags, 2) ?: false) == true,
            gpuSatisfies(trueCount(flags), \count => count == 1)
        ]))
fromGpuScalarCase () = withBuffer(toGpu ([1.25, 2.5, 5.0]), \uploaded17 => withBuffer(fromGpu (uploaded17), fromGpuScalarFloats))
fromGpuScalarFloats read0 =
    floats = read0
    withBuffer(toGpu ([true, false, true]), \uploaded16 => withBuffer(fromGpu (uploaded16), \read1 => fromGpuScalarFlags (floats, read1)))
fromGpuScalarFlags (floats, read1) =
    flags = read1
    checkAll "fromGpu preserves float and bool list elements" [
        listLength floats == 3, (listGet (floats, 0) ?: 99.0) == 1.25, (listGet (floats, 1) ?: 99.0) == 2.5, (listGet (floats, 2) ?: 99.0) == 5.0, listLength flags == 3, (listGet (flags, 0) ?: false) == true, (listGet (flags, 1) ?: true) == false, (listGet (flags, 2) ?: false) == true
    ]
repeatedCrossingCase () =
    use uploaded15 <- withBuffer (toGpu (floatListValue ()))
    use read0 <- withBuffer (fromGpu (uploaded15))
    use floats <- withBuffer (toGpu (read0))
    use uploaded14 <- withBuffer (toGpu (boolListValue ()))
    use read1 <- withBuffer (fromGpu (uploaded14))
    use flags <- withBuffer (toGpu (read1))
    use read2 <- withBuffer (fromGpu (floats))
    use read3 <- withBuffer (fromGpu (flags))
    repeatedCrossingWith (floats, flags, read2, read3)
repeatedCrossingWith (floats, flags, read2, read3) =
    floatsBack = read2
    flagsBack = read3
    checkAll "repeated host and GPU crossings retain scalar types" [
        gpuLength floats == 2, (gpuGet (floats, 0) ?: 99.0) == 1.5, (gpuGet (floats, 1) ?: 99.0) == 2.5, gpuSatisfies(floatsSum(floats), \sum => sum == 4.0), (listGet (floatsBack, 0) ?: 99.0) == 1.5, (listGet (floatsBack, 1) ?: 99.0) == 2.5,
        gpuLength flags == 3, gpuSatisfies(trueCount(flags), \count => count == 1), (listGet (flagsBack, 0) ?: true) == false, (listGet (flagsBack, 2) ?: false) == true
    ]
(** With no first element to inspect, lowering must use the inferred result type. *)
emptyTypedLiteralCase () =
    checkAll "empty literals retain contextual scalar types" [
        gpuSatisfies (toGpu ([]), \(uploaded11: GpuBuffer<int>) => gpuLength (uploaded11) == 0), gpuSatisfies (toGpu ([]), \uploaded10 => (gpuGet (uploaded10, 0) ?: 9.5) == 9.5), gpuSatisfies (toGpu ([]), \uploaded9 => (gpuGet (uploaded9, 0) ?: true) == true),
        gpuSatisfies (toGpu (emptyRead), \uploaded8 => gpuSatisfies (fromGpu (uploaded8), \checked0 => listLength (checked0) == 0))
    ]
(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactTests [
    { name = "runtime list values retain float and bool GPU element tags", work = listValueTagsCase },
    { name = "fromGpu reads float and bool elements at their source types", work = fromGpuScalarCase },
    { name = "repeated List and GpuBuffer crossings preserve scalar types", work = repeatedCrossingCase },
    { name = "empty GPU literals retain contextual scalar types", work = emptyTypedLiteralCase }
]
(** [FLOAT-IEEE-RESULTS]: host kernels obey the scalar arithmetic contract. *)
squareScalar value = value * value
subtractSelf value = value - value
divideZero value = value / 0.0
remainderZero value = value % -0.0
gpuIeeeCase () =
    use seed <- withBuffer (toGpu ([10000000000000000.0]))
    use uploaded9 <- withBuffer (gpuMap(seed, squareScalar))
    use fourth <- withBuffer (gpuMap(uploaded9, squareScalar))
    use uploaded10 <- withBuffer (gpuMap(fourth, squareScalar))
    use uploaded17 <- withBuffer (gpuMap(uploaded10, squareScalar))
    withBuffer(gpuMap(uploaded17, squareScalar), gpuIeeeInfinity)
gpuIeeeInfinity infinityBuffer =
    infinity = gpuGet (infinityBuffer, 0) ?: 0.0
    withBuffer(gpuMap(infinityBuffer, subtractSelf), \nanBuffer => gpuIeeeNaN (infinityBuffer, infinity, nanBuffer))
gpuIeeeNaN (infinityBuffer, infinity, nanBuffer) =
    nan = gpuGet (nanBuffer, 0) ?: 0.0
    withBuffer(toGpu ([infinity, nan, -0.0]), \uploaded7 => withBuffer(fromGpu (uploaded7), \read0 => withBuffer(toGpu (listReverse (read0)), \roundTrip => checkAll "host GPU kernels preserve non-finite values and signed zero" [
                        infinity > 10000000000000000.0, nan != nan, gpuSatisfies(floatsSum(infinityBuffer), \sum => sum == infinity), (gpuGet (roundTrip, 2) ?: 0.0) == infinity, (gpuGet (roundTrip, 1) ?: 0.0) != (gpuGet (roundTrip, 1) ?: 0.0),
                        toString (gpuGet (roundTrip, 0) ?: 1.0) == "-0.0"
                    ])))
(** gpuOpError turns a refused GPU operation into the failed check that names it. *)
gpuOpError message = check ("GPU operation", "success", toString message)
(** [GPU-DEVICE-FAULT] A selected device reports its fault without invoking host recovery. *)
deviceFault (result, reason) = match result
    Success _ => false
    Error message => contains(message, "kernel: ") && contains(message, reason)
gpuFloatZeroCase () =
    mut faults = ""
    handle Arith
        divideByZero op _ =>
            faults := faults + op
            0.25
    match toGpu ([1.0, 0.0, -1.0])
        Success input =>
            quotients = gpuMap(input, divideZero)
            remainders = gpuMap(input, remainderZero)
            match gpuDevice () == "host"
                true => checkAll "host GPU zero divisors use the enclosing policy" [
                    gpuSatisfies(quotients, \q => gpuEquals(floatsSum(q), 0.75)),
                    gpuSatisfies(remainders, \r => gpuEquals(floatsSum(r), 0.75)),
                    faults == "///%%%"
                ]
                false => checkAll "host GPU zero divisors use the enclosing policy" [
                    deviceFault(quotients, "division by zero"), deviceFault(remainders, "remainder by zero"), faults == ""
                ]
        Error message => gpuOpError message

testCases [
    { name = "host GPU arithmetic preserves IEEE non-finite values", work = gpuIeeeCase },
    { name = "host GPU float zero divisors use explicit recovery", work = gpuFloatZeroCase }
]
(** [BUILTIN-ABS]: builtin callbacks use their inferred scalar ABI and policy. *)
absFloatsKept floats = (gpuGet (floats, 0) ?: 0.0) == 2.5 && toString (gpuGet (floats, 1) ?: 1.0) == "0.0" && (gpuGet (floats, 2) ?: 0.0) == 3.5
gpuAbsoluteCase () =
    match toGpu ([-2.5, -0.0, 3.5])
        Success value =>
            match gpuMap(value, abs)
                Success floats =>
                    mut faults = ""
                    handle Arith
                        overflow op lhs rhs wrapped =>
                            checkAll "GPU abs overflow payload" [
                                lhs == -9223372036854775808, rhs == 0, wrapped == lhs
                            ]
                            faults := faults + op
                            17
                    match toGpu ([-9223372036854775808, -3, 4])
                        Success value =>
                            match gpuMap(value, abs)
                                Success integers =>
                                    checkAll "GPU abs keeps float and integer callback contracts" [
                                        absFloatsKept floats, (gpuGet (integers, 0) ?: 0) == 17, (gpuGet (integers, 1) ?: 0) == 3, (gpuGet (integers, 2) ?: 0) == 4, faults == "abs"
                                    ]
                                Error message => checkAll "GPU abs keeps float and integer callback contracts" [
                                    absFloatsKept floats,
                                    gpuDevice () != "host", contains(message, "integer overflow"), faults == "",
                                    gpuSatisfies(toGpu([-3, 4]), \safe => gpuSatisfies(gpuMap(safe, abs), \integers => (gpuGet(integers, 0) ?: 0) == 3 && (gpuGet(integers, 1) ?: 0) == 4))
                                ]
                        Error message => gpuOpError message
                Error message => gpuOpError message
        Error message => gpuOpError message
test "host GPU abs callbacks retain numeric types and recovery" gpuAbsoluteCase
(** Shared element probes: per-width bit words behind one shape. *)
bits64At (values, at, word) = gpuSatisfies(gpuGet(values, at), \x => floatBits(x) == word)
bits32At (values, at, word) = gpuSatisfies(gpuGet(values, at), \x => float32Bits(x) == word)
bits16At (values, at, word) = gpuSatisfies(gpuGet(values, at), \x => float16Bits(x) == word)
(** [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 64. *)
remainder64Case () = gpuSatisfies(toGpu([toFloat(5.5), toFloat(-5.5), toFloat(-0.0), floatFromBits(1), floatFromBits(9218868437227405312), floatFromBits(9221120237041090560)]), \input => gpuSatisfies(gpuMap(input, \x => x % toFloat(2.0)), \output => gpuLength(output) == 6 && bits64At(output, 0, 4609434218613702656) && bits64At(output, 1, -4613937818241073152) && bits64At(output, 2, -9223372036854775808) && bits64At(output, 3, 1) && gpuSatisfies(gpuGet(output, 4), \x => x != x) && gpuSatisfies(gpuGet(output, 5), \x => x != x)))
(** [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 32. *)
remainder32Case () = gpuSatisfies(toGpu([toFloat32(5.5), toFloat32(-5.5), toFloat32(-0.0), float32FromBits(1), float32FromBits(2139095040), float32FromBits(2143289344)]), \input => gpuSatisfies(gpuMap(input, \x => x % toFloat32(2.0)), \output => gpuLength(output) == 6 && bits32At(output, 0, 1069547520) && bits32At(output, 1, -1077936128) && bits32At(output, 2, -2147483648) && bits32At(output, 3, 1) && gpuSatisfies(gpuGet(output, 4), \x => x != x) && gpuSatisfies(gpuGet(output, 5), \x => x != x)))
(** [BUILTIN-MATH-FLOATDIV] One floatDiv quotient probe at any width: the conversions, bit views and
    expected words travel with the width. A zero divisor answers an infinity of the right sign or NaN,
    never an Arith operation. *)
floatDivQuotientCase (toX, xBits, bitsAt, w0, w1, w4, infBits) =
    use numerators <- gpuSatisfies (toGpu([toX(1.0), toX(-1.0), toX(0.0), toX(6.0), toX(1.0)]))
    use divisors <- gpuSatisfies (toGpu([toX(0.0), toX(0.0), toX(0.0), toX(4.0), toX(-0.0)]))
    use q <- gpuSatisfies (gpuZipWith(numerators, divisors, \(n, d) => floatDiv(n, d)))
    gpuLength(q) == 5 && bitsAt(q, 0, w0) && bitsAt(q, 1, w1) && gpuSatisfies(gpuGet(q, 2), \x => x != x) && gpuEquals(gpuGet(q, 3), toX(1.5)) && bitsAt(q, 4, w4) && xBits(floatDiv(toX(1.0), toX(0.0))) == infBits && floatDiv(toX(6.0), toX(4.0)) == toX(1.5)
(** [BUILTIN-MATH-FLOATDIV] floatDiv is the IEEE quotient at width 64 on the host and in a kernel. *)
floatDiv64Case () = floatDivQuotientCase (toFloat, floatBits, bits64At, 9218868437227405312, -4503599627370496, -4503599627370496, 9218868437227405312)
(** [BUILTIN-MATH-FLOATDIV] The same quotients at width 32, the width the Qwen kernels compute in. *)
floatDiv32Case () = floatDivQuotientCase (toFloat32, float32Bits, bits32At, 2139095040, -8388608, -8388608, 2139095040)
(** [BUILTIN-MATH-FLOATDIV] The same quotients at width 16, which a kernel computes in binary32 and rounds back. *)
floatDiv16Case () = floatDivQuotientCase (toFloat16, float16Bits, bits16At, 31744, -1024, -1024, 31744)
(** [GPU-DEVICE-NATIVE] [%]: signs, subnormals and non-finite values at width 16. *)
remainder16Case () = gpuSatisfies(toGpu([toFloat16(5.5), toFloat16(-5.5), toFloat16(-0.0), float16FromBits(1), float16FromBits(31744), float16FromBits(32256)]), \input => gpuSatisfies(gpuMap(input, \x => x % toFloat16(2.0)), \output => gpuLength(output) == 6 && bits16At(output, 0, 15872) && bits16At(output, 1, -16896) && bits16At(output, 2, -32768) && bits16At(output, 3, 1) && gpuSatisfies(gpuGet(output, 4), \x => x != x) && gpuSatisfies(gpuGet(output, 5), \x => x != x)))
(** The sized bit views run as kernels too: binary32 words through
    float32FromBits/float32Bits and binary16 words through float16FromBits/float16Bits
    come back as the words they were, on the host and on a device. *)
(** Every bit-round-trip word list comes back unchanged, at any width. *)
wordsRestored (restored, words, zero, one) = gpuLength(restored) == listLength(words) && fold(range(0, listLength(words)), true, \(ok, i) => ok && (gpuGet(restored, i) ?: zero) == (listGet(words, i) ?: one))
sized32BitsCase () =
    words = [toInt32(0), toInt32(-2147483648), toInt32(1065353216), toInt32(-1082130432), toInt32(2139095040), toInt32(2143289344), toInt32(-4194304), toInt32(1), toInt32(8388607)]
    gpuSatisfies(toGpu(words), \input => gpuSatisfies(gpuMap(input, float32FromBits), \floats => gpuSatisfies(gpuMap(floats, float32Bits), \restored => wordsRestored(restored, words, toInt32(0), toInt32(1)))))
sized16BitsCase () =
    words = [toInt16(0), toInt16(-32768), toInt16(15360), toInt16(-17408), toInt16(31744), toInt16(32256), toInt16(1), toInt16(1023), toInt16(-1025)]
    gpuSatisfies(toGpu(words), \input => gpuSatisfies(gpuMap(input, float16FromBits), \halves => gpuSatisfies(gpuMap(halves, float16Bits), \restored => wordsRestored(restored, words, toInt16(0), toInt16(1)))))
(** Emitted bit-conversion kernels must preserve signed zeros and NaN payloads. *)
gpuBitRoundTripCase () =
    words = [0, -9223372036854775808, 4607182418800017408, -4616189618054758400,
        9218868437227405312, -4503599627370496, 9221120237041090851, -2251799813684957,
        9218868437227405603, -4503599627370205, 1, -9223372036854775807]
    withBuffer(toGpu (words), \value => withBuffer(gpuMap(value, floatFromBits), \uploaded1 => withBuffer(gpuMap(uploaded1, floatBits), \restored => checkAll "GPU bit conversions retain every payload bit" [
                            remainder64Case(), remainder32Case(), remainder16Case(), floatDiv64Case(), floatDiv32Case(), floatDiv16Case(), sized32BitsCase(), sized16BitsCase(),
                            wordsRestored(restored, words, 0, 1)
                        ])))
test "GPU bit conversion kernels preserve exact words" (exactly gpuBitRoundTripCase)
