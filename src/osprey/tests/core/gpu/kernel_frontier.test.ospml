(** Kernel-frontier conformance ([GPU-KERNEL-ELEM-TYPING],
    [GPU-KERNEL-FORM], [GPU-KERNEL-EXTRACT]). The layout-bodied lambda below
    exercises the ML spelling of Default block bodies. *)
addFloats (a, x) = a + x
plus (a, x) = a + x
(** Element with an explicit fallback; every assertion row reads through it. *)
at (xs, i, fallback) = gpuGet (xs, i) ?: fallback
(** Two elements of one buffer as a row, for whole-row structural comparison. *)
rowOf (xs, i, j, fallback) = [at (xs, i, fallback), at (xs, j, fallback)]
(** Asserts the float sum of xs from 0.0 with addFloats is expected. *)
floatSumIs (xs, expected) = gpuEquals(gpuFold (xs, 0.0, addFloats), expected)
(** Deliberately unannotated: the concrete GpuBuffer<float> specialization and recursive self-call must be emitted from the call site. *)
rowDot (matrix, vector, cols, row, col) = match col == cols
    true => 0.0
    false => (at (matrix, (((row * cols) ) + col), 0.0) * at (vector, col, 0.0)
        + rowDot (matrix, vector, cols, row, (col + 1) ))
multiplicationOrderCase () =
    t = 2.0
    withBuffer (toGpu ([1.0, 2.0]), \xs => withBuffer (toGpu ([3.0, 4.0]), \ys => withBuffer (gpuZipWith (xs, ys, \(x, y) => t * x * y), \captureFirst => withBuffer (gpuZipWith (xs, ys, \(x, y) => x * y * t), \captureLast => checkAll "buffer slots type every multiplication order" [
                        floatSumIs (captureFirst, 22.0), floatSumIs (captureLast, 22.0),
                        at (captureFirst, 0, 0.0) == 6.0,
                        at (captureLast, 1, 0.0) == 16.0
                    ]))))
genericCombineCase () =
    withBuffer (toGpu ([1.0, 2.0, 3.0]), \xs => checkAll "named generic float combines specialize from buffer slots" [
            gpuEquals(gpuFold(xs, 0.0, plus), 6.0), gpuSatisfies(gpuScan(xs, 0.0, plus), \uploaded28 => at (uploaded28, 2, 0.0) == 6.0)
        ])
recursiveHelperCase () = withBuffer(gpuIota 2, recursiveHelperWith)
recursiveHelperWith indices =
    withBuffer (toGpu ([1.0, 2.0, 3.0, 4.0]), \matrix => withBuffer (toGpu ([10.0, 20.0]), \vector => withBuffer (gpuMap(indices, (\row => rowDot (matrix, vector, 2, row, 0))), \rows => checkAll "recursive GPU helpers monomorphize from their call site" [
                    gpuLengthIs (rows, 2),
                    structuralEquals (rowOf (rows, 0, 1, 0.0)) [50.0, 110.0],
                    floatSumIs (rows, 160.0)
                ])))
blockBodyCase () =
    t = 2.0
    withBuffer (toGpu ([1.0, 2.0, 3.0]), \xs => withBuffer (gpuMap(xs, (\x =>
                y = t * x
                y + t)), \mapped => checkAll "block-bodied kernels preserve local bindings" [
                gpuLength mapped == 3,
                structuralEquals (rowOf (mapped, 0, 1, 0.0)) [4.0, 6.0],
                at (mapped, 2, 0.0) == 8.0,
                floatSumIs (mapped, 18.0)
            ]))
test ("float kernel slots type both multiplication orders", exactly multiplicationOrderCase)
test ("named generic float combines specialize from buffer slots", exactly genericCombineCase)
test ("unannotated recursive helpers are valid GPU kernels", exactly recursiveHelperCase)
test ("block-bodied GPU kernels keep local bindings", exactly blockBodyCase)
builtinMapCase () =
    withBuffer (toGpu ([9007199254740993, -7]), \uploaded12 => withBuffer (gpuMap (uploaded12) toFloat, \floats => withBuffer (toGpu ([-1.5, -0.0, 2.25]), \uploaded13 => withBuffer (gpuMap (uploaded13) abs, \positive =>
                abs = \x => x * 2.0
                withBuffer (toGpu ([3.0]), \uploaded14 => withBuffer (gpuMap (uploaded14) abs, \shadowed => checkAll "builtin maps preserve scalar types and lexical shadowing" [at (floats, 0, 0.0) == 9007199254740992.0, at (floats, 1, 0.0) == -7.0, at (positive, 0, 0.0) == 1.5, toString (at (positive, 1, 0.0)) == "0.0", at (positive, 2, 0.0) == 2.25, at (shadowed, 0, 0.0) == 6.0]))))))
builtinZipCase () = withBuffer(toGpu ([9223372036854775807, -9223372036854775808, 4000000000]), \left => withBuffer(toGpu ([1, -1, 4000000000]), \right => builtinZipCaseUploaded(left, right)))
builtinZipCaseUploaded (left, right) =
    withBuffer (gpuZipWith (left, right, wrapAdd), \added => withBuffer (gpuZipWith (left, right, wrapSub), \subtracted => withBuffer (gpuZipWith (left, right, wrapMul), \multiplied => withBuffer (gpuZipWith (left, right, satMul), \saturated => checkAll "builtin zip preserves wrapping and saturation boundaries" [
                        structuralEquals (rowOf (added, 0, 1, 0)) [-9223372036854775808, 9223372036854775807],
                        at (subtracted, 0, 0) == 9223372036854775806, at (subtracted, 1, 0) == -9223372036854775807,
                        at (saturated, 1, 0) == 9223372036854775807, at (saturated, 2, 0) == 9223372036854775807,
                        structuralEquals (rowOf (multiplied, 1, 2, 0)) [-9223372036854775808, -2446744073709551616]
                    ]))))
builtinFoldCase () =
    withBuffer (toGpu ([1, 1]), \source => withBuffer (gpuScan (source, -9223372036854775808, satSub), \lower => withBuffer (gpuScan (source, 9223372036854775807, satAdd), \upper => checkAll "builtin folds and scans preserve accumulator policy" [
                    gpuEquals(gpuFold (source, 9223372036854775807, wrapAdd), -9223372036854775807), gpuEquals(gpuFold (source, 9223372036854775807, satAdd), 9223372036854775807),
                    structuralEquals [at (lower, 1, 0), at (upper, 1, 0)] [-9223372036854775808, 9223372036854775807]
                ])))
builtinPolicyCase () =
    mut faults = 0
    handle Arith
        overflow op left right wrapped =>
            faults := wrapAdd faults 1
            checkAll "extracted absolute overflow preserves operation arguments" [
                op == "abs", left == -9223372036854775808, right == 0, wrapped == -9223372036854775808
            ]
            77
    withBuffer (toGpu ([-9223372036854775808, -4, 5]), \uploaded10 => withBuffer (gpuMap (uploaded10) abs, \values => checkAll "builtin kernel dispatches to the active arithmetic policy" [
                structuralEquals [faults, (gpuGet (values, 0) ?: 0)] [1, 77],
                structuralEquals (rowOf (values, 1, 2, 0)) [4, 5]
            ]))
test "builtin maps specialize and respect shadowing" builtinMapCase
test "builtin zip pins wrapping and saturation" builtinZipCase
test "builtin folds and scans preserve accumulator policy" builtinFoldCase
test "builtin kernels preserve the active overflow policy" builtinPolicyCase
builtinDivisionCase () =
    mut faults = ""
    handle Arith
        overflow op left right wrapped =>
            checkAll "division overflow arguments" [
                op == "intDiv", left == -9223372036854775808, right == -1, wrapped == left
            ]
            faults := faults + "overflow;"
            41
        remainderByZero left =>
            expect left 7
            faults := faults + "zero;"
            42
    withBuffer (toGpu ([-9223372036854775808, 7, 9]), \uploaded8 => withBuffer (toGpu ([-1, 0, 2]), \uploaded9 => withBuffer (gpuZipWith (uploaded8, uploaded9, intDiv), \values => checkAll "builtin division dispatches once in element order" [
                    faults == "overflow;zero;",
                    structuralEquals (rowOf (values, 0, 1, 0)) [41, 42],
                    at (values, 2, 0) == 4
                ])))
test "builtin integer division preserves ordered recovery" builtinDivisionCase
lexicalKernelCase () =
    enabled = true
    keep = \_x => enabled
    choose = \(a, x) => match enabled
        true => a
        false => x
    identity = \x => match enabled
        true => x
        false => x
    enabled = false
    withBuffer (toGpu ([1.0, 2.0]), \source => withBuffer (toGpu ([30.0, 40.0]), \uploaded7 => withBuffer (gpuZipWith (source, uploaded7, choose), \zipped => withBuffer (gpuScan (source, 42.0, choose), \scanned => checkAll "closed kernels keep their definition environment" [
                        enabled == false, gpuLengthIs(gpuFilter source keep, 2), gpuSatisfies(gpuMap source identity, \uploaded7 => at (uploaded7, 1, 0.0) == 2.0),
                        structuralEquals [at (zipped, 1, 0.0), at (scanned, 0, 0.0)] [2.0, 42.0],
                        at (scanned, 1, 0.0) == 42.0,
                        gpuEquals(gpuFold (source, 42.0, choose), 42.0)
                    ]))))
effect KernelSwitch
    disable : Unit => int
liveKernelCellCase () =
    mut enabled = true
    keep = \_x => enabled
    handle KernelSwitch
        disable =>
            enabled := false
            0
    changed = perform KernelSwitch.disable ()
    checkAll "host-bound kernels retain live cell identity" [changed == 0, gpuSatisfies (toGpu ([1, 2]), \uploaded5 => gpuLengthIs(gpuFilter (uploaded5) keep, 0))]
test "closed GPU kernels retain lexical uniforms" lexicalKernelCase
test "host GPU kernels retain live cells" liveKernelCellCase
managedKernelCase () =
    label = "kept"
    keep = \_x => length label > 0
    label = ""
    checkAll "declined extraction retains the captured managed value" [label == "", gpuSatisfies (toGpu ([1, 2]), \uploaded4 => gpuLengthIs(gpuFilter (uploaded4) keep, 2))]
capturedArithmeticCase () =
    limit = 9223372036854775807
    add = \x => x + limit
    limit = 0
    mut faults = 0
    handle Arith
        overflow op left right wrapped =>
            faults := wrapAdd faults 1
            checkAll "captured kernel overflow arguments" [
                op == "+",
                structuralEquals [left, right] [1, 9223372036854775807],
                wrapped == -9223372036854775808
            ]
            42
    withBuffer (toGpu ([1, 0]), \uploaded3 => withBuffer (gpuMap (uploaded3) add, \values => checkAll "captured kernel dispatches through the active policy" [
                structuralEquals [limit, faults, at (values, 0, 0)] [0, 1, 42],
                at (values, 1, 0) == 9223372036854775807
            ]))
(** The float functions are total over IEEE doubles ([BUILTIN-MATH]): a domain error is NaN, an overflow is infinity, nothing performs Arith — and each is a kernel by name. *)
mathTotalityCase () =
    nan = sqrt (-1.0)
    withBuffer (toGpu ([0.0, 1.0]), \value => withBuffer (gpuMap(value, exp), \probabilities => checkAll "float math builtins are total over IEEE doubles" [
                structuralEquals [sqrt 4.0, tanh 1000000.0, at (probabilities, 0, 0.0)] [2.0, 1.0, 1.0],
                nan != nan, ln 0.0 < -1000.0, ln 0.0 == ln 0.0 * 2.0, exp 1000.0 == exp 2000.0, exp 1000.0 > 1.0, tanh (-1000000.0) == -1.0,
                gpuSatisfies (toGpu ([1.0, 4.0, 9.0]), \uploaded1 => gpuSatisfies(gpuMap(uploaded1, sqrt), \uploaded1 => floatSumIs (uploaded1, 6.0)))
            ]))
test "declined GPU extraction preserves managed captures" managedKernelCase
test "captured GPU kernels preserve arithmetic policy" capturedArithmeticCase
test "float math builtins are total and name GPU kernels" mathTotalityCase
