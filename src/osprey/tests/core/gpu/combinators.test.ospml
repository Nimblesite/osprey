// GPU combinator algebra: how gpuMap, gpuFilter, gpuScan, gpuZipWith and
// gpuFold behave alone, at their degenerate edges, and composed into deep
// chains — the empty and one-element buffer, ragged truncation to the shorter
// operand, order-preserving compaction, the inclusive-prefix seed, the initial
// value a fold returns with nothing to reduce, and the left-to-right traversal
// the host backend documents ([GPU-MAP], [GPU-FOLD], [GPU-ZIPWITH],
// [GPU-IOTA], [GPU-GET], [GPU-SCAN], [GPU-FILTER], [GPU-BUFFER-FUSE],
// [GPU-CONVERT], [GPU-BACKEND-HOST], [GPU-DEVICE] —
// docs/specs/runtime/0034-GPUComputation.md).
(** The zero-length buffers every combinator is pushed through; the annotation supplies the element type an empty literal cannot. *)
emptyInts : Unit -> Result<GpuBuffer<int>, Error>
emptyInts () = toGpu ([])
emptyFloats : Unit -> Result<GpuBuffer<float>, Error>
emptyFloats () = toGpu ([])
(** The associative int combines fold and scan share. *)
sumI (a, b) = (a + b)
mulI (a, b) = (a * b)
(** subI and horner are deliberately non-commutative. Left-to-right is the only traversal that reproduces their results, so every assertion on them pins the order [GPU- BACKEND-HOST] rather than merely the element set. *)
subI (a, b) = (a - b)
horner (a, d) = (((a * 10) ) + d)
(** maxI makes a scan a running maximum; addF is the float reduction; orB is the boolean any-reduction that latches on the first accepted element. *)
maxI : (int, int) -> int
maxI (a, b) = match a > b
    true => a
    false => b
addF (a, x) = a + x
orB (a, b) = a || b
(** The population count that turns a bool buffer into a scalar. *)
countTrue (a, flag) = match flag
    true => (a + 1)
    false => a
(** dbl, inc and half are the one-line stages the deep chains are built from. *)
dbl x = (x * 2)
inc x = (x + 1)
half : float -> float
half x = x * 0.5
(** toBit widens a bool element back to an int one, closing the type cycle int -> bool -> int that [GPU-BUFFER-ELEM]'s three scalars allow. *)
toBit b = match b
    true => 1
    false => 0
(** isEven and isOddP are each other's negation; isOddP is spelled with `!` so the predicate slot is fed by a boolean operator, not just a comparison. *)
isEven x = (x % 2 ) == 0
isOddP x = !(isEven x)
(** keepEvery and keepNone are the degenerate predicates — total acceptance and total rejection, independent of the element. *)
keepEvery x = x == x
keepNone x = x != x
(** The remaining predicates compose comparisons with &&, || and !. *)
isBig x = x > 4
bigEven x = isEven x && isBig x
inBand x = x >= 3 && x <= 6
notBand x = !(inBand x)
atEdge x = (x < 2) || (x > 7)
isPositive x = x > 0.0
truthy b = b
(** The zip kernels below all return an element type neither operand has, so gpuZipWith is exercised as a type-changing combinator too. *)
sameParity (a, b) = isEven a == isEven b
lessF : (float, float) -> bool
lessF (a, b) = a < b
meanF (a, b) = (toFloat a + toFloat b) * 0.5
mixAdd : (int, float) -> float
mixAdd (i, x) = toFloat i + x
(** oobMessage renders a gpuGet outcome as text so the Error [GPU-GET] returns is visible in an assertion instead of being swallowed by a `?:` default. *)
oobMessage : (GpuBuffer<int>, int) -> string
oobMessage (buf, i) = match gpuGet (buf, i)
    Success value => "value ${value}"
    Error message => message
(** Pin that no combinator invents an element from nothing: map, filter and scan over zero elements are all zero elements, whatever the kernel does to the element type. *)
emptyShapeCase () = withBuffer (emptyInts (), \intEmpty => withBuffer (emptyFloats (), \floatEmpty => emptyShapeWith (intEmpty, floatEmpty)))
emptyShapeWith (intEmpty, floatEmpty) =
    withBuffer (gpuMap(intEmpty, dbl), \uploaded169 => withBuffer (gpuFilter(uploaded169, isEven), \uploaded213 => withBuffer (gpuScan(uploaded213, 0, sumI), \uploaded222 => withBuffer (gpuMap(uploaded222, inc), \chained => checkAll "empty shapes" [
                        structuralEquals [gpuLength (intEmpty), (gpuGet (intEmpty, 0) ?: 42)] [0, 42],
                        gpuLength chained == 0,
                        gpuLengthIs(gpuMap(intEmpty, dbl), 0), gpuLengthIs(gpuMap(intEmpty, toFloat), 0), gpuLengthIs(gpuMap(intEmpty, isEven), 0),
                        gpuLengthIs(gpuMap(floatEmpty, half), 0), gpuLengthIs(gpuFilter(intEmpty, keepEvery), 0), gpuLengthIs(gpuFilter(intEmpty, keepNone), 0),
                        gpuLengthIs(gpuScan(intEmpty, 0, sumI), 0), gpuLengthIs(gpuScan(intEmpty, 99, maxI), 0),
                        gpuSatisfies (toGpu ([1, 2, 3]), \uploaded61 => gpuLengthIs(gpuZipWith (intEmpty, uploaded61, sumI), 0)), gpuSatisfies (toGpu ([1, 2, 3]), \uploaded60 => gpuLengthIs(gpuZipWith (uploaded60, intEmpty, sumI), 0)),
                        gpuSatisfies (fromGpu (intEmpty), \checked0 => listLength (checked0) == 0)
                    ]))))
(** Pin [GPU-FOLD]'s base case: with no element to combine, the result is exactly the initial value — for every combine, and for a buffer emptied by compaction rather than born empty. *)
emptyFoldCase () = withIndices (0, \indices0 => emptyFoldWith (indices0))
emptyFoldWith (indices0) = withBuffer (emptyInts (), \intEmpty => withBuffer (emptyFloats (), \floatEmpty => emptyFoldOn (indices0, intEmpty, floatEmpty)))
emptyFoldOn (indices0, intEmpty, floatEmpty) =
    withBuffer (toGpu ([1, 3, 5]), \value => withBuffer (gpuFilter(value, keepNone), \drained => checkAll "empty folds" [
                gpuEquals(gpuFold(intEmpty, 0, sumI), 0), gpuEquals(gpuFold(intEmpty, 7, sumI), 7), gpuEquals(gpuFold(intEmpty, 1, mulI), 1), gpuEquals(gpuFold(intEmpty, 100, subI), 100),
                gpuEquals(gpuFold(intEmpty, 9, horner), 9), gpuEquals(gpuFold(intEmpty, 3, maxI), 3), gpuEquals(gpuFold(floatEmpty, 0.0, addF), 0.0),
                gpuEquals(gpuFold(floatEmpty, 2.5, addF), 2.5), gpuSatisfies(gpuMap(intEmpty, isEven), \uploaded149 => gpuEquals(gpuFold(uploaded149, 4, countTrue), 4)), gpuLength drained == 0,
                gpuEquals(gpuFold(drained, 11, sumI), 11), gpuSatisfies(gpuScan(drained, 0, sumI), \uploaded147 => gpuEquals(gpuFold(uploaded147, 13, sumI), 13)), gpuEquals(gpuFold(indices0, 5, mulI), 5),
                gpuSatisfies(gpuZipWith (intEmpty, intEmpty, sumI), \uploaded145 => gpuEquals(gpuFold(uploaded145, 6, sumI), 6))
            ]))
(** Walk the one-element buffer through every combinator: the smallest shape where a kernel actually runs, and the one where an off-by-one in a loop bound or a prefix seed shows up immediately. *)
singletonCase () =
    withBuffer (toGpu ([5]), \one => withBuffer (gpuScan(one, 3, sumI), \scanned => checkAll "singleton" [
                structuralEquals [gpuLength one, gpuLength scanned] [1, 1],
                structuralEquals [(gpuGet (scanned, 0) ?: 0), (gpuGet (one, 1) ?: 42)] [8, 42],
                gpuSatisfies(gpuMap(one, dbl), \uploaded143 => (gpuGet (uploaded143, 0) ?: 0) == 10), gpuLengthIs(gpuFilter(one, isEven), 0),
                gpuSatisfies (toGpu ([4]), \uploaded57 => gpuLengthIs(gpuFilter(uploaded57, isEven), 1)), gpuSatisfies (toGpu ([4]), \uploaded56 => gpuSatisfies(gpuFilter(uploaded56, isEven), \uploaded140 => (gpuGet (uploaded140, 0) ?: 0) == 4)),
                gpuSatisfies(gpuScan(one, 0, maxI), \uploaded139 => (gpuGet (uploaded139, 0) ?: 0) == 5), gpuEquals(gpuFold(one, 3, sumI), 8), gpuEquals(gpuFold(one, 10, subI), 5),
                gpuSatisfies (toGpu ([7]), \uploaded55 => gpuSatisfies(gpuZipWith (one, uploaded55, sumI), \uploaded136 => (gpuGet (uploaded136, 0) ?: 0) == 12)), gpuSatisfies (toGpu ([1, 2, 3]), \uploaded54 => gpuSatisfies(gpuZipWith (uploaded54, one, sumI), \uploaded135 => (gpuGet (uploaded135, 0) ?: 0) == 6))
            ]))
(** Pin [GPU-ZIPWITH]'s truncation to the shorter operand in both argument orders, with a non-commutative kernel so a swapped operand pair could not pass by accident. *)
raggedCase () = withIndices (3, \indices3 => withIndices (7, \indices7 => withIndices (4, \indices4 => raggedWith (indices3, indices7, indices4))))
raggedWith (indices3, indices7, indices4) =
    withBuffer (toGpu ([1, 2, 3, 4, 5]), \uploaded50 => withBuffer (toGpu ([10, 20]), \uploaded51 => withBuffer (gpuZipWith (uploaded50, uploaded51, subI), \leftFirst => withBuffer (toGpu ([10, 20]), \uploaded52 => withBuffer (toGpu ([1, 2, 3, 4, 5]), \uploaded53 => withBuffer (gpuZipWith (uploaded52, uploaded53, subI), \rightFirst => checkAll "ragged zip" [
                                structuralEquals [gpuLength leftFirst, gpuLength rightFirst] [2, 2],
                                structuralEquals [(gpuGet (rightFirst, 0) ?: 0), (gpuGet (rightFirst, 1) ?: 0)] [9, 18],
                                (gpuGet (leftFirst, 2) ?: 77) == 77,
                                gpuEquals(gpuFold(leftFirst, 27, sumI), 0),
                                gpuEquals(gpuFold(rightFirst, 0, sumI), 27),
