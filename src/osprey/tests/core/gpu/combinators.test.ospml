(** Pin the three shapes of a compaction — every element kept, none kept, alternating — and read the kept run back element by element so [GPU-FILTER]'s source-order guarantee is checked, not just its count. *)
filterKeepCase () =
    withBuffer (toGpu ([9, 4, 7, 2, 5, 8]), \src => withBuffer (gpuFilter(src, keepEvery), \kept => withBuffer (gpuFilter(src, isEven), \alternates => checkAll "filter keep sets" [
