mixedChainWith (indices30, indices6) = withBuffer (gpuFilter(indices30, isEven), \uploaded65 => withBuffer (gpuScan(uploaded65, 0, sumI), \uploaded190 => withBuffer (gpuFilter(uploaded190, bigEven), \prefixes => withBuffer (gpuMap(indices6, (\x => (x * 3) )), \tripled => withBuffer (gpuZipWith (indices6, tripled, mulI), \uploaded67 => withBuffer (gpuMap(uploaded67, inc), \uploaded189 => withBuffer (gpuFilter(uploaded189, isOddP), \woven => mixedChainChecks (indices6, tripled, prefixes, woven))))))))
mixedChainChecks (indices6, tripled, prefixes, woven) = checkAll "mixed chains" [
    gpuLength prefixes == 13, (gpuGet (prefixes, 0) ?: 0) == 6, (gpuGet (prefixes, 12) ?: 0) == 210, gpuSatisfies(gpuFold(prefixes, 0, sumI), \uploaded64 => (uploaded64) == 1118), gpuSatisfies(gpuFold(tripled, 0, sumI), \uploaded63 => (uploaded63) == 45),
    gpuSatisfies(gpuZipWith (tripled, indices6, subI), \uploaded62 => gpuSatisfies(gpuFold(uploaded62, 0, sumI), \uploaded188 => (uploaded188) == 30)), gpuLength woven == 3, (gpuGet (woven, 0) ?: 0) == 1, (gpuGet (woven, 2) ?: 0) == 49,
    gpuSatisfies(gpuFold(woven, 0, sumI), \uploaded61 => (uploaded61) == 63), gpuSatisfies(gpuFilter(woven, isEven), \uploaded60 => gpuLength (uploaded60) == 0),
    gpuSatisfies(gpuScan(woven, 0, sumI), \uploaded59 => gpuSatisfies(gpuFold(uploaded59, 0, sumI), \uploaded187 => (uploaded187) == 78))
    ]
(** Walk the whole element lattice [GPU-BUFFER-ELEM] allows — int to float through [GPU-CONVERT]'s toFloat, int and float to bool through predicates, bool back to int — folding each buffer at its own element type. *)
typeChangeCase () = withBuffer (toGpu ([1, 2, 3]), \value => withBuffer (gpuMap(value, toFloat), \widened => withBuffer (toGpu ([1, 2, 3, 4]), \value => withBuffer (gpuMap(value, isEven), \flags => withBuffer (gpuMap(flags, toBit), \bits => typeChangeChecks (widened, flags, bits))))))
typeChangeChecks (widened, flags, bits) = checkAll "type-changing maps" [
    gpuSatisfies(gpuFold(widened, 0.0, addF), \uploaded55 => (uploaded55) == 6.0), (gpuGet (widened, 1) ?: 0.0) == 2.0, gpuSatisfies(gpuMap(widened, half), \uploaded54 => gpuSatisfies(gpuFold(uploaded54, 0.0, addF), \uploaded186 => (uploaded186) == 3.0)),
    gpuSatisfies(gpuScan(widened, 0.0, addF), \uploaded53 => gpuSatisfies(gpuFold(uploaded53, 0.0, addF), \uploaded185 => (uploaded185) == 10.0)), gpuLength flags == 4, (gpuGet (flags, 0) ?: true) == false, (gpuGet (flags, 1) ?: false) == true,
    gpuSatisfies(gpuFold(flags, 0, countTrue), \uploaded52 => (uploaded52) == 2), gpuSatisfies(gpuFold(bits, 0, sumI), \uploaded51 => (uploaded51) == 2), gpuSatisfies(gpuMap(bits, toFloat), \uploaded50 => gpuSatisfies(gpuFold(uploaded50, 0.0, addF), \uploaded184 => (uploaded184) == 2.0)),
    gpuSatisfies (toGpu ([0.0 - 1.5, 0.0, 2.5]), \uploaded18 => gpuSatisfies(gpuMap(uploaded18, isPositive), \uploaded49 => gpuSatisfies(gpuFold(uploaded49, 0, countTrue), \uploaded183 => (uploaded183) == 1))),
    gpuSatisfies (toGpu ([0, 1, 2]), \uploaded17 => gpuSatisfies(gpuMap(uploaded17, toFloat), \uploaded48 => gpuSatisfies(gpuMap(uploaded48, isPositive), \uploaded182 => gpuSatisfies(gpuFold(uploaded182, 0, countTrue), \uploaded215 => (uploaded215) == 2))))
    ]
(** Pin toGpu (as) a consuming stage of an iterator pipeline [GPU-BUFFER-FUSE]: the pending map/filter stages replay inside the loop that fills the buffer, so no List is built on the way. A filtered chain publishes the kept prefix exactly as gpuFilter does, an inverted or empty range yields an empty buffer, and a fused map may change the element type. *)
fusionSourceCase () = withBuffer (toGpu(range (0, 10) |> filter isEven |> map (\x => (x * 2) )), \staged => fusionSourceChecks (staged))
fusionSourceChecks (staged) = checkAll "fused sources" [
    gpuSatisfies (toGpu(range (0, 4) |> map toFloat |> map half), \uploaded15 => gpuSatisfies(gpuFold(uploaded15, 0.0, addF), \uploaded47 => (uploaded47) == 3.0)), gpuSatisfies (toGpu(range (0, 4) |> map dbl |> map inc), \uploaded14 => gpuSatisfies(gpuFold(uploaded14, 0, sumI), \uploaded46 => (uploaded46) == 16)),
    gpuLength staged == 5, (gpuGet (staged, 4) ?: 0) == 16, gpuSatisfies(gpuFold(staged, 0, sumI), \uploaded45 => (uploaded45) == 40), gpuSatisfies (toGpu(range (0, 10) |> filter isEven), \uploaded13 => gpuSatisfies(gpuFold(uploaded13, 0, horner), \uploaded44 => (uploaded44) == 2468)),
    gpuSatisfies (toGpu(range (3, 7)), \uploaded12 => gpuSatisfies(gpuFold(uploaded12, 0, sumI), \uploaded43 => (uploaded43) == 18)), gpuSatisfies (toGpu(range (0, 1)), \uploaded11 => gpuLength (uploaded11) == 1), gpuSatisfies (toGpu(range (5, 5)), \uploaded10 => gpuLength (uploaded10) == 0),
    gpuSatisfies (toGpu(range (9, 2)), \uploaded9 => gpuLength (uploaded9) == 0), gpuSatisfies (toGpu(range (0, 10) |> filter keepNone), \uploaded8 => gpuLength (uploaded8) == 0), gpuSatisfies (toGpu(range (0, 10) |> filter keepEvery), \uploaded7 => gpuLength (uploaded7) == 10),
    gpuSatisfies (toGpu(range (0, 6) |> map toFloat), \uploaded6 => gpuSatisfies(gpuFold(uploaded6, 0.0, addF), \uploaded42 => (uploaded42) == 15.0)), gpuSatisfies (toGpu(range (0, 6) |> map isEven), \uploaded5 => gpuSatisfies(gpuFold(uploaded5, 0, countTrue), \uploaded41 => (uploaded41) == 3))
    ]
(** Feed a fused buffer into every combinator in turn, including both operand slots of a ragged zip, so a buffer built by the fusion path is indistinguishable from one copied out of a list. *)
fusionStageCase () = withBuffer (toGpu(range (0, 10) |> map (\x => (x * 2) )), \fused => withBuffer (toGpu(range (0, 10) |> filter isEven), \kept => fusionStageChecks (fused, kept)))
fusionStageChecks (fused, kept) = checkAll "fused into combinators" [
    gpuSatisfies(gpuMap(fused, inc), \uploaded40 => gpuSatisfies(gpuFold(uploaded40, 0, sumI), \uploaded181 => (uploaded181) == 100)), gpuSatisfies(gpuFilter(fused, isBig), \uploaded39 => gpuLength (uploaded39) == 7),
    gpuSatisfies(gpuFilter(fused, isBig), \uploaded38 => gpuSatisfies(gpuFold(uploaded38, 0, sumI), \uploaded180 => (uploaded180) == 84)), gpuSatisfies(gpuFilter(fused, isEven), \uploaded37 => gpuSatisfies(gpuFold(uploaded37, 0, sumI), \uploaded179 => (uploaded179) == 90)),
    gpuSatisfies(gpuScan(fused, 0, sumI), \uploaded36 => (gpuGet (uploaded36, 9) ?: 0) == 90), gpuSatisfies(gpuZipWith (fused, kept, sumI), \uploaded35 => gpuLength (uploaded35) == 5), gpuSatisfies(gpuZipWith (kept, fused, sumI), \uploaded34 => gpuLength (uploaded34) == 5),
    gpuSatisfies(gpuZipWith (fused, kept, sumI), \uploaded33 => gpuSatisfies(gpuFold(uploaded33, 0, sumI), \uploaded178 => (uploaded178) == 40)), gpuSatisfies(gpuZipWith (kept, kept, mulI), \uploaded32 => gpuSatisfies(gpuFold(uploaded32, 0, sumI), \uploaded177 => (uploaded177) == 120)),
    gpuSatisfies(gpuMap(fused, toFloat), \uploaded31 => gpuSatisfies(gpuFold(uploaded31, 0.0, addF), \uploaded176 => (uploaded176) == 90.0)), gpuSatisfies(gpuScan(kept, 0, sumI), \uploaded30 => gpuSatisfies(gpuFold(uploaded30, 0, sumI), \uploaded175 => (uploaded175) == 40)),
    gpuSatisfies(gpuMap(fused, isEven), \uploaded29 => gpuSatisfies(gpuFilter(uploaded29, truthy), \uploaded174 => gpuLength (uploaded174) == 10)),
    gpuSatisfies(gpuMap(fused, dbl), \uploaded28 => gpuSatisfies(gpuScan(uploaded28, 0, sumI), \uploaded173 => gpuSatisfies(gpuFold(uploaded173, 0, sumI), \uploaded214 => (uploaded214) == 660)))
    ]
(** Pin the index buffer [0, n) that gather and stencil start from, down to n = 1, n = 0, and a negative n — which yields an empty buffer for the same reason an inverted range does, never a negative allocation. *)
iotaCase () = withIndices (5, \indices5 => withIndices (1, \indices1 => withIndices (0, \indices0 => withIndices (3, \indices3 => iotaWith (indices5, indices1, indices0, indices3)))))
iotaWith (indices5, indices1, indices0, indices3) =
    idx = indices5
    checkAll "iota" [
        gpuLength idx == 5, gpuSatisfies(gpuFold(idx, 0, sumI), \uploaded27 => (uploaded27) == 10), (gpuGet (idx, 0) ?: 9) == 0, (gpuGet (idx, 4) ?: 0) == 4, (gpuGet (idx, 5) ?: 77) == 77, gpuSatisfies(gpuFold(idx, 0, horner), \uploaded26 => (uploaded26) == 1234), gpuLength (indices1) == 1, (gpuGet (indices1, 0) ?: 9) == 0,
        gpuLength (indices0) == 0, gpuSatisfies(gpuFold(indices0, 3, sumI), \uploaded25 => (uploaded25) == 3), iotaError (0 - 4) == "gpu: buffer allocation: a negative element count", gpuSatisfies(gpuZipWith (idx, idx, mulI), \uploaded24 => gpuSatisfies(gpuFold(uploaded24, 0, sumI), \uploaded172 => (uploaded172) == 30)),
        gpuSatisfies(gpuMap(idx, toFloat), \uploaded23 => gpuSatisfies(gpuFold(uploaded23, 0.0, addF), \uploaded171 => (uploaded171) == 10.0)), gpuSatisfies(gpuScan(indices3, 0, horner), \uploaded22 => gpuSatisfies(gpuFold(uploaded22, 0, sumI), \uploaded170 => (uploaded170) == 13))
    ]
(** Pin typed reads in bounds and a visible Error out of bounds, at both ends of the index range and at both element types — plus a gather kernel, since reading a buffer is pure and therefore legal inside one. *)
getCase () = withIndices (3, \indices3 => getWith (indices3))
getWith (indices3) = withBuffer (toGpu ([7, 8, 9]), \ints => withBuffer (toGpu ([1.5, 2.5]), \floats => withBuffer (gpuMap(indices3, (\i => gpuGet (ints, (2 - i) ) ?: 0)), \reversed => getChecks (ints, floats, reversed))))
getChecks (ints, floats, reversed) = checkAll "get" [
    (gpuGet (ints, 0) ?: 0) == 7, (gpuGet (ints, 1) ?: 0) == 8, (gpuGet (ints, 2) ?: 0) == 9, (gpuGet (floats, 0) ?: 0.0) == 1.5, (gpuGet (floats, 1) ?: 0.0) == 2.5, (gpuGet (ints, 3) ?: 999) == 999, (gpuGet (ints, (0 - 1) ) ?: 999) == 999, (gpuGet (floats, 2) ?: 9.5) == 9.5, oobMessage (ints, 0) == "value 7",
    oobMessage (ints, 3) == "gpuGet: index out of bounds", (gpuGet (reversed, 0) ?: 0) == 9, gpuSatisfies(gpuFold(reversed, 0, horner), \uploaded20 => (uploaded20) == 987)
    ]
(** Pin backend introspection: the host backend names itself, and says so rather than reporting a device it does not have [GPU-DEVICE]. *)
deviceCase () = checkAll "device" [
    gpuDevice () == "host", length (gpuDevice ()) == 4, gpuDevice () != "cuda:0"
    ]
(** Exact-value tests record any arithmetic fault as a failed assertion. *)
test ("every combinator over an empty buffer stays empty", \() => exactArithmetic (emptyShapeCase))
test ("gpuFold over an empty buffer is the initial value", \() => exactArithmetic (emptyFoldCase))
test ("every combinator handles a one-element buffer", \() => exactArithmetic (singletonCase))
test ("gpuZipWith truncates to the shorter operand in both orders", \() => exactArithmetic (raggedCase))
test ("gpuZipWith produces the kernel's element type", \() => exactArithmetic (zipTypeCase))
test ("gpuFilter keeps all, none, or alternates in source order", \() => exactArithmetic (filterKeepCase))
test ("gpuFilter predicates compose comparisons and boolean operators", \() => exactArithmetic (filterPredicateCase))
test ("gpuScan is an inclusive prefix element by element", \() => exactArithmetic (scanPrefixCase))
test ("gpuScan seeds element zero with the initial value", \() => exactArithmetic (scanSeedCase))
test ("non-commutative combines pin the traversal order", \() => exactArithmetic (orderCase))
test ("five-stage and longer chains stay exact", \() => exactArithmetic (deepChainCase))
test ("shape-changing combinators compose", \() => exactArithmetic (mixedChainCase))
test ("kernels move elements between all three scalar types", \() => exactArithmetic (typeChangeCase))
test ("an iterator pipeline fuses into a buffer with no list", \() => exactArithmetic (fusionSourceCase))
test ("a fused buffer feeds every combinator", \() => exactArithmetic (fusionStageCase))
test ("gpuIota builds the index buffer", \() => exactArithmetic (iotaCase))
test ("gpuGet reads typed elements and errors out of bounds", \() => exactArithmetic (getCase))
test ("gpuDevice names the active backend", \() => exactArithmetic (deviceCase))
