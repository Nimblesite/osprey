                                gpuSatisfies (toGpu ([9]), \uploaded46 => gpuSatisfies (toGpu ([1, 2, 3]), \uploaded47 => gpuLengthIs(gpuZipWith (uploaded46, uploaded47, mulI), 1))),
                                gpuLengthIs(gpuZipWith (indices3, indices7, sumI), 3), gpuLengthIs(gpuZipWith (indices7, indices3, sumI), 3),
                                gpuSatisfies(gpuZipWith (indices7, indices3, mulI), \uploaded126 => gpuEquals(gpuFold(uploaded126, 0, sumI), 5)), gpuLengthIs(gpuZipWith (indices4, indices4, sumI), 4)
                            ]))))))
(** Pin that the zip kernel's result type is the buffer's, not either operand's, including a pair whose two operands differ in type. *)
zipTypeCase () =
    withBuffer (toGpu ([1, 2, 3, 4]), \uploaded40 => withBuffer (toGpu ([3, 5, 7, 9]), \uploaded41 => withBuffer (gpuZipWith (uploaded40, uploaded41, sameParity), \parity => withBuffer (toGpu ([1, 3]), \uploaded42 => withBuffer (toGpu ([3, 5]), \uploaded43 => withBuffer (gpuZipWith (uploaded42, uploaded43, meanF), \means => withBuffer (toGpu ([1, 2]), \uploaded44 => withBuffer (toGpu ([0.5, 0.25]), \uploaded45 => withBuffer (gpuZipWith (uploaded44, uploaded45, mixAdd), \mixed => checkAll "zip element types" [
