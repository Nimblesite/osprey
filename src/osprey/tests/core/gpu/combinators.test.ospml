            structuralEquals [gpuLength staged, (gpuGet (staged, 4) ?: 0)] [5, 16],
            gpuEquals(gpuFold(staged, 0, sumI), 40), gpuSatisfies (toGpu(range (0, 10) |> filter isEven), \uploaded13 => gpuEquals(gpuFold(uploaded13, 0, horner), 2468)),
            gpuSatisfies (toGpu(range (3, 7)), \uploaded12 => gpuEquals(gpuFold(uploaded12, 0, sumI), 18)), gpuSatisfies (toGpu(range (0, 1)), \uploaded11 => gpuLength (uploaded11) == 1), gpuSatisfies (toGpu(range (5, 5)), \uploaded10 => gpuLength (uploaded10) == 0),
            gpuSatisfies (toGpu(range (9, 2)), \uploaded9 => gpuLength (uploaded9) == 0), gpuSatisfies (toGpu(range (0, 10) |> filter keepNone), \uploaded8 => gpuLength (uploaded8) == 0), gpuSatisfies (toGpu(range (0, 10) |> filter keepEvery), \uploaded7 => gpuLength (uploaded7) == 10),
            gpuSatisfies (toGpu(range (0, 6) |> map toFloat), \uploaded6 => gpuEquals(gpuFold(uploaded6, 0.0, addF), 15.0)), gpuSatisfies (toGpu(range (0, 6) |> map isEven), \uploaded5 => gpuEquals(gpuFold(uploaded5, 0, countTrue), 3))
        ])
(** Feed a fused buffer into every combinator in turn, including both operand slots of a ragged zip, so a buffer built by the fusion path is indistinguishable from one copied out of a list. *)
fusionStageCase () =
    withBuffer (toGpu(range (0, 10) |> map (\x => (x * 2) )), \fused => withBuffer (toGpu(range (0, 10) |> filter isEven), \kept => checkAll "fused into combinators" [
                gpuSatisfies(gpuMap(fused, inc), \uploaded40 => gpuEquals(gpuFold(uploaded40, 0, sumI), 100)), gpuLengthIs(gpuFilter(fused, isBig), 7),
                gpuSatisfies(gpuFilter(fused, isBig), \uploaded38 => gpuEquals(gpuFold(uploaded38, 0, sumI), 84)), gpuSatisfies(gpuFilter(fused, isEven), \uploaded37 => gpuEquals(gpuFold(uploaded37, 0, sumI), 90)),
                gpuSatisfies(gpuScan(fused, 0, sumI), \uploaded36 => (gpuGet (uploaded36, 9) ?: 0) == 90), gpuLengthIs(gpuZipWith (fused, kept, sumI), 5), gpuLengthIs(gpuZipWith (kept, fused, sumI), 5),
                gpuSatisfies(gpuZipWith (fused, kept, sumI), \uploaded33 => gpuEquals(gpuFold(uploaded33, 0, sumI), 40)), gpuSatisfies(gpuZipWith (kept, kept, mulI), \uploaded32 => gpuEquals(gpuFold(uploaded32, 0, sumI), 120)),
                gpuSatisfies(gpuMap(fused, toFloat), \uploaded31 => gpuEquals(gpuFold(uploaded31, 0.0, addF), 90.0)), gpuSatisfies(gpuScan(kept, 0, sumI), \uploaded30 => gpuEquals(gpuFold(uploaded30, 0, sumI), 40)),
                gpuSatisfies(gpuMap(fused, isEven), \uploaded29 => gpuLengthIs(gpuFilter(uploaded29, truthy), 10)),
                gpuSatisfies(gpuMap(fused, dbl), \uploaded28 => gpuSatisfies(gpuScan(uploaded28, 0, sumI), \uploaded173 => gpuEquals(gpuFold(uploaded173, 0, sumI), 660)))
            ]))
(** Pin the index buffer [0, n) that gather and stencil start from, down to n = 1, n = 0, and a negative n — which yields an empty buffer for the same reason an inverted range does, never a negative allocation. *)
iotaCase () = withIndices (5, \indices5 => withIndices (1, \indices1 => withIndices (0, \indices0 => withIndices (3, \indices3 => iotaWith (indices5, indices1, indices0, indices3)))))
iotaWith (indices5, indices1, indices0, indices3) =
    idx = indices5
    checkAll "iota" [
        structuralEquals [gpuLength idx, (gpuGet (idx, 0) ?: 9), (gpuGet (idx, 4) ?: 0)] [5, 0, 4],
        structuralEquals [(gpuGet (idx, 5) ?: 77), gpuLength (indices1)] [77, 1],
        structuralEquals [(gpuGet (indices1, 0) ?: 9), gpuLength (indices0)] [0, 0],
        gpuEquals(gpuFold(idx, 0, sumI), 10), gpuEquals(gpuFold(idx, 0, horner), 1234),
        gpuEquals(gpuFold(indices0, 3, sumI), 3), iotaError (0 - 4) == "gpu: buffer allocation: a negative element count", gpuSatisfies(gpuZipWith (idx, idx, mulI), \uploaded24 => gpuEquals(gpuFold(uploaded24, 0, sumI), 30)),
        gpuSatisfies(gpuMap(idx, toFloat), \uploaded23 => gpuEquals(gpuFold(uploaded23, 0.0, addF), 10.0)), gpuSatisfies(gpuScan(indices3, 0, horner), \uploaded22 => gpuEquals(gpuFold(uploaded22, 0, sumI), 13))
    ]
(** Pin typed reads in bounds and a visible Error out of bounds, at both ends of the index range and at both element types — plus a gather kernel, since reading a buffer is pure and therefore legal inside one. *)
getCase () = withIndices (3, \indices3 => getWith (indices3))
getWith (indices3) =
    withBuffer (toGpu ([7, 8, 9]), \ints => withBuffer (toGpu ([1.5, 2.5]), \floats => withBuffer (gpuMap(indices3, (\i => gpuGet (ints, (2 - i) ) ?: 0)), \reversed => checkAll "get" [
                    structuralEquals [(gpuGet (ints, 0) ?: 0), (gpuGet (ints, 1) ?: 0)] [7, 8],
                    structuralEquals [(gpuGet (ints, 2) ?: 0), (gpuGet (ints, 3) ?: 999)] [9, 999],
                    structuralEquals [(gpuGet (ints, (0 - 1) ) ?: 999), (gpuGet (reversed, 0) ?: 0)] [999, 9],
                    structuralEquals [(gpuGet (floats, 0) ?: 0.0), (gpuGet (floats, 1) ?: 0.0)] [1.5, 2.5],
                    (gpuGet (floats, 2) ?: 9.5) == 9.5,
                    oobMessage (ints, 0) == "value 7",
                    oobMessage (ints, 3) == "gpuGet: index out of bounds",
                    gpuEquals(gpuFold(reversed, 0, horner), 987)
                ])))
(** Pin backend introspection: the host backend names itself, and says so rather than reporting a device it does not have [GPU-DEVICE]. *)
deviceCase () = checkAll "device" [
    gpuDevice () == "host", length (gpuDevice ()) == 4, gpuDevice () != "cuda:0"
    ]
test ("every combinator over an empty buffer stays empty", exactly emptyShapeCase)
test ("gpuFold over an empty buffer is the initial value", exactly emptyFoldCase)
test ("every combinator handles a one-element buffer", exactly singletonCase)
test ("gpuZipWith truncates to the shorter operand in both orders", exactly raggedCase)
test ("gpuZipWith produces the kernel's element type", exactly zipTypeCase)
test ("gpuFilter keeps all, none, or alternates in source order", exactly filterKeepCase)
test ("gpuFilter predicates compose comparisons and boolean operators", exactly filterPredicateCase)
test ("gpuScan is an inclusive prefix element by element", exactly scanPrefixCase)
test ("gpuScan seeds element zero with the initial value", exactly scanSeedCase)
test ("non-commutative combines pin the traversal order", exactly orderCase)
test ("five-stage and longer chains stay exact", exactly deepChainCase)
test ("shape-changing combinators compose", exactly mixedChainCase)
test ("kernels move elements between all three scalar types", exactly typeChangeCase)
test ("an iterator pipeline fuses into a buffer with no list", exactly fusionSourceCase)
test ("a fused buffer feeds every combinator", exactly fusionStageCase)
test ("gpuIota builds the index buffer", exactly iotaCase)
test ("gpuGet reads typed elements and errors out of bounds", exactly getCase)
test ("gpuDevice names the active backend", exactly deviceCase)
