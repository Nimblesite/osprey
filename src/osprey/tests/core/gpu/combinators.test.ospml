// withBuffer, gpuSatisfies, withIndices, iotaError and exactArithmetic are the
// testing prelude's [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the
// one shared copy, so this file declares none of its own.
// GPU combinator algebra: how gpuMap, gpuFilter, gpuScan, gpuZipWith and
// gpuFold behave alone, at their degenerate edges, and composed into deep
// chains — the empty and one-element buffer, ragged truncation to the shorter
// operand, order-preserving compaction, the inclusive-prefix seed, the initial
// value a fold returns with nothing to reduce, and the left-to-right traversal
// the host backend documents ([GPU-MAP], [GPU-FOLD], [GPU-ZIPWITH],
// [GPU-IOTA], [GPU-GET], [GPU-SCAN], [GPU-FILTER], [GPU-BUFFER-FUSE],
// [GPU-CONVERT], [GPU-BACKEND-HOST], [GPU-DEVICE] —
// docs/specs/runtime/0034-GPUComputation.md).
(** The zero-length buffers every combinator is pushed through; the annotation supplies the element type an empty literal cannot. *)
emptyInts : Unit -> Result<GpuBuffer<int>, Error>
emptyInts () = toGpu([])
emptyFloats : Unit -> Result<GpuBuffer<float>, Error>
emptyFloats () = toGpu([])
(** sumI and mulI are the associative int combines fold and scan share. *)
sumI (a, b) = (a + b)
mulI (a, b) = (a * b)
(** subI and horner are deliberately non-commutative. Left-to-right is the only traversal that reproduces their results, so every assertion on them pins the order [GPU- BACKEND-HOST] rather than merely the element set. *)
subI (a, b) = (a - b)
horner (a, d) = (((a * 10) ) + d)
(** maxI makes a scan a running maximum; addF is the float reduction; orB is the boolean any-reduction that latches on the first accepted element. *)
maxI : (int, int) -> int
maxI (a, b) = match a > b
    true => a
    false => b
orB (a, b) = a || b
(** The population count that turns a bool buffer into a scalar. *)
countTrue (a, flag) = match flag
    true => (a + 1)
    false => a
(** dbl, inc and half are the one-line stages the deep chains are built from. *)
dbl (x) = (x * 2)
inc (x) = (x + 1)
half : float -> float
half (x) = x * 0.5
(** toBit widens a bool element back to an int one, closing the type cycle int -> bool -> int that [GPU-BUFFER-ELEM]'s three scalars allow. *)
toBit (b) = match b
    true => 1
    false => 0
(** isEven and isOddP are each other's negation; isOddP is spelled with `!` so the predicate slot is fed by a boolean operator, not just a comparison. *)
isEven (x) = (x % 2 ) == 0
isOddP (x) = !isEven(x)
(** keepEvery and keepNone are the degenerate predicates — total acceptance and total rejection, independent of the element. *)
keepEvery (x) = x == x
keepNone (x) = x != x
(** The remaining predicates compose comparisons with &&, || and !. *)
isBig (x) = x > 4
bigEven (x) = isEven(x) && isBig(x)
inBand (x) = x >= 3 && x <= 6
notBand (x) = !inBand(x)
atEdge (x) = (x < 2) || (x > 7)
isPositive (x) = x > 0.0
truthy (b) = b
(** The zip kernels below all return an element type neither operand has, so gpuZipWith is exercised as a type-changing combinator too. *)
sameParity (a, b) = isEven(a) == isEven(b)
lessF : (float, float) -> bool
lessF (a, b) = a < b
meanF (a, b) = (toFloat(a) + toFloat(b)) * 0.5
mixAdd : (int, float) -> float
mixAdd (i, x) = toFloat(i) + x
(** oobMessage renders a gpuGet outcome as text so the Error [GPU-GET] returns is visible in an assertion instead of being swallowed by a `?:` default. *)
oobMessage : (GpuBuffer<int>, int) -> string
oobMessage (buf, i) = match gpuGet(buf, i)
    Success value => "value ${value}"
    Error message => message
(** rendersAs is one gpuGet outcome as text, so an element's own type stays visible. *)
rendersAs (b, index, text) = oobMessage(b, index) == text
(** sumsTo, productsTo, differencesTo and hornerTo are [GPU-FOLD] with this file's int combines; subI and horner are non-commutative, so their `expected` also pins the traversal order. *)
sumsTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, sumI), expected)
productsTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, mulI), expected)
differencesTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, subI), expected)
hornerTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, horner), expected)
(** trueCountIs is [GPU-FOLD] with countTrue: `b` holds `expected` true elements. *)
trueCountIs (b, expected) = gpuEquals(gpuFold(b, 0, countTrue), expected)
(** foldedFrom reads a buffer already in hand through sumI from `foldSeed`: every filtered, scanned and zipped buffer below reads back through it, so bufferSumsTo and scanSumsTo are the same read at seed 0 and at a scan's own seed. *)
foldedFrom (buf, foldSeed, expected) = gpuSatisfies(buf, \s => sumsTo(s, foldSeed, expected))
(** bufferHornerTo reads a buffer through the non-commutative horner fold, from seed 0. *)
bufferHornerTo (buf, expected) = gpuSatisfies(buf, \b => hornerTo(b, 0, expected))
(** zipLeftIs zips `b` with the upload of `values` and keeps `expected` elements — the shorter operand wins. *)
zipLeftIs (b, values, expected) = gpuSatisfies(toGpu(values), \other => gpuLengthIs(gpuZipWith(b, other, sumI), expected))
(** zippedProductLengthIs and mixedZipLengthIs zip two uploads and keep `expected` elements; their kernels differ in type, and gpuZipWith only accepts a named function, so each names its own. *)
zippedProductLengthIs (values, others, expected) = gpuSatisfies(toGpu(values), \first => gpuSatisfies(toGpu(others), \second => gpuLengthIs(gpuZipWith(first, second, mulI), expected)))
mixedZipLengthIs (values, others, expected) = gpuSatisfies(toGpu(values), \first => gpuSatisfies(toGpu(others), \second => gpuLengthIs(gpuZipWith(first, second, mixAdd), expected)))
(** floatBufferSumsTo reads any float buffer already in hand — widened by [GPU-CONVERT], halved or scanned — through the float fold at seed 0.0, and evenFlagRuns counts the isEven flags a compaction keeps; the widened-type and bool-buffer cases all read through them. *)
floatBufferSumsTo (buf, expected) = gpuSatisfies(buf, \widened => floatSumsTo(widened, 0.0, expected))
evenFlagRuns (buf, expected) = gpuSatisfies(gpuMap(buf, isEven), \flags => gpuLengthIs(gpuFilter(flags, truthy), expected))
(** emptyShapeCase pins that no combinator invents an element from nothing: map, filter and scan over zero elements are all zero elements, whatever the kernel does to the element type. *)
emptyShapeCase () = withBuffer(emptyInts(), \intEmpty => withBuffer(emptyFloats(), \floatEmpty => emptyShapeWith(intEmpty, floatEmpty)))
emptyShapeWith (intEmpty, floatEmpty) = withBuffer(gpuMap(intEmpty, dbl), \mapped => withBuffer(gpuFilter(mapped, isEven), \filtered => withBuffer(gpuScan(filtered, 0, sumI), \scanned => withBuffer(gpuMap(scanned, inc), \chained => checkAll("empty shapes", [
    lengthIs(intEmpty, 0), gpuLengthIs(gpuMap(intEmpty, dbl), 0), gpuLengthIs(gpuMap(intEmpty, toFloat), 0), gpuLengthIs(gpuMap(intEmpty, isEven), 0),
    gpuLengthIs(gpuMap(floatEmpty, half), 0), gpuLengthIs(gpuFilter(intEmpty, keepEvery), 0), gpuLengthIs(gpuFilter(intEmpty, keepNone), 0),
    gpuLengthIs(gpuScan(intEmpty, 0, sumI), 0), gpuLengthIs(gpuScan(intEmpty, 99, maxI), 0), zipLeftIs(intEmpty, [1, 2, 3], 0), gpuSatisfies(toGpu([1, 2, 3]), \other => gpuLengthIs(gpuZipWith(other, intEmpty, sumI), 0)),
    gpuSatisfies(fromGpu(intEmpty), \values => listLength(values) == 0), elementIs(intEmpty, 0, 42, 42), lengthIs(chained, 0)
])))))
(** emptyFoldCase pins [GPU-FOLD]'s base case: with no element to combine, the result is exactly the initial value — for every combine, and for a buffer emptied by compaction rather than born empty. *)
emptyFoldCase () = withIndices(0, \indices0 => emptyFoldWith(indices0))
emptyFoldWith (indices0) = withBuffer(emptyInts(), \intEmpty => withBuffer(emptyFloats(), \floatEmpty => emptyFoldOn(indices0, intEmpty, floatEmpty)))
emptyFoldOn (indices0, intEmpty, floatEmpty) = withBuffer(toGpu([1, 3, 5]), \value => withBuffer(gpuFilter(value, keepNone), \drained => checkAll("empty folds", [
    sumsTo(intEmpty, 0, 0), sumsTo(intEmpty, 7, 7), productsTo(intEmpty, 1, 1), differencesTo(intEmpty, 100, 100), hornerTo(intEmpty, 9, 9), gpuEquals(gpuFold(intEmpty, 3, maxI), 3),
    floatSumsTo(floatEmpty, 0.0, 0.0), floatSumsTo(floatEmpty, 2.5, 2.5), gpuSatisfies(gpuMap(intEmpty, isEven), \flags => gpuEquals(gpuFold(flags, 4, countTrue), 4)),
    lengthIs(drained, 0), sumsTo(drained, 11, 11), foldedFrom(gpuScan(drained, 0, sumI), 13, 13),
    productsTo(indices0, 5, 5), gpuSatisfies(gpuZipWith(intEmpty, intEmpty, sumI), \zipped => sumsTo(zipped, 6, 6))
])))
(** singletonCase walks the one-element buffer through every combinator: the smallest shape where a kernel actually runs, and the one where an off-by-one in a loop bound or a prefix seed shows up immediately. *)
singletonCase () = withBuffer(toGpu([5]), \one => withBuffer(gpuScan(one, 3, sumI), \scanned => withBuffer(toGpu([4]), \four => withBuffer(toGpu([7]), \seven => withBuffer(toGpu([1, 2, 3]), \longer => checkAll("singleton", [
    lengthIs(one, 1), gpuSatisfies(gpuMap(one, dbl), \doubled => elementIs(doubled, 0, 0, 10)), gpuLengthIs(gpuFilter(one, isEven), 0),
    gpuLengthIs(gpuFilter(four, isEven), 1), gpuSatisfies(gpuFilter(four, isEven), \kept => elementIs(kept, 0, 0, 4)),
    lengthIs(scanned, 1), elementIs(scanned, 0, 0, 8), gpuSatisfies(gpuScan(one, 0, maxI), \running => elementIs(running, 0, 0, 5)),
    sumsTo(one, 3, 8), differencesTo(one, 10, 5), gpuSatisfies(gpuZipWith(one, seven, sumI), \zipped => elementIs(zipped, 0, 0, 12)),
    gpuSatisfies(gpuZipWith(longer, one, sumI), \zipped => elementIs(zipped, 0, 0, 6)), elementIs(one, 1, 42, 42)
]))))))
(** raggedCase pins [GPU-ZIPWITH]'s truncation to the shorter operand in both argument orders, and uses a non-commutative kernel so a swapped operand pair could not pass by accident. *)
raggedCase () = withIndices(3, \indices3 => withIndices(7, \indices7 => withIndices(4, \indices4 => raggedWith(indices3, indices7, indices4))))
raggedWith (indices3, indices7, indices4) = withBuffer(toGpu([1, 2, 3, 4, 5]), \left => withBuffer(toGpu([10, 20]), \right => withBuffer(gpuZipWith(left, right, subI), \leftFirst => withBuffer(gpuZipWith(right, left, subI), \rightFirst => checkAll("ragged zip", [
    lengthIs(leftFirst, 2), lengthIs(rightFirst, 2), elementsFrom(rightFirst, 0, 0, [9, 18]), sumsTo(leftFirst, 27, 0), sumsTo(rightFirst, 0, 27), elementIs(leftFirst, 2, 77, 77),
    zippedProductLengthIs([1, 2, 3], [9], 1), zippedProductLengthIs([9], [1, 2, 3], 1), gpuLengthIs(gpuZipWith(indices3, indices7, sumI), 3), gpuLengthIs(gpuZipWith(indices7, indices3, sumI), 3),
    foldedFrom(gpuZipWith(indices7, indices3, mulI), 0, 5), gpuLengthIs(gpuZipWith(indices4, indices4, sumI), 4)
])))))
(** zipTypeCase pins that the zip kernel's result type is the buffer's, not either operand's, including a pair whose two operands differ in type. *)
zipTypeCase () = withBuffer(toGpu([1, 2, 3, 4]), \first => withBuffer(toGpu([3, 5, 7, 9]), \second => withBuffer(gpuZipWith(first, second, sameParity), \parity => withBuffer(toGpu([1, 3]), \meanLeft => withBuffer(toGpu([3, 5]), \meanRight => withBuffer(gpuZipWith(meanLeft, meanRight, meanF), \means => withBuffer(toGpu([1, 2]), \mixLeft => withBuffer(toGpu([0.5, 0.25]), \mixRight => withBuffer(gpuZipWith(mixLeft, mixRight, mixAdd), \mixed => withBuffer(toGpu([1.0, 2.0, 3.0]), \lessLeft => withBuffer(toGpu([3.0, 2.0, 1.0]), \lessRight => withBuffer(gpuZipWith(lessLeft, lessRight, lessF), \flags => checkAll("zip element types", [
    lengthIs(parity, 4), elementIs(parity, 0, false, true), elementIs(parity, 1, true, false), trueCountIs(parity, 2),
    lengthIs(means, 2), elementsFrom(means, 0, 0.0, [2.0, 4.0]), floatSumsTo(means, 0.0, 6.0), elementIs(mixed, 0, 0.0, 1.5), floatSumsTo(mixed, 0.0, 3.75), mixedZipLengthIs([1, 2, 3], [0.5], 1),
    trueCountIs(flags, 1)
])))))))))))))
(** filterKeepCase pins the three shapes of a compaction — every element kept, none kept, alternating — and reads the kept run back element by element so [GPU-FILTER]'s source-order guarantee is checked, not just its count. *)
filterKeepCase () = withBuffer(toGpu([9, 4, 7, 2, 5, 8]), \src => withBuffer(gpuFilter(src, keepEvery), \kept => withBuffer(gpuFilter(src, isEven), \alternates => checkAll("filter keep sets", [
    lengthIs(kept, 6), elementsAt(kept, 0, [0, 5], [9, 8]), sumsTo(kept, 0, 35), gpuLengthIs(gpuFilter(src, keepNone), 0), lengthIs(alternates, 3), elementsFrom(alternates, 0, 0, [4, 2, 8]),
    elementIs(alternates, 3, 55, 55), gpuLengthIs(gpuFilter(src, isOddP), 3), bufferHornerTo(gpuFilter(src, isOddP), 975)
]))))
(** filterPredicateCase feeds the predicate slot from comparisons and from every boolean operator, over int and float elements and over a bool buffer whose elements are the predicate. *)
filterPredicateCase () = withIndices(10, \indices10 => withIndices(6, \indices6 => filterPredicateWith(indices10, indices6)))
filterPredicateWith (indices10, indices6) = withBuffer(toGpu([0.0 - 1.5, 0.0, 2.5, 4.0]), \signed => checkAll("filter predicates", [
    gpuLengthIs(gpuFilter(indices10, isBig), 5), foldedFrom(gpuFilter(indices10, isBig), 0, 35), gpuLengthIs(gpuFilter(indices10, bigEven), 2), foldedFrom(gpuFilter(indices10, bigEven), 0, 14),
    gpuLengthIs(gpuFilter(indices10, atEdge), 4), bufferHornerTo(gpuFilter(indices10, atEdge), 189), foldedFrom(gpuFilter(indices10, isOddP), 0, 25), gpuLengthIs(gpuFilter(indices10, inBand), 4),
    gpuLengthIs(gpuFilter(indices10, notBand), 6), foldedFrom(gpuFilter(indices10, notBand), 0, 27),
    gpuLengthIs(gpuFilter(signed, isPositive), 2), floatBufferSumsTo(gpuFilter(signed, isPositive), 6.5), evenFlagRuns(indices6, 3)
]))
(** scanPrefixCase reads [GPU-SCAN]'s inclusive prefix out one element at a time: element i is the combine folded through element i, so the last element must equal the whole-buffer fold and index n is out of bounds. *)
scanPrefixCase () = withIndices(5, \indices5 => scanPrefixWith(indices5))
scanPrefixWith (indices5) = withBuffer(toGpu([1, 2, 3, 4, 5]), \value => withBuffer(gpuScan(value, 0, sumI), \sums => withBuffer(gpuScan(sums, 0, sumI), \twice => withBuffer(toGpu([1, 2, 3, 4]), \four => withBuffer(gpuScan(four, 1, mulI), \products => checkAll("inclusive prefix", [
    lengthIs(sums, 5), elementsFrom(sums, 0, 0, [1, 3, 6, 10]), elementIs(sums, 4, 0, 15), elementIs(sums, 5, 77, 77), gpuSatisfies(gpuFold(value, 0, sumI), \total => elementIs(sums, 4, 0, total)),
    elementIs(twice, 4, 0, 35), lengthIs(products, 4), elementIs(products, 3, 0, 24), gpuSatisfies(gpuScan(indices5, 0, sumI), \scanned => elementIs(scanned, 4, 0, 10))
]))))))
(** scanSeedCase pins the seed's role — element 0 is combine(initial, src 0), never src 0 — over a sum, a maximum a high seed swamps, and a bool latch. *)
scanSeedCase () = withBuffer(toGpu([1, 2, 3]), \three => withBuffer(gpuScan(three, 10, sumI), \seeded => withBuffer(toGpu([3, 1, 4, 1, 5, 9, 2, 6]), \source => withBuffer(gpuScan(source, 0, maxI), \running => withBuffer(toGpu([1, 3, 4, 7]), \flagsSource => withBuffer(gpuMap(flagsSource, isEven), \flags => withBuffer(gpuScan(flags, false, orB), \latched => checkAll("scan seeds", [
    elementsFrom(seeded, 0, 0, [11, 13, 16]), elementsAt(running, 0, [0, 1, 3, 7], [3, 3, 4, 9]), sumsTo(running, 0, 46),
    gpuSatisfies(toGpu([3, 1, 4]), \source => foldedFrom(gpuScan(source, 100, maxI), 0, 300)), lengthIs(latched, 4), elementIs(latched, 1, true, false), trueCountIs(latched, 2)
]))))))))
(** orderCase pins the traversal itself. Every combine here is order-sensitive, so reversing the source has to change the answer, and a scan's last element has to agree with the fold running the same combine — the left-to-right host contract [GPU-BACKEND-HOST], written out as numbers. *)
orderCase () = withBuffer(toGpu([1, 2, 3, 4]), \digitsUp => withBuffer(gpuScan(digitsUp, 0, horner), \running => checkAll("traversal order", [
    hornerTo(digitsUp, 0, 1234), gpuSatisfies(toGpu([4, 3, 2, 1]), \digitsDown => hornerTo(digitsDown, 0, 4321)), hornerTo(digitsUp, 9, 91234),
    gpuSatisfies(toGpu([1, 2, 3]), \up => differencesTo(up, 100, 94)), gpuSatisfies(toGpu([3, 2, 1]), \down => differencesTo(down, 100, 94)), elementIs(running, 0, 0, 1),
    elementsFrom(running, 1, 0, [12, 123, 1234]), gpuSatisfies(gpuFold(digitsUp, 0, horner), \total => elementIs(running, 3, 0, total)),
    gpuSatisfies(toGpu([1, 2, 3]), \source => foldedFrom(gpuScan(source, 10, subI), 0, 20)), gpuSatisfies(toGpu([1, 2, 3]), \source => foldedFrom(gpuScan(source, 0, subI), 10, 0)), sumsTo(running, 0, 1370)
])))
(** deepChainCase runs pipelines of five and more dependent stages: each one allocates a fresh buffer the next stage consumes, so a stage that read a stale length or a stale pointer would corrupt every number below. *)
deepChainCase () = withIndices(12, \indices12 => withIndices(8, \indices8 => withIndices(20, \indices20 => deepChainWith(indices12, indices8, indices20))))
(** The widened chain folds a float buffer back through a bool one, closing the scalar-type cycle [GPU-BUFFER-ELEM] allows. *)
deepChainWith (indices12, indices8, indices20) = withBuffer(gpuMap(indices12, dbl), \doubled => withBuffer(gpuMap(doubled, toFloat), \asFloats => withBuffer(gpuMap(asFloats, half), \widened => withBuffer(gpuMap(indices8, inc), \steppedOnce => withBuffer(gpuMap(steppedOnce, dbl), \steppedTwice => withBuffer(gpuMap(steppedTwice, inc), \steppedThrice => withBuffer(gpuMap(steppedThrice, dbl), \steppedFourth => withBuffer(gpuMap(steppedFourth, inc), \stepped => withBuffer(gpuMap(indices20, dbl), \longDoubled => withBuffer(gpuFilter(longDoubled, isBig), \big => withBuffer(gpuScan(big, 0, sumI), \compacted => checkAll("deep chains", [
    lengthIs(compacted, 17), elementsAt(compacted, 0, [0, 16], [6, 374]), sumsTo(compacted, 0, 2550), floatSumsTo(widened, 0.0, 66.0),
    gpuSatisfies(gpuMap(widened, isPositive), \flags => gpuSatisfies(gpuMap(flags, toBit), \bits => sumsTo(bits, 0, 11))), lengthIs(stepped, 8),
    elementsAt(stepped, 0, [0, 7], [7, 35]), sumsTo(stepped, 0, 168), foldedFrom(gpuFilter(stepped, isOddP), 0, 168), gpuLengthIs(gpuFilter(stepped, isEven), 0)
]))))))))))))
(** mixedChainCase interleaves the shape-changing combinators — a compaction feeding a scan feeding another compaction, a zip feeding a map feeding a filter — where a wrong published length silently shortens everything after. *)
mixedChainCase () = withIndices(30, \indices30 => withIndices(6, \indices6 => mixedChainWith(indices30, indices6)))
mixedChainWith (indices30, indices6) = withBuffer(gpuFilter(indices30, isEven), \evens => withBuffer(gpuScan(evens, 0, sumI), \scanned => withBuffer(gpuFilter(scanned, bigEven), \prefixes => withBuffer(gpuMap(indices6, \x => (x * 3) ), \tripled => withBuffer(gpuZipWith(indices6, tripled, mulI), \products => withBuffer(gpuMap(products, inc), \stepped => withBuffer(gpuFilter(stepped, isOddP), \woven => checkAll("mixed chains", [
    lengthIs(prefixes, 13), elementsAt(prefixes, 0, [0, 12], [6, 210]), sumsTo(prefixes, 0, 1118), sumsTo(tripled, 0, 45),
    foldedFrom(gpuZipWith(tripled, indices6, subI), 0, 30), lengthIs(woven, 3), elementsAt(woven, 0, [0, 2], [1, 49]), sumsTo(woven, 0, 63), gpuLengthIs(gpuFilter(woven, isEven), 0),
    foldedFrom(gpuScan(woven, 0, sumI), 0, 78)
]))))))))
(** typeChangeCase walks the whole element lattice [GPU-BUFFER-ELEM] allows — int to float through [GPU-CONVERT]'s toFloat, int and float to bool through predicates, bool back to int — folding each buffer at its own element type. *)
typeChangeCase () = withBuffer(toGpu([1, 2, 3]), \counting => withBuffer(gpuMap(counting, toFloat), \widened => withBuffer(toGpu([1, 2, 3, 4]), \four => withBuffer(gpuMap(four, isEven), \flags => withBuffer(gpuMap(flags, toBit), \bits => withBuffer(toGpu([0.0 - 1.5, 0.0, 2.5]), \signed => withBuffer(toGpu([0, 1, 2]), \upToTwo => checkAll("type-changing maps", [
    floatSumsTo(widened, 0.0, 6.0), elementIs(widened, 1, 0.0, 2.0), floatBufferSumsTo(gpuMap(widened, half), 3.0),
    floatBufferSumsTo(gpuScan(widened, 0.0, addF), 10.0), lengthIs(flags, 4), elementIs(flags, 0, true, false),
    elementIs(flags, 1, false, true), trueCountIs(flags, 2), sumsTo(bits, 0, 2), floatBufferSumsTo(gpuMap(bits, toFloat), 2.0),
    gpuSatisfies(gpuMap(signed, isPositive), \positive => trueCountIs(positive, 1)),
    gpuSatisfies(gpuMap(upToTwo, toFloat), \widenedUpToTwo => gpuSatisfies(gpuMap(widenedUpToTwo, isPositive), \positive => trueCountIs(positive, 2)))
]))))))))
(** fusionSourceCase pins `toGpu` as a consuming stage of an iterator pipeline [GPU-BUFFER-FUSE]: the pending map/filter stages replay inside the loop that fills the buffer, so no `List` is built on the way. A filtered chain publishes the kept prefix exactly as gpuFilter does, an inverted or empty range yields an empty buffer, and a fused map may change the element type. *)
fusionSourceCase () = withBuffer(toGpu(range(0, 10) |> filter(isEven) |> map(\x => (x * 2) )), \staged => checkAll("fused sources", [
    floatBufferSumsTo(toGpu(range(0, 4) |> map(toFloat) |> map(half)), 3.0),
    gpuSatisfies(toGpu(range(0, 4) |> map(dbl) |> map(inc)), \chained => sumsTo(chained, 0, 16)), lengthIs(staged, 5), elementIs(staged, 4, 0, 16),
    sumsTo(staged, 0, 40), gpuSatisfies(toGpu(range(0, 10) |> filter(isEven)), \evens => hornerTo(evens, 0, 2468)),
    gpuSatisfies(toGpu(range(3, 7)), \four => sumsTo(four, 0, 18)), gpuLengthIs(toGpu(range(0, 1)), 1), gpuLengthIs(toGpu(range(5, 5)), 0),
    gpuLengthIs(toGpu(range(9, 2)), 0), gpuLengthIs(toGpu(range(0, 10) |> filter(keepNone)), 0), gpuLengthIs(toGpu(range(0, 10) |> filter(keepEvery)), 10),
    floatBufferSumsTo(toGpu(range(0, 6) |> map(toFloat)), 15.0), gpuSatisfies(toGpu(range(0, 6) |> map(isEven)), \flags => trueCountIs(flags, 3))
]))
(** fusionStageCase feeds a fused buffer into every combinator in turn, including both operand slots of a ragged zip, so a buffer built by the fusion path is indistinguishable from one copied out of a list. *)
fusionStageCase () = withBuffer(toGpu(range(0, 10) |> map(\x => (x * 2) )), \fused => withBuffer(toGpu(range(0, 10) |> filter(isEven)), \kept => checkAll("fused into combinators", [
    gpuSatisfies(gpuMap(fused, inc), \stepped => sumsTo(stepped, 0, 100)), gpuLengthIs(gpuFilter(fused, isBig), 7),
    foldedFrom(gpuFilter(fused, isBig), 0, 84), foldedFrom(gpuFilter(fused, isEven), 0, 90),
    gpuSatisfies(gpuScan(fused, 0, sumI), \scanned => elementIs(scanned, 9, 0, 90)), gpuLengthIs(gpuZipWith(fused, kept, sumI), 5),
    gpuLengthIs(gpuZipWith(kept, fused, sumI), 5), foldedFrom(gpuZipWith(fused, kept, sumI), 0, 40), foldedFrom(gpuZipWith(kept, kept, mulI), 0, 120), floatBufferSumsTo(gpuMap(fused, toFloat), 90.0),
    foldedFrom(gpuScan(kept, 0, sumI), 0, 40), evenFlagRuns(fused, 10), gpuSatisfies(gpuMap(fused, dbl), \doubled => foldedFrom(gpuScan(doubled, 0, sumI), 0, 660))
])))
(** iotaCase pins the index buffer [0, n) that gather and stencil start from, down to n = 1, n = 0, and a negative n — which yields an empty buffer for the same reason an inverted range does, never a negative allocation. *)
iotaCase () = withIndices(5, \indices5 => withIndices(1, \indices1 => withIndices(0, \indices0 => withIndices(3, \indices3 => iotaWith(indices5, indices1, indices0, indices3)))))
iotaWith (indices5, indices1, indices0, indices3) =
    idx = indices5
    checkAll("iota", [
        lengthIs(idx, 5), sumsTo(idx, 0, 10), elementIs(idx, 0, 9, 0), elementIs(idx, 4, 0, 4), elementIs(idx, 5, 77, 77), hornerTo(idx, 0, 1234),
        lengthIs(indices1, 1), elementIs(indices1, 0, 9, 0), lengthIs(indices0, 0), sumsTo(indices0, 3, 3), iotaError(0 - 4) == "gpu: buffer allocation: a negative element count",
        foldedFrom(gpuZipWith(idx, idx, mulI), 0, 30), floatBufferSumsTo(gpuMap(idx, toFloat), 10.0), foldedFrom(gpuScan(indices3, 0, horner), 0, 13)
    ])
(** getCase pins typed reads in bounds and a visible Error out of bounds, at both ends of the index range and at both element types — plus a gather kernel, since reading a buffer is pure and therefore legal inside one. *)
getCase () = withIndices(3, \indices3 => getWith(indices3))
getWith (indices3) = withBuffer(toGpu([7, 8, 9]), \ints => withBuffer(toGpu([1.5, 2.5]), \floats => withBuffer(gpuMap(indices3, \i => gpuGet(ints, (2 - i) ) ?: 0), \reversed => checkAll("get", [
    elementsFrom(ints, 0, 0, [7, 8, 9]), elementsFrom(floats, 0, 0.0, [1.5, 2.5]), elementsAt(ints, 999, [3, (0 - 1)], [999, 999]), elementIs(floats, 2, 9.5, 9.5), rendersAs(ints, 0, "value 7"),
    rendersAs(ints, 3, "gpuGet: index out of bounds"), elementIs(reversed, 0, 0, 9), hornerTo(reversed, 0, 987)
]))))
(** Pin backend introspection: the host backend names itself, and says so rather than reporting a device it does not have [GPU-DEVICE]. *)
deviceCase () = checkAll("device", [
        gpuDevice() == "host", length(gpuDevice()) == 4, gpuDevice() != "cuda:0"
])
exactTests([
    { name = "every combinator over an empty buffer stays empty", work = emptyShapeCase }, { name = "gpuFold over an empty buffer is the initial value", work = emptyFoldCase },
    { name = "every combinator handles a one-element buffer", work = singletonCase }, { name = "gpuZipWith truncates to the shorter operand in both orders", work = raggedCase },
    { name = "gpuZipWith produces the kernel's element type", work = zipTypeCase }, { name = "gpuFilter keeps all, none, or alternates in source order", work = filterKeepCase },
    { name = "gpuFilter predicates compose comparisons and boolean operators", work = filterPredicateCase }, { name = "gpuScan is an inclusive prefix element by element", work = scanPrefixCase },
    { name = "gpuScan seeds element zero with the initial value", work = scanSeedCase }, { name = "non-commutative combines pin the traversal order", work = orderCase },
    { name = "five-stage and longer chains stay exact", work = deepChainCase }, { name = "shape-changing combinators compose", work = mixedChainCase },
    { name = "kernels move elements between all three scalar types", work = typeChangeCase }, { name = "an iterator pipeline fuses into a buffer with no list", work = fusionSourceCase },
    { name = "a fused buffer feeds every combinator", work = fusionStageCase }, { name = "gpuIota builds the index buffer", work = iotaCase },
    { name = "gpuGet reads typed elements and errors out of bounds", work = getCase }, { name = "gpuDevice names the active backend", work = deviceCase }
])
