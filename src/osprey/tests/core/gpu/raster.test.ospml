// Rasterisation on the GPU surface: a fragment-shader-shaped renderer, and
// the addressing algebra every rasteriser is built out of. Every scene is one
// pure kernel dispatched over `gpuIota (width * height)` — the flat pixel grid
// — and layers composite with a single elementwise pass ([GPU-IOTA], [GPU-MAP],
// [GPU-ZIPWITH], [GPU-FILTER], [GPU-FOLD], [GPU-SCAN], [GPU-GET], [GPU-DEVICE]
// — docs/specs/runtime/0034-GPUComputation.md). Shading is fixed-point integer
// arithmetic — the workload a fragment shader actually runs — and the kernels
// reach recursive helpers and vertices captured by an inline lambda, both of
// which prove [GPU-KERNEL-FORM]'s claim that a kernel is gated on purity, not
// on shape. Execution is the host backend [GPU-BACKEND-HOST] and a device
// target runs it unchanged.
(** scale is the fixed-point unit: one whole number is 4096 sub-units. The frame is the two full-size scenes, the tile the size raster primitives are asserted at, the
    quad the image small enough to pin every pixel of, and the ramp the palette a brightness level indexes — darkest first; glyph is that indexing. *)
scale () = 4096
frameWidth () = 64
frameHeight () = 24
tileEdge () = 8
quadEdge () = 4
ramp () = " .:-=+*#%@"
maxLevel () = 9
channelMax () = 255
glyph level = substring (ramp (), level, (level + 1) ) ?: " "
clampLevel (v, low) = clampRange (v, low, maxLevel ())
(** clampRange is saturation: values outside [lo, hi] stick to the nearer end; clampLevel above is that clamp against the palette, never below `low`. *)
clampRange (v, lo, hi) = match v < lo
    true => lo
    false => match v > hi
        true => hi
        false => v
(** absOf is a signed residual's magnitude, bit turns a coverage decision into a drawable sample, fullBright lifts it to the palette top, outOfFrame is a sentinel no
    brightness level can equal, and colOf/rowOf decompose a flat buffer index into raster coordinates with flatIndex as their exact inverse — the whole of [GPU-IOTA]
    addressing. *)
absOf v = match v < 0
    true => (0 - v)
    false => v
bit flag = match flag
    true => 1
    false => 0
fullBright v = (v * maxLevel ())
outOfFrame () = (0 - 1)
colOf (idx, w) = (idx % w)
rowOf (idx, w) = intDiv (idx, w)
flatIndex (x, y, w) = ((y * w) ) + x
(** isqrt is the floor of the square root by Newton's method converging from above, total on zero and on negatives; escape counts Mandelbrot iterations before z leaves
    the radius-2 disc, and mandelPixel is the fragment kernel that shades one — flat pixel index in, brightness out, the complex plane sampled at pixel centers over
    [-2.25, 0.75] x [-1.25, 1.25]. *)
isqrtIter (n, guess) =
    next = intDiv ((guess + (intDiv (n, guess) )) , 2)
    match next >= guess
        true => guess
        false => isqrtIter (n, next)
isqrt n = match n <= 0
    true => 0
    false => isqrtIter (n, n)
escape (zr, zi, cr, ci, i) = match i >= 24
    true => 24
    false =>
        zr2 = intDiv ((zr * zr) , scale ())
        zi2 = intDiv ((zi * zi) , scale ())
        match ((zr2 + zi2) ) > ((4 * scale ()) )
            true => i
            false => escape (
                ((zr2 - zi2) ) + cr ,
                (intDiv ((2 * zr * zi) , scale ()) ) + ci ,
                cr, ci, (i + 1) )
(** sampleX/sampleY are a pixel's offsets from the frame centre in cell units — every full-size fragment kernel recovers them the same way. *)
sampleX idx = ((2 * colOf (idx, frameWidth ())) ) + 1 - frameWidth ()
sampleY idx = ((2 * rowOf (idx, frameWidth ())) ) + 1 - frameHeight ()
mandelPixel idx =
    cr = (intDiv (((sampleX (idx)) * 12288) , (2 * frameWidth ()) ) ) - 3072
    ci = intDiv (((sampleY (idx)) * 10240) , (2 * frameHeight ()) )
    clampLevel (intDiv ((escape (0, 0, cr, ci, 0) * 10) , 24) , 0)
(** The silhouette radii are in half-cells — the 2:1 ratio corrects for cells being twice as tall as wide — and lightAxis is one axis of the unit light direction,
    1/sqrt(3) in fixed-point. lambert is the diffuse term for a surface point, in the same units, and spherePixel shades a unit sphere one ray per cell: the normal is
    recovered from the disc equation and lit from the upper left, and cells outside the silhouette stay at level zero. *)
sphereRadiusX () = 44
sphereRadiusY () = 22
lightAxis () = 2365
lambert (nx, ny, dd) =
    nz = isqrt (((scale () - dd) ) * scale () )
    axis = (0 - lightAxis ())
    intDiv (((nx * axis) ) + ((ny * axis) ) + ((nz * lightAxis ()) ) , scale ())
spherePixel idx =
    nx = intDiv (((sampleX (idx)) * scale ()) , sphereRadiusX ())
    ny = intDiv (((sampleY (idx)) * scale ()) , sphereRadiusY ())
    dd = intDiv (((nx * nx) ) + ((ny * ny) ) , scale ())
    match dd > scale ()
        true => 0
        false => clampLevel (intDiv ((lambert (nx, ny, dd) * 9) , scale ()) , 1)
(** edgeFn is the half-plane test at the heart of every triangle rasteriser: the cross product of edge AB with AP. It is zero exactly on the edge line, and at the
    opposite vertex its magnitude is twice the triangle's area. insideTri accepts a sample only when all three edges agree in sign, so a triangle wound the other way
    covers nothing; coverBuf rasterises one across a tile, its vertices captured by the kernel closure. *)
edgeFn (ax, ay, bx, by, px, py) =
    (((px - ax) ) * ((by - ay) ) ) - (((py - ay) ) * ((bx - ax) ) )
insideTri (ax, ay, bx, by, cx, cy, px, py) =
    (edgeFn(ax, ay, bx, by, px, py) <= 0 && edgeFn(bx, by, cx, cy, px, py) <= 0 && edgeFn(cx, cy, ax, ay, px, py) <= 0)
coverBuf (ax, ay, bx, by, cx, cy, indices64) = gpuMap (indices64, \idx => bit (insideTri (ax, ay, bx, by, cx, cy, colOf (idx, tileEdge ()), rowOf (idx, tileEdge ()))))
(** spanBit lights a pixel on scanline `sy` between columns x0 and x1 inclusive — a scanline filler's innermost test — spanBuf fills one such span across a tile, and
    clampedSpan clips the endpoints first so an off-image span draws its visible part rather than nothing. An inverted range fills nothing either way. spanStart is the
    first lit column of a scanline, or the width when it is empty; rowTotal sums one scanline a pixel at a time and rowSums reduces a raster to one total per scanline.
    Recursion needs a concrete signature. *)
spanBit (idx, sy, x0, x1) = bit (rowOf (idx, tileEdge ()) == sy
    && colOf (idx, tileEdge ()) >= x0 && colOf (idx, tileEdge ()) <= x1)
spanBuf (sy, x0, x1, indices64) = gpuMap (indices64, \idx => spanBit (idx, sy, x0, x1))
clampedSpan (sy, x0, x1, indices64) = spanBuf(sy, clampRange (x0, 0, (tileEdge () - 1) ), clampRange (x1, 0, (tileEdge () - 1) ), indices64)
spanStart (src, w, y, x) = match x == w
    true => w
    false => match (gpuGet (src, flatIndex (x, y, w)) ?: 0) > 0
        true => x
        false => spanStart (src, w, y, (x + 1) )
rowTotal (src, w, y, x) = match x == w
    true => 0
    false => ((gpuGet (src, flatIndex (x, y, w)) ?: 0) + rowTotal (src, w, y, (x + 1) ))
rowSums (src, w, indicesRows) = gpuMap (indicesRows, \y => rowTotal (src, w, y, 0))
(** spanTotalRun asserts a fill's total per entry of a flat (sy, x0, x1, want) table, so the degenerate spans are data rather than a run of near-identical lines. *)
spanTotalRun (fill, v) = match v
    [] => true
    [sy, x0, x1, want, ...rest] => grandIs (fill (sy, x0, x1), want) && spanTotalRun (fill, rest)
(** spanStartIs asserts the first lit column of scanline [y], and spanStartRun is a flat (y, want) pair table of them. *)
spanStartIs (pixels, w, y, want) = spanStart (pixels, w, y, 0) == want
spanStartRun (pixels, w, v) = match v
    [] => true
    [y, want, ...rest] => spanStartIs (pixels, w, y, want) && spanStartRun (pixels, w, rest)
(** sampleClamped is edge-clamp texture addressing: a coordinate off the image reads the nearest border texel instead of failing the gather. upscale2 is nearest-
    neighbour magnification — each source texel becomes a 2x2 block — and transposeOf swaps rows and columns; both address purely by decomposing the destination index
    and recomposing it against the source. The sat* trio is 8-bit channel arithmetic: results saturate into [0, 255] instead of wrapping. *)
sampleClamped (tex, w, h, x, y) =
    gpuGet(tex, flatIndex(clampRange(x, 0, (w - 1) ), clampRange(y, 0, (h - 1) ), w)) ?: 0
upscale2 (src, w, h, indicesOut) = gpuMap (indicesOut, \idx => sampleClamped (src, w, h, intDiv (colOf (idx, (2 * w) ), 2) , intDiv (rowOf (idx, (2 * w) ), 2) ))
transposeOf (src, w, h, indicesOut) = gpuMap (indicesOut, \idx => sampleClamped (src, w, h, rowOf (idx, h), colOf (idx, h)))
channelAdd (a, b) = clampRange ((a + b) , 0, channelMax ())
channelSub (a, b) = clampRange ((a - b) , 0, channelMax ())
channelMul (a, b) = clampRange (intDiv ((a * b) , channelMax ()) , 0, channelMax ())
(** sampleIs is sampleClamped as an assertion, sampleRun is sampleIs over a flat (x, y, want) triple list, and uploadedIs uploads a texel list to assert over. *)
sampleIs (tex, w, h, x, y, want) = sampleClamped (tex, w, h, x, y) == want
sampleRun (tex, w, h, v) = match v
    [] => true
    [x, y, want, ...rest] => sampleIs (tex, w, h, x, y, want) && sampleRun (tex, w, h, rest)
uploadedIs (values, work) = gpuSatisfies (toGpu (values), work)
(** texel is a bounds-checked read falling back to an impossible level, so an assertion against a gather that errored can never accidentally pass; total and litCount
    are the whole-buffer reductions the cases read. overLayer composites a lit foreground pixel over a background one, addLevels totals brightness, and the predicates
    select the cells a scene drew, the cells that never escaped, and the right frame edge. *)
texel (pixels, i) = gpuGet (pixels, i) ?: outOfFrame ()
total pixels = gpuFold (pixels, 0, addLevels)
litCountOf (pixels, predicate) = gpuSatisfies(gpuFilter (pixels, litPixel), \lit => predicate (gpuLength lit))
(** Whether the pixels a dispatch produced total [want]; exactly [want] of them are lit; pixel [index] is [want]; or the dispatch produced [want] pixels. Every scene assertion below is one of those four. *)
grandIs (result, want) = gpuSatisfies(result, \pixels => gpuEquals(total(pixels), want))
litIs (result, want) = gpuSatisfies(result, \pixels => litCountOf(pixels, \lit => lit == want))
texelIs (result, index, want) = gpuSatisfies(result, \pixels => texel (pixels, index) == want)
(** texelRun is whether [pixels] holds [want] in order from index [start] — the run form of texel, so a contiguous band of pixels is one assertion. A gather that
    errored reads the impossible level, so a broken run can never pass. *)
texelRun (pixels, start, want) = match want
    [] => true
    [v, ...rest] => texel (pixels, start) == v && texelRun (pixels, ((start + 1) ), rest)
(** texelRunOf is texelRun over a dispatched buffer, so a run of texelIs assertions is one line. *)
texelRunOf (result, start, want) = match want
    [] => true
    [v, ...rest] => texelIs(result, start, v) && texelRunOf (result, ((start + 1) ), rest)
(** texelsAt is that same assertion at raster coordinates — `v` is a flat (x, y, want) triple list over a raster [w] wide, so a coverage case states its read-backs as
    one table — and texelsAre is the flat-index (index, want) pair form. *)
texelsAt (pixels, w, v) = match v
    [] => true
    [x, y, want, ...rest] => texel (pixels, flatIndex (x, y, w)) == want && texelsAt (pixels, w, rest)
texelsAre (pixels, v) = match v
    [] => true
    [index, want, ...rest] => texel (pixels, index) == want && texelsAre (pixels, rest)
overLayer (bg, fg) = match fg > 0
    true => fg
    false => bg
addLevels (a, b) = (a + b)
litPixel level = level > 0
interiorPixel level = level >= 9
lastColumn v = v == ((frameWidth () - 1) )
(** residual is the index-decomposition error at one pixel — colOf and rowOf then flatIndex must reproduce the index exactly, everywhere — and columnOfPixel/rowOfPixel
    are that decomposition itself, as kernels. tilePixels and quadPixels are the small rasters' dispatch sizes, pixelGrid the index buffer the full-size kernels
    dispatch over, and the two frames the rendered layers; triCover is the reference triangle — a right wedge inset one pixel from the tile corner, covering x, y >= 1
    with x + y <= 7. *)
residual (idx) =
    absOf((flatIndex(colOf(idx, frameWidth()), rowOf(idx, frameWidth()), frameWidth()) - idx) )
columnOfPixel idx = colOf (idx, frameWidth ())
rowOfPixel idx = rowOf (idx, frameWidth ())
tilePixels () = (tileEdge () * tileEdge ())
quadPixels () = (quadEdge () * quadEdge ())
mandelFrame (indices1536) = gpuMap (indices1536, mandelPixel)
sphereFrame (indices1536) = gpuMap (indices1536, spherePixel)
(** withScene brackets one rendered frame and hands its case the pixels, their per-scanline sums and the interior cells — the bracket every full-size scene case shares.
    [FAILURE-EXPLICIT] A failed dispatch fails its case. *)
withScene (frame, indices24, work) =
    withBuffer(frame, \pixels => withBuffer(rowSums (pixels, frameWidth (), indices24), \sums => withBuffer(gpuFilter (pixels, interiorPixel), \interior => work (pixels, sums, interior))))
triCover (indices64) = coverBuf(1, 1, 6, 1, 1, 6, indices64)
(** gradientPixel is the quad's background — brightness rises with the column — wedgePixel covers its upper-left triangle at full brightness, and quadFrame is the whole
    small pipeline: two dispatches over one index grid composited by one elementwise pass, every pixel of it pinned below. rowText renders one scanline of any raster at
    any width, frameText all of them, and row/canvas/tile are those two at this file's fixed sizes. *)
gradientPixel idx = clampLevel ((colOf (idx, quadEdge ()) * 2) , 0)
wedgePixel (idx) =
    (bit(insideTri(0, 0, 3, 0, 0, 3, colOf(idx, quadEdge()), rowOf(idx, quadEdge()))) * maxLevel())
(** [FAILURE-EXPLICIT] A failed layer render stops the composite before its consumer. *)
quadEach (indices16, work) =
    withBuffer(gpuMap(indices16, gradientPixel), \gradient => withBuffer(gpuMap(indices16, wedgePixel), \wedge => withBuffer(gpuZipWith(gradient, wedge, overLayer), work)))
rowText (pixels, w, y) =
    range(0, w) |> fold("", \(acc, x) => acc + glyph(gpuGet(pixels, flatIndex(x, y, w)) ?: 0))
frameText (pixels, w, h) =
    range(0, h) |> fold("", \(acc, y) => acc + rowText(pixels, w, y) + "\n")
row (pixels, y) = rowText (pixels, frameWidth (), y)
canvas pixels = frameText (pixels, frameWidth (), frameHeight ())
(** rowIs is one rendered scanline as an assertion, rowRun is rowIs over a list of expected scanlines starting at [y], and frameIs is the whole-frame form. *)
rowIs (pixels, w, y, want) = rowText (pixels, w, y) == want
frameIs (pixels, w, h, want) = frameText (pixels, w, h) == want
rowRun (pixels, w, y, want) = match want
    [] => true
    [text, ...rest] => rowIs (pixels, w, y, text) && rowRun (pixels, w, (y + 1), rest)
(** [FAILURE-EXPLICIT] A failed full-brightness pass fails the case rather than printing raw levels. *)
withBrightText (result, work) =
    withBuffer(result, \pixels => withBuffer(gpuMap(pixels, fullBright), \bright => work(frameText(bright, tileEdge(), tileEdge()))))
(** brightRowIs is withBrightText for one scanline: the same full-brightness pass, asserting a single rendered row. *)
brightRowIs (result, y, want) =
    gpuSatisfies(result, \pixels => gpuSatisfies(gpuMap (pixels, fullBright), \bright => rowIs (bright, tileEdge (), y, want)))

(** gallery renders all three layers and their buffer statistics as one frame of output — one dispatch per scene, one elementwise pass to composite — then the raster
    primitives at a size every pixel can be read at: both windings of a triangle, spans clipped and unclipped, a magnified texel block, and the quad whose every pixel
    is asserted below. *)
gallery (indices1536, indices64, indices16, texels) =
    withBuffer(mandelFrame(indices1536),
        \mandel => withBuffer(sphereFrame(indices1536),
        \sphere => withBuffer(gpuZipWith(mandel, sphere, overLayer),
        \composite => withBuffer(gpuFilter(mandel, interiorPixel),
        \inside => withBuffer(gpuFilter(sphere, litPixel),
        \sphereLit => withBuffer(gpuFold(sphere, 0, addLevels),
        \light => withBrightText(triCover(indices64),
        \triangleText => withBrightText(coverBuf(1, 6, 6, 1, 1, 1, indices64),
        \invertedText => withBrightText(spanBuf(3, 2, 5, indices64),
        \spanText => withBrightText(clampedSpan(5, (0 - 4), 2, indices64),
        \clippedText => withBuffer(upscale2(texels, 2, 2, indices16),
        \upscaled => quadEach(indices16,
        \quad => print("== mandelbrot ${gpuLength(mandel)}px on ${gpuDevice()} ==\n${canvas(mandel)}" +
            "== lambert sphere ==\n${canvas(sphere)}" +
            "== composite ==\n${canvas(composite)}" +
            "interior=${gpuLength(inside)} " +
            "lit=${gpuLength(sphereLit)} " +
            "light=${light}" +
            "\n== triangle ==\n${triangleText}" +
            "== inverted triangle ==\n${invertedText}" +
            "== span y=3 x=2..5 ==\n${spanText}" +
            "== span clipped from -4..2 ==\n${clippedText}" +
            "== upscaled 2x2 ==\n${frameText(upscaled, 4, 4)}" +
            "== quad ==\n${frameText(quad, quadEdge(), quadEdge())}") ))))))))))))
(** dispatchCase pins the grid one dispatch covers at every raster size here, plus the empty dispatch every combinator survives and three gathers that leave the buffer
    entirely. *)
dispatchCase () = withIndices (0, \indices0 => withIndices (8, \indices8 => withIndices (16, \indices16 => withIndices (64, \indices64 => withIndices (1536, \indices1536 => dispatchWith (indices0, indices8, indices16, indices64, indices1536))))))
dispatchWith (indices0, indices8, indices16, indices64, indices1536) = checkAll "dispatch" [
    gpuLength (indices1536) == 1536, gpuLengthIs(mandelFrame(indices1536), 1536),
    gpuLengthIs(sphereFrame(indices1536), 1536), gpuLength (indices64) == 64,
    gpuLengthIs(triCover(indices64), 64),
    gpuSatisfies(gpuMap (indices16, gradientPixel), \gradient => gpuSatisfies(gpuMap (indices16, wedgePixel), \wedge => gpuLengthIs(gpuZipWith (gradient, wedge, overLayer), 16))),
    gpuSatisfies(triCover(indices64), \cover => gpuLengthIs(rowSums(cover, tileEdge (), indices8), 8)),
    gpuLength (indices0) == 0, gpuLengthIs(gpuMap (indices0, residual), 0),
    litIs (indices0, 0), grandIs (indices0, 0), texelsAre (indices0, [0, outOfFrame ()]),
    gpuSatisfies(triCover(indices64), \cover => texelsAre (cover, [64, outOfFrame (), (0 - 1) , outOfFrame ()])), gpuDevice () == "host"
]
(** paletteCase pins the whole brightness-to-character mapping and the clamps that keep a computed level inside it from either side. *)
paletteCase () = checkAll "palette" [
    glyph 0 == " ", glyph 1 == ".", glyph 2 == ":", glyph 3 == "-", glyph 4 == "=",
    glyph 5 == "+", glyph 6 == "*", glyph 7 == "#", glyph 8 == "%", glyph 9 == "@",
    length (ramp ()) == 10, glyph (clampLevel (99, 0)) == "@",
    glyph (clampLevel ((0 - 4) , 0)) == " ", clampLevel (0, 1) == 1,
    clampLevel (9, 0) == 9, clampLevel (10, 0) == 9, clampRange (5, 5, 5) == 5,
    clampRange (4, 5, 5) == 5, clampRange (6, 5, 5) == 5,
    clampRange ((0 - 7) , (0 - 9) , 0) == ((0 - 7) ),
    absOf ((0 - 12) ) == 12, absOf 0 == 0, bit true == 1, bit false == 0,
    fullBright 1 == 9, fullBright 0 == 0
]
(** decomposeCase pins index-to-coordinate decomposition over the whole frame: colOf/rowOf then flatIndex is the identity at all 1536 pixels, and the coordinate fields
    sum to their closed forms. *)
decomposeCase () = withIndices (1536, \indices1536 => decomposeWith (indices1536))
decomposeWith (indices1536) =
    withBuffer(gpuMap(indices1536, columnOfPixel), \cols => withBuffer(gpuMap(indices1536, rowOfPixel), \rows => checkAll("decompose", [
        grandIs(gpuMap(indices1536, residual), 0),
        litIs(gpuMap(indices1536, residual), 0),
        grandIs (cols, 48384), grandIs (rows, 17664), grandIs (indices1536, 1178880),
        gpuLengthIs(gpuFilter(cols, lastColumn), 24), litIs (cols, 1512), litIs (rows, 1472),
        texelsAre (cols, [0, 0, 63, 63, 64, 0, 1535, 63]), texelsAre (rows, [0, 0, 63, 0, 64, 1, 1535, 23]),
        flatIndex(0, 0, frameWidth()) == 0, flatIndex(63, 23, frameWidth()) == 1535,
        flatIndex(0, 1, frameWidth()) == 64, flatIndex(3, 2, tileEdge()) == 19,
        colOf(19, tileEdge()) == 3, rowOf(19, tileEdge()) == 2,
        flatIndex(0, 0, 1) == 0, colOf(7, 1) == 0, rowOf(7, 1) == 7
    ])))
(** edgeCase pins the edge function itself: zero along its own edge, twice the signed area at the opposite vertex, and a sign that flips with winding. *)
edgeCase () = checkAll "edge function" [
    edgeFn (1, 1, 6, 1, 1, 1) == 0, edgeFn (1, 1, 6, 1, 6, 1) == 0,
    edgeFn (1, 1, 6, 1, 3, 1) == 0, edgeFn (1, 1, 6, 1, 1, 6) == ((0 - 25) ),
    edgeFn (1, 1, 1, 6, 6, 1) == 25, edgeFn (6, 1, 1, 1, 1, 6) == 25,
    edgeFn (1, 1, 6, 1, 1, 2) == ((0 - 5) ), edgeFn (1, 1, 6, 1, 1, 0) == 5,
    edgeFn (0, 0, 3, 0, 3, 3) == ((0 - 9) ), edgeFn (0, 0, 0, 0, 5, 5) == 0,
    edgeFn (0, 0, 4, 0, 2, 0) == 0, edgeFn (0, 0, 4, 4, 2, 2) == 0,
    edgeFn (0, 0, 4, 4, 0, 4) == ((0 - 16) ), edgeFn (0, 0, 4, 4, 4, 0) == 16,
    insideTri (1, 1, 6, 1, 1, 6, 2, 2) == true, insideTri (1, 1, 6, 1, 1, 6, 0, 0) == false,
    insideTri (1, 6, 6, 1, 1, 1, 2, 2) == false
]
(** triangleCase rasterises triangles over a tile and pins their coverage: exact area, per-scanline spans, boundary inclusion, and the degenerate shapes — reversed
    winding, off-tile, larger than the tile, and the two of zero area. That last pair is where an inclusive half-plane test shows its teeth: collinear vertices leave a
    whole scanline satisfying every edge, and coincident vertices zero all three edge functions, so the whole tile passes — the ambiguity a real rasteriser resolves
    with a fill rule. *)
triangleCase () = withIndices (8, \indices8 => withIndices (64, \indices64 => triangleWith (indices8, indices64)))
triangleWith (indices8, indices64) =
    withBuffer(triCover(indices64), \cover => withBuffer(rowSums(cover, tileEdge(), indices8), \sums => checkAll("triangle", [
        grandIs (cover, 21), litIs (cover, 21), texelRun (sums, 0, [0, 6, 5, 4, 3, 2, 1, 0]),
        grandIs (sums, 21), spanStartRun (cover, tileEdge (), [0, 8, 1, 1, 6, 1]),
        texelsAt (cover, tileEdge (), [6, 1, 1, 7, 1, 0, 1, 6, 1, 0, 1, 0, 4, 4, 0, 3, 3, 1]),
        grandIs(coverBuf(1, 6, 6, 1, 1, 1, indices64), 0),
        grandIs(coverBuf(2, 2, 2, 2, 2, 2, indices64), 64),
        grandIs(coverBuf(0, 0, 3, 0, 6, 0, indices64), 8),
        grandIs(coverBuf(20, 20, 26, 20, 20, 26, indices64), 0),
        grandIs(coverBuf(0, 0, 7, 0, 0, 7, indices64), 36),
        grandIs(coverBuf((0 - 9), (0 - 9), 40, (0 - 9), (0 - 9), 40, indices64), 64)
    ])))
(** spanCase pins scanline filling and every degenerate span: a normal run, a single pixel, a whole row, an inverted range, a row off the tile, and one off-image span
    that draws nothing until clipped. *)
spanCase () = withIndices (64, \indices64 => spanWith (indices64))
spanWith (indices64) =
    withBuffer(spanBuf(3, 2, 5, indices64), \mid => withBuffer(clampedSpan(2, (0 - 4), (0 - 1), indices64), \clipped => checkAll("span fill", [
        grandIs (mid, 4), spanStartIs (mid, tileEdge (), 3, 2),
        texelsAt (mid, tileEdge (), [2, 3, 1, 5, 3, 1, 1, 3, 0, 6, 3, 0, 2, 2, 0, 2, 4, 0]),
        spanTotalRun (\(sy, x0, x1) => spanBuf (sy, x0, x1, indices64),
            [0, 0, 0, 1, 7, 7, 7, 1, 0, 0, 7, 8, 4, 5, 2, 0, 8, 0, 7, 0, (0 - 1) , 0, 7, 0, 2, (0 - 4) , (0 - 1) , 0, 1, (0 - 9) , 99, 8]),
        grandIs (clipped, 1),
        spanTotalRun (\(sy, x0, x1) => clampedSpan (sy, x0, x1, indices64), [5, (0 - 4) , 2, 3, 5, 6, 99, 2]),
        texelsAre (clipped, [flatIndex (0, 2, tileEdge ()), 1]),
        brightRowIs (spanBuf(3, 2, 5, indices64), 3, "  @@@@  "),
        brightRowIs (spanBuf(3, 2, 5, indices64), 2, "        ")
    ])))
(** saturateCase pins channel arithmetic at both rails: nothing wraps, nothing leaves [0, 255], and the same clamps hold elementwise over buffers. *)
saturateCase () = withBuffer(toGpu ([200, 0, 128, 255, 40]), \base => withBuffer(toGpu ([100, 0, 200, 1, 10]), \addend => saturateCaseUploaded(base, addend)))
saturateCaseUploaded (base, addend) =
    withBuffer(gpuZipWith (base, addend, channelAdd), \added => withBuffer(gpuZipWith (base, addend, channelSub), \subtracted => withBuffer(gpuZipWith (base, addend, channelMul), \multiplied => checkAll "saturation" [
        channelAdd (1, 1) == 2, channelAdd (0, 0) == 0, channelAdd (255, 0) == 255,
        channelAdd (254, 1) == 255, channelAdd (255, 1) == 255, channelAdd (255, 255) == 255,
        channelAdd ((0 - 50) , 10) == 0, channelSub (255, 255) == 0, channelSub (0, 1) == 0,
        channelSub (255, 1) == 254, channelSub (10, 40) == 0, channelMul (255, 255) == 255,
        channelMul (0, 255) == 0, channelMul (255, 0) == 0, channelMul (128, 200) == 100, channelMul (255, 1) == 1,
        texelsAre (added, [0, 255, 1, 0, 4, 50]),
        grandIs (added, 815), grandIs (subtracted, 384), grandIs (multiplied, 180),
        litIs (added, 4)
    ])))
(** samplingCase pins edge-clamp addressing and nearest-neighbour magnification — every magnified texel of it — plus the 1x1, single-row, single-column and empty
    degenerate images. *)
samplingCase () = withIndices (0, \indices0 => withIndices (4, \indices4 => withIndices (16, \indices16 => samplingWith (indices0, indices4, indices16))))
samplingWith (indices0, indices4, indices16) =
    withBuffer(toGpu([1, 2, 3, 4]), \tex => withBuffer(upscale2(tex, 2, 2, indices16), \big => checkAll("sampling", [
        sampleRun (tex, 2, 2, [0, 0, 1, 1, 0, 2, 0, 1, 3, 1, 1, 4, (0 - 5) , (0 - 5) , 1,
                               9, 9, 4, 9, 0, 2, 0, 9, 3, (0 - 1) , 9, 3]),
        uploadedIs ([7], \uploaded7 => sampleIs (uploaded7, 1, 1, 5, 5, 7)),
        uploadedIs ([5, 6, 7], \uploaded6 => sampleIs (uploaded6, 3, 1, 2, 4, 7)),
        uploadedIs ([5, 6, 7], \uploaded5 => sampleIs (uploaded5, 1, 3, 4, 2, 7)), gpuLength(big) == 16,
        texelRun (big, 0, [1, 1, 2, 2, 1, 1, 2, 2, 3, 3, 4, 4, 3, 3, 4, 4]),
        grandIs (big, 40),
        uploadedIs ([7], \uploaded4 => gpuLengthIs(upscale2(uploaded4, 1, 1, indices4), 4)),
        uploadedIs ([7], \uploaded3 => grandIs(upscale2(uploaded3, 1, 1, indices4), 28)),
        gpuLengthIs(upscale2(indices0, 0, 0, indices0), 0)
    ])))
(** gatherCase pins row and column addressing over a non-square raster: transpose by gather alone, its involution, the reductions it turns into each other, and a prefix
    scan read at each scanline boundary. *)
gatherCase () = withIndices (1, \indices1 => withIndices (2, \indices2 => withIndices (3, \indices3 => withIndices (6, \indices6 => withIndices (64, \indices64 => gatherWith (indices1, indices2, indices3, indices6, indices64))))))
gatherWith (indices1, indices2, indices3, indices6, indices64) =
    withBuffer(toGpu([1, 2, 3, 4, 5, 6]), \src => withBuffer(transposeOf(src, 3, 2, indices6), \flipped => withBuffer(triCover(indices64), \cover => withBuffer(gpuScan(cover, 0, addLevels), \running => checkAll("gather", [
        gpuLength(flipped) == 6, texelRun (flipped, 0, [1, 4, 2, 5, 3, 6]),
        gpuSatisfies(transposeOf(flipped, 2, 3, indices6), \restored => grandIs(gpuZipWith(restored, src, channelSub), 0)),
        texelRunOf(rowSums(src, 3, indices2), 0, [6, 15]),
        texelRunOf(rowSums(flipped, 2, indices3), 0, [5, 7, 9]),
        rowTotal(src, 3, 0, 0) == 6, rowTotal(src, 6, 0, 0) == 21, rowTotal(src, 1, 4, 0) == 5,
        uploadedIs ([9], \uploaded1 => texelIs(transposeOf(uploaded1, 1, 1, indices1), 0, 9)),
        texelsAre (running, [7, 0, 15, 6, 23, 11, 63, 21])
    ])))))
(** quadCase is the whole small pipeline pinned pixel by pixel: two kernels over one index grid, composited, read back at all sixteen positions and rendered as text —
    nothing here is a spot check. *)
quadCase () = withIndices (0, \indices0 => withIndices (16, \indices16 => quadWith (indices0, indices16)))
quadWith (indices0, indices16) = quadEach (indices16, \quad => checkAll "quad pipeline" [
        gpuLength quad == 16, texelRun (quad, 0, [9, 9, 9, 9, 9, 9, 9, 6, 9, 9, 4, 6, 9, 2, 4, 6]),
        grandIs (quad, 118), gpuLengthIs(gpuFilter (quad, interiorPixel), 10),
        litIs (quad, 16),
        rowRun (quad, quadEdge (), 0, ["@@@@", "@@@*", "@@=*", "@:=*"]),
        frameIs (quad, quadEdge (), 0, ""), frameIs (indices0, 0, 0, ""),
        rowIs (quad, 0, 0, ""), texelIs(gpuMap (indices16, gradientPixel), 3, 6),
        gpuSatisfies(gpuMap (indices16, wedgePixel), \wedge => texelsAre (wedge, [3, 9, 15, 0]))
    ])
(** mirrorRow counts a scanline matching its mirror across the real axis, and symmetryCase pins that the fractal frame is symmetric about that axis. *)
mirrorRow (pixels, acc, y) = match row (pixels, y) == row (pixels, ((frameHeight () - 1) ) - y )
    true => (acc + 1)
    false => acc
symmetryCase () = withIndices (24, \indices24 => withIndices (1536, \indices1536 => symmetryWith (indices24, indices1536)))
symmetryWith (indices24, indices1536) =
    withScene(mandelFrame(indices1536), indices24, \(mandel, sums, interior) => checkAll("symmetry", [
        range(0, frameHeight()) |> fold(0, \(acc, y) => mirrorRow(mandel, acc, y)) == 24, gpuLength(interior) == 344,
        litIs (mandel, 1212), grandIs (mandel, 4624),
        row(mandel, 0) == row(mandel, 23), row(mandel, 11) == row(mandel, 12),
        texel(sums, 11) == texel(sums, 12),
        spanStartIs (mandel, frameWidth (), 0, 24), texelsAre (mandel, [0, 0, 1535, 0])
    ]))
(** shadingCase pins the sphere: a lit silhouette, a dark background, a brightest cell on the lit side, and the integer square root that recovers the normal. *)
shadingCase () = withIndices (24, \indices24 => withIndices (1536, \indices1536 => shadingWith (indices24, indices1536)))
shadingWith (indices24, indices1536) =
    withScene(sphereFrame(indices1536), indices24, \(sphere, sums, interior) => checkAll("shading", [
        texelsAre (sphere, [0, 0, 1535, 0]),
        texelsAt (sphere, frameWidth (), [19, 5, 9, 31, 0, 0, 63, 12, 0]), litIs (sphere, 764),
        gpuLength(interior) == 1, grandIs (sphere, 2928),
        texelsAre (sums, [0, 0, 23, 0]),
        spanStartRun (sphere, frameWidth (), [0, 64, 12, 10]),
        isqrt(0) == 0, isqrt(1) == 1, isqrt(16) == 4, isqrt(17) == 4,
        isqrt(4096) == 64, isqrt((0 - 9) ) == 0
    ]))
(** compositeCase pins that one elementwise pass layers sphere over fractal. The silhouette falls entirely inside what the fractal drew, so the composite lights exactly
    the fractal's cells while its brightness total drops — the foreground is darker than what it hides. *)
compositeCase () = withIndices (0, \indices0 => withIndices (16, \indices16 => withIndices (1536, \indices1536 => compositeWith (indices0, indices16, indices1536))))
compositeWith (indices0, indices16, indices1536) =
    withBuffer(mandelFrame(indices1536), \mandel => withBuffer(sphereFrame(indices1536), \sphere => withBuffer(gpuZipWith(mandel, sphere, overLayer), \composite => checkAll("composite", [
        gpuLength(composite) == 1536, texel(composite, 0) == texel(mandel, 0),
        texelsAt (composite, frameWidth (), [19, 5, 9]), litIs (composite, 1212),
        gpuSatisfies(gpuFilter(composite, litPixel), \compositeLit => litCountOf(mandel, \mandelLit => gpuLength(compositeLit) == mandelLit)),
        grandIs (composite, 3860),
        overLayer(3, 0) == 3, overLayer(0, 7) == 7, overLayer(0, 0) == 0, overLayer(4, 4) == 4,
        gpuLengthIs(gpuZipWith(mandel, indices0, overLayer), 0),
        gpuLengthIs(gpuZipWith(indices16, sphere, overLayer), 16)
    ]))))
exactArithmetic (\() => withBuffer (toGpu ([1, 4, 7, 9]), \texels => withIndices (1536, \indices1536 => withIndices (64, \indices64 => withIndices (16, \indices16 => gallery (indices1536, indices64, indices16, texels))))))
(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactTests [
    { name = "one kernel dispatch covers the whole pixel grid", work = dispatchCase },
    { name = "brightness levels map onto the palette", work = paletteCase },
    { name = "flat indices decompose into raster coordinates", work = decomposeCase },
    { name = "edge functions are signed areas about their edge", work = edgeCase },
    { name = "triangles rasterise to exact coverage and spans", work = triangleCase },
    { name = "spans fill scanlines and clip at the tile edge", work = spanCase },
    { name = "channel arithmetic saturates at both rails", work = saturateCase },
    { name = "clamped addressing samples and magnifies", work = samplingCase },
    { name = "gather transposes rows and columns", work = gatherCase },
    { name = "a small pipeline is correct at every pixel", work = quadCase },
    { name = "the fractal kernel renders a symmetric frame", work = symmetryCase },
    { name = "the sphere kernel shades a lit silhouette", work = shadingCase },
    { name = "zipWith composites two rendered layers", work = compositeCase }
]
