(** [FAILURE-EXPLICIT] A checked stage preserves the first failure unchanged. *)
andThen (result, next) = match result
    Success value => next value
    Error message => Error(message = message)
// GPU stress, scale and numeric-edge workloads: million-element pipelines,
// two-dozen-pass chains, buffers rebuilt from their own output, and the
// checked-arithmetic boundaries where a `?:` fallback is all that stands
// between a kernel and an overflow. Every expected value is closed-form, and
// every accumulation that can overflow asserts both sides of its boundary —
// the last value that fits and the first that does not ([GPU-BACKEND-HOST],
// [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-ZIPWITH], [GPU-GET],
// [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
(** overflowMark is the sentinel a checked-arithmetic fallback publishes: no kernel below produces it any other way, so reading it back proves the fallback fired. maxInt and minInt are the two's-complement edges these accumulations walk to; hugeFloat is where a double's ulp reaches 2.0. minInt counts down from -maxInt because this flavor rejects -2^63. *)
marked work =
    handle Arith
        overflow _ _ _ _ => overflowMark ()
    work ()
preserving work =
    handle Arith
        overflow _ lhs _ _ => lhs
    work ()
zeroReciprocal work =
    handle Arith
        divideByZero _ _ => 0.0
    work ()
overflowMark () = -999
maxInt () = 9223372036854775807
minInt () = ((0 - maxInt ()) ) - 1
hugeFloat () = 10000000000000000.0
(** The growth kernels and the shared associative reduction — on overflow tally keeps its accumulator, so a saturating fold freezes rather than wraps. bump and lower step an element up and down, so a long chain of them must cancel exactly, and negate, absI and altSign drive the signed buffers. *)
square x = (x * x)
product (a, b) = (a * b)
tally (a, x) = preserving (\() => a + x)
bump x = (x + 1)
lower x = (x - 1)
negate x = (0 - x)
absI x = match x < 0
    true => (0 - x)
    false => x
altSign x = match (x % 2 ) == 0
    true => x
    false => (0 - x)
(** negSat, lowerSat and sqSat are the boundary-probing twins of negate, lower and square: the same arithmetic, but the fallback publishes the mark. Then the compaction predicates, and minI, a running minimum for gpuScan. *)
negSat x = marked (\() => (0 - x))
lowerSat x = marked (\() => (x - 1))
sqSat x = marked (\() => (x * x))
isEven x = (x % 2 ) == 0
isQuad x = (x % 4 ) == 0
isNeg x = x < 0
isPos x = x > 0
isMax x = x == maxInt ()
minI (a, b) = match a < b
    true => a
    false => b
(** prodSat and doubleUp are sticky: once the mark reaches the accumulator it stays, so the fold reports the *first* overflow. addOr marks an overflowing sum, clampAdd saturates it, and hugeScale walks elements past the int edge one at a time. *)
prodSat (a, x) = match a == overflowMark ()
    true => overflowMark ()
    false => marked (\() => (a * x))
doubleUp (a, _x) = match a == overflowMark ()
    true => overflowMark ()
    false => marked (\() => (a * 2))
addOr (a, x) = marked (\() => (a + x))
clampAdd (a, x) = satAdd a x
hugeScale x = satMul x 100000000000000000
(** The float kernels. addF's signature is load-bearing: a context-free `a + x` int-defaults [GPU-KERNEL-ELEM-TYPING]. headBig and tailBig plant one enormous value at opposite ends of an otherwise all-ones buffer, so one fold absorbs every small term after it and the other does not. *)
addF (a, x) = a + x
half x = x * 0.5
negF x = 0.0 - x
recip x = zeroReciprocal (\() => 1.0 / x)
tenthOf _x = 0.1
isPositiveF x = x > 0.0
stir x = (x * 1.0001 + 0.5) * 0.9999
headBig x = match x == 0.0
    true => hugeFloat ()
    false => 1.0
tailBig x = match x == 1000.0
    true => hugeFloat ()
    false => 1.0
(** simulate and mix rerun a kernel over the whole buffer n times, while rebuild sends the buffer back to the host and in again every pass, so each round trip is a fresh dense copy of its own output. Every recursive pass retains the original allocation or readback Error. *)
simulate (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, bump)
        Success value => simulate(value, n - 1)
        Error message => Error(message = message)
mix (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, stir)
        Success value => mix(value, n - 1)
        Error message => Error(message = message)
rebuild (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, bump)
        Success value => match fromGpu value
            Success value => match toGpu value
                Success value => rebuild (value, n - 1)
                Error message => Error(message = message)
            Error message => Error(message = message)
        Error message => Error(message = message)
(** Run a million elements through map, fold, filter and scan. *)
megaPipelineCase () = withIndices (1000000, \idx => megaPipelineWith (idx))
megaPipelineWith (idx) =
    withBuffer (gpuMap(idx, square), \squares => withBuffer (gpuFilter(idx, isEven), \evens => withBuffer (gpuScan(idx, 0, tally), \running => checkAll "million-element pipeline" [
                    gpuEquals(gpuFold(squares, 0, tally), 333332833333500000), gpuEquals(gpuFold(idx, 0, tally), 499999500000),
                    structuralEquals [gpuLength idx, gpuLength squares] [1000000, 1000000],
                    structuralEquals [(gpuGet (idx, 0) ?: -1), (gpuGet (idx, 999999) ?: -1)] [0, 999999],
                    structuralEquals [(gpuGet (squares, 999999) ?: -1), gpuLength evens] [999998000001, 500000],
                    structuralEquals [(gpuGet (evens, 499999) ?: -1), gpuLength running] [999998, 1000000],
                    structuralEquals [(gpuGet (running, 0) ?: -1), (gpuGet (running, 1) ?: -1)] [0, 1],
                    (gpuGet (running, 999999) ?: -1) == 499999500000,
                    (gpuGet (idx, 1000000) ?: -1) == -1, gpuEquals(gpuFold(evens, 0, tally), 249999500000)
                ])))
(** Read a 100k prefix sum, a seeded scan and a scan of a scan. *)
scanScaleCase () = withIndices (100000, \indices100000 => scanScaleWith (indices100000))
scanScaleWith (indices100000) =
    withBuffer (gpuScan(indices100000, 0, tally), \running => withBuffer (gpuScan(indices100000, 1000, tally), \seeded => withBuffer (gpuScan(running, 0, tally), \twice => checkAll "100k prefix scan" [
                    structuralEquals [(gpuGet (running, 0) ?: -1), (gpuGet (running, 1) ?: -1)] [0, 1],
                    structuralEquals [(gpuGet (running, 2) ?: -1), (gpuGet (running, 99999) ?: -1)] [3, 4999950000],
                    structuralEquals [gpuLength running, (gpuGet (seeded, 0) ?: -1)] [100000, 1000],
                    structuralEquals [(gpuGet (seeded, 99999) ?: -1), gpuLength seeded] [4999951000, 100000],
                    structuralEquals [(gpuGet (twice, 0) ?: -1), (gpuGet (twice, 2) ?: -1)] [0, 4],
                    (gpuGet (twice, 99999) ?: -1) == 166666666650000,
                    gpuEquals(gpuFold(running, 0, minI), 0)
                ])))
(** Run sixteen climbs then sixteen descents, back to back. *)
longChainCase () = withIndices (100000, \indices100000 => longChainWith (indices100000))
longChainWith (indices100000) =
    climbResult = (gpuMap(indices100000, bump) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower))
        |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) )
    match climbResult
        Success value =>
            climbed = value
            cancelResult = (gpuMap(climbed, lower) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower))
                |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) )
            withBuffer (cancelResult, \cancelled => checkAll "twenty-four chained passes" [
                    structuralEquals [gpuLength climbed, (gpuGet (climbed, 0) ?: -1)] [100000, 8],
                    structuralEquals [(gpuGet (climbed, 99999) ?: -1), gpuLength cancelled] [100007, 100000],
                    structuralEquals [(gpuGet (cancelled, 0) ?: -1), (gpuGet (cancelled, 99999) ?: -1)] [0, 99999],
                    gpuEquals(gpuFold(climbed, 0, tally), 5000750000),
                    gpuEquals(gpuFold(cancelled, 0, tally), 4999950000), gpuSatisfies(gpuFilter(cancelled, isEven), \uploaded109 => gpuEquals(gpuFold(uploaded109, 0, tally), 2499950000))
                ])
        Error message => gpuFailed message
(** Rebuild a buffer from its own materialized output six times. *)
rebuildCase () = withIndices (20000, \indices20000 => withIndices (0, \indices0 => withIndices (1, \indices1 => rebuildWith (indices20000, indices0, indices1))))
rebuildWith (indices20000, indices0, indices1) =
    withBuffer (rebuild (indices20000, 6), \settled => withBuffer (fromGpu (settled), \back => withBuffer (toGpu (back), \again => checkAll "six host round trips" [
                    structuralEquals [gpuLength settled, (gpuGet (settled, 0) ?: -1)] [20000, 6],
                    structuralEquals [(gpuGet (settled, 19999) ?: -1), listLength back] [20005, 20000],
                    structuralEquals [(listGet (back, 0) ?: -1), (listGet (back, 19999) ?: -1)] [6, 20005],
                    gpuLength again == 20000,
                    gpuEquals(gpuFold(settled, 0, tally), 200110000),
                    gpuEquals(gpuFold(again, 0, tally), 200110000), gpuSatisfies(gpuFilter(again, isEven), \uploaded106 => gpuEquals(gpuFold(uploaded106, 0, tally), 100050000)),
                    gpuSatisfies (rebuild (indices0, 4), \checked0 => gpuLength (checked0) == 0), gpuSatisfies (rebuild (indices1, 3), \checked0 => gpuEquals(gpuFold(checked0, 0, tally), 3))
                ])))
(** Compact 500k elements and then compact that result. *)
compactionScaleCase () = withIndices (500000, \src => compactionScaleWith (src))
compactionScaleWith (src) =
    withBuffer (gpuFilter(src, isEven), \evens => withBuffer (gpuFilter(evens, isQuad), \quads => checkAll "500k compaction" [
                structuralEquals [gpuLength evens, (gpuGet (evens, 0) ?: -1)] [250000, 0],
                structuralEquals [(gpuGet (evens, 249999) ?: -1), gpuLength quads] [499998, 125000],
                (gpuGet (quads, 124999) ?: -1) == 499996,
                gpuEquals(gpuFold(evens, 0, tally), 62499750000), (gpuGet (evens, 250000) ?: -1) == -1,
                gpuEquals(gpuFold(quads, 0, tally), 31249750000), gpuLengthIs(gpuFilter(src, isNeg), 0), gpuLengthIs(gpuFilter(src, isPos), 499999),
                gpuSatisfies(gpuFilter(src, isPos), \uploaded98 => gpuEquals(gpuFold(uploaded98, 0, tally), 124999750000)), gpuSatisfies(gpuFilter(src, isPos), \uploaded97 => gpuLengthIs(gpuFilter(uploaded97, isNeg), 0))
            ]))
(** Multiply 250k buffers, truncate ragged pairs and cancel. *)
zipScaleCase () = withIndices (250000, \idx => withIndices (1000000, \indices1000000 => withIndices (3, \indices3 => withIndices (0, \indices0 => zipScaleWith (idx, indices1000000, indices3, indices0)))))
zipScaleWith (idx, indices1000000, indices3, indices0) =
    withBuffer (gpuZipWith (idx, idx, product), \squares => withBuffer (gpuZipWith (indices1000000, indices3, tally), \ragged => withBuffer (gpuMap(idx, negate), \uploaded96 => withBuffer (gpuZipWith (idx,uploaded96, tally), \cancel => checkAll "250k zip" [
                        gpuEquals(gpuFold(squares, 0, tally), 5208302083375000),
                        structuralEquals [gpuLength squares, (gpuGet (squares, 249999) ?: -1)] [250000, 62499500001],
                        structuralEquals [gpuLength ragged, gpuLength cancel] [3, 250000],
                        (gpuGet (cancel, 249999) ?: -1) == 0,
                        gpuEquals(gpuFold(ragged, 0, tally), 6),
                        gpuLengthIs(gpuZipWith (indices3, indices1000000, tally), 3), gpuLengthIs(gpuZipWith (idx, indices0, tally), 0), gpuEquals(gpuFold(cancel, 0, tally), 0)
                    ]))))
(** Run 500 whole-buffer passes over 10k elements, then split the pass count in half without changing the answer. *)
simulationCase () = withIndices (10000, \indices10000 => withIndices (0, \indices0 => withIndices (1, \indices1 => simulationWith (indices10000, indices0, indices1))))
simulationWith (indices10000, indices0, indices1) =
    withBuffer (simulate (indices10000, 500), \settled => withBuffer (simulate (indices10000, 250), \uploaded7 => withBuffer (simulate (uploaded7, 250), \staged => checkAll "500-pass simulation" [
                    gpuEquals(gpuFold(settled, 0, tally), 54995000),
                    structuralEquals [gpuLength settled, (gpuGet (settled, 0) ?: -1)] [10000, 500],
                    structuralEquals [(gpuGet (settled, 9999) ?: -1), (gpuGet (staged, 9999) ?: -1)] [10499, 10499],
                    gpuEquals(gpuFold(staged, 0, tally), 54995000),
                    gpuLengthIs(simulate (indices0, 100), 0), gpuSatisfies(simulate (indices1, 7), \uploaded4 => gpuEquals(gpuFold(uploaded4, 0, tally), 7))
                ])))
(** Walk each checked operator to the int edge and one step past: 20! fits and 21! does not, 2^62 fits and 2^63 does not, 3037000499 squares and its successor does not, and minInt cannot negate. *)
overflowBoundaryCase () = withIndices (20, \indices20 => withIndices (21, \indices21 => withIndices (62, \indices62 => withIndices (63, \indices63 => overflowBoundaryWith (indices20, indices21, indices62, indices63)))))
overflowBoundaryWith (indices20, indices21, indices62, indices63) =
    withBuffer (gpuMap(indices20, bump), \uploaded84 => withBuffer (gpuFold(uploaded84, 1, prodSat), \fits => withBuffer (gpuMap(indices21, bump), \uploaded85 => withBuffer (gpuFold(uploaded85, 1, prodSat), \spills => withBuffer (toGpu ([3037000499, 3037000500]), \value => withBuffer (gpuMap(value, sqSat), \roots => withBuffer (toGpu ([minInt (), -1, 0, 1, maxInt ()]), \value => withBuffer (gpuMap(value, negSat), \edges => checkAll "checked overflow boundaries" [
                                        fits == 2432902008176640000,
                                        (gpuGet (roots, 0) ?: 0) == 9223372030926249001,
                                        structuralEquals [(gpuGet (edges, 1) ?: 0), (gpuGet (edges, 2) ?: 0)] [1, 0],
                                        spills == overflowMark (), gpuEquals(gpuFold(indices62, 1, doubleUp), 4611686018427387904), gpuSatisfies(gpuFold(indices63, 1, doubleUp), \uploaded80 => (uploaded80) == overflowMark ()),
                                        (gpuGet (roots, 1) ?: 0) == overflowMark (), (gpuGet (edges, 0) ?: 0) == overflowMark (), (gpuGet (edges, 3) ?: 0) == -1,
                                        (gpuGet (edges, 4) ?: 0) == -9223372036854775807, gpuSatisfies (toGpu ([maxInt ()]), \uploaded10 => gpuSatisfies(gpuFold(uploaded10, 0, addOr), \uploaded79 => (uploaded79) == maxInt ())),
                                        gpuSatisfies (toGpu ([maxInt (), 1]), \uploaded9 => gpuSatisfies(gpuFold(uploaded9, 0, addOr), \uploaded78 => (uploaded78) == overflowMark ())),
                                        gpuSatisfies (toGpu ([maxInt (), 1]), \uploaded8 => gpuSatisfies(gpuFold(uploaded8, 0, tally), \uploaded77 => (uploaded77) == maxInt ())),
                                        gpuSatisfies (toGpu ([minInt ()]), \uploaded7 => gpuSatisfies(gpuMap(uploaded7, lowerSat), \uploaded76 => gpuSatisfies(gpuFold(uploaded76, 0, addOr), \uploaded137 => (uploaded137) == overflowMark ()))),
                                        gpuSatisfies (toGpu ([maxInt (), 1]), \uploaded6 => gpuLengthIs(gpuFilter(uploaded6, isMax), 1))
                                    ]))))))))
(** Cross the int edge part way through two thousand elements. *)
saturationCase () = withIndices (2000, \indices2000 => saturationWith (indices2000))
saturationWith (indices2000) =
    withBuffer (gpuMap(indices2000, hugeScale), \bigs => withBuffer (gpuFilter(bigs, isMax), \saturated => checkAll "saturating accumulation" [
                structuralEquals [gpuLength bigs, (gpuGet (bigs, 0) ?: -1)] [2000, 0],
                structuralEquals [(gpuGet (bigs, 92) ?: -1), gpuLength saturated] [9200000000000000000, 1907],
                (gpuGet (bigs, 93) ?: -1) == maxInt (), (gpuGet (bigs, 1999) ?: -1) == maxInt (), (gpuGet (saturated, 0) ?: -1) == maxInt (),
                gpuSatisfies(gpuFold(bigs, 0, clampAdd), \uploaded72 => (uploaded72) == maxInt ()), gpuEquals(gpuFold(bigs, 0, tally), 9100000000000000000), gpuLengthIs(gpuFilter(bigs, isNeg), 0),
                gpuLengthIs(gpuMap(bigs, isMax), 2000)
            ]))
(** Carry a wholly negative buffer through every combinator. *)
negativeCase () = withIndices (100000, \indices100000 => negativeWith (indices100000))
negativeWith (indices100000) =
    withBuffer (gpuMap(indices100000, negate), \negs => withBuffer (gpuMap(negs, negate), \restored => withBuffer (gpuScan(negs, 0, tally), \running => withBuffer (gpuScan(negs, 0, minI), \lows => checkAll "negative values at scale" [
                        gpuEquals(gpuFold(negs, 0, tally), -4999950000),
                        structuralEquals [gpuLength negs, (gpuGet (negs, 0) ?: 1)] [100000, 0],
                        structuralEquals [(gpuGet (restored, 99999) ?: -1), (gpuGet (lows, 0) ?: 1)] [99999, 0],
                        (gpuGet (negs, 99999) ?: 1) == -99999, gpuLengthIs(gpuFilter(negs, isNeg), 99999),
                        gpuLengthIs(gpuFilter(negs, isPos), 0), gpuLengthIs(gpuFilter(negs, isEven), 50000),
                        gpuSatisfies(gpuFilter(negs, isEven), \uploaded60 => gpuEquals(gpuFold(uploaded60, 0, tally), -2499950000)), gpuEquals(gpuFold(restored, 0, tally), 4999950000),
                        (gpuGet (running, 1) ?: 1) == -1, (gpuGet (running, 99999) ?: 1) == -4999950000, (gpuGet (lows, 99999) ?: 1) == -99999, gpuSatisfies(gpuZipWith (negs, indices100000, tally), \uploaded58 => gpuEquals(gpuFold(uploaded58, 0, tally), 0)),
                        gpuSatisfies(gpuMap(negs, absI), \uploaded57 => gpuEquals(gpuFold(uploaded57, 0, tally), 4999950000))
