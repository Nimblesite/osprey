(** Run 500 whole-buffer passes over 10k elements, then split the pass count in half without changing the answer. *)
simulationCase () = withIndices (10000, \indices10000 => withIndices (0, \indices0 => withIndices (1, \indices1 => simulationWith (indices10000, indices0, indices1))))
