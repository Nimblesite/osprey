(** Flip sign on every other element of a 200k buffer: the fold telescopes, the scan oscillates, squaring erases the signs. *)
alternatingCase () = withIndices (200000, \indices200000 => alternatingWith (indices200000))
alternatingWith (indices200000) =
    withBuffer (gpuMap(indices200000, altSign), \alt => withBuffer (gpuScan(alt, 0, tally), \running => checkAll "alternating signs" [
                gpuEquals(gpuFold(alt, 0, tally), -100000),
                structuralEquals [gpuLength alt, (gpuGet (alt, 0) ?: 1), (gpuGet (alt, 2) ?: 0)] [200000, 0, 2],
                structuralEquals [(gpuGet (running, 0) ?: 1), (gpuGet (running, 2) ?: 0)] [0, 1],
                (gpuGet (alt, 1) ?: 0) == -1, (gpuGet (alt, 199999) ?: 0) == -199999, (gpuGet (running, 1) ?: 0) == -1,
                (gpuGet (running, 3) ?: 0) == -2, (gpuGet (running, 199999) ?: 0) == -100000, gpuLengthIs(gpuFilter(alt, isNeg), 100000),
                gpuSatisfies(gpuFilter(alt, isNeg), \uploaded52 => gpuEquals(gpuFold(uploaded52, 0, tally), -10000000000)), gpuLengthIs(gpuFilter(alt, isPos), 99999),
                gpuSatisfies(gpuFilter(alt, isPos), \uploaded50 => gpuEquals(gpuFold(uploaded50, 0, tally), 9999900000)), gpuSatisfies(gpuMap(alt, absI), \uploaded49 => gpuEquals(gpuFold(uploaded49, 0, tally), 19999900000)),
                gpuSatisfies(gpuMap(alt, square), \uploaded48 => gpuEquals(gpuFold(uploaded48, 0, tally), 2666646666700000)), gpuSatisfies(gpuZipWith (alt, alt, product), \uploaded47 => gpuEquals(gpuFold(uploaded47, 0, tally), 2666646666700000))
            ]))
(** Pin the empty buffer, the inverted extent and all-zeros. *)
zeroDegenerateCase () = withIndices (0, \empty => withIndices (50000, \indices50000 => withIndices (1000000, \indices1000000 => zeroDegenerateWith (empty, indices50000, indices1000000))))
zeroDegenerateWith (empty, indices50000, indices1000000) =
    inverted = iotaError (-1000000)
    withBuffer (gpuMap(indices50000, (\_x => 0)), \zeros => checkAll "zero and empty at every combinator" [
            structuralEquals [gpuLength empty, gpuLength zeros, (gpuGet (zeros, 49999) ?: -1)] [0, 50000, 0],
            inverted == "gpu: buffer allocation: a negative element count",
            iotaError (-7) == "gpu: buffer allocation: a negative element count",
            gpuSatisfies (toGpu ([]), \(uploaded5: GpuBuffer<int>) => gpuLength (uploaded5) == 0), gpuEquals(gpuFold(empty, 42, tally), 42),
            gpuLengthIs(gpuMap(empty, bump), 0), gpuLengthIs(gpuFilter(empty, isEven), 0), gpuLengthIs(gpuScan(empty, 0, tally), 0),
            gpuLengthIs(gpuZipWith (empty, indices1000000, tally), 0), gpuLengthIs(gpuZipWith (indices1000000, empty, tally), 0), (gpuGet (empty, 0) ?: -1) == -1, gpuSatisfies (fromGpu (empty), \checked0 => listLength (checked0) == 0),
            gpuSatisfies (fromGpu (empty), \checked0 => gpuSatisfies (toGpu (checked0), \uploaded4 => gpuLength (uploaded4) == 0)), gpuEquals(gpuFold(zeros, 0, tally), 0),
            gpuLengthIs(gpuFilter(zeros, isEven), 50000), gpuLengthIs(gpuFilter(zeros, isPos), 0), gpuSatisfies(gpuScan(zeros, 0, tally), \uploaded36 => (gpuGet (uploaded36, 49999) ?: -1) == 0),
            gpuSatisfies(gpuZipWith (zeros, indices50000, product), \uploaded35 => gpuEquals(gpuFold(uploaded35, 0, tally), 0)), gpuSatisfies(gpuMap(zeros, square), \uploaded34 => gpuEquals(gpuFold(uploaded34, 0, tally), 0))
