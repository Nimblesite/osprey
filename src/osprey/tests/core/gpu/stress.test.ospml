        Error message => check ("GPU operation", "success", toString message)
(** Walk each checked operator to the int edge and one step past: 20! fits and 21! does not, 2^62 fits and 2^63 does not, 3037000499 squares and its successor does not, and minInt cannot negate. *)
overflowBoundaryCase () = withIndices (20, \indices20 => withIndices (21, \indices21 => withIndices (62, \indices62 => withIndices (63, \indices63 => overflowBoundaryWith (indices20, indices21, indices62, indices63)))))
overflowBoundaryWith (indices20, indices21, indices62, indices63) =
    match gpuMap(indices20, bump)
