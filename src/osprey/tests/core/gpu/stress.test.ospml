                        gpuSatisfies(gpuFold(quads, 0, tally), \uploaded101 => (uploaded101) == 31249750000), gpuSatisfies(gpuFilter(src, isNeg), \uploaded100 => gpuLength (uploaded100) == 0), gpuSatisfies(gpuFilter(src, isPos), \uploaded99 => gpuLength (uploaded99) == 499999),
                        gpuSatisfies(gpuFilter(src, isPos), \uploaded98 => gpuSatisfies(gpuFold(uploaded98, 0, tally), \uploaded142 => (uploaded142) == 124999750000)), gpuSatisfies(gpuFilter(src, isPos), \uploaded97 => gpuSatisfies(gpuFilter(uploaded97, isNeg), \uploaded141 => gpuLength (uploaded141) == 0))
                    ]
