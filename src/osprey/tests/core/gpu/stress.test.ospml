(** [FAILURE-EXPLICIT] A checked stage preserves the first failure unchanged. *)
andThen (result, next) = match result
    Success value => next value
    Error message => Error(message = message)
// gpuSatisfies and exactArithmetic are the testing prelude's
// [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the one shared copy,
// so this file declares only the index helpers whose labels are its own.
(** [FAILURE-EXPLICIT] Allocation errors fail the case before its consumer runs. *)
withIndices (n, work) = match gpuIota n
    Success value => work value
    Error message => check "index allocation" "success" (toString message)
// GPU stress, scale and numeric-edge workloads: million-element pipelines,
// two-dozen-pass chains, buffers rebuilt from their own output, and the
// checked-arithmetic boundaries where a `?:` fallback is all that stands
// between a kernel and an overflow. Every expected value is closed-form, and
// every accumulation that can overflow asserts both sides of its boundary —
// the last value that fits and the first that does not ([GPU-BACKEND-HOST],
// [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-ZIPWITH], [GPU-GET],
// [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
(** overflowMark is the sentinel a checked-arithmetic fallback publishes: no kernel below produces it any other way, so reading it back proves the fallback fired. maxInt and minInt are the two's-complement edges these accumulations walk to; hugeFloat is where a double's ulp reaches 2.0. minInt counts down from -maxInt because this flavor rejects -2^63. *)
marked work =
    handle Arith
        overflow _ _ _ _ => overflowMark ()
    work ()
preserving work =
    handle Arith
        overflow _ lhs _ _ => lhs
    work ()
zeroReciprocal work =
    handle Arith
        divideByZero _ _ => 0.0
    work ()
overflowMark () = -999
maxInt () = 9223372036854775807
minInt () = ((0 - maxInt ()) ) - 1
hugeFloat () = 10000000000000000.0
(** The growth kernels and the shared associative reduction — on overflow tally keeps its accumulator, so a saturating fold freezes rather than wraps. bump and lower step an element up and down, so a long chain of them must cancel exactly, and negate, absI and altSign drive the signed buffers. *)
square x = (x * x)
product (a, b) = (a * b)
tally (a, x) = preserving (\() => a + x)
bump x = (x + 1)
lower x = (x - 1)
negate x = (0 - x)
absI x = match x < 0
    true => (0 - x)
    false => x
altSign x = match (x % 2 ) == 0
    true => x
    false => (0 - x)
(** negSat, lowerSat and sqSat are the boundary-probing twins of negate, lower and square: the same arithmetic, but the fallback publishes the mark. Then the compaction predicates, and minI, a running minimum for gpuScan. *)
negSat x = marked (\() => (0 - x))
lowerSat x = marked (\() => (x - 1))
sqSat x = marked (\() => (x * x))
isEven x = (x % 2 ) == 0
isQuad x = (x % 4 ) == 0
isNeg x = x < 0
isPos x = x > 0
isMax x = x == maxInt ()
minI (a, b) = match a < b
    true => a
    false => b
(** prodSat and doubleUp are sticky: once the mark reaches the accumulator it stays, so the fold reports the *first* overflow rather than a later product of the sentinel. addOr marks an overflowing sum, clampAdd saturates it, and hugeScale walks elements past the int edge one at a time. *)
sticky (a, step) = match a == overflowMark ()
    true => overflowMark ()
    false => marked step
prodSat (a, x) = sticky (a, \() => (a * x))
doubleUp (a, _x) = sticky (a, \() => (a * 2))
addOr (a, x) = marked (\() => (a + x))
clampAdd (a, x) = satAdd (a, x)
hugeScale x = satMul (x, 100000000000000000)
half x = x * 0.5
negF x = 0.0 - x
recip x = zeroReciprocal (\() => 1.0 / x)
tenthOf _x = 0.1
isPositiveF x = x > 0.0
stir x = (x * 1.0001 + 0.5) * 0.9999
atFloat (edge, x) = match x == edge
    true => hugeFloat ()
    false => 1.0
headBig x = atFloat (0.0, x)
tailBig x = atFloat (1000.0, x)
(** The checked one-buffer GPU step `step` applied to `buf` `times` times, retaining the first failure. *)
repeatStep (buf, times, step) = match times
    0 => Success(value = buf)
    _ => andThen (step (buf), \next => repeatStep (next, times - 1, step))
(** simulate and mix rerun a kernel over the whole buffer n times — the allocation churn a profiler should see — while rebuild sends the buffer back to the host and in again every pass, so each round trip is a fresh dense copy of its own output. lowerTimes is the inverse walk a climb cancels against. *)
simulate (buf, n) = repeatStep (buf, n, (\b => gpuMap(b, bump)))
mix (buf, n) = repeatStep (buf, n, (\b => gpuMap(b, stir)))
lowerTimes (buf, n) = repeatStep (buf, n, (\b => gpuMap(b, lower)))
rebuild (buf, n) = match n
    0 => Success(value = buf)
    _ => andThen (gpuMap (buf, bump), \mapped => andThen (fromGpu (mapped), \back => andThen (toGpu (back), \again => rebuild (again, n - 1))))
(** [GPU-FOLD] with tally: `b` from `seed` totals `expected`. *)
sumsTo (b, seed, expected) = gpuEquals(gpuFold(b, seed, tally), expected)
(** sumsTo from the zero seed. *)
sumIs (b, expected) = sumsTo (b, 0, expected)
(** Fold the zip of `a` and `b` with tally to `expected`. *)
zippedSumsTo (a, b, expected) = gpuSatisfies(gpuZipWith(a, b, tally), \zipped => sumIs (zipped, expected))
(** Fold the elementwise product of `a` and `b` with tally to `expected`. *)
zippedProductSumsTo (a, b, expected) = gpuSatisfies(gpuZipWith(a, b, product), \zipped => sumIs (zipped, expected))
(** Fold the upload of `values` with tally to `expected`. *)
uploadSumIs (values, expected) = gpuSatisfies(toGpu (values), \uploaded => sumIs (uploaded, expected))
(** Fold the upload of `values` with addOr to `expected`, so an overflow shows as the mark. *)
uploadAddOrIs (values, expected) = gpuSatisfies(toGpu (values), \uploaded => gpuEquals(gpuFold(uploaded, 0, addOr), expected))
(** Fold the upload of `values` with addF from `seed` to `expected`. *)
uploadFloatSumsTo (values, seed, expected) = gpuSatisfies(toGpu (values), \uploaded => floatSumsTo (uploaded, seed, expected))
