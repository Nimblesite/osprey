                                                                        (gpuGet (roots, 0) ?: 0) == 9223372030926249001, (gpuGet (roots, 1) ?: 0) == overflowMark (), (gpuGet (edges, 0) ?: 0) == overflowMark (), (gpuGet (edges, 1) ?: 0) == 1, (gpuGet (edges, 2) ?: 0) == 0, (gpuGet (edges, 3) ?: 0) == -1,
