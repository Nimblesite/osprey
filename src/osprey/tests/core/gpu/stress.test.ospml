longChainCase () = withIndices (100000, \indices100000 => longChainWith (indices100000))
longChainWith (indices100000) = withBuffer(simulate (indices100000, 16), \raised => withBuffer(lowerTimes (raised, 8), \climbed => withBuffer(lowerTimes (climbed, 8), \cancelled => checkAll("twenty-four chained passes", [
    lengthIs (climbed, 100000), elementsAt (climbed, (-1), [0, 99999], [8, 100007]), sumIs (climbed, 5000750000), lengthIs (cancelled, 100000), elementsAt (cancelled, (-1), [0, 99999], [0, 99999]), sumIs (cancelled, 4999950000), gpuSatisfies(gpuFilter(cancelled, isEven), \evens => sumIs (evens, 2499950000))
]))))
(** Rebuild a buffer from its own materialized output six times. *)
rebuildCase () = withIndices (20000, \indices20000 => withIndices (0, \indices0 => withIndices (1, \indices1 => rebuildWith (indices20000, indices0, indices1))))
rebuildWith (indices20000, indices0, indices1) = withBuffer(rebuild (indices20000, 6), \settled => withBuffer(fromGpu (settled), \back => withBuffer(toGpu (back), \again => checkAll("six host round trips", [
    lengthIs (settled, 20000), elementsAt (settled, (-1), [0, 19999], [6, 20005]), sumIs (settled, 200110000), listLengthIs (back, 20000), listHolds (back, 0, (-1), 6), listHolds (back, 19999, (-1), 20005), lengthIs (again, 20000), sumIs (again, 200110000), gpuSatisfies(gpuFilter(again, isEven), \evens => sumIs (evens, 100050000)), gpuLengthIs(rebuild (indices0, 4), 0), gpuSatisfies(rebuild (indices1, 3), \checked => sumIs (checked, 3))
]))))
(** Compact 500k elements and then compact that result. *)
compactionScaleCase () = withIndices (500000, \src => compactionScaleWith (src))
compactionScaleWith (src) = withBuffer(gpuFilter(src, isEven), \evens => withBuffer(gpuFilter(evens, isQuad), \quads => checkAll("500k compaction", [
    lengthIs (evens, 250000), sumIs (evens, 62499750000), elementsAt (evens, (-1), [0, 249999, 250000], [0, 499998, (-1)]), lengthIs (quads, 125000), elementIs (quads, 124999, (-1), 499996), sumIs (quads, 31249750000), gpuLengthIs(gpuFilter(src, isNeg), 0), gpuLengthIs(gpuFilter(src, isPos), 499999), gpuSatisfies(gpuFilter(src, isPos), \pos => sumIs (pos, 124999750000)), gpuSatisfies(gpuFilter(src, isPos), \pos => gpuLengthIs(gpuFilter(pos, isNeg), 0))
