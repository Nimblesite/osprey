    sumIs (squares, 333332833333500000), sumIs (idx, 499999500000), lengthIs (idx, 1000000), lengthIs (squares, 1000000), elementsAt (idx, (-1), [0, 999999, 1000000], [0, 999999, (-1)]), elementIs (squares, 999999, (-1), 999998000001), lengthIs (evens, 500000), sumIs (evens, 249999500000), elementIs (evens, 499999, (-1), 999998), lengthIs (running, 1000000), elementsAt (running, (-1), [0, 1, 999999], [0, 1, 499999500000])
]))))
