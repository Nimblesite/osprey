                                            match gpuMap(value, sqSat)
                                                Success roots =>
                                                    match toGpu ([minInt (), -1, 0, 1, maxInt ()])
                                                        Success value =>
                                                            match gpuMap(value, negSat)
                                                                Success edges =>
                                                                    checkAll "checked overflow boundaries" [
