(** Read one ahead, one behind and straight across a 100k buffer from inside kernels: each shift falls off exactly one end, and an out-of-range index is a visible Error rather than a silent zero. *)
gatherBoundaryCase () = withIndices (100000, \src => gatherBoundaryWith (src))
gatherBoundaryWith (src) =
    withBuffer (gpuMap(src, (\i => gpuGet (src, (i + 1) ) ?: -7)), \ahead => withBuffer (gpuMap(src, (\i => gpuGet (src, (i - 1) ) ?: -7)), \behind => withBuffer (gpuMap(src, (\i => gpuGet (src, (99999 - i) ) ?: -7)), \mirror => checkAll "gathers at the buffer edges" [
                    structuralEquals [(gpuGet (ahead, 0) ?: 0), (gpuGet (ahead, 99998) ?: 0)] [1, 99999],
                    structuralEquals [(gpuGet (behind, 1) ?: 0), (gpuGet (behind, 99999) ?: 0)] [0, 99998],
                    structuralEquals [(gpuGet (mirror, 0) ?: 0), (gpuGet (mirror, 99999) ?: 0)] [99999, 0],
                    (gpuGet (src, 99999) ?: -1) == 99999,
                    (gpuGet (ahead, 99999) ?: 0) == -7, gpuEquals(gpuFold(ahead, 0, tally), 4999949993), (gpuGet (behind, 0) ?: 0) == -7,
                    gpuEquals(gpuFold(behind, 0, tally), 4999849994), gpuEquals(gpuFold(mirror, 0, tally), 4999950000),
                    gpuLengthIs(gpuFilter(ahead, isNeg), 1), gpuLengthIs(gpuFilter(behind, isNeg), 1), (gpuGet (src, 100000) ?: -1) == -1, (gpuGet (src, 1000000) ?: -1) == -1, (gpuGet (src, -1) ?: -1) == -1,
                    (gpuGet (src, minInt ()) ?: -1) == -1, (gpuGet (src, maxInt ()) ?: -1) == -1
