(** Pin the empty buffer, the inverted extent and all-zeros. *)
zeroDegenerateCase () = withIndices (0, \empty => withIndices (50000, \indices50000 => withIndices (1000000, \indices1000000 => zeroDegenerateWith (empty, indices50000, indices1000000))))
zeroDegenerateWith (empty, indices50000, indices1000000) =
    inverted = iotaError (-1000000)
    match gpuMap(indices50000, (\_x => 0))
        Success zeros =>
            checkAll "zero and empty at every combinator" [
                gpuLength empty == 0, inverted == "gpu: buffer allocation: a negative element count", gpuSatisfies (toGpu ([]), \(uploaded5: GpuBuffer<int>) => gpuLength (uploaded5) == 0), gpuSatisfies(gpuFold(empty, 42, tally), \uploaded45 => (uploaded45) == 42), iotaError (-7) == "gpu: buffer allocation: a negative element count",
                gpuSatisfies(gpuMap(empty, bump), \uploaded44 => gpuLength (uploaded44) == 0), gpuSatisfies(gpuFilter(empty, isEven), \uploaded43 => gpuLength (uploaded43) == 0), gpuSatisfies(gpuScan(empty, 0, tally), \uploaded42 => gpuLength (uploaded42) == 0),
                gpuSatisfies(gpuZipWith (empty, indices1000000, tally), \uploaded41 => gpuLength (uploaded41) == 0), gpuSatisfies(gpuZipWith (indices1000000, empty, tally), \uploaded40 => gpuLength (uploaded40) == 0), (gpuGet (empty, 0) ?: -1) == -1, gpuSatisfies (fromGpu (empty), \checked0 => listLength (checked0) == 0),
                gpuSatisfies (fromGpu (empty), \checked0 => gpuSatisfies (toGpu (checked0), \uploaded4 => gpuLength (uploaded4) == 0)), gpuLength zeros == 50000, gpuSatisfies(gpuFold(zeros, 0, tally), \uploaded39 => (uploaded39) == 0), (gpuGet (zeros, 49999) ?: -1) == 0,
                gpuSatisfies(gpuFilter(zeros, isEven), \uploaded38 => gpuLength (uploaded38) == 50000), gpuSatisfies(gpuFilter(zeros, isPos), \uploaded37 => gpuLength (uploaded37) == 0), gpuSatisfies(gpuScan(zeros, 0, tally), \uploaded36 => (gpuGet (uploaded36, 49999) ?: -1) == 0),
                gpuSatisfies(gpuZipWith (zeros, indices50000, product), \uploaded35 => gpuSatisfies(gpuFold(uploaded35, 0, tally), \uploaded128 => (uploaded128) == 0)), gpuSatisfies(gpuMap(zeros, square), \uploaded34 => gpuSatisfies(gpuFold(uploaded34, 0, tally), \uploaded127 => (uploaded127) == 0))
            ]
        Error message => check ("GPU operation", "success", toString message)
(** Read one ahead, one behind and straight across a 100k buffer from inside kernels: each shift falls off exactly one end, and an out-of-range index is a visible Error rather than a silent zero. *)
gatherBoundaryCase () = withIndices (100000, \src => gatherBoundaryWith (src))
gatherBoundaryWith (src) =
    match gpuMap(src, (\i => gpuGet (src, (i + 1) ) ?: -7))
        Success ahead =>
            match gpuMap(src, (\i => gpuGet (src, (i - 1) ) ?: -7))
                Success behind =>
                    match gpuMap(src, (\i => gpuGet (src, (99999 - i) ) ?: -7))
                        Success mirror =>
                            checkAll "gathers at the buffer edges" [
                                (gpuGet (ahead, 0) ?: 0) == 1, (gpuGet (ahead, 99998) ?: 0) == 99999, (gpuGet (ahead, 99999) ?: 0) == -7, gpuSatisfies(gpuFold(ahead, 0, tally), \uploaded30 => (uploaded30) == 4999949993), (gpuGet (behind, 0) ?: 0) == -7, (gpuGet (behind, 1) ?: 0) == 0, (gpuGet (behind, 99999) ?: 0) == 99998,
                                gpuSatisfies(gpuFold(behind, 0, tally), \uploaded29 => (uploaded29) == 4999849994), (gpuGet (mirror, 0) ?: 0) == 99999, (gpuGet (mirror, 99999) ?: 0) == 0, gpuSatisfies(gpuFold(mirror, 0, tally), \uploaded28 => (uploaded28) == 4999950000),
                                gpuSatisfies(gpuFilter(ahead, isNeg), \uploaded27 => gpuLength (uploaded27) == 1), gpuSatisfies(gpuFilter(behind, isNeg), \uploaded26 => gpuLength (uploaded26) == 1), (gpuGet (src, 99999) ?: -1) == 99999, (gpuGet (src, 100000) ?: -1) == -1, (gpuGet (src, 1000000) ?: -1) == -1, (gpuGet (src, -1) ?: -1) == -1,
                                (gpuGet (src, minInt ()) ?: -1) == -1, (gpuGet (src, maxInt ()) ?: -1) == -1
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Widen a 100k index buffer through the float combinators. *)
floatScaleCase () = withIndices (100000, \indices100000 => floatScaleWith (indices100000))
floatScaleWith (indices100000) =
    match gpuMap(indices100000, toFloat)
        Success xs =>
            match gpuMap(xs, half)
                Success halves =>
                    match gpuMap(xs, negF)
                        Success flipped =>
                            match gpuMap(xs, recip)
                                Success recips =>
                                    checkAll "float buffers at scale" [
                                        gpuSatisfies(gpuFold(xs, 0.0, addF), \uploaded21 => (uploaded21) == 4999950000.0), gpuLength xs == 100000, (gpuGet (xs, 0) ?: -1.0) == 0.0, (gpuGet (xs, 99999) ?: -1.0) == 99999.0, gpuSatisfies(gpuFold(halves, 0.0, addF), \uploaded20 => (uploaded20) == 2499975000.0),
                                        (gpuGet (halves, 3) ?: -1.0) == 1.5, gpuSatisfies(gpuFold(flipped, 0.0, addF), \uploaded19 => (uploaded19) == -4999950000.0), (gpuGet (flipped, 99999) ?: 0.0) == -99999.0, (gpuGet (recips, 0) ?: -1.0) == 0.0, (gpuGet (recips, 1) ?: -1.0) == 1.0, (gpuGet (recips, 4) ?: -1.0) == 0.25,
                                        gpuSatisfies(gpuScan(xs, 0.0, addF), \uploaded18 => (gpuGet (uploaded18, 99999) ?: -1.0) == 4999950000.0), gpuSatisfies(gpuZipWith (xs, flipped, addF), \uploaded17 => gpuSatisfies(gpuFold(uploaded17, 0.0, addF), \uploaded126 => (uploaded126) == 0.0)),
                                        gpuSatisfies(gpuFilter(xs, isPositiveF), \uploaded16 => gpuLength (uploaded16) == 99999), toFloat 9007199254740992 == 9007199254740992.0, toFloat 9007199254740993 == toFloat 9007199254740992, toFloat 9007199254740991 < toFloat 9007199254740992, toFloat (-9007199254740992) == -9007199254740992.0
                                    ]
                                Error message => check ("GPU operation", "success", toString message)
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Make accumulation order observable: [GPU-FOLD] contracts the host backend to combine left-to-right, so a huge leading term absorbs every small one after it while the same terms reversed all survive — why the spec calls a non-associative combine backend-dependent. *)
floatOrderCase () = withIndices (1001, \indices1001 => withIndices (100000, \indices100000 => floatOrderWith (indices1001, indices100000)))
floatOrderWith (indices1001, indices100000) =
    handle Arith
        divideByZero op lhs =>
            checkAll "zero divisor payload" [
                op == "/", lhs == 1.0
            ]
            -1.0
    match gpuMap(indices1001, toFloat)
        Success xs =>
            match gpuMap(xs, headBig)
                Success leading =>
                    match gpuMap(xs, tailBig)
                        Success trailing =>
                            match gpuFold(leading, 0.0, addF)
                                Success absorbed =>
                                    match gpuFold(trailing, 0.0, addF)
                                        Success survived =>
                                            match gpuMap(indices100000, tenthOf)
                                                Success uploaded15 =>
                                                    match gpuFold(uploaded15, 0.0, addF)
                                                        Success tenths =>
                                                            checkAll "float accumulation order is observable" [
                                                                absorbed == hugeFloat (), survived == hugeFloat () + 1000.0, survived > absorbed, survived - absorbed == 1000.0, gpuSatisfies (toGpu ([hugeFloat (), 1.0, 1.0, 1.0]), \uploaded3 => gpuSatisfies(gpuFold(uploaded3, 0.0, addF), \uploaded9 => (uploaded9) == hugeFloat ())),
                                                                gpuSatisfies (toGpu ([1.0, 1.0, 1.0, hugeFloat ()]), \uploaded2 => gpuSatisfies(gpuFold(uploaded2, 0.0, addF), \uploaded8 => (uploaded8) > hugeFloat ())),
                                                                gpuSatisfies (toGpu ([1.0, 1.0, 1.0, hugeFloat ()]), \uploaded1 => gpuSatisfies(gpuFold(uploaded1, 0.0, addF), \uploaded7 => (uploaded7) - hugeFloat () == 4.0)), (gpuGet (leading, 0) ?: 0.0) == hugeFloat (), (gpuGet (leading, 1000) ?: 0.0) == 1.0,
                                                                (gpuGet (trailing, 1000) ?: 0.0) == hugeFloat (), gpuSatisfies(gpuScan(leading, 0.0, addF), \uploaded6 => (gpuGet (uploaded6, 1000) ?: 0.0) == hugeFloat ()), tenths > 10000.0, tenths < 10000.001, ((1.0 / 0.0) ) == -1.0
                                                            ]
                                                        Error message => check ("GPU operation", "success", toString message)
                                                Error message => check ("GPU operation", "success", toString message)
                                        Error message => check ("GPU operation", "success", toString message)
                                Error message => check ("GPU operation", "success", toString message)
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Run 400 float passes over the canonical [GPU-CONVERT] seed. *)
floatChurnCase () = withIndices (8, \indices8 => withIndices (0, \indices0 => floatChurnWith (indices8, indices0)))
floatChurnWith (indices8, indices0) =
    match gpuMap(indices8, toFloat)
        Success uploaded4 =>
            match mix (uploaded4, 400)
                Success mixed =>
                    match gpuFold(mixed, 0.0, addF)
                        Success total =>
                            checkAll "400-pass float churn" [
                                total > 1627.8, total < 1627.9, gpuLength mixed == 8, (gpuGet (mixed, 0) ?: 0.0) > 0.0, (gpuGet (mixed, 7) ?: 0.0) > (gpuGet (mixed, 0) ?: 0.0), gpuSatisfies(gpuFilter(mixed, isPositiveF), \uploaded3 => gpuLength (uploaded3) == 8),
                                gpuSatisfies(gpuMap(indices0, toFloat), \uploaded2 => gpuSatisfies(mix (uploaded2, 50), \uploaded2 => gpuLength (uploaded2) == 0)),
                                gpuSatisfies(gpuMap(indices8, toFloat), \uploaded1 => gpuSatisfies(mix (uploaded1, 0), \uploaded1 => gpuSatisfies(gpuFold(uploaded1, 0.0, addF), \uploaded124 => (uploaded124) == 28.0)))
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Exact-value tests record any arithmetic fault as a failed assertion. *)
test ("a million elements map, fold, filter and scan in one pipeline", exactly megaPipelineCase)
test ("a 100k prefix scan matches its closed form", exactly scanScaleCase)
test ("twenty-four dependent map passes stay exact", exactly longChainCase)
test ("a buffer rebuilt from its own output six times stays exact", exactly rebuildCase)
test ("half a million elements compact and compact again", exactly compactionScaleCase)
test ("quarter-million-element zips multiply, truncate and cancel", exactly zipScaleCase)
test ("five hundred simulation passes stay exact", exactly simulationCase)
test ("checked arithmetic marks the exact overflow boundary", exactly overflowBoundaryCase)
test ("a saturating accumulation freezes instead of wrapping", exactly saturationCase)
test ("negative buffers survive every combinator", exactly negativeCase)
test ("alternating signs telescope through fold, scan and filter", exactly alternatingCase)
test ("zero and empty buffers are defined everywhere", exactly zeroDegenerateCase)
test ("gathers report every out-of-range index as an error", exactly gatherBoundaryCase)
test ("float buffers keep their bits at scale", exactly floatScaleCase)
test ("float accumulation order changes the sum", exactly floatOrderCase)
test ("float churn keeps double words through 400 passes", exactly floatChurnCase)
