                                        gpuSatisfies(gpuFold(squares, 0, tally), \uploaded93 => (uploaded93) == 5208302083375000), gpuLength squares == 250000, (gpuGet (squares, 249999) ?: -1) == 62499500001, gpuLength ragged == 3, gpuSatisfies(gpuFold(ragged, 0, tally), \uploaded92 => (uploaded92) == 6),
