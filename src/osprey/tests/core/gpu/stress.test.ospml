test ("a million elements map, fold, filter and scan in one pipeline", \() => exactArithmetic (megaPipelineCase))
test ("a 100k prefix scan matches its closed form", \() => exactArithmetic (scanScaleCase))
test ("twenty-four dependent map passes stay exact", \() => exactArithmetic (longChainCase))
test ("a buffer rebuilt from its own output six times stays exact", \() => exactArithmetic (rebuildCase))
test ("half a million elements compact and compact again", \() => exactArithmetic (compactionScaleCase))
test ("quarter-million-element zips multiply, truncate and cancel", \() => exactArithmetic (zipScaleCase))
test ("five hundred simulation passes stay exact", \() => exactArithmetic (simulationCase))
test ("checked arithmetic marks the exact overflow boundary", \() => exactArithmetic (overflowBoundaryCase))
test ("a saturating accumulation freezes instead of wrapping", \() => exactArithmetic (saturationCase))
test ("negative buffers survive every combinator", \() => exactArithmetic (negativeCase))
test ("alternating signs telescope through fold, scan and filter", \() => exactArithmetic (alternatingCase))
test ("zero and empty buffers are defined everywhere", \() => exactArithmetic (zeroDegenerateCase))
test ("gathers report every out-of-range index as an error", \() => exactArithmetic (gatherBoundaryCase))
test ("float buffers keep their bits at scale", \() => exactArithmetic (floatScaleCase))
test ("float accumulation order changes the sum", \() => exactArithmetic (floatOrderCase))
test ("float churn keeps double words through 400 passes", \() => exactArithmetic (floatChurnCase))
