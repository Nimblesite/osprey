    elementsFrom (running, 0, (-1), [0, 1, 3]), elementIs (running, 99999, (-1), 4999950000), lengthIs (running, 100000), elementsAt (seeded, (-1), [0, 99999], [1000, 4999951000]), lengthIs (seeded, 100000), elementsAt (twice, (-1), [0, 2, 99999], [0, 4, 166666666650000]), gpuEquals(gpuFold(running, 0, minI), 0)
]))))
