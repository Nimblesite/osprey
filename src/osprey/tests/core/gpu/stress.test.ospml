(** [FAILURE-EXPLICIT] A checked stage preserves the first failure unchanged. *)
andThen (result, next) = match result
    Success value => next value
    Error message => Error(message = message)
(** [FAILURE-EXPLICIT] Allocation errors fail the case before its consumer runs. *)
withIndices (n, work) = match gpuIota n
    Success value => work value
    Error message => check "index allocation" "success" (toString message)
// GPU stress, scale and numeric-edge workloads: million-element pipelines,
// two-dozen-pass chains, buffers rebuilt from their own output, and the
// checked-arithmetic boundaries where a `?:` fallback is all that stands
// between a kernel and an overflow. Every expected value is closed-form, and
// every accumulation that can overflow asserts both sides of its boundary —
// the last value that fits and the first that does not ([GPU-BACKEND-HOST],
// [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-ZIPWITH], [GPU-GET],
// [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
(** overflowMark is the sentinel a checked-arithmetic fallback publishes: no kernel below produces it any other way, so reading it back proves the fallback fired. maxInt and minInt are the two's-complement edges these accumulations walk to; hugeFloat is where a double's ulp reaches 2.0. minInt counts down from -maxInt because this flavor rejects -2^63. *)
marked work =
    handle Arith
        overflow _ _ _ _ => overflowMark ()
    work ()
preserving work =
    handle Arith
        overflow _ lhs _ _ => lhs
    work ()
zeroReciprocal work =
    handle Arith
        divideByZero _ _ => 0.0
    work ()
overflowMark () = -999
maxInt () = 9223372036854775807
minInt () = ((0 - maxInt ()) ) - 1
hugeFloat () = 10000000000000000.0
(** The growth kernels and the shared associative reduction — on overflow tally keeps its accumulator, so a saturating fold freezes rather than wraps. bump and lower step an element up and down, so a long chain of them must cancel exactly, and negate, absI and altSign drive the signed buffers. *)
square x = (x * x)
product (a, b) = (a * b)
tally (a, x) = preserving (\() => a + x)
bump x = (x + 1)
lower x = (x - 1)
negate x = (0 - x)
absI x = match x < 0
    true => (0 - x)
    false => x
altSign x = match (x % 2 ) == 0
    true => x
    false => (0 - x)
(** negSat, lowerSat and sqSat are the boundary-probing twins of negate, lower and square: the same arithmetic, but the fallback publishes the mark. Then the compaction predicates, and minI, a running minimum for gpuScan. *)
negSat x = marked (\() => (0 - x))
lowerSat x = marked (\() => (x - 1))
sqSat x = marked (\() => (x * x))
isEven x = (x % 2 ) == 0
isQuad x = (x % 4 ) == 0
isNeg x = x < 0
isPos x = x > 0
isMax x = x == maxInt ()
minI (a, b) = match a < b
    true => a
    false => b
(** prodSat and doubleUp are sticky: once the mark reaches the accumulator it stays, so the fold reports the *first* overflow. addOr marks an overflowing sum, clampAdd saturates it, and hugeScale walks elements past the int edge one at a time. *)
prodSat (a, x) = match a == overflowMark ()
    true => overflowMark ()
    false => marked (\() => (a * x))
doubleUp (a, _x) = match a == overflowMark ()
    true => overflowMark ()
    false => marked (\() => (a * 2))
addOr (a, x) = marked (\() => (a + x))
clampAdd (a, x) = satAdd a x
hugeScale x = satMul x 100000000000000000
(** The float kernels. addF's signature is load-bearing: a context-free `a + x` int-defaults [GPU-KERNEL-ELEM-TYPING]. headBig and tailBig plant one enormous value at opposite ends of an otherwise all-ones buffer, so one fold absorbs every small term after it and the other does not. *)
addF (a, x) = a + x
half x = x * 0.5
negF x = 0.0 - x
recip x = zeroReciprocal (\() => 1.0 / x)
tenthOf _x = 0.1
isPositiveF x = x > 0.0
stir x = (x * 1.0001 + 0.5) * 0.9999
headBig x = match x == 0.0
    true => hugeFloat ()
    false => 1.0
tailBig x = match x == 1000.0
    true => hugeFloat ()
    false => 1.0
(** simulate and mix rerun a kernel over the whole buffer n times, while rebuild sends the buffer back to the host and in again every pass, so each round trip is a fresh dense copy of its own output. Every recursive pass retains the original allocation or readback Error. *)
simulate (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, bump)
        Success value => simulate(value, n - 1)
        Error message => Error(message = message)
mix (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, stir)
        Success value => mix(value, n - 1)
        Error message => Error(message = message)
rebuild (buf, n) = match n
    0 => Success(value = buf)
    _ => match gpuMap(buf, bump)
        Success value => match fromGpu value
            Success value => match toGpu value
                Success value => rebuild (value, n - 1)
                Error message => Error(message = message)
            Error message => Error(message = message)
        Error message => Error(message = message)
(** Run a million elements through map, fold, filter and scan. *)
megaPipelineCase () = withIndices (1000000, \idx => megaPipelineWith (idx))
megaPipelineWith (idx) =
    match gpuMap(idx, square)
        Success squares =>
            match gpuFilter(idx, isEven)
                Success evens =>
                    match gpuScan(idx, 0, tally)
                        Success running =>
                            checkAll "million-element pipeline" [
                                gpuSatisfies(gpuFold(squares, 0, tally), \uploaded120 => (uploaded120) == 333332833333500000), gpuSatisfies(gpuFold(idx, 0, tally), \uploaded119 => (uploaded119) == 499999500000), gpuLength idx == 1000000, gpuLength squares == 1000000, (gpuGet (idx, 0) ?: -1) == 0, (gpuGet (idx, 999999) ?: -1) == 999999,
                                (gpuGet (idx, 1000000) ?: -1) == -1, (gpuGet (squares, 999999) ?: -1) == 999998000001, gpuLength evens == 500000, gpuSatisfies(gpuFold(evens, 0, tally), \uploaded118 => (uploaded118) == 249999500000), (gpuGet (evens, 499999) ?: -1) == 999998, gpuLength running == 1000000, (gpuGet (running, 0) ?: -1) == 0,
                                (gpuGet (running, 1) ?: -1) == 1, (gpuGet (running, 999999) ?: -1) == 499999500000
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Read a 100k prefix sum, a seeded scan and a scan of a scan. *)
scanScaleCase () = withIndices (100000, \indices100000 => scanScaleWith (indices100000))
scanScaleWith (indices100000) =
    match gpuScan(indices100000, 0, tally)
        Success running =>
            match gpuScan(indices100000, 1000, tally)
                Success seeded =>
                    match gpuScan(running, 0, tally)
                        Success twice =>
                            checkAll "100k prefix scan" [
                                (gpuGet (running, 0) ?: -1) == 0, (gpuGet (running, 1) ?: -1) == 1, (gpuGet (running, 2) ?: -1) == 3, (gpuGet (running, 99999) ?: -1) == 4999950000, gpuLength running == 100000, (gpuGet (seeded, 0) ?: -1) == 1000, (gpuGet (seeded, 99999) ?: -1) == 4999951000, gpuLength seeded == 100000,
                                (gpuGet (twice, 0) ?: -1) == 0, (gpuGet (twice, 2) ?: -1) == 4, (gpuGet (twice, 99999) ?: -1) == 166666666650000, gpuSatisfies(gpuFold(running, 0, minI), \uploaded114 => (uploaded114) == 0)
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Run sixteen climbs then sixteen descents, back to back. *)
longChainCase () = withIndices (100000, \indices100000 => longChainWith (indices100000))
longChainWith (indices100000) =
    climbResult = (gpuMap(indices100000, bump) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump)) |> andThen(\buffer => gpuMap(buffer, bump))
        |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower))
        |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) )
    match climbResult
        Success climbed =>
            cancelResult = (gpuMap(climbed, lower) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower))
                |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) |> andThen(\buffer => gpuMap(buffer, lower)) )
            match cancelResult
                Success cancelled =>
                    checkAll "twenty-four chained passes" [
                        gpuLength climbed == 100000, (gpuGet (climbed, 0) ?: -1) == 8, (gpuGet (climbed, 99999) ?: -1) == 100007, gpuSatisfies(gpuFold(climbed, 0, tally), \uploaded111 => (uploaded111) == 5000750000), gpuLength cancelled == 100000, (gpuGet (cancelled, 0) ?: -1) == 0, (gpuGet (cancelled, 99999) ?: -1) == 99999,
                        gpuSatisfies(gpuFold(cancelled, 0, tally), \uploaded110 => (uploaded110) == 4999950000), gpuSatisfies(gpuFilter(cancelled, isEven), \uploaded109 => gpuSatisfies(gpuFold(uploaded109, 0, tally), \uploaded144 => (uploaded144) == 2499950000))
                    ]
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Rebuild a buffer from its own materialized output six times. *)
rebuildCase () = withIndices (20000, \indices20000 => withIndices (0, \indices0 => withIndices (1, \indices1 => rebuildWith (indices20000, indices0, indices1))))
rebuildWith (indices20000, indices0, indices1) =
    match rebuild (indices20000, 6)
        Success read0 =>
            settled = read0
            match fromGpu (settled)
                Success back =>
                    match toGpu (back)
                        Success again =>
                            checkAll "six host round trips" [
                                gpuLength settled == 20000, (gpuGet (settled, 0) ?: -1) == 6, (gpuGet (settled, 19999) ?: -1) == 20005, gpuSatisfies(gpuFold(settled, 0, tally), \uploaded108 => (uploaded108) == 200110000), listLength back == 20000, (listGet (back, 0) ?: -1) == 6, (listGet (back, 19999) ?: -1) == 20005,
                                gpuLength again == 20000, gpuSatisfies(gpuFold(again, 0, tally), \uploaded107 => (uploaded107) == 200110000), gpuSatisfies(gpuFilter(again, isEven), \uploaded106 => gpuSatisfies(gpuFold(uploaded106, 0, tally), \uploaded143 => (uploaded143) == 100050000)),
                                gpuSatisfies (rebuild (indices0, 4), \checked0 => gpuLength (checked0) == 0), gpuSatisfies (rebuild (indices1, 3), \checked0 => gpuSatisfies(gpuFold(checked0, 0, tally), \uploaded105 => (uploaded105) == 3))
                            ]
                        Error message => check ("GPU operation", "success", toString message)
                Error message => check ("GPU operation", "success", toString message)
        Error message => check ("GPU operation", "success", toString message)
(** Compact 500k elements and then compact that result. *)
