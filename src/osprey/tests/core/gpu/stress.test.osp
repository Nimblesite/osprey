/// repeatStep applies the checked one-buffer GPU step `step` to `buf` `times` times, retaining the first failure.
fn repeatStep(buf, times, step) = match times {
    0 => Success { value: buf }
    _ => andThen(step(buf), fn(next) => repeatStep(next, times - 1, step))
