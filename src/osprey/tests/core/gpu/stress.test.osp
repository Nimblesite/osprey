/// uploadAddOrIs folds the upload of `values` with addOr to `expected`, so an overflow shows as the mark.
fn uploadAddOrIs(values, expected) = gpuSatisfies(toGpu(values), fn(uploaded) => gpuSatisfies(gpuFold(uploaded, 0, addOr), fn(total) => total == expected))
