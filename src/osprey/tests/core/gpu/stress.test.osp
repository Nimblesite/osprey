/// [FAILURE-EXPLICIT] A checked stage preserves the first failure unchanged.
fn andThen(result, next) = match result {
    Success { value } => next(value)
    Error { message } => Error { message: message }
}
// GPU stress, scale and numeric-edge workloads: million-element pipelines, two-dozen-pass chains, buffers rebuilt from their own output, and the checked-arithmetic
// boundaries where a `?:` fallback is all that stands between a kernel and an overflow. Every expected value is closed-form, and every accumulation that can overflow
// asserts both sides of its boundary — the last value that fits and the first that does not ([GPU-BACKEND-HOST], [GPU-FOLD], [GPU-SCAN], [GPU-FILTER], [GPU-ZIPWITH],
// [GPU-GET], [GPU-CONVERT] — docs/specs/runtime/0034-GPUComputation.md).
/// overflowMark is the sentinel a checked-arithmetic fallback publishes: no kernel below produces it any other way, so reading it back proves the fallback fired rather
/// than the arithmetic wrapping. maxInt and minInt are the two's-complement edges these accumulations walk to; hugeFloat is where a double's ulp reaches 2.0, so adding 1.0
/// to it is a no-op. minInt counts down from -maxInt because the ML flavor rejects the literal -2^63.
fn marked(work) = {
    handle Arith { overflow _ _ _ _ => overflowMark() }
    work()
}
fn preserving(work) = {
    handle Arith { overflow _ lhs _ _ => lhs }
    work()
}
fn zeroReciprocal(work) = {
    handle Arith { divideByZero _ _ => 0.0 }
    work()
}
fn overflowMark() = -999
fn maxInt() = 9223372036854775807
fn minInt() = ((0 - maxInt()) ) - 1
fn hugeFloat() = 10000000000000000.0
/// The growth kernels and the shared associative reduction — on overflow tally keeps its accumulator, so a saturating fold freezes rather than wraps. bump and lower step
/// an element up and down, so a long chain of them must cancel exactly, and negate, absI and altSign drive the signed buffers.
fn square(x) = (x * x)
fn product(a, b) = (a * b)
fn tally(a, x) = preserving(fn() => a + x)
fn bump(x) = (x + 1)
fn lower(x) = (x - 1)
fn negate(x) = (0 - x)
fn absI(x) = match x < 0 { true => (0 - x) false => x }
fn altSign(x) = match (x % 2 ) == 0 { true => x false => (0 - x) }
/// negSat, lowerSat and sqSat are the boundary-probing twins of negate, lower and square: the same arithmetic, but the fallback publishes the mark rather than a plausible
/// value. Then the compaction predicates — parity, divisibility, sign, saturation — and minI, a running minimum for gpuScan.
fn negSat(x) = marked(fn() => (0 - x))
fn lowerSat(x) = marked(fn() => (x - 1))
fn sqSat(x) = marked(fn() => (x * x))
fn isEven(x) = (x % 2 ) == 0
fn isQuad(x) = (x % 4 ) == 0
fn isNeg(x) = x < 0
fn isPos(x) = x > 0
fn isMax(x) = x == maxInt()
fn minI(a, b) = match a < b { true => a false => b }
/// prodSat and doubleUp are sticky: once the mark reaches the accumulator it stays, so the fold reports the *first* overflow rather than a later product of the sentinel.
/// addOr marks an overflowing sum, clampAdd saturates it, and hugeScale walks elements past the int edge one at a time.
fn prodSat(a, x) = match a == overflowMark() {
    true => overflowMark()
    false => marked(fn() => (a * x))
}
fn doubleUp(a, _x) = match a == overflowMark() {
    true => overflowMark()
    false => marked(fn() => (a * 2))
}
fn addOr(a, x) = marked(fn() => (a + x))
fn clampAdd(a, x) = satAdd(a, x)
fn hugeScale(x) = satMul(x, 100000000000000000)
/// The float kernels: reduction, scaling, negation, a checked reciprocal whose fallback fires on zero, a constant tenth that also widens int to float, a positivity
/// predicate, and a mixer with several ops per element. headBig and tailBig plant one enormous value at opposite ends of an otherwise all-ones buffer, so one fold absorbs
/// every small term after it and the other does not.
fn addF(a, x) = a + x
fn half(x) = x * 0.5
fn negF(x) = 0.0 - x
fn recip(x) = zeroReciprocal(fn() => 1.0 / x)
fn tenthOf(_x) = 0.1
fn isPositiveF(x) = x > 0.0
fn stir(x) = (x * 1.0001 + 0.5) * 0.9999
fn headBig(x) = match x == 0.0 { true => hugeFloat() false => 1.0 }
fn tailBig(x) = match x == 1000.0 { true => hugeFloat() false => 1.0 }
/// simulate and mix rerun a kernel over the whole buffer n times — the allocation churn a profiler should see — while rebuild sends the buffer back to the host and in
/// again every pass, so each round trip is a fresh dense copy of its own output. Every recursive pass retains the original allocation or readback Error.
fn simulate(buf, n) = match n {
    0 => Success { value: buf }
    _ => match gpuMap(buf, bump) {
        Success { value } => simulate(value, n - 1)
        Error { message } => Error { message: message }
    }
}
fn mix(buf, n) = match n {
    0 => Success { value: buf }
    _ => match gpuMap(buf, stir) {
        Success { value } => mix(value, n - 1)
        Error { message } => Error { message: message }
    }
}
fn rebuild(buf, n) = match n {
    0 => Success { value: buf }
    _ => match gpuMap(buf, bump) {
        Success { value } => match fromGpu(value) {
            Success { value } => match toGpu(value) {
                Success { value } => rebuild(value, n - 1)
                Error { message } => Error { message: message }
            }
            Error { message } => Error { message: message }
        }
        Error { message } => Error { message: message }
    }
}
/// megaPipelineCase runs a million elements through map, fold, filter and scan.
fn megaPipelineCase() = withIndices(1000000, fn(idx) => megaPipelineWith(idx))
fn megaPipelineWith(idx) = {
    withBuffer(gpuMap(idx, square), fn(squares) => {
            withBuffer(gpuFilter(idx, isEven), fn(evens) => {
                    withBuffer(gpuScan(idx, 0, tally), fn(running) => {
                            checkAll("million-element pipeline", [
                                    gpuSatisfies(gpuFold(squares, 0, tally), fn(uploaded120) => (uploaded120) == 333332833333500000), gpuSatisfies(gpuFold(idx, 0, tally), fn(uploaded119) => (uploaded119) == 499999500000),
                                    structuralEquals([gpuLength(idx), gpuLength(squares)], [1000000, 1000000]),
                                    (gpuGet(idx, 0) ?: -1) == 0,
                                    (gpuGet(idx, 999999) ?: -1) == 999999,
                                    (gpuGet(squares, 999999) ?: -1) == 999998000001,
                                    gpuLength(evens) == 500000,
                                    (gpuGet(evens, 499999) ?: -1) == 999998,
                                    gpuLength(running) == 1000000,
                                    (gpuGet(running, 0) ?: -1) == 0,
                                    (gpuGet(running, 1) ?: -1) == 1,
                                    (gpuGet(running, 999999) ?: -1) == 499999500000,
                                    (gpuGet(idx, 1000000) ?: -1) == -1, gpuSatisfies(gpuFold(evens, 0, tally), fn(uploaded118) => (uploaded118) == 249999500000)
                            ])
                        })
                })
        })
}
/// scanScaleCase reads a 100k prefix sum, a seeded scan and a scan of a scan.
fn scanScaleCase() = withIndices(100000, fn(indices100000) => scanScaleWith(indices100000))
fn scanScaleWith(indices100000) = {
    withBuffer(gpuScan(indices100000, 0, tally), fn(running) => {
            withBuffer(gpuScan(indices100000, 1000, tally), fn(seeded) => {
                    withBuffer(gpuScan(running, 0, tally), fn(twice) => {
                            checkAll("100k prefix scan", [
                                    structuralEquals([(gpuGet(running, 0) ?: -1), (gpuGet(running, 1) ?: -1)], [0, 1]),
                                    (gpuGet(running, 2) ?: -1) == 3,
                                    (gpuGet(running, 99999) ?: -1) == 4999950000,
                                    gpuLength(running) == 100000,
                                    (gpuGet(seeded, 0) ?: -1) == 1000,
                                    (gpuGet(seeded, 99999) ?: -1) == 4999951000,
                                    gpuLength(seeded) == 100000,
                                    (gpuGet(twice, 0) ?: -1) == 0,
                                    (gpuGet(twice, 2) ?: -1) == 4,
                                    (gpuGet(twice, 99999) ?: -1) == 166666666650000,
                                    gpuSatisfies(gpuFold(running, 0, minI), fn(uploaded114) => (uploaded114) == 0)
                            ])
                        })
                })
        })
}
/// longChainCase runs sixteen climbs then sixteen descents, back to back.
fn longChainCase() = withIndices(100000, fn(indices100000) => longChainWith(indices100000))
fn longChainWith(indices100000) = {
    let climbResult = gpuMap(indices100000, bump) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump))
    |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump))
    |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump))
    |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump)) |> andThen(fn(buffer) => gpuMap(buffer, bump))
    |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower))
    |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower))
    withBuffer(climbResult, fn(climbed) => {
        let cancelResult = gpuMap(climbed, lower) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower))
        |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower)) |> andThen(fn(buffer) => gpuMap(buffer, lower))
        withBuffer(cancelResult, fn(cancelled) => {
                checkAll("twenty-four chained passes", [
                        structuralEquals([gpuLength(climbed), (gpuGet(climbed, 0) ?: -1)], [100000, 8]),
                        structuralEquals([(gpuGet(climbed, 99999) ?: -1), gpuLength(cancelled)], [100007, 100000]),
                        (gpuGet(cancelled, 0) ?: -1) == 0,
                        (gpuGet(cancelled, 99999) ?: -1) == 99999,
                        gpuSatisfies(gpuFold(climbed, 0, tally), fn(uploaded111) => (uploaded111) == 5000750000),
                        gpuSatisfies(gpuFold(cancelled, 0, tally), fn(uploaded110) => (uploaded110) == 4999950000), gpuSatisfies(gpuFilter(cancelled, isEven), fn(uploaded109) => gpuSatisfies(gpuFold(uploaded109, 0, tally), fn(uploaded144) => (uploaded144) == 2499950000))
                ])
            })
    })
}

/// rebuildCase rebuilds a buffer from its own materialized output six times.
fn rebuildCase() = withIndices(20000, fn(indices20000) => withIndices(0, fn(indices0) => withIndices(1, fn(indices1) => rebuildWith(indices20000, indices0, indices1))))
fn rebuildWith(indices20000, indices0, indices1) = {
    withBuffer(rebuild(indices20000, 6), fn(settled) => {
            withBuffer(fromGpu(settled), fn(back) => {
                    withBuffer(toGpu(back), fn(again) => {
                            checkAll("six host round trips", [
                                    structuralEquals([gpuLength(settled), (gpuGet(settled, 0) ?: -1)], [20000, 6]),
                                    (gpuGet(settled, 19999) ?: -1) == 20005,
                                    listLength(back) == 20000,
                                    (listGet(back, 0) ?: -1) == 6,
                                    (listGet(back, 19999) ?: -1) == 20005,
                                    gpuLength(again) == 20000,
                                    gpuSatisfies(gpuFold(settled, 0, tally), fn(uploaded108) => (uploaded108) == 200110000),
                                    gpuSatisfies(gpuFold(again, 0, tally), fn(uploaded107) => (uploaded107) == 200110000), gpuSatisfies(gpuFilter(again, isEven), fn(uploaded106) => gpuSatisfies(gpuFold(uploaded106, 0, tally), fn(uploaded143) => (uploaded143) == 100050000)),
                                    gpuSatisfies(rebuild(indices0, 4), fn(checked0) => gpuLength(checked0) == 0), gpuSatisfies(rebuild(indices1, 3), fn(checked0) => gpuSatisfies(gpuFold(checked0, 0, tally), fn(uploaded105) => (uploaded105) == 3))
                            ])
                        })
                })
        })
}
/// compactionScaleCase compacts 500k elements and then compacts that result.
fn compactionScaleCase() = withIndices(500000, fn(src) => compactionScaleWith(src))
fn compactionScaleWith(src) = {
    withBuffer(gpuFilter(src, isEven), fn(evens) => {
            withBuffer(gpuFilter(evens, isQuad), fn(quads) => {
                    checkAll("500k compaction", [
                            structuralEquals([gpuLength(evens), (gpuGet(evens, 0) ?: -1)], [250000, 0]),
                            structuralEquals([(gpuGet(evens, 249999) ?: -1), gpuLength(quads)], [499998, 125000]),
                            (gpuGet(quads, 124999) ?: -1) == 499996,
                            gpuSatisfies(gpuFold(evens, 0, tally), fn(uploaded102) => (uploaded102) == 62499750000), (gpuGet(evens, 250000) ?: -1) == -1,
                            gpuSatisfies(gpuFold(quads, 0, tally), fn(uploaded101) => (uploaded101) == 31249750000), gpuSatisfies(gpuFilter(src, isNeg), fn(uploaded100) => gpuLength(uploaded100) == 0), gpuSatisfies(gpuFilter(src, isPos), fn(uploaded99) => gpuLength(uploaded99) == 499999),
                            gpuSatisfies(gpuFilter(src, isPos), fn(uploaded98) => gpuSatisfies(gpuFold(uploaded98, 0, tally), fn(uploaded142) => (uploaded142) == 124999750000)), gpuSatisfies(gpuFilter(src, isPos), fn(uploaded97) => gpuSatisfies(gpuFilter(uploaded97, isNeg), fn(uploaded141) => gpuLength(uploaded141) == 0))
                    ])
                })
        })
}
/// zipScaleCase multiplies 250k buffers, truncates ragged pairs and cancels.
fn zipScaleCase() = withIndices(250000, fn(idx) => withIndices(1000000, fn(indices1000000) => withIndices(3, fn(indices3) => withIndices(0, fn(indices0) => zipScaleWith(idx, indices1000000, indices3, indices0)))))
fn zipScaleWith(idx, indices1000000, indices3, indices0) = {
    withBuffer(gpuZipWith(idx, idx, product), fn(squares) => {
            withBuffer(gpuZipWith(indices1000000, indices3, tally), fn(ragged) => {
                    withBuffer(gpuMap(idx, negate), fn(uploaded96) => {
                            withBuffer(gpuZipWith(idx,uploaded96, tally), fn(cancel) => {
                                    checkAll("250k zip", [
                                            gpuSatisfies(gpuFold(squares, 0, tally), fn(uploaded93) => (uploaded93) == 5208302083375000),
                                            gpuLength(squares) == 250000,
                                            (gpuGet(squares, 249999) ?: -1) == 62499500001,
                                            gpuLength(ragged) == 3,
                                            gpuLength(cancel) == 250000,
                                            (gpuGet(cancel, 249999) ?: -1) == 0,
                                            gpuSatisfies(gpuFold(ragged, 0, tally), fn(uploaded92) => (uploaded92) == 6),
                                            gpuSatisfies(gpuZipWith(indices3, indices1000000, tally), fn(uploaded91) => gpuLength(uploaded91) == 3), gpuSatisfies(gpuZipWith(idx, indices0, tally), fn(uploaded90) => gpuLength(uploaded90) == 0),
                                            gpuSatisfies(gpuFold(cancel, 0, tally), fn(uploaded89) => (uploaded89) == 0)
                                    ])
                                })
                        })
                })
        })
}
/// simulationCase runs 500 whole-buffer passes over 10k elements, then splits the pass count in half without changing the answer.
fn simulationCase() = withIndices(10000, fn(indices10000) => withIndices(0, fn(indices0) => withIndices(1, fn(indices1) => simulationWith(indices10000, indices0, indices1))))
fn simulationWith(indices10000, indices0, indices1) = {
    withBuffer(simulate(indices10000, 500), fn(settled) => {
            withBuffer(simulate(indices10000, 250), fn(uploaded7) => {
                    withBuffer(simulate(uploaded7, 250), fn(staged) => {
                            checkAll("500-pass simulation", [
                                    gpuSatisfies(gpuFold(settled, 0, tally), fn(uploaded88) => (uploaded88) == 54995000),
                                    structuralEquals([gpuLength(settled), (gpuGet(settled, 0) ?: -1)], [10000, 500]),
                                    (gpuGet(settled, 9999) ?: -1) == 10499,
                                    (gpuGet(staged, 9999) ?: -1) == 10499,
                                    gpuSatisfies(gpuFold(staged, 0, tally), fn(uploaded87) => (uploaded87) == 54995000),
                                    gpuSatisfies(simulate(indices0, 100), fn(uploaded5) => gpuLength(uploaded5) == 0), gpuSatisfies(simulate(indices1, 7), fn(uploaded4) => gpuSatisfies(gpuFold(uploaded4, 0, tally), fn(uploaded86) => (uploaded86) == 7))
                            ])
                        })
                })
        })
}
/// overflowBoundaryCase walks each checked operator to the int edge and one step past: 20! fits and 21! does not, 2^62 fits and 2^63 does not, 3037000499 squares and its
/// successor does not, and minInt cannot negate.
fn overflowBoundaryCase() = withIndices(20, fn(indices20) => withIndices(21, fn(indices21) => withIndices(62, fn(indices62) => withIndices(63, fn(indices63) => overflowBoundaryWith(indices20, indices21, indices62, indices63)))))
fn overflowBoundaryWith(indices20, indices21, indices62, indices63) = {
    withBuffer(gpuMap(indices20, bump), fn(uploaded84) => {
            withBuffer(gpuFold(uploaded84, 1, prodSat), fn(fits) => {
                    withBuffer(gpuMap(indices21, bump), fn(uploaded85) => {
                            withBuffer(gpuFold(uploaded85, 1, prodSat), fn(spills) => {
                                    withBuffer(toGpu([3037000499, 3037000500]), fn(value) => {withBuffer(gpuMap(value, sqSat), fn(roots) => {
                                                    withBuffer(toGpu([minInt(), -1, 0, 1, maxInt()]), fn(value) => {withBuffer(gpuMap(value, negSat), fn(edges) => {
                                                                    checkAll("checked overflow boundaries", [
                                                                            fits == 2432902008176640000,
                                                                            (gpuGet(roots, 0) ?: 0) == 9223372030926249001,
                                                                            (gpuGet(edges, 1) ?: 0) == 1,
                                                                            (gpuGet(edges, 2) ?: 0) == 0,
                                                                            spills == overflowMark(), gpuSatisfies(gpuFold(indices62, 1, doubleUp), fn(uploaded81) => (uploaded81) == 4611686018427387904), gpuSatisfies(gpuFold(indices63, 1, doubleUp), fn(uploaded80) => (uploaded80) == overflowMark()),
                                                                            (gpuGet(roots, 1) ?: 0) == overflowMark(), (gpuGet(edges, 0) ?: 0) == overflowMark(), (gpuGet(edges, 3) ?: 0) == -1,
                                                                            (gpuGet(edges, 4) ?: 0) == -9223372036854775807, gpuSatisfies(toGpu([maxInt()]), fn(uploaded10) => gpuSatisfies(gpuFold(uploaded10, 0, addOr), fn(uploaded79) => (uploaded79) == maxInt())),
                                                                            gpuSatisfies(toGpu([maxInt(), 1]), fn(uploaded9) => gpuSatisfies(gpuFold(uploaded9, 0, addOr), fn(uploaded78) => (uploaded78) == overflowMark())),
                                                                            gpuSatisfies(toGpu([maxInt(), 1]), fn(uploaded8) => gpuSatisfies(gpuFold(uploaded8, 0, tally), fn(uploaded77) => (uploaded77) == maxInt())),
                                                                            gpuSatisfies(toGpu([minInt()]), fn(uploaded7) => gpuSatisfies(gpuMap(uploaded7, lowerSat), fn(uploaded76) => gpuSatisfies(gpuFold(uploaded76, 0, addOr), fn(uploaded137) => (uploaded137) == overflowMark()))),
                                                                            gpuSatisfies(toGpu([maxInt(), 1]), fn(uploaded6) => gpuSatisfies(gpuFilter(uploaded6, isMax), fn(uploaded75) => gpuLength(uploaded75) == 1))
                                                                    ])
                                                                })
                                                        })
                                                })
                                        })
                                })
                        })
                })
        })
}
/// saturationCase crosses the int edge part way through two thousand elements.
fn saturationCase() = withIndices(2000, fn(indices2000) => saturationWith(indices2000))
fn saturationWith(indices2000) = {
    withBuffer(gpuMap(indices2000, hugeScale), fn(bigs) => {
            withBuffer(gpuFilter(bigs, isMax), fn(saturated) => {
                    checkAll("saturating accumulation", [
                            structuralEquals([gpuLength(bigs), (gpuGet(bigs, 0) ?: -1)], [2000, 0]),
                            (gpuGet(bigs, 92) ?: -1) == 9200000000000000000,
                            gpuLength(saturated) == 1907,
                            (gpuGet(bigs, 93) ?: -1) == maxInt(), (gpuGet(bigs, 1999) ?: -1) == maxInt(), (gpuGet(saturated, 0) ?: -1) == maxInt(),
                            gpuSatisfies(gpuFold(bigs, 0, clampAdd), fn(uploaded72) => (uploaded72) == maxInt()), gpuSatisfies(gpuFold(bigs, 0, tally), fn(uploaded71) => (uploaded71) == 9100000000000000000), gpuSatisfies(gpuFilter(bigs, isNeg), fn(uploaded70) => gpuLength(uploaded70) == 0),
                            gpuSatisfies(gpuMap(bigs, isMax), fn(uploaded69) => gpuLength(uploaded69) == 2000)
                    ])
                })
        })
}
/// negativeCase carries a wholly negative buffer through every combinator.
fn negativeCase() = withIndices(100000, fn(indices100000) => negativeWith(indices100000))
fn negativeWith(indices100000) = {
    withBuffer(gpuMap(indices100000, negate), fn(negs) => {
            withBuffer(gpuMap(negs, negate), fn(restored) => {
                    withBuffer(gpuScan(negs, 0, tally), fn(running) => {
                            withBuffer(gpuScan(negs, 0, minI), fn(lows) => {
                                    checkAll("negative values at scale", [
                                            gpuSatisfies(gpuFold(negs, 0, tally), fn(uploaded64) => (uploaded64) == -4999950000),
                                            structuralEquals([gpuLength(negs), (gpuGet(negs, 0) ?: 1)], [100000, 0]),
                                            (gpuGet(restored, 99999) ?: -1) == 99999,
                                            (gpuGet(lows, 0) ?: 1) == 0,
                                            (gpuGet(negs, 99999) ?: 1) == -99999, gpuSatisfies(gpuFilter(negs, isNeg), fn(uploaded63) => gpuLength(uploaded63) == 99999),
                                            gpuSatisfies(gpuFilter(negs, isPos), fn(uploaded62) => gpuLength(uploaded62) == 0), gpuSatisfies(gpuFilter(negs, isEven), fn(uploaded61) => gpuLength(uploaded61) == 50000),
                                            gpuSatisfies(gpuFilter(negs, isEven), fn(uploaded60) => gpuSatisfies(gpuFold(uploaded60, 0, tally), fn(uploaded136) => (uploaded136) == -2499950000)), gpuSatisfies(gpuFold(restored, 0, tally), fn(uploaded59) => (uploaded59) == 4999950000),
                                            (gpuGet(running, 1) ?: 1) == -1, (gpuGet(running, 99999) ?: 1) == -4999950000, (gpuGet(lows, 99999) ?: 1) == -99999, gpuSatisfies(gpuZipWith(negs, indices100000, tally), fn(uploaded58) => gpuSatisfies(gpuFold(uploaded58, 0, tally), fn(uploaded135) => (uploaded135) == 0)),
                                            gpuSatisfies(gpuMap(negs, absI), fn(uploaded57) => gpuSatisfies(gpuFold(uploaded57, 0, tally), fn(uploaded134) => (uploaded134) == 4999950000))
                                    ])
                                })
                        })
                })
        })
}
/// alternatingCase flips sign on every other element of a 200k buffer: the fold telescopes, the scan oscillates, squaring erases the signs.
fn alternatingCase() = withIndices(200000, fn(indices200000) => alternatingWith(indices200000))
fn alternatingWith(indices200000) = {
    withBuffer(gpuMap(indices200000, altSign), fn(alt) => {
            withBuffer(gpuScan(alt, 0, tally), fn(running) => {
                    checkAll("alternating signs", [
                            gpuSatisfies(gpuFold(alt, 0, tally), fn(uploaded54) => (uploaded54) == -100000),
                            structuralEquals([gpuLength(alt), (gpuGet(alt, 0) ?: 1)], [200000, 0]),
                            structuralEquals([(gpuGet(alt, 2) ?: 0), (gpuGet(running, 0) ?: 1)], [2, 0]),
                            (gpuGet(running, 2) ?: 0) == 1,
                            (gpuGet(alt, 1) ?: 0) == -1, (gpuGet(alt, 199999) ?: 0) == -199999, (gpuGet(running, 1) ?: 0) == -1,
                            (gpuGet(running, 3) ?: 0) == -2, (gpuGet(running, 199999) ?: 0) == -100000, gpuSatisfies(gpuFilter(alt, isNeg), fn(uploaded53) => gpuLength(uploaded53) == 100000),
                            gpuSatisfies(gpuFilter(alt, isNeg), fn(uploaded52) => gpuSatisfies(gpuFold(uploaded52, 0, tally), fn(uploaded133) => (uploaded133) == -10000000000)), gpuSatisfies(gpuFilter(alt, isPos), fn(uploaded51) => gpuLength(uploaded51) == 99999),
                            gpuSatisfies(gpuFilter(alt, isPos), fn(uploaded50) => gpuSatisfies(gpuFold(uploaded50, 0, tally), fn(uploaded132) => (uploaded132) == 9999900000)), gpuSatisfies(gpuMap(alt, absI), fn(uploaded49) => gpuSatisfies(gpuFold(uploaded49, 0, tally), fn(uploaded131) => (uploaded131) == 19999900000)),
                            gpuSatisfies(gpuMap(alt, square), fn(uploaded48) => gpuSatisfies(gpuFold(uploaded48, 0, tally), fn(uploaded130) => (uploaded130) == 2666646666700000)), gpuSatisfies(gpuZipWith(alt, alt, product), fn(uploaded47) => gpuSatisfies(gpuFold(uploaded47, 0, tally), fn(uploaded129) => (uploaded129) == 2666646666700000))
                    ])
                })
        })
}
/// zeroDegenerateCase pins the empty buffer, the inverted extent and all-zeros.
fn zeroDegenerateCase() = withIndices(0, fn(empty) => withIndices(50000, fn(indices50000) => withIndices(1000000, fn(indices1000000) => zeroDegenerateWith(empty, indices50000, indices1000000))))
fn zeroDegenerateWith(empty, indices50000, indices1000000) = {
    let inverted = iotaError(-1000000)
    withBuffer(gpuMap(indices50000, fn(_x) => 0), fn(zeros) => {
            checkAll("zero and empty at every combinator", [
                    structuralEquals([gpuLength(empty), gpuLength(zeros), (gpuGet(zeros, 49999) ?: -1)], [0, 50000, 0]),
                    inverted == "gpu: buffer allocation: a negative element count",
                    iotaError(-7) == "gpu: buffer allocation: a negative element count",
                    gpuSatisfies(toGpu([]), fn(uploaded5: GpuBuffer<int>) => gpuLength(uploaded5) == 0), gpuSatisfies(gpuFold(empty, 42, tally), fn(uploaded45) => (uploaded45) == 42),
                    gpuSatisfies(gpuMap(empty, bump), fn(uploaded44) => gpuLength(uploaded44) == 0), gpuSatisfies(gpuFilter(empty, isEven), fn(uploaded43) => gpuLength(uploaded43) == 0), gpuSatisfies(gpuScan(empty, 0, tally), fn(uploaded42) => gpuLength(uploaded42) == 0),
                    gpuSatisfies(gpuZipWith(empty, indices1000000, tally), fn(uploaded41) => gpuLength(uploaded41) == 0), gpuSatisfies(gpuZipWith(indices1000000, empty, tally), fn(uploaded40) => gpuLength(uploaded40) == 0), (gpuGet(empty, 0) ?: -1) == -1, gpuSatisfies(fromGpu(empty), fn(checked0) => listLength(checked0) == 0),
                    gpuSatisfies(fromGpu(empty), fn(checked0) => gpuSatisfies(toGpu(checked0), fn(uploaded4) => gpuLength(uploaded4) == 0)), gpuSatisfies(gpuFold(zeros, 0, tally), fn(uploaded39) => (uploaded39) == 0),
                    gpuSatisfies(gpuFilter(zeros, isEven), fn(uploaded38) => gpuLength(uploaded38) == 50000), gpuSatisfies(gpuFilter(zeros, isPos), fn(uploaded37) => gpuLength(uploaded37) == 0), gpuSatisfies(gpuScan(zeros, 0, tally), fn(uploaded36) => (gpuGet(uploaded36, 49999) ?: -1) == 0),
                    gpuSatisfies(gpuZipWith(zeros, indices50000, product), fn(uploaded35) => gpuSatisfies(gpuFold(uploaded35, 0, tally), fn(uploaded128) => (uploaded128) == 0)), gpuSatisfies(gpuMap(zeros, square), fn(uploaded34) => gpuSatisfies(gpuFold(uploaded34, 0, tally), fn(uploaded127) => (uploaded127) == 0))
            ])
        })
}
/// gatherBoundaryCase reads one ahead, one behind and straight across a 100k buffer from inside kernels: each shift falls off exactly one end, and an out-of-range index is a visible Error rather than a silent zero.
fn gatherBoundaryCase() = withIndices(100000, fn(src) => gatherBoundaryWith(src))
fn gatherBoundaryWith(src) = {
    withBuffer(gpuMap(src, fn(i) => gpuGet(src, (i + 1) ) ?: -7), fn(ahead) => {
            withBuffer(gpuMap(src, fn(i) => gpuGet(src, (i - 1) ) ?: -7), fn(behind) => {
                    withBuffer(gpuMap(src, fn(i) => gpuGet(src, (99999 - i) ) ?: -7), fn(mirror) => {
                            checkAll("gathers at the buffer edges", [
                                    (gpuGet(ahead, 0) ?: 0) == 1,
                                    (gpuGet(ahead, 99998) ?: 0) == 99999,
                                    (gpuGet(behind, 1) ?: 0) == 0,
                                    (gpuGet(behind, 99999) ?: 0) == 99998,
                                    (gpuGet(mirror, 0) ?: 0) == 99999,
                                    (gpuGet(mirror, 99999) ?: 0) == 0,
                                    (gpuGet(src, 99999) ?: -1) == 99999,
                                    (gpuGet(ahead, 99999) ?: 0) == -7, gpuSatisfies(gpuFold(ahead, 0, tally), fn(uploaded30) => (uploaded30) == 4999949993), (gpuGet(behind, 0) ?: 0) == -7,
                                    gpuSatisfies(gpuFold(behind, 0, tally), fn(uploaded29) => (uploaded29) == 4999849994), gpuSatisfies(gpuFold(mirror, 0, tally), fn(uploaded28) => (uploaded28) == 4999950000),
                                    gpuSatisfies(gpuFilter(ahead, isNeg), fn(uploaded27) => gpuLength(uploaded27) == 1), gpuSatisfies(gpuFilter(behind, isNeg), fn(uploaded26) => gpuLength(uploaded26) == 1), (gpuGet(src, 100000) ?: -1) == -1, (gpuGet(src, 1000000) ?: -1) == -1, (gpuGet(src, -1) ?: -1) == -1,
                                    (gpuGet(src, minInt()) ?: -1) == -1, (gpuGet(src, maxInt()) ?: -1) == -1
                            ])
                        })
                })
        })
}
/// floatScaleCase widens a 100k index buffer through the float combinators.
fn floatScaleCase() = withIndices(100000, fn(indices100000) => floatScaleWith(indices100000))
fn floatScaleWith(indices100000) = {
    withBuffer(gpuMap(indices100000, toFloat), fn(xs) => {
            withBuffer(gpuMap(xs, half), fn(halves) => {
                    withBuffer(gpuMap(xs, negF), fn(flipped) => {
                            withBuffer(gpuMap(xs, recip), fn(recips) => {
                                    checkAll("float buffers at scale", [
                                            gpuSatisfies(gpuFold(xs, 0.0, addF), fn(uploaded21) => (uploaded21) == 4999950000.0), gpuLength(xs) == 100000,
                                            (gpuGet(xs, 0) ?: -1.0) == 0.0,
                                            (gpuGet(xs, 99999) ?: -1.0) == 99999.0,
                                            (gpuGet(halves, 3) ?: -1.0) == 1.5,
                                            (gpuGet(recips, 0) ?: -1.0) == 0.0,
                                            (gpuGet(recips, 1) ?: -1.0) == 1.0,
                                            (gpuGet(recips, 4) ?: -1.0) == 0.25,
                                            toFloat(9007199254740992) == 9007199254740992.0,
                                            gpuSatisfies(gpuFold(halves, 0.0, addF), fn(uploaded20) => (uploaded20) == 2499975000.0),
                                            gpuSatisfies(gpuFold(flipped, 0.0, addF), fn(uploaded19) => (uploaded19) == -4999950000.0), (gpuGet(flipped, 99999) ?: 0.0) == -99999.0,
                                            gpuSatisfies(gpuScan(xs, 0.0, addF), fn(uploaded18) => (gpuGet(uploaded18, 99999) ?: -1.0) == 4999950000.0), gpuSatisfies(gpuZipWith(xs, flipped, addF), fn(uploaded17) => gpuSatisfies(gpuFold(uploaded17, 0.0, addF), fn(uploaded126) => (uploaded126) == 0.0)),
                                            gpuSatisfies(gpuFilter(xs, isPositiveF), fn(uploaded16) => gpuLength(uploaded16) == 99999), toFloat(9007199254740993) == toFloat(9007199254740992), toFloat(9007199254740991) < toFloat(9007199254740992), toFloat(-9007199254740992) == -9007199254740992.0
                                    ])
                                })
                        })
                })
        })
}
/// floatOrderCase makes accumulation order observable: [GPU-FOLD] contracts the host backend to combine left-to-right, so a huge leading term absorbs every small one after
/// it while the same terms reversed all survive — why the spec calls a non-associative combine backend-dependent.
fn floatOrderCase() = withIndices(1001, fn(indices1001) => withIndices(100000, fn(indices100000) => floatOrderWith(indices1001, indices100000)))
fn floatOrderWith(indices1001, indices100000) = {
    handle Arith { divideByZero op lhs => {
            checkAll("zero divisor payload", [
                    op == "/", lhs == 1.0
            ])
            -1.0
        } }
    withBuffer(gpuMap(indices1001, toFloat), fn(xs) => {
            withBuffer(gpuMap(xs, headBig), fn(leading) => {
                    withBuffer(gpuMap(xs, tailBig), fn(trailing) => {
                            withBuffer(gpuFold(leading, 0.0, addF), fn(absorbed) => {
                                    withBuffer(gpuFold(trailing, 0.0, addF), fn(survived) => {
                                            withBuffer(gpuMap(indices100000, tenthOf), fn(uploaded15) => {
                                                    withBuffer(gpuFold(uploaded15, 0.0, addF), fn(tenths) => {
                                                            checkAll("float accumulation order is observable", [
                                                                    absorbed == hugeFloat(), survived == hugeFloat() + 1000.0, survived > absorbed,
                                                                    survived - absorbed == 1000.0,
                                                                    (gpuGet(leading, 1000) ?: 0.0) == 1.0,
                                                                    gpuSatisfies(toGpu([hugeFloat(), 1.0, 1.0, 1.0]), fn(uploaded3) => gpuSatisfies(gpuFold(uploaded3, 0.0, addF), fn(uploaded9) => (uploaded9) == hugeFloat())),
                                                                    gpuSatisfies(toGpu([1.0, 1.0, 1.0, hugeFloat()]), fn(uploaded2) => gpuSatisfies(gpuFold(uploaded2, 0.0, addF), fn(uploaded8) => (uploaded8) > hugeFloat())),
                                                                    gpuSatisfies(toGpu([1.0, 1.0, 1.0, hugeFloat()]), fn(uploaded1) => gpuSatisfies(gpuFold(uploaded1, 0.0, addF), fn(uploaded7) => (uploaded7) - hugeFloat() == 4.0)), (gpuGet(leading, 0) ?: 0.0) == hugeFloat(),
                                                                    (gpuGet(trailing, 1000) ?: 0.0) == hugeFloat(), gpuSatisfies(gpuScan(leading, 0.0, addF), fn(uploaded6) => (gpuGet(uploaded6, 1000) ?: 0.0) == hugeFloat()), tenths > 10000.0, tenths < 10000.001, ((1.0 / 0.0) ) == -1.0
                                                            ])
                                                        })
                                                })
                                        })
                                })
                        })
                })
        })
}
/// floatChurnCase runs 400 float passes over the canonical [GPU-CONVERT] seed.
fn floatChurnCase() = withIndices(8, fn(indices8) => withIndices(0, fn(indices0) => floatChurnWith(indices8, indices0)))
fn floatChurnWith(indices8, indices0) = {
    withBuffer(gpuMap(indices8, toFloat), fn(uploaded4) => {
            withBuffer(mix(uploaded4, 400), fn(mixed) => {
                    withBuffer(gpuFold(mixed, 0.0, addF), fn(total) => {
                            checkAll("400-pass float churn", [
                                    total > 1627.8, total < 1627.9, gpuLength(mixed) == 8, (gpuGet(mixed, 0) ?: 0.0) > 0.0, (gpuGet(mixed, 7) ?: 0.0) > (gpuGet(mixed, 0) ?: 0.0), gpuSatisfies(gpuFilter(mixed, isPositiveF), fn(uploaded3) => gpuLength(uploaded3) == 8),
                                    gpuSatisfies(gpuMap(indices0, toFloat), fn(uploaded2) => gpuSatisfies(mix(uploaded2, 50), fn(uploaded2) => gpuLength(uploaded2) == 0)),
                                    gpuSatisfies(gpuMap(indices8, toFloat), fn(uploaded1) => gpuSatisfies(mix(uploaded1, 0), fn(uploaded1) => gpuSatisfies(gpuFold(uploaded1, 0.0, addF), fn(uploaded124) => (uploaded124) == 28.0)))
                            ])
                        })
                })
        })
}
test("a million elements map, fold, filter and scan in one pipeline", fn() => exactArithmetic(megaPipelineCase))
test("a 100k prefix scan matches its closed form", fn() => exactArithmetic(scanScaleCase))
test("twenty-four dependent map passes stay exact", fn() => exactArithmetic(longChainCase))
test("a buffer rebuilt from its own output six times stays exact", fn() => exactArithmetic(rebuildCase))
test("half a million elements compact and compact again", fn() => exactArithmetic(compactionScaleCase))
test("quarter-million-element zips multiply, truncate and cancel", fn() => exactArithmetic(zipScaleCase))
test("five hundred simulation passes stay exact", fn() => exactArithmetic(simulationCase))
test("checked arithmetic marks the exact overflow boundary", fn() => exactArithmetic(overflowBoundaryCase))
test("a saturating accumulation freezes instead of wrapping", fn() => exactArithmetic(saturationCase))
test("negative buffers survive every combinator", fn() => exactArithmetic(negativeCase))
test("alternating signs telescope through fold, scan and filter", fn() => exactArithmetic(alternatingCase))
test("zero and empty buffers are defined everywhere", fn() => exactArithmetic(zeroDegenerateCase))
test("gathers report every out-of-range index as an error", fn() => exactArithmetic(gatherBoundaryCase))
test("float buffers keep their bits at scale", fn() => exactArithmetic(floatScaleCase))
test("float accumulation order changes the sum", fn() => exactArithmetic(floatOrderCase))
test("float churn keeps double words through 400 passes", fn() => exactArithmetic(floatChurnCase))
