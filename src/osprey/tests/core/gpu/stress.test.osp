/// [FAILURE-EXPLICIT] A checked stage preserves the first failure unchanged.
fn andThen(result, next) = match result {
    Success { value } => next(value)
    Error { message } => Error { message: message }
}
// gpuSatisfies and exactArithmetic are the testing prelude's
// [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the one shared copy,
// so this file declares only the index helpers whose labels are its own.
/// [FAILURE-EXPLICIT] Allocation errors fail the case before its consumer runs.
fn withIndices(n, work) = match gpuIota(n) {
    Success { value } => work(value)
    Error { message } => check("index allocation", "success", toString(message))
}
