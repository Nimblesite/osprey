]))
/// fusionStageCase feeds a fused buffer into every combinator in turn, including both operand slots of a ragged zip, so a buffer built by the fusion path is
/// indistinguishable from one copied out of a list.
fn fusionStageCase() = withBuffer(toGpu(range(0, 10) |> map(fn(x) => (x * 2) )), fn(fused) => withBuffer(toGpu(range(0, 10) |> filter(isEven)), fn(kept) => checkAll("fused into combinators", [
    gpuSatisfies(gpuMap(fused, inc), fn(stepped) => sumsTo(stepped, 0, 100)), gpuLengthIs(gpuFilter(fused, isBig), 7),
    bufferSumsTo(gpuFilter(fused, isBig), 84), bufferSumsTo(gpuFilter(fused, isEven), 90),
    gpuSatisfies(gpuScan(fused, 0, sumI), fn(scanned) => elementIs(scanned, 9, 0, 90)), gpuLengthIs(gpuZipWith(fused, kept, sumI), 5),
    gpuLengthIs(gpuZipWith(kept, fused, sumI), 5), bufferSumsTo(gpuZipWith(fused, kept, sumI), 40),
    bufferSumsTo(gpuZipWith(kept, kept, mulI), 120),
    gpuSatisfies(gpuMap(fused, toFloat), fn(widened) => floatSumsTo(widened, 0.0, 90.0)),
    scanSumsTo(gpuScan(kept, 0, sumI), 0, 40),
    gpuSatisfies(gpuMap(fused, isEven), fn(flags) => gpuLengthIs(gpuFilter(flags, truthy), 10)),
    gpuSatisfies(gpuMap(fused, dbl), fn(doubled) => scanSumsTo(gpuScan(doubled, 0, sumI), 0, 660))
])))
/// iotaCase pins the index buffer [0, n) that gather and stencil start from, down to n = 1, n = 0, and a negative n — which yields an empty buffer for the same reason an
/// inverted range does, never a negative allocation.
fn iotaCase() = withIndices(5, fn(indices5) => withIndices(1, fn(indices1) => withIndices(0, fn(indices0) => withIndices(3, fn(indices3) => iotaWith(indices5, indices1, indices0, indices3)))))
fn iotaWith(indices5, indices1, indices0, indices3) = {
    let idx = indices5
    checkAll("iota", [
            lengthIs(idx, 5), sumsTo(idx, 0, 10), elementIs(idx, 0, 9, 0), elementIs(idx, 4, 0, 4), elementIs(idx, 5, 77, 77), hornerTo(idx, 0, 1234),
            lengthIs(indices1, 1), elementIs(indices1, 0, 9, 0), lengthIs(indices0, 0), sumsTo(indices0, 3, 3),
            iotaError(0 - 4) == "gpu: buffer allocation: a negative element count",
            bufferSumsTo(gpuZipWith(idx, idx, mulI), 30),
            gpuSatisfies(gpuMap(idx, toFloat), fn(widened) => floatSumsTo(widened, 0.0, 10.0)),
            scanSumsTo(gpuScan(indices3, 0, horner), 0, 13)
    ])
}
/// getCase pins typed reads in bounds and a visible Error out of bounds, at both ends of the index range and at both element types — plus a gather kernel, since reading a
/// buffer is pure and therefore legal inside one.
fn getCase() = withIndices(3, fn(indices3) => getWith(indices3))
fn getWith(indices3) = withBuffer(toGpu([7, 8, 9]), fn(ints) => withBuffer(toGpu([1.5, 2.5]), fn(floats) => withBuffer(gpuMap(indices3, fn(i) => gpuGet(ints, (2 - i) ) ?: 0), fn(reversed) => checkAll("get", [
    elementsFrom(ints, 0, 0, [7, 8, 9]), elementsFrom(floats, 0, 0.0, [1.5, 2.5]),
    elementsAt(ints, 999, [3, (0 - 1)], [999, 999]), elementIs(floats, 2, 9.5, 9.5), rendersAs(ints, 0, "value 7"),
    rendersAs(ints, 3, "gpuGet: index out of bounds"), elementIs(reversed, 0, 0, 9), hornerTo(reversed, 0, 987)
]))))
/// deviceCase pins backend introspection: the host backend names itself, and says so rather than reporting a device it does not have [GPU-DEVICE].
fn deviceCase() = checkAll("device", [
        gpuDevice() == "host", length(gpuDevice()) == 4, gpuDevice() != "cuda:0"
])
test("every combinator over an empty buffer stays empty", fn() => exactArithmetic(emptyShapeCase))
test("gpuFold over an empty buffer is the initial value", fn() => exactArithmetic(emptyFoldCase))
test("every combinator handles a one-element buffer", fn() => exactArithmetic(singletonCase))
test("gpuZipWith truncates to the shorter operand in both orders", fn() => exactArithmetic(raggedCase))
test("gpuZipWith produces the kernel's element type", fn() => exactArithmetic(zipTypeCase))
test("gpuFilter keeps all, none, or alternates in source order", fn() => exactArithmetic(filterKeepCase))
test("gpuFilter predicates compose comparisons and boolean operators", fn() => exactArithmetic(filterPredicateCase))
test("gpuScan is an inclusive prefix element by element", fn() => exactArithmetic(scanPrefixCase))
test("gpuScan seeds element zero with the initial value", fn() => exactArithmetic(scanSeedCase))
test("non-commutative combines pin the traversal order", fn() => exactArithmetic(orderCase))
test("five-stage and longer chains stay exact", fn() => exactArithmetic(deepChainCase))
test("shape-changing combinators compose", fn() => exactArithmetic(mixedChainCase))
test("kernels move elements between all three scalar types", fn() => exactArithmetic(typeChangeCase))
test("an iterator pipeline fuses into a buffer with no list", fn() => exactArithmetic(fusionSourceCase))
test("a fused buffer feeds every combinator", fn() => exactArithmetic(fusionStageCase))
test("gpuIota builds the index buffer", fn() => exactArithmetic(iotaCase))
test("gpuGet reads typed elements and errors out of bounds", fn() => exactArithmetic(getCase))
test("gpuDevice names the active backend", fn() => exactArithmetic(deviceCase))
