// withBuffer, gpuSatisfies, withIndices, iotaError and exactArithmetic are the
// testing prelude's [TESTING-ARITH-POLICY] GPU helpers: naming one attaches the
// one shared copy, so this file declares none of its own.
// GPU combinator algebra: how gpuMap, gpuFilter, gpuScan, gpuZipWith and gpuFold behave alone, at their degenerate edges, and composed into deep chains — the empty and
// one-element buffer, ragged truncation to the shorter operand, order-preserving compaction, the inclusive-prefix seed, the initial value a fold returns with nothing to
// reduce, and the left-to-right traversal the host backend documents ([GPU-MAP], [GPU-FOLD], [GPU-ZIPWITH], [GPU-IOTA], [GPU-GET], [GPU-SCAN], [GPU-FILTER], [GPU-BUFFER-
// FUSE], [GPU-CONVERT], [GPU-BACKEND-HOST], [GPU-DEVICE] — docs/specs/runtime/0034-GPUComputation.md).
/// The zero-length buffers every combinator is pushed through; the annotation supplies the element type an empty literal cannot.
fn emptyInts() -> Result<GpuBuffer<int>, Error> = toGpu([])
fn emptyFloats() -> Result<GpuBuffer<float>, Error> = toGpu([])
/// sumI and mulI are the associative int combines fold and scan share.
fn sumI(a, b) = (a + b)
fn mulI(a, b) = (a * b)
/// subI and horner are deliberately non-commutative. Left-to-right is the only traversal that reproduces their results, so every assertion on them pins the order [GPU-
/// BACKEND-HOST] rather than merely the element set.
fn subI(a, b) = (a - b)
fn horner(a, d) = (((a * 10) ) + d)
/// maxI makes a scan a running maximum; addF is the float reduction; orB is the boolean any-reduction that latches on the first accepted element.
fn maxI(a, b: int) = match a > b { true => a false => b }
fn orB(a, b) = a || b
/// countTrue is the population count that turns a bool buffer into a scalar.
fn countTrue(a, flag) = match flag {
    true => (a + 1)
    false => a
}
/// dbl, inc and half are the one-line stages the deep chains are built from.
fn dbl(x) = (x * 2)
fn inc(x) = (x + 1)
fn half(x: float) = x * 0.5
/// toBit widens a bool element back to an int one, closing the type cycle int -> bool -> int that [GPU-BUFFER-ELEM]'s three scalars allow.
fn toBit(b) = match b { true => 1 false => 0 }
/// isEven and isOddP are each other's negation; isOddP is spelled with `!` so the predicate slot is fed by a boolean operator, not just a comparison.
fn isEven(x) = (x % 2 ) == 0
fn isOddP(x) = !isEven(x)
/// keepEvery and keepNone are the degenerate predicates — total acceptance and total rejection, independent of the element.
fn keepEvery(x) = x == x
fn keepNone(x) = x != x
/// The remaining predicates compose comparisons with &&, || and !.
fn isBig(x) = x > 4
fn bigEven(x) = isEven(x) && isBig(x)
fn inBand(x) = x >= 3 && x <= 6
fn notBand(x) = !inBand(x)
fn atEdge(x) = (x < 2) || (x > 7)
fn isPositive(x) = x > 0.0
fn truthy(b) = b
/// The zip kernels below all return an element type neither operand has, so gpuZipWith is exercised as a type-changing combinator too.
fn sameParity(a, b) = isEven(a) == isEven(b)
fn lessF(a, b: float) = a < b
fn meanF(a, b) = (toFloat(a) + toFloat(b)) * 0.5
fn mixAdd(i, x: float) = toFloat(i) + x
/// oobMessage renders a gpuGet outcome as text so the Error [GPU-GET] returns is visible in an assertion instead of being swallowed by a `?:` default.
fn oobMessage(buf: GpuBuffer<int>, i) = match gpuGet(buf, i) {
    Success { value } => "value ${value}"
    Error { message } => message
}
/// rendersAs is one gpuGet outcome as text, so an element's own type stays visible.
fn rendersAs(b, index, text) = oobMessage(b, index) == text
/// sumsTo, productsTo, differencesTo and hornerTo are [GPU-FOLD] with this file's int combines; subI and horner are non-commutative, so their `expected` also pins the traversal order.
fn sumsTo(b, seed, expected) = gpuEquals(gpuFold(b, seed, sumI), expected)
fn productsTo(b, seed, expected) = gpuEquals(gpuFold(b, seed, mulI), expected)
fn differencesTo(b, seed, expected) = gpuEquals(gpuFold(b, seed, subI), expected)
fn hornerTo(b, seed, expected) = gpuEquals(gpuFold(b, seed, horner), expected)
/// trueCountIs is [GPU-FOLD] with countTrue: `b` holds `expected` true elements.
fn trueCountIs(b, expected) = gpuEquals(gpuFold(b, 0, countTrue), expected)
/// foldedFrom reads a buffer already in hand through sumI from `foldSeed`: every filtered, scanned and zipped buffer below reads back through it, so bufferSumsTo and scanSumsTo are the same read at seed 0 and at a scan's own seed.
fn foldedFrom(buf, foldSeed, expected) = gpuSatisfies(buf, fn(s) => sumsTo(s, foldSeed, expected))
fn bufferSumsTo(buf, expected) = foldedFrom(buf, 0, expected)
fn scanSumsTo(scanned, foldSeed, expected) = foldedFrom(scanned, foldSeed, expected)
/// bufferHornerTo reads a buffer through the non-commutative horner fold, from seed 0.
fn bufferHornerTo(buf, expected) = gpuSatisfies(buf, fn(b) => hornerTo(b, 0, expected))
/// zipLeftIs zips `b` with the upload of `values` and keeps `expected` elements — the shorter operand wins.
fn zipLeftIs(b, values, expected) = gpuSatisfies(toGpu(values), fn(other) => gpuLengthIs(gpuZipWith(b, other, sumI), expected))
/// zippedProductLengthIs and mixedZipLengthIs zip two uploads and keep `expected` elements; their kernels differ in type, and gpuZipWith only accepts a named function, so each names its own.
fn zippedProductLengthIs(values, others, expected) = gpuSatisfies(toGpu(values), fn(first) => gpuSatisfies(toGpu(others), fn(second) => gpuLengthIs(gpuZipWith(first, second, mulI), expected)))
fn mixedZipLengthIs(values, others, expected) = gpuSatisfies(toGpu(values), fn(first) => gpuSatisfies(toGpu(others), fn(second) => gpuLengthIs(gpuZipWith(first, second, mixAdd), expected)))
/// emptyShapeCase pins that no combinator invents an element from nothing: map, filter and scan over zero elements are all zero elements, whatever the kernel does to the
/// element type.
fn emptyShapeCase() = withBuffer(emptyInts(), fn(intEmpty) => withBuffer(emptyFloats(), fn(floatEmpty) => emptyShapeWith(intEmpty, floatEmpty)))
fn emptyShapeWith(intEmpty, floatEmpty) = withBuffer(gpuMap(intEmpty, dbl), fn(mapped) => withBuffer(gpuFilter(mapped, isEven), fn(filtered) => withBuffer(gpuScan(filtered, 0, sumI), fn(scanned) => withBuffer(gpuMap(scanned, inc), fn(chained) => checkAll("empty shapes", [
    lengthIs(intEmpty, 0), gpuLengthIs(gpuMap(intEmpty, dbl), 0), gpuLengthIs(gpuMap(intEmpty, toFloat), 0), gpuLengthIs(gpuMap(intEmpty, isEven), 0),
    gpuLengthIs(gpuMap(floatEmpty, half), 0), gpuLengthIs(gpuFilter(intEmpty, keepEvery), 0), gpuLengthIs(gpuFilter(intEmpty, keepNone), 0),
    gpuLengthIs(gpuScan(intEmpty, 0, sumI), 0), gpuLengthIs(gpuScan(intEmpty, 99, maxI), 0), zipLeftIs(intEmpty, [1, 2, 3], 0), gpuSatisfies(toGpu([1, 2, 3]), fn(other) => gpuLengthIs(gpuZipWith(other, intEmpty, sumI), 0)),
    gpuSatisfies(fromGpu(intEmpty), fn(values) => listLength(values) == 0), elementIs(intEmpty, 0, 42, 42), lengthIs(chained, 0)
])))))
/// emptyFoldCase pins [GPU-FOLD]'s base case: with no element to combine, the result is exactly the initial value — for every combine, and for a buffer emptied by
/// compaction rather than born empty.
fn emptyFoldCase() = withIndices(0, fn(indices0) => emptyFoldWith(indices0))
fn emptyFoldWith(indices0) = withBuffer(emptyInts(), fn(intEmpty) => withBuffer(emptyFloats(), fn(floatEmpty) => emptyFoldOn(indices0, intEmpty, floatEmpty)))
fn emptyFoldOn(indices0, intEmpty, floatEmpty) = withBuffer(toGpu([1, 3, 5]), fn(value) => withBuffer(gpuFilter(value, keepNone), fn(drained) => checkAll("empty folds", [
    sumsTo(intEmpty, 0, 0), sumsTo(intEmpty, 7, 7), productsTo(intEmpty, 1, 1), differencesTo(intEmpty, 100, 100),
    hornerTo(intEmpty, 9, 9), gpuEquals(gpuFold(intEmpty, 3, maxI), 3),
    floatSumsTo(floatEmpty, 0.0, 0.0), floatSumsTo(floatEmpty, 2.5, 2.5), gpuSatisfies(gpuMap(intEmpty, isEven), fn(flags) => gpuEquals(gpuFold(flags, 4, countTrue), 4)),
    lengthIs(drained, 0), sumsTo(drained, 11, 11), scanSumsTo(gpuScan(drained, 0, sumI), 13, 13),
    productsTo(indices0, 5, 5), gpuSatisfies(gpuZipWith(intEmpty, intEmpty, sumI), fn(zipped) => sumsTo(zipped, 6, 6))
])))
/// singletonCase walks the one-element buffer through every combinator: the smallest shape where a kernel actually runs, and the one where an off-by-one in a loop bound or
/// a prefix seed shows up immediately.
fn singletonCase() = withBuffer(toGpu([5]), fn(one) => withBuffer(gpuScan(one, 3, sumI), fn(scanned) => withBuffer(toGpu([4]), fn(four) => withBuffer(toGpu([7]), fn(seven) => withBuffer(toGpu([1, 2, 3]), fn(longer) => checkAll("singleton", [
    lengthIs(one, 1), gpuSatisfies(gpuMap(one, dbl), fn(doubled) => elementIs(doubled, 0, 0, 10)), gpuLengthIs(gpuFilter(one, isEven), 0),
    gpuLengthIs(gpuFilter(four, isEven), 1), gpuSatisfies(gpuFilter(four, isEven), fn(kept) => elementIs(kept, 0, 0, 4)),
    lengthIs(scanned, 1), elementIs(scanned, 0, 0, 8), gpuSatisfies(gpuScan(one, 0, maxI), fn(running) => elementIs(running, 0, 0, 5)),
    sumsTo(one, 3, 8), differencesTo(one, 10, 5), gpuSatisfies(gpuZipWith(one, seven, sumI), fn(zipped) => elementIs(zipped, 0, 0, 12)),
    gpuSatisfies(gpuZipWith(longer, one, sumI), fn(zipped) => elementIs(zipped, 0, 0, 6)), elementIs(one, 1, 42, 42)
]))))))
/// raggedCase pins [GPU-ZIPWITH]'s truncation to the shorter operand in both argument orders, and uses a non-commutative kernel so a swapped operand pair could not pass by
/// accident.
fn raggedCase() = withIndices(3, fn(indices3) => withIndices(7, fn(indices7) => withIndices(4, fn(indices4) => raggedWith(indices3, indices7, indices4))))
fn raggedWith(indices3, indices7, indices4) = withBuffer(toGpu([1, 2, 3, 4, 5]), fn(left) => withBuffer(toGpu([10, 20]), fn(right) => withBuffer(gpuZipWith(left, right, subI), fn(leftFirst) => withBuffer(gpuZipWith(right, left, subI), fn(rightFirst) => checkAll("ragged zip", [
    lengthIs(leftFirst, 2), lengthIs(rightFirst, 2), elementsFrom(rightFirst, 0, 0, [9, 18]),
    sumsTo(leftFirst, 27, 0), sumsTo(rightFirst, 0, 27), elementIs(leftFirst, 2, 77, 77),
    zippedProductLengthIs([1, 2, 3], [9], 1), zippedProductLengthIs([9], [1, 2, 3], 1),
    gpuLengthIs(gpuZipWith(indices3, indices7, sumI), 3), gpuLengthIs(gpuZipWith(indices7, indices3, sumI), 3),
    bufferSumsTo(gpuZipWith(indices7, indices3, mulI), 5), gpuLengthIs(gpuZipWith(indices4, indices4, sumI), 4)
])))))
/// zipTypeCase pins that the zip kernel's result type is the buffer's, not either operand's, including a pair whose two operands differ in type.
fn zipTypeCase() = withBuffer(toGpu([1, 2, 3, 4]), fn(first) => withBuffer(toGpu([3, 5, 7, 9]), fn(second) => withBuffer(gpuZipWith(first, second, sameParity), fn(parity) => withBuffer(toGpu([1, 3]), fn(meanLeft) => withBuffer(toGpu([3, 5]), fn(meanRight) => withBuffer(gpuZipWith(meanLeft, meanRight, meanF), fn(means) => withBuffer(toGpu([1, 2]), fn(mixLeft) => withBuffer(toGpu([0.5, 0.25]), fn(mixRight) => withBuffer(gpuZipWith(mixLeft, mixRight, mixAdd), fn(mixed) => withBuffer(toGpu([1.0, 2.0, 3.0]), fn(lessLeft) => withBuffer(toGpu([3.0, 2.0, 1.0]), fn(lessRight) => withBuffer(gpuZipWith(lessLeft, lessRight, lessF), fn(flags) => checkAll("zip element types", [
    lengthIs(parity, 4), elementIs(parity, 0, false, true), elementIs(parity, 1, true, false), trueCountIs(parity, 2),
    lengthIs(means, 2), elementsFrom(means, 0, 0.0, [2.0, 4.0]), floatSumsTo(means, 0.0, 6.0),
    elementIs(mixed, 0, 0.0, 1.5), floatSumsTo(mixed, 0.0, 3.75), mixedZipLengthIs([1, 2, 3], [0.5], 1),
    trueCountIs(flags, 1)
])))))))))))))
/// filterKeepCase pins the three shapes of a compaction — every element kept, none kept, alternating — and reads the kept run back element by element so [GPU-FILTER]'s
/// source-order guarantee is checked, not just its count.
fn filterKeepCase() = withBuffer(toGpu([9, 4, 7, 2, 5, 8]), fn(src) => withBuffer(gpuFilter(src, keepEvery), fn(kept) => withBuffer(gpuFilter(src, isEven), fn(alternates) => checkAll("filter keep sets", [
    lengthIs(kept, 6), elementsAt(kept, 0, [0, 5], [9, 8]), sumsTo(kept, 0, 35), gpuLengthIs(gpuFilter(src, keepNone), 0),
    lengthIs(alternates, 3), elementsFrom(alternates, 0, 0, [4, 2, 8]),
    elementIs(alternates, 3, 55, 55), gpuLengthIs(gpuFilter(src, isOddP), 3), bufferHornerTo(gpuFilter(src, isOddP), 975)
]))))
/// filterPredicateCase feeds the predicate slot from comparisons and from every boolean operator, over int and float elements and over a bool buffer whose elements are the
/// predicate.
fn filterPredicateCase() = withIndices(10, fn(indices10) => withIndices(6, fn(indices6) => filterPredicateWith(indices10, indices6)))
fn filterPredicateWith(indices10, indices6) = withBuffer(toGpu([0.0 - 1.5, 0.0, 2.5, 4.0]), fn(signed) => checkAll("filter predicates", [
    gpuLengthIs(gpuFilter(indices10, isBig), 5), bufferSumsTo(gpuFilter(indices10, isBig), 35),
    gpuLengthIs(gpuFilter(indices10, bigEven), 2), bufferSumsTo(gpuFilter(indices10, bigEven), 14),
    gpuLengthIs(gpuFilter(indices10, atEdge), 4), bufferHornerTo(gpuFilter(indices10, atEdge), 189),
    bufferSumsTo(gpuFilter(indices10, isOddP), 25), gpuLengthIs(gpuFilter(indices10, inBand), 4),
    gpuLengthIs(gpuFilter(indices10, notBand), 6), bufferSumsTo(gpuFilter(indices10, notBand), 27),
    gpuLengthIs(gpuFilter(signed, isPositive), 2), gpuSatisfies(gpuFilter(signed, isPositive), fn(kept) => floatSumsTo(kept, 0.0, 6.5)),
    gpuSatisfies(gpuMap(indices6, isEven), fn(flags) => gpuLengthIs(gpuFilter(flags, truthy), 3))
]))
/// scanPrefixCase reads [GPU-SCAN]'s inclusive prefix out one element at a time: element i is the combine folded through element i, so the last element must equal the
/// whole-buffer fold and index n is out of bounds.
fn scanPrefixCase() = withIndices(5, fn(indices5) => scanPrefixWith(indices5))
fn scanPrefixWith(indices5) = withBuffer(toGpu([1, 2, 3, 4, 5]), fn(value) => withBuffer(gpuScan(value, 0, sumI), fn(sums) => withBuffer(gpuScan(sums, 0, sumI), fn(twice) => withBuffer(toGpu([1, 2, 3, 4]), fn(four) => withBuffer(gpuScan(four, 1, mulI), fn(products) => checkAll("inclusive prefix", [
    lengthIs(sums, 5), elementsFrom(sums, 0, 0, [1, 3, 6, 10]),
    elementIs(sums, 4, 0, 15), elementIs(sums, 5, 77, 77), gpuSatisfies(gpuFold(value, 0, sumI), fn(total) => elementIs(sums, 4, 0, total)),
    elementIs(twice, 4, 0, 35), lengthIs(products, 4), elementIs(products, 3, 0, 24), gpuSatisfies(gpuScan(indices5, 0, sumI), fn(scanned) => elementIs(scanned, 4, 0, 10))
]))))))
/// scanSeedCase pins the seed's role — element 0 is combine(initial, src 0), never src 0 — over a sum, a maximum a high seed swamps, and a bool latch.
fn scanSeedCase() = withBuffer(toGpu([1, 2, 3]), fn(three) => withBuffer(gpuScan(three, 10, sumI), fn(seeded) => withBuffer(toGpu([3, 1, 4, 1, 5, 9, 2, 6]), fn(source) => withBuffer(gpuScan(source, 0, maxI), fn(running) => withBuffer(toGpu([1, 3, 4, 7]), fn(flagsSource) => withBuffer(gpuMap(flagsSource, isEven), fn(flags) => withBuffer(gpuScan(flags, false, orB), fn(latched) => checkAll("scan seeds", [
    elementsFrom(seeded, 0, 0, [11, 13, 16]), elementsAt(running, 0, [0, 1, 3, 7], [3, 3, 4, 9]), sumsTo(running, 0, 46),
    gpuSatisfies(toGpu([3, 1, 4]), fn(source) => scanSumsTo(gpuScan(source, 100, maxI), 0, 300)),
    lengthIs(latched, 4), elementIs(latched, 1, true, false), trueCountIs(latched, 2)
]))))))))
/// orderCase pins the traversal itself. Every combine here is order-sensitive, so reversing the source has to change the answer, and a scan's last element has to agree
/// with the fold running the same combine — the left-to-right host contract [GPU-BACKEND-HOST], written out as numbers.
fn orderCase() = withBuffer(toGpu([1, 2, 3, 4]), fn(digitsUp) => withBuffer(gpuScan(digitsUp, 0, horner), fn(running) => checkAll("traversal order", [
    hornerTo(digitsUp, 0, 1234), gpuSatisfies(toGpu([4, 3, 2, 1]), fn(digitsDown) => hornerTo(digitsDown, 0, 4321)), hornerTo(digitsUp, 9, 91234),
    gpuSatisfies(toGpu([1, 2, 3]), fn(up) => differencesTo(up, 100, 94)), gpuSatisfies(toGpu([3, 2, 1]), fn(down) => differencesTo(down, 100, 94)), elementIs(running, 0, 0, 1),
    elementsFrom(running, 1, 0, [12, 123, 1234]),
    gpuSatisfies(gpuFold(digitsUp, 0, horner), fn(total) => elementIs(running, 3, 0, total)),
    gpuSatisfies(toGpu([1, 2, 3]), fn(source) => scanSumsTo(gpuScan(source, 10, subI), 0, 20)), gpuSatisfies(toGpu([1, 2, 3]), fn(source) => scanSumsTo(gpuScan(source, 0, subI), 10, 0)), sumsTo(running, 0, 1370)
])))
/// deepChainCase runs pipelines of five and more dependent stages: each one allocates a fresh buffer the next stage consumes, so a stage that read a stale length or a
/// stale pointer would corrupt every number below.
fn deepChainCase() = withIndices(12, fn(indices12) => withIndices(8, fn(indices8) => withIndices(20, fn(indices20) => deepChainWith(indices12, indices8, indices20))))
/// The widened chain folds a float buffer back through a bool one, closing the scalar-type cycle [GPU-BUFFER-ELEM] allows.
fn deepChainWith(indices12, indices8, indices20) = withBuffer(gpuMap(indices12, dbl), fn(doubled) => withBuffer(gpuMap(doubled, toFloat), fn(asFloats) => withBuffer(gpuMap(asFloats, half), fn(widened) => withBuffer(gpuMap(indices8, inc), fn(steppedOnce) => withBuffer(gpuMap(steppedOnce, dbl), fn(steppedTwice) => withBuffer(gpuMap(steppedTwice, inc), fn(steppedThrice) => withBuffer(gpuMap(steppedThrice, dbl), fn(steppedFourth) => withBuffer(gpuMap(steppedFourth, inc), fn(stepped) => withBuffer(gpuMap(indices20, dbl), fn(longDoubled) => withBuffer(gpuFilter(longDoubled, isBig), fn(big) => withBuffer(gpuScan(big, 0, sumI), fn(compacted) => checkAll("deep chains", [
    lengthIs(compacted, 17), elementsAt(compacted, 0, [0, 16], [6, 374]), sumsTo(compacted, 0, 2550), floatSumsTo(widened, 0.0, 66.0),
    gpuSatisfies(gpuMap(widened, isPositive), fn(flags) => gpuSatisfies(gpuMap(flags, toBit), fn(bits) => sumsTo(bits, 0, 11))), lengthIs(stepped, 8),
    elementsAt(stepped, 0, [0, 7], [7, 35]), sumsTo(stepped, 0, 168),
    gpuSatisfies(gpuFilter(stepped, isOddP), fn(odd) => sumsTo(odd, 0, 168)), gpuLengthIs(gpuFilter(stepped, isEven), 0)
]))))))))))))
/// mixedChainCase interleaves the shape-changing combinators — a compaction feeding a scan feeding another compaction, a zip feeding a map feeding a filter — where a wrong
/// published length silently shortens everything after.
fn mixedChainCase() = withIndices(30, fn(indices30) => withIndices(6, fn(indices6) => mixedChainWith(indices30, indices6)))
fn mixedChainWith(indices30, indices6) = withBuffer(gpuFilter(indices30, isEven), fn(evens) => withBuffer(gpuScan(evens, 0, sumI), fn(scanned) => withBuffer(gpuFilter(scanned, bigEven), fn(prefixes) => withBuffer(gpuMap(indices6, fn(x) => (x * 3) ), fn(tripled) => withBuffer(gpuZipWith(indices6, tripled, mulI), fn(products) => withBuffer(gpuMap(products, inc), fn(stepped) => withBuffer(gpuFilter(stepped, isOddP), fn(woven) => checkAll("mixed chains", [
