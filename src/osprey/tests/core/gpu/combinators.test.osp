    elementIs(flags, 1, false, true), trueCountIs(flags, 2), sumsTo(bits, 0, 2), gpuSatisfies(gpuMap(bits, toFloat), fn(widenedBits) => floatSumsTo(widenedBits, 0.0, 2.0)),
    gpuSatisfies(gpuMap(signed, isPositive), fn(positive) => trueCountIs(positive, 1)),
