/// fusionSourceCase pins `toGpu` as a consuming stage of an iterator pipeline [GPU-BUFFER-FUSE]: the pending map/filter stages replay inside the loop that fills the
/// buffer, so no `List` is built on the way. A filtered chain publishes the kept prefix exactly as gpuFilter does, an inverted or empty range yields an empty buffer, and a
/// fused map may change the element type.
fn fusionSourceCase() = withBuffer(toGpu(range(0, 10) |> filter(isEven) |> map(fn(x) => (x * 2) )), fn(staged) => checkAll("fused sources", [
    gpuSatisfies(toGpu(range(0, 4) |> map(toFloat) |> map(half)), fn(widened) => floatSumsTo(widened, 0.0, 3.0)),
    gpuSatisfies(toGpu(range(0, 4) |> map(dbl) |> map(inc)), fn(chained) => sumsTo(chained, 0, 16)), lengthIs(staged, 5), elementIs(staged, 4, 0, 16),
    sumsTo(staged, 0, 40), gpuSatisfies(toGpu(range(0, 10) |> filter(isEven)), fn(evens) => hornerTo(evens, 0, 2468)),
