fn iotaOutcome(result) = match result { Success { value } => "unexpected success ${gpuLength(value)}" Error { message } => toString(message) }
// Aspirational GPU frontend parity. Flavor-equivalent programs must reach the
// same typed GPU IR, including the full int domain and negative arguments
// ([GPU-BUFFER-ELEM], [GPU-IOTA], [GPU-KERNEL-EXTRACT]).

fn minimumIntCase() = {
    let minimum = -9223372036854775808
    withBuffer(toGpu([minimum]), fn(buf) => checkAll("minimum int literal crosses the GPU boundary", [
        gpuLength(buf) == 1,
        (gpuGet(buf, 0) ?: 0) == minimum,
        gpuSatisfies(fromGpu(buf), fn(checked) => (listGet(checked, 0) ?: 0) == minimum)
    ]))
}
fn negativeIotaCase() = {
    let direct = gpuIota(-3)
    let piped = -7 |> gpuIota()
    checkAll("negative gpuIota arguments report allocation errors", [
            iotaOutcome(direct) == "gpu: buffer allocation: a negative element count",
            iotaOutcome(piped) == "gpu: buffer allocation: a negative element count",
            iotaOutcome(direct) == iotaOutcome(piped),
            iotaOutcome(gpuIota(-9223372036854775808)) == "gpu: buffer allocation: a negative element count"
    ])
}
testCases([
    { name: "minimum int literals are flavor-equivalent in GPU buffers", work: minimumIntCase },
    { name: "negative gpuIota arguments are flavor-equivalent", work: negativeIotaCase }
])
fn denseFloatCombinatorsCase() = {
    let values: List<float32> = [0.5, 1.0, 1.5]
    withBuffer(toGpu(values), fn(buffer) =>
        withBuffer(gpuScan(buffer, toFloat32(0.0), fn(acc, value) => acc + value), fn(scan) =>
            withBuffer(gpuFilter(buffer, fn(value) => value > toFloat32(0.5)), fn(kept) =>
                withBuffer(gpuZipWith(buffer, buffer, fn(a, b) => a + b), fn(zipped) => checkAll("dense float32 combinators", [
                    gpuEquals(gpuFold(buffer, toFloat32(0.0), fn(acc, value) => acc + value), toFloat32(3.0)),
                    gpuSatisfies(fromGpu(scan), fn(listed) => join(mapList(listed, toString), ",") == "0.5,1.5,3.0"),
                    gpuSatisfies(fromGpu(kept), fn(listed) => join(mapList(listed, toString), ",") == "1.0,1.5"),
                    gpuSatisfies(fromGpu(zipped), fn(listed) => join(mapList(listed, toString), ",") == "1.0,2.0,3.0")
                ])))))
}
test("float32 reductions scans filters and zip keep their width", denseFloatCombinatorsCase)
