// Assertion-driven migration of the persistent List golden example.

/// IterationProbe records callback values so forEachList order is testable without stdout.
effect IterationProbe {
    /// Record one callback value so traversal order is testable.
    observe: fn(int) -> Unit
}

/// Slot is a record element, so `listGet` must hand back the whole record.
type Slot = { label: string, weight: float, ready: bool }

/// The element at `index` in `xs`, or `fallback` past either end ([BUILTIN-LIST-GET]).
fn elementOr(xs, index, fallback) = listGet(xs, index) ?: fallback

/// The int at `index` in `xs`, or -999 past either end.
fn intAt(xs, index) = elementOr(xs, index, (0 - 999))

/// True when [BUILTIN-LIST-GET] answers `Error` for `index` with the exact
/// "index out of bounds" message, and false for any other outcome.
fn oobAt(xs, index) = match listGet(xs, index) {
    Success => false
    Error { message } => message == "index out of bounds"
}

/// Every listed index of `xs` answers `Error` with that exact message.
fn allOob(xs, indices) = match indices {
    [] => true
    [index, ...rest] => oobAt(xs, index) && allOob(xs, rest)
}

/// grownBy extends `xs` by listAppend with each element of `values`, in order.
fn grownBy(xs, values) = match values {
    [] => xs
    [head, ...tail] => grownBy(listAppend(xs, head), tail)
}

/// aListFixture is the [1, 2, 3] int list every construction case starts from.
fn aListFixture() = grownBy(List(), [1, 2, 3])

/// bListFixture is the [10, 20] int list every concatenation case starts from.
fn bListFixture() = grownBy(List(), [10, 20])

/// wordTriple is the three-word string fixture the typed cases index and rebuild.
fn wordTriple() = ["alpha", "beta", "gamma"]

/// ratioTriple is the exact-binary three-float fixture the typed cases sum.
fn ratioTriple() = [0.5, 1.25, 2.75]

/// Every element of `xs` equals its partner want in `wants`, index by index,
/// every row through the Result path of [BUILTIN-LIST-GET].
fn elementsAre(xs, wants, fallback) = elementsFrom(xs, wants, fallback, 0)

/// elementsAre's recursion: `index` counts up one want at a time.
fn elementsFrom(xs, wants, fallback, index) = match wants {
    [] => true
    [want, ...rest] => elementOr(xs, index, fallback) == want && elementsFrom(xs, rest, fallback, index + 1)
}

/// Every listed index of `indices` yields its partner want from `xs`, through
/// the Result path of [BUILTIN-LIST-GET].
fn rowsHold(xs, indices, wants, fallback) =
    range(0, listLength(indices)) |> fold(true, fn(hold, i) => hold && elementOr(xs, intAt(indices, i), fallback) == elementOr(wants, i, fallback))

/// listLength as a first-class value, so answersHold can fold length rows.
fn lengthOf(xs) = listLength(xs)

/// sentinelSlot is the out-of-range fallback record every typed bounds check reads fields from.
fn sentinelSlot() = Slot { label: "missing", weight: 0.0, ready: false }

/// leftRightSlots is the two-slot fixture indexed, traversed, and destructured by the typed cases.
fn leftRightSlots() = [
    Slot { label: "left", weight: 1.5, ready: true },
    Slot { label: "right", weight: 2.5, ready: false }
]

/// everyRowOf folds `row` over every index of `lists`, AND-ing every row.
fn everyRowOf(lists, row) = range(0, listLength(lists)) |> fold(true, fn(hold, i) => hold && row(i))

/// Every listed list equals its partner want-list element by element, through
/// the Result path of [BUILTIN-LIST-GET].
fn allElementsAre(lists, wants, fallback) = everyRowOf(lists, fn(i) => elementsAre(elementOr(lists, i, []), elementOr(wants, i, []), fallback))

/// Every listed list answers its partner index and want rows, list by list,
/// each row through the Result path of [BUILTIN-LIST-GET].
fn allRowsHold(lists, indices, wants, fallback) = everyRowOf(lists, fn(i) => rowsHold(elementOr(lists, i, []), elementOr(indices, i, []), elementOr(wants, i, []), fallback))

/// The slot's three fields read back `label`, `weight` and `ready`, so a head
/// bound to the wrong slot cannot pass by matching only one field.
fn slotReads(slot, label, weight, ready) = slot.label == label && slot.weight == weight && slot.ready == ready

/// Every `wanted` element is a member of `xs` and no `absent` one is
/// ([BUILTIN-LIST-CONTAINS]), so one row answers both membership questions.
fn membershipHolds(xs, wanted, absent) = allListed(xs, wanted) && noneListed(xs, absent)

/// `s` starts with `prefix` and ends with `suffix`.
fn spans(s, prefix, suffix) = startsWith(s, prefix) && endsWith(s, suffix)

/// The transcript spells `expected`, runs `size` bytes, ends with `tail` and
/// not its reversal, and carries `seam` where the last traversal joined it.
fn transcriptSealed(log, expected, size, tail, reversed, seam) =
    log == expected && length(log) == size && endsWith(log, tail) && !endsWith(log, reversed) && contains(log, seam)

/// noteEach visits `xs` in index order, asking `spell` for each element's text.
fn noteEach(xs, spell) = forEachList(xs, fn(item) => perform TranscriptProbe.note(spell(item)))

/// sealedRow checks the log the last traversal left against `title`'s row.
fn sealedRow(log, title, expected, size, tail, reversed, seam) = checkAll(title, [transcriptSealed(log, expected, size, tail, reversed, seam)])

/// appendThrough builds inclusive integer ranges while preserving every prior list version.
fn appendThrough(xs) =
    fn(next) => fn(last) => match next > last {
        true => xs
        false => appendThrough(listAppend(xs, next))(next + 1 )(last)
    }

/// classify exercises exact-length, singleton, pair, and head-tail list patterns.
fn classify(xs: List<int>) = match xs {
    [] => "empty"
    [single] => "one(${single})"
    [first, second] => "two(${first},${second})"
    [head, ...tail] => "many head=${head} rest=${listLength(tail)}"
}

/// sumBy proves recursive head-tail destructuring retains every element by
/// adding each element's weight to the weights of the rest ([TYPE-LIST]).
fn sumBy(xs, weight) = match xs {
    [] => 0
    [head, ...tail] => weight(head) + sumBy(tail, weight)
}

/// identity weighs an element as itself, so both sums share one callback.
fn identity(x) = x

/// sumList weighs every int element as itself.
fn sumList(xs) = sumBy(xs, identity)

/// restLen exercises a wildcard prefix followed by a captured list tail.
fn restLen(xs: List<int>) = match xs {
    [_, _second, ...rest] => listLength(rest)
    _ => 0
}

/// encodeIteration folds callback order into a base-100 integer through a handled
/// effect, pinning forEachList's in-order traversal ([BUILTIN-LIST-FOREACH]).
fn encodeIteration(xs) = {
    mut encoded = 0
    handle IterationProbe {
        observe value => { encoded = encoded * 100 + value  }
    }
    forEachList(xs, fn(value) => perform IterationProbe.observe(value))
    encoded
}

/// constructionAndIdentityCase preserves all legacy construction, identity, reverse, prepend, and contains observations.
fn constructionAndIdentityCase() = {
    let empty = List()
    let a = aListFixture()
    let b = bListFixture()
    let reversed = listReverse(a)
    let restored = listReverse(reversed)
    let prepended = listPrepend(a, 0)
    let concatenated = listConcat(a, b)
    let emptyPlusA = empty + a
    let aPlusEmpty = a + empty
    let doubledA = a + a
    let abPlusA = a + b + a

    // Every legacy length observation remains an independent assertion.
    checkAll("legacy construction and operation lengths", [answersHold(lengthOf, [empty, a, b, reversed, restored, concatenated, listConcat(empty, a), listConcat(a, empty), a + a, a + b + a, prepended, a], [0, 3, 2, 3, 3, 5, 3, 3, 6, 8, 4, 3])])

    // Constituent checks ensure the old length-only observations cannot hide corrupt contents.
    checkAll("construction and reverse contents", [allElementsAre([a, b, reversed, restored, prepended], [[1, 2, 3], [10, 20], [3, 2, 1], [1, 2, 3], [0, 1, 2, 3]], (0 - 999))])

    // Concatenation identities and the operator alias are checked at their seams and endpoints.
    checkAll("concat identities and boundaries", [
        allRowsHold([concatenated, abPlusA], [[0, 2, 3, 4], [5, 7]], [[1, 3, 10, 20], [1, 3]], (0 - 999)),
        intAt(emptyPlusA, 0) == 1,
        intAt(aPlusEmpty, 2) == 3,
        intAt(doubledA, 3) == 1
    ])

    // All three legacy contains results survive alongside additional positive and
    // endpoint checks ([BUILTIN-LIST-CONTAINS]).
    checkAll("contains behavior", [
        membershipHolds(a, [2, 1, 3], [99]),
        noneListed(List(), [1]),
        allListed(concatenated, [10, 20]),
        noneListed(prepended, [99])
    ])
}

/// iterationAndPersistenceCase preserves callback order plus every generation and branch observation.
fn iterationAndPersistenceCase() = {
    let a = aListFixture()
    let reversed = listReverse(a)
    let b = bListFixture()
    let combined = a + b
    let g0 = List()
    let g1 = listAppend(g0, 10)
    let g2 = listAppend(g1, 20)
    let g3 = listAppend(g2, 30)
    let g4 = listAppend(g3, 40)
    let g5 = listAppend(g4, 50)
    let x = listAppend(g3, 999)
    let y = listAppend(g3, 888)
    let y2 = listAppend(y, 777)

    // Callback encodings preserve every legacy forEachList sequence and its exact order.
    checkAll("forEachList iteration order", [
        encodeIteration(a) == 10203,
        encodeIteration(reversed) == 30201,
        encodeIteration(combined) == 102031020
    ])

    // One condition per formerly printed iteration value keeps the golden observations explicit.
    checkAll("iteration constituent values", [allElementsAre([a, reversed, combined], [[1, 2, 3], [3, 2, 1], [1, 2, 3, 10, 20]], (0 - 999))])

    // The six generation lengths, retained g2 length, and all branch lengths mirror the old golden.
    checkAll("persistent generation and branch lengths", [answersHold(lengthOf, [g0, g1, g2, g3, g4, g5, g2, x, y, y2, g3], [0, 1, 2, 3, 4, 5, 2, 4, 4, 5, 3])])

    // Added content checks prove later generations and sibling branches do not mutate their ancestors.
    checkAll("persistent generation and branch contents", [
        membershipHolds(g0, [], [10]),
        membershipHolds(g1, [10], [20]),
        membershipHolds(g2, [10, 20], [30, 50]),
        membershipHolds(g5, [10, 50], []),
        membershipHolds(x, [999], [888]),
        membershipHolds(y, [888], [999, 777]),
        membershipHolds(y2, [777], []),
        membershipHolds(g3, [], [999, 888, 777]),
        intAt(g5, 4) == 50,
        intAt(y2, 3) == 888,
        intAt(y2, 4) == 777
    ])
}

/// tailBoundaryCase retains the 10/20/30/35 generations and probes both sides of the 32-element tail boundary.
fn tailBoundaryCase() = {
    let t = appendThrough(List())(1)(10)
    let t2 = appendThrough(t)(11)(20)
    let t3 = appendThrough(t2)(21)(30)
    let t4 = appendThrough(t3)(31)(35)
    let reversed = listReverse(t4)
    let doubled = listConcat(t4, t4)

    // All six legacy tail-boundary length observations remain independent.
    checkAll("tail boundary legacy lengths", [answersHold(lengthOf, [t, t2, t3, t4, reversed, doubled], [10, 20, 30, 35, 35, 70])])

    // Boundary indices assert actual content before, at, and after the 32-element trie tail split.
    checkAll("tail boundary contents", [
        allRowsHold([t, t2, t4, reversed, doubled], [[0, 9], [10, 19], [30, 31, 32, 34], [0, 2, 3, 34], [34, 35, 69]], [[1, 10], [11, 20], [31, 32, 33, 35], [35, 33, 32, 1], [35, 1, 35]], (0 - 999)),
        intAt(t3, 29) == 30,
        listLength(t3) == 30,
        noneListed(t3, [31]),
        structuralEquals([sumList(t), sumList(t4)], [55, 630])
    ])
}

/// indexingPatternsAndDispatchCase preserves Result indexing, list patterns, recursion, and receiver-directed builtins.
fn indexingPatternsAndDispatchCase() = {
    let commands = ["echo hello", "echo world", "echo test"]
    let empty: List<string> = []
    let a = aListFixture()
    let b = bListFixture()
    let singleton = listAppend(List(), 7)
    let short = listAppend(List(), 9)
    let pair = listAppend(short, 8)
    let four = grownBy(pair, [7, 6])
    let patternFour = grownBy(List(), [4, 5, 6, 7])
    let t = appendThrough(List())(1)(10)
    let dispatchFive = grownBy(List(), [1, 2, 3, 4, 5])
    let dispatchTen = listConcat(dispatchFive, dispatchFive)
    let dispatchTwenty = listConcat(dispatchTen, dispatchTen)
    let dispatchThirty = listConcat(dispatchTwenty, dispatchTen)
    let dispatchThirtyFive = listConcat(dispatchThirty, dispatchFive)

    // Successful and failing index paths retain all four legacy observations and exact failure reasons.
    checkAll("list index Result behavior", [
        (commands[0] ?: "missing") == "echo hello",
        (commands[2] ?: "missing") == "echo test",
        oobAt(commands, 5),
        oobAt(empty, 0),
        (commands[1] ?: "missing") == "echo world",
        structuralEquals([listLength(commands), listLength(empty)], [3, 0])
    ])

    // Every legacy classify, recursive sum, and wildcard-rest result remains directly asserted.
    checkAll("list pattern and recursion results", [
        answersHold(classify, [List(), b, a, singleton, patternFour], ["empty", "two(10,20)", "many head=1 rest=2", "one(7)", "many head=4 rest=3"]),
        answersHold(sumList, [a, t], [6, 55]),
        answersHold(restLen, [a, short, pair, four], [1, 0, 0, 2])
    ])

    // The same patterns reached through a LITERAL argument. A callee cannot tell
    // which list layout it received — its parameter is one `i8*` either way — and
    // `osprey_list_get`/`_drop` need a real OspreyList, so every one of these
    // SEGFAULTED before the literal was rebuilt at the call boundary.
    // `osprey_list_length` masked it by reading both layouts' shared leading
    // `i64`, which is why the length-only assertions above never caught it.
    checkAll("list patterns bind through a literal argument", [
        answersHold(classify, [[9], [9, 8], [9, 8, 7]], ["one(9)", "two(9,8)", "many head=9 rest=2"]),
        answersHold(sumList, [[1, 2, 3], [5]], [6, 5]),
        answersHold(restLen, [[1, 2, 3, 4], [1]], [2, 0])
    ])

    // The old composite bare-length row is split into one condition per receiver.
    // A flat list literal is its own layout, distinct from both an OspreyList
    // handle and a string: it used to reach `osp_strlen`, which counted the
    // length word's bytes and answered 1 for any list of 1..=255 elements.
    checkAll("receiver-directed length dispatch", [structuralEquals([length(a), length(dispatchThirtyFive), length("abcd"), length(empty), length(""), length(commands), length(lines("a\nb\nc"))], [3, 35, 4, 0, 0, 3, 3])])

    // The old composite bare-isEmpty row is split and extended across derived lists.
    checkAll("receiver-directed isEmpty dispatch", [structuralEquals([isEmpty(empty), isEmpty(a), isEmpty(""), isEmpty("abcd"), isEmpty(listReverse(a)), isEmpty(listConcat(empty, empty)), isEmpty(commands)], [true, false, true, false, false, true, false])])

    // A flat list literal is a third layout, distinct from both an OspreyList
    // handle and a string. `+` used to hand `osprey_list_concat` the literal's
    // foreign header and SEGFAULT when exactly one side was a literal, and fall
    // through to integer arithmetic ("expected an integer") when both were. Each
    // operand is normalised to a runtime list first, so all four combinations of
    // literal and handle concatenate and keep their order.
    checkAll("list literal and runtime handle concatenate in either position", [
        answersHold(lengthOf, [commands + commands, commands + empty, empty + commands], [6, 3, 3]),
        answersHold(lengthOf, [a + [7, 8], [7, 8] + a], [5, 5]),
        listContains(commands + empty, "echo test"),
        !listContains(empty + commands, "echo missing"),
        allRowsHold([[7, 8] + a, a + [7, 8]], [[0, 2], [3, 4]], [[7, 1], [7, 8]], (0 - 999)),
        length([7, 8] + a) == 5
    ])
}

// Register the construction, identity, and content scenario. The testing
// prelude supplies exactArithmetic beside every program that names it.
test("lists construct, reverse, prepend, concatenate, and retain contents", fn() => exactArithmetic(constructionAndIdentityCase))

// Register the traversal, persistence, and branching scenario.
exactTests([
    { name: "list iteration and persistent branches retain order and isolation", work: iterationAndPersistenceCase },
    // Register the 32-element structural boundary scenario.
    { name: "lists preserve content across the 32-element tail boundary", work: tailBoundaryCase },
    // Register Result indexing, patterns, recursion, and builtin dispatch together.
    { name: "list indexing, patterns, recursion, and receiver dispatch compose", work: indexingPatternsAndDispatchCase }
])

/// [BUILTIN-LIST-GET] declares `listGet(list: List<T>, index: int) -> Result<T, Error>`
/// and says it is "equivalent to `list[index]`", with an out-of-range index
/// returning `Error`. `T` is the element type, so a string list yields the
/// string, a float list the float, a bool list the bool and a record list the
/// whole record — never the raw storage word behind it. Every existing case
/// above indexes an `int` list, where a word and a value are indistinguishable,
/// which is exactly how issue #211 survived.
fn typedElementRetrievalCase() = {
    let words = wordTriple()
    let ratios = ratioTriple()
    let flags = [true, false, true]
    let slots = leftRightSlots()
    let missingSlot = sentinelSlot()
    let firstSlot = elementOr(slots, 0, missingSlot)
    let secondSlot = elementOr(slots, 1, missingSlot)
    let pastEndSlot = elementOr(slots, 2, missingSlot)

    // A string element comes back as its own string, at every index, through
    // both spellings the spec calls equivalent [BUILTIN-LIST-GET].
    checkAll("string elements survive listGet", [
        elementsAre(words, ["alpha", "beta", "gamma"], "none"),
        structuralEquals([words[0] ?: "none", words[1] ?: "none", words[2] ?: "none"], ["alpha", "beta", "gamma"]),
        structuralEquals([listGet(words, 0) ?: "none", listGet(words, 1) ?: "none", listGet(words, 2) ?: "none"], [words[0] ?: "other", words[1] ?: "other", words[2] ?: "other"]),
        structuralEquals([length(elementOr(words, 0, "")), length(elementOr(words, 1, "")), length(elementOr(words, 2, ""))], [5, 4, 5]),
        "${elementOr(words, 0, "none")}-${elementOr(words, 2, "none")}" == "alpha-gamma",
        contains(elementOr(words, 1, "none"), "et"),
        !contains(elementOr(words, 1, "none"), "alpha"),
        spans(elementOr(words, 2, "none"), "gam", "mma"),
        toUpperCase(elementOr(words, 0, "none")) == "ALPHA",
        rowsHold(words, [3, 99], ["past end", "past end"], "past end"),
        (words[3] ?: "past end") == "past end"
    ])

    // The same rule holds through every persistent producer: a rebuilt list
    // still yields strings, not the words its cells happen to hold
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-PREPEND], [BUILTIN-LIST-APPEND],
    // [BUILTIN-LIST-CONCAT]).
    checkAll("string elements survive every list producer", [
        allRowsHold([listReverse(words), listPrepend(words, "zero"), listAppend(words, "delta"), words + ["delta"], ["zero"] + words], [[0, 2], [0, 1], [3, 0], [3], [0, 1]], [["gamma", "alpha"], ["zero", "alpha"], ["delta", "alpha"], ["delta"], ["zero", "alpha"]], "none"),
        structuralEquals([listLength(listAppend(words, "delta")), listLength(listPrepend(words, "zero"))], [4, 4]),
        membershipHolds(words, ["beta"], ["delta"]),
        listContains(listAppend(words, "delta"), "delta"),
        elementOr(listReverse(listReverse(words)), 1, "none") == "beta"
    ])

    // A float element keeps its IEEE value; a bool element keeps true/false.
    checkAll("float and bool elements survive listGet", [
        elementsAre(ratios, [0.5, 1.25, 2.75], 0.0),
        (ratios[1] ?: 0.0) == 1.25,
        elementOr(ratios, 0, 0.0) + elementOr(ratios, 1, 0.0) == 1.75,
        elementOr(ratios, 2, 0.0) - elementOr(ratios, 0, 0.0) == 2.25,
        elementOr(ratios, 1, 0.0) * 2.0 == 2.5,
        rowsHold(ratios, [9], [9.5], 9.5),
        elementOr(listReverse(ratios), 0, 0.0) == 2.75,
        listLength(ratios) == 3,
        structuralEquals([elementOr(flags, 0, false), elementOr(flags, 1, true), elementOr(flags, 2, false)], [true, false, true]),
        (flags[0] ?: false),
        !(flags[1] ?: true),
        elementOr(flags, 0, false) == elementOr(flags, 2, true),
        elementOr(flags, 0, false) != elementOr(flags, 1, true),
        !elementOr(flags, 7, false),
        elementOr(listReverse(flags), 1, true) == false,
        listLength(flags) == 3
    ])

    // A record element comes back whole: every field of the stored record is
    // readable off the retrieved one, and the out-of-range case still takes
    // the declared `Error` branch rather than fabricating a record.
    checkAll("record elements survive listGet whole", [
        slotReads(firstSlot, "left", 1.5, true),
        slotReads(secondSlot, "right", 2.5, false),
        structuralEquals([firstSlot.label != secondSlot.label, firstSlot.weight != secondSlot.weight, firstSlot.ready != secondSlot.ready], [true, true, true]),
        firstSlot.weight + secondSlot.weight == 4.0,
        structuralEquals([length(firstSlot.label), length(secondSlot.label)], [4, 5]),
        "${firstSlot.label}/${secondSlot.label}" == "left/right",
        slotReads(pastEndSlot, "missing", 0.0, false),
        structuralEquals([elementOr(listReverse(slots), 0, missingSlot).label, elementOr(listReverse(slots), 1, missingSlot).label], ["right", "left"]),
        elementOr(listAppend(slots, missingSlot), 2, firstSlot).label == "missing",
        elementOr(listPrepend(slots, missingSlot), 0, firstSlot).weight == 0.0,
        listLength(slots) == 2
    ])
}

// Register typed element retrieval across string, float, bool and record lists.
test("listGet returns the element type for every element type", exactly(typedElementRetrievalCase))

/// TranscriptProbe renders one visited element at a time, so `forEachList`'s
/// traversal order over non-integer element types is observable without stdout.
effect TranscriptProbe {
    /// Record one rendered element in traversal order.
    note: fn(string) -> Unit
}

/// shapeOf reads only the SHAPE of a list, never an element, so one function
/// pins arm selection for every element type: [TYPE-LIST-PATTERNS] says "a list
/// pattern matches exactly the listed length unless its final element is a rest
/// binder (`...name`)" and "the rest binder receives the remaining `List<T>`".
fn shapeOf(xs) = match xs {
    [] => "none"
    [_only] => "single"
    [_first, _second] => "pair"
    [_head, ...tail] => "long+${listLength(tail)}"
}

/// headOr binds the first element through a rest-binder pattern, or answers the
/// caller's fallback for the empty list [TYPE-LIST-PATTERNS].
fn headOr(xs, fallback) = match xs {
    [] => fallback
    [head, ..._tail] => head
}

/// secondOr binds a two-element prefix before the rest binder, the only place
/// the spec permits a rest binder — last, and once.
fn secondOr(xs, fallback) = match xs {
    [_first, second, ..._rest] => second
    _ => fallback
}

/// headOrWith pre-applies headOr's fallback, so answersHold can fold head rows.
fn headOrWith(fallback) = fn(xs) => headOr(xs, fallback)

/// secondOrWith pre-applies secondOr's fallback, so answersHold can fold second rows.
fn secondOrWith(fallback) = fn(xs) => secondOr(xs, fallback)

/// tailLength reports the rest binder's own length, distinguishing the empty
/// list (-1) from a singleton whose tail is empty (0).
fn tailLength(xs) = match xs {
    [] => ((0 - 1) )
    [_head, ...tail] => listLength(tail)
}

/// joinWords walks a string list through the rest binder, so a dropped,
/// duplicated or reordered element changes the transcript. The annotation is
/// load-bearing exactly as `classify`'s is: an interpolated binder does not pin
/// its own element type.
fn joinWords(xs: List<string>) = match xs {
    [] => ""
    [head, ...tail] => "${head}|${joinWords(tail)}"
}

/// lastWord recurses to the final element; the `[]` arm's string result is what
/// infers the element type, so no annotation is legal here.
fn lastWord(xs) = match xs {
    [] => "none"
    [only] => only
    [_head, ...rest] => lastWord(rest)
}

/// boolWeight turns a bool element into its counted weight through a match, so
/// both flavors spell the same lowering (ML has no boolean ternary).
fn boolWeight(flag) = match flag {
    true => 1
    false => 0
}

/// sumFloatBy reduces a float list through head/tail patterns. Float `+` is
/// total, unlike checked integer `+` ([ARITH-CHECKED]), so no `?:` appears.
fn sumFloatBy(xs, weight) = match xs {
    [] => 0.0
    [head, ...tail] => weight(head) + sumFloatBy(tail, weight)
}

/// sumFloats weighs every float element as itself.
fn sumFloats(xs) = sumFloatBy(xs, identity)

/// countTrue counts the `true` elements of a bool list through list patterns.
fn countTrue(xs) = sumBy(xs, boolWeight)

/// slotLabels proves a record element survives head/tail destructuring WHOLE:
/// the bound head is a record whose fields are all readable.
fn slotLabels(xs) = match xs {
    [] => ""
    [head, ...tail] => head.label + ">" + slotLabels(tail)
}

/// readySlots reads a second field off the same bound head, so a head bound to
/// the wrong slot cannot pass by matching only one field.
fn readySlots(xs) = sumBy(xs, fn(slot) => boolWeight(slot.ready))

/// totalWeight reads the third, float-typed field off the bound head.
fn totalWeight(xs) = sumFloatBy(xs, fn(slot) => slot.weight)

/// rowAt unwraps a nested-list element, substituting a sentinel row that appears
/// nowhere else, so the `Error` branch of [BUILTIN-LIST-GET] cannot pass as a
/// legitimate row.
fn rowAt(rows, index) = match listGet(rows, index) {
    Success { value } => value
    Error => [777]
}

/// sumInner sums every element of every inner list, exercising a `List<T>` whose
/// `T` is itself a `List<int>` ([TYPE-LIST]).
fn sumInner(xs) = sumBy(xs, sumList)

/// describeMatrix selects its arm on the OUTER list's length while reading the
/// INNER list's length [TYPE-LIST-PATTERNS].
fn describeMatrix(xs) = match xs {
    [] => "no rows"
    [only] => "one row of ${listLength(only)}"
    [first, second] => "rows ${listLength(first)}+${listLength(second)}"
    [head, ...tail] => "head ${listLength(head)} then ${listLength(tail)} more"
}

/// weave folds a running base-10 encoding, so a fold's visit ORDER is observable
/// as one integer ([BUILTIN-ITER-FOLD] "reduces an iterator to a single value").
fn weave(acc, value) = acc * 10 + value

/// twice is the [BUILTIN-ITER-MAP] callback; isEvenValue the
/// [BUILTIN-ITER-FILTER] predicate.
fn twice(n) = n * 2

fn isEvenValue(n) = (n % 2 ) == 0

/// foldRow checks one `range` fold: `step` folds every visited index into `base`.
fn foldRow(start, stop, base, step, want) = (range(start, stop) |> fold(base, step)) == want

/// weaveEach checks the base-10 encoding of `xs`'s elements read over [start, stop).
fn weaveEach(xs, fallback, start, stop, want) = foldRow(start, stop, 0, fn(acc, i) => weave(acc, elementOr(xs, i, fallback)), want)

/// sumEach checks the plain float sum of `xs`'s elements read over [start, stop).
fn sumEach(xs, fallback, start, stop, want) = foldRow(start, stop, 0.0, fn(acc, i) => acc + elementOr(xs, i, fallback), want)

/// sepEach checks the joined spelling of the visited indices, `sep`-separated.
fn sepEach(start, stop, sep, want) = foldRow(start, stop, "", fn(acc, v) => "${acc}${v}${sep}", want)

/// weaveRange checks the encoding of the visited indices themselves.
fn weaveRange(start, stop, base, want) = foldRow(start, stop, base, weave, want)

/// weaveMapped checks the encoding of `range(start, stop)` mapped through `twice` ([BUILTIN-ITER-MAP]).
fn weaveMapped(start, stop, base, want) = (range(start, stop) |> map(twice) |> fold(base, weave)) == want

/// [TYPE-LIST-PATTERNS] states a list pattern "matches exactly the listed length
/// unless its final element is a rest binder" and that "the rest binder receives
/// the remaining `List<T>`" — a rule about SHAPE that must hold for every `T`.
/// Every pattern case above matches a `List<int>`, where an element and its
/// storage word are indistinguishable (the blind spot behind issue #211). These
/// blocks re-run the same arms over `List<string>`, including empty,
/// single-character, whitespace, punctuation, digit and duplicated elements.
fn stringListPatternCase() = {
    let noWords: List<string> = []
    let solo = ["solo"]
    let duo = ["left", "right"]
    let words = wordTriple()
    let quad = ["a", "bb", "ccc", "dddd"]
    let odd = ["", " ", "a", "12", "a,b", "ab ab"]
    let dup = ["same", "same", "other", "same"]

    // Arm selection depends on written length alone, so a string list picks the
    // same arms an int list of the same length picks.
    checkAll("string list patterns select the arm for the written length", [
        answersHold(shapeOf, [noWords, solo, duo, words, quad, odd, dup, ["x"], ["x", "y"], ["x", "y", "z"], listReverse(words), listAppend(duo, "third"), listPrepend(solo, "first"), listConcat(noWords, solo), listConcat(duo, noWords), noWords + noWords], ["none", "single", "pair", "long+2", "long+3", "long+5", "long+3", "single", "pair", "long+2", "long+2", "long+2", "pair", "single", "pair", "none"]),
        answersHold(tailLength, [noWords, solo, duo, words, odd, dup], [(0 - 1), 0, 1, 2, 5, 3])
    ])

    // Each binder carries its OWN element: head, second and the fallback are
    // three distinct strings, so a binder reading the wrong slot is visible.
    checkAll("string binders carry their own element", [
        answersHold(headOrWith("empty"), [noWords, solo, duo, words, odd, dup, listReverse(words), listPrepend(words, "zero"), listAppend(words, "delta"), noWords + words, words + noWords, ["only"]], ["empty", "solo", "left", "alpha", "", "same", "gamma", "zero", "alpha", "alpha", "alpha", "only"]),
        answersHold(secondOrWith("none"), [noWords, solo, duo, words, odd, dup, listReverse(words), listReverse(quad), ["x", "y", "z"]], ["none", "none", "right", "beta", " ", "same", "beta", "ccc", "y"])
    ])

    // Recursive head/tail traversal keeps every element, in index order, once.
    // "alpha|beta|gamma|" is 5+1+4+1+5+1 = 17 bytes; the six `odd` elements are
    // 0+1+1+2+3+5 = 12 bytes plus six separators = 18.
    checkAll("recursive rest-binder traversal keeps string order", [
        answersHold(joinWords, [noWords, solo, duo, words, quad, odd, dup, listReverse(words), listReverse(dup), listAppend(words, "delta"), listPrepend(words, "zero"), duo + words, words + duo], ["", "solo|", "left|right|", "alpha|beta|gamma|", "a|bb|ccc|dddd|", "| |a|12|a,b|ab ab|", "same|same|other|same|", "gamma|beta|alpha|", "same|other|same|same|", "alpha|beta|gamma|delta|", "zero|alpha|beta|gamma|", "left|right|alpha|beta|gamma|", "alpha|beta|gamma|left|right|"]),
        joinWords(listReverse(listReverse(words))) == joinWords(words),
        joinWords(noWords + words) == joinWords(words),
        joinWords(words + noWords) == joinWords(words),
        structuralEquals([length(joinWords(words)), length(joinWords(odd)), length(joinWords(quad)), length(joinWords(dup))], [17, 18, 14, 21]),
        answersHold(lastWord, [noWords, solo, words, listReverse(words), listAppend(words, "delta")], ["none", "solo", "gamma", "alpha", "delta"])
    ])

    // String elements are compared by CONTENT for membership
    // ([BUILTIN-LIST-CONTAINS]), so the empty string is a findable element and a
    // case difference is not.
    checkAll("string element edge cases survive indexing and membership", [
        isEmpty(elementOr(odd, 0, "x")),
        structuralEquals([elementOr(odd, 0, "x"), elementOr(odd, 1, "x")], ["", " "]),
        structuralEquals([length(elementOr(odd, 0, "x")), length(elementOr(odd, 1, "x"))], [0, 1]),
        elementOr(odd, 3, "x") == "12",
        containsAll(elementOr(odd, 4, "x"), [","]),
        spans(elementOr(odd, 5, "x"), "ab", "ab"),
        containsAll(elementOr(odd, 5, "x"), [" "]),
        toUpperCase(elementOr(words, 1, "x")) == "BETA",
        toLowerCase(toUpperCase(elementOr(words, 2, "x"))) == "gamma",
        membershipHolds(odd, ["", " "], ["A"]),
        membershipHolds(dup, ["same", "other"], ["missing"]),
        noneListed(noWords, [""]),
        answersHold(lengthOf, [dup, odd, listReverse(dup)], [4, 6, 4]),
        elementOr(dup, 0, "x") == elementOr(dup, 3, "y"),
        elementOr(dup, 0, "x") != elementOr(dup, 2, "y"),
        listLength(words) == 3
    ])
}

// Register list patterns over string elements.
test("string lists destructure, iterate, and rebuild through list patterns", exactly(stringListPatternCase))

/// The same [TYPE-LIST-PATTERNS] shape rules over `List<float>` and `List<bool>`,
/// the two element types whose storage word is NOT an int. Every float used here
/// is an exact binary fraction (a multiple of 0.25), so the sums are exact and a
/// `==` on a float is a legitimate assertion. Float `+` is total; integer `+`
/// stays checked ([ARITH-CHECKED]).
fn floatAndBoolListPatternCase() = {
    let noFloats: List<float> = []
    let oneFloat = [1.5]
    let twoFloats = [0.25, 0.75]
    let ratios = ratioTriple()
    let quarters = [0.0, 0.25, 0.5, 0.75]
    let dupFloats = [2.0, 2.0, 1.0]
    let noFlags: List<bool> = []
    let allOn = [true, true, true]
    let allOff = [false, false, false]
    let mixed = [true, false, true]
    let pairOn = [true, false]

    // Arm selection and binder identity for float elements.
    checkAll("float list patterns select arms and bind elements", [
        answersHold(shapeOf, [noFloats, oneFloat, twoFloats, ratios, quarters, dupFloats], ["none", "single", "pair", "long+2", "long+3", "long+2"]),
        answersHold(headOrWith(9.5), [noFloats, oneFloat, twoFloats, ratios, quarters, listReverse(ratios)], [9.5, 1.5, 0.25, 0.5, 0.0, 2.75]),
        answersHold(secondOrWith(9.5), [noFloats, oneFloat, twoFloats, ratios, quarters], [9.5, 9.5, 0.75, 1.25, 0.25]),
        answersHold(tailLength, [noFloats, oneFloat, ratios, quarters], [(0 - 1), 0, 2, 3])
    ])

    // 0.5+1.25+2.75 = 4.5 and 0.0+0.25+0.5+0.75 = 1.5, both exact in binary, so
    // reversal and either concatenation order must reproduce them exactly
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-CONCAT]).
    checkAll("float head-tail recursion sums every element exactly once", [
        answersHold(sumFloats, [noFloats, oneFloat, twoFloats, ratios, quarters, dupFloats, listReverse(ratios), listReverse(quarters), ratios + twoFloats, twoFloats + ratios, noFloats + ratios, ratios + noFloats, ratios + ratios, listAppend(ratios, 0.5), listPrepend(ratios, 0.5), [0.25], [0.25, 0.25]], [0.0, 1.5, 1.0, 4.5, 1.5, 5.0, 4.5, 1.5, 5.5, 5.5, 4.5, 4.5, 9.0, 5.0, 5.0, 0.25, 0.5]),
        answersHold(lengthOf, [ratios, ratios + twoFloats], [3, 5]),
        membershipHolds(ratios, [1.25], [1.5]),
        listContains(dupFloats, 2.0)
    ])

    // Every bool permutation of length 0..3 is counted independently, so a
    // pattern that drops or double-counts the head cannot hide in a total.
    checkAll("bool list patterns count every permutation", [
        answersHold(shapeOf, [noFlags, [true], pairOn, mixed], ["none", "single", "pair", "long+2"]),
        answersHold(countTrue, [noFlags, [true], [false], [true, true], [true, false], [false, true], [false, false], allOn, allOff, mixed, listReverse(mixed), mixed + allOn, allOff + mixed, listAppend(mixed, false), listPrepend(mixed, false), listAppend(allOff, true)], [0, 1, 0, 2, 1, 1, 0, 3, 0, 2, 2, 5, 2, 2, 2, 1]),
        answersHold(boolWeight, [true, false], [1, 0])
    ])

    // A bool element keeps its own value through every binder and producer.
    checkAll("bool elements keep their value through binders and producers", [
        structuralEquals([headOr(noFlags, false), headOr(allOn, false), headOr(allOff, true), headOr(mixed, false), headOr(listReverse(pairOn), true)], [false, true, false, true, false]),
        structuralEquals([secondOr(mixed, true), secondOr(pairOn, true), secondOr([false, true], false), secondOr(noFlags, true)], [false, false, true, true]),
        allListed(mixed, [false, true]),
        noneListed(allOn, [false]),
        noneListed(allOff, [true]),
        answersHold(lengthOf, [mixed + allOff, listReverse(allOn)], [6, 3]),
        countTrue(mixed + allOff) == 2,
        tailLength(mixed) == 2,
        tailLength(noFlags) == ((0 - 1) )
    ])
}

// Register list patterns over float and bool elements.
test("float and bool lists destructure and recombine through list patterns", exactly(floatAndBoolListPatternCase))

/// [TYPE-LIST-PATTERNS] over `List<Slot>`. A rest-binder pattern must bind the
/// WHOLE record, not the storage word behind it, so every arm below reads more
/// than one field off the bound head. [BUILTIN-LIST-CONTAINS] adds the rule that
/// "managed handles such as nested lists and records compare by identity", so a
/// freshly built record with identical field values is NOT a member.
fn recordListPatternCase() = {
    let missingSlot = sentinelSlot()
    let soloSlot = Slot { label: "solo", weight: 3.0, ready: true }
    let noSlots: List<Slot> = []
    let oneSlot = [soloSlot]
    let slots = leftRightSlots()
    let trio = listAppend(slots, Slot { label: "extra", weight: 4.0, ready: true })
    let headOf = headOrWith(missingSlot)
    let secondOf = secondOrWith(missingSlot)
    let heads = [noSlots, oneSlot, slots, listReverse(slots)]
    let seconds = [noSlots, oneSlot, slots, trio]

    // The bound head is a whole record: three fields of two different types are
    // readable off it, and the empty-list arm returns the caller's own record.
    checkAll("record list patterns bind whole records", [
        answersHold(shapeOf, [noSlots, oneSlot, slots, trio], ["none", "single", "pair", "long+2"]),
        answersHold(fn(xs) => headOf(xs).label, heads, ["missing", "solo", "left", "right"]),
        answersHold(fn(xs) => headOf(xs).weight, heads, [0.0, 3.0, 1.5, 2.5]),
        answersHold(fn(xs) => headOf(xs).ready, heads, [false, true, true, false]),
        answersHold(fn(xs) => secondOf(xs).label, seconds, ["missing", "missing", "right", "right"]),
        secondOf(slots).weight == 2.5,
        !secondOf(slots).ready,
        headOf(slots).label != secondOf(slots).label,
        structuralEquals([tailLength(slots), tailLength(trio)], [1, 2])
    ])

    // Recursion over the rest binder reaches every record, in order, once.
    // "left>right>extra>" is 5+6+6 = 17 bytes; weights 1.5+2.5+4.0 = 8.0.
    checkAll("record fields survive head-tail recursion", [
        answersHold(slotLabels, [noSlots, oneSlot, slots, trio, listReverse(slots), listReverse(trio), listPrepend(slots, soloSlot), noSlots + slots], ["", "solo>", "left>right>", "left>right>extra>", "right>left>", "extra>right>left>", "solo>left>right>", "left>right>"]),
        length(slotLabels(trio)) == 17,
        answersHold(readySlots, [noSlots, oneSlot, slots, trio, listReverse(trio), listPrepend(slots, missingSlot)], [0, 1, 1, 2, 2, 1]),
        answersHold(totalWeight, [noSlots, oneSlot, slots, trio, listReverse(trio), slots + slots], [0.0, 3.0, 4.0, 8.0, 8.0, 8.0])
    ])

    // Building `trio` left `slots` untouched. A record has no decided `==`
    // ([BOOL-EQUALITY]), so membership is asked of a key, the label.
    checkAll("record lists stay persistent and are searched by key", [
        answersHold(lengthOf, [slots, trio, listAppend(trio, missingSlot)], [2, 3, 4]),
        slotLabels(slots) == "left>right>",
        readySlots(slots) == 1,
        totalWeight(slots) == 4.0,
        containsAll(slotLabels(oneSlot), ["${soloSlot.label}>"]),
        containsAll(slotLabels(listPrepend(slots, soloSlot)), ["${soloSlot.label}>"]),
        containsAll(slotLabels(slots), ["left>"]),
        containsNone(slotLabels(slots), ["${soloSlot.label}>", "${missingSlot.label}>"]),
        containsNone(slotLabels(noSlots), ["${missingSlot.label}>"]),
        elementOr(trio, 2, missingSlot).label == "extra",
        elementOr(trio, 2, missingSlot).weight == 4.0,
        elementOr(trio, 2, missingSlot).ready,
        elementOr(trio, 3, missingSlot).label == "missing",
        elementOr(slots, 2, missingSlot).label == "missing",
        elementOr(noSlots, 0, missingSlot).label == "missing",
        isEmpty(noSlots),
        !isEmpty(slots),
        length(slots) == 2,
        length(noSlots) == 0
    ])
}

// Register list patterns over record elements.
test("record lists destructure whole through list patterns", exactly(recordListPatternCase))

/// A `List<T>` whose `T` is itself a `List<int>` ([TYPE-LIST]). [BUILTIN-LIST-GET]
/// must hand back the inner LIST, so every retrieval here is indexed again or
/// summed; a raw storage word would have neither a length nor elements.
/// [BUILTIN-LIST-CONTAINS] again applies its identity rule to nested lists.
fn nestedListCase() = {
    let emptyRow: List<int> = []
    let rows = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    let oneRow = [[9, 9, 9]]
    let twoRows = [[1], [2, 3]]
    let withEmptyRow = listAppend(rows, emptyRow)
    let grown = listAppend(rows, [10, 11])
    let firstRow = rowAt(rows, 0)
    let biggerFirstRow = listAppend(firstRow, 99)
    let sentinelProbe = rowAt(rows, 9)

    // Row sums: [1,2]=3, [3,4,5]=12, [6,7,8,9]=30, so sumInner(rows) = 45 and
    // sumInner(grown) = 45 + 21 = 66.
    checkAll("nested list elements come back as lists", [
        listLength(rows) == 3,
        listLength(firstRow) == 2,
        sumList(firstRow) == 3,
        elementsAre(firstRow, [1, 2], 0),
        answersHold(lengthOf, [rowAt(rows, 1), rowAt(rows, 2)], [3, 4]),
        structuralEquals([sumList(rowAt(rows, 1)), sumList(rowAt(rows, 2))], [12, 30]),
        rowsHold(rowAt(rows, 1), [2], [5], 0),
        intAt(rowAt(rows, 2), 3) == 9,
        elementOr(rowAt(rows, 2), 4, 77) == 77,
        structuralEquals([sumList(sentinelProbe), listLength(sentinelProbe)], [777, 1]),
        answersHold(sumInner, [rows, oneRow, twoRows, withEmptyRow, grown], [45, 27, 6, 45, 66]),
        listLength(withEmptyRow) == 4,
        isEmpty(rowAt(withEmptyRow, 3)),
        listLength(rowAt(withEmptyRow, 3)) == 0
    ])

    // The outer arm is chosen by the outer length while the message reports the
    // inner length, so mixing the two up is visible in every arm.
    checkAll("nested list patterns read outer arm and inner length", [
        answersHold(shapeOf, [oneRow, twoRows, rows, grown], ["single", "pair", "long+2", "long+3"]),
        answersHold(describeMatrix, [oneRow, twoRows, rows, grown, withEmptyRow, listReverse(rows)], ["one row of 3", "rows 1+2", "head 2 then 2 more", "head 2 then 3 more", "head 2 then 3 more", "head 4 then 2 more"]),
        answersHold(lengthOf, [headOr(rows, emptyRow), headOr(listReverse(rows), emptyRow), secondOr(twoRows, emptyRow)], [2, 4, 2]),
        structuralEquals([sumList(headOr(rows, emptyRow)), sumList(secondOr(rows, emptyRow)), sumList(secondOr(oneRow, emptyRow))], [3, 12, 0]),
        tailLength(rows) == 2,
        tailLength(oneRow) == 0
    ])

    // Appending to a retrieved row builds a NEW row and leaves the matrix alone:
    // the stored row keeps its own contents ([BOOL-EQUALITY] decides no `==`
    // for lists, so the rows are compared by their sums).
    checkAll("nested lists stay isolated when a retrieved row grows", [
        answersHold(lengthOf, [rows, grown, listReverse(rows), rows + rows], [3, 4, 3, 6]),
        answersHold(lengthOf, [firstRow, biggerFirstRow], [2, 3]),
        sumInner(rows) == 45,
        sumList(biggerFirstRow) == 102,
        sumList(firstRow) == 3,
        sumList(rowAt(rows, 0)) != sumList(biggerFirstRow),
        sumList(rowAt(rows, 0)) == sumList([1, 2]),
        sumInner(listReverse(rows)) == 45,
        structuralEquals([sumList(rowAt(listReverse(rows), 0)), sumList(rowAt(listReverse(rows), 2)), sumList(rowAt(rows + rows, 3))], [30, 3, 3]),
        sumInner(rows + rows) == 90,
        sumInner(rows) == 45
    ])
}

// Register nested-list indexing, patterns and isolation.
test("nested lists index, destructure, and stay isolated", exactly(nestedListCase))

/// [BUILTIN-LIST-FOREACH] states `forEachList` "calls `function` once per element
/// in index order". One handler owns the transcript, so the assertions between
/// the traversals are INTERMEDIATE observations: a lost or reordered element
/// cannot hide behind a correct final string. [BUILTIN-ITER-RANGE],
/// [BUILTIN-ITER-MAP], [BUILTIN-ITER-FILTER], [BUILTIN-ITER-FOLD] and
/// [BUILTIN-ITER-FUSION] are pinned the same way, with a positional base-10
/// encoding that changes if the visit order changes.
fn typedIterationOrderCase() = {
    let noWords: List<string> = []
    let words = wordTriple()
    let flags = [true, false]
    let counts = [7, 8, 9]
    let ratios = ratioTriple()
    let missingSlot = sentinelSlot()
    let slots = leftRightSlots()
    mut log = ""

    handle TranscriptProbe {
        note text => { log = "${log}${text}|" }
    }

    /// visitsAndSeals traverses `xs` through `spell`, then checks the row the
    /// traversal appended to the one handler-owned transcript.
    let visitsAndSeals = fn(xs, spell, title, expected, size, tail, reversed, seam) => {
        noteEach(xs, spell)
        sealedRow(log, title, expected, size, tail, reversed, seam)
    }
    noteEach(noWords, fn(word) => word)

    // "Once per element" over zero elements is zero calls.
    checkAll("forEachList over an empty list records nothing", [
        log == "",
        length(log) == 0,
        isEmpty(log),
        isEmpty(noWords),
        listLength(noWords) == 0,
        shapeOf(noWords) == "none",
        tailLength(noWords) == ((0 - 1) )
    ])

    noteEach(words, fn(word) => word)

    // 5+1+4+1+5+1 = 17 bytes, and the reversed spelling must NOT appear.
    checkAll("forEachList visits string elements in index order", [
        log == "alpha|beta|gamma|",
        length(log) == 17,
        spans(log, "alpha|", "gamma|"),
        containsAll(log, ["|beta|"]),
        containsNone(log, ["gamma|beta|"]),
        log == joinWords(words)
    ])

    // 17 + "true|" (5) + "false|" (6) = 28.
    visitsAndSeals(flags, fn(flag) => "${flag}", "forEachList visits bool elements in index order", "alpha|beta|gamma|true|false|", 28, "true|false|", "false|true|", "gamma|true|")

    // 28 + "7|8|9|" (6) = 34.
    visitsAndSeals(counts, fn(count) => "${count}", "forEachList visits int elements in index order", "alpha|beta|gamma|true|false|7|8|9|", 34, "7|8|9|", "9|8|7|", "false|7|")

    // 34 + "left|" (5) + "right|" (6) = 45.
    visitsAndSeals(slots, fn(slot) => slot.label, "forEachList visits record elements in index order", "alpha|beta|gamma|true|false|7|8|9|left|right|", 45, "left|right|", "right|left|", "9|left|")

    noteEach(listReverse(words), fn(word) => word)

    // 45 + 17 = 62; the derived list is traversed, the source is not.
    checkAll("forEachList follows the derived list, not its source", [
        log == "alpha|beta|gamma|true|false|7|8|9|left|right|gamma|beta|alpha|",
        length(log) == 62,
        spans(log, "alpha|beta|gamma|", "gamma|beta|alpha|"),
        containsAll(log, ["right|gamma|"]),
        joinWords(words) == "alpha|beta|gamma|",
        joinWords(listReverse(words)) == "gamma|beta|alpha|"
    ])

    // A fold over `range(0, n)` reproduces index order independently of
    // forEachList, so the two mechanisms cross-check each other.
    // weave(0,7)=7, weave(7,8)=78, weave(78,9)=789.
    checkAll("range folds reproduce list order for every element type", [
        foldRow(0, 3, "", fn(acc, i) => "${acc}${elementOr(words, i, "?")}|", "alpha|beta|gamma|"),
        weaveEach(counts, 0, 0, 3, 789),
        weaveEach(listReverse(counts), 0, 0, 3, 987),
        weaveEach(counts, 0, 1, 3, 89),
        weaveEach(counts, 0, 0, 0, 0),
        foldRow(0, 2, 0, fn(acc, i) => acc + boolWeight(elementOr(flags, i, false)), 1),
        sumEach(ratios, 0.0, 0, 2, 1.75),
        sumEach(ratios, 0.0, 0, 3, 4.5),
        foldRow(0, 2, "", fn(acc, i) => "${acc}${elementOr(slots, i, missingSlot).label}>", "left>right>"),
        foldRow(0, 5, 0, fn(acc, i) => acc + i, 10),
        weaveRange(5, 5, 99, 99),
        weaveRange(1, 6, 0, 12345),
        sepEach(0, 3, ";", "0;1;2;")
    ])

    // map/filter/fold chains over a range fuse into one loop
    // ([BUILTIN-ITER-FUSION]) but must still produce the documented order.
    // 1..5 doubled is 2,4,6,8,10 -> 24690; evens of 1..9 doubled are 4,8,12,16
    // -> 4, 48, 492, 4936.
    checkAll("map, filter and fold pipelines keep the documented order", [
        weaveMapped(1, 6, 0, 24690),
        (range(1, 6) |> filter(isEvenValue) |> fold(0, weave)) == 24,
        (range(1, 10) |> filter(isEvenValue) |> map(twice) |> fold(0, weave)) == 4936,
        (range(1, 6) |> map(twice) |> filter(isEvenValue) |> fold(0, weave)) == 24690,
        (range(1, 6) |> map(twice) |> fold(0, fn(a, b) => a + b)) == 30,
        (range(1, 6) |> filter(isEvenValue) |> fold(0, fn(a, b) => a + b)) == 6,
        weaveMapped(0, 4, 0, 246),
        weaveMapped(0, 1, 7, 70),
        weaveMapped(2, 2, 5, 5),
        (range(1, 4) |> map(twice) |> fold("", fn(acc, v) => "${acc}${v},")) == "2,4,6,",
        sepEach(1, 4, ",", "1,2,3,"),
        answersHold(twice, [0, 21], [0, 42]),
        isEvenValue(0),
        !isEvenValue(7),
        isEvenValue(8),
        weave(0, 5) == 5,
        weave(12, 3) == 123
    ])
}

// Register traversal order across every element type and the iterator surface.
test("forEachList and range pipelines visit every element type in order", exactly(typedIterationOrderCase))

/// [BUILTIN-LIST-GET] says an "out-of-range index returns `Error`", and
/// [TYPE-LIST] says "index access is bounds-checked". These blocks walk the
/// boundary from both sides on every element type: the first index, the last
/// index, one past the end, far past the end, and a negative index. The string
/// list is grown to 40 elements so indices 31/32/33 straddle the 32-element
/// structural tail split for a NON-int element type.
fn boundaryIndexCase() = {
    let five = ["s0", "s1", "s2", "s3", "s4"]
    let ten = five + five
    let twenty = ten + ten
    let forty = twenty + twenty
    let noWords: List<string> = []
    let words = wordTriple()
    let ratios = ratioTriple()
    let marks = [true, false]
    let missingSlot = sentinelSlot()
    let slots = leftRightSlots()
    let negIndex = (0 - 1)
    let farNegIndex = (0 - 1000)
    let lastIndex = (listLength(forty) - 1)

    // `forty` repeats "s0".."s4", so the element at index i is "s${i % 5}":
    // index 30 -> "s0", 31 -> "s1", 32 -> "s2" (the tail split), 39 -> "s4".
    checkAll("string list index boundaries around the 32-element tail", [
        answersHold(lengthOf, [five, ten, twenty, forty], [5, 10, 20, 40]),
        lastIndex == 39,
        allRowsHold([forty, listReverse(forty), listAppend(forty, "tail"), listPrepend(forty, "head")], [[0, 4, 5, 30, 31, 32, 33, lastIndex], [0, 7, 39], [40, 32], [0, 33]], [["s0", "s4", "s0", "s0", "s1", "s2", "s3", "s4"], ["s4", "s2", "s0"], ["tail", "s2"], ["head", "s2"]], "?"),
        rowsHold(forty, [40, 1000, negIndex, farNegIndex], ["past", "past", "past", "past"], "past"),
        listLength(listAppend(forty, "tail")) == 41,
        listLength(forty) == 40
    ])

    // The Error branch is taken for every element type. Asserting BOTH fallbacks
    // for the bool list proves the fallback was used rather than a stored value.
    checkAll("out-of-range indexing takes the Error branch for every type", [
        oobAt(words, negIndex),
        oobAt(forty, 1000),
        oobAt(noWords, 0),
        allRowsHold([words, noWords], [[3, negIndex, 2], [0, negIndex]], [["past", "past", "gamma"], ["past", "past"]], "past"),
        rowsHold(ratios, [3, negIndex, 2], [9.5, 9.5, 2.75], 9.5),
        elementOr(marks, 2, false) == false,
        elementOr(marks, 2, true) == true,
        elementOr(marks, negIndex, true) == true,
        elementOr(marks, 1, true) == false,
        elementOr(slots, 2, missingSlot).label == "missing",
        elementOr(slots, negIndex, missingSlot).label == "missing",
        elementOr(slots, 1, missingSlot).label == "right",
        isEmpty(noWords),
        listLength(noWords) == 0
    ])

    // Every doubling keeps the repeating pattern, so a rebuilt list indexes the
    // same way its source did. "s0|s1|s2|s3|s4|" is 5 * 3 = 15 bytes.
    checkAll("doubled and derived lists index consistently", [
        joinWords(five) == "s0|s1|s2|s3|s4|",
        structuralEquals([length(joinWords(five)), length(joinWords(ten)), length(joinWords(twenty)), length(joinWords(forty))], [15, 30, 60, 120]),
        shapeOf(forty) == "long+39",
        tailLength(forty) == 39,
        headOr(forty, "?") == "s0",
        secondOr(forty, "?") == "s1",
        answersHold(lastWord, [five, ten], ["s4", "s4"]),
        membershipHolds(forty, ["s3"], ["s5"]),
        allListed(five, ["s0"]),
        noneListed(noWords, ["s0"]),
        allRowsHold([ten, twenty, ten + five, five + ten], [[9], [19, 10], [10], [4, 5]], [["s4"], ["s4", "s0"], ["s0"], ["s4", "s0"]], "?"),
        listLength(ten + five) == 15
    ])
}

// Register bounds checking across element types and the tail boundary.
test("list index boundaries are checked on every element type", exactly(boundaryIndexCase))

/// foldSeedCase pins [BUILTIN-ITER-FOLD]: a list-literal seed takes the runtime
/// representation once, before the loop, so every iteration's listAppend and
/// listConcat reads a runtime list. Left flat, the second iteration read the
/// literal's header as a trie and crashed.
/// grownFrom folds listAppend over `range(start, stop)` into `seed`, so a
/// list-literal seed is settled once before the loop ([BUILTIN-ITER-FOLD]).
fn grownFrom(start, stop, seed, f) = range(start, stop) |> fold(seed, fn(acc, i) => listAppend(acc, f(i)))

fn foldSeedCase() = {
    let squares = grownFrom(1, 5, [], fn(i) => i * i)
    let words = grownFrom(0, 3, [], fn(i) => "w${i}")
    let doubled = range(0, 3) |> fold([], fn(acc, i) => listConcat(acc, [i, i]))
    let seeded = grownFrom(3, 6, [1, 2], identity)
    checkAll("fold over a list-literal seed", [
        answersHold(lengthOf, [squares, doubled, seeded], [4, 6, 5]),
        answersHold(sumList, [squares, doubled, seeded], [30, 6, 15]),
        intAt(squares, 3) == 16,
        listLength(words) == 3,
        elementOr(words, 2, "?") == "w2",
        joinWords(words) == "w0|w1|w2|",
        elementOr(doubled, 4, (0 - 1)) == 2,
        rowsHold(seeded, [0, 4], [1, 5], 0)
    ])
}

/// linesIndexCase pins [BUILTIN-LIST-GET] on a bound string list: the result
/// of lines is settled into the runtime layout once at the binding, so ten
/// thousand indexed reads cost ten thousand reads, not ten thousand copies of
/// two thousand strings. "line i" is 6, 7, 8 or 9 bytes by decade, 16890 per
/// pass, and the reads make five passes.
fn lineAfter(acc, i) = match i == 0 {
    true => "line 0"
    false => acc + "\nline ${i}"
}

fn linesIndexCase() = {
    let text = range(0, 2000) |> fold("", lineAfter)
    let rows = lines(text)
    let total = range(0, 10000) |> fold(0, fn(acc, i) => acc + byteLength(elementOr(rows, i % 2000, "")))
    checkAll("a bound string list is read by index in constant time", [listLength(rows) == 2000, elementOr(rows, 1999, "?") == "line 1999", total == 84450])
}

exactTests([
    { name: "fold rebuilds a list-literal seed once before the loop", work: foldSeedCase },
    { name: "a bound string list is read by index in constant time", work: linesIndexCase }
])
