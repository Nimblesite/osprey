// Assertion-driven migration of the persistent List golden example.

/// IterationProbe records callback values so forEachList order is testable without stdout.
effect IterationProbe {
    /// Record one callback value so traversal order is testable.
    observe: fn(int) -> Unit
}

/// Slot is a record element, so `listGet` must hand back the whole record.
type Slot = { label: string, weight: float, ready: bool }

/// The int at `index` in `xs`, or -999 past either end.
fn intAt(xs, index) = listGet(xs, index) ?: (0 - 999)

/// appendThrough builds inclusive integer ranges while preserving every prior list version.
fn appendThrough(xs) =
    fn(next) => fn(last) => match next > last {
        true => xs
        false => appendThrough(listAppend(xs, next))(next + 1 )(last)
    }

/// classify exercises exact-length, singleton, pair, and head-tail list patterns.
fn classify(xs: List<int>) = match xs {
    [] => "empty"
    [single] => "one(${single})"
    [first, second] => "two(${first},${second})"
    [head, ...tail] => "many head=${head} rest=${listLength(tail)}"
}

/// sumList proves recursive head-tail destructuring retains every element.
fn sumList(xs) = match xs {
    [] => 0
    [head, ...tail] => head + sumList(tail) 
}

/// restLen exercises a wildcard prefix followed by a captured list tail.
fn restLen(xs: List<int>) = match xs {
    [_, _second, ...rest] => listLength(rest)
    _ => 0
}

/// encodeIteration folds callback order into a base-100 integer through a handled
/// effect, pinning forEachList's in-order traversal ([BUILTIN-LIST-FOREACH]).
fn encodeIteration(xs) = {
    mut encoded = 0
    handle IterationProbe {
        observe value => { encoded = encoded * 100 + value  }
    }
    forEachList(xs, fn(value) => perform IterationProbe.observe(value))
    encoded
}

/// constructionAndIdentityCase preserves all legacy construction, identity, reverse, prepend, and contains observations.
fn constructionAndIdentityCase() = {
    let empty = List()
    let a = listAppend(listAppend(listAppend(List(), 1), 2), 3)
    let b = listAppend(listAppend(List(), 10), 20)
    let reversed = listReverse(a)
    let restored = listReverse(reversed)
    let prepended = listPrepend(a, 0)
    let concatenated = listConcat(a, b)
    let emptyPlusA = empty + a
    let aPlusEmpty = a + empty
    let doubledA = a + a
    let abPlusA = a + b + a

    // Every legacy length observation remains an independent assertion.
    checkAll("legacy construction and operation lengths", [
        structuralEquals([listLength(empty), listLength(a), listLength(b), listLength(reversed)], [0, 3, 2, 3]),
        structuralEquals([listLength(restored), listLength(concatenated), listLength(listConcat(empty, a))], [3, 5, 3]),
        structuralEquals([listLength(listConcat(a, empty)), listLength(a + a), listLength(a + b + a)], [3, 6, 8]),
        structuralEquals([listLength(prepended), listLength(a)], [4, 3])
    ])

    // Constituent checks ensure the old length-only observations cannot hide corrupt contents.
    checkAll("construction and reverse contents", [
        structuralEquals([intAt(a, 0), intAt(a, 1), intAt(a, 2), intAt(b, 0), intAt(b, 1)], [1, 2, 3, 10, 20]),
        structuralEquals(mapList([0, 1, 2], fn(k) => intAt(reversed, k)), [3, 2, 1]),
        structuralEquals(mapList([0, 1, 2], fn(k) => intAt(restored, k)), [1, 2, 3]),
        structuralEquals(mapList([0, 1, 2], fn(k) => intAt(prepended, k)), [0, 1, 2]),
        intAt(prepended, 3) == 3
    ])

    // Concatenation identities and the operator alias are checked at their seams and endpoints.
    checkAll("concat identities and boundaries", [
        structuralEquals(mapList([0, 2, 3], fn(k) => intAt(concatenated, k)), [1, 3, 10]),
        structuralEquals([intAt(concatenated, 4), intAt(emptyPlusA, 0), intAt(aPlusEmpty, 2)], [20, 1, 3]),
        structuralEquals([intAt(doubledA, 3), intAt(abPlusA, 5), intAt(abPlusA, 7)], [1, 1, 3])
    ])

    // All three legacy contains results survive alongside additional positive and
    // endpoint checks ([BUILTIN-LIST-CONTAINS]).
    checkAll("contains behavior", [
        structuralEquals([listContains(a, 2), listContains(a, 99), listContains(List(), 1)], [true, false, false]),
        structuralEquals([listContains(a, 1), listContains(a, 3), listContains(concatenated, 10)], [true, true, true]),
        structuralEquals([listContains(concatenated, 20), listContains(prepended, 99)], [true, false])
    ])
}

/// iterationAndPersistenceCase preserves callback order plus every generation and branch observation.
fn iterationAndPersistenceCase() = {
    let a = listAppend(listAppend(listAppend(List(), 1), 2), 3)
    let reversed = listReverse(a)
    let b = listAppend(listAppend(List(), 10), 20)
    let combined = a + b
    let g0 = List()
    let g1 = listAppend(g0, 10)
    let g2 = listAppend(g1, 20)
    let g3 = listAppend(g2, 30)
    let g4 = listAppend(g3, 40)
    let g5 = listAppend(g4, 50)
    let x = listAppend(g3, 999)
    let y = listAppend(g3, 888)
    let y2 = listAppend(y, 777)

    // Callback encodings preserve every legacy forEachList sequence and its exact order.
    checkAll("forEachList iteration order", [
        structuralEquals([encodeIteration(a), encodeIteration(reversed)], [10203, 30201]),
        encodeIteration(combined) == 102031020
    ])

    // One condition per formerly printed iteration value keeps the golden observations explicit.
    checkAll("iteration constituent values", [
        structuralEquals([intAt(a, 0), intAt(a, 1), intAt(a, 2), intAt(reversed, 0)], [1, 2, 3, 3]),
        structuralEquals([intAt(reversed, 1), intAt(reversed, 2), intAt(combined, 0)], [2, 1, 1]),
        structuralEquals(mapList([1, 2, 3], fn(k) => intAt(combined, k)), [2, 3, 10]),
        intAt(combined, 4) == 20
    ])

    // The six generation lengths, retained g2 length, and all branch lengths mirror the old golden.
    checkAll("persistent generation and branch lengths", [
        structuralEquals([listLength(g0), listLength(g1), listLength(g2), listLength(g3)], [0, 1, 2, 3]),
        structuralEquals([listLength(g4), listLength(g5), listLength(g2), listLength(x)], [4, 5, 2, 4]),
        structuralEquals([listLength(y), listLength(y2), listLength(g3)], [4, 5, 3])
    ])

    // Added content checks prove later generations and sibling branches do not mutate their ancestors.
    checkAll("persistent generation and branch contents", [
        structuralEquals([listContains(g0, 10), listContains(g1, 10), listContains(g1, 20)], [false, true, false]),
        structuralEquals(mapList([10, 20, 30], fn(k) => listContains(g2, k)), [true, true, false]),
        structuralEquals([listContains(g5, 10), listContains(g5, 50), listContains(g2, 50)], [true, true, false]),
        structuralEquals([listContains(x, 999), listContains(x, 888), listContains(y, 888)], [true, false, true]),
        structuralEquals([listContains(y, 999), listContains(y2, 777), listContains(y, 777)], [false, true, false]),
        structuralEquals(mapList([999, 888, 777], fn(k) => listContains(g3, k)), [false, false, false]),
        structuralEquals([intAt(g5, 4), intAt(y2, 3), intAt(y2, 4)], [50, 888, 777])
    ])
}

/// tailBoundaryCase retains the 10/20/30/35 generations and probes both sides of the 32-element tail boundary.
fn tailBoundaryCase() = {
    let t = appendThrough(List())(1)(10)
    let t2 = appendThrough(t)(11)(20)
    let t3 = appendThrough(t2)(21)(30)
    let t4 = appendThrough(t3)(31)(35)
    let reversed = listReverse(t4)
    let doubled = listConcat(t4, t4)

    // All six legacy tail-boundary length observations remain independent.
    checkAll("tail boundary legacy lengths", [
        structuralEquals([listLength(t), listLength(t2), listLength(t3), listLength(t4)], [10, 20, 30, 35]),
        structuralEquals([listLength(reversed), listLength(doubled)], [35, 70])
    ])

    // Boundary indices assert actual content before, at, and after the 32-element trie tail split.
    checkAll("tail boundary contents", [
        structuralEquals([intAt(t, 0), intAt(t, 9), intAt(t2, 10), intAt(t2, 19), intAt(t3, 29)], [1, 10, 11, 20, 30]),
        structuralEquals(mapList([30, 31, 32, 34], fn(k) => intAt(t4, k)), [31, 32, 33, 35]),
        structuralEquals(mapList([0, 2, 3], fn(k) => intAt(reversed, k)), [35, 33, 32]),
        structuralEquals([intAt(reversed, 34), intAt(doubled, 34), intAt(doubled, 35)], [1, 35, 1]),
        structuralEquals([intAt(doubled, 69), listLength(t3)], [35, 30]),
        !listContains(t3, 31),
        sumList(t) == 55,
        sumList(t4) == 630
    ])
}

/// indexingPatternsAndDispatchCase preserves Result indexing, list patterns, recursion, and receiver-directed builtins.
fn indexingPatternsAndDispatchCase() = {
    let commands = ["echo hello", "echo world", "echo test"]
    let empty: List<string> = []
    let a = listAppend(listAppend(listAppend(List(), 1), 2), 3)
    let b = listAppend(listAppend(List(), 10), 20)
    let singleton = listAppend(List(), 7)
    let short = listAppend(List(), 9)
    let pair = listAppend(short, 8)
    let four = listAppend(listAppend(pair, 7), 6)
    let patternFour = listAppend(listAppend(listAppend(listAppend(List(), 4), 5), 6), 7)
    let t = appendThrough(List())(1)(10)
    let dispatchFive = listAppend(listAppend(listAppend(listAppend(listAppend(List(), 1), 2), 3), 4), 5)
    let dispatchTen = listConcat(dispatchFive, dispatchFive)
    let dispatchTwenty = listConcat(dispatchTen, dispatchTen)
    let dispatchThirty = listConcat(dispatchTwenty, dispatchTen)
    let dispatchThirtyFive = listConcat(dispatchThirty, dispatchFive)
    let commandOob = match commands[5] {
        Success => false
        Error { message } => message == "index out of bounds"
    }
    let emptyOob = match empty[0] {
        Success => false
        Error { message } => message == "index out of bounds"
    }

    // Successful and failing index paths retain all four legacy observations and exact failure reasons.
    checkAll("list index Result behavior", [
        (commands[0] ?: "missing") == "echo hello",
        (commands[2] ?: "missing") == "echo test",
        commandOob,
        emptyOob,
        (commands[1] ?: "missing") == "echo world",
        listLength(commands) == 3,
        listLength(empty) == 0
    ])

    // Every legacy classify, recursive sum, and wildcard-rest result remains directly asserted.
    checkAll("list pattern and recursion results", [
        structuralEquals([classify(List()), classify(b), classify(a)], ["empty", "two(10,20)", "many head=1 rest=2"]),
        classify(singleton) == "one(7)",
        structuralEquals([sumList(a), sumList(t), restLen(a), restLen(short), restLen(pair)], [6, 55, 1, 0, 0]),
        restLen(four) == 2,
        classify(patternFour) == "many head=4 rest=3"
    ])

    // The same patterns reached through a LITERAL argument. A callee cannot tell
    // which list layout it received — its parameter is one `i8*` either way — and
    // `osprey_list_get`/`_drop` need a real OspreyList, so every one of these
    // SEGFAULTED before the literal was rebuilt at the call boundary.
    // `osprey_list_length` masked it by reading both layouts' shared leading
    // `i64`, which is why the length-only assertions above never caught it.
    checkAll("list patterns bind through a literal argument", [
        structuralEquals([classify([9]), classify([9, 8])], ["one(9)", "two(9,8)"]),
        classify([9, 8, 7]) == "many head=9 rest=2",
        structuralEquals([sumList([1, 2, 3]), sumList([5]), restLen([1, 2, 3, 4]), restLen([1])], [6, 5, 2, 0])
    ])

    // The old composite bare-length row is split into one condition per receiver.
    // A flat list literal is its own layout, distinct from both an OspreyList
    // handle and a string: it used to reach `osp_strlen`, which counted the
    // length word's bytes and answered 1 for any list of 1..=255 elements.
    checkAll("receiver-directed length dispatch", [
        structuralEquals([length(a), length(dispatchThirtyFive), length("abcd"), length(empty)], [3, 35, 4, 0]),
        structuralEquals([length(""), length(commands), length(lines("a\nb\nc"))], [0, 3, 3])
    ])

    // The old composite bare-isEmpty row is split and extended across derived lists.
    checkAll("receiver-directed isEmpty dispatch", [
        structuralEquals([isEmpty(empty), isEmpty(a), isEmpty(""), isEmpty("abcd")], [true, false, true, false]),
        structuralEquals([isEmpty(listReverse(a)), isEmpty(listConcat(empty, empty))], [false, true]),
        !isEmpty(commands)
    ])

    // A flat list literal is a third layout, distinct from both an OspreyList
    // handle and a string. `+` used to hand `osprey_list_concat` the literal's
    // foreign header and SEGFAULT when exactly one side was a literal, and fall
    // through to integer arithmetic ("expected an integer") when both were. Each
    // operand is normalised to a runtime list first, so all four combinations of
    // literal and handle concatenate and keep their order.
    checkAll("list literal and runtime handle concatenate in either position", [
        structuralEquals([listLength(commands + commands), listLength(commands + empty)], [6, 3]),
        listLength(empty + commands) == 3,
        listContains(commands + empty, "echo test"),
        !listContains(empty + commands, "echo missing"),
        listLength(a + [7, 8]) == 5,
        listLength([7, 8] + a) == 5,
        (listGet([7, 8] + a, 0) ?: ((0 - 999) )) == 7,
        (listGet([7, 8] + a, 2) ?: ((0 - 999) )) == 1,
        (listGet(a + [7, 8], 3) ?: ((0 - 999) )) == 7,
        (listGet(a + [7, 8], 4) ?: ((0 - 999) )) == 8,
        length([7, 8] + a) == 5
    ])
}

// Register the construction, identity, and content scenario.
test("lists construct, reverse, prepend, concatenate, and retain contents", fn() => exactArithmetic(constructionAndIdentityCase))

// Register the traversal, persistence, and branching scenario.
test("list iteration and persistent branches retain order and isolation", fn() => exactArithmetic(iterationAndPersistenceCase))

// Register the 32-element structural boundary scenario.
test("lists preserve content across the 32-element tail boundary", fn() => exactArithmetic(tailBoundaryCase))

// Register Result indexing, patterns, recursion, and builtin dispatch together.
test("list indexing, patterns, recursion, and receiver dispatch compose", fn() => exactArithmetic(indexingPatternsAndDispatchCase))

/// [BUILTIN-LIST-GET] declares `listGet(list: List<T>, index: int) -> Result<T, Error>`
/// and says it is "equivalent to `list[index]`", with an out-of-range index
/// returning `Error`. `T` is the element type, so a string list yields the
/// string, a float list the float, a bool list the bool and a record list the
/// whole record — never the raw storage word behind it. Every existing case
/// above indexes an `int` list, where a word and a value are indistinguishable,
/// which is exactly how issue #211 survived.
fn typedElementRetrievalCase() = {
    let words = ["alpha", "beta", "gamma"]
    let ratios = [0.5, 1.25, 2.75]
    let flags = [true, false, true]
    let slots = [
        Slot { label: "left", weight: 1.5, ready: true },
        Slot { label: "right", weight: 2.5, ready: false }
    ]
    let missingSlot = Slot { label: "missing", weight: 0.0, ready: false }
    let firstSlot = listGet(slots, 0) ?: missingSlot
    let secondSlot = listGet(slots, 1) ?: missingSlot
    let pastEndSlot = listGet(slots, 2) ?: missingSlot

    // A string element comes back as its own string, at every index, through
    // both spellings the spec calls equivalent [BUILTIN-LIST-GET].
    checkAll("string elements survive listGet", [
        (listGet(words, 0) ?: "none") == "alpha",
        (listGet(words, 1) ?: "none") == "beta",
        (listGet(words, 2) ?: "none") == "gamma",
        (words[0] ?: "none") == "alpha",
        (words[1] ?: "none") == "beta",
        (words[2] ?: "none") == "gamma",
        (listGet(words, 0) ?: "none") == (words[0] ?: "other"),
        (listGet(words, 1) ?: "none") == (words[1] ?: "other"),
        (listGet(words, 2) ?: "none") == (words[2] ?: "other"),
        length(listGet(words, 0) ?: "") == 5,
        length(listGet(words, 1) ?: "") == 4,
        length(listGet(words, 2) ?: "") == 5,
        "${listGet(words, 0) ?: "none"}-${listGet(words, 2) ?: "none"}" == "alpha-gamma",
        contains(listGet(words, 1) ?: "none", "et"),
        !contains(listGet(words, 1) ?: "none", "alpha"),
        startsWith(listGet(words, 2) ?: "none", "gam"),
        endsWith(listGet(words, 2) ?: "none", "mma"),
        toUpperCase(listGet(words, 0) ?: "none") == "ALPHA",
        (listGet(words, 3) ?: "past end") == "past end",
        (listGet(words, 99) ?: "past end") == "past end",
        (words[3] ?: "past end") == "past end"
    ])

    // The same rule holds through every persistent producer: a rebuilt list
    // still yields strings, not the words its cells happen to hold
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-PREPEND], [BUILTIN-LIST-APPEND],
    // [BUILTIN-LIST-CONCAT]).
    checkAll("string elements survive every list producer", [
        (listGet(listReverse(words), 0) ?: "none") == "gamma",
        (listGet(listReverse(words), 2) ?: "none") == "alpha",
        (listGet(listPrepend(words, "zero"), 0) ?: "none") == "zero",
        (listGet(listPrepend(words, "zero"), 1) ?: "none") == "alpha",
        (listGet(listAppend(words, "delta"), 3) ?: "none") == "delta",
        (listGet(listAppend(words, "delta"), 0) ?: "none") == "alpha",
        (listGet(words + ["delta"], 3) ?: "none") == "delta",
        (listGet(["zero"] + words, 0) ?: "none") == "zero",
        (listGet(["zero"] + words, 1) ?: "none") == "alpha",
        listLength(listAppend(words, "delta")) == 4,
        listLength(listPrepend(words, "zero")) == 4,
        structuralEquals(mapList(["beta", "delta"], fn(k) => listContains(words, k)), [true, false]),
        listContains(listAppend(words, "delta"), "delta"),
        (listGet(listReverse(listReverse(words)), 1) ?: "none") == "beta"
    ])

    // A float element keeps its IEEE value; a bool element keeps true/false.
    checkAll("float and bool elements survive listGet", [
        (listGet(ratios, 0) ?: 0.0) == 0.5,
        (listGet(ratios, 1) ?: 0.0) == 1.25,
        (listGet(ratios, 2) ?: 0.0) == 2.75,
        (ratios[1] ?: 0.0) == 1.25,
        (listGet(ratios, 0) ?: 0.0) + (listGet(ratios, 1) ?: 0.0) == 1.75,
        (listGet(ratios, 2) ?: 0.0) - (listGet(ratios, 0) ?: 0.0) == 2.25,
        (listGet(ratios, 1) ?: 0.0) * 2.0 == 2.5,
        (listGet(ratios, 9) ?: 9.5) == 9.5,
        (listGet(listReverse(ratios), 0) ?: 0.0) == 2.75,
        listLength(ratios) == 3,
        (listGet(flags, 0) ?: false),
        !(listGet(flags, 1) ?: true),
        (listGet(flags, 2) ?: false),
        (flags[0] ?: false),
        !(flags[1] ?: true),
        (listGet(flags, 0) ?: false) == (listGet(flags, 2) ?: true),
        (listGet(flags, 0) ?: false) != (listGet(flags, 1) ?: true),
        !(listGet(flags, 7) ?: false),
        (listGet(listReverse(flags), 1) ?: true) == false,
        listLength(flags) == 3
    ])

    // A record element comes back whole: every field of the stored record is
    // readable off the retrieved one, and the out-of-range case still takes
    // the declared `Error` branch rather than fabricating a record.
    checkAll("record elements survive listGet whole", [
        firstSlot.label == "left",
        firstSlot.weight == 1.5,
        firstSlot.ready,
        secondSlot.label == "right",
        secondSlot.weight == 2.5,
        !secondSlot.ready,
        firstSlot.label != secondSlot.label,
        firstSlot.weight != secondSlot.weight,
        firstSlot.ready != secondSlot.ready,
        firstSlot.weight + secondSlot.weight == 4.0,
        length(firstSlot.label) == 4,
        length(secondSlot.label) == 5,
        "${firstSlot.label}/${secondSlot.label}" == "left/right",
        pastEndSlot.label == "missing",
        pastEndSlot.weight == 0.0,
        !pastEndSlot.ready,
        (listGet(listReverse(slots), 0) ?: missingSlot).label == "right",
        (listGet(listReverse(slots), 1) ?: missingSlot).label == "left",
        (listGet(listAppend(slots, missingSlot), 2) ?: firstSlot).label == "missing",
        (listGet(listPrepend(slots, missingSlot), 0) ?: firstSlot).weight == 0.0,
        listLength(slots) == 2
    ])
}

// Register typed element retrieval across string, float, bool and record lists.
test("listGet returns the element type for every element type", fn() => exactArithmetic(typedElementRetrievalCase))

/// TranscriptProbe renders one visited element at a time, so `forEachList`'s
/// traversal order over non-integer element types is observable without stdout.
effect TranscriptProbe {
    /// Record one rendered element in traversal order.
    note: fn(string) -> Unit
}

/// shapeOf reads only the SHAPE of a list, never an element, so one function
/// pins arm selection for every element type: [TYPE-LIST-PATTERNS] says "a list
/// pattern matches exactly the listed length unless its final element is a rest
/// binder (`...name`)" and "the rest binder receives the remaining `List<T>`".
fn shapeOf(xs) = match xs {
    [] => "none"
    [_only] => "single"
    [_first, _second] => "pair"
    [_head, ...tail] => "long+${listLength(tail)}"
}

/// headOr binds the first element through a rest-binder pattern, or answers the
/// caller's fallback for the empty list [TYPE-LIST-PATTERNS].
fn headOr(xs, fallback) = match xs {
    [] => fallback
    [head, ..._tail] => head
}

/// secondOr binds a two-element prefix before the rest binder, the only place
/// the spec permits a rest binder — last, and once.
fn secondOr(xs, fallback) = match xs {
    [_first, second, ..._rest] => second
    _ => fallback
}

/// tailLength reports the rest binder's own length, distinguishing the empty
/// list (-1) from a singleton whose tail is empty (0).
fn tailLength(xs) = match xs {
    [] => ((0 - 1) )
    [_head, ...tail] => listLength(tail)
}

/// joinWords walks a string list through the rest binder, so a dropped,
/// duplicated or reordered element changes the transcript. The annotation is
/// load-bearing exactly as `classify`'s is: an interpolated binder does not pin
/// its own element type.
fn joinWords(xs: List<string>) = match xs {
    [] => ""
    [head, ...tail] => "${head}|${joinWords(tail)}"
}

/// lastWord recurses to the final element; the `[]` arm's string result is what
/// infers the element type, so no annotation is legal here.
fn lastWord(xs) = match xs {
    [] => "none"
    [only] => only
    [_head, ...rest] => lastWord(rest)
}

/// boolWeight turns a bool element into its counted weight through a match, so
/// both flavors spell the same lowering (ML has no boolean ternary).
fn boolWeight(flag) = match flag {
    true => 1
    false => 0
}

/// sumFloats reduces a float list through head/tail patterns. Float `+` is
/// total, unlike checked integer `+` ([ARITH-CHECKED]), so no `?:` appears.
fn sumFloats(xs) = match xs {
    [] => 0.0
    [head, ...tail] => head + sumFloats(tail)
}

/// countTrue counts the `true` elements of a bool list through list patterns.
fn countTrue(xs) = match xs {
    [] => 0
    [head, ...tail] => boolWeight(head) + countTrue(tail) 
}

/// slotLabels proves a record element survives head/tail destructuring WHOLE:
/// the bound head is a record whose fields are all readable.
fn slotLabels(xs) = match xs {
    [] => ""
    [head, ...tail] => head.label + ">" + slotLabels(tail)
}

/// readySlots reads a second field off the same bound head, so a head bound to
/// the wrong slot cannot pass by matching only one field.
fn readySlots(xs) = match xs {
    [] => 0
    [head, ...tail] => boolWeight(head.ready) + readySlots(tail) 
}

/// totalWeight reads the third, float-typed field off the bound head.
fn totalWeight(xs) = match xs {
    [] => 0.0
    [head, ...tail] => head.weight + totalWeight(tail)
}

/// rowAt unwraps a nested-list element, substituting a sentinel row that appears
/// nowhere else, so the `Error` branch of [BUILTIN-LIST-GET] cannot pass as a
/// legitimate row.
fn rowAt(rows, index) = match listGet(rows, index) {
    Success { value } => value
    Error => [777]
}

/// sumInner sums every element of every inner list, exercising a `List<T>` whose
/// `T` is itself a `List<int>` ([TYPE-LIST]).
fn sumInner(xs) = match xs {
    [] => 0
    [head, ...tail] => sumList(head) + sumInner(tail) 
}

/// describeMatrix selects its arm on the OUTER list's length while reading the
/// INNER list's length [TYPE-LIST-PATTERNS].
fn describeMatrix(xs) = match xs {
    [] => "no rows"
    [only] => "one row of ${listLength(only)}"
    [first, second] => "rows ${listLength(first)}+${listLength(second)}"
    [head, ...tail] => "head ${listLength(head)} then ${listLength(tail)} more"
}

/// weave folds a running base-10 encoding, so a fold's visit ORDER is observable
/// as one integer ([BUILTIN-ITER-FOLD] "reduces an iterator to a single value").
fn weave(acc, value) = acc * 10 + value 

/// twice is the [BUILTIN-ITER-MAP] callback; isEvenValue the
/// [BUILTIN-ITER-FILTER] predicate.
fn twice(n) = n * 2 

fn isEvenValue(n) = (n % 2 ) == 0

/// [TYPE-LIST-PATTERNS] states a list pattern "matches exactly the listed length
/// unless its final element is a rest binder" and that "the rest binder receives
/// the remaining `List<T>`" — a rule about SHAPE that must hold for every `T`.
/// Every pattern case above matches a `List<int>`, where an element and its
/// storage word are indistinguishable (the blind spot behind issue #211). These
/// blocks re-run the same arms over `List<string>`, including empty,
/// single-character, whitespace, punctuation, digit and duplicated elements.
fn stringListPatternCase() = {
    let noWords: List<string> = []
    let solo = ["solo"]
    let duo = ["left", "right"]
    let words = ["alpha", "beta", "gamma"]
    let quad = ["a", "bb", "ccc", "dddd"]
    let odd = ["", " ", "a", "12", "a,b", "ab ab"]
    let dup = ["same", "same", "other", "same"]

    // Arm selection depends on written length alone, so a string list picks the
    // same arms an int list of the same length picks.
    checkAll("string list patterns select the arm for the written length", [
        structuralEquals([shapeOf(noWords), shapeOf(solo), shapeOf(duo)], ["none", "single", "pair"]),
        structuralEquals([shapeOf(words), shapeOf(quad), shapeOf(odd)], ["long+2", "long+3", "long+5"]),
        structuralEquals([shapeOf(dup), shapeOf(["x"]), shapeOf(["x", "y"])], ["long+3", "single", "pair"]),
        structuralEquals([shapeOf(["x", "y", "z"]), shapeOf(listReverse(words))], ["long+2", "long+2"]),
        structuralEquals([shapeOf(listAppend(duo, "third")), shapeOf(listPrepend(solo, "first"))], ["long+2", "pair"]),
        structuralEquals([shapeOf(listConcat(noWords, solo)), shapeOf(listConcat(duo, noWords))], ["single", "pair"]),
        shapeOf(noWords + noWords) == "none",
        tailLength(noWords) == ((0 - 1) ),
        structuralEquals([tailLength(solo), tailLength(duo), tailLength(words), tailLength(odd)], [0, 1, 2, 5]),
        tailLength(dup) == 3
    ])

    // Each binder carries its OWN element: head, second and the fallback are
    // three distinct strings, so a binder reading the wrong slot is visible.
    checkAll("string binders carry their own element", [
        structuralEquals([headOr(noWords, "empty"), headOr(solo, "empty")], ["empty", "solo"]),
        structuralEquals([headOr(duo, "empty"), headOr(words, "empty"), headOr(odd, "empty")], ["left", "alpha", ""]),
        structuralEquals([headOr(dup, "empty"), headOr(listReverse(words), "empty")], ["same", "gamma"]),
        headOr(listPrepend(words, "zero"), "empty") == "zero",
        headOr(listAppend(words, "delta"), "empty") == "alpha",
        structuralEquals([headOr(noWords + words, "empty"), headOr(words + noWords, "empty")], ["alpha", "alpha"]),
        structuralEquals([secondOr(noWords, "none"), secondOr(solo, "none")], ["none", "none"]),
        structuralEquals([secondOr(duo, "none"), secondOr(words, "none")], ["right", "beta"]),
        structuralEquals([secondOr(odd, "none"), secondOr(dup, "none")], [" ", "same"]),
        structuralEquals([secondOr(listReverse(words), "none"), secondOr(listReverse(quad), "none")], ["beta", "ccc"]),
        structuralEquals([secondOr(["x", "y", "z"], "none"), headOr(["only"], "empty")], ["y", "only"])
    ])

    // Recursive head/tail traversal keeps every element, in index order, once.
    // "alpha|beta|gamma|" is 5+1+4+1+5+1 = 17 bytes; the six `odd` elements are
    // 0+1+1+2+3+5 = 12 bytes plus six separators = 18.
    checkAll("recursive rest-binder traversal keeps string order", [
        structuralEquals([joinWords(noWords), joinWords(solo), joinWords(duo)], ["", "solo|", "left|right|"]),
        structuralEquals([joinWords(words), joinWords(quad)], ["alpha|beta|gamma|", "a|bb|ccc|dddd|"]),
        structuralEquals([joinWords(odd), joinWords(dup)], ["| |a|12|a,b|ab ab|", "same|same|other|same|"]),
        joinWords(listReverse(words)) == "gamma|beta|alpha|",
        joinWords(listReverse(listReverse(words))) == joinWords(words),
        joinWords(listReverse(dup)) == "same|other|same|same|",
        joinWords(listAppend(words, "delta")) == "alpha|beta|gamma|delta|",
        joinWords(listPrepend(words, "zero")) == "zero|alpha|beta|gamma|",
        joinWords(duo + words) == "left|right|alpha|beta|gamma|",
        joinWords(words + duo) == "alpha|beta|gamma|left|right|",
        joinWords(noWords + words) == joinWords(words),
        joinWords(words + noWords) == joinWords(words),
        structuralEquals([length(joinWords(words)), length(joinWords(odd)), length(joinWords(quad))], [17, 18, 14]),
        length(joinWords(dup)) == 21,
        structuralEquals([lastWord(noWords), lastWord(solo), lastWord(words)], ["none", "solo", "gamma"]),
        structuralEquals([lastWord(listReverse(words)), lastWord(listAppend(words, "delta"))], ["alpha", "delta"])
    ])

    // String elements are compared by CONTENT for membership
    // ([BUILTIN-LIST-CONTAINS]), so the empty string is a findable element and a
    // case difference is not.
    checkAll("string element edge cases survive indexing and membership", [
        (listGet(odd, 0) ?: "x") == "",
        isEmpty(listGet(odd, 0) ?: "x"),
        length(listGet(odd, 0) ?: "x") == 0,
        (listGet(odd, 1) ?: "x") == " ",
        length(listGet(odd, 1) ?: "x") == 1,
        (listGet(odd, 3) ?: "x") == "12",
        contains(listGet(odd, 4) ?: "x", ","),
        startsWith(listGet(odd, 5) ?: "x", "ab"),
        endsWith(listGet(odd, 5) ?: "x", "ab"),
        contains(listGet(odd, 5) ?: "x", " "),
        toUpperCase(listGet(words, 1) ?: "x") == "BETA",
        toLowerCase(toUpperCase(listGet(words, 2) ?: "x")) == "gamma",
        structuralEquals(mapList(["", " ", "A"], fn(k) => listContains(odd, k)), [true, true, false]),
        structuralEquals(mapList(["same", "other"], fn(k) => listContains(dup, k)), [true, true]),
        structuralEquals([listContains(dup, "missing"), listContains(noWords, "")], [false, false]),
        structuralEquals([listLength(dup), listLength(odd), listLength(listReverse(dup))], [4, 6, 4]),
        (listGet(dup, 0) ?: "x") == (listGet(dup, 3) ?: "y"),
        (listGet(dup, 0) ?: "x") != (listGet(dup, 2) ?: "y"),
        listLength(words) == 3
    ])
}

// Register list patterns over string elements.
test("string lists destructure, iterate, and rebuild through list patterns", fn() => exactArithmetic(stringListPatternCase))

/// The same [TYPE-LIST-PATTERNS] shape rules over `List<float>` and `List<bool>`,
/// the two element types whose storage word is NOT an int. Every float used here
/// is an exact binary fraction (a multiple of 0.25), so the sums are exact and a
/// `==` on a float is a legitimate assertion. Float `+` is total; integer `+`
/// stays checked ([ARITH-CHECKED]).
fn floatAndBoolListPatternCase() = {
    let noFloats: List<float> = []
    let oneFloat = [1.5]
    let twoFloats = [0.25, 0.75]
    let ratios = [0.5, 1.25, 2.75]
    let quarters = [0.0, 0.25, 0.5, 0.75]
    let dupFloats = [2.0, 2.0, 1.0]
    let noFlags: List<bool> = []
    let allOn = [true, true, true]
    let allOff = [false, false, false]
    let mixed = [true, false, true]
    let pairOn = [true, false]

    // Arm selection and binder identity for float elements.
    checkAll("float list patterns select arms and bind elements", [
        structuralEquals([shapeOf(noFloats), shapeOf(oneFloat), shapeOf(twoFloats)], ["none", "single", "pair"]),
        structuralEquals([shapeOf(ratios), shapeOf(quarters), shapeOf(dupFloats)], ["long+2", "long+3", "long+2"]),
        headOr(noFloats, 9.5) == 9.5,
        headOr(oneFloat, 9.5) == 1.5,
        headOr(twoFloats, 9.5) == 0.25,
        headOr(ratios, 9.5) == 0.5,
        headOr(quarters, 9.5) == 0.0,
        headOr(listReverse(ratios), 9.5) == 2.75,
        secondOr(noFloats, 9.5) == 9.5,
        secondOr(oneFloat, 9.5) == 9.5,
        secondOr(twoFloats, 9.5) == 0.75,
        secondOr(ratios, 9.5) == 1.25,
        secondOr(quarters, 9.5) == 0.25,
        tailLength(noFloats) == ((0 - 1) ),
        structuralEquals([tailLength(oneFloat), tailLength(ratios), tailLength(quarters)], [0, 2, 3])
    ])

    // 0.5+1.25+2.75 = 4.5 and 0.0+0.25+0.5+0.75 = 1.5, both exact in binary, so
    // reversal and either concatenation order must reproduce them exactly
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-CONCAT]).
    checkAll("float head-tail recursion sums every element exactly once", [
        sumFloats(noFloats) == 0.0,
        sumFloats(oneFloat) == 1.5,
        sumFloats(twoFloats) == 1.0,
        sumFloats(ratios) == 4.5,
        sumFloats(quarters) == 1.5,
        sumFloats(dupFloats) == 5.0,
        sumFloats(listReverse(ratios)) == 4.5,
        sumFloats(listReverse(quarters)) == 1.5,
        sumFloats(ratios + twoFloats) == 5.5,
        sumFloats(twoFloats + ratios) == 5.5,
        sumFloats(noFloats + ratios) == 4.5,
        sumFloats(ratios + noFloats) == 4.5,
        sumFloats(ratios + ratios) == 9.0,
        sumFloats(listAppend(ratios, 0.5)) == 5.0,
        sumFloats(listPrepend(ratios, 0.5)) == 5.0,
        sumFloats([0.25]) == 0.25,
        sumFloats([0.25, 0.25]) == 0.5,
        listLength(ratios) == 3,
        listLength(ratios + twoFloats) == 5,
        structuralEquals([listContains(ratios, 1.25), listContains(ratios, 1.5)], [true, false]),
        listContains(dupFloats, 2.0)
    ])

    // Every bool permutation of length 0..3 is counted independently, so a
    // pattern that drops or double-counts the head cannot hide in a total.
    checkAll("bool list patterns count every permutation", [
        structuralEquals([shapeOf(noFlags), shapeOf([true]), shapeOf(pairOn)], ["none", "single", "pair"]),
        shapeOf(mixed) == "long+2",
        structuralEquals([countTrue(noFlags), countTrue([true]), countTrue([false])], [0, 1, 0]),
        structuralEquals([countTrue([true, true]), countTrue([true, false]), countTrue([false, true])], [2, 1, 1]),
        structuralEquals([countTrue([false, false]), countTrue(allOn), countTrue(allOff)], [0, 3, 0]),
        structuralEquals([countTrue(mixed), countTrue(listReverse(mixed)), countTrue(mixed + allOn)], [2, 2, 5]),
        structuralEquals([countTrue(allOff + mixed), countTrue(listAppend(mixed, false))], [2, 2]),
        structuralEquals([countTrue(listPrepend(mixed, false)), countTrue(listAppend(allOff, true))], [2, 1]),
        structuralEquals([boolWeight(true), boolWeight(false)], [1, 0])
    ])

    // A bool element keeps its own value through every binder and producer.
    checkAll("bool elements keep their value through binders and producers", [
        structuralEquals([headOr(noFlags, false), headOr(allOn, false), headOr(allOff, true)], [false, true, false]),
        structuralEquals([headOr(mixed, false), headOr(listReverse(pairOn), true)], [true, false]),
        structuralEquals([secondOr(mixed, true), secondOr(pairOn, true)], [false, false]),
        structuralEquals([secondOr([false, true], false), secondOr(noFlags, true)], [true, true]),
        structuralEquals(mapList([false, true], fn(k) => listContains(mixed, k)), [true, true]),
        structuralEquals([listContains(allOn, false), listContains(allOff, true)], [false, false]),
        structuralEquals([listLength(mixed + allOff), countTrue(mixed + allOff), tailLength(mixed)], [6, 2, 2]),
        tailLength(noFlags) == ((0 - 1) ),
        listLength(listReverse(allOn)) == 3
    ])
}

// Register list patterns over float and bool elements.
test("float and bool lists destructure and recombine through list patterns", fn() => exactArithmetic(floatAndBoolListPatternCase))

/// [TYPE-LIST-PATTERNS] over `List<Slot>`. A rest-binder pattern must bind the
/// WHOLE record, not the storage word behind it, so every arm below reads more
/// than one field off the bound head. [BUILTIN-LIST-CONTAINS] adds the rule that
/// "managed handles such as nested lists and records compare by identity", so a
/// freshly built record with identical field values is NOT a member.
fn recordListPatternCase() = {
    let missingSlot = Slot { label: "missing", weight: 0.0, ready: false }
    let soloSlot = Slot { label: "solo", weight: 3.0, ready: true }
    let noSlots: List<Slot> = []
    let oneSlot = [soloSlot]
    let slots = [
        Slot { label: "left", weight: 1.5, ready: true },
        Slot { label: "right", weight: 2.5, ready: false }
    ]
    let trio = listAppend(slots, Slot { label: "extra", weight: 4.0, ready: true })
    let noneHead = headOr(noSlots, missingSlot)
    let soloHead = headOr(oneSlot, missingSlot)
    let firstOfSlots = headOr(slots, missingSlot)
    let secondOfSlots = secondOr(slots, missingSlot)
    let reversedHead = headOr(listReverse(slots), missingSlot)
    let noneSecond = secondOr(noSlots, missingSlot)
    let soloSecond = secondOr(oneSlot, missingSlot)
    let secondOfTrio = secondOr(trio, missingSlot)

    // The bound head is a whole record: three fields of two different types are
    // readable off it, and the empty-list arm returns the caller's own record.
    checkAll("record list patterns bind whole records", [
        structuralEquals([shapeOf(noSlots), shapeOf(oneSlot), shapeOf(slots)], ["none", "single", "pair"]),
        structuralEquals([shapeOf(trio), noneHead.label], ["long+2", "missing"]),
        noneHead.weight == 0.0,
        !noneHead.ready,
        soloHead.label == "solo",
        soloHead.weight == 3.0,
        soloHead.ready,
        firstOfSlots.label == "left",
        firstOfSlots.weight == 1.5,
        firstOfSlots.ready,
        reversedHead.label == "right",
        reversedHead.weight == 2.5,
        !reversedHead.ready,
        structuralEquals([noneSecond.label, soloSecond.label, secondOfSlots.label], ["missing", "missing", "right"]),
        secondOfSlots.weight == 2.5,
        !secondOfSlots.ready,
        secondOfTrio.label == "right",
        firstOfSlots.label != secondOfSlots.label,
        tailLength(slots) == 1,
        tailLength(trio) == 2
    ])

    // Recursion over the rest binder reaches every record, in order, once.
    // "left>right>extra>" is 5+6+6 = 17 bytes; weights 1.5+2.5+4.0 = 8.0.
    checkAll("record fields survive head-tail recursion", [
        structuralEquals([slotLabels(noSlots), slotLabels(oneSlot), slotLabels(slots)], ["", "solo>", "left>right>"]),
        structuralEquals([slotLabels(trio), slotLabels(listReverse(slots))], ["left>right>extra>", "right>left>"]),
        slotLabels(listReverse(trio)) == "extra>right>left>",
        slotLabels(listPrepend(slots, soloSlot)) == "solo>left>right>",
        slotLabels(noSlots + slots) == "left>right>",
        structuralEquals([length(slotLabels(trio)), readySlots(noSlots), readySlots(oneSlot)], [17, 0, 1]),
        structuralEquals([readySlots(slots), readySlots(trio), readySlots(listReverse(trio))], [1, 2, 2]),
        readySlots(listPrepend(slots, missingSlot)) == 1,
        totalWeight(noSlots) == 0.0,
        totalWeight(oneSlot) == 3.0,
        totalWeight(slots) == 4.0,
        totalWeight(trio) == 8.0,
        totalWeight(listReverse(trio)) == 8.0,
        totalWeight(slots + slots) == 8.0
    ])

    // Building `trio` left `slots` untouched. A record has no decided `==`
    // ([BOOL-EQUALITY]), so membership is asked of a key, the label.
    checkAll("record lists stay persistent and are searched by key", [
        listLength(slots) == 2,
        listLength(trio) == 3,
        slotLabels(slots) == "left>right>",
        readySlots(slots) == 1,
        totalWeight(slots) == 4.0,
        contains(slotLabels(oneSlot), "${soloSlot.label}>"),
        contains(slotLabels(listPrepend(slots, soloSlot)), "${soloSlot.label}>"),
        !contains(slotLabels(slots), "${soloSlot.label}>"),
        !contains(slotLabels(slots), "${missingSlot.label}>"),
        contains(slotLabels(slots), "left>"),
        !contains(slotLabels(noSlots), "${missingSlot.label}>"),
        listLength(listAppend(trio, missingSlot)) == 4,
        listLength(trio) == 3,
        (listGet(trio, 2) ?: missingSlot).label == "extra",
        (listGet(trio, 2) ?: missingSlot).weight == 4.0,
        (listGet(trio, 2) ?: missingSlot).ready,
        (listGet(trio, 3) ?: missingSlot).label == "missing",
        (listGet(slots, 2) ?: missingSlot).label == "missing",
        (listGet(noSlots, 0) ?: missingSlot).label == "missing",
        isEmpty(noSlots),
        !isEmpty(slots),
        length(slots) == 2,
        length(noSlots) == 0
    ])
}

// Register list patterns over record elements.
test("record lists destructure whole through list patterns", fn() => exactArithmetic(recordListPatternCase))

/// A `List<T>` whose `T` is itself a `List<int>` ([TYPE-LIST]). [BUILTIN-LIST-GET]
/// must hand back the inner LIST, so every retrieval here is indexed again or
/// summed; a raw storage word would have neither a length nor elements.
/// [BUILTIN-LIST-CONTAINS] again applies its identity rule to nested lists.
fn nestedListCase() = {
    let emptyRow: List<int> = []
    let rows = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    let oneRow = [[9, 9, 9]]
    let twoRows = [[1], [2, 3]]
    let withEmptyRow = listAppend(rows, emptyRow)
    let grown = listAppend(rows, [10, 11])
    let firstRow = rowAt(rows, 0)
    let biggerFirstRow = listAppend(firstRow, 99)
    let sentinelProbe = rowAt(rows, 9)

    // Row sums: [1,2]=3, [3,4,5]=12, [6,7,8,9]=30, so sumInner(rows) = 45 and
    // sumInner(grown) = 45 + 21 = 66.
    checkAll("nested list elements come back as lists", [
        structuralEquals([listLength(rows), listLength(firstRow), sumList(firstRow)], [3, 2, 3]),
        (listGet(firstRow, 0) ?: 0) == 1,
        (listGet(firstRow, 1) ?: 0) == 2,
        listLength(rowAt(rows, 1)) == 3,
        sumList(rowAt(rows, 1)) == 12,
        (listGet(rowAt(rows, 1), 2) ?: 0) == 5,
        listLength(rowAt(rows, 2)) == 4,
        sumList(rowAt(rows, 2)) == 30,
        (listGet(rowAt(rows, 2), 3) ?: 0) == 9,
        (listGet(rowAt(rows, 2), 4) ?: 77) == 77,
        structuralEquals([sumList(sentinelProbe), listLength(sentinelProbe), sumInner(rows)], [777, 1, 45]),
        structuralEquals([sumInner(oneRow), sumInner(twoRows), sumInner(withEmptyRow)], [27, 6, 45]),
        structuralEquals([sumInner(grown), listLength(withEmptyRow)], [66, 4]),
        isEmpty(rowAt(withEmptyRow, 3)),
        listLength(rowAt(withEmptyRow, 3)) == 0
    ])

    // The outer arm is chosen by the outer length while the message reports the
    // inner length, so mixing the two up is visible in every arm.
    checkAll("nested list patterns read outer arm and inner length", [
        structuralEquals([shapeOf(oneRow), shapeOf(twoRows), shapeOf(rows)], ["single", "pair", "long+2"]),
        structuralEquals([shapeOf(grown), describeMatrix(oneRow)], ["long+3", "one row of 3"]),
        structuralEquals([describeMatrix(twoRows), describeMatrix(rows)], ["rows 1+2", "head 2 then 2 more"]),
        describeMatrix(grown) == "head 2 then 3 more",
        describeMatrix(withEmptyRow) == "head 2 then 3 more",
        describeMatrix(listReverse(rows)) == "head 4 then 2 more",
        structuralEquals([listLength(headOr(rows, emptyRow)), listLength(headOr(listReverse(rows), emptyRow))], [2, 4]),
        structuralEquals([sumList(headOr(rows, emptyRow)), sumList(secondOr(rows, emptyRow))], [3, 12]),
        structuralEquals([listLength(secondOr(twoRows, emptyRow)), sumList(secondOr(oneRow, emptyRow))], [2, 0]),
        structuralEquals([tailLength(rows), tailLength(oneRow)], [2, 0])
    ])

    // Appending to a retrieved row builds a NEW row and leaves the matrix alone:
    // the stored row keeps its own contents ([BOOL-EQUALITY] decides no `==`
    // for lists, so the rows are compared by their sums).
    checkAll("nested lists stay isolated when a retrieved row grows", [
        structuralEquals([listLength(rows), listLength(grown), sumInner(rows), listLength(firstRow)], [3, 4, 45, 2]),
        structuralEquals([listLength(biggerFirstRow), sumList(biggerFirstRow), sumList(firstRow)], [3, 102, 3]),
        listLength(rowAt(rows, 0)) == 2,
        sumList(rowAt(rows, 0)) != sumList(biggerFirstRow),
        sumList(rowAt(rows, 0)) == sumList([1, 2]),
        structuralEquals([sumInner(listReverse(rows)), sumList(rowAt(listReverse(rows), 0))], [45, 30]),
        structuralEquals([sumList(rowAt(listReverse(rows), 2)), listLength(listReverse(rows))], [3, 3]),
        structuralEquals([sumInner(rows + rows), listLength(rows + rows), sumList(rowAt(rows + rows, 3))], [90, 6, 3]),
        sumInner(rows) == 45
    ])
}

// Register nested-list indexing, patterns and isolation.
test("nested lists index, destructure, and stay isolated", fn() => exactArithmetic(nestedListCase))

/// [BUILTIN-LIST-FOREACH] states `forEachList` "calls `function` once per element
/// in index order". One handler owns the transcript, so the assertions between
/// the traversals are INTERMEDIATE observations: a lost or reordered element
/// cannot hide behind a correct final string. [BUILTIN-ITER-RANGE],
/// [BUILTIN-ITER-MAP], [BUILTIN-ITER-FILTER], [BUILTIN-ITER-FOLD] and
/// [BUILTIN-ITER-FUSION] are pinned the same way, with a positional base-10
/// encoding that changes if the visit order changes.
fn typedIterationOrderCase() = {
    let noWords: List<string> = []
    let words = ["alpha", "beta", "gamma"]
    let flags = [true, false]
    let counts = [7, 8, 9]
    let ratios = [0.5, 1.25, 2.75]
    let missingSlot = Slot { label: "missing", weight: 0.0, ready: false }
    let slots = [
        Slot { label: "left", weight: 1.5, ready: true },
        Slot { label: "right", weight: 2.5, ready: false }
    ]
    mut log = ""

    handle TranscriptProbe {
        note text => { log = "${log}${text}|" }
    }
    forEachList(noWords, fn(word) => perform TranscriptProbe.note(word))

    // "Once per element" over zero elements is zero calls.
    checkAll("forEachList over an empty list records nothing", [
        log == "",
        length(log) == 0,
        isEmpty(log),
        isEmpty(noWords),
        listLength(noWords) == 0,
        shapeOf(noWords) == "none",
        tailLength(noWords) == ((0 - 1) )
    ])

    forEachList(words, fn(word) => perform TranscriptProbe.note(word))

    // 5+1+4+1+5+1 = 17 bytes, and the reversed spelling must NOT appear.
    checkAll("forEachList visits string elements in index order", [
        log == "alpha|beta|gamma|",
        length(log) == 17,
        structuralEquals([startsWith(log, "alpha|"), endsWith(log, "gamma|")], [true, true]),
        structuralEquals(mapList(["|beta|", "gamma|beta|"], fn(k) => contains(log, k)), [true, false]),
        log == joinWords(words)
    ])

    forEachList(flags, fn(flag) => perform TranscriptProbe.note("${flag}"))

    // 17 + "true|" (5) + "false|" (6) = 28.
    checkAll("forEachList visits bool elements in index order", [
        log == "alpha|beta|gamma|true|false|",
        length(log) == 28,
        structuralEquals(mapList(["true|false|", "false|true|"], fn(k) => endsWith(log, k)), [true, false]),
        contains(log, "gamma|true|")
    ])

    forEachList(counts, fn(count) => perform TranscriptProbe.note("${count}"))

    // 28 + "7|8|9|" (6) = 34.
    checkAll("forEachList visits int elements in index order", [
        log == "alpha|beta|gamma|true|false|7|8|9|",
        length(log) == 34,
        structuralEquals([endsWith(log, "7|8|9|"), contains(log, "9|8|7|")], [true, false]),
        contains(log, "false|7|")
    ])

    forEachList(slots, fn(slot) => perform TranscriptProbe.note(slot.label))

    // 34 + "left|" (5) + "right|" (6) = 45.
    checkAll("forEachList visits record elements in index order", [
        log == "alpha|beta|gamma|true|false|7|8|9|left|right|",
        length(log) == 45,
        structuralEquals(mapList(["left|right|", "right|left|"], fn(k) => endsWith(log, k)), [true, false]),
        contains(log, "9|left|")
    ])

    forEachList(listReverse(words), fn(word) => perform TranscriptProbe.note(word))

    // 45 + 17 = 62; the derived list is traversed, the source is not.
    checkAll("forEachList follows the derived list, not its source", [
        log == "alpha|beta|gamma|true|false|7|8|9|left|right|gamma|beta|alpha|",
        length(log) == 62,
        structuralEquals([endsWith(log, "gamma|beta|alpha|"), startsWith(log, "alpha|beta|gamma|")], [true, true]),
        contains(log, "right|gamma|"),
        joinWords(words) == "alpha|beta|gamma|",
        joinWords(listReverse(words)) == "gamma|beta|alpha|"
    ])

    // A fold over `range(0, n)` reproduces index order independently of
    // forEachList, so the two mechanisms cross-check each other.
    // weave(0,7)=7, weave(7,8)=78, weave(78,9)=789.
    checkAll("range folds reproduce list order for every element type", [
        (range(0, 3) |> fold("", fn(acc, i) => "${acc}${listGet(words, i) ?: "?"}|")) == "alpha|beta|gamma|",
        (range(0, 3) |> fold(0, fn(acc, i) => weave(acc, (listGet(counts, i) ?: 0)))) == 789,
        (range(0, 3) |> fold(0, fn(acc, i) => weave(acc, (listGet(listReverse(counts), i) ?: 0)))) == 987,
        (range(1, 3) |> fold(0, fn(acc, i) => weave(acc, (listGet(counts, i) ?: 0)))) == 89,
        (range(0, 0) |> fold(0, fn(acc, i) => weave(acc, (listGet(counts, i) ?: 0)))) == 0,
        (range(0, 2) |> fold(0, fn(acc, i) => acc + boolWeight(listGet(flags, i) ?: false) )) == 1,
        (range(0, 2) |> fold(0.0, fn(acc, i) => acc + (listGet(ratios, i) ?: 0.0))) == 1.75,
        (range(0, 3) |> fold(0.0, fn(acc, i) => acc + (listGet(ratios, i) ?: 0.0))) == 4.5,
        (range(0, 2) |> fold("", fn(acc, i) => "${acc}${(listGet(slots, i) ?: missingSlot).label}>")) == "left>right>",
        (range(0, 5) |> fold(0, fn(acc, i) => acc + i )) == 10,
        (range(5, 5) |> fold(99, weave)) == 99,
        (range(1, 6) |> fold(0, weave)) == 12345,
        (range(0, 3) |> fold("", fn(acc, i) => "${acc}${i};")) == "0;1;2;"
    ])

    // map/filter/fold chains over a range fuse into one loop
    // ([BUILTIN-ITER-FUSION]) but must still produce the documented order.
    // 1..5 doubled is 2,4,6,8,10 -> 24690; evens of 1..9 doubled are 4,8,12,16
    // -> 4, 48, 492, 4936.
    checkAll("map, filter and fold pipelines keep the documented order", [
        (range(1, 6) |> map(twice) |> fold(0, weave)) == 24690,
        (range(1, 6) |> filter(isEvenValue) |> fold(0, weave)) == 24,
        (range(1, 10) |> filter(isEvenValue) |> map(twice) |> fold(0, weave)) == 4936,
        (range(1, 6) |> map(twice) |> filter(isEvenValue) |> fold(0, weave)) == 24690,
        (range(1, 6) |> map(twice) |> fold(0, fn(a, b) => a + b )) == 30,
        (range(1, 6) |> filter(isEvenValue) |> fold(0, fn(a, b) => a + b )) == 6,
        (range(0, 4) |> map(twice) |> fold(0, weave)) == 246,
        (range(0, 1) |> map(twice) |> fold(7, weave)) == 70,
        (range(2, 2) |> map(twice) |> fold(5, weave)) == 5,
        (range(1, 4) |> map(twice) |> fold("", fn(acc, v) => "${acc}${v},")) == "2,4,6,",
        (range(1, 4) |> fold("", fn(acc, v) => "${acc}${v},")) == "1,2,3,",
        twice(0) == 0,
        twice(21) == 42,
        structuralEquals([isEvenValue(0), isEvenValue(7), isEvenValue(8)], [true, false, true]),
        weave(0, 5) == 5,
        weave(12, 3) == 123
    ])
}

// Register traversal order across every element type and the iterator surface.
test("forEachList and range pipelines visit every element type in order", fn() => exactArithmetic(typedIterationOrderCase))

/// [BUILTIN-LIST-GET] says an "out-of-range index returns `Error`", and
/// [TYPE-LIST] says "index access is bounds-checked". These blocks walk the
/// boundary from both sides on every element type: the first index, the last
/// index, one past the end, far past the end, and a negative index. The string
/// list is grown to 40 elements so indices 31/32/33 straddle the 32-element
/// structural tail split for a NON-int element type.
fn boundaryIndexCase() = {
    let five = ["s0", "s1", "s2", "s3", "s4"]
    let ten = five + five
    let twenty = ten + ten
    let forty = twenty + twenty
    let noWords: List<string> = []
    let words = ["alpha", "beta", "gamma"]
    let ratios = [0.5, 1.25, 2.75]
    let marks = [true, false]
    let missingSlot = Slot { label: "missing", weight: 0.0, ready: false }
    let slots = [
        Slot { label: "left", weight: 1.5, ready: true },
        Slot { label: "right", weight: 2.5, ready: false }
    ]
    let negIndex = (0 - 1) 
    let farNegIndex = (0 - 1000) 
    let lastIndex = (listLength(forty) - 1) 
    let negError = match listGet(words, negIndex) {
        Success => false
        Error { message } => message == "index out of bounds"
    }
    let farError = match listGet(forty, 1000) {
        Success => false
        Error { message } => message == "index out of bounds"
    }
    let emptyError = match listGet(noWords, 0) {
        Success => false
        Error { message } => message == "index out of bounds"
    }

    // `forty` repeats "s0".."s4", so the element at index i is "s${i % 5}":
    // index 30 -> "s0", 31 -> "s1", 32 -> "s2" (the tail split), 39 -> "s4".
    checkAll("string list index boundaries around the 32-element tail", [
        structuralEquals([listLength(five), listLength(ten), listLength(twenty), listLength(forty)], [5, 10, 20, 40]),
        lastIndex == 39,
        (listGet(forty, 0) ?: "?") == "s0",
        (listGet(forty, 4) ?: "?") == "s4",
        (listGet(forty, 5) ?: "?") == "s0",
        (listGet(forty, 30) ?: "?") == "s0",
        (listGet(forty, 31) ?: "?") == "s1",
        (listGet(forty, 32) ?: "?") == "s2",
        (listGet(forty, 33) ?: "?") == "s3",
        (listGet(forty, lastIndex) ?: "?") == "s4",
        (listGet(forty, 40) ?: "past") == "past",
        (listGet(forty, 1000) ?: "past") == "past",
        (listGet(forty, negIndex) ?: "past") == "past",
        (listGet(forty, farNegIndex) ?: "past") == "past",
        (listGet(listReverse(forty), 0) ?: "?") == "s4",
        (listGet(listReverse(forty), 7) ?: "?") == "s2",
        (listGet(listReverse(forty), 39) ?: "?") == "s0",
        listLength(listAppend(forty, "tail")) == 41,
        (listGet(listAppend(forty, "tail"), 40) ?: "?") == "tail",
        (listGet(listAppend(forty, "tail"), 32) ?: "?") == "s2",
        (listGet(listPrepend(forty, "head"), 0) ?: "?") == "head",
        (listGet(listPrepend(forty, "head"), 33) ?: "?") == "s2",
        listLength(forty) == 40
    ])

    // The Error branch is taken for every element type. Asserting BOTH fallbacks
    // for the bool list proves the fallback was used rather than a stored value.
    checkAll("out-of-range indexing takes the Error branch for every type", [
        negError,
        farError,
        emptyError,
        (listGet(words, 3) ?: "past") == "past",
        (listGet(words, negIndex) ?: "past") == "past",
        (listGet(words, 2) ?: "past") == "gamma",
        (listGet(ratios, 3) ?: 9.5) == 9.5,
        (listGet(ratios, negIndex) ?: 9.5) == 9.5,
        (listGet(ratios, 2) ?: 9.5) == 2.75,
        (listGet(marks, 2) ?: false) == false,
        (listGet(marks, 2) ?: true) == true,
        (listGet(marks, negIndex) ?: true) == true,
        (listGet(marks, 1) ?: true) == false,
        (listGet(slots, 2) ?: missingSlot).label == "missing",
        (listGet(slots, negIndex) ?: missingSlot).label == "missing",
        (listGet(slots, 1) ?: missingSlot).label == "right",
        (listGet(noWords, 0) ?: "past") == "past",
        (listGet(noWords, negIndex) ?: "past") == "past",
        isEmpty(noWords),
        listLength(noWords) == 0
    ])

    // Every doubling keeps the repeating pattern, so a rebuilt list indexes the
    // same way its source did. "s0|s1|s2|s3|s4|" is 5 * 3 = 15 bytes.
    checkAll("doubled and derived lists index consistently", [
        joinWords(five) == "s0|s1|s2|s3|s4|",
        structuralEquals([length(joinWords(five)), length(joinWords(ten)), length(joinWords(twenty))], [15, 30, 60]),
        length(joinWords(forty)) == 120,
        shapeOf(forty) == "long+39",
        tailLength(forty) == 39,
        structuralEquals([headOr(forty, "?"), secondOr(forty, "?"), lastWord(five)], ["s0", "s1", "s4"]),
        lastWord(ten) == "s4",
        structuralEquals(mapList(["s3", "s5"], fn(k) => listContains(forty, k)), [true, false]),
        structuralEquals([listContains(five, "s0"), listContains(noWords, "s0")], [true, false]),
        (listGet(ten, 9) ?: "?") == "s4",
        (listGet(twenty, 19) ?: "?") == "s4",
        (listGet(twenty, 10) ?: "?") == "s0",
        listLength(ten + five) == 15,
        (listGet(ten + five, 10) ?: "?") == "s0",
        (listGet(five + ten, 4) ?: "?") == "s4",
        (listGet(five + ten, 5) ?: "?") == "s0"
    ])
}

// Register bounds checking across element types and the tail boundary.
test("list index boundaries are checked on every element type", fn() => exactArithmetic(boundaryIndexCase))

/// foldSeedCase pins [BUILTIN-ITER-FOLD]: a list-literal seed takes the runtime
/// representation once, before the loop, so every iteration's listAppend and
/// listConcat reads a runtime list. Left flat, the second iteration read the
/// literal's header as a trie and crashed.
fn foldSeedCase() = {
    let squares = range(1, 5) |> fold([], fn(acc, i) => listAppend(acc, i * i))
    let words = range(0, 3) |> fold([], fn(acc, i) => listAppend(acc, "w${i}"))
    let doubled = range(0, 3) |> fold([], fn(acc, i) => listConcat(acc, [i, i]))
    let seeded = range(3, 6) |> fold([1, 2], fn(acc, i) => listAppend(acc, i))
    checkAll("fold over a list-literal seed", [
        listLength(squares) == 4, (listGet(squares, 3) ?: 0) == 16, sumList(squares) == 30,
        listLength(words) == 3, (listGet(words, 2) ?: "?") == "w2", joinWords(words) == "w0|w1|w2|",
        listLength(doubled) == 6, (listGet(doubled, 4) ?: -1) == 2, sumList(doubled) == 6,
        listLength(seeded) == 5, (listGet(seeded, 0) ?: 0) == 1, (listGet(seeded, 4) ?: 0) == 5, sumList(seeded) == 15
    ])
}

/// linesIndexCase pins [BUILTIN-LIST-GET] on a bound string list: the result
/// of lines is settled into the runtime layout once at the binding, so ten
/// thousand indexed reads cost ten thousand reads, not ten thousand copies of
/// two thousand strings. "line i" is 6, 7, 8 or 9 bytes by decade, 16890 per
/// pass, and the reads make five passes.
fn lineAfter(acc, i) = match i == 0 {
    true => "line 0"
    false => acc + "\nline ${i}"
}

fn linesIndexCase() = {
    let text = range(0, 2000) |> fold("", lineAfter)
    let rows = lines(text)
    let total = range(0, 10000) |> fold(0, fn(acc, i) => acc + byteLength(listGet(rows, i % 2000) ?: ""))
    checkAll("a bound string list is read by index in constant time", [
        listLength(rows) == 2000, (listGet(rows, 1999) ?: "?") == "line 1999", total == 84450
    ])
}

test("fold rebuilds a list-literal seed once before the loop", fn() => exactArithmetic(foldSeedCase))
test("a bound string list is read by index in constant time", fn() => exactArithmetic(linesIndexCase))
