(** Cross-contract oracle for [TYPE-GENERICS-DECL], [FLAVOR-ML-GENERICS],
    [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [BUILTIN-LIST-GET],
    [BUILTIN-MAP-GET], [BUILTIN-LIST-APPEND], [BUILTIN-MAP-SET], and
    [BUILTIN-LIST-FOREACH]. *)
type Envelope T U =
    payload : T
    metadata : U

effect RecordAudit
    note : string => Unit

nestedAt<T> : (List (List T), int, int, List T, T) -> T
nestedAt (matrix, row, column, fallbackRow, fallback) =
    listGet (listGet matrix row ?: fallbackRow) column ?: fallback

groupAt<T> : (Map string (List T), string, int, List T, T) -> T
groupAt (groups, key, index, fallbackList, fallback) =
    listGet (mapGet groups key ?: fallbackList) index ?: fallback

(** The cases' shared fallbacks, one accessor per element type. *)
intAt (matrix, row, column) = nestedAt (matrix, row, column, [99], 99)
textGroup (groups, key, index) = groupAt (groups, key, index, ["row"], "item")

(** One nested-matrix probe: where to read and the exact value it must hold. *)
type CellProbe =
    row : int
    column : int
    value : int

(** One group probe: which key and index, and the exact element it must hold. *)
type GroupProbe =
    key : string
    index : int
    value : string

(** Asserts every cell probe reads its exact value out of `matrix`. *)
checkCells (label, matrix, probes) =
    forEachList probes (\probe => check label probe.value (intAt (matrix, probe.row, probe.column)))

(** Asserts every group probe reads its exact element out of `groups`. *)
checkGroups (label, groups, probes) =
    forEachList probes (\probe => check label probe.value (textGroup (groups, probe.key, probe.index)))

(** The number of elements stored under `key`, or none when the key is absent. *)
groupSize (groups, key) = listLength (mapGet groups key ?: ["missing"])

auditEnvelopeMetadata envelopes =
    mut transcript = ""
    handle RecordAudit
        note value =>
            transcript := transcript + value + "/"
    forEachList envelopes (\envelope => perform RecordAudit.note envelope.metadata)
    transcript

(** The same two-parameter generic record crosses an effectful callback, list
    and map storage, `Result` fallbacks, field recovery, an effectful callback,
    and persistent descendants. This jointly enforces [TYPE-GENERICS-DECL],
    [BUILTIN-LIST-FOREACH], [BUILTIN-LIST-GET], and [BUILTIN-MAP-GET]. *)
genericRecordCollectionEffectCase () =
    first = Envelope<List<List<int>>, string>(payload = [[1, 2], [3, 4, 5]], metadata = "int-matrix")
    second = Envelope<List<List<int>>, string>(payload = [[6, 7], [8, 9, 10]], metadata = "second")
    fallback = Envelope<List<List<int>>, string>(payload = [[99]], metadata = "fallback")
    envelopes = [first, second]
    grown = envelopes |> listAppend (Envelope<List<List<int>>, string>(payload = [[11, 12]], metadata = "third"))
    firstBack = listGet envelopes 0 ?: fallback
    secondBack = listGet envelopes 1 ?: fallback
    thirdBack = listGet grown 2 ?: fallback
    stringEnvelope = Envelope<Map<string, List<string>>, int>(
        payload = Map () |> mapSet "short" ["a", "bb"] |> mapSet "long" ["three", "seven"],
        metadata = 17)
    stringFallback = Envelope<Map<string, List<string>>, int>(payload = mapSet (Map ()) "missing" ["fallback"], metadata = 99)
    envelopeMap = Map () |> mapSet "primary" stringEnvelope
    stringBack = mapGet envelopeMap "primary" ?: stringFallback
    missingBack = mapGet envelopeMap "missing" ?: stringFallback

    checkAll "Envelope<List<List<int>>,string> survives list storage and persistence" [
        listLength envelopes == 2,
        listLength grown == 3,
        structuralEquals [firstBack.metadata, secondBack.metadata] ["int-matrix", "second"],
        thirdBack.metadata == "third",
        structuralEquals [length firstBack.metadata, length secondBack.metadata, length thirdBack.metadata] [10, 6, 5],
        (listGet envelopes 8 ?: fallback).metadata == "fallback",
        nestedAt ((listGet envelopes 8 ?: fallback).payload, 0, 0, [91], 98) == 99,
        listLength envelopes == 2,
        structuralEquals [firstBack.metadata, auditEnvelopeMetadata envelopes] ["int-matrix", "int-matrix/second/"],
        auditEnvelopeMetadata grown == "int-matrix/second/third/"
    ]

    checkCells ("first envelope matrix cells", firstBack.payload, [
        CellProbe(row = 0, column = 0, value = 1),
        CellProbe(row = 0, column = 1, value = 2),
        CellProbe(row = 1, column = 0, value = 3),
        CellProbe(row = 1, column = 2, value = 5)
    ])
    checkCells ("second envelope matrix cells", secondBack.payload, [
        CellProbe(row = 0, column = 0, value = 6),
        CellProbe(row = 0, column = 1, value = 7),
        CellProbe(row = 1, column = 0, value = 8),
        CellProbe(row = 1, column = 2, value = 10)
    ])
    checkCells ("grown envelope matrix cells", thirdBack.payload, [
        CellProbe(row = 0, column = 0, value = 11),
        CellProbe(row = 0, column = 1, value = 12)
    ])

    checkAll "Envelope<Map<string,List<string>>,int> survives map storage and lookup" [
        mapLength envelopeMap == 1,
        mapContains envelopeMap "primary",
        !(mapContains envelopeMap "missing"),
        structuralEquals [stringBack.metadata, length (textGroup (stringBack.payload, "long", 1))] [17, 5],
        structuralEquals [groupSize (stringBack.payload, "short"), groupSize (stringBack.payload, "long")] [2, 2],
        structuralEquals [missingBack.metadata, mapLength stringBack.payload, mapLength missingBack.payload] [99, 2, 1],
        listLength (mapKeys stringBack.payload) == 2,
        listContains (mapKeys stringBack.payload) "short",
        listContains (mapKeys stringBack.payload) "long",
        !(listContains (mapKeys stringBack.payload) "missing")
    ]

    checkGroups ("primary envelope groups", stringBack.payload, [
        GroupProbe(key = "short", index = 0, value = "a"),
        GroupProbe(key = "short", index = 1, value = "bb"),
        GroupProbe(key = "long", index = 0, value = "three"),
        GroupProbe(key = "long", index = 1, value = "seven")
    ])
    checkGroups ("missing envelope group", missingBack.payload, [
        GroupProbe(key = "missing", index = 0, value = "fallback")
    ])

    checkAll "different T and U argument lists remain isolated" [
        firstBack.metadata != secondBack.metadata,
        secondBack.metadata != thirdBack.metadata,
        intAt (firstBack.payload, 0, 0) != intAt (secondBack.payload, 0, 0),
        intAt (secondBack.payload, 0, 0) != intAt (thirdBack.payload, 0, 0),
        stringBack.metadata != missingBack.metadata,
        textGroup (stringBack.payload, "short", 0) != textGroup (missingBack.payload, "missing", 0),
        structuralEquals [mapLength envelopeMap, listLength envelopes, listLength grown] [1, 2, 3]
    ]

test "multi-argument generic records mix effects lists maps and Results" genericRecordCollectionEffectCase
