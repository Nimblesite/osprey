/// Default twin of the regression oracle for [TYPE-LIST-PATTERNS] and
/// [TYPE-FIELD-ACCESS-NON-RECORD]: a recursive generic function that reads a
/// field two records declare, off a `[first, ...rest]` element, resolves the
/// record from the list it walks, at every depth of the recursion.

/// A binder: the first of two records declaring `name` and `ty`.
type Binder = { name: string, ty: int }

/// A declaration: the second record declaring `name` and `ty`.
type Decl = { name: string, ty: int, extra: int }

/// Every element's `name`, walked by self-recursion over the tail.
fn names(context) = match context {
    [] => []
    [first, ...rest] => listPrepend(names(rest), first.name)
}

/// The sum of every element's `ty`, saturating.
fn tySum(context) = match context {
    [] => 0
    [first, ...rest] => satAdd(tySum(rest), first.ty)
}

/// Two elements per step, so the tail is bound past a two-element prefix.
fn pairNames(context) = match context {
    [] => ""
    [only] => only.name
    [first, second, ...rest] => first.name + second.name + pairNames(rest)
}

/// Recursion through an accumulator parameter as well as the tail.
fn joined(context, acc) = match context {
    [] => acc
    [first, ...rest] => joined(rest, acc + first.name)
}

/// The element named `wanted`, found by two mutually recursive functions,
/// so the `Result` payload crosses a specialised call and an inlined phi.
fn found(context, wanted) = match context {
    [] => Error { message: "no ${wanted}" }
    [first, ...rest] => foundAt(first, rest, wanted)
}

/// One step of `found`: this element, or the search of the rest.
fn foundAt(first, rest, wanted) = match first.name == wanted {
    true => Success { value: first }
    false => found(rest, wanted)
}

/// The `ty` of the element named `wanted`, or `-1`.
fn tyOf(context, wanted) = match found(context, wanted) {
    Success { value } => value.ty
    Error { _message } => -1
}

/// The `name` read back off the found element, or the error message.
fn nameOf(context, wanted) = match found(context, wanted) {
    Success { value } => value.name
    Error { message } => message
}

/// No binders, typed so the walks below see a `List<Binder>`.
let noBinders: List<Binder> = []

/// The same recursive functions over lists of both records, whose shared
/// fields sit at the same slots, and over the empty list.
fn sharedFieldRecursionCase() = {
    let binders = [Binder { name: "a", ty: 1 }, Binder { name: "b", ty: 2 }, Binder { name: "c", ty: 3 }]
    let decls = [Decl { name: "x", ty: 10, extra: 7 }, Decl { name: "y", ty: 20, extra: 8 }]

    checkAll("binders", [
            structuralEquals([join(names(binders), ","), pairNames(binders)], ["a,b,c", "abc"]),
            structuralEquals([joined(binders, ">"), nameOf(binders, "b")], [">abc", "b"]),
            nameOf(binders, "q") == "no q",
            structuralEquals([tySum(binders), tyOf(binders, "a"), tyOf(binders, "c")], [6, 1, 3]),
            tyOf(binders, "q") == -1
    ])
    checkAll("declarations", [
            structuralEquals([join(names(decls), ","), pairNames(decls), joined(decls, "")], ["x,y", "xy", "xy"]),
            tySum(decls) == 30
    ])
    checkAll("empty and single", [
            structuralEquals([join(names(noBinders), ","), pairNames(noBinders)], ["", ""]),
            structuralEquals([pairNames([Binder { name: "z", ty: 0 }]), joined(noBinders, "-")], ["z", "-"]),
            nameOf(noBinders, "a") == "no a",
            tySum(noBinders) == 0,
            tyOf(noBinders, "a") == -1
    ])
}

test("recursive functions read shared record fields off list pattern elements and found results", sharedFieldRecursionCase)
