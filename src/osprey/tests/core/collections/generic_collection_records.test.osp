/// Cross-contract Default twin for [TYPE-GENERICS-DECL], [TYPE-LIST],
/// [TYPE-MAP], [TYPE-MAP-LOOKUP], [BUILTIN-LIST-GET], [BUILTIN-MAP-GET],
/// [BUILTIN-LIST-APPEND], [BUILTIN-MAP-SET], and [BUILTIN-LIST-FOREACH].
type Envelope<T, U> = { payload: T, metadata: U }

effect RecordAudit {
    note: fn(string) -> Unit
}

/// Reads `index` out of `found`, or out of `fallbackList` when it is missing.
fn atOr(found, index, fallbackList, fallback) =
listGet(found ?: fallbackList, index) ?: fallback

/// The cases' shared fallbacks, one accessor per element type.
fn intAt(matrix, row, column) = atOr(listGet(matrix, row), column, [99], 99)
fn textGroup(groups, key, index) = atOr(mapGet(groups, key), index, ["row"], "item")

/// The exact values the listed columns of `row` hold inside `matrix`.
fn rowCells(matrix, row, columns) = mapList(columns, fn(column) => intAt(matrix, row, column))

/// The exact cells the two probed rows of `matrix` hold: columns 0, 1 then 0, 2.
fn probedCells(matrix) = [rowCells(matrix, 0, [0, 1]), rowCells(matrix, 1, [0, 2])]

/// The exact elements the listed indices hold under `key` inside `groups`.
fn keyCells(groups, key, indices) = mapList(indices, fn(index) => textGroup(groups, key, index))

/// The number of elements stored under `key`, or none when the key is absent.
fn groupSize(groups, key) = listLength(mapGet(groups, key) ?: ["missing"])

fn auditEnvelopeMetadata(envelopes) = {
    mut transcript = ""
    handle RecordAudit {
        note value => { transcript = transcript + value + "/" }
    }
    forEachList(envelopes, fn(envelope) => perform RecordAudit.note(envelope.metadata))
    transcript
}

/// The same two-parameter record crosses an effectful callback, List and Map
/// storage, Result fallbacks, field recovery, and persistent descendants.
/// Implements [TYPE-GENERICS-DECL], [BUILTIN-LIST-FOREACH],
/// [BUILTIN-LIST-GET], and [BUILTIN-MAP-GET].
fn genericRecordCollectionEffectCase() = {
    let first = Envelope<List<List<int>>, string> { payload: [[1, 2], [3, 4, 5]], metadata: "int-matrix" }
    let second = Envelope<List<List<int>>, string> { payload: [[6, 7], [8, 9, 10]], metadata: "second" }
    let fallback = Envelope<List<List<int>>, string> { payload: [[99]], metadata: "fallback" }
    let envelopes = [first, second]
    let grown = listAppend(envelopes, Envelope<List<List<int>>, string> { payload: [[11, 12]], metadata: "third" })
    let firstBack = listGet(envelopes, 0) ?: fallback
    let secondBack = listGet(envelopes, 1) ?: fallback
    let thirdBack = listGet(grown, 2) ?: fallback
    let stringEnvelope = Envelope<Map<string, List<string>>, int> {
        payload: mapSet(mapSet(Map(), "short", ["a", "bb"]), "long", ["three", "seven"]),
        metadata: 17
    }
    let stringFallback = Envelope<Map<string, List<string>>, int> {
        payload: mapSet(Map(), "missing", ["fallback"]),
        metadata: 99
    }
    let envelopeMap = mapSet(Map(), "primary", stringEnvelope)
    let stringBack = mapGet(envelopeMap, "primary") ?: stringFallback
    let missingBack = mapGet(envelopeMap, "missing") ?: stringFallback

    checkAll("Envelope<List<List<int>>,string> survives list storage and persistence", [
            structuralEquals([listLength(envelopes), listLength(grown), length(firstBack.metadata)], [2, 3, 10]),
            structuralEquals([length(secondBack.metadata), length(thirdBack.metadata)], [6, 5]),
            atOr(listGet((listGet(envelopes, 8) ?: fallback).payload, 0), 0, [91], 98) == 99,
            listLength(envelopes) == 2,
            structuralEquals([firstBack.metadata, secondBack.metadata], ["int-matrix", "second"]),
            structuralEquals([thirdBack.metadata, (listGet(envelopes, 8) ?: fallback).metadata], ["third", "fallback"]),
            firstBack.metadata == "int-matrix",
            auditEnvelopeMetadata(envelopes) == "int-matrix/second/",
            auditEnvelopeMetadata(grown) == "int-matrix/second/third/",
            structuralEquals(probedCells(firstBack.payload), [[1, 2], [3, 5]]),
            structuralEquals(probedCells(secondBack.payload), [[6, 7], [8, 10]]),
            structuralEquals(rowCells(thirdBack.payload, 0, [0, 1]), [11, 12])
    ])

    checkAll("Envelope<Map<string,List<string>>,int> survives map storage and lookup", [
            structuralEquals([mapLength(envelopeMap), stringBack.metadata], [1, 17]),
            structuralEquals([length(textGroup(stringBack.payload, "long", 1)), missingBack.metadata], [5, 99]),
            structuralEquals([mapLength(stringBack.payload), mapLength(missingBack.payload)], [2, 1]),
            listLength(mapKeys(stringBack.payload)) == 2,
            mapContains(envelopeMap, "primary"),
            !mapContains(envelopeMap, "missing"),
            structuralEquals(mapList(["short", "long"], fn(k) => groupSize(stringBack.payload, k)), [2, 2]),
            listContains(mapKeys(stringBack.payload), "short"),
            listContains(mapKeys(stringBack.payload), "long"),
            !listContains(mapKeys(stringBack.payload), "missing"),
            structuralEquals(keyCells(stringBack.payload, "short", [0, 1]), ["a", "bb"]),
            structuralEquals(keyCells(stringBack.payload, "long", [0, 1]), ["three", "seven"]),
            structuralEquals(keyCells(missingBack.payload, "missing", [0]), ["fallback"])
    ])

    checkAll("different T and U argument lists remain isolated", [
            firstBack.metadata != secondBack.metadata,
            secondBack.metadata != thirdBack.metadata,
            intAt(firstBack.payload, 0, 0) != intAt(secondBack.payload, 0, 0),
            intAt(secondBack.payload, 0, 0) != intAt(thirdBack.payload, 0, 0),
            stringBack.metadata != missingBack.metadata,
            textGroup(stringBack.payload, "short", 0) != textGroup(missingBack.payload, "missing", 0),
            structuralEquals([mapLength(envelopeMap), listLength(envelopes), listLength(grown)], [1, 2, 3])
    ])
}

test("multi-argument generic records mix effects lists maps and Results", genericRecordCollectionEffectCase)
