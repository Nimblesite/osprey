/// Cross-contract Default twin for [TYPE-GENERICS-FN], [TYPE-MAP],
/// [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], [TYPE-LIST], [BUILTIN-MAP-GET],
/// [BUILTIN-MAP-SET], [BUILTIN-MAP-REMOVE], [BUILTIN-MAP-MERGE],
/// [BUILTIN-MAP-KEYS], [BUILTIN-MAP-VALUES], [BUILTIN-LIST-GET],
/// [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
effect MapDepot<T> {
    fetch: fn(string) -> Map<string, List<T>>
}

fn groupAt<T>(groups: Map<string, List<T>>, key: string, index: int, fallbackList: List<T>, fallback: T) =
listGet(mapGet(groups, key) ?: fallbackList, index) ?: fallback
/// groupIs reads group `key` of `groups` item by item through groupAt and
/// holds when the items are `wants`, in order.
fn groupIs(groups, key, fallbackList, fallback, wants) = range(0, listLength(wants)) |> fold(true, fn(ok, i) => ok && groupAt(groups, key, i, fallbackList, fallback) == (listGet(wants, i) ?: fallback))

fn intGroups() = mapSet(mapSet(Map(), "low", [1, 2]), "high", [30, 40, 50])
fn stringGroups() = mapSet(mapSet(Map(), "short", ["a", "bb"]), "long", ["three", "seven"])
fn floatGroups() = mapSet(mapSet(Map(), "small", [0.5, 1.25]), "large", [8.5, 9.75])
fn boolGroups() = mapSet(mapSet(Map(), "left", [true, false]), "right", [false, true])

/// requestGroups performs one MapDepot.fetch; the leaf type T is pinned by the
/// caller's expected map value.
fn requestGroups<T>(key) -> Map<string, List<T>> = perform MapDepot.fetch(key)

/// withDepot answers every MapDepot.fetch with `groups`, then runs the
/// effect body `request` under that handler.
fn withDepot<T>(groups: Map<string, List<T>>, request: fn() -> Map<string, List<T>>) = {
    handle MapDepot {
        fetch _key => groups
    }
    request()
}
fn mapListShape<T>(groups: Map<string, List<T>>) = match mapLength(groups) {
    0 => "empty"
    1 => "one:${listLength(mapValues(groups))}"
    _ => "many:${mapLength(groups)}/${listLength(mapValues(groups))}"
}

/// Crosses generic effect erasure, Map<string,List<T>> lookup, list and map
/// nesting, Result recovery, persistent rewrites, and view materialisation.
/// Implements [EFFECTS-GENERIC-RUNTIME], [TYPE-MAP-LOOKUP],
/// [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET].
fn nestedMapEffectPipelineCase() = {
    let ints = withDepot(intGroups(), fn() => requestGroups("ints"))
    let strings = withDepot(stringGroups(), fn() => requestGroups("strings"))
    let floats = withDepot(floatGroups(), fn() => requestGroups("floats"))
    let bools = withDepot(boolGroups(), fn() => requestGroups("bools"))
    let listOfMaps = [ints, mapSet(ints, "high", [60, 70]), mapSet(Map(), "only", [80, 90])]
    let mapOfListsOfMaps = mapSet(Map(), "generations", listOfMaps)
    let generations = mapGet(mapOfListsOfMaps, "generations") ?: [intGroups()]
    let second = listGet(generations, 1) ?: intGroups()
    let third = listGet(generations, 2) ?: intGroups()
    let rewritten = mapRemove(mapSet(ints, "extra", [6, 7]), "low")
    let merged = mapMerge(ints, mapSet(Map(), "high", [80, 90]))

    checkAll("Map<string,List<T>> recovers four concrete leaf arguments", [
            mapLength(ints) == 2,
            mapLength(strings) == 2,
            mapLength(floats) == 2,
            mapLength(bools) == 2,
            listLength(mapGet(ints, "low") ?: [99]) == 2,
            listLength(mapGet(ints, "high") ?: [99]) == 3,
            groupIs(ints, "low", [91], 99, [1, 2]),
            groupIs(ints, "high", [91], 99, [30, 40, 50]),
            groupAt(ints, "missing", 0, [91], 99) == 91,
            groupAt(ints, "low", 8, [91], 99) == 99,
            groupIs(strings, "short", ["row"], "item", ["a", "bb"]),
            groupIs(strings, "long", ["row"], "item", ["three", "seven"]),
            length(groupAt(strings, "long", 1, ["row"], "item")) == 5,
            groupAt(strings, "missing", 0, ["row"], "item") == "row",
            groupIs(floats, "small", [9.0], 9.5, [0.5, 1.25]),
            groupIs(floats, "large", [9.0], 9.5, [8.5, 9.75]),
            groupAt(floats, "small", 0, [9.0], 9.5) + groupAt(floats, "small", 1, [9.0], 9.5) == 1.75,
            groupAt(bools, "left", 0, [false], false),
            !groupAt(bools, "left", 1, [true], true),
            !groupAt(bools, "right", 0, [true], true),
            groupAt(bools, "right", 1, [false], false)
    ])

    checkAll("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", [
            listLength(listOfMaps) == 3,
            mapLength(mapOfListsOfMaps) == 1,
            listLength(generations) == 3,
            mapLength(listGet(generations, 0) ?: Map()) == 2,
            mapLength(second) == 2,
            mapLength(third) == 1,
            groupAt(listGet(generations, 0) ?: intGroups(), "high", 2, [91], 99) == 50,
            groupIs(second, "high", [91], 99, [60, 70]),
            groupIs(third, "only", [91], 99, [80, 90]),
            mapListShape(Map()) == "empty",
            mapListShape(mapSet(Map(), "one", [1])) == "one:1",
            structuralEquals([mapListShape(ints), mapListShape(strings), mapListShape(floats), mapListShape(bools)], ["many:2/2", "many:2/2", "many:2/2", "many:2/2"])
    ])

    checkAll("persistent map pipelines preserve descendants and source generations", [
            mapLength(rewritten) == 2,
            !mapContains(rewritten, "low"),
            mapContains(rewritten, "high"),
            mapContains(rewritten, "extra"),
            groupAt(rewritten, "high", 2, [91], 99) == 50,
            groupIs(rewritten, "extra", [91], 99, [6, 7]),
            mapLength(merged) == 2,
            groupIs(merged, "high", [91], 99, [80, 90]),
            groupAt(ints, "high", 0, [91], 99) == 30,
            mapContains(ints, "low"),
            !mapContains(ints, "extra"),
            listLength(mapKeys(ints)) == 2,
            listLength(mapValues(ints)) == 2,
            listContains(mapKeys(ints), "low"),
            listContains(mapKeys(ints), "high"),
            !listContains(mapKeys(ints), "extra"),
            structuralEquals(mapList(mapValues(ints), fn(items) => listLength(items) >= 2), [true, true])
    ])
}

test("generic map effects mix nested lists Results views and pipelines", nestedMapEffectPipelineCase)
