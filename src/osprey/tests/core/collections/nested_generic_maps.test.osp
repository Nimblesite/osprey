/// Cross-contract Default twin for [TYPE-GENERICS-FN], [TYPE-MAP],
/// [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], [TYPE-LIST], [BUILTIN-MAP-GET],
/// [BUILTIN-MAP-SET], [BUILTIN-MAP-REMOVE], [BUILTIN-MAP-MERGE],
/// [BUILTIN-MAP-KEYS], [BUILTIN-MAP-VALUES], [BUILTIN-LIST-GET],
/// [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
effect MapDepot<T> {
    fetch: fn(string) -> Map<string, List<T>>
}

fn groupAt<T>(groups: Map<string, List<T>>, key: string, index: int, fallbackList: List<T>, fallback: T) =
listGet(mapGet(groups, key) ?: fallbackList, index) ?: fallback

/// The cases' shared fallbacks, one accessor per element type.
fn intGroup(groups, key, index) = groupAt(groups, key, index, [91], 99)
fn textGroup(groups, key, index) = groupAt(groups, key, index, ["row"], "item")
fn floatGroup(groups, key, index) = groupAt(groups, key, index, [9.0], 9.5)
fn boolGroup(groups, key, index) = groupAt(groups, key, index, [false], false)
fn boolMissGroup(groups, key, index) = groupAt(groups, key, index, [true], true)

/// The int at `index` of `xs`, or a sentinel no case expects.
fn listInt(xs, index) = listGet(xs, index) ?: (0 - 999)

/// The string at `index` of `xs`, or a sentinel no case expects.
fn listText(xs, index) = listGet(xs, index) ?: ""

/// The float at `index` of `xs`, or a sentinel no case expects.
fn listFloat(xs, index) = listGet(xs, index) ?: (0.0 - 999.0)

/// Asserts each `keys[i]`/`indices[i]` cell of `groups` reads back `values[i]`.
fn cells(label, groups, keys, indices, values, group, leaf) =
forEachList(toList(range(0, listLength(values))), fn(i) =>
    check(label, leaf(values, i), group(groups, listText(keys, i), listInt(indices, i))))

fn intGroups() = mapSet(mapSet(Map(), "low", [1, 2]), "high", [30, 40, 50])
fn stringGroups() = mapSet(mapSet(Map(), "short", ["a", "bb"]), "long", ["three", "seven"])
fn floatGroups() = mapSet(mapSet(Map(), "small", [0.5, 1.25]), "large", [8.5, 9.75])
fn boolGroups() = mapSet(mapSet(Map(), "left", [true, false]), "right", [false, true])

/// Answers every depot request with `groups`, then runs a `kind`ed request.
fn depotGroups(groups, kind) = {
    handle MapDepot {
        fetch _key => groups
    }
    perform MapDepot.fetch(kind)
}

fn effectIntGroups() = depotGroups(intGroups(), "ints")
fn effectStringGroups() = depotGroups(stringGroups(), "strings")
fn effectFloatGroups() = depotGroups(floatGroups(), "floats")
fn effectBoolGroups() = depotGroups(boolGroups(), "bools")

fn mapListShape<T>(groups: Map<string, List<T>>) = match mapLength(groups) {
    0 => "empty"
    1 => "one:${listLength(mapValues(groups))}"
    _ => "many:${mapLength(groups)}/${listLength(mapValues(groups))}"
}

/// Crosses generic effect erasure, Map<string,List<T>> lookup, list and map
/// nesting, Result recovery, persistent rewrites, and view materialisation.
/// Implements [EFFECTS-GENERIC-RUNTIME], [TYPE-MAP-LOOKUP],
/// [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET].
fn nestedMapEffectPipelineCase() = {
    let ints = effectIntGroups()
    let strings = effectStringGroups()
    let floats = effectFloatGroups()
    let bools = effectBoolGroups()
    let listOfMaps = [ints, mapSet(ints, "high", [60, 70]), mapSet(Map(), "only", [80, 90])]
    let mapOfListsOfMaps = mapSet(Map(), "generations", listOfMaps)
    let generations = mapGet(mapOfListsOfMaps, "generations") ?: [intGroups()]
    let second = listGet(generations, 1) ?: intGroups()
    let third = listGet(generations, 2) ?: intGroups()
    let rewritten = mapRemove(mapSet(ints, "extra", [6, 7]), "low")
    let merged = mapMerge(ints, mapSet(Map(), "high", [80, 90]))

    cells("Map<string,List<T>> recovers four concrete leaf arguments", ints, ["low", "low", "high", "high", "high"], [0, 1, 0, 1, 2], [1, 2, 30, 40, 50], intGroup, listInt)
    cells("Map<string,List<T>> recovers four concrete leaf arguments", strings, ["short", "short", "long", "long"], [0, 1, 0, 1], ["a", "bb", "three", "seven"], textGroup, listText)
    cells("Map<string,List<T>> recovers four concrete leaf arguments", floats, ["small", "small", "large", "large"], [0, 1, 0, 1], [0.5, 1.25, 8.5, 9.75], floatGroup, listFloat)
    checkAll("Map<string,List<T>> recovers four concrete leaf arguments", [
            structuralEquals([mapLength(ints), mapLength(strings), mapLength(floats)], [2, 2, 2]),
            structuralEquals([mapLength(bools), listLength(mapGet(ints, "low") ?: [99])], [2, 2]),
            structuralEquals([listLength(mapGet(ints, "high") ?: [99]), intGroup(ints, "missing", 0)], [3, 91]),
            structuralEquals([intGroup(ints, "low", 8), length(textGroup(strings, "long", 1))], [99, 5]),
            textGroup(strings, "missing", 0) == "row",
            floatGroup(floats, "small", 0) + floatGroup(floats, "small", 1) == 1.75,
            structuralEquals([boolGroup(bools, "left", 0), boolMissGroup(bools, "left", 1)], [true, false]),
            structuralEquals([boolMissGroup(bools, "right", 0), boolGroup(bools, "right", 1)], [false, true])
    ])

    checkAll("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", [
            structuralEquals([listLength(listOfMaps), mapLength(mapOfListsOfMaps), listLength(generations)], [3, 1, 3]),
            structuralEquals([mapLength(listGet(generations, 0) ?: Map()), mapLength(second)], [2, 2]),
            structuralEquals([mapLength(third), intGroup(listGet(generations, 0) ?: intGroups(), "high", 2)], [1, 50]),
            structuralEquals([mapListShape(Map()), mapListShape(mapSet(Map(), "one", [1]))], ["empty", "one:1"]),
            structuralEquals([mapListShape(ints), mapListShape(strings)], ["many:2/2", "many:2/2"]),
            structuralEquals([mapListShape(floats), mapListShape(bools)], ["many:2/2", "many:2/2"])
    ])
    cells("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", second, ["high", "high"], [0, 1], [60, 70], intGroup, listInt)
    cells("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", third, ["only", "only"], [0, 1], [80, 90], intGroup, listInt)

    cells("persistent map pipelines preserve descendants and source generations", rewritten, ["high", "extra", "extra"], [2, 0, 1], [50, 6, 7], intGroup, listInt)
    cells("persistent map pipelines preserve descendants and source generations", merged, ["high", "high"], [0, 1], [80, 90], intGroup, listInt)
    cells("persistent map pipelines preserve descendants and source generations", ints, ["high"], [0], [30], intGroup, listInt)
    checkAll("persistent map pipelines preserve descendants and source generations", [
            structuralEquals([mapLength(rewritten), mapLength(merged)], [2, 2]),
            structuralEquals([listLength(mapKeys(ints)), listLength(mapValues(ints))], [2, 2]),
            structuralEquals(mapList(["low", "high"], fn(k) => mapContains(rewritten, k)), [false, true]),
            mapContains(rewritten, "extra"),
            mapContains(ints, "low"),
            !mapContains(ints, "extra"),
            structuralEquals(mapList(["low", "high"], fn(k) => listContains(mapKeys(ints), k)), [true, true]),
            !listContains(mapKeys(ints), "extra"),
            structuralEquals(mapList([0, 1], fn(i) => listLength(listGet(mapValues(ints), i) ?: [99]) >= 2), [true, true])
    ])
}

test("generic map effects mix nested lists Results views and pipelines", nestedMapEffectPipelineCase)
