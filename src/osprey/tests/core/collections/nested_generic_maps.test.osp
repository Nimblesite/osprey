/// Cross-contract Default twin for [TYPE-GENERICS-FN], [TYPE-MAP],
/// [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], [TYPE-LIST], [BUILTIN-MAP-GET],
/// [BUILTIN-MAP-SET], [BUILTIN-MAP-REMOVE], [BUILTIN-MAP-MERGE],
/// [BUILTIN-MAP-KEYS], [BUILTIN-MAP-VALUES], [BUILTIN-LIST-GET],
/// [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
effect MapDepot<T> {
    fetch: fn(string) -> Map<string, List<T>>
}

fn groupAt<T>(groups: Map<string, List<T>>, key: string, index: int, fallbackList: List<T>, fallback: T) =
listGet(mapGet(groups, key) ?: fallbackList, index) ?: fallback

/// The cases' shared fallbacks, one accessor per element type.
fn intGroup(groups, key, index) = groupAt(groups, key, index, [91], 99)
fn textGroup(groups, key, index) = groupAt(groups, key, index, ["row"], "item")
fn floatGroup(groups, key, index) = groupAt(groups, key, index, [9.0], 9.5)
fn boolGroup(groups, key, index) = groupAt(groups, key, index, [false], false)
fn boolMissGroup(groups, key, index) = groupAt(groups, key, index, [true], true)

/// The int at `index` of `xs`, or a sentinel no case expects.
fn listInt(xs) = fn(index) => listGet(xs, index) ?: (0 - 999)

/// The string at `index` of `xs`, or a sentinel no case expects.
fn listText(xs) = fn(index) => listGet(xs, index) ?: ""

/// The float at `index` of `xs`, or a sentinel no case expects.
fn listFloat(xs) = fn(index) => listGet(xs, index) ?: (0.0 - 999.0)

/// Asserts each `keys[i]`/`indices[i]` cell reads back `values[i]`, one check each.
fn checkCells(label, keys, keyPick, indices, values, probe, pick) =
forEachList(toList(range(0, listLength(values))), fn(i) =>
    check(label, pick(values, i), probe(keyPick(keys, i), listInt(indices)(i))))

fn intGroups() = mapSet(mapSet(Map(), "low", [1, 2]), "high", [30, 40, 50])
fn stringGroups() = mapSet(mapSet(Map(), "short", ["a", "bb"]), "long", ["three", "seven"])
fn floatGroups() = mapSet(mapSet(Map(), "small", [0.5, 1.25]), "large", [8.5, 9.75])
fn boolGroups() = mapSet(mapSet(Map(), "left", [true, false]), "right", [false, true])

fn requestIntGroups() -> Map<string, List<int>> = perform MapDepot.fetch("ints")
fn requestStringGroups() -> Map<string, List<string>> = perform MapDepot.fetch("strings")
fn requestFloatGroups() -> Map<string, List<float>> = perform MapDepot.fetch("floats")
fn requestBoolGroups() -> Map<string, List<bool>> = perform MapDepot.fetch("bools")

fn effectIntGroups() = {
    handle MapDepot {
        fetch _key => intGroups()
    }
    requestIntGroups()
}
fn effectStringGroups() = {
    handle MapDepot {
        fetch _key => stringGroups()
    }
    requestStringGroups()
}
fn effectFloatGroups() = {
    handle MapDepot {
        fetch _key => floatGroups()
    }
    requestFloatGroups()
}
fn effectBoolGroups() = {
    handle MapDepot {
        fetch _key => boolGroups()
    }
    requestBoolGroups()
}

fn mapListShape<T>(groups: Map<string, List<T>>) = match mapLength(groups) {
    0 => "empty"
    1 => "one:${listLength(mapValues(groups))}"
    _ => "many:${mapLength(groups)}/${listLength(mapValues(groups))}"
}

/// Crosses generic effect erasure, Map<string,List<T>> lookup, list and map
/// nesting, Result recovery, persistent rewrites, and view materialisation.
/// Implements [EFFECTS-GENERIC-RUNTIME], [TYPE-MAP-LOOKUP],
/// [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET].
fn nestedMapEffectPipelineCase() = {
    let ints = effectIntGroups()
    let strings = effectStringGroups()
    let floats = effectFloatGroups()
    let bools = effectBoolGroups()
    let listOfMaps = [ints, mapSet(ints, "high", [60, 70]), mapSet(Map(), "only", [80, 90])]
    let mapOfListsOfMaps = mapSet(Map(), "generations", listOfMaps)
    let generations = mapGet(mapOfListsOfMaps, "generations") ?: [intGroups()]
    let second = listGet(generations, 1) ?: intGroups()
    let third = listGet(generations, 2) ?: intGroups()
    let rewritten = mapRemove(mapSet(ints, "extra", [6, 7]), "low")
    let merged = mapMerge(ints, mapSet(Map(), "high", [80, 90]))

    checkCells("Map<string,List<T>> recovers four concrete leaf arguments", ["low", "low", "high", "high", "high"], fn(xs, i) => listText(xs)(i), [0, 1, 0, 1, 2], [1, 2, 30, 40, 50], fn(key, index) => intGroup(ints, key, index), fn(xs, i) => listInt(xs)(i))
    checkCells("Map<string,List<T>> recovers four concrete leaf arguments", ["short", "short", "long", "long"], fn(xs, i) => listText(xs)(i), [0, 1, 0, 1], ["a", "bb", "three", "seven"], fn(key, index) => textGroup(strings, key, index), fn(xs, i) => listText(xs)(i))
    checkCells("Map<string,List<T>> recovers four concrete leaf arguments", ["small", "small", "large", "large"], fn(xs, i) => listText(xs)(i), [0, 1, 0, 1], [0.5, 1.25, 8.5, 9.75], fn(key, index) => floatGroup(floats, key, index), fn(xs, i) => listFloat(xs)(i))
    checkAll("Map<string,List<T>> recovers four concrete leaf arguments", [
            structuralEquals([mapLength(ints), mapLength(strings), mapLength(floats), mapLength(bools)], [2, 2, 2, 2]),
            listLength(mapGet(ints, "low") ?: [99]) == 2,
            listLength(mapGet(ints, "high") ?: [99]) == 3,
            structuralEquals([intGroup(ints, "missing", 0), intGroup(ints, "low", 8)], [91, 99]),
            length(textGroup(strings, "long", 1)) == 5,
            textGroup(strings, "missing", 0) == "row",
            floatGroup(floats, "small", 0) + floatGroup(floats, "small", 1) == 1.75,
            boolGroup(bools, "left", 0),
            !boolMissGroup(bools, "left", 1),
            !boolMissGroup(bools, "right", 0),
            boolGroup(bools, "right", 1)
    ])

    checkAll("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", [
            structuralEquals([listLength(listOfMaps), mapLength(mapOfListsOfMaps), listLength(generations)], [3, 1, 3]),
            mapLength(listGet(generations, 0) ?: Map()) == 2,
            mapLength(second) == 2,
            mapLength(third) == 1,
            intGroup(listGet(generations, 0) ?: intGroups(), "high", 2) == 50,
            structuralEquals([mapListShape(Map()), mapListShape(mapSet(Map(), "one", [1]))], ["empty", "one:1"]),
            structuralEquals([mapListShape(ints), mapListShape(strings)], ["many:2/2", "many:2/2"]),
            structuralEquals([mapListShape(floats), mapListShape(bools)], ["many:2/2", "many:2/2"])
    ])
    checkCells("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", ["high", "high"], fn(xs, i) => listText(xs)(i), [0, 1], [60, 70], fn(key, index) => intGroup(second, key, index), fn(xs, i) => listInt(xs)(i))
    checkCells("List<Map<string,List<T>>> and Map<string,List<Map<string,List<T>>>> retain T", ["only", "only"], fn(xs, i) => listText(xs)(i), [0, 1], [80, 90], fn(key, index) => intGroup(third, key, index), fn(xs, i) => listInt(xs)(i))

    checkCells("persistent map pipelines preserve descendants and source generations", ["high", "extra", "extra"], fn(xs, i) => listText(xs)(i), [2, 0, 1], [50, 6, 7], fn(key, index) => intGroup(rewritten, key, index), fn(xs, i) => listInt(xs)(i))
    checkCells("persistent map pipelines preserve descendants and source generations", ["high", "high"], fn(xs, i) => listText(xs)(i), [0, 1], [80, 90], fn(key, index) => intGroup(merged, key, index), fn(xs, i) => listInt(xs)(i))
    checkCells("persistent map pipelines preserve descendants and source generations", ["high"], fn(xs, i) => listText(xs)(i), [0], [30], fn(key, index) => intGroup(ints, key, index), fn(xs, i) => listInt(xs)(i))
    checkAll("persistent map pipelines preserve descendants and source generations", [
            mapLength(rewritten) == 2,
            !mapContains(rewritten, "low"),
            mapContains(rewritten, "high"),
            mapContains(rewritten, "extra"),
            mapLength(merged) == 2,
            mapContains(ints, "low"),
            !mapContains(ints, "extra"),
            listLength(mapKeys(ints)) == 2,
            listLength(mapValues(ints)) == 2,
            listContains(mapKeys(ints), "low"),
            listContains(mapKeys(ints), "high"),
            !listContains(mapKeys(ints), "extra"),
            listLength(listGet(mapValues(ints), 0) ?: [99]) >= 2,
            listLength(listGet(mapValues(ints), 1) ?: [99]) >= 2
    ])
}

test("generic map effects mix nested lists Results views and pipelines", nestedMapEffectPipelineCase)
