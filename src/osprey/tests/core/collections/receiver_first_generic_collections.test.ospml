(** ML pipe-side oracle for the receiver-first call contract in
    [BUILTIN-STRING-UFCS] and [BUILTIN-ITER-PIPE], crossed with [TYPE-LIST],
    [TYPE-MAP], [BUILTIN-LIST-GET], [BUILTIN-MAP-GET],
    [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
    ML deliberately has no dot-UFCS surface; its `value |> function args`
    form must remain semantically identical to Default `value.function(args)`. *)
effect CallSupply T
    groups : Unit => Map string (List T)

intGroups () = Map () |> mapSet "low" [1, 2] |> mapSet "high" [30, 40, 50]
stringGroups () = Map () |> mapSet "short" ["a", "bb"] |> mapSet "long" ["three", "seven"]

requestIntGroups : Unit -> Map string (List int)
requestIntGroups () = perform CallSupply.groups ()
requestStringGroups : Unit -> Map string (List string)
requestStringGroups () = perform CallSupply.groups ()

suppliedInts () =
    handle CallSupply
        groups => intGroups ()
    requestIntGroups ()

suppliedStrings () =
    handle CallSupply
        groups => stringGroups ()
    requestStringGroups ()

groupAt<T> : (Map string (List T), string, int, List T, T) -> T
groupAt (groups, key, index, fallbackList, fallback) =
    (groups |> mapGet key ?: fallbackList) |> listGet index ?: fallback

(** The cases' shared fallbacks, one accessor per element type. *)
intGroup (groups, key, index) = groupAt (groups, key, index, [91], 99)
textGroup (groups, key, index) = groupAt (groups, key, index, ["row"], "item")

(** One group probe: which key and index, and the exact int it must hold. *)
type IntProbe =
    key : string
    index : int
    value : int

(** One group probe: which key and index, and the exact text it must hold. *)
type TextProbe =
    key : string
    index : int
    value : string

(** Asserts the pipe-side size views of the map `groups` answer `expected`. *)
checkMapSized (label, groups, expected) =
    checkAll label [
        (groups |> mapLength) == mapLength groups,
        (groups |> mapLength) == expected,
        (groups |> length) == expected,
        !((groups |> isEmpty))
    ]

(** Asserts the pipe-side size views of the list `xs` answer `expected`. *)
checkListSized (label, xs, expected) =
    checkAll label [
        (xs |> listLength) == expected,
        (xs |> length) == expected,
        !((xs |> isEmpty))
    ]

(** Asserts every probe reads its exact int out of the map `groups`. *)
checkIntGroups (label, groups, probes) =
    forEachList probes (\probe => check label probe.value (intGroup (groups, probe.key, probe.index)))

(** Asserts every probe reads its exact text out of the map `groups`. *)
checkTextGroups (label, groups, probes) =
    forEachList probes (\probe => check label probe.value (textGroup (groups, probe.key, probe.index)))

(** Asserts `groups` holds every key of `present` and none of `absent`. *)
checkKeys (label, groups, present, absent) =
    forEachList present (\key => check label true (groups |> mapContains key))
    forEachList absent (\key => check label false (groups |> mapContains key))

(** Asserts `xs` holds every item of `present` and none of `absent`. *)
checkContains (label, xs, present, absent) =
    forEachList present (\item => check label true (xs |> listContains item))
    forEachList absent (\item => check label false (xs |> listContains item))

(** The length of the nested list at `index` of `xs`, or none when it is absent. *)
nestedLength (xs, index) = (listGet xs index ?: [99]) |> listLength

(** One call chain crosses generic effect erasure, Map<string,List<T>> lookup,
    `Result` recovery, persistent operations, view conversion, reversal, and
    leaf extraction. This jointly enforces [BUILTIN-ITER-PIPE],
    [EFFECTS-GENERIC-RUNTIME], [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET]. *)
receiverFirstCollectionCase () =
    ints = suppliedInts ()
    strings = suppliedStrings ()
    high = ints |> mapGet "high" ?: [99]
    long = strings |> mapGet "long" ?: ["missing"]
    grownInts = ints |> mapSet "extra" [6, 7] |> mapRemove "low"
    grownStrings = strings |> mapSet "long" ["eight", "nine"]
    intValues = ints |> mapValues |> listReverse
    stringKeys = strings |> mapKeys |> listReverse

    checkMapSized ("original int map size", ints, 2)
    checkMapSized ("original string map size", strings, 2)
    checkMapSized ("grown int map size", grownInts, 2)
    checkMapSized ("grown string map size", grownStrings, 2)
    checkListSized ("high group size", high, 3)
    checkListSized ("long group size", long, 2)
    checkListSized ("reversed values size", intValues, 2)
    checkListSized ("reversed keys size", stringKeys, 2)
    checkIntGroups ("original int group probes", ints, [
        IntProbe(key = "low", index = 0, value = 1),
        IntProbe(key = "low", index = 1, value = 2)
    ])
    checkIntGroups ("grown int group probes", grownInts, [
        IntProbe(key = "high", index = 2, value = 50),
        IntProbe(key = "extra", index = 0, value = 6),
        IntProbe(key = "extra", index = 1, value = 7)
    ])
    checkTextGroups ("original string group probes", strings, [
        TextProbe(key = "short", index = 0, value = "a"),
        TextProbe(key = "short", index = 1, value = "bb"),
        TextProbe(key = "long", index = 0, value = "three")
    ])
    checkTextGroups ("grown string group probes", grownStrings, [
        TextProbe(key = "long", index = 0, value = "eight"),
        TextProbe(key = "long", index = 1, value = "nine")
    ])
    checkKeys ("grown int keys", grownInts, ["high", "extra"], ["low"])
    checkKeys ("original int keys", ints, ["low"], ["extra"])
    checkContains ("reversed key membership", stringKeys, ["short", "long"], ["missing"])

    checkAll "receiver-first entries and nested leaves" [
        structuralEquals [(high |> listGet 0 ?: 99), (high |> listGet 1 ?: 99)] [30, 40],
        structuralEquals [(high |> listGet 2 ?: 99), length (long |> listGet 0 ?: "missing")] [50, 5],
        ((Map () |> mapSet "one" [1] |> mapGet "one" ?: [99]) |> listGet 0 ?: 99) == 1,
        ((List () |> listAppend [8, 9] |> listGet 0 ?: [99]) |> listGet 1 ?: 99) == 9,
        structuralEquals [(long |> listGet 0 ?: "missing"), (long |> listGet 1 ?: "missing")] ["three", "seven"],
        nestedLength (intValues, 0) >= 2,
        nestedLength (intValues, 1) >= 2
    ]

test "receiver-first collection call syntax composes over nested generics" receiverFirstCollectionCase
