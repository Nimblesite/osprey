// Assertion-driven migration of the persistent List golden example.

(** IterationProbe records callback values so forEachList order is testable without stdout. *)
effect IterationProbe
    (** Record one callback value so traversal order is testable. *)
    observe : int => Unit

(** Slot is a record element, so `listGet` must hand back the whole record. *)
type Slot =
    label : string
    weight : float
    ready : bool

(** The two-slot record fixture every typed retrieval case indexes. *)
slotFixture () =
    [Slot(label = "left", weight = 1.5, ready = true), Slot(label = "right", weight = 2.5, ready = false)]

(** The int at `index`, or a sentinel far outside every case's value range. *)
listInt xs index = listGet xs index ?: (0 - 999)

(** The string at `index`, or a sentinel no case expects. *)
listText xs index = listGet xs index ?: ""

(** The float at `index`, or a sentinel no case expects. *)
listFloat xs index = listGet xs index ?: (0.0 - 999.0)

(** Asserts `xs` holds every entry of `expected` at the same index. *)
checkSame label xs expected pick =
    forEachList (toList (range 0 (listLength expected))) (\i =>
        check label (pick expected i) (pick xs i))

(** Asserts `xs` holds every int in `expected` at the same index. *)
checkList label xs expected = checkSame label xs expected listInt

(** Asserts `xs` holds every string in `expected` at the same index. *)
checkTextList label xs expected = checkSame label xs expected listText

(** Asserts each `[index, value]` row of `rows` reads back from `xs`. *)
checkIndexRows label xs rows =
    forEachList rows (\row =>
        check label (listInt row 1) (listInt xs (listInt row 0)))

(** Asserts `xs` holds every item of `present` and none of `absent`. *)
checkMembership label xs present absent =
    forEachList present (\item => check label true (listContains xs item))
    forEachList absent (\item => check label false (listContains xs item))

(** True when indexing `xs` at `index` answers the exact out-of-bounds error. *)
indexOob xs index = match listGet xs index
    Success _value => false
    Error message => message == "index out of bounds"

(** Asserts `probe` answers `expected` at each index, comparing through `pick`. *)
checkProbes label cases expected probe pick = checkCases label cases expected probe pick (List ())

(** Asserts `probe` answers `expected` at each index, `fallback` standing in for a missing case. *)
checkCases label cases expected probe pick fallback =
    forEachList (toList (range 0 (listLength expected))) (\i =>
        check label (pick expected i) (probe (listGet cases i ?: fallback)))

(** Asserts every index of `indices` misses `xs`, yielding `missing`. *)
checkPast label xs missing indices =
    forEachList indices (\i =>
        check label missing (listGet xs i ?: missing))

(** appendThrough builds inclusive integer ranges while preserving every prior list version. *)
appendThrough xs next last = match next > last
    true => xs
    false => appendThrough (listAppend xs next) (next + 1 ) last

(** classify exercises exact-length, singleton, pair, and head-tail list patterns. *)
classify : List int -> string
classify [] = "empty"
classify [single] = "one(${single})"
classify [first, second] = "two(${first},${second})"
classify [head, ...tail] = "many head=${head} rest=${listLength tail}"

(** sumList proves recursive head-tail destructuring retains every element. *)
sumList [] = 0
sumList [head, ...tail] = head + sumList tail 

(** restLen exercises a wildcard prefix followed by a captured list tail. *)
restLen : List int -> int
restLen [_, _second, ...rest] = listLength rest
restLen _ = 0

(** encodeIteration folds callback order into a base-100 integer through a handled
    effect, pinning forEachList's in-order traversal ([BUILTIN-LIST-FOREACH]). *)
encodeIteration xs =
    mut encoded = 0
    handle IterationProbe
        observe value =>
            encoded := encoded * 100 + value 
    forEachList xs (\value => perform IterationProbe.observe value)
    encoded

(** constructionAndIdentityCase preserves all legacy construction, identity, reverse, prepend, and contains observations. *)
constructionAndIdentityCase () =
    empty = List ()
    a = listAppend (listAppend (listAppend (List ()) 1) 2) 3
    b = listAppend (listAppend (List ()) 10) 20
    reversed = listReverse a
    restored = listReverse reversed
    prepended = listPrepend a 0
    concatenated = listConcat a b
    emptyPlusA = empty + a
    aPlusEmpty = a + empty
    doubledA = a + a
    abPlusA = a + b + a

    // Every legacy length observation remains an independent assertion.
    checkList "legacy construction and operation lengths" (mapList [empty, a, b, reversed, restored, concatenated, listConcat empty a, listConcat a empty, a + a, a + b + a, prepended, a] listLength) [0, 3, 2, 3, 3, 5, 3, 3, 6, 8, 4, 3]

    // Constituent checks ensure the old length-only observations cannot hide corrupt contents.
    checkList "construction and reverse contents" a [1, 2, 3]
    checkList "construction and reverse contents" b [10, 20]
    checkList "construction and reverse contents" reversed [3, 2, 1]
    checkList "construction and reverse contents" restored [1, 2, 3]
    checkList "construction and reverse contents" prepended [0, 1, 2, 3]

    // Concatenation identities and the operator alias are checked at their seams and endpoints.
    checkList "concat identities and boundaries" concatenated [1, 2, 3, 10, 20]
    checkList "concat identities and boundaries" emptyPlusA [1, 2, 3]
    checkList "concat identities and boundaries" aPlusEmpty [1, 2, 3]
    checkList "concat identities and boundaries" doubledA [1, 2, 3, 1, 2, 3]
    checkList "concat identities and boundaries" abPlusA [1, 2, 3, 10, 20, 1, 2, 3]

    // All three legacy contains results survive alongside additional positive and
    // endpoint checks ([BUILTIN-LIST-CONTAINS]).
    checkMembership "contains behavior" a [2, 1, 3] [99]
    checkMembership "contains behavior" concatenated [10, 20] []
    checkAll "contains behavior" [
        !(listContains (List ()) 1),
        !(listContains prepended 99)
    ]

(** iterationAndPersistenceCase preserves callback order plus every generation and branch observation. *)
iterationAndPersistenceCase () =
    a = listAppend (listAppend (listAppend (List ()) 1) 2) 3
    reversed = listReverse a
    b = listAppend (listAppend (List ()) 10) 20
    combined = a + b
    g0 = List ()
    g1 = listAppend g0 10
    g2 = listAppend g1 20
    g3 = listAppend g2 30
    g4 = listAppend g3 40
    g5 = listAppend g4 50
    x = listAppend g3 999
    y = listAppend g3 888
    y2 = listAppend y 777

    // Callback encodings preserve every legacy forEachList sequence and its exact order.
    checkList "forEachList iteration order" (mapList [a, reversed, combined] encodeIteration) [10203, 30201, 102031020]

    // One condition per formerly printed iteration value keeps the golden observations explicit.
    checkList "iteration constituent values" a [1, 2, 3]
    checkList "iteration constituent values" reversed [3, 2, 1]
    checkList "iteration constituent values" combined [1, 2, 3, 10, 20]

    // The six generation lengths, retained g2 length, and all branch lengths mirror the old golden.
    checkList "persistent generation and branch lengths" (mapList [g0, g1, g2, g3, g4, g5, g2, x, y, y2, g3] listLength) [0, 1, 2, 3, 4, 5, 2, 4, 4, 5, 3]

    // Added content checks prove later generations and sibling branches do not mutate their ancestors.
    checkMembership "persistent generation and branch contents" g1 [10] [20]
    checkMembership "persistent generation and branch contents" g2 [10, 20] [30, 50]
    checkMembership "persistent generation and branch contents" g5 [10, 50] []
    checkMembership "persistent generation and branch contents" x [999] [888]
    checkMembership "persistent generation and branch contents" y [888] [999, 777]
    checkMembership "persistent generation and branch contents" y2 [777] []
    checkMembership "persistent generation and branch contents" g3 [] [999, 888, 777]
    checkIndexRows "persistent generation and branch contents" g5 [[4, 50]]
    checkIndexRows "persistent generation and branch contents" y2 [[3, 888], [4, 777]]
    checkAll "persistent generation and branch contents" [ !(listContains g0 10) ]

(** tailBoundaryCase retains the 10/20/30/35 generations and probes both sides of the 32-element tail boundary. *)
tailBoundaryCase () =
    t = appendThrough (List ()) 1 10
    t2 = appendThrough t 11 20
    t3 = appendThrough t2 21 30
    t4 = appendThrough t3 31 35
    reversed = listReverse t4
    doubled = listConcat t4 t4

    // All six legacy tail-boundary length observations remain independent.
    checkList "tail boundary legacy lengths" (mapList [t, t2, t3, t4, reversed, doubled] listLength) [10, 20, 30, 35, 35, 70]

    // Boundary indices assert actual content before, at, and after the 32-element trie tail split.
    checkIndexRows "tail boundary contents" t [[0, 1], [9, 10]]
    checkIndexRows "tail boundary contents" t2 [[10, 11], [19, 20]]
    checkIndexRows "tail boundary contents" t3 [[29, 30]]
    checkIndexRows "tail boundary contents" t4 [[30, 31], [31, 32], [32, 33], [34, 35]]
    checkIndexRows "tail boundary contents" reversed [[0, 35], [2, 33], [3, 32], [34, 1]]
    checkIndexRows "tail boundary contents" doubled [[34, 35], [35, 1], [69, 35]]
    checkAll "tail boundary contents" [
        listLength t3 == 30,
        !(listContains t3 31)
    ]
    checkList "tail boundary contents" (mapList [t, t4] sumList) [55, 630]

(** indexingPatternsAndDispatchCase preserves Result indexing, list patterns, recursion, and receiver-directed builtins. *)
indexingPatternsAndDispatchCase () =
    commands = ["echo hello", "echo world", "echo test"]
    empty : List<string>
    empty = []
    a = listAppend (listAppend (listAppend (List ()) 1) 2) 3
    b = listAppend (listAppend (List ()) 10) 20
    singleton = listAppend (List ()) 7
    short = listAppend (List ()) 9
    pair = listAppend short 8
    four = listAppend (listAppend pair 7) 6
    patternFour = listAppend (listAppend (listAppend (listAppend (List ()) 4) 5) 6) 7
    t = appendThrough (List ()) 1 10
    dispatchFive = listAppend (listAppend (listAppend (listAppend (listAppend (List ()) 1) 2) 3) 4) 5
    dispatchTen = listConcat dispatchFive dispatchFive
    dispatchTwenty = listConcat dispatchTen dispatchTen
    dispatchThirty = listConcat dispatchTwenty dispatchTen
    dispatchThirtyFive = listConcat dispatchThirty dispatchFive
    commandOob = indexOob commands 5
    emptyOob = match empty[0]
        Success _value => false
        Error message => message == "index out of bounds"

    // Successful and failing index paths retain all four legacy observations and exact failure reasons.
    checkAll "list index Result behavior" [
        (commands[0] ?: "missing") == "echo hello",
        (commands[2] ?: "missing") == "echo test",
        commandOob,
        emptyOob,
        (commands[1] ?: "missing") == "echo world",
        listLength commands == 3,
        listLength empty == 0
    ]

    // Every legacy classify, recursive sum, and wildcard-rest result remains directly asserted.
    checkAll "list pattern and recursion results" [
        classify (List ()) == "empty",
        classify b == "two(10,20)",
        classify a == "many head=1 rest=2",
        classify singleton == "one(7)",
        sumList a == 6,
        sumList t == 55,
        restLen a == 1,
        restLen short == 0,
        restLen pair == 0,
        restLen four == 2,
        classify patternFour == "many head=4 rest=3"
    ]

    // The same patterns reached through a LITERAL argument. A callee cannot tell
    // which list layout it received — its parameter is one `i8*` either way — and
    // `osprey_list_get`/`_drop` need a real OspreyList, so every one of these
    // SEGFAULTED before the literal was rebuilt at the call boundary.
    // `osprey_list_length` masked it by reading both layouts' shared leading
    // `i64`, which is why the length-only assertions above never caught it.
    checkAll "list patterns bind through a literal argument" [
        classify [9] == "one(9)",
        classify [9, 8] == "two(9,8)",
        classify [9, 8, 7] == "many head=9 rest=2",
        sumList [1, 2, 3] == 6,
        sumList [5] == 5,
        restLen [1, 2, 3, 4] == 2,
        restLen [1] == 0
    ]

    // The old composite bare-length row is split into one condition per receiver.
    // A flat list literal is its own layout, distinct from both an OspreyList
    // handle and a string: it used to reach `osp_strlen`, which counted the
    // length word's bytes and answered 1 for any list of 1..=255 elements.
    checkAll "receiver-directed length dispatch" [
        length a == 3,
        length dispatchThirtyFive == 35,
        length "abcd" == 4,
        length empty == 0,
        length "" == 0,
        length commands == 3,
        length (lines "a\nb\nc") == 3
    ]

    // The old composite bare-isEmpty row is split and extended across derived lists.
    checkAll "receiver-directed isEmpty dispatch" [
        isEmpty empty,
        !(isEmpty a),
        isEmpty "",
        !(isEmpty "abcd"),
        !(isEmpty (listReverse a)),
        isEmpty (listConcat empty empty),
        !(isEmpty commands)
    ]

    // A flat list literal is a third layout, distinct from both an OspreyList
    // handle and a string. `+` used to hand `osprey_list_concat` the literal's
    // foreign header and SEGFAULT when exactly one side was a literal, and fall
    // through to integer arithmetic ("expected an integer") when both were. Each
    // operand is normalised to a runtime list first, so all four combinations of
    // literal and handle concatenate and keep their order.
    checkAll "list literal and runtime handle concatenate in either position" [
        listLength (commands + commands) == 6,
        listLength (commands + empty) == 3,
        listLength (empty + commands) == 3,
        listContains (commands + empty) "echo test",
        !(listContains (empty + commands) "echo missing"),
        listLength (a + [7, 8]) == 5,
        listLength ([7, 8] + a) == 5,
        listInt ([7, 8] + a) 0 == 7,
        listInt ([7, 8] + a) 2 == 1,
        listInt (a + [7, 8]) 3 == 7,
        listInt (a + [7, 8]) 4 == 8,
        length ([7, 8] + a) == 5
    ]

// Register the construction, identity, and content scenario.
test "lists construct, reverse, prepend, concatenate, and retain contents" (\() => exactArithmetic (constructionAndIdentityCase))

// Register the traversal, persistence, and branching scenario.
test "list iteration and persistent branches retain order and isolation" (\() => exactArithmetic (iterationAndPersistenceCase))

// Register the 32-element structural boundary scenario.
test "lists preserve content across the 32-element tail boundary" (\() => exactArithmetic (tailBoundaryCase))

// Register Result indexing, patterns, recursion, and builtin dispatch together.
test "list indexing, patterns, recursion, and receiver dispatch compose" (\() => exactArithmetic (indexingPatternsAndDispatchCase))

(** [BUILTIN-LIST-GET] declares `listGet(list: List<T>, index: int) -> Result<T, Error>`
    and says it is "equivalent to `list[index]`", with an out-of-range index
    returning `Error`. `T` is the element type, so a string list yields the
    string, a float list the float, a bool list the bool and a record list the
    whole record — never the raw storage word behind it. Every existing case
    above indexes an `int` list, where a word and a value are indistinguishable,
    which is exactly how issue #211 survived. *)
typedElementRetrievalCase () =
    words = ["alpha", "beta", "gamma"]
    ratios = [0.5, 1.25, 2.75]
    flags = [true, false, true]
    slots = slotFixture ()
    missingSlot = Slot(label = "missing", weight = 0.0, ready = false)
    firstSlot = listGet slots 0 ?: missingSlot
    secondSlot = listGet slots 1 ?: missingSlot
    pastEndSlot = listGet slots 2 ?: missingSlot

    // A string element comes back as its own string, at every index, through
    // both spellings the spec calls equivalent [BUILTIN-LIST-GET].
    checkTextList "string elements survive listGet" words ["alpha", "beta", "gamma"]
    checkTextList "string elements survive listGet" [words[0] ?: "none", words[1] ?: "none", words[2] ?: "none"] ["alpha", "beta", "gamma"]

    checkAll "string elements survive listGet" [
        length (listGet words 2 ?: "") == 5,
        "${listGet words 0 ?: "none"}-${listGet words 2 ?: "none"}" == "alpha-gamma",
        contains (listGet words 1 ?: "none") "et",
        !(contains (listGet words 1 ?: "none") "alpha"),
        startsWith (listGet words 2 ?: "none") "gam",
        endsWith (listGet words 2 ?: "none") "mma",
        toUpperCase (listGet words 0 ?: "none") == "ALPHA",
        (listGet words 3 ?: "past end") == "past end",
        (listGet words 99 ?: "past end") == "past end",
        (words[3] ?: "past end") == "past end"
    ]
    checkCases "string elements survive listGet" [0, 1, 2] ["alpha", "beta", "gamma"] (\(i) => listGet words i ?: "none") listText 0
    checkCases "string elements survive listGet" [0, 1, 2] [5, 4, 5] (\(i) => length (listGet words i ?: "")) listInt 0

    // The same rule holds through every persistent producer: a rebuilt list
    // still yields strings, not the words its cells happen to hold
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-PREPEND], [BUILTIN-LIST-APPEND],
    // [BUILTIN-LIST-CONCAT]).
    checkTextList "string elements survive every list producer" (listReverse words) ["gamma", "beta", "alpha"]
    checkTextList "string elements survive every list producer" (listPrepend words "zero") ["zero", "alpha", "beta", "gamma"]
    checkTextList "string elements survive every list producer" (listAppend words "delta") ["alpha", "beta", "gamma", "delta"]
    checkTextList "string elements survive every list producer" (words + ["delta"]) ["alpha", "beta", "gamma", "delta"]
    checkTextList "string elements survive every list producer" (["zero"] + words) ["zero", "alpha", "beta", "gamma"]

    checkAll "string elements survive every list producer" [
        listContains words "beta",
        !(listContains words "delta"),
        listContains (listAppend words "delta") "delta",
        listText (listReverse (listReverse words)) 1 == "beta"
    ]
    checkList "string elements survive every list producer" (mapList [listAppend words "delta", listPrepend words "zero"] listLength) [4, 4]

    // A float element keeps its IEEE value; a bool element keeps true/false.
    checkAll "float and bool elements survive listGet" [
        (ratios[1] ?: 0.0) == 1.25,
        (listGet ratios 0 ?: 0.0) + (listGet ratios 1 ?: 0.0) == 1.75,
        (listGet ratios 2 ?: 0.0) - (listGet ratios 0 ?: 0.0) == 2.25,
        (listGet ratios 1 ?: 0.0) * 2.0 == 2.5,
        (listGet ratios 9 ?: 9.5) == 9.5,
        (listGet (listReverse ratios) 0 ?: 0.0) == 2.75,
        listLength ratios == 3,
        (listGet flags 0 ?: false),
        !(listGet flags 1 ?: true),
        (listGet flags 2 ?: false),
        (flags[0] ?: false),
        !(flags[1] ?: true),
        (listGet flags 0 ?: false) == (listGet flags 2 ?: true),
        (listGet flags 0 ?: false) != (listGet flags 1 ?: true),
        !(listGet flags 7 ?: false),
        (listGet (listReverse flags) 1 ?: true) == false,
        listLength flags == 3
    ]
    checkCases "float and bool elements survive listGet" [0, 1, 2] [0.5, 1.25, 2.75] (\(i) => listGet ratios i ?: 0.0) listFloat 0

    // A record element comes back whole: every field of the stored record is
    // readable off the retrieved one, and the out-of-range case still takes
    // the declared `Error` branch rather than fabricating a record.
    checkAll "record elements survive listGet whole" [
        firstSlot.ready,
        !secondSlot.ready,
        firstSlot.label != secondSlot.label,
        firstSlot.weight != secondSlot.weight,
        firstSlot.ready != secondSlot.ready,
        firstSlot.weight + secondSlot.weight == 4.0,
        "${firstSlot.label}/${secondSlot.label}" == "left/right",
        !pastEndSlot.ready,
        (listGet (listAppend slots missingSlot) 2 ?: firstSlot).label == "missing",
        (listGet (listPrepend slots missingSlot) 0 ?: firstSlot).weight == 0.0,
        listLength slots == 2
    ]
    checkSame "record elements survive listGet whole" (mapList [firstSlot, secondSlot, pastEndSlot] (\(slot) => slot.label)) ["left", "right", "missing"] listText
    checkSame "record elements survive listGet whole" (mapList [firstSlot, secondSlot, pastEndSlot] (\(slot) => slot.weight)) [1.5, 2.5, 0.0] listFloat
    checkList "record elements survive listGet whole" (mapList [firstSlot, secondSlot] (\(slot) => length slot.label)) [4, 5]
    checkCases "record elements survive listGet whole" [0, 1] ["right", "left"] (\(i) => (listGet (listReverse slots) i ?: missingSlot).label) listText 0

// Register typed element retrieval across string, float, bool and record lists.
test "listGet returns the element type for every element type" (\() => exactArithmetic (typedElementRetrievalCase))

(** TranscriptProbe renders one visited element at a time, so `forEachList`'s
    traversal order over non-integer element types is observable without stdout. *)
effect TranscriptProbe
    (** Record one rendered element in traversal order. *)
    note : string => Unit

(** shapeOf reads only the SHAPE of a list, never an element, so one function
    pins arm selection for every element type: [TYPE-LIST-PATTERNS] says "a list
    pattern matches exactly the listed length unless its final element is a rest
    binder (`...name`)" and "the rest binder receives the remaining `List<T>`". *)
shapeOf xs = match xs
    [] => "none"
    [_only] => "single"
    [_first, _second] => "pair"
    [_head, ...tail] => "long+${listLength tail}"

(** headOr binds the first element through a rest-binder pattern, or answers the
    caller's fallback for the empty list [TYPE-LIST-PATTERNS]. *)
headOr (xs, fallback) = match xs
    [] => fallback
    [head, ..._tail] => head

(** secondOr binds a two-element prefix before the rest binder, the only place
    the spec permits a rest binder — last, and once. *)
secondOr (xs, fallback) = match xs
    [_first, second, ..._rest] => second
    _ => fallback

(** tailLength reports the rest binder's own length, distinguishing the empty
    list (-1) from a singleton whose tail is empty (0). *)
tailLength xs = match xs
    [] => ((0 - 1) )
    [_head, ...tail] => listLength tail

(** joinWords walks a string list through the rest binder, so a dropped,
    duplicated or reordered element changes the transcript. The annotation is
    load-bearing exactly as `classify`'s is: an interpolated binder does not pin
    its own element type. *)
joinWords : List string -> string
joinWords xs = match xs
    [] => ""
    [head, ...tail] => "${head}|${joinWords tail}"

(** lastWord recurses to the final element; the `[]` arm's string result is what
    infers the element type, so no annotation is legal here. *)
lastWord xs = match xs
    [] => "none"
    [only] => only
    [_head, ...rest] => lastWord rest

(** boolWeight turns a bool element into its counted weight through a match, so
    both flavors spell the same lowering (ML has no boolean ternary). *)
boolWeight flag = match flag
    true => 1
    false => 0

(** sumFloats reduces a float list through head/tail patterns. Float `+` is
    total, unlike checked integer `+` ([ARITH-CHECKED]), so no `?:` appears. *)
sumFloats xs = match xs
    [] => 0.0
    [head, ...tail] => head + sumFloats tail

(** countTrue counts the `true` elements of a bool list through list patterns. *)
countTrue xs = match xs
    [] => 0
    [head, ...tail] => boolWeight head + countTrue tail 

(** slotLabels proves a record element survives head/tail destructuring WHOLE:
    the bound head is a record whose fields are all readable. *)
slotLabels xs = match xs
    [] => ""
    [head, ...tail] => head.label + ">" + slotLabels tail

(** readySlots reads a second field off the same bound head, so a head bound to
    the wrong slot cannot pass by matching only one field. *)
readySlots xs = match xs
    [] => 0
    [head, ...tail] => boolWeight head.ready + readySlots tail 

(** totalWeight reads the third, float-typed field off the bound head. *)
totalWeight xs = match xs
    [] => 0.0
    [head, ...tail] => head.weight + totalWeight tail

(** rowAt unwraps a nested-list element, substituting a sentinel row that appears
    nowhere else, so the `Error` branch of [BUILTIN-LIST-GET] cannot pass as a
    legitimate row. *)
rowAt (rows, index) = match listGet rows index
    Success value => value
    Error _message => [777]

(** sumInner sums every element of every inner list, exercising a `List<T>` whose
    `T` is itself a `List<int>` ([TYPE-LIST]). *)
sumInner xs = match xs
    [] => 0
    [head, ...tail] => sumList head + sumInner tail 

(** describeMatrix selects its arm on the OUTER list's length while reading the
    INNER list's length [TYPE-LIST-PATTERNS]. *)
describeMatrix xs = match xs
    [] => "no rows"
    [only] => "one row of ${listLength only}"
    [first, second] => "rows ${listLength first}+${listLength second}"
    [head, ...tail] => "head ${listLength head} then ${listLength tail} more"

(** weave folds a running base-10 encoding, so a fold's visit ORDER is observable
    as one integer ([BUILTIN-ITER-FOLD] "reduces an iterator to a single value"). *)
weave (acc, value) = acc * 10 + value 

(** twice is the [BUILTIN-ITER-MAP] callback; isEvenValue the
    [BUILTIN-ITER-FILTER] predicate. *)
twice n = n * 2 

isEvenValue n = (n % 2 ) == 0

(** [TYPE-LIST-PATTERNS] states a list pattern "matches exactly the listed length
    unless its final element is a rest binder" and that "the rest binder receives
    the remaining `List<T>`" — a rule about SHAPE that must hold for every `T`.
    Every pattern case above matches a `List<int>`, where an element and its
    storage word are indistinguishable (the blind spot behind issue #211). These
    blocks re-run the same arms over `List<string>`, including empty,
    single-character, whitespace, punctuation, digit and duplicated elements. *)
stringListPatternCase () =
    noWords : List<string>
    noWords = []
    solo = ["solo"]
    duo = ["left", "right"]
    words = ["alpha", "beta", "gamma"]
    quad = ["a", "bb", "ccc", "dddd"]
    odd = ["", " ", "a", "12", "a,b", "ab ab"]
    dup = ["same", "same", "other", "same"]

    // Arm selection depends on written length alone, so a string list picks the
    // same arms an int list of the same length picks.
    checkProbes "string list patterns select the arm for the written length" [noWords, solo, duo, words, quad, odd, dup, ["x"], ["x", "y"], ["x", "y", "z"], listReverse words, listAppend duo "third", listPrepend solo "first", listConcat noWords solo, listConcat duo noWords, noWords + noWords] ["none", "single", "pair", "long+2", "long+3", "long+5", "long+3", "single", "pair", "long+2", "long+2", "long+2", "pair", "single", "pair", "none"] shapeOf listText
    checkProbes "string list patterns select the arm for the written length" [noWords, solo, duo, words, odd, dup] [0 - 1, 0, 1, 2, 5, 3] tailLength listInt

    // Each binder carries its OWN element: head, second and the fallback are
    // three distinct strings, so a binder reading the wrong slot is visible.
    checkProbes "string binders carry their own element" [noWords, solo, duo, words, odd, dup, listReverse words, listPrepend words "zero", listAppend words "delta", noWords + words, words + noWords, ["only"]] ["empty", "solo", "left", "alpha", "", "same", "gamma", "zero", "alpha", "alpha", "alpha", "only"] (\(xs) => headOr (xs, "empty")) listText
    checkProbes "string binders carry their own element" [noWords, solo, duo, words, odd, dup, listReverse words, listReverse quad, ["x", "y", "z"]] ["none", "none", "right", "beta", " ", "same", "beta", "ccc", "y"] (\(xs) => secondOr (xs, "none")) listText

    // Recursive head/tail traversal keeps every element, in index order, once.
    // "alpha|beta|gamma|" is 5+1+4+1+5+1 = 17 bytes; the six `odd` elements are
    // 0+1+1+2+3+5 = 12 bytes plus six separators = 18.
    checkProbes "recursive rest-binder traversal keeps string order" [noWords, solo, duo, words, quad, odd, dup, listReverse words, listReverse (listReverse words), listReverse dup, listAppend words "delta", listPrepend words "zero", duo + words, words + duo, noWords + words, words + noWords] ["", "solo|", "left|right|", "alpha|beta|gamma|", "a|bb|ccc|dddd|", "| |a|12|a,b|ab ab|", "same|same|other|same|", "gamma|beta|alpha|", "alpha|beta|gamma|", "same|other|same|same|", "alpha|beta|gamma|delta|", "zero|alpha|beta|gamma|", "left|right|alpha|beta|gamma|", "alpha|beta|gamma|left|right|", "alpha|beta|gamma|", "alpha|beta|gamma|"] joinWords listText
    checkList "recursive rest-binder traversal keeps string order" (mapList [words, odd, quad, dup] (\(xs) => length (joinWords xs))) [17, 18, 14, 21]
    checkProbes "recursive rest-binder traversal keeps string order" [noWords, solo, words, listReverse words, listAppend words "delta"] ["none", "solo", "gamma", "alpha", "delta"] lastWord listText

    // String elements are compared by CONTENT for membership
    // ([BUILTIN-LIST-CONTAINS]), so the empty string is a findable element and a
    // case difference is not.
    checkAll "string element edge cases survive indexing and membership" [
        isEmpty (listGet odd 0 ?: "x"),
        length (listGet odd 0 ?: "x") == 0,
        length (listGet odd 1 ?: "x") == 1,
        contains (listGet odd 4 ?: "x") ",",
        startsWith (listGet odd 5 ?: "x") "ab",
        endsWith (listGet odd 5 ?: "x") "ab",
        contains (listGet odd 5 ?: "x") " ",
        toUpperCase (listGet words 1 ?: "x") == "BETA",
        toLowerCase (toUpperCase (listGet words 2 ?: "x")) == "gamma",
        !(listContains noWords ""),
        (listGet dup 0 ?: "x") == (listGet dup 3 ?: "y"),
        (listGet dup 0 ?: "x") != (listGet dup 2 ?: "y")
    ]
    checkCases "string element edge cases survive indexing and membership" [0, 1, 3] ["", " ", "12"] (\(i) => listGet odd i ?: "x") listText 0
    checkMembership "string element edge cases survive indexing and membership" odd ["", " "] ["A"]
    checkMembership "string element edge cases survive indexing and membership" dup ["same", "other"] ["missing"]
    checkList "string element edge cases survive indexing and membership" (mapList [dup, odd, listReverse dup, words] listLength) [4, 6, 4, 3]

// Register list patterns over string elements.
test "string lists destructure, iterate, and rebuild through list patterns" (\() => exactArithmetic (stringListPatternCase))

(** The same [TYPE-LIST-PATTERNS] shape rules over `List<float>` and `List<bool>`,
    the two element types whose storage word is NOT an int. Every float used here
    is an exact binary fraction (a multiple of 0.25), so the sums are exact and a
    `==` on a float is a legitimate assertion. Float `+` is total; integer `+`
    stays checked ([ARITH-CHECKED]). *)
floatAndBoolListPatternCase () =
    noFloats : List<float>
    noFloats = []
    oneFloat = [1.5]
    twoFloats = [0.25, 0.75]
    ratios = [0.5, 1.25, 2.75]
    quarters = [0.0, 0.25, 0.5, 0.75]
    dupFloats = [2.0, 2.0, 1.0]
    noFlags : List<bool>
    noFlags = []
    allOn = [true, true, true]
    allOff = [false, false, false]
    mixed = [true, false, true]
    pairOn = [true, false]

    // Arm selection and binder identity for float elements.
    checkProbes "float list patterns select arms and bind elements" [noFloats, oneFloat, twoFloats, ratios, quarters, dupFloats] ["none", "single", "pair", "long+2", "long+3", "long+2"] shapeOf listText
    checkProbes "float list patterns select arms and bind elements" [noFloats, oneFloat, twoFloats, ratios, quarters, listReverse ratios] [9.5, 1.5, 0.25, 0.5, 0.0, 2.75] (\(xs) => headOr (xs, 9.5)) listFloat
    checkProbes "float list patterns select arms and bind elements" [noFloats, oneFloat, twoFloats, ratios, quarters] [9.5, 9.5, 0.75, 1.25, 0.25] (\(xs) => secondOr (xs, 9.5)) listFloat
    checkProbes "float list patterns select arms and bind elements" [noFloats, oneFloat, ratios, quarters] [0 - 1, 0, 2, 3] tailLength listInt

    // 0.5+1.25+2.75 = 4.5 and 0.0+0.25+0.5+0.75 = 1.5, both exact in binary, so
    // reversal and either concatenation order must reproduce them exactly
    // ([BUILTIN-LIST-REVERSE], [BUILTIN-LIST-CONCAT]).
    checkProbes "float head-tail recursion sums every element exactly once" [noFloats, oneFloat, twoFloats, ratios, quarters, dupFloats, listReverse ratios, listReverse quarters] [0.0, 1.5, 1.0, 4.5, 1.5, 5.0, 4.5, 1.5] sumFloats listFloat
    checkProbes "float head-tail recursion sums every element exactly once" [ratios + twoFloats, twoFloats + ratios, noFloats + ratios, ratios + noFloats, ratios + ratios, listAppend ratios 0.5, listPrepend ratios 0.5, [0.25], [0.25, 0.25]] [5.5, 5.5, 4.5, 4.5, 9.0, 5.0, 5.0, 0.25, 0.5] sumFloats listFloat
    checkAll "float head-tail recursion sums every element exactly once" [
        listLength ratios == 3,
        listLength (ratios + twoFloats) == 5,
        listContains ratios 1.25,
        !(listContains ratios 1.5),
        listContains dupFloats 2.0
    ]

    // Every bool permutation of length 0..3 is counted independently, so a
    // pattern that drops or double-counts the head cannot hide in a total.
    checkProbes "bool list patterns count every permutation" [noFlags, [true], pairOn, mixed] ["none", "single", "pair", "long+2"] shapeOf listText
    checkProbes "bool list patterns count every permutation" [noFlags, [true], [false], [true, true], [true, false], [false, true], [false, false], allOn, allOff, mixed, listReverse mixed, mixed + allOn, allOff + mixed, listAppend mixed false, listPrepend mixed false, listAppend allOff true] [0, 1, 0, 2, 1, 1, 0, 3, 0, 2, 2, 5, 2, 2, 2, 1] countTrue listInt
    checkAll "bool list patterns count every permutation" [
        boolWeight true == 1,
        boolWeight false == 0
    ]

    // A bool element keeps its own value through every binder and producer.
    checkAll "bool elements keep their value through binders and producers" [
        headOr (noFlags, false) == false,
        headOr (allOn, false),
        !(headOr (allOff, true)),
        headOr (mixed, false),
        !(headOr (listReverse pairOn, true)),
        secondOr (mixed, true) == false,
        secondOr (pairOn, true) == false,
        secondOr ([false, true], false),
        secondOr (noFlags, true),
        listContains mixed false,
        listContains mixed true,
        !(listContains allOn false),
        !(listContains allOff true),
        listLength (mixed + allOff) == 6,
        countTrue (mixed + allOff) == 2,
        tailLength mixed == 2,
        tailLength noFlags == ((0 - 1) ),
        listLength (listReverse allOn) == 3
    ]

// Register list patterns over float and bool elements.
test "float and bool lists destructure and recombine through list patterns" (\() => exactArithmetic (floatAndBoolListPatternCase))

(** [TYPE-LIST-PATTERNS] over `List<Slot>`. A rest-binder pattern must bind the
    WHOLE record, not the storage word behind it, so every arm below reads more
    than one field off the bound head. [BUILTIN-LIST-CONTAINS] adds the rule that
    "managed handles such as nested lists and records compare by identity", so a
    freshly built record with identical field values is NOT a member. *)
recordListPatternCase () =
    missingSlot = Slot(label = "missing", weight = 0.0, ready = false)
    soloSlot = Slot(label = "solo", weight = 3.0, ready = true)
    noSlots : List<Slot>
    noSlots = []
    oneSlot = [soloSlot]
    slots = slotFixture ()
    trio = listAppend slots (Slot(label = "extra", weight = 4.0, ready = true))
    noneHead = headOr (noSlots, missingSlot)
    soloHead = headOr (oneSlot, missingSlot)
    firstOfSlots = headOr (slots, missingSlot)
    secondOfSlots = secondOr (slots, missingSlot)
    reversedHead = headOr (listReverse slots, missingSlot)
    noneSecond = secondOr (noSlots, missingSlot)
    soloSecond = secondOr (oneSlot, missingSlot)
    secondOfTrio = secondOr (trio, missingSlot)

    // The bound head is a whole record: three fields of two different types are
    // readable off it, and the empty-list arm returns the caller's own record.
    checkProbes "record list patterns bind whole records" [noSlots, oneSlot, slots, trio] ["none", "single", "pair", "long+2"] shapeOf listText
    checkSame "record list patterns bind whole records" (mapList [noneHead, soloHead, firstOfSlots, reversedHead] (\(slot) => slot.label)) ["missing", "solo", "left", "right"] listText
    checkSame "record list patterns bind whole records" (mapList [noneHead, soloHead, firstOfSlots, reversedHead] (\(slot) => slot.weight)) [0.0, 3.0, 1.5, 2.5] listFloat
    checkAll "record list patterns bind whole records" [
        !noneHead.ready,
        soloHead.ready,
        firstOfSlots.ready,
        !reversedHead.ready,
        noneSecond.label == "missing",
        soloSecond.label == "missing",
        secondOfSlots.label == "right",
        secondOfSlots.weight == 2.5,
        !secondOfSlots.ready,
        secondOfTrio.label == "right",
        firstOfSlots.label != secondOfSlots.label
    ]
    checkList "record list patterns bind whole records" (mapList [slots, trio] tailLength) [1, 2]

    // Recursion over the rest binder reaches every record, in order, once.
    // "left>right>extra>" is 5+6+6 = 17 bytes; weights 1.5+2.5+4.0 = 8.0.
    checkProbes "record fields survive head-tail recursion" [noSlots, oneSlot, slots, trio, listReverse slots, listReverse trio, listPrepend slots soloSlot, noSlots + slots] ["", "solo>", "left>right>", "left>right>extra>", "right>left>", "extra>right>left>", "solo>left>right>", "left>right>"] slotLabels listText
    checkList "record fields survive head-tail recursion" (mapList [trio] (\(xs) => length (slotLabels xs))) [17]
    checkList "record fields survive head-tail recursion" (mapList [noSlots, oneSlot, slots, trio, listReverse trio, listPrepend slots missingSlot] readySlots) [0, 1, 1, 2, 2, 1]
    checkSame "record fields survive head-tail recursion" (mapList [noSlots, oneSlot, slots, trio, listReverse trio, slots + slots] totalWeight) [0.0, 3.0, 4.0, 8.0, 8.0, 8.0] listFloat

    // Building `trio` left `slots` untouched. A record has no decided `==`
    // ([BOOL-EQUALITY]), so membership is asked of a key, the label.
    checkAll "record lists stay persistent and are searched by key" [
        slotLabels slots == "left>right>",
        readySlots slots == 1,
        totalWeight slots == 4.0,
        contains (slotLabels oneSlot) "${soloSlot.label}>",
        contains (slotLabels (listPrepend slots soloSlot)) "${soloSlot.label}>",
        !(contains (slotLabels slots) "${soloSlot.label}>"),
        !(contains (slotLabels slots) "${missingSlot.label}>"),
        contains (slotLabels slots) "left>",
        !(contains (slotLabels noSlots) "${missingSlot.label}>"),
        (listGet trio 2 ?: missingSlot).label == "extra",
        (listGet trio 2 ?: missingSlot).weight == 4.0,
        (listGet trio 2 ?: missingSlot).ready,
        (listGet trio 3 ?: missingSlot).label == "missing",
        (listGet slots 2 ?: missingSlot).label == "missing",
        (listGet noSlots 0 ?: missingSlot).label == "missing",
        isEmpty noSlots,
        !(isEmpty slots)
    ]
    checkList "record lists stay persistent and are searched by key" (mapList [slots, trio, listAppend trio missingSlot, noSlots] listLength) [2, 3, 4, 0]
    checkList "record lists stay persistent and are searched by key" (mapList [slots, trio, listAppend trio missingSlot, noSlots] length) [2, 3, 4, 0]

// Register list patterns over record elements.
test "record lists destructure whole through list patterns" (\() => exactArithmetic (recordListPatternCase))

(** A `List<T>` whose `T` is itself a `List<int>` ([TYPE-LIST]). [BUILTIN-LIST-GET]
    must hand back the inner LIST, so every retrieval here is indexed again or
    summed; a raw storage word would have neither a length nor elements.
    [BUILTIN-LIST-CONTAINS] again applies its identity rule to nested lists. *)
nestedListCase () =
    emptyRow : List<int>
    emptyRow = []
    rows = [[1, 2], [3, 4, 5], [6, 7, 8, 9]]
    oneRow = [[9, 9, 9]]
    twoRows = [[1], [2, 3]]
    withEmptyRow = listAppend rows emptyRow
    grown = listAppend rows [10, 11]
    firstRow = rowAt (rows, 0)
    biggerFirstRow = listAppend firstRow 99
    sentinelProbe = rowAt (rows, 9)

    // Row sums: [1,2]=3, [3,4,5]=12, [6,7,8,9]=30, so sumInner(rows) = 45 and
    // sumInner(grown) = 45 + 21 = 66.
    checkAll "nested list elements come back as lists" [
        (listGet (rowAt (rows, 2)) 4 ?: 77) == 77,
        isEmpty (rowAt (withEmptyRow, 3))
    ]
    checkList "nested list elements come back as lists" (mapList [rows, withEmptyRow, grown, listReverse rows, rows + rows] listLength) [3, 4, 4, 3, 6]
    checkList "nested list elements come back as lists" (mapList [firstRow, rowAt (rows, 1), rowAt (rows, 2), sentinelProbe, rowAt (withEmptyRow, 3)] listLength) [2, 3, 4, 1, 0]
    checkList "nested list elements come back as lists" (mapList [firstRow, rowAt (rows, 1), rowAt (rows, 2), sentinelProbe] sumList) [3, 12, 30, 777]
    checkList "nested list elements come back as lists" (mapList [rows, oneRow, twoRows, withEmptyRow, grown] sumInner) [45, 27, 6, 45, 66]
    checkList "nested list elements come back as lists" (mapList [0, 1] (\(i) => listGet firstRow i ?: 0)) [1, 2]
    checkList "nested list elements come back as lists" (mapList [[1, 2], [2, 3]] (\(cell) => listGet (rowAt (rows, listInt cell 0)) (listInt cell 1) ?: 0)) [5, 9]

    // The outer arm is chosen by the outer length while the message reports the
    // inner length, so mixing the two up is visible in every arm.
    checkProbes "nested list patterns read outer arm and inner length" [oneRow, twoRows, rows, grown] ["single", "pair", "long+2", "long+3"] shapeOf listText
    checkProbes "nested list patterns read outer arm and inner length" [oneRow, twoRows, rows, grown, withEmptyRow, listReverse rows] ["one row of 3", "rows 1+2", "head 2 then 2 more", "head 2 then 3 more", "head 2 then 3 more", "head 4 then 2 more"] describeMatrix listText
    checkList "nested list patterns read outer arm and inner length" (mapList [headOr (rows, emptyRow), headOr (listReverse rows, emptyRow), secondOr (twoRows, emptyRow)] listLength) [2, 4, 2]
    checkList "nested list patterns read outer arm and inner length" (mapList [headOr (rows, emptyRow), secondOr (rows, emptyRow), secondOr (oneRow, emptyRow)] sumList) [3, 12, 0]
    checkList "nested list patterns read outer arm and inner length" (mapList [rows, oneRow] tailLength) [2, 0]

    // Appending to a retrieved row builds a NEW row and leaves the matrix alone:
    // the stored row keeps its own contents ([BOOL-EQUALITY] decides no `==`
    // for lists, so the rows are compared by their sums).
    checkAll "nested lists stay isolated when a retrieved row grows" [
        sumList (rowAt (rows, 0)) != sumList biggerFirstRow,
        sumList (rowAt (rows, 0)) == sumList [1, 2]
    ]
    checkList "nested lists stay isolated when a retrieved row grows" (mapList [rows, grown, listReverse rows, rows + rows] listLength) [3, 4, 3, 6]
    checkList "nested lists stay isolated when a retrieved row grows" (mapList [firstRow, biggerFirstRow, rowAt (rows, 0)] listLength) [2, 3, 2]
    checkList "nested lists stay isolated when a retrieved row grows" (mapList [biggerFirstRow, firstRow, rowAt (listReverse rows, 0), rowAt (listReverse rows, 2), rowAt (rows + rows, 3)] sumList) [102, 3, 30, 3, 3]
    checkList "nested lists stay isolated when a retrieved row grows" (mapList [rows, listReverse rows, rows + rows, rows] sumInner) [45, 45, 90, 45]

// Register nested-list indexing, patterns and isolation.
test "nested lists index, destructure, and stay isolated" (\() => exactArithmetic (nestedListCase))

(** [BUILTIN-LIST-FOREACH] states `forEachList` "calls `function` once per element
    in index order". One handler owns the transcript, so the assertions between
    the traversals are INTERMEDIATE observations: a lost or reordered element
    cannot hide behind a correct final string. [BUILTIN-ITER-RANGE],
    [BUILTIN-ITER-MAP], [BUILTIN-ITER-FILTER], [BUILTIN-ITER-FOLD] and
    [BUILTIN-ITER-FUSION] are pinned the same way, with a positional base-10
    encoding that changes if the visit order changes. *)
typedIterationOrderCase () =
    noWords : List<string>
    noWords = []
    words = ["alpha", "beta", "gamma"]
    flags = [true, false]
    counts = [7, 8, 9]
    ratios = [0.5, 1.25, 2.75]
    missingSlot = Slot(label = "missing", weight = 0.0, ready = false)
    slots = slotFixture ()
    mut log = ""

    handle TranscriptProbe
        note text =>
            log := "${log}${text}|"
    forEachList noWords (\word => perform TranscriptProbe.note word)

    // "Once per element" over zero elements is zero calls.
    checkAll "forEachList over an empty list records nothing" [
        log == "",
        length log == 0,
        isEmpty log,
        isEmpty noWords,
        listLength noWords == 0,
        shapeOf noWords == "none",
        tailLength noWords == ((0 - 1) )
    ]

    forEachList words (\word => perform TranscriptProbe.note word)

    // 5+1+4+1+5+1 = 17 bytes, and the reversed spelling must NOT appear.
    checkAll "forEachList visits string elements in index order" [
        log == "alpha|beta|gamma|",
        length log == 17,
        startsWith log "alpha|",
        endsWith log "gamma|",
        contains log "|beta|",
        !(contains log "gamma|beta|"),
        log == joinWords words
    ]

    forEachList flags (\flag => perform TranscriptProbe.note "${flag}")

    // 17 + "true|" (5) + "false|" (6) = 28.
    checkAll "forEachList visits bool elements in index order" [
        log == "alpha|beta|gamma|true|false|",
        length log == 28,
        endsWith log "true|false|",
        !(endsWith log "false|true|"),
        contains log "gamma|true|"
    ]

    forEachList counts (\count => perform TranscriptProbe.note "${count}")

    // 28 + "7|8|9|" (6) = 34.
    checkAll "forEachList visits int elements in index order" [
        log == "alpha|beta|gamma|true|false|7|8|9|",
        length log == 34,
        endsWith log "7|8|9|",
        !(contains log "9|8|7|"),
        contains log "false|7|"
    ]

    forEachList slots (\slot => perform TranscriptProbe.note slot.label)

    // 34 + "left|" (5) + "right|" (6) = 45.
    checkAll "forEachList visits record elements in index order" [
        log == "alpha|beta|gamma|true|false|7|8|9|left|right|",
        length log == 45,
        endsWith log "left|right|",
        !(endsWith log "right|left|"),
        contains log "9|left|"
    ]

    forEachList (listReverse words) (\word => perform TranscriptProbe.note word)

    // 45 + 17 = 62; the derived list is traversed, the source is not.
    checkAll "forEachList follows the derived list, not its source" [
        log == "alpha|beta|gamma|true|false|7|8|9|left|right|gamma|beta|alpha|",
        length log == 62,
        endsWith log "gamma|beta|alpha|",
        startsWith log "alpha|beta|gamma|",
        contains log "right|gamma|",
        joinWords words == "alpha|beta|gamma|",
        joinWords (listReverse words) == "gamma|beta|alpha|"
    ]

    // A fold over `range(0, n)` reproduces index order independently of
    // forEachList, so the two mechanisms cross-check each other.
    // weave(0,7)=7, weave(7,8)=78, weave(78,9)=789.
    checkAll "range folds reproduce list order for every element type" [
        (range (0, 3) |> fold "" (\(acc, i) => "${acc}${listGet words i ?: "?"}|")) == "alpha|beta|gamma|",
        (range (0, 3) |> fold 0 (\(acc, i) => weave (acc, (listGet counts i ?: 0)))) == 789,
        (range (0, 3) |> fold 0 (\(acc, i) => weave (acc, (listGet (listReverse counts) i ?: 0)))) == 987,
        (range (1, 3) |> fold 0 (\(acc, i) => weave (acc, (listGet counts i ?: 0)))) == 89,
        (range (0, 0) |> fold 0 (\(acc, i) => weave (acc, (listGet counts i ?: 0)))) == 0,
        (range (0, 2) |> fold 0 (\(acc, i) => acc + boolWeight (listGet flags i ?: false) )) == 1,
        (range (0, 2) |> fold 0.0 (\(acc, i) => acc + (listGet ratios i ?: 0.0))) == 1.75,
        (range (0, 3) |> fold 0.0 (\(acc, i) => acc + (listGet ratios i ?: 0.0))) == 4.5,
        (range (0, 2) |> fold "" (\(acc, i) => "${acc}${(listGet slots i ?: missingSlot).label}>")) == "left>right>",
        (range (0, 5) |> fold 0 (\(acc, i) => acc + i )) == 10,
        (range (5, 5) |> fold 99 weave) == 99,
        (range (1, 6) |> fold 0 weave) == 12345,
        (range (0, 3) |> fold "" (\(acc, i) => "${acc}${i};")) == "0;1;2;"
    ]

    // map/filter/fold chains over a range fuse into one loop
    // ([BUILTIN-ITER-FUSION]) but must still produce the documented order.
    // 1..5 doubled is 2,4,6,8,10 -> 24690; evens of 1..9 doubled are 4,8,12,16
    // -> 4, 48, 492, 4936.
    checkAll "map, filter and fold pipelines keep the documented order" [
        (range (1, 6) |> map twice |> fold 0 weave) == 24690,
        (range (1, 6) |> filter isEvenValue |> fold 0 weave) == 24,
        (range (1, 10) |> filter isEvenValue |> map twice |> fold 0 weave) == 4936,
        (range (1, 6) |> map twice |> filter isEvenValue |> fold 0 weave) == 24690,
        (range (1, 6) |> map twice |> fold 0 (\(a, b) => a + b )) == 30,
        (range (1, 6) |> filter isEvenValue |> fold 0 (\(a, b) => a + b )) == 6,
        (range (0, 4) |> map twice |> fold 0 weave) == 246,
        (range (0, 1) |> map twice |> fold 7 weave) == 70,
        (range (2, 2) |> map twice |> fold 5 weave) == 5,
        (range (1, 4) |> map twice |> fold "" (\(acc, v) => "${acc}${v},")) == "2,4,6,",
        (range (1, 4) |> fold "" (\(acc, v) => "${acc}${v},")) == "1,2,3,",
        twice 0 == 0,
        twice 21 == 42,
        isEvenValue 0,
        !(isEvenValue 7),
        isEvenValue 8,
        weave (0, 5) == 5,
        weave (12, 3) == 123
    ]

// Register traversal order across every element type and the iterator surface.
test "forEachList and range pipelines visit every element type in order" (\() => exactArithmetic (typedIterationOrderCase))

(** [BUILTIN-LIST-GET] says an "out-of-range index returns `Error`", and
    [TYPE-LIST] says "index access is bounds-checked". These blocks walk the
    boundary from both sides on every element type: the first index, the last
    index, one past the end, far past the end, and a negative index. The string
    list is grown to 40 elements so indices 31/32/33 straddle the 32-element
    structural tail split for a NON-int element type. *)
boundaryIndexCase () =
    five = ["s0", "s1", "s2", "s3", "s4"]
    ten = five + five
    twenty = ten + ten
    forty = twenty + twenty
    noWords : List<string>
    noWords = []
    words = ["alpha", "beta", "gamma"]
    ratios = [0.5, 1.25, 2.75]
    marks = [true, false]
    missingSlot = Slot(label = "missing", weight = 0.0, ready = false)
    slots = slotFixture ()
    negIndex = (0 - 1) 
    farNegIndex = (0 - 1000) 
    lastIndex = (listLength forty - 1) 
    negError = match listGet words negIndex
        Success _value => false
        Error message => message == "index out of bounds"
    farError = match listGet forty 1000
        Success _value => false
        Error message => message == "index out of bounds"
    emptyError = match listGet noWords 0
        Success _value => false
        Error message => message == "index out of bounds"

    // `forty` repeats "s0".."s4", so the element at index i is "s${i % 5}":
    // index 30 -> "s0", 31 -> "s1", 32 -> "s2" (the tail split), 39 -> "s4".
    checkAll "string list index boundaries around the 32-element tail" [
        listLength five == 5,
        listLength ten == 10,
        listLength twenty == 20,
        listLength forty == 40,
        lastIndex == 39,
        (listGet forty 0 ?: "?") == "s0",
        (listGet forty 4 ?: "?") == "s4",
        (listGet forty 5 ?: "?") == "s0",
        (listGet forty 30 ?: "?") == "s0",
        (listGet forty 31 ?: "?") == "s1",
        (listGet forty 32 ?: "?") == "s2",
        (listGet forty 33 ?: "?") == "s3",
        (listGet forty lastIndex ?: "?") == "s4",
        (listGet forty 40 ?: "past") == "past",
        (listGet forty 1000 ?: "past") == "past",
        (listGet forty negIndex ?: "past") == "past",
        (listGet forty farNegIndex ?: "past") == "past",
        (listGet (listReverse forty) 0 ?: "?") == "s4",
        (listGet (listReverse forty) 7 ?: "?") == "s2",
        (listGet (listReverse forty) 39 ?: "?") == "s0",
        listLength (listAppend forty "tail") == 41,
        (listGet (listAppend forty "tail") 40 ?: "?") == "tail",
        (listGet (listAppend forty "tail") 32 ?: "?") == "s2",
        (listGet (listPrepend forty "head") 0 ?: "?") == "head",
        (listGet (listPrepend forty "head") 33 ?: "?") == "s2",
        listLength forty == 40
    ]

    // The Error branch is taken for every element type. Asserting BOTH fallbacks
    // for the bool list proves the fallback was used rather than a stored value.
    checkAll "out-of-range indexing takes the Error branch for every type" [
        negError,
        farError,
        emptyError,
        (listGet words 3 ?: "past") == "past",
        (listGet words negIndex ?: "past") == "past",
        (listGet words 2 ?: "past") == "gamma",
        (listGet ratios 3 ?: 9.5) == 9.5,
        (listGet ratios negIndex ?: 9.5) == 9.5,
        (listGet ratios 2 ?: 9.5) == 2.75,
        (listGet marks 2 ?: false) == false,
        (listGet marks 2 ?: true) == true,
        (listGet marks negIndex ?: true) == true,
        (listGet marks 1 ?: true) == false,
        (listGet slots 2 ?: missingSlot).label == "missing",
        (listGet slots negIndex ?: missingSlot).label == "missing",
        (listGet slots 1 ?: missingSlot).label == "right",
        (listGet noWords 0 ?: "past") == "past",
        (listGet noWords negIndex ?: "past") == "past",
        isEmpty noWords,
        listLength noWords == 0
    ]

    // Every doubling keeps the repeating pattern, so a rebuilt list indexes the
    // same way its source did. "s0|s1|s2|s3|s4|" is 5 * 3 = 15 bytes.
    checkAll "doubled and derived lists index consistently" [
        joinWords five == "s0|s1|s2|s3|s4|",
        length (joinWords five) == 15,
        length (joinWords ten) == 30,
        length (joinWords twenty) == 60,
        length (joinWords forty) == 120,
        shapeOf forty == "long+39",
        tailLength forty == 39,
        headOr (forty, "?") == "s0",
        secondOr (forty, "?") == "s1",
        lastWord five == "s4",
        lastWord ten == "s4",
        listContains forty "s3",
        !(listContains forty "s5"),
        listContains five "s0",
        !(listContains noWords "s0"),
        (listGet ten 9 ?: "?") == "s4",
        (listGet twenty 19 ?: "?") == "s4",
        (listGet twenty 10 ?: "?") == "s0",
        listLength (ten + five) == 15,
        (listGet (ten + five) 10 ?: "?") == "s0",
        (listGet (five + ten) 4 ?: "?") == "s4",
        (listGet (five + ten) 5 ?: "?") == "s0"
    ]

// Register bounds checking across element types and the tail boundary.
test "list index boundaries are checked on every element type" (\() => exactArithmetic (boundaryIndexCase))

(** foldSeedCase pins [BUILTIN-ITER-FOLD]: a list-literal seed takes the runtime
    representation once, before the loop, so every iteration's listAppend and
    listConcat reads a runtime list. Left flat, the second iteration read the
    literal's header as a trie and crashed. *)
foldSeedCase () =
    squares = range (1, 5) |> fold [] (\(acc, i) => listAppend (acc, i * i))
    words = range (0, 3) |> fold [] (\(acc, i) => listAppend (acc, "w${i}"))
    doubled = range (0, 3) |> fold [] (\(acc, i) => listConcat (acc, [i, i]))
    seeded = range (3, 6) |> fold [1, 2] (\(acc, i) => listAppend (acc, i))
    checkAll "fold over a list-literal seed" [
        listLength squares == 4, (listGet (squares, 3) ?: 0) == 16, sumList squares == 30,
        listLength words == 3, (listGet (words, 2) ?: "?") == "w2", joinWords words == "w0|w1|w2|",
        listLength doubled == 6, (listGet (doubled, 4) ?: -1) == 2, sumList doubled == 6,
        listLength seeded == 5, (listGet (seeded, 0) ?: 0) == 1, (listGet (seeded, 4) ?: 0) == 5, sumList seeded == 15
    ]

(** linesIndexCase pins [BUILTIN-LIST-GET] on a bound string list: the result
    of lines is settled into the runtime layout once at the binding, so ten
    thousand indexed reads cost ten thousand reads, not ten thousand copies of
    two thousand strings. "line i" is 6, 7, 8 or 9 bytes by decade, 16890 per
    pass, and the reads make five passes. *)
lineAfter (acc, i) = match i == 0
    true => "line 0"
    false => acc + "\nline ${i}"

linesIndexCase () =
    text = range (0, 2000) |> fold "" lineAfter
    rows = lines text
    total = range (0, 10000) |> fold 0 (\(acc, i) => acc + byteLength (listGet (rows, i % 2000) ?: ""))
    checkAll "a bound string list is read by index in constant time" [
        listLength rows == 2000, (listGet (rows, 1999) ?: "?") == "line 1999", total == 84450
    ]

test "fold rebuilds a list-literal seed once before the loop" (\() => exactArithmetic (foldSeedCase))
test "a bound string list is read by index in constant time" (\() => exactArithmetic (linesIndexCase))
