// Assertion-driven migration of the persistent Map golden example.

/// Entry is a record value, so `mapGet` must hand back the whole record.
type Entry = { title: string, score: float, active: bool }

/// The int bound to `key`, or a sentinel far outside every case's value range.
fn mapInt(m, key) = mapGet(m, key) ?: (0 - 999)

/// The int at `index`, or the same sentinel.
fn listInt(xs, index) = listGet(xs, index) ?: (0 - 999)

/// The int bound to `key`, or a second sentinel so two failed lookups differ.
fn mapIntMiss(m, key) = mapGet(m, key) ?: (0 - 998)

/// The sum of every int in `xs`.
fn listSum(xs) = foldList(xs, 0, fn(acc, x) => acc + x)

/// Asserts `predicate` at every index `0..n`, one independent check each.
fn checkIndices(label, n, predicate) = {
    let _ = foldList(toList(range(0, n)), 0, fn(acc, i) => {
        check(label, true, predicate(i))
        acc
    })
}

/// Asserts `predicate` for every item, one independent check each.
fn checkEach(label, items, predicate) = {
    let _ = foldList(items, 0, fn(acc, item) => {
        check(label, true, predicate(item))
        acc
    })
}

/// True when `mapGet` answers the exact missing-key error for `key`.
fn keyMissing(m, key) = match mapGet(m, key) {
    Success => false
    Error { message } => message == "mapGet: key not found"
}

/// Asserts `m` binds every entry of `expected`.
fn checkMapIs(label, m, expected) = checkEach(label, mapKeys(expected),
    fn(key) => mapInt(m, key) == mapInt(expected, key))

/// Asserts `m` binds every entry of `expected` and lacks every key of `absent`.
fn checkMapBindings(label, m, expected, absent) = {
    checkMapIs(label, m, expected)
    checkEach(label, absent, fn(key) => !mapContains(m, key))
}

/// Asserts none of `absent` appears in the key view of `m`.
fn checkKeysLack(label, m, absent) = checkEach(label, absent,
    fn(key) => !listContains(mapKeys(m), key))

/// Asserts `m` maps the key at `i` of `keys` to the value at `i` of `values`.
fn checkPairs(label, m, keys, values) = checkIndices(label, listLength(keys),
    fn(i) => (mapGet(m, listGet(keys, i) ?: "absent") ?: (0 - 1)) == (listGet(values, i) ?: (0 - 2)))

/// Asserts `xs` answers `expected` at every index, one independent check each.
fn checkInts(label, xs, expected) = checkIndices(label, listLength(expected),
    fn(i) => listInt(xs, i) == listInt(expected, i))

/// Generation `n` of the canonical five-key chain k1..k5, rebuilt per call.
fn genChain(n) = foldList(toList(range(1, n + 1)), Map(), fn(m, i) => mapSet(m, "k${i}", i))

/// constructionAndOverwriteCase preserves empty, set, contains, overwrite, and source-isolation observations.
fn constructionAndOverwriteCase() = {
    let empty = Map()
    let m1 = mapSet(empty, "alice", 25)
    let m2 = mapSet(m1, "bob", 30)
    let m3 = mapSet(m2, "charlie", 35)
    let m4 = mapSet(m3, "alice", 99)
    let m4Missing = keyMissing(m4, "dave")

    // Every legacy empty, growth, contains, and overwrite-length observation remains independent.
    checkAll("legacy map construction observations", [
            mapLength(empty) == 0,
            !mapContains(empty, "missing"),
            mapLength(m1) == 1,
            mapLength(m2) == 2,
            mapLength(m3) == 3,
            mapContains(m3, "alice"),
            mapContains(m3, "bob"),
            mapContains(m3, "charlie"),
            !mapContains(m3, "dave"),
            mapLength(m4) == 3,
            mapLength(m3) == 3
    ])

    // Added value checks ensure correct bindings and persistence rather than length-only success.
    checkMapBindings("map construction values and isolation", m1, { "alice": 25 }, ["bob"])
    checkMapBindings("map construction values and isolation", m2, { "alice": 25, "bob": 30 }, ["charlie"])
    checkMapIs("map construction values and isolation", m3, { "alice": 25, "bob": 30, "charlie": 35 })
    checkMapIs("map construction values and isolation", m4, { "alice": 99, "bob": 30, "charlie": 35 })
    checkMapIs("map construction values and isolation", m3, { "alice": 25 })
    check("map construction values and isolation", true, m4Missing)
}

/// generationsAndBranchesCase preserves the five-generation chain and validates sibling branch isolation.
fn generationsAndBranchesCase() = {
    let xa = mapSet(genChain(3), "X", 100)
    let xb = mapSet(genChain(3), "Y", 200)

    // The six generation lengths and every legacy branch-membership result remain asserted.
    checkEach("persistent map generation and branch observations", [0, 1, 2, 3, 4, 5, 3],
        fn(n) => mapLength(genChain(n)) == n)
    checkAll("persistent map generation and branch observations", [
            mapContains(genChain(2), "k1"),
            !mapContains(genChain(2), "k4"),
            mapContains(xa, "X"),
            !mapContains(xa, "Y"),
            !mapContains(xb, "X"),
            mapContains(xb, "Y")
    ])

    // Value-level checks prove old generations retain bindings after descendant creation.
    checkMapBindings("persistent map generation values", genChain(1), { "k1": 1 }, ["k2"])
    checkMapBindings("persistent map generation values", genChain(2), { "k1": 1, "k2": 2 }, ["k3"])
    checkMapBindings("persistent map generation values", genChain(3), { "k3": 3 }, ["k4"])
    checkMapBindings("persistent map generation values", genChain(4), { "k4": 4 }, ["k5"])
    checkMapIs("persistent map generation values", genChain(5), { "k1": 1, "k5": 5 })
    checkAll("persistent map generation values", [
            !mapContains(genChain(0), "k1"),
            mapLength(genChain(2)) == 2,
            mapLength(genChain(3)) == 3
    ])

    // Branch-specific values and absences catch aliasing between siblings and their parent.
    checkAll("persistent map branch values and isolation", [
            mapInt(xa, "X") == 100,
            mapInt(xb, "Y") == 200,
            mapInt(xa, "k1") == 1,
            mapInt(xb, "k3") == 3,
            !mapContains(xa, "Y"),
            !mapContains(xb, "X"),
            !mapContains(genChain(3), "X"),
            !mapContains(genChain(3), "Y")
    ])
    checkInts("persistent map branch values and isolation",
        mapList([xa, xb], mapLength), [4, 4])
}

/// removalAndMergeCase preserves removal and merge lengths while adding exact right-biased value checks.
fn removalAndMergeCase() = {
    let removed = mapRemove(genChain(5), "k3")
    let absentRemoved = mapRemove(genChain(5), "nonexistent")
    let a = mapSet(mapSet(mapSet(Map(), "x", 1), "y", 2), "z", 3)
    let b = mapSet(mapSet(mapSet(Map(), "y", 20), "z", 30), "w", 40)
    let mergedAB = mapMerge(a, b)
    let mergedBA = mapMerge(b, a)
    let mergedPlus = a + b
    let removedMissing = keyMissing(removed, "k3")

    // All four legacy removal observations remain direct predicates.
    checkAll("persistent removal legacy observations", [
            mapLength(removed) == 4,
            !mapContains(removed, "k3"),
            mapContains(genChain(5), "k3"),
            mapLength(absentRemoved) == 5
    ])

    // Added removal checks validate retained values, exact failure, original preservation, and absent-key identity behavior.
    checkMapIs("persistent removal values and isolation", removed, { "k1": 1, "k2": 2, "k4": 4, "k5": 5 })
    checkMapIs("persistent removal values and isolation", genChain(5), { "k3": 3 })
    checkMapIs("persistent removal values and isolation", absentRemoved, { "k1": 1, "k5": 5 })
    checkAll("persistent removal values and isolation", [
            removedMissing,
            mapContains(absentRemoved, "k3"),
            !mapContains(genChain(4), "k5")
    ])

    // Every legacy merge length, operator-alias, membership, and identity observation remains asserted.
    checkInts("map merge legacy observations",
        mapList([mergedAB, mergedBA, mergedPlus], mapLength), [4, 4, 4])
    checkAll("map merge legacy observations", [
            mapContains(mergedAB, "w"),
            mapLength(mapMerge(Map(), a)) == 3,
            mapLength(mapMerge(a, a)) == 3
    ])

    // Exact lookups pin right-biased merge semantics in both directions and through the plus alias.
    checkMapIs("map merge right-biased values", mergedAB, { "x": 1, "y": 20, "z": 30, "w": 40 })
    checkMapIs("map merge right-biased values", mergedBA, { "x": 1, "y": 2, "z": 3, "w": 40 })
    checkMapIs("map merge right-biased values", mergedPlus, { "x": 1, "y": 20, "z": 30, "w": 40 })
    checkMapIs("map merge right-biased values", a, { "y": 2 })
    checkMapIs("map merge right-biased values", b, { "y": 20 })
}

/// viewsAndCrossCollectionCase preserves keys, values, and list/map coexistence observations.
fn viewsAndCrossCollectionCase() = {
    let g5 = genChain(5)
    let keys = mapKeys(g5)
    let values = mapValues(g5)
    let xs = listAppend(listAppend(listAppend(List(), 100), 200), 300)
    let xs2 = listAppend(xs, 400)
    let mm2 = mapSet(genChain(3), "d", 4)

    // The three legacy view lengths and five cross-collection lengths remain independent.
    checkInts("map views and cross-collection legacy lengths",
        mapList([keys, mapKeys(Map())], listLength), [5, 0])
    checkInts("map views and cross-collection legacy lengths",
        mapList([values, xs2, xs, mapValues(genChain(3)) + xs], listLength), [5, 4, 3, 6])
    checkInts("map views and cross-collection legacy lengths",
        mapList([mm2, genChain(3)], mapLength), [4, 3])

    // Key and value membership checks validate view content without assuming hash iteration order.
    checkEach("map key view contents", ["k1", "k2", "k3", "k4", "k5"],
        fn(key) => listContains(keys, key))
    checkEach("map value view contents", [1, 2, 3, 4, 5],
        fn(value) => listContains(values, value))

    checkAll("map key and value view contents", [
            !listContains(keys, "missing"),
            !listContains(values, 99)
    ])

    // Added cross-collection checks prove list and map descendants remain isolated from both source structures.
    checkAll("list and map cross-collection isolation", [
            listInt(xs, 0) == 100,
            listInt(xs, 2) == 300,
            listInt(xs2, 3) == 400,
            !listContains(xs, 400),
            mapInt(mm2, "d") == 4,
            !mapContains(genChain(3), "d"),
            mapInt(genChain(3), "k3") == 3,
            mapInt(g5, "k5") == 5,
            mapLength(g5) == listLength(keys),
            mapLength(g5) == listLength(values)
    ])
}

/// literalsAndDispatchCase preserves literal lookup, duplicate-key, and receiver-directed builtin behavior.
fn literalsAndDispatchCase() = {
    let empty = Map()
    let prices = { "apple": 2, "banana": 3, "cherry": 5 }
    let duplicate = { "key": 1, "key": 2 }
    let priceMissing = keyMissing(prices, "mango")

    // All three legacy literal lookup outcomes remain asserted with exact missing-key behavior.
    checkMapIs("map literal lookup behavior", prices, { "apple": 2, "banana": 3, "cherry": 5 })
    checkAll("map literal lookup behavior", [
            priceMissing,
            mapInt(duplicate, "key") == 2,
            ({ "apple": 2, "banana": 3 }["apple"] ?: ((0 - 999) )) == 2,
            ({ "key": 1, "key": 2 }["key"] ?: ((0 - 999) )) == 2,
            mapLength(prices) == 3,
            mapLength(duplicate) == 1,
            mapContains(duplicate, "key")
    ])
    // The old composite bare-length row is split into constituent map assertions.
    checkInts("receiver-directed map length dispatch",
        mapList([prices, duplicate, empty], length), [3, 1, 0])

    // The old composite bare-isEmpty row is split and extended across literal and derived maps.
    checkAll("receiver-directed map isEmpty dispatch", [
            isEmpty(empty),
            !isEmpty(prices),
            !isEmpty(duplicate),
            isEmpty(mapRemove(duplicate, "key"))
    ])
}

// Register empty, set, overwrite, and source-isolation behavior.
test("maps construct, overwrite, and retain source bindings", fn() => exactArithmetic(constructionAndOverwriteCase))

// Register generation-chain and sibling-branch persistence behavior.
test("map generations and sibling branches remain isolated", fn() => exactArithmetic(generationsAndBranchesCase))

// Register persistent removal and right-biased merge behavior.
test("map removal and merge preserve values and bias", fn() => exactArithmetic(removalAndMergeCase))

// Register key/value views beside independent persistent lists.
test("map views and list interactions preserve both collections", fn() => exactArithmetic(viewsAndCrossCollectionCase))

// Register literal lookup, duplicate keys, and receiver-directed dispatch.
test("map literals and receiver dispatch preserve lookup semantics", fn() => exactArithmetic(literalsAndDispatchCase))

/// [BUILTIN-MAP-GET] declares `mapGet(map: Map<string, V>, key: string) -> Result<V, Error>`,
/// equivalent to `map[key]`, with a missing key returning `Error`. `V` is the
/// value type, so a string-valued map yields the string, a float-valued map the
/// float, a bool-valued map the bool and a record-valued map the whole record.
/// Every case above stores `int` values, where a value and its storage word are
/// indistinguishable — the blind spot issue #211 lives in.
fn typedValueRetrievalCase() = {
    let titles = mapSet(mapSet(mapSet(Map(), "a", "alpha"), "b", "beta"), "c", "gamma")
    let scores = mapSet(mapSet(Map(), "half", 0.5), "quarter", 1.25)
    let flags = mapSet(mapSet(Map(), "on", true), "off", false)
    let blank = Entry { title: "none", score: 0.0, active: false }
    let entries = mapSet(
        mapSet(Map(), "left", Entry { title: "Left", score: 1.5, active: true }),
        "right",
        Entry { title: "Right", score: 2.5, active: false }
    )
    let leftEntry = mapGet(entries, "left") ?: blank
    let rightEntry = mapGet(entries, "right") ?: blank
    let absentEntry = mapGet(entries, "middle") ?: blank
    let absentTitle = match mapGet(titles, "zzz") {
        Success { value } => value
        Error { message } => message
    }

    // A string value comes back as its own string, through both spellings the
    // spec calls equivalent, and a missing key still takes the `Error` branch.
    checkAll("string values survive mapGet", [
        (mapGet(titles, "a") ?: "none") == "alpha",
        (mapGet(titles, "b") ?: "none") == "beta",
        (mapGet(titles, "c") ?: "none") == "gamma",
        (titles["a"] ?: "none") == "alpha",
        (titles["b"] ?: "none") == "beta",
        (titles["c"] ?: "none") == "gamma",
        (mapGet(titles, "a") ?: "none") == (titles["a"] ?: "other"),
        (mapGet(titles, "c") ?: "none") == (titles["c"] ?: "other"),
        length(mapGet(titles, "a") ?: "") == 5,
        length(mapGet(titles, "b") ?: "") == 4,
        contains(mapGet(titles, "c") ?: "none", "amm"),
        startsWith(mapGet(titles, "a") ?: "none", "alp"),
        endsWith(mapGet(titles, "b") ?: "none", "eta"),
        toUpperCase(mapGet(titles, "b") ?: "none") == "BETA",
        "${mapGet(titles, "a") ?: "none"}+${mapGet(titles, "b") ?: "none"}" == "alpha+beta",
        absentTitle == "mapGet: key not found",
        (mapGet(titles, "zzz") ?: "absent") == "absent",
        mapContains(titles, "a"),
        !mapContains(titles, "zzz"),
        mapLength(titles) == 3
    ])

    // Persistent producers keep values typed too: an overwritten, removed or
    // merged map still yields strings ([BUILTIN-MAP-SET], [BUILTIN-MAP-REMOVE],
    // [BUILTIN-MAP-MERGE]).
    checkAll("string values survive every map producer", [
        (mapGet(mapSet(titles, "a", "replaced"), "a") ?: "none") == "replaced",
        (mapGet(mapSet(titles, "a", "replaced"), "b") ?: "none") == "beta",
        (mapGet(titles, "a") ?: "none") == "alpha",
        (mapGet(mapRemove(titles, "b"), "a") ?: "none") == "alpha",
        (mapGet(mapRemove(titles, "b"), "c") ?: "none") == "gamma",
        (mapGet(mapRemove(titles, "b"), "b") ?: "gone") == "gone",
        !mapContains(mapRemove(titles, "b"), "b"),
        mapLength(mapRemove(titles, "b")) == 2,
        mapLength(titles) == 3,
        (mapGet(mapMerge(titles, mapSet(Map(), "d", "delta")), "d") ?: "none") == "delta",
        (mapGet(mapMerge(titles, mapSet(Map(), "d", "delta")), "a") ?: "none") == "alpha",
        (mapGet(mapMerge(titles, mapSet(Map(), "a", "right wins")), "a") ?: "none") == "right wins",
        mapLength(mapMerge(titles, mapSet(Map(), "d", "delta"))) == 4,
        listContains(mapKeys(titles), "a"),
        listContains(mapKeys(titles), "c"),
        listLength(mapKeys(titles)) == 3
    ])

    // A float value keeps its IEEE value; a bool value keeps true/false.
    checkAll("float and bool values survive mapGet", [
        (mapGet(scores, "half") ?: 0.0) == 0.5,
        (mapGet(scores, "quarter") ?: 0.0) == 1.25,
        (scores["half"] ?: 0.0) == 0.5,
        (mapGet(scores, "half") ?: 0.0) + (mapGet(scores, "quarter") ?: 0.0) == 1.75,
        (mapGet(scores, "quarter") ?: 0.0) * 4.0 == 5.0,
        (mapGet(scores, "missing") ?: 9.5) == 9.5,
        (mapGet(mapSet(scores, "half", 3.5), "half") ?: 0.0) == 3.5,
        (mapGet(scores, "half") ?: 0.0) == 0.5,
        mapLength(scores) == 2,
        (mapGet(flags, "on") ?: false),
        !(mapGet(flags, "off") ?: true),
        (flags["on"] ?: false),
        !(flags["off"] ?: true),
        (mapGet(flags, "on") ?: false) != (mapGet(flags, "off") ?: true),
        !(mapGet(flags, "unknown") ?: false),
        (mapGet(mapSet(flags, "on", false), "on") ?: true) == false,
        (mapGet(flags, "on") ?: false),
        mapContains(flags, "off"),
        !mapContains(flags, "unknown"),
        mapLength(flags) == 2
    ])

    // A record value comes back whole: every field of the stored record is
    // readable off the retrieved one, and a missing key still takes `Error`.
    checkAll("record values survive mapGet whole", [
        leftEntry.title == "Left",
        leftEntry.score == 1.5,
        leftEntry.active,
        rightEntry.title == "Right",
        rightEntry.score == 2.5,
        !rightEntry.active,
        leftEntry.title != rightEntry.title,
        leftEntry.score != rightEntry.score,
        leftEntry.active != rightEntry.active,
        leftEntry.score + rightEntry.score == 4.0,
        length(leftEntry.title) == 4,
        length(rightEntry.title) == 5,
        "${leftEntry.title}/${rightEntry.title}" == "Left/Right",
        absentEntry.title == "none",
        absentEntry.score == 0.0,
        !absentEntry.active,
        (mapGet(mapSet(entries, "left", blank), "left") ?: rightEntry).title == "none",
        (mapGet(mapSet(entries, "left", blank), "right") ?: blank).title == "Right",
        (mapGet(mapRemove(entries, "left"), "right") ?: blank).score == 2.5,
        (mapGet(mapRemove(entries, "left"), "left") ?: blank).title == "none",
        mapLength(entries) == 2
    ])
}

// Register typed value retrieval across string, float, bool and record maps.
test("mapGet returns the value type for every value type", fn() => exactArithmetic(typedValueRetrievalCase))

/// [BUILTIN-MAP] states that `Map()` and map literals create *string*-keyed maps,
/// and [BUILTIN-MAP-GET]/[BUILTIN-MAP-CONTAINS] key them by that string alone. A
/// key is therefore distinguished by exact content: the empty string, a lone
/// space, leading versus trailing spaces, a case difference, punctuation, a
/// digit string with a leading zero and a forty-character key are each their own
/// binding under [BUILTIN-MAP-SET], and [BUILTIN-MAP-KEYS] must report each once.
fn keyShapeCase() = {
    let shaped = { "": 0, "a": 1, "A": 2, " ": 3, " a": 4, "a ": 5, "a b": 6, "a.b": 7, "a-b": 8, "a_b": 9, "007": 10, "7": 11 }
    let longKey = "abcdefghijklmnopqrstuvwxyz0123456789abcd"
    let longKeyPrefix = "abcdefghijklmnopqrstuvwxyz0123456789abc"
    let shapedLong = mapSet(shaped, longKey, 12)
    let gap = " "
    let shapes = ["", "a", "A", " ", " a", "a ", "a b", "a.b", "a-b", "a_b", "007", "7"]
    let emptyKeyMissing = keyMissing(mapRemove(shaped, ""), "")

    // Twelve literal keys carry values 0..11 in declaration order and the long
    // key carries 12; the long key spells 26 letters + 10 digits + "abcd" = 40.
    checkIndices("every key shape binds its own value", listLength(shapes),
        fn(i) => mapInt(shaped, listGet(shapes, i) ?: "absent") == i)

    checkAll("every key shape binds its own value", [
            mapInt(shapedLong, longKey) == 12,
            mapLength(shaped) == 12,
            mapLength(shapedLong) == 13,
            length(shapedLong) == 13,
            !isEmpty(shaped),
            length(longKey) == 40,
            length(longKeyPrefix) == 39,
            emptyKeyMissing
    ])

    // Membership follows exact content, so every near miss — a differing case, an
    // extra space, a longer or shorter spelling, a leading zero — must be absent.
    checkEach("map membership follows exact key content", shapes,
        fn(key) => mapContains(shaped, key))

    checkAll("map membership follows exact key content", [
            mapContains(shapedLong, longKey),
            !mapContains(shaped, longKey)
    ])
    checkEach("map membership follows exact key content",
        [longKeyPrefix, toUpperCase(longKey)], fn(key) => !mapContains(shapedLong, key))
    checkEach("map membership follows exact key content",
        ["b", "B", "  ", " a ", "ab", "a.b.c", "0007", "07", "a-B"],
        fn(key) => !mapContains(shaped, key))

    // Keys that differ only by case, spacing or punctuation hold different values,
    // computed keys reach the same bindings as literal ones, and overwriting the
    // empty-string key leaves the source generation at its original value.
    checkEach("case, spacing and punctuation keys stay distinct",
        [["a", "A"], [" a", "a "], ["a b", "a.b"], ["a.b", "a-b"], ["a-b", "a_b"], ["007", "7"], ["", " "]],
        fn(pair) => mapInt(shaped, listGet(pair, 0) ?: "absent") != mapIntMiss(shaped, listGet(pair, 1) ?: "absent"))

    checkAll("case, spacing and punctuation keys stay distinct", [
            mapInt(shaped, toUpperCase("a")) == 2,
            mapInt(shaped, toLowerCase("A")) == 1,
            mapInt(shaped, "a${gap}b") == 6,
            mapInt(shaped, "${gap}a") == 4,
            mapInt(shaped, "a${gap}") == 5,
            (shaped[""] ?: ((0 - 999) )) == 0,
            (shaped["a b"] ?: ((0 - 999) )) == 6,
            (shaped["007"] ?: ((0 - 999) )) == 10,
            mapInt(mapSet(shaped, "", 99), "") == 99,
            mapLength(mapSet(shaped, "", 99)) == 12,
            mapInt(shaped, "") == 0,
            mapInt(mapSet(shaped, "A", 99), "a") == 1,
            mapLength(mapSet(shaped, "b", 99)) == 13
    ])

    // The key view holds all thirteen shapes and nothing else; the value view is
    // the same length and the twelve-key parent must not have gained the long key.
    checkEach("map key and value views report each shape once", shapes,
        fn(key) => listContains(mapKeys(shapedLong), key))

    checkKeysLack("map key and value views report each shape once", shapedLong,
        [longKeyPrefix, "b", "  "])
    checkAll("map key and value views report each shape once", [
            listLength(mapKeys(shapedLong)) == 13,
            listLength(mapValues(shapedLong)) == 13,
            listLength(mapKeys(shapedLong)) == mapLength(shapedLong),
            listContains(mapKeys(shapedLong), longKey),
            !listContains(mapKeys(shaped), longKey),
            listContains(mapValues(shapedLong), 0),
            listContains(mapValues(shapedLong), 6),
            listContains(mapValues(shapedLong), 12),
            !listContains(mapValues(shapedLong), 13),
            !listContains(mapValues(shaped), 12)
    ])
}

// Register exact-content key behavior across every key shape.
test("map keys are distinguished by exact string content", fn() => exactArithmetic(keyShapeCase))

/// [BUILTIN-MAP-SET] returns a map with `key` bound to `value`, "replacing any
/// prior binding", while the Collection Functions preamble states operations
/// "return new values without changing their inputs". A chain of overwrites on
/// one key must therefore hold the length steady while every earlier generation
/// keeps its own value, and [BUILTIN-MAP-REMOVE] must undo a set exactly —
/// leaving neighbouring keys, including keys that are prefixes of one another,
/// untouched.
fn overwriteChainCase() = {
    let v0 = Map()
    let v1 = mapSet(v0, "slot", 1)
    let v2 = mapSet(v1, "slot", 2)
    let v3 = mapSet(v2, "slot", 3)
    let v4 = mapSet(v3, "other", 40)
    let v5 = mapSet(v4, "slot", 5)
    let v6 = mapSet(v5, "other", 60)
    let v7 = mapSet(v6, "slot", 5)
    let prefixes = { "p": 1, "pa": 2, "pat": 3, "path": 4 }
    let prefixOverwritten = mapSet(prefixes, "pa", 20)
    let generations = [v0, v1, v2, v3, v4, v5, v6, v7]

    // Three overwrites of "slot" never grow the map; adding "other" grows it once
    // and re-setting "slot" to the value it already holds changes nothing.
    checkIndices("overwrite chain lengths and per-generation values", 8,
        fn(i) => mapLength(listGet(generations, i) ?: Map()) == listInt([0, 1, 1, 1, 2, 2, 2, 2], i))
    checkIndices("overwrite chain lengths and per-generation values", 7,
        fn(i) => mapInt(listGet(generations, i + 1) ?: Map(), "slot") == listInt([1, 2, 3, 3, 5, 5, 5], i))
    checkIndices("overwrite chain lengths and per-generation values", 4,
        fn(i) => mapInt(listGet(generations, i + 4) ?: Map(), "other") == listInt([40, 40, 60, 60], i))
    checkAll("overwrite chain lengths and per-generation values", [
            !mapContains(v0, "slot"),
            !mapContains(v3, "other"),
            isEmpty(v0),
            !isEmpty(v1)
    ])

    // Length arithmetic separates a fresh key (+1) from an overwrite (+0), and a
    // key differing only in case counts as fresh.
    checkAll("set length arithmetic separates fresh keys from overwrites", [
            mapLength(mapSet(v6, "fresh", 7)) == (mapLength(v6) + 1 ),
            mapLength(mapSet(v6, "slot", 7)) == mapLength(v6),
            mapLength(mapSet(v6, "other", 7)) == mapLength(v6),
            mapLength(mapSet(v0, "first", 1)) == 1,
            mapLength(mapSet(mapSet(v0, "k", 1), "k", 2)) == 1,
            mapLength(mapSet(mapSet(v0, "k", 1), "K", 2)) == 2,
            mapInt(mapSet(mapSet(v0, "k", 1), "k", 2), "k") == 2,
            mapInt(mapSet(mapSet(v0, "k", 1), "K", 2), "k") == 1,
            mapInt(mapSet(mapSet(v0, "k", 1), "K", 2), "K") == 2,
            mapLength(v6) == 2,
            mapContains(mapSet(v6, "fresh", 7), "fresh"),
            !mapContains(v6, "fresh"),
            mapInt(mapSet(v6, "slot", 7), "slot") == 7,
            mapInt(mapSet(v6, "slot", 7), "other") == 60,
            mapInt(v6, "slot") == 5
    ])

    // set-then-remove is the identity on the key it touched, remove is idempotent
    // because "a missing key leaves the map unchanged", and draining both keys
    // must land on an empty map rather than a stale one.
    checkAll("set and remove round-trip without disturbing neighbours", [
            mapLength(mapRemove(mapSet(v6, "fresh", 7), "fresh")) == 2,
            !mapContains(mapRemove(mapSet(v6, "fresh", 7), "fresh"), "fresh"),
            mapInt(mapRemove(mapSet(v6, "fresh", 7), "fresh"), "slot") == 5,
            mapInt(mapRemove(mapSet(v6, "fresh", 7), "fresh"), "other") == 60,
            mapLength(mapRemove(v6, "slot")) == 1,
            mapLength(mapRemove(mapRemove(v6, "slot"), "slot")) == 1,
            mapLength(mapRemove(mapRemove(v6, "slot"), "other")) == 0,
            isEmpty(mapRemove(mapRemove(v6, "slot"), "other")),
            mapLength(mapRemove(v6, "absent")) == 2,
            mapLength(mapRemove(v0, "absent")) == 0,
            mapInt(mapSet(mapRemove(v6, "slot"), "slot", 5), "slot") == 5,
            mapInt(mapSet(mapRemove(v6, "slot"), "slot", 5), "other") == 60,
            mapLength(mapSet(mapRemove(v6, "slot"), "slot", 5)) == 2,
            mapInt(mapRemove(v6, "slot"), "other") == 60,
            mapLength(v6) == 2,
            mapContains(v6, "slot")
    ])

    // "p", "pa", "pat" and "path" are nested prefixes; overwriting "pa" alone must
    // move only its value, and the source generation keeps the old 2.
    checkMapIs("overwriting one prefix key leaves its neighbours alone", prefixes, { "p": 1, "pa": 2, "pat": 3, "path": 4 })
    checkMapIs("overwriting one prefix key leaves its neighbours alone", prefixOverwritten, { "p": 1, "pa": 20, "pat": 3, "path": 4 })
    checkMapIs("overwriting one prefix key leaves its neighbours alone", prefixes, { "pa": 2 })
    checkAll("overwriting one prefix key leaves its neighbours alone", [
            !mapContains(prefixes, "pathx"),
            !mapContains(prefixes, "Path"),
            !mapContains(prefixes, ""),
            mapContains(prefixOverwritten, "pat"),
            listLength(mapKeys(prefixOverwritten)) == 4,
            listContains(mapKeys(prefixOverwritten), "path"),
            !listContains(mapValues(prefixOverwritten), 2),
            listContains(mapValues(prefixOverwritten), 20),
            listContains(mapValues(prefixes), 2)
    ])
    checkInts("overwriting one prefix key leaves its neighbours alone",
        mapList([prefixes, prefixOverwritten], mapLength), [4, 4])
}

// Register repeated-overwrite and prefix-key isolation behavior.
test("map overwrite chains keep one binding per key", fn() => exactArithmetic(overwriteChainCase))

/// [BUILTIN-MAP-MERGE] "returns the right-biased union" and states `left + right`
/// is equivalent. Right bias makes merge non-commutative but still associative,
/// with the empty map a two-sided identity and any map idempotent against itself;
/// the Collection Functions preamble guarantees both operands survive unchanged.
fn mergeAlgebraCase() = {
    let empty = Map()
    let left = { "k": 1, "K": 2, "k.k": 3, "": 4 }
    let right = { "k": 10, "k-k": 30, "": 40, " ": 50 }
    let third = { "K": 200, "k-k": 300, "q": 700 }
    let lr = mapMerge(left, right)
    let rl = mapMerge(right, left)
    let lrThenThird = mapMerge(mapMerge(left, right), third)
    let leftThenRt = mapMerge(left, mapMerge(right, third))
    let plusChain = left + right + third
    let overrideK = mapSet(empty, "k", 999)
    let unionKeys = ["k", "K", "k.k", "", "k-k", " "]
    let unionWants = [10, 2, 3, 40, 30, 50]
    let rlWants = [1, 2, 3, 4, 30, 50]
    let assocKeys = listAppend(unionKeys, "q")
    let assocWants = [10, 200, 3, 40, 300, 50, 700]

    // left ∪ right keeps six distinct keys: "k" and "" come from the right (10, 40),
    // "K" and "k.k" only exist on the left (2, 3), "k-k" and " " only on the right.
    checkIndices("right-biased union values", listLength(unionKeys),
        fn(i) => mapInt(lr, listGet(unionKeys, i) ?: "absent") == listInt(unionWants, i))
    checkIndices("right-biased union values", listLength(unionKeys),
        fn(i) => mapInt(rl, listGet(unionKeys, i) ?: "absent") == listInt(rlWants, i))

    checkAll("right-biased union values and lengths", [
            mapInt(lr, "k") != mapIntMiss(rl, "k"),
            mapInt(lr, "") != mapIntMiss(rl, ""),
            !mapContains(lr, "q"),
            !mapContains(rl, "q")
    ])
    checkInts("right-biased union values and lengths",
        mapList([left, right, third, lr, rl], mapLength), [4, 4, 3, 6, 6])

    // The empty map is a two-sided identity, merging a map with itself is the
    // identity too, and neither operand is disturbed by any of it.
    checkAll("merge identity, idempotence and operand preservation", [
            mapInt(mapMerge(empty, left), "k") == 1,
            mapInt(mapMerge(empty, left), "") == 4,
            mapInt(mapMerge(left, empty), "K") == 2,
            mapInt(mapMerge(left, empty), "k.k") == 3,
            mapLength(mapMerge(empty, empty)) == 0,
            isEmpty(mapMerge(empty, empty)),
            mapInt(mapMerge(left, left), "k") == 1,
            mapInt(mapMerge(left, left), "") == 4,
            mapInt(mapMerge(right, right), " ") == 50,
            mapInt(left, "k") == 1,
            mapInt(right, "k") == 10,
            mapInt(left, "") == 4,
            mapInt(right, "") == 40,
            !mapContains(left, "k-k"),
            !mapContains(right, "K")
    ])
    checkInts("merge identity, idempotence and operand preservation",
        mapList([mapMerge(empty, left), mapMerge(left, empty), mapMerge(left, left), mapMerge(right, right), left, right], mapLength),
        [4, 4, 4, 4, 4, 4])

    // ((left ∪ right) ∪ third) and (left ∪ (right ∪ third)) both resolve to
    // k=10, K=200, k.k=3, ""=40, k-k=300, " "=50, q=700 — seven keys either way —
    // and `left + right + third` associates to the left, so it agrees as well.
    checkIndices("merge is associative and the + alias agrees", listLength(assocKeys),
        fn(i) => mapInt(lrThenThird, listGet(assocKeys, i) ?: "absent") == listInt(assocWants, i))
    checkIndices("merge is associative and the + alias agrees", listLength(assocKeys),
        fn(i) => mapInt(leftThenRt, listGet(assocKeys, i) ?: "absent") == listInt(assocWants, i))
    checkIndices("merge is associative and the + alias agrees", listLength(assocKeys),
        fn(i) => mapInt(plusChain, listGet(assocKeys, i) ?: "absent") == listInt(assocWants, i))

    checkAll("merge is associative and the + alias agrees", [
            mapInt(lrThenThird, "K") == mapIntMiss(leftThenRt, "K"),
            mapInt(lrThenThird, "k-k") == mapIntMiss(leftThenRt, "k-k")
    ])
    checkInts("merge is associative and the + alias agrees",
        mapList([lrThenThird, leftThenRt, plusChain], mapLength), [7, 7, 7])

    // Views of a merged map hold exactly the surviving bindings — 1 and 30 lost
    // their keys to the right map — and merging a map with a subset of itself is
    // still right-biased, so the full map wins when it stands on the right.
    checkEach("merged views and single-key override interaction", ["", " ", "k-k", "K"],
        fn(key) => listContains(mapKeys(lr), key))
    checkAll("merged views and single-key override interaction", [
            listLength(mapKeys(lr)) == 6,
            listLength(mapValues(lr)) == 6,
            !listContains(mapKeys(lr), "q"),
            listContains(mapValues(lr), 10),
            listContains(mapValues(lr), 50),
            !listContains(mapValues(lr), 1),
            listLength(mapKeys(lrThenThird)) == 7,
            listContains(mapKeys(lrThenThird), "q"),
            listContains(mapValues(lrThenThird), 700),
            !listContains(mapValues(lrThenThird), 30),
            mapLength(mapMerge(lr, overrideK)) == 6,
            mapInt(mapMerge(lr, overrideK), "k") == 999,
            mapInt(mapMerge(overrideK, lr), "k") == 10,
            mapLength(mapMerge(lr, mapRemove(lr, "k"))) == 6,
            mapLength(mapMerge(mapRemove(lr, "k"), lr)) == 6,
            mapInt(mapMerge(mapRemove(lr, "k"), lr), "k") == 10
    ])
}

// Register right-biased merge algebra: identity, idempotence, associativity.
test("map merge is right-biased, associative, and identity-preserving", fn() => exactArithmetic(mergeAlgebraCase))

/// [BUILTIN-MAP-REMOVE] "returns a map without `key`" and states "a missing key
/// leaves the map unchanged". Sweeping a five-key map one key at a time must drop
/// exactly the named binding each time, removal order must not matter, removing a
/// near-miss key must be a no-op, and the source map must survive every sweep
/// intact ([BUILTIN-COLLECTION-LENGTH], [BUILTIN-COLLECTION-ISEMPTY]).
fn removalSweepCase() = {
    let base = { "a": 1, "b": 2, "c": 3, "d": 4, "e": 5 }
    let extra = { "f": 6 }
    let noA = mapRemove(base, "a")
    let noB = mapRemove(base, "b")
    let noC = mapRemove(base, "c")
    let noD = mapRemove(base, "d")
    let noE = mapRemove(base, "e")
    let abFirst = mapRemove(mapRemove(base, "a"), "b")
    let baFirst = mapRemove(mapRemove(base, "b"), "a")
    let drained = mapRemove(mapRemove(mapRemove(mapRemove(mapRemove(base, "a"), "b"), "c"), "d"), "e")
    let widened = mapMerge(base, extra)
    let drainedMissing = keyMissing(drained, "a")
    let sweeps = [noA, noB, noC, noD, noE]

    // Each of the five single removals leaves four bindings, and the four that
    // survive keep their original values.
    checkEach("each single removal drops exactly one binding", sweeps, fn(m) => mapLength(m) == 4)
    checkIndices("each single removal drops exactly one binding", 5,
        fn(i) => !mapContains(listGet(sweeps, i) ?: base, listGet(["a", "b", "c", "d", "e"], i) ?: "a"))
    checkMapIs("each single removal drops exactly one binding", noA, { "b": 2, "e": 5 })
    checkMapIs("each single removal drops exactly one binding", noB, { "a": 1, "c": 3 })
    checkMapIs("each single removal drops exactly one binding", noC, { "b": 2, "d": 4 })
    checkMapIs("each single removal drops exactly one binding", noD, { "c": 3, "e": 5 })
    checkMapIs("each single removal drops exactly one binding", noE, { "a": 1, "d": 4 })
    checkAll("each single removal drops exactly one binding", [
            mapLength(base) == 5,
            mapContains(base, "a"),
            mapContains(base, "e"),
            mapInt(base, "c") == 3
    ])

    // Removing "a" then "b" and "b" then "a" must agree on every surviving key,
    // and removing all five must land on a genuinely empty map with empty views.
    checkAll("removal is order-insensitive and drains to empty", [
            mapInt(abFirst, "c") == mapIntMiss(baFirst, "c"),
            mapInt(abFirst, "d") == mapIntMiss(baFirst, "d"),
            mapInt(abFirst, "e") == mapIntMiss(baFirst, "e"),
            mapInt(abFirst, "c") == 3,
            mapInt(baFirst, "e") == 5,
            isEmpty(drained),
            length(drained) == 0,
            drainedMissing,
            !mapContains(drained, "c"),
            mapLength(base) == 5,
            !isEmpty(base)
    ])
    checkInts("removal is order-insensitive and drains to empty",
        mapList([abFirst, baFirst, drained], mapLength), [3, 3, 0])
    checkEach("removal is order-insensitive and drains to empty", [abFirst, baFirst],
        fn(m) => !mapContains(m, "a") && !mapContains(m, "b"))
    checkEach("removal is order-insensitive and drains to empty", [mapKeys(drained)],
        fn(keys) => listLength(keys) == 0)
    checkEach("removal is order-insensitive and drains to empty", [mapValues(drained)],
        fn(values) => listLength(values) == 0)

    // A key that is absent by case, spacing, length or emptiness is still absent,
    // so each of these removals must leave all five bindings in place, and a
    // second removal of an already-removed key must be a no-op as well.
    checkEach("removing an absent key leaves the map unchanged", ["z", "", " ", "A", "ab", "a "],
        fn(key) => mapLength(mapRemove(base, key)) == 5)
    checkAll("removing an absent key leaves the map unchanged", [
            mapInt(mapRemove(base, "A"), "a") == 1,
            mapInt(mapRemove(base, ""), "a") == 1,
            mapInt(mapRemove(base, "ab"), "b") == 2,
            mapInt(mapRemove(base, "a "), "a") == 1,
            mapContains(mapRemove(base, "z"), "a"),
            mapContains(mapRemove(base, "z"), "e"),
            mapLength(mapRemove(drained, "a")) == 0,
            isEmpty(mapRemove(drained, "a")),
            mapLength(mapRemove(mapRemove(base, "a"), "a")) == 4,
            !mapContains(mapRemove(mapRemove(base, "a"), "a"), "a"),
            mapInt(mapRemove(mapRemove(base, "a"), "a"), "b") == 2,
            listLength(mapKeys(mapRemove(base, "z"))) == 5
    ])

    // Merging a removed generation back against the full map restores the missing
    // binding from whichever side holds it, and set-after-remove rebinds the key
    // without disturbing the source generation.
    checkAll("removal composes with set and merge", [
            mapLength(mapMerge(noB, base)) == 5,
            mapInt(mapMerge(noB, base), "b") == 2,
            mapLength(mapMerge(base, noB)) == 5,
            mapInt(mapMerge(base, noB), "b") == 2,
            mapLength(widened) == 6,
            mapInt(widened, "f") == 6,
            mapLength(mapRemove(widened, "f")) == 5,
            !mapContains(mapRemove(widened, "f"), "f"),
            mapLength(mapSet(noC, "c", 33)) == 5,
            mapInt(mapSet(noC, "c", 33), "c") == 33,
            mapInt(base, "c") == 3,
            mapLength(mapSet(drained, "a", 1)) == 1,
            mapInt(mapSet(drained, "a", 1), "a") == 1,
            listLength(mapKeys(noA)) == 4,
            !listContains(mapKeys(noA), "a"),
            listContains(mapKeys(noA), "b"),
            listLength(mapValues(noA)) == 4,
            !listContains(mapValues(noA), 1),
            listContains(mapValues(noA), 5)
    ])
}

// Register the removal sweep, absent-key no-op, and removal/merge composition.
test("map removal drops exactly one binding and leaves absent keys alone", fn() => exactArithmetic(removalSweepCase))

/// Bucket holds a Map and a List field, so a record can carry whole collections.
type Bucket = { name: string, items: Map<string, int>, tags: List<string> }

/// [BUILTIN-MAP] fixes the value type only as `V`, so a map value may itself be a
/// map, a list or a record, and [BUILTIN-LIST] elements may be maps. Nesting must
/// not flatten: an inner collection retrieved through [BUILTIN-MAP-GET] or
/// [BUILTIN-LIST-GET] answers its own [BUILTIN-COLLECTION-LENGTH] and its own
/// lookups, and rebuilding an inner collection must leave the original nest alone.
fn nestedCollectionCase() = {
    let inner1 = { "x": 1, "y": 2 }
    let inner2 = { "x": 10, "z": 30 }
    let inner3 = mapRemove(mapRemove(inner1, "x"), "y")
    let fallbackMap = { "fallback": 0 }
    let maps = listAppend(listAppend(listAppend(List(), inner1), inner2), inner3)
    let outer = mapSet(mapSet(mapSet(Map(), "one", inner1), "two", inner2), "three", inner3)
    let outerReplaced = mapSet(outer, "one", inner2)
    let odds = [1, 3, 5]
    let evens = [2, 4, 6, 8]
    let fallbackList = [0]
    let byParity = mapSet(mapSet(Map(), "odds", odds), "evens", evens)
    let byParityGrown = mapSet(byParity, "odds", listAppend(odds, 7))
    let tagsA = ["red", "blue"]
    let tagsB = ["green", "red", "blue"]
    let noTags = ["none"]
    let bucketA = Bucket { name: "alpha", items: inner1, tags: tagsA }
    let bucketB = Bucket { name: "beta", items: inner2, tags: tagsB }
    let blankBucket = Bucket { name: "none", items: inner3, tags: noTags }
    let buckets = mapSet(mapSet(Map(), "alpha", bucketA), "beta", bucketB)
    let firstNested = listGet(maps, 0) ?: fallbackMap
    let secondNested = listGet(maps, 1) ?: fallbackMap
    let thirdNested = listGet(maps, 2) ?: fallbackMap
    let pastEndNested = listGet(maps, 9) ?: fallbackMap
    let innerOne = mapGet(outer, "one") ?: fallbackMap
    let innerTwo = mapGet(outer, "two") ?: fallbackMap
    let innerMissing = mapGet(outer, "four") ?: fallbackMap
    let innerReplaced = mapGet(outerReplaced, "one") ?: fallbackMap
    let oddsBack = mapGet(byParity, "odds") ?: fallbackList
    let evensBack = mapGet(byParity, "evens") ?: fallbackList
    let listMissing = mapGet(byParity, "primes") ?: fallbackList
    let oddsGrown = mapGet(byParityGrown, "odds") ?: fallbackList
    let bucketItems = bucketA.items
    let bucketTags = bucketA.tags
    let alphaBack = mapGet(buckets, "alpha") ?: blankBucket
    let betaBack = mapGet(buckets, "beta") ?: blankBucket
    let bucketMissing = mapGet(buckets, "gamma") ?: blankBucket
    let betaItems = betaBack.items
    let betaTags = betaBack.tags
    let missingItems = bucketMissing.items

    // Three maps stored as list elements keep their own two, two and zero
    // bindings; an out-of-range index still takes the Error branch.
    checkMapIs("maps stored in a list keep their own contents", firstNested, { "x": 1, "y": 2 })
    checkMapIs("maps stored in a list keep their own contents", secondNested, { "x": 10, "z": 30 })
    checkAll("maps stored in a list keep their own contents", [
            listLength(maps) == 3,
            isEmpty(thirdNested),
            !mapContains(firstNested, "z"),
            !mapContains(secondNested, "y"),
            !mapContains(thirdNested, "x"),
            mapInt(firstNested, "x") != mapIntMiss(secondNested, "x"),
            mapInt(pastEndNested, "fallback") == 0,
            listLength(listAppend(maps, inner1)) == 4,
            listLength(maps) == 3
    ])
    checkInts("maps stored in a list keep their own contents",
        mapList([firstNested, secondNested, thirdNested, pastEndNested, inner1, inner2], mapLength),
        [2, 2, 0, 1, 2, 2])

    // A map of maps answers three outer keys while each inner map keeps its own
    // bindings, and replacing one inner map must not disturb the original nest.
    checkMapIs("maps stored as map values keep their own contents", innerOne, { "x": 1, "y": 2 })
    checkMapIs("maps stored as map values keep their own contents", innerTwo, { "x": 10, "z": 30 })
    checkMapIs("maps stored as map values keep their own contents", innerOne, { "x": 1 })
    checkAll("maps stored as map values keep their own contents", [
            mapLength(outer) == 3,
            listLength(mapKeys(outer)) == 3,
            listContains(mapKeys(outer), "one"),
            listContains(mapKeys(outer), "three"),
            !listContains(mapKeys(outer), "four"),
            mapLength(innerOne) == 2,
            mapLength(innerTwo) == 2,
            !mapContains(innerOne, "z"),
            mapLength(innerMissing) == 1,
            mapInt(innerMissing, "fallback") == 0,
            mapLength(innerReplaced) == 2,
            mapInt(innerReplaced, "z") == 30,
            mapInt(innerOne, "x") == 1,
            mapLength(outer) == 3,
            mapLength(mapRemove(outer, "two")) == 2,
            !mapContains(mapRemove(outer, "two"), "two")
    ])

    // Lists stored as map values keep index order and length; growing one value
    // list produces a four-element list while the stored three-element one stands.
    checkIndices("lists stored as map values keep index order", 3,
        fn(i) => listInt(oddsBack, i) == listInt(odds, i))
    checkAll("lists stored as map values keep index order", [
            mapLength(byParity) == 2,
            listInt(evensBack, 0) == 2,
            listInt(evensBack, 3) == 8,
            listInt(oddsBack, 3) == ((0 - 999) ),
            listContains(oddsBack, 5),
            !listContains(oddsBack, 2),
            listContains(evensBack, 8),
            !listContains(evensBack, 1),
            listInt(listMissing, 0) == 0,
            listInt(oddsGrown, 3) == 7,
            listInt(listReverse(evensBack), 0) == 8
    ])
    checkInts("lists stored as map values keep index order",
        mapList([oddsBack, evensBack, listMissing, oddsGrown, odds], listLength), [3, 4, 1, 4, 3])

    // A record carries a whole Map and a whole List, and a map of records hands
    // each record back whole with its nested collections still addressable.
    checkAll("records hold collections and maps hold records", [
            bucketA.name == "alpha",
            mapLength(bucketItems) == 2,
            mapLength(bucketA.items) == 2,
            listLength(bucketTags) == 2,
            mapInt(bucketItems, "x") == 1,
            mapInt(bucketItems, "y") == 2,
            !mapContains(bucketItems, "z"),
            (listGet(bucketTags, 0) ?: "none") == "red",
            (listGet(bucketTags, 1) ?: "none") == "blue",
            listContains(bucketTags, "blue"),
            !listContains(bucketTags, "green"),
            alphaBack.name == "alpha",
            betaBack.name == "beta",
            bucketMissing.name == "none",
            mapLength(betaItems) == 2,
            mapInt(betaItems, "z") == 30,
            !mapContains(betaItems, "y"),
            listLength(betaTags) == 3,
            listContains(betaTags, "green"),
            mapLength(buckets) == 2,
            listContains(mapKeys(buckets), "alpha"),
            !listContains(mapKeys(buckets), "gamma"),
            mapLength(missingItems) == 0,
            isEmpty(missingItems)
    ])
}

// Register nesting of maps inside lists, maps and records.
test("maps nest inside lists, maps, and records without flattening", fn() => exactArithmetic(nestedCollectionCase))

/// [BUILTIN-MAP-KEYS] returns all keys "in unspecified order" and
/// [BUILTIN-MAP-VALUES] returns all values "in the same traversal order as
/// mapKeys". Order is unspecified but the *pairing* is not: for every index i,
/// `mapGet(m, keys[i])` must equal `values[i]`. Totals and view lengths are
/// order-independent too, so an overwrite must move exactly one paired value and
/// a removal must drop exactly one pair ([BUILTIN-COLLECTION-LENGTH]).
fn keyValueViewPairingCase() = {
    let m = { "a": 1, "b": 2, "c": 3, "d": 4, "e": 5, "f": 6 }
    let keys = mapKeys(m)
    let values = mapValues(m)
    let total = listSum(values)
    let bumped = mapSet(m, "c", 33)
    let bumpedKeys = mapKeys(bumped)
    let bumpedValues = mapValues(bumped)
    let bumpedTotal = listSum(bumpedValues)
    let trimmed = mapRemove(m, "e")
    let trimmedKeys = mapKeys(trimmed)
    let trimmedValues = mapValues(trimmed)
    let trimmedTotal = listSum(trimmedValues)

    // Whatever order the views come back in, index i of one must address index i
    // of the other; 1+2+3+4+5+6 = 21 is order-independent. The two sentinels
    // differ so a pair of failed lookups cannot satisfy the equality.
    checkPairs("key and value views pair index by index", m, keys, values)
    checkEach("key and value views pair index by index", keys,
        fn(key) => mapContains(m, key))

    checkAll("key and value views pair index by index", [
            listLength(keys) == mapLength(m),
            listLength(values) == mapLength(m),
            total == 21
    ])
    checkInts("key and value views pair index by index", mapList([keys], listLength), [6])
    checkInts("key and value views pair index by index", mapList([values], listLength), [6])

    // Both views hold every binding and nothing extra. Reversing both preserves
    // the pairing, because reverse maps index i to index n-1-i on either side.
    checkEach("key and value views hold every binding once", ["a", "b", "c", "d", "e", "f"],
        fn(key) => listContains(keys, key))
    checkEach("key and value views hold every binding once", [1, 2, 3, 4, 5, 6],
        fn(value) => listContains(values, value))
    checkPairs("key and value views hold every binding once", m, listReverse(keys), listReverse(values))

    checkAll("key and value views hold every binding once", [
            !listContains(keys, "g"),
            !listContains(keys, ""),
            !listContains(values, 0),
            !listContains(values, 7),
            listLength(listReverse(keys)) == 6
    ])

    // Overwriting "c" from 3 to 33 raises the total by exactly 30 (21 -> 51),
    // leaves the key count at six, and the source map still totals 21.
    checkPairs("an overwrite moves exactly one paired value", bumped, bumpedKeys, bumpedValues)

    checkAll("an overwrite moves exactly one paired value", [
            mapLength(bumped) == 6,
            bumpedTotal == 51,
            (bumpedTotal - total ) == 30,
            mapInt(bumped, "c") == 33,
            mapInt(m, "c") == 3,
            total == 21,
            listContains(bumpedValues, 33),
            !listContains(bumpedValues, 3),
            listContains(values, 3),
            !listContains(values, 33),
            listContains(bumpedKeys, "c")
    ])
    checkInts("an overwrite moves exactly one paired value", mapList([bumpedKeys], listLength), [6])
    checkInts("an overwrite moves exactly one paired value", mapList([bumpedValues], listLength), [6])

    // Removing "e" drops the total by exactly its value 5 (21 -> 16) and both
    // views by one entry, while the remaining five stay paired.
    checkPairs("a removal drops exactly one pair", trimmed, trimmedKeys, trimmedValues)

    checkAll("a removal drops exactly one pair", [
            listLength(trimmedKeys) == 5,
            listLength(trimmedValues) == 5,
            mapLength(trimmed) == 5,
            trimmedTotal == 16,
            (total - trimmedTotal ) == 5,
            !listContains(trimmedKeys, "e"),
            !listContains(trimmedValues, 5),
            listContains(trimmedKeys, "a"),
            listContains(trimmedValues, 6),
            listLength(keys) == 6,
            listContains(keys, "e"),
            listLength(mapKeys(mapRemove(trimmed, "zzz"))) == 5,
            listLength(mapValues(mapRemove(trimmed, "zzz"))) == 5
    ])
}

// Register the mapKeys/mapValues traversal-order pairing contract.
test("mapKeys and mapValues stay paired index by index", fn() => exactArithmetic(keyValueViewPairingCase))
