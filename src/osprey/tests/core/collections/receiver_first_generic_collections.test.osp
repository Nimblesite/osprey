/// Default UFCS oracle for [BUILTIN-STRING-UFCS], crossed with [TYPE-LIST],
/// [TYPE-MAP], [BUILTIN-LIST-GET], [BUILTIN-MAP-GET],
/// [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME].
/// Every `value.function(args)` below must lower to `function(value, args)`.
effect CallSupply<T> {
    groups: fn() -> Map<string, List<T>>
}

fn intGroups() = Map().mapSet("low", [1, 2]).mapSet("high", [30, 40, 50])
fn stringGroups() = Map().mapSet("short", ["a", "bb"]).mapSet("long", ["three", "seven"])

fn requestIntGroups() -> Map<string, List<int>> = perform CallSupply.groups()
fn requestStringGroups() -> Map<string, List<string>> = perform CallSupply.groups()

fn suppliedInts() = {
    handle CallSupply {
        groups => intGroups()
    }
    requestIntGroups()
}
fn suppliedStrings() = {
    handle CallSupply {
        groups => stringGroups()
    }
    requestStringGroups()
}

fn groupAt<T>(groups: Map<string, List<T>>, key: string, index: int, fallbackList: List<T>, fallback: T) =
(groups.mapGet(key) ?: fallbackList).listGet(index) ?: fallback

/// The cases' shared fallbacks, one accessor per element type.
fn intGroup(groups, key, index) = groupAt(groups, key, index, [91], 99)
fn textGroup(groups, key, index) = groupAt(groups, key, index, ["row"], "item")

/// One group probe: which key and index, and the exact int it must hold.
type IntProbe = { key: string, index: int, value: int }

/// One group probe: which key and index, and the exact text it must hold.
type TextProbe = { key: string, index: int, value: string }

/// Asserts the receiver-first size views of the map `groups` answer `expected`.
fn checkMapSized(label, groups, expected) = checkAll(label, [
    groups.mapLength() == mapLength(groups),
    groups.mapLength() == expected,
    groups.length() == expected,
    !groups.isEmpty()
])

/// Asserts the receiver-first size views of the list `xs` answer `expected`.
fn checkListSized(label, xs, expected) = checkAll(label, [
    xs.listLength() == expected,
    xs.length() == expected,
    !xs.isEmpty()
])

/// Asserts every probe reads its exact int out of the map `groups`.
fn checkIntGroups(label, groups, probes) = {
    let _ = forEachList(probes, fn(probe) => check(label, probe.value, intGroup(groups, probe.key, probe.index)))
}

/// Asserts every probe reads its exact text out of the map `groups`.
fn checkTextGroups(label, groups, probes) = {
    let _ = forEachList(probes, fn(probe) => check(label, probe.value, textGroup(groups, probe.key, probe.index)))
}

/// Asserts `groups` holds every key of `present` and none of `absent`.
fn checkKeys(label, groups, present, absent) = {
    let _ = forEachList(present, fn(key) => check(label, true, groups.mapContains(key)))
    let _ = forEachList(absent, fn(key) => check(label, false, groups.mapContains(key)))
}

/// Asserts `xs` holds every item of `present` and none of `absent`.
fn checkContains(label, xs, present, absent) = {
    let _ = forEachList(present, fn(item) => check(label, true, xs.listContains(item)))
    let _ = forEachList(absent, fn(item) => check(label, false, xs.listContains(item)))
}

/// The length of the nested list at `index` of `xs`, or none when it is absent.
fn nestedLength(xs, index) = (listGet(xs, index) ?: [99]).listLength()

/// One UFCS chain crosses generic effect erasure, Map<string,List<T>> lookup,
/// Result recovery, persistent operations, view conversion, reversal, and leaf
/// extraction. Implements [BUILTIN-STRING-UFCS], [EFFECTS-GENERIC-RUNTIME],
/// [BUILTIN-MAP-VALUES], and [BUILTIN-LIST-GET].
fn receiverFirstCollectionCase() = {
    let ints = suppliedInts()
    let strings = suppliedStrings()
    let high = ints.mapGet("high") ?: [99]
    let long = strings.mapGet("long") ?: ["missing"]
    let grownInts = ints.mapSet("extra", [6, 7]).mapRemove("low")
    let grownStrings = strings.mapSet("long", ["eight", "nine"])
    let intValues = ints.mapValues().listReverse()
    let stringKeys = strings.mapKeys().listReverse()

    checkMapSized("original int map size", ints, 2)
    checkMapSized("original string map size", strings, 2)
    checkMapSized("grown int map size", grownInts, 2)
    checkMapSized("grown string map size", grownStrings, 2)
    checkListSized("high group size", high, 3)
    checkListSized("long group size", long, 2)
    checkListSized("reversed values size", intValues, 2)
    checkListSized("reversed keys size", stringKeys, 2)
    checkIntGroups("original int group probes", ints, [
        IntProbe { key: "low", index: 0, value: 1 },
        IntProbe { key: "low", index: 1, value: 2 }
    ])
    checkIntGroups("grown int group probes", grownInts, [
        IntProbe { key: "high", index: 2, value: 50 },
        IntProbe { key: "extra", index: 0, value: 6 },
        IntProbe { key: "extra", index: 1, value: 7 }
    ])
    checkTextGroups("original string group probes", strings, [
        TextProbe { key: "short", index: 0, value: "a" },
        TextProbe { key: "short", index: 1, value: "bb" },
        TextProbe { key: "long", index: 0, value: "three" }
    ])
    checkTextGroups("grown string group probes", grownStrings, [
        TextProbe { key: "long", index: 0, value: "eight" },
        TextProbe { key: "long", index: 1, value: "nine" }
    ])
    checkKeys("grown int keys", grownInts, ["high", "extra"], ["low"])
    checkKeys("original int keys", ints, ["low"], ["extra"])
    checkContains("reversed key membership", stringKeys, ["short", "long"], ["missing"])

    checkAll("receiver-first entries and nested leaves", [
            (high.listGet(0) ?: 99) == 30,
            (high.listGet(1) ?: 99) == 40,
            (high.listGet(2) ?: 99) == 50,
            (long.listGet(0) ?: "missing") == "three",
            (long.listGet(1) ?: "missing") == "seven",
            length(long.listGet(0) ?: "missing") == 5,
            nestedLength(intValues, 0) >= 2,
            nestedLength(intValues, 1) >= 2,
            ((Map().mapSet("one", [1]).mapGet("one") ?: [99]).listGet(0) ?: 99) == 1,
            ((List().listAppend([8, 9]).listGet(0) ?: [99]).listGet(1) ?: 99) == 9
    ])
}

test("receiver-first collection call syntax composes over nested generics", receiverFirstCollectionCase)
