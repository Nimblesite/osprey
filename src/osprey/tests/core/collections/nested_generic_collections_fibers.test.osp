/// Native-only twin. [CONCURRENCY-SPAWN-AWAIT] and [CONCURRENCY-CHANNEL]
/// sequester this from wasm32; [TYPE-GENERICS-FN], [TYPE-LIST], [TYPE-MAP],
/// [BUILTIN-LIST-GET], [BUILTIN-MAP-GET], [EFFECTS-GENERIC-INSTANTIATION],
/// and [EFFECTS-GENERIC-RUNTIME] define the collection values crossing it.
effect FiberDepot<T> {
    fetch: fn(string) -> T
}

fn nestedAt<T>(matrix, row, column, fallbackRow, fallback: T) =
listGet(listGet(matrix, row) ?: fallbackRow, column) ?: fallback

fn groupAt<T>(groups, key, index, fallbackList, fallback: T) =
listGet(mapGet(groups, key) ?: fallbackList, index) ?: fallback

fn intMatrix() = [[1, 2], [3, 4, 5]]
fn stringMatrix() = [["ant", "bee"], ["cat", "dog", "eel"]]
fn floatGroups() = mapSet(mapSet(Map(), "small", [0.5, 1.25]), "large", [8.5, 9.75])
fn boolGroups() = mapSet(mapSet(Map(), "left", [true, false]), "right", [false, true])

/// One probe into a nested int matrix; a lost row or cell must answer the
/// out-of-range fallback, far from any `expected`.
fn intCell(matrix, row, column, expected) = nestedAt(matrix, row, column, [99], 99) == expected

/// One probe into a nested string matrix, with the same fallback discipline.
fn textCell(matrix, row, column, expected) = nestedAt(matrix, row, column, ["row"], "item") == expected

/// One probe into a float group map, fallbacks off the expected values.
fn floatCell(groups, key, index, expected) = groupAt(groups, key, index, [9.0], 9.5) == expected

/// The fallback is the drawn cell's negation, so a lost key cannot answer `expected`.
fn boolCell(groups, key, index, expected) = groupAt(groups, key, index, [!expected], !expected) == expected

/// The whole bool group contract in one line, instead of four copies of it.
fn boolCells(groups) = boolCell(groups, "left", 0, true) && boolCell(groups, "left", 1, false) && boolCell(groups, "right", 0, false) && boolCell(groups, "right", 1, true)

/// The cells each matrix crossing must answer, folded so a crossing names one
/// predicate per matrix instead of a copy of the probes.
fn edgeCells(matrix) = intCell(matrix, 0, 0, 1) && intCell(matrix, 1, 2, 5)
fn keptCells(matrix) = edgeCells(matrix) && intCell(matrix, 0, 1, 2)
fn importedCells(matrix) = keptCells(matrix) && intCell(matrix, 1, 0, 3)
fn tailCells(matrix) = edgeCells(matrix) && intCell(matrix, 2, 0, 6) && intCell(matrix, 2, 1, 7)
fn fieldCells(matrix) = keptCells(matrix) && intCell(matrix, 2, 1, 7)
fn rebuiltCells(matrix) = intCell(matrix, 0, 0, 6) && intCell(matrix, 0, 1, 7) && intCell(matrix, 2, 0, 1)

/// The original head plus the appended tail a grown matrix must answer.
fn grownCells(matrix) = intCell(matrix, 0, 0, 1) && intCell(matrix, 2, 0, 6) && intCell(matrix, 2, 1, 7)

/// One drawn `small` cell, shared by every map that must still answer it.
fn smallCell(groups) = floatCell(groups, "small", 0, 0.5)

/// The `small` and `large` cells a group map must answer after crossing.
fn smallLargeCells(groups) = smallCell(groups) && floatCell(groups, "large", 1, 9.75)

/// The `small` and appended `extra` cells one map answers after crossing.
fn smallExtraCells(groups) = smallCell(groups) && extraCells(groups)

/// A drawn row's width, falling back off the expected value.
fn rowLengthIs(matrix, row, want) = listLength(listGet(matrix, row) ?: [99]) == want

/// A matrix crossing answers its drawn row count and its cells through ONE
/// gate, so a case names a shape instead of copying a length line per value.
fn matrixIs(matrix, rows, cells) = listLength(matrix) == rows && cells(matrix)

/// The group-map twin of `matrixIs`: drawn key count plus the cells behind it.
fn groupIs(groups, keys, cells) = mapLength(groups) == keys && cells(groups)

/// What a rebuilt bool map must hold: the appended keys kept, the removed one
/// gone, and never a spare key.
fn grownBoolMap(groups) = mapLength(groups) == 2 && mapContains(groups, "right") && mapContains(groups, "extra") && !mapContains(groups, "left")

/// The spawned bool map still holds the drawn key and never gained the appended one.
fn spawnedBoolMap(groups) = mapContains(groups, "left") && !mapContains(groups, "extra")

/// Every spawned fiber is still readable exactly once, long after its await.
fn allFibersDone(matrix, texts, floats, bools) = fiberDone(matrix) == 1 && fiberDone(texts) == 1 && fiberDone(floats) == 1 && fiberDone(bools) == 1

/// Every drawn cell of a string matrix and of a float group map.
fn textCells(matrix) = textCell(matrix, 0, 0, "ant") && textCell(matrix, 0, 1, "bee") && textCell(matrix, 1, 0, "cat") && textCell(matrix, 1, 2, "eel")
fn floatCells(groups) = smallCell(groups) && floatCell(groups, "small", 1, 1.25) && floatCell(groups, "large", 1, 9.75)

/// The appended `extra` group's cells, in one line instead of a copy per map.
fn extraCells(groups) = floatCell(groups, "extra", 0, 6.25) && floatCell(groups, "extra", 1, 7.5)

/// A channel reached through a PARAMETER is the seam no send-site knowledge
/// can cover: the callee sees only the declared `Channel<T>`, so the element
/// representation has to come from inference, and what crossed the wire has to
/// be a real collection rather than a literal's flat `{length, data}` header.
/// Reading that header as a list ran off the end of a 16-byte block.
/// Implements [CONCURRENCY-CHANNEL].
/// A channel held in a record FIELD is the third route: the slot is a machine
/// word with no owner of its own, so the element ABI has to come from the
/// declared field type or the received value is read as an untyped word.
type MatrixHub = MatrixHub { channel: Channel<List<List<int>>> }

fn drainMatrix(channel: Channel<List<List<int>>>) = recv(channel)
fn drainGroups(channel: Channel<Map<string, List<float>>>) = recv(channel)

fn requestIntMatrix() -> List<List<int>> = perform FiberDepot.fetch("ints")
fn requestBoolGroups() -> Map<string, List<bool>> = perform FiberDepot.fetch("bools")
/// One inherited-handler fiber round trip: `supply` answers the fetch and
/// the spawned `request` performs it, so the awaited result keeps its type.
/// Implements [EFFECTS-GENERIC-INSTANTIATION] and [EFFECTS-GENERIC-RUNTIME].
fn fiberEffect(supply, request) = {
    handle FiberDepot {
        fetch _key => supply()
    }
    await(spawn request())
}

/// Crosses nested construction, fiber-result erasure, out-of-order await,
/// channel erasure, Result extraction, and persistence. Implements
/// [CONCURRENCY-SPAWN-AWAIT], [CONCURRENCY-CHANNEL], [BUILTIN-LIST-GET],
/// [BUILTIN-MAP-GET], and [TYPE-GENERICS-FN].
fn fiberChannelCollectionCase() = {
    let intFiber = spawn intMatrix()
    let stringFiber = spawn stringMatrix()
    let floatFiber = spawn floatGroups()
    let boolFiber = spawn boolGroups()
    let strings = await(stringFiber)
    let ints = await(intFiber)
    let bools = await(boolFiber)
    let floats = await(floatFiber)
    let matrixChannel = Channel(2)
    let groupChannel = Channel(2)
    send(matrixChannel, ints)
    send(matrixChannel, listAppend(ints, [6, 7]))
    send(groupChannel, floats)
    send(groupChannel, mapSet(floats, "extra", [6.25, 7.5]))
    let firstMatrix = recv(matrixChannel)
    let secondMatrix = recv(matrixChannel)
    let firstGroups = recv(groupChannel)
    let secondGroups = recv(groupChannel)
    send(matrixChannel, secondMatrix)
    send(groupChannel, secondGroups)
    let matrixViaParameter = drainMatrix(matrixChannel)
    let groupsViaParameter = drainGroups(groupChannel)
    let hub = MatrixHub { channel: Channel(1) }
    send(hub.channel, matrixViaParameter)
    let matrixViaField = recv(hub.channel)
    /// ABANDONED on purpose: a managed value that is sent and never received
    /// still holds the reference `send` transferred to the channel, and nothing
    /// can hand it back — the runtime's completed-result cleanup walks fibers,
    /// not channels. Program teardown has to release it, and the ARC corpus
    /// harness fails this file if a single object survives exit.
    let abandonedMatrices = Channel(2)
    let abandonedGroups = Channel(2)
    send(abandonedMatrices, listAppend(matrixViaField, [8, 9]))
    send(abandonedGroups, mapSet(floats, "orphan", [1.5]))

    checkAll("spawn and out-of-order await reconstruct nested collection owners", [
            matrixIs(ints, 2, importedCells),
            matrixIs(strings, 2, textCells),
            groupIs(floats, 2, floatCells),
            groupIs(bools, 2, boolCells),
            allFibersDone(intFiber, stringFiber, floatFiber, boolFiber)
    ])

    checkAll("Channel<collection> round trips full nested descriptors in FIFO order", [
            matrixIs(firstMatrix, 2, edgeCells),
            matrixIs(secondMatrix, 3, grownCells),
            groupIs(firstGroups, 2, smallLargeCells),
            groupIs(secondGroups, 3, extraCells),
            floatCell(secondGroups, "small", 1, 1.25),
            matrixIs(ints, 2, |m| => intCell(m, 1, 2, 5)),
            groupIs(floats, 2, smallCell),
            matrixIs(matrixViaParameter, 3, tailCells),
            groupIs(groupsViaParameter, 3, smallExtraCells),
            matrixIs(matrixViaField, 3, fieldCells)
    ])
}

/// Performs a generic effect inside a fiber, inherits its handler, returns a
/// nested collection, and feeds it through persistent producers. Implements
/// [EFFECTS-GENERIC-RUNTIME], [CONCURRENCY-SPAWN-AWAIT],
/// [BUILTIN-LIST-APPEND], and [BUILTIN-MAP-SET].
fn fiberEffectCollectionCase() = {
    let ints = fiberEffect(intMatrix, requestIntMatrix)
    let bools = fiberEffect(boolGroups, requestBoolGroups)
    let grownInts = listReverse(listAppend(ints, [6, 7]))
    let grownBools = mapRemove(mapSet(bools, "extra", [true, false]), "left")

    checkAll("inherited generic handlers preserve collection results from fibers", [
            matrixIs(ints, 2, keptCells),
            groupIs(bools, 2, boolCells),
            matrixIs(grownInts, 3, rebuiltCells),
            grownBoolMap(grownBools),
            boolCell(grownBools, "extra", 0, true),
            boolCell(grownBools, "extra", 1, false),
            listLength(ints) == 2,
            spawnedBoolMap(bools)
    ])
}

/// The channel case was parked with a Skip verdict while
/// `Channel<collection>` lost its element type in transit: the wire word is a
/// uniform `i64`, `recv` never unboxed it back, and a `List<List<int>>` came
/// back readable only as `List<int>` — every nested access answered its
/// fallback. `send` now records the element on the channel binding and `recv`
/// unboxes to it, and the let-bound handle no longer generalizes, so the two
/// ends can no longer disagree. Both cases run for real.
type Verdict = Pass | Fail(string) | Skip(string)

/// A channel reached through a CLOSURE — passed as a function-value parameter,
/// or captured — is the route no declaration covers: a lambda's lowered
/// signature is all the callee has, and it carried no return owner, so `recv`'s
/// nested descriptor was lost and `listGet` on the result met an `i64` payload
/// against an `i8*` default. The program was rejected with `match arms disagree
/// on type`, naming no user construct. Implements [CONCURRENCY-CHANNEL],
/// [BUILTIN-LIST-GET], [TYPE-GENERICS-FN].
fn drainVia(f, channel) = f(channel)

fn channelThroughClosureCase() = {
    let matrices = Channel(4)
    send(matrices, intMatrix())
    send(matrices, listAppend(intMatrix(), [6, 7]))
    let viaLambdaParameter = drainVia(|c| => recv(c), matrices)
    let takeNext = || => recv(matrices)
    let viaCapture = takeNext()
    let groups = Channel(2)
    send(groups, floatGroups())
    let groupsViaLambdaParameter = drainVia(|c| => recv(c), groups)

    checkAll("a channel reached through a closure keeps its element descriptor", [
            matrixIs(viaLambdaParameter, 2, keptCells),
            rowLengthIs(viaLambdaParameter, 1, 3),
            matrixIs(viaCapture, 3, grownCells),
            rowLengthIs(viaCapture, 2, 2),
            groupIs(groupsViaLambdaParameter, 2, smallLargeCells)
    ])
}

testCases([
    { name: "fibers channels Results and persistence retain generic collection types", work: fiberChannelCollectionCase },
    { name: "generic effects inside fibers retain nested collection types", work: fiberEffectCollectionCase },
    { name: "a channel reached through a closure keeps its element descriptor", work: channelThroughClosureCase }
])
