/// Native-only twin. [CONCURRENCY-SPAWN-AWAIT] and [CONCURRENCY-CHANNEL]
/// sequester this from wasm32; [TYPE-GENERICS-FN], [TYPE-LIST], [TYPE-MAP],
/// [BUILTIN-LIST-GET], [BUILTIN-MAP-GET], [EFFECTS-GENERIC-INSTANTIATION],
/// and [EFFECTS-GENERIC-RUNTIME] define the collection values crossing it.
effect FiberDepot<T> {
    fetch: fn(string) -> T
}

fn nestedAt<T>(matrix: List<List<T>>, row: int, column: int, fallbackRow: List<T>, fallback: T) =
listGet(listGet(matrix, row) ?: fallbackRow, column) ?: fallback

fn groupAt<T>(groups: Map<string, List<T>>, key: string, index: int, fallbackList: List<T>, fallback: T) =
listGet(mapGet(groups, key) ?: fallbackList, index) ?: fallback

/// The cases' shared fallbacks, one accessor per element type.
fn intAt(matrix, row, column) = nestedAt(matrix, row, column, [99], 99)
fn floatAt(groups, key, index) = groupAt(groups, key, index, [9.0], 9.5)
fn boolAt(groups, key, index) = groupAt(groups, key, index, [false], false)
fn boolMissAt(groups, key, index) = groupAt(groups, key, index, [true], true)

/// Asserts every cell of `matrix` equals the same cell of `expected`, one
/// independent check each, so a whole nested matrix is stated once.
fn checkMatrix(label, matrix, expected, fallbackRow, fallback) = {
    let _ = foldList(toList(range(0, listLength(expected))), 0, fn(acc, row) => {
        let expectedRow = listGet(expected, row) ?: fallbackRow
        let _ = foldList(toList(range(0, listLength(expectedRow))), 0, fn(cellAcc, column) => {
            check(label, listGet(expectedRow, column) ?: fallback, nestedAt(matrix, row, column, fallbackRow, fallback))
            cellAcc
        })
        acc
    })
}

fn intMatrix() = [[1, 2], [3, 4, 5]]
fn stringMatrix() = [["ant", "bee"], ["cat", "dog", "eel"]]
fn floatGroups() = mapSet(mapSet(Map(), "small", [0.5, 1.25]), "large", [8.5, 9.75])
fn boolGroups() = mapSet(mapSet(Map(), "left", [true, false]), "right", [false, true])

/// A channel reached through a PARAMETER is the seam no send-site knowledge
/// can cover: the callee sees only the declared `Channel<T>`, so the element
/// representation has to come from inference, and what crossed the wire has to
/// be a real collection rather than a literal's flat `{length, data}` header.
/// Reading that header as a list ran off the end of a 16-byte block.
/// Implements [CONCURRENCY-CHANNEL].
/// A channel held in a record FIELD is the third route: the slot is a machine
/// word with no owner of its own, so the element ABI has to come from the
/// declared field type or the received value is read as an untyped word.
type MatrixHub = MatrixHub { channel: Channel<List<List<int>>> }

fn drainMatrix(channel: Channel<List<List<int>>>) = recv(channel)
fn drainGroups(channel: Channel<Map<string, List<float>>>) = recv(channel)

fn requestIntMatrix() -> List<List<int>> = perform FiberDepot.fetch("ints")
fn requestBoolGroups() -> Map<string, List<bool>> = perform FiberDepot.fetch("bools")
fn fiberEffectIntMatrix() = {
    handle FiberDepot {
        fetch _key => intMatrix()
    }
    await(spawn requestIntMatrix())
}
fn fiberEffectBoolGroups() = {
    handle FiberDepot {
        fetch _key => boolGroups()
    }
    await(spawn requestBoolGroups())
}

/// Crosses nested construction, fiber-result erasure, out-of-order await,
/// channel erasure, Result extraction, and persistence. Implements
/// [CONCURRENCY-SPAWN-AWAIT], [CONCURRENCY-CHANNEL], [BUILTIN-LIST-GET],
/// [BUILTIN-MAP-GET], and [TYPE-GENERICS-FN].
fn fiberChannelCollectionCase() = {
    let intFiber = spawn intMatrix()
    let stringFiber = spawn stringMatrix()
    let floatFiber = spawn floatGroups()
    let boolFiber = spawn boolGroups()
    let strings = await(stringFiber)
    let ints = await(intFiber)
    let bools = await(boolFiber)
    let floats = await(floatFiber)
    let matrixChannel = Channel(2)
    let groupChannel = Channel(2)
    send(matrixChannel, ints)
    send(matrixChannel, listAppend(ints, [6, 7]))
    send(groupChannel, floats)
    send(groupChannel, mapSet(floats, "extra", [6.25, 7.5]))
    let firstMatrix = recv(matrixChannel)
    let secondMatrix = recv(matrixChannel)
    let firstGroups = recv(groupChannel)
    let secondGroups = recv(groupChannel)
    send(matrixChannel, secondMatrix)
    send(groupChannel, secondGroups)
    let matrixViaParameter = drainMatrix(matrixChannel)
    let groupsViaParameter = drainGroups(groupChannel)
    let hub = MatrixHub { channel: Channel(1) }
    send(hub.channel, matrixViaParameter)
    let matrixViaField = recv(hub.channel)
    /// ABANDONED on purpose: a managed value that is sent and never received
    /// still holds the reference `send` transferred to the channel, and nothing
    /// can hand it back — the runtime's completed-result cleanup walks fibers,
    /// not channels. Program teardown has to release it, and the ARC corpus
    /// harness fails this file if a single object survives exit.
    let abandonedMatrices = Channel(2)
    let abandonedGroups = Channel(2)
    send(abandonedMatrices, listAppend(matrixViaField, [8, 9]))
    send(abandonedGroups, mapSet(floats, "orphan", [1.5]))

    checkMatrix("spawn and out-of-order await reconstruct nested collection owners", ints, [[1, 2], [3, 4, 5]], [99], 99)
    checkMatrix("spawn and out-of-order await reconstruct nested collection owners", strings, [["ant", "bee"], ["cat", "dog", "eel"]], ["row"], "item")

    checkAll("spawn and out-of-order await reconstruct nested collection owners", [
            floatAt(floats, "small", 0) == 0.5,
            floatAt(floats, "small", 1) == 1.25,
            floatAt(floats, "large", 1) == 9.75,
            boolAt(bools, "left", 0),
            !boolMissAt(bools, "left", 1),
            !boolMissAt(bools, "right", 0),
            boolAt(bools, "right", 1),
            listLength(ints) == 2,
            listLength(strings) == 2,
            mapLength(floats) == 2,
            mapLength(bools) == 2,
            fiberDone(intFiber) == 1,
            fiberDone(stringFiber) == 1,
            fiberDone(floatFiber) == 1,
            fiberDone(boolFiber) == 1
    ])

    checkMatrix("Channel<collection> round trips full nested descriptors in FIFO order", firstMatrix, [[1, 2], [3, 4, 5]], [99], 99)
    checkMatrix("Channel<collection> round trips full nested descriptors in FIFO order", secondMatrix, [[1, 2], [3, 4, 5], [6, 7]], [99], 99)
    checkMatrix("Channel<collection> round trips full nested descriptors in FIFO order", matrixViaParameter, [[1, 2], [3, 4, 5], [6, 7]], [99], 99)
    checkMatrix("Channel<collection> round trips full nested descriptors in FIFO order", matrixViaField, [[1, 2], [3, 4, 5], [6, 7]], [99], 99)

    checkAll("Channel<collection> round trips full nested descriptors in FIFO order", [
            listLength(firstMatrix) == 2,
            listLength(secondMatrix) == 3,
            mapLength(firstGroups) == 2,
            mapLength(secondGroups) == 3,
            floatAt(firstGroups, "small", 0) == 0.5,
            floatAt(firstGroups, "large", 1) == 9.75,
            floatAt(secondGroups, "small", 1) == 1.25,
            floatAt(secondGroups, "extra", 0) == 6.25,
            floatAt(secondGroups, "extra", 1) == 7.5,
            intAt(ints, 1, 2) == 5,
            floatAt(floats, "small", 0) == 0.5,
            listLength(ints) == 2,
            mapLength(floats) == 2,
            listLength(matrixViaParameter) == 3,
            mapLength(groupsViaParameter) == 3,
            floatAt(groupsViaParameter, "small", 0) == 0.5,
            floatAt(groupsViaParameter, "extra", 0) == 6.25,
            floatAt(groupsViaParameter, "extra", 1) == 7.5,
            listLength(matrixViaField) == 3,
            intAt(matrixViaField, 0, 1) == 2
    ])
}

/// Performs a generic effect inside a fiber, inherits its handler, returns a
/// nested collection, and feeds it through persistent producers. Implements
/// [EFFECTS-GENERIC-RUNTIME], [CONCURRENCY-SPAWN-AWAIT],
/// [BUILTIN-LIST-APPEND], and [BUILTIN-MAP-SET].
fn fiberEffectCollectionCase() = {
    let ints = fiberEffectIntMatrix()
    let bools = fiberEffectBoolGroups()
    let grownInts = listReverse(listAppend(ints, [6, 7]))
    let grownBools = mapRemove(mapSet(bools, "extra", [true, false]), "left")

    checkMatrix("inherited generic handlers preserve collection results from fibers", grownInts, [[6, 7], [3, 4, 5], [1, 2]], [99], 99)

    checkAll("inherited generic handlers preserve collection results from fibers", [
            listLength(ints) == 2,
            mapLength(bools) == 2,
            intAt(ints, 0, 0) == 1,
            intAt(ints, 0, 1) == 2,
            intAt(ints, 1, 2) == 5,
            boolAt(bools, "left", 0),
            !boolMissAt(bools, "left", 1),
            !boolMissAt(bools, "right", 0),
            boolAt(bools, "right", 1),
            listLength(grownInts) == 3,
            mapLength(grownBools) == 2,
            !mapContains(grownBools, "left"),
            mapContains(grownBools, "right"),
            mapContains(grownBools, "extra"),
            boolAt(grownBools, "extra", 0),
            !boolMissAt(grownBools, "extra", 1),
            listLength(ints) == 2,
            mapContains(bools, "left"),
            !mapContains(bools, "extra")
    ])
}

/// The channel case was parked with a Skip verdict while
/// `Channel<collection>` lost its element type in transit: the wire word is a
/// uniform `i64`, `recv` never unboxed it back, and a `List<List<int>>` came
/// back readable only as `List<int>` — every nested access answered its
/// fallback. `send` now records the element on the channel binding and `recv`
/// unboxes to it, and the let-bound handle no longer generalizes, so the two
/// ends can no longer disagree. Both cases run for real.
type Verdict = Pass | Fail(string) | Skip(string)

/// A channel reached through a CLOSURE — passed as a function-value parameter,
/// or captured — is the route no declaration covers: a lambda's lowered
/// signature is all the callee has, and it carried no return owner, so `recv`'s
/// nested descriptor was lost and `listGet` on the result met an `i64` payload
/// against an `i8*` default. The program was rejected with `match arms disagree
/// on type`, naming no user construct. Implements [CONCURRENCY-CHANNEL],
/// [BUILTIN-LIST-GET], [TYPE-GENERICS-FN].
fn drainVia(f, channel) = f(channel)

fn channelThroughClosureCase() = {
    let matrices = Channel(4)
    send(matrices, intMatrix())
    send(matrices, listAppend(intMatrix(), [6, 7]))
    let viaLambdaParameter = drainVia(|c| => recv(c), matrices)
    let takeNext = || => recv(matrices)
    let viaCapture = takeNext()
    let groups = Channel(2)
    send(groups, floatGroups())
    let groupsViaLambdaParameter = drainVia(|c| => recv(c), groups)

    checkAll("a channel reached through a closure keeps its element descriptor", [
            listLength(viaLambdaParameter) == 2,
            intAt(viaLambdaParameter, 0, 0) == 1,
            intAt(viaLambdaParameter, 0, 1) == 2,
            intAt(viaLambdaParameter, 1, 2) == 5,
            listLength(listGet(viaLambdaParameter, 1) ?: [99]) == 3,
            listLength(viaCapture) == 3,
            intAt(viaCapture, 0, 0) == 1,
            intAt(viaCapture, 2, 0) == 6,
            intAt(viaCapture, 2, 1) == 7,
            listLength(listGet(viaCapture, 2) ?: [99]) == 2,
            mapLength(groupsViaLambdaParameter) == 2,
            floatAt(groupsViaLambdaParameter, "small", 0) == 0.5,
            floatAt(groupsViaLambdaParameter, "large", 1) == 9.75
    ])
}

test("fibers channels Results and persistence retain generic collection types", fiberChannelCollectionCase)
test("generic effects inside fibers retain nested collection types", fiberEffectCollectionCase)
test("a channel reached through a closure keeps its element descriptor", channelThroughClosureCase)
