(** Cross-contract oracle for [TYPE-GENERICS-FN], [FLAVOR-ML-GENERICS],
    [TYPE-LIST], [TYPE-LIST-PATTERNS], [BUILTIN-LIST-GET],
    [BUILTIN-LIST-APPEND], [BUILTIN-LIST-PREPEND], [BUILTIN-LIST-REVERSE],
    [BUILTIN-LIST-FOREACH], [EFFECTS-GENERIC-DECL],
    [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME]. *)
effect LeafAudit T
    observe : T => Unit

nestedAt<T> : (List (List T), int, int, List T, T) -> T
nestedAt (matrix, row, column, fallbackRow, fallback) =
    listGet (listGet matrix row ?: fallbackRow) column ?: fallback

(** Asserts every cell of one `expectedRow` matches `matrix`, one check each. *)
checkRow label matrix expectedRow row fallbackRow fallback =
    forEachList (toList (range 0 (listLength expectedRow))) (\column =>
        check label (listGet expectedRow column ?: fallback) (nestedAt (matrix, row, column, fallbackRow, fallback)))

(** Asserts every cell of `matrix` equals the same cell of `expected`. *)
checkMatrix label matrix expected fallbackRow fallback =
    forEachList (toList (range 0 (listLength expected))) (\row =>
        checkRow label matrix (listGet expected row ?: fallbackRow) row fallbackRow fallback)

(** Asserts every cell of `matrix` decodes back to itself through `nestedAt`. *)
checkSelf label matrix fallbackRow fallback = checkMatrix label matrix matrix fallbackRow fallback

(** Asserts the two list lengths are `expected`. *)
checkLengths first second expected = structuralEquals [listLength first, listLength second] expected

(** Asserts `matrixShape` of `first` and `second` are `firstShape` and `secondShape`. *)
checkShapes first second firstShape secondShape =
    matrixShape first == firstShape && matrixShape second == secondShape

(** `nestedAt` over the text matrices, with the text fallbacks. *)
textAt matrix row column = nestedAt (matrix, row, column, ["row"], "item")

chooseByCollection<T, U> : (List T, U, U) -> U
chooseByCollection (items, present, empty) = match isEmpty items
    true => empty
    false => present

matrixShape<T> : List (List T) -> string
matrixShape matrix = match matrix
    [] => "empty"
    [row] => match row
        [] => "one-empty-row"
        [_only] => "one-singleton-row"
        _ => "one:${listLength row}"
    [first, second] => "two:${listLength first}/${listLength second}"
    [head, ...tail] => "many:${listLength head}+${listLength tail}"

(** Folds every leaf of `rows` through `LeafAudit.observe`, starting at `seed`. *)
auditLeaves (seed, step, rows) =
    mut encoded = seed
    handle LeafAudit
        observe value =>
            encoded := step (encoded, value)
    forEachList rows (\row => forEachList row (\value => perform LeafAudit.observe value))
    encoded

(** Encodes leaf integers in base ten, so `[[1, 2], [3]]` becomes `123`. *)
auditInts rows = auditLeaves (0, \(acc, value) => acc * 10 + value, rows)

(** Appends each leaf string to a `/`-terminated log, so `[[ant]]` becomes `ant/`. *)
auditStrings rows = auditLeaves ("", \(acc, value) => acc + value + "/", rows)

(** One flow crosses generic instantiation, three list layers, `Result<T, Error>`
    recovery, persistent producers, nested patterns, callbacks, and generic
    operation erasure. This jointly enforces [TYPE-GENERICS-FN], [TYPE-LIST],
    [TYPE-LIST-PATTERNS], [BUILTIN-LIST-GET], [BUILTIN-LIST-FOREACH], and
    [EFFECTS-GENERIC-RUNTIME]. *)
nestedListEffectPatternCase () =
    leaf = "four leaf arguments survive nested Result extraction"
    grown = "deep persistence patterns and generic effects stay coherent"
    ints = [[1, 2], [3, 4, 5]]
    strings = [["ant", "bee"], ["cat", "dog", "eel"]]
    floats = [[1.25, 2.5], [3.75, 4.5, 5.25]]
    bools = [[true, false], [false, true, true]]
    intCube = [ints, [[6], [7, 8, 9]], [[10, 11, 12, 13]]]
    stringCube = [strings, [["fox"], ["gnu", "hare"]], [["ibis", "jay"]]]
    intPlane = listGet intCube 1 ?: [[99]]
    stringPlane = listGet stringCube 1 ?: [["missing"]]
    grownInts = ints |> listAppend [6, 7] |> listPrepend [8, 9] |> listReverse
    grownStrings = strings |> listAppend ["fox", "gnu"] |> listReverse

    checkSelf leaf ints [99] 99
    checkSelf leaf strings ["row"] "item"
    checkSelf leaf floats [9.0] 9.5
    checkSelf leaf bools [false] false

    checkAll leaf [
        structuralEquals [listLength ints, listLength strings, listLength floats] [2, 2, 2],
        checkLengths bools (listGet ints 0 ?: [99]) [2, 2],
        structuralEquals [listLength (listGet ints 1 ?: [99]), nestedAt (ints, 8, 0, [91, 92], 99)] [3, 91],
        structuralEquals [nestedAt (ints, 0, 8, [91], 99), length (textAt strings 1 0)] [99, 3],
        textAt strings 8 0 == "row",
        textAt strings 0 8 == "item",
        nestedAt (floats, 0, 0, [9.0], 9.5) + nestedAt (floats, 0, 1, [9.0], 9.5) == 3.75,
        structuralEquals [nestedAt (floats, 9, 0, [9.0], 9.5), nestedAt (floats, 0, 9, [9.0], 9.5)] [9.0, 9.5],
        nestedAt (bools, 9, 0, [true], false),
        !(nestedAt (bools, 0, 9, [true], false))
    ]

    checkMatrix grown grownInts [[6, 7], [3, 4, 5], [1, 2], [8, 9]] [99] 99
    checkMatrix grown grownStrings [["fox", "gnu"], ["cat", "dog", "eel"], ["ant", "bee"]] ["row"] "item"

    checkAll grown [
        structuralEquals [listLength intCube, listLength stringCube, nestedAt (intPlane, 1, 2, [99], 99)] [3, 3, 9],
        structuralEquals [nestedAt (listGet intCube 2 ?: [[99]], 0, 3, [99], 99), auditInts ints] [13, 12345],
        structuralEquals [auditInts [[6], [7, 8]], listLength grownInts] [678, 4],
        structuralEquals [listLength grownStrings, chooseByCollection (listGet strings 0 ?: ["x"], 41, 99)] [3, 41],
        textAt stringPlane 1 1 == "hare",
        textAt (listGet stringCube 2 ?: [["missing"]]) 0 1 == "jay",
        checkShapes (List ()) [[]] "empty" "one-empty-row",
        checkShapes [[7]] ints "one-singleton-row" "two:2/3",
        checkShapes strings [[1], [2], [3]] "two:2/3" "many:1+2",
        auditStrings strings == "ant/bee/cat/dog/eel/",
        auditStrings [["fox"], ["gnu", "hare"]] == "fox/gnu/hare/",
        chooseByCollection (listGet ints 0 ?: [99], "present", "empty") == "present",
        chooseByCollection (List (), true, false) == false,
        chooseByCollection (listGet floats 1 ?: [0.0], 6.5, 7.5) == 6.5
    ]

test "nested generic lists mix effects patterns Results and persistence" (exactly nestedListEffectPatternCase)
