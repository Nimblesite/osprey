(** Cross-contract oracle for [TYPE-GENERICS-FN], [FLAVOR-ML-GENERICS],
    [TYPE-LIST], [TYPE-LIST-PATTERNS], [BUILTIN-LIST-GET],
    [BUILTIN-LIST-APPEND], [BUILTIN-LIST-PREPEND], [BUILTIN-LIST-REVERSE],
    [BUILTIN-LIST-FOREACH], [EFFECTS-GENERIC-DECL],
    [EFFECTS-GENERIC-INSTANTIATION], and [EFFECTS-GENERIC-RUNTIME]. *)
effect LeafAudit T
    observe : T => Unit

nestedAt<T> : (List (List T), int, int, List T, T) -> T
nestedAt (matrix, row, column, fallbackRow, fallback) =
    listGet (listGet matrix row ?: fallbackRow) column ?: fallback

(** cellReader binds `fallbackRow` and `fallback` once so a case walks a matrix
    by row and column without repeating its recovery arguments. *)
cellReader (matrix, fallbackRow, fallback) = \(row, column) => nestedAt (matrix, row, column, fallbackRow, fallback)
(** rowIs reads row `row` of `matrix` cell by cell through nestedAt and holds
    when the cells are `wants`, in order. *)
rowIs (matrix, row, fallbackRow, fallback, wants) = range (0, listLength wants) |> fold true (\(ok, c) => ok && nestedAt (matrix, row, c, fallbackRow, fallback) == (listGet wants c ?: fallback))

chooseByCollection<T, U> : (List T, U, U) -> U
chooseByCollection (items, present, empty) = match isEmpty items
    true => empty
    false => present

matrixShape<T> : List (List T) -> string
matrixShape matrix = match matrix
    [] => "empty"
    [row] => match row
        [] => "one-empty-row"
        [_only] => "one-singleton-row"
        _ => "one:${listLength row}"
    [first, second] => "two:${listLength first}/${listLength second}"
    [head, ...tail] => "many:${listLength head}+${listLength tail}"

(** auditLeaves folds every leaf of `rows` through one LeafAudit handler that
    combines the running `initial` accumulator with each observed leaf. *)
auditLeaves (rows, initial, combine) =
    mut encoded = initial
    handle LeafAudit
        observe value =>
            encoded := combine (encoded, value)
    forEachList rows (\row => forEachList row (\value => perform LeafAudit.observe value))
    encoded

auditInts rows = auditLeaves (rows, 0, \(acc, value) => acc * 10 + value)

auditStrings rows = auditLeaves (rows, "", \(acc, value) => acc + value + "/")

(** One flow crosses generic instantiation, three list layers, `Result<T, Error>`
    recovery, persistent producers, nested patterns, callbacks, and generic
    operation erasure. This jointly enforces [TYPE-GENERICS-FN], [TYPE-LIST],
    [TYPE-LIST-PATTERNS], [BUILTIN-LIST-GET], [BUILTIN-LIST-FOREACH], and
    [EFFECTS-GENERIC-RUNTIME]. *)
nestedListEffectPatternCase () =
    ints = [[1, 2], [3, 4, 5]]
    strings = [["ant", "bee"], ["cat", "dog", "eel"]]
    floats = [[1.25, 2.5], [3.75, 4.5, 5.25]]
    bools = [[true, false], [false, true, true]]
    intCube = [ints, [[6], [7, 8, 9]], [[10, 11, 12, 13]]]
    stringCube = [strings, [["fox"], ["gnu", "hare"]], [["ibis", "jay"]]]
    intPlane = listGet intCube 1 ?: [[99]]
    stringPlane = listGet stringCube 1 ?: [["missing"]]
    grownInts = ints |> listAppend [6, 7] |> listPrepend [8, 9] |> listReverse
    grownStrings = strings |> listAppend ["fox", "gnu"] |> listReverse
    stringCell = cellReader (strings, ["row"], "item")
    grownStringCell = cellReader (grownStrings, ["row"], "item")
    floatCell = cellReader (floats, [9.0], 9.5)
    grownCell = cellReader (grownInts, [99], 99)
    boolCell = cellReader (bools, [false], false)
    hitCell = cellReader (bools, [true], true)
    missCell = cellReader (bools, [true], false)

    checkAll "four leaf arguments survive nested Result extraction" [
        listLength ints == 2,
        listLength strings == 2,
        listLength floats == 2,
        listLength bools == 2,
        listLength (listGet ints 0 ?: [99]) == 2,
        listLength (listGet ints 1 ?: [99]) == 3,
        rowIs (ints, 0, [99], 99, [1, 2]),
        rowIs (ints, 1, [99], 99, [3, 4, 5]),
        nestedAt (ints, 8, 0, [91, 92], 99) == 91,
        nestedAt (ints, 0, 8, [91], 99) == 99,
        rowIs (strings, 0, ["row"], "item", ["ant", "bee"]),
        rowIs (strings, 1, ["row"], "item", ["cat", "dog", "eel"]),
        stringCell (8, 0) == "row",
        stringCell (0, 8) == "item",
        length (stringCell (1, 0)) == 3,
        rowIs (floats, 0, [9.0], 9.5, [1.25, 2.5]),
        rowIs (floats, 1, [9.0], 9.5, [3.75, 4.5, 5.25]),
        floatCell (0, 0) + floatCell (0, 1) == 3.75,
        floatCell (9, 0) == 9.0,
        floatCell (0, 9) == 9.5,
        boolCell (0, 0),
        !(hitCell (0, 1)),
        !(hitCell (1, 0)),
        boolCell (1, 1),
        boolCell (1, 2),
        missCell (9, 0),
        !(missCell (0, 9))
    ]

    checkAll "deep persistence patterns and generic effects stay coherent" [
        listLength intCube == 3,
        listLength stringCube == 3,
        nestedAt (intPlane, 1, 2, [99], 99) == 9,
        nestedAt (stringPlane, 1, 1, ["row"], "item") == "hare",
        nestedAt (listGet intCube 2 ?: [[99]], 0, 3, [99], 99) == 13,
        nestedAt (listGet stringCube 2 ?: [["missing"]], 0, 1, ["row"], "item") == "jay",
        matrixShape (List ()) == "empty",
        matrixShape [[]] == "one-empty-row",
        matrixShape [[7]] == "one-singleton-row",
        matrixShape ints == "two:2/3",
        matrixShape strings == "two:2/3",
        matrixShape [[1], [2], [3]] == "many:1+2",
        auditInts ints == 12345,
        auditInts [[6], [7, 8]] == 678,
        auditStrings strings == "ant/bee/cat/dog/eel/",
        auditStrings [["fox"], ["gnu", "hare"]] == "fox/gnu/hare/",
        listLength grownInts == 4,
        rowIs (grownInts, 0, [99], 99, [6, 7]),
        grownCell (1, 0) == 3,
        grownCell (2, 0) == 1,
        rowIs (grownInts, 3, [99], 99, [8, 9]),
        listLength grownStrings == 3,
        grownStringCell (0, 0) == "fox",
        grownStringCell (2, 1) == "bee",
        chooseByCollection (listGet ints 0 ?: [99], "present", "empty") == "present",
        chooseByCollection (listGet strings 0 ?: ["x"], 41, 99) == 41,
        chooseByCollection (List (), true, false) == false,
        chooseByCollection (listGet floats 1 ?: [0.0], 6.5, 7.5) == 6.5
    ]

(** Exact-value tests record any arithmetic fault as a failed assertion. *)

test "nested generic lists mix effects patterns Results and persistence" (exactly nestedListEffectPatternCase)
