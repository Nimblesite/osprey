(** ML surface for [MODULES-MODULE] and [MODULES-EXPORTS] carrying data:
    records, unions and generic functions declared inside a module, matched and
    consumed across the boundary through the module's exported factories.

    An exported union's constructors ARE public — [MODULES-OPAQUE-TYPES] makes
    only the OPAQUE ones private — but a factory is still the surface to prefer:
    it keeps the representation free to change, so every value here is built by
    an exported factory and inspected by an exported accessor. *)

namespace shapes

(** Shapes, their extents and their faults, every value built and read through
    the exports below. *)
module Geo
    (** A circle or a square, each carrying its one dimension. *)
    export type Shape = Circle(radius : int) | Square(side : int)

    (** The width and height of a shape's bounding box. *)
    export type Extent =
        width : int
        height : int

    (** Builds a circle of `radius`. *)
    export circle radius =
        Circle
            radius = radius

    (** Builds a square of `side`. *)
    export square side =
        Square
            side = side

    (** The area of `shape`: its radius or side squared. *)
    export area shape = match shape
        Circle radius => (radius * radius)
        Square side => (side * side)

    (** The lower-case kind of `shape`, as text. *)
    export name shape = match shape
        Circle _ => "circle"
        Square _ => "square"

    (** The bounding box of `shape`: a circle spans twice its radius, a square its side. *)
    export extent shape = match shape
        Circle radius =>
            Extent
                width = (radius * 2)
                height = (radius * 2)
        Square side =>
            Extent
                width = side
                height = side

    (** Twice the width plus height of `extent`. *)
    export perimeterOf extent = ((((extent.width + extent.height) ) * 2) )

    (** The two reasons a shape request fails. *)
    export type Fault = Missing | InvalidParameter

    (** The fault for an absent shape. *)
    export missing () = Missing

    (** The fault for a rejected parameter. *)
    export invalid () = InvalidParameter

(** A generic one-field record, so one module function can be shown specialising
    at several call sites. *)
module Boxes
    (** A record holding one value of any type. *)
    export type Box T =
        held : T

    (** A generic module function specialises independently at every call site. *)
    export wrap value =
        Box
            held = value

    (** Reads the value a box holds. *)
    export held box = box.held

    (** Rebuilds `box` around the value it already holds. *)
    export rewrap box = wrap (held box)

(** An opaque record ID: built by `make`, read by `value`, never forged outside. *)
module Ids
    (** The representation stays inside: a client builds an `Id` only through
        `make` and reads it only through `value` ([MODULES-OPAQUE-TYPES]). *)
    export opaque type Id =
        value : int

    (** Builds an ID carrying `n`. *)
    export make n =
        Id
            value = n

    (** Reads the number an ID carries. *)
    export value id = id.value

    (** Read the ID carried by either result variant.
    # Examples
    ```osprey
    print (Ids::resultValue (Error(message = Ids::make 9)))
    ```
    ```output
    9
    ```
    *)
    export resultValue r = match r
        Success (Id n) | Error (Id n) => n

    (** An ID carrying one more than `id` does. *)
    export next id = match id
        Id value =>
            Id
                value = value + 1

(** Opaque aliases over `int` and `string`, so a client can hold a token but
    never inspect it. *)
module Tokens
    (** Manifest aliases kept abstract: inside `Tokens` a `Token` IS an `int`
        and a `Label` IS a `string`, so the module computes with them freely.
        A client can only hold one and hand it back ([MODULES-OPAQUE-TYPES]). *)
    export opaque type Token = int
    (** The opaque text form of a token, which a client can only pass back. *)
    export opaque type Label = string

    (** A token for `n`, carrying twice its value inside the module. *)
    export issue : int -> Token
    issue n = n * 2

    (** The token one past `token`. *)
    export next : Token -> Token
    next token = token + 1

    (** The integer a token hides. *)
    export raw : Token -> int
    raw token = token

    (** Whether two tokens carry the same integer. *)
    export same : (Token, Token) -> bool
    same (left, right) = left == right

    (** An opaque `t<n>` label for `token`. *)
    export label : Token -> Label
    label token = "t${token}"

    (** The string behind an opaque label. *)
    export text : Label -> string
    text label = label

(** Opaque aliases of four shapes — a generic application, a record, a `Result`
    and a function type — each reached only through the exports below. *)
module Sealed
    type Conn =
        host : string
        port : int

    (** Aliases of every shape stay abstract alike: a generic application, a
        record, a `Result` and a function type. Inside the module each one is
        the type it names, so list, field, `?:` and call rules all apply. *)
    export opaque type Bag T = (List T)
    (** An opaque connection record of host and port. *)
    export opaque type Link = (Conn)
    (** An opaque `Result<int, string>`. *)
    export opaque type Attempt = (Result int string)
    (** An opaque int-to-int function. *)
    export opaque type Step = (int -> int)

    (** A bag holding `first` then `second`. *)
    export bag : (int, int) -> Bag int
    bag (first, second) = [first, second]

    (** How many items a bag holds. *)
    export size : Bag int -> int
    size bag = listLength bag

    (** A link to `host` on `port`. *)
    export open : (string, int) -> Link
    open (host, port) =
        Conn
            host = host
            port = port

    (** `link` with its port replaced by `port`. *)
    export moved : (Link, int) -> Link
    moved (link, port) = link(port = port)

    (** Renders a link as `host:port`. *)
    export describe : Link -> string
    describe link = "${link.host}:${link.port}"

    (** A successful attempt carrying `n`. *)
    export tried : int -> Attempt
    tried n = n

    (** A failed attempt carrying `why` as its message. *)
    export failed : string -> Attempt
    failed why = Error(message = why)

    (** The attempt's value, or `fallback` when it failed. *)
    export orElse : (Attempt, int) -> int
    orElse (attempt, fallback) = attempt ?: fallback

    (** A step that adds `n` to its input. *)
    export stepBy : int -> Step
    stepBy n = \x => x + n

    (** Applies `step` to `start`. *)
    export run : (Step, int) -> int
    run (step, start) = step start

(** Constructors reached through exported factories keep their payloads. *)
unionPayloadCase () = checkAll ("module union payloads survive the boundary", [
    structuralEquals [Geo::area (Geo::circle 3), Geo::area (Geo::square 4)] [9, 16],
    structuralEquals [Geo::area (Geo::circle 0), Geo::area (Geo::square (Geo::area (Geo::square 2)))] [0, 16],
    structuralEquals [Geo::name (Geo::circle 3), Geo::name (Geo::square 4)] ["circle", "square"]
])

(** A union constructor of a namespaced module prints its own name, never its mangled symbol. *)
faultNameCase () = checkAll ("namespaced union constructors print their names", [
    "${Geo::missing ()}" == "Missing",
    "fault: ${Geo::invalid ()}." == "fault: InvalidParameter.",
    structuralEquals (mapList ([Geo::missing (), Geo::invalid ()], \fault => "${fault}")) ["Missing", "InvalidParameter"]
])

(** A record declared in a module crosses the boundary with its fields intact. *)
recordFieldCase () = checkAll ("module record fields cross the boundary", [
    structuralEquals [(Geo::extent (Geo::circle 3)).width, (Geo::extent (Geo::circle 3)).height] [6, 6],
    structuralEquals [(Geo::extent (Geo::square 5)).width, Geo::perimeterOf (Geo::extent (Geo::square 5))] [5, 20],
    Geo::perimeterOf (Geo::extent (Geo::circle 1)) == 8
])

(** One generic module function serves several unrelated instantiations. *)
genericModuleCase () = checkAll ("generic module functions specialise per site", [
    structuralEquals [Boxes::held (Boxes::wrap 7), Boxes::held (Boxes::rewrap (Boxes::wrap 2))] [7, 2],
    Boxes::held (Boxes::wrap (Geo::area (Geo::square 3))) == 9,
    Boxes::held (Boxes::wrap "seven") == "seven",
    Boxes::held (Boxes::wrap true) == true
])

(** An opaque record is built, read and rebuilt only by its own module. *)
opaqueCase () = checkAll ("opaque records are reached through their module", [
    Ids::resultValue (Success(value = Ids::make 3)) == 3,
    Ids::resultValue (Error(message = Ids::make 9)) == 9,
    structuralEquals [Ids::value (Ids::make 7), Ids::value (Ids::next (Ids::make 7))] [7, 8],
    Ids::value (Ids::next (Ids::next (Ids::make 0))) == 2
])

(** An opaque alias is the bare representation at run time, yet it cannot be
    forged or inspected: it travels through bindings, generic functions and
    lists, and back into its module, unchanged. *)
opaqueAliasCase () =
    first = Tokens::issue 20
    second = Tokens::next first
    held = [first, second]
    checkAll ("opaque aliases are reached through their module", [
        structuralEquals [Tokens::raw first, Tokens::raw second] [40, 41],
        structuralEquals [listLength held, Tokens::raw (listGet held 1 ?: first)] [2, 41],
        structuralEquals [Sealed::size (Sealed::bag (4, 5)), Sealed::orElse (Sealed::tried 3, 9)] [2, 3],
        structuralEquals [Sealed::orElse (Sealed::failed "no", 9), Sealed::run (Sealed::stepBy 5, 10)] [9, 15],
        Tokens::same (first, first),
        !Tokens::same (first, second),
        Tokens::text (Tokens::label second) == "t41",
        Sealed::describe (Sealed::moved (Sealed::open ("host", 80), 81)) == "host:81",
        Tokens::same (Boxes::held (Boxes::wrap second), second)
    ])

exactArithmetic (\() =>
    print "${Geo::area (Geo::circle 3)} ${Geo::name (Geo::square 4)} ${Geo::perimeterOf (Geo::extent (Geo::square 5))} ${Boxes::held (Boxes::wrap "seven")}")

exactTests [
    { name = "module unions keep their payloads", work = unionPayloadCase },
    { name = "module records keep their fields", work = recordFieldCase },
    { name = "module generics specialise per call site", work = genericModuleCase },
    { name = "module opaque records stay abstract", work = opaqueCase },
    { name = "module opaque aliases stay abstract", work = opaqueAliasCase },
    { name = "namespaced union constructors print their names", work = faultNameCase }
]
