/// Default surface for [MODULES-SIGNATURE] and [MODULES-EXPORTS]: an ascribed
/// module publishes exactly the items its signature names, keeps everything
/// else private, and conforms in kind, arity, types, effects and nesting.

namespace store;

signature CounterApi {
    type Counter
    fn empty() -> Counter
    fn bump(c: Counter) -> Counter
    fn size(c: Counter) -> int
}

signature ClockApi {
    effect Clock {
        control now : fn() -> int
    }
    fn reading() -> int
}

signature LeafApi {
    fn value() -> int
}

signature TreeApi {
    module Leaf : LeafApi
    fn doubled() -> int
}

signature PickerApi {
    fn pick<A, B>(a: A, b: B) -> B
    fn keep<T>(x: T) -> T
}

/// An ascribed module's signature is its whole public surface.
module Counters : CounterApi {
    type Counter = { count: int }

    /// A private helper is not in the signature, so it stays module-private.
    fn step(n) = (n + 1) 

    fn empty() = Counter { count: 0 }
    fn bump(c) = Counter { count: step(c.count) }
    fn size(c) = c.count
}

/// The same contract implemented by a manifest alias: `Counter` is an `int`
/// inside `Tallies` and stays abstract outside it, at no run-time cost
/// ([MODULES-OPAQUE-TYPES]).
module Tallies : CounterApi {
    type Counter = int

    fn empty() = 0
    fn bump(c) = c + 1
    fn size(c) = c
}

/// A signature may carry an effect declaration alongside its functions.
module Clocks : ClockApi {
    effect Clock {
        control now : fn() -> int
    }

    fn reading() = perform Clock.now()
}

/// Nested-module ascription conforms recursively.
module Trees : TreeApi {
    module Leaf : LeafApi {
        fn value() = 21
    }

    fn doubled() = (Leaf::value() * 2) 
}

/// Unannotated implementations take the signature's binders, which stay
/// rigid and are instantiated afresh at every use ([TYPE-GENERICS-FN]).
module Pickers : PickerApi {
    fn pick(_a, b) = b
    fn keep(x) = x
}

/// An unascribed module reaches the same surface through plain `export`.
/// The Default-only `: Signature + extra` ascription cannot appear in a twin
/// pair — ML ascription is exact — so it is asserted in
/// `src/toolchain/crates/osprey-project/tests/module_diagnostics.rs` instead.
module Extended {
    type Counter = { count: int }
    /// A counter that starts at five, not zero.
    export fn empty() = Counter { count: 5 }
    /// A counter two past `c`.
    export fn bump(c) = Counter { count: ((c.count + 2)) }
    /// The count `c` holds.
    export fn size(c) = c.count

    /// The size of the starting counter, which is five.
    export fn seeded() = size(empty())
}

/// The abstract `Counter` flows through the ascribed surface without leaking.
fn abstractTypeCase() = checkAll("abstract signature type round-trips", [
    structuralEquals([Counters::size(Counters::empty()), Counters::size(Counters::bump(Counters::empty()))], [0, 1]),
    Counters::size(Counters::bump(Counters::bump(Counters::empty()))) == 2,
    Counters::size(Counters::bump(Counters::bump(Counters::bump(Counters::empty())))) == 3,
    Tallies::size(Tallies::empty()) == 0,
    Tallies::size(Tallies::bump(Tallies::bump(Tallies::empty()))) == 2
])

/// Reads the module's clock through a caller-installed handler.
fn readAs(stamp) = {
    handle Clocks::Clock {
        now => resume(stamp)
    }
    Clocks::reading()
}

/// A signature effect is declared by the module and handled by the caller.
fn signatureEffectCase() = checkAll("signature effect stays performable", [
    structuralEquals([readAs(7), readAs(0), readAs(41), ((readAs(41) + 1) ), readAs(readAs(3))], [7, 0, 41, 42, 3])
])

/// Nested ascription and the plain-export surface both stay addressable.
fn nestedAndExtraCase() = checkAll("nested ascription and extra exports", [
    structuralEquals([Trees::Leaf::value(), Trees::doubled(), Extended::size(Extended::empty())], [21, 42, 5]),
    structuralEquals([Extended::size(Extended::bump(Extended::empty())), Extended::seeded()], [7, 5])
])

/// One generic signature item used at several types in one program.
fn genericCase() = checkAll("generic signature binders instantiate per use", [
    Pickers::pick(1, "two") == "two",
    Pickers::pick("one", 2) == 2,
    Pickers::keep(Pickers::keep(9)) == 9,
    Pickers::keep("x") == "x"
])

exactArithmetic(fn() => print("${Counters::size(Counters::bump(Counters::empty()))} ${Trees::doubled()} ${Extended::seeded()}"))

exactTests([
    { name: "abstract signature types stay abstract", work: abstractTypeCase },
    { name: "signature effects remain performable", work: signatureEffectCase },
    { name: "nested ascription and extra exports conform", work: nestedAndExtraCase },
    { name: "generic signatures instantiate per use", work: genericCase }
])
