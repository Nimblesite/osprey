
/// Default twin of the ML layout-depth program. ML layout is the one place the
/// two surfaces genuinely differ: Default marks every boundary with braces, ML
/// marks them only with indentation. Holding both to one golden is what proves
/// a layout bug that closed a block one line early would be caught
/// ([FLAVOR-ML-LAYOUT], [MODULES-FLAVOR-PROJECTION]).

namespace depth {
    signature LeafApi {
        fn value() -> int
        fn scaled(n: int) -> int
    }

    /// The outermost of four nesting levels, holding a private factor that only
    /// its own exports read.
    module Trunk {
        /// Private at the trunk, so only the trunk's own exports may use it.
        let factor = 3

        /// The middle level, holding a leaf module and one that performs an effect.
        export module Branch {
            /// A leaf module three segments deep, ascribed to `LeafApi`.
            export module Twig : LeafApi {
                fn value() = 7
                fn scaled(n) = (n * 7) 
            }

            /// A branch reaches its own twig without qualification.
            export fn pick() = Twig::value()

            /// The deepest module, declaring an effect four segments below the namespace.
            export module Bud {
                /// A single `draw` row that no module in this chain handles.
                export effect Sap {
                    control draw : fn(int) -> int
                }

                /// Four segments deep, and the row still reaches the caller.
                export fn drink(n) = perform Sap.draw(n)
            }
        }

        /// Multiplies `n` by the trunk's private factor.
        export fn amplify(n) = (n * factor) 
    }
}

import depth::Trunk::Branch::Twig
import depth::Trunk::Branch::Bud as Bud
import depth::Trunk::{amplify, amplify as boost}

/// Installs a doubling handler for the effect declared at the deepest level.
fn tapping(rate, body) = {
    handle Bud::Sap {
        draw amount => resume((amount * rate) )
    }
    body()
}

/// Every nesting level stays addressable by its full path and by its import.
fn nestingDepthCase() = checkAll("layout nesting keeps every level addressable", [
    depth::Trunk::Branch::Twig::value() == 7,
    Twig::value() == 7,
    depth::Trunk::Branch::pick() == 7,
    Twig::scaled(2) == 14,
    depth::Trunk::Branch::Twig::scaled(3) == 21,
    depth::Trunk::amplify(2) == 6
])

/// A layout import selecting two members binds both, alias included.
fn layoutImportCase() = checkAll("indented member selection binds each name", [
    amplify(2) == 6,
    boost(2) == 6,
    amplify(0) == 0,
    boost(Twig::value()) == 21,
    amplify(boost(1)) == 9
])

/// The deepest module's effect is handled by a top-level installer.
fn deepEffectCase() = checkAll("an effect four segments deep still propagates", [
    tapping(2, fn() => Bud::drink(5)) == 10,
    tapping(1, fn() => Bud::drink(5)) == 5,
    tapping(0, fn() => Bud::drink(5)) == 0,
    tapping(3, fn() => (Bud::drink(2) + Bud::drink(4)) ) == 18,
    tapping(2, fn() => Bud::drink(Twig::value())) == 14
])

/// Hands `x` to `f`, so a lambda argument may carry a block body.
fn applied(x, f) = f(x)

/// A block body under a lambda nested in another lambda's argument closes at its own bracket.
fn nestedBodyCase() = applied(2, fn(outer) => {
    let inner = applied(outer, fn(x) => {
        let doubled = x * 2
        doubled + 1
    })
    let deeper = applied(inner, fn(y) => applied(y, fn(z) => z * 10))
    checkAll("nested block bodies close at their brackets", [
        inner == 5,
        deeper == 50,
        applied(1, fn(w) => w + 1) == 2
    ])
})

exactArithmetic(fn() => print("${Twig::scaled(3)} ${boost(2)} ${tapping(2, fn() => Bud::drink(5))} ${depth::Trunk::Branch::pick()}"))

exactTests([
    { name: "layout nesting keeps every level addressable", work: nestingDepthCase },
    { name: "an indented import selection binds every member", work: layoutImportCase },
    { name: "an effect declared four segments deep propagates", work: deepEffectCase },
    { name: "a nested block body closes at its bracket", work: nestedBodyCase }
])
