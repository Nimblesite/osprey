/// Default surface of a codegen regression: inside a module function, a field
/// read on a record an effect operation returned took another record's layout
/// when two records declare that field name, and read the wrong memory. Codegen
/// now takes the owner from the inferred type ([MODULES-EFFECTS]
/// [TYPE-FIELD-ACCESS-NON-RECORD]).

namespace inventory;

type Item = { name: string, bytes: int }
type Listing = { items: List<Item>, skipped: int }
type Tally = { skipped: int, label: string, items: List<Item> }

module Store {
    export effect Catalog {
        list : fn(string) -> Listing
    }

    fn sum(items) = match items {
        [] => 0
        [first, ...rest] => satAdd(first.bytes, sum(rest))
    }

    /// Reads both fields of the operation's result inside the module.
    export fn tally(root) = {
        let listing = perform Catalog.list(root)
        Tally { skipped: listing.skipped, label: root, items: listing.items }
    }

    export fn total(root) = sum(perform Catalog.list(root).items)
}

let fixed = handler Store::Catalog {
    list _ => Listing { items: [Item { name: "a", bytes: 5 }, Item { name: "b", bytes: 7 }], skipped: 3 }
}
let counted = fixed(fn() => Store::tally("/disk"))
print("${counted.label}: ${length(counted.items)} items, ${counted.skipped} skipped, ${fixed(fn() => Store::total("/disk"))} bytes")
