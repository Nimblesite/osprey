(** ML surface for the generic clause of [MODULES-FILE-SCOPE-BINDING]: a binding
    whose value is a GENERIC function is the one case with no module storage at
    all. A generic definition has no single machine-level shape
    ([TYPE-GENERICS-FN]), so binding it produces no runtime value to store — the
    name resolves to the body, and every call site specialises it independently.

    Handler coexistence is covered by `effect_installer_defects`; the tests below
    focus on independent specialization and lexical binding identity. *)

(** A generic identity, bound by name below. *)
identity x = x

(** A generic wrapper, so the binding is exercised at two arities of use. *)
labelled (tag, value) = "${tag}:${value}"

alias = identity
tagged = labelled

(** Specialised at `int` by this call site alone. *)
roundTo n = alias n

(** Specialised at `string` by this call site alone; the binding is not narrowed
    to whichever type the first caller happened to fix. *)
label s = alias s

(** Specialised at `bool` through a third, independent site. *)
flag b = alias b

(** One binding, three unrelated instantiations. *)
independentSpecialisationCase () = checkAll ("generic binding specialises per site", [
    structuralEquals [roundTo 1, roundTo 0] [1, 0],
    structuralEquals [label "s", label ""] ["s", ""],
    flag true == true,
    flag false == false
])

(** The binding and the function it names are the same declaration. *)
bindingEqualsNameCase () = checkAll ("the binding resolves to the named body", [
    alias 7 == identity 7,
    alias "seven" == identity "seven",
    structuralEquals [roundTo (identity 3), alias (alias (alias 2))] [3, 2],
    label (alias "x") == "x"
])

(** A second generic binding specialises independently of the first. *)
secondBindingCase () = checkAll ("a second generic binding is independent", [
    structuralEquals [tagged ("n", 1), tagged ("s", "one"), tagged ("b", true)] ["n:1", "s:one", "b:true"],
    structuralEquals [tagged ("nested", tagged ("in", 2)), tagged ("via", roundTo 4)] ["nested:in:2", "via:4"]
])

(** [TYPE-GENERICS-FN] Specialization preserves declaration scope and caller arguments. *)
anchor = 2
fileLambda = \_ignored => anchor
declared _ignored = anchor
declaredAlias = declared
apply (f, value) = f value
relay (f, value) = apply (f, value)
curried first second = "${first}:${second}:${anchor}"
type IntOperation =
    run : int -> int
type StringOperation =
    run : string -> int

lexicalCallCase () =
    anchor = 100
    caller = \value => wrapAdd (anchor, value)
    captured = \value => "${anchor}:${value}"
    checkAll ("generic calls use declaration bindings", [
        (range (1, 3) |> map declared |> fold (0, wrapAdd)) == 4,
        structuralEquals [(range (1, 3) |> map declaredAlias |> fold (0, wrapAdd)), fileLambda anchor] [4, 2],
        structuralEquals [(range (1, 3) |> map fileLambda |> fold (0, wrapAdd)), declared anchor] [4, 2],
        structuralEquals [declaredAlias "independent", identity anchor, caller 1] [2, 100, 101],
        structuralEquals [apply (declared, anchor), relay (declaredAlias, "forwarded"), anchor] [2, 2, 100],
        gpuSatisfies(toGpu [1, 2], \uploaded => gpuSatisfies(gpuMap (uploaded, declared), \mapped => gpuEquals(gpuFold (mapped, 0, wrapAdd), 4))),
        gpuSatisfies(toGpu [1, 2], \uploaded => gpuSatisfies(gpuMap (uploaded, declaredAlias), \mapped => gpuEquals(gpuFold (mapped, 0, wrapAdd), 4))),
        gpuSatisfies(toGpu [1, 2], \uploaded => gpuSatisfies(gpuMap (uploaded, fileLambda), \mapped => gpuEquals(gpuFold (mapped, 0, wrapAdd), 4))),
        structuralEquals [apply (captured, 1), relay (captured, "a")] ["100:1", "100:a"]
    ])

lexicalValueCase () =
    anchor = 100
    integers = IntOperation(run = declared)
    strings = StringOperation(run = declaredAlias)
    local = IntOperation(run = \value => wrapAdd (anchor, value))
    checkAll ("generic values use declaration bindings", [
        structuralEquals [integers.run anchor, strings.run "independent", local.run 1, anchor] [2, 2, 101, 100]
    ])

lexicalCurryCase () =
    first = 100
    anchor = 200
    checkAll ("curried arguments stay in caller scope", [
        structuralEquals [curried 1 (curried 2 3), curried 1 first] ["1:2:3:2:2", "1:100:2"],
        curried "a" anchor == "a:200:2",
        structuralEquals [first, anchor] [100, 200]
    ])

effect Trace
    step : string => int
marked (label, value) =
    _ = perform Trace.step label
    value
staged first =
    _ = perform Trace.step "body"
    \second => "${first}:${second}:${anchor}"

applicationOrderCase () =
    mut seen = ""
    handle Trace
        step label =>
            seen := "${seen}${label}|"
            length seen
    first = 100
    anchor = 200
    actual = staged (marked ("first", 1)) (marked ("second", first))
    checkAll ("curried effects execute once in application order", [
        structuralEquals [actual, seen] ["1:100:2", "first|body|second|"],
        structuralEquals [first, anchor] [100, 200]
    ])

mut shared = 2
effect Counter
    set : int => int
readShared _ignored = shared

mutableScopeCase () =
    handle Counter
        set value =>
            shared := value
            shared
    mut shared = 100
    local = \() => shared
    holder = IntOperation(run = readShared)
    before = holder.run 0
    updated = perform Counter.set 7
    checkAll ("generic values read live declaration storage", [
        structuralEquals [before, updated, holder.run 0] [2, 7, 7],
        structuralEquals [readShared "another type", local (), shared] [7, 100, 100]
    ])

print "${roundTo 1} ${label "s"} ${flag true} ${tagged ("n", 1)}"
testCases [
    { name = "one generic binding specialises at every call site", work = independentSpecialisationCase },
    { name = "a generic binding resolves to the named body", work = bindingEqualsNameCase },
    { name = "generic bindings specialise independently of each other", work = secondBindingCase },
    { name = "generic calls preserve lexical bindings", work = lexicalCallCase },
    { name = "generic values preserve lexical bindings", work = lexicalValueCase },
    { name = "curried arguments preserve caller bindings", work = lexicalCurryCase },
    { name = "curried effects preserve application order", work = applicationOrderCase },
    { name = "generic values preserve live global storage", work = mutableScopeCase }
]
