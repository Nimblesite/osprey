/// Default surface for [MODULES-IMPORT] and [MODULES-RESOLUTION]: whole-module,
/// aliased, member and aliased-member imports, and the rule that a nearer local
/// or module declaration always wins over an imported binding.

namespace catalog {
    module Units {
        export let each = 1
        export fn pack(count) = (count * 12) 
        export fn crate(count) = (pack(count) * 4) 

        export module Metric {
            export fn grams(kilos) = (kilos * 1000) 
        }
    }

    module Pricing {
        export fn cents(dollars) = (dollars * 100) 
    }
}

import catalog::Units
import catalog::Units as U
import catalog::Units::{pack, crate as bigCrate}
import catalog::Units::Metric
import catalog::Pricing::{cents}

/// A local declaration is nearer than any import, so it shadows `cents`.
fn localWins() = 7

/// The imported member name and the qualified path denote one declaration.
fn memberImportCase() = checkAll("member imports bind exported members", [
    structuralEquals([pack(2), pack(0), bigCrate(1), bigCrate(2), cents(3)], [24, 0, 48, 96, 300]),
    pack(2) == Units::pack(2),
    bigCrate(1) == catalog::Units::crate(1)
])

/// A whole-module import binds its final segment, or its explicit alias.
fn wholeModuleImportCase() = checkAll("whole-module imports and aliases", [
    structuralEquals([Units::each, U::each, Units::pack(3), U::pack(3), U::crate(1)], [1, 1, 36, 36, 48]),
    structuralEquals([Units::Metric::grams(2), Metric::grams(2), U::Metric::grams(1)], [2000, 2000, 1000])
])

/// Every spelling of one declaration agrees, and locals outrank imports.
fn resolutionOrderCase() = checkAll("resolution prefers the nearest binding", [
    structuralEquals([localWins(), catalog::Pricing::cents(1), cents(1), U::pack(U::each)], [7, 100, 100, 12]),
    catalog::Units::Metric::grams(3) == Metric::grams(3),
    Units::crate(2) == bigCrate(2)
])

exactArithmetic(fn() => print("${pack(2)} ${bigCrate(1)} ${Metric::grams(2)} ${U::each} ${cents(3)}"))

test("member imports bind selected exports", exactly(memberImportCase))
test("whole-module imports bind a module name", exactly(wholeModuleImportCase))
test("nearer declarations outrank imported ones", exactly(resolutionOrderCase))
