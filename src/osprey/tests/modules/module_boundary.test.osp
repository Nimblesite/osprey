//! Module-boundary corpus, Default flavor. This `//!` documents the FILE, not
//! the namespace declared below it, and it coexists with the `///` that
//! documents that namespace from outside ([DOC-SIGIL-INNER], spec 0026).

/// Default surface for [MODULES-MODULE] and [MODULES-EXPORTS]: a closed,
/// stateless declaration boundary whose items are private until exported, with
/// nested plain modules and module-owned constants.

namespace billing;

module Tax {
    //! Documents the module body from the inside, alongside the `///` a caller
    //! reads from the outside. Both survive to the AST.

    /// Unascribed module items are private unless marked `export`.
    let rate = 10

    /// A private helper is callable from its own module only.
    fn hundredths(cents) = intDiv((cents * rate) , 100) 

    export fn add(cents) = (cents + hundredths(cents)) 

    export fn rateUsed() = rate

    /// A nested plain module is itself a closed boundary.
    export module Rounding {
        let step = 5

        /// A private nested item stays private to the nested module.
        fn remainder(cents) = (cents % step) 

        export fn down(cents) = (cents - remainder(cents)) 
    }

    /// The parent reaches its own nested module without qualification.
    export fn addRounded(cents) = Rounding::down(add(cents))
}

module Ledger {
    /// A module reads another module's exported surface, not its privates.
    export fn withTax(cents) = Tax::add(cents)

    export fn label(cents) = "cents=${withTax(cents)}"
}

/// Exported functions compute across the private constant and helper.
fn exportedSurfaceCase() = checkAll("Tax exported surface", [
    structuralEquals([Tax::add(100), Tax::add(0), Tax::add(1)], [110, 0, 1]),
    structuralEquals([Tax::add(9), Tax::add(10), Tax::rateUsed()], [9, 11, 10])
])

/// Nested modules are addressable through their exporting parent.
fn nestedModuleCase() = checkAll("nested module boundary", [
    structuralEquals([Tax::Rounding::down(13), Tax::Rounding::down(10), Tax::Rounding::down(4)], [10, 10, 0]),
    structuralEquals([Tax::addRounded(100), Tax::addRounded(37), Tax::addRounded(9)], [110, 40, 5])
])

/// One module consuming another's exports keeps both boundaries intact.
fn crossModuleCase() = checkAll("cross-module consumption", [
    Ledger::withTax(200) == 220,
    Ledger::withTax(100) == Tax::add(100),
    structuralEquals([Ledger::label(100), Ledger::label(0)], ["cents=110", "cents=0"])
])

exactArithmetic(fn() => print("${Tax::add(100)} ${Tax::Rounding::down(13)} ${Tax::addRounded(37)} ${Ledger::label(200)}"))

exactTests([
    { name: "module exports expose only marked items", work: exportedSurfaceCase },
    { name: "nested plain modules nest their boundaries", work: nestedModuleCase },
    { name: "modules consume each other through exports", work: crossModuleCase }
])
