// Local server callback plus status-only GET, POST, PUT, and DELETE requests,
// and a slow handler that stops once its client hangs up.
// [BUILTIN-HTTP] [HTTP-SERVER] [HTTP-STATUS-CLIENT] [HTTP-SERVER-CLIENT-GONE]

print("=== Comprehensive HTTP API Test ===")

/// One JSON route response: complete, no stream, with `body` as the payload.
fn jsonResponse(status, body) = HttpResponse {
    status: status,
    headers: "Content-Type: application/json",
    contentType: "application/json",
    streamFd: (0 - 1) ,
    isComplete: true,
    partialBody: body
}

/// What the slow handler saw: how many 10 ms waits passed before its client left,
/// or -1 if the client never did.
let goneAfter = Channel(1)

/// Waits in 10 ms steps until the client of this request hangs up, for 5 s at most.
fn waitGone(waits) = match httpClientGone() {
    1 => waits
    _ => match waits {
        500 => -1
        _ => {
            sleep(10)
            waitGone(satAdd(waits, 1))
        }
    }
}

/// The slow route: reports through `goneAfter` when its client left.
fn slowRoute() = {
    send(goneAfter, waitGone(0))
    jsonResponse(200, "{\"late\": true}")
}

// Test HTTP server creation
print("Creating HTTP server on port 18080...")
let serverId = (httpCreateServer(18080, "127.0.0.1") ?: -1)
print("Server created with ID: ${serverId}")

/// Define HTTP request handler function - RESTORED TO ORIGINAL GLORY!
/// This function receives HTTP requests from the C runtime and returns HttpResponse
fn handleHttpRequest(method, path, _headers: string, _body: string) = match method {
    "GET" => match path {
        "/api/users" => jsonResponse(200, "{\"users\": [{\"id\": 1, \"name\": \"Alice\"}, {\"id\": 2, \"name\": \"Bob\"}]}")
        "/health" => jsonResponse(200, "{\"status\": \"ok\", \"timestamp\": \"2025-01-15T10:30:00Z\"}")
        "/alive" => jsonResponse(satAdd(200, httpClientGone()), "{}")
        "/slow" => slowRoute()
        _ => jsonResponse(404, "{\"error\": \"Not found\"}")
    }
    "POST" => match path {
        "/api/users" => jsonResponse(201, "{\"id\": 3, \"name\": \"New User\", \"message\": \"User created successfully\"}")
        "/api/auth/login" => jsonResponse(200, "{\"token\": \"abc123xyz\", \"expires\": \"2025-01-16T10:30:00Z\"}")
        _ => jsonResponse(404, "{\"error\": \"Not found\"}")
    }
    "PUT" => match path {
        "/api/users/1" => jsonResponse(200, "{\"id\": 1, \"name\": \"Alice Updated\", \"message\": \"User updated successfully\"}")
        _ => jsonResponse(404, "{\"error\": \"Not found\"}")
    }
    "DELETE" => match path {
        "/api/users/1" => jsonResponse(200, "{\"message\": \"User deleted successfully\"}")
        _ => jsonResponse(404, "{\"error\": \"Not found\"}")
    }
    _ => jsonResponse(405, "{\"error\": \"Method not allowed\"}")
}

// Start the server listening with our comprehensive handler
print("Starting server listener with callback handler...")
let listenResult = (httpListen(serverId, handleHttpRequest) ?: -1)
print("Server listening on http://127.0.0.1:18080")

/// Issues one `method` request for `path`, printing the request line and its
/// status line in the order the golden records them.
fn request(client, method, path, payload) = {
    print("${method} ${path}")
    let result = match method {
        "GET" => httpGet(client, path, "")
        "POST" => httpPost(client, path, payload, "Content-Type: application/json")
        "PUT" => httpPut(client, path, payload, "Content-Type: application/json")
        _ => httpDelete(client, path, "")
    }
    let status = result ?: -1
    print("${method} ${path} result: ${status}")
    status
}

// Create HTTP client to connect to OUR Osprey server
print("Creating HTTP client...")
let clientId = (httpCreateClient("http://127.0.0.1:18080", 5000) ?: -1)
print("Client created with ID: ${clientId}")

// Test HTTP methods against our REAL Osprey server
print("=== Testing HTTP Methods ===")

/// Test GET, POST, PUT and DELETE against the routes the handler serves.
let getUsersResult = request(clientId, "GET", "/api/users", "")
let getHealthResult = request(clientId, "GET", "/health", "")
let postResult = request(clientId, "POST", "/api/users", "{\"name\": \"Charlie\", \"email\": \"charlie@example.com\"}")
let loginResult = request(clientId, "POST", "/api/auth/login", "{\"username\": \"admin\", \"password\": \"secret\"}")
let putResult = request(clientId, "PUT", "/api/users/1", "{\"name\": \"Alice Smith\", \"email\": \"alice.smith@example.com\"}")
let deleteResult = request(clientId, "DELETE", "/api/users/1", "")

// A client that gives up after 300 ms: the handler notices it left, and the
// listener serves the next request.
print("=== Testing Client Gone ===")
let impatient = (httpCreateClient("http://127.0.0.1:18080", 300) ?: -1)
let slowResult = match httpGet(impatient, "/slow", "") {
    Success { value } => value
    Error => -2
}
let waited = recv(goneAfter)
print("GET /slow result: ${slowResult}, handler saw the client leave: ${waited > 0}")
let aliveResult = request(clientId, "GET", "/alive", "")

// Test non-existent endpoints
print("=== Testing Error Cases ===")
let notFoundResult = request(clientId, "GET", "/nonexistent", "")

print("=== Server Shutdown Test ===")
print("✅ All HTTP operations completed successfully")
print("🛑 Initiating immediate graceful server shutdown...")

/// Clean up server resources
let stopResult = (httpStopServer(serverId) ?: -1)
print("Server stopped with result: ${stopResult}")

print("=== HTTP API Test Complete ===")

// Verifies every routed method, the error route, and graceful shutdown.
test("local HTTP API routes every method and status", fn() => checkAll("HTTP API statuses", [
    serverId > 0,
    clientId > 0,
    httpClientGone() == 0,
    slowResult == -2,
    waited > 0,
    waited < 500,
    aliveResult == 200,
    structuralEquals([getUsersResult, getHealthResult, postResult, loginResult], [200, 200, 201, 200]),
    structuralEquals([putResult, deleteResult, notFoundResult, stopResult], [200, 200, 404, 0])
]))
