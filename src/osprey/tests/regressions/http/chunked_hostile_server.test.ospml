// ML twin of chunked_hostile_server.test.osp: a hostile origin written in Osprey.
// The handler sends back, byte for byte, the chunked framing each case asks for,
// and the client must decode it or answer Error, never crash and never hand back
// a partial body. [HTTP-CHUNKED-DECODE] [HTTP-RESPONSE-FRAMING] [HTTP-RESPONSE-HANDLE]

framingHeaders path = match path
    "/lower" => "transfer-encoding: chunked\r\n"
    "/upper" => "TRANSFER-ENCODING: CHUNKED\r\n"
    "/padded" => "Transfer-Encoding:   chunked  \r\n"
    "/gzip-chunked" => "Transfer-Encoding: gzip, chunked\r\n"
    "/x-te" => "X-Transfer-Encoding: chunked\r\n"
    "/note" => "Transfer-Encoding: gzip\r\nX-Note: chunked\r\n"
    "/chunked-gzip" => "Transfer-Encoding: chunked, gzip\r\n"
    "/notchunked" => "Transfer-Encoding: notchunked\r\n"
    "/trailing-comma" => "Transfer-Encoding: chunked, \r\n"
    "/empty-line-after" => "Transfer-Encoding: chunked\r\nTransfer-Encoding: ,\r\n"
    "/gzip-length" => "Transfer-Encoding: gzip\r\nContent-Length: 1\r\n"
    "/plain" => ""
    "/404-plain" => ""
    "/four-digits" => ""
    "/two-digits" => ""
    "/negative" => ""
    "/two-lines" => "Transfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n"
    "/two-apart" => "Transfer-Encoding: gzip\r\nX-Between: 1\r\ntransfer-encoding: CHUNKED\r\n"
    "/chunked-then-gzip" => "Transfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\n"
    "/bare-lf" => "X-A: a\nTransfer-Encoding: chunked\r\n"
    "/bare-cr" => "X-A: a\rb\r\n"
    "/spaced-name" => "Transfer-Encoding : chunked\r\n"
    "/folded" => "Transfer-Encoding: gzip,\r\n chunked\r\n"
    "/no-colon" => "no colon here\r\n"
    "/no-name" => ": no name\r\n"
    "/length-lie" => "Content-Length: 100\r\n"
    "/length-junk" => "Content-Length: x\r\n"
    "/length-negative" => "Content-Length: -1\r\n"
    _ => "Transfer-Encoding: chunked\r\n"

statusFor path = match path
    "/204" => 204
    "/304" => 304
    "/500" => 500
    "/four-digits" => 2000
    "/two-digits" => 20
    "/negative" => (0 - 14)
    "/404-plain" => 404
    _ => 200

doubled (text, times) = match times
    0 => text
    _ => doubled ("${text}${text}", wrapSub times 1)

sixteenKib () = doubled ("x", 14)

framingFor (path, requested) = match path
    "/get-oversized" => "7FFFFFFF\r\nhi\r\n0\r\n\r\n"
    "/get-valid" => "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    "/big" => "4000\r\n${sixteenKib ()}\r\n0\r\n\r\n"
    "/big-then-lie" => "4000\r\n${sixteenKib ()}\r\n7FFFFFFF\r\nhi\r\n"
    _ => requested

hostileOrigin (_method, path, _headers, requested) = HttpResponse(
    status = statusFor path,
    headers = framingHeaders path,
    contentType = "text/plain",
    streamFd = (0 - 1),
    isComplete = true,
    partialBody = framingFor (path, requested)
)

released (responseId, outcome) = match httpResponseFree responseId
    Success _value => outcome
    Error message => "free-failed=${message}"

bodyOf responseId = match httpResponseBody responseId
    Success value => released (responseId, "status=${httpResponseStatus responseId} body=${value}")
    Error message => released (responseId, "body-failed=${message}")

outcomeOf response = match response
    Success value => bodyOf value
    Error message => "error=${message}"

posted (client, path, framing) = outcomeOf (httpPostResponse client path framing "")

fetched (client, path) = outcomeOf (httpGetResponse client path "")

withHostileOrigin (port, scenario) =
    server = httpCreateServer port "127.0.0.1" ?: -1
    _listening = httpListen server hostileOrigin ?: -1
    client = httpCreateClient "http://127.0.0.1:${port}" 5000 ?: -1
    _ran = scenario client
    _closed = httpCloseClient client ?: -1
    _stopped = httpStopServer server ?: -1
    "done"

accepts (client, framing, body) =
    check "accepts ${framing}" "status=200 body=${body}" (posted (client, "/chunked", framing))

refuses (client, framing, reason) =
    check "refuses ${framing}" "error=http response: chunked body: ${reason}" (posted (client, "/chunked", framing))

tooBig (client, framing) = refuses (client, framing, "chunk size exceeds the remaining body")

badSize (client, framing) = refuses (client, framing, "invalid chunk size")

noCrlf (client, framing) = refuses (client, framing, "chunk data not followed by CRLF")

truncated (client, framing) = refuses (client, framing, "truncated")

sizesBeyondTheBody client =
    forEachList [
        "10\r\nhi\r\n0\r\n\r\n", "3\r\nhi", "6\r\nhello",
        "5\r\nhel", "1\r\n", "400\r\nhi\r\n0\r\n\r\n",
        "10000\r\nhi\r\n0\r\n\r\n", "7FFFFFFF\r\nhi\r\n0\r\n\r\n", "7fffffff\r\nhi\r\n0\r\n\r\n",
        "80000000\r\nhi\r\n0\r\n\r\n", "FFFFFFFF\r\nhi\r\n0\r\n\r\n", "100000000\r\nhi\r\n0\r\n\r\n",
        "7FFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n", "8000000000000000\r\nhi\r\n0\r\n\r\n", "FFFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n",
        "3\r\nabc\r\n100\r\nhi\r\n0\r\n\r\n", "3\r\nabc\r\n7FFFFFFF\r\nhi\r\n0\r\n\r\n", "1;ext=1\r\n",
        "FFFFFFFF;ext=1\r\nhi\r\n0\r\n\r\n"
    ] (\framing => tooBig (client, framing))

sizesThatAreNotSizes client =
    forEachList [
        "10000000000000000\r\n\r\n", "10000000000000005\r\nhello\r\n0\r\n\r\n", "FFFFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n",
        "-1\r\nhi\r\n0\r\n\r\n", "-5\r\nhello\r\n0\r\n\r\n", "-0\r\n\r\n",
        "-7FFFFFFF\r\nhi\r\n0\r\n\r\n", "+5\r\nhello\r\n0\r\n\r\n", "0x5\r\nhello\r\n0\r\n\r\n",
        " 5\r\nhello\r\n0\r\n\r\n", "\t5\r\nhello\r\n0\r\n\r\n", "zz\r\nhello\r\n0\r\n\r\n",
        "5z\r\nhello\r\n0\r\n\r\n", "5 z\r\nhello\r\n0\r\n\r\n", "5,3\r\nhello\r\n0\r\n\r\n",
        "g\r\n", "\r\n", "\r\n0\r\n\r\n",
        ";ext\r\nhi\r\n0\r\n\r\n", "5\nhello\n0\n\n", "0\n\n",
        "3\r\nabc\r\nzz\r\n", "3\r\nabc\r\n-1\r\nhi\r\n", "5\r\nhello\r\n\r\n",
        "5;a\nb\r\nhello\r\n0\r\n\r\n", "5;a\rb\r\nhello\r\n0\r\n\r\n", "5;\n\r\nhello\r\n0\r\n\r\n",
        "0;a\nb\r\n\r\n"
    ] (\framing => badSize (client, framing))

dataWithoutItsCrlf client =
    forEachList [
        "5\r\nhelloXX0\r\n\r\n", "5\r\nhello0\r\n\r\n", "5\r\nhello\n0\r\n\r\n",
        "5\r\nhello\rX0\r\n\r\n", "5\r\nhello\n\r0\r\n\r\n", "4\r\nhello\r\n0\r\n\r\n",
        "6\r\nhello\r\n0\r\n\r\n", "3\r\nabc\r\n2\r\nhiXX0\r\n\r\n"
    ] (\framing => noCrlf (client, framing))

framingCutShort client =
    forEachList [
        "", "5", "5\r",
        "5 ", "5;ext", "5\r\nhello",
        "5\r\nhello\r", "5\r\nhello\r\n", "5\r\nhello\r\n0",
        "5\r\nhello\r\n0\r", "5\r\nhello\r\n0\r\n", "5\r\nhello\r\n0\r\n\r",
        "0", "0\r\n", "0\r\nX-Trailer: yes",
        "0\r\nX-Trailer: yes\r\n", "0\r\nX-One: 1\r\nX-Two: 2\r\n"
    ] (\framing => truncated (client, framing))

(** Every well-formed framing paired with the body it must decode to. *)
wellFormedBodies client =
    forEachList [
        { framing = "0\r\n\r\n", body = "" },
        { framing = "00000\r\n\r\n", body = "" },
        { framing = "5\r\nhello\r\n0\r\n\r\n", body = "hello" },
        { framing = "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n", body = "hello world" },
        { framing = "1\r\na\r\n1\r\nb\r\n1\r\nc\r\n1\r\nd\r\n0\r\n\r\n", body = "abcd" },
        { framing = "a\r\n0123456789\r\n0\r\n\r\n", body = "0123456789" },
        { framing = "A\r\n0123456789\r\n0\r\n\r\n", body = "0123456789" },
        { framing = "0005\r\nhello\r\n000\r\n\r\n", body = "hello" },
        { framing = "00000000000000000000005\r\nhello\r\n0\r\n\r\n", body = "hello" },
        { framing = "5;name=value\r\nhello\r\n0;last\r\n\r\n", body = "hello" },
        { framing = "5 ;name\r\nhello\r\n0\t;last\r\n\r\n", body = "hello" },
        { framing = "5  \r\nhello\r\n0 \r\n\r\n", body = "hello" },
        { framing = "5;a\tb\r\nhello\r\n0\r\n\r\n", body = "hello" },
        { framing = "3\r\nabc\r\n0\r\nX-Trailer: yes\r\n\r\n", body = "abc" },
        { framing = "3\r\nabc\r\n0\r\nX-One: 1\r\nX-Two: 2\r\n\r\n", body = "abc" },
        { framing = "8\r\na\r\n0\r\n\r\n\r\n0\r\n\r\n", body = "a\r\n0\r\n\r\n" },
        { framing = "2\r\n\r\n\r\n0\r\n\r\n", body = "\r\n" },
        { framing = "2\r\né\r\n0\r\n\r\n", body = "é" },
        { framing = "3\r\nabc\r\n0\r\n\r\nleft over", body = "abc" }
    ] (\row => accepts (client, row.framing, row.body))

(** Checks each listed path answers `want` when posted the same `framing`. *)
headerEcho (client, framing, want, rows) =
    forEachList (rows, \row => check row.label want (posted (client, row.path, framing)))

whichResponsesAreChunked client =
    framing = "2\r\nhi\r\n0\r\n\r\n"
    hostile = "7FFFFFFF\r\nhi\r\n0\r\n\r\n"
    headerEcho (client, framing, "status=200 body=hi", [
        { label = "lower-case header", path = "/lower" },
        { label = "upper-case header", path = "/upper" },
        { label = "padded value", path = "/padded" },
        { label = "chunked last", path = "/gzip-chunked" },
        { label = "trailing comma", path = "/trailing-comma" },
        { label = "empty line after", path = "/empty-line-after" }
    ])
    headerEcho (client, hostile, "status=200 body=${hostile}", [
        { label = "coding beats length", path = "/gzip-length" },
        { label = "named header only", path = "/x-te" },
        { label = "another header's value", path = "/note" },
        { label = "chunked not last", path = "/chunked-gzip" },
        { label = "a longer word", path = "/notchunked" },
        { label = "no header", path = "/plain" }
    ])

hostileThenValid client =
    _refused = posted (client, "/chunked", "FFFFFFFF\r\nhi\r\n0\r\n\r\n")
    posted (client, "/chunked", "2\r\nok\r\n0\r\n\r\n")

getAndPostAgree client =
    check "GET hostile" "error=http response: chunked body: chunk size exceeds the remaining body" (fetched (client, "/get-oversized"))
    check "GET valid" "status=200 body=hello world" (fetched (client, "/get-valid"))
    check "POST hostile then valid" "status=200 body=ok" (hostileThenValid client)

hammer (client, remaining) = match remaining
    0 => "status=200 body=survived"
    _ => match posted (client, "/chunked", "7FFFFFFF\r\nhi\r\n0\r\n\r\n")
        "error=http response: chunked body: chunk size exceeds the remaining body" => hammer (client, wrapSub remaining 1)
        other => other

survivesRepeatedAttacks client =
    check "200 attacks in a row" "status=200 body=survived" (hammer (client, 200))
    check "still serving" "status=200 body=alive" (posted (client, "/chunked", "5\r\nalive\r\n0\r\n\r\n"))

statusesWithoutABody client =
    lie = "7FFFFFFF\r\nhi\r\n"
    check "304, nothing sent" "status=304 body=" (fetched (client, "/304"))
    check "204, nothing sent" "status=204 body=" (fetched (client, "/204"))
    check "304, a lie sent" "status=304 body=" (posted (client, "/304", lie))
    check "204, a lie sent" "status=204 body=" (posted (client, "/204", lie))
    check "204, a body sent" "status=204 body=" (posted (client, "/204", "2\r\nhi\r\n0\r\n\r\n"))
    check "500 keeps its body" "status=500 body=no" (posted (client, "/500", "2\r\nno\r\n0\r\n\r\n"))
    check "500 with a lie" "error=http response: chunked body: chunk size exceeds the remaining body" (posted (client, "/500", lie))
    check "200 needs its framing" "error=http response: chunked body: truncated" (fetched (client, "/empty"))

repeatedHeaderLines client =
    framing = "2\r\nhi\r\n0\r\n\r\n"
    hostile = "7FFFFFFF\r\nhi\r\n"
    check "two lines decode" "status=200 body=hi" (posted (client, "/two-lines", framing))
    check "two lines apart decode" "status=200 body=hi" (posted (client, "/two-apart", framing))
    check "two lines still refuse" "error=http response: chunked body: chunk size exceeds the remaining body" (posted (client, "/two-lines", hostile))
    check "gzip last means raw" "status=200 body=${hostile}" (posted (client, "/chunked-then-gzip", hostile))

bodiesPastTheBuffer client =
    check "16 KiB decodes" "status=200 body=${sixteenKib ()}" (fetched (client, "/big"))
    check "a lie after 16 KiB" "error=http response: chunked body: chunk size exceeds the remaining body" (fetched (client, "/big-then-lie"))

(** Checks each listed path, posted its own framing, is refused for a malformed head line. *)
malformedHead (client, rows) =
    forEachList (rows, \row => check row.label "error=http response: head: malformed" (posted (client, row.path, row.framing)))

headsThatHideFraming client =
    hostile = "7FFFFFFF\r\nhi\r\n"
    malformedHead (client, [
        { label = "bare LF in a value", path = "/bare-lf", framing = hostile },
        { label = "bare CR in a value", path = "/bare-cr", framing = "hello" },
        { label = "space before the colon", path = "/spaced-name", framing = hostile },
        { label = "a folded line", path = "/folded", framing = "2\r\nhi\r\n0\r\n\r\n" },
        { label = "a line with no colon", path = "/no-colon", framing = "hello" },
        { label = "a line with no name", path = "/no-name", framing = "hello" }
    ])
    check "still serving" "status=200 body=alive" (posted (client, "/chunked", "5\r\nalive\r\n0\r\n\r\n"))

(** Checks every listed path is refused with the same fixed `expected` text. *)
refusesPath (client, expected, request, rows) =
    forEachList (rows, \row => check row.label expected (request row.path))

statusesThatAreNotStatuses client =
    refusesPath (client, "error=http response: status line: not HTTP/1.x", \path => fetched (client, path), [
        { label = "four digits", path = "/four-digits" },
        { label = "two digits", path = "/two-digits" },
        { label = "our own negative code", path = "/negative" }
    ])
    check "a real 404" "status=404 body=gone" (posted (client, "/404-plain", "gone"))

lengthsThatLie client =
    refusesPath (client, "error=http response: body: invalid Content-Length", \path => posted (client, path, "hello"), [
        { label = "a second, different length", path = "/length-lie" },
        { label = "a length that isn't one", path = "/length-junk" },
        { label = "a negative length", path = "/length-negative" }
    ])
    check "chunked ignores a lie" "status=200 body=hi" (posted (client, "/two-lines", "2\r\nhi\r\n0\r\n\r\n"))

sizesCase () = withHostileOrigin (18110, sizesBeyondTheBody)
parseCase () = withHostileOrigin (18111, sizesThatAreNotSizes)
crlfCase () = withHostileOrigin (18112, dataWithoutItsCrlf)
cutCase () = withHostileOrigin (18113, framingCutShort)
validCase () = withHostileOrigin (18114, wellFormedBodies)
headerCase () = withHostileOrigin (18115, whichResponsesAreChunked)
methodCase () = withHostileOrigin (18116, getAndPostAgree)
repeatCase () = withHostileOrigin (18117, survivesRepeatedAttacks)
statusCase () = withHostileOrigin (18118, statusesWithoutABody)
linesCase () = withHostileOrigin (18119, repeatedHeaderLines)
bigCase () = withHostileOrigin (18120, bodiesPastTheBuffer)
headCase () = withHostileOrigin (18121, headsThatHideFraming)
statusLineCase () = withHostileOrigin (18122, statusesThatAreNotStatuses)
lengthCase () = withHostileOrigin (18123, lengthsThatLie)

test "chunk sizes beyond the body are refused" sizesCase
test "chunk sizes that do not parse are refused" parseCase
test "chunk data without its CRLF is refused" crlfCase
test "truncated framing is refused" cutCase
test "well-formed framing decodes" validCase
test "only a final chunked coding means chunked" headerCase
test "GET and POST share the decoder" methodCase
test "repeated attacks leave the client working" repeatCase
test "204 and 304 have no body" statusCase
test "repeated Transfer-Encoding lines are one list" linesCase
test "bodies past the transport buffer decode" bigCase
test "heads that hide framing are refused" headCase
test "statuses are three digits" statusLineCase
test "lengths that lie are refused" lengthCase
