// A hostile origin written in Osprey: the handler sends back, byte for byte, the
// chunked framing each case asks for, and the client must decode it or answer
// Error, never crash and never hand back a partial body. [HTTP-CHUNKED-DECODE]
// [HTTP-RESPONSE-FRAMING] [HTTP-RESPONSE-HANDLE]

fn framingHeaders(path) = match path {
    "/lower" => "transfer-encoding: chunked\r\n"
    "/upper" => "TRANSFER-ENCODING: CHUNKED\r\n"
    "/padded" => "Transfer-Encoding:   chunked  \r\n"
    "/gzip-chunked" => "Transfer-Encoding: gzip, chunked\r\n"
    "/x-te" => "X-Transfer-Encoding: chunked\r\n"
    "/note" => "Transfer-Encoding: gzip\r\nX-Note: chunked\r\n"
    "/chunked-gzip" => "Transfer-Encoding: chunked, gzip\r\n"
    "/notchunked" => "Transfer-Encoding: notchunked\r\n"
    "/trailing-comma" => "Transfer-Encoding: chunked, \r\n"
    "/empty-line-after" => "Transfer-Encoding: chunked\r\nTransfer-Encoding: ,\r\n"
    "/gzip-length" => "Transfer-Encoding: gzip\r\nContent-Length: 1\r\n"
    "/plain" => ""
    "/404-plain" => ""
    "/four-digits" => ""
    "/two-digits" => ""
    "/negative" => ""
    "/two-lines" => "Transfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n"
    "/two-apart" => "Transfer-Encoding: gzip\r\nX-Between: 1\r\ntransfer-encoding: CHUNKED\r\n"
    "/chunked-then-gzip" => "Transfer-Encoding: chunked\r\nTransfer-Encoding: gzip\r\n"
    "/bare-lf" => "X-A: a\nTransfer-Encoding: chunked\r\n"
    "/bare-cr" => "X-A: a\rb\r\n"
    "/spaced-name" => "Transfer-Encoding : chunked\r\n"
    "/folded" => "Transfer-Encoding: gzip,\r\n chunked\r\n"
    "/no-colon" => "no colon here\r\n"
    "/no-name" => ": no name\r\n"
    "/length-lie" => "Content-Length: 100\r\n"
    "/length-junk" => "Content-Length: x\r\n"
    "/length-negative" => "Content-Length: -1\r\n"
    _ => "Transfer-Encoding: chunked\r\n"
}

fn statusFor(path) = match path {
    "/204" => 204
    "/304" => 304
    "/500" => 500
    "/four-digits" => 2000
    "/two-digits" => 20
    "/negative" => (0 - 14)
    "/404-plain" => 404
    _ => 200
}

fn doubled(text, times) = match times {
    0 => text
    _ => doubled("${text}${text}", wrapSub(times, 1))
}

fn sixteenKib() = doubled("x", 14)

fn framingFor(path, requested) = match path {
    "/get-oversized" => "7FFFFFFF\r\nhi\r\n0\r\n\r\n"
    "/get-valid" => "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"
    "/big" => "4000\r\n${sixteenKib()}\r\n0\r\n\r\n"
    "/big-then-lie" => "4000\r\n${sixteenKib()}\r\n7FFFFFFF\r\nhi\r\n"
    _ => requested
}

fn hostileOrigin(_method, path, _headers, requested) = HttpResponse {
    status: statusFor(path),
    headers: framingHeaders(path),
    contentType: "text/plain",
    streamFd: (0 - 1),
    isComplete: true,
    partialBody: framingFor(path, requested)
}

fn released(responseId, outcome) = match httpResponseFree(responseId) {
    Success => outcome
    Error { message } => "free-failed=${message}"
}

fn bodyOf(responseId) = match httpResponseBody(responseId) {
    Success { value } => released(responseId, "status=${httpResponseStatus(responseId)} body=${value}")
    Error { message } => released(responseId, "body-failed=${message}")
}

fn outcomeOf(response) = match response {
    Success { value } => bodyOf(value)
    Error { message } => "error=${message}"
}

fn posted(client, path, framing) = outcomeOf(httpPostResponse(client, path, framing, ""))

fn fetched(client, path) = outcomeOf(httpGetResponse(client, path, ""))

fn withHostileOrigin(port, scenario) = {
    let server = (httpCreateServer(port, "127.0.0.1") ?: -1)
    let _listening = (httpListen(server, hostileOrigin) ?: -1)
    let client = (httpCreateClient("http://127.0.0.1:${port}", 5000) ?: -1)
    let _ran = scenario(client)
    let _closed = (httpCloseClient(client) ?: -1)
    let _stopped = (httpStopServer(server) ?: -1)
    "done"
}

fn checkEach(cases) = forEachList(cases, fn(c) => check(c.name, c.expected, c.actual))

fn probes(client, verb, verdict, framing) = check("${verb} ${framing}", verdict, posted(client, "/chunked", framing))

fn accepts(client, framing, body) = probes(client, "accepts", "status=200 body=${body}", framing)

fn refuses(client, framing, reason) = probes(client, "refuses", "error=http response: chunked body: ${reason}", framing)

fn refused(client, reason, framings) = forEachList(framings, fn(framing) => refuses(client, framing, reason))

fn chunkTooBig() = "error=http response: chunked body: chunk size exceeds the remaining body"

fn sizesBeyondTheBody(client) = refused(client, "chunk size exceeds the remaining body", [
    "10\r\nhi\r\n0\r\n\r\n", "3\r\nhi", "6\r\nhello",
    "5\r\nhel", "1\r\n", "400\r\nhi\r\n0\r\n\r\n",
    "10000\r\nhi\r\n0\r\n\r\n", "7FFFFFFF\r\nhi\r\n0\r\n\r\n", "7fffffff\r\nhi\r\n0\r\n\r\n",
    "80000000\r\nhi\r\n0\r\n\r\n", "FFFFFFFF\r\nhi\r\n0\r\n\r\n", "100000000\r\nhi\r\n0\r\n\r\n",
    "7FFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n", "8000000000000000\r\nhi\r\n0\r\n\r\n", "FFFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n",
    "3\r\nabc\r\n100\r\nhi\r\n0\r\n\r\n", "3\r\nabc\r\n7FFFFFFF\r\nhi\r\n0\r\n\r\n", "1;ext=1\r\n",
    "FFFFFFFF;ext=1\r\nhi\r\n0\r\n\r\n"
])

fn sizesThatAreNotSizes(client) = refused(client, "invalid chunk size", [
    "10000000000000000\r\n\r\n", "10000000000000005\r\nhello\r\n0\r\n\r\n", "FFFFFFFFFFFFFFFFF\r\nhi\r\n0\r\n\r\n",
    "-1\r\nhi\r\n0\r\n\r\n", "-5\r\nhello\r\n0\r\n\r\n", "-0\r\n\r\n",
    "-7FFFFFFF\r\nhi\r\n0\r\n\r\n", "+5\r\nhello\r\n0\r\n\r\n", "0x5\r\nhello\r\n0\r\n\r\n",
    " 5\r\nhello\r\n0\r\n\r\n", "\t5\r\nhello\r\n0\r\n\r\n", "zz\r\nhello\r\n0\r\n\r\n",
    "5z\r\nhello\r\n0\r\n\r\n", "5 z\r\nhello\r\n0\r\n\r\n", "5,3\r\nhello\r\n0\r\n\r\n",
    "g\r\n", "\r\n", "\r\n0\r\n\r\n",
    ";ext\r\nhi\r\n0\r\n\r\n", "5\nhello\n0\n\n", "0\n\n",
    "3\r\nabc\r\nzz\r\n", "3\r\nabc\r\n-1\r\nhi\r\n", "5\r\nhello\r\n\r\n",
    "5;a\nb\r\nhello\r\n0\r\n\r\n", "5;a\rb\r\nhello\r\n0\r\n\r\n", "5;\n\r\nhello\r\n0\r\n\r\n",
    "0;a\nb\r\n\r\n"
])

fn dataWithoutItsCrlf(client) = refused(client, "chunk data not followed by CRLF", [
    "5\r\nhelloXX0\r\n\r\n", "5\r\nhello0\r\n\r\n", "5\r\nhello\n0\r\n\r\n",
    "5\r\nhello\rX0\r\n\r\n", "5\r\nhello\n\r0\r\n\r\n", "4\r\nhello\r\n0\r\n\r\n",
    "6\r\nhello\r\n0\r\n\r\n", "3\r\nabc\r\n2\r\nhiXX0\r\n\r\n"
])

fn framingCutShort(client) = refused(client, "truncated", [
    "", "5", "5\r",
    "5 ", "5;ext", "5\r\nhello",
    "5\r\nhello\r", "5\r\nhello\r\n", "5\r\nhello\r\n0",
    "5\r\nhello\r\n0\r", "5\r\nhello\r\n0\r\n", "5\r\nhello\r\n0\r\n\r",
    "0", "0\r\n", "0\r\nX-Trailer: yes",
    "0\r\nX-Trailer: yes\r\n", "0\r\nX-One: 1\r\nX-Two: 2\r\n"
])

fn wellFormedBodies(client) = forEachList([
    { framing: "0\r\n\r\n", body: "" }, { framing: "00000\r\n\r\n", body: "" },
    { framing: "5\r\nhello\r\n0\r\n\r\n", body: "hello" }, { framing: "5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n", body: "hello world" },
    { framing: "1\r\na\r\n1\r\nb\r\n1\r\nc\r\n1\r\nd\r\n0\r\n\r\n", body: "abcd" }, { framing: "a\r\n0123456789\r\n0\r\n\r\n", body: "0123456789" },
    { framing: "A\r\n0123456789\r\n0\r\n\r\n", body: "0123456789" }, { framing: "0005\r\nhello\r\n000\r\n\r\n", body: "hello" },
    { framing: "00000000000000000000005\r\nhello\r\n0\r\n\r\n", body: "hello" }, { framing: "5;name=value\r\nhello\r\n0;last\r\n\r\n", body: "hello" },
    { framing: "5 ;name\r\nhello\r\n0\t;last\r\n\r\n", body: "hello" }, { framing: "5  \r\nhello\r\n0 \r\n\r\n", body: "hello" },
    { framing: "5;a\tb\r\nhello\r\n0\r\n\r\n", body: "hello" }, { framing: "3\r\nabc\r\n0\r\nX-Trailer: yes\r\n\r\n", body: "abc" },
    { framing: "3\r\nabc\r\n0\r\nX-One: 1\r\nX-Two: 2\r\n\r\n", body: "abc" }, { framing: "8\r\na\r\n0\r\n\r\n\r\n0\r\n\r\n", body: "a\r\n0\r\n\r\n" },
    { framing: "2\r\n\r\n\r\n0\r\n\r\n", body: "\r\n" }, { framing: "2\r\né\r\n0\r\n\r\n", body: "é" },
    { framing: "3\r\nabc\r\n0\r\n\r\nleft over", body: "abc" }
], fn(c) => accepts(client, c.framing, c.body))

fn whichResponsesAreChunked(client) = {
    let framing = "2\r\nhi\r\n0\r\n\r\n"
    let hostile = "7FFFFFFF\r\nhi\r\n0\r\n\r\n"
    checkEach([
        { name: "lower-case header", expected: "status=200 body=hi", actual: posted(client, "/lower", framing) }, { name: "upper-case header", expected: "status=200 body=hi", actual: posted(client, "/upper", framing) },
        { name: "padded value", expected: "status=200 body=hi", actual: posted(client, "/padded", framing) }, { name: "chunked last", expected: "status=200 body=hi", actual: posted(client, "/gzip-chunked", framing) },
        { name: "trailing comma", expected: "status=200 body=hi", actual: posted(client, "/trailing-comma", framing) }, { name: "empty line after", expected: "status=200 body=hi", actual: posted(client, "/empty-line-after", framing) },
        { name: "coding beats length", expected: "status=200 body=${hostile}", actual: posted(client, "/gzip-length", hostile) }, { name: "named header only", expected: "status=200 body=${hostile}", actual: posted(client, "/x-te", hostile) },
        { name: "another header's value", expected: "status=200 body=${hostile}", actual: posted(client, "/note", hostile) }, { name: "chunked not last", expected: "status=200 body=${hostile}", actual: posted(client, "/chunked-gzip", hostile) },
        { name: "a longer word", expected: "status=200 body=${hostile}", actual: posted(client, "/notchunked", hostile) }, { name: "no header", expected: "status=200 body=${hostile}", actual: posted(client, "/plain", hostile) }
    ])
}

fn hostileThenValid(client) = {
    let _refused = posted(client, "/chunked", "FFFFFFFF\r\nhi\r\n0\r\n\r\n")
    posted(client, "/chunked", "2\r\nok\r\n0\r\n\r\n")
}

fn getAndPostAgree(client) = checkEach([
    { name: "GET hostile", expected: chunkTooBig(), actual: fetched(client, "/get-oversized") }, { name: "GET valid", expected: "status=200 body=hello world", actual: fetched(client, "/get-valid") },
    { name: "POST hostile then valid", expected: "status=200 body=ok", actual: hostileThenValid(client) }
])

fn hammer(client, remaining) = match remaining {
    0 => "status=200 body=survived"
    _ => match posted(client, "/chunked", "7FFFFFFF\r\nhi\r\n0\r\n\r\n") {
        "error=http response: chunked body: chunk size exceeds the remaining body" => hammer(client, wrapSub(remaining, 1))
        other => other
    }
}

fn survivesRepeatedAttacks(client) = {
    check("200 attacks in a row", "status=200 body=survived", hammer(client, 200))
    check("still serving", "status=200 body=alive", posted(client, "/chunked", "5\r\nalive\r\n0\r\n\r\n"))
}

fn statusesWithoutABody(client) = {
    let lie = "7FFFFFFF\r\nhi\r\n"
    checkEach([
        { name: "304, nothing sent", expected: "status=304 body=", actual: fetched(client, "/304") }, { name: "204, nothing sent", expected: "status=204 body=", actual: fetched(client, "/204") },
        { name: "304, a lie sent", expected: "status=304 body=", actual: posted(client, "/304", lie) }, { name: "204, a lie sent", expected: "status=204 body=", actual: posted(client, "/204", lie) },
        { name: "204, a body sent", expected: "status=204 body=", actual: posted(client, "/204", "2\r\nhi\r\n0\r\n\r\n") }, { name: "500 keeps its body", expected: "status=500 body=no", actual: posted(client, "/500", "2\r\nno\r\n0\r\n\r\n") },
        { name: "500 with a lie", expected: chunkTooBig(), actual: posted(client, "/500", lie) }, { name: "200 needs its framing", expected: "error=http response: chunked body: truncated", actual: fetched(client, "/empty") }
    ])
}

fn repeatedHeaderLines(client) = {
    let framing = "2\r\nhi\r\n0\r\n\r\n"
    let hostile = "7FFFFFFF\r\nhi\r\n"
    checkEach([
        { name: "two lines decode", expected: "status=200 body=hi", actual: posted(client, "/two-lines", framing) }, { name: "two lines apart decode", expected: "status=200 body=hi", actual: posted(client, "/two-apart", framing) },
        { name: "two lines still refuse", expected: chunkTooBig(), actual: posted(client, "/two-lines", hostile) }, { name: "gzip last means raw", expected: "status=200 body=${hostile}", actual: posted(client, "/chunked-then-gzip", hostile) }
    ])
}

fn bodiesPastTheBuffer(client) = {
    check("16 KiB decodes", "status=200 body=${sixteenKib()}", fetched(client, "/big"))
    check("a lie after 16 KiB", chunkTooBig(), fetched(client, "/big-then-lie"))
}

fn headsThatHideFraming(client) = {
    let malformed = "error=http response: head: malformed"
    let hostile = "7FFFFFFF\r\nhi\r\n"
    checkEach([
        { name: "bare LF in a value", expected: malformed, actual: posted(client, "/bare-lf", hostile) }, { name: "bare CR in a value", expected: malformed, actual: posted(client, "/bare-cr", "hello") },
        { name: "space before the colon", expected: malformed, actual: posted(client, "/spaced-name", hostile) }, { name: "a folded line", expected: malformed, actual: posted(client, "/folded", "2\r\nhi\r\n0\r\n\r\n") },
        { name: "a line with no colon", expected: malformed, actual: posted(client, "/no-colon", "hello") }, { name: "a line with no name", expected: malformed, actual: posted(client, "/no-name", "hello") },
        { name: "still serving", expected: "status=200 body=alive", actual: posted(client, "/chunked", "5\r\nalive\r\n0\r\n\r\n") }
    ])
}

fn statusesThatAreNotStatuses(client) = {
    let notHttp = "error=http response: status line: not HTTP/1.x"
    checkEach([
        { name: "four digits", expected: notHttp, actual: fetched(client, "/four-digits") }, { name: "two digits", expected: notHttp, actual: fetched(client, "/two-digits") },
        { name: "our own negative code", expected: notHttp, actual: fetched(client, "/negative") }, { name: "a real 404", expected: "status=404 body=gone", actual: posted(client, "/404-plain", "gone") }
    ])
}

fn lengthsThatLie(client) = {
    let invalid = "error=http response: body: invalid Content-Length"
    checkEach([
        { name: "a second, different length", expected: invalid, actual: posted(client, "/length-lie", "hello") }, { name: "a length that isn't one", expected: invalid, actual: posted(client, "/length-junk", "hello") },
        { name: "a negative length", expected: invalid, actual: posted(client, "/length-negative", "hello") }, { name: "chunked ignores a lie", expected: "status=200 body=hi", actual: posted(client, "/two-lines", "2\r\nhi\r\n0\r\n\r\n") }
    ])
}

fn originCase(port, work) = fn() => withHostileOrigin(port, work)

testCases([
    { name: "chunk sizes beyond the body are refused", work: originCase(18110, sizesBeyondTheBody) },
    { name: "chunk sizes that do not parse are refused", work: originCase(18111, sizesThatAreNotSizes) },
    { name: "chunk data without its CRLF is refused", work: originCase(18112, dataWithoutItsCrlf) },
    { name: "truncated framing is refused", work: originCase(18113, framingCutShort) },
    { name: "well-formed framing decodes", work: originCase(18114, wellFormedBodies) },
    { name: "only a final chunked coding means chunked", work: originCase(18115, whichResponsesAreChunked) },
    { name: "GET and POST share the decoder", work: originCase(18116, getAndPostAgree) },
    { name: "repeated attacks leave the client working", work: originCase(18117, survivesRepeatedAttacks) },
    { name: "204 and 304 have no body", work: originCase(18118, statusesWithoutABody) },
    { name: "repeated Transfer-Encoding lines are one list", work: originCase(18119, repeatedHeaderLines) },
    { name: "bodies past the transport buffer decode", work: originCase(18120, bodiesPastTheBuffer) },
    { name: "heads that hide framing are refused", work: originCase(18121, headsThatHideFraming) },
    { name: "statuses are three digits", work: originCase(18122, statusesThatAreNotStatuses) },
    { name: "lengths that lie are refused", work: originCase(18123, lengthsThatLie) }
])
