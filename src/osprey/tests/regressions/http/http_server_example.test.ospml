// [BUILTIN-HTTP] [HTTP-SERVER] [HTTP-STATUS-CLIENT]
// ML twin of http_server_example.osp. Top-level statements are the program body;
// the HTTP builtins are ordinary calls. The handler's `-> HttpResponse` return is
// load-bearing (mirrored by an ML signature); its body is a layout `match` over
// `method`, each arm a nested layout `match` over `path` whose arms are inline record
// literals `HttpResponse(status = …, …)` (Default `HttpResponse { status: … }`).

(** One JSON route response: complete, no stream, with `body` as the payload. *)
jsonResponse (status, body) = HttpResponse(
    status = status,
    headers = "Content-Type: application/json",
    contentType = "application/json",
    streamFd = (0 - 1) ,
    isComplete = true,
    partialBody = body
)

print "=== Comprehensive HTTP API Test ==="

print "Creating HTTP server on port 18080..."
serverId = httpCreateServer 18080 "127.0.0.1" ?: -1
print "Server created with ID: ${serverId}"

handleHttpRequest : (string, string, string, string) -> HttpResponse
handleHttpRequest (method, path, _headers, _body) =
    match method
        "GET" =>
            match path
                "/api/users" => jsonResponse (200, "{\"users\": [{\"id\": 1, \"name\": \"Alice\"}, {\"id\": 2, \"name\": \"Bob\"}]}")
                "/health" => jsonResponse (200, "{\"status\": \"ok\", \"timestamp\": \"2025-01-15T10:30:00Z\"}")
                _ => jsonResponse (404, "{\"error\": \"Not found\"}")
        "POST" =>
            match path
                "/api/users" => jsonResponse (201, "{\"id\": 3, \"name\": \"New User\", \"message\": \"User created successfully\"}")
                "/api/auth/login" => jsonResponse (200, "{\"token\": \"abc123xyz\", \"expires\": \"2025-01-16T10:30:00Z\"}")
                _ => jsonResponse (404, "{\"error\": \"Not found\"}")
        "PUT" =>
            match path
                "/api/users/1" => jsonResponse (200, "{\"id\": 1, \"name\": \"Alice Updated\", \"message\": \"User updated successfully\"}")
                _ => jsonResponse (404, "{\"error\": \"Not found\"}")
        "DELETE" =>
            match path
                "/api/users/1" => jsonResponse (200, "{\"message\": \"User deleted successfully\"}")
                _ => jsonResponse (404, "{\"error\": \"Not found\"}")
        _ => jsonResponse (405, "{\"error\": \"Method not allowed\"}")

print "Starting server listener with callback handler..."
listenResult = httpListen serverId handleHttpRequest ?: -1
print "Server listening on http://127.0.0.1:18080"

(** Issues one `method` request for `path`, printing the request line then the
    status line in the order the golden records them. *)
request (client, method, path, payload) =
    print "${method} ${path}"
    result =
        match method
            "GET" => httpGet client path ""
            "POST" => httpPost client path payload "Content-Type: application/json"
            "PUT" => httpPut client path payload "Content-Type: application/json"
            _ => httpDelete client path ""
    status = result ?: -1
    print "${method} ${path} result: ${status}"
    status

print "Creating HTTP client..."
clientId = httpCreateClient "http://127.0.0.1:18080" 5000 ?: -1
print "Client created with ID: ${clientId}"

print "=== Testing HTTP Methods ==="

(** Verify GET, POST, PUT and DELETE against the routes the handler serves. *)
getUsersResult = request (clientId, "GET", "/api/users", "")
getHealthResult = request (clientId, "GET", "/health", "")
postResult = request (clientId, "POST", "/api/users", "{\"name\": \"Charlie\", \"email\": \"charlie@example.com\"}")
loginResult = request (clientId, "POST", "/api/auth/login", "{\"username\": \"admin\", \"password\": \"secret\"}")
putResult = request (clientId, "PUT", "/api/users/1", "{\"name\": \"Alice Smith\", \"email\": \"alice.smith@example.com\"}")
deleteResult = request (clientId, "DELETE", "/api/users/1", "")

print "=== Testing Error Cases ==="
notFoundResult = request (clientId, "GET", "/nonexistent", "")

print "=== Server Shutdown Test ==="
print "✅ All HTTP operations completed successfully"
print "🛑 Initiating immediate graceful server shutdown..."

stopResult = httpStopServer serverId ?: -1
print "Server stopped with result: ${stopResult}"

print "=== HTTP API Test Complete ==="

// Verify every routed method, the error route, and graceful shutdown.
test "local HTTP API routes every method and status" (\() => checkAll "HTTP API statuses" [
    serverId > 0,
    clientId > 0,
    structuralEquals [getUsersResult, getHealthResult, postResult, loginResult] [200, 200, 201, 200],
    structuralEquals [putResult, deleteResult, notFoundResult, stopResult] [200, 200, 404, 0]
])
