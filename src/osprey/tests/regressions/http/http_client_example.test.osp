// Deterministic loopback coverage for the status-only HTTP client.

fn localResponse(_method: string, _path: string, _headers: string, _body: string) = HttpResponse {
    status: 200,
    headers: "Content-Type: text/plain",
    contentType: "text/plain",
    streamFd: 0,
    isComplete: true,
    partialBody: "ok"
}

fn localHttpRoundTrip() = {
    let server = (httpCreateServer(18107, "127.0.0.1") ?: -1)
    let listening = (httpListen(server, localResponse) ?: -1)
    let client = (httpCreateClient("http://127.0.0.1:18107", 1000) ?: -1)
    let status = (httpGet(client, "/health", "") ?: -1)
    let closed = (httpCloseClient(client) ?: -1)
    let stopped = (httpStopServer(server) ?: -1)
    checkAll("loopback HTTP round trip", [
        server != 0,
        listening == 0,
        client != 0,
        structuralEquals([status, closed, stopped], [200, 0, 0])
    ])
}

test("status-only HTTP client uses a local server", localHttpRoundTrip)
