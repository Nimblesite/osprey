// Deterministic loopback coverage for the status-only HTTP client.

localResponse : (string, string, string, string) -> HttpResponse
localResponse (_method, _path, _headers, _body) = HttpResponse(
    status = 200,
    headers = "Content-Type: text/plain",
    contentType = "text/plain",
    streamFd = 0,
    isComplete = true,
    partialBody = "ok"
)

localHttpRoundTrip () =
    server = httpCreateServer 18107 "127.0.0.1" ?: -1
    listening = httpListen server localResponse ?: -1
    client = httpCreateClient "http://127.0.0.1:18107" 1000 ?: -1
    status = httpGet client "/health" "" ?: -1
    closed = httpCloseClient client ?: -1
    stopped = httpStopServer server ?: -1
    checkAll "loopback HTTP round trip" [
        server != 0,
        structuralEquals [listening, status, closed, stopped] [0, 200, 0, 0],
        client != 0
    ]

test "status-only HTTP client uses a local server" localHttpRoundTrip
