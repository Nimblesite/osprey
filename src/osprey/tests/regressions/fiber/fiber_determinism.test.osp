// Fiber execution order remains deterministic when awaited in spawn order,
// including a multi-step batch whose workers each preprocess, validate and transform.
// [CONCURRENCY-DETERMINISTIC]

extern fn fiber_set_deterministic_mode(enabled: bool) -> int

effect Logger {
    /// Record an informational `message` against the active logger.
    info: fn(string) -> Unit
}

effect Metrics {
    /// Record a successful `route` call taking `millis`.
    recordSuccess: fn(string, int) -> Unit
}

type TaskPriority = Urgent | High | Medium | Low

fn calculateComplexity(priority) = match priority {
    Urgent => 750
    High => 450    
    Medium => 600
    Low => 75
}

fn calculateTaskTime(complexity: int) = (intDiv(complexity, 10) ) + 2 

fn processTask(taskId: string, dataSize: int, priority: TaskPriority) -> int ![Logger, Metrics, Arith] = {
    perform Logger.info("Starting task: " + taskId + " with data size: " + toString(dataSize))
    let complexity = calculateComplexity(priority)
    let processed = dataSize * 8 
    perform Metrics.recordSuccess(taskId, processed)
    perform Logger.info("Task " + taskId + " completed successfully in " + toString(calculateTaskTime(complexity)) + "ms")
    processed
}

fn processTask1() = processTask(taskId: "task-1", dataSize: 150, priority: High)
fn processTask2() = processTask(taskId: "task-2", dataSize: 200, priority: Medium)
fn processTask3() = processTask(taskId: "task-3", dataSize: 75, priority: Urgent)
fn totalProcessed(first: int, second: int, third: int) = first + second + third 

let _ = fiber_set_deterministic_mode(enabled: true)
fn determinismDemo() = {
    handle Metrics {
        recordSuccess taskId processed => print("✅ " + taskId + " succeeded: " + toString(processed) + " units")
    }
    handle Logger {
        info msg => print("ℹ️  " + msg)
    }
    print("=== Fiber Determinism Test ===\nThis test executes tasks in spawn order 1, 2, 3\nThe deterministic run scheduler preserves that order\n")

    /// Spawn all three fibers, then await in spawn order.
    let fiber1 = spawn processTask1()
    let fiber2 = spawn processTask2()
    let fiber3 = spawn processTask3()
    let result1 = await(fiber1)
    let result2 = await(fiber2)
    let result3 = await(fiber3)

    print("Total processed: ${toString(totalProcessed(result1, result2, result3))} units\n=== Test Complete ===")
}
exactArithmetic(fn() => determinismDemo())

/// Repeats the batch under recording handlers, returning the completion trace
/// the deterministic scheduler produced followed by the awaited total.
fn completionTrace() = {
    mut completions = ""
    let total = {
        handle Metrics {
            recordSuccess taskId processed => {
                completions = "${completions}${taskId}:${toString(processed)}|"
                0
            }
        }
        handle Logger {
            info _msg => 0
        }
        let first = spawn processTask1()
        let second = spawn processTask2()
        let third = spawn processTask3()
        totalProcessed(await(first), await(second), await(third))
    }
    "${completions}total:${toString(total)}"
}

// A sum is ORDER-BLIND: `total == 3400` holds just as well when the scheduler
// runs the three fibers backwards, so asserting the total alone leaves the one
// property this file exists to prove completely unguarded. The trace pins the
// spawn order 1, 2, 3. Implements [CONCURRENCY-DETERMINISTIC].

test("deterministic fibers complete in spawn order", fn() => exactArithmetic(fn() => checkAll("deterministic fiber ordering", [
    completionTrace() == "task-1:1200|task-2:1600|task-3:600|total:3400",
    startsWith(completionTrace(), "task-1:"),
    endsWith(completionTrace(), "total:3400"),
    structuralEquals([calculateComplexity(Urgent), calculateComplexity(High), calculateTaskTime(600)], [750, 450, 62])
])))

/// A select with nothing ready runs queued fibers in spawn order until an arm is
/// ready, and a timeout fires without waiting once none is left to run.
/// Implements [CONCURRENCY-DETERMINISTIC] and [CONCURRENCY-SELECT].
fn selectDrivesQueuedFibers() = {
    let first = Channel(1)
    let second = Channel(1)
    let earlier = spawn(send(second, 2))
    let later = spawn(send(first, 1))
    let woken = select { x = recv(first) => "first:${x}"  y = recv(second) => "second:${y}" }
    let next = select { x = recv(first) => "first:${x}"  y = recv(second) => "second:${y}" }
    let quiet = Channel(1)
    let expired = select { recv(quiet) => "value"  timeout(600000) => "expired" }
    let _finished = "${await(earlier)}${await(later)}"
    "${woken}|${next}|${expired}"
}

test("a deterministic select runs queued fibers in spawn order", fn() => check("trace", "second:2|first:1|expired", selectDrivesQueuedFibers()))

fn calculateTime(complexity: int) = (intDiv(complexity, 10) ) + 7 

fn calculateEfficiency(duration) = match duration < 100 {
    true => 100
    false => 50
}

fn preprocessData(rawData) = rawData * 2 + 100 
fn validateData(data) = data > 50
fn transformData(data) = data * 3 

type TaskResult = Success | Warning | Failed

fn classifyTask(taskId: string, dataSize: int, priority: TaskPriority) -> TaskResult ![Logger, Metrics, Arith] = {
    perform Logger.info("Starting task: " + taskId + " with data size: " + toString(dataSize))
    
    let complexity = calculateComplexity(priority)
    let actualTime = calculateTime(complexity)
    
    let preprocessed = preprocessData(dataSize)
    let isValid = validateData(preprocessed)
    
    match isValid {
        true => {
            let processed = transformData(preprocessed)
            let efficiency = calculateEfficiency(actualTime)
            
            perform Metrics.recordSuccess(taskId, processed)
            perform Logger.info("Task " + taskId + " completed successfully in " + toString(actualTime) + "ms")
            
            match efficiency > 80 {
                true => Success
                false => Warning
            }
        }
        false => {
            perform Logger.info("Task " + taskId + " failed validation")
            Failed
        }
    }
}

fn processTaskForBatch(taskId: string, dataSize: int, priority: TaskPriority) -> int ![Logger, Metrics, Arith] = {
    let result = classifyTask(taskId: taskId, dataSize: dataSize, priority: priority)
    match result {
        Success => 900
        Warning => 600  
        Failed => 0
    }
}

fn processAlphaTask1() = processTaskForBatch(taskId: "task-alpha-1", dataSize: 150, priority: High)
fn processAlphaTask2() = processTaskForBatch(taskId: "task-alpha-2", dataSize: 200, priority: Medium) 
fn processAlphaTask3() = processTaskForBatch(taskId: "task-alpha-3", dataSize: 75, priority: Urgent)
fn sumBatchResults(first: int, second: int, third: int) = first + second + third 

fn processAlphaBatch() -> int ![Logger, Metrics, Arith] = {
    perform Logger.info("Processing batch: alpha")
    
    let worker1 = spawn processAlphaTask1()
    let worker2 = spawn processAlphaTask2()
    let worker3 = spawn processAlphaTask3()
    
    let result1 = await(worker1)
    let result2 = await(worker2)
    let result3 = await(worker3)
    
    let batchTotal = sumBatchResults(result1, result2, result3)
    
    perform Logger.info("Batch alpha processed: " + toString(batchTotal) + " total data units")
    
    batchTotal
}

fn executionOrderDemo() = {
    handle Metrics {
        recordSuccess taskId processed => print("✅ " + taskId + " succeeded: " + toString(processed) + " units")
    }
    handle Logger {
        info msg => print("ℹ️  " + msg)
    }
    print("=== Fiber Execution Order Test ===")
    let results1 = processAlphaBatch()
    print("Total: ${toString(results1)}\n=== Test Complete ===")
}
exactArithmetic(fn() => executionOrderDemo())

/// Repeats the complete batch under quiet handlers for an asserted result.
fn alphaBatchForTest() = {
    handle Metrics {
        recordSuccess _taskId _processed => 0
    }
    handle Logger {
        info _msg => 0
    }
    processAlphaBatch()
}

// Verifies preprocessing, classification, and the awaited batch total.

test("fiber batch preserves transformed results", fn() => exactArithmetic(fn() => checkAll("fiber batch results", [
    structuralEquals([alphaBatchForTest(), preprocessData(150), transformData(400)], [2700, 400, 1200]),
    structuralEquals([calculateEfficiency(52), calculateComplexity(Low)], [100, 75])
])))
