// [CONCURRENCY-HANDLES] A program can have as many fibers and channels as it likes
// over its life, and each still answers its own value. Past 999 these once answered
// -1 with exit 0, segfaulted for a string, or aborted for a channel.

twice i = wrapAdd (i, i)
word i = "w${i}"

sumOfFibers (i, total) = match i
    3000 => total
    _ => sumOfFibers (wrapAdd (i, 1), wrapAdd (total, await (spawn (twice i))))

lastWord (i, last) = match i
    3000 => last
    _ => lastWord (wrapAdd (i, 1), await (spawn (word i)))

type Pair =
    index : int
    label : string

pairOf i = Pair(index = i, label = word i)

(** A record a fiber returned is a managed value the runtime holds for every handle. *)
sumOfRecords (i, total, last) = match i
    3000 => "${total} ${last}"
    _ =>
        pair = await (spawn (pairOf i))
        sumOfRecords (wrapAdd (i, 1), wrapAdd (total, pair.index), pair.label)

sumOfChannels (i, total) = match i
    3000 => total
    _ =>
        channel = Channel 1
        send channel i
        sumOfChannels (wrapAdd (i, 1), wrapAdd (total, recv channel))

wordsThroughChannels (i, last) = match i
    3000 => last
    _ =>
        channel = Channel 1
        send channel (await (spawn (word i)))
        wordsThroughChannels (wrapAdd (i, 1), recv channel)

reusableHandles () =
    fiber = spawn (word 7)
    _pass = sumOfFibers (0, 0)
    check "first await" "w7" (await fiber)
    check "second await" "w7" (await fiber)

test "thousands of int fibers" (\() => check "sum" "8997000" "${sumOfFibers (0, 0)}")
test "thousands of string fibers" (\() => check "last" "w2999" (lastWord (0, "")))
test "thousands of record fibers" (\() => check "sum and last" "4498500 w2999" (sumOfRecords (0, 0, "")))
test "thousands of channels" (\() => check "sum" "4498500" "${sumOfChannels (0, 0)}")
test "strings through fibers and channels" (\() => check "last" "w2999" (wordsThroughChannels (0, "")))
test "an old handle survives thousands more" reusableHandles
