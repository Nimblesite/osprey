// [CONCURRENCY-SELECT] Select chooses among channel operations; the arms join as a
// match does and every arm kind is exercised across element types.

/// A shopping order on a channel, for a managed element.
type Order = { item: string, qty: int }

/// Ready arms run in source order, and only the chosen arm's operation happens.
fn tieBreaksInSourceOrder() = {
    use first <- andThen(Channel(2))
    use second <- andThen(Channel(2))
    send(first, 1)
    send(second, 2)
    let chosen = select {
        a = recv(first) => a + 10
        b = recv(second) => b + 20
    }
    let next = select {
        a = recv(first) => a + 10
        b = recv(second) => b + 20
        _ => 99
    }
    let drained = select {
        a = recv(first) => a
        b = recv(second) => b
        _ => 99
    }
    Success { value: checkAll("source order", [chosen == 11, next == 22, drained == 99]) }
}

/// A send arm runs when its channel has room, and a full one falls through.
fn sendArmsRespectCapacity() = {
    use room <- andThen(Channel(1))
    let sent = select {
        send(room, 7) => "sent"
        _ => "full"
    }
    let refused = select {
        send(room, 8) => "sent"
        _ => "full"
    }
    let received = recv(room)
    Success { value: checkAll("send capacity", [sent == "sent", refused == "full", received == 7]) }
}

/// A receive binding has the channel's element type, for each kind of element.
fn bindingsHaveTheElementType() = {
    use words <- andThen(Channel(1))
    use orders <- andThen(Channel(1))
    use flags <- andThen(Channel(1))
    send(words, "he" + "llo")
    send(orders, Order { item: "tea", qty: 2 })
    send(flags, true)
    let word = select { w = recv(words) => length(w) _ => 0 }
    let order = select { o = recv(orders) => o.item + toString(o.qty) _ => "none" }
    let flag = select { f = recv(flags) => !f _ => true }
    use ignored <- andThen(Channel(1))
    send(ignored, "dropped" + "!")
    let dropped = select { recv(ignored) => "took" _ => "none" }
    Success { value: checkAll("bindings", [word == 5, order == "tea2", flag == false, dropped == "took"]) }
}

/// An unchosen managed send gives its reference back, and a chosen one delivers it.
fn managedSendsKeepTheirOwnership() = {
    use full <- andThen(Channel(1))
    use open <- andThen(Channel(1))
    send(full, "occupied" + "!")
    let chosen = select {
        send(full, "never" + "!") => "full arm"
        send(open, "deliver" + "ed") => "open arm"
    }
    let inFull = recv(full)
    let inOpen = recv(open)
    Success { value: checkAll("managed sends", [chosen == "open arm", inFull == "occupied!", inOpen == "delivered"]) }
}

/// A timeout arm runs once nothing is ready, and a ready channel beats it.
fn timeoutsDecideOnlyWhenNothingIsReady() = {
    use quiet <- andThen(Channel(1))
    let expired = select { recv(quiet) => "value" timeout(5) => "expired" }
    let immediate = select { recv(quiet) => "value" timeout(0) => "expired" }
    send(quiet, 1)
    let ready = select { recv(quiet) => "value" timeout(5000) => "expired" }
    Success { value: checkAll("timeouts", [expired == "expired", immediate == "expired", ready == "value"]) }
}

/// A blocked select wakes when another fiber's operation makes an arm ready.
fn aFiberWakesABlockedSelect() = {
    use replies <- andThen(Channel(1))
    use idle <- andThen(Channel(1))
    let worker = spawn(send(replies, 42))
    let answer = select {
        r = recv(replies) => r
        i = recv(idle) => i + 1000
    }
    let _ignored = await(worker)
    use drains <- andThen(Channel(1))
    send(drains, 1)
    let blocked = spawn(send(drains, 2))
    let freed = recv(drains)
    let second = select { d = recv(drains) => d timeout(5000) => 0 }
    let _done = await(blocked)
    Success { value: checkAll("wakeups", [answer == 42, freed == 1, second == 2]) }
}

/// Record a step on the log, then answer the value.
fn note(log, step, value) = {
    send(log, step)
    value
}

/// Operands evaluate once on entry, in source order, whichever arm runs.
fn operandsEvaluateOnceInOrder() = {
    use log <- andThen(Channel(4))
    use channel <- andThen(Channel(1))
    let picked = select {
        send(channel, note(log, 1, 10)) => note(log, 3, 100)
        timeout(note(log, 2, 5)) => 0
    }
    Success { value: checkAll("operands", [picked == 100, recv(log) == 1, recv(log) == 2, recv(log) == 3, recv(channel) == 10]) }
}

exactTests([
    { name: "ready arms run in source order", work: fn() => settledWork(tieBreaksInSourceOrder) },
    { name: "send arms respect capacity", work: fn() => settledWork(sendArmsRespectCapacity) },
    { name: "receive bindings have the element type", work: fn() => settledWork(bindingsHaveTheElementType) },
    { name: "managed sends keep their ownership", work: fn() => settledWork(managedSendsKeepTheirOwnership) },
    { name: "timeouts decide only when nothing is ready", work: fn() => settledWork(timeoutsDecideOnlyWhenNothingIsReady) },
    { name: "a fiber wakes a blocked select", work: fn() => settledWork(aFiberWakesABlockedSelect) },
    { name: "operands evaluate once in order", work: fn() => settledWork(operandsEvaluateOnceInOrder) }
])
