// The Database EFFECT — L1 capstone. DB access is a capability: app logic is
// `!Database`, so an unhandled Database effect is a COMPILE error, and the
// handler is swappable (real SQLite here; a mock/in-memory handler can replace
// it in tests with zero changes to app code). The handler is the only place that
// touches the generic-FFI SQLite bindings — there are NO hardcoded DB builtins,
// and the connection/statement pointers are threaded through op arguments (so no
// handler closes over outer state). Fallible ops return `Result<_, Error>`.
//
// Plan: docs/plans/ffi-sqlite.md · Spec: docs/specs/compiler/0019-ForeignFunctionInterface.md
//
// @link: sqlite3

extern fn sqlite3_open(filename: string, ppDb: Ptr) -> int
extern fn sqlite3_exec(db: Ptr, sql: string, cb: Ptr, arg: Ptr, errmsg: Ptr) -> int
extern fn sqlite3_prepare_v2(db: Ptr, sql: string, nByte: int, ppStmt: Ptr, tail: Ptr) -> int
extern fn sqlite3_bind_int(stmt: Ptr, idx: int, val: int) -> int
extern fn sqlite3_bind_text(stmt: Ptr, idx: int, val: string, nByte: int, destructor: Ptr) -> int
extern fn sqlite3_step(stmt: Ptr) -> int
extern fn sqlite3_column_int(stmt: Ptr, col: int) -> int
extern fn sqlite3_column_text(stmt: Ptr, col: int) -> string
extern fn sqlite3_finalize(stmt: Ptr) -> int
extern fn sqlite3_close(db: Ptr) -> int

extern fn osprey_ffi_cell() -> Ptr
extern fn osprey_ffi_deref(cell: Ptr) -> Ptr
extern fn osprey_ffi_free(cell: Ptr) -> int
extern fn osprey_ffi_null() -> Ptr
extern fn osprey_ffi_transient() -> Ptr

/// The capability. Connection/statement handles are passed explicitly so handler
/// arms stay free of captured state.
effect Database {
    /// Open the database at `path`, reporting failure as a `Result`.
    open: fn(string) -> Result<Ptr, Error>
    /// Run one statement that returns no rows; yields the status code.
    exec: fn(Ptr, string) -> int
    /// Compile `sql` into a reusable prepared statement.
    prepare: fn(Ptr, string) -> Ptr
    /// Bind integer `value` to one-based parameter `index`.
    bindInt: fn(Ptr, int, int) -> int
    /// Bind text `value` to one-based parameter `index`.
    bindText: fn(Ptr, int, string) -> int
    /// Advance the statement one row; yields the status code.
    step: fn(Ptr) -> int
    /// Read the current row's integer column `index`.
    columnInt: fn(Ptr, int) -> int
    /// Read the current row's text column `index`.
    columnText: fn(Ptr, int) -> string
    /// Release the prepared statement.
    finalize: fn(Ptr) -> int
    /// Close the connection and release its resources.
    close: fn(Ptr) -> int
}

/// --- real SQLite handler implementations (top-level, no captures) ---
/// Runs `call` against a fresh out-parameter cell, yielding its status code and pointer.
fn withCell(call) = {
    let cell = osprey_ffi_cell()
    let rc = call(cell)
    let value = osprey_ffi_deref(cell: cell)
    let _freed = osprey_ffi_free(cell: cell)
    { rc: rc, value: value }
}

fn openReal(path) = {
    let opened = withCell(fn(cell) => sqlite3_open(filename: path, ppDb: cell))
    match opened.rc {
        0 => Success { value: opened.value }
        _ => Error { message: "open failed" }
    }
}

fn execReal(db, sql) = {
    let nullptr = osprey_ffi_null()
    sqlite3_exec(db: db, sql: sql, cb: nullptr, arg: nullptr, errmsg: nullptr)
}

fn prepareReal(db, sql) = {
    let prepared = withCell(fn(cell) => sqlite3_prepare_v2(db: db, sql: sql, nByte: (0 - 1) , ppStmt: cell, tail: osprey_ffi_null()))
    prepared.value
}

/// `${label} ok` when status code `rc` is zero, `${label} err` otherwise.
fn statusLine(label, rc) = match rc {
    0 => "${label} ok"
    _ => "${label} err"
}

fn createUsersTable(db) !Database = perform Database.exec(db, "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)")
fn readRow(stmt) !Database = { id: perform Database.columnInt(stmt, 0), name: "${perform Database.columnText(stmt, 1)}" }

/// --- application logic: effect-typed, knows nothing about SQLite or FFI ---
fn seedUser(db, uid, uname) !Database = {
    let stmt = perform Database.prepare(db, "INSERT INTO users(id, name) VALUES (?, ?)")
    let _b1 = perform Database.bindInt(stmt, 1, uid)
    let _b2 = perform Database.bindText(stmt, 2, uname)
    let rc = perform Database.step(stmt)
    let _fin = perform Database.finalize(stmt)
    rc
}

/// Seeds the two demo users, yielding the line that reports their status codes.
fn seedDemoUsers(db) !Database = "inserted ${seedUser(db: db, uid: 1, uname: "Ada")} ${seedUser(db: db, uid: 2, uname: "Linus")}"

fn showUser(stmt) !Database = {
    let rc = perform Database.step(stmt)
    let row = readRow(stmt)
    print("user ${row.id} = ${row.name}")
    rc
}

fn runApp(db) !Database = {
    print(statusLine("create", createUsersTable(db)))
    print(seedDemoUsers(db))
    let q = perform Database.prepare(db, "SELECT id, name FROM users ORDER BY id")
    let _r1 = showUser(q)
    let _r2 = showUser(q)
    let _qfin = perform Database.finalize(q)
    print(statusLine("closed", perform Database.close(db)))
}

/// Installs the real SQLite handler around `work`.
fn withDatabase(work) = {
    handle Database {
        open path => openReal(path: path)
        exec db sql => execReal(db: db, sql: sql)
        prepare db sql => prepareReal(db: db, sql: sql)
        bindInt stmt idx val => sqlite3_bind_int(stmt: stmt, idx: idx, val: val)
        bindText stmt idx val => sqlite3_bind_text(stmt: stmt, idx: idx, val: val, nByte: (0 - 1) , destructor: osprey_ffi_transient())
        step stmt => sqlite3_step(stmt: stmt)
        columnInt stmt col => sqlite3_column_int(stmt: stmt, col: col)
        columnText stmt col => sqlite3_column_text(stmt: stmt, col: col)
        finalize stmt => sqlite3_finalize(stmt: stmt)
        close db => sqlite3_close(db: db)
    }
    work()
}

/// Runs `work` against a fresh in-memory database inside the real handler.
fn withMemoryDatabase(work) = withDatabase(fn() => resultAndThen(perform Database.open(":memory:"), work))

/// Reports an open failure, otherwise yields whatever the run produced.
fn reportOpened(result) = match result {
    Success { value } => value
    Error { message } => print("open ${message}")
}

fn databaseDemo() = reportOpened(withMemoryDatabase(runApp))
databaseDemo()

/// Captures every externally visible result of one handled database interaction.
type DatabaseObservation = {
    createStatuses: List<int>,
    rowStatuses: List<int>,
    finishStatuses: List<int>,
    selectedName: string
}

/// Runs application helpers through Database and returns immutable evidence.
fn observeDatabase(db) !Database = {
    let created = createUsersTable(db)
    let inserted = seedUser(db: db, uid: 7, uname: "Grace")
    let query = perform Database.prepare(db, "SELECT id, name FROM users WHERE id = 7")
    let stepped = perform Database.step(query)
    let row = readRow(query)
    let done = perform Database.step(query)
    let finalized = perform Database.finalize(query)
    let closed = perform Database.close(db)
    DatabaseObservation {
        createStatuses: [created, inserted, stepped],
        rowStatuses: [row.id, done],
        finishStatuses: [finalized, closed],
        selectedName: row.name
    }
}

/// Reports whether the real handler produced an observation instead of an error.
fn databaseOpened(result) = match result {
    Success => true
    Error => false
}

/// Verifies the Database capability performs a complete typed SQLite round trip.
fn databaseEffectCase() = {
    let result = withMemoryDatabase(observeDatabase)
    match result {
        Success { value } => checkAll("Database effect round trip", [
            databaseOpened(result),
            structuralEquals(value.createStatuses, [0, 101, 100]),
            structuralEquals(value.rowStatuses, [7, 101]),
            structuralEquals(value.finishStatuses, [0, 0]),
            value.selectedName == "Grace"
        ])
        Error { message } => checkAll("Database effect open result", [
            databaseOpened(result),
            message == ""
        ])
    }
}
test("Database capability binds, queries, and closes through its handler", databaseEffectCase)
