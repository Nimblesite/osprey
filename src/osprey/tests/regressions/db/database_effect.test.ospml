// The Database EFFECT — L1 capstone. DB access is a capability: app logic is
// `!Database`, so an unhandled Database effect is a COMPILE error, and the
// handler is swappable (real SQLite here; a mock/in-memory handler can replace
// it in tests with zero changes to app code). The handler is the only place that
// touches the generic-FFI SQLite bindings — there are NO hardcoded DB builtins,
// and the connection/statement pointers are threaded through op arguments (so no
// handler closes over outer state). Fallible ops return `Result<_, string>`.
//
// Plan: docs/plans/ffi-sqlite.md · Spec: docs/specs/compiler/0019-ForeignFunctionInterface.md
//
// @link: sqlite3

extern sqlite3_open (filename : string) (ppDb : Ptr) -> int
extern sqlite3_exec (db : Ptr) (sql : string) (cb : Ptr) (arg : Ptr) (errmsg : Ptr) -> int
extern sqlite3_prepare_v2 (db : Ptr) (sql : string) (nByte : int) (ppStmt : Ptr) (tail : Ptr) -> int
extern sqlite3_bind_int (stmt : Ptr) (idx : int) (val : int) -> int
extern sqlite3_bind_text (stmt : Ptr) (idx : int) (val : string) (nByte : int) (destructor : Ptr) -> int
extern sqlite3_step (stmt : Ptr) -> int
extern sqlite3_column_int (stmt : Ptr) (col : int) -> int
extern sqlite3_column_text (stmt : Ptr) (col : int) -> string
extern sqlite3_finalize (stmt : Ptr) -> int
extern sqlite3_close (db : Ptr) -> int

extern osprey_ffi_cell -> Ptr
extern osprey_ffi_deref (cell : Ptr) -> Ptr
extern osprey_ffi_free (cell : Ptr) -> int
extern osprey_ffi_null -> Ptr
extern osprey_ffi_transient -> Ptr

(** The capability. Connection/statement handles are passed explicitly so handler
    arms stay free of captured state. *)
effect Database
    (** Open the database at `path`, reporting failure as a `Result`. *)
    open : string => Result<Ptr, string>
    (** Run one statement that returns no rows; yields the status code. *)
    exec : (Ptr, string) => int
    (** Compile `sql` into a reusable prepared statement. *)
    prepare : (Ptr, string) => Ptr
    (** Bind integer `value` to one-based parameter `index`. *)
    bindInt : (Ptr, int, int) => int
    (** Bind text `value` to one-based parameter `index`. *)
    bindText : (Ptr, int, string) => int
    (** Advance the statement one row; yields the status code. *)
    step : Ptr => int
    (** Read the current row's integer column `index`. *)
    columnInt : (Ptr, int) => int
    (** Read the current row's text column `index`. *)
    columnText : (Ptr, int) => string
    (** Release the prepared statement. *)
    finalize : Ptr => int
    (** Close the connection and release its resources. *)
    close : Ptr => int

(** --- real SQLite handler implementations (top-level, no captures) --- *)
(** Runs `call` against a fresh out-parameter cell, yielding its status code and pointer. *)
withCell call =
    cell = osprey_ffi_cell ()
    rc = call cell
    value = osprey_ffi_deref cell
    _freed = osprey_ffi_free cell
    { rc = rc, value = value }

openReal path =
    opened = withCell (\cell => sqlite3_open path cell)
    match opened.rc
        0 => Success(value = opened.value)
        _ => Error(message = "open failed")

execReal (db, sql) =
    nullptr = osprey_ffi_null ()
    sqlite3_exec db sql nullptr nullptr nullptr

prepareReal (db, sql) =
    prepared = withCell (\cell => sqlite3_prepare_v2 db sql (0 - 1) cell (osprey_ffi_null ()))
    prepared.value

(** `${label} ok` when status code `rc` is zero, `${label} err` otherwise. *)
statusLine (label, rc) = match rc
    0 => "${label} ok"
    _ => "${label} err"

createUsersTable db = perform Database.exec db "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)"
readRow stmt = { id = perform Database.columnInt stmt 0, name = "${perform Database.columnText stmt 1}" }

(** --- application logic: effect-typed, knows nothing about SQLite or FFI --- *)
seedUser (db, uid, uname) =
    stmt = perform Database.prepare db "INSERT INTO users(id, name) VALUES (?, ?)"
    _b1 = perform Database.bindInt stmt 1 uid
    _b2 = perform Database.bindText stmt 2 uname
    rc = perform Database.step stmt
    _fin = perform Database.finalize stmt
    rc

(** Seeds the two demo users, yielding the line that reports their status codes. *)
seedDemoUsers db = "inserted ${seedUser (db, 1, "Ada")} ${seedUser (db, 2, "Linus")}"

showUser stmt =
    rc = perform Database.step stmt
    row = readRow stmt
    print "user ${row.id} = ${row.name}"
    rc

runApp db =
    print "${statusLine ("create", createUsersTable db)}\n${seedDemoUsers db}"
    q = perform Database.prepare db "SELECT id, name FROM users ORDER BY id"
    _r1 = showUser q
    _r2 = showUser q
    _qfin = perform Database.finalize q
    print (statusLine ("closed", perform Database.close db))

(** Installs the real SQLite handler around `work`. *)
withDatabase work =
    handle Database
        open path => openReal path
        exec db sql => execReal (db, sql)
        prepare db sql => prepareReal (db, sql)
        bindInt stmt idx val => sqlite3_bind_int stmt idx val
        bindText stmt idx val => sqlite3_bind_text stmt idx val (0 - 1) (osprey_ffi_transient ())
        step stmt => sqlite3_step stmt
        columnInt stmt col => sqlite3_column_int stmt col
        columnText stmt col => sqlite3_column_text stmt col
        finalize stmt => sqlite3_finalize stmt
        close db => sqlite3_close db
    work ()

(** Runs `work` against a fresh in-memory database inside the real handler. *)
withMemoryDatabase work = withDatabase (\() => andThen (perform Database.open ":memory:", work))

(** Reports an open failure, otherwise yields whatever the run produced. *)
reportOpened result = match result
    Success value => value
    Error message => print "open ${message}"

databaseDemo () = reportOpened (withMemoryDatabase runApp)
databaseDemo ()

(** Captures every externally visible result of one handled database interaction. *)
type DatabaseObservation =
    createStatuses : List<int>
    rowStatuses : List<int>
    finishStatuses : List<int>
    selectedName : string

(** Runs application helpers through Database and returns immutable evidence. *)
observeDatabase db =
    created = createUsersTable db
    inserted = seedUser (db, 7, "Grace")
    query = perform Database.prepare db "SELECT id, name FROM users WHERE id = 7"
    stepped = perform Database.step query
    row = readRow query
    done = perform Database.step query
    finalized = perform Database.finalize query
    closed = perform Database.close db
    DatabaseObservation(
        createStatuses = [created, inserted, stepped],
        rowStatuses = [row.id, done],
        finishStatuses = [finalized, closed],
        selectedName = row.name
    )

(** Reports whether the real handler produced an observation instead of an error. *)
databaseOpened result = match result
    Success => true
    Error => false

(** Verifies the Database capability performs a complete typed SQLite round trip. *)
databaseEffectCase () =
    result = withMemoryDatabase observeDatabase
    match result
        Success value => checkAll ("Database effect round trip", [
            databaseOpened result,
            structuralEquals (value.createStatuses, [0, 101, 100]),
            structuralEquals (value.rowStatuses, [7, 101]),
            structuralEquals (value.finishStatuses, [0, 0]),
            value.selectedName == "Grace"
        ])
        Error message => checkAll ("Database effect open result", [
            databaseOpened result,
            message == ""
        ])
test "Database capability binds, queries, and closes through its handler" databaseEffectCase

// --- The same bindings used directly, without the capability: SQLite through the
// GENERIC C interop layer, out-parameters through the FFI pointer cells, values
// always BOUND (?, ?), never interpolated. [FFI-LINK-DIRECTIVES] [FFI-PTR] [FFI-NO-DB-BUILTINS]

(** SQLITE_OK = 0, SQLITE_DONE = 101. A friendly status for the OK code. *)
okText rc =
    match rc
        0 => "ok"
        _ => "err"

(** Prepare a statement and hand back the live stmt pointer (out-param via a cell). *)
prepare (db, sql) =
    cell = osprey_ffi_cell ()
    _rc = sqlite3_prepare_v2 db sql ((0 - 1) ) cell (osprey_ffi_null ())
    stmt = osprey_ffi_deref cell
    _freed = osprey_ffi_free cell
    stmt

(** Step the statement once, release it, and report both statuses as `rc` and `fin`. *)
runStatement stmt =
    rc = sqlite3_step stmt
    fin = sqlite3_finalize stmt
    { rc = rc, fin = fin }

(** Insert one user with BOUND parameters — no string interpolation of values. *)
insertUser (db, uid, uname) =
    stmt = prepare (db, "INSERT INTO users(id, name) VALUES (?, ?)")
    _b1 = sqlite3_bind_int stmt 1 uid
    _b2 = sqlite3_bind_text stmt 2 uname ((0 - 1) ) (osprey_ffi_transient ())
    (runStatement stmt).rc

(** Read the next row and print it as a typed (int, text) pair. *)
printRow stmt =
    rc = sqlite3_step stmt
    print "user ${sqlite3_column_int stmt 0} = ${sqlite3_column_text stmt 1}"
    rc

(** Create the users table over the FFI and hand back the exec status. *)
createUsers db = sqlite3_exec db "CREATE TABLE users(id INTEGER PRIMARY KEY, name TEXT)" (osprey_ffi_null ()) (osprey_ffi_null ()) (osprey_ffi_null ())

(** Open an in-memory database on `cell`, create the users table, and report both
statuses alongside the live connection. *)
openUsers cell =
    openrc = sqlite3_open ":memory:" cell
    db = osprey_ffi_deref cell
    ddlrc = createUsers db
    { openrc = openrc, ddlrc = ddlrc, db = db }

(** Fold a table of status rows: each row's `got` codes must equal `want`.
Every row carries one further condition that is true for the same reason. *)
assertStatuses rows =
    forEachList (rows, \row => checkAll row.label [structuralEquals row.got row.want, row.extra])

dbCell = osprey_ffi_cell ()
opened = openUsers dbCell
db = opened.db
print "open ${okText opened.openrc}\ncreate ${okText opened.ddlrc}"

i1 = insertUser (db, 1, "Ada")
i2 = insertUser (db, 2, "Linus")
print "inserted ${i1} ${i2}"

q = prepare (db, "SELECT id, name FROM users ORDER BY id")
r1 = printRow q
r2 = printRow q
qfin = sqlite3_finalize q

cleanup = osprey_ffi_free dbCell
closed = sqlite3_close db
print "closed ${okText closed}"

(** Verify generic FFI pointer cells, bound parameters, and typed row access. *)
sqliteRoundTripCase () =
    testCell = osprey_ffi_cell ()
    setup = openUsers testCell
    testDb = setup.db
    testInsert = insertUser (testDb, 7, "Grace")
    testQuery = prepare (testDb, "SELECT id, name FROM users WHERE id = 7")
    testRow = sqlite3_step testQuery
    selectedId = sqlite3_column_int testQuery 0
    selectedName = "${sqlite3_column_text testQuery 1}"
    finished = runStatement testQuery
    testClosed = sqlite3_close testDb
    testFreed = osprey_ffi_free testCell
    // Setup agrees on SQLITE_OK, bound parameters produce SQLITE_DONE with the
    // expected typed row, and statements, connections and pointer cells release.
    assertStatuses [
        { label = "SQLite setup status", got = [setup.openrc, setup.ddlrc], want = [0, 0], extra = okText setup.openrc == "ok" },
        { label = "SQLite bound row", got = [testInsert, testRow, selectedId, finished.rc], want = [101, 100, 7, 101], extra = selectedName == "Grace" },
        { label = "SQLite cleanup status", got = [finished.fin, testClosed, testFreed], want = [0, 0, 0], extra = okText testClosed == "ok" }
    ]
test "SQLite FFI binds and reads a typed row" sqliteRoundTripCase
