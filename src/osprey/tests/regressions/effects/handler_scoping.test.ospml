effect Logger
    (** Record `message` in whatever log the installed handler owns. *)
    log : string => Unit
    (** Record a diagnostic `message` kept out of normal output. *)
    debug : string => Unit

(** A Logger handler value that prints each record behind `logTag`/`debugTag`. *)
taggedLogger (logTag, debugTag) = handler Logger
    log msg => print (logTag + msg)
    debug msg => print (debugTag + msg)

(** Perform the log and diagnostic ops, then answer `value`. *)
loggedOp (message, diagnostic, value) =
    perform Logger.log message
    perform Logger.debug diagnostic
    value

innerOp () = loggedOp ("inner exec", "debug inner", 42)

outerOp () = loggedOp ("outer exec", "debug outer", 21)

(** Log `value` behind `label`, then answer it unchanged. *)
loggedValue (label, value) =
    perform Logger.log (label + toString value)
    value

testNested () =
    perform Logger.log "before inner handler"

    _innerResult =
        taggedLogger ("[INNER-LOG] ", "[INNER-DEBUG] ") (\() =>
            loggedValue ("inner result: ", innerOp ()))

    perform Logger.log "after inner handler — back to outer"
    outerResult = loggedValue ("outer result: ", outerOp ())

scopingDemo () =
    taggedLogger ("[OUTER-LOG] ", "[OUTER-DEBUG] ") (\() =>
        print "=== handler scoping ==="
        r = nestedCall ()
        print ("forward chain result: " + toString r)

        testNested ()
        print "=== done ===")
scopingDemo ()

performComplex () =
    perform Logger.log "complex starting"
    loggedValue ("complex intermediate: ", 21 * 2)

deepNestedOp () =
    perform Logger.log "deep op exec"
    performComplex ()

nestedCall () =
    perform Logger.log "before nested"
    r = deepNestedOp ()
    perform Logger.log "after nested"
    r

effect Ask
    (** Request a replacement for `value` from the installed handler. *)
    control ask : int => int
effect Tell
    (** Hand `value` to the handler and use whatever it returns. *)
    control tell : int => int

askBoth n =
    a = perform Ask.ask n
    perform Tell.tell a

(** Answer one more than the value it receives, as an `Ask` handler value. *)
plusOneHandler () = handler Ask
    ask v => resume ((v + 1) )

(** Hand every answer to a nested `Tell` region that doubles it. *)
tellDoubled n =
    handle Tell
        tell v => resume ((v * 2) )
    askBoth n

nested =
    exactArithmetic (\() =>
        plusOne = plusOneHandler ()
        plusOne (\() => tellDoubled 4))

askOnce n = perform Ask.ask n

shadowed =
    exactArithmetic (\() =>
        handle Ask
            ask v => resume ((v + 100) )
        plusOne = plusOneHandler ()
        plusOne (\() => askOnce 1))
print ("nested resuming " + toString nested + " shadowed resume " + toString shadowed)
print "=== resume scoping done ==="

(** (4) RESUME carrying an ERASED operand — the box must survive the captured
    continuation. A value-carrying `resume` suspends the performer and restores
    it later, so an `any` operand crosses the mailbox, is narrowed by the arm,
    and is released by whoever still owns it after the round trip. Every
    ownership rule for a box is pinned in
    src/osprey/tests/regressions/basics/types/any_type_comprehensive, but that file stays
    free of `resume` so it keeps its wasm32 goldens; only a RESUMING handler
    routes a box through a continuation, and that path is already unportable
    here for `__osprey_coro_suspend`.
    [TYPE-ANY] [EFFECTS-OPERATION-MAILBOX] [GC-ARC-PERCEUS] *)
type Boxed =
    held : string
    tag : int

effect Audit
    (** Narrow `item` and hand back the width of its rendering. *)
    control note : any => int

describeErased : any -> string
describeErased v =
    match v
        { held, .. } => "held=${held}"
        _ => "other=${v}"

(** Both performs continue afterwards, so each one's box is live across a
    suspend — the heap payload is built at runtime so ARC actually counts it. *)
auditWork : Unit -> int ![Audit, Arith]
auditWork () =
    a = perform Audit.note (Boxed(held = "eff" + "ect", tag = 3))
    b = perform Audit.note 5
    (a + b) 

audited =
    exactArithmetic (\() =>
        handle Audit
            note item => resume (length (describeErased item))
        auditWork ())

(** Run the forward-referenced chain under a quiet handler. *)
forwardResultForTest () =
    handle Logger
        log _msg => 0
        debug _msg => 0
    nestedCall ()

// Re-enter the forward call chain and check nested handler restoration.

test "nested handlers override locally and restore outer scope" (\() => exactArithmetic ((\() => checkAll "handler scope results" [
        structuralEquals [(forwardResultForTest () ), nested, shadowed, audited] [42, 10, 2, 18],
        nested != shadowed
])))

(** Counter proves handler-owned state is one shared cell no matter how deep the
    performing call sits ([EFFECTS-HANDLER-STATE]). *)
effect Counter
    (** Add `amount` to the handler's cell and answer the running total. *)
    bump : int => int
    (** Read the handler's cell, offset by `offset`, without changing it. *)
    snapshot : int => int

(** One nested helper level: the perform leaves the handled body's own frame. *)
bumpVia : int -> int ! Counter
bumpVia n = perform Counter.bump n

(** Two nested helper levels, so the operation is two calls from the region. *)
bumpTwice : int -> int ![Counter, Arith]
bumpTwice n =
    first = bumpVia n
    second = bumpVia (n + 1 )
    (first + second) 

(** Three levels: [EFFECTS-HANDLER-STATE] does not stop at a call boundary. *)
deeplyNested : int -> int ![Counter, Arith]
deeplyNested n = bumpTwice n

(** A handler region at file scope owns its cell exactly as one inside a
    function does — the spec's own example installs the handler at top level. *)
mut topCell = 0
mut topBumps = 0
topSum =
    exactArithmetic (\() =>
        handle Counter
            bump amount =>
                topBumps := topBumps + 1 
                topCell := topCell + amount 
                topCell
            snapshot offset => topCell + offset 
        deeplyNested 2)

(** [EFFECTS-HANDLER-STATE] promotes a captured `mut` to a shared heap cell so
    "every arm, the handled body, and code after the region observe the same
    location". Nothing in that sentence is scoped to the frame that performs, so
    a perform issued from a nested helper — or from a region installed at file
    scope — must land on the same cell. Issues #178 and #156. *)
handlerStateThroughNestedCallsCase () =
    mut cell = 0
    mut bumps = 0
    mut snapshots = 0
    mut lastAmount = 0
    sum =
        handle Counter
            bump amount =>
                bumps := bumps + 1 
                cell := cell + amount 
                lastAmount := amount
                cell
            snapshot offset =>
                snapshots := snapshots + 1 
                cell + offset 
        nestedSum = deeplyNested 5
        live = perform Counter.snapshot 0
        (nestedSum + live) 
    after =
        handle Counter
            bump amount =>
                bumps := bumps + 1 
                cell := cell + amount 
                cell
            snapshot offset => cell + offset 
        bumpVia 100

    // The arm's own answers accumulate on one cell across three call levels.
    checkAll "nested performs share the handler cell" [
        structuralEquals [sum, cell, bumps, snapshots] [27, 111, 3, 1],
        structuralEquals [lastAmount, after, (bumps + snapshots )] [6, 111, 4],
        after == cell,
        sum != cell,
        bumps != snapshots
    ]

    // Each intermediate total is observable, so a lost update cannot hide
    // behind a correct final sum.
    checkAll "handler cell reaches every intermediate total" [
        structuralEquals [(5 + 11 ), bumps] [16, 3],
        sum == (16 + 11 ),
        cell == (11 + 100 ),
        lastAmount == (5 + 1 ),
        cell > 0,
        cell != 0,
        sum > 0,
        after > sum,
        after > lastAmount
    ]

    // The file-scope region owns its own cell, on the same rule.
    checkAll "a top-level handler region owns its state" [
        structuralEquals [topSum, topCell, topBumps] [7, 5, 2],
        topCell != cell,
        topSum != sum,
        topCell == (2 + 3 ),
        topSum == (2 + 5 ),
        topBumps != bumps,
        topCell > 0,
        topSum > topCell
    ]

test "handler-owned state is one cell across nested calls and file scope" (exactly handlerStateThroughNestedCallsCase)

(** (4) A `handle` that names no body handles the rest of the block it sits in
    ([EFFECTS-HANDLE-REST]). Nothing has to be indented to say "from here on",
    and the region still ends where its block does — `trail` below is read after
    the handled statements, inside the same region. *)
restOfBlockCase () =
    mut trail = ""
    handle Logger
        log msg => trail := trail + "[" + msg + "]"
        debug msg => trail := trail + "(" + msg + ")"
    value = innerOp ()
    perform Logger.log "tail"
    checkAll "handle with no in" [
        value == 42,
        trail == "[inner exec](debug inner)[tail]",
        trail != ""
    ]

// A handler region that names no body still covers everything after it.
test "a handle with no `in` handles the rest of its block" (exactly restOfBlockCase)

(** A captured handler must retain its shared state when another handler calls it.
    [EFFECTS-HANDLER-VALUE-STATE] *)
effect HandlerLabel
    current : Unit => string

reportHandlerLabel () =
    label = perform HandlerLabel.current ()
    perform Logger.log label
    label

callableStateAcrossHandlersCase () =
    mut recorded = ""
    label = handler HandlerLabel
        current => "seen"
    recording = handler Logger
        log message => recorded := message
        debug _message => 0
    answer = label (\() => recording reportHandlerLabel)
    expect answer "seen"
    expect recorded "seen"

test "nested callable handlers retain one mutable capture" callableStateAcrossHandlersCase
