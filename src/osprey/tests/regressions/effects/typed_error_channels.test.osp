// Cross-contract oracle for [EFFECTS-OP-TYPING], [EFFECTS-STATIC-DISCHARGE],
// [EFFECTS-HANDLER-STATE], [TYPE-LIST], [TYPE-LIST-PATTERNS], [TYPE-MAP],
// [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], and [PATTERN-RESULT-DEFAULT].

/// --- three distinct, independent typed error channels ---
effect Parse {
    /// Supply the integer to use for unparseable `text`.
    bad: fn(string) -> int
}
effect Missing {
    /// Supply the default for the absent field `name`.
    fill: fn(string) -> int
}
effect Range {
    /// Clamp `value` into range, returning the bound it was pinned to.
    clamp: fn(int, int) -> int
}

/// The row scopes these performs; rows are not yet propagated through calls.
fn loadConfig() -> int ![Parse, Missing, Range, Arith] = {
    let port = perform Parse.bad("=80=") // Parse channel: not a number
    let timeout = perform Missing.fill("timeout") // Missing channel: key absent
    let retries = perform Range.clamp(250, 10) // Range channel: over the max
    print("assembled  -> port=${toString(port)} timeout=${toString(timeout)} retries=${toString(retries)}")
    port + timeout + retries 
}

/// This helper declares and performs only Range.
fn loadRetries(raw: int) -> (int) -> int !Range =
fn(hi) => perform Range.clamp(raw, hi)

/// No arm uses resume, so each arm value replaces its operation result.
let combined = exactArithmetic(fn() => {
    handle Parse {
        bad raw => {
            print("[Parse]    cannot parse '${raw}' -> substitute 0")
            0
        }
    }
    handle Missing {
        fill key => match key {
            "timeout" => {
                print("[Missing]  key '${key}' absent -> default 30")
                30
            }
            _ => {
                print("[Missing]  key '${key}' absent -> default 1")
                1
            }
        }
    }
    handle Range {
        clamp v hi => match v > hi {
            true => {
                print("[Range]    ${toString(v)} exceeds max ${toString(hi)} -> clamp to ${toString(hi)}")
                hi
            }
            false => {
                print("[Range]    ${toString(v)} within max ${toString(hi)} -> keep")
                v
            }
        }
    }
    let total = loadConfig()
    print("combined config total = ${toString(total)}")

    /// The inner Range handler overrides the outer handler for one call.
    let strict = {
        handle Range {
            clamp v _hi => {
                print("[Range*]   STRICT override: force ${toString(v)} -> 1")
                1
            }
        }
        loadRetries(500)(10)
    }
    print("strict retries (inner handler)  = ${toString(strict)}")

    /// Leaving the inner region restores the outer Range handler.
    let relaxed = loadRetries(500)(10)
    print("relaxed retries (outer handler) = ${toString(relaxed)}")

    total
}
)
print("final combined result = ${toString(combined)}")

fn parseUnder(raw, replacement) = {
    handle Parse {
        bad _text => replacement
    }
    perform Parse.bad(raw)
}

fn missingUnder(key) = {
    handle Missing {
        fill name => match name { "timeout" => 30 _ => 1 }
    }
    perform Missing.fill(key)
}

/// Runs `body` under the ordinary clamping Range policy.
fn clampingRange(body) = {
    handle Range {
        clamp value limit => match value > limit { true => limit false => value }
    }
    body()
}

/// Clamps `raw` to at most `high` under the ordinary policy.
fn clampUnder(raw, high) = clampingRange(fn() => loadRetries(raw)(high))

fn forceUnder(raw, high, replacement) = {
    handle Range {
        clamp _value _limit => replacement
    }
    loadRetries(raw)(high)
}

/// Applies the forced Range policy, which always yields `4`, to `raw`.
fn forcedPolicy(raw) = forceUnder(raw, 10, 4)

/// Applies the strict inner Range policy in isolation.
fn strictRangeForTest() = forceUnder(500, 10, 1)

/// Applies the ordinary clamping Range policy in isolation.
fn relaxedRangeForTest() = clampUnder(500, 10)

fn rangePolicyTrace(raw, high) = clampingRange(fn() => {
    let before = loadRetries(raw)(high)
    let strict = {
        handle Range {
            clamp _value _limit => 1
        }
        loadRetries(raw)(high)
    }
    let after = loadRetries(raw)(high)
    [before, strict, after]
})

fn traceShape(values) = match values {
    [] => "empty"
    [only] => "one:${only}"
    [first, second] => "two:${first}/${second}"
    [head, ...tail] => "many:${head}+${listLength(tail)}"
}

/// Element `index` of `values`, or `fallback` when out of range.
fn listSlot(values, index, fallback) = values.listGet(index) ?: fallback

/// Every observed fact about a Range trace: length, then elements 0..2.
fn traceFacts(values) = [listLength(values), listSlot(values, 0, 99), listSlot(values, 1, 99), listSlot(values, 2, 99)]

/// Scalar stored under `key`, or `fallback` when the key is absent.
fn mapSlot(map, key, fallback) = map.mapGet(key) ?: fallback

/// Length of the list stored under `key`, treating an absent key as empty.
fn mapListLength(map, key) = listLength(map.mapGet(key) ?: [99])

/// Element `index` of the list stored under `key`, or `fallback` when absent.
fn mapListSlot(map, key, index, fallback) = listSlot(map.mapGet(key) ?: [99], index, fallback)

/// Replays Range under two policies and checks the composed channel result.
fn typedErrorChannelCase() = {
    let trace = rangePolicyTrace(500, 10)
    let healthyTrace = rangePolicyTrace(5, 10)
    let scalars = {
        "parse": parseUnder("bad", 7),
        "missing": missingUnder("timeout"),
        "range": clampUnder(500, 10)
    }
    let nested = {
        "outer-inner-outer": trace,
        "healthy-inner-healthy": healthyTrace
    }
    let grown = mapSet(nested, "forced", [forcedPolicy(9), forcedPolicy(99)])

    checkAll("typed channel direct substitution policies", [
            structuralEquals([combined, strictRangeForTest(), relaxedRangeForTest()], [40, 1, 10]),
            structuralEquals([parseUnder("bad", 0), parseUnder("bad", 7), parseUnder("other", 99)], [0, 7, 99]),
            structuralEquals([missingUnder("timeout"), missingUnder("retries"), clampUnder(5, 10)], [30, 1, 5]),
            structuralEquals([clampUnder(10, 10), clampUnder(11, 10), clampUnder(500, 10)], [10, 10, 10]),
            structuralEquals([forcedPolicy(5), forcedPolicy(500)], [4, 4]),
            strictRangeForTest() != relaxedRangeForTest()
    ])

    checkAll("nested handlers restore outer policies around collection values", [
            structuralEquals([traceFacts(trace), traceFacts(healthyTrace)], [[3, 10, 1, 10], [3, 5, 1, 5]]),
            structuralEquals([traceShape([]), traceShape([7])], ["empty", "one:7"]),
            structuralEquals([traceShape([7, 8]), traceShape(trace)], ["two:7/8", "many:10+2"])
    ])

    checkAll("typed effect results remain coherent inside maps of lists", [
            structuralEquals([mapLength(scalars), mapSlot(scalars, "parse", 99), mapSlot(scalars, "missing", 99), mapSlot(scalars, "range", 99), mapSlot(scalars, "absent", 99)], [3, 7, 30, 10, 99]),
            structuralEquals([mapLength(nested), mapLength(grown), mapListLength(nested, "outer-inner-outer"), mapListLength(grown, "forced")], [2, 3, 3, 2]),
            structuralEquals([listLength(mapKeys(grown)), listLength(mapValues(grown))], [3, 3]),
            structuralEquals([mapListSlot(nested, "outer-inner-outer", 1, 99), mapListSlot(nested, "healthy-inner-healthy", 2, 99), mapListSlot(grown, "forced", 0, 99), mapListSlot(grown, "forced", 1, 99)], [1, 5, 4, 4]),
            !mapContains(nested, "forced"),
            mapContains(grown, "forced")
    ])
}

test("typed error channels compose and restore shadowed handlers", exactly(typedErrorChannelCase))
