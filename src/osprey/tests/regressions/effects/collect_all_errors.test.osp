// Cross-contract oracle for [EFFECTS-OP-TYPING], [EFFECTS-HANDLER-STATE],
// [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS],
// [BUILTIN-STRING-UFCS], [BUILTIN-STRING-CONTAINS], and
// [BUILTIN-STRING-INDEXOF].

effect Invalid {
    /// Report one validation failure and keep checking the rest.
    report: fn(string) -> Unit
}

/// Both branches return Unit, so validation continues after a report.
fn flag(broken, msg) !Invalid = match broken {
    true => perform Invalid.report(msg)
    false => {}
}

/// All six checks run on every call.
fn validate(name, age, score, email) !Invalid = {
    flag(name == "", "name is empty")
    flag(age < 0, "age is negative (${toString(age)})")
    flag(score < 0, "score below 0 (${toString(score)})")
    flag(score > 100, "score above 100 (${toString(score)})")
    flag(email == "", "email is empty")
    flag(email.contains("@") == false, "email is missing '@' (${email})")
    "validation pass finished"
}

/// `count` and `errs` are handler-owned mutable state.
fn audit(name, age, score, email) = {
    mut count = 0
    mut errs = ""
    let _ = {
        handle Invalid {
            report m => {
                count = count + 1 
                errs = errs + "\n    #${toString(count)} ${m}"
            }
        }
        validate(name, age, score, email)
    }
    match count == 0 {
        true => " — clean\n    => ACCEPTED (0 errors)"
        false => "${errs}\n    => REJECTED (${toString(count)} errors collected in ONE pass)"
    }
}

// (a) MULTIPLE simultaneous failures — every one reported, in field order.
exactArithmetic(fn() => print("── signup: Nadia ──" + audit("", (0 - 3) , 250, "nadia_at_example.com")))

// (b) The SAME handler shape over a fully-valid record — zero errors, happy path.
exactArithmetic(fn() => print("── signup: Owen ──" + audit("Owen", 34, 88, "owen@example.com")))

// (c) A partial failure — proves the count is exact, not all-or-nothing.
exactArithmetic(fn() => print("── signup: blank ──" + audit("", 40, 60, "")))

/// Verifies exact collection counts, order, and the zero-error branch.
fn collectAllErrorsCase() = {
    let nadia = audit("", (0 - 3) , 250, "nadia_at_example.com")
    let owen = audit("Owen", 34, 88, "owen@example.com")
    let blank = audit("", 40, 60, "")
    let onlyName = audit("", 20, 50, "name@example.com")
    let onlyAge = audit("Ari", (0 - 1) , 50, "ari@example.com")
    let onlyLowScore = audit("Ari", 20, (0 - 1) , "ari@example.com")
    let onlyHighScore = audit("Ari", 20, 101, "ari@example.com")
    let onlyMissingAt = audit("Ari", 20, 50, "ari.example.com")
    let scoreZero = audit("Zero", 0, 0, "zero@example.com")
    let scoreHundred = audit("Hundred", 0, 100, "hundred@example.com")
    let reports = [nadia, owen, blank, onlyName, onlyAge, onlyLowScore, onlyHighScore, onlyMissingAt]
    let byKind = {
        "multi": [nadia, blank],
        "clean": [owen, scoreZero, scoreHundred],
        "single": [onlyName, onlyAge, onlyLowScore, onlyHighScore, onlyMissingAt]
    }

    checkAll("multi-error validation preserves exact order and count", [
            containsAll(nadia, ["#1 name is empty", "#2 age is negative (-3)", "#3 score above 100 (250)", "#4 email is missing '@'", "REJECTED (4 errors"]),
            containsNone(nadia, ["score below 0", "email is empty"]),
            (indexOf(nadia, "#1 name") ?: 999) < (indexOf(nadia, "#2 age") ?: 999),
            (indexOf(nadia, "#2 age") ?: 999) < (indexOf(nadia, "#3 score") ?: 999),
            (indexOf(nadia, "#3 score") ?: 999) < (indexOf(nadia, "#4 email") ?: 999),
            contains(owen, "ACCEPTED (0 errors)"),
            containsAll(blank, ["#1 name is empty", "#2 email is empty", "#3 email is missing '@'", "REJECTED (3 errors"]),
            (indexOf(blank, "#1 name") ?: 999) < (indexOf(blank, "#2 email") ?: 999),
            (indexOf(blank, "#2 email") ?: 999) < (indexOf(blank, "#3 email") ?: 999)
    ])

    checkAll("single failures and inclusive boundaries remain independent", [
            containsAll(onlyName, ["#1 name is empty", "REJECTED (1 errors"]),
            containsAll(onlyAge, ["#1 age is negative (-1)", "REJECTED (1 errors"]),
            containsAll(onlyLowScore, ["#1 score below 0 (-1)", "REJECTED (1 errors"]),
            containsAll(onlyHighScore, ["#1 score above 100 (101)", "REJECTED (1 errors"]),
            containsAll(onlyMissingAt, ["#1 email is missing '@'", "REJECTED (1 errors"]),
            contains(scoreZero, "ACCEPTED (0 errors)"),
            contains(scoreHundred, "ACCEPTED (0 errors)"),
            structuralEquals([contains(scoreZero, "REJECTED"), contains(scoreHundred, "REJECTED")], [false, false])
    ])

    checkAll("validation reports retain strings inside nested collections", [
            structuralEquals([listLength(reports), mapLength(byKind)], [8, 3]),
            listLength(byKind.mapGet("multi") ?: ["missing"]) == 2,
            listLength(byKind.mapGet("clean") ?: ["missing"]) == 3,
            structuralEquals([listLength(byKind.mapGet("single") ?: ["missing"]), listLength(mapKeys(byKind))], [5, 3]),
            listLength(mapValues(byKind)) == 3,
            (reports.listGet(0) ?: "missing").contains("REJECTED (4 errors"),
            (reports.listGet(1) ?: "missing").contains("ACCEPTED (0 errors)"),
            (reports.listGet(7) ?: "missing").contains("missing '@'"),
            ((byKind.mapGet("multi") ?: ["missing"]).listGet(1) ?: "missing").contains("REJECTED (3 errors"),
            ((byKind.mapGet("clean") ?: ["missing"]).listGet(2) ?: "missing").contains("ACCEPTED (0 errors)"),
            ((byKind.mapGet("single") ?: ["missing"]).listGet(3) ?: "missing").contains("score above 100"),
            !mapContains(byKind, "missing")
    ])
}

test("validation collects every error in field order", exactly(collectAllErrorsCase))
