/// A generic handler VALUE invoked with a callback whose result type is still
/// generic is specialised at each call site, like any generic function. The
/// `with`-suite closure's Result error channel is phantom — the Error variant
/// stores a string message — so a still-open error variable no longer keeps
/// the closure generic, and one `checked` serves every result type. Implements
/// [TYPE-FN-CLOSURE] and [EFFECTS-HANDLER-VALUE].

effect Fault { control halt: fn(string) -> int }

let halting = handler Fault {
    halt fault => Error { message: fault }
}

fn checked(work) = halting(fn() => Success { value: work() })

print(toString(checked(fn() => "ok")))
print(toString(checked(fn() => 7)))
print(toString(checked(fn() => 1.5)))
print(toString(checked(fn() => perform Fault.halt("boom"))))
