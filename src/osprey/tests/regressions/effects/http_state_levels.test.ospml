effect Db
    (** Append a task and return its new id. *)
    add : string => int
    (** Render the current task table. *)
    list : Unit => string
    (** Count the tasks currently stored. *)
    count : Unit => int

effect Metrics
    (** Record one served request for `route`. *)
    hit : string => Unit
    (** Read the total requests served since boot. *)
    served : Unit => int

effect Persist
    (** Durably write a snapshot, returning the number of bytes written. *)
    flush : string => int
    (** Read how many bytes the last flush wrote. *)
    bytes : Unit => int

effect Log
    (** Record an informational `message` about server activity. *)
    info : string => Unit

textResp (status, bodyText) = HttpResponse(status = status, headers = "Content-Type: text/plain", contentType = "text/plain", streamFd = (0 - 1) , isComplete = true, partialBody = bodyText)

onPost body =
    id = perform Db.add body
    snap = perform Db.list ()
    written = perform Persist.flush snap
    textResp (201, "created task #${toString id} (${toString written}B persisted)")

onGet path = match path
    "/stats" => textResp (200, "requests=${toString (perform Metrics.served ())} tasks=${toString (perform Db.count ())}")
    _        => textResp (200, perform Db.list ())

handleReq : (string, string, string, string) -> HttpResponse
handleReq (method, path, _headers, body) =
    perform Metrics.hit path
    match method
        "POST" => onPost body
        _      => onGet path

bodyOf h = match httpResponseBody h
    Success value => value
    Error _message => "(no body)"

readAndFree h =
    b = bodyOf h
    _freed = httpResponseFree h
    b

fetch (clientId, path) = match httpGetResponse clientId path ""
    Success value => readAndFree value
    Error _message => "GET failed"

postTask (clientId, text) =
    perform Log.info "POST /tasks <- ${text}"
    print ("  server replied ${toString (httpPost clientId "/tasks" text "" ?: -1)}")

seedTask text = perform Db.add text

runDemo () =
    serverId = httpCreateServer 18280 "127.0.0.1" ?: -1
    listening = match httpListen serverId handleReq
        Success _ => "server up on :18280"
        Error message => "cannot listen on :18280: ${message}"
    clientId = httpCreateClient "http://127.0.0.1:18280" 5000 ?: -1
    print listening
    seeded = await (spawn (seedTask "welcome to osprey"))
    print "seeded task #${toString seeded} from a background fiber"
    postTask (clientId, "buy oat milk")
    postTask (clientId, "land the effects PR")
    listing = fetch (clientId, "/tasks")
    print "--- GET /tasks ---\n${listing}--- end ---"
    print "GET /stats -> ${fetch (clientId, "/stats")}"
    _stopped = httpStopServer serverId ?: -1
    print "STATE @ shutdown — db: ${toString (perform Db.count ())} tasks | server: ${toString (perform Metrics.served ())} requests | disk: ${toString (perform Persist.bytes ())} bytes"
mut diskBytes = 0
mut requests = 0
mut tasks = ""
mut taskCount = 0

_ =
    exactArithmetic (\() =>
        handle Persist
            flush snap =>
                (** Relative, so it lands in the temporary working directory the test run
                    gets. What the assertions need is a name no other case writes.
                    [BUILTIN-FILE-ERRMSG] [TESTING-CLI-RUN-SCRATCH] *)
                saved = writeFile "osprey_http_state_levels.db" snap
                diskBytes := match saved
                    Success _value => length snap
                    // Say WHY [BUILTIN-FILE-ERRMSG]. Storing a bare -1 here is how a
                    // failed persist reached the assertions as "expected true, got
                    // false", with the operating system's own explanation discarded.
                    Error message =>
                        print "[persist] ${message}"
                        0 - 1 
                diskBytes
            bytes => diskBytes
        handle Metrics
            hit _p      =>
                requests := requests + 1 
            served     => requests
        handle Db
            add t =>
                taskCount := taskCount + 1 
                tasks := "${tasks}#${toString taskCount} ${t}\n"
                taskCount
            list  => tasks
            count => taskCount
        handle Log
            info m => print "[client] ${m}"
        runDemo ()
        0)

// Verify state mutated through the live server, client, and background fiber.

test "HTTP requests update every handled state layer" (\() => exactArithmetic ((\() => checkAll "HTTP state levels" [
    taskCount == 3,
    requests == 4,
    diskBytes == 60,
    containsAll tasks ["#1 welcome to osprey", "#3 land the effects PR"]
])))
