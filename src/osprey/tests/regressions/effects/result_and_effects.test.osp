
// Cross-contract oracle for [ARITH-CHECKED], [PATTERN-RESULT-DEFAULT],
// [ERR-PAYLOAD], [EFFECTS-OP-TYPING], [EFFECTS-HANDLER-STATE], [TYPE-LIST],
// [TYPE-MAP], [TYPE-MAP-LOOKUP], and [BUILTIN-STRING-UFCS].

effect Rescue {
    /// Supply the integer a failed operation should yield instead.
    onErr: fn(string) -> int
}

let RESCUED_DEFAULT = 100

/// Bridge arithmetic requests to the application's existing Rescue capability.
fn arithmeticRescue(work) = {
    handle Arith {
        overflow _ _ _ _ => perform Rescue.onErr("integer overflow")
        remainderByZero _ => perform Rescue.onErr("division by zero")
    }
    work()
}
fn divRescue(a, b) = arithmeticRescue(fn() => intDiv(a, b))
fn modRescue(a, b) = arithmeticRescue(fn() => a % b)

fn integerDefault(value, work) = {
    handle Arith { remainderByZero _ => value }
    work()
}
fn floatDefault(work) = {
    handle Arith { divideByZero op lhs => {
        checkAll("float fault payload", [op == "/", lhs == 10.0])
        -1.0
    } }
    work()
}

/// checkedAdd is overflow-checked: MAX_INT + 1 => Error(integer overflow).
fn addRescue(a, b) = match checkedAdd(a: a, b: b) {
    Success { value } => value
    Error { message } => perform Rescue.onErr(message)
}

/// The cell at `index` of the list stored under `key`, or the 99/0 fallbacks.
fn cellAt(listsBy, key, index) = listGet(mapGet(listsBy, key) ?: [99], index) ?: 99

fn recoveredValues(fallback) = {
    handle Rescue {
        onErr _message => fallback
    }
    [
        divRescue(10, 0),
        divRescue(20, 4),
        modRescue(7, 0),
        modRescue(17, 5),
        addRescue(9223372036854775807, 1),
        addRescue(100, 23)
    ]
}

/// Publishes one step's outcome, then hands its value back for the total.
fn stepLine(prefix, value) = {
    print("${prefix}${toString(value)}")
    value
}

/// Every failed step receives a replacement value, so later steps still run.
fn pipeline() = foldList([
        stepLine("  step a  intDiv 10 / 0   -> ", divRescue(10, 0)),
        stepLine("  step b  intDiv 20 / 4   -> ", divRescue(20, 4)),
        stepLine("  step c  7 % 0           -> ", modRescue(7, 0)),
        stepLine("  step d  17 % 5          -> ", modRescue(17, 5)),
        stepLine("  step e  MAX + 1         -> ", addRescue(9223372036854775807, 1)),
        stepLine("  step f  100 + 23        -> ", addRescue(100, 23))
    ], 0, fn(sum, value) => sum + value)

print("=== Result -> effect rescue pipeline ===")

/// [EFFECTS-HANDLER-STATE] The handler owns its rescue count; each arm value is
/// substituted at the perform site because this region contains no `resume`.
mut rescues = 0
let total = exactArithmetic(fn() => {
    handle Rescue {
        onErr message => {
            rescues = rescues + 1 
            print("  RESCUE #${toString(rescues)}: original error \"${message}\" -> using ${toString(RESCUED_DEFAULT)}")
            RESCUED_DEFAULT
        }
    }
    pipeline()
})

print("rescued ${toString(rescues)} failing step(s); healthy + rescued total = ${toString(total)}")

/// A local Arith policy supplies a replacement without invoking Rescue.
let localOk = integerDefault(-1, fn() => 10 % 3)
let localBad = integerDefault(-1, fn() => 10 % 0)
print("local remainder policy  10 % 3 -> ${toString(localOk)}   10 % 0 -> ${toString(localBad)}")

// Floating division is recovered by an explicit value policy.
print("float policy for 10 / 0 = ${toString(floatDefault(fn() => 10 / 0))}\n=== pipeline complete ===")

/// Verifies rescued failures beside healthy Result, nested collections, and local fallbacks.
fn resultAndEffectsCase() = {
    let hundreds = recoveredValues(100)
    let sevens = recoveredValues(7)
    let negatives = recoveredValues((0 - 1) )
    let policyMatrix = [hundreds, sevens, negatives]
    let policyMap = { "hundred": hundreds, "seven": sevens, "negative": negatives }
    let grownMap = mapSet(policyMap, "zero", recoveredValues(0))
    let bareSuccess = match checkedSub(2, 1) { Success { value } => value Error => 0 }
    let bareError = match checkedAdd(9223372036854775807, 1) { Success => 7 Error => 9 }
    let boundResult = match checkedSub(2, 1) {
        Error => 0
        whole => match whole { Success { value } => value Error => 0 }
    }

    checkAll("Result and effect pipeline state", [
            answersHold(fn(value) => value, [bareSuccess, bareError, boundResult, rescues, total, localOk, localBad], [1, 9, 1, 3, 430, 1, ((0 - 1) )]),
            toString(floatDefault(fn() => 10 / 0)) == "-1.0",
            answersHold(fn(work) => integerDefault(-1, work), [fn() => intDiv(20, 4), fn() => intDiv(20, 0), fn() => 17 % 5, fn() => 17 % 0], [5, ((0 - 1) ), 2, ((0 - 1) )]),
            (checkedAdd(100, 23) ?: 0) == 123,
            (checkedAdd(9223372036854775807, 1) ?: 77) == 77,
            answersHold(fn(shown) => shown, [toString(intDiv(20, 4)), toString(integerDefault(-1, fn() => intDiv(20, 0))), toString(checkedAdd(9223372036854775807, 1))], ["5", "-1", "Error(integer overflow)"])
    ])

    checkAll("each Rescue policy replaces only failing collection elements", [
            structuralEquals([hundreds, sevens], [[100, 5, 100, 2, 100, 123], [7, 5, 7, 2, 7, 123]]),
            (hundreds.listGet(9) ?: 99) == 99,
            answersHold(fn(index) => negatives.listGet(index) ?: 99, [0, 4], [((0 - 1) ), ((0 - 1) )])
    ])

    checkAll("recovered lists retain element types inside nested maps", [
            listLength(policyMatrix) == 3,
            listLength(policyMatrix.listGet(0) ?: [99]) == 6,
            answersHold(fn(row) => row.listGet(4) ?: 99, policyMatrix, [100, 7, ((0 - 1) )]),
            answersHold(fn(by) => mapLength(by), [policyMap, grownMap], [3, 4]),
            listLength(policyMap.mapGet("hundred") ?: [99]) == 6,
            answersHold(fn(at) => cellAt(policyMap, ["hundred", "seven", "negative"].listGet(at) ?: "", [0, 2, 4].listGet(at) ?: 0), [0, 1, 2], [100, 7, ((0 - 1) )]),
            cellAt(grownMap, "zero", 0) == 0,
            answersHold(fn(by) => mapContains(by, "zero"), [policyMap, grownMap], [false, true]),
            listLength(mapKeys(grownMap)) == 4,
            listLength(mapValues(grownMap)) == 4
    ])
}

test("fallible arithmetic is recovered without masking healthy results", exactly(resultAndEffectsCase))
