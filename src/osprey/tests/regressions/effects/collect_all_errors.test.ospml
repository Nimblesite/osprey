(** Cross-contract oracle for [EFFECTS-OP-TYPING], [EFFECTS-HANDLER-STATE],
    [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS],
    [BUILTIN-STRING-CONTAINS], [BUILTIN-STRING-INDEXOF], [FLAVOR-ML-LIST],
    and [FLAVOR-ML-MAP]. Invalid.report returns Unit through direct
    substitution, allowing every validation check to run. *)

effect Invalid
    (** Report one validation failure and keep checking the rest. *)
    report : string => Unit

(** Both branches return Unit, so validation continues after a report. *)
flag (broken, msg) = match broken
    true => perform Invalid.report msg
    false =>
        (** A binding-only layout block evaluates to Unit in ML flavor. *)
        _unchanged = broken

(** Reports `msg` together with the offending value when `outside` holds. *)
flagged (outside, msg, value) = flag (outside, "${msg} (${toString value})")

(** All six checks run on every call. *)
validate (name, age, score, email) =
    flag (name == "", "name is empty")
    flagged (age < 0, "age is negative", age)
    flagged (score < 0, "score below 0", score)
    flagged (score > 100, "score above 100", score)
    flag (email == "", "email is empty")
    flag (contains email "@" == false, "email is missing '@' (${email})")
    "validation pass finished"

(** `count` and `errs` are handler-owned mutable state. *)
audit (name, age, score, email) =
    mut count = 0
    mut errs = ""
    _ =
        handle Invalid
            report m =>
                count := count + 1 
                errs := errs + "\n    #${toString count} ${m}"
        validate (name, age, score, email)
    match count == 0
        true => " — clean\n    => ACCEPTED (0 errors)"
        false => "${errs}\n    => REJECTED (${toString count} errors collected in ONE pass)"

(** Prints one signup label and the report its record collects. *)
signup (label, name, age, score, email) = exactArithmetic (\() =>
    print ("── signup: ${label} ──" + audit (name, age, score, email)))

(** Whether every consecutive pair in `parts` is reported in that order. *)
inOrder (report, parts) = match parts
    [first, second, ...rest] => ((indexOf report first ?: 999) < (indexOf report second ?: 999)) && inOrder (report, [second] + rest)
    _ => true

(** The `index`th report in `rows`, or a sentinel when it is absent. *)
reportAt (rows, index) = listGet rows index ?: "missing"

(** How many reports are filed under `kind`. *)
kindSize (byKind, kind) = listLength (mapGet byKind kind ?: ["missing"])

(** The `index`th report filed under `kind`, or a sentinel when it is absent. *)
kindReport (byKind, kind, index) = reportAt (mapGet byKind kind ?: ["missing"], index)

(** A report with one failure names its first error and counts exactly one. *)
rejectedOnce (report, first) = containsAll report [first, "REJECTED (1 errors"]

// (a) MULTIPLE simultaneous failures — every one reported, in field order.
signup ("Nadia", "", (0 - 3) , 250, "nadia_at_example.com")

// (b) The SAME handler shape over a fully-valid record — zero errors, happy path.
signup ("Owen", "Owen", 34, 88, "owen@example.com")

// (c) A partial failure — proves the count is exact, not all-or-nothing.
signup ("blank", "", 40, 60, "")

(** Verify exact collection counts, order, and the zero-error branch. *)
collectAllErrorsCase () =
    nadia = audit ("", (0 - 3) , 250, "nadia_at_example.com")
    owen = audit ("Owen", 34, 88, "owen@example.com")
    blank = audit ("", 40, 60, "")
    onlyName = audit ("", 20, 50, "name@example.com")
    onlyAge = audit ("Ari", (0 - 1) , 50, "ari@example.com")
    onlyLowScore = audit ("Ari", 20, (0 - 1) , "ari@example.com")
    onlyHighScore = audit ("Ari", 20, 101, "ari@example.com")
    onlyMissingAt = audit ("Ari", 20, 50, "ari.example.com")
    scoreZero = audit ("Zero", 0, 0, "zero@example.com")
    scoreHundred = audit ("Hundred", 0, 100, "hundred@example.com")
    reports = [nadia, owen, blank, onlyName, onlyAge, onlyLowScore, onlyHighScore, onlyMissingAt]
    byKind = [
        "multi" => [nadia, blank],
        "clean" => [owen, scoreZero, scoreHundred],
        "single" => [onlyName, onlyAge, onlyLowScore, onlyHighScore, onlyMissingAt]
    ]

    checkAll "multi-error validation preserves exact order and count" [
        containsAll nadia ["#1 name is empty", "#2 age is negative (-3)", "#3 score above 100 (250)", "#4 email is missing '@'", "REJECTED (4 errors"],
        containsNone nadia ["score below 0", "email is empty"],
        inOrder (nadia, ["#1 name", "#2 age", "#3 score", "#4 email"]),
        contains owen "ACCEPTED (0 errors)",
        containsAll blank ["#1 name is empty", "#2 email is empty", "#3 email is missing '@'", "REJECTED (3 errors"],
        inOrder (blank, ["#1 name", "#2 email", "#3 email"])
    ]

    checkAll "single failures and inclusive boundaries remain independent" [
        rejectedOnce (onlyName, "#1 name is empty"),
        rejectedOnce (onlyAge, "#1 age is negative (-1)"),
        rejectedOnce (onlyLowScore, "#1 score below 0 (-1)"),
        rejectedOnce (onlyHighScore, "#1 score above 100 (101)"),
        rejectedOnce (onlyMissingAt, "#1 email is missing '@'"),
        contains scoreZero "ACCEPTED (0 errors)",
        contains scoreHundred "ACCEPTED (0 errors)",
        !(contains scoreZero "REJECTED"),
        !(contains scoreHundred "REJECTED")
    ]

    checkAll "validation reports retain strings inside nested collections" [
        structuralEquals [listLength reports, mapLength byKind] [8, 3],
        kindSize (byKind, "multi") == 2,
        kindSize (byKind, "clean") == 3,
        structuralEquals [kindSize (byKind, "single"), listLength (mapKeys byKind)] [5, 3],
        listLength (mapValues byKind) == 3,
        contains (reportAt (reports, 0)) "REJECTED (4 errors",
        contains (reportAt (reports, 1)) "ACCEPTED (0 errors)",
        contains (reportAt (reports, 7)) "missing '@'",
        contains (kindReport (byKind, "multi", 1)) "REJECTED (3 errors",
        contains (kindReport (byKind, "clean", 2)) "ACCEPTED (0 errors)",
        contains (kindReport (byKind, "single", 3)) "score above 100",
        !(mapContains byKind "missing")
    ]

test "validation collects every error in field order" (exactly collectAllErrorsCase)
