// #287: A function that calls a later generic function is itself generalized.

fn order(a, b) = if a < b { -1 } else { after(a, b) }
fn after(a, b) = if a > b { 1 } else { 0 }
print("${order(1, 2)}\n${order("a", "b")}")

/// #393: a record built from another record's fields keeps its string field
/// when the generic function that builds it is passed by name.
fn labelled(r) = "${r.label}=${r.v}"
fn rebuilt(row) = labelled({ label: row.label, v: row.i })
fn printRebuilt(row) = print("rebuilt     -> ${rebuilt(row)}")

let rows = [{ label: "byteAt1", i: 1 }, { label: "cpWidth", i: 2 }]
forEachList(rows, printRebuilt)
print("mapped rows -> ${join(mapList(rows, rebuilt), " | ")}\nkept rows   -> ${join(mapList(filterList(rows, |row| => row.i > 1), rebuilt), " | ")}")
