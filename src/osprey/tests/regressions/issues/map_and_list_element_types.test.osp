// #211: mapGet and listGet return values, never raw storage words.

/// [MEM-OWNERSHIP-STATIC-SHARING] The absent removal keeps the managed value
/// usable through the next successful removal and lookup.
fn afterRemovals() = {
    /// These distinct keys share a 32-bit FNV hash. Replace one collision entry.
    let entries = mapSet(mapSet(Map(), "keyktfa", "first"), "key51wu", "temporary")
    let populated = mapSet(entries, "keyktfa", "he" + "ap")
    mapRemove(mapRemove(populated, "absent"), "key51wu")
}
let ms = afterRemovals()
print("map string  -> ${mapGet(ms, "keyktfa")}")
let mf = mapSet(Map(), "k", 1.5)
print("map float   -> ${mapGet(mf, "k")}")
let mb = mapSet(Map(), "k", true)
print("map bool    -> ${mapGet(mb, "k")}")
let mi = mapSet(Map(), "k", 42)
print("map int     -> ${mapGet(mi, "k")}\nlist string -> ${listGet(listAppend(List(), "he" + "ap"), 0) ?: "missing"}\nlist float  -> ${listGet(listAppend(List(), 1.5), 0) ?: 0.0}")

/// Input to the #419 regression, which checks that a Result held in a list keeps its tag and payload.
type Box = { n: int }

fn checked(b) = match b.n == 0 {
    true => Error { message: "diverged at ${b.n}" }
    false => Success { value: b.n }
}

fn shown(outcome) = match outcome {
    Error { message } => "error ${message}"
    Success { value } => "ok ${value}"
}

fn joined(outcomes) = join(mapList(outcomes, shown), " | ")

let built = [checked(Box { n: 4 }), checked(Box { n: 0 }), checked(Box { n: 7 })]
forEachList(built, |r| => print("list result -> ${shown(r)}"))
print("literal     -> ${joined([Error { message: "plain" }, Success { value: 2 }])}\nmapped      -> ${joined(built)}\nindexed     -> ${shown(listGet(built, 1) ?: Success { value: 9 })} ${shown(listGet(built, 2) ?: Success { value: 9 })} ${shown(listGet(built, 5) ?: Success { value: 9 })}")

/// #393: a record built from another record's fields keeps its string field
/// when the generic function that builds it is passed by name.
fn labelled(r) = "${r.label}=${r.v}"
fn rebuilt(row) = labelled({ label: row.label, v: row.i })
fn printRebuilt(row) = print("rebuilt     -> ${rebuilt(row)}")

let rows = [{ label: "byteAt1", i: 1 }, { label: "cpWidth", i: 2 }]
forEachList(rows, printRebuilt)
print("mapped rows -> ${join(mapList(rows, rebuilt), " | ")}\nkept rows   -> ${join(mapList(filterList(rows, |row| => row.i > 1), rebuilt), " | ")}")
