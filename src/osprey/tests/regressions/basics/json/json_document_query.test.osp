// JSON's six primitive value kinds form a recursive tagged union. Objects map
// names to JsonValue and arrays contain JsonValue, so traversal narrows every
// node with `match` before descending to the next level.

type JsonValue =
    JsonNull
    | JsonBoolean { value: bool }
    | JsonNumber { value: int }
    | JsonString { value: string }
    | JsonArray { values: List<JsonValue> }
    | JsonObject { fields: Map<string, JsonValue> }

fn describe(value) = match value {
    JsonNull => "null"
    JsonBoolean(_value) => "boolean"
    JsonNumber(_value) => "number"
    JsonString(_value) => "string"
    JsonArray(_values) => "array"
    JsonObject(_fields) => "object"
}

/// This is a recursive JSON walk: match the object/array container, then pass
/// each nested JsonValue to the same matcher. The document below has one root
/// field, making the path and its output deterministic.
fn reportDeepString(value) = match value {
    JsonObject { fields } => forEachList(mapValues(fields), reportDeepString)
    JsonArray { values } => forEachList(values, reportDeepString)
    JsonString { value } => print("deeply nested string = ${value}")
    JsonNull => print("unexpected null")
    JsonBoolean(_value) => print("unexpected boolean")
    JsonNumber(_value) => print("unexpected number")
}

let deepestValue = JsonString { value: "devon@osprey.dev" }
let innerArray = JsonArray { values: List() |> listAppend(deepestValue) }
let outerArray = JsonArray { values: List() |> listAppend(innerArray) }
let document = JsonObject { fields: Map() |> mapSet("workspace", outerArray) }

print("=== JSON value union ===")
match document {
    JsonObject { fields } => print("root is ${describe(document)} with ${toString(mapLength(fields))} field")
    _ => print("root is not an object")
}
reportDeepString(document)
print("types: ${describe(JsonNull)}, ${describe(JsonBoolean { value: true })}, ${describe(JsonNumber { value: 17 })}, ${describe(deepestValue)}, ${describe(outerArray)}, ${describe(document)}")
print("=== JSON value union complete ===")

/// Recursively follows the single object/array path to its string leaf.
fn deepString(value) = match value {
    JsonObject { fields } => match mapGet(fields, "workspace") {
        Success { value } => deepString(value)
        Error => ""
    }
    JsonArray { values } => match listGet(values, 0) {
        Success { value } => deepString(value)
        Error => ""
    }
    JsonString { value } => value
    _ => ""
}

/// Counts object fields while returning zero for non-object values.
fn objectFieldCount(value) = match value {
    JsonObject { fields } => mapLength(fields)
    _ => 0
}

/// Traverses the module's recursive document under the test runner, reusing
/// the value the walk above already built.
fn jsonDocumentCase() = {
    reportDeepString(document)
    checkAll("recursive JSON document", [
        structuralEquals([describe(JsonNull), describe(JsonBoolean { value: true })], ["null", "boolean"]),
        structuralEquals([describe(JsonNumber { value: 17 }), describe(deepestValue)], ["number", "string"]),
        structuralEquals([describe(outerArray), describe(document)], ["array", "object"]),
        structuralEquals([deepString(document), deepString(JsonNull)], ["devon@osprey.dev", ""]),
        objectFieldCount(document) == 1
    ])
}
test("recursive JSON traversal preserves the nested value", jsonDocumentCase)

let noScalar = "<none>"
let notAContainer = -1
let notReleased = -1

/// Reads one scalar by path, or a marker when the path names no scalar.
fn scalarAt(doc, path) = jsonGet(doc, path) ?: noScalar

/// Releases `doc` once and checks what a released handle must show: the
/// release succeeds, a scalar and a container path answer nothing, and a
/// second release is refused.
fn checkReleased(label, doc, scalarPath, containerPath) = checkAll(label, [
    (jsonFree(doc) ?: notReleased) == 0,
    scalarAt(doc, scalarPath) == noScalar,
    jsonLength(doc, containerPath) == notAContainer,
    (jsonFree(doc) ?: notReleased) == notReleased
])

/// Parses a document with the built-in JSON functions, reads scalars and
/// lengths by path, then releases the handle exactly once. [BUILTIN-JSON]
fn parsedDocumentCase() = match jsonParse("{\"owner\":\"devon\",\"tags\":[\"a\",\"b\",\"c\"],\"active\":true,\"stars\":17}") {
    Success { value } => {
        checkAll("built-in JSON document", [
            structuralEquals([scalarAt(value, "owner"), scalarAt(value, "tags[1]")], ["devon", "b"]),
            structuralEquals([scalarAt(value, "active"), scalarAt(value, "stars")], ["true", "17"]),
            scalarAt(value, "tags") == noScalar, scalarAt(value, "absent") == noScalar,
            structuralEquals([jsonLength(value, ""), jsonLength(value, "tags")], [4, 3])
        ])
        checkReleased("built-in JSON document", value, "owner", "owner")
    }
    Error => checkAll("built-in JSON document", [false])
}
test("built-in JSON functions parse, query and release a document", parsedDocumentCase)

/// Answers the value a released document produced, or the marker when the
/// release itself failed.
fn released(doc, value) = match (jsonFree(doc) ?: notReleased) {
    0 => value
    _ => noScalar
}

/// Parses text and releases it again, answering whether it parsed.
fn parses(text) = match jsonParse(text) {
    Success { value } => (jsonFree(value) ?: notReleased) == 0
    Error => false
}

/// Answers whether every text in `texts` is one complete document.
fn allParse(texts) = foldList(texts, true, fn(okay, text) => okay && parses(text))

/// Answers whether no text in `texts` is a complete document.
fn noneParse(texts) = foldList(texts, true, fn(okay, text) => okay && !parses(text))

/// Parses text, reads one scalar by path, and releases the handle.
fn textAt(text, path) = match jsonParse(text) {
    Success { value } => released(value, jsonGet(value, path) ?: noScalar)
    Error => noScalar
}

/// Reads back a raw number token stored as the only field of an object.
fn numberText(raw) = textAt("{\"v\":${raw}}", "v")

/// A number token is refused inside an array and inside an object alike, so
/// no token in `raws` may parse.
fn refusedNumbers(raws) = foldList(raws, true, fn(okay, raw) => okay && !parses("[${raw}]") && !parses("{\"v\":${raw}}"))

/// The decoded value of a JSON string literal whose body is `body`.
fn decoded(body) = textAt("{\"v\":\"${body}\"}", "v")

/// A JSON string literal whose body is `body` makes the document malformed,
/// so no body in `bodies` may parse.
fn refusedStrings(bodies) = foldList(bodies, true, fn(okay, body) => okay && !parses("{\"v\":\"${body}\"}"))

/// A single code point as a string, for control characters a literal cannot spell.
fn ctl(codePoint) = fromCodePoint(codePoint) ?: noScalar

/// Numbers accept RFC 8259's grammar and nothing else, and read back as the
/// exact source text. [BUILTIN-JSON-NUMBER]
fn jsonNumberCase() = {
    checkAll("RFC 8259 numbers are accepted", [
        allParse(["0", "-0", "17", "-17", "0.5", "-0.5", "1e5", "1E5", "1e+5", "1e-5", "1.25e-3", "[0,-0,1.5e10,-2E-2]"])
    ])
    checkAll("a number reads back as its source text", [
        structuralEquals([numberText("1.50"), numberText("-0"), numberText("1E+05")], ["1.50", "-0", "1E+05"]),
        numberText("2.5e-3") == "2.5e-3",
        numberText("123456789012345678901234567890") == "123456789012345678901234567890",
        structuralEquals([numberText("0"), textAt("17", ""), textAt("-0.25", "")], ["0", "17", "-0.25"])
    ])
    checkAll("every non-RFC number makes the document malformed", [
        refusedNumbers(["-", "+1", ".5", "1.", "1.e5", "1e", "1e+", "1E-", "--1", "1..2", "01", "-01", "00", "0x1F", "NaN", "Infinity", "-Infinity", "1_000", "1e5.5", "- 1"])
    ])
    checkAll("a complete root number followed by more text is refused", [
        noneParse(["01", "1 2", "1.5.5", "-", "+1", "1."]),
        numberText("01") == noScalar
    ])
}
test("JSON numbers follow RFC 8259 and keep their source text", jsonNumberCase)

/// Strings decode exactly RFC 8259's escapes, pair surrogates, and refuse
/// every other escape, lone surrogate, raw control character and NUL.
/// [BUILTIN-JSON-STRING]
fn jsonStringCase() = {
    checkAll("the eight short escapes decode", [
        structuralEquals([decoded("a\\\"b"), decoded("a\\\\b"), decoded("a\\/b")], ["a\"b", "a\\b", "a/b"]),
        structuralEquals([decoded("a\\nb"), decoded("a\\tb"), decoded("a\\rb")], ["a\nb", "a\tb", "a\rb"]),
        decoded("\\b") == ctl(8), decoded("\\f") == ctl(12)
    ])
    checkAll("unicode escapes and literal UTF-8 decode to their scalars", [
        structuralEquals([decoded("\\u0041"), decoded("\\u00e9"), decoded("\\u00E9")], ["A", "é", "é"]),
        structuralEquals([decoded("\\u20AC"), decoded("\\uD83E\\uDD85"), decoded("é🦅")], ["€", "🦅", "é🦅"]),
        structuralEquals([decoded(""), decoded("plain")], ["", "plain"]),
        byteLength(decoded("\\uD83E\\uDD85")) == 4,
        decoded("\\u0001") == ctl(1), decoded("\\u001F") == ctl(31),
        decoded(ctl(127)) == ctl(127)
    ])
    checkAll("any other escape is refused, never taken literally", [
        refusedStrings(["\\a", "\\x41", "\\'", "\\0", "\\U0041", "\\e", "\\ ", "\\"])
    ])
    checkAll("a unicode escape needs exactly four hex digits", [
        refusedStrings(["\\u", "\\u1", "\\u12", "\\u123", "\\u12G4", "\\uXYZW"])
    ])
    checkAll("surrogates must arrive as a high-low pair", [
        refusedStrings(["\\uD83E", "\\uD83Ex", "\\uD83E\\u0041", "\\uD83E\\uD83E", "\\uDD85", "\\uDD85\\uD83E", "a\\uDC00b"])
    ])
    checkAll("NUL and raw control characters are refused", [
        refusedStrings(["\\u0000", "a\\u0000b", ctl(1), ctl(9), ctl(10), ctl(13), ctl(31), "a${ctl(10)}b"])
    ])
}
test("JSON strings decode RFC 8259 escapes and refuse everything else", jsonStringCase)

/// A document is one complete value, parsed whole or refused whole.
/// [BUILTIN-JSON-STRING]
fn jsonDocumentShapeCase() = {
    checkAll("every complete value parses, whitespace around it included", [
        allParse(["{}", "[]", " {\"a\":1} ", "true", "false", "null", "\"text\"", "[[],{},[{}]]"]),
        structuralEquals([textAt("\"text\"", ""), textAt("true", "")], ["text", "true"]),
        structuralEquals([textAt("null", ""), textAt("false", "")], ["null", "false"])
    ])
    checkAll("empty, trailing, unseparated and unterminated documents are refused", [
        noneParse(["", "   ", "{\"a\":1} x", "{\"a\":1}{}", "[1] [2]", "{\"a\":1 \"b\":2}", "[1 2]",
            "{\"a\" 1}", "{\"a\":1,}", "[1,]", "[,1]", "{\"a\":1", "[1,2", "\"abc", "{a:1}",
            "{'a':1}", "tru", "nul", "True", "{\"a\":}", "{,}", "]", "}"])
    ])
}
test("a JSON document parses whole or is refused whole", jsonDocumentShapeCase)

let nested = "{\"user\":{\"name\":\"devon\",\"items\":[{\"name\":\"talon\"},{\"name\":\"wing\"}],\"empty\":[],\"none\":{},\"flag\":false,\"nothing\":null}}"

/// Paths reach nested scalars, containers answer lengths, and a released or
/// invalid handle answers nothing. [BUILTIN-JSON]
fn jsonPathCase() = {
    match jsonParse(nested) {
        Success { value } => {
            checkAll("a live document answers every path", [
                value > 0,
                scalarAt(value, "user.name") == "devon",
                scalarAt(value, "user.items[0].name") == "talon",
                scalarAt(value, "user.items[1].name") == "wing",
                structuralEquals([scalarAt(value, "user.flag"), scalarAt(value, "user.nothing")], ["false", "null"]),
                scalarAt(value, "user.items[2].name") == noScalar,
                scalarAt(value, "user.items") == noScalar, scalarAt(value, "user") == noScalar,
                scalarAt(value, "user.missing") == noScalar, scalarAt(value, "") == noScalar,
                structuralEquals([jsonLength(value, ""), jsonLength(value, "user")], [1, 6]),
                structuralEquals([jsonLength(value, "user.items"), jsonLength(value, "user.items[0]")], [2, 1]),
                structuralEquals([jsonLength(value, "user.empty"), jsonLength(value, "user.none")], [0, 0]),
                jsonLength(value, "user.name") == notAContainer,
                jsonLength(value, "user.nothing") == notAContainer,
                jsonLength(value, "user.missing") == notAContainer
            ])
            checkReleased("a released handle answers nothing", value, "user.name", "user")
        }
        Error => checkAll("nested JSON document", [false])
    }
    checkAll("a handle that was never issued answers nothing", [
        (jsonFree(0) ?: notReleased) == notReleased, jsonLength(0, "") == notAContainer,
        scalarAt(0, "") == noScalar, (jsonFree(-5) ?: notReleased) == notReleased
    ])
}
test("JSON paths, lengths and handles follow the document", jsonPathCase)
