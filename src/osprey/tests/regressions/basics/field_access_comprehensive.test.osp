// Comprehensive Field Access Test
// This tests various aspects of field access with different scenarios

/// Define record types
type Point = { x: int, y: int }
type User = { id: int, active: bool }
type Rectangle = { width: int, height: int }
type Counter = { count: int }

print("=== COMPREHENSIVE FIELD ACCESS TEST ===")

// Test 1 - Basic integer fields
print("Test 1 - Basic integer fields:")
let point = Point { x: 15, y: 25 }
print("Point x: ${point.x}\nPoint y: ${point.y}\n")

// Test 2 - Boolean and integer fields
print("Test 2 - Boolean and integer fields:")
let user = User { id: 42, active: true }
print("User ID: ${user.id}\nUser active: ${match user.active { true => 1 false => 0 }}\n")

// Test 3 - Field access in arithmetic
print("Test 3 - Field access in arithmetic:")
let rect = Rectangle { width: 10, height: 5 }
print("Rectangle width: ${rect.width}\nRectangle height: ${rect.height}")
let area = exactArithmetic(fn() => rect.width * rect.height)
print("Area: ${area}\n")

// Test 4 - Field access in conditionals
print("Test 4 - Field access in conditionals:")
let status = match user.active {
    true => "Active User"
    false => "Inactive User"
}
print("User status: ${status}\n")

// Test 5 - Non-destructive updates
print("Test 5 - Non-destructive updates:")
let counter = Counter { count: 0 }
print("Original count: ${counter.count}")
let incremented = counter { count: counter.count }
print("After update: ${incremented.count}")
let movedPoint = point { x: 100, y: 200 }
print("Updated point: (${movedPoint.x}, ${movedPoint.y})\nOriginal point unchanged: (${point.x}, ${point.y})\n")

// Test 6 - Complex expressions with field access
print("Test 6 - Complex expressions with field access:")
fn calculateArea(r) = r.width * r.height
let perimeter = exactArithmetic(fn() => 2 * (rect.width + rect.height))
let manhattanDistance = exactArithmetic(fn() => point.x + point.y)
let calculatedArea = exactArithmetic(fn() => calculateArea(rect))

print("Rectangle perimeter: ${perimeter}\nManhattan distance from origin: ${manhattanDistance}\nCalculated area using function: ${calculatedArea}\n")

print("=== COMPREHENSIVE FIELD ACCESS TEST COMPLETE ===")

/// Derives the same conditional label from a record field.
fn userStatus(value: User) = match value.active {
    true => "Active User"
    false => "Inactive User"
}

/// Verifies reads, arithmetic consumers, branching, and persistent updates.
fn fieldAccessCase() = {
    let point = Point { x: 15, y: 25 }
    let user = User { id: 42, active: true }
    let inactive = user { active: false }
    let rect = Rectangle { width: 10, height: 5 }
    let counter = Counter { count: 0 }
    let incremented = counter { count: counter.count }
    let moved = point { x: 100, y: 200 }
    checkAll("record field behavior", [
        structuralEquals([point.x, point.y, user.id, (calculateArea(rect))], [15, 25, 42, 50]),
        structuralEquals([(rect.width + rect.height ), (point.x + point.y ), counter.count], [15, 40, 0]),
        structuralEquals([incremented.count, moved.x, moved.y, point.x, point.y], [0, 100, 200, 15, 25]),
        user.active, !inactive.active,
        structuralEquals([userStatus(user), userStatus(inactive)], ["Active User", "Inactive User"])
    ])
}

test("field access feeds expressions without mutating records", exactly(fieldAccessCase))
