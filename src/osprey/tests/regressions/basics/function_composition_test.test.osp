// 🔗 Function Composition Test
// Tests passing functions as arguments to other functions

print("=== Function Composition Test ===")

/// Define some simple functions
fn double(x) = x * 2 
fn triple(x) = x * 3 
fn add5(x) = x + 5 

// Function composition test showing higher-order functions with strong typing
print("Testing function composition...")

fn square(x) = x * x 

/// Higher-order function with proper function typing instead of 'any'
fn applyFunction(value, func: (int) -> int) = func(value)

/// Curried composition: apply `h`, then add one (the middleware shape).
fn wrap(h) = fn(b) => h(b) + 1 

/// Nested closure: `base` is captured at every curried level.
fn nestAdder(base) = fn(x) => fn(y) => x + y + base

/// Applies `func` to `value` and prints one labelled report line, exactly.
fn reportApplication(label, value, func) =
    exactArithmetic(fn() => print("${label}: ${applyFunction(value: value, func: func)}"))

/// Prints `label` with `ok` when `holds`, else marks the comparison failed.
fn reportComparison(label, ok, holds) = print(match holds {
    true => "${label}=${ok}"
    false => "${label}=fail"
})

/// Test function composition
let testValue = 10
print("Starting value: ${testValue}")

/// Test passing different functions - use named arguments
reportApplication("After double", testValue, double)
reportApplication("After triple", testValue, triple)
reportApplication("After add5", testValue, add5)
print("square(5) = ${exactArithmetic(fn() => applyFunction(value: 5, func: square))}")

print("Function composition working correctly!")

/// Inline string-typed lambda exercises non-i64 lambda parameter codegen
let exclaim = fn(s) => s + "!"
print(exclaim("hi"))

/// Nested lambda: the inner lambda calls the outer lambda, then adds one.
exactArithmetic(fn() => print(toString(wrap(double)(5))))

/// Higher-order: an inline integer lambda flows into an `(int) -> int` slot.
print(toString(exactArithmetic(fn() => applyFunction(value: 10, func: fn(x) => x + 100 ))))

/// String equality must compare contents (strcmp), not the i8* pointer
let strA = "hi"
let strB = "hi"
let strC = "no"
reportComparison("strEq", "hi", strA == strB)
reportComparison("strNe", "ok", strA != strC)

/// String ordering must use strcmp lexicographically, not raw pointer order
let zStr = "zebra"
let aStr = "apple"
reportComparison("strLt", "ok", aStr < zStr)
reportComparison("strLt2", "ok", !(zStr < aStr))

/// Reassignment after explicitly handling checked integer addition. The client
/// can only request a state transition; the handler owns the actual mutation.
effect CounterState {
    /// Advance the counter the handler owns by one.
    increment: fn() -> Unit
    /// Put the counter the handler owns back to zero.
    reset: fn() -> Unit
}

mut counter = 0
fn countedComposition() = {
    handle CounterState {
        increment => { counter = counter + 1  }
        reset => { counter = 0  }
    }
    perform CounterState.reset()
    perform CounterState.increment()
    perform CounterState.increment()
    perform CounterState.increment()
}
exactArithmetic(fn() => countedComposition())
print(toString(counter))

/// Generic union variant payload was rendering as "<T>" because toString hit the
/// fallback formatter for an unresolved type-variable name even though the LLVM
/// runtime value was a plain i64.
type Box<T> = Empty | Full { value: T }
let bx = Full { value: 7 }
match bx {
    Full { value } => print(toString(value))
    Empty => print("empty")
}

// strings.Trim on the lexer token was greedy; "Quote: \"hi\"" lost its closing
// quote and gained a stray trailing backslash. Surrounding-quote strip is now
// single-step via TrimPrefix/TrimSuffix. Same bug existed on the interpolated
// string path.
print("Quote: \"hi\"")
let nm = "Bob"
print("Hi \"${nm}\"")

// Escape processor used to scan multiple times in the wrong order, so
// `\\n` would match the inner `\n` first and produce a real newline.
print("lit: ab\\nc")

/// Unary minus on a float was rejected ("operand of - must be Int") and
/// codegen always lowered to i64 sub even when operand was a double.
print(toString(-2.5))

/// === Closures: escaping capture [TYPE-FN-CLOSURE] ===
/// A returned lambda keeps its maker's state alive (heap closure cell); each
/// instance owns its own cell, and an annotated or inferred maker works alike.
fn makeAdder(n) = fn(x) => x + n 
fn makeScaler(k) = fn(v) => v * k
let plus5 = makeAdder(5)
let plus10 = makeAdder(10)
exactArithmetic(fn() => print("adders: ${plus5(3)} ${plus10(3)} ${plus5(100)}"))
exactArithmetic(fn() => print("direct: ${makeAdder(7)(3)} inferred: ${makeScaler(3)(7)}"))

/// A capturing let-bound lambda is a first-class value, curried composition
/// (the middleware shape) works, and nested closures capture level by level.
let offset = 100
let addOffset = fn(x) => x + offset 
exactArithmetic(fn() => print("passed: ${applyFunction(value: 11, func: addOffset)}"))
exactArithmetic(fn() => print("wrapped: ${wrap(double)(20)} nested: ${nestAdder(3)(10)(20)}"))

/// Regression pins: a rebound mut calls the NEW closure (not a stale inline
/// body); a named-function alias is a first-class value; a Result-returning
/// call is explicitly defaulted before entering a scalar-returning slot.
fn mkR(x) -> Result<int, string> = Success { value: x }
fn defaulted(x) = mkR(x) ?: 0
effect ClosureSlot {
    /// Rebind the captured adder to `value`.
    rebindAdder: fn(int) -> Unit
    /// Put the captured adder back to its initial body.
    reset: fn() -> Unit
}
mut rb = fn(x) => x + 1 
fn reboundComposition() = {
    handle ClosureSlot {
        rebindAdder offset => {
            rb = makeAdder(offset)
        }
        reset => { rb = fn(x) => x + 1  }
    }
    perform ClosureSlot.reset()
    perform ClosureSlot.rebindAdder(40)
}
reboundComposition()
let dblAlias = double
exactArithmetic(fn() => print("pins: ${rb(2)} ${applyFunction(value: 21, func: dblAlias)} ${applyFunction(value: 9, func: defaulted)}"))

/// A function-typed record field holds a capturing closure (read it via `let`;
/// the direct `vchk.check(50)` spelling awaits the UFCS field-call rule).
type Checker = { check: (int) -> bool }
let limit = 10
let vchk = Checker { check: fn(n) => n > limit }
let chk = vchk.check
print("field: ${chk(50)} ${chk(5)}")

/// Sums a list of ints.
fn add(a, b) = a + b
/// Sums the even numbers below ten, folded from a filtered range.
fn evenSumOfRange() = fold(filter(range(1, 10), fn(x) => (x % 2 ) == 0), 0, add)
/// Sums ten-plus additions over a mapped range.
fn computedSum() = fold(map(range(1, 4), makeAdder(10)), 0, add)

/// Capturing lambdas as iterator callbacks: fused range pipeline and list walk.
let factor2 = 3
exactArithmetic(fn() => forEach(map(range(1, 4), fn(x) => x * 10 + factor2 ), fn(v) => print("mapped: ${v}")))
let evensum = exactArithmetic(fn() => evenSumOfRange())
print("evensum: ${evensum}")
exactArithmetic(fn() => forEachList(listAppend(listAppend(List(), 4), 5), fn(x) => print("elem: ${x * factor2}")))

/// Higher-order calls through non-name callees [TYPE-FN-HIGHER-ORDER]: a chained
/// 3-deep application (the outer callee is itself a call result), an iterator
/// callback that is a computed call result (`makeAdder(10)`), and a filter keyed
/// on a function read from a record field (`vchk.check`).
let tri3 = fn(a) => fn(b) => fn(c) => a + b + c
exactArithmetic(fn() => print("chain3: ${tri3(1)(2)(3)} computed: ${computedSum()} fieldcb: ${fold(filter(range(8, 13), vchk.check), 0, add)}"))

/// === Generic functions as first-class values [TYPE-GENERICS-FN] ===
/// A generic function specialises into a concrete function-typed slot, a
/// let-bound generic name stays callable (call alias), and the Kotlin-style
/// scope-function idiom works: a generic HOF applies its lambda argument at
/// two different instantiations (int and string).
fn identity<T>(x: T) -> T = x
fn alsoDo(x, f) = f(x)
let idAlias = identity
exactArithmetic(fn() => print("generic-values: ${applyFunction(value: 33, func: identity)} ${idAlias(7)} ${alsoDo(21, fn(n) => n * 2)} ${alsoDo("osp", fn(s) => s + "!")}"))

print("=== Function Composition Test Complete ===")

/// Verifies named, inline, nested, and string-valued function application.
fn basicCompositionCase() = {
    checkAll("basic function composition", [
        structuralEquals([applyFunction(value: 10, func: double), applyFunction(value: 10, func: triple), applyFunction(value: 10, func: add5), applyFunction(value: 5, func: square)], [20, 30, 15, 25]),
        wrap(double)(5) == 11,
        structuralEquals([exclaim("hi"), "hi"], ["hi!", "hi"]),
        "hi" != "no",
        "apple" < "zebra", !("zebra" < "apple")
    ])
}

/// Verifies escaping captures, function fields, aliases, Results, and generics.
fn closureCompositionCase() = {
    checkAll("closure and generic composition", [
        structuralEquals([plus5(3), plus10(3), plus5(100), makeAdder(7)(3), (makeScaler(3)(7))], [8, 13, 105, 10, 21]),
        structuralEquals([applyFunction(value: 11, func: addOffset), wrap(double)(20), (nestAdder(3)(10)(20) )], [111, 41, 33]),
        structuralEquals([applyFunction(value: 21, func: dblAlias), applyFunction(value: 9, func: defaulted)], [42, 9]),
        structuralEquals([applyFunction(value: 33, func: identity), idAlias(7)], [33, 7]),
        (alsoDo(21, fn(n) => n * 2) ) == 42,
        chk(50), !chk(5),
        alsoDo("osp", fn(s) => s + "!") == "osp!"
    ])
}

/// Verifies capturing callbacks through map, filter, fold, and chained calls.
fn iteratorCompositionCase() = checkAll("capturing iterator callbacks", [
    structuralEquals([evenSumOfRange(), fold(map(range(1, 4), fn(x) => x * 10 + 3 ), 0, add), computedSum(), fold(filter(range(8, 13), vchk.check), 0, add), (tri3(1)(2)(3) )], [20, 69, 36, 23, 6])
])

/// Verifies handler-owned mutation and closure rebinding inside the test body.
fn effectCompositionCase() = {
    countedComposition()
    reboundComposition()
    checkAll("effect-managed function state", [counter == 3, rb(2) == 42])
}

exactTests([
    { name: "functions compose across scalar and string values", work: basicCompositionCase },
    { name: "closures retain captures through higher-order consumers", work: closureCompositionCase },
    { name: "capturing callbacks preserve iterator results", work: iteratorCompositionCase },
    { name: "effects own mutation and closure rebinding", work: effectCompositionCase }
])
