// ML-flavor twin of codepoint_roundtrip.osp. Layout match arms, whitespace
// application (`codePointWidth cp`), and layout-block bodies lower to the SAME
// canonical AST as the Default braces/parens form — byte-identical IR
// ([FLAVOR-IR-EQUIV]). No params/returns are annotated in the Default source,
// so none are annotated here.
// Spec: [BUILTIN-STRING-CURSOR] (Cursor Access).

(** codePointWidth(cp) must equal the real encoded byte count of its char. *)
widthMatches (cp, ch) =
    match codePointWidth cp
        Success value => value == byteLength ch
        Error _message => false

(** Decode byte 0 of an encoded char and assert it equals the original scalar. *)
checkDecode (cp, ch) =
    match codePointAt ch 0
        Success value =>
            match value == cp
                true => print "cp=${cp} char=${ch} byteLen=${byteLength ch} width-ok=${widthMatches (cp, ch)} -> roundtrip OK ${value}\n"
                false => print "cp=${cp} ROUNDTRIP MISMATCH got ${value}\n"
        Error message => print "cp=${cp} decode FAILED: ${message}\n"
    0

(** Encode one scalar, then round-trip-decode it. *)
roundTrip cp =
    match fromCodePoint cp
        Success value => checkDecode (cp, value)
        Error message =>
            print "cp=${cp} encode FAILED: ${message}\n"
            0

(** An invalid scalar must be rejected by encode with an Error message. *)
rejectInvalid cp =
    match fromCodePoint cp
        Success value => print "cp=${cp} UNEXPECTEDLY accepted: ${value}\n"
        Error message => print "cp=${cp} rejected: ${message}\n"
    0

(** Run `check` on every scalar in `scalars`, in order. *)
checkEach (scalars, check) = foldList scalars 0 (\(_acc, cp) => check cp)

(** Print a cursor Result value under `label`, or `fallback` when it errors. *)
printValue (label, fallback, result) =
    match result
        Success value => print "${label}${value}\n"
        Error _message => print fallback
    0

// 1-byte (0x01..0x7F): low 0x01, 'A', boundary 0x7F. (NUL 0x00 is the
// C-string terminator, so it is not representable as a standalone char.)
print "=== 1-byte: 0x01..0x7F ===\n"
_a0 = checkEach ([1, 65, 127], roundTrip)

// 2-byte (0x80..0x7FF): boundary 0x80, 'é', boundary 0x7FF.
print "=== 2-byte: 0x80..0x7FF ===\n"
_b0 = checkEach ([128, 233, 2047], roundTrip)

// 3-byte (0x800..0xFFFF): boundary 0x800, '世', boundary 0xFFFF.
print "=== 3-byte: 0x800..0xFFFF ===\n"
_c0 = checkEach ([2048, 19990, 65535], roundTrip)

// 4-byte (0x10000..0x10FFFF): boundary 0x10000, '😀', max scalar 0x10FFFF.
print "=== 4-byte: 0x10000..0x10FFFF ===\n"
_d0 = checkEach ([65536, 128512, 1114111], roundTrip)

// Invalid scalars: surrogate range 0xD800..0xDFFF, past-max 0x110000, neg.
print "=== invalid scalars are rejected ===\n"
_s0 = checkEach ([55296, 57343, 1114112, (0 - 1) ], rejectInvalid)

// Direct codePointWidth band classification, one assertion per width band.
print "=== codePointWidth band boundaries ===\n"
_w0 = printValue ("width(0x7F)=", "w err\n", codePointWidth 127)
_w1 = printValue ("width(0x7FF)=", "w err\n", codePointWidth 2047)
_w2 = printValue ("width(0xFFFF)=", "w err\n", codePointWidth 65535)
_w3 = printValue ("width(0x10FFFF)=", "w err\n", codePointWidth 1114111)

// byteAt indexes RAW BYTES (not codepoints): byte 1 of "é" (0xC3 0xA9) is
// the continuation byte 0xA9 = 169, proving byte-level access past offset 0.
print "=== byteAt raw-byte semantics ===\n"
_e0 = foldList [0, 1] 0 (\(_acc, index) => printValue ("byteAt(é,${index})=", "b err\n", byteAt "é" index))

print "=== codepoint roundtrip complete ===\n"

(** Return whether encoding, decoding, and width calculation agree for a scalar. *)
scalarRoundTrips cp =
    match fromCodePoint cp
        Success value =>
            match codePointAt value 0
                Success decoded => decoded == cp && widthMatches (cp, value)
                Error _message => false
        Error _message => false

(** A cursor Result must carry exactly `expected`, never an Error. *)
valueIs (result, expected) =
    match result
        Success value => value == expected
        Error _message => false

(** Invalid scalars must return a non-empty diagnostic. *)
isRejected result =
    match result
        Success _value => false
        Error message => length message > 0

(** Verify all UTF-8 widths, invalid scalar handling, and raw byte access. *)
codepointRoundTripCase () =
    checkAll "Unicode cursor round trips" [
        scalarRoundTrips 1, scalarRoundTrips 233, scalarRoundTrips 19990, scalarRoundTrips 128512,
        valueIs (codePointWidth 127, 1), valueIs (codePointWidth 2047, 2),
        valueIs (codePointWidth 65535, 3), valueIs (codePointWidth 1114111, 4),
        isRejected (fromCodePoint 55296), isRejected (fromCodePoint 57343),
        isRejected (fromCodePoint 1114112),
        valueIs (byteAt "é" 0, 195), valueIs (byteAt "é" 1, 169),
        structuralEquals [roundTrip 65, roundTrip 55296, rejectInvalid 55296] [0, 0, 0]
    ]
test "Unicode scalars survive encode and decode" codepointRoundTripCase
