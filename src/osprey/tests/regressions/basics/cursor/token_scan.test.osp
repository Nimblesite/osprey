// A mini-lexer primitive built directly on the O(1) string cursor
// (byteAt / byteLength, [BUILTIN-STRING-CURSOR]). It scans a run of ASCII
// digits out of a string and accumulates them into an integer, advancing one
// byte at a time by RECURSION (Osprey has no loops). byteAt's Result is the
// end-of-input signal: an Error from an out-of-range index ends the run just
// like a non-digit byte does.
//
// Demonstrates:
//   * scanning "12345abc" -> 12345, stopping cleanly at 'a'
//   * locating where a number token ends (the index of the first non-digit)
//   * walking a string of several number tokens separated by non-digits and
//     printing each scanned value (a real multi-token lexer loop)
//
// Spec: docs/specs/runtime/0012-Built-InFunctions.md (Cursor Access)

/// ASCII '0' and '9' as named constants (zero-arg fns are in scope everywhere;
/// top-level `let`s are not visible inside fn bodies).
fn zero() = 48
fn nine() = 57

/// Is the scalar an ASCII digit byte?
fn isDigitByte(value) = value >= zero() && value <= nine()

/// Is the byte at index i an ASCII digit? End-of-input (Error) is "no".
fn isDigitAt(s, i) = match byteAt(s, i) {
    Success { value } => isDigitByte(value)
    Error => false
}

/// Accumulate the digit run starting at i. acc carries the value built so far;
/// each step multiplies by ten and adds (byte - '0'). Stops at the first
/// non-digit byte OR at end-of-input, returning the accumulated integer.
fn scanInt(s, i, acc) = match byteAt(s, i) {
    Success { value } => match isDigitByte(value) {
        true  => scanInt(s, (i + 1) , (acc * 10 + value - zero()) )
        false => acc
    }
    Error => acc
}

/// Index of the first byte at or after i that is NOT a digit (where the token
/// ends). Recurses while digits continue; returns i at the first non-digit/EOI.
fn scanEnd(s, i) = match isDigitAt(s, i) {
    true  => scanEnd(s, (i + 1) )
    false => i
}

/// Skip a run of non-digit bytes: index of the next digit at or after i, or
/// byteLength(s) if none remains. The dual of scanEnd, used to hop between
/// number tokens.
fn nextDigit(s, i) = match i >= byteLength(s) {
    true  => i
    false => match isDigitAt(s, i) {
        true  => i
        false => nextDigit(s, (i + 1) )
    }
}

/// Walk the whole string, scanning every number token into a List<int>.
/// From position i: skip to the next digit, scan that number, append it, then
/// continue from just past the token. Terminates when no digit remains.
fn scanAll(s, i, acc) = match nextDigit(s, i) >= byteLength(s) {
    true  => acc
    false => scanAll(s, scanEnd(s, nextDigit(s, i)),
                     listAppend(acc, scanInt(s, nextDigit(s, i), 0)))
}

/// Print one `label=value` line for a thunk-computed integer.
fn report(label, compute) = print("${label}=${exactArithmetic(compute)}\n")

/// ---- single token: "12345abc" stops at 'a' ----
let mixed = "12345abc"
report("byteLen", fn() => byteLength(mixed))
report("scan", fn() => scanInt(mixed, 0, 0))             // 12345
report("end", fn() => scanEnd(mixed, 0))                 // 5 (index of 'a')
exactArithmetic(fn() => match byteAt(mixed, scanEnd(mixed, 0)) {        // proves we stopped at 'a'
    Success { value }   => print("stopByte=${value}\n")   // 97 == 'a'
    Error => print("stopByte FAILED\n")
}
)

/// ---- digits-only token runs to end-of-input via the Error branch ----
report("pure", fn() => scanInt("777", 0, 0))
report("pureEnd", fn() => scanEnd("777", 0))

/// ---- leading non-digits: scan returns 0, nextDigit finds the run ----
report("leadScan", fn() => scanInt("ab42", 0, 0))
report("leadNext", fn() => nextDigit("ab42", 0))
report("leadVal", fn() => scanInt("ab42", nextDigit("ab42", 0), 0))

/// ---- empty input: nothing to scan ----
report("emptyScan", fn() => scanInt("", 0, 0))

/// ---- multi-token lexer over a delimited string ----
let stream = "12,345-6789 0!42"
let tokens = exactArithmetic(fn() => scanAll(stream, 0, List()))
print("tokenCount=${listLength(tokens)}\n")    // 5
forEachList(tokens, print)                     // 12 345 6789 0 42

print("=== Scan Complete ===\n")

/// Do the scanned tokens hold `expected` at every index, in order?
fn tokensAre(tokens, expected, i) = match listGet(expected, i) {
    Success { want } => match listGet(tokens, i) {
        Success { value } => value == want && tokensAre(tokens, expected, (i + 1))
        Error => false
    }
    Error => listLength(tokens) == i
}

/// Verifies token boundaries, empty input, and a complete multi-token scan.
fn tokenScanCase() = {
    let scanned = scanAll("12,345-6789 0!42", 0, List())
    checkAll("integer cursor scan", [
        structuralEquals([scanInt("12345abc", 0, 0), scanEnd("12345abc", 0), scanInt("777", 0, 0)], [12345, 5, 777]),
        structuralEquals([scanEnd("777", 0), scanInt("ab42", 0, 0), nextDigit("ab42", 0)], [3, 0, 2]),
        structuralEquals([scanInt("ab42", 2, 0), scanInt("", 0, 0), listLength(scanned)], [42, 0, 5]),
        tokensAre(scanned, [12, 345, 6789, 0, 42], 0)
    ])
}

test("token scanner finds every integer and boundary", exactly(tokenScanCase))
