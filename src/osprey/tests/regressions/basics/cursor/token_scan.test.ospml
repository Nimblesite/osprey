// ML-flavor twin of token_scan.osp. A mini-lexer primitive built directly on
// the O(1) string cursor (byteAt / byteLength, [BUILTIN-STRING-CURSOR]). It
// scans a run of ASCII digits out of a string and accumulates them into an
// integer, advancing one byte at a time by RECURSION (Osprey has no loops).
// byteAt's Result is the end-of-input signal: an Error from an out-of-range
// index ends the run just like a non-digit byte does.
//
// Uncurried whitespace application, layout `match`, and positional
// `Success value` / `Error message` patterns lower to the same nodes as the
// braced Default flavor — byte-identical IR.
//
// Spec: docs/specs/runtime/0012-Built-InFunctions.md (Cursor Access)

(** ASCII '0' and '9' as named constants (zero-arg fns are in scope everywhere;
    top-level bindings are not visible inside fn bodies). *)
zero () = 48
nine () = 57

(** Is the scalar an ASCII digit byte? *)
isDigitByte value = value >= zero () && value <= nine ()

(** Is the byte at index i an ASCII digit? End-of-input (Error) is "no". *)
isDigitAt (s, i) =
    match byteAt s i
        Success value => isDigitByte value
        Error _message => false

(** Accumulate the digit run starting at i. acc carries the value built so far;
    each step multiplies by ten and adds (byte - '0'). Stops at the first
    non-digit byte OR at end-of-input, returning the accumulated integer. *)
scanInt (s, i, acc) =
    match byteAt s i
        Success value =>
            match isDigitByte value
                true => scanInt (s, ((i + 1) ), ((acc * 10 + value - zero ()) ))
                false => acc
        Error _message => acc

(** Index of the first byte at or after i that is NOT a digit (where the token
    ends). Recurses while digits continue; returns i at the first non-digit/EOI. *)
scanEnd (s, i) =
    match isDigitAt (s, i)
        true => scanEnd (s, ((i + 1) ))
        false => i

(** Skip a run of non-digit bytes: index of the next digit at or after i, or
    byteLength s if none remains. The dual of scanEnd, used to hop between
    number tokens. *)
nextDigit (s, i) =
    match i >= byteLength s
        true => i
        false =>
            match isDigitAt (s, i)
                true => i
                false => nextDigit (s, ((i + 1) ))

(** Walk the whole string, scanning every number token into a List<int>.
    From position i: skip to the next digit, scan that number, append it, then
    continue from just past the token. Terminates when no digit remains. *)
scanAll (s, i, acc) =
    match nextDigit (s, i) >= byteLength s
        true => acc
        false => scanAll (s, (scanEnd (s, (nextDigit (s, i)))), (listAppend acc (scanInt (s, (nextDigit (s, i)), 0))))

(** Print one `label=value` line for a thunk-computed integer. *)
report (label, compute) =
    print "${label}=${exactArithmetic compute}\n"

(** ---- single token: "12345abc" stops at 'a' ---- *)
mixed = "12345abc"
report ("byteLen", (\() => byteLength mixed))
report ("scan", (\() => scanInt (mixed, 0, 0)))
report ("end", (\() => scanEnd (mixed, 0)))
exactArithmetic (\() =>
    match byteAt mixed (scanEnd (mixed, 0))
        Success value => print "stopByte=${value}\n"
        Error _message => print "stopByte FAILED\n")

(** ---- digits-only token runs to end-of-input via the Error branch ---- *)
report ("pure", (\() => scanInt ("777", 0, 0)))
report ("pureEnd", (\() => scanEnd ("777", 0)))

(** ---- leading non-digits: scan returns 0, nextDigit finds the run ---- *)
report ("leadScan", (\() => scanInt ("ab42", 0, 0)))
report ("leadNext", (\() => nextDigit ("ab42", 0)))
report ("leadVal", (\() => scanInt ("ab42", (nextDigit ("ab42", 0)), 0)))

(** ---- empty input: nothing to scan ---- *)
report ("emptyScan", (\() => scanInt ("", 0, 0)))

(** ---- multi-token lexer over a delimited string ---- *)
stream = "12,345-6789 0!42"
tokens = exactArithmetic (\() =>
    scanAll (stream, 0, (List ())))
print "tokenCount=${listLength tokens}\n"
forEachList tokens print

print "=== Scan Complete ===\n"

(** Do the scanned tokens hold `expected` at every index, in order? *)
tokensAre (tokens, expected, i) =
    match listGet expected i
        Success want =>
            match listGet tokens i
                Success value => value == want && tokensAre (tokens, expected, (i + 1))
                Error _message => false
        Error _message => listLength tokens == i

(** Verify token boundaries, empty input, and a complete multi-token scan. *)
tokenScanCase () =
    scanned = scanAll ("12,345-6789 0!42", 0, (List ()))
    checkAll "integer cursor scan" [
        structuralEquals [scanInt ("12345abc", 0, 0), scanEnd ("12345abc", 0), scanInt ("777", 0, 0)] [12345, 5, 777],
        structuralEquals [scanEnd ("777", 0), scanInt ("ab42", 0, 0), nextDigit ("ab42", 0)] [3, 0, 2],
        structuralEquals [scanInt ("ab42", 2, 0), scanInt ("", 0, 0), listLength scanned] [42, 0, 5],
        tokensAre (scanned, [12, 345, 6789, 0, 42], 0)
    ]

test "token scanner finds every integer and boundary" (exactly tokenScanCase)
