(** `structuralEquals` [BUILTIN-STRUCTURAL-EQUALS]: every row of the spec
    table, true and false — scalars by value (float NaN unequal to itself),
    records field by field, unions by variant then payload, lists by length
    then elements, maps by keys then values, a recursive tree differing deep
    inside, and NaN inside a record keeping it unequal to itself. The rejected
    operand types are pinned by
    src/osprey/examples/failscompilation/structural_equals_*.ospo. *)

type Route =
    tab : string
    depth : int

type Pair = Pair int string

type Shape =
    Dot
    Circle
        r : float
    Rect
        w : int
        h : int

type Tree =
    Leaf
    Node
        left : Tree
        right : Tree
        size : int

type Reading =
    at : string
    temp : float

type Box T =
    content : T

type Slot A =
    Filled
        label : string
        act : A
    Empty

type Act =
    Go
    Stop

route (tab, depth) = Route(tab = tab, depth = depth)
pair (n, s) = Pair(n, s)
reading (at, temp) = Reading(at = at, temp = temp)
tree (size) = match size
    0 => Leaf
    1 => Node(left = Leaf, right = Leaf, size = 1)
    _ => Node(left = tree(0), right = tree(1), size = size)

(** The two outcomes every row asserts, so a row is a table of pairs. *)
same (a, b) = structuralEquals(a, b)
differ (a, b) = !(structuralEquals(a, b))

scalarsRow () =
    print "scalars ${toString (same (3, 3))} ${toString (same (3, 4))} ${toString (same ("osprey", "osprey"))} ${toString (same (true, false))}"
    checkAll("scalars compare by value", [
        same (3, 3), differ (3, 4),
        same ("osprey", "osprey"), differ ("osprey", "Osprey"),
        same (true, true), differ (true, false)
    ])

floatsRow () =
    print "float ${toString (same (0.5, 0.5))} ${toString (same (0.5, 0.25))} nan ${toString (same (sqrt (-1.0), sqrt (-1.0)))}"
    checkAll("floats compare by value, so NaN is unequal to itself", [
        same (0.5, 0.5), differ (0.5, 0.25), differ (sqrt (-1.0), sqrt (-1.0))
    ])

recordsRow () =
    print "records ${toString (same (route ("home", 1), route ("home", 1)))} ${toString (same (route ("home", 1), route ("home", 2)))} pair ${toString (same (pair (1, "a"), pair (1, "a")))} ${toString (same (pair (1, "a"), pair (2, "a")))}"
    checkAll("records compare every field; a tuple is a row", [
        same (route ("home", 1), route ("home", 1)), differ (route ("home", 1), route ("home", 2)), differ (route ("home", 1), route ("away", 1)),
        same (pair (1, "a"), pair (1, "a")), differ (pair (1, "a"), pair (2, "a")), differ (pair (1, "a"), pair (1, "b"))
    ])

unionsRow () =
    print "unions ${toString (same (Circle(r = 1.0), Circle(r = 1.0)))} ${toString (same (Circle(r = 1.0), Circle(r = 2.0)))} ${toString (same (Dot, Dot))} ${toString (same (Dot, Rect(w = 1, h = 1)))}"
    checkAll("unions compare variant then payload", [
        same (Circle(r = 1.0), Circle(r = 1.0)), differ (Circle(r = 1.0), Circle(r = 2.0)), differ (Circle(r = 1.0), Rect(w = 1, h = 1)),
        same (Dot, Dot), differ (Dot, Rect(w = 1, h = 1)), same (Rect(w = 1, h = 2), Rect(w = 1, h = 2))
    ])

listsRow () = checkAll("lists compare length then elements in order", [
    same ([1, 2], [1, 2]), differ ([1, 2], [1, 2, 3]), differ ([1, 2], [2, 1]),
    same ([route ("a", 1)], [route ("a", 1)]), differ ([route ("a", 1)], [route ("a", 2)]),
    same ([[1], [2]], [[1], [2]]), differ ([[1], [2]], [[1], [3]])
])

mapsRow () =
    checkAll("maps compare keys then values", [
        same (Map() |> mapSet("a", 1) |> mapSet("b", 2), Map() |> mapSet("a", 1) |> mapSet("b", 2)),
        differ (Map() |> mapSet("a", 1), Map() |> mapSet("a", 2)), differ (Map() |> mapSet("a", 1), Map() |> mapSet("b", 1)),
        differ (Map() |> mapSet("a", 1), Map() |> mapSet("a", 1) |> mapSet("b", 2))
    ])

treesRow () =
    leftHeavy = Node(left = tree(1), right = Leaf, size = 3)
    rightHeavy = Node(left = Leaf, right = tree(1), size = 3)
    print "tree ${toString (same (tree (2), tree (2)))} ${toString (same (tree (2), tree (3)))} deep ${toString (same (leftHeavy, rightHeavy))} ${toString (same (leftHeavy, Node(left = tree(1), right = Leaf, size = 3)))}"
    checkAll("a recursive tree compares through its own comparator", [
        same (tree (2), tree (2)), differ (tree (2), tree (3)), differ (leftHeavy, rightHeavy),
        same (leftHeavy, Node(left = tree(1), right = Leaf, size = 3))
    ])

nanRow () =
    print "nan-in-record ${toString (same (reading ("noon", sqrt (-1.0)), reading ("noon", sqrt (-1.0))))} ${toString (same (reading ("noon", 1.0), reading ("noon", 1.0)))}"
    checkAll("a value holding NaN is unequal to itself", [differ (reading ("noon", sqrt (-1.0)), reading ("noon", sqrt (-1.0))), same (reading ("noon", 1.0), reading ("noon", 1.0))])

(** A generic caller is instantiated at each call site. *)
genericCallerRow () =
    checkAll("a generic caller is checked at each call site", [
        same (1, 1), differ (1, 2),
        same (route ("a", 1), route ("a", 1)), differ (route ("a", 1), route ("a", 2))
    ])

(** A constructor written straight into the call carries no published type of
    its own; its generic fields are instantiated from what is written into them. *)
constructorOperandsRow () =
    boxes = same (Box(content = 1), Box(content = 1))
    slots = same (Filled(label = "a", act = Go), Filled(label = "a", act = Stop))
    print "constructors ${toString boxes} ${toString slots}"
    checkAll("constructor operands instantiate their generic fields", [
        same (Box(content = 1), Box(content = 1)), differ (Box(content = [1, 2]), Box(content = [2, 1])),
        same (Filled(label = "a", act = Go), Filled(label = "a", act = Go)), differ (Filled(label = "a", act = Go), Filled(label = "a", act = Stop))
    ])

testCases([
    { name = "scalars compare by value", work = scalarsRow },
    { name = "floats compare by value, so NaN is unequal to itself", work = floatsRow },
    { name = "records compare every field; a tuple is a row", work = recordsRow },
    { name = "unions compare variant then payload", work = unionsRow },
    { name = "lists compare length then elements in order", work = listsRow },
    { name = "maps compare keys then values", work = mapsRow },
    { name = "a recursive tree compares through its own comparator", work = treesRow },
    { name = "a value holding NaN is unequal to itself", work = nanRow },
    { name = "a generic caller is checked at each call site", work = genericCallerRow },
    { name = "constructor operands instantiate their generic fields", work = constructorOperandsRow }
])
