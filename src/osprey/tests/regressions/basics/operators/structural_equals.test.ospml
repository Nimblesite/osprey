(** `structuralEquals` [BUILTIN-STRUCTURAL-EQUALS]: every row of the spec
    table, true and false — scalars by value (float NaN unequal to itself),
    records field by field (nested, positional), unions by variant then
    payload, lists by length then elements, maps by keys then values — plus a
    recursive tree equal and differing deep inside, and NaN inside a record
    keeping it unequal to itself. The rejected operand types are pinned by
    src/osprey/examples/failscompilation/ml_structural_equals_*.ospo. *)

type Route =
    tab : string
    depth : int

type Pair = Pair int string

type Shape =
    Dot
    Circle
        r : float
    Rect
        w : int
        h : int

type Tree =
    Leaf
    Node
        left : Tree
        right : Tree
        size : int

type Reading =
    at : string
    temp : float

type Box T =
    content : T

type Slot A =
    Filled
        label : string
        act : A
    Empty

type Act =
    Go
    Stop

(** One observation a row makes: the word printed before it (empty after the
    first of a group), whether the row prints it, the value it decided, and
    whether the operands should have compared equal. *)
type Cell =
    head : string
    shown : bool
    equals : bool
    want : bool

route (tab, depth) = Route(tab = tab, depth = depth)
pair (n, s) = Pair n s
reading (at, temp) = Reading(at = at, temp = temp)
tree size =
    match size
        0 => Leaf
        1 => Node(left = Leaf, right = Leaf, size = 1)
        _ => Node(left = tree 0, right = tree 1, size = size)
deepSame (a, b) = structuralEquals(a, b)

(** An observation the row prints under `head`, where `want` says whether the operands should compare equal. *)
shown (head, equals, want) = Cell(head = head, shown = true, equals = equals, want = want)

(** An observation the row asserts without printing, where `want` says whether the operands should compare equal. *)
hidden (equals, want) = Cell(head = "", shown = false, equals = equals, want = want)

(** The printed text of one observation: its head word, when it has one, then the value it decided. *)
cellText c =
    match isEmpty c.head
        true => toString c.equals
        false => "${c.head} ${toString c.equals}"

(** One `checkTrue` per observation, so a list-built row reports like a `checkAll`. *)
checkCells (name, cells) = forEachList (cells, \c => checkTrue name (c.equals == c.want))

(** Print a row's printed observations, space separated, then assert every one of them. *)
printedRow (name, cells) =
    print (join (mapList (filterList (cells, \c => c.shown), cellText)) " ")
    checkCells (name, cells)

scalarsRow () = printedRow ("scalars compare by value", [
    shown ("scalars", structuralEquals (3, 3), true),
    shown ("", structuralEquals (3, 4), false),
    shown ("", structuralEquals ("osprey", "osprey"), true),
    hidden (structuralEquals ("osprey", "Osprey"), false),
    hidden (structuralEquals (true, true), true),
    shown ("", structuralEquals (true, false), false),
])

floatsRow () = printedRow ("floats compare by value, so NaN is unequal to itself", [
    shown ("float", structuralEquals (0.5, 0.5), true),
    shown ("", structuralEquals (0.5, 0.25), false),
    shown ("nan", structuralEquals (sqrt (-1.0), sqrt (-1.0)), false),
])

recordsRow () = printedRow ("records compare every field; a tuple is a row", [
    shown ("records", structuralEquals (route ("home", 1), route ("home", 1)), true),
    shown ("", structuralEquals (route ("home", 1), route ("home", 2)), false),
    hidden (structuralEquals (route ("home", 1), route ("away", 1)), false),
    shown ("pair", structuralEquals (pair (1, "a"), pair (1, "a")), true),
    shown ("", structuralEquals (pair (1, "a"), pair (2, "a")), false),
    hidden (structuralEquals (pair (1, "a"), pair (1, "b")), false),
])

unionsRow () = printedRow ("unions compare variant then payload", [
    shown ("unions", structuralEquals (Circle(r = 1.0), Circle(r = 1.0)), true),
    shown ("", structuralEquals (Circle(r = 1.0), Circle(r = 2.0)), false),
    hidden (structuralEquals (Circle(r = 1.0), Rect(w = 1, h = 1)), false),
    shown ("", structuralEquals (Dot, Dot), true),
    shown ("", structuralEquals (Dot, Rect(w = 1, h = 1)), false),
    hidden (structuralEquals (Rect(w = 1, h = 2), Rect(w = 1, h = 2)), true),
])

listsRow () = checkCells ("lists compare length then elements in order", [
    hidden (structuralEquals ([1, 2], [1, 2]), true),
    hidden (structuralEquals ([1, 2], [1, 2, 3]), false),
    hidden (structuralEquals ([1, 2], [2, 1]), false),
    hidden (structuralEquals ([route ("a", 1)], [route ("a", 1)]), true),
    hidden (structuralEquals ([route ("a", 1)], [route ("a", 2)]), false),
    hidden (structuralEquals ([[1], [2]], [[1], [2]]), true),
    hidden (structuralEquals ([[1], [2]], [[1], [3]]), false),
])

mapsRow () = checkCells ("maps compare keys then values", [
    hidden (structuralEquals (Map() |> mapSet("a", 1) |> mapSet("b", 2), Map() |> mapSet("a", 1) |> mapSet("b", 2)), true),
    hidden (structuralEquals (Map() |> mapSet("a", 1), Map() |> mapSet("a", 2)), false),
    hidden (structuralEquals (Map() |> mapSet("a", 1), Map() |> mapSet("b", 1)), false),
    hidden (structuralEquals (Map() |> mapSet("a", 1), Map() |> mapSet("a", 1) |> mapSet("b", 2)), false),
])

treesRow () =
    leftHeavy = Node(left = tree 1, right = Leaf, size = 3)
    rightHeavy = Node(left = Leaf, right = tree 1, size = 3)
    printedRow ("a recursive tree compares through its own comparator", [
        shown ("tree", structuralEquals (tree 2, tree 2), true),
        shown ("", structuralEquals (tree 2, tree 3), false),
        shown ("deep", structuralEquals (leftHeavy, rightHeavy), false),
        shown ("", structuralEquals (leftHeavy, Node(left = tree 1, right = Leaf, size = 3)), true),
    ])

nanRow () = printedRow ("a value holding NaN is unequal to itself", [
    shown ("nan-in-record", structuralEquals (reading ("noon", sqrt (-1.0)), reading ("noon", sqrt (-1.0))), false),
    shown ("", structuralEquals (reading ("noon", 1.0), reading ("noon", 1.0)), true),
])

genericCallerRow () = checkCells ("a generic caller is checked at each call site", [
    hidden (deepSame (1, 1), true),
    hidden (deepSame (1, 2), false),
    hidden (deepSame (route ("a", 1), route ("a", 1)), true),
    hidden (deepSame (route ("a", 1), route ("a", 2)), false),
])

(** A constructor written straight into the call carries no published type of
    its own; its generic fields are instantiated from what is written into them. *)
constructorOperandsRow () = printedRow ("constructor operands instantiate their generic fields", [
    shown ("constructors", structuralEquals (Box(content = 1), Box(content = 1)), true),
    hidden (structuralEquals (Box(content = [1, 2]), Box(content = [2, 1])), false),
    hidden (structuralEquals (Filled(label = "a", act = Go), Filled(label = "a", act = Go)), true),
    shown ("", structuralEquals (Filled(label = "a", act = Go), Filled(label = "a", act = Stop)), false),
])

test "scalars compare by value" scalarsRow
test "floats compare by value, so NaN is unequal to itself" floatsRow
test "records compare every field; a tuple is a row" recordsRow
test "unions compare variant then payload" unionsRow
test "lists compare length then elements in order" listsRow
test "maps compare keys then values" mapsRow
test "a recursive tree compares through its own comparator" treesRow
test "a value holding NaN is unequal to itself" nanRow
test "a generic caller is checked at each call site" genericCallerRow
test "constructor operands instantiate their generic fields" constructorOperandsRow
