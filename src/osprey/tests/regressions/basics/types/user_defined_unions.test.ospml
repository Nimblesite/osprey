(** Cross-contract oracle for [TYPE-MATCH-EXHAUSTIVE], [TYPE-LIST],
    [TYPE-LIST-PATTERNS], [TYPE-MAP], [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS],
    [TYPE-GENERICS-FN], [BUILTIN-MAP-GET], [BUILTIN-MAP-SET],
    [BUILTIN-MAP-REMOVE], [BUILTIN-MAP-MERGE], [EFFECTS-OP-TYPING],
    [EFFECTS-HANDLER-STATE], [EFFECTS-GENERIC-DECL],
    [EFFECTS-GENERIC-INSTANTIATION], [EFFECTS-GENERIC-RUNTIME],
    [FLAVOR-ML-GENERICS], [FLAVOR-ML-LIST], [FLAVOR-ML-MAP],
    [FLAVOR-ML-INDEX], and [FLAVOR-ML-MATCH]. *)

type Outcome =
    Ok
        value : string
    Err
        message : string

type Status =
    Active
    Inactive

(** A union whose two variants carry payloads of different kinds. Construction
    once wrote the variant into a stack `alloca` and returned that pointer, so a
    value RETURNED from one function and passed straight into another read a
    garbage int, or segfaulted the moment its string payload was dereferenced.
    Heap allocation is what makes `render (classify n)` well-defined. *)
type Grade =
    Score
        points : int
    Reason
        text : string

effect OutcomeAudit
    observe : string => Unit

(** Audits whatever leaf type a lookup recovered, at every instantiation. *)
effect MapLookupAudit T
    observe : T => Unit

(** The two generic lookups an audited map needs: one recovers a value at any
    leaf type, the other reaches through a map of lists. One definition each, so
    the suite instantiates ONE generic body at int, string and List rather than
    pinning three monomorphic copies. *)
valueOr<T> : (Map<string, T>, string, T) -> T
valueOr (items, key, fallback) = mapGet items key ?: fallback

listValueAt<T> : (Map<string, List<T>>, string, int, T) -> T
listValueAt (items, key, index, fallback) = listGet (valueOr (items, key, [fallback])) index ?: fallback

describe o =
    match o
        Ok value => "ok: " + value
        Err message => "err: " + message

classify points =
    match points
        0 => Reason(text = "empty")
        _ => Score(points = points)

render g =
    match g
        Score points => "score " + toString points
        Reason text => "reason " + text

label s =
    match s
        Active => "active"
        Inactive => "inactive"

chooseOutcome<T> : (Outcome, T, T) -> T
chooseOutcome (outcome, accepted, rejected) =
    match outcome
        Ok _value => accepted
        Err _message => rejected

outcomeShape outcomes =
    match outcomes
        [] => "empty"
        [only] => "one:${describe only}"
        [first, second] => "two:${describe first}/${describe second}"
        [head, ...tail] => "many:${describe head}+${listLength tail}"

auditOutcomes outcomes =
    mut trace = ""
    handle OutcomeAudit
        observe rendered =>
            trace := trace + rendered + "|"
    forEachList outcomes (\outcome => perform OutcomeAudit.observe (describe outcome))
    trace

auditIntKeys (items, keys) =
    mut encoded = 0
    handle MapLookupAudit
        observe value =>
            encoded := encoded * 100 + value 
    forEachList keys (\key => perform MapLookupAudit.observe (valueOr (items, key, 0)))
    encoded

auditStringKeys (items, keys) =
    mut encoded = ""
    handle MapLookupAudit
        observe value =>
            encoded := encoded + value + "/"
    forEachList keys (\key => perform MapLookupAudit.observe (valueOr (items, key, "missing")))
    encoded

(** `topMap` is BUILT at runtime, so its handle is opaque. Indexing one used to
    read that handle as the flat `{i64, i8*}` array a map LITERAL lowers to and
    segfaulted; the index now routes through the same C runtime get as `mapGet`. *)
seedValue = 9
topMap = mapSet (mapSet (Map ()) "a" seedValue) "b" 16
topProbe = match topMap["a"]
    Success value => "a=${value}"
    Error _message => "miss"

print "${describe (Ok(value = "loaded"))}\n${describe (Err(message = "missing"))}\n${label Active}\n${label Inactive}\n${render (classify 27)}\n${render (classify 0)}\n${topProbe}\nlen ${mapLength topMap}"

(** One realistic flow stores union values in persistent generic collections,
    recovers them through `Result`, visits them through an effectful callback,
    and instantiates one generic selector at unrelated result types. *)
userDefinedUnionCase () =
    loaded = Ok(value = "loaded")
    missing = Err(message = "missing")
    cached = Ok(value = "cached")
    outcomes = [loaded, missing]
    grown = outcomes |> listAppend cached
    prefixed = grown |> listPrepend (Err(message = "offline"))
    reversed = listReverse prefixed
    byName = ["primary" => loaded, "failure" => missing]
    updated = byName |> mapSet "cached" cached
    withoutFailure = updated |> mapRemove "failure"
    merged = byName |> mapMerge ["primary" => cached, "offline" => Err(message = "offline")]
    fallback = Err(message = "fallback")

    checkAll "union tags and payloads survive direct construction" [
        structuralEquals [describe loaded, describe missing] ["ok: loaded", "err: missing"],
        structuralEquals [describe cached, describe (Err(message = "offline"))] ["ok: cached", "err: offline"],
        structuralEquals [label Active, label Inactive] ["active", "inactive"],
        label Active != label Inactive
    ]

    checkAll "union lists preserve order patterns Results and persistence" [
        structuralEquals [listLength outcomes, listLength grown, listLength prefixed] [2, 3, 4],
        structuralEquals [listLength reversed, listLength outcomes] [4, 2],
        describe (listGet outcomes 0 ?: fallback) == "ok: loaded",
        describe (listGet outcomes 1 ?: fallback) == "err: missing",
        describe (listGet grown 2 ?: fallback) == "ok: cached",
        describe (listGet prefixed 0 ?: fallback) == "err: offline",
        describe (listGet reversed 0 ?: fallback) == "ok: cached",
        describe (listGet reversed 3 ?: fallback) == "err: offline",
        structuralEquals [describe (listGet outcomes 9 ?: fallback), outcomeShape []] ["err: fallback", "empty"],
        outcomeShape [loaded] == "one:ok: loaded",
        outcomeShape outcomes == "two:ok: loaded/err: missing",
        structuralEquals [outcomeShape grown, auditOutcomes outcomes] ["many:ok: loaded+2", "ok: loaded|err: missing|"],
        auditOutcomes grown == "ok: loaded|err: missing|ok: cached|"
    ]

    checkAll "union maps preserve replacement removal lookup and generic choices" [
        structuralEquals [mapLength byName, mapLength updated, mapLength withoutFailure, mapLength merged] [2, 3, 2, 3],
        structuralEquals [listLength (mapKeys merged), listLength (mapValues merged)] [3, 3],
        chooseOutcome (loaded, 41, 99) == 41,
        listLength (chooseOutcome (loaded, [[1], [2, 3]], [[9]])) == 2,
        listLength (listGet (chooseOutcome (loaded, [[1], [2, 3]], [[9]])) 1 ?: [99]) == 2,
        describe (mapGet byName "primary" ?: fallback) == "ok: loaded",
        describe (mapGet byName "failure" ?: fallback) == "err: missing",
        describe (mapGet updated "cached" ?: fallback) == "ok: cached",
        describe (mapGet withoutFailure "failure" ?: fallback) == "err: fallback",
        describe (mapGet merged "primary" ?: fallback) == "ok: cached",
        describe (mapGet merged "offline" ?: fallback) == "err: offline",
        chooseOutcome (missing, "accepted", "rejected") == "rejected",
        mapContains byName "primary",
        mapContains updated "cached",
        !(mapContains withoutFailure "failure"),
        chooseOutcome (cached, true, false)
    ]

    checkAll "returned union values stay valid call arguments" [
        structuralEquals [render (classify 27), render (classify 0)] ["score 27", "reason empty"],
        structuralEquals [render (classify ((0 - 4) )), render (Score(points = 9))] ["score -4", "score 9"],
        render (Reason(text = "blocked")) == "reason blocked"
    ]

test "user-defined union variants preserve their tags and payloads" (exactly userDefinedUnionCase)

(** Exercise generic lookup at scalar and nested collection types on maps BUILT
    at runtime, then route every recovered value through one generic effect. *)
builtMapIndexCase () =
    built = mapSet (mapSet (Map ()) "a" 9) "b" 16
    replaced = built |> mapSet "a" 25
    removed = replaced |> mapRemove "b"
    merged = built |> mapMerge ["b" => 36, "c" => 49]
    words = ["first" => "ant", "second" => "bee"]
    wordGrowth = words |> mapSet "third" "cat"
    buckets = ["odd" => [1, 3, 5], "even" => [2, 4, 6]]
    bucketGrowth = buckets |> mapSet "prime" [2, 3, 5, 7]
    stringBuckets = ["short" => ["a", "bb"], "long" => ["three", "seven"]]
    nestedMaps = [buckets, bucketGrowth]
    absent = match built["missing"]
        Success _value => false
        Error message => message != ""

    checkAll "built scalar maps preserve lookup replacement and persistence" [
        structuralEquals [(built["a"] ?: ((0 - 1) )), (built["b"] ?: ((0 - 1) ))] [9, 16],
        structuralEquals [valueOr (built, "a", ((0 - 1) )), mapLength built, mapLength replaced] [9, 2, 2],
        structuralEquals [valueOr (replaced, "a", 0), valueOr (built, "a", 0), mapLength removed] [25, 9, 1],
        structuralEquals [mapLength merged, valueOr (merged, "a", 0), valueOr (merged, "b", 0)] [3, 9, 36],
        structuralEquals [valueOr (merged, "c", 0), auditIntKeys (built, ["a", "b"])] [49, 916],
        auditIntKeys (merged, ["a", "b", "c"]) == 93649,
        valueOr (built, "missing", ((0 - 1) )) == ((0 - 1) ),
        mapContains built "a",
        mapContains built "b",
        !(mapContains built "missing"),
        absent,
        mapContains removed "a",
        !(mapContains removed "b")
    ]

    checkAll "generic lookup instantiations stay isolated across leaf types" [
        structuralEquals [valueOr (words, "first", "missing"), valueOr (words, "second", "missing")] ["ant", "bee"],
        valueOr (words, "absent", "missing") == "missing",
        valueOr (wordGrowth, "third", "missing") == "cat",
        valueOr (words, "third", "missing") == "missing",
        auditStringKeys (words, ["first", "second"]) == "ant/bee/",
        auditStringKeys (wordGrowth, ["third", "first"]) == "cat/ant/",
        structuralEquals [mapLength words, mapLength wordGrowth] [2, 3],
        structuralEquals [listLength (mapKeys wordGrowth), listLength (mapValues wordGrowth)] [3, 3]
    ]

    checkAll "maps of lists retain their nested element descriptors" [
        structuralEquals [mapLength buckets, mapLength bucketGrowth] [2, 3],
        listLength (valueOr (buckets, "odd", [99])) == 3,
        listLength (valueOr (bucketGrowth, "prime", [99])) == 4,
        structuralEquals [listValueAt (buckets, "odd", 0, 99), listValueAt (buckets, "odd", 2, 99)] [1, 5],
        structuralEquals [listValueAt (buckets, "even", 0, 99), listValueAt (buckets, "even", 2, 99)] [2, 6],
        structuralEquals [listValueAt (bucketGrowth, "prime", 3, 99), listValueAt (buckets, "missing", 0, 99)] [7, 99],
        structuralEquals [listValueAt (buckets, "odd", 9, 99), listLength nestedMaps] [99, 2],
        listValueAt (listGet nestedMaps 0 ?: ["fallback" => [99]], "odd", 2, 99) == 5,
        listValueAt (listGet nestedMaps 1 ?: ["fallback" => [99]], "prime", 3, 99) == 7,
        listValueAt (stringBuckets, "short", 0, "missing") == "a",
        listValueAt (stringBuckets, "short", 1, "missing") == "bb",
        listValueAt (stringBuckets, "long", 0, "missing") == "three",
        listValueAt (stringBuckets, "long", 1, "missing") == "seven"
    ]
test "built maps support indexed lookup" (exactly builtMapIndexCase)
