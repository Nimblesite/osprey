// Recursive unions — every payload shape the spec promises:
//   1. List<Self>            (JArr — payload owns variants of its own type)
//   2. Map<string, Self>     (JObj — payload owns variants by string key)
//   3. Self directly         (Tree — Node owns two Self in left/right)
//   4. Mutually recursive    (Expr <-> Stmt)
// Every shape is unwound through multiple matches to prove variant tags
// survive boxing/unboxing across recursive storage.
//
// Spec: 0004-TypeSystem.md [TYPE-UNION-REC]

/// ---------- 1+2: JSON-style union with List<Self> + Map<string, Self> ----------
type JsonValue =
    JNull
    | JBool { v: bool }
    | JNum  { v: int }
    | JStr  { v: string }
    | JArr  { items:   List<JsonValue> }
    | JObj  { entries: Map<string, JsonValue> }

fn describe(j) = match j {
    JNull             => "null"
    JBool(_v)       => "bool"
    JNum(_v)       => "num"
    JStr(_v)       => "str"
    JArr(_items)   => "arr"
    JObj(_entries) => "obj"
}

fn announce(j) = print(describe(j))

/// Prints each row on its own line.
fn announceLine(v) = print(v)

/// True when `j`'s tag is among the described tags of `items`.
fn tagsHave(items, j) = listContains(mapList(items, describe), describe(j))

/// Prints `found` when `ok` holds, `lost` otherwise.
fn reportMember(ok, found, lost) = match ok { true => print(found) false => print(lost) }

/// Applies `test` to a JArr payload's items, or yields `fallback` for other variants.
fn withArrItems(a, test, fallback) = match a {
    JArr { items } => test(items)
    _              => fallback
}

/// Applies `test` to a JObj payload's entries, or yields `fallback` for other variants.
fn withObjEntries(o, test, fallback) = match o {
    JObj { entries } => test(entries)
    _                => fallback
}

/// Announces `found`/`lost` for `j`'s tag against a JArr payload's items.
fn announceArrTag(a, j, found, lost) = match a {
    JArr { items } => reportMember(tagsHave(items, j), found, lost)
    _              => print("not arr")
}

/// Announces `found`/`lost` for `key` against a JObj payload's entries.
fn announceObjKey(o, key, found, lost) = match o {
    JObj { entries } => reportMember(mapContains(entries, key), found, lost)
    _                => print("not obj")
}

/// Announces `found`/`lost` for `j`'s tag against a JObj payload's values.
fn announceObjTag(o, j, found, lost) = match o {
    JObj { entries } => reportMember(tagsHave(mapValues(entries), j), found, lost)
    _                => print("not obj")
}

/// --- List<Self> payload ---
let jNum  = JNum  { v: 42 }
let jStr  = JStr  { v: "hi" }
let jBool = JBool { v: true }
let inner = List() |> listAppend(jNum) |> listAppend(jStr) |> listAppend(jBool)
let arr   = JArr { items: inner }

print(describe(arr))
print(describe(jNum))
print(describe(JNull))
match arr {
    JArr { items } => print(toString(listLength(items)))
    _              => print("not arr")
}
match arr {
    JArr { items } => forEachList(items, announce)
    _              => print("not arr")
}
announceArrTag(arr, jNum, "hasNum", "lostNum")
announceArrTag(arr, jBool, "hasBool", "lostBool")

/// --- Map<string, Self> payload ---
let nameVal = JStr { v: "alice" }
let ageVal  = JNum { v: 30 }
let obj = JObj {
    entries: Map() |> mapSet("name", nameVal)
                   |> mapSet("age",  ageVal)
}

match obj {
    JObj { entries } => print(toString(mapLength(entries)))
    _                => print("not obj")
}
announceObjKey(obj, "name", "has name", "no name")
match obj {
    JObj { entries } => forEachList(mapValues(entries), announce)
    _                => print("not obj")
}
announceObjTag(obj, nameVal, "hasName", "lostName")
match obj {
    JObj { entries } => print(toString(listLength(mapKeys(entries))))
    _                => print("not obj")
}

/// ---------- 3: Plain self-recursive (Tree) ----------
type Tree = Leaf | Node { value: int, left: Tree, right: Tree }

/// A leaf carrying `v`.
fn leaf(v) = Node { value: v, left: Leaf, right: Leaf }

/// A node whose left child is a leaf and whose right child is the leaf `w`.
fn skewed(v, w) = Node { value: v, left: Leaf, right: leaf(w) }

fn label(t) = match t {
    Leaf                        => "leaf"
    Node(_value, _left, _right) => "node"
}
fn rootVal(t) = match t {
    Leaf                        => 0
    Node(value, _left, _right) => value
}
/// Applies `f` to `t`'s right child when `toRight`, its left child otherwise.
fn navigate(t, toRight, f, fallback) = match t {
    Leaf                      => fallback
    Node(_value, left, right) => match toRight { true => f(right) false => f(left) }
}
/// Label of `t`'s left child, or "leaf" when there is none.
fn leftLabel(t) = navigate(t, false, label, "leaf")
/// Value at the root of `t`'s right child, or 0 when there is none.
fn rightRootVal(t) = navigate(t, true, rootVal, 0)
/// Value at the root of `t`'s right child's right child.
fn rightRightVal(t) = navigate(t, true, rightRootVal, 0)
/// Value at the root of `t`'s left child's right child.
fn leftRightVal(t) = navigate(t, false, rightRootVal, 0)

///             4
///           /   \
///         2       6
///        / \     / \
///       1   3   5   7
let n1 = leaf(1)
let n3 = leaf(3)
let n5 = leaf(5)
let n7 = leaf(7)
let n2 = Node { value: 2, left: n1, right: n3 }
let n6 = Node { value: 6, left: n5, right: n7 }
let root = Node { value: 4, left: n2, right: n6 }

forEachList([
    label(root),
    label(Leaf),
    toString(rootVal(root)),
    leftLabel(root),
    leftLabel(n1),
    toString(rightRootVal(root)),
    toString(rightRightVal(root)),
    toString(leftRightVal(root))
], announceLine)

/// ---------- 4: Mutually recursive (Expr <-> Stmt) ----------
type Expr =
    ENum   { v: int }
    | EAdd { args: List<Expr> }
    | EBlk { body: Stmt }

type Stmt =
    SLet     { name: string, value: Expr }
    | SRet   { value: Expr }

fn descExpr(e) = match e {
    ENum(_v)    => "num"
    EAdd(_args) => "add"
    EBlk(_body) => "blk"
}
fn descStmt(s) = match s {
    SLet(_name, _value) => "let"
    SRet(_value)        => "ret"
}
fn numValue(e) = match e {
    ENum { v } => v
    EAdd(_args) => 999
    EBlk(_body) => 999
}
fn announceExpr(e) = print(descExpr(e))
fn announceNum(e)  = print(toString(numValue(e)))

fn unwrapBlk(e) = match e {
    EBlk { body } => body
    _             => SRet { value: ENum { v: 0 } }
}
fn unwrapRet(s) = match s {
    SRet { value } => value
    _              => ENum { v: 0 }
}
fn unwrapAddLen(e) = match e {
    EAdd { args } => listLength(args)
    _             => 999
}

let two   = ENum { v: 2 }
let three = ENum { v: 3 }
let sum   = EAdd { args: List() |> listAppend(two) |> listAppend(three) }
let stmt  = SRet { value: sum }
let outer = EBlk { body: stmt }

let s1 = unwrapBlk(outer)
let e1 = unwrapRet(s1)
forEachList([
    descExpr(two),
    descExpr(sum),
    descExpr(outer),
    descStmt(stmt),
    descStmt(s1),
    descExpr(e1),
    toString(unwrapAddLen(e1))
], announceLine)

match e1 {
    EAdd { args } => {
        forEachList(args, announceExpr)
        forEachList(args, announceNum)
    }
    _ => print("expected EAdd")
}

/// Verifies recursive list, map, tree, and mutually-recursive payloads survive unwrapping.
fn recursiveUnionCase() = {
    let arrayNumber = JNum { v: 7 }
    let arrayText = JStr { v: "seven" }
    let recursiveArray = JArr {
        items: List() |> listAppend(arrayNumber) |> listAppend(arrayText)
    }
    let arrayLength = withArrItems(recursiveArray, fn(items) => listLength(items), 0)
    let arrayHasNumber = withArrItems(recursiveArray, fn(items) => tagsHave(items, arrayNumber), false)
    let recursiveObject = JObj {
        entries: Map() |> mapSet("answer", arrayNumber) |> mapSet("word", arrayText)
    }
    let objectLength = withObjEntries(recursiveObject, fn(entries) => mapLength(entries), 0)
    let objectHasWord = withObjEntries(recursiveObject, fn(entries) => mapContains(entries, "word"), false)
    let leftChild = skewed(2, 3)
    let rightChild = skewed(6, 7)
    let recursiveTree = Node { value: 4, left: leftChild, right: rightChild }
    let expressionArgs = List() |> listAppend(ENum { v: 2 }) |> listAppend(ENum { v: 3 })
    let recursiveExpression = EBlk { body: SRet { value: EAdd { args: expressionArgs } } }
    let unwrappedExpression = unwrapRet(unwrapBlk(recursiveExpression))
    checkAll("recursive union payloads", [
        structuralEquals([describe(recursiveArray), describe(recursiveObject)], ["arr", "obj"]),
        structuralEquals([label(recursiveTree), leftLabel(recursiveTree)], ["node", "node"]),
        structuralEquals([descExpr(recursiveExpression), descStmt(unwrapBlk(recursiveExpression))], ["blk", "ret"]),
        descExpr(unwrappedExpression) == "add",
        structuralEquals([arrayLength, objectLength, rootVal(recursiveTree)], [2, 2, 4]),
        structuralEquals([leftRightVal(recursiveTree), rightRootVal(recursiveTree)], [3, 6]),
        structuralEquals([rightRightVal(recursiveTree), unwrapAddLen(unwrappedExpression)], [7, 2]),
        arrayHasNumber,
        objectHasWord
    ])
}
test("recursive union payloads retain nested tags and values", recursiveUnionCase)
