// HINDLEY-MILNER TYPE INFERENCE TEST
// ML-flavor twin: lowers to the same canonical AST as the Default flavor, so
// the LLVM IR is byte-identical. No explicit type annotations — every type is
// inferred from usage context exactly as in the Default twin.

(** Type definitions needed for the test *)
type Pair =
    first : int
    second : int
type Point =
    x : int
    y : int
type Container =
    value : string
    label : string

(** Generic record shapes shared by the equality and unification tests: declared
    once, since both tests only differ in the type arguments they use. *)
type Generic T =
    data : T
type AnotherGeneric T U =
    first : T
    second : U
type Box T =
    item : T
type Pair2 A B =
    left : A
    right : B

(** One polymorphic factory per generic record shape *)
makeGeneric value = Generic(data = value)
makeAnotherGeneric (a, b) = AnotherGeneric(first = a, second = b)
makeBox val = Box(item = val)
makePair2 (a, b) = Pair2(left = a, right = b)

print "=== HINDLEY-MILNER TEST ==="

// Test 1: Function parameter and return type inference
print "Test 1: Function type inference from usage"
(** These functions have NO explicit types - all inferred! *)
identity x = x
add (a, b) = a + b 
concat (s1, s2) = join [s1, s2] ""
negate x = !x

(** Usage drives monomorphization *)
intId = identity 42
stringId = identity "test"
boolId = identity true

print "identity(42) = ${intId}, identity(\"test\") = ${stringId}, identity(true) = ${toString boolId}"

(** Test arithmetic inference *)
addValue = exactArithmetic (\() =>
    add (10, 20))
concatResult = concat ("hello", "world")
negateResult = negate false

print "add(10, 20) = ${addValue}, concat = ${concatResult}, negate(false) = ${toString negateResult}"

// Test 3: Function inference with generic records
print "\nTest 3: Function inference with generic records"
getFirst p = p.first
getSecond p = p.second
getValue c = c.value

intPair = Pair(first = 100, second = 200)
container1 = Container(value = "hello", label = "test")

firstInt = getFirst intPair
valueString = getValue container1
secondInt = getSecond intPair

print "getFirst(intPair) = ${firstInt}\ngetValue(container1) = ${valueString}\ngetSecond(intPair) = ${secondInt}"

// Test 4: Polymorphic functions with HM inference
print "\nTest 4: Polymorphic function inference"
identityP x = x
makePoint (a, b) = Point(x = a, y = b)

(** Each usage gets monomorphized *)
id1 = identityP 42
id2 = identityP "test"
id3 = identityP true

point1 = makePoint (1, 2)

print "identityP(42) = ${id1}\nidentityP(\"test\") = ${id2}\nidentityP(true) = ${toString id3}\nmakePoint(1, 2) = {${point1.x}, ${point1.y}}"

// Test 5: Complex HM inference with field access
print "\nTest 5: Complex field access inference"
distance p = p.x * p.x + p.y * p.y 
combine c = join [c.value, c.label] ""

numPoint = Point(x = 3, y = 4)
textContainer = Container(value = "hello", label = "world")

dist = exactArithmetic (\() =>
    distance numPoint)
combined = combine textContainer

print "distance({3, 4}) = ${dist}\ncombine({\"hello\", \"world\"}) = ${combined}"

// Test 6: Higher-order functions with HM inference
print "\nTest 6: Higher-order HM inference"
apply (f, x) = f x

intPoint = Point(x = 1, y = 2)
stringContainer = Container(value = "hello", label = "world")

(** Direct field access works perfectly with HM *)
pointX = intPoint.x
pointY = intPoint.y
pairFirst = intPair.first
pairSecond = intPair.second
containerValue = stringContainer.value
containerLabel = stringContainer.label

applied1 = apply (identityP, 99)
applied2 = apply (toString, 123)

print "intPoint.x = ${pointX}\nintPoint.y = ${pointY}\nintPair.first = ${pairFirst}\nintPair.second = ${pairSecond}\nstringContainer.value = ${containerValue}\nstringContainer.label = ${containerLabel}\napply(identityP, 99) = ${applied1}\napply(toString, 123) = ${applied2}"

// Test 7: Generic type equality testing (for GenericType.Equals coverage)
print "\nTest 7: Generic type equality comparison"

(** Each call site monomorphizes the shared factory to a different Generic<T> *)
gen1 = makeGeneric 42
gen2 = makeGeneric 99
gen3 = makeGeneric "test"
gen4 = makeAnotherGeneric (1, "two")
gen5 = makeAnotherGeneric (3, "four")

(** Access fields to force type unification and comparison *)
val1 = gen1.data
val2 = gen2.data
val3 = gen3.data
val4 = gen4.first
val5 = gen5.first

print "Generic type equality test - gen1.data = ${val1}\nGeneric type equality test - gen2.data = ${val2}\nGeneric type equality test - gen3.data = ${val3}\nGeneric type equality test - gen4.first = ${val4}\nGeneric type equality test - gen5.first = ${val5}"

// Test method call inference
print "\nTest 9: Method call type inference"

type StringWrapper =
    content : string

(** Add a method-like function that takes self *)
getLength _self = 42

uppercase self = self.content + "_UPPER"

wrapper = StringWrapper(content = "hello")

(** These aren't real method calls in OSP, but test the pattern *)
wrapperLen = getLength wrapper
wrapperUpper = uppercase wrapper

print "wrapper.length() equivalent = ${wrapperLen}\nwrapper.uppercase() equivalent = ${wrapperUpper}"

// Test unifyGenericTypes coverage
print "\nTest 10: Generic type unification"

(** Force generic type unification through usage *)
box1 = makeBox 100
box2 = makeBox "test"
pair2_1 = makePair2 (5, "five")
pair2_2 = makePair2 (true, 314)

(** Access to force unification *)
boxVal1 = box1.item
boxVal2 = box2.item
pairLeft = pair2_1.left
pairRight = pair2_1.right

print "Box<int>.item = ${boxVal1}\nBox<string>.item = ${boxVal2}\nPair2<int, string>.left = ${pairLeft}\nPair2<int, string>.right = ${pairRight}"

// Test type equality methods coverage
print "\nTest 11: Type equality and String methods"

(** This will exercise the String() and Equals() methods on various types *)
typeTest1 x = x * 2 
typeTest2 s = join [s, s] ""
typeTest3 b = !b

typeResult1 = exactArithmetic (\() =>
    typeTest1 21)
typeResult2 = typeTest2 "hi"
typeResult3 = typeTest3 false

print "typeTest1(21) = ${typeResult1}\ntypeTest2(\"hi\") = ${typeResult2}\ntypeTest3(false) = ${toString typeResult3}"

// Test declared fn type parameters + explicit construction-site type args
// Implements [TYPE-GENERICS-FN], [FLAVOR-ML-GENERICS]
print "\nTest 12: Declared type parameters"

// The binder is load-bearing: without <T>, the two `T` annotations would name
// a nominal type instead of pinning both parameters to ONE inferred type.
pick<T> : (T, T) -> T
pick (first, _second) = first

picked = pick (10, 20)
pickedStr = pick ("left", "right")
pinned = Box<int>(item = 7)
print "pick<T>(10, 20) = ${picked}, pick<T>(\"left\", \"right\") = ${pickedStr}\nBox<int> pinned explicitly: item = ${pinned.item}"

print "=== PURE HINDLEY-MILNER TEST COMPLETE ==="
print "All types inferred from usage context - no explicit type annotations!"

(** Verify inferred helpers remain polymorphic across values, records, and HOFs. *)
inferredBehaviorCase () =
    inferredPair = Pair(first = 11, second = 12)
    inferredPoint = makePoint (6, 8)
    inferredContainer = Container(value = "type", label = "safe")
    inferredBox = makeBox "boxed"
    inferredGeneric = makeAnotherGeneric (4, "four")
    checkAll "Hindley-Milner inferred behavior" [
        structuralEquals [identity 7, add (12, 30), getFirst inferredPair, getSecond inferredPair] [7, 42, 11, 12],
        structuralEquals [inferredPoint.x, inferredPoint.y, distance inferredPoint] [6, 8, 100],
        structuralEquals [apply (identityP, 99), inferredGeneric.first, typeTest1 21] [99, 4, 42],
        structuralEquals [identity "hm", concat ("type", "safe")] ["hm", "typesafe"],
        structuralEquals [getValue inferredContainer, combine inferredContainer] ["type", "typesafe"],
        structuralEquals [apply (toString, 123), inferredBox.item, inferredGeneric.second] ["123", "boxed", "four"],
        structuralEquals [typeTest2 "ha", pick ("left", "right")] ["haha", "left"],
        identity true,
        negate false,
        typeTest3 false
    ]

test "inference preserves polymorphism and derived values" (exactly inferredBehaviorCase)
