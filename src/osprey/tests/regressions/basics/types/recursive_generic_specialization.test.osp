/// An inferred recursive function specializes at each call's element type.
/// The self-call must resolve to the matching emitted specialization.
fn walk(xs, n) = match n {
    0 => xs
    _ => walk(listReverse(xs), (n - 1) )
}

exactArithmetic(fn() => print("${listLength(walk([5, 6, 7], 2))} ${listLength(walk(["a", "b"], 1))}"))

/// Verifies recursive integer and string specializations retain their contents.
fn recursiveGenericCase() = {
    let ints = walk([5, 6, 7], 2)
    let strings = walk(["a", "b"], 1)
    checkAll("recursive generic calls specialize without annotations", [
        structuralEquals([listLength(ints), (listGet(ints, 0) ?: 0), (listGet(ints, 1) ?: 0)], [3, 5, 6]),
        structuralEquals([(listGet(ints, 2) ?: 0), listLength(strings)], [7, 2]),
        structuralEquals([(listGet(strings, 0) ?: ""), (listGet(strings, 1) ?: "")], ["b", "a"])
    ])
}

test("recursive generic functions specialize for integers and strings", exactly(recursiveGenericCase))

/// Repeated generic calls share closed instantiations after bounded expansion.
fn twice(x) = "${x}${x}"
fn four(x) = "${twice(x)}${twice(x)}"
fn eight(x) = "${four(x)}${four(x)}"
fn sixteen(x) = "${eight(x)}${eight(x)}"
fn thirtyTwo(x) = "${sixteen(x)}${sixteen(x)}"
fn sixtyFour(x) = "${thirtyTwo(x)}${thirtyTwo(x)}"
fn oneTwentyEight(x) = "${sixtyFour(x)}${sixtyFour(x)}"
fn twoFiftySix(x) = "${oneTwentyEight(x)}${oneTwentyEight(x)}"
type Packet<A> = Packet { payload: A }
fn unpack(packet) = match packet { Packet { payload } => payload }
fn recover(result) = match result {
    Success { value } => satAdd(value, 1)
    Error { message } => byteLength(message)
}
effect GenericProbe { read: fn() -> string }
fn probed(x) = "${perform GenericProbe.read()}${x}"
fn withProbe(label) = {
    handle GenericProbe { read => label }
    probed("!")
}

fn sharedGenericCase() = {
    let expanded = twoFiftySix("q")
    checkAll("shared generic ABI and Result normalization", [
        structuralEquals([byteLength(expanded), (byteAt(expanded, 0) ?: 0)], [256, 113]),
        structuralEquals([(byteAt(expanded, 255) ?: 0), unpack(Packet { payload: 73 })], [113, 73]),
        structuralEquals([recover(Error { message: "bad" }), recover(Success { value: 41 })], [3, 42]),
        structuralEquals([unpack(Packet { payload: "payload" }), withProbe("left")], ["payload", "left!"]),
        withProbe("right") == "right!"
    ])
}

test("nested generic fanout preserves specialized values", sharedGenericCase)

/// A shared Result-returning specialization must retain its payload layout.
/// The recursive Result return needs this annotation to reach code generation.
fn payloadResult(marker, present, step) -> Result<List<int>, string> = match step {
    0 => match present {
        true => Success { value: [11, 22] }
        false => Error { message: "missing" }
    }
    _ => payloadResult(marker, present, 0)
}
fn payloadLength(xs) = match payloadResult(xs, true, 1) {
    Success { value } => length(value)
    Error { message } => byteLength(message)
}

fn sharedResultPayloadCase() = {
    let expanded = twoFiftySix("r")
    let numbers = payloadResult("ints", true, 1) ?: []
    let second = payloadResult(73, true, 1) ?: []
    checkAll("specialized Result list payloads remain lists", [
        structuralEquals([byteLength(expanded), length(numbers), length(second)], [256, 2, 2]),
        structuralEquals([payloadLength("marker"), payloadLength(73)], [2, 2])
    ])
}

test("shared Result specializations preserve list payloads", sharedResultPayloadCase)
