(** A generic walk that hands its whole node to a helper, which re-matches it
    and falls back to the walk, used to hang the compiler: each pass of the
    effect-provenance fixed point recomputed the walk's return value, and that
    value flipped between two shapes forever. A return that cycles is now
    joined with its earlier values, so the analysis settles. Implements
    [EFFECTS-PROVENANCE], [TYPE-GENERICS-FN] and [TYPE-UNION-REC]. *)
type Node A =
    Leaf
        label : string
    Button
        label : string
        action : A
    Group
        children : List<Node<A>>
    Disclosure
        action : A
        children : List<Node<A>>
    Aside
        column : Node<A>
        pane : Node<A>
        width : int
        action : A

type Binding A =
    Tap
        action : A
    Size
        action : A

type Walked A =
    bindings : List<Binding<A>>
    nodes : List<string>

one (bindings, text) = Walked(bindings = bindings, nodes = [text])

bound (bindings, binding, text) = one (listAppend bindings binding, text)

childAt (walked, children, index) = match listGet children index
    Success child =>
        next = walk (walked.bindings, child)
        Walked(bindings = next.bindings, nodes = listConcat walked.nodes next.nodes)
    Error _ => walked

all (bindings, children) = range (0, length children) |> fold (Walked(bindings = bindings, nodes = [])) (\(walked, index) => childAt (walked, children, index))

disclosure (bindings, action, children) =
    inner = all (listAppend bindings (Tap(action = action)), children)
    one (inner.bindings, "disclosure")

aside (bindings, node, action) = match node
    Aside column pane width _ =>
        content = walk (bindings, pane)
        beside = walk (content.bindings, column)
        bound (beside.bindings, Size(action = action), "aside ${toString width}")
    _ => walk (bindings, node)

walk (bindings, node) = match node
    Leaf label => one (bindings, label)
    Button label action => bound (bindings, Tap(action = action), label)
    Group children => all (bindings, children)
    Disclosure action children => disclosure (bindings, action, children)
    Aside _ _ _ action => aside (bindings, node, action)

tree = Group(children = [Leaf(label = "a"), Aside(column = Button(label = "b", action = 1), pane = Disclosure(action = 3, children = [Leaf(label = "c")]), width = 5, action = 2)])
done = walk ([], tree)
print "${join done.nodes ","} ${toString (length done.bindings)}"
