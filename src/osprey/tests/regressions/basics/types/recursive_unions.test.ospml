// Recursive unions — every payload shape the spec promises:
//   1. List<Self>            (JArr — payload owns variants of its own type)
//   2. Map<string, Self>     (JObj — payload owns variants by string key)
//   3. Self directly         (Tree — Node owns two Self in left/right)
//   4. Mutually recursive    (Expr <-> Stmt)
// Every shape is unwound through multiple matches to prove variant tags
// survive boxing/unboxing across recursive storage.
//
// Spec: 0004-TypeSystem.md [TYPE-UNION-REC]

(** ---------- 1+2: JSON-style union with List<Self> + Map<string, Self> ---------- *)
type JsonValue =
    JNull
    JBool
        v : bool
    JNum
        v : int
    JStr
        v : string
    JArr
        items : List JsonValue
    JObj
        entries : Map string JsonValue

describe j =
    match j
        JNull => "null"
        JBool _v => "bool"
        JNum _v => "num"
        JStr _v => "str"
        JArr _items => "arr"
        JObj _entries => "obj"

announce j = print (describe j)

(** Prints each row on its own line. *)
announceLine v = print v

(** True when `j`'s tag is among the described tags of `items`. *)
tagsHave items j = listContains (mapList items describe) (describe j)

(** Prints `found` when `ok` holds, `lost` otherwise. *)
reportMember ok found lost =
    match ok
        true => print found
        false => print lost

(** Applies `test` to a JArr payload's items, or yields `fallback` for other variants. *)
withArrItems a test fallback =
    match a
        JArr items => test items
        _ => fallback

(** Applies `test` to a JObj payload's entries, or yields `fallback` for other variants. *)
withObjEntries o test fallback =
    match o
        JObj entries => test entries
        _ => fallback

(** Announces `found`/`lost` for `j`'s tag against a JArr payload's items. *)
announceArrTag a j found lost =
    match a
        JArr items => reportMember (tagsHave items j) found lost
        _ => print "not arr"

(** Announces `found`/`lost` for `key` against a JObj payload's entries. *)
announceObjKey o key found lost =
    match o
        JObj entries => reportMember (mapContains entries key) found lost
        _ => print "not obj"

(** Announces `found`/`lost` for `j`'s tag against a JObj payload's values. *)
announceObjTag o j found lost =
    match o
        JObj entries => reportMember (tagsHave (mapValues entries) j) found lost
        _ => print "not obj"

(** --- List<Self> payload --- *)
jNum = JNum(v = 42)
jStr = JStr(v = "hi")
jBool = JBool(v = true)
inner = List() |> listAppend(jNum) |> listAppend(jStr) |> listAppend(jBool)
arr = JArr(items = inner)

print (describe arr)
print (describe jNum)
print (describe JNull)
match arr
    JArr items => print (toString (listLength items))
    _ => print "not arr"
match arr
    JArr items => forEachList items announce
    _ => print "not arr"
announceArrTag arr jNum "hasNum" "lostNum"
announceArrTag arr jBool "hasBool" "lostBool"

(** --- Map<string, Self> payload --- *)
nameVal = JStr(v = "alice")
ageVal = JNum(v = 30)
obj = JObj(entries = Map() |> mapSet "name" nameVal |> mapSet "age" ageVal)

match obj
    JObj entries => print (toString (mapLength entries))
    _ => print "not obj"
announceObjKey obj "name" "has name" "no name"
match obj
    JObj entries => forEachList (mapValues entries) announce
    _ => print "not obj"
announceObjTag obj nameVal "hasName" "lostName"
match obj
    JObj entries => print (toString (listLength (mapKeys entries)))
    _ => print "not obj"

(** ---------- 3: Plain self-recursive (Tree) ---------- *)
type Tree =
    Leaf
    Node
        value : int
        left : Tree
        right : Tree

(** A leaf carrying `v`. *)
leaf v = Node(value = v, left = Leaf, right = Leaf)

(** A node whose left child is a leaf and whose right child is the leaf `w`. *)
skewed v w = Node(value = v, left = Leaf, right = leaf w)

label t =
    match t
        Leaf => "leaf"
        Node _value _left _right => "node"
rootVal t =
    match t
        Leaf => 0
        Node value _left _right => value
(** Applies `f` to `t`'s right child when `toRight`, its left child otherwise. *)
navigate t toRight f fallback =
    match t
        Leaf => fallback
        Node _value left right =>
            match toRight
                true => f right
                false => f left
(** Label of `t`'s left child, or "leaf" when there is none. *)
leftLabel t = navigate t false label "leaf"
(** Value at the root of `t`'s right child, or 0 when there is none. *)
rightRootVal t = navigate t true rootVal 0
(** Value at the root of `t`'s right child's right child. *)
rightRightVal t = navigate t true rightRootVal 0
(** Value at the root of `t`'s left child's right child. *)
leftRightVal t = navigate t false rightRootVal 0

(**             4
              /   \
            2       6
           / \     / \
          1   3   5   7 *)
n1 = leaf 1
n3 = leaf 3
n5 = leaf 5
n7 = leaf 7
n2 = Node(value = 2, left = n1, right = n3)
n6 = Node(value = 6, left = n5, right = n7)
root = Node(value = 4, left = n2, right = n6)

forEachList [
    label root,
    label Leaf,
    toString (rootVal root),
    leftLabel root,
    leftLabel n1,
    toString (rightRootVal root),
    toString (rightRightVal root),
    toString (leftRightVal root)
] announceLine

(** ---------- 4: Mutually recursive (Expr <-> Stmt) ---------- *)
type Expr =
    ENum
        v : int
    EAdd
        args : List Expr
    EBlk
        body : Stmt

type Stmt =
    SLet
        name : string
        value : Expr
    SRet
        value : Expr

descExpr e =
    match e
        ENum _v => "num"
        EAdd _args => "add"
        EBlk _body => "blk"
descStmt s =
    match s
        SLet _name _value => "let"
        SRet _value => "ret"
numValue e =
    match e
        ENum v => v
        EAdd _args => 999
        EBlk _body => 999
announceExpr e = print (descExpr e)
announceNum e = print (toString (numValue e))

unwrapBlk e =
    match e
        EBlk body => body
        _ => SRet(value = ENum(v = 0))
unwrapRet s =
    match s
        SRet value => value
        _ => ENum(v = 0)
unwrapAddLen e =
    match e
        EAdd args => listLength args
        _ => 999

two = ENum(v = 2)
three = ENum(v = 3)
sum = EAdd(args = List() |> listAppend(two) |> listAppend(three))
stmt = SRet(value = sum)
outer = EBlk(body = stmt)

s1 = unwrapBlk outer
e1 = unwrapRet s1
forEachList [
    descExpr two,
    descExpr sum,
    descExpr outer,
    descStmt stmt,
    descStmt s1,
    descExpr e1,
    toString (unwrapAddLen e1)
] announceLine

match e1
    EAdd args =>
        forEachList args announceExpr
        forEachList args announceNum
    _ => print "expected EAdd"

(** Verify recursive list, map, tree, and mutually-recursive payloads survive unwrapping. *)
recursiveUnionCase () =
    arrayNumber = JNum(v = 7)
    arrayText = JStr(v = "seven")
    recursiveArray = JArr(items = List() |> listAppend arrayNumber |> listAppend arrayText)
    arrayLength = withArrItems recursiveArray (\items => listLength items) 0
    arrayHasNumber = withArrItems recursiveArray (\items => tagsHave items arrayNumber) false
    recursiveObject = JObj(entries = Map() |> mapSet "answer" arrayNumber |> mapSet "word" arrayText)
    objectLength = withObjEntries recursiveObject (\entries => mapLength entries) 0
    objectHasWord = withObjEntries recursiveObject (\entries => mapContains entries "word") false
    leftChild = skewed 2 3
    rightChild = skewed 6 7
    recursiveTree = Node(value = 4, left = leftChild, right = rightChild)
    expressionArgs = List() |> listAppend (ENum(v = 2)) |> listAppend (ENum(v = 3))
    recursiveExpression = EBlk(body = SRet(value = EAdd(args = expressionArgs)))
    unwrappedExpression = unwrapRet (unwrapBlk recursiveExpression)
    checkAll "recursive union payloads" [
        structuralEquals [describe recursiveArray, describe recursiveObject] ["arr", "obj"],
        structuralEquals [label recursiveTree, leftLabel recursiveTree] ["node", "node"],
        structuralEquals [descExpr recursiveExpression, descStmt (unwrapBlk recursiveExpression)] ["blk", "ret"],
        descExpr unwrappedExpression == "add",
        structuralEquals [arrayLength, objectLength, rootVal recursiveTree] [2, 2, 4],
        structuralEquals [leftRightVal recursiveTree, rightRootVal recursiveTree] [3, 6],
        structuralEquals [rightRightVal recursiveTree, unwrapAddLen unwrappedExpression] [7, 2],
        arrayHasNumber,
        objectHasWord
    ]
test "recursive union payloads retain nested tags and values" recursiveUnionCase
