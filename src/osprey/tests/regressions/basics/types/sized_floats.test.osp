/// Every float width: rounding boundaries, subnormals, signed zero, the
/// non-finite values, the IEEE comparison table, arithmetic and math at each
/// width, bit views, and conversions in every direction.
/// Implements [TYPE-NUMERIC-SIZED], [TYPE-NUMERIC-LITERAL],
/// [TYPE-NUMERIC-ARITH-WIDTH], [TYPE-NUMERIC-PRINT], [TYPE-NUMERIC-WORD],
/// [BUILTIN-CONVERT-FLOAT], [BUILTIN-FLOAT-BITS], [BUILTIN-MATH],
/// [BUILTIN-MATH-ROUNDING] and [FLOAT-IEEE-RESULTS].

type Reading = { level: float32, ratio: float16, wide: float }
type Box<T> = { held: T }
type Pair<T> = { left: T, right: T }
type Huge = { inf32: float32, nan32: float32, inf16: float16, nan16: float16 }

let wrapping = handler Arith {
    divideByZero _ _ => 0.0
    overflow _ _ _ wrapped => wrapped
    remainderByZero _ => 0
}

let f32One: float32 = 1.0
let f32Two: float32 = 2.0
let f32Tenth: float32 = 0.1
let f16One: float16 = 1.0
let f16Two: float16 = 2.0
let f16Tenth: float16 = 0.1

fn narrow(x: float32) = x + 0.0
fn returnsFloat32() -> float32 = 0.5
fn halve(x: float32) = x / 2.0
fn quarter() -> float16 = 0.25

/// Each width's overflow-to-infinity value, with the NaN that value makes of itself.
fn huge() = {
    let inf32 = toFloat32(350000000000000000000000000000000000000.0)
    let inf16 = toFloat16(340000000000000000000000000000000000000.0)
    Huge { inf32: inf32, nan32: inf32 - inf32, inf16: inf16, nan16: inf16 - inf16 }
}

/// The six IEEE comparisons of `a` against `b`, as one space-separated row.
fn orderRow(a, b) = "${a == b} ${a != b} ${a < b} ${a <= b} ${a > b} ${a >= b}"

/// One comparison row per operand pair, joined by newlines.
fn orderRows(pairs) = join(mapList(pairs, fn(pair) => orderRow(pair.left, pair.right)), "\n")

fn rounding() = {
    print("${f32Tenth} ${f16Tenth}")
    print("${toFloat32(1.0000000596046448)} ${toFloat16(1.00048828125)}")
    print("${toFloat32(16777217)} ${toFloat16(65519.9)}")
    print("${toFloat32(65504.0)} ${toFloat16(65504.0)}")
    print("${toFloat32(1234567936)} ${toFloat16(2048.0)}")
    print("${toFloat32(1.00048828125)} ${toFloat16(1.0000000596046448)}")
}

fn subnormals() = {
    print("${toFloat32(0.000000000000000000000000000000000000000000001)} ${toFloat16(0.00000006)}")
    print("${toFloat32(0.000000000000000000000000000000000000011754943508222875)} ${toFloat16(0.00006103515625)}")
    print("${toFloat32(0.000000000000000000000000000000000000000000001) * toFloat32(0.5)}")
    print("${toFloat16(0.00000006) * toFloat16(0.5)}")
}

fn nonfinite() = {
    let h = huge()
    print("${h.inf32} ${h.nan32} ${h.inf16} ${h.nan16}\n${toFloat32(sqrt(-1.0))} ${toFloat16(sqrt(-1.0))}\n${h.inf32 / h.inf32} ${h.inf16 / h.inf16}")
    print("${toFloat32(1.0) / toFloat32(0.000000000000000000000000000000000000000000001)}")
    print("${toFloat16(1.0) / toFloat16(0.00000006)}")
    print("${toFloat32(1.0) / toFloat32(0.0)} ${1.0 / 0.0}\n${-h.inf32} ${-h.inf16}\n${toFloat32(-0.0)} ${toFloat16(-0.0)}\n${toFloat32(-0.0) == toFloat32(0.0)} ${toFloat16(-0.0) == toFloat16(0.0)}")
}

fn comparisonTable() = {
    let h = huge()
    print("${orderRows([Pair { left: h.nan32, right: h.nan32 }, Pair { left: h.nan32, right: f32One }, Pair { left: f32One, right: h.nan32 }])}\n${orderRows([Pair { left: h.nan16, right: h.nan16 }, Pair { left: h.nan16, right: f16One }])}")
    print("${h.inf32 == h.inf32} ${h.inf32 > f32Two} ${h.inf32 < f32Two} ${f32Two < h.inf32}\n${h.inf16 == h.inf16} ${h.inf16 > f16Two} ${-h.inf16 < f16Two}")
    print("${orderRow(toFloat32(-0.0), toFloat32(0.0))}\n${orderRow(toFloat16(-0.0), toFloat16(0.0))}")
}

fn arithmetic() = {
    print("${f32One + f32One} ${f32Two - f32Tenth} ${toFloat32(3.0) * toFloat32(0.1)} ${f32One / 2.0}\n${f16One + f16One} ${f16Two - f16Tenth} ${toFloat16(3.0) * toFloat16(0.1)} ${f16One / 2.0}\n${toFloat32(5.5) % 2.0} ${toFloat32(-5.5) % 2.0} ${toFloat32(5.5) % -2.0}\n${toFloat16(5.5) % 2.0} ${toFloat16(-5.5) % 2.0}\n${-f32Tenth} ${-f16Tenth} ${abs(toFloat32(-2.5))} ${abs(toFloat16(-2.5))}\n${toFloat32(1.0) / 3.0} ${toFloat16(1.0) / 3.0}")
}

fn mathBuiltins() = {
    print("${sqrt(toFloat32(2.0))} ${sqrt(toFloat16(2.0))}\n${pow(toFloat32(2.0), toFloat32(10.0))} ${pow(toFloat16(2.0), toFloat16(10.0))}\n${pow(toFloat32(2.0), toFloat32(0.5))} ${pow(toFloat16(2.0), toFloat16(0.5))}\n${floor(toFloat32(-2.7))} ${floor(toFloat16(-2.7))}\n${round(toFloat32(2.5))} ${round(toFloat32(3.5))} ${round(toFloat32(-2.5))}\n${round(toFloat16(2.5))} ${round(toFloat16(3.5))} ${round(toFloat16(-2.5))}")
}

/// [FLOAT-IEEE-RESULTS] Runtime list inputs prevent folding away libm calls.
fn portableTanh() = {
    let inputs = [toFloat32(0.0), toFloat32(-0.0), toFloat32(0.5), toFloat32(-0.5), toFloat32(2.0), toFloat32(-2.0), toFloat32(1000.0), toFloat32(-1000.0), float32FromBits(1), float32FromBits(-2147483647)]
    let results = mapList(inputs, tanh)
    print(join(mapList(results, fn(value) => toString(float32Bits(value))), " "))
}

fn bitViews() = {
    print("${float32Bits(toFloat32(0.1))} ${float16Bits(toFloat16(1.0))}")
    print("${float32FromBits(1036831949)} ${float16FromBits(15360)}")
    print("${float32FromBits(float32Bits(f32Tenth))} ${float16FromBits(float16Bits(f16One))}")
    print("${floatBits(1.0)} ${floatFromBits(4607182418800017408)}")
    print("${float32Bits(toFloat32(-0.0))} ${float16Bits(toFloat16(-0.0))}")
    print("${float32FromBits(-2147483648)} ${float16FromBits(-32768)}")
}

fn conversions() = {
    print("${toFloat(7)} ${toFloat32(7)} ${toFloat16(7)}")
    print("${toFloat(toInt8(-3))} ${toFloat32(toUint8(200))} ${toFloat16(toInt16(-100))}")
    print("${toFloat32(16777217)} ${toFloat16(65519.9)} ${toFloat32(f16Tenth)} ${toFloat16(f32Tenth)}")
    print("${toFloat32(toFloat(0.1))} ${toFloat16(toFloat32(0.1))} ${toFloat(toFloat16(1.5))}")
    print("${floatToInt(toFloat32(2.9))} ${floatToInt(toFloat16(-2.9))} ${floatToInt(2.9)} ${floatToInt(sqrt(toFloat32(-1.0)))}")
    print("${toInt8(200)} ${toUint8(-1)} ${toInt32(toUint16(40000))} ${toInt(toUint32(4000000000))}")
}

fn journeys() = {
    let small: List<float32> = [0.5, 1.5, 0.1]
    let first = small[0] ?: toFloat32(0.0)
    let last = small[2] ?: toFloat32(0.0)
    let total = foldList(small, toFloat32(0.0), fn(sum, x) => sum + x)
    print("${first} ${last} ${length(small)}\n${total}")
    let inMap: Map<string, float32> = Map() |> mapSet("k", 0.25)
    let fromMap = inMap["k"] ?: toFloat32(0.0)
    let succeeded: Result<float32, string> = Success { value: 0.5 }
    let unpacked = match succeeded {
        Success { value } => value + 0.25
        _ => toFloat32(0.0)
    }
    print("${fromMap} ${unpacked}")
    let reading = Reading { level: 0.75, ratio: 0.5, wide: 0.25 }
    print("${reading.level + 0.25} ${reading.ratio + 0.25} ${reading.wide + 0.25}")
    let held: Box<float32> = Box { held: 0.125 }
    print("${held.held * toFloat32(2.0)}")
    let erased: any = f16Tenth
    print("${erased}")
}

fn matchSites() = {
    let chosen: float32 = match f32Tenth > 0.0 {
        true => 0.2
        false => 0.4
    }
    let picked: float16 = match f16One > 0.0 {
        true => 0.5
        false => 0.25
    }
    print("${chosen} ${picked}")
    let tenth = match f32Tenth {
        0.1 => "tenth"
        _ => "other"
    }
    let negative = match toFloat16(-1.5) {
        -1.5 => "minus"
        _ => "other"
    }
    let wide = match 0.1 {
        0.5 => "half"
        0.1 => "tenth"
        _ => "other"
    }
    print("${tenth} ${negative} ${wide}")
}

fn closureSites() = {
    let captured: float32 = 0.25
    let scale = fn(x) => x + captured
    let boost = fn(x: float16) => x + 0.25
    print("${scale(toFloat32(0.5))} ${boost(toFloat16(0.5))}")
}

fn builtinsByName() = {
    let roots32 = mapList([toFloat32(1.0), toFloat32(4.0), toFloat32(9.0)], sqrt)
    let roots16 = mapList([toFloat16(1.0), toFloat16(4.0), toFloat16(9.0)], sqrt)
    let widened = mapList(roots32, toFloat)
    let narrowed = mapList(roots16, toFloat32)
    let floored = mapList([toFloat32(-2.5), toFloat32(2.5)], floor)
    print("${roots32[0] ?: toFloat32(0.0)} ${roots32[2] ?: toFloat32(0.0)} ${roots16[1] ?: toFloat16(0.0)}\n${widened[0] ?: 0.0} ${length(widened)}\n${narrowed[2] ?: toFloat32(0.0)}\n${floored[0] ?: toFloat32(0.0)} ${floored[1] ?: toFloat32(0.0)}")
}

rounding()
subnormals()
wrapping(nonfinite)
comparisonTable()
arithmetic()
mathBuiltins()
portableTanh()
bitViews()
wrapping(conversions)
journeys()
matchSites()
closureSites()
builtinsByName()
print("${halve(toFloat32(1.0))} ${quarter()} ${narrow(0.5)} ${returnsFloat32()}")

fn strict(work) = {
    handle Arith {
        overflow op lhs rhs wrapped => {
            print("overflow ${op} ${lhs} ${rhs} ${wrapped}")
            99
        }
        divideByZero op lhs => {
            print("zero ${op} ${lhs}")
            0.0
        }
        remainderByZero lhs => {
            print("remainder ${lhs}")
            77
        }
    }
    work()
}

print("${strict(fn() => toFloat32(1.0) / toFloat32(0.0))}")
print("${strict(fn() => 1.0 / 0.0)}")
print("${strict(fn() => toFloat16(1.0) % toFloat16(0.0))}")

/// [TYPE-NUMERIC-ARITH-WIDTH] Helpers infer their arithmetic width.
fn generic32Add(a, b) = a + b
fn generic32Sub(a, b) = a - b
fn generic32Mul(a, b) = a * b
fn genericDiv(a, b) = a / b
fn generic32Rem(a, b) = a % b
fn generic16Add(a, b) = a + b
fn generic16Sub(a, b) = a - b
fn generic16Mul(a, b) = a * b
fn generic16Rem(a, b) = a % b
fn generic32Cancel(a, b) = (a + b) - a
fn generic16Cancel(a, b) = (a + b) - a
fn generic64Cancel(a, b) = (a + b) - a
fn genericResult(a, b) = {
    let quotient = genericDiv(a, b)
    Success { value: quotient }
}
let divisionAlias = genericDiv
fn genericArithmetic() = {
    print("${float32Bits(generic32Add(toFloat32(5.5), toFloat32(2.25)))} ${float32Bits(generic32Sub(toFloat32(5.5), toFloat32(2.25)))} ${float32Bits(generic32Mul(toFloat32(5.5), toFloat32(2.25)))} ${float32Bits(genericDiv(toFloat32(5.5), toFloat32(2.25)))} ${float32Bits(generic32Rem(toFloat32(5.5), toFloat32(2.25)))}\n${float16Bits(generic16Add(toFloat16(5.5), toFloat16(2.25)))} ${float16Bits(generic16Sub(toFloat16(5.5), toFloat16(2.25)))} ${float16Bits(generic16Mul(toFloat16(5.5), toFloat16(2.25)))} ${float16Bits(genericDiv(toFloat16(5.5), toFloat16(2.25)))} ${float16Bits(generic16Rem(toFloat16(5.5), toFloat16(2.25)))}")
    print("${genericDiv(3, 1.5)} ${genericDiv(2.5, 2)} ${genericDiv(3, 2)} ${float32Bits(genericDiv(toFloat32(1.0), toFloat32(3.0)))} ${float16Bits(genericDiv(toFloat16(1.0), toFloat16(3.0)))}\n${float32Bits(divisionAlias(toFloat32(-0.0), toFloat32(2.0)))} ${float16Bits(divisionAlias(toFloat16(-0.0), toFloat16(2.0)))} ${float32Bits(genericDiv(float32FromBits(2), toFloat32(2.0)))} ${float16Bits(genericDiv(float16FromBits(2), toFloat16(2.0)))}")
    let result32 = genericResult(toFloat32(5.5), toFloat32(2.25))
    let result16 = genericResult(toFloat16(5.5), toFloat16(2.25))
    print("${float32Bits(result32 ?: toFloat32(0.0))} ${float16Bits(result16 ?: toFloat16(0.0))}")
    print("${generic32Cancel(toFloat32(16777216.0), toFloat32(1.0))} ${generic16Cancel(toFloat16(2048.0), toFloat16(1.0))} ${generic64Cancel(16777216.0, 1.0)}")
}
wrapping(genericArithmetic)
