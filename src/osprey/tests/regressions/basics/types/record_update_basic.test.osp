// Record Update Tests - Non-destructive updates per spec 3.7.4

print("=== RECORD UPDATE BASIC TESTS ===")

/// Test 1: Simple record type
type Point = {
    x: int,
    y: int
}

print("Test 1: Basic single field update")
let point1 = Point { x: 10, y: 20 }
print("Original: x=10, y=20")
print(point1.x)
print(point1.y)

let point2 = point1 { x: 30 }
print("After update x=30: x=30, y=20")
print(point2.x)
print(point2.y)

print("Original unchanged: x=10, y=20")
print(point1.x)
print(point1.y)

// Test 2: Multiple field update
print("Test 2: Multiple field update")
let point3 = point1 { x: 50, y: 60 }
print("After update x=50, y=60")
print(point3.x)
print(point3.y)

/// Test 3: Different record type
type Person = {
    name: string,
    age: int
}

print("Test 3: Different record type")
let alice = Person { name: "Alice", age: 25 }
print("Original: Alice, 25")
print(alice.name)
print(alice.age)

let older = alice { age: 26 }
print("After age update: Alice, 26")
print(older.name)
print(older.age)

// Test 4: Update with expressions
print("Test 4: Update with expressions")
let computed = point1 { x: 10, y: point1.x }
print("Computed update: x=10, y=10")
print(computed.x)
print(computed.y)

print("=== RECORD UPDATE BASIC TESTS COMPLETE ===")

type _ = { x: int }

/// Verifies updates replace selected fields without mutating their source record.
fn recordUpdateCase() = {
    let original = Point { x: 10, y: 20 }
    let moved = original { x: 30 }
    let replaced = original { x: 50, y: 60 }
    let person = Person { name: "Alice", age: 25 }
    let olderPerson = person { age: 26 }
    let computedPoint = original { x: original.y, y: original.x }
    checkAll("non-destructive record updates", [
        original.x == 10,
        original.y == 20,
        moved.x == 30,
        moved.y == 20,
        replaced.x == 50,
        replaced.y == 60,
        person.name == "Alice",
        person.age == 25,
        olderPerson.name == "Alice",
        olderPerson.age == 26,
        computedPoint.x == 20,
        computedPoint.y == 10,
        (_ { x: 9 }).x == 9
    ])
}
test("record updates preserve the source and untouched fields", recordUpdateCase)

/// Generic and nested record types for the cases below.
type Box<T> = { held: T }
type Pair<A, B> = { first: A, second: B }
type Tag = { x: string }
type Address = { city: string, zip: int }
type Company = { name: string, address: Address, active: bool }
type Cell = { v: any }

/// One update function serves every record that has the field: the write is
/// deferred to the call that fixes the record, exactly like a field read
/// ([TYPE-RECORD-UPDATE]).
fn setX(r, v) = r { x: v }
fn rename(p, name) = p { name: name }
fn rebox(b) = b { held: 5 }
fn swap(b, v) = b { held: v }
fn second(p, s) = p { second: s }
fn erase(c) = c { v: 1 }
fn describe(p) = "${p.x},${p.y}"

/// A handler arm rebinds a `mut` record to its own update, the one place
/// the language allows a rebinding.
effect Steer { nudge : fn(int) -> int }
fn steered() = {
    mut acc = Point { x: 0, y: 0 }
    handle Steer {
        nudge by => {
            acc = acc { x: by, y: satAdd(acc.y, by) }
            acc.y
        }
    }
    let first = perform Steer.nudge(5)
    let second = perform Steer.nudge(1)
    acc { x: satAdd(first, second) }
}

/// A recursive walk threads a record through its own updates.
fn walk(p, steps) = match steps {
    0 => p
    _ => walk(p { x: satAdd(p.x, 1), y: satAdd(p.y, 2) }, satSub(steps, 1))
}

fn genericUpdateCase() = {
    let point = Point { x: 1, y: 2 }
    let person = Person { name: "Alice", age: 25 }
    let movedPoint = setX(point, 7)
    let retagged = setX(Tag { x: "a" }, "b")
    let renamed = rename(person, "Bob")
    let boxed = Box { held: 1 }
    let reboxed = rebox(boxed)
    let swapped = swap(Box { held: "a" }, "b")
    let pair = Pair { first: 1, second: "one" }
    let repaired = second(pair, "uno")
    checkAll("updates through generic functions", [
        movedPoint.x == 7,
        movedPoint.y == 2,
        point.x == 1,
        retagged.x == "b",
        renamed.name == "Bob",
        renamed.age == 25,
        boxed.held == 1,
        reboxed.held == 5,
        swapped.held == "b",
        repaired.first == 1,
        repaired.second == "uno",
        pair.second == "one"
    ])
}

fn nestedUpdateCase() = {
    let home = Address { city: "Perth", zip: 6000 }
    let acme = Company { name: "Acme", address: home, active: true }
    let moved = acme { address: home { city: "Hobart" } }
    let closed = moved { active: false, name: "Acme (closed)" }
    let boxed = Box { held: 2 }
    let doubled = boxed { held: satMul(boxed.held, 2) }
    let pair = Pair { first: "a", second: 1 }
    let bumped = pair { second: satAdd(pair.second, 1), first: "b" }
    checkAll("nested and generic records update without touching their source", [
        moved.address.city == "Hobart",
        moved.address.zip == 6000,
        acme.address.city == "Perth",
        closed.active == false,
        closed.name == "Acme (closed)",
        closed.address.city == "Hobart",
        doubled.held == 4,
        boxed.held == 2,
        bumped.first == "b",
        bumped.second == 2,
        pair.second == 1
    ])
}

fn httpRecordPattern(response) = match response {
    HttpResponse { status, headers, contentType, streamFd, isComplete, partialBody } => status == 201 && headers == "X: yes" && contentType == "text/plain" && streamFd == -1 && !isComplete && partialBody == "updated"
}
fn erasedRecordStatus(value: any) = match value {
    { status, .. } => toString(status)
    _ => "missing"
}

/// [TYPE-RECORD-UPDATE] The C ABI record has no leading discriminant.
fn httpRecordLayout() = {
    let response = HttpResponse { status: 200, headers: "X: yes", contentType: "text/plain", streamFd: -1, isComplete: true, partialBody: "hi" }
    let changed = response { status: 201, isComplete: false, partialBody: "updated" }
    let selected = match changed { { status, isComplete, .. } => status == 201 && !isComplete }
    let erased: any = response
    let rendered = "{ status: 200, headers: X: yes, contentType: text/plain, streamFd: -1, isComplete: true, partialBody: hi }"
    selected && response.status == 200 && response.headers == "X: yes" && response.contentType == "text/plain" && response.streamFd == -1 && response.isComplete && response.partialBody == "hi" && changed.partialBody == "updated" && changed.headers == "X: yes" && toString(erased) == rendered && httpRecordPattern(changed) && erasedRecordStatus(response) == "200" && erasedRecordStatus(changed) == "201"
}

/// [TYPE-RECORD-ANON] Captures preserve nested anonymous layout identity.
fn nestedAnonymousCapture() = {
    let box = { child: { count: 42 }, label: "hi" }
    let read = fn(x) => {
        let selected = box.child
        wrapAdd(selected.count, x)
    }
    read(1) == 43 && box.child.count == 42 && box.label == "hi"
}

/// [TYPE-RECORD-UPDATE] Result fields retain their whole value across every record path.
type Outcome = { answer: Result<int, Error>, note: string }
type GenericOutcome<T> = { answer: Result<T, Error>, note: string }

fn readOutcome(record) = record.answer
fn matchOutcome(record) = match record {
    Outcome { answer, note } => toString(answer) == "Success(42)" && note == "copy"
}
fn structuralOutcome(record: Outcome) = match record {
    { answer, note } => toString(answer) == "Success(42)" && note == "copy"
}
fn resultRecordCase() = {
    let failed = Outcome { answer: Error { message: "kept" }, note: "first" }
    let success = failed { answer: 42 }
    let copied = success { note: "copy" }
    let erased: any = copied
    toString(failed.answer) == "Error(kept)" && toString(success.answer) == "Success(42)" && success.note == "first" && toString(readOutcome(copied)) == "Success(42)" && matchOutcome(copied) && structuralOutcome(copied) && toString(erased) == "{ answer: Success(42), note: copy }"
}
fn genericResultRecordCase() = {
    let floating = GenericOutcome { answer: Success { value: 2.5 }, note: "float" }
    let failed = floating { answer: Error { message: "float error" } }
    let promoted = failed { answer: 1.25 }
    let nested = GenericOutcome { answer: Success { value: Point { x: 4, y: 5 } }, note: "nested" }
    let erasedFloat: any = floating
    let erasedError: any = failed
    let erasedNested: any = nested
    let point = match readOutcome(nested) {
        Success { value } => value
        Error(_) => Point { x: 0, y: 0 }
    }
    toString(floating.answer) == "Success(2.5)" && toString(failed.answer) == "Error(float error)" && toString(promoted.answer) == "Success(1.25)" && point.x == 4 && point.y == 5 && toString(erasedFloat) == "{ answer: Success(2.5), note: float }" && toString(erasedError) == "{ answer: Error(float error), note: float }" && toString(erasedNested) == "{ answer: Success({ x: 4, y: 5 }), note: nested }"
}
fn anonymousResultRecordCase() = {
    let original = { answer: Success { value: false }, note: "anonymous" }
    let failed = original { answer: Error { message: "bool error" } }
    let copied = failed { note: "copy" }
    let success = copied { answer: true }
    toString(original.answer) == "Success(false)" && toString(failed.answer) == "Error(bool error)" && toString(readOutcome(copied)) == "Error(bool error)" && toString(success.answer) == "Success(true)" && copied.note == "copy"
}

/// [TYPE-RECORD-RESULT] Constructors, generic slots and live cells preserve failures.
type Delivery = Waiting | Delivered { answer: Result<float, Error> }
effect ReplaceOutcome { replace: fn(int) -> int }
fn deliveryResult(delivery) = match delivery {
    Waiting => "waiting"
    Delivered { answer } => toString(answer)
}
fn resultTransportCase() = {
    mut current = Outcome { answer: Error { message: "initial" }, note: "cell" }
    let read = fn() => current.answer
    let before = read()
    handle ReplaceOutcome {
        replace number => {
            current = current { answer: number }
            number
        }
    }
    let changed = perform ReplaceOutcome.replace(42)
    let boxed = Box { held: read() }
    let errorBox = Box { held: Error { message: "generic error" } }
    changed == 42 && toString(before) == "Error(initial)" && toString(read()) == "Success(42)" && toString(boxed.held) == "Success(42)" && toString(errorBox.held) == "Error(generic error)" && deliveryResult(Delivered { answer: 2.5 }) == "Success(2.5)" && deliveryResult(Delivered { answer: Error { message: "delivery" } }) == "Error(delivery)" && deliveryResult(Waiting) == "waiting"
}

/// [TYPE-RECORD-RESULT] Generic union slots preserve concrete Result payloads.
type Parcel<T> = Absent | Packed { answer: Result<T, Error> }
fn parcelText(parcel) = match parcel {
    Absent => "absent"
    Packed { answer } => toString(answer)
}
fn genericUnionResultCase() = {
    let floating = Packed { answer: Success { value: 2.5 } }
    let boolean = Packed { answer: Success { value: false } }
    let failed = Packed { answer: Error { message: "parcel" } }
    let erasedFloat: any = floating
    let erasedBool: any = boolean
    parcelText(floating) == "Success(2.5)" && parcelText(boolean) == "Success(false)" && parcelText(failed) == "Error(parcel)" && parcelText(Absent) == "absent" && toString(erasedFloat) == "Packed { answer: Success(2.5) }" && toString(erasedBool) == "Packed { answer: Success(false) }"
}

fn flowUpdateCase() = {
    let start = Point { x: 0, y: 0 }
    let stepped = match start.x {
        0 => start { x: 1 }
        _ => start { y: 1 }
    }
    let shift = fn(p) => p { y: satAdd(p.y, 10) }
    let shifted = shift(stepped)
    let walked = walk(start, 3)
    let steeredPoint = steered()
    checkAll("updates inside match arms, lambdas, recursion and handler arms", [
        stepped.x == 1,
        stepped.y == 0,
        shifted.y == 10,
        shifted.x == 1,
        walked.x == 3,
        walked.y == 6,
        start.x == 0,
        steeredPoint.x == 11,
        steeredPoint.y == 6,
        describe(start { y: 9, x: 8 }) == "8,9",
        nestedAnonymousCapture(),
        httpRecordLayout(),
        resultRecordCase(),
        genericResultRecordCase(),
        anonymousResultRecordCase(),
        resultTransportCase(),
        genericUnionResultCase()
    ])
}

let erasedCell = erase(Cell { v: "s" })
let walkedTwice = walk(Point { x: 1, y: 1 }, 2)
print("${erasedCell.v} ${describe(walkedTwice)}")
test("record updates through generic functions", genericUpdateCase)
test("record updates of nested and generic records", nestedUpdateCase)
test("record updates in control flow", flowUpdateCase)
