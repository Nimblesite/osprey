/// Every small integer type: both ends of its range, each operator at its
/// width, overflow through the one `Arith` policy, and each boxed journey — list,
/// map, record, `Result`, `any`, closure and generic function.
/// Implements [TYPE-NUMERIC-SIZED], [TYPE-NUMERIC-LITERAL],
/// [TYPE-NUMERIC-ARITH-WIDTH], [TYPE-NUMERIC-WORD], [BUILTIN-CONVERT-INT],
/// [BUILTIN-TOTAL-ARITH] and [BUILTIN-BITWISE].

type Packet = { tag: uint8, delta: int16, count: uint32, seq: int32 }

type Holder<T> = { held: T }

let wrapping = handler Arith {
    overflow _ _ _ wrapped => wrapped
    divideByZero _ _ => 0.0
    remainderByZero _ => 0
}

let i8Low: int8 = -128
let i8High: int8 = 127
let i16Low: int16 = -32768
let i16High: int16 = 32767
let i32Low: int32 = -2147483648
let i32High: int32 = 2147483647
let u8High: uint8 = 255
let u16High: uint16 = 65535
let u32High: uint32 = 4294967295
let u8Zero: uint8 = 0

print("${i8Low} ${i8High} ${i16Low} ${i16High} ${i32Low} ${i32High}")
print("${u8Zero} ${u8High} ${u16High} ${u32High}")

fn bump(n: int16) = n + 1
fn identity(x) = x
fn twice(f, x) = f(f(x))

/// Print four values as one space-separated row.
fn shown4(a, b, c, d) = print("${a} ${b} ${c} ${d}")

fn arithmetic() = {
    shown4(i8High + 1, i8Low - 1, i8High * 2, -i8Low)
    shown4(i16High + 1, i16Low - 1, i16High * 2, -i16Low)
    shown4(i32High + 1, i32Low - 1, i32High * 2, -i32Low)
    shown4(u8High + 1, u8Zero - 1, u8High * 2, -u8High)
    print("${u16High + 1} ${u16High * 2}")
    print("${u32High + 1} ${u32High * 2}")
    print("${abs(i8Low)} ${abs(i16High)} ${abs(u8High)}")
    shown4(u8High % 7, i8Low % 7, i8Low % -1, u32High % 10)
    shown4(u8High % u8Zero, intDiv(i8Low, -1), intDiv(u8High, 2), intDiv(u8High, u8Zero))
    print("${u8High / 2} ${i8Low / 2}")
    print("${bump(32767)} ${bump(41)}")
}

fn totalHelpers() = {
    shown4(wrapAdd(u8High, 1), wrapSub(u8Zero, 1), wrapMul(u8High, 2), wrapAdd(i8High, 1))
    print("${satAdd(u8High, 1)} ${satSub(u8Zero, 1)} ${satMul(u8High, 2)}")
    shown4(satAdd(i8High, 1), satSub(i8Low, 1), satMul(i8Low, -1), satAdd(u32High, 1))
    print("${bitAnd(u8High, 15)} ${bitOr(u8Zero, 3)} ${bitXor(u8High, 15)} ${bitNot(u8Zero)} ${bitNot(i8High)}")
    shown4(shiftLeft(u8High, 1), shiftRight(u8High, 1), shiftRight(i8Low, 1), shiftRightLogical(i8Low, 1))
    shown4(shiftLeft(u8High, 8), shiftRight(u8High, 8), shiftRight(i8Low, 8), shiftLeft(i16High, 15))
    shown4(checkedAdd(u8High, 1), checkedAdd(u8Zero, 1), checkedSub(u8Zero, 1), checkedMul(i8High, 2))
}

fn comparisons() = {
    shown4(u8High > 100, u32High > 2147483648, i8Low < 0, i32Low < i32High)
    shown4(u8High == 255, u8High != 255, u32High >= 4294967295, u8Zero <= 0)
    let label = match u8High {
        255 => "top"
        0 => "bottom"
        _ => "middle"
    }
    let signed = match i8Low {
        -128 => "least"
        _ => "other"
    }
    print("${label} ${signed}")
}

fn conversions() = {
    shown4(toInt(u8High), toInt(i8Low), toInt(u32High), toInt(i32Low))
    shown4(toInt16(i8Low), toInt32(u16High), toUint16(u8High), toUint32(u16High))
    print("${toUint8(300)} ${toInt8(u8High)} ${toUint8(i8Low)} ${toUint32(-1)} ${toInt32(u32High)}")
    print("${toInt8(100)} ${toUint8(255)} ${toFloat(u8High)} ${toFloat(i8Low)} ${toFloat(u32High)}")
    print("${toInt(bitNot(u8Zero)) + 1}")
}

/// Unwrap a `Result` and adjust its value, or answer with `fallback`.
fn unboxed(result, fallback, adjust) = match result {
    Success { value } => adjust(value)
    _ => fallback
}

fn journeys() = {
    let small: List<uint8> = [1, 200, u8High]
    let first = unboxed(small[1], u8Zero, fn(value) => value + 100)
    let negatives = [i8Low, -1, i8High]
    let last = unboxed(negatives[0], i8High, fn(value) => value - 1)
    print("${first} ${last} ${length(small)}")
    let total = foldList(small, u8Zero, fn(sum, x) => sum + x)
    print("${total}")
    let held = Holder { held: u8High }
    print("${held.held + 1}")
    let packet = Packet { tag: 250, delta: -32768, count: 4294967295, seq: 7 }
    shown4(packet.tag + 10, packet.delta - 1, packet.count + 1, packet.seq * 2)
    print("${identity(u8High) + 1} ${identity(i8Low) - 1}")
    print("${twice(fn(x) => x + 200, u8Zero)}")
    let scores = Map() |> mapSet("low", u8Zero) |> mapSet("high", u8High)
    let high = unboxed(scores["high"], u8Zero, fn(value) => value + 1)
    print("${high}")
    let chosen: uint8 = match length(small) > 1 {
        true => 7
        false => u8High
    }
    let joined = match length(small) {
        3 => u8High
        _ => 5
    }
    print("${chosen} ${joined + 1}")
    let parsed: Result<uint8, string> = Success { value: 200 }
    let unpacked = unboxed(parsed, u8Zero, fn(value) => value + 100)
    print("${unpacked}")
    let erased: any = u8High
    print("${erased}")
    print("${1 + 2} ${identity(9) + 1}")
}

wrapping(arithmetic)
wrapping(totalHelpers)
comparisons()
wrapping(conversions)
wrapping(journeys)

/// Report one intercepted `Arith` failure, then answer with `fallback`.
fn intercepted(label, detail, fallback) = {
    print("${label} ${detail}")
    fallback
}

fn strict(work) = {
    handle Arith {
        overflow op lhs rhs wrapped => intercepted("overflow", "${op} ${lhs} ${rhs} ${wrapped}", 99)
        divideByZero op lhs => intercepted("zero", "${op} ${lhs}", 0.0)
        remainderByZero lhs => intercepted("remainder", "${lhs}", 77)
    }
    work()
}

fn counting() = {
    mut seen: uint8 = 250
    handle Arith {
        overflow _ _ _ wrapped => {
            seen = seen + 10
            wrapped
        }
    }
    let moved = u8High + 2
    print("${moved} ${seen}")
}

wrapping(counting)

/// Print what `strict` answers for one intercepted computation.
fn strictShown(work) = print("${strict(work)}")

strictShown(fn() => u8High + 1)
strictShown(fn() => i8Low - 1)
strictShown(fn() => -u8High)
strictShown(fn() => abs(i8Low))
strictShown(fn() => intDiv(i16Low, -1))
strictShown(fn() => u8High % u8Zero)
strictShown(fn() => toUint8(i8Low))
strictShown(fn() => toUint32(i32Low))
strictShown(fn() => toInt8(u8High))
strictShown(fn() => u32High * 2)
