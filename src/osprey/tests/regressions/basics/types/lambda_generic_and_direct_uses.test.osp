/// One `let`-bound lambda used directly at `bool` and through the generic
/// `firstOf` at `string` and `int`. A use inside a generic function is a
/// different type at each of that function's instantiations, so it never
/// pins the shared lambda to one caller's type; each use keeps its own
/// ([TYPE-GENERICS-APPLY]). Pinning it to `bool` miscompiled the other two.

let boxIt = fn(x) => [x, x]
fn firstOf(v) = listGet(boxIt(v), 0)

fn mixedUses() = {
    let text = firstOf("text") ?: "none"
    let number = firstOf(7) ?: 0
    let flags = listLength(boxIt(true))
    print("${text} ${toString(number)} ${toString(flags)}")
    checkAll("each use keeps its own type", [text == "text", number == 7, flags == 2])
}

test("a lambda used directly and through a generic function keeps each type", mixedUses)
