(** Every small integer type: both ends of its range, each operator at its
    width, overflow through the one `Arith` policy, and each boxed journey — list,
    map, record, `Result`, `any`, closure and generic function.
    Implements [TYPE-NUMERIC-SIZED], [TYPE-NUMERIC-LITERAL],
    [TYPE-NUMERIC-ARITH-WIDTH], [TYPE-NUMERIC-WORD], [BUILTIN-CONVERT-INT],
    [BUILTIN-TOTAL-ARITH] and [BUILTIN-BITWISE]. *)

type Packet =
    tag : uint8
    delta : int16
    count : uint32
    seq : int32

type Holder T =
    held : T

wrapping = handler Arith
    overflow _ _ _ wrapped => wrapped
    divideByZero _ _ => 0.0
    remainderByZero _ => 0

i8Low : int8
i8Low = -128
i8High : int8
i8High = 127
i16Low : int16
i16Low = -32768
i16High : int16
i16High = 32767
i32Low : int32
i32Low = -2147483648
i32High : int32
i32High = 2147483647
u8High : uint8
u8High = 255
u16High : uint16
u16High = 65535
u32High : uint32
u32High = 4294967295
u8Zero : uint8
u8Zero = 0

print "${i8Low} ${i8High} ${i16Low} ${i16High} ${i32Low} ${i32High}\n${u8Zero} ${u8High} ${u16High} ${u32High}"

bump : int16 -> int16
bump n = n + 1
identity x = x
twice (f, x) = f (f x)

(** Print four values as one space-separated row. *)
shown4 (a, b, c, d) = print "${a} ${b} ${c} ${d}"

arithmetic () =
    shown4 (i8High + 1, i8Low - 1, i8High * 2, -i8Low)
    shown4 (i16High + 1, i16Low - 1, i16High * 2, -i16Low)
    shown4 (i32High + 1, i32Low - 1, i32High * 2, -i32Low)
    shown4 (u8High + 1, u8Zero - 1, u8High * 2, -u8High)
    print "${u16High + 1} ${u16High * 2}\n${u32High + 1} ${u32High * 2}\n${abs i8Low} ${abs i16High} ${abs u8High}"
    shown4 (u8High % 7, i8Low % 7, i8Low % -1, u32High % 10)
    shown4 (u8High % u8Zero, intDiv i8Low (-1), intDiv u8High 2, intDiv u8High u8Zero)
    print "${u8High / 2} ${i8Low / 2}\n${bump 32767} ${bump 41}"

totalHelpers () =
    shown4 (wrapAdd u8High 1, wrapSub u8Zero 1, wrapMul u8High 2, wrapAdd i8High 1)
    print "${satAdd u8High 1} ${satSub u8Zero 1} ${satMul u8High 2}"
    shown4 (satAdd i8High 1, satSub i8Low 1, satMul i8Low (-1), satAdd u32High 1)
    print "${bitAnd u8High 15} ${bitOr u8Zero 3} ${bitXor u8High 15} ${bitNot u8Zero} ${bitNot i8High}"
    shown4 (shiftLeft u8High 1, shiftRight u8High 1, shiftRight i8Low 1, shiftRightLogical i8Low 1)
    shown4 (shiftLeft u8High 8, shiftRight u8High 8, shiftRight i8Low 8, shiftLeft i16High 15)
    shown4 (checkedAdd u8High 1, checkedAdd u8Zero 1, checkedSub u8Zero 1, checkedMul i8High 2)

comparisons () =
    shown4 (u8High > 100, u32High > 2147483648, i8Low < 0, i32Low < i32High)
    shown4 (u8High == 255, u8High != 255, u32High >= 4294967295, u8Zero <= 0)
    label = match u8High
        255 => "top"
        0 => "bottom"
        _ => "middle"
    signed = match i8Low
        -128 => "least"
        _ => "other"
    print "${label} ${signed}"

conversions () =
    shown4 (toInt u8High, toInt i8Low, toInt u32High, toInt i32Low)
    shown4 (toInt16 i8Low, toInt32 u16High, toUint16 u8High, toUint32 u16High)
    print "${toUint8 300} ${toInt8 u8High} ${toUint8 i8Low} ${toUint32 (-1)} ${toInt32 u32High}\n${toInt8 100} ${toUint8 255} ${toFloat u8High} ${toFloat i8Low} ${toFloat u32High}\n${toInt (bitNot u8Zero) + 1}"

(** Unwrap a `Result` and adjust its value, or answer with `fallback`. *)
unboxed (result, fallback, adjust) = match result
    Success value => adjust value
    _ => fallback

journeys () =
    small : List<uint8>
    small = [1, 200, u8High]
    first = unboxed (small[1], u8Zero, \value => value + 100)
    negatives = [i8Low, -1, i8High]
    last = unboxed (negatives[0], i8High, \value => value - 1)
    print "${first} ${last} ${length small}"
    total = foldList small u8Zero (\(sum, x) => sum + x)
    print "${total}"
    kept = Holder(held = u8High)
    print "${kept.held + 1}"
    packet = Packet(tag = 250, delta = -32768, count = 4294967295, seq = 7)
    shown4 (packet.tag + 10, packet.delta - 1, packet.count + 1, packet.seq * 2)
    print "${identity u8High + 1} ${identity i8Low - 1}\n${twice ((\x => x + 200), u8Zero)}"
    scores = Map () |> mapSet "low" u8Zero |> mapSet "high" u8High
    high = unboxed (scores["high"], u8Zero, \value => value + 1)
    print "${high}"
    chosen : uint8
    chosen = match length small > 1
        true => 7
        false => u8High
    joined = match length small
        3 => u8High
        _ => 5
    print "${chosen} ${joined + 1}"
    parsed : Result<uint8, string>
    parsed = Success(value = 200)
    unpacked = unboxed (parsed, u8Zero, \value => value + 100)
    print "${unpacked}"
    erased : any
    erased = u8High
    print "${erased}\n${1 + 2} ${identity 9 + 1}"

wrapping arithmetic
wrapping totalHelpers
comparisons ()
wrapping conversions
wrapping journeys

(** Report one intercepted `Arith` failure, then answer with `fallback`. *)
intercepted (label, detail, fallback) =
    print "${label} ${detail}"
    fallback

strict work =
    handle Arith
        overflow op lhs rhs wrapped => intercepted ("overflow", "${op} ${lhs} ${rhs} ${wrapped}", 99)
        divideByZero op lhs => intercepted ("zero", "${op} ${lhs}", 0.0)
        remainderByZero lhs => intercepted ("remainder", "${lhs}", 77)
    work ()

counting () =
    seen : uint8
    mut seen = 250
    handle Arith
        overflow _ _ _ wrapped =>
            seen := seen + 10
            wrapped
    moved = u8High + 2
    print "${moved} ${seen}"

wrapping counting

(** Print what `strict` answers for one intercepted computation. *)
strictShown work = print "${strict work}"

strictShown (\() => u8High + 1)
strictShown (\() => i8Low - 1)
strictShown (\() => -u8High)
strictShown (\() => abs i8Low)
strictShown (\() => intDiv i16Low (-1))
strictShown (\() => u8High % u8Zero)
strictShown (\() => toUint8 i8Low)
strictShown (\() => toUint32 i32Low)
strictShown (\() => toInt8 u8High)
strictShown (\() => u32High * 2)
