(** A generic top-level function passed by name, not called, instantiates at the use's types. `joined` used as
    `foldList`'s step once instantiated at its int-defaulted signature, so float chunks came back as int words read
    as float bits (1.5 printed as 4.94e-324) under GC and ARC. Strings, records and a lambda wrapper were unaffected.
    Implements [TYPE-GENERICS-FN] and [BUILTIN-LIST-FOLD]. *)
joined (left, right) = foldList (right, left, \(all, value) => listAppend all value)

flattened parts = foldList (parts, [], joined)

wrapped parts = foldList (parts, [], \(all, part) => joined (all, part))

floats = flattened [[1.5, 2.0], [], [3.0, -0.25]]
words = flattened [["a", "bc"], ["d"]]
counts = flattened [[1, 2], [3]]
levels = flattened [[{ level = 0.5 }], [{ level = 2.25 }]]
twice = mapList ([0.75, 48000.0], \x => x)
picked = foldList ([0.5, 1.25], 0.0, \(sum, x) => sum + x)

print "floats ${join (mapList (floats, toString), ",")} wrapped ${join (mapList (wrapped [[1.5], [2.0]], toString), ",")} words ${join (words, ",")} counts ${join (mapList (counts, toString), ",")} levels ${toString (foldList (levels, 0.0, \(sum, r) => sum + r.level))} twice ${join (mapList (twice, toString), ",")} picked ${toString picked}"
