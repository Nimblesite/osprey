/// A channel stored in a generic record field retains its nested element type.
/// This previously misread the received row and printed 0 instead of 3.
/// [CONCURRENCY-CHANNEL]
type Box<t> = Box { slot: t }

/// Sends one row through the channel in a generic record field and reads it back.
fn boxedRoundTrip() = {
    use slot <- andThen(Channel(2))
    let boxed = Box { slot: slot }
    send(boxed.slot, [[1, 2, 3]])
    let m = recv(boxed.slot)
    print(toString(listLength(listGet(m, 0) ?: [99])))
    Success { value: m }
}

/// Verifies both list levels survive the generic field and channel transfer.
fn channelElementCase() = {
    use m <- andThen(boxedRoundTrip())
    let row = listGet(m, 0) ?: [99]
    Success { value: checkAll("channel element metadata survives a generic record field", [
        structuralEquals([listLength(m), listLength(row), (listGet(row, 0) ?: 99)], [1, 3, 1]),
        structuralEquals([(listGet(row, 1) ?: 99), (listGet(row, 2) ?: 99)], [2, 3])
    ]) }
}
test("generic record fields preserve nested channel elements", settled(channelElementCase))
