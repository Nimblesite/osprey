/// Mutually recursive generic functions with declared signatures generalize
/// together, so one program can use the group at two types (#278).
/// Implements [TYPE-GENERICS-FN], [TYPE-UNION-REC], [BUILTIN-LIST-CONCAT].
type Tree<T> =
    Leaf { item: T }
    | Node { kids: List<Tree<T>> }

fn kid<T>(out, kids, index) -> List<T> =
    listConcat(out, all(listGet(kids, index) ?: Node { kids: [] }))

fn all<T>(tree: Tree<T>) -> List<T> = match tree {
    Leaf { item } => [item]
    Node { kids } => range(0, length(kids)) |> fold([], fn(out, index) => kid(out, kids, index))
}

let ints = all(Node { kids: [Leaf { item: 1 }, Leaf { item: 2 }] })
let texts = all(Leaf { item: "x" })
print("${toString(listLength(ints))} ${join(texts, ",")}")

fn mutualGenericCase() = {
    let ints = all(Node { kids: [Leaf { item: 1 }, Leaf { item: 2 }] })
    let texts = all(Leaf { item: "x" })
    checkAll("mutually recursive generics instantiate at each type", [
        listLength(ints) == 2,
        (listGet(ints, 0) ?: 0) == 1,
        (listGet(ints, 1) ?: 0) == 2,
        listLength(texts) == 1,
        (listGet(texts, 0) ?: "") == "x"
    ])
}

test("mutually recursive generic functions work at two types", fn() => mutualGenericCase())
