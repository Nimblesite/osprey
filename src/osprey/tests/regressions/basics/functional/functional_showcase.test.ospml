// ML-flavor twin of functional_showcase.osp. Layout blocks, whitespace
// application (`range 1 6`), and `\x => …` lambdas lower to the SAME canonical
// AST as the Default braces/parens/`fn(x) =>` form — byte-identical IR
// ([FLAVOR-IR-EQUIV]). The `sq`/`add` signatures mirror the Default `-> int`
// returns; the unannotated helpers stay unannotated in both flavors.

dbl x = x * 2 

sq : int -> int
sq x = x * x 

inc x = x + 1 
gt4 x = x > 4
lt3 x = x < 3
even x = (x % 2 ) == 0

add : (int, int) -> int
add (a, b) = a + b 

mul (a, b) = a * b 

(** Prints `label = value` for `work`, valued under exact arithmetic. *)
printExact (label, work) = print "${label} = ${toString (exactArithmetic work)}"

(** The chained scalar pipe `3 |> inc |> dbl |> sq`. *)
chainedPipe () = 3 |> inc |> dbl |> sq

(** The inline-lambda pipe `10 |> (x + 5)`. *)
inlineAddPipe () = 10 |> \x => x + 5

(** The twice-chained lambda pipe `5 |> (+100)` then `x * 2`. *)
twiceChainedPipe () = 5 |> (\x => x + 100 ) |> (\x => x * 2 )

(** A fold from `seed` by `step` over 1..`hi`. *)
foldOver (seed, step, hi) = range 1 hi |> fold seed step

print "=== Functional Showcase ==="

// 1. forEach over a range
print "range 1..6 forEach print:"
range 1 6 |> forEach print

// 2. negative + empty ranges
print "range -2..3 forEach print:"
range ((0 - 2) ) 3 |> forEach print
print "range 5..5 (empty):"
range 5 5 |> forEach print

// 3. map + forEach
print "map dbl over 1..5:"
exactArithmetic (\() =>
    range 1 5 |> map dbl |> forEach print)

// 4. filter + forEach
print "filter even over 1..7:"
range 1 7 |> filter even |> forEach print

// 5. map-then-filter — filter sees mapped value
print "map dbl |> filter gt4 over 1..5:"
exactArithmetic (\() =>
    range 1 5 |> map dbl |> filter gt4 |> forEach print)

// 6. filter-then-map — map applied after filtering raw values
print "filter lt3 |> map dbl over 1..6:"
exactArithmetic (\() =>
    range 1 6 |> filter lt3 |> map dbl |> forEach print)

(** 7. fold (sum, product) *)
printExact ("sum 1..5", \() => foldOver (0, add, 6))
printExact ("prod 1..4", \() => foldOver (1, mul, 5))

(** 8. chained pipes on a single value *)
printExact ("3|>inc|>dbl|>sq", chainedPipe)

(** 9. inline lambda in pipeline *)
printExact ("10|>(x+5)", inlineAddPipe)

(** 10. lambda chained twice (parens around each so the chain doesn't get swallowed) *)
printExact ("5|>+100|>*2", twiceChainedPipe)

print "=== Showcase Complete ==="
// Exercises [BUILTIN-ITER], [BUILTIN-ITER-RANGE], [BUILTIN-ITER-MAP],
// [BUILTIN-ITER-FILTER], [BUILTIN-ITER-FOREACH], [BUILTIN-ITER-FOLD],
// [BUILTIN-ITER-CALLBACK], [BUILTIN-ITER-PIPE], and [BUILTIN-ITER-FUSION].

(** Verify direct helpers and every scalar pipe from the showcase. *)
scalarPipelineCase () =
    checkAll "functional scalar pipelines" [
        structuralEquals [dbl 7, sq 5, inc 9, add (7, 8), mul (6, 7), chainedPipe ()] [14, 25, 10, 15, 42, 64],
        structuralEquals [inlineAddPipe (), twiceChainedPipe ()] [15, 210],
        gt4 5, !gt4 4, lt3 2, !lt3 3,
        even 2, !even 3
    ]

(** Verify range boundaries and both map/filter orderings through folds. *)
iteratorPipelineCase () =
    source = range 1 5
    doubled = source |> map dbl
    small = source |> filter lt3
    kept = doubled |> filter gt4 |> toList
    names = range 0 3 |> map (\i => "n${i}") |> toList
    halves = range 1 3 |> map (\i => toFloat i * 0.5) |> toList
    checkAll "functional iterator pipelines" [
        structuralEquals [(range 1 6 |> fold 0 add), (range 1 5 |> fold 1 mul), (range 5 5 |> fold 9 add)] [15, 24, 9],
        (range ((0 - 2) ) 3 |> fold 0 add) == 0,
        (range 1 5 |> map dbl |> filter gt4 |> fold 0 add) == 14,
        structuralEquals [(range 1 6 |> filter lt3 |> map dbl |> fold 0 add), (small |> fold 0 add)] [6, 3],
        structuralEquals [(doubled |> fold 0 add), (doubled |> filter gt4 |> fold 0 add)] [20, 14],
        structuralEquals [(doubled |> fold 0 add), (source |> fold 0 add), listLength kept] [20, 10, 2],
        structuralEquals [(listGet kept 0 ?: 0), (listGet kept 1 ?: 0), listLength (range 3 3 |> toList)] [6, 8, 0],
        structuralEquals [listLength (source |> toList), listLength names] [4, 3],
        (listGet names 2 ?: "none") == "n2",
        (listGet halves 1 ?: 9.5) == 1.0
    ]

(** A `mut` a handler arm captures is promoted to a shared cell in EVERY
    lowered body, not only a top-level function's: inside a closure the arm
    wrote a private copy and the read after the `handle` returned 0. The list
    literal handed to that closure must also escape to a runtime list, or the
    body reads a foreign header and walks off the end.
    Implements [EFFECTS-HANDLER-STATE], [BUILTIN-LIST-FOREACH]. *)
effect Tally
    (** Fold one digit into the running number. *)
    note : int => Unit

(** A let-bound lambda leaves its arithmetic overload OPEN until the program
    says which one it is: `join = \(a, b) => a + b` used only on strings is
    concatenation, not the checked integer addition an eager default picked —
    which printed `Success(<pointer>)`. One definition still gets ONE overload,
    so `sum` beside it stays integer. Implements [ARITH-CHECKED]. *)
lambdaOverloadCase () =
    join = \(a, b) => a + b
    curriedJoin = \a => \b => a + b
    sum = \(a, b) => a + b 
    checkAll "a let-bound lambda picks its overload from its use" [
        structuralEquals [join ("os", "prey"), join ("", "x")] ["osprey", "x"],
        structuralEquals [curriedJoin "os" "prey", curriedJoin "a" ""] ["osprey", "a"],
        structuralEquals [sum (20, 22), length (join ("ab", "cde"))] [42, 5]
    ]

(** A handler region inside a closure, driven by a list literal the closure
    receives as an argument. *)
closureHandlerCase () =
    digits = \keys =>
        mut seen = 0
        handle Tally
            note value =>
                seen := seen * 10 + value 
        forEachList keys (\k => perform Tally.note k)
        seen
    checkAll "a handler inside a closure keeps its captured state" [
        structuralEquals [digits [1, 2, 3], digits [7], digits [9, 0]] [123, 7, 90]
    ]

(** A function VALUE that returns a tagged collection. A named function recovers
    its return owner from the declaration; a call through a closure cell has only
    the lowered signature to go on, and that signature carried no owner slot — so
    `listGet` on the result met an `i64` payload against a `double`/`i8*` default
    and the program was REJECTED with `match arms disagree on type`, naming no
    user construct. The same loss reached a captured value, a lambda passed as a
    function-value parameter, and a generic HOF. Implements [BUILTIN-LIST-GET],
    [BUILTIN-MAP-GET], [TYPE-GENERICS-FN]. *)
applyTo f x = f x

(** The element at `i` of `xs`, or a double sentinel when it is missing. *)
doubleAt (xs, i) = listGet xs i ?: 9.5

(** The element at `i` of `xs`, or a text sentinel when it is missing. *)
textAt (xs, i) = listGet xs i ?: "none"

(** Row `i` of the nested collection `rows`, or an int sentinel row. *)
rowAt (rows, i) = listGet rows i ?: [99]

(** Element `j` of row `i` of `rows`, or an int sentinel. *)
nestedAt (rows, i, j) = listGet (rowAt (rows, i)) j ?: 99

functionValueCollectionCase () =
    floatsFrom = \n => [n, n * 2.0]
    namesFrom = \s => [s, s + "!"]
    nestedFrom = \n => [[n, n + 1 ], [n + 2 ]]
    captured = [0.25, 0.5, 0.75]
    takeCaptured = \i => listGet captured i
    groupsFrom = \k => mapSet (Map ()) k [1.5, 2.5]
    checkAll "a function value returning a collection keeps its element type" [
        structuralEquals [doubleAt (floatsFrom 0.5, 0), doubleAt (floatsFrom 0.5, 1)] [0.5, 1.0],
        structuralEquals [(takeCaptured 0 ?: 9.5), (takeCaptured 2 ?: 9.5)] [0.25, 0.75],
        doubleAt (applyTo floatsFrom 1.25, 0) == 1.25,
        doubleAt (mapGet (groupsFrom "k") "k" ?: [9.0], 1) == 2.5,
        structuralEquals [listLength (floatsFrom 0.5), nestedAt (nestedFrom 1, 0, 1)] [2, 2],
        nestedAt (nestedFrom 1, 1, 0) == 3,
        structuralEquals [listLength (rowAt (nestedFrom 1, 0)), mapLength (groupsFrom "k")] [2, 1],
        structuralEquals [textAt (namesFrom "os", 0), textAt (namesFrom "os", 1)] ["os", "os!"],
        textAt (applyTo namesFrom "hi", 1) == "hi!"
    ]

(** A GENERIC function whose body is a lambda. One closure cell has one ABI and
    the binding may be used at several, so `f = pick ()` was rejected outright:
    `a closure value with a still-generic type`. The lambda is now recorded for
    inline application, so each call site specialises it at that site's real
    types — the same beta-reduction that already made a directly bound
    `f = \x => x` work at two instantiations.

    The producing call's arguments are evaluated ONCE at the binding and carried
    as values, so a captured parameter is neither re-evaluated per instantiation
    nor read from whatever scope the body was inlined into. `countedSeed`
    performs an effect, so `runs` counts that evaluation for real.
    Implements [TYPE-GENERICS-FN]. *)
pick () = \x => x
constly v = \_x => v

(** Bound at FILE SCOPE and read from inside a function below. That crosses
    function boundaries, so the lambda must be seeded before any body is
    emitted — otherwise the reader emits `call @sharedIdentity` to a symbol no
    definition produces and the module fails to LINK, which no type or codegen
    check would have caught. *)
sharedIdentity = pick ()
countedSeed () =
    perform Tally.note 1
    99

(** Binds the seeded lambda and applies it at TWO instantiations, so the
    evaluation count is observed across both. *)
agreesFromSeed () =
    counted = constly (countedSeed ())
    match counted 0 == counted "a different instantiation"
        true => 1
        false => 0

genericReturnedLambdaCase () =
    identityValue = pick ()
    alwaysText = constly "kept"
    alwaysNumber = constly (41 + 1 )
    mut runs = 0
    seedAgrees =
        handle Tally
            note value =>
                runs := runs + value 
        agreesFromSeed ()
    checkAll "a generic function's returned lambda specialises per call site" [
        structuralEquals [identityValue 7, alwaysNumber "z", alwaysNumber false] [7, 42, 42],
        structuralEquals [sharedIdentity 5, seedAgrees, runs] [5, 1, 1],
        structuralEquals [identityValue "os", alwaysText 0] ["os", "kept"],
        structuralEquals [alwaysText "any", alwaysText 1.5] ["kept", "kept"],
        sharedIdentity "across a function boundary" == "across a function boundary",
        structuralEquals [identityValue 2.5, sharedIdentity 1.25] [2.5, 1.25],
        identityValue true
    ]

(** A still-generic lambda has no closure cell, so it is applied inline at each
    call site. Its environment is nonetheless fixed where it was DEFINED. A
    shadowing binding, a nested closure, a handler arm, a second generic
    lambda, a function alias, a function value and an early ARC release must
    all see the captured value;
    each used to read the caller's scope instead — a wrong answer, freed memory
    or `unknown name`. A handler-owned cell stays one shared cell, and a lazy
    stage consumed by a later statement still reads what it closed over.
    Implements [TYPE-FN-CLOSURE], [TYPE-GENERICS-FN], [BUILTIN-ITER-CALLBACK]. *)
effect Probe
    ask : Unit => string

heapText n = "kept-${n}"
sameValue x = x
runThunk work = work ()
askProbe () = perform Probe.ask ()

genericLambdaEnvironmentCase () =
    kept = heapText 7
    tagged = \x => "${x}:${kept}"
    fromFactory = constly (heapText 8)
    later = heapText 9
    stageText = heapText 5
    staged = map (range (0, 2)) (\i => "${i}:${stageText}")
    afterStage = heapText 6
    viaLambda = \x => tagged x
    sameAgain = sameValue
    shout = \text => text + "!"
    viaAlias = \x => sameAgain x
    viaShout = \x => shout "${x}"
    rebound =
        sameAgain = \x => "shadow:${x}"
        shout = \text => text + "?"
        viaAlias 1 == 1 && viaShout 2 == "2!" && sameAgain 0 == "shadow:0" && shout "c" == "c?"
    shadowed =
        kept = "shadow"
        "${tagged 1}/${kept}"
    shadowedStage =
        kept = "shadow"
        fold (map (range (0, 2)) tagged) kept (\(acc, s) => acc + s)
    inArm =
        handle Probe
            ask => tagged "arm"
        askProbe ()
    mut total = 0
    report = \x => "${x}=${total}"
    handle Tally
        note value =>
            total := total + value
    perform Tally.note 5
    checkAll "a generic lambda keeps the environment it was defined in" [
        structuralEquals [fold staged "" (\(acc, s) => acc + s), afterStage] ["0:kept-51:kept-5", "kept-6"],
        structuralEquals [shadowedStage, tagged 1, tagged "s"] ["shadow0:kept-71:kept-7", "1:kept-7", "s:kept-7"],
        structuralEquals [fromFactory 1, fromFactory "s", later] ["kept-8", "kept-8", "kept-9"],
        structuralEquals [shadowed, runThunk (\() => tagged 2)] ["1:kept-7/shadow", "2:kept-7"],
        runThunk (\() => runThunk (\() => tagged "deep")) == "deep:kept-7",
        structuralEquals [runThunk (\() => fromFactory 3), runThunk (\() => viaLambda 4)] ["kept-8", "4:kept-7"],
        structuralEquals [viaAlias "a", viaShout 4, viaShout "b", inArm] ["a", "4!", "b!", "arm:kept-7"],
        structuralEquals [report "t", runThunk (\() => report true)] ["t=5", "true=5"],
        viaAlias 3 == 3,
        rebound
    ]

test "scalar pipes preserve helper composition" (exactly scalarPipelineCase)
test "iterator pipes preserve order and boundaries" (exactly iteratorPipelineCase)
test "a let-bound lambda picks its arithmetic overload from its use" (exactly lambdaOverloadCase)
test "a handler inside a closure keeps its captured state" (exactly closureHandlerCase)
test "a function value returning a collection keeps its element type" (exactly functionValueCollectionCase)
test "a generic function's returned lambda specialises per call site" (exactly genericReturnedLambdaCase)
test "a generic lambda keeps the environment it was defined in" (exactly genericLambdaEnvironmentCase)
