// Error-message catalogue: the ERROR path of every fallible builtin, with the
// real reason threaded through the `Error { message }` arm — never a
// placeholder. Each line prints "<name>: <message>". Also proves the other half
// of [ERR-PAYLOAD]: toString(Result) renders the real reason as Error(<reason>).
// Spec: [BUILTIN-STRING-CURSOR], [ERR-PAYLOAD], [TYPE-LIST], [TYPE-MAP].

/// A user-declared fallible function — its Error reason must render in toString.
fn boom() -> Result<int, string> = Error { message: "user boom" }

/// A Result payload is a runtime value of ANY length, so `toString` must size
/// its buffer from the string it is handed. The fixed 64-byte block it used to
/// format into was a heap buffer overflow, not a size heuristic: rendering any
/// longer Success payload or Error reason wrote past the allocation and
/// corrupted whatever followed it. [BUILTIN-TOSTRING]
fn longText() = "a Result payload far longer than the sixty-four byte block toString once formatted into, which made printing one a heap overflow"

fn longFailure() -> Result<int, string> = Error { message: longText() }

fn longSuccess() -> Result<string, string> = Success { value: longText() }

/// "unexpected " marks the half of a Result that should not have happened.
fn surprise(wrong) = if wrong { "unexpected " } else { "" }

/// Prints one labelled arm as "<name>: <detail>".
fn printArm(name, wrong, detail) = print("${name}: ${surprise(wrong)}${detail}\n")

/// Prints a Result under its label, marking "unexpected" on whichever half is wrong.
fn reportUnder(name, result, wrongOnSuccess) = match result {
    Success { value } => printArm(name, wrongOnSuccess, toString(value))
    Error { message } => printArm(name, !wrongOnSuccess, message)
}

/// Prints a fallible call under its label: the reason on Error, "unexpected" on Success.
fn report(name, result) = reportUnder(name, result, true)

/// Prints a call expected to succeed: the value on Success, "unexpected" on Error.
/// Prints an expected-success Result under its label, marking "unexpected" on Error.
fn reportOk(name, result) = reportUnder(name, result, false)

/// Like `report`, for a payload whose type has no toString.
fn reportPlain(name, result) = match result {
    Success => print("${name}: unexpected\n")
    Error { message } => print("${name}: ${message}\n")
}

/// Prints one toString(Result) rendering under its aligned label.
fn showToString(label, result) = print("${label}${toString(result)}\n")

// The failing calls below are bound once, so the catalogue and the checks that
// re-verify them share a single definition of each fault.

/// Parsing rejects a non-numeric string.
let parseIntErr = parseInt("nope")
let parseFloatErr = parseFloat("x")

/// String operations reject an empty separator, needle or fill, a negative
/// index or count, and an out-of-range substring.
let splitErr = split("a", "")
let indexOfErr = indexOf("abc", "z")
let substringErr = substring("hi", (0 - 1), 5)
let replaceErr = replace("h", "", "")
let repeatErr = repeat("a", (0 - 1))
let padStartErr = padStart("x", 5, "")
let padEndErr = padEnd("x", 5, "")

/// Cursor primitives reject an out-of-range byte, a mid-codepoint offset, a
/// surrogate, and a value past the last scalar.
let byteAtErr = byteAt("a", 9)
let codePointAtOobErr = codePointAt("a", 9)
let codePointAtMidErr = codePointAt("é", 1)
let surrogateErr = codePointWidth(55296)
let tooBigErr = codePointWidth(1114112)
let fromCodePointErr = fromCodePoint(1114112)

/// A user-declared failure keeps its reason for both rendering and checking.
let userBoom = boom()

/// Valid counterparts: a whole character reads back, division and parsing
/// succeed, and a scalar builds its string.
let wholeCodePoint = codePointAt(take("é", 1), 0)
let divideOk = divideResult(7, 2)
let parsedOk = parseInt("42")
let codePointA = fromCodePoint(65)

/// Collections reject a bad index and a missing key.
let xs = [1, 2, 3]
let prices = { "apple": 2, "banana": 3 }
let listIndexErr = xs[9]
let mapKeyErr = prices["mango"]

  // ---- numeric parsing ----
  report("parseInt", parseIntErr)
  report("parseFloat", parseFloatErr)

  // ---- string operations ----
  reportPlain("split", splitErr)
  report("indexOf", indexOfErr)
  report("substring", substringErr)
  report("replace", replaceErr)
  report("repeat", repeatErr)
  report("padStart", padStartErr)
  report("padEnd", padEndErr)

  // ---- O(1) cursor primitives ([BUILTIN-STRING-CURSOR]) ----
  report("byteAt", byteAtErr)
  report("codePointAt-oob", codePointAtOobErr)
  // "é" is U+00E9 (bytes 0xC3 0xA9): byte index 1 lands mid-codepoint.
  report("codePointAt-mid", codePointAtMidErr)
  // 0xD800 = 55296 (a UTF-16 surrogate — not a valid scalar value).
  report("codePointWidth-surrogate", surrogateErr)
  // 0x110000 = 1114112 (one past the last Unicode scalar value).
  report("codePointWidth-toobig", tooBigErr)
  report("fromCodePoint", fromCodePointErr)
  // `take` keeps a character whole, so no Osprey string operation can produce the
  // truncated or broken sequences the runtime's C tests feed `codePointAt`.
  reportOk("codePointAt-whole", wholeCodePoint)

  // ---- division: error AND success on the same construct ----
  exactArithmetic(fn() => report("divide", divideResult(10, 0)))
  reportOk("divide-ok", divideOk)

  /// ---- out-of-bounds list index ----
  report("listIndex", listIndexErr)

  /// ---- missing map key ----
  report("mapKey", mapKeyErr)

  // ---- toString(Result) renders the real reason (the other half of
  //      [ERR-PAYLOAD]): Error(<reason>) for failures, Success(<value>) else ----
  showToString("toString cursor err = ", surrogateErr)  // surrogate
  showToString("toString builtin err = ", parseIntErr)
  showToString("toString user err   = ", userBoom)
  showToString("toString ok int     = ", parsedOk)
  showToString("toString ok float   = ", divideOk)
  showToString("toString ok string  = ", codePointA)

  print("=== Error Catalogue Complete ===\n")

/// Every failing Result must carry a usable diagnostic payload.
fn hasDiagnostic(result) = match result {
    Success => false
    Error { message } => length(toString(message)) > 0
}

/// Checks that two fallible calls both fail with a diagnostic payload.
fn bothDiagnosed(a, b) = structuralEquals([hasDiagnostic(a), hasDiagnostic(b)], [true, true])

/// Verifies parsing, arithmetic, and user-created Result failures.
fn numericErrorCase() = {
    let userFailure = match userBoom {
        Success => false
        Error { message } => message == "user boom"
    }
    checkAll("numeric Result diagnostics", [
        bothDiagnosed(parseIntErr, parseFloatErr),
        hasDiagnostic(divideResult(10, 0)),
        userFailure
    ])
}

/// Verifies every fallible string operation used by the catalogue.
fn stringErrorCase() = checkAll("string Result diagnostics", [
    bothDiagnosed(splitErr, indexOfErr),
    bothDiagnosed(substringErr, replaceErr),
    bothDiagnosed(repeatErr, padStartErr),
    hasDiagnostic(padEndErr)
])

/// Verifies cursor bounds, invalid scalars, and malformed UTF-8 diagnostics.
fn cursorErrorCase() = checkAll("cursor Result diagnostics", [
    bothDiagnosed(byteAtErr, codePointAtOobErr),
    bothDiagnosed(codePointAtMidErr, surrogateErr),
    bothDiagnosed(tooBigErr, fromCodePointErr),
    !hasDiagnostic(wholeCodePoint)
])

/// Verifies collection errors alongside the successful counterparts.
fn collectionAndSuccessCase() = {
    let divisionWorks = match divideOk {
        Success { value } => value == 3.5
        Error => false
    }
    checkAll("collection errors and successful Results", [
        hasDiagnostic(listIndexErr),
        hasDiagnostic(mapKeyErr),
        (parsedOk ?: 0) == 42,
        structuralEquals([(codePointA ?: ""), toString(userBoom)], ["A", "Error(user boom)"]),
        divisionWorks
    ])
}

/// `Success(` + payload + `)` is nine characters more than the payload — the
/// exact count the fixed-size buffer got wrong.
fn oversizedPayloadCase() = {
    let text = longText()
    checkAll("toString sizes its buffer for the payload", [
        toString(longFailure()) == "Error(${text})",
        toString(longSuccess()) == "Success(${text})",
        length(toString(longSuccess())) == ((length(text) + 9))
    ])
}

exactTests([
    { name: "numeric failures retain their reasons", work: numericErrorCase },
    { name: "string failures retain their reasons", work: stringErrorCase },
    { name: "cursor failures retain their reasons", work: cursorErrorCase },
    { name: "collections fail safely and valid Results succeed", work: collectionAndSuccessCase },
    { name: "toString sizes its buffer for the payload", work: oversizedPayloadCase }
])
