(** Exact-value tests record any arithmetic fault as a failed assertion. *)

// 🎮 Epic Text Adventure Game Engine (Fixed)
// Showcasing Osprey's pattern matching, safe arithmetic, and storytelling capabilities

print "🏰 Welcome to the Mystical Castle Adventure! 🏰\nYou stand before an ancient castle shrouded in mystery...\n"

(** Game state and inventory system *)
playerHealth = 100
hasKey = 0  // 0 = false, 1 = true
hasSword = 0
goldCoins = 50
monstersDefeated = 0

(** Character stats and progression *)
calculatePlayerLevel defeats =
    match defeats
        0 => 1
        1 => 2
        2 => 3
        3 => 4
        _ => 5

getPlayerTitle level =
    match level
        1 => "Novice Adventurer"
        2 => "Brave Explorer"
        3 => "Seasoned Warrior"
        4 => "Legendary Hero"
        _ => "Master of the Realm"

(** Combat system with separate functions (avoiding nested matches) *)
calculateWeaponDamage enemyType =
    match enemyType
        1 => 25  // Goblin with sword
        2 => 40  // Orc with sword
        3 => 60  // Dragon with sword
        _ => 15  // Unknown enemy with sword

calculateBarehandDamage enemyType =
    match enemyType
        1 => 10  // Goblin barehanded
        2 => 15  // Orc barehanded
        3 => 20  // Dragon barehanded (barely a scratch!)
        _ => 5   // Unknown enemy barehanded

getEnemyName enemyType =
    match enemyType
        1 => "Sneaky Goblin"
        2 => "Fierce Orc"
        3 => "Ancient Dragon"
        _ => "Mysterious Shadow"

getEnemyHealth enemyType =
    match enemyType
        1 => 30  // Goblin
        2 => 60  // Orc
        3 => 120 // Dragon
        _ => 25  // Unknown

(** Room exploration system *)
exploreRoom roomNumber =
    match roomNumber
        1 => "the Grand Entrance Hall with marble columns"
        2 => "a dusty Library filled with ancient tomes"
        3 => "the Armory containing gleaming weapons"
        4 => "the Treasure Chamber sparkling with gold"
        5 => "the Throne Room where shadows dance"
        _ => "a mysterious room filled with swirling mist"

getRoomTreasure roomNumber =
    match roomNumber
        1 => 10  // Small coin purse
        2 => 25  // Valuable book
        3 => 0   // Weapon instead of gold
        4 => 100 // Treasure chest
        5 => 50  // Royal coins
        _ => 5   // Mysterious trinket

hasRoomWeapon roomNumber =
    match roomNumber
        3 => 1  // Armory has sword
        _ => 0  // No weapon in other rooms

hasRoomKey roomNumber =
    match roomNumber
        2 => 1  // Library has key
        _ => 0  // No key in other rooms

// Game progression and storytelling
print "⚔️  Your Quest Begins! ⚔️\n"

currentLevel = calculatePlayerLevel monstersDefeated
playerTitle = getPlayerTitle currentLevel
print "You are ${playerTitle} (Level ${currentLevel})\nHealth: ${playerHealth} ❤️  | Gold: ${goldCoins} 💰\n"

// Explore multiple rooms
print "🚪 Room 1: You enter ${exploreRoom 1}"
room1Gold = getRoomTreasure 1
newGold1 =
    exactArithmetic (\() =>
        goldCoins + room1Gold)
print "You find ${room1Gold} gold coins! Total: ${newGold1} 💰\n"

print "📚 Room 2: You discover ${exploreRoom 2}"
room2Gold = getRoomTreasure 2
newGold2 =
    exactArithmetic (\() =>
        newGold1 + room2Gold)
foundKey = hasRoomKey 2
print "You find ${room2Gold} gold coins and acquire a mysterious key! 🗝️\nTotal gold: ${newGold2} 💰\n"

print "⚔️  Room 3: You enter ${exploreRoom 3}"
foundSword = hasRoomWeapon 3
print "You acquire a gleaming sword! ⚔️\nYour combat prowess has increased dramatically!\n"

// Epic battle sequence
print "🐉 BOSS BATTLE: Ancient Dragon Appears! 🐉\nThe ground trembles as a massive dragon blocks your path!\n"

enemyType = 3  // Dragon
enemyName = getEnemyName enemyType
enemyHealth = getEnemyHealth enemyType

(** Calculate damage based on weapon status (avoiding nested match) *)
weaponDamage = calculateWeaponDamage enemyType
barehandDamage = calculateBarehandDamage enemyType
playerDamage =
    match foundSword
        1 => weaponDamage
        _ => barehandDamage

print "Enemy: ${enemyName}\nEnemy Health: ${enemyHealth} ❤️\nYour attack power: ${playerDamage} ⚔️\n"

(** Battle calculation *)
totalDamageNeeded = enemyHealth
attacksNeeded = exactArithmetic (\() =>
    totalDamageNeeded / playerDamage)

print "⚡ BATTLE COMMENCES! ⚡\nYou need ${attacksNeeded} successful attacks to defeat the ${enemyName}!\n"

// Simulate battle rounds
print "🥊 Round 1: You strike for ${playerDamage} damage!"
remainingHealth1 =
    exactArithmetic (\() =>
        enemyHealth - playerDamage)
print "Dragon health remaining: ${remainingHealth1}\n"

print "🥊 Round 2: Another powerful blow for ${playerDamage} damage!"
remainingHealth2 =
    exactArithmetic (\() =>
        remainingHealth1 - playerDamage)
print "Dragon health remaining: ${remainingHealth2}\n"

print "🥊 FINAL ROUND: You deliver the finishing blow!"
finalDamage = remainingHealth2
print "Critical hit for ${finalDamage} damage!\n"

(** Victory and level progression *)
newMonstersDefeated =
    exactArithmetic (\() =>
        monstersDefeated + 1)
newLevel = calculatePlayerLevel newMonstersDefeated
newTitle = getPlayerTitle newLevel
victoryGold = 200
finalGold =
    exactArithmetic (\() =>
        newGold2 + victoryGold)

print "🎉 VICTORY! 🎉\nThe ${enemyName} has been defeated!\nYou gain ${victoryGold} gold coins as reward!\nTotal gold: ${finalGold} 💰\n"

print "📈 LEVEL UP! 📈\nPrevious: ${playerTitle} (Level ${currentLevel})\nNew: ${newTitle} (Level ${newLevel})\n"

// Final treasure room
print "🏆 Room 4: You enter ${exploreRoom 4}"
treasureGold = getRoomTreasure 4
ultimateGold =
    exactArithmetic (\() =>
        finalGold + treasureGold)
print "You discover the legendary treasure chest!\nInside: ${treasureGold} gold coins! 💎\nYour final wealth: ${ultimateGold} 💰\n"

// Epic conclusion
print "🎭 QUEST COMPLETE! 🎭\nCongratulations, ${newTitle}!\nYou have conquered the Mystical Castle!\nFinal Stats:\n  - Level: ${newLevel}\n  - Monsters Defeated: ${newMonstersDefeated}\n  - Gold Collected: ${ultimateGold} 💰\n  - Artifacts: Sword ⚔️ & Key 🗝️\n\n🌟 Your legend will be remembered forever! 🌟\nThanks for playing the Osprey Adventure Game!"

(** Replay the quest calculations and check every helper's branch table. *)
adventureGameCase () =
    afterRoomOne = (50 + getRoomTreasure 1) 
    afterRoomTwo = (afterRoomOne + getRoomTreasure 2) 
    damage = calculateWeaponDamage 3
    healthAfterOne = getEnemyHealth 3 - damage
    healthAfterTwo = (healthAfterOne - damage) 
    defeated = (0 + 1) 
    rewardBalance = (afterRoomTwo + 200) 
    questBalance = (rewardBalance + getRoomTreasure 4) 

    checkAll "adventure branch tables" [
        answersHold (calculatePlayerLevel, [0, 1, 2, 3, 9], [1, 2, 3, 4, 5]),
        answersHold (getPlayerTitle, [1, 2, 3, 4, 5], ["Novice Adventurer", "Brave Explorer", "Seasoned Warrior", "Legendary Hero", "Master of the Realm"]),
        answersHold (calculateWeaponDamage, [1, 2, 3, 9], [25, 40, 60, 15]),
        answersHold (calculateBarehandDamage, [1, 2, 3, 9], [10, 15, 20, 5]),
        answersHold (getEnemyName, [1, 2, 3, 9], ["Sneaky Goblin", "Fierce Orc", "Ancient Dragon", "Mysterious Shadow"]),
        answersHold (getEnemyHealth, [1, 2, 3, 9], [30, 60, 120, 25])
    ]
    checkAll "adventure room and quest state" [
        answersHold (exploreRoom, [1, 2, 3, 4, 5, 9], ["the Grand Entrance Hall with marble columns", "a dusty Library filled with ancient tomes", "the Armory containing gleaming weapons", "the Treasure Chamber sparkling with gold", "the Throne Room where shadows dance", "a mysterious room filled with swirling mist"]),
        answersHold (getRoomTreasure, [1, 2, 3, 4, 5, 9], [10, 25, 0, 100, 50, 5]),
        hasRoomWeapon 3 == 1,
        hasRoomWeapon 2 == 0,
        hasRoomKey 2 == 1,
        hasRoomKey 3 == 0,
        afterRoomOne == 60,
        afterRoomTwo == 85,
        damage == 60,
        (getEnemyHealth 3 / damage ) == 2.0,
        healthAfterOne == 60,
        healthAfterTwo == 0,
        defeated == 1,
        calculatePlayerLevel defeated == 2,
        getPlayerTitle (calculatePlayerLevel defeated) == "Brave Explorer",
        rewardBalance == 285,
        questBalance == 385
    ]

test "adventure game preserves branch and progression state" (exactly adventureGameCase)
