// 🎮 Epic Text Adventure Game Engine (Fixed)
// Showcasing Osprey's pattern matching, safe arithmetic, and storytelling capabilities

print("🏰 Welcome to the Mystical Castle Adventure! 🏰")
print("You stand before an ancient castle shrouded in mystery...")
print("")

/// Game state and inventory system
let playerHealth = 100
let hasKey = 0  // 0 = false, 1 = true
let hasSword = 0
let goldCoins = 50
let monstersDefeated = 0

/// Character stats and progression
fn calculatePlayerLevel(defeats) = match defeats {
    0 => 1
    1 => 2
    2 => 3
    3 => 4
    _ => 5
}

fn getPlayerTitle(level) = match level {
    1 => "Novice Adventurer"
    2 => "Brave Explorer"
    3 => "Seasoned Warrior"
    4 => "Legendary Hero"
    _ => "Master of the Realm"
}

/// Combat system with separate functions (avoiding nested matches)
fn calculateWeaponDamage(enemyType) = match enemyType {
    1 => 25  // Goblin with sword
    2 => 40  // Orc with sword
    3 => 60  // Dragon with sword
    _ => 15  // Unknown enemy with sword
}

fn calculateBarehandDamage(enemyType) = match enemyType {
    1 => 10  // Goblin barehanded
    2 => 15  // Orc barehanded
    3 => 20  // Dragon barehanded (barely a scratch!)
    _ => 5   // Unknown enemy barehanded
}

fn getEnemyName(enemyType) = match enemyType {
    1 => "Sneaky Goblin"
    2 => "Fierce Orc"
    3 => "Ancient Dragon"
    _ => "Mysterious Shadow"
}

fn getEnemyHealth(enemyType) = match enemyType {
    1 => 30  // Goblin
    2 => 60  // Orc
    3 => 120 // Dragon
    _ => 25  // Unknown
}

/// Room exploration system
fn exploreRoom(roomNumber) = match roomNumber {
    1 => "the Grand Entrance Hall with marble columns"
    2 => "a dusty Library filled with ancient tomes"
    3 => "the Armory containing gleaming weapons"
    4 => "the Treasure Chamber sparkling with gold"
    5 => "the Throne Room where shadows dance"
    _ => "a mysterious room filled with swirling mist"
}

fn getRoomTreasure(roomNumber) = match roomNumber {
    1 => 10  // Small coin purse
    2 => 25  // Valuable book
    3 => 0   // Weapon instead of gold
    4 => 100 // Treasure chest
    5 => 50  // Royal coins
    _ => 5   // Mysterious trinket
}

fn hasRoomWeapon(roomNumber) = match roomNumber {
    3 => 1  // Armory has sword
    _ => 0  // No weapon in other rooms
}

fn hasRoomKey(roomNumber) = match roomNumber {
    2 => 1  // Library has key
    _ => 0  // No key in other rooms
}

/// Gold after banking a room's treasure or a reward `amount`.
fn goldAfter(balance, amount) = exactArithmetic(fn() => balance + amount)

/// A room's treasure and the gold total after banking it.
type RoomLoot = { treasure: int, gold: int }

/// Enters a room, printing its entry line, and returns its treasure with the new gold total.
fn enterRoom(roomNumber, arrival, balance) = {
    print("${arrival} ${exploreRoom(roomNumber)}")
    let treasure = getRoomTreasure(roomNumber)
    RoomLoot { treasure: treasure, gold: goldAfter(balance, treasure) }
}

/// Runs one battle round: prints the strike and the health left, returning that health.
fn battleRound(strike, health, damage) = {
    print(strike)
    let remaining = exactArithmetic(fn() => health - damage)
    print("Dragon health remaining: ${remaining}")
    print("")
    remaining
}

// Game progression and storytelling
print("⚔️  Your Quest Begins! ⚔️")
print("")

let currentLevel = calculatePlayerLevel(monstersDefeated)
let playerTitle = getPlayerTitle(currentLevel)
print("You are ${playerTitle} (Level ${currentLevel})")
print("Health: ${playerHealth} ❤️  | Gold: ${goldCoins} 💰")
print("")

// Explore multiple rooms
let room1 = enterRoom(1, "🚪 Room 1: You enter", goldCoins)
print("You find ${room1.treasure} gold coins! Total: ${room1.gold} 💰")
print("")

let room2 = enterRoom(2, "📚 Room 2: You discover", room1.gold)
let foundKey = hasRoomKey(2)
print("You find ${room2.treasure} gold coins and acquire a mysterious key! 🗝️")
print("Total gold: ${room2.gold} 💰")
print("")

print("⚔️  Room 3: You enter ${exploreRoom(3)}")
let foundSword = hasRoomWeapon(3)
print("You acquire a gleaming sword! ⚔️")
print("Your combat prowess has increased dramatically!")
print("")

// Epic battle sequence
print("🐉 BOSS BATTLE: Ancient Dragon Appears! 🐉")
print("The ground trembles as a massive dragon blocks your path!")
print("")

let enemyType = 3  // Dragon
let enemyName = getEnemyName(enemyType)
let enemyHealth = getEnemyHealth(enemyType)

/// Calculate damage based on weapon status (avoiding nested match)
let weaponDamage = calculateWeaponDamage(enemyType)
let barehandDamage = calculateBarehandDamage(enemyType)
let playerDamage = match foundSword {
    1 => weaponDamage
    _ => barehandDamage
}

print("Enemy: ${enemyName}")
print("Enemy Health: ${enemyHealth} ❤️")
print("Your attack power: ${playerDamage} ⚔️")
print("")

/// Battle calculation
let attacksNeeded = exactArithmetic(fn() => enemyHealth / playerDamage)

print("⚡ BATTLE COMMENCES! ⚡")
print("You need ${attacksNeeded} successful attacks to defeat the ${enemyName}!")
print("")

// Simulate battle rounds
let remainingHealth1 = battleRound(
    "🥊 Round 1: You strike for ${playerDamage} damage!", enemyHealth, playerDamage
)

let remainingHealth2 = battleRound(
    "🥊 Round 2: Another powerful blow for ${playerDamage} damage!", remainingHealth1, playerDamage
)

print("🥊 FINAL ROUND: You deliver the finishing blow!")
let finalDamage = remainingHealth2
print("Critical hit for ${finalDamage} damage!")
print("")

/// Victory and level progression
let newMonstersDefeated = exactArithmetic(fn() => monstersDefeated + 1)
let newLevel = calculatePlayerLevel(newMonstersDefeated)
let newTitle = getPlayerTitle(newLevel)
let victoryGold = 200
let finalGold = goldAfter(room2.gold, victoryGold)

print("🎉 VICTORY! 🎉")
print("The ${enemyName} has been defeated!")
print("You gain ${victoryGold} gold coins as reward!")
print("Total gold: ${finalGold} 💰")
print("")

print("📈 LEVEL UP! 📈")
print("Previous: ${playerTitle} (Level ${currentLevel})")
print("New: ${newTitle} (Level ${newLevel})")
print("")

// Final treasure room
let room4 = enterRoom(4, "🏆 Room 4: You enter", finalGold)
print("You discover the legendary treasure chest!")
print("Inside: ${room4.treasure} gold coins! 💎")
print("Your final wealth: ${room4.gold} 💰")
print("")

// Epic conclusion
print("🎭 QUEST COMPLETE! 🎭")
print("Congratulations, ${newTitle}!")
print("You have conquered the Mystical Castle!")
print("Final Stats:")
print("  - Level: ${newLevel}")
print("  - Monsters Defeated: ${newMonstersDefeated}")
print("  - Gold Collected: ${room4.gold} 💰")
print("  - Artifacts: Sword ⚔️ & Key 🗝️")
print("")
print("🌟 Your legend will be remembered forever! 🌟")
print("Thanks for playing the Osprey Adventure Game!")

/// Checks `probe` at every input in `inputs` against the expected row.
fn probeRows(probe, inputs, expected) = structuralEquals(mapList(inputs, probe), expected)

/// Replays the quest calculations and checks every helper's branch table.
fn adventureGameCase() = {
    let afterRoomOne = (50 + getRoomTreasure(1)) 
    let afterRoomTwo = (afterRoomOne + getRoomTreasure(2)) 
    let damage = calculateWeaponDamage(3)
    let healthAfterOne = getEnemyHealth(3) - damage
    let healthAfterTwo = (healthAfterOne - damage) 
    let defeated = (0 + 1) 
    let rewardBalance = (afterRoomTwo + 200) 
    let questBalance = (rewardBalance + getRoomTreasure(4)) 

    checkAll("adventure branch tables", [
        probeRows(calculatePlayerLevel, [0, 1, 2, 3, 9], [1, 2, 3, 4, 5]),
        probeRows(calculateWeaponDamage, [1, 2, 3, 9], [25, 40, 60, 15]),
        probeRows(calculateBarehandDamage, [1, 2, 3, 9], [10, 15, 20, 5]),
        probeRows(getEnemyHealth, [1, 2, 3, 9], [30, 60, 120, 25]),
        probeRows(getPlayerTitle, [1, 2, 3, 4, 5], [
            "Novice Adventurer", "Brave Explorer", "Seasoned Warrior",
            "Legendary Hero", "Master of the Realm"
        ]),
        probeRows(getEnemyName, [1, 2, 3, 9], ["Sneaky Goblin", "Fierce Orc", "Ancient Dragon", "Mysterious Shadow"])
    ])
    checkAll("adventure room and quest state", [
        probeRows(exploreRoom, [1, 2, 3, 4, 5, 9], [
            "the Grand Entrance Hall with marble columns",
            "a dusty Library filled with ancient tomes",
            "the Armory containing gleaming weapons",
            "the Treasure Chamber sparkling with gold",
            "the Throne Room where shadows dance",
            "a mysterious room filled with swirling mist"
        ]),
        probeRows(getRoomTreasure, [1, 2, 3, 4, 5, 9], [10, 25, 0, 100, 50, 5]),
        probeRows(hasRoomWeapon, [3, 2], [1, 0]),
        probeRows(hasRoomKey, [2, 3], [1, 0]),
        getPlayerTitle(calculatePlayerLevel(defeated)) == "Brave Explorer",
        structuralEquals([afterRoomOne, afterRoomTwo, damage, healthAfterOne, healthAfterTwo], [60, 85, 60, 60, 0]),
        structuralEquals([defeated, calculatePlayerLevel(defeated), rewardBalance, questBalance], [1, 2, 285, 385]),
        (getEnemyHealth(3) / damage ) == 2.0
    ])
}

test("adventure game preserves branch and progression state", exactly(adventureGameCase))
