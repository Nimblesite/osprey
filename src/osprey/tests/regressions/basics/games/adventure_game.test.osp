
// 🎮 Epic Text Adventure Game Engine (Fixed)
// Showcasing Osprey's pattern matching, safe arithmetic, and storytelling capabilities

print("🏰 Welcome to the Mystical Castle Adventure! 🏰\nYou stand before an ancient castle shrouded in mystery...\n")

/// Game state and inventory system
let playerHealth = 100
let hasKey = 0  // 0 = false, 1 = true
let hasSword = 0
let goldCoins = 50
let monstersDefeated = 0

/// Character stats and progression
fn calculatePlayerLevel(defeats) = match defeats {
    0 => 1
    1 => 2
    2 => 3
    3 => 4
    _ => 5
}

fn getPlayerTitle(level) = match level {
    1 => "Novice Adventurer"
    2 => "Brave Explorer"
    3 => "Seasoned Warrior"
    4 => "Legendary Hero"
    _ => "Master of the Realm"
}

/// Level and title earned for a count of defeated monsters.
fn rankFor(defeats) = {
    let level = calculatePlayerLevel(defeats)
    { level: level, title: getPlayerTitle(level) }
}

/// Combat system: one catalog row per enemy type, its name, health, and damage with and without a weapon.
fn enemy(id) = match id {
    1 => { name: "Sneaky Goblin", health: 30, swordDamage: 25, barehandDamage: 10 }
    2 => { name: "Fierce Orc", health: 60, swordDamage: 40, barehandDamage: 15 }
    3 => { name: "Ancient Dragon", health: 120, swordDamage: 60, barehandDamage: 20 }
    _ => { name: "Mysterious Shadow", health: 25, swordDamage: 15, barehandDamage: 5 }
}

fn calculateWeaponDamage(enemyType) = enemy(enemyType).swordDamage
fn calculateBarehandDamage(enemyType) = enemy(enemyType).barehandDamage
fn getEnemyName(enemyType) = enemy(enemyType).name
fn getEnemyHealth(enemyType) = enemy(enemyType).health

/// Room exploration system: one catalog row per room, its description and gold.
fn room(id) = match id {
    1 => { description: "the Grand Entrance Hall with marble columns", gold: 10 }
    2 => { description: "a dusty Library filled with ancient tomes", gold: 25 }
    3 => { description: "the Armory containing gleaming weapons", gold: 0 }
    4 => { description: "the Treasure Chamber sparkling with gold", gold: 100 }
    5 => { description: "the Throne Room where shadows dance", gold: 50 }
    _ => { description: "a mysterious room filled with swirling mist", gold: 5 }
}

fn exploreRoom(roomNumber) = room(roomNumber).description

/// Safe binary arithmetic: one exact-value wrapper per operator.
fn safeAdd(a, b) = exactArithmetic(fn() => a + b)
fn safeSub(a, b) = exactArithmetic(fn() => a - b)
fn safeDiv(a, b) = exactArithmetic(fn() => a / b)

/// Gold collected in one room: the find and the running total.
fn collectGold(balance, roomNumber) = {
    let found = getRoomTreasure(roomNumber)
    { found: found, total: safeAdd(balance, found) }
}

fn getRoomTreasure(roomNumber) = room(roomNumber).gold

fn hasRoomWeapon(roomNumber) = match roomNumber {
    3 => 1  // Armory has sword
    _ => 0  // No weapon in other rooms
}

fn hasRoomKey(roomNumber) = match roomNumber {
    2 => 1  // Library has key
    _ => 0  // No key in other rooms
}

// Game progression and storytelling
print("⚔️  Your Quest Begins! ⚔️\n")

let startRank = rankFor(monstersDefeated)
print("You are ${startRank.title} (Level ${startRank.level})\nHealth: ${playerHealth} ❤️  | Gold: ${goldCoins} 💰\n")

// Explore multiple rooms
print("🚪 Room 1: You enter ${exploreRoom(1)}")
let room1 = collectGold(goldCoins, 1)
print("You find ${room1.found} gold coins! Total: ${room1.total} 💰\n")

print("📚 Room 2: You discover ${exploreRoom(2)}")
let room2 = collectGold(room1.total, 2)
let foundKey = hasRoomKey(2)
print("You find ${room2.found} gold coins and acquire a mysterious key! 🗝️\nTotal gold: ${room2.total} 💰\n")

print("⚔️  Room 3: You enter ${exploreRoom(3)}")
let foundSword = hasRoomWeapon(3)
print("You acquire a gleaming sword! ⚔️\nYour combat prowess has increased dramatically!\n")

// Epic battle sequence
print("🐉 BOSS BATTLE: Ancient Dragon Appears! 🐉\nThe ground trembles as a massive dragon blocks your path!\n")

let enemyType = 3  // Dragon
let enemyName = getEnemyName(enemyType)
let enemyHealth = getEnemyHealth(enemyType)

/// Calculate damage based on weapon status (avoiding nested match)
let weaponDamage = calculateWeaponDamage(enemyType)
let barehandDamage = calculateBarehandDamage(enemyType)
let playerDamage = match foundSword {
    1 => weaponDamage
    _ => barehandDamage
}

print("Enemy: ${enemyName}\nEnemy Health: ${enemyHealth} ❤️\nYour attack power: ${playerDamage} ⚔️\n")

/// Battle calculation
let totalDamageNeeded = enemyHealth
let attacksNeeded = safeDiv(totalDamageNeeded, playerDamage)

print("⚡ BATTLE COMMENCES! ⚡\nYou need ${attacksNeeded} successful attacks to defeat the ${enemyName}!\n")

/// One battle round: the banner, the blow, and the dragon's health after it.
fn battleRound(banner, health) = {
    let remaining = safeSub(health, playerDamage)
    print("${banner} ${playerDamage} damage!\nDragon health remaining: ${remaining}\n")
    remaining
}

/// The dragon's remaining health after the first strike.
let remainingHealth1 = battleRound("🥊 Round 1: You strike for", enemyHealth)
let remainingHealth2 = battleRound("🥊 Round 2: Another powerful blow for", remainingHealth1)

print("🥊 FINAL ROUND: You deliver the finishing blow!")
let finalDamage = remainingHealth2
print("Critical hit for ${finalDamage} damage!\n")

/// Victory and level progression
let newMonstersDefeated = safeAdd(monstersDefeated, 1)
let newRank = rankFor(newMonstersDefeated)
let victoryGold = 200
let finalGold = safeAdd(room2.total, victoryGold)

print("🎉 VICTORY! 🎉\nThe ${enemyName} has been defeated!\nYou gain ${victoryGold} gold coins as reward!\nTotal gold: ${finalGold} 💰\n")

print("📈 LEVEL UP! 📈\nPrevious: ${startRank.title} (Level ${startRank.level})\nNew: ${newRank.title} (Level ${newRank.level})\n")

// Final treasure room
print("🏆 Room 4: You enter ${exploreRoom(4)}")
let treasure = collectGold(finalGold, 4)
print("You discover the legendary treasure chest!\nInside: ${treasure.found} gold coins! 💎\nYour final wealth: ${treasure.total} 💰\n")

// Epic conclusion
print("🎭 QUEST COMPLETE! 🎭\nCongratulations, ${newRank.title}!\nYou have conquered the Mystical Castle!\nFinal Stats:\n  - Level: ${newRank.level}\n  - Monsters Defeated: ${newMonstersDefeated}\n  - Gold Collected: ${treasure.total} 💰\n  - Artifacts: Sword ⚔️ & Key 🗝️\n\n🌟 Your legend will be remembered forever! 🌟\nThanks for playing the Osprey Adventure Game!")

/// Validates the quest state the narrative computed and every helper's branch table.
fn adventureGameCase() = {
    let enemyIds = [1, 2, 3, 9]
    let roomIds = [1, 2, 3, 4, 5, 9]

    checkAll("adventure branch tables", [
        answersHold(calculatePlayerLevel, [0, 1, 2, 3, 9], [1, 2, 3, 4, 5]),
        answersHold(getPlayerTitle, [1, 2, 3, 4, 5], ["Novice Adventurer", "Brave Explorer", "Seasoned Warrior", "Legendary Hero", "Master of the Realm"]),
        answersHold(calculateWeaponDamage, enemyIds, [25, 40, 60, 15]),
        answersHold(calculateBarehandDamage, enemyIds, [10, 15, 20, 5]),
        answersHold(getEnemyName, enemyIds, ["Sneaky Goblin", "Fierce Orc", "Ancient Dragon", "Mysterious Shadow"]),
        answersHold(getEnemyHealth, enemyIds, [30, 60, 120, 25])
    ])
    checkAll("adventure room and quest state", [
        answersHold(exploreRoom, roomIds, ["the Grand Entrance Hall with marble columns", "a dusty Library filled with ancient tomes", "the Armory containing gleaming weapons", "the Treasure Chamber sparkling with gold", "the Throne Room where shadows dance", "a mysterious room filled with swirling mist"]),
        answersHold(getRoomTreasure, roomIds, [10, 25, 0, 100, 50, 5]),
        hasRoomWeapon(3) == 1,
        hasRoomWeapon(2) == 0,
        hasRoomKey(2) == 1,
        hasRoomKey(3) == 0,
        room1.total == 60,
        room2.total == 85,
        weaponDamage == 60,
        attacksNeeded == 2.0,
        remainingHealth1 == 60,
        remainingHealth2 == 0,
        newMonstersDefeated == 1,
        calculatePlayerLevel(newMonstersDefeated) == 2,
        getPlayerTitle(calculatePlayerLevel(newMonstersDefeated)) == "Brave Explorer",
        finalGold == 285,
        treasure.total == 385
    ])
}

test("adventure game preserves branch and progression state", exactly(adventureGameCase))
