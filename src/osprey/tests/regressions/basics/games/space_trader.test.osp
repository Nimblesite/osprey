
// 🚀 Space Trading Simulation - Complex Game Example
// An epic CLI adventure showcasing Osprey's pattern matching and safe arithmetic

print("🌌 Welcome to the Galactic Trade Network! 🌌\nYou are Captain Alex, commander of the starship Osprey-7\nYour mission: Build a trading empire across the galaxy!\n")

/// Initial ship status and cargo
let shipFuel = 100
let credits = 1000
let cargoSpace = 50
let cargoUsed = 0
let reputation = 0
let planetsVisited = 0

/// Market prices and trading system
fn getResourcePrice(resourceType) = match resourceType {
    1 => 50   // Quantum Crystals
    2 => 25   // Space Metal
    3 => 75   // Exotic Spices
    4 => 100  // Rare Artifacts
    5 => 30   // Energy Cells
    _ => 10   // Common Minerals
}

fn getResourceName(resourceType) = match resourceType {
    1 => "Quantum Crystals"
    2 => "Space Metal"
    3 => "Exotic Spices"
    4 => "Rare Artifacts"
    5 => "Energy Cells"
    _ => "Common Minerals"
}

fn getPlanetName(planetId) = match planetId {
    1 => "Nebula Prime"
    2 => "Crystal Moon"
    3 => "Trade Station Alpha"
    4 => "Asteroid Mining Base"
    5 => "Galactic Hub"
    _ => "Unknown Sector"
}

fn getPlanetSpecialty(planetId) = match planetId {
    1 => 1  // Quantum Crystals
    2 => 2  // Space Metal
    3 => 3  // Exotic Spices
    4 => 4  // Rare Artifacts
    5 => 5  // Energy Cells
    _ => 6  // Common Minerals
}

fn calculateTravelCost(distance) = match distance {
    1 => 10  // Nearby
    2 => 20  // Medium range
    3 => 30  // Far
    4 => 40  // Very far
    _ => 50  // Deep space
}

fn getReputationTitle(rep) = match rep {
    0 => "Unknown Trader"
    1 => "Novice Merchant"
    2 => "Skilled Trader"
    3 => "Master Merchant"
    4 => "Trade Baron"
    _ => "Galactic Legend"
}

/// Ship and crew management
// Cargo valuation has an explicit ceiling at the maximum representable credit value.
fn calculateCargoValue(amount, price) = satMul(amount, price)

fn getShipStatus(fuel) = match fuel {
    100 => "Excellent"
    75 => "Good"
    50 => "Fair"
    25 => "Low"
    _ => "Critical"
}

// Mission briefing and setup
print("🛸 MISSION BRIEFING 🛸\nShip: Osprey-7 Starfreighter\nFuel: ${shipFuel}% ⛽\nCredits: ${credits} 💰\nCargo Space: ${cargoUsed}/${cargoSpace} 📦\nReputation: ${getReputationTitle(reputation)}\n")

// Trading simulation across multiple planets
print("🌍 GALACTIC TRADING SIMULATION 🌍\n")

/// Planet 1: Nebula Prime
let planet1 = 1
let planet1Name = getPlanetName(planet1)
let specialty1 = getPlanetSpecialty(planet1)
let resource1Name = getResourceName(specialty1)
let resource1Price = getResourcePrice(specialty1)

print("📍 Arriving at ${planet1Name}\nThis planet specializes in: ${resource1Name}\nMarket price: ${resource1Price} credits per unit")

let purchaseAmount1 = 10
let totalCost1 = exactArithmetic(fn() => calculateCargoValue(amount: purchaseAmount1, price: resource1Price))
let newCredits1 = exactArithmetic(fn() => credits - totalCost1)
let newCargoUsed1 = exactArithmetic(fn() => cargoUsed + purchaseAmount1)
let travelCost1 = calculateTravelCost(2)
let newFuel1 = exactArithmetic(fn() => shipFuel - travelCost1)

print("Purchasing ${purchaseAmount1} units of ${resource1Name}\nTotal cost: ${totalCost1} credits\nRemaining credits: ${newCredits1} 💰\nCargo: ${newCargoUsed1}/${cargoSpace} 📦\n")

/// Planet 2: Crystal Moon
let planet2 = 2
let planet2Name = getPlanetName(planet2)
print("🚀 Traveling to ${planet2Name}...\nFuel consumed: ${travelCost1}%\nCurrent fuel: ${newFuel1}% ⛽\n")

let specialty2 = getPlanetSpecialty(planet2)
let resource2Name = getResourceName(specialty2)
let resource2Price = getResourcePrice(specialty2)

print("📍 Arrived at ${planet2Name}\nLocal specialty: ${resource2Name}\nMarket price: ${resource2Price} credits per unit")

/// Sell previous cargo at premium
let sellPrice1 = exactArithmetic(fn() => resource1Price + 25  // 50% markup
)
let revenue1 = exactArithmetic(fn() => calculateCargoValue(amount: purchaseAmount1, price: sellPrice1))
let newCredits2 = exactArithmetic(fn() => newCredits1 + revenue1)
let newCargoUsed2 = exactArithmetic(fn() => newCargoUsed1 - purchaseAmount1)

print("Selling ${purchaseAmount1} units of ${resource1Name}\nSale price: ${sellPrice1} credits per unit\nRevenue: ${revenue1} credits 💰\nNew balance: ${newCredits2} credits\nCargo space freed: ${newCargoUsed2}/${cargoSpace} 📦\n")

/// Buy local specialty
let purchaseAmount2 = 15
let totalCost2 = exactArithmetic(fn() => calculateCargoValue(amount: purchaseAmount2, price: resource2Price))
let newCredits3 = exactArithmetic(fn() => newCredits2 - totalCost2)
let newCargoUsed3 = exactArithmetic(fn() => newCargoUsed2 + purchaseAmount2)

print("Purchasing ${purchaseAmount2} units of ${resource2Name}\nCost: ${totalCost2} credits\nRemaining credits: ${newCredits3} 💰\n")

/// Planet 3: Trade Station Alpha (Major Hub)
let planet3 = 3
let planet3Name = getPlanetName(planet3)
let travelCost2 = calculateTravelCost(3)
let newFuel2 = exactArithmetic(fn() => newFuel1 - travelCost2)

print("🚀 Long-range jump to ${planet3Name}\nFuel consumed: ${travelCost2}%\nCurrent fuel: ${newFuel2}% ⛽\n")

print("📍 Docking at ${planet3Name}\nThis is the galaxy's premier trading hub!")

/// Major trade at hub
let sellPrice2 = exactArithmetic(fn() => resource2Price + 30  // Premium for rare goods
)
let revenue2 = exactArithmetic(fn() => calculateCargoValue(amount: purchaseAmount2, price: sellPrice2))
let newCredits4 = exactArithmetic(fn() => newCredits3 + revenue2)
let newCargoUsed4 = exactArithmetic(fn() => newCargoUsed3 - purchaseAmount2)

print("Selling ${purchaseAmount2} units of ${resource2Name}\nHub premium price: ${sellPrice2} credits per unit\nMajor revenue: ${revenue2} credits! 💰\nNew balance: ${newCredits4} credits\n")

/// Calculate profit and reputation
let totalProfit = exactArithmetic(fn() => newCredits4 - credits)
let newReputation = exactArithmetic(fn() => reputation + 1)
let newPlanetsVisited = exactArithmetic(fn() => planetsVisited + 3)
let newReputationTitle = getReputationTitle(newReputation)

print("📈 TRADING RESULTS 📈\nStarting credits: ${credits}\nFinal credits: ${newCredits4}\nTotal profit: ${totalProfit} credits! 💰\nPlanets visited: ${newPlanetsVisited}\nNew reputation: ${newReputationTitle}\n")

/// Ship status report
let finalShipStatus = getShipStatus(newFuel2)
print("🛸 SHIP STATUS REPORT 🛸\nFuel level: ${newFuel2}% (${finalShipStatus})\nCargo bay: ${newCargoUsed4}/${cargoSpace} units\nShip condition: Operational\n")

/// Advanced calculations and projections
let fuelEfficiency = exactArithmetic(fn() => newFuel2 / newPlanetsVisited)
let profitPerPlanet = exactArithmetic(fn() => totalProfit / newPlanetsVisited)
let projectedWealth = exactArithmetic(fn() => newCredits4 * 2)

print("📊 ADVANCED ANALYTICS 📊\nFuel efficiency: ${fuelEfficiency}% per planet\nProfit per planet: ${profitPerPlanet} credits\nProjected wealth (if doubled): ${projectedWealth} credits\n")

// Mission completion and next steps
print("🏆 MISSION COMPLETE! 🏆\nCongratulations, Captain ${newReputationTitle}!\nYou have successfully established trade routes across the galaxy!\n\nNext objectives:\n  ⭐ Explore more distant sectors\n  ⭐ Upgrade ship cargo capacity\n  ⭐ Establish permanent trade agreements\n  ⭐ Recruit specialized crew members\n\n🌟 Your trading empire awaits! 🌟\nEnd of Galactic Trade Simulation\nThank you for playing Osprey Space Trader!")

/// Replays the trading ledger and validates every market and status branch.
fn spaceTraderCase() = {
    let costOne = calculateCargoValue(amount: 10, price: getResourcePrice(1))
    let creditsOne = (1000 - costOne) 
    let cargoOne = (0 + 10) 
    let fuelOne = (100 - calculateTravelCost(2)) 
    let sellPriceOne = getResourcePrice(1) + 25
    let revenueOne = calculateCargoValue(amount: 10, price: sellPriceOne)
    let creditsTwo = (creditsOne + revenueOne) 
    let cargoTwo = (cargoOne - 10) 
    let costTwo = calculateCargoValue(amount: 15, price: getResourcePrice(2))
    let creditsThree = (creditsTwo - costTwo) 
    let cargoThree = (cargoTwo + 15) 
    let fuelTwo = (fuelOne - calculateTravelCost(3)) 
    let sellPriceTwo = getResourcePrice(2) + 30
    let revenueTwo = calculateCargoValue(amount: 15, price: sellPriceTwo)
    let creditsFour = (creditsThree + revenueTwo) 
    let cargoFour = (cargoThree - 15) 
    let profit = (creditsFour - 1000) 
    let projected = (creditsFour * 2) 

    checkAll("space trader branch tables", [
        getResourcePrice(1) == 50,
        getResourcePrice(2) == 25,
        getResourcePrice(3) == 75,
        getResourcePrice(4) == 100,
        getResourcePrice(5) == 30,
        getResourcePrice(9) == 10,
        getResourceName(1) == "Quantum Crystals",
        getResourceName(2) == "Space Metal",
        getResourceName(3) == "Exotic Spices",
        getResourceName(4) == "Rare Artifacts",
        getResourceName(5) == "Energy Cells",
        getResourceName(9) == "Common Minerals",
        getPlanetName(1) == "Nebula Prime",
        getPlanetName(2) == "Crystal Moon",
        getPlanetName(3) == "Trade Station Alpha",
        getPlanetName(4) == "Asteroid Mining Base",
        getPlanetName(5) == "Galactic Hub",
        getPlanetName(9) == "Unknown Sector",
        getPlanetSpecialty(1) == 1,
        getPlanetSpecialty(2) == 2,
        getPlanetSpecialty(3) == 3,
        getPlanetSpecialty(4) == 4,
        getPlanetSpecialty(5) == 5,
        getPlanetSpecialty(9) == 6,
        calculateTravelCost(1) == 10,
        calculateTravelCost(2) == 20,
        calculateTravelCost(3) == 30,
        calculateTravelCost(4) == 40,
        calculateTravelCost(9) == 50
    ])
    checkAll("space trader ledger and ship state", [
        getReputationTitle(0) == "Unknown Trader",
        getReputationTitle(1) == "Novice Merchant",
        getReputationTitle(2) == "Skilled Trader",
        getReputationTitle(3) == "Master Merchant",
        getReputationTitle(4) == "Trade Baron",
        getReputationTitle(9) == "Galactic Legend",
        getShipStatus(100) == "Excellent",
        getShipStatus(75) == "Good",
        getShipStatus(50) == "Fair",
        getShipStatus(25) == "Low",
        getShipStatus(10) == "Critical",
        calculateCargoValue(amount: 10, price: 50) == 500,
        calculateCargoValue(amount: 9223372036854775807, price: 2) == 9223372036854775807,
        costOne == 500,
        creditsOne == 500,
        cargoOne == 10,
        fuelOne == 80,
        sellPriceOne == 75,
        revenueOne == 750,
        creditsTwo == 1250,
        cargoTwo == 0,
        costTwo == 375,
        creditsThree == 875,
        cargoThree == 15,
        fuelTwo == 50,
        sellPriceTwo == 55,
        revenueTwo == 825,
        creditsFour == 1700,
        cargoFour == 0,
        profit == 700,
        getShipStatus(fuelTwo) == "Fair",
        projected == 3400
    ])
}

test("space trading preserves market, ledger, and ship state", exactly(spaceTraderCase))
