// 🚀 Space Trading Simulation - Complex Game Example
// An epic CLI adventure showcasing Osprey's pattern matching and safe arithmetic

print("🌌 Welcome to the Galactic Trade Network! 🌌")
print("You are Captain Alex, commander of the starship Osprey-7")
print("Your mission: Build a trading empire across the galaxy!")
print("")

/// Initial ship status and cargo
let shipFuel = 100
let credits = 1000
let cargoSpace = 50
let cargoUsed = 0
let reputation = 0
let planetsVisited = 0

/// Market prices and trading system
fn getResourcePrice(resourceType) = match resourceType {
    1 => 50   // Quantum Crystals
    2 => 25   // Space Metal
    3 => 75   // Exotic Spices
    4 => 100  // Rare Artifacts
    5 => 30   // Energy Cells
    _ => 10   // Common Minerals
}

fn getResourceName(resourceType) = match resourceType {
    1 => "Quantum Crystals"
    2 => "Space Metal"
    3 => "Exotic Spices"
    4 => "Rare Artifacts"
    5 => "Energy Cells"
    _ => "Common Minerals"
}

fn getPlanetName(planetId) = match planetId {
    1 => "Nebula Prime"
    2 => "Crystal Moon"
    3 => "Trade Station Alpha"
    4 => "Asteroid Mining Base"
    5 => "Galactic Hub"
    _ => "Unknown Sector"
}

fn getPlanetSpecialty(planetId) = match planetId {
    1 => 1  // Quantum Crystals
    2 => 2  // Space Metal
    3 => 3  // Exotic Spices
    4 => 4  // Rare Artifacts
    5 => 5  // Energy Cells
    _ => 6  // Common Minerals
}

fn calculateTravelCost(distance) = match distance {
    1 => 10  // Nearby
    2 => 20  // Medium range
    3 => 30  // Far
    4 => 40  // Very far
    _ => 50  // Deep space
}

fn getReputationTitle(rep) = match rep {
    0 => "Unknown Trader"
    1 => "Novice Merchant"
    2 => "Skilled Trader"
    3 => "Master Merchant"
    4 => "Trade Baron"
    _ => "Galactic Legend"
}

/// Ship and crew management
// Cargo valuation has an explicit ceiling at the maximum representable credit value.
fn calculateCargoValue(amount, price) = satMul(amount, price)

/// Cargo value at unitPrice under the explicit arithmetic check every ledger step needs.
fn cargoValue(amount, unitPrice) = exactArithmetic(fn() => calculateCargoValue(amount: amount, price: unitPrice))

/// Ledger addition under the explicit arithmetic check.
fn plus(total, amount) = exactArithmetic(fn() => total + amount)

/// Ledger subtraction under the explicit arithmetic check.
fn minus(total, amount) = exactArithmetic(fn() => total - amount)

/// Market price raised by markup under the explicit arithmetic check.
fn premium(price, markup) = exactArithmetic(fn() => price + markup)

/// Total shared over count under the explicit arithmetic check.
fn average(total, count) = exactArithmetic(fn() => total / count)

fn getShipStatus(fuel) = match fuel {
    100 => "Excellent"
    75 => "Good"
    50 => "Fair"
    25 => "Low"
    _ => "Critical"
}

/// Print every row of a report, in order.
fn printRows(rows) = forEachList(rows, fn(row) => print(row))

/// Print an arrival row, a specialty row, and the market price.
fn reportMarket(arrivalLine, specialtyLine, price) =
    printRows([arrivalLine, specialtyLine, "Market price: ${price} credits per unit"])

/// Print a jump headline, its fuel cost, the fuel left, and a blank row.
fn reportJump(headline, fuelCost, fuelLeft) =
    printRows([headline, "Fuel consumed: ${fuelCost}%", "Current fuel: ${fuelLeft}% ⛽", ""])

/// Print a purchase receipt followed by any extra rows and a blank row.
fn reportPurchase(amount, resource, costLabel, cost, balance, extraRows) =
    printRows(["Purchasing ${amount} units of ${resource}", "${costLabel} ${cost} credits", "Remaining credits: ${balance} 💰"] + extraRows + [""])

/// Print a sale receipt followed by any extra rows and a blank row.
fn reportSale(amount, resource, priceLine, revenueLine, balance, extraRows) =
    printRows(["Selling ${amount} units of ${resource}", priceLine, revenueLine, "New balance: ${balance} credits"] + extraRows + [""])

// Mission briefing and setup
print("🛸 MISSION BRIEFING 🛸")
print("Ship: Osprey-7 Starfreighter")
print("Fuel: ${shipFuel}% ⛽")
print("Credits: ${credits} 💰")
print("Cargo Space: ${cargoUsed}/${cargoSpace} 📦")
print("Reputation: ${getReputationTitle(reputation)}")
print("")

// Trading simulation across multiple planets
print("🌍 GALACTIC TRADING SIMULATION 🌍")
print("")

/// Planet 1: Nebula Prime
let planet1Name = getPlanetName(1)
let specialty1 = getPlanetSpecialty(1)
let resource1Name = getResourceName(specialty1)
let resource1Price = getResourcePrice(specialty1)

reportMarket("📍 Arriving at ${planet1Name}", "This planet specializes in: ${resource1Name}", resource1Price)

let purchaseAmount1 = 10
let totalCost1 = cargoValue(purchaseAmount1, resource1Price)
let newCredits1 = minus(credits, totalCost1)
let newCargoUsed1 = plus(cargoUsed, purchaseAmount1)
let travelCost1 = calculateTravelCost(2)
let newFuel1 = minus(shipFuel, travelCost1)

reportPurchase(purchaseAmount1, resource1Name, "Total cost:", totalCost1, newCredits1, ["Cargo: ${newCargoUsed1}/${cargoSpace} 📦"])

/// Planet 2: Crystal Moon
let planet2Name = getPlanetName(2)
reportJump("🚀 Traveling to ${planet2Name}...", travelCost1, newFuel1)

let specialty2 = getPlanetSpecialty(2)
let resource2Name = getResourceName(specialty2)
let resource2Price = getResourcePrice(specialty2)

reportMarket("📍 Arrived at ${planet2Name}", "Local specialty: ${resource2Name}", resource2Price)

/// Sell previous cargo at premium
let sellPrice1 = premium(resource1Price, 25)  // 50% markup
let revenue1 = cargoValue(purchaseAmount1, sellPrice1)
let newCredits2 = plus(newCredits1, revenue1)
let newCargoUsed2 = minus(newCargoUsed1, purchaseAmount1)

reportSale(purchaseAmount1, resource1Name, "Sale price: ${sellPrice1} credits per unit", "Revenue: ${revenue1} credits 💰", newCredits2, ["Cargo space freed: ${newCargoUsed2}/${cargoSpace} 📦"])

/// Buy local specialty
let purchaseAmount2 = 15
let totalCost2 = cargoValue(purchaseAmount2, resource2Price)
let newCredits3 = minus(newCredits2, totalCost2)
let newCargoUsed3 = plus(newCargoUsed2, purchaseAmount2)

reportPurchase(purchaseAmount2, resource2Name, "Cost:", totalCost2, newCredits3, [])

/// Planet 3: Trade Station Alpha (Major Hub)
let planet3Name = getPlanetName(3)
let travelCost2 = calculateTravelCost(3)
let newFuel2 = minus(newFuel1, travelCost2)

reportJump("🚀 Long-range jump to ${planet3Name}", travelCost2, newFuel2)

print("📍 Docking at ${planet3Name}")
print("This is the galaxy's premier trading hub!")

/// Major trade at hub
let sellPrice2 = premium(resource2Price, 30)  // Premium for rare goods
let revenue2 = cargoValue(purchaseAmount2, sellPrice2)
let newCredits4 = plus(newCredits3, revenue2)
let newCargoUsed4 = minus(newCargoUsed3, purchaseAmount2)

reportSale(purchaseAmount2, resource2Name, "Hub premium price: ${sellPrice2} credits per unit", "Major revenue: ${revenue2} credits! 💰", newCredits4, [])

/// Calculate profit and reputation
let totalProfit = minus(newCredits4, credits)
let newReputation = plus(reputation, 1)
let newPlanetsVisited = plus(planetsVisited, 3)
let newReputationTitle = getReputationTitle(newReputation)

print("📈 TRADING RESULTS 📈")
print("Starting credits: ${credits}")
print("Final credits: ${newCredits4}")
print("Total profit: ${totalProfit} credits! 💰")
print("Planets visited: ${newPlanetsVisited}")
print("New reputation: ${newReputationTitle}")
print("")

/// Ship status report
let finalShipStatus = getShipStatus(newFuel2)
print("🛸 SHIP STATUS REPORT 🛸")
print("Fuel level: ${newFuel2}% (${finalShipStatus})")
print("Cargo bay: ${newCargoUsed4}/${cargoSpace} units")
print("Ship condition: Operational")
print("")

/// Advanced calculations and projections
let fuelEfficiency = average(newFuel2, newPlanetsVisited)
let profitPerPlanet = average(totalProfit, newPlanetsVisited)
let projectedWealth = exactArithmetic(fn() => newCredits4 * 2)

print("📊 ADVANCED ANALYTICS 📊")
print("Fuel efficiency: ${fuelEfficiency}% per planet")
print("Profit per planet: ${profitPerPlanet} credits")
print("Projected wealth (if doubled): ${projectedWealth} credits")
print("")

// Mission completion and next steps
print("🏆 MISSION COMPLETE! 🏆")
print("Congratulations, Captain ${newReputationTitle}!")
print("You have successfully established trade routes across the galaxy!")
print("")
print("Next objectives:")
print("  ⭐ Explore more distant sectors")
print("  ⭐ Upgrade ship cargo capacity")
print("  ⭐ Establish permanent trade agreements")
print("  ⭐ Recruit specialized crew members")
print("")
print("🌟 Your trading empire awaits! 🌟")
print("End of Galactic Trade Simulation")
print("Thank you for playing Osprey Space Trader!")

/// Replays the trading ledger and validates every market and status branch.
fn spaceTraderCase() = {
    let costOne = calculateCargoValue(amount: 10, price: getResourcePrice(1))
    let creditsOne = (1000 - costOne) 
    let cargoOne = (0 + 10) 
    let fuelOne = (100 - calculateTravelCost(2)) 
    let sellPriceOne = getResourcePrice(1) + 25
    let revenueOne = calculateCargoValue(amount: 10, price: sellPriceOne)
    let creditsTwo = (creditsOne + revenueOne) 
    let cargoTwo = (cargoOne - 10) 
    let costTwo = calculateCargoValue(amount: 15, price: getResourcePrice(2))
    let creditsThree = (creditsTwo - costTwo) 
    let cargoThree = (cargoTwo + 15) 
    let fuelTwo = (fuelOne - calculateTravelCost(3)) 
    let sellPriceTwo = getResourcePrice(2) + 30
    let revenueTwo = calculateCargoValue(amount: 15, price: sellPriceTwo)
    let creditsFour = (creditsThree + revenueTwo) 
    let cargoFour = (cargoThree - 15) 
    let profit = (creditsFour - 1000) 
    let projected = (creditsFour * 2) 

    checkAll("space trader branch tables", [
        structuralEquals([getResourcePrice(1), getResourcePrice(2), getResourcePrice(3)], [50, 25, 75]),
        structuralEquals([getResourcePrice(4), getResourcePrice(5), getResourcePrice(9)], [100, 30, 10]),
        structuralEquals([getPlanetSpecialty(1), getPlanetSpecialty(2), getPlanetSpecialty(3)], [1, 2, 3]),
        structuralEquals([getPlanetSpecialty(4), getPlanetSpecialty(5), getPlanetSpecialty(9)], [4, 5, 6]),
        structuralEquals([calculateTravelCost(1), calculateTravelCost(2), calculateTravelCost(3)], [10, 20, 30]),
        structuralEquals([calculateTravelCost(4), calculateTravelCost(9)], [40, 50]),
        structuralEquals([getResourceName(1), getResourceName(2)], ["Quantum Crystals", "Space Metal"]),
        structuralEquals([getResourceName(3), getResourceName(4)], ["Exotic Spices", "Rare Artifacts"]),
        structuralEquals([getResourceName(5), getResourceName(9)], ["Energy Cells", "Common Minerals"]),
        structuralEquals([getPlanetName(1), getPlanetName(2)], ["Nebula Prime", "Crystal Moon"]),
        structuralEquals([getPlanetName(3), getPlanetName(4)], ["Trade Station Alpha", "Asteroid Mining Base"]),
        structuralEquals([getPlanetName(5), getPlanetName(9)], ["Galactic Hub", "Unknown Sector"])
    ])
    checkAll("space trader ledger and ship state", [
        structuralEquals([getReputationTitle(0), getReputationTitle(1)], ["Unknown Trader", "Novice Merchant"]),
        structuralEquals([getReputationTitle(2), getReputationTitle(3)], ["Skilled Trader", "Master Merchant"]),
        structuralEquals([getReputationTitle(4), getReputationTitle(9)], ["Trade Baron", "Galactic Legend"]),
        structuralEquals([getShipStatus(100), getShipStatus(75), getShipStatus(50)], ["Excellent", "Good", "Fair"]),
        structuralEquals([getShipStatus(25), getShipStatus(10), getShipStatus(fuelTwo)], ["Low", "Critical", "Fair"]),
        calculateCargoValue(amount: 10, price: 50) == 500,
        calculateCargoValue(amount: 9223372036854775807, price: 2) == 9223372036854775807,
        structuralEquals([costOne, creditsOne, cargoOne, fuelOne, sellPriceOne], [500, 500, 10, 80, 75]),
        structuralEquals([revenueOne, creditsTwo, cargoTwo, costTwo, creditsThree], [750, 1250, 0, 375, 875]),
        structuralEquals([cargoThree, fuelTwo, sellPriceTwo, revenueTwo, creditsFour], [15, 50, 55, 825, 1700]),
        structuralEquals([cargoFour, profit, projected], [0, 700, 3400])
    ])
}

test("space trading preserves market, ledger, and ship state", exactly(spaceTraderCase))
