// Process builtins [BUILTIN-PROCESS].
// Demonstrates async process spawning with ProcessHandle type,
// real-time callback-based stdout/stderr collection, and proper resource management

print("=== Async Process Management Demo ===")

/// A spawned handle paired with the exit code its wait reported.
type WaitedHandle = { processID: int, exitCode: int }

/// Define the callback function that C runtime will call
fn processEventHandler(processID, eventType, data) = {
    match eventType {
        1 => print("[STDOUT] Process ${toString(processID)}: ${data}")
        2 => print("[STDERR] Process ${toString(processID)}: ${data}")
        3 => print("[EXIT] Process ${toString(processID)} exited with code: ${data}")
        _ => print("[UNKNOWN] Process ${toString(processID)} event ${toString(eventType)}: ${data}")
    }
}

/// Waits for `value`, prints `message`, then releases the handle, in that order.
fn awaitAndCleanup(value, message) = {
    let _exitCode = awaitProcess(value)
    print(message)
    cleanupProcess(value)
}

// Test 1: Basic async process spawning with callback-based output
print("--- Test 1: Basic Process Spawning ---")
let result1 = spawnProcess("echo Hello from async process!", processEventHandler)
match result1 {
    Success { value } => {
        print("✓ Process spawned successfully")
        awaitAndCleanup(value, "✓ Process completed successfully")
        print("✓ Process resources cleaned up")
    }
    Error => print("✗ Process spawn failed")
}

// Test 2: Process with different output
print("--- Test 2: Another Process ---")
let result2 = spawnProcess("echo Process 2 output", processEventHandler)
match result2 {
    Success { value } => {
        print("Process 2 spawned successfully")
        awaitAndCleanup(value, "Process 2 finished")
    }
    Error => print("Process 2 failed")
}

// Test 3: Error handling
print("--- Test 3: Error Handling ---")
let result3 = spawnProcess("exit 1", processEventHandler)  // Command that returns exit code 1
match result3 {
    Success { value } => awaitAndCleanup(value, "Error process returned non-zero exit code")
    Error => print("✗ Process spawn unexpectedly failed")
}

// Test 4: Result<ProcessHandle> toString conversion
print("--- Test 4: ProcessHandle Result toString ---")
let result4 = spawnProcess("echo Testing toString", processEventHandler)
print("ProcessHandle Result toString: ${toString(result4)}")  // Tests convertResultToString for ProcessHandle
match result4 {
    Success { value } => {
        let _ = awaitProcess(value)
        cleanupProcess(value)
    }
    Error => print("Process 4 failed")
}

print("=== Async Process Management Demo Complete ===\nNote: Process output appears via C runtime callbacks during execution")

/// Spawns `command`, waits for it, releases it, and reports the exit code to `accept`.
fn probeExit(command, accept) = match spawnProcess(command, processEventHandler) {
    Success { value } => {
        let exitCode = awaitProcess(value)
        cleanupProcess(value)
        accept(exitCode)
    }
    Error => false
}

/// Starts fresh processes so the test asserts real wait and cleanup behavior.
fn asyncProcessLifecycleCase() = checkAll("process wait and cleanup state", [
    probeExit("exit 0", fn(code) => code == 0),
    probeExit("exit 1", fn(code) => code != 0)
])
test("async processes report successful and failing exits", asyncProcessLifecycleCase)

/// Spawns a fresh `exit 0` handle and awaits it, pairing the handle with its exit code.
fn freshHandle() = {
    let processID = spawnProcess("exit 0", processEventHandler) ?: -1
    let exitCode = awaitProcess(processID)
    WaitedHandle { processID: processID, exitCode: exitCode }
}

/// Handle numbers only increase, and a released handle answers -1 exactly as
/// one that was never issued does. [BUILTIN-PROCESS-FAILURE]
fn processHandleCase() = {
    let first = freshHandle()
    let second = freshHandle()
    cleanupProcess(first.processID)
    cleanupProcess(second.processID)
    checkAll("process handles are fresh and released exactly once", [
        first.processID > 0, second.processID > first.processID,
        structuralEquals([first.exitCode, second.exitCode], [0, 0]),
        awaitProcess(first.processID) == -1, awaitProcess(second.processID) == -1,
        awaitProcess(999999) == -1, awaitProcess(-1) == -1, awaitProcess(0) == -1
    ])
}
test("process handles only increase and released handles await to -1", processHandleCase)
