// ML twin of async_process_management.osp. [BUILTIN-PROCESS]
// spawnProcess/awaitProcess/cleanupProcess
// are ordinary builtin calls (whitespace application); `match` arms with multi-line
// bodies become indented layout blocks, and `Success { value }` / `Error { message }`
// constructor patterns become positional `Success value` / `Error message`. Lowers to
// the same canonical AST as the Default flavor — byte-identical IR.

print "=== Async Process Management Demo ==="

(** A spawned handle paired with the exit code its wait reported. *)
type WaitedHandle =
    processID : int
    exitCode : int

processEventHandler (processID, eventType, data) =
    match eventType
        1 => print "[STDOUT] Process ${toString processID}: ${data}"
        2 => print "[STDERR] Process ${toString processID}: ${data}"
        3 => print "[EXIT] Process ${toString processID} exited with code: ${data}"
        _ => print "[UNKNOWN] Process ${toString processID} event ${toString eventType}: ${data}"

(** Waits for `value`, prints `message`, then releases the handle, in that order. *)
awaitAndCleanup (value, message) =
    _exitCode = awaitProcess value
    print message
    cleanupProcess value

print "--- Test 1: Basic Process Spawning ---"
result1 = spawnProcess "echo Hello from async process!" processEventHandler
match result1
    Success value =>
        print "✓ Process spawned successfully"
        awaitAndCleanup (value, "✓ Process completed successfully")
        print "✓ Process resources cleaned up"
    Error _message => print "✗ Process spawn failed"

print "--- Test 2: Another Process ---"
result2 = spawnProcess "echo Process 2 output" processEventHandler
match result2
    Success value =>
        print "Process 2 spawned successfully"
        awaitAndCleanup (value, "Process 2 finished")
    Error _message => print "Process 2 failed"

print "--- Test 3: Error Handling ---"
result3 = spawnProcess "exit 1" processEventHandler
match result3
    Success value => awaitAndCleanup (value, "Error process returned non-zero exit code")
    Error _message => print "✗ Process spawn unexpectedly failed"

print "--- Test 4: ProcessHandle Result toString ---"
result4 = spawnProcess "echo Testing toString" processEventHandler
print "ProcessHandle Result toString: ${toString result4}"
match result4
    Success value =>
        _ = awaitProcess value
        cleanupProcess value
    Error _message => print "Process 4 failed"

print "=== Async Process Management Demo Complete ==="
print "Note: Process output appears via C runtime callbacks during execution"

(** Spawns `command`, waits for it, releases it, and reports the exit code to `accept`. *)
probeExit (command, accept) =
    match spawnProcess command processEventHandler
        Success value =>
            exitCode = awaitProcess value
            cleanupProcess value
            accept exitCode
        Error _message => false

(** Start fresh processes so the test asserts real wait and cleanup behavior. *)
asyncProcessLifecycleCase () =
    checkAll "process wait and cleanup state" [
        probeExit ("exit 0", \code => code == 0),
        probeExit ("exit 1", \code => code != 0)
    ]
test "async processes report successful and failing exits" asyncProcessLifecycleCase

(** Spawns a fresh `exit 0` handle and awaits it, pairing the handle with its exit code. *)
freshHandle () =
    processID = spawnProcess "exit 0" processEventHandler ?: -1
    exitCode = awaitProcess processID
    WaitedHandle(processID = processID, exitCode = exitCode)

(** Handle numbers only increase, and a released handle answers -1 exactly as
    one that was never issued does. [BUILTIN-PROCESS-FAILURE] *)
processHandleCase () =
    first = freshHandle ()
    second = freshHandle ()
    cleanupProcess first.processID
    cleanupProcess second.processID
    checkAll "process handles are fresh and released exactly once" [
        first.processID > 0, second.processID > first.processID,
        structuralEquals [first.exitCode, second.exitCode] [0, 0],
        awaitProcess first.processID == -1, awaitProcess second.processID == -1,
        awaitProcess 999999 == -1, awaitProcess (-1) == -1, awaitProcess 0 == -1
    ]
test "process handles only increase and released handles await to -1" processHandleCase
