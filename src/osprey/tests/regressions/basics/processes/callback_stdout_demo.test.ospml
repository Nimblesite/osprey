(** ML twin: collect arbitrary pipe chunks until exit. Processes run sequentially. *)
mut stdoutText = ""
mut stderrText = ""

print "=== CALLBACK-BASED STDOUT COLLECTION DEMO ==="

outputTrace (processID, channel, data) =
    match data == ""
        true => ""
        false => "[CALLBACK] Process ${processID} ${channel}: ${data}\n"

completeTrace (processID, data) =
    output = outputTrace (processID, "STDOUT", stdoutText)
    errors = outputTrace (processID, "STDERR", stderrText)
    print "${output}${errors}[CALLBACK] Process ${processID} EXIT: ${data}"

effect CollectedOutput
    stdout : string => Unit
    stderr : string => Unit
    finished : (int, string) => Unit

processEventHandler (processID, eventType, data) =
    handle CollectedOutput
        stdout chunk => stdoutText := stdoutText + chunk
        stderr chunk => stderrText := stderrText + chunk
        finished processID data =>
            completeTrace (processID, data)
            stdoutText := ""
            stderrText := ""
    match eventType
        1 => perform CollectedOutput.stdout data
        2 => perform CollectedOutput.stderr data
        3 => perform CollectedOutput.finished processID data
        _ => print "[CALLBACK] Process ${toString processID} UNKNOWN EVENT ${toString eventType}: ${data}"

print "--- Test 1: Basic Stdout Callback ---"
result1 = spawnProcess "echo Hello from callback!" processEventHandler
match result1
    Success value =>
        print "✓ Process spawned with ID: ${toString value}"
        exitCode = awaitProcess value
        print "✓ Process finished with exit code: ${toString exitCode}"
        cleanupProcess value
        print "✓ Process cleaned up"
    Error _message => print "✗ Failed to spawn process"

// Write boundaries do not determine callback boundaries. [BUILTIN-PROCESS]
print "--- Test 2: Multiple Lines Callback ---"
result2 = spawnProcess "printf 'Line 1\\nLine 2\\nLine 3\\n'" processEventHandler
match result2
    Success value =>
        print "✓ Multi-line process spawned with ID: ${toString value}"
        _exitCode = awaitProcess value
        print "✓ Multi-line process finished"
        cleanupProcess value
    Error _message => print "✗ Failed to spawn multi-line process"

print "--- Test 3: Error Process Callback ---"
result3 = spawnProcess "echo Expected failure 1>&2 && exit 1" processEventHandler
match result3
    Success value =>
        print "✓ Error process spawned with ID: ${toString value}"
        exitCode = awaitProcess value
        print "✓ Error process finished with exit code: ${toString exitCode}"
        cleanupProcess value
    Error _message => print "✗ Failed to spawn error process"

print "=== CALLBACK DEMO COMPLETE ===\nThe [CALLBACK] lines above show C runtime calling into Osprey!\n--- Fragmented stdout and stderr callbacks ---"
processEventHandler (99, 1, "Line 1\nLi")
processEventHandler (99, 2, "warn")
processEventHandler (99, 1, "ne 2\nLine 3\n")
processEventHandler (99, 2, "ing\n")
processEventHandler (99, 3, "0")

(** Drive stdout, exit callbacks, waits, and cleanup from inside the test body. *)
callbackLifecycleCase () =
    outputProbe = spawnProcess "echo asserted callback output" processEventHandler
    outputCompleted = match outputProbe
        Success value =>
            exitCode = awaitProcess value
            cleanupProcess value
            exitCode == 0
        Error _message => false
    errorProbe = spawnProcess "echo asserted callback error 1>&2 && exit 1" processEventHandler
    errorCompleted = match errorProbe
        Success value =>
            exitCode = awaitProcess value
            cleanupProcess value
            exitCode == 1
        Error _message => false
    checkAll "callback process lifecycle state" [outputCompleted, errorCompleted]
test "callbacks accompany successful and failing process exits" callbackLifecycleCase
