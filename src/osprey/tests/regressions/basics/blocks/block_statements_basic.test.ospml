(** Cross-contract oracle for [BLOCK-SCOPE], [PATTERN-RESULT-DEFAULT],
    [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [ARITH-CHECKED],
    [FLAVOR-ML-BLOCK], [FLAVOR-ML-LIST], [FLAVOR-ML-MAP],
    [FLAVOR-ML-INDEX], and [FLAVOR-ML-MATCH]. *)

print "=== Block Statements ==="

(** --- 1. Block with list access (single statement) --- *)
listHeadBlock () =
    nums = [42, 84, 126]
    match nums[0]
        Success value => value
        Error _message => 0
r1 = listHeadBlock ()
print "1 list head: ${r1}"

(** --- 2. Block with map access + multiplication --- *)
mapProductBlock () =
    config = ["factor" => 2, "base" => 10]
    x = match config["base"]
        Success value => value
        Error _message => 0
    factor = match config["factor"]
        Success value => value
        Error _message => 1
    m = x * factor
    m
r2 = exactArithmetic (\() =>
    mapProductBlock ())
print "2 map factor*base: ${r2}"

(** --- 3. Nested blocks with shadowing --- *)
outer = 100
shadowedBlock () =
    config = ["multiplier" => 2, "offset" => 25]
    outer = match config["offset"]
        Success value => value
        Error _message => 50
    inner =
        listData = [10, 20, 30]
        outer = match listData[2]
            Success value => value
            Error _message => 25
        m = outer * 2
        m
    s = outer + inner
    s
r3 = exactArithmetic (\() =>
    shadowedBlock ())
print "3 shadowed inner+outer: ${r3}"

(** --- 4. Block inside a function --- *)
compute () =
    numbers = [5, 10, 15]
    base = match numbers[1]
        Success value => value
        Error _message => 10
    multiplier = 3
    r = base * multiplier
    r
exactArithmetic (\() =>
    print "4 fn block: ${compute ()}")

(** --- 5. 2D list inside a block --- *)
matrixBlock () =
    matrix = [[1, 2], [3, 4]]
    firstRow = match matrix[0]
        Success value => value
        Error _message => [0]
    match firstRow[1]
        Success value =>
            m = value * 10
            match m
                Success result => result
                Error _message => 0
        Error _message => 0
r5 = exactArithmetic (\() =>
    matrixBlock ())
print "5 2D matrix[0][1]*10: ${r5}"

(** --- 6. Conditional logic via nested match producing a block result --- *)
value = 42
conditionalBlock value =
    scoreMap = ["test1" => 84, "test2" => 90]
    doubled = value * 2
    match doubled
        Success dValue => match dValue
            84 => match scoreMap["test1"]
                Success sValue =>
                    added = sValue + 10
                    match added
                        Success value => value
                        Error _message => 0
                Error _message => 0
            _ => 0
        Error _message => 0
r6 = exactArithmetic (\() =>
    conditionalBlock value)
print "6 cond match block: ${r6}\n=== Done ==="

(** Verify every block result, including shadowing and the wildcard branch. *)
blockStatementsCase () =
    results = [r1, r2, r3, compute (), r5, r6]
    nestedResults = [results, [listHeadBlock (), matrixBlock ()], [conditionalBlock 10]]
    byName = [
        "head" => r1,
        "map" => r2,
        "shadow" => r3,
        "compute" => compute (),
        "matrix" => r5,
        "conditional" => r6
    ]

    checkAll "block statement values" [
        structuralEquals [listHeadBlock (), mapProductBlock (), shadowedBlock (), compute ()] [42, 20, 85, 30],
        structuralEquals [matrixBlock (), conditionalBlock 42, conditionalBlock 10] [20, 94, 0]
    ]

    checkAll "top-level bindings and lexical shadowing remain stable" [
        structuralEquals [r1, r2, r3, r5, r6, outer, value, conditionalBlock 0] [42, 20, 85, 20, 94, 100, 42, 0],
        structuralEquals [conditionalBlock 41, conditionalBlock 43, conditionalBlock ((0 - 1) )] [0, 0, 0],
        shadowedBlock () == r3,
        compute () == compute (),
        matrixBlock () == r5,
        conditionalBlock value == r6
    ]

    checkAll "block results retain element types in nested lists" [
        structuralEquals [listLength results, (listGet results 0 ?: 99), (listGet results 1 ?: 99)] [6, 42, 20],
        structuralEquals [(listGet results 2 ?: 99), (listGet results 3 ?: 99), (listGet results 4 ?: 99)] [85, 30, 20],
        structuralEquals [(listGet results 5 ?: 99), (listGet results 9 ?: 99), listLength nestedResults] [94, 99, 3],
        listLength (listGet nestedResults 0 ?: [99]) == 6,
        listLength (listGet nestedResults 1 ?: [99]) == 2,
        listLength (listGet nestedResults 2 ?: [99]) == 1,
        (listGet (listGet nestedResults 0 ?: [99]) 2 ?: 99) == 85,
        (listGet (listGet nestedResults 1 ?: [99]) 1 ?: 99) == 20,
        (listGet (listGet nestedResults 2 ?: [99]) 0 ?: 99) == 0
    ]

    checkAll "block results remain coherent in maps and interpolation" [
        structuralEquals [mapLength byName, (mapGet byName "head" ?: 99)] [6, 42],
        structuralEquals [(mapGet byName "map" ?: 99), (mapGet byName "shadow" ?: 99)] [20, 85],
        structuralEquals [(mapGet byName "compute" ?: 99), (mapGet byName "matrix" ?: 99)] [30, 20],
        structuralEquals [(mapGet byName "conditional" ?: 99), (mapGet byName "missing" ?: 99)] [94, 99],
        structuralEquals [listLength (mapKeys byName), listLength (mapValues byName)] [6, 6],
        "${r1}/${r2}/${r3}/${r5}/${r6}" == "42/20/85/20/94",
        "outer=${outer} inner=${shadowedBlock ()}" == "outer=100 inner=85"
    ]

test "blocks preserve values and lexical scope" (\() => exactArithmetic (blockStatementsCase))

(** [BLOCK-SCOPE] Runtime storage and callable metadata follow source bindings. *)
effect BlockRead
    value : Unit => int
blockCellShadow input =
    value = 100
    selected =
        mut value = wrapAdd value input
        handle BlockRead
            value => value
        perform BlockRead.value ()
    "${selected}:${value}"
blockOuterCell () =
    mut value = 100
    handle BlockRead
        value => value
    selected =
        mut value = 2
        handle BlockRead
            value => value
        perform BlockRead.value ()
    "${selected}:${value}:${perform BlockRead.value ()}"
blockImmutableOverCell () =
    mut value = 100
    handle BlockRead
        value => value
    selected =
        value = wrapAdd value 2
        read = \() => value
        read ()
    "${selected}:${value}"
blockCallableShadow () =
    apply = \x => wrapAdd x 100
    selected =
        apply = \x => wrapMul x 2
        apply 3
    "${selected}:${apply 3}"
blockIdentity x = x
blockConstant x = \_unused => x
blockGenericShadow () =
    apply = blockIdentity
    selected =
        apply = blockConstant 9
        apply 3
    "${selected}:${apply 3}"
blockEscapingCallable () =
    apply = \x => wrapAdd x 100
    selected =
        apply = \x => wrapAdd x 2
        apply
    "${selected 40}:${apply 40}"
test "nested cells leave their enclosing immutable binding intact" (\() => check "cell shadow" "102:100" (blockCellShadow 2))
test "nested cells restore the enclosing cell and handler" (\() => check "outer cell" "2:100:100" (blockOuterCell ()))
test "immutable shadowing reads then hides an enclosing cell" (\() => check "immutable shadow" "102:100" (blockImmutableOverCell ()))
test "nested callable bindings restore their enclosing lambda" (\() => check "lambda shadow" "6:103" (blockCallableShadow ()))
test "nested generic aliases restore their enclosing function" (\() => check "generic shadow" "9:3" (blockGenericShadow ()))
test "escaping block callables retain their own lexical binding" (\() => check "escaping lambda" "42:140" (blockEscapingCallable ()))

blockResultShadow () =
    value = Success(value = 100)
    selected =
        value = 42
        "${value}"
    "${selected}:${value ?: 0}"
blockApply f = f 42
blockAliasOverCell () =
    mut value = 100
    handle BlockRead
        value => value
    selected =
        value = blockIdentity
        blockApply value
    "${selected}:${value}"
test "a plain shadowing binding never inherits Result storage" (\() => check "Result shadow" "42:100" (blockResultShadow ()))
test "a generic alias hides an enclosing cell when passed as a value" (\() => check "alias over cell" "42:100" (blockAliasOverCell ()))
