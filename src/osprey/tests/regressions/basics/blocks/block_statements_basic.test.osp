/// Exact-value tests record any arithmetic fault as a failed assertion.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

// Cross-contract oracle for [BLOCK-SCOPE], [PATTERN-RESULT-DEFAULT],
// [TYPE-LIST], [TYPE-MAP], [TYPE-MAP-LOOKUP], [ARITH-CHECKED], and
// [BUILTIN-STRING-UFCS].

print("=== Block Statements ===")

/// --- 1. Block with list access (single statement) ---
fn listHeadBlock() = {
    let nums = [42, 84, 126]
    match nums[0] {
        Success { value } => value
        Error => 0
    }
}
let r1 = listHeadBlock()
print("1 list head: ${r1}")

/// --- 2. Block with map access + multiplication ---
fn mapProductBlock() = {
    let config = { "factor": 2, "base": 10 }
    let x = match config["base"] { Success { value } => value Error => 0 }
    let factor = match config["factor"] { Success { value } => value Error => 1 }
    let m = x * factor
    m
}
let r2 = exactArithmetic(fn() => mapProductBlock())
print("2 map factor*base: ${r2}")

/// --- 3. Nested blocks with shadowing ---
let outer = 100
fn shadowedBlock() = {
    let config = { "multiplier": 2, "offset": 25 }
    let outer = match config["offset"] {
        Success { value } => value
        Error => 50
    }
    let inner = {
        let listData = [10, 20, 30]
        let outer = match listData[2] {
            Success { value } => value
            Error => 25
        }
        let m = outer * 2
        m
    }
    let s = outer + inner
    s
}
let r3 = exactArithmetic(fn() => shadowedBlock())
print("3 shadowed inner+outer: ${r3}")

/// --- 4. Block inside a function ---
fn compute() = {
    let numbers = [5, 10, 15]
    let base = match numbers[1] {
        Success { value } => value
        Error => 10
    }
    let multiplier = 3
    let r = base * multiplier
    r
}
exactArithmetic(fn() => print("4 fn block: ${compute()}"))

/// --- 5. 2D list inside a block ---
fn matrixBlock() = {
    let matrix = [[1, 2], [3, 4]]
    let firstRow = match matrix[0] {
        Success { value } => value
        Error => [0]
    }
    match firstRow[1] {
        Success { value } => {
            let m = value * 10
            match m {
                Success { result } => result
                Error => 0
            }
        }
        Error => 0
    }
}
let r5 = exactArithmetic(fn() => matrixBlock())
print("5 2D matrix[0][1]*10: ${r5}")

/// --- 6. Conditional logic via nested match producing a block result ---
let value = 42
fn conditionalBlock(value) = {
    let scoreMap = { "test1": 84, "test2": 90 }
    let doubled = value * 2
    match doubled {
        Success { dValue } => match dValue {
            84 => match scoreMap["test1"] {
                Success { sValue } => {
                    let added = sValue + 10
                    match added {
                        Success { value } => value
                        Error => 0
                    }
                }
                Error => 0
            }
            _ => 0
        }
        Error => 0
    }
}
let r6 = exactArithmetic(fn() => conditionalBlock(value))
print("6 cond match block: ${r6}\n=== Done ===")

/// Verifies every block result, including shadowing and the wildcard branch.
fn blockStatementsCase() = {
    let results = [r1, r2, r3, compute(), r5, r6]
    let nestedResults = [results, [listHeadBlock(), matrixBlock()], [conditionalBlock(10)]]
    let byName = {
        "head": r1,
        "map": r2,
        "shadow": r3,
        "compute": compute(),
        "matrix": r5,
        "conditional": r6
    }

    checkAll("block statement values", [
            listHeadBlock() == 42,
            mapProductBlock() == 20,
            shadowedBlock() == 85,
            compute() == 30,
            matrixBlock() == 20,
            conditionalBlock(42) == 94,
            conditionalBlock(10) == 0
    ])

    checkAll("top-level bindings and lexical shadowing remain stable", [
            r1 == 42,
            r2 == 20,
            r3 == 85,
            r5 == 20,
            r6 == 94,
            outer == 100,
            value == 42,
            shadowedBlock() == r3,
            compute() == compute(),
            matrixBlock() == r5,
            conditionalBlock(value) == r6,
            conditionalBlock(0) == 0,
            conditionalBlock(41) == 0,
            conditionalBlock(43) == 0,
            conditionalBlock((0 - 1) ) == 0
    ])

    checkAll("block results retain element types in nested lists", [
            listLength(results) == 6,
            (results.listGet(0) ?: 99) == 42,
            (results.listGet(1) ?: 99) == 20,
            (results.listGet(2) ?: 99) == 85,
            (results.listGet(3) ?: 99) == 30,
            (results.listGet(4) ?: 99) == 20,
            (results.listGet(5) ?: 99) == 94,
            (results.listGet(9) ?: 99) == 99,
            listLength(nestedResults) == 3,
            listLength(nestedResults.listGet(0) ?: [99]) == 6,
            listLength(nestedResults.listGet(1) ?: [99]) == 2,
            listLength(nestedResults.listGet(2) ?: [99]) == 1,
            ((nestedResults.listGet(0) ?: [99]).listGet(2) ?: 99) == 85,
            ((nestedResults.listGet(1) ?: [99]).listGet(1) ?: 99) == 20,
            ((nestedResults.listGet(2) ?: [99]).listGet(0) ?: 99) == 0
    ])

    checkAll("block results remain coherent in maps and interpolation", [
            mapLength(byName) == 6,
            (byName.mapGet("head") ?: 99) == 42,
            (byName.mapGet("map") ?: 99) == 20,
            (byName.mapGet("shadow") ?: 99) == 85,
            (byName.mapGet("compute") ?: 99) == 30,
            (byName.mapGet("matrix") ?: 99) == 20,
            (byName.mapGet("conditional") ?: 99) == 94,
            (byName.mapGet("missing") ?: 99) == 99,
            listLength(mapKeys(byName)) == 6,
            listLength(mapValues(byName)) == 6,
            "${r1}/${r2}/${r3}/${r5}/${r6}" == "42/20/85/20/94",
            "outer=${outer} inner=${shadowedBlock()}" == "outer=100 inner=85"
    ])
}

test("blocks preserve values and lexical scope", fn() => exactArithmetic(blockStatementsCase))

/// [BLOCK-SCOPE] Runtime storage and callable metadata follow source bindings.
effect BlockRead { value: fn() -> int }
fn blockCellShadow(input) = {
    let value = 100
    let selected = {
        mut value = wrapAdd(value, input)
        handle BlockRead { value => value }
        perform BlockRead.value()
    }
    "${selected}:${value}"
}
fn blockOuterCell() = {
    mut value = 100
    handle BlockRead { value => value }
    let selected = {
        mut value = 2
        handle BlockRead { value => value }
        perform BlockRead.value()
    }
    "${selected}:${value}:${perform BlockRead.value()}"
}
fn blockImmutableOverCell() = {
    mut value = 100
    handle BlockRead { value => value }
    let selected = {
        let value = wrapAdd(value, 2)
        let read = fn() => value
        read()
    }
    "${selected}:${value}"
}
fn blockCallableShadow() = {
    let apply = fn(x) => wrapAdd(x, 100)
    let selected = {
        let apply = fn(x) => wrapMul(x, 2)
        apply(3)
    }
    "${selected}:${apply(3)}"
}
fn blockIdentity(x) = x
fn blockConstant(x) = fn(_unused) => x
fn blockGenericShadow() = {
    let apply = blockIdentity
    let selected = {
        let apply = blockConstant(9)
        apply(3)
    }
    "${selected}:${apply(3)}"
}
fn blockEscapingCallable() = {
    let apply = fn(x) => wrapAdd(x, 100)
    let selected = {
        let apply = fn(x) => wrapAdd(x, 2)
        apply
    }
    "${selected(40)}:${apply(40)}"
}
test("nested cells leave their enclosing immutable binding intact", fn() => check("cell shadow", "102:100", blockCellShadow(2)))
test("nested cells restore the enclosing cell and handler", fn() => check("outer cell", "2:100:100", blockOuterCell()))
test("immutable shadowing reads then hides an enclosing cell", fn() => check("immutable shadow", "102:100", blockImmutableOverCell()))
test("nested callable bindings restore their enclosing lambda", fn() => check("lambda shadow", "6:103", blockCallableShadow()))
test("nested generic aliases restore their enclosing function", fn() => check("generic shadow", "9:3", blockGenericShadow()))
test("escaping block callables retain their own lexical binding", fn() => check("escaping lambda", "42:140", blockEscapingCallable()))

fn blockResultShadow() = {
    let value = Success { value: 100 }
    let selected = {
        let value = 42
        "${value}"
    }
    "${selected}:${value ?: 0}"
}
fn blockApply(f) = f(42)
fn blockAliasOverCell() = {
    mut value = 100
    handle BlockRead { value => value }
    let selected = {
        let value = blockIdentity
        blockApply(value)
    }
    "${selected}:${value}"
}
test("a plain shadowing binding never inherits Result storage", fn() => check("Result shadow", "42:100", blockResultShadow()))
test("a generic alias hides an enclosing cell when passed as a value", fn() => check("alias over cell", "42:100", blockAliasOverCell()))
