// PiMath regression: the math and bitwise builtins [BUILTIN-MATH] and its
// sections [BUILTIN-MATH-TRIG] [BUILTIN-MATH-HYPERBOLIC] [BUILTIN-MATH-LOG]
// [BUILTIN-MATH-SPECIAL] [BUILTIN-MATH-ROUNDING] [BUILTIN-CONVERT-FLOAT]
// [BUILTIN-FLOAT-BITS] [BUILTIN-FLOATTOINT] [BUILTIN-BITWISE]. The exact
// families print their byte-exact values (identical on every host and device);
// the transcendental families compare within 1e-12, which every host libm
// agrees on, so the golden holds across the default, gc, arc and wasm32 lanes.

/// |a - b| < 1e-12: libm last digits differ between hosts, but never by more
/// than a couple of ulps — 1e-12 is far above that.
fn close(a, b) = abs(a - b) < 0.000000000001

/// floatToInt renders deterministically without pinning the error message.
fn showFloatToInt(x) = match floatToInt(x) {
    Success { value } => "Success(" + toString(value) + ")"
    Error => "Error"
}

/// One exact-family row: prints `<label>=<value>` and asserts the value it printed.
fn exactRow(label, actual, expected) = {
    print(label + "=" + toString(actual))
    actual == expected
}

fn exactCase() = checkAll("exact families are byte-exact", [
    exactRow("floor(-2.7)", floor(-2.7), -3.0),
    exactRow("ceil(2.3)", ceil(2.3), 3.0),
    exactRow("trunc(-2.7)", trunc(-2.7), -2.0),
    exactRow("round(2.5)", round(2.5), 2.0),
    exactRow("round(3.5)", round(3.5), 4.0),
    exactRow("round(-2.5)", round(-2.5), -2.0),
    exactRow("fmod(-7.5,2)", fmod(-7.5, 2.0), -1.5),
    exactRow("copysign(3,-1)", copysign(3.0, -1.0), -3.0),
    exactRow("toFloat32(0.1)", toFloat32(0.1), 0.1),
    exactRow("floatBits(1)", floatBits(1.0), 4607182418800017408),
    exactRow("floatFromBits", floatFromBits(4607182418800017408), 1.0),
    exactRow("float32Bits(toFloat32(0.1))", float32Bits(toFloat32(0.1)), 1036831949),
    exactRow("float32FromBits", float32FromBits(1036831949), toFloat32(0.1)),
    exactRow("float16Bits(toFloat16(1.0))", float16Bits(toFloat16(1.0)), 15360),
    exactRow("float16FromBits", float16FromBits(15360), toFloat16(1.0)),
    exactRow("floatToInt(-2.9)", showFloatToInt(-2.9), "Success(-2)"),
    exactRow("floatToInt(2.9)", showFloatToInt(2.9), "Success(2)"),
    exactRow("floatToInt(nan)", showFloatToInt(sqrt(-1.0)), "Error"),
    exactRow("floatToInt(inf)", showFloatToInt(exp(1000.0)), "Error"),
    exactRow("floatToInt(1e300)", showFloatToInt(exp(100.0)), "Error"),
    exactRow("bitAnd", bitAnd(12, 10), 8),
    exactRow("bitOr", bitOr(12, 10), 14),
    exactRow("bitXor", bitXor(12, 10), 6),
    exactRow("bitNot", bitNot(12), -13),
    exactRow("shiftLeft", shiftLeft(1, 40), 1099511627776),
    exactRow("shiftLeft(64)", shiftLeft(1, 64), 0),
    exactRow("shiftRight", shiftRight(-16, 2), -4),
    exactRow("shiftRightLogical", shiftRightLogical(-16, 2), 4611686018427387900),
    exactRow("shiftRight(64)", shiftRight(-1, 64), -1),
    exactRow("shiftRightLogical(64)", shiftRightLogical(1, 64), 0)
])

/// The value each transcendental family yields at its probe argument, in order.
fn familyValues() = [
    sin(1.0), cos(1.0), tan(0.5), asin(0.5),
    acos(0.5), atan(0.5), atan2(1.0, -1.0), sinh(1.0),
    cosh(1.0), asinh(1.0), acosh(2.0), atanh(0.5),
    log2(8.0), log10(1000.0), log1p(0.1), expm1(0.1),
    erf(1.0), erfc(1.0), pow(2.0, 10.0), hypot(3.0, 4.0)
]

/// The reference each family value matches within 1e-12, in the same order.
fn familyReferences() = [
    0.8414709848078965, 0.5403023058681398, 0.5463024898437905, 0.5235987755982988,
    1.0471975511965976, 0.46364760900080615, 2.356194490192345, 1.1752011936438014,
    1.5430806348152437, 0.881373587019543, 1.3169578969248166, 0.5493061443340549,
    3.0, 3.0, 0.09531017980432487, 0.10517091807564763,
    0.8427007929497148, 0.15729920705028516, 1024.0, 5.0
]

/// True when `actual` is within 1e-12 of the reference held in `found`.
fn closeFound(actual, found) = match found {
    Success { value } => close(actual, value)
    Error _ => false
}

/// The `i`-th family value against the `i`-th reference; a missing index fails.
fn closeAt(values, references, i) = match listGet(values, i) {
    Success { value } => closeFound(value, listGet(references, i))
    Error _ => false
}

/// One in-tolerance row per family, in family order.
fn closeRows(values, references) = mapList(toList(range(0, listLength(references))), fn(i) => closeAt(values, references, i))

/// One labelled assertion per row, in order.
fn checkRows(label, rows) = forEachList(rows, fn(ok) => checkTrue(label, ok))

fn transcendentalCase() = {
    checkRows("transcendental families within 1e-12", closeRows(familyValues(), familyReferences()))
    checkAll("transcendental families within 1e-12", [
        // Exact special values of the transcendental families.
        sin(0.0) == 0.0,
        cos(0.0) == 1.0,
        pow(0.0, 0.0) == 1.0,
        pow(2.0, 0.0) == 1.0,
        atan2(0.0, 1.0) == 0.0,
        hypot(0.0, 0.0) == 0.0,
        log2(1.0) == 0.0,
        log10(1.0) == 0.0,
        log1p(0.0) == 0.0,
        expm1(0.0) == 0.0
    ])
}

testCases([
    { name: "math builtins: exact families are byte-exact", work: exactCase },
    { name: "math builtins: transcendental families within 1e-12", work: transcendentalCase }
])
