// ML-flavor twin of string_pipeline.osp. Layout blocks, whitespace
// application (`route "GET" "/health"`), and pipe-with-arg (`raw |> contains "GET"`)
// lower to the SAME canonical AST as the Default braces/parens form —
// byte-identical IR ([FLAVOR-IR-EQUIV]). String API end-to-end: inspection,
// search, transformation, parsing, pipe / UFCS / direct-call equivalence,
// lines/words/split returning List<string>, and an HTTP-routing pattern.
// Spec: [BUILTIN-STRING-UFCS] for the pipe/UFCS/direct equivalence and
// [BUILTIN-STRING-LIST] for the splitting family. Builtins exercised:
// [BUILTIN-STRING-LENGTH], [BUILTIN-STRING-ISEMPTY],
// [BUILTIN-STRING-CONTAINS], [BUILTIN-STRING-STARTSWITH],
// [BUILTIN-STRING-ENDSWITH], [BUILTIN-STRING-INDEXOF],
// [BUILTIN-STRING-SUBSTRING], [BUILTIN-STRING-TAKE], [BUILTIN-STRING-DROP],
// [BUILTIN-STRING-TRIM], [BUILTIN-STRING-TRIMSTART],
// [BUILTIN-STRING-TRIMEND], [BUILTIN-STRING-TOLOWERCASE],
// [BUILTIN-STRING-TOUPPERCASE], [BUILTIN-STRING-JOIN],
// [BUILTIN-STRING-REPLACE], [BUILTIN-STRING-REPEAT],
// [BUILTIN-STRING-REVERSE], [BUILTIN-STRING-PADSTART],
// [BUILTIN-STRING-PADEND], [BUILTIN-STRING-PARSEINT],
// [BUILTIN-STRING-PARSEFLOAT], [BUILTIN-STRING-SPLIT],
// [BUILTIN-STRING-LINES], [BUILTIN-STRING-WORDS], the `+` operator
// [BUILTIN-STRING-CONCAT], and [BUILTIN-COLLECTION-LENGTH] to count the
// resulting List<string>.

handleGet path =
    match path
        "/health" => "200 ok"
        _ => match startsWith path "/api/users/"
            true  => "200 user-detail " + drop path 11
            false => match startsWith path "/api/"
                true  => "200 api-fallback"
                false => "404 not-found"
handlePost path =
    match path
        "/api/users" => "201 created"
        _            => "404 not-found"
route (method, path) =
    match method
        "GET"  => handleGet path
        "POST" => handlePost path
        _      => "405 method-not-allowed"

(** Renders `label="value"` on success, or `<label> err` on failure. *)
quotedLine (label, result) =
    match result
        Success value => "${label}=\"${value}\""
        Error _message => "${label} err"

(** Renders `label=value` on success, or the given failure line. *)
plainLine (label, failure, result) = match result
    Success value => "${label}=${value}"
    Error _message => failure

(** Renders a list's element count under a label. *)
countLine (label, items) = "${label} count=${listLength items}"

(** True when an operation fails with a non-empty message. *)
rejected result =
    match result
        Success _value => false
        Error message => length message > 0

(** One routing line per path requested with the given method. *)
routedLines (method, paths) = mapList (paths, \path => route (method, path))

(** The routing table as one result per request, blank-line separated. *)
routingReport () =
    join [
        join (routedLines ("GET", ["/health", "/api/users/42", "/api/orders"])) "\n\n",
        join (routedLines ("POST", ["/api/users"])) "\n\n",
        route ("GET", "/random"),
        route ("DELETE", "/anything")
    ] "\n\n"

print "=== String Pipeline ===\n"

(** ----- Inspection / search (total, no Result wrap) ----- *)
raw = "  GET /api/users?name=alice&age=30  "
print "raw=\"${raw}\" len=${raw |> length}\n"
print "isEmpty=${raw |> isEmpty}\n"
print "contains 'GET'=${raw |> contains "GET"}\n"
print "startsWith '  '=${raw |> startsWith "  "}\n\nendsWith '  '=${raw |> endsWith "  "}\n"

// pipe == UFCS == direct
print "len pipe=${raw |> length}  ufcs=${length raw}  direct=${length raw}\n"
print "ctns pipe=${raw |> contains "GET"}  ufcs=${contains raw "GET"}  direct=${contains raw "GET"}\n"

(** ----- Transformation chain via pipe ----- *)
normalized = raw |> trim |> toLowerCase
dashed = join ["a", "b", "c"] "-"
print "normalized=\"${normalized}\"\n"
print "isGetRequest=${normalized |> startsWith "get "}\n"
print "upper=\"${toUpperCase "hello"}\"\n"
print "trimStart=\"${trimStart "  hi  "}\"\n"
print "trimEnd=\"${trimEnd "  hi  "}\"\n"
print "join=\"${dashed}\"\n"

// UFCS chain
print "chain=\"${take (toLowerCase (trim raw)) 5}\"\n"

// ----- Substring & search (fallible — Result<T,E>) -----
queryLine = match indexOf raw "?"
    Success value => "query starts at ${value}"
    Error _message => "no query string"
print ((join [queryLine, quotedLine ("substring", substring "hello world" 6 11)] "\n\n") + "\n")

// ----- Transformation (fallible) -----
print ((join [
    quotedLine ("replace", replace "a-b-c-d" "-" "/"),
    quotedLine ("repeat", repeat "ab" 4),
    quotedLine ("padS", padStart "42" 5 "0"),
    quotedLine ("padE", padEnd "42" 5 "0")
] "\n\n") + "\n")

(** ----- take/drop/reverse (UFCS form) ----- *)
hello = "hello"
print "take ufcs=\"${take hello 3}\"\n\ndrop ufcs=\"${drop hello 3}\"\n"
print "reverse=\"${reverse "abc"}\"\n"

// ----- Parsing -----
print ((join [
    plainLine ("parseInt", "pi err", parseInt "123"),
    plainLine ("oops", "parseInt strict: rejects 'oops'", parseInt "oops"),
    plainLine ("parseFloat", "pf err", parseFloat "3.14")
] "\n\n") + "\n")

(** ----- Split/lines/words → List<string> ----- *)
multi  = "a\nb\nc"
spaced = "  hello   world  "
print ((join [countLine ("lines", lines multi), countLine ("words", words spaced)] "\n\n") + "\n")
match split "a,b,c" ","
    Success value => print "split count=${listLength value}\n"
    Error _message => print "split err\n"
match split "anything" ""
    Success _value => print "split empty unexpected\n"
    Error _message => print "split empty rejected\n"

// ----- HTTP-routing via startsWith + pattern matching -----
print (routingReport () + "\n")

print "=== Pipeline Complete ===\n"

(** Replay the transformation pipeline, fallible operations, and routing branches. *)
stringPipelineCase () =
    source = "  GET /api/users?name=alice&age=30  "
    cleaned = source |> trim |> toLowerCase
    splitCount = listLength (split "a,b,c" "," ?: [])
    checkAll "string inspection and transformations" [
        structuralEquals [length source, (source |> length)] [36, 36],
        structuralEquals [isEmpty source, contains source "GET", startsWith source "  ", endsWith source "  "] [false, true, true, true],
        structuralEquals [cleaned, toUpperCase "hello"] ["get /api/users?name=alice&age=30", "HELLO"],
        structuralEquals [trimStart "  hi  ", trimEnd "  hi  ", dashed] ["hi  ", "  hi", "a-b-c"],
        structuralEquals [take cleaned 5, take "hello" 3, drop "hello" 3, reverse "abc"] ["get /", "hel", "lo", "cba"],
        startsWith cleaned "get "
    ]
    checkAll "fallible string values and collection results" [
        structuralEquals [(indexOf source "?" ?: ((0 - 1) )), (parseInt "123" ?: 0)] [16, 123],
        structuralEquals [listLength (lines "a\nb\nc"), listLength (words "  hello   world  "), splitCount] [3, 2, 3],
        (substring "hello world" 6 11 ?: "missing") == "world",
        (replace "a-b-c-d" "-" "/" ?: "missing") == "a/b/c/d",
        structuralEquals [("42" |> padStart 5 "0" ?: "missing"), ("42" |> padEnd 5 "0" ?: "missing")] ["00042", "42000"],
        (repeat "ab" 4 ?: "missing") == "abababab",
        (parseFloat "3.14" ?: 0.0) == 3.14,
        rejected (split "anything" ""),
        rejected (parseInt "oops"),
        rejected (indexOf "hello" "xyz")
    ]
    checkAll "HTTP routing branches" [
        structuralEquals (mapList ["/health", "/api/users/42"] (\k => route ("GET", k))) ["200 ok", "200 user-detail 42"],
        structuralEquals [route ("GET", "/api/orders"), route ("GET", "/random")] ["200 api-fallback", "404 not-found"],
        route ("DELETE", "/anything") == "405 method-not-allowed",
        structuralEquals (mapList ["/api/users", "/other"] (\k => route ("POST", k))) ["201 created", "404 not-found"]
    ]
test "string pipeline preserves transformations and routing" stringPipelineCase
