// [STRING-INTERPOLATION] also covers escapes and embedded expression rendering.
// Edge-case verification for the string builtins: every error path and
// boundary documented in spec/0012-Built-InFunctions.md. The integration
// test runner compares the full stdout to the expected output verbatim, so
// any regression in a builtin's behaviour causes an exact-mismatch failure.
// Builtins exercised: [BUILTIN-STRING-ISEMPTY], [BUILTIN-STRING-STARTSWITH],
// [BUILTIN-STRING-ENDSWITH], [BUILTIN-STRING-TAKE], [BUILTIN-STRING-DROP],
// [BUILTIN-STRING-TRIM], [BUILTIN-STRING-SUBSTRING],
// [BUILTIN-STRING-INDEXOF], [BUILTIN-STRING-REPLACE],
// [BUILTIN-STRING-REPEAT], [BUILTIN-STRING-PADSTART],
// [BUILTIN-STRING-PADEND], [BUILTIN-STRING-PARSEINT],
// [BUILTIN-STRING-PARSEFLOAT], plus the O(1) cursor [BUILTIN-STRING-CURSOR]
// — [BUILTIN-STRING-BYTELENGTH], [BUILTIN-STRING-BYTEAT],
// [BUILTIN-STRING-CODEPOINTAT], [BUILTIN-STRING-CODEPOINTWIDTH],
// [BUILTIN-STRING-FROMCODEPOINT].
// Failure payloads are threaded through Result<T, E> per [ERR-PAYLOAD].

/// A user-declared fallible function: its Error message must reach the arm.
fn failWith(reason) -> Result<int, string> = Error { message: reason }

/// Prints `label` and `value` joined by `=` on one line.
fn printValue(label, value) = print("${label}=${value}\n")

/// Prints `label=` followed by `value` inside literal double quotes.
fn printQuoted(label, value) = print("${label}=\"${value}\"\n")

/// Prints `label FAILED: message`.
fn printFailed(label, message) = print("${label} FAILED: ${message}\n")

/// Prints `outcome`'s `Success` value quoted when `quoted`, bare otherwise,
/// or FAILED with its message.
fn printOutcomeLike(label, outcome, quoted) = match outcome {
    Success { value } => match quoted {
        true => printQuoted(label, value)
        false => printValue(label, value)
    }
    Error { message } => printFailed(label, message)
}

/// Prints the `Success` value of `outcome` bare, or FAILED with its message.
fn printOutcome(label, outcome) = printOutcomeLike(label, outcome, false)

/// Prints the `Success` value of `outcome` quoted, or FAILED with its message.
fn printOutcomeQuoted(label, outcome) = printOutcomeLike(label, outcome, true)

/// Prints that `outcome` succeeding was unexpected.
fn printUnexpected(label) = print("${label} unexpected\n")

/// Prints that `outcome` succeeding was unexpected, or its rejection message.
fn printRejection(label, outcome) = match outcome {
    Success => printUnexpected(label)
    Error { message } => printValue(label, message)
}

/// Prints that `outcome` succeeding was unexpected, or that it was rejected.
fn printRejected(label, outcome) = match outcome {
    Success => printUnexpected(label)
    Error => print("${label} rejected\n")
}

/// Prints one labelled clamping cut of "hi": `take` keeps the front bytes,
/// `drop` skips them.
fn printClamp(c) = match c.front {
    true => printQuoted(c.label, take("hi", c.at))
    false => printQuoted(c.label, drop("hi", c.at))
}

/// Prints one labelled `substring("hi", c.from, c.to)` boundary: the quoted
/// success when `c.ok` holds, its rejection otherwise.
fn printBoundary(c) = {
    let edge = substring("hi", c.from, c.to)
    match c.ok {
        true => printOutcomeQuoted(c.label, edge)
        false => printRejected(c.label, edge)
    }
}

/// The cursor reading `row` names: its probe builtin applied to "héllo" at
/// `i` (the width probes take the code point alone).
fn cursorReading(row) = match row.probe {
    "byteAt" => byteAt("héllo", row.i)
    "codePointAt" => codePointAt("héllo", row.i)
    _ => codePointWidth(row.i)
}

/// Prints one labelled cursor reading: the value when `ok` holds, the
/// rejection message otherwise.
fn printCursorReading(row) = {
    let reading = cursorReading(row)
    match row.ok {
        true => printOutcome(row.label, reading)
        false => printRejection(row.label, reading)
    }
}

/// True when every condition listed in `wanted` holds.
fn allHold(wanted) = match wanted {
    [] => true
    [head, ...tail] => head && allHold(tail)
}

/// True when `outcome` is an `Error` whose message is exactly `wanted`.
fn rejectsWith(outcome, wanted) = match outcome {
    Success => false
    Error { message } => message == wanted
}

/// True when `outcome` is an `Error` carrying a non-empty message.
fn rejectedNonEmpty(outcome) = !rejectsWith(outcome, "")

/// `s` is a single byte whose value is exactly `byte` ([BUILTIN-STRING-CURSOR]).
fn singleByte(s, byte) = structuralEquals([length(s) == 1, (byteAt(s, 0) ?: 0) == byte], [true, true])

/// `indexOf(s, needle)` succeeds with byte index `wanted` ([BUILTIN-STRING-INDEXOF]).
fn indexOfIs(s, needle, wanted) = (indexOf(s, needle) ?: (0 - 1)) == wanted

/// `outcome` succeeds with exactly `wanted` ([BUILTIN-STRING-SUBSTRING],
/// [BUILTIN-STRING-REPLACE], [BUILTIN-STRING-REPEAT], [BUILTIN-STRING-PADSTART],
/// [BUILTIN-STRING-PADEND]).
fn succeedsWith(outcome, wanted) = (outcome ?: "missing") == wanted

/// `take(s, n)` and `drop(s, n)` reassemble `s` exactly at the cut `n`.
fn partitionsAt(s, n) = take(s, n) + drop(s, n) == s

/// The hole for `v`, `toString(v)` and their agreement all render `text`, and
/// `toString(v)` and the hole render identically ([BUILTIN-TOSTRING]).
fn holeRenders(v, text) =
    structuralEquals(["${v}" == text, toString(v) == text, "${v}" == toString(v)], [true, true, true])

/// `toString(v)` and the interpolation hole for `v` render identically.
fn holeIsToString(v) = toString(v) == "${v}"

/// True when `split(text, sep)` produced exactly `wanted` parts
/// ([BUILTIN-STRING-SPLIT]); a rejected split matches no count.
fn splitPartsAre(text, sep, wanted) = match split(text, sep) {
    Success { value } => listLength(value) == wanted
    Error => false
}

/// `toUpperCase(s)` folds to `upper` and `toLowerCase(s)` folds to `lower`.
fn foldsTo(s, upper, lower) = allHold([toUpperCase(s) == upper, toLowerCase(s) == lower])

/// The bytes of `s` from `first` onwards are exactly `wanted` ([BUILTIN-STRING-BYTEAT]).
fn bytesAreFrom(s, first, wanted) = match wanted {
    [] => true
    [head, ...tail] => (byteAt(s, first) ?: (0 - 1)) == head && bytesAreFrom(s, (first + 1), tail)
}

/// The bytes of `s` from byte 0 onwards are exactly `wanted`.
fn bytesAre(s, wanted) = bytesAreFrom(s, 0, wanted)

/// Every needle of `held` satisfies `found`, and no needle of `absent` does.
fn needlesHold(found, held, absent) = allHold(mapList(held, found)) && allHold(mapList(absent, fn(needle) => !found(needle)))

  // ---- isEmpty edges ----
  printValue("empty-emp", "" |> isEmpty)
  printValue("empty-x", "x" |> isEmpty)

  // ---- startsWith / endsWith with empty needle ----
  printValue("starts-empty", "abc" |> startsWith(""))
  printValue("ends-empty", "abc" |> endsWith(""))
  // suffix/prefix longer than s
  printValue("starts-long", "hi" |> startsWith("hello"))
  printValue("ends-long", "hi" |> endsWith("hello"))

  // ---- take / drop clamping ----

  let negFive = (0 - 5)
  forEachList(
      [{ label: "take-neg", at: negFive, front: true }, { label: "take-big", at: 99, front: true },
       { label: "drop-neg", at: negFive, front: false }, { label: "drop-big", at: 99, front: false }],
      printClamp)

  // ---- trim on all-whitespace ----
  printQuoted("trim-allws", "   " |> trim)
  printQuoted("trim-empty", "" |> trim)

  // ---- substring boundaries ----
  forEachList(
      [{ label: "sub-empty", from: 0, to: 0, ok: true },
       { label: "sub-full", from: 0, to: 2, ok: true },
       { label: "sub-neg", from: (0 - 1), to: 2, ok: false },
       { label: "sub-over", from: 0, to: 99, ok: false },
       { label: "sub-inverted", from: 2, to: 0, ok: false }],
      printBoundary)

  // ---- indexOf empty needle and not-found ----
  printOutcome("idx-empty", indexOf("hello", ""))
  printRejected("idx-missing", indexOf("hello", "xyz"))

  // ---- replace empty needle rejected ----
  printRejected("rep-empty", replace("hello", "", "x"))
  // replace shrinking
  printOutcomeQuoted("rep-shrink", replace("hello", "l", ""))

  // ---- repeat n=0 and n<0 ----
  printOutcomeQuoted("rep0", repeat("ab", 0))
  printRejected("rep-neg", repeat("ab", (0 - 1) ))

  // ---- padStart / padEnd empty fill rejected ----
  printRejected("padS-empty", padStart("hi", 5, ""))
  printRejected("padE-empty", padEnd("hi", 5, ""))
  // target <= len → no padding
  printOutcomeQuoted("padS-noop", padStart("hi", 1, "x"))
  // multi-char fill cycles
  printOutcomeQuoted("padS-multi", padStart("42", 5, "ab"))

  // ---- parseFloat rejects junk ----
  forEachList(
      [{ label: "pf-empty", junk: "" }, { label: "pf-trailing", junk: "3.14x" }, { label: "pf-space", junk: " 3.14" },
       { label: "pf-nan", junk: "nan" }, { label: "pf-hex", junk: "0x1p2" }, { label: "pf-infinite", junk: "1e9999" }],
      fn(j) => printRejected(j.label, parseFloat(j.junk)))

  // ---- parseInt overflow ----
  printRejected("pi-overflow", parseInt("99999999999999999999"))
  printOutcome("pi-min", parseInt("-9223372036854775808"))
  printRejected("pi-leading-space", parseInt(" 42"))

  // ---- O(1) byte / codepoint cursor [BUILTIN-STRING-CURSOR] ----
  // "héllo": é is U+00E9 (bytes 0xC3 0xA9), so byteLength is 6, not 5.
  printValue("byteLen", byteLength("héllo"))
  forEachList(
      [{ label: "byteAt1", probe: "byteAt", i: 1, ok: true },
       { label: "byteAt-oob", probe: "byteAt", i: 99, ok: false },
       { label: "cpAt1", probe: "codePointAt", i: 1, ok: true },
       { label: "cpAt-mid", probe: "codePointAt", i: 2, ok: false },
       { label: "cpWidth", probe: "codePointWidth", i: 128512, ok: true },
       { label: "cpWidth-surrogate", probe: "codePointWidth", i: 55296, ok: false }],
      printCursorReading)
  printOutcome("fromCp", fromCodePoint(128512))
  printRejection("fromCp-bad", fromCodePoint(2000000))
  // U+0000 is a scalar, but cannot inhabit the runtime's NUL-terminated
  // [BUILTIN-STRING-FROMCODEPOINT] representation.
  printRejection("fromCp-nul", fromCodePoint(0))
  // Round-trip: encode U+00E9 then decode byte 0 back to the same scalar.
  match fromCodePoint(233) {
    Success { value } => printOutcome("roundtrip", codePointAt(value, 0))
    Error { message } => print("roundtrip FAILED: ${message}\n")
  }

  // ---- real error payloads reach the Error arm ([ERR-PAYLOAD]) ----
  printRejection("pi-msg", parseInt("oops"))
exactArithmetic(fn() => printRejection("div-msg", divideResult(10, 0)))
  printRejection("user-msg", failWith("custom boom"))

  print("=== Edge Cases Complete ===\n")

/// Re-evaluates successful boundaries, rejected inputs, cursor values, and payloads.
fn stringEdgeCase() = {
    let negativeOne = (0 - 1) 
    let roundTrip = match fromCodePoint(233) {
        Success { value } => (codePointAt(value, 0) ?: 0) == 233
        Error => false
    }
    let customPayload = rejectsWith(failWith("custom boom"), "custom boom")

    checkAll("total string boundary values", [
        isEmpty(""),
        !isEmpty("x"),
        startsWith("abc", ""),
        endsWith("abc", ""),
        !startsWith("hi", "hello"),
        !endsWith("hi", "hello"),
        take("hi", (0 - 5) ) == "",
        take("hi", 99) == "hi",
        drop("hi", (0 - 5) ) == "hi",
        drop("hi", 99) == "",
        trim("   ") == "",
        trim("") == "",
        succeedsWith(substring("hi", 0, 0), ""),
        succeedsWith(substring("hi", 0, 2), "hi"),
        indexOfIs("hello", "", 0),
        succeedsWith(replace("hello", "l", ""), "heo"),
        succeedsWith(repeat("ab", 0), ""),
        succeedsWith(padStart("hi", 1, "x"), "hi"),
        succeedsWith(padStart("42", 5, "ab"), "aba42")
    ])
    checkAll("rejected string inputs", [
        rejectedNonEmpty(substring("hi", negativeOne, 2)),
        rejectedNonEmpty(substring("hi", 0, 99)),
        rejectedNonEmpty(substring("hi", 2, 0)),
        rejectedNonEmpty(indexOf("hello", "xyz")),
        rejectedNonEmpty(parseInt(" 42")),
        rejectedNonEmpty(replace("hello", "", "x")),
        rejectedNonEmpty(repeat("ab", negativeOne)),
        rejectedNonEmpty(padStart("hi", 5, "")),
        rejectedNonEmpty(padEnd("hi", 5, "")),
        allHold(mapList(["", "3.14x", " 3.14", "nan", "0x1p2", "1e9999"], fn(junk) => rejectedNonEmpty(parseFloat(junk)))),
        rejectedNonEmpty(parseInt("99999999999999999999"))
    ])
    checkAll("cursor values and error payloads", [
        byteLength("héllo") == 6,
        (byteAt("héllo", 1) ?: 0) == 195,
        rejectedNonEmpty(byteAt("héllo", 99)),
        (codePointAt("héllo", 1) ?: 0) == 233,
        rejectedNonEmpty(codePointAt("héllo", 2)),
        (codePointWidth(128512) ?: 0) == 4,
        rejectedNonEmpty(codePointWidth(55296)),
        (fromCodePoint(128512) ?: "missing") == "😀",
        rejectedNonEmpty(fromCodePoint(2000000)),
        rejectedNonEmpty(fromCodePoint(0)),
        roundTrip,
        (parseInt("-9223372036854775808") ?: 0) == (((0 - 9223372036854775807) - 1) ),
        customPayload,
        rejectedNonEmpty(divideResult(10, 0))
    ])
}

test("string edge cases preserve values and error payloads", exactly(stringEdgeCase))

/// [STRING-INTERPOLATION] Rendering: "Integers, floats, and booleans use their
/// normal scalar rendering"; [BUILTIN-TOSTRING] "Uses the same accepted types and
/// formatting as `print`, without writing output." Every hole is compared to the
/// exact text the spec pins AND to `toString` of the same value, so the two
/// lowerings cannot silently drift apart.
fn interpolationScalarCase() = {
    let negativeSeven = (0 - 7) 
    let intMax = 9223372036854775807
    let intMin = ((0 - 9223372036854775807) - 1) 
    let emptyText = ""
    let spaceText = " "

    // Integers: no thousands separator, no sign for a positive, an explicit
    // "-" for a negative, and the two 64-bit extremes spelled in full.
    checkAll("integers render identically in a hole and in toString", [
        holeRenders(0, "0"),
        "${1}" == "1",
        holeRenders(42, "42"),
        holeRenders(negativeSeven, "-7"),
        length("${0}") == 1,
        holeRenders(intMax, "9223372036854775807"),
        length("${negativeSeven}") == 2,
        holeRenders(intMin, "-9223372036854775808"),
        length("${intMin}") == 20,
        "${0}" != "0.0",
        "${1}" != "true"
    ])

    // Floats keep a visible fractional part so a whole-valued float never
    // renders as an int; [BUILTIN-CONVERT-FLOAT] pins toFloat(7) == 7.0 and
    // toFloat(-3) == -3.0. Float + - * are plain, not Result ([ARITH-CHECKED]).
    checkAll("floats and booleans render with their scalar spelling", [
        holeRenders(0.0, "0.0"),
        "${1.5}" == "1.5",
        holeRenders(3.5, "3.5"),
        "${2.0}" == "2.0",
        "${100000.0}" == "100000.0",
        "${0.0 - 0.25}" == "-0.25",
        "${1.5 + 2.5}" == "4.0",
        "${1.5 * 2.0}" == "3.0",
        "${2.0}" == toString(2.0),
        "${toFloat(7)}" == "7.0",
        "${toFloat(0)}" == "0.0",
        "${toFloat(negativeSeven)}" == "-7.0",
        holeRenders(true, "true"),
        holeRenders(false, "false"),
        "${1 == 1}" == "true",
        "${1 != 1}" == "false",
        "${!(1 == 2)}" == "true",
        "${2.0}" != "2",
        "${true}" != "1"
    ])

    // "Strings are inserted unchanged" — no quoting, no escaping, no trimming.
    checkAll("strings are inserted into a hole unchanged", [
        "${emptyText}" == "",
        "${spaceText}" == " ",
        "${"x"}" == "x",
        "${"a b"}" == "a b",
        "${"  padded  "}" == "  padded  ",
        holeRenders("abc", "abc"),
        length("${emptyText}") == 0,
        length("${spaceText}") == 1,
        length("${"  padded  "}") == 10,
        isEmpty("${emptyText}"),
        !isEmpty("${spaceText}"),
        "a${emptyText}b" == "ab",
        "${emptyText}${emptyText}" == "",
        "[${spaceText}]" == "[ ]",
        "${toString(42)}" == "42",
        "${toUpperCase("ab")}" == "AB",
        "${"ab" |> toUpperCase}" == "AB",
        "${length("abc")}" == "3"
    ])
}

/// [STRING-INTERPOLATION]: "A `Result` is never unwrapped at an interpolation
/// hole. It renders as the complete `Success(value)` or `Error(message)` value,
/// preserving its failure channel exactly as `toString` does." [BUILTIN-PRINT]
/// accepts `Result<T, E>` only "when both payloads are printable", so every
/// Result below carries an int, float or string payload.
fn interpolationResultCase() = {
    let negativeOne = (0 - 1) 
    let negativeFive = (0 - 5) 

    checkAll("Results retain their wrapper and arithmetic stays plain", [
        allHold(["${parseInt("42")}" == "Success(42)", "${parseInt("0")}" == "Success(0)", "${parseInt("-9223372036854775808")}" == "Success(-9223372036854775808)"]),
        allHold(["${parseFloat("3.5")}" == "Success(3.5)", "${parseFloat("2")}" == "Success(2.0)", "${parseFloat("1e3")}" == "Success(1000.0)", "${parseFloat("-0.5")}" == "Success(-0.5)"]),
        allHold(["${intDiv(7, 2)}" == "3", "${intDiv(255643, 10)}" == "25564", "${10 / 4}" == "2.5", "${abs(negativeFive)}" == "5"]),
        allHold(["${fromCodePoint(65)}" == "Success(A)", "${indexOf("banana", "na")}" == "Success(2)", "${substring("banana", 1, 4)}" == "Success(ana)", "${repeat("ab", 2)}" == "Success(abab)", "${padStart("7", 3, "0")}" == "Success(007)", "${byteAt("A", 0)}" == "Success(65)", "${codePointWidth(233)}" == "Success(2)"])
    ])

    // Every message here is the reason the runtime actually produces; a
    // placeholder reason would break the byte-for-byte comparison ([ERR-PAYLOAD]).
    checkAll("a failed Result renders as Error(message) and keeps its reason", [
        allHold(["${parseInt("oops")}" == "Error(parseInt: invalid integer)", "${parseInt(" 42")}" == "Error(parseInt: invalid integer)"]),
        allHold(["${parseFloat("nan")}" == "Error(parseFloat: invalid number)", "${parseFloat("")}" == "Error(parseFloat: invalid number)"]),
        allHold(["${divideResult(5, 0)}" == "Error(division by zero)", "${divideResult(10, 0)}" == "Error(division by zero)", "${indexOf("hello", "zz")}" == "Error(indexOf: substring not found)", "${replace("h", "", "")}" == "Error(replace: needle must not be empty)", "${repeat("a", negativeOne)}" == "Error(repeat: count must not be negative)", "${padStart("x", 5, "")}" == "Error(padStart: fill must not be empty)", "${padEnd("x", 5, "")}" == "Error(padEnd: fill must not be empty)"]),
        allHold(["${substring("hi", 0, 99)}" == "Error(substring: index out of range)", "${byteAt("a", 9)}" == "Error(byteAt: index out of range)", "${codePointAt("é", 1)}" == "Error(codePointAt: invalid UTF-8 lead byte)", "${codePointWidth(55296)}" == "Error(codePointWidth: surrogate is not a scalar)", "${codePointWidth(1114112)}" == "Error(codePointWidth: code point out of range)", "${fromCodePoint(0)}" == "Error(fromCodePoint: invalid code point)", "${failWith("custom boom")}" == "Error(custom boom)"])
    ])

    // Plain "2" is one byte; "Error(division by zero)" is 6 + 16 + 1 = 23.
    checkAll("toString and a hole agree on every Result", [
        allHold([holeIsToString(parseInt("42")), holeIsToString(parseInt("oops")), holeIsToString(divideResult(10, 0)), holeIsToString(intDiv(7, 2)), holeIsToString(fromCodePoint(65)), holeIsToString(failWith("custom boom"))]),
        "value=${intDiv(10, 5)}" == "value=2",
        "a${divideResult(5, 0)}b" == "aError(division by zero)b",
        "${intDiv(7, 2)}${intDiv(7, 2)}" == "33",
        length("${intDiv(10, 5)}") == 1,
        length("${divideResult(10, 0)}") == 23,
        startsWith("${parseInt("42")}", "Success("),
        endsWith("${parseInt("42")}", ")"),
        !contains("${parseInt("42")}", "Error"),
        startsWith("${parseInt("oops")}", "Error("),
        contains("${parseInt("oops")}", "invalid integer"),
        !contains("${parseInt("oops")}", "Success"),
        (indexOf("${parseInt("oops")}", "(") ?: negativeOne) == 5,
        (indexOf("${intDiv(10, 5)}", "(") ?: negativeOne) == negativeOne
    ])
}

/// [LEX-STRING-LITERAL] literals: "Shared unescaping recognizes `\n`, `\r`, `\t`,
/// `\e`, `\0`, `\"`, and `\\`; an unknown escape is preserved verbatim."
/// [STRING-INTERPOLATION] Escapes repeats the rule. `\0` is deliberately absent:
/// the runtime string is a NUL-terminated `char*` ([BUILTIN-STRING-CURSOR]), so
/// an embedded NUL has no observable length and the spec does not define one.
fn escapeSequenceCase() = {

    // ASCII: LF 10, CR 13, TAB 9, ESC 27, '"' 34, '\' 92, 'a' 97, 'b' 98.
    checkAll("each recognised escape collapses to exactly one byte", [
        singleByte("\n", 10),
        singleByte("\r", 13),
        singleByte("\t", 9),
        singleByte("\e", 27),
        singleByte("\"", 34),
        singleByte("\\", 92),
        byteLength("\n\r\t\e") == 4,
        bytesAre("\n\r\t\e", [10, 13, 9, 27]),
        length("a\nb") == 3,
        bytesAre("a\nb", [97, 10, 98]),
        "\n" != "n",
        "\\n" != "\n",
        length("\\n") == 2,
        length("a\"b") == 3,
        bytesAreFrom("a\"b", 1, [34])
    ])

    // An unrecognised escape keeps BOTH bytes: 'q' is 113, 'd' is 100, 'x' 120.
    checkAll("an unknown escape keeps its backslash verbatim", [
        length("\q") == 2,
        bytesAre("\q", [92, 113]),
        "\q" == "\\q",
        length("\d") == 2,
        bytesAreFrom("\d", 1, [100]),
        length("\s\q") == 4,
        contains("\q", "\\"),
        startsWith("\q", "\\"),
        endsWith("\q", "q"),
        !contains("\q", "\t"),
        !isEmpty("\q"),
        toUpperCase("\q") == "\Q",
        toLowerCase("\Q") == "\q",
        reverse("\q") == "q\\",
        length("path\to") == 6,
        bytesAreFrom("path\to", 4, [9]),
        length("path\xo") == 7,
        bytesAreFrom("path\xo", 4, [92, 120])
    ])

    // ASCII whitespace for trim/words is space, TAB, LF, CR, VT and FF; ESC is
    // NOT whitespace ([BUILTIN-STRING-TRIM], [BUILTIN-STRING-WORDS]).
    // "A trailing newline does not produce an empty final element" ([BUILTIN-STRING-LINES]).
    checkAll("escaped whitespace drives trim, words, lines and split", [
        trim("\n\t hi \r\n") == "hi",
        trimStart("\n\thi") == "hi",
        trimEnd("hi\t\n") == "hi",
        trim("\t\r\n ") == "",
        trim("\e") == "\e",
        length(trim("\e hi ")) == 4,
        answersHold(fn(x) => listLength(lines(x)), ["a\nb\nc", "a\n", "a\n\nb", "solo"], [3, 1, 3, 1]),
        answersHold(fn(x) => listLength(words(x)), ["a\tb\nc", "   ", "", " a ", "a\r\nb"], [3, 0, 0, 1, 2]),
        structuralEquals([lines("a\nb"), words("a\tb")], [["a", "b"], ["a", "b"]]),
        join(lines("a\nb\nc"), "-") == "a-b-c",
        join(words("  x  y  "), "+") == "x+y",
        splitPartsAre("a\tb", "\t", 2),
        contains("a\nb", "\n"),
        !contains("ab", "\n"),
        startsWith("\tx", "\t"),
        endsWith("x\n", "\n")
    ])
}

/// [BUILTIN-STRING-CONTAINS]: "True if `needle` occurs anywhere in `s`. An empty
/// `needle` returns `true`." [BUILTIN-STRING-INDEXOF]: "Returns the byte index of
/// the FIRST occurrence of `needle`" and an empty needle returns
/// `Success { value: 0 }`. "banana" repeats both "a" and "na", so a scan that
/// reports the last match instead of the first cannot pass.
fn substringPositionCase() = {
    let subject = "banana"
    let missing = (0 - 1) 
    let indexAbsent = rejectsWith(indexOf(subject, "xyz"), "indexOf: substring not found")
    let indexEmptySubject = rejectedNonEmpty(indexOf("", "a"))

    // "banana" byte layout: b0 a1 n2 a3 n4 a5, length 6.
    checkAll("contains finds a needle at the start, middle, end and nowhere", [
        needlesHold(fn(needle) => contains(subject, needle), ["ban", "nan", "ana", "banana", "b", "a", "n", ""], ["bananas", "xyz", "BAN", "bn", " "]),
        contains("", ""),
        !contains("", "a"),
        contains("a", "a"),
        !contains("a", "aa"),
        contains("a b", " "),
        contains(toLowerCase("BANANA"), "banana"),
        length(subject) == 6
    ])

    checkAll("startsWith and endsWith agree with contains at both ends", [
        needlesHold(fn(prefix) => startsWith(subject, prefix), ["", "b", "ba", "banana"], ["banana!", "anana", "B"]),
        needlesHold(fn(suffix) => endsWith(subject, suffix), ["", "a", "na", "ana", "banana"], ["!banana", "banan", "A"]),
        startsWith("", ""),
        !startsWith("", "a"),
        endsWith("", ""),
        !endsWith("", "a"),
        startsWith("a", "a"),
        endsWith("a", "a"),
        needlesHold(fn(needle) => contains(subject, needle), ["ba", "na"], [])
    ])

    // The reported index must reconstruct the needle through substring/take/drop.
    checkAll("indexOf returns the first occurrence as a byte index", [
        answersHold(fn(needle) => indexOf(subject, needle) ?: (0 - 1),
            ["b", "a", "n", "na", "ana", "banana", ""], [0, 1, 2, 2, 1, 0, 0]),
        indexOfIs("", "", 0),
        indexOfIs("a", "a", 0),
        indexAbsent,
        indexEmptySubject,
        structuralEquals([substring(subject, 1, 4) ?: "missing", substring(subject, 2, 4) ?: "missing", substring(subject, 0, 6) ?: "missing", substring(subject, 6, 6) ?: "missing", substring(subject, 3, 3) ?: "missing"], ["ana", "na", subject, "", ""]),
        answersHold(fn(cut) => cut(subject, indexOf(subject, "na") ?: missing), [fn(s, n) => take(s, n), fn(s, n) => drop(s, n)], ["ba", "nana"]),
        startsWith(drop(subject, (indexOf(subject, "ana") ?: missing)), "ana"),
        indexOfIs(toUpperCase(subject), "NA", 2)
    ])
}

/// [BUILTIN-STRING-TOUPPERCASE] / [BUILTIN-STRING-TOLOWERCASE]: "ASCII case
/// conversion. Other bytes are copied unchanged." "é" is U+00E9 (bytes 0xC3 0xA9 =
/// 195 169) and "É" is U+00C9 (0xC3 0x89), so neither conversion may touch them —
/// a locale-sensitive implementation would corrupt these.
fn caseFoldingCase() = {
    let mixed = "MiXeD 123!"
    let accented = "héllo"

    checkAll("ASCII letters fold and every other byte is copied unchanged", [
        foldsTo("", "", ""),
        toUpperCase("a") == "A",
        toLowerCase("A") == "a",
        foldsTo(mixed, "MIXED 123!", "mixed 123!"),
        foldsTo("0123456789", "0123456789", "0123456789"),
        foldsTo("!@#%^&*()", "!@#%^&*()", "!@#%^&*()"),
        toUpperCase(" \t\n") == " \t\n",
        toUpperCase("\e") == "\e",
        toUpperCase(accented) == "HéLLO",
        toLowerCase("HÉLLO") == "hÉllo",
        length(toUpperCase(accented)) == 6,
        byteLength(toLowerCase(accented)) == 6,
        bytesAre(toUpperCase(accented), [72, 195, 169, 76])
    ])

    // Idempotent, length preserving, and a lower/upper round trip that survives
    // the non-ASCII bytes it must not touch.
    checkAll("case conversion is idempotent, length preserving and round trips", [
        toUpperCase(toUpperCase(mixed)) == toUpperCase(mixed),
        toLowerCase(toLowerCase(mixed)) == toLowerCase(mixed),
        structuralEquals([toLowerCase(toUpperCase("Hello")), toUpperCase(toLowerCase("Hello"))], ["hello", "HELLO"]),
        toLowerCase(toUpperCase(accented)) == accented,
        toUpperCase(toLowerCase(accented)) == "HéLLO",
        toUpperCase(toLowerCase(mixed)) == toUpperCase(mixed),
        toUpperCase(toLowerCase(mixed)) != mixed,
        length(toUpperCase(mixed)) == length(mixed),
        length(toLowerCase(mixed)) == length(mixed),
        length(toUpperCase(accented)) == length(accented),
        toLowerCase("HeLLo") == toLowerCase("hEllO"),
        toUpperCase("HeLLo") == toUpperCase("hEllO"),
        toLowerCase("HeLLo") != "HeLLo",
        toUpperCase("abc") != "abc",
        toUpperCase("ABC") == "ABC",
        toLowerCase("abc") == "abc",
        reverse(toUpperCase("abc")) == toUpperCase(reverse("abc")),
        toUpperCase("a" + "b") == toUpperCase("a") + toUpperCase("b"),
        toLowerCase("A" + "B") == toLowerCase("A") + toLowerCase("B"),
        isEmpty(toUpperCase("")),
        isEmpty(toLowerCase(""))
    ])

    checkAll("case folding composes with the search and slicing builtins", [
        contains(toLowerCase("HELLO WORLD"), "world"),
        !contains("HELLO WORLD", "world"),
        startsWith(toLowerCase("GET /x"), "get "),
        !startsWith("GET /x", "get "),
        endsWith(toUpperCase("image.png"), ".PNG"),
        !endsWith("image.png", ".PNG"),
        indexOfIs(toUpperCase("banana"), "NA", 2),
        indexOfIs(toLowerCase("BANANA"), "na", 2),
        toUpperCase(take("hello", 3)) == take(toUpperCase("hello"), 3),
        toLowerCase(drop("HELLO", 3)) == drop(toLowerCase("HELLO"), 3),
        succeedsWith(replace(toLowerCase("A-B"), "-", "+"), "a+b"),
        succeedsWith(repeat(toUpperCase("ab"), 2), "ABAB"),
        succeedsWith(padStart(toUpperCase("z"), 3, "y"), "yyZ"),
        succeedsWith(padEnd(toLowerCase("Z"), 3, "y"), "zyy"),
        succeedsWith(substring(toUpperCase("banana"), 0, 3), "BAN"),
        allHold([trim(toUpperCase("  a  ")) == "A", toUpperCase(trim("  a  ")) == "A"]),
        join([toUpperCase("a"), toLowerCase("B")], "-") == "A-b",
        "${toUpperCase("ab")}" == "AB",
        "${toLowerCase("AB")}" == "ab"
    ])
}

/// [BUILTIN-STRING-CONCAT]: "The `+` operator on two `string` values returns
/// `string` directly. String concatenation cannot fail and is never
/// `Result`-wrapped." [BUILTIN-STRING-LENGTH] counts bytes and
/// [BUILTIN-STRING-BYTELENGTH] is "Equivalent to `length(s)`". Integer `+` IS
/// checked, so every length sum is discharged with `?:` ([ARITH-CHECKED]).
fn concatLengthCase() = {
    let left = "ab"
    let middle = "cde"
    let right = "f"
    let joined = left + middle + right
    let negativeFive = (0 - 5) 
    let noParts: List<string> = []

    checkAll("concatenation is associative with the empty string as identity", [
        (left + middle) + right == "abcdef",
        left + (middle + right) == "abcdef",
        (left + middle) + right == left + (middle + right),
        joined == "abcdef",
        left + "" == left,
        "" + left == left,
        "" + "" == "",
        left + right != right + left,
        "ab" + "ba" == "abba",
        "ba" + "ab" == "baab",
        left + middle == "${left}${middle}",
        joined == "${left}${middle}${right}",
        length(joined) == 6,
        byteLength(joined) == length(joined),
        length(left + middle) == ((length(left) + length(middle)) ),
        length(joined) == ((((length(left) + length(middle)) ) + length(right)) ),
        length("" + "") == 0,
        isEmpty("" + ""),
        !isEmpty(joined),
        startsWith(joined, left),
        endsWith(joined, right),
        contains(joined, middle)
    ])

    // take(s, n) + drop(s, n) == s must hold at, inside and outside both ends.
    checkAll("take and drop partition a string at every boundary", [
        answersHold(fn(n) => partitionsAt(joined, n), [0, 1, 3, 6, 7, negativeFive], [true, true, true, true, true, true]),
        structuralEquals(mapList([0, 6, 99, negativeFive], fn(n) => [take(joined, n), drop(joined, n)]), [["", joined], [joined, ""], [joined, ""], ["", joined]]),
        length(take(joined, 3)) == 3,
        length(drop(joined, 3)) == 3,
        ((length(take(joined, 2)) + length(drop(joined, 2))) ) == length(joined),
        take(joined, 3) == (substring(joined, 0, 3) ?: "missing"),
        drop(joined, 3) == (substring(joined, 3, 6) ?: "missing"),
        structuralEquals([substring(joined, 0, 0) ?: "missing", substring(joined, 6, 6) ?: "missing", substring(joined, 0, 6) ?: "missing"], ["", "", joined])
    ])

    // "ab--cd--ef" is 3 parts (6 bytes) plus 2 separators (4 bytes) = 10.
    checkAll("repeat, reverse, padding and join keep their length contracts", [
        succeedsWith(repeat(left, 0), ""),
        succeedsWith(repeat(left, 1), left),
        succeedsWith(repeat(left, 3), "ababab"),
        length(repeat(left, 5) ?: "") == 10,
        succeedsWith(repeat("", 5), ""),
        length(repeat("", 5) ?: "x") == 0,
        reverse("") == "",
        reverse("a") == "a",
        reverse(joined) == "fedcba",
        reverse(reverse(joined)) == joined,
        reverse(reverse("héllo")) == "héllo",
        length(reverse("héllo")) == 6,
        length(reverse(joined)) == length(joined),
        reverse(left + middle) == reverse(middle) + reverse(left),
        structuralEquals([padStart("7", 5, "0") ?: "", padEnd("7", 5, "0") ?: ""], ["00007", "70000"]),
        succeedsWith(padStart("7", 5, "0"), "00007"),
        succeedsWith(padEnd("7", 5, "0"), "70000"),
        succeedsWith(padStart("x", 6, "ab"), "ababax"),
        succeedsWith(padEnd("x", 6, "ab"), "xababa"),
        succeedsWith(padStart("hello", 3, "0"), "hello"),
        (padEnd("hello", 3, "0") ?: "missing") == "hello",
        join(["a", "b", "c"], "") == "abc",
        join(["a"], "-") == "a",
        join(["", ""], "-") == "-",
        join(noParts, "-") == "",
        length(join(["ab", "cd", "ef"], "--")) == 10
    ])
}

/// [STRING-INTERPOLATION]: "An interpolation expression may contain operators,
/// calls, field access, or a nested braced expression." The literal text either
/// side of a hole is preserved verbatim, and a `$` NOT followed by `{` introduces
/// nothing — [LEX-STRING-LITERAL] gives `${` alone as the interpolation opener.
fn interpolationCompositionCase() = {
    let name = "alice"
    let count = 3
    let xs = ["red", "green", "blue"]
    let prices = { "apple": 2, "banana": 5 }
    let step0 = ""
    let step1 = "${step0}${listGet(xs, 0) ?: "?"}|"
    let step2 = "${step1}${listGet(xs, 1) ?: "?"}|"
    let step3 = "${step2}${listGet(xs, 2) ?: "?"}|"
    let step4 = "${step3}${listGet(xs, 9) ?: "?"}|"

    checkAll("a hole may hold a call, a pipe, an operator or an index", [
        "${length("abc")}" == "3",
        "${toUpperCase(name)}" == "ALICE",
        "${name |> toUpperCase}" == "ALICE",
        "${name |> length}" == "5",
        "${toString(count)}" == "3",
        "${toUpperCase(toLowerCase("AbC"))}" == "ABC",
        "${take(name, 2)}" == "al",
        "${drop(name, 2)}" == "ice",
        "${reverse(name)}" == "ecila",
        "${count == 3}" == "true",
        "${count != 3}" == "false",
        "${!(count == 3)}" == "false",
        "${isEmpty("")}" == "true",
        "${contains(name, "lic")}" == "true",
        "${(count + 4) }" == "7",
        "${(count * 4) }" == "12",
        answersHold(fn(i) => "${listGet(xs, i) ?: "none"}", [0, 9], ["red", "none"]),
        "${xs[2] ?: "none"}" == "blue",
        "${prices["apple"] ?: 0}" == "2",
        "${prices["mango"] ?: 0}" == "0",
        "${listLength(xs)}" == "3"
    ])

    // "alice has 3" is 5 + 5 + 1 = 11 bytes; '$' is byte 36.
    checkAll("the literal text around every hole survives verbatim", [
        "${count}" == "3",
        "${count}x" == "3x",
        "x${count}" == "x3",
        "x${count}y" == "x3y",
        "${count}${count}" == "33",
        "${count}-${count}" == "3-3",
        "a${count}b${count}c" == "a3b3c",
        "no holes here" == "no holes here",
        length("${count}") == 1,
        length("x${count}y") == 3,
        "${name} has ${count}" == "alice has 3",
        length("${name} has ${count}") == 11,
        "$" == "$",
        length("$") == 1,
        (byteAt("$", 0) ?: 0) == 36,
        "$x" == "$x",
        length("$x") == 2,
        "a$b" == "a$b",
        contains("cost: $5", "$"),
        !contains("${name}", "$"),
        "${name}" + " has " + "${count}" == "alice has 3"
    ])

    // Grown one hole at a time. Every intermediate is asserted, so a lost
    // append cannot hide behind a correct final transcript.
    checkAll("a transcript built hole by hole records every intermediate", [
        step0 == "",
        step1 == "red|",
        step2 == "red|green|",
        step3 == "red|green|blue|",
        step4 == "red|green|blue|?|",
        answersHold(fn(s) => length(s), [step1, step2, step3, step4], [4, 10, 15, 17]),
        startsWith(step4, step3),
        startsWith(step3, step2),
        startsWith(step2, step1),
        !startsWith(step1, step2),
        endsWith(step4, "?|"),
        endsWith(step3, "blue|"),
        contains(step3, "green|"),
        !contains(step2, "blue"),
        step1 + "green|" == step2,
        step2 + "blue|" == step3,
        (indexOf(step3, "green") ?: 0) == 4,
        (indexOf(step3, "blue") ?: 0) == 10,
        splitPartsAre(step3, "|", 4),
        toUpperCase(step2) == "RED|GREEN|",
        reverse(step1) == "|der"
    ])
}

/// Byte counts move past a character they would split, and take and drop stay complementary.
fn utf8CutCase() = {
    let quote = "“ok”"
    let eagle = "🦅x"
    checkAll("utf-8 cuts", [
        length(quote) == 8,
        answersHold(fn(x) => take(quote, x), [1, 2, 3, 4], ["“", "“", "“", "“o"]),
        answersHold(fn(x) => drop(quote, x), [1, 3, 5, 6], ["ok”", "ok”", "”", ""]),
        take(eagle, 1) == "🦅",
        drop(eagle, 1) == "x",
        partitionsAt(quote, 2),
        partitionsAt(eagle, 3)
    ])
    checkAll("utf-8 substring bounds", [
        structuralEquals([substring(quote, 0, 3) ?: "missing", substring(quote, 3, 5) ?: "missing"], ["“", "ok"]),
        byteLength(substring(quote, 1, 3) ?: "") == 2,
        byteLength(substring(quote, 0, 1) ?: "") == 1
    ])
    let block = "first
  second ${length(quote)}
third"
    checkAll("a literal may span lines", [
        length(block) == 22,
        block == "first\n  second 8\nthird"
    ])
}

// Registration order fixes the TAP order in the shared golden.
exactTests([
    { name: "interpolation renders every printable scalar", work: interpolationScalarCase },
    { name: "a Result is never unwrapped at an interpolation hole", work: interpolationResultCase },
    { name: "escape sequences resolve to their exact bytes", work: escapeSequenceCase },
    { name: "search builtins scan every substring position", work: substringPositionCase },
    { name: "ASCII case folding is total and round-trips", work: caseFoldingCase },
    { name: "concatenation and length arithmetic hold", work: concatLengthCase },
    { name: "interpolation composes expressions and preserves text", work: interpolationCompositionCase },
    { name: "a byte count never splits a UTF-8 character", work: utf8CutCase }
])
