(** This Result API deliberately converts a recorded arithmetic fault at its boundary. *)
divideResult (a, b) =
    mut failed = false
    handle Arith
        divideByZero op _ =>
            expect op "/"
            failed := true
            0.0
    value = a / b
    match failed
        true => Error(message = "division by zero")
        false => Success(value = value)

// ML-flavor twin of string_edge_cases.osp. Layout `match` arms, whitespace
// application (`startsWith ""`), pipe chains, and a layout-block `main` body
// lower to the SAME canonical AST as the Default braces/parens form —
// byte-identical IR ([FLAVOR-IR-EQUIV]).
// Edge-case verification for the string builtins: every error path and
// boundary documented in spec/0012-Built-InFunctions.md. The integration
// test runner compares the full stdout to the expected output verbatim, so
// any regression in a builtin's behaviour causes an exact-mismatch failure.
// Builtins exercised: [BUILTIN-STRING-ISEMPTY], [BUILTIN-STRING-STARTSWITH],
// [BUILTIN-STRING-ENDSWITH], [BUILTIN-STRING-TAKE], [BUILTIN-STRING-DROP],
// [BUILTIN-STRING-TRIM], [BUILTIN-STRING-SUBSTRING],
// [BUILTIN-STRING-INDEXOF], [BUILTIN-STRING-REPLACE],
// [BUILTIN-STRING-REPEAT], [BUILTIN-STRING-PADSTART],
// [BUILTIN-STRING-PADEND], [BUILTIN-STRING-PARSEINT],
// [BUILTIN-STRING-PARSEFLOAT], plus the O(1) cursor [BUILTIN-STRING-CURSOR]
// — [BUILTIN-STRING-BYTELENGTH], [BUILTIN-STRING-BYTEAT],
// [BUILTIN-STRING-CODEPOINTAT], [BUILTIN-STRING-CODEPOINTWIDTH],
// [BUILTIN-STRING-FROMCODEPOINT].
// Failure payloads are threaded through Result<T, E> per [ERR-PAYLOAD].

(** A user-declared fallible function: its Error message must reach the arm. *)
failWith : string -> Result int string
failWith reason = Error(message = reason)

(** Print a successful `Result` as `<label>=<value>`; a failure is loud. *)
showValue (label, result) =
    match result
        Success value => print "${label}=${value}\n"
        Error _message => print "${label} FAILED\n"

(** Same, with the value quoted: `<label>="<value>"`. *)
showQuoted (label, result) =
    match result
        Success value => print "${label}=\"${value}\"\n"
        Error _message => print "${label} FAILED\n"

(** Print a rejected call as `<label> rejected`; a success is unexpected. *)
showRejected (label, result) =
    match result
        Success _value => print "${label} unexpected\n"
        Error _message => print "${label} rejected\n"

(** Print a Result's real Error reason; a success is unexpected. *)
showError (label, result) =
    match result
        Success _value => print "${label} unexpected\n"
        Error message => print "${label}=${message}\n"

(** Print a successful value, or the reason it failed. *)
showOrFail (label, result) =
    match result
        Success value => print "${label}=${value}\n"
        Error message => print "${label} FAILED: ${message}\n"

(** Whether a fallible call failed with a non-empty diagnostic. *)
rejected result =
    match result
        Success _value => false
        Error message => message != ""
// ---- isEmpty edges ----
print "empty-emp=${"" |> isEmpty}\n"
print "empty-x=${"x" |> isEmpty}\n"

// ---- startsWith / endsWith with empty needle ----
print "starts-empty=${"abc" |> startsWith("")}\n"
print "ends-empty=${"abc" |> endsWith("")}\n"
// suffix/prefix longer than s
print "starts-long=${"hi"  |> startsWith("hello")}\n"
print "ends-long=${"hi"    |> endsWith("hello")}\n"

// ---- take / drop clamping ----
print "take-neg=\"${"hi" |> take((0 - 5) )}\"\n"
print "take-big=\"${"hi" |> take(99)}\"\n"
print "drop-neg=\"${"hi" |> drop((0 - 5) )}\"\n"
print "drop-big=\"${"hi" |> drop(99)}\"\n"

// ---- trim on all-whitespace ----
print "trim-allws=\"${"   " |> trim}\"\n"
print "trim-empty=\"${"" |> trim}\"\n"

// ---- substring boundaries ----
showQuoted ("sub-empty", substring "hi" 0 0)
showQuoted ("sub-full", substring "hi" 0 2)
showRejected ("sub-neg", substring "hi" ((0 - 1) ) 2)
showRejected ("sub-over", substring "hi" 0 99)
showRejected ("sub-inverted", substring "hi" 2 0)

// ---- indexOf empty needle and not-found ----
showValue ("idx-empty", indexOf "hello" "")
showRejected ("idx-missing", indexOf "hello" "xyz")

// ---- replace empty needle rejected ----
showRejected ("rep-empty", replace "hello" "" "x")
// replace shrinking
showQuoted ("rep-shrink", replace "hello" "l" "")

// ---- repeat n=0 and n<0 ----
showQuoted ("rep0", repeat "ab" 0)
showRejected ("rep-neg", repeat "ab" ((0 - 1) ))

// ---- padStart / padEnd empty fill rejected ----
showRejected ("padS-empty", padStart "hi" 5 "")
showRejected ("padE-empty", padEnd "hi" 5 "")
// target <= len → no padding
showQuoted ("padS-noop", padStart "hi" 1 "x")
// multi-char fill cycles
showQuoted ("padS-multi", padStart "42" 5 "ab")

// ---- parseFloat rejects junk ----
showRejected ("pf-empty", parseFloat "")
showRejected ("pf-trailing", parseFloat "3.14x")
showRejected ("pf-space", parseFloat " 3.14")
showRejected ("pf-nan", parseFloat "nan")
showRejected ("pf-hex", parseFloat "0x1p2")
showRejected ("pf-infinite", parseFloat "1e9999")

// ---- parseInt overflow ----
showRejected ("pi-overflow", parseInt "99999999999999999999")
showValue ("pi-min", parseInt "-9223372036854775808")
showRejected ("pi-leading-space", parseInt " 42")

// ---- O(1) byte / codepoint cursor [BUILTIN-STRING-CURSOR] ----
// "héllo": é is U+00E9 (bytes 0xC3 0xA9), so byteLength is 6, not 5.
print "byteLen=${byteLength("héllo")}\n"
showOrFail ("byteAt1", byteAt "héllo" 1)
showError ("byteAt-oob", byteAt "héllo" 99)
showOrFail ("cpAt1", codePointAt "héllo" 1)
showError ("cpAt-mid", codePointAt "héllo" 2)
showOrFail ("cpWidth", codePointWidth 128512)
showError ("cpWidth-surrogate", codePointWidth 55296)
showOrFail ("fromCp", fromCodePoint 128512)
showError ("fromCp-bad", fromCodePoint 2000000)
// U+0000 is a scalar, but cannot inhabit the runtime's NUL-terminated
// [BUILTIN-STRING-FROMCODEPOINT] representation.
showError ("fromCp-nul", fromCodePoint 0)
// Round-trip: encode U+00E9 then decode byte 0 back to the same scalar.
match fromCodePoint 233
    Success value   =>
        match codePointAt value 0
            Success value   => print "roundtrip=${value}\n"
            Error   message => print "roundtrip FAILED: ${message}\n"
    Error   message => print "roundtrip FAILED: ${message}\n"

// ---- real error payloads reach the Error arm ([ERR-PAYLOAD]) ----
showError ("pi-msg", parseInt "oops")
exactArithmetic (\() => showError ("div-msg", divideResult (10, 0)))
showError ("user-msg", failWith "custom boom")

print "=== Edge Cases Complete ===\n"

(** Re-evaluate successful boundaries, rejected inputs, cursor values, and payloads. *)
stringEdgeCase () =
    negativeOne = (0 - 1) 
    substringNegative = rejected (substring "hi" negativeOne 2)
    substringOverrun = rejected (substring "hi" 0 99)
    substringInverted = rejected (substring "hi" 2 0)
    indexMissing = rejected (indexOf "hello" "xyz")
    replaceEmpty = rejected (replace "hello" "" "x")
    repeatNegative = rejected (repeat "ab" negativeOne)
    padStartEmpty = rejected (padStart "hi" 5 "")
    padEndEmpty = rejected (padEnd "hi" 5 "")
    emptyFloat = rejected (parseFloat "")
    trailingFloat = rejected (parseFloat "3.14x")
    spacedFloat = rejected (parseFloat " 3.14")
    nanFloat = rejected (parseFloat "nan")
    hexFloat = rejected (parseFloat "0x1p2")
    infiniteFloat = rejected (parseFloat "1e9999")
    integerOverflow = rejected (parseInt "99999999999999999999")
    integerLeadingSpace = rejected (parseInt " 42")
    byteOutOfBounds = rejected (byteAt "héllo" 99)
    codePointMidSequence = rejected (codePointAt "héllo" 2)
    surrogateRejected = rejected (codePointWidth 55296)
    invalidCodePoint = rejected (fromCodePoint 2000000)
    nulCodePoint = rejected (fromCodePoint 0)
    roundTrip = match fromCodePoint 233
        Success value => (codePointAt value 0 ?: 0) == 233
        Error _message => false
    customPayload = match failWith "custom boom"
        Success _value => false
        Error message => message == "custom boom"
    divisionRejected = match divideResult (10, 0)
        Success _value => false
        Error message => message != ""

    checkAll "total string boundary values" [
        isEmpty "",
        !(isEmpty "x"),
        startsWith "abc" "",
        endsWith "abc" "",
        !(startsWith "hi" "hello"),
        !(endsWith "hi" "hello"),
        structuralEquals [take "hi" ((0 - 5) ), take "hi" 99, drop "hi" ((0 - 5) ), drop "hi" 99] ["", "hi", "hi", ""],
        structuralEquals [trim "   ", trim ""] ["", ""],
        (substring "hi" 0 0 ?: "missing") == "",
        (substring "hi" 0 2 ?: "missing") == "hi",
        (indexOf "hello" "" ?: negativeOne) == 0,
        (replace "hello" "l" "" ?: "missing") == "heo",
        (repeat "ab" 0 ?: "missing") == "",
        (padStart "hi" 1 "x" ?: "missing") == "hi",
        (padStart "42" 5 "ab" ?: "missing") == "aba42"
    ]
    checkAll "rejected string inputs" [
        substringNegative,
        substringOverrun,
        substringInverted,
        indexMissing,
        replaceEmpty,
        repeatNegative,
        padStartEmpty,
        padEndEmpty,
        emptyFloat,
        trailingFloat,
        spacedFloat,
        nanFloat,
        hexFloat,
        infiniteFloat,
        integerOverflow,
        integerLeadingSpace
    ]
    checkAll "cursor values and error payloads" [
        byteLength "héllo" == 6,
        (byteAt "héllo" 1 ?: 0) == 195,
        byteOutOfBounds,
        (codePointAt "héllo" 1 ?: 0) == 233,
        codePointMidSequence,
        (codePointWidth 128512 ?: 0) == 4,
        surrogateRejected,
        (fromCodePoint 128512 ?: "missing") == "😀",
        invalidCodePoint,
        nulCodePoint,
        roundTrip,
        (parseInt "-9223372036854775808" ?: 0) == (((0 - 9223372036854775807) - 1) ),
        customPayload,
        divisionRejected
    ]

test "string edge cases preserve values and error payloads" (\() => exactArithmetic (stringEdgeCase))

(** [STRING-INTERPOLATION] Rendering: "Integers, floats, and booleans use their
    normal scalar rendering"; [BUILTIN-TOSTRING] "Uses the same accepted types and
    formatting as `print`, without writing output." Every hole is compared to the
    exact text the spec pins AND to `toString` of the same value, so the two
    lowerings cannot silently drift apart. *)
interpolationScalarCase () =
    negativeSeven = (0 - 7) 
    intMax = 9223372036854775807
    intMin = ((0 - 9223372036854775807) - 1) 
    emptyText = ""
    spaceText = " "

    // Integers: no thousands separator, no sign for a positive, an explicit
    // "-" for a negative, and the two 64-bit extremes spelled in full.
    checkAll "integers render identically in a hole and in toString" [
        structuralEquals ["${0}", "${1}", "${42}", "${negativeSeven}"] ["0", "1", "42", "-7"],
        structuralEquals ["${intMax}", "${intMin}", toString 0] ["9223372036854775807", "-9223372036854775808", "0"],
        structuralEquals [toString 42, toString negativeSeven, toString intMax] ["42", "-7", "9223372036854775807"],
        toString intMin == "-9223372036854775808",
        "${0}" == toString 0,
        "${negativeSeven}" == toString negativeSeven,
        "${intMax}" == toString intMax,
        "${intMin}" == toString intMin,
        structuralEquals [length "${0}", length "${negativeSeven}", length "${intMin}"] [1, 2, 20],
        "${0}" != "0.0",
        "${1}" != "true"
    ]

    // Floats keep a visible fractional part so a whole-valued float never
    // renders as an int; [BUILTIN-CONVERT-FLOAT] pins toFloat 7 == 7.0 and
    // toFloat (-3) == -3.0. Float + - * are plain, not Result ([ARITH-CHECKED]).
    checkAll "floats and booleans render with their scalar spelling" [
        structuralEquals ["${0.0}", "${1.5}", "${3.5}", "${2.0}"] ["0.0", "1.5", "3.5", "2.0"],
        structuralEquals ["${100000.0}", "${0.0 - 0.25}", "${1.5 + 2.5}"] ["100000.0", "-0.25", "4.0"],
        structuralEquals ["${1.5 * 2.0}", toString 0.0, toString 3.5] ["3.0", "0.0", "3.5"],
        "${2.0}" == toString 2.0,
        structuralEquals ["${toFloat 7}", "${toFloat 0}", "${toFloat negativeSeven}"] ["7.0", "0.0", "-7.0"],
        structuralEquals ["${true}", "${false}", toString true, toString false] ["true", "false", "true", "false"],
        "${1 == 1}" == "true",
        "${1 != 1}" == "false",
        "${!(1 == 2)}" == "true",
        "${2.0}" != "2",
        "${true}" != "1"
    ]

    // "Strings are inserted unchanged" — no quoting, no escaping, no trimming.
    checkAll "strings are inserted into a hole unchanged" [
        structuralEquals ["${emptyText}", "${spaceText}", "${"x"}", "${"a b"}"] ["", " ", "x", "a b"],
        structuralEquals ["${"  padded  "}", toString "abc"] ["  padded  ", "abc"],
        "${"abc"}" == toString "abc",
        structuralEquals [length "${emptyText}", length "${spaceText}", length "${"  padded  "}"] [0, 1, 10],
        isEmpty "${emptyText}",
        !(isEmpty "${spaceText}"),
        structuralEquals ["a${emptyText}b", "${emptyText}${emptyText}", "[${spaceText}]"] ["ab", "", "[ ]"],
        structuralEquals ["${toString 42}", "${toUpperCase "ab"}", "${"ab" |> toUpperCase}"] ["42", "AB", "AB"],
        "${length "abc"}" == "3"
    ]

(** [STRING-INTERPOLATION]: "A `Result` is never unwrapped at an interpolation
    hole. It renders as the complete `Success(value)` or `Error(message)` value,
    preserving its failure channel exactly as `toString` does." [BUILTIN-PRINT]
    accepts `Result<T, E>` only "when both payloads are printable", so every
    Result below carries an int, float or string payload. *)
interpolationResultCase () =
    negativeOne = (0 - 1) 
    negativeFive = (0 - 5) 

    checkAll "Results retain their wrapper and arithmetic stays plain" [
        structuralEquals ["${parseInt "42"}", "${parseInt "0"}"] ["Success(42)", "Success(0)"],
        "${parseInt "-9223372036854775808"}" == "Success(-9223372036854775808)",
        structuralEquals ["${parseFloat "3.5"}", "${parseFloat "2"}"] ["Success(3.5)", "Success(2.0)"],
        structuralEquals ["${parseFloat "1e3"}", "${parseFloat "-0.5"}"] ["Success(1000.0)", "Success(-0.5)"],
        structuralEquals ["${intDiv (7, 2)}", "${intDiv (255643, 10)}", "${10 / 4}"] ["3", "25564", "2.5"],
        structuralEquals ["${abs negativeFive}", "${fromCodePoint 65}"] ["5", "Success(A)"],
        structuralEquals ["${indexOf "banana" "na"}", "${substring "banana" 1 4}"] ["Success(2)", "Success(ana)"],
        structuralEquals ["${repeat "ab" 2}", "${padStart "7" 3 "0"}"] ["Success(abab)", "Success(007)"],
        structuralEquals ["${byteAt "A" 0}", "${codePointWidth 233}"] ["Success(65)", "Success(2)"]
    ]

    // Every message here is the reason the runtime actually produces; a
    // placeholder reason would break the byte-for-byte comparison ([ERR-PAYLOAD]).
    checkAll "a failed Result renders as Error(message) and keeps its reason" [
        "${parseInt "oops"}" == "Error(parseInt: invalid integer)",
        "${parseInt " 42"}" == "Error(parseInt: invalid integer)",
        "${parseFloat "nan"}" == "Error(parseFloat: invalid number)",
        "${parseFloat ""}" == "Error(parseFloat: invalid number)",
        "${divideResult (5, 0)}" == "Error(division by zero)",
        "${divideResult (10, 0)}" == "Error(division by zero)",
        "${indexOf "hello" "zz"}" == "Error(indexOf: substring not found)",
        "${replace "h" "" ""}" == "Error(replace: needle must not be empty)",
        "${repeat "a" negativeOne}" == "Error(repeat: count must not be negative)",
        "${padStart "x" 5 ""}" == "Error(padStart: fill must not be empty)",
        "${padEnd "x" 5 ""}" == "Error(padEnd: fill must not be empty)",
        "${substring "hi" 0 99}" == "Error(substring: index out of range)",
        "${byteAt "a" 9}" == "Error(byteAt: index out of range)",
        "${codePointAt "é" 1}" == "Error(codePointAt: invalid UTF-8 lead byte)",
        "${codePointWidth 55296}" == "Error(codePointWidth: surrogate is not a scalar)",
        "${codePointWidth 1114112}" == "Error(codePointWidth: code point out of range)",
        "${fromCodePoint 0}" == "Error(fromCodePoint: invalid code point)",
        "${failWith "custom boom"}" == "Error(custom boom)"
    ]

    // Plain "2" is one byte; "Error(division by zero)" is 6 + 16 + 1 = 23.
    checkAll "toString and a hole agree on every Result" [
        toString (parseInt "42") == "${parseInt "42"}",
        toString (parseInt "oops") == "${parseInt "oops"}",
        toString (divideResult (10, 0)) == "${divideResult (10, 0)}",
        toString (intDiv (7, 2)) == "${intDiv (7, 2)}",
        toString (fromCodePoint 65) == "${fromCodePoint 65}",
        toString (failWith "custom boom") == "${failWith "custom boom"}",
        "value=${intDiv (10, 5)}" == "value=2",
        "a${divideResult (5, 0)}b" == "aError(division by zero)b",
        "${intDiv (7, 2)}${intDiv (7, 2)}" == "33",
        length "${intDiv (10, 5)}" == 1,
        length "${divideResult (10, 0)}" == 23,
        startsWith "${parseInt "42"}" "Success(",
        endsWith "${parseInt "42"}" ")",
        !(contains "${parseInt "42"}" "Error"),
        startsWith "${parseInt "oops"}" "Error(",
        contains "${parseInt "oops"}" "invalid integer",
        !(contains "${parseInt "oops"}" "Success"),
        (indexOf "${parseInt "oops"}" "(" ?: negativeOne) == 5,
        (indexOf "${intDiv (10, 5)}" "(" ?: negativeOne) == negativeOne
    ]

(** [LEXICAL-STRUCTURE] literals: "Shared unescaping recognizes `\n`, `\r`, `\t`,
    `\e`, `\0`, `\"`, and `\\`; an unknown escape is preserved verbatim."
    [STRING-INTERPOLATION] Escapes repeats the rule. `\0` is deliberately absent:
    the runtime string is a NUL-terminated `char*` ([BUILTIN-STRING-CURSOR]), so
    an embedded NUL has no observable length and the spec does not define one. *)
escapeSequenceCase () =
    tabSplitCount = match split "a\tb" "\t"
        Success value => listLength value
        Error _message => (0 - 1) 

    // ASCII: LF 10, CR 13, TAB 9, ESC 27, '"' 34, '\' 92, 'a' 97, 'b' 98.
    checkAll "each recognised escape collapses to exactly one byte" [
        length "\n" == 1,
        (byteAt "\n" 0 ?: 0) == 10,
        length "\r" == 1,
        (byteAt "\r" 0 ?: 0) == 13,
        length "\t" == 1,
        (byteAt "\t" 0 ?: 0) == 9,
        length "\e" == 1,
        (byteAt "\e" 0 ?: 0) == 27,
        length "\"" == 1,
        (byteAt "\"" 0 ?: 0) == 34,
        length "\\" == 1,
        (byteAt "\\" 0 ?: 0) == 92,
        byteLength "\n\r\t\e" == 4,
        (byteAt "\n\r\t\e" 0 ?: 0) == 10,
        (byteAt "\n\r\t\e" 3 ?: 0) == 27,
        length "a\nb" == 3,
        (byteAt "a\nb" 0 ?: 0) == 97,
        (byteAt "a\nb" 1 ?: 0) == 10,
        (byteAt "a\nb" 2 ?: 0) == 98,
        "\n" != "n",
        "\\n" != "\n",
        length "\\n" == 2,
        length "a\"b" == 3,
        (byteAt "a\"b" 1 ?: 0) == 34
    ]

    // An unrecognised escape keeps BOTH bytes: 'q' is 113, 'd' is 100, 'x' 120.
    checkAll "an unknown escape keeps its backslash verbatim" [
        length "\q" == 2,
        (byteAt "\q" 0 ?: 0) == 92,
        (byteAt "\q" 1 ?: 0) == 113,
        "\q" == "\\q",
        length "\d" == 2,
        (byteAt "\d" 1 ?: 0) == 100,
        length "\s\q" == 4,
        structuralEquals [contains "\q" "\\", startsWith "\q" "\\", endsWith "\q" "q"] [true, true, true],
        !(contains "\q" "\t"),
        !(isEmpty "\q"),
        structuralEquals [toUpperCase "\q", toLowerCase "\Q", reverse "\q"] ["\Q", "\q", "q\\"],
        length "path\to" == 6,
        (byteAt "path\to" 4 ?: 0) == 9,
        length "path\xo" == 7,
        (byteAt "path\xo" 4 ?: 0) == 92,
        (byteAt "path\xo" 5 ?: 0) == 120
    ]

    // ASCII whitespace for trim/words is space, TAB, LF, CR, VT and FF; ESC is
    // NOT whitespace ([BUILTIN-STRING-TRIM], [BUILTIN-STRING-WORDS]).
    // "A trailing newline does not produce an empty final element" ([BUILTIN-STRING-LINES]).
    checkAll "escaped whitespace drives trim, words, lines and split" [
        structuralEquals [trim "\n\t hi \r\n", trimStart "\n\thi", trimEnd "hi\t\n"] ["hi", "hi", "hi"],
        structuralEquals [trim "\t\r\n ", trim "\e"] ["", "\e"],
        structuralEquals [length (trim "\e hi "), listLength (lines "a\nb\nc"), listLength (lines "a\n")] [4, 3, 1],
        structuralEquals [listLength (lines "a\n\nb"), listLength (lines "solo")] [3, 1],
        structuralEquals [listLength (words "a\tb\nc"), listLength (words "   "), listLength (words "")] [3, 0, 0],
        structuralEquals [listLength (words " a "), listLength (words "a\r\nb")] [1, 2],
        (listGet (lines "a\nb") 1 ?: "missing") == "b",
        (listGet (lines "a\nb") 0 ?: "missing") == "a",
        (listGet (words "a\tb") 1 ?: "missing") == "b",
        join (lines "a\nb\nc") "-" == "a-b-c",
        join (words "  x  y  ") "+" == "x+y",
        tabSplitCount == 2,
        contains "a\nb" "\n",
        !(contains "ab" "\n"),
        startsWith "\tx" "\t",
        endsWith "x\n" "\n"
    ]

(** [BUILTIN-STRING-CONTAINS]: "True if `needle` occurs anywhere in `s`. An empty
    `needle` returns `true`." [BUILTIN-STRING-INDEXOF]: "Returns the byte index of
    the FIRST occurrence of `needle`" and an empty needle returns
    `Success { value: 0 }`. "banana" repeats both "a" and "na", so a scan that
    reports the last match instead of the first cannot pass. *)
substringPositionCase () =
    subject = "banana"
    missing = (0 - 1) 
    indexAbsent = match indexOf subject "xyz"
        Success _value => false
        Error message => message == "indexOf: substring not found"
    indexEmptySubject = match indexOf "" "a"
        Success _value => false
        Error message => message != ""

    // "banana" byte layout: b0 a1 n2 a3 n4 a5, length 6.
    checkAll "contains finds a needle at the start, middle, end and nowhere" [
        containsAll subject ["ban", "nan", "ana", "banana", "b", "a", "n", ""],
        structuralEquals [containsNone subject ["bananas", "xyz", "BAN", "bn", " "], contains "" ""] [true, true],
        !(contains "" "a"),
        contains "a" "a",
        !(contains "a" "aa"),
        contains "a b" " ",
        contains (toLowerCase "BANANA") "banana",
        length subject == 6
    ]

    checkAll "startsWith and endsWith agree with contains at both ends" [
        structuralEquals (mapList ["", "b", "ba"] (\k => startsWith subject k)) [true, true, true],
        startsWith subject "banana",
        !(startsWith subject "banana!"),
        !(startsWith subject "anana"),
        !(startsWith subject "B"),
        structuralEquals (mapList ["", "a", "na"] (\k => endsWith subject k)) [true, true, true],
        structuralEquals (mapList ["ana", "banana"] (\k => endsWith subject k)) [true, true],
        !(endsWith subject "!banana"),
        !(endsWith subject "banan"),
        !(endsWith subject "A"),
        startsWith "" "",
        !(startsWith "" "a"),
        endsWith "" "",
        !(endsWith "" "a"),
        structuralEquals [startsWith "a" "a", endsWith "a" "a", containsAll subject ["ba", "na"]] [true, true, true]
    ]

    // The reported index must reconstruct the needle through substring/take/drop.
    checkAll "indexOf returns the first occurrence as a byte index" [
        (indexOf subject "b" ?: missing) == 0,
        (indexOf subject "a" ?: missing) == 1,
        (indexOf subject "n" ?: missing) == 2,
        (indexOf subject "na" ?: missing) == 2,
        (indexOf subject "ana" ?: missing) == 1,
        (indexOf subject "banana" ?: missing) == 0,
        (indexOf subject "" ?: missing) == 0,
        (indexOf "" "" ?: missing) == 0,
        (indexOf "a" "a" ?: missing) == 0,
        indexAbsent,
        indexEmptySubject,
        (substring subject 1 4 ?: "missing") == "ana",
        (substring subject 2 4 ?: "missing") == "na",
        (substring subject 0 6 ?: "missing") == subject,
        (substring subject 6 6 ?: "missing") == "",
        (substring subject 3 3 ?: "missing") == "",
        take subject (indexOf subject "na" ?: missing) == "ba",
        drop subject (indexOf subject "na" ?: missing) == "nana",
        startsWith (drop subject (indexOf subject "ana" ?: missing)) "ana",
        (indexOf (toUpperCase subject) "NA" ?: missing) == 2
    ]

(** [BUILTIN-STRING-TOUPPERCASE] / [BUILTIN-STRING-TOLOWERCASE]: "ASCII case
    conversion. Other bytes are copied unchanged." "é" is U+00E9 (bytes 0xC3 0xA9 =
    195 169) and "É" is U+00C9 (0xC3 0x89), so neither conversion may touch them —
    a locale-sensitive implementation would corrupt these. *)
caseFoldingCase () =
    mixed = "MiXeD 123!"
    accented = "héllo"
    missing = (0 - 1) 

    checkAll "ASCII letters fold and every other byte is copied unchanged" [
        structuralEquals [toUpperCase "", toLowerCase "", toUpperCase "a", toLowerCase "A"] ["", "", "A", "a"],
        structuralEquals [toUpperCase mixed, toLowerCase mixed] ["MIXED 123!", "mixed 123!"],
        structuralEquals [toUpperCase "0123456789", toLowerCase "0123456789"] ["0123456789", "0123456789"],
        structuralEquals [toUpperCase "!@#%^&*()", toLowerCase "!@#%^&*()"] ["!@#%^&*()", "!@#%^&*()"],
        structuralEquals [toUpperCase " \t\n", toUpperCase "\e", toUpperCase accented] [" \t\n", "\e", "HéLLO"],
        toLowerCase "HÉLLO" == "hÉllo",
        length (toUpperCase accented) == 6,
        byteLength (toLowerCase accented) == 6,
        (byteAt (toUpperCase accented) 0 ?: 0) == 72,
        (byteAt (toUpperCase accented) 1 ?: 0) == 195,
        (byteAt (toUpperCase accented) 2 ?: 0) == 169,
        (byteAt (toUpperCase accented) 3 ?: 0) == 76
    ]

    // Idempotent, length preserving, and a lower/upper round trip that survives
    // the non-ASCII bytes it must not touch.
    checkAll "case conversion is idempotent, length preserving and round trips" [
        toUpperCase (toUpperCase mixed) == toUpperCase mixed,
        toLowerCase (toLowerCase mixed) == toLowerCase mixed,
        toLowerCase (toUpperCase "Hello") == "hello",
        toUpperCase (toLowerCase "Hello") == "HELLO",
        toLowerCase (toUpperCase accented) == accented,
        toUpperCase (toLowerCase accented) == "HéLLO",
        toUpperCase (toLowerCase mixed) == toUpperCase mixed,
        toUpperCase (toLowerCase mixed) != mixed,
        length (toUpperCase mixed) == length mixed,
        length (toLowerCase mixed) == length mixed,
        length (toUpperCase accented) == length accented,
        toLowerCase "HeLLo" == toLowerCase "hEllO",
        toUpperCase "HeLLo" == toUpperCase "hEllO",
        toLowerCase "HeLLo" != "HeLLo",
        toUpperCase "abc" != "abc",
        toUpperCase "ABC" == "ABC",
        toLowerCase "abc" == "abc",
        reverse (toUpperCase "abc") == toUpperCase (reverse "abc"),
        toUpperCase ("a" + "b") == (toUpperCase "a" + toUpperCase "b"),
        toLowerCase ("A" + "B") == (toLowerCase "A" + toLowerCase "B"),
        isEmpty (toUpperCase ""),
        isEmpty (toLowerCase "")
    ]

    checkAll "case folding composes with the search and slicing builtins" [
        contains (toLowerCase "HELLO WORLD") "world",
        !(contains "HELLO WORLD" "world"),
        startsWith (toLowerCase "GET /x") "get ",
        !(startsWith "GET /x" "get "),
        endsWith (toUpperCase "image.png") ".PNG",
        !(endsWith "image.png" ".PNG"),
        (indexOf (toUpperCase "banana") "NA" ?: missing) == 2,
        (indexOf (toLowerCase "BANANA") "na" ?: missing) == 2,
        toUpperCase (take "hello" 3) == take (toUpperCase "hello") 3,
        toLowerCase (drop "HELLO" 3) == drop (toLowerCase "HELLO") 3,
        (replace (toLowerCase "A-B") "-" "+" ?: "missing") == "a+b",
        (repeat (toUpperCase "ab") 2 ?: "missing") == "ABAB",
        (padStart (toUpperCase "z") 3 "y" ?: "missing") == "yyZ",
        (padEnd (toLowerCase "Z") 3 "y" ?: "missing") == "zyy",
        (substring (toUpperCase "banana") 0 3 ?: "missing") == "BAN",
        structuralEquals [trim (toUpperCase "  a  "), toUpperCase (trim "  a  ")] ["A", "A"],
        structuralEquals [join [toUpperCase "a", toLowerCase "B"] "-", "${toUpperCase "ab"}"] ["A-b", "AB"],
        "${toLowerCase "AB"}" == "ab"
    ]

(** [BUILTIN-STRING-CONCAT]: "The `+` operator on two `string` values returns
    `string` directly. String concatenation cannot fail and is never
    `Result`-wrapped." [BUILTIN-STRING-LENGTH] counts bytes and
    [BUILTIN-STRING-BYTELENGTH] is "Equivalent to `length(s)`". Integer `+` IS
    checked, so every length sum is discharged with `?:` ([ARITH-CHECKED]). *)
concatLengthCase () =
    left = "ab"
    middle = "cde"
    right = "f"
    joined = left + middle + right
    negativeFive = (0 - 5) 
    noParts : List<string>
    noParts = []

    checkAll "concatenation is associative with the empty string as identity" [
        ((left + middle) + right) == "abcdef",
        (left + (middle + right)) == "abcdef",
        ((left + middle) + right) == (left + (middle + right)),
        joined == "abcdef",
        (left + "") == left,
        ("" + left) == left,
        ("" + "") == "",
        (left + right) != (right + left),
        ("ab" + "ba") == "abba",
        ("ba" + "ab") == "baab",
        (left + middle) == "${left}${middle}",
        joined == "${left}${middle}${right}",
        length joined == 6,
        byteLength joined == length joined,
        length (left + middle) == ((length left + length middle) ),
        length joined == ((((length left + length middle) ) + length right) ),
        length ("" + "") == 0,
        isEmpty ("" + ""),
        !(isEmpty joined),
        structuralEquals [startsWith joined left, endsWith joined right, contains joined middle] [true, true, true]
    ]

    // take s n + drop s n == s must hold at, inside and outside both ends.
    checkAll "take and drop partition a string at every boundary" [
        (take joined 0 + drop joined 0) == joined,
        (take joined 1 + drop joined 1) == joined,
        (take joined 3 + drop joined 3) == joined,
        (take joined 6 + drop joined 6) == joined,
        (take joined 7 + drop joined 7) == joined,
        (take joined negativeFive + drop joined negativeFive) == joined,
        take joined 0 == "",
        drop joined 0 == joined,
        take joined 6 == joined,
        drop joined 6 == "",
        take joined 99 == joined,
        drop joined 99 == "",
        take joined negativeFive == "",
        drop joined negativeFive == joined,
        length (take joined 3) == 3,
        length (drop joined 3) == 3,
        ((length (take joined 2) + length (drop joined 2)) ) == length joined,
        take joined 3 == (substring joined 0 3 ?: "missing"),
        drop joined 3 == (substring joined 3 6 ?: "missing"),
        (substring joined 0 0 ?: "missing") == "",
        (substring joined 6 6 ?: "missing") == "",
        (substring joined 0 6 ?: "missing") == joined
    ]

    // "ab--cd--ef" is 3 parts (6 bytes) plus 2 separators (4 bytes) = 10.
    checkAll "repeat, reverse, padding and join keep their length contracts" [
        (repeat left 0 ?: "missing") == "",
        (repeat left 1 ?: "missing") == left,
        (repeat left 3 ?: "missing") == "ababab",
        length (repeat left 5 ?: "") == 10,
        (repeat "" 5 ?: "missing") == "",
        length (repeat "" 5 ?: "x") == 0,
        structuralEquals [reverse "", reverse "a", reverse joined] ["", "a", "fedcba"],
        reverse (reverse joined) == joined,
        reverse (reverse "héllo") == "héllo",
        length (reverse "héllo") == 6,
        length (reverse joined) == length joined,
        reverse (left + middle) == (reverse middle + reverse left),
        length (padStart "7" 5 "0" ?: "") == 5,
        length (padEnd "7" 5 "0" ?: "") == 5,
        (padStart "7" 5 "0" ?: "missing") == "00007",
        (padEnd "7" 5 "0" ?: "missing") == "70000",
        (padStart "x" 6 "ab" ?: "missing") == "ababax",
        (padEnd "x" 6 "ab" ?: "missing") == "xababa",
        (padStart "hello" 3 "0" ?: "missing") == "hello",
        (padEnd "hello" 3 "0" ?: "missing") == "hello",
        structuralEquals [join ["a", "b", "c"] "", join ["a"] "-", join ["", ""] "-"] ["abc", "a", "-"],
        join noParts "-" == "",
        length (join ["ab", "cd", "ef"] "--") == 10
    ]

(** [STRING-INTERPOLATION]: "An interpolation expression may contain operators,
    calls, field access, or a nested braced expression." The literal text either
    side of a hole is preserved verbatim, and a `$` NOT followed by `{` introduces
    nothing — [LEXICAL-STRUCTURE] gives `${` alone as the interpolation opener. *)
interpolationCompositionCase () =
    name = "alice"
    count = 3
    xs = ["red", "green", "blue"]
    prices = ["apple" => 2, "banana" => 5]
    step0 = ""
    step1 = "${step0}${(listGet xs 0) ?: "?"}|"
    step2 = "${step1}${(listGet xs 1) ?: "?"}|"
    step3 = "${step2}${(listGet xs 2) ?: "?"}|"
    step4 = "${step3}${(listGet xs 9) ?: "?"}|"
    segmentCount = match split step3 "|"
        Success value => listLength value
        Error _message => (0 - 1) 

    checkAll "a hole may hold a call, a pipe, an operator or an index" [
        structuralEquals ["${length "abc"}", "${toUpperCase name}", "${name |> toUpperCase}"] ["3", "ALICE", "ALICE"],
        structuralEquals ["${name |> length}", "${toString count}"] ["5", "3"],
        structuralEquals ["${toUpperCase (toLowerCase "AbC")}", "${take name 2}"] ["ABC", "al"],
        structuralEquals ["${drop name 2}", "${reverse name}"] ["ice", "ecila"],
        "${count == 3}" == "true",
        "${count != 3}" == "false",
        "${!(count == 3)}" == "false",
        structuralEquals ["${isEmpty ""}", "${contains name "lic"}", "${(count + 4) }"] ["true", "true", "7"],
        "${(count * 4) }" == "12",
        "${(listGet xs 0) ?: "none"}" == "red",
        "${(listGet xs 9) ?: "none"}" == "none",
        "${xs[2] ?: "none"}" == "blue",
        "${prices["apple"] ?: 0}" == "2",
        "${prices["mango"] ?: 0}" == "0",
        "${listLength xs}" == "3"
    ]

    // "alice has 3" is 5 + 5 + 1 = 11 bytes; '$' is byte 36.
    checkAll "the literal text around every hole survives verbatim" [
        structuralEquals ["${count}", "${count}x", "x${count}", "x${count}y"] ["3", "3x", "x3", "x3y"],
        structuralEquals ["${count}${count}", "${count}-${count}", "a${count}b${count}c"] ["33", "3-3", "a3b3c"],
        "no holes here" == "no holes here",
        length "${count}" == 1,
        length "x${count}y" == 3,
        "${name} has ${count}" == "alice has 3",
        length "${name} has ${count}" == 11,
        "$" == "$",
        length "$" == 1,
        (byteAt "$" 0 ?: 0) == 36,
        "$x" == "$x",
        length "$x" == 2,
        "a$b" == "a$b",
        contains "cost: $5" "$",
        !(contains "${name}" "$"),
        ("${name}" + " has " + "${count}") == "alice has 3"
    ]

    // Grown one hole at a time. Every intermediate is asserted, so a lost
    // append cannot hide behind a correct final transcript.
    checkAll "a transcript built hole by hole records every intermediate" [
        structuralEquals [step0, step1, step2, step3] ["", "red|", "red|green|", "red|green|blue|"],
        step4 == "red|green|blue|?|",
        structuralEquals [length step1, length step2, length step3, length step4] [4, 10, 15, 17],
        structuralEquals [startsWith step4 step3, startsWith step3 step2, startsWith step2 step1] [true, true, true],
        !(startsWith step1 step2),
        structuralEquals [endsWith step4 "?|", endsWith step3 "blue|", contains step3 "green|"] [true, true, true],
        !(contains step2 "blue"),
        (step1 + "green|") == step2,
        (step2 + "blue|") == step3,
        (indexOf step3 "green" ?: 0) == 4,
        (indexOf step3 "blue" ?: 0) == 10,
        segmentCount == 4,
        toUpperCase step2 == "RED|GREEN|",
        reverse step1 == "|der"
    ]

(** Byte counts move past a character they would split, and take and drop stay complementary. *)
utf8CutCase () =
    quote = "“ok”"
    eagle = "🦅x"
    checkAll "utf-8 cuts" [
        length quote == 8,
        structuralEquals (mapList [1, 2, 3, 4] (\k => take quote k)) ["“", "“", "“", "“o"],
        structuralEquals (mapList [1, 3, 5, 6] (\k => drop quote k)) ["ok”", "ok”", "”", ""],
        structuralEquals [take eagle 1, drop eagle 1] ["🦅", "x"],
        take quote 2 + drop quote 2 == quote,
        take eagle 3 + drop eagle 3 == eagle
    ]
    checkAll "utf-8 substring bounds" [
        (substring quote 0 3 ?: "bad") == "“",
        (substring quote 3 5 ?: "bad") == "ok",
        byteLength (substring quote 1 3 ?: "") == 2,
        byteLength (substring quote 0 1 ?: "") == 1
    ]
    block = "first
  second ${length quote}
third"
    checkAll "a literal may span lines" [
        length block == 22,
        block == "first\n  second 8\nthird"
    ]

// Registration order fixes the TAP order in the shared golden.
test "interpolation renders every printable scalar" (\() => exactArithmetic (interpolationScalarCase))
test "a Result is never unwrapped at an interpolation hole" (\() => exactArithmetic (interpolationResultCase))
test "escape sequences resolve to their exact bytes" (\() => exactArithmetic (escapeSequenceCase))
test "search builtins scan every substring position" (\() => exactArithmetic (substringPositionCase))
test "ASCII case folding is total and round-trips" (\() => exactArithmetic (caseFoldingCase))
test "concatenation and length arithmetic hold" (\() => exactArithmetic (concatLengthCase))
test "interpolation composes expressions and preserves text" (\() => exactArithmetic (interpolationCompositionCase))
test "a byte count never splits a UTF-8 character" (\() => exactArithmetic (utf8CutCase))
