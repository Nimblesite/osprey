// Match-based validation predicates.

fn notEmpty(s) = match s {
    ""  => false
    _   => true
}

fn isPositive(n) = n > 0

fn isValidAge(age) = match age {
    0   => false
    200 => false
    _   => true
}

fn isValidEmail(email) = match email {
    ""        => false
    "invalid" => false
    _         => true
}

print("Testing validation functions:\n${toString(notEmpty(""))}\n${toString(notEmpty("test"))}\n${toString(isPositive(0))}\n${toString(isPositive(10))}\n${toString(isValidAge(25))}\n${toString(isValidAge(200))}\n${toString(isValidEmail(""))}\n${toString(isValidEmail("alice@example.com"))}\n${toString(isPositive(5))}\n${toString(isPositive((0 - 5) ))}\n${toString(isPositive(0))}")

/// Verifies every validator at its accepted values and rejected sentinels.
fn validationPredicatesCase() = checkAll("validation predicate boundaries", [
    !(notEmpty("")),
    notEmpty("Osprey"),
    !(isPositive(0)),
    isPositive(1),
    !(isPositive((0 - 1) )),
    !(isValidAge(0)),
    isValidAge(25),
    !(isValidAge(200)),
    !(isValidEmail("")),
    !(isValidEmail("invalid")),
    isValidEmail("alice@example.com")
])
test("validators reject sentinels and accept valid inputs", validationPredicatesCase)
