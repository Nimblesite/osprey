// ML matching twin covering literals, booleans, and wildcards.

(** Classify literals through adjacent pattern clauses. *)
tourClassify 0 = "zero"
tourClassify 1 = "one"
tourClassify _ = "many"

(** Verify every literal and wildcard branch. *)
matchTourCase () =
    // Preserve each rendered branch result.
    checkAll "match tour legacy rendered lines" [
        structuralEquals [tourClassify 0, tourClassify 1, tourClassify 9] ["zero", "one", "many"]
    ]
    // Check each dynamic result independently.
    checkAll "match tour legacy constituent values" [
        structuralEquals [tourClassify 0, tourClassify 1, tourClassify 9] ["zero", "one", "many"]
    ]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "match tour wildcard edge cases" [
        structuralEquals [tourClassify 2, tourClassify ((0 - 1) ), tourClassify 100] ["many", "many", "many"],
        (tourClassify 0 == tourClassify 1) == false
    ]

(** Convert a threshold comparison to a grade label. *)
matchGrade n =
    match n >= 50
        true => "pass"
        false => "fail"

(** Convert parity to an even-or-odd label. *)
matchEven n =
    match (n % 2 ) == 0
        true => "even"
        false => "odd"

(** Verify boolean scrutinees for grading and parity. *)
matchBooleanCase () =
    // Preserve the complete rendered result.
    checkAll "boolean match legacy rendered lines" [
        "g80=${matchGrade 80} g20=${matchGrade 20} e4=${matchEven 4} e7=${matchEven 7}" ==
            "g80=pass g20=fail e4=even e7=odd"
    ]
    // Check each label independently.
    checkAll "boolean match legacy constituent values" [
        structuralEquals [matchGrade 80, matchGrade 20, matchEven 4, matchEven 7] ["pass", "fail", "even", "odd"]
    ]
    // Exercise threshold and parity boundaries.
    checkAll "boolean match boundaries" [
        structuralEquals [matchGrade 50, matchGrade 49, matchEven 0, matchEven 9] ["pass", "fail", "even", "odd"]
    ]

(** Label integer literals through adjacent pattern clauses. *)
matchLabel 0 = "none"
matchLabel 1 = "single"
matchLabel 2 = "pair"
matchLabel _ = "many"

(** Verify literal and wildcard integer matching. *)
matchIntegerCase () =
    // Preserve the complete rendered result.
    checkAll "integer match legacy rendered lines" [
        "a=${matchLabel 0} b=${matchLabel 1} c=${matchLabel 2} d=${matchLabel 7}" ==
            "a=none b=single c=pair d=many"
    ]
    // Check each label independently.
    checkAll "integer match legacy constituent values" [
        structuralEquals [matchLabel 0, matchLabel 1, matchLabel 2, matchLabel 7] ["none", "single", "pair", "many"]
    ]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "integer match wildcard boundaries" [
        structuralEquals [matchLabel 3, matchLabel ((0 - 1) ), matchLabel 100] ["many", "many", "many"]
    ]

test "literal matching retains every printed arm" matchTourCase
test "boolean matching covers thresholds and parity" matchBooleanCase
test "integer matching covers literals and wildcard" matchIntegerCase

(** [PATTERN-BINDING-SCOPE] Every pattern introduces names in its own arm. *)
type Choice = Pick int | Other
type Coordinates =
    x : int
    y : int

resultScope input =
    value = 100
    message = "outer"
    selected = match input
        Success value => "${value}:${message}"
        Error message => "${value}:${message}"
    "${selected}:${value}:${message}"

unionScope input =
    value = 100
    selected = match input
        Pick value => value
        Other => value
    "${selected}:${value}"

listScope input =
    head = 100
    tail = [8, 9]
    selected = match input
        [] => head
        [head, ...tail] => wrapAdd (head, listLength tail)
    "${selected}:${head}:${listLength tail}"

structuralScope : Coordinates -> string
structuralScope input =
    x = 100
    selected = match input
        { x, .. } => wrapAdd (x, 1)
    "${selected}:${x}"

erasedScope : any -> string
erasedScope input =
    x = 100
    selected = match input
        { x, .. } => "${x}"
        _ => "none"
    "${selected}:${x}"

bindingScope () =
    value = 100
    selected = match 2
        value => value
    checkAll ("a catch-all binding leaves its outer value intact", [
        structuralEquals [selected, value] [2, 100]
    ])

siblingScopeCase () = checkAll ("pattern arms have independent bindings", [
    resultScope (Success(value = 2)) == "2:outer:100:outer",
    structuralEquals [resultScope (Error(message = "bad")), unionScope (Pick 2)] ["100:bad:100:outer", "2:100"],
    structuralEquals [unionScope Other, listScope [2, 3], listScope []] ["100:100", "3:100:2", "100:100:2"],
    structuralScope (Coordinates(x = 2, y = 3)) == "3:100",
    structuralEquals [erasedScope (Coordinates(x = 2, y = 3)), erasedScope 0] ["2:100", "none:100"]
])

capturedPattern input =
    value = 100
    reader = match input
        Pick value => \() => value
        Other => \() => value
    "${reader ()}:${value}"

capturedPatternCase () = checkAll ("closures retain the selected arm's binding", [
    structuralEquals [capturedPattern (Pick 2), capturedPattern Other] ["2:100", "100:100"]
])

test ("catch-all bindings remain inside their arm", bindingScope)
test ("pattern arms retain their own lexical bindings", siblingScopeCase)
test ("escaping closures retain pattern bindings", capturedPatternCase)

nestedPatternCase () =
    value = 100
    selected = match Pick 2
        Pick value =>
            inner = match Pick 3
                Pick value => value
                Other => value
            "${inner}:${value}"
        Other => "none"
    checkAll ("nested matches restore the containing arm", [selected == "3:2", value == 100])

effect PatternCounter
    set : int => int
mutablePatternCase () =
    mut value = 100
    handle PatternCounter
        set next =>
            value := next
            value
    readOuter = \() => value
    selectedReader = match Pick 2
        Pick value => \() => value
        Other => \() => value
    selected = selectedReader ()
    updated = perform PatternCounter.set 101
    checkAll ("pattern values shadow cell storage without changing it", [
        structuralEquals [selected, selectedReader (), updated, value, readOuter ()] [2, 2, 101, 101, 101]
    ])

test ("nested matches restore enclosing pattern bindings", nestedPatternCase)
test ("pattern bindings shadow captured mutable cells", mutablePatternCase)

type CallChoice = Apply (int -> int) | Absent
type IntOperation =
    run : int -> int

callablePatternCase () =
    apply = \n => wrapAdd (n, 100)
    input = Apply (\n => wrapAdd (n, 1))
    selected = match input
        Apply apply => apply 2
        Absent => apply 2
    run = \n => wrapAdd (n, 200)
    record = IntOperation(run = \n => wrapAdd (n, 2))
    structural = match record
        { run } => run 2
    checkAll ("pattern bindings retain function signatures", [
        structuralEquals [selected, apply 2, structural, run 2] [3, 102, 4, 202]
    ])

test ("callable pattern bindings retain their own signatures", callablePatternCase)

callablePayloadCase () =
    value = \n => wrapAdd (n, 100)
    wrapped = Success(value = \n => wrapAdd (n, 1))
    selected = match wrapped
        Success value => value 2
        Error message => length message
    callbacks = [(\n => wrapAdd (n, 2))]
    listed = match callbacks
        [] => 0
        [value, ...rest] => wrapAdd (value 2, listLength rest)
    bound = match value
        call => call 2
    checkAll ("Result list and catch-all bindings retain callable signatures", [
        structuralEquals [selected, listed, bound, value 2] [3, 4, 102, 102]
    ])

test ("callable payload patterns preserve function values", callablePayloadCase)

directCallablePatternCase () =
    result = match Success(value = \n => wrapAdd (n, 1))
        Success value => value 2
        Error message => length message
    listed = match [(\n => wrapAdd (n, 2))]
        [] => 0
        [value] => value 2
    called = match (\n => wrapAdd (n, 3))
        call => call 2
    checkAll ("direct scrutinees keep their callable payloads", [result == 3, listed == 4, called == 5])

test ("direct callable scrutinees preserve function types", directCallablePatternCase)

joinedCallable flag = match flag
    true => Success(value = \n => n * 2.0)
    false => Success(value = \n => n * 3.0)
applyJoined flag = match joinedCallable flag
    Success value => value 1.25
    Error message => toFloat (length message)
joinedCallablePatternCase () = checkAll ("joined callable Results retain their float ABI", [
    structuralEquals [applyJoined true, applyJoined false] [2.5, 3.75]
])

test ("joined callable Results retain their payload signatures", joinedCallablePatternCase)
