// ML matching twin covering literals, booleans, and wildcards.

(** Classify literals through adjacent pattern clauses. *)
tourClassify 0 = "zero"
tourClassify 1 = "one"
tourClassify _ = "many"

(** Whether every literal and wildcard branch renders its recorded answer. *)
tourBranches () = answersHold (tourClassify, [0, 1, 9], ["zero", "one", "many"])

(** Verify every literal and wildcard branch. *)
matchTourCase () =
    // Preserve each rendered branch result, then re-check the same answers.
    checkAll "match tour legacy rendered lines" [tourBranches ()]
    // Check each dynamic result independently.
    checkAll "match tour legacy constituent values" [tourBranches ()]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "match tour wildcard edge cases" [
        answersHold (tourClassify, [2, 0 - 1, 100], ["many", "many", "many"]),
        (tourClassify 0 == tourClassify 1) == false
    ]

(** Convert a threshold comparison to a grade label. *)
matchGrade n =
    match n >= 50
        true => "pass"
        false => "fail"

(** Convert parity to an even-or-odd label. *)
matchEven n =
    match (n % 2 ) == 0
        true => "even"
        false => "odd"

(** Verify boolean scrutinees for grading and parity. *)
matchBooleanCase () =
    // Preserve the complete rendered result.
    checkAll "boolean match legacy rendered lines" [
        "g80=${matchGrade 80} g20=${matchGrade 20} e4=${matchEven 4} e7=${matchEven 7}" ==
            "g80=pass g20=fail e4=even e7=odd"
    ]
    // Check each label independently.
    checkAll "boolean match legacy constituent values" [
        answersHold (matchGrade, [80, 20], ["pass", "fail"]),
        answersHold (matchEven, [4, 7], ["even", "odd"])
    ]
    // Exercise threshold and parity boundaries.
    checkAll "boolean match boundaries" [
        answersHold (matchGrade, [50, 49], ["pass", "fail"]),
        answersHold (matchEven, [0, 9], ["even", "odd"])
    ]

(** Label integer literals through adjacent pattern clauses. *)
matchLabel 0 = "none"
matchLabel 1 = "single"
matchLabel 2 = "pair"
matchLabel _ = "many"

(** Verify literal and wildcard integer matching. *)
matchIntegerCase () =
    // Preserve the complete rendered result.
    checkAll "integer match legacy rendered lines" [
        "a=${matchLabel 0} b=${matchLabel 1} c=${matchLabel 2} d=${matchLabel 7}" ==
            "a=none b=single c=pair d=many"
    ]
    // Check each label independently.
    checkAll "integer match legacy constituent values" [
        answersHold (matchLabel, [0, 1, 2, 7], ["none", "single", "pair", "many"])
    ]
    // Exercise adjacent, negative, and large wildcard inputs.
    checkAll "integer match wildcard boundaries" [
        answersHold (matchLabel, [3, 0 - 1, 100], ["many", "many", "many"])
    ]

test ("literal matching retains every printed arm", matchTourCase)
test ("boolean matching covers thresholds and parity", matchBooleanCase)
test ("integer matching covers literals and wildcard", matchIntegerCase)

(** [PATTERN-BINDING-SCOPE] Every pattern introduces names in its own arm. *)
type Choice = Pick int | Other
type Coordinates =
    x : int
    y : int

resultScope input =
    value = 100
    message = "outer"
    selected = match input
        Success value => "${value}:${message}"
        Error message => "${value}:${message}"
    "${selected}:${value}:${message}"

unionScope input =
    value = 100
    selected = match input
        Pick value => value
        Other => value
    "${selected}:${value}"

listScope input =
    head = 100
    tail = [8, 9]
    selected = match input
        [] => head
        [head, ...tail] => wrapAdd (head, listLength tail)
    "${selected}:${head}:${listLength tail}"

structuralScope : Coordinates -> string
structuralScope input =
    x = 100
    selected = match input
        { x, .. } => wrapAdd (x, 1)
    "${selected}:${x}"

erasedScope : any -> string
erasedScope input =
    x = 100
    selected = match input
        { x, .. } => "${x}"
        _ => "none"
    "${selected}:${x}"

bindingScope () =
    value = 100
    selected = match 2
        value => value
    checkAll ("a catch-all binding leaves its outer value intact", [
        selected == 2, value == 100
    ])

siblingScopeCase () = checkAll ("pattern arms have independent bindings", [
    resultScope (Success(value = 2)) == "2:outer:100:outer",
    resultScope (Error(message = "bad")) == "100:bad:100:outer",
    unionScope (Pick 2) == "2:100",
    unionScope Other == "100:100",
    listScope [2, 3] == "3:100:2",
    listScope [] == "100:100:2",
    structuralScope (Coordinates(x = 2, y = 3)) == "3:100",
    erasedScope (Coordinates(x = 2, y = 3)) == "2:100",
    erasedScope 0 == "none:100"
])

capturedPattern input =
    value = 100
    reader = match input
        Pick value => \() => value
        Other => \() => value
    "${reader ()}:${value}"

capturedPatternCase () = checkAll ("closures retain the selected arm's binding", [
    capturedPattern (Pick 2) == "2:100",
    capturedPattern Other == "100:100"
])

test ("catch-all bindings remain inside their arm", bindingScope)
test ("pattern arms retain their own lexical bindings", siblingScopeCase)
test ("escaping closures retain pattern bindings", capturedPatternCase)

nestedPatternCase () =
    value = 100
    selected = match Pick 2
        Pick value =>
            inner = match Pick 3
                Pick value => value
                Other => value
            "${inner}:${value}"
        Other => "none"
    checkAll ("nested matches restore the containing arm", [selected == "3:2", value == 100])

effect PatternCounter
    set : int => int
    readAfterWrite : Unit => int
mutablePatternCase () =
    mut value = 100
    handle PatternCounter
        set next =>
            value := next
            value
        readAfterWrite =>
            mut local = 7
            read = \() => local
            local := 11
            read ()
    readOuter = \() => value
    selectedReader = match Pick 2
        Pick value => \() => value
        Other => \() => value
    selected = selectedReader ()
    updated = perform PatternCounter.set 101
    checkAll ("pattern values shadow cell storage without changing it", [
        selected == 2, selectedReader () == 2, updated == 101, value == 101, readOuter () == 101,
        perform PatternCounter.readAfterWrite () == 11
    ])

test ("nested matches restore enclosing pattern bindings", nestedPatternCase)
test ("pattern bindings shadow captured mutable cells", mutablePatternCase)

type CallChoice = Apply (int -> int) | Absent
type IntOperation =
    run : int -> int

callablePatternCase () =
    apply = \n => wrapAdd (n, 100)
    input = Apply (\n => wrapAdd (n, 1))
    selected = match input
        Apply apply => apply 2
        Absent => apply 2
    run = \n => wrapAdd (n, 200)
    record = IntOperation(run = \n => wrapAdd (n, 2))
    structural = match record
        { run } => run 2
    checkAll ("pattern bindings retain function signatures", [
        selected == 3, apply 2 == 102, structural == 4, run 2 == 202
    ])

test ("callable pattern bindings retain their own signatures", callablePatternCase)

callablePayloadCase () =
    value = \n => wrapAdd (n, 100)
    wrapped = Success(value = \n => wrapAdd (n, 1))
    selected = match wrapped
        Success value => value 2
        Error message => length message
    callbacks = [(\n => wrapAdd (n, 2))]
    listed = match callbacks
        [] => 0
        [value, ...rest] => wrapAdd (value 2, listLength rest)
    bound = match value
        call => call 2
    checkAll ("Result list and catch-all bindings retain callable signatures", [
        selected == 3, listed == 4, bound == 102, value 2 == 102
    ])

test ("callable payload patterns preserve function values", callablePayloadCase)

directCallablePatternCase () =
    result = match Success(value = \n => wrapAdd (n, 1))
        Success value => value 2
        Error message => length message
    listed = match [(\n => wrapAdd (n, 2))]
        [] => 0
        [value] => value 2
    called = match (\n => wrapAdd (n, 3))
        call => call 2
    checkAll ("direct scrutinees keep their callable payloads", [result == 3, listed == 4, called == 5])

test ("direct callable scrutinees preserve function types", directCallablePatternCase)

joinedCallable flag = match flag
    true => Success(value = \n => n * 2.0)
    false => Success(value = \n => n * 3.0)
applyJoined flag = match joinedCallable flag
    Success value => value 1.25
    Error message => toFloat (length message)
joinedCallablePatternCase () = checkAll ("joined callable Results retain their float ABI", [
    applyJoined true == 2.5, applyJoined false == 3.75
])

test ("joined callable Results retain their payload signatures", joinedCallablePatternCase)

(* Or-patterns ([PATTERN-OR]): one arm, several alternatives, one body. *)

type Glyph = Space | Tab | Newline | Letter(c : string) | Digit(d : int) | Word(w : string)
type Pt = Pt int int
type Tri = Tri int int int
type Cell = Cell Glyph int
type Sized =
    kind : string
    n : int

(** Payload-free alternatives, payload alternatives and a nested literal slot. *)
glyphKind g = match g
    Space | Tab | Newline => "blank"
    Digit (0 | 1) => "bit"
    Digit d => "digit ${d}"
    Letter s | Word s => "text ${s}"

(** Integer, string, bool and float literal alternatives. *)
smallInt n = match n
    0 | 1 | 2 => "small"
    _ => "big"
yes s = match s
    "y" | "yes" | "Y" => true
    _ => false
either b = match b
    true | false => "bool"
unitish x = match x
    0.0 | 1.0 => "unit"
    _ => "other"

orLiteralCase () = checkAll ("or-pattern variant and literal alternatives", [
    answersHold (glyphKind, [Space, Tab, Newline, Digit(d = 0), Digit(d = 1), Digit(d = 7), Letter(c = "a"), Word(w = "hi")], ["blank", "blank", "blank", "bit", "bit", "digit 7", "text a", "text hi"]),
    answersHold (smallInt, [0, 1, 2, 3, 0 - 1], ["small", "small", "small", "big", "big"]),
    answersHold (yes, ["y", "yes", "Y", "n", ""], [true, true, true, false, false]),
    answersHold (either, [true, false], ["bool", "bool"]),
    answersHold (unitish, [0.0, 1.0, 0.5], ["unit", "unit", "other"])
])

test ("or-patterns join variant and literal alternatives", orLiteralCase)

(** `Success` and `Error` alternatives binding one name of one type. *)
resultText r = match r
    Success s | Error s => "got ${s}"

(** Positional payloads, lists with a rest binder and rows as alternatives. *)
onAxis p = match p
    Pt 0 _ | Pt _ 0 => "axis"
    _ => "plane"
shortList xs = match xs
    [] | [_] => "short"
    [a, b, ...rest] => "long ${wrapAdd (wrapAdd (a, b), listLength rest)}"
axisPair (x, y) = match Pt x y
    (0, n) | (n, 0) => n
    _ => -1
tailSize xs = match xs
    [0, ...rest] | [1, ...rest] => listLength rest
    _ => -1
(** [PATTERN-OR-BODY] List tails and borrowed list elements share the arm binder. *)
type Box = Wrap (List<int>) | Boxed (List<int>) | Nest (List<List<int>>) | Hollow
tailLen b = match b
    Wrap [_, ...xs] | Boxed [_, _, ...xs] | Nest [xs] => listLength xs
    _ => 0 - 1

rowSize (r : Sized) = match r
    { kind = "s", n } | { kind = "m", n } => n
    _ => 0

openBand (r : Sized) = match r
    { kind = "old", .. } => 1
    { n = 2 | 3, kind = "s" | "m", .. } => 2
    _ => 0

(** Three levels: a Result holding a cell whose slots are or-patterns. *)
deepBlank r = match r
    Success (Cell (Space | Tab) (0 | 1)) | Error "blank" => "deep blank"
    Success (Cell (Letter(c = "x" | "y")) _) => "deep letter"
    _ => "deep other"

orStructureCase () = checkAll ("or-pattern Result, payload, list, row and nested alternatives", [
    answersHold (resultText, [Success(value = "a"), Error(message = "b")], ["got a", "got b"]),
    answersHold (onAxis, [Pt 0 5, Pt 5 0, Pt 0 0, Pt 2 3], ["axis", "axis", "axis", "plane"]),
    axisPair (0, 8) == 8, axisPair (9, 0) == 9, axisPair (2, 3) == -1,
    answersHold (tailSize, [[0], [1, 8, 9], [2, 9], []], [0, 2, -1, -1]),
    answersHold (shortList, [[], [9], [1, 2, 3, 4]], ["short", "short", "long 5"]),
    answersHold (tailLen, [Wrap [1, 2, 3], Boxed [1, 2, 3], Nest [[4, 5, 6, 7]], Wrap [], Nest [[1], [2]], Hollow], [2, 1, 4, -1, -1, -1]),
    rowSize (Sized(kind = "s", n = 3)) == 3, rowSize (Sized(kind = "m", n = 4)) == 4,
    rowSize (Sized(kind = "l", n = 5)) == 0,
    openBand (Sized(kind = "old", n = 2)) == 1, openBand (Sized(kind = "m", n = 2)) == 2,
    openBand (Sized(kind = "s", n = 3)) == 2, openBand (Sized(kind = "s", n = 4)) == 0,
    answersHold (deepBlank, [Success(value = Cell Space 0), Success(value = Cell Tab 1), Error(message = "blank"), Success(value = Cell Space 2)], ["deep blank", "deep blank", "deep blank", "deep other"]),
    answersHold (deepBlank, [Success(value = Cell (Letter(c = "x")) 9), Success(value = Cell (Letter(c = "y")) 9), Success(value = Cell (Letter(c = "z")) 9), Error(message = "other")], ["deep letter", "deep letter", "deep other", "deep other"])
])

test ("or-patterns cover Results, payloads, lists, rows and three-level nests", orStructureCase)

(** [PATTERN-OR-ORDER]: when both alternatives match, the first supplies `x`. *)
firstWins t = match t
    Tri x 0 _ | Tri _ x 0 => x
    _ => 0 - 1

(** A function-valued binder taken from either alternative. *)
pickCall r = match r
    Success f | Error f => f 10

(** A closure capturing the binder escapes the arm. *)
adder t = match t
    Pt n 0 | Pt 0 n => \x => wrapAdd (x, n)
    _ => \x => x

orBindingCase () =
    mut n = 100
    shadowed = match Pt 4 0
        Pt n 0 | Pt 0 n => n
        _ => 0
    checkAll ("or-pattern bindings follow order and scope", [
        firstWins (Tri 5 0 0) == 5, firstWins (Tri 3 7 0) == 7, firstWins (Tri 5 1 7) == 0 - 1,
        pickCall (Success(value = \x => wrapMul (x, 2))) == 20,
        pickCall (Error(message = \x => wrapAdd (x, 1))) == 11,
        shadowed == 4, n == 100,
        adder (Pt 3 0) 1 == 4, adder (Pt 0 6) 1 == 7, adder (Pt 2 2) 1 == 1
    ])

test ("or-pattern bindings follow order, scope and closures", orBindingCase)
