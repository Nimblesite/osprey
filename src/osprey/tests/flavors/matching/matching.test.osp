// Assertion-driven replacement for the former matching flavor goldens.

/// Classify two integer literals and route every other value to a wildcard.
fn tourClassify(n) = match n {
    0 => "zero"
    1 => "one"
    _ => "many"
}

/// This case documents the three formerly printed match-tour branches.
fn matchTourCase() = {
    // Preserve each complete one-word output line independently.
    checkAll("match tour legacy rendered lines", [
            tourClassify(0) == "zero",
            tourClassify(1) == "one",
            tourClassify(9) == "many"
    ])
    // Repeat the dynamic branch results as explicit constituent assertions.
    checkAll("match tour legacy constituent values", [
            tourClassify(0) == "zero",
            tourClassify(1) == "one",
            tourClassify(9) == "many"
    ])
    // Extend wildcard coverage across adjacent, negative, and large integers.
    checkAll("match tour wildcard edge cases", [
            tourClassify(2) == "many",
            tourClassify((0 - 1) ) == "many",
            tourClassify(100) == "many",
            (tourClassify(0) == tourClassify(1)) == false
    ])
}

/// Convert a threshold comparison into a pass-or-fail label.
fn matchGrade(n) = match n >= 50 {
    true => "pass"
    false => "fail"
}

/// Convert a modulo comparison into an even-or-odd label.
fn matchEven(n) = match (n % 2 ) == 0 {
    true => "even"
    false => "odd"
}

/// This case documents boolean scrutinees for grading and parity.
fn matchBooleanCase() = {
    // Preserve the complete combined boolean-match output line.
    checkAll("boolean match legacy rendered lines", [
            "g80=${matchGrade(80)} g20=${matchGrade(20)} e4=${matchEven(4)} e7=${matchEven(7)}" ==
            "g80=pass g20=fail e4=even e7=odd"
    ])
    // Split all four matched labels into independent assertions.
    checkAll("boolean match legacy constituent values", [
            matchGrade(80) == "pass",
            matchGrade(20) == "fail",
            matchEven(4) == "even",
            matchEven(7) == "odd"
    ])
    // Exercise the grade threshold and parity boundary values.
    checkAll("boolean match boundaries", [
            matchGrade(50) == "pass",
            matchGrade(49) == "fail",
            matchEven(0) == "even",
            matchEven(9) == "odd"
    ])
}

/// Label zero, one, and two explicitly before the integer wildcard.
fn matchLabel(n) = match n {
    0 => "none"
    1 => "single"
    2 => "pair"
    _ => "many"
}

/// This case documents literal and wildcard matching over integers.
fn matchIntegerCase() = {
    // Preserve the complete combined integer-match output line.
    checkAll("integer match legacy rendered lines", [
            "a=${matchLabel(0)} b=${matchLabel(1)} c=${matchLabel(2)} d=${matchLabel(7)}" ==
            "a=none b=single c=pair d=many"
    ])
    // Split all four matched labels into independent assertions.
    checkAll("integer match legacy constituent values", [
            answersHold(matchLabel, [0, 1, 2, 7], ["none", "single", "pair", "many"])
    ])
    // Extend the wildcard across adjacent, negative, and large integers.
    checkAll("integer match wildcard boundaries", [
            matchLabel(3) == "many",
            matchLabel((0 - 1) ) == "many",
            matchLabel(100) == "many"
    ])
}

// Register the literal-match tour scenario.
testCases([
    { name: "literal matching retains every printed arm", work: matchTourCase },
    // Register the boolean-scrutinee scenario.
    { name: "boolean matching covers thresholds and parity", work: matchBooleanCase },
    // Register the integer literal-and-wildcard scenario.
    { name: "integer matching covers literals and wildcard", work: matchIntegerCase }
])

/// [PATTERN-BINDING-SCOPE] Every pattern introduces names in its own arm.
type Choice = Pick(int) | Other
type Coordinates = { x: int, y: int }

fn resultScope(input) = {
    let value = 100
    let message = "outer"
    let selected = match input {
        Success { value } => "${value}:${message}"
        Error { message } => "${value}:${message}"
    }
    "${selected}:${value}:${message}"
}

fn unionScope(input) = {
    let value = 100
    let selected = match input {
        Pick(value) => value
        Other => value
    }
    "${selected}:${value}"
}

fn listScope(input) = {
    let head = 100
    let tail = [8, 9]
    let selected = match input {
        [] => head
        [head, ...tail] => wrapAdd(head, listLength(tail))
    }
    "${selected}:${head}:${listLength(tail)}"
}

fn structuralScope(input: Coordinates) = {
    let x = 100
    let selected = match input { { x, .. } => wrapAdd(x, 1) }
    "${selected}:${x}"
}

fn erasedScope(input: any) = {
    let x = 100
    let selected = match input {
        { x, .. } => "${x}"
        _ => "none"
    }
    "${selected}:${x}"
}

fn bindingScope() = {
    let value = 100
    let selected = match 2 { value => value }
    checkAll("a catch-all binding leaves its outer value intact", [
        selected == 2, value == 100
    ])
}

fn siblingScopeCase() = checkAll("pattern arms have independent bindings", [
    resultScope(Success { value: 2 }) == "2:outer:100:outer",
    resultScope(Error { message: "bad" }) == "100:bad:100:outer",
    unionScope(Pick(2)) == "2:100",
    unionScope(Other) == "100:100",
    listScope([2, 3]) == "3:100:2",
    listScope([]) == "100:100:2",
    structuralScope(Coordinates { x: 2, y: 3 }) == "3:100",
    erasedScope(Coordinates { x: 2, y: 3 }) == "2:100",
    erasedScope(0) == "none:100"
])

fn capturedPattern(input) = {
    let value = 100
    let reader = match input {
        Pick(value) => || => value
        Other => || => value
    }
    "${reader()}:${value}"
}

fn capturedPatternCase() = checkAll("closures retain the selected arm's binding", [
    capturedPattern(Pick(2)) == "2:100",
    capturedPattern(Other) == "100:100"
])

testCases([
    { name: "catch-all bindings remain inside their arm", work: bindingScope },
    { name: "pattern arms retain their own lexical bindings", work: siblingScopeCase },
    { name: "escaping closures retain pattern bindings", work: capturedPatternCase }
])

fn nestedPatternCase() = {
    let value = 100
    let selected = match Pick(2) {
        Pick(value) => {
            let inner = match Pick(3) { Pick(value) => value Other => value }
            "${inner}:${value}"
        }
        Other => "none"
    }
    checkAll("nested matches restore the containing arm", [selected == "3:2", value == 100])
}

effect PatternCounter { set: fn(int) -> int }
fn mutablePatternCase() = {
    mut value = 100
    handle PatternCounter {
        set next => {
            value = next
            value
        }
    }
    let readOuter = || => value
    let selectedReader = match Pick(2) { Pick(value) => || => value Other => || => value }
    let selected = selectedReader()
    let updated = perform PatternCounter.set(101)
    checkAll("pattern values shadow cell storage without changing it", [
        selected == 2, selectedReader() == 2, updated == 101, value == 101, readOuter() == 101
    ])
}

testCases([
    { name: "nested matches restore enclosing pattern bindings", work: nestedPatternCase },
    { name: "pattern bindings shadow captured mutable cells", work: mutablePatternCase }
])

type CallChoice = Apply(fn(int) -> int) | Absent
type IntOperation = { run: fn(int) -> int }

fn callablePatternCase() = {
    let apply = fn(n) => wrapAdd(n, 100)
    let input = Apply(fn(n) => wrapAdd(n, 1))
    let selected = match input { Apply(apply) => apply(2) Absent => apply(2) }
    let run = fn(n) => wrapAdd(n, 200)
    let record = IntOperation { run: fn(n) => wrapAdd(n, 2) }
    let structural = match record { { run } => run(2) }
    checkAll("pattern bindings retain function signatures", [
        selected == 3, apply(2) == 102, structural == 4, run(2) == 202
    ])
}

test("callable pattern bindings retain their own signatures", callablePatternCase)

fn callablePayloadCase() = {
    let value = fn(n) => wrapAdd(n, 100)
    let wrapped = Success { value: fn(n) => wrapAdd(n, 1) }
    let selected = match wrapped {
        Success { value } => value(2)
        Error { message } => length(message)
    }
    let callbacks = [fn(n) => wrapAdd(n, 2)]
    let listed = match callbacks { [] => 0 [value, ...rest] => wrapAdd(value(2), listLength(rest)) }
    let bound = match value { call => call(2) }
    checkAll("Result list and catch-all bindings retain callable signatures", [
        selected == 3, listed == 4, bound == 102, value(2) == 102
    ])
}

test("callable payload patterns preserve function values", callablePayloadCase)

fn directCallablePatternCase() = {
    let result = match Success { value: fn(n) => wrapAdd(n, 1) } {
        Success { value } => value(2)
        Error { message } => length(message)
    }
    let listed = match [fn(n) => wrapAdd(n, 2)] { [] => 0 [value] => value(2) }
    let called = match (fn(n) => wrapAdd(n, 3)) { call => call(2) }
    checkAll("direct scrutinees keep their callable payloads", [result == 3, listed == 4, called == 5])
}

test("direct callable scrutinees preserve function types", directCallablePatternCase)

fn joinedCallable(flag) = match flag {
    true => Success { value: fn(n) => n * 2.0 }
    false => Success { value: fn(n) => n * 3.0 }
}
fn applyJoined(flag) = match joinedCallable(flag) {
    Success { value } => value(1.25)
    Error { message } => toFloat(length(message))
}
fn joinedCallablePatternCase() = checkAll("joined callable Results retain their float ABI", [
    applyJoined(true) == 2.5, applyJoined(false) == 3.75
])

test("joined callable Results retain their payload signatures", joinedCallablePatternCase)

// Or-patterns ([PATTERN-OR]): one arm, several alternatives, one body.

type Glyph = Space | Tab | Newline | Letter { c: string } | Digit { d: int } | Word { w: string }
type Pt = Pt(int, int)
type Tri = Tri(int, int, int)
type Cell = Cell(Glyph, int)
type Sized = { kind: string, n: int }

/// Payload-free alternatives, payload alternatives and a nested literal slot.
fn glyphKind(g) = match g {
    Space | Tab | Newline => "blank"
    Digit { d: 0 | 1 } => "bit"
    Digit { d } => "digit ${d}"
    Letter { c: s } | Word { w: s } => "text ${s}"
}

/// Integer, string, bool and float literal alternatives.
fn smallInt(n) = match n { 0 | 1 | 2 => "small" _ => "big" }
fn yes(s) = match s { "y" | "yes" | "Y" => true _ => false }
fn either(b) = match b { true | false => "bool" }
fn unitish(x) = match x { 0.0 | 1.0 => "unit" _ => "other" }

fn orLiteralCase() = checkAll("or-pattern variant and literal alternatives", [
    glyphKind(Space) == "blank", glyphKind(Tab) == "blank", glyphKind(Newline) == "blank",
    glyphKind(Digit { d: 0 }) == "bit", glyphKind(Digit { d: 1 }) == "bit",
    glyphKind(Digit { d: 7 }) == "digit 7",
    glyphKind(Letter { c: "a" }) == "text a", glyphKind(Word { w: "hi" }) == "text hi",
    smallInt(0) == "small", smallInt(1) == "small", smallInt(2) == "small",
    smallInt(3) == "big", smallInt(0 - 1) == "big",
    yes("y"), yes("yes"), yes("Y"), yes("n") == false, yes("") == false,
    either(true) == "bool", either(false) == "bool",
    unitish(0.0) == "unit", unitish(1.0) == "unit", unitish(0.5) == "other"
])

test("or-patterns join variant and literal alternatives", orLiteralCase)

/// `Success` and `Error` alternatives binding one name of one type.
fn resultText(r) = match r {
    Success { value: s } | Error { message: s } => "got ${s}"
}

/// Positional payloads, lists and rows as alternatives.
fn onAxis(p) = match p { Pt(0, _) | Pt(_, 0) => "axis" _ => "plane" }
fn shortList(xs) = match xs { [] | [_] => "short" [a, b, ...rest] => "long ${wrapAdd(wrapAdd(a, b), listLength(rest))}" }

/// A binder that is a list tail (+1) in one alternative and a borrowed
/// element or another tail in the next: ARC releases it exactly once.
type Box = Wrap(List<int>) | Boxed(List<int>) | Nest(List<List<int>>) | Hollow
fn tailLen(b) = match b {
    Wrap([_, ...xs]) | Boxed([_, _, ...xs]) | Nest([xs]) => listLength(xs)
    _ => 0 - 1
}
fn rowSize(r: Sized) = match r { { kind: "s", n } | { kind: "m", n } => n _ => 0 }

/// Three levels: a Result holding a cell whose slots are or-patterns.
fn deepBlank(r) = match r {
    Success { value: Cell(Space | Tab, 0 | 1) } | Error { message: "blank" } => "deep blank"
    Success { value: Cell(Letter { c: "x" | "y" }, _) } => "deep letter"
    _ => "deep other"
}

fn orStructureCase() = checkAll("or-pattern Result, payload, list, row and nested alternatives", [
    resultText(Success { value: "a" }) == "got a", resultText(Error { message: "b" }) == "got b",
    onAxis(Pt(0, 5)) == "axis", onAxis(Pt(5, 0)) == "axis", onAxis(Pt(0, 0)) == "axis",
    onAxis(Pt(2, 3)) == "plane",
    shortList([]) == "short", shortList([9]) == "short", shortList([1, 2, 3, 4]) == "long 5",
    tailLen(Wrap([1, 2, 3])) == 2, tailLen(Boxed([1, 2, 3])) == 1, tailLen(Nest([[4, 5, 6, 7]])) == 4,
    tailLen(Wrap([])) == 0 - 1, tailLen(Nest([[1], [2]])) == 0 - 1, tailLen(Hollow) == 0 - 1,
    rowSize({ kind: "s", n: 3 }) == 3, rowSize({ kind: "m", n: 4 }) == 4,
    rowSize({ kind: "l", n: 5 }) == 0,
    deepBlank(Success { value: Cell(Space, 0) }) == "deep blank",
    deepBlank(Success { value: Cell(Tab, 1) }) == "deep blank",
    deepBlank(Error { message: "blank" }) == "deep blank",
    deepBlank(Success { value: Cell(Space, 2) }) == "deep other",
    deepBlank(Success { value: Cell(Letter { c: "x" }, 9) }) == "deep letter",
    deepBlank(Success { value: Cell(Letter { c: "y" }, 9) }) == "deep letter",
    deepBlank(Success { value: Cell(Letter { c: "z" }, 9) }) == "deep other",
    deepBlank(Error { message: "other" }) == "deep other"
])

test("or-patterns cover Results, payloads, lists, rows and three-level nests", orStructureCase)

/// [PATTERN-OR-ORDER]: when both alternatives match, the first supplies `x`.
fn firstWins(t) = match t { Tri(x, 0, _) | Tri(_, x, 0) => x _ => 0 - 1 }

/// A function-valued binder taken from either alternative.
fn pickCall(r) = match r {
    Success { value: f } | Error { message: f } => f(10)
}

/// A closure capturing the binder escapes the arm.
fn adder(t) = match t {
    Pt(n, 0) | Pt(0, n) => fn(x) => wrapAdd(x, n)
    _ => fn(x) => x
}

fn orBindingCase() = {
    mut n = 100
    let shadowed = match Pt(4, 0) { Pt(n, 0) | Pt(0, n) => n _ => 0 }
    checkAll("or-pattern bindings follow order and scope", [
        firstWins(Tri(5, 0, 0)) == 5, firstWins(Tri(3, 7, 0)) == 7, firstWins(Tri(5, 1, 7)) == 0 - 1,
        pickCall(Success { value: fn(x) => wrapMul(x, 2) }) == 20,
        pickCall(Error { message: fn(x) => wrapAdd(x, 1) }) == 11,
        shadowed == 4, n == 100,
        adder(Pt(3, 0))(1) == 4, adder(Pt(0, 6))(1) == 7, adder(Pt(2, 2))(1) == 1
    ])
}

test("or-pattern bindings follow order, scope and closures", orBindingCase)
