// Assertion-driven replacement for the former matching flavor goldens.

/// Classify two integer literals and route every other value to a wildcard.
fn tourClassify(n) = match n {
    0 => "zero"
    1 => "one"
    _ => "many"
}

/// Assert the three literal-tour labels under one check label.
fn tourLines(label) = checkAll(label, [
        structuralEquals([tourClassify(0), tourClassify(1), tourClassify(9)], ["zero", "one", "many"])
])

/// This case documents the three formerly printed match-tour branches.
fn matchTourCase() = {
    // Preserve each complete one-word output line independently.
    tourLines("match tour legacy rendered lines")
    // Repeat the dynamic branch results as explicit constituent assertions.
    tourLines("match tour legacy constituent values")
    // Extend wildcard coverage across adjacent, negative, and large integers.
    checkAll("match tour wildcard edge cases", [
            structuralEquals([tourClassify(2), tourClassify((0 - 1) ), tourClassify(100)], ["many", "many", "many"]),
            (tourClassify(0) == tourClassify(1)) == false
    ])
}

/// Convert a threshold comparison into a pass-or-fail label.
fn matchGrade(n) = match n >= 50 {
    true => "pass"
    false => "fail"
}

/// Convert a modulo comparison into an even-or-odd label.
fn matchEven(n) = match (n % 2 ) == 0 {
    true => "even"
    false => "odd"
}

/// Assert grade and parity labels for two grading and two parity inputs.
fn checkGradeParity(label, passIn, failIn, evenIn, oddIn) = checkAll(label, [
        structuralEquals([matchGrade(passIn), matchGrade(failIn)], ["pass", "fail"]),
        structuralEquals([matchEven(evenIn), matchEven(oddIn)], ["even", "odd"])
])

/// This case documents boolean scrutinees for grading and parity.
fn matchBooleanCase() = {
    // Preserve the complete combined boolean-match output line.
    checkAll("boolean match legacy rendered lines", [
            "g80=${matchGrade(80)} g20=${matchGrade(20)} e4=${matchEven(4)} e7=${matchEven(7)}" ==
            "g80=pass g20=fail e4=even e7=odd"
    ])
    // Split all four matched labels into independent assertions.
    checkGradeParity("boolean match legacy constituent values", 80, 20, 4, 7)
    // Exercise the grade threshold and parity boundary values.
    checkGradeParity("boolean match boundaries", 50, 49, 0, 9)
}

/// Label zero, one, and two explicitly before the integer wildcard.
fn matchLabel(n) = match n {
    0 => "none"
    1 => "single"
    2 => "pair"
    _ => "many"
}

/// Assert that two integer inputs produce the expected labels.
fn labelPair(a, b, expected) = structuralEquals([matchLabel(a), matchLabel(b)], expected)

/// This case documents literal and wildcard matching over integers.
fn matchIntegerCase() = {
    // Preserve the complete combined integer-match output line.
    checkAll("integer match legacy rendered lines", [
            "a=${matchLabel(0)} b=${matchLabel(1)} c=${matchLabel(2)} d=${matchLabel(7)}" ==
            "a=none b=single c=pair d=many"
    ])
    // Split all four matched labels into independent assertions.
    checkAll("integer match legacy constituent values", [
            labelPair(0, 1, ["none", "single"]),
            labelPair(2, 7, ["pair", "many"])
    ])
    // Extend the wildcard across adjacent, negative, and large integers.
    checkAll("integer match wildcard boundaries", [
            structuralEquals([matchLabel(3), matchLabel((0 - 1) ), matchLabel(100)], ["many", "many", "many"])
    ])
}

// Register the literal-match tour scenario.
test("literal matching retains every printed arm", matchTourCase)
// Register the boolean-scrutinee scenario.
test("boolean matching covers thresholds and parity", matchBooleanCase)
// Register the integer literal-and-wildcard scenario.
test("integer matching covers literals and wildcard", matchIntegerCase)

/// [PATTERN-BINDING-SCOPE] Every pattern introduces names in its own arm.
type Choice = Pick(int) | Other
type Coordinates = { x: int, y: int }

fn resultScope(input) = {
    let value = 100
    let message = "outer"
    let selected = match input {
        Success { value } => "${value}:${message}"
        Error { message } => "${value}:${message}"
    }
    "${selected}:${value}:${message}"
}

fn unionScope(input) = {
    let value = 100
    let selected = match input {
        Pick(value) => value
        Other => value
    }
    "${selected}:${value}"
}

fn listScope(input) = {
    let head = 100
    let tail = [8, 9]
    let selected = match input {
        [] => head
        [head, ...tail] => wrapAdd(head, listLength(tail))
    }
    "${selected}:${head}:${listLength(tail)}"
}

fn structuralScope(input: Coordinates) = {
    let x = 100
    let selected = match input { { x, .. } => wrapAdd(x, 1) }
    "${selected}:${x}"
}

fn erasedScope(input: any) = {
    let x = 100
    let selected = match input {
        { x, .. } => "${x}"
        _ => "none"
    }
    "${selected}:${x}"
}

fn bindingScope() = {
    let value = 100
    let selected = match 2 { value => value }
    checkAll("a catch-all binding leaves its outer value intact", [
        structuralEquals([selected, value], [2, 100])
    ])
}

fn siblingScopeCase() = checkAll("pattern arms have independent bindings", [
    resultScope(Success { value: 2 }) == "2:outer:100:outer",
    structuralEquals([resultScope(Error { message: "bad" }), unionScope(Pick(2))], ["100:bad:100:outer", "2:100"]),
    structuralEquals([unionScope(Other), listScope([2, 3]), listScope([])], ["100:100", "3:100:2", "100:100:2"]),
    structuralScope(Coordinates { x: 2, y: 3 }) == "3:100",
    structuralEquals([erasedScope(Coordinates { x: 2, y: 3 }), erasedScope(0)], ["2:100", "none:100"])
])

fn capturedPattern(input) = {
    let value = 100
    let reader = match input {
        Pick(value) => || => value
        Other => || => value
    }
    "${reader()}:${value}"
}

fn capturedPatternCase() = checkAll("closures retain the selected arm's binding", [
    structuralEquals([capturedPattern(Pick(2)), capturedPattern(Other)], ["2:100", "100:100"])
])

test("catch-all bindings remain inside their arm", bindingScope)
test("pattern arms retain their own lexical bindings", siblingScopeCase)
test("escaping closures retain pattern bindings", capturedPatternCase)

fn nestedPatternCase() = {
    let value = 100
    let selected = match Pick(2) {
        Pick(value) => {
            let inner = match Pick(3) { Pick(value) => value Other => value }
            "${inner}:${value}"
        }
        Other => "none"
    }
    checkAll("nested matches restore the containing arm", [selected == "3:2", value == 100])
}

effect PatternCounter { set: fn(int) -> int }
fn mutablePatternCase() = {
    mut value = 100
    handle PatternCounter {
        set next => {
            value = next
            value
        }
    }
    let readOuter = || => value
    let selectedReader = match Pick(2) { Pick(value) => || => value Other => || => value }
    let selected = selectedReader()
    let updated = perform PatternCounter.set(101)
    checkAll("pattern values shadow cell storage without changing it", [
        structuralEquals([selected, selectedReader(), updated, value, readOuter()], [2, 2, 101, 101, 101])
    ])
}

test("nested matches restore enclosing pattern bindings", nestedPatternCase)
test("pattern bindings shadow captured mutable cells", mutablePatternCase)

type CallChoice = Apply(fn(int) -> int) | Absent
type IntOperation = { run: fn(int) -> int }

fn callablePatternCase() = {
    let apply = fn(n) => wrapAdd(n, 100)
    let input = Apply(fn(n) => wrapAdd(n, 1))
    let selected = match input { Apply(apply) => apply(2) Absent => apply(2) }
    let run = fn(n) => wrapAdd(n, 200)
    let record = IntOperation { run: fn(n) => wrapAdd(n, 2) }
    let structural = match record { { run } => run(2) }
    checkAll("pattern bindings retain function signatures", [
        structuralEquals([selected, apply(2), structural, run(2)], [3, 102, 4, 202])
    ])
}

test("callable pattern bindings retain their own signatures", callablePatternCase)

/// Apply a callable Result payload to the value two, or return the error length.
fn applyPayload(wrapped) = match wrapped {
    Success { value } => value(2)
    Error { message } => length(message)
}

fn callablePayloadCase() = {
    let value = fn(n) => wrapAdd(n, 100)
    let wrapped = Success { value: fn(n) => wrapAdd(n, 1) }
    let selected = applyPayload(wrapped)
    let callbacks = [fn(n) => wrapAdd(n, 2)]
    let listed = match callbacks { [] => 0 [value, ...rest] => wrapAdd(value(2), listLength(rest)) }
    let bound = match value { call => call(2) }
    checkAll("Result list and catch-all bindings retain callable signatures", [
        structuralEquals([selected, listed, bound, value(2)], [3, 4, 102, 102])
    ])
}

test("callable payload patterns preserve function values", callablePayloadCase)

fn directCallablePatternCase() = {
    let result = applyPayload(Success { value: fn(n) => wrapAdd(n, 1) })
    let listed = match [fn(n) => wrapAdd(n, 2)] { [] => 0 [value] => value(2) }
    let called = match (fn(n) => wrapAdd(n, 3)) { call => call(2) }
    checkAll("direct scrutinees keep their callable payloads", [result == 3, listed == 4, called == 5])
}

test("direct callable scrutinees preserve function types", directCallablePatternCase)

fn joinedCallable(flag) = match flag {
    true => Success { value: fn(n) => n * 2.0 }
    false => Success { value: fn(n) => n * 3.0 }
}
fn applyJoined(flag) = match joinedCallable(flag) {
    Success { value } => value(1.25)
    Error { message } => toFloat(length(message))
}
fn joinedCallablePatternCase() = checkAll("joined callable Results retain their float ABI", [
    structuralEquals([applyJoined(true), applyJoined(false)], [2.5, 3.75])
])

test("joined callable Results retain their payload signatures", joinedCallablePatternCase)
