(** Portable cross-contract oracle for [EFFECTS-OP-TYPING],
    [EFFECTS-STATIC-DISCHARGE], [EFFECTS-HANDLER-STATE], [TYPE-LIST],
    [TYPE-MAP], [TYPE-MAP-LOOKUP], [TYPE-MAP-OPS], [FLAVOR-ML-HANDLER],
    [FLAVOR-ML-LIST], [FLAVOR-ML-MAP], and [FLAVOR-ML-CALL]. *)

(** Counter mutation is available only through this handled operation. *)
effect FlavorCounter
    (** Add `amount` to the counter the handler owns. *)
    tick : int => Unit

(** The list stored under `key` in `m`, or the sentinel `[99]` when it is absent. *)
storedList m k = mapGet m k ?: [99]

(** The length and index-`i` element of the list stored under `key`, or sentinels. *)
listShape m k i = [listLength (storedList m k), listGet (storedList m k) i ?: 99]

runBatchAssertions () =
    mut total = 10
    base = ["first" => [2, 3], "second" => [5, 9]]
    grown = base |> mapSet "third" [7, 11, 13]
    replaced = grown |> mapSet "first" [20]
    removed = replaced |> mapRemove "second"
    first = storedList base "first"
    second = storedList base "second"
    missing = storedList base "missing"

    checkAll "effect batch collection preconditions" [
        structuralEquals [total, mapLength base, mapLength grown, mapLength replaced] [10, 2, 3, 3],
        structuralEquals [mapLength removed, listLength first, listLength second] [2, 2, 2],
        structuralEquals [listLength missing, (listGet first 0 ?: 99), (listGet first 1 ?: 99)] [1, 2, 3],
        structuralEquals [(listGet second 0 ?: 99), (listGet second 1 ?: 99), (listGet missing 0 ?: 0)] [5, 9, 99],
        !(mapContains base "third"),
        mapContains grown "third",
        !(mapContains removed "second")
    ]

    handle FlavorCounter
        tick amount =>
            total := total + amount 
    forEachList first (\amount => perform FlavorCounter.tick amount)
    checkAll "effectful callback applies the first generic list" [
        total == 15,
        "first total=${total}" == "first total=15"
    ]
    perform FlavorCounter.tick ((0 - 4) )
    checkAll "negative handled transition remains checked" [
        total == 11,
        total < 15
    ]
    forEachList second (\amount => perform FlavorCounter.tick amount)
    perform FlavorCounter.tick 0
    checkAll "second list and identity transition compose" [
        total == 25,
        total > 11,
        "second total=${total}" == "second total=25"
    ]

    checkAll "handler exit preserves state and persistent collection versions" [
        structuralEquals [listShape grown "third" 2, listShape replaced "first" 0] [[3, 13], [1, 20]],
        structuralEquals [total, mapLength base, mapLength grown, listLength (mapValues grown)] [25, 2, 3, 3],
        structuralEquals [listLength (storedList base "first"), listLength (mapKeys grown)] [2, 3]
    ]

(** Verify state before, during, and after the handler. *)
mutationCase () =
    mut flavorCounter = 0

    // The counter starts at zero for each test run.
    checkAll "counter initial state" [
        flavorCounter == 0
    ]

    handle FlavorCounter
        tick amount =>
            flavorCounter := flavorCounter + amount 
    perform FlavorCounter.tick 1

    // The first operation is independently observable.
    checkAll "counter first transition" [
        flavorCounter == 1
    ]

    perform FlavorCounter.tick 41

    // The second operation reaches the expected total.
    checkAll "counter second transition" [
        flavorCounter == 42
    ]

    // State and rendering survive handler exit.
    checkAll "counter legacy final state and rendering" [
        flavorCounter == 42,
        "counter = ${flavorCounter}" == "counter = 42"
    ]

    runBatchAssertions ()

test "handled mutation retains every counter transition" (exactly mutationCase)
