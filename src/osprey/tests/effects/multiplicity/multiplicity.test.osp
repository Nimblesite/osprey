/// Resumption multiplicity — how many times an effect's request may be answered
/// ([MULTI-AXIS], docs/specs/language/0017-AlgebraicEffects.md). This suite is the runnable
/// half of the [MULTI-FALSIFY] gate: the programs the axis must ACCEPT. The
/// programs it must REJECT are `src/osprey/examples/failscompilation/multi_*.ospo`.
/// Implements [MULTI-AXIS], [MULTI-DECL], [MULTI-HANDLE-ONCE], [MULTI-COMPAT].

effect Charge {
    /// Settle `amount`. The handler may retry internally before answering, but
    /// answers this request at most once — `once`, written out here to pin that
    /// the default and the keyword mean the same thing.
    control once charge: fn(int) -> int
}

effect Email {
    /// Deliver `body`. Not replayable: sending a receipt twice is a defect,
    /// which is the whole reason multiplicity is on the row.
    deliver: fn(string) -> Unit
}

effect Audit {
    /// Record a performer-side event without touching stdout.
    line: fn(string) -> Unit
}

effect Random {
    /// A fresh draw. `replayable` asserts re-performing is acceptable to the
    /// program — declared, never inferred ([MULTI-REPLAY]).
    control replayable next: fn() -> int
}

/// The modifier words stay ordinary identifiers everywhere else, including as
/// operation names — the contextual-keyword rule of [MULTI-DECL].
effect Vocabulary {
    control abort: fn() -> int
    control once: fn() -> int
    control many: fn() -> int
    control replayable: fn() -> int
}

/// The gateway declines the first settlement of an amount and accepts the next.
fn settle(amount, attempt) = match attempt {
    1 => Error { message: "gateway timeout" }
    _ => Success { value: amount }
}

/// One order: settle it, then send exactly one receipt for what was settled.
/// The retry happens inside the handler arm, so this body runs once per answer.
fn placeOrder(amount) = {
    let settled = perform Charge.charge(amount)
    perform Email.deliver("receipt for ${toString(settled)}")
    "settled ${toString(settled)}"
}

/// Install the audit transcript and one-receipt-per-delivery regions around
/// `work`, returning its answer with the handler-owned transcript and count.
fn withReceipts(work) = {
    mut transcript = ""
    mut receipts = 0
    let outcome = {
        handle Audit {
            line message => { transcript = "${transcript}${message}\n" }
        }
        handle Email {
            deliver body => {
                receipts = receipts + 1 
                perform Audit.line("email: ${body}")
            }
        }
        work()
    }
    { outcome: outcome, transcript: transcript, receipts: receipts }
}

/// [MULTI-FALSIFY] 1 — a `once` arm that retries internally still answers its
/// request exactly once, so the body's `Email.deliver` runs exactly once. The
/// two `resume` sites sit on different `match` branches, which is the shape
/// [MULTI-HANDLE-ONCE] must keep legal: at most one per control path.
fn retrySendsOneReceiptCase() = {
    mut attempts = 0
    let run = withReceipts(fn() => {
        handle Charge {
            charge amount => {
                attempts = attempts + 1 
                match settle(amount, attempts) {
                    Success { value } => resume(value)
                    Error { message } => {
                        perform Audit.line("declined: ${message}; retrying")
                        attempts = attempts + 1 
                        match settle(amount, attempts) {
                            Success { value } => resume(value)
                            Error { message } => "declined: ${message}"
                        }
                    }
                }
            }
        }
        placeOrder(120)
    })
    checkAll("retry answers once and mails once", [
        run.outcome == "settled 120",
        run.transcript == "declined: gateway timeout; retrying\nemail: receipt for 120\n",
        structuralEquals([attempts, run.receipts], [2, 1]),
        !contains(run.transcript, "email: receipt for 120\nemail: receipt for 120\n")
    ])
}

/// Declining to resume is the safe direction `once` permits: `once` is affine,
/// not linear, so zero resumptions is always legal and the receipt in the
/// un-run remainder is exactly what is dropped with the continuation.
fn declineSendsNoReceiptCase() = {
    let run = withReceipts(fn() => {
        handle Charge {
            charge amount => match settle(amount, 1) {
                Success { value } => resume(value)
                Error { message } => {
                    perform Audit.line("abandoned ${toString(amount)}: ${message}")
                    "declined: ${message}"
                }
            }
        }
        placeOrder(75)
    })
    checkAll("abandoning the continuation mails nothing", [
        run.outcome == "declined: gateway timeout",
        run.transcript == "abandoned 75: gateway timeout\n",
        run.receipts == 0
    ])
}

/// ONE unannotated definition applied under two different effects — the
/// multiplicity twin of [STAGE-FALSIFY]'s shared function. Multiplicity is read
/// from the DECLARATION, so this is multiplicity-polymorphic with no annotation
/// and no multiplicity variable to infer ([MULTI-STAGE-POLY]).
fn applyTwice(f, x) = f(f(x))

/// A callback over a `replayable` operation.
fn jitter(n) = (n + perform Random.next()) 

/// A callback over an ordinary, non-replayable `once` operation.
fn audited(n) = {
    perform Email.deliver("audit ${toString(n)}")
    (n * 2) 
}

/// [MULTI-FALSIFY] 4, for the multiplicities the runtime can represent: the
/// same function serves a `replayable` callback and a plain `once` one in one
/// program, carrying no multiplicity annotation.
fn sharedAcrossMultiplicitiesCase() = {
    mut audits = 0
    let noisy = {
        handle Random {
            next => resume(3)
        }
        applyTwice(jitter, 10)
    }
    let doubled = {
        handle Email {
            deliver _body => { audits = audits + 1  }
        }
        applyTwice(audited, 5)
    }
    checkAll("one function serves both multiplicities", [
        structuralEquals([noisy, doubled, audits], [16, 20, 2])
    ])
}

/// An operation NAMED with a modifier word declares, performs and handles like
/// any other, and the same words bind as ordinary values.
fn contextualKeywordCase() = {
    let total = {
        handle Vocabulary {
            abort => resume(1)
            once => resume(2)
            many => resume(4)
            replayable => resume(8)
        }
        let low = (perform Vocabulary.abort() + perform Vocabulary.once()) 
        let high = (perform Vocabulary.many() + perform Vocabulary.replayable()) 
        (low + high) 
    }
    let many = 100
    let abort = (many + total) 
    checkAll("modifier words stay ordinary identifiers", [
        structuralEquals([total, abort], [15, 115])
    ])
}

test("a once arm retrying internally sends exactly one receipt", fn() => exactArithmetic(retrySendsOneReceiptCase))
test("a once arm that declines to resume sends no receipt", fn() => exactArithmetic(declineSendsNoReceiptCase))
test("one unannotated function serves both multiplicities", fn() => exactArithmetic(sharedAcrossMultiplicitiesCase))
test("abort, once, many and replayable stay legal identifiers", fn() => exactArithmetic(contextualKeywordCase))
