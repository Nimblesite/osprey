(** Exact-value tests record any arithmetic fault as a failed assertion. *)

(** Resumption multiplicity — how many times an effect's request may be answered
    ([MULTI-AXIS], docs/specs/language/0017-AlgebraicEffects.md). The ML twin of
    `multiplicity.test.osp`, sharing its golden.
    Implements [MULTI-AXIS], [MULTI-DECL], [MULTI-HANDLE-ONCE], [MULTI-COMPAT]. *)

effect Charge
    (** Settle `amount`. The handler may retry internally before answering, but
        answers this request at most once — `once`, written out here to pin that
        the default and the keyword mean the same thing. *)
    control once charge : int => int

effect Email
    (** Deliver `body`. Not replayable: sending a receipt twice is a defect. *)
    deliver : string => Unit

effect Audit
    (** Record a performer-side event without touching stdout. *)
    line : string => Unit

effect Random
    (** A fresh draw; `replayable` asserts re-performing is acceptable
        ([MULTI-REPLAY]). *)
    control replayable next : Unit => int

(** The modifier words stay ordinary identifiers everywhere else, including as
    operation names — the contextual-keyword rule of [MULTI-DECL]. *)
effect Vocabulary
    control abort : Unit => int
    control once : Unit => int
    control many : Unit => int
    control replayable : Unit => int

(** The gateway declines the first settlement of an amount and accepts the next. *)
settle (amount, attempt) = match attempt
    1 => Error(message = "gateway timeout")
    _ => Success(value = amount)

(** One order: settle it, then send exactly one receipt for what was settled. *)
placeOrder amount =
    settled = perform Charge.charge amount
    perform Email.deliver "receipt for ${toString settled}"
    "settled ${toString settled}"

(** The handler stack both [MULTI-HANDLE-ONCE] shapes share: transcript lines are
    appended whole, deliveries counted and audited, and the charge arm answers at
    most once, retrying internally while `limit` leaves another attempt. *)
runChargedOrder (amount, limit, verify) =
    mut transcript = ""
    mut attempts = 0
    mut receipts = 0
    outcome =
        handle Audit
            line message => transcript := "${transcript}${message}"
        handle Email
            deliver body =>
                receipts := receipts + 1 
                perform Audit.line "email: ${body}\n"
        handle Charge
            charge asked =>
                attempts := attempts + 1 
                match settle (asked, attempts)
                    Success value => resume value
                    Error message => match (limit - attempts)
                        0 =>
                            perform Audit.line (refusalLine (asked, limit, message))
                            "declined: ${message}"
                        _ =>
                            perform Audit.line "declined: ${message}; retrying\n"
                            attempts := attempts + 1 
                            match settle (asked, attempts)
                                Success value => resume value
                                Error message => "declined: ${message}"
        placeOrder amount
    verify (outcome, attempts, receipts, transcript)

(** What a `once` arm logs as it refuses: the retrying shape already logged its
    failed retry, the declining shape abandons and names its amount. *)
refusalLine (amount, limit, message) = match limit
    1 => "abandoned ${toString amount}: ${message}\n"
    _ => ""

(** [MULTI-FALSIFY] 1 — a `once` arm retrying internally answers exactly once, so
    `Email.deliver` runs once; two `resume` sites on different branches is the shape
    [MULTI-HANDLE-ONCE] must keep legal. *)
retrySendsOneReceiptCase () = runChargedOrder (120, 2, verifyRetriedOrder)

verifyRetriedOrder (outcome, attempts, receipts, transcript) = checkAll "retry answers once and mails once" [
    outcome == "settled 120",
    attempts == 2,
    receipts == 1,
    transcript == "declined: gateway timeout; retrying\nemail: receipt for 120\n",
    !contains transcript "email: receipt for 120\nemail: receipt for 120\n"
]

(** Declining to resume is the safe direction `once` permits: `once` is affine, so
    zero resumptions is legal and the receipt goes with the dropped continuation. *)
declineSendsNoReceiptCase () = runChargedOrder (75, 1, verifyAbandonedOrder)

verifyAbandonedOrder (outcome, _attempts, receipts, transcript) = checkAll "abandoning the continuation mails nothing" [
    outcome == "declined: gateway timeout", receipts == 0, transcript == "abandoned 75: gateway timeout\n"
]

(** ONE unannotated definition applied under two different effects — the
    multiplicity twin of [STAGE-FALSIFY]'s shared function ([MULTI-STAGE-POLY]). *)
applyTwice (f, x) = f (f x)

(** A callback over a `replayable` operation. *)
jitter n = (n + perform Random.next ()) 

(** A callback over an ordinary, non-replayable `once` operation. *)
audited n =
    perform Email.deliver "audit ${toString n}"
    (n * 2) 

(** [MULTI-FALSIFY] 4, for the multiplicities the runtime can represent. *)
sharedAcrossMultiplicitiesCase () =
    mut audits = 0
    noisy =
        handle Random
            next => resume 3
        applyTwice (jitter, 10)
    doubled =
        handle Email
            deliver _body => audits := audits + 1 
        applyTwice (audited, 5)
    checkAll "one function serves both multiplicities" [
        noisy == 16, doubled == 20, audits == 2
    ]

(** An operation NAMED with a modifier word declares, performs and handles like
    any other, and the same words bind as ordinary values. *)
contextualKeywordCase () =
    total =
        handle Vocabulary
            abort => resume 1
            once => resume 2
            many => resume 4
            replayable => resume 8
        low = (perform Vocabulary.abort () + perform Vocabulary.once ()) 
        high = (perform Vocabulary.many () + perform Vocabulary.replayable ()) 
        (low + high) 
    many = 100
    abort = (many + total) 
    checkAll "modifier words stay ordinary identifiers" [
        total == 15, abort == 115
    ]

exactTests [
    { name = "a once arm retrying internally sends exactly one receipt", work = retrySendsOneReceiptCase },
    { name = "a once arm that declines to resume sends no receipt", work = declineSendsNoReceiptCase },
    { name = "one unannotated function serves both multiplicities", work = sharedAcrossMultiplicitiesCase },
    { name = "abort, once, many and replayable stay legal identifiers", work = contextualKeywordCase }
]
