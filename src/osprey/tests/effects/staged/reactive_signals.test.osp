/// Compiler-derived reactive reads. Implements [STAGE-SIGNALS-CACHE], [STAGE-SIGNALS-EXACT], [STAGE-SIGNALS-REBUILD], [STAGE-POLY].
static effect Signal<T> { read: fn() -> T }
type Count = { value: int }
type Cursor = { at: int }
fn count() = (perform Signal<Count>.read()).value
fn cursor() = (perform Signal<Cursor>.read()).at
fn counterLabel() = "count=${count()}"
fn cursorLabel() = "cursor=${cursor()}"
fn status() = "${counterLabel()}/${cursorLabel()}"
fn footer() = "ready"
fn relay(callback) !e = callback()
fn branch(flag) = match flag { true => counterLabel() false => cursorLabel() }

fn initial(n) = fn(at) => {
    handle static Signal<Count> { read => Count { value: n } }
    handle static Signal<Cursor> { read => Cursor { at: at } }
    { counter: signalSnapshot(counterLabel), cursor: signalSnapshot(cursorLabel), status: signalSnapshot(status), footer: signalSnapshot(footer) }
}
fn refreshAll(old) = fn(changed) => fn(n) => fn(at) => {
    handle static Signal<Count> { read => Count { value: n } }
    handle static Signal<Cursor> { read => Cursor { at: at } }
    { counter: signalRefresh(old.counter, changed, counterLabel), cursor: signalRefresh(old.cursor, changed, cursorLabel), status: signalRefresh(old.status, changed, status), footer: signalRefresh(old.footer, changed, footer) }
}
fn selectiveRebuild() = {
    let first = initial(1)(2)
    let changedCount = refreshAll(first)(signalDependencies(count))(7)(9)
    let changedCursor = refreshAll(changedCount)(signalDependencies(cursor))(8)(4)
    let batch = refreshAll(changedCursor)(signalDependencies(status))(3)(6)
    let idle = refreshAll(batch)([])(99)(99)
    checkAll("selective reactive views", [
        first.status.value == "count=1/cursor=2",
        changedCount.counter.value == "count=7", changedCount.cursor.value == "cursor=2",
        changedCount.status.value == "count=7/cursor=9", changedCount.footer.revision == 1,
        changedCount.counter.revision == 2, changedCount.cursor.revision == 1,
        changedCursor.counter.value == "count=7", changedCursor.cursor.value == "cursor=4",
        changedCursor.status.value == "count=8/cursor=4",
        batch.counter.value == "count=3", batch.cursor.value == "cursor=6", batch.status.revision == 4,
        idle.status.value == batch.status.value, idle.status.revision == 4,
        idle.footer.value == "ready", idle.footer.revision == 1
    ])
}

fn conservativeBranches() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 1 } }
        handle static Signal<Cursor> { read => Cursor { at: 2 } }
        signalSnapshot(|| => branch(true))
    }
    let changed = {
        handle static Signal<Count> { read => Count { value: 5 } }
        handle static Signal<Cursor> { read => Cursor { at: 9 } }
        signalRefresh(first, signalDependencies(cursor), || => branch(true))
    }
    checkAll("may-read includes an inactive branch", [
        length(first.dependencies) == 2, first.value == "count=1",
        changed.value == "count=5", changed.revision == 2
    ])
}

fn callbackReplacementAndUnknown() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 1 } }
        signalSnapshot(counterLabel)
    }
    let replacement = {
        handle static Signal<Cursor> { read => Cursor { at: 8 } }
        signalRefresh(first, [], cursorLabel)
    }
    let unknown = {
        handle static Signal<Count> { read => Count { value: 3 } }
        relay(|| => signalSnapshot(counterLabel))
    }
    checkAll("callback replacement updates dependencies", [
        replacement.value == "cursor=8", replacement.revision == 2,
        join(replacement.dependencies, ";") == join(signalDependencies(cursorLabel), ";"), unknown.value == "count=3"
    ])
}

fn rowsStayOpen(callback) = signalSnapshot(callback)
fn unknownRefresh(old) = fn(callback) => signalRefresh(old, [], callback)
fn unresolvedCallbacksRebuild() = {
    let first = rowsStayOpen(|| => "first")
    let next = unknownRefresh(first)(|| => "next")
    checkAll("unknown dependencies invalidate conservatively", [
        join(first.dependencies, ";") == "<unknown>", first.value == "first",
        next.value == "next", next.revision == 2
    ])
}

fn managedValues() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 2 } }
        signalSnapshot(|| => [counterLabel(), "kept"])
    }
    let next = {
        handle static Signal<Count> { read => Count { value: 4 } }
        signalRefresh(first, signalDependencies(count), || => [counterLabel(), "kept"])
    }
    checkAll("snapshots own managed values independently", [
        join(first.value, ",") == "count=2,kept", join(next.value, ",") == "count=4,kept",
        first.revision == 1, next.revision == 2
    ])
}

effect Audit { note: fn(string) -> Unit }
fn tracked() = {
    perform Audit.note("build;")
    counterLabel()
}
fn factory() = {
    perform Audit.note("factory;")
    tracked
}
fn evaluationAndNoOp() = {
    mut trail = ""
    handle Audit { note text => { trail = "${trail}${text}" } }
    let first = {
        handle static Signal<Count> { read => Count { value: 2 } }
        signalSnapshot(factory())
    }
    let idle = {
        handle static Signal<Count> { read => Count { value: 9 } }
        signalRefresh(first, [], factory())
    }
    let metadata = signalDependencies(factory())
    checkAll("arguments run once and clean caches skip their callback", [
        trail == "factory;build;factory;factory;", first.value == "count=2", idle.value == "count=2",
        idle.revision == 1, join(metadata, ";") == join(signalDependencies(count), ";")
    ])
}

fn unresolvedChangesRebuild() = {
    let first = signalSnapshot(|| => "first")
    let next = signalRefresh(first, ["<unknown>"], || => "next")
    checkAll("unknown changes invalidate conservatively", [
        first.value == "first", next.value == "next", next.revision == 2
    ])
}

fn maybeLabel(allowed) = match allowed {
    true => Success { value: counterLabel() }
    false => Error { message: "denied" }
}
fn cachedResultsKeepBothVariants() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 2 } }
        signalSnapshot(|| => maybeLabel(true))
    }
    let next = {
        handle static Signal<Count> { read => Count { value: 4 } }
        signalRefresh(first, signalDependencies(count), || => maybeLabel(false))
    }
    let firstAnswer = match first.value { Success { value } => value Error { message } => message }
    let nextAnswer = match next.value { Success { value } => value Error { message } => message }
    checkAll("cached results preserve success and error payloads", [
        firstAnswer == "count=2", nextAnswer == "denied", first.revision == 1, next.revision == 2
    ])
}

fn capturedLabel() = {
    let saved = counterLabel()
    fn() => saved
}
fn callableSnapshotsKeepTheirCapturedValues() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 2 } }
        signalSnapshot(capturedLabel)
    }
    let idle = {
        handle static Signal<Count> { read => Count { value: 9 } }
        signalRefresh(first, [], capturedLabel)
    }
    let next = {
        handle static Signal<Count> { read => Count { value: 4 } }
        signalRefresh(idle, signalDependencies(count), capturedLabel)
    }
    checkAll("callable snapshots own their captured values", [first.value() == "count=2", idle.value() == "count=2", next.value() == "count=4", first.revision == 1, idle.revision == 1, next.revision == 2])
}

test("reactive views rebuild selectively through helpers", selectiveRebuild)
test("inactive branches remain possible dependencies", conservativeBranches)
test("changing a callback updates its dependency set", callbackReplacementAndUnknown)
test("unknown rows rebuild rather than miss a change", unresolvedCallbacksRebuild)
test("old and new snapshots keep their managed values", managedValues)
test("arguments run once while clean computations stay cached", evaluationAndNoOp)
test("unknown changes cannot retain a stale snapshot", unresolvedChangesRebuild)
test("cached results retain whole variants across rebuilds", cachedResultsKeepBothVariants)
test("cached callables retain their captured values across rebuilds", callableSnapshotsKeepTheirCapturedValues)

/// A rebuild is an ordinary record wherever it flows: passed into a call, from
/// either arm of a match, it keeps its layout (#272).
type Region = { region: string, dependencies: List<string>, revision: int, json: string }
fn describeSnapshot(next) = "${next.value}@${next.revision}"
fn named(key, next) = Region { region: key, dependencies: next.dependencies, revision: next.revision, json: next.value }
fn blankSnapshot() = { dependencies: ["<unknown>"], revision: 0, value: "" }
fn pickRow(cached, flag) = {
    let row = match flag { true => { revision: 1, value: "fresh" } false => cached }
    describeSnapshot(row)
}
fn refreshArgumentsKeepTheirLayout() = {
    let first = {
        handle static Signal<Count> { read => Count { value: 2 } }
        signalSnapshot(counterLabel)
    }
    let direct = {
        handle static Signal<Count> { read => Count { value: 3 } }
        describeSnapshot(signalRefresh(blankSnapshot(), [], counterLabel))
    }
    let built = {
        handle static Signal<Count> { read => Count { value: 3 } }
        named("list", signalRefresh(blankSnapshot(), [], counterLabel))
    }
    let kept = {
        handle static Signal<Count> { read => Count { value: 9 } }
        named("kept", signalRefresh(first, [], counterLabel))
    }
    let bound = {
        handle static Signal<Count> { read => Count { value: 4 } }
        let next = signalRefresh(blankSnapshot(), [], counterLabel)
        describeSnapshot(next)
    }
    let snapshot = {
        handle static Signal<Count> { read => Count { value: 5 } }
        describeSnapshot(signalSnapshot(counterLabel))
    }
    print("refresh arguments: ${direct} ${built.region}=${built.json}@${built.revision} ${kept.region}=${kept.json}@${kept.revision} ${bound} ${snapshot} ${describeSnapshot(first)}")
    checkAll("refreshed snapshots keep their record layout as call arguments", [
        direct == "count=3@1", built.region == "list", built.json == "count=3", built.revision == 1,
        join(built.dependencies, ";") == join(signalDependencies(counterLabel), ";"),
        kept.region == "kept", kept.json == "count=2", kept.revision == 1,
        join(kept.dependencies, ";") == join(first.dependencies, ";"),
        bound == "count=4@1", snapshot == "count=5@1", describeSnapshot(first) == "count=2@1",
        pickRow({ revision: 9, value: "cached" }, false) == "cached@9", pickRow({ revision: 9, value: "cached" }, true) == "fresh@1"
    ])
}

test("refreshed snapshots keep their layout as call arguments", refreshArgumentsKeepTheirLayout)
