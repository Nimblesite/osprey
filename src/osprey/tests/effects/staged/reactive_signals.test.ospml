(** Compiler-derived reactive reads. Implements [STAGE-SIGNALS-CACHE], [STAGE-SIGNALS-EXACT], [STAGE-SIGNALS-REBUILD], [STAGE-POLY]. *)
static effect Signal T
    read : Unit => T
type Count =
    value : int
type Cursor =
    at : int
count () = (perform Signal<Count>.read ()).value
cursor () = (perform Signal<Cursor>.read ()).at
counterLabel () = "count=${count ()}"
cursorLabel () = "cursor=${cursor ()}"
status () = "${counterLabel ()}/${cursorLabel ()}"
footer () = "ready"
relay callback = callback ()
branch flag = match flag
    true => counterLabel ()
    false => cursorLabel ()

(** The joined dependency row of `deps` reads the same as `reference`'s. *)
tracksDeps (deps, reference) = join deps ";" == join reference ";"

(** Run `work` with the static `Count` signal pinned to `n`. *)
underCount (n, work) =
    handle static Signal<Count>
        read => Count(value = n)
    work ()

(** Run `work` with the `Count` and `Cursor` signals pinned to `n` and `at`. *)
underSignals (n, at, work) =
    handle static Signal<Count>
        read => Count(value = n)
    handle static Signal<Cursor>
        read => Cursor(at = at)
    work ()

initial n at =
    underSignals (n, at, \() =>
        { counter = signalSnapshot counterLabel, cursor = signalSnapshot cursorLabel, status = signalSnapshot status, footer = signalSnapshot footer })
refreshAll old changed n at =
    underSignals (n, at, \() =>
        { counter = signalRefresh old.counter changed counterLabel, cursor = signalRefresh old.cursor changed cursorLabel, status = signalRefresh old.status changed status, footer = signalRefresh old.footer changed footer })

(** Snapshot `now` while the count signal reads two. *)
snapshotOf now = underCount (2, \() => signalSnapshot now)

(** Rebuild `old` under count four once the count signal changes. *)
refreshedFrom (old, later) = underCount (4, \() => signalRefresh old (signalDependencies count) later)

(** Both snapshots of one count rebuild hold the revisions one refresh gives. *)
rebuiltOnce (first, next) = first.revision == 1 && next.revision == 2

selectiveRebuild () =
    first = initial 1 2
    changedCount = refreshAll first (signalDependencies count) 7 9
    changedCursor = refreshAll changedCount (signalDependencies cursor) 8 4
    batch = refreshAll changedCursor (signalDependencies status) 3 6
    idle = refreshAll batch [] 99 99
    checkAll "selective reactive views" [
        structuralEquals [first.status.value, changedCount.counter.value] ["count=1/cursor=2", "count=7"],
        structuralEquals [changedCount.cursor.value, changedCount.status.value] ["cursor=2", "count=7/cursor=9"],
        structuralEquals [changedCursor.counter.value, changedCursor.cursor.value] ["count=7", "cursor=4"],
        structuralEquals [changedCursor.status.value, batch.counter.value] ["count=8/cursor=4", "count=3"],
        structuralEquals [batch.cursor.value, idle.footer.value] ["cursor=6", "ready"],
        structuralEquals [changedCount.footer.revision, changedCount.counter.revision] [1, 2],
        structuralEquals [changedCount.cursor.revision, batch.status.revision] [1, 4],
        structuralEquals [idle.status.revision, idle.footer.revision] [4, 1],
        idle.status.value == batch.status.value,
    ]

conservativeBranches () =
    first = underSignals (1, 2, \() => signalSnapshot (\() => branch true))
    changed = underSignals (5, 9, \() => signalRefresh first (signalDependencies cursor) (\() => branch true))
    checkAll "may-read includes an inactive branch" [
        structuralEquals [length first.dependencies, changed.revision] [2, 2],
        structuralEquals [first.value, changed.value] ["count=1", "count=5"],
    ]

callbackReplacementAndUnknown () =
    first = underCount (1, \() => signalSnapshot counterLabel)
    replacement =
        handle static Signal<Cursor>
            read => Cursor(at = 8)
        signalRefresh first [] cursorLabel
    unknown = underCount (3, \() => relay (\() => signalSnapshot counterLabel))
    checkAll "callback replacement updates dependencies" [
        structuralEquals [replacement.value, unknown.value] ["cursor=8", "count=3"],
        replacement.revision == 2,
        tracksDeps (replacement.dependencies, signalDependencies cursorLabel),
    ]

rowsStayOpen callback = signalSnapshot callback
unknownRefresh old callback = signalRefresh old [] callback
unresolvedCallbacksRebuild () =
    first = rowsStayOpen (\() => "first")
    next = unknownRefresh first (\() => "next")
    checkAll "unknown dependencies invalidate conservatively" [
        structuralEquals [join first.dependencies ";", first.value, next.value] ["<unknown>", "first", "next"],
        next.revision == 2,
    ]

keptValues () = [counterLabel (), "kept"]
managedValues () =
    first = snapshotOf keptValues
    next = refreshedFrom (first, keptValues)
    checkAll "snapshots own managed values independently" [
        structuralEquals [join first.value ",", join next.value ","] ["count=2,kept", "count=4,kept"],
        rebuiltOnce (first, next),
    ]

effect Audit
    note : string => Unit
tracked () =
    perform Audit.note "build;"
    counterLabel ()
factory () =
    perform Audit.note "factory;"
    tracked
evaluationAndNoOp () =
    mut trail = ""
    handle Audit
        note text =>
            trail := "${trail}${text}"
    first = underCount (2, \() => signalSnapshot (factory ()))
    idle = underCount (9, \() => signalRefresh first [] (factory ()))
    metadata = signalDependencies (factory ())
    checkAll "arguments run once and clean caches skip their callback" [
        structuralEquals [trail, first.value, idle.value] ["factory;build;factory;factory;", "count=2", "count=2"],
        idle.revision == 1, tracksDeps (metadata, signalDependencies count)
    ]

unresolvedChangesRebuild () =
    first = signalSnapshot (\() => "first")
    next = signalRefresh first ["<unknown>"] (\() => "next")
    checkAll "unknown changes invalidate conservatively" [
        structuralEquals [first.value, next.value] ["first", "next"],
        next.revision == 2
    ]

(** The count label answered as a success. *)
allowedLabel () = Success(value = counterLabel ())

(** The denial a refused signal read answers. *)
deniedLabel () = Error(message = "denied")

(** The payload `result` carries, whichever variant it holds. *)
answerOf result = match result
    Success value => value
    Error message => message

cachedResultsKeepBothVariants () =
    first = snapshotOf allowedLabel
    next = refreshedFrom (first, deniedLabel)
    checkAll "cached results preserve success and error payloads" [
        structuralEquals [answerOf first.value, answerOf next.value] ["count=2", "denied"],
        rebuiltOnce (first, next)
    ]

capturedLabel () =
    saved = counterLabel ()
    \() => saved
callableSnapshotsKeepTheirCapturedValues () =
    first = snapshotOf capturedLabel
    idle = underCount (9, \() => signalRefresh first [] capturedLabel)
    next = refreshedFrom (idle, capturedLabel)
    checkAll "callable snapshots own their captured values" [first.value () == "count=2", idle.value () == "count=2", next.value () == "count=4", first.revision == 1, idle.revision == 1, next.revision == 2]

testCases [
    { name = "reactive views rebuild selectively through helpers", work = selectiveRebuild },
    { name = "inactive branches remain possible dependencies", work = conservativeBranches },
    { name = "changing a callback updates its dependency set", work = callbackReplacementAndUnknown },
    { name = "unknown rows rebuild rather than miss a change", work = unresolvedCallbacksRebuild },
    { name = "old and new snapshots keep their managed values", work = managedValues },
    { name = "arguments run once while clean computations stay cached", work = evaluationAndNoOp },
    { name = "unknown changes cannot retain a stale snapshot", work = unresolvedChangesRebuild },
    { name = "cached results retain whole variants across rebuilds", work = cachedResultsKeepBothVariants },
    { name = "cached callables retain their captured values across rebuilds", work = callableSnapshotsKeepTheirCapturedValues }
]

(** A rebuild is an ordinary record wherever it flows: passed into a call, from
    either arm of a match, it keeps its layout (#272). *)
type Region =
    region : string
    dependencies : List<string>
    revision : int
    json : string
describeSnapshot next = "${next.value}@${next.revision}"
named (key, next) = Region(region = key, dependencies = next.dependencies, revision = next.revision, json = next.value)
blankSnapshot () = { dependencies = ["<unknown>"], revision = 0, value = "" }

(** The blank snapshot refreshed once under the current count signal. *)
refreshedBlank () = signalRefresh (blankSnapshot ()) [] counterLabel

(** The refreshed blank snapshot described while the count signal reads `n`. *)
describedBlank n = underCount (n, \() => describeSnapshot (refreshedBlank ()))

pickRow (cached, flag) =
    row = match flag
        true => { revision = 1, value = "fresh" }
        false => cached
    describeSnapshot row
refreshArgumentsKeepTheirLayout () =
    first = snapshotOf counterLabel
    direct = describedBlank 3
    built = underCount (3, \() => named ("list", refreshedBlank ()))
    kept = underCount (9, \() => named ("kept", signalRefresh first [] counterLabel))
    bound = describedBlank 4
    snapshot = underCount (5, \() => describeSnapshot (signalSnapshot counterLabel))
    print "refresh arguments: ${direct} ${built.region}=${built.json}@${built.revision} ${kept.region}=${kept.json}@${kept.revision} ${bound} ${snapshot} ${describeSnapshot first}"
    checkAll "refreshed snapshots keep their record layout as call arguments" [
        structuralEquals [direct, built.region, built.json, kept.region] ["count=3@1", "list", "count=3", "kept"],
        structuralEquals [kept.json, bound, snapshot] ["count=2", "count=4@1", "count=5@1"],
        describeSnapshot first == "count=2@1",
        structuralEquals [pickRow ({ revision = 9, value = "cached" }, false), pickRow ({ revision = 9, value = "cached" }, true)] ["cached@9", "fresh@1"],
        structuralEquals [built.revision, kept.revision] [1, 1],
        tracksDeps (built.dependencies, signalDependencies counterLabel),
        tracksDeps (kept.dependencies, first.dependencies),
    ]

test "refreshed snapshots keep their layout as call arguments" refreshArgumentsKeepTheirLayout
