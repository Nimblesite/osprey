(** One transformer block written once against a static `Tensor` effect and
    run by two interpretations: a handler over plain lists and a handler over
    GPU buffers. The model never names a buffer type; the handler decides how
    each operation executes, and both answers must agree bit for bit with each
    other and with the oracle values src/osprey/tests/core/gpu/transformer pins.
    Implements [STAGE-BACKEND], [STAGE-POLY], [EFFECTS-GENERIC-INSTANTIATION],
    [GPU-KERNEL-PURE]. *)

namespace backends

(** The statically selected tensor dialect used by both interpretations. *)
module Backends
    (** [FAILURE-EXPLICIT] Continue only after Success; preserve the original Error. *)
    export andThen (result, next) = match result
        Success value => next value
        Error message => Error(message = message)
    (** The dense-tensor dialect a model is written in. `B` is the buffer
        representation an interpretation chooses; the model leaves it to
        inference everywhere. *)
    (** The buffer-producing operations answer with a `Result` [FAILURE-EXPLICIT]:
        an interpretation that runs them on a device has a failure channel, and the
        list interpretation answers `Success`. *)
    export static effect Tensor B
        build : (int, (int) -> float) => Result<B, Error>
        get : (B, int) => float
        length : B => int
        zipWith : (B, B, (float, float) -> float) => Result<B, Error>
        reduce : (B, float, (float, float) -> float) => Result<float, Error>
        matMul : (B, B, int, int, int) => Result<B, Error>
        fromList : List<float> => Result<B, Error>
        device : Unit => string

    (** Every operation as host list code; the product accumulates in k order from 0.0. *)
    export onLists work =
        handle static Tensor<List<float>>
            build n f => Success(value = range 0 n |> map f |> toList)
            get b i => listGet b i ?: 0.0
            length b => listLength b
            zipWith a b f => Success(value = range 0 (listLength a) |> map (\i => f (listGet a i ?: 0.0, listGet b i ?: 0.0)) |> toList)
            reduce b seed f => Success(value = range 0 (listLength b) |> fold seed (\(a, i) => f (a, listGet b i ?: 0.0)))
            matMul a b rows inner cols => Success(value = range 0 (rows * cols) |> map (\i => range 0 inner |> fold 0.0 (\(acc, k) => acc + (listGet a (intDiv i cols * inner + k) ?: 0.0) * (listGet b (k * cols + i % cols) ?: 0.0))) |> toList)
            fromList xs => Success(value = xs)
            device => "lists"
        work ()

    (** Every operation as a GPU kernel or product; the arms forward the model's callbacks. *)
    export onGpu work =
        handle static Tensor<GpuBuffer<float>>
            build n f => andThen(toGpu(range(0, n)), \xs => gpuMap(xs, f))
            get b i => gpuGet b i ?: 0.0
            length b => gpuLength b
            zipWith a b f => gpuZipWith a b f
            reduce b seed f => gpuFold b seed f
            matMul a b rows inner cols => gpuMatMul a b rows inner cols
            fromList xs => toGpu xs
            device => gpuDevice ()
        work ()

width = 4
widthF = 4.0
heads = 2
headWidth = 2
qkvWidth = 12
mlpWidth = 8
vocab = 5
epsilon = 0.00001
scoreScale = 0.5
geluScale = 0.7978845608028654
geluCubic = 0.044715
tolerance = 0.000000001

(** [FAILURE-EXPLICIT] Report a failed tensor operation and answer `fallback`. *)
tensorFailed (message, fallback) =
    check ("tensor operation", "success", toString message)
    fallback
(** [FAILURE-EXPLICIT] A failed tensor operation fails the case with its reason, answering `fallback`. *)
settledAs (result, fallback, work) = match result
    Success value => work value
    Error message => tensorFailed (message, fallback)
(** [FAILURE-EXPLICIT] A failed tensor operation fails the predicate with its reason. *)
tensorSatisfies (result, predicate) = settledAs (result, false, predicate)
(** [FAILURE-EXPLICIT] A case ends here; a failure has already failed an assertion. *)
settled result = settledAs (result, 0, \_value => 0)
(** [FAILURE-EXPLICIT] The same for a string-producing case: the empty text can never equal the expected rendering, so a failure cannot pass. *)
settledText result = settledAs (result, "", \value => value)
at (m, i) = perform Backends::Tensor.get m i
size m = perform Backends::Tensor.length m
vector xs = perform Backends::Tensor.fromList xs
device () = perform Backends::Tensor.device ()
product (a, b, rows, inner, cols) = perform Backends::Tensor.matMul a b rows inner cols
total b = perform Backends::Tensor.reduce b 0.0 addF
maxF (a, x) = match x > a
    true => x
    false => a
near (actual, expected) = abs (actual - expected) < tolerance
gelu x = 0.5 * x * (1.0 + tanh (geluScale * (x + geluCubic * x * x * x)))
(** Every element of x through gelu, as a new buffer. *)
smoothed x = perform Backends::Tensor.build (size x) (\i => gelu (at (x, i)))

(** Deterministic test weights: ((i * step) % modulus - shift) / scale for element i. *)
weight (n, step, modulus, shift, scale) = perform Backends::Tensor.build n (\i => toFloat ((i * step) % modulus - shift) / scale)
(** One parameter's weight spec: `weight` of `n` elements by (step, modulus, shift, scale). *)
weightSpec (n, step, modulus, shift, scale) = { n = n, step = step, modulus = modulus, shift = shift, scale = scale }
(** Each block parameter's weight spec, in field order, built in turn and bundled. *)
paramSpecs () = [
    weightSpec (width, 3, 5, 1, 2.0), weightSpec (width, 5, 7, 3, 4.0), weightSpec (width * qkvWidth, 7, 11, 5, 8.0), weightSpec (qkvWidth, 3, 7, 3, 8.0), weightSpec (width * width, 5, 13, 6, 8.0), weightSpec (width, 7, 5, 2, 4.0),
    weightSpec (width, 7, 9, 4, 4.0), weightSpec (width, 2, 5, 2, 8.0), weightSpec (width * mlpWidth, 11, 13, 6, 8.0), weightSpec (mlpWidth, 5, 11, 5, 8.0), weightSpec (mlpWidth * width, 13, 17, 8, 16.0), weightSpec (width, 3, 7, 3, 4.0)
]
buildParams specs = foldList specs (Success(value = [])) (\(acc, spec) => Backends::andThen(acc, \built => Backends::andThen(weight (spec.n, spec.step, spec.modulus, spec.shift, spec.scale), \value => Success(value = listAppend built value))))
unpackParams ws = match ws
    [ln1gain, ln1bias, qkvWeight, qkvBias, projWeight, projBias, ln2gain, ln2bias, fcWeight, fcBias, outWeight, outBias] => Success(value = { ln1gain = ln1gain, ln1bias = ln1bias, qkvWeight = qkvWeight, qkvBias = qkvBias, projWeight = projWeight, projBias = projBias, ln2gain = ln2gain, ln2bias = ln2bias, fcWeight = fcWeight, fcBias = fcBias, outWeight = outWeight, outBias = outBias })
    _ => Error(message = "twelve block parameters")
blockParams () = Backends::andThen(buildParams (paramSpecs ()), unpackParams)

sumRange (x, start, n) = range start (start + n) |> fold 0.0 (\(a, i) => a + at (x, i))
squaredDeviation (x, start, n, mean) = range start (start + n) |> fold 0.0 (\(a, i) => a + (at (x, i) - mean) * (at (x, i) - mean))
rowMeans (x, t) = perform Backends::Tensor.build t (\r => sumRange (x, r * width, width) / widthF)
rowVariances (x, t, means) = perform Backends::Tensor.build t (\r => squaredDeviation (x, r * width, width, at (means, r)) / widthF)
normalised (x, means, variances, g, b, i) = (at (x, i) - at (means, intDiv i width)) / sqrt (at (variances, intDiv i width) + epsilon) * at (g, i % width) + at (b, i % width)

(** LayerNorm over each of the t rows of x [t, width]. *)
layerNorm (x, t, g, b) =
    Backends::andThen(rowMeans(x, t),
        \means => Backends::andThen(rowVariances(x, t, means),
            \variances => perform Backends::Tensor.build (t * width) (\i => normalised(x, means, variances, g, b, i))))

(** x [rows, inner] times w [inner, cols], plus the bias on every row. *)
linear (x, rows, inner, cols, w, bias) =
    Backends::andThen(product(x, w, rows, inner, cols),
        \value => perform Backends::Tensor.build (rows * cols) (\i => at(value, i) + at(bias, i % cols)))

(** Element d of head h of row r, in the q, k or v slice at `offset`. *)
headAt (qkv, offset, r, h, d) = at (qkv, r * qkvWidth + offset + h * headWidth + d)
score (qkv, h, r, c) = (range 0 headWidth |> fold 0.0 (\(a, d) => a + headAt (qkv, 0, r, h, d) * headAt (qkv, width, c, h, d))) * scoreScale
causalScore (qkv, h, r, c) = match c <= r
    true => score (qkv, h, r, c)
    false => 0.0
rowMax (scores, row, t) = range 0 (row % t + 1) |> fold (at (scores, row * t)) (\(a, c) => maxF (a, at (scores, row * t + c)))
causalWeight (scores, peaks, t, i) = match i % t <= intDiv i t % t
    true => exp (at (scores, i) - at (peaks, intDiv i t))
    false => 0.0
weighted (probs, qkv, t, r, h, d) = range 0 (r + 1) |> fold 0.0 (\(a, c) => a + at (probs, (h * t + r) * t + c) * headAt (qkv, 2 * width, c, h, d))

(** Softmax of every causal row of the [heads, t, t] scores. *)
probsOf (scores, t) =
    Backends::andThen(perform Backends::Tensor.build (heads * t) (\row => rowMax(scores, row, t)),
        \peaks => Backends::andThen(perform Backends::Tensor.build (heads * t * t) (\i => causalWeight(scores, peaks, t, i)),
            \weights => Backends::andThen(perform Backends::Tensor.build (heads * t) (\row => sumRange(weights, row * t, t)),
                \sums => perform Backends::Tensor.build (heads * t * t) (\i => at(weights, i) / at(sums, intDiv(i, t))))))

(** Causal multi-head self-attention over qkv [t, qkvWidth], as [t, width]. *)
attention (qkv, t) =
    Backends::andThen(perform Backends::Tensor.build (heads * t * t) (\i => causalScore(qkv, intDiv(i, t * t), intDiv(i % (t * t), t), i % t)),
        \scores => Backends::andThen(probsOf(scores, t),
            \probs => perform Backends::Tensor.build (t * width) (\i => weighted(probs, qkv, t, intDiv(i, width), intDiv(i % width, headWidth), i % headWidth))))

subLayer (x, gain, bias, body, t) =
    Backends::andThen(layerNorm(x, t, gain, bias),
        \normed => Backends::andThen(body (normed, t),
            \out => perform Backends::Tensor.zipWith (x) (out) (addF)))
(** A linear map into `wide` columns, `mid` answering `midOut` columns, then a
    linear map back to `width` columns, plus the bias on every row. *)
mappedLinear (x, t, wide, midOut, inW, inB, mid, outW, outB) =
    Backends::andThen(linear(x, t, width, wide, inW, inB),
        \grown => Backends::andThen(mid grown,
            \hidden => linear(hidden, t, midOut, width, outW, outB)))
attended (x, w, t) = mappedLinear(x, t, qkvWidth, width, w.qkvWeight, w.qkvBias, \qkv => attention(qkv, t), w.projWeight, w.projBias)
feedForward (x, w, t) = mappedLinear(x, t, mlpWidth, mlpWidth, w.fcWeight, w.fcBias, smoothed, w.outWeight, w.outBias)
(** One pre-norm block: attention and MLP, each with a residual. *)
block (x, t) = Backends::andThen(blockParams(),
    \w => Backends::andThen(subLayer (x, w.ln1gain, w.ln1bias, \(v, n) => attended (v, w, n), t),
        \x2 => subLayer (x2, w.ln2gain, w.ln2bias, \(v, n) => feedForward (v, w, n), t)))

(** Token plus position embeddings of the host-side ids, [t, width]. *)
embed (tokens, positions, ids, t) = perform Backends::Tensor.build (t * width) (\i => at (tokens, (listGet ids (intDiv i width) ?: 0) * width + i % width) + at (positions, i))
blockOutput () =
    Backends::andThen(weight (vocab * width, 9, 17, 8, 4.0),
        \tokens => Backends::andThen(weight (3 * width, 4, 9, 4, 8.0),
            \positions => Backends::andThen(embed(tokens, positions, [3, 1], 2),
                \x => block(x, 2))))
rendered y = range 0 (size y) |> fold "" (\(acc, i) => acc + " " + toString (at (y, i)))

(** The oracle values of the block, element by element. *)
oracle = [ -1.6005739040598597, 1.6570609567125532, 0.7819120177177687, 2.600026966458822, -1.4874618953251921, 0.04813056859620782, -0.6083624491502386, 1.4214195552139615 ]

(** Element i of y against the oracle: a missing oracle is never near a real element. *)
oracleAt (y, i) = near (at (y, i), listGet oracle i ?: 0.0)
(** Every oracle element of y, checked one element at a time. *)
oracleRow y = range 0 (listLength oracle) |> fold true (\(held, i) => held && oracleAt (y, i))

(** The oracle values of the block, plus which interpretation answered. *)
blockChecks (name, expectedDevice) =
    Backends::andThen(blockOutput(),
        \y =>
            checkAll(name, [ size(y) == 8, device() == expectedDevice, oracleRow y, tensorSatisfies(total(y), \grand => near(grand, 2.8121518161640227)) ])
            Success(value = 0) )

listsCase () = settled (Backends::onLists (\() => blockChecks ("the block over lists matches the reference pass", "lists")))
gpuCase () = settled (Backends::onGpu (\() => blockChecks ("the same block over GPU buffers matches the reference pass", "host")))

(** Both interpretations print every element identically: the products
    accumulate in the same order, so the answers are the same doubles. *)
listsText () =
    Backends::andThen(blockOutput(),
        \y => Success(value = rendered(y)))
agreementCase () =
    Backends::andThen(Backends::onLists(listsText),
        \lists => Backends::andThen(Backends::onGpu(listsText),
            \gpu =>
                checkAll("both interpretations compute the same doubles", [ lists == gpu, lists != "", length(lists) > 8 * 4 ])
                Success(value = 0) ))

agreementSettled () =
    settled(agreementCase())

(** A request that leaves its instantiation to inference is answered by the
    innermost region, through helpers that never name a buffer type. *)
inferenceCase () = checkAll "an inferred instantiation selects the innermost region" [
    Backends::onLists (\() => Backends::onGpu device) == "host",
    Backends::onGpu (\() => Backends::onLists device) == "lists",
    Backends::onGpu (\() => tensorSatisfies (vector [1.0, 2.0], \uploaded => at (uploaded, 1) == 2.0)),
    Backends::onLists (\() => tensorSatisfies (vector [1.0, 2.0, 3.0], \t => tensorSatisfies (total t, \grand => grand == 6.0)))
]

(** A static arm forwards the model's callback to the kernel it builds: an
    inline lambda, a named function and a closure over a local all run. *)
doubled n = perform Backends::Tensor.build n (\i => toFloat i * 2.0)
scaled (n, scale) = perform Backends::Tensor.build n (\i => toFloat i * scale)
(** The scaled kernel closure over the local scale, checked at one element. *)
scaledCase scale = tensorSatisfies (scaled (2, scale), \t => at (t, 1) == 3.0)
(** Two uploaded vectors multiplied into one product, checked at one element. *)
productCase () = tensorSatisfies (vector [1.0, 2.0, 3.0, 4.0], \left => tensorSatisfies (vector [5.0, 6.0, 7.0, 8.0], \right => tensorSatisfies (product (left, right, 2, 2, 2), \assembled => at (assembled, 3) == 50.0)))
forwardedKernelCase () =
    scale = 3.0
    checkAll "a static arm forwards the model's callback to its kernel" [
        Backends::onGpu (\() => tensorSatisfies (doubled 3, \t => at (t, 2) == 4.0)),
        Backends::onGpu (\() => tensorSatisfies (vector [1.0, 2.0], \uploaded => tensorSatisfies (smoothed uploaded, \t => at (t, 1) == gelu 2.0))),
        Backends::onGpu (\() => scaledCase scale),
        Backends::onLists (\() => scaledCase scale),
        Backends::onGpu productCase,
        Backends::onLists productCase
    ]

(** An operation's declared callback type survives discharge inside a generic
    function: a kernel that returns a parameter, or a parameter times a
    literal, is checked against `fn(float, float) -> float` and keeps that type
    in the residual — instead of being re-inferred polymorphic and reading each
    float back as a raw word. *)
firstOf (a, b) = perform Backends::Tensor.zipWith a b (\(g, _x) => g)
secondDoubled (a, b) = perform Backends::Tensor.zipWith a b (\(_g, x) => x * 2.0)
declaredTypes () =
    Backends::andThen(doubled(3),
        \first => Backends::andThen(scaled(3, 3.0),
            \second => Backends::andThen(firstOf(first, second),
                \heads => Backends::andThen(total(heads),
                    \headTotal => Backends::andThen(secondDoubled(first, second),
                        \doubles => Backends::andThen(total(doubles),
                            \doubleTotal => Success(value = "${headTotal} ${doubleTotal}")))))))
declaredTypesCase () = checkAll "a kernel keeps the operation's declared element types inside a generic function" [
    settledText (Backends::onGpu(declaredTypes)) == "6.0 18.0",
    settledText (Backends::onLists(declaredTypes)) == "6.0 18.0"
]

test "the block over lists matches the reference pass" (exactly listsCase)
test "the same block over GPU buffers matches the reference pass" (exactly gpuCase)
test "both interpretations compute the same doubles" (exactly agreementSettled)
test "an inferred instantiation selects the innermost region" (exactly inferenceCase)
test "a static arm forwards the model's callback to its kernel" (exactly forwardedKernelCase)
test "a kernel keeps the operation's declared element types inside a generic function" (exactly declaredTypesCase)
