/// RecoveryError models expected failures whose handlers supply ordinary values.
effect RecoveryError {
    /// Supply the integer for the absent field `name`.
    missingInt: fn(string) -> int
    /// Supply the text for the absent field `name`.
    missingText: fn(string) -> string
    /// Decide whether `name` is permitted.
    denied: fn(string) -> bool
    /// Record a recovery without changing what the caller receives.
    report: fn(string) -> Unit
}

/// StockError lets callers choose what an over-sized request receives.
effect StockError {
    /// Decide what an over-sized request receives given `wanted` and `available`.
    shortage: fn(int, int) -> int
}

/// PolicyError exposes two operations so a nested handler can override only one.
effect PolicyError {
    /// Supply the score for `label` under the active policy.
    score: fn(string) -> int
    /// Supply the display text for `label` under the active policy.
    label: fn(string) -> string
}

/// AuditError records recovery decisions without changing the recovered value.
effect AuditError {
    /// Record that a recovery happened, without altering it.
    note: fn(string) -> Unit
}

/// LookupError returns a complete Result so the handler chooses success or failure.
effect LookupError {
    /// Look up `key`, reporting absence as a `Result` the caller matches on.
    find: fn(string) -> Result<int, string>
}

/// Return positive input unchanged and ask for a replacement only at zero.
fn requirePositive(value) !RecoveryError = match value > 0 {
    true => value
    false => perform RecoveryError.missingInt("positive value required")
}

/// Continue ordinary arithmetic after a handler substitutes a missing integer.
fn continuedValue(value) ![RecoveryError, Arith] = requirePositive(value) + 2 

/// Request three replacements so handler state and substitution order are visible.
fn recoverThree() ![RecoveryError, Arith] = {
    let first = perform RecoveryError.missingInt("first")
    let second = perform RecoveryError.missingInt("second")
    let third = perform RecoveryError.missingInt("third")
    first + second + third 
}

/// Report one broken rule while returning Unit so later checks still execute.
fn reportIf(broken: bool) -> (string) -> Unit !RecoveryError = fn(message) => match broken {
        true => perform RecoveryError.report(message)
        false => {}
    }

/// Run every validation rule and return only after all reports have been handled.
fn validateRecord(name: string) -> (int) -> (string) -> string !RecoveryError =
    fn(age) => fn(email) => {
        reportIf(name == "")("name")
        reportIf(age < 0)("age")
        reportIf(email == "")("email")
        reportIf(!contains(email, "@"))("at-sign")
        "finished"
    }

/// Consume integer, string, and boolean results supplied by one handler region.
fn mixedRecovery() !RecoveryError = {
    let number = perform RecoveryError.missingInt("number")
    let text = perform RecoveryError.missingText("text")
    let allowed = perform RecoveryError.denied("permission")
    "${toString(number)}|${text}|${toString(allowed)}"
}

/// Ask the active stock policy how much can be allocated after a shortage.
fn allocate(requested: int) -> (int) -> int !StockError = fn(available) => match requested > available {
        true => perform StockError.shortage(requested, available)
        false => requested
    }

/// Add fixed packaging work after the shared allocation function recovers.
fn shipmentTotal() ![StockError, Arith] = allocate(9)(5) + 2 

/// Recover an integer, audit both sides of the perform, and then keep computing.
fn auditedRecovery() ![RecoveryError, AuditError, Arith] = {
    let value = perform RecoveryError.missingInt("token")
    perform AuditError.note("body saw ${toString(value)}")
    value + 1 
}

/// Perform the deeply nested failure at the bottom of the helper chain.
fn bottomValue() !RecoveryError = perform RecoveryError.missingInt("bottom")

/// Carry one recovered value back through every recursive caller.
fn descend(depth) ![RecoveryError, Arith] = match depth {
    0 => bottomValue()
    _ => 1 + descend((depth - 1) ) 
}

/// Default the complete Result returned by the effect operation.
fn lookupValue(key) !LookupError = perform LookupError.find(key) ?: ((0 - 1) )

/// Combine both Result branches after one handler supplies their whole values.
fn combineLookups() ![LookupError, Arith] = lookupValue("known") * 10 + lookupValue("missing") 

/// Verify that successful code never enters an installed recovery arm.
fn happyPathBypassCase() = {
    mut recoveries = 0
    let value = {
        handle RecoveryError {
            missingInt _reason => {
                recoveries = recoveries + 1 
                99
            }
        }
        requirePositive(7)
    }

    // The original value survives and the handler remains untouched.
    checkAll("happy path bypass", [
        structuralEquals([value, recoveries], [7, 0]),
        value != 99
    ])
}

/// Verify that a direct arm substitutes a value and the caller keeps running.
fn fallbackContinuationCase() = {
    let value = {
        handle RecoveryError {
            missingInt _reason => 40
        }
        continuedValue(0)
    }

    // Arithmetic after perform sees the handler's replacement.
    checkAll("fallback and continuation", [
        value == 42,
        value > 40,
        value != 40
    ])
}

/// Verify repeated recoveries share state and return distinct replacements.
fn repeatedRecoveryStateCase() = {
    mut recoveries = 0
    mut reasons = ""
    let total = {
        handle RecoveryError {
            missingInt reason => {
                recoveries = recoveries + 1 
                reasons = "${reasons}${reason}|"
                recoveries * 10 
            }
        }
        recoverThree()
    }

    // Each call observes the updated handler-owned counter.
    checkAll("repeated recovery state", [
        structuralEquals([total, recoveries], [60, 3]),
        reasons == "first|second|third|",
        total == (10 + 20 + 30 )
    ])
}

/// Verify Unit-valued reports collect every error without stopping validation.
fn collectAllReportsCase() = {
    mut reports = 0
    mut fields = ""
    let result = {
        handle RecoveryError {
            report field => {
                reports = reports + 1 
                fields = "${fields}${field}|"
            }
        }
        validateRecord("")((0 - 3) )("")
    }

    // Validation reaches its final value after all four broken rules report.
    checkAll("collect all reports", [
        structuralEquals([result, fields], ["finished", "name|age|email|at-sign|"]),
        reports == 4,
        contains(fields, "age|")
    ])
}

/// Verify one direct handler supplies several declared operation result types.
fn multipleResultTypesCase() = {
    let rendered = {
        handle RecoveryError {
            missingInt _reason => 7
            missingText _reason => "fallback"
            denied _reason => true
        }
        mixedRecovery()
    }

    // Integer, string, and boolean replacements retain their declared types.
    checkAll("multiple operation result types", [
        rendered == "7|fallback|true",
        startsWith(rendered, "7|"),
        endsWith(rendered, "|true")
    ])
}

/// Verify the same effectful function can run under two local recovery policies.
fn twoPoliciesCase() = {
    let skipped = {
        handle StockError {
            shortage _requested _available => 0
        }
        shipmentTotal()
    }
    let capped = {
        handle StockError {
            shortage _requested available => available
        }
        shipmentTotal()
    }

    // Skip and cap policies change only the handled shortage decision.
    checkAll("two policies over one function", [
        structuralEquals([skipped, capped, (capped - skipped )], [2, 7, 5]),
        capped > skipped
    ])
}

/// Verify an inner same-effect arm overrides one operation and then disappears.
fn nestedOverrideCase() = {
    let rendered = {
        handle PolicyError {
            score _key => 10
            label _key => "outer"
        }
        let before = perform PolicyError.score("before")
        let inside = {
            handle PolicyError {
                score _key => 99
            }
            let innerScore = perform PolicyError.score("inside")
            let inheritedLabel = perform PolicyError.label("inside")
            "${toString(innerScore)}:${inheritedLabel}"
        }
        let after = perform PolicyError.score("after")
        "${toString(before)}|${inside}|${toString(after)}"
    }

    // The inner score wins, the outer label remains reachable, and score restores.
    checkAll("nested override and restoration", [
        rendered == "10|99:outer|10",
        contains(rendered, "99:outer"),
        endsWith(rendered, "|10")
    ])
}

/// Verify a recovery arm and the continued body can both reach an outer effect.
fn outerEffectCompositionCase() = {
    mut notes = ""
    mut noteCount = 0
    let result = {
        handle AuditError {
            note message => {
                noteCount = noteCount + 1 
                notes = "${notes}${message}|"
            }
        }
        handle RecoveryError {
            missingInt reason => {
                perform AuditError.note("handler saw ${reason}")
                41
            }
        }
        auditedRecovery()
    }

    // The outer audit observes the handler decision and the resumed caller work.
    checkAll("outer effect composition", [
        structuralEquals([result, noteCount], [42, 2]),
        notes == "handler saw token|body saw 41|",
        contains(notes, "body saw 41")
    ])
}

/// Verify dynamic handling reaches through helpers and recursive calls.
fn deepRecursionCase() = {
    mut recoveries = 0
    let value = {
        handle RecoveryError {
            missingInt _reason => {
                recoveries = recoveries + 1 
                8
            }
        }
        descend(4)
    }

    // One bottom-level replacement returns through all four recursive frames.
    checkAll("deep helper recursion", [
        structuralEquals([value, recoveries, (value - 8 )], [12, 1, 4])
    ])
}

/// A direct arm returning a whole `Result` must deliver that exact value.
fn wholeResultOperationCase() = {
    mut lookups = 0
    let combined = {
        handle LookupError {
            find key => {
                lookups = lookups + 1 
                match key {
                    "known" => Success { value: 4 }
                    _ => Error { message: "absent" }
                }
            }
        }
        combineLookups()
    }

    // Both arms travel as complete Result blocks: Success{4} scales to 40 and
    // Error{"absent"} matches to its 6-character length.
    checkAll("whole Result operation values", [
        structuralEquals([combined, lookups], [39, 2])
    ])
}

/// Spare is the record a direct arm must hand back whole.
type Spare = { tag: string, weight: float, ready: bool }

/// Grade is the tagged union a direct arm must hand back with its payload intact.
type Grade = Granted { score: int } | Refused { reason: string }

/// ValueError declares one operation per result type a direct arm may supply.
effect ValueError {
    /// Supply the integer replacement for `field`.
    asInt: fn(string) -> int
    /// Supply the float replacement for `field`.
    asFloat: fn(string) -> float
    /// Supply the boolean decision for `field`.
    asBool: fn(string) -> bool
    /// Supply the text replacement for `field`.
    asText: fn(string) -> string
    /// Supply the record replacement for `field`.
    asSpare: fn(string) -> Spare
    /// Supply the tagged grade for `field`.
    asGrade: fn(string) -> Grade
    /// Supply the whole Result for `field`.
    asResult: fn(string) -> Result<int, string>
    /// Record a recovery without changing what the caller receives.
    mark: fn(string) -> Unit
}

/// Fold both Grade constructors into one integer so the payload is observable.
fn gradeScore(grade) = match grade {
    Granted { score } => score
    Refused { reason } => 0 - length(reason) 
}

/// Fold both Result constructors into one integer so the payload is observable.
fn resultScore(outcome) = match outcome {
    Success { value } => value
    Error { message } => length(message)
}

/// Perform every declared ValueError operation once and render what came back.
fn everyValue() ![ValueError, Arith] = {
    let n = perform ValueError.asInt("count")
    let f = perform ValueError.asFloat("ratio")
    let b = perform ValueError.asBool("allowed")
    let t = perform ValueError.asText("name")
    let s = perform ValueError.asSpare("spare")
    let g = perform ValueError.asGrade("grade")
    let r = perform ValueError.asResult("lookup")
    perform ValueError.mark("rendered")
    let heavy = f + s.weight > 4.0
    let graded = gradeScore(g)
    let looked = resultScore(r)
    "${toString(n)}|${t}|${toString(b)}|${s.tag}|${toString(heavy)}|${toString(graded)}|${toString(looked)}"
}

/// TierError exposes three operations so complementary partial handlers can split them.
effect TierError {
    /// Supply the base amount for `label`.
    base: fn(string) -> int
    /// Supply the bonus amount for `label`.
    bonus: fn(string) -> int
    /// Supply the tier name for `label`.
    tier: fn(string) -> string
}

/// Draw all three TierError channels in a pinned order and render one quote.
fn tierQuote(label) ![TierError, Arith] = {
    let amount = perform TierError.base(label)
    let extra = perform TierError.bonus(label)
    let name = perform TierError.tier(label)
    let combined = amount + extra 
    "${name}:${toString(combined)}"
}

/// Tally lets a callback ask for a scaled contribution and then record it.
effect Tally {
    /// Supply the scaled contribution for `value`.
    scale: fn(int) -> int
    /// Record one scaled contribution.
    add: fn(int) -> Unit
}

/// Scale one element through the handler and hand the result straight back to it.
fn tallyOne(value) !Tally = {
    let scaled = perform Tally.scale(value)
    perform Tally.add(scaled)
}

/// StepError asks for one contribution per recursion level.
effect StepError {
    /// Supply the contribution for recursion `depth`.
    contribute: fn(int) -> int
}

/// Perform before descending so the visit order is the recursion order.
fn descendSum(depth) ![StepError, Arith] = match depth {
    0 => 0
    _ => {
        let here = perform StepError.contribute(depth)
        here + descendSum((depth - 1) ) 
    }
}

/// Cross four effects in one body so a stack of regions has to cooperate.
fn crossEffectBody() ![RecoveryError, AuditError, StockError, PolicyError] = {
    let filled = perform RecoveryError.missingInt("qty")
    perform AuditError.note("filled ${toString(filled)}")
    let allowed = perform StockError.shortage(filled, 4)
    perform AuditError.note("allowed ${toString(allowed)}")
    let name = perform PolicyError.label("order")
    let rank = perform PolicyError.score("order")
    perform AuditError.note("scored ${toString(rank)}")
    "${name}:${toString(filled)}:${toString(allowed)}:${toString(rank)}"
}

/// TextError supplies replacement text and numbers whose shape the caller inspects.
effect TextError {
    /// Supply the replacement text for `field`.
    fill: fn(string) -> string
    /// Supply the replacement number for `field`.
    number: fn(string) -> int
}

/// Ask for three replacements, twice under the same field name.
fn fillAll() !TextError = {
    let a = perform TextError.fill("a")
    let b = perform TextError.fill("a")
    let c = perform TextError.fill("b")
    "${a}/${b}/${c}"
}

/// Verify every declared operation result type survives direct substitution.
///
/// [EFFECTS-HANDLER-ARMS]: with no `resume` anywhere in the region, "the arm's
/// value substitutes for its operation's declared result". [EFFECTS-OP-TYPING]
/// requires that value to match the operation's declared type, so int, float,
/// bool, string, record, union, `Result` and `Unit` must each arrive intact.
/// The whole-`Result` half is the general form of the transport fixed in
/// [issue #183](https://github.com/Nimblesite/osprey/issues/183).
fn everyResultTypeCase() = {
    mut marks = 0
    mut trail = ""
    let rendered = {
        handle ValueError {
            asInt field => {
                trail = "${trail}i:${field}|"
                12
            }
            asFloat field => {
                trail = "${trail}f:${field}|"
                2.5
            }
            asBool field => {
                trail = "${trail}b:${field}|"
                true
            }
            asText field => {
                trail = "${trail}t:${field}|"
                "fallback"
            }
            asSpare field => {
                trail = "${trail}s:${field}|"
                Spare { tag: "spare", weight: 1.5, ready: true }
            }
            asGrade field => {
                trail = "${trail}g:${field}|"
                Granted { score: 30 }
            }
            asResult field => {
                trail = "${trail}r:${field}|"
                Success { value: 9 }
            }
            mark field => {
                marks = marks + 1 
                trail = "${trail}m:${field}|"
            }
        }
        everyValue()
    }
    let intValue = {
        handle ValueError {
            asInt _field => 0
        }
        perform ValueError.asInt("zero")
    }
    let negativeValue = {
        handle ValueError {
            asInt _field => -41
        }
        perform ValueError.asInt("negative")
    }
    let floatValue = {
        handle ValueError {
            asFloat _field => 2.5
        }
        perform ValueError.asFloat("ratio")
    }
    let boolValue = {
        handle ValueError {
            asBool _field => false
        }
        perform ValueError.asBool("blocked")
    }
    let textValue = {
        handle ValueError {
            asText _field => ""
        }
        perform ValueError.asText("empty")
    }
    let spareValue = {
        handle ValueError {
            asSpare _field => Spare { tag: "left", weight: 1.5, ready: true }
        }
        perform ValueError.asSpare("spare")
    }
    let grantedValue = {
        handle ValueError {
            asGrade _field => Granted { score: 7 }
        }
        perform ValueError.asGrade("good")
    }
    let refusedValue = {
        handle ValueError {
            asGrade _field => Refused { reason: "denied" }
        }
        perform ValueError.asGrade("bad")
    }
    let okValue = {
        handle ValueError {
            asResult _field => Success { value: 5 }
        }
        perform ValueError.asResult("hit")
    }
    let badValue = {
        handle ValueError {
            asResult _field => Error { message: "absent" }
        }
        perform ValueError.asResult("miss")
    }
    let grantedScore = gradeScore(grantedValue)
    let refusedScore = gradeScore(refusedValue)
    let okScore = resultScore(okValue)
    let badScore = resultScore(badValue)

    // Scalar substitutions keep their declared type at the identity, zero and
    // negative boundaries. `-41` is a folded negated literal, so it is a plain
    // `int` and not a `Result` [ARITH-NEG-LITERAL].
    checkAll("scalar operation results cross a direct arm", [
        structuralEquals([intValue, (intValue - negativeValue )], [0, 41]),
        structuralEquals([(negativeValue + 41 ), length(textValue)], [0, 0]),
        intValue != 12,
        negativeValue == -41,
        negativeValue < 0,
        structuralEquals([floatValue, floatValue + 1.5, floatValue * 2.0, floatValue - 2.5], [2.5, 4.0, 5.0, 0.0]),
        floatValue > 2.0,
        floatValue < 3.0,
        boolValue == false,
        !boolValue,
        boolValue != true,
        structuralEquals([textValue, "${textValue}x"], ["", "x"]),
        isEmpty(textValue),
        !contains(textValue, "a")
    ])

    // A record arrives with every field readable and a union arrives with its
    // constructor and payload: `Refused { reason: "denied" }` folds to
    // -length("denied") == -6, so granted - refused == 7 - (-6) == 13.
    checkAll("record and union operation results arrive whole", [
        structuralEquals([spareValue.tag, toUpperCase(spareValue.tag)], ["left", "LEFT"]),
        structuralEquals([spareValue.weight, spareValue.weight + floatValue, spareValue.weight * 2.0], [1.5, 4.0, 3.0]),
        spareValue.ready,
        spareValue.tag != "spare",
        structuralEquals([length(spareValue.tag), grantedScore, length("denied")], [4, 7, 6]),
        structuralEquals([(grantedScore + refusedScore ), (grantedScore - refusedScore )], [1, 13]),
        structuralEquals([gradeScore(Granted { score: 0 }), gradeScore(Refused { reason: "" })], [0, 0]),
        grantedScore > 0,
        refusedScore == -6,
        refusedScore < 0,
        grantedScore != refusedScore,
        gradeScore(Granted { score: -3 }) == -3,
        gradeScore(Refused { reason: "no" }) == -2
    ])

    // A direct arm may choose either `Result` constructor, and the `Unit`
    // channel changes nothing the caller receives beyond handler-owned state.
    checkAll("Result and Unit operation results cross a direct arm", [
        structuralEquals([okScore, badScore, (okScore + badScore ), resultScore(Success { value: 0 })], [5, 6, 11, 0]),
        structuralEquals([resultScore(Error { message: "" }), resultScore(Error { message: "x" })], [0, 1]),
        structuralEquals([(okValue ?: 0), (badValue ?: 0), (badValue ?: 77), marks, (marks * 3 )], [5, 0, 77, 1, 3]),
        okScore != badScore,
        badScore == length("absent"),
        resultScore(Success { value: -2 }) == -2,
        marks != 0,
        endsWith(trail, "m:rendered|")
    ])

    // One region answers all eight operations of one effect in body order.
    // 2.5 + 1.5 > 4.0 is false, the grade folds to 30 and the Result to 9,
    // so the render is "12|fallback|true|spare|false|30|9" (33 characters).
    checkAll("one region answers every operation of one effect", [
        rendered == "12|fallback|true|spare|false|30|9",
        trail == "i:count|f:ratio|b:allowed|t:name|s:spare|g:grade|r:lookup|m:rendered|",
        structuralEquals([length(rendered), marks, length(trail)], [33, 1, 69]),
        structuralEquals([startsWith(rendered, "12|"), endsWith(rendered, "|9")], [true, true]),
        structuralEquals(mapList(["|spare|", "|true|"], fn(k) => contains(rendered, k)), [true, true]),
        structuralEquals(mapList(["2.5", "|13|"], fn(k) => contains(rendered, k)), [false, false]),
        structuralEquals([startsWith(trail, "i:count|"), endsWith(trail, "m:rendered|")], [true, true]),
        structuralEquals(mapList(["|s:spare|", "b:allowed|t:name|"], fn(k) => contains(trail, k)), [true, true]),
        !contains(trail, "|i:count|")
    ])
}

/// Verify partial, nested and complementary handlers split one effect exactly.
///
/// [EFFECTS-STATIC-DISCHARGE]: "Discharge is operation- and
/// instantiation-specific. A handler for `Pair.first` does not discharge
/// `Pair.second` ... Complementary nested partial handlers may each discharge
/// the operation they cover." The handler section adds that "the innermost
/// matching arm wins and an outer arm remains available for operations not
/// handled by the inner region". Handler-owned counters make the routing
/// visible per call [EFFECTS-HANDLER-STATE].
fn partialOverrideLatticeCase() = {
    mut flatCalls = 0
    mut flatTrail = ""
    mut outerBaseCalls = 0
    mut innerBaseCalls = 0
    let flat = {
        handle TierError {
            base label => {
                flatCalls = flatCalls + 1 
                flatTrail = "${flatTrail}base:${label}|"
                100
            }
            bonus label => {
                flatCalls = flatCalls + 1 
                flatTrail = "${flatTrail}bonus:${label}|"
                5
            }
            tier label => {
                flatCalls = flatCalls + 1 
                flatTrail = "${flatTrail}tier:${label}|"
                "gold"
            }
        }
        let first = tierQuote("a")
        let second = tierQuote("b")
        "${first}/${second}"
    }
    let overridden = {
        handle TierError {
            base _label => {
                outerBaseCalls = outerBaseCalls + 1 
                100
            }
            bonus _label => 5
            tier _label => "gold"
        }
        let outside = tierQuote("out")
        let inside = {
            handle TierError {
                base _label => {
                    innerBaseCalls = innerBaseCalls + 1 
                    200
                }
            }
            tierQuote("in")
        }
        let afterwards = tierQuote("post")
        "${outside}|${inside}|${afterwards}"
    }
    let split = {
        handle TierError {
            base _label => 10
        }
        handle TierError {
            bonus _label => 3
        }
        handle TierError {
            tier _label => "silver"
        }
        tierQuote("c")
    }
    let reordered = {
        handle TierError {
            tier _label => "silver"
        }
        handle TierError {
            base _label => 10
        }
        handle TierError {
            bonus _label => 3
        }
        tierQuote("d")
    }
    let deepest = {
        handle TierError {
            base _label => 1
            bonus _label => 0
            tier _label => "bronze"
        }
        handle TierError {
            base _label => 2
        }
        handle TierError {
            base _label => 3
        }
        tierQuote("e")
    }
    let restored = {
        handle TierError {
            base _label => 7
            bonus _label => 1
            tier _label => "outer"
        }
        let before = perform TierError.base("before")
        let inner = {
            handle TierError {
                base _label => 70
            }
            let insideBase = perform TierError.base("inside")
            let insideTier = perform TierError.tier("inside")
            "${insideTier}/${toString(insideBase)}"
        }
        let after = perform TierError.base("after")
        "${toString(before)}|${inner}|${toString(after)}"
    }

    // Two quotes under one three-arm handler: six arm entries, base+bonus of
    // 100+5, and a transcript in the order the body draws the channels.
    checkAll("one handler answers every operation of one effect", [
        structuralEquals([flat, flatTrail], ["gold:105/gold:105", "base:a|bonus:a|tier:a|base:b|bonus:b|tier:b|"]),
        structuralEquals([length(flat), flatCalls, length(flatTrail)], [17, 6, 44]),
        structuralEquals([startsWith(flat, "gold:105"), endsWith(flat, "gold:105")], [true, true]),
        contains(flat, "105/gold"),
        flat != "gold:105",
        flatCalls == (2 * 3 ),
        structuralEquals([startsWith(flatTrail, "base:a|"), endsWith(flatTrail, "tier:b|")], [true, true]),
        structuralEquals(mapList(["tier:a|base:b|", "base:c"], fn(k) => contains(flatTrail, k)), [true, false])
    ])

    // The inner region supplies only `base`; `bonus` and `tier` still reach the
    // outer arms, so the inner quote is 200+5 while both outer quotes are 100+5.
    checkAll("an inner arm overrides one operation and the outer arms remain", [
        overridden == "gold:105|gold:205|gold:105",
        structuralEquals([length(overridden), outerBaseCalls, innerBaseCalls], [26, 2, 1]),
        structuralEquals([(outerBaseCalls + innerBaseCalls ), (200 + 5 )], [3, 205]),
        outerBaseCalls > innerBaseCalls,
        structuralEquals([contains(overridden, "gold:205"), startsWith(overridden, "gold:105|")], [true, true]),
        structuralEquals([endsWith(overridden, "|gold:105"), contains(overridden, "gold:305")], [true, false]),
        structuralEquals([startsWith(overridden, "gold:205"), contains(overridden, "|gold:205|")], [false, true]),
        overridden != flat
    ])

    // Three single-arm regions cover complementary operations; nesting them in
    // either order discharges the same three operations to the same values.
    checkAll("complementary partial handlers each discharge their own operation", [
        structuralEquals([split, reordered], ["silver:13", "silver:13"]),
        split == reordered,
        structuralEquals([length(split), (10 + 3 )], [9, 13]),
        structuralEquals([startsWith(split, "silver:"), endsWith(split, ":13")], [true, true]),
        structuralEquals(mapList(["r:1", "gold"], fn(k) => contains(split, k)), [true, false]),
        split != flat,
        !startsWith(reordered, "13"),
        endsWith(reordered, "13")
    ])

    // Three same-operation regions: the innermost `base` wins at 3, while
    // `bonus` and `tier` fall through two uncovering regions to the outermost.
    // After an inner region ends the outer policy answers again, so the
    // before/inside/after readings are 7, 70 and 7.
    checkAll("the innermost matching arm wins and the outer policy is restored", [
        structuralEquals([deepest, restored], ["bronze:3", "7|outer/70|7"]),
        structuralEquals([length(deepest), length(restored)], [8, 12]),
        structuralEquals([startsWith(deepest, "bronze:"), endsWith(deepest, ":3")], [true, true]),
        structuralEquals(mapList([":1", ":2"], fn(k) => contains(deepest, k)), [false, false]),
        deepest != split,
        structuralEquals([startsWith(restored, "7|"), endsWith(restored, "|7")], [true, true]),
        structuralEquals(mapList(["outer/70", "70|outer"], fn(k) => contains(restored, k)), [true, false]),
        !contains(restored, "|70|")
    ])
}

/// Verify an operation performed inside a lambda handed to a higher-order
/// function reaches the installed handler.
///
/// [EFFECTS-STATIC-DISCHARGE]: the checker "propagates them through named calls
/// and higher-order callback calls", and "Constructing a lambda is pure, but
/// invoking it contributes its latent requirements". `forEachList` "Calls
/// `function` once per element in index order" [BUILTIN-LIST-FOREACH], so the
/// handler-owned transcript is the traversal order.
fn higherOrderRecoveryCase() = {
    let none = List()
    let one = [7]
    let dup = [3, 3, 3]
    let mixed = [1, 2, 3, 4, 5]
    let nested = [[10, 20], [30]]
    let missing = -1
    mut total = 0
    mut steps = 0
    mut scaled = 0
    mut trail = ""
    mut negatives = 0
    let finished = {
        handle Tally {
            scale value => {
                scaled = scaled + 1 
                value * 2 
            }
            add value => {
                total = total + value 
                steps = steps + 1 
                trail = "${trail}${toString(value)}|"
            }
        }
        forEachList(none, fn(value) => tallyOne(value))
        forEachList(one, fn(value) => tallyOne(value))
        forEachList(dup, fn(value) => tallyOne(value))
        forEachList(mixed, fn(value) => tallyOne(value))
        forEachList(nested, fn(inner) => forEachList(inner, fn(value) => tallyOne(value)))
        "finished"
    }
    let negated = {
        handle Tally {
            scale value => 0 - value 
            add value => {
                negatives = negatives + value 
            }
        }
        forEachList(mixed, fn(value) => tallyOne(value))
        "negated"
    }

    // Twelve elements are visited in five traversals: 7 doubles to 14, three
    // 3s to 6 each (18), 1..5 to 2..10 (30) and [[10,20],[30]] to 20+40+60
    // (120). 14 + 18 + 30 + 120 == 182.
    checkAll("a lambda handed to a higher-order function reaches the handler", [
        structuralEquals([finished, trail], ["finished", "14|6|6|6|2|4|6|8|10|20|40|60|"]),
        structuralEquals([steps, scaled, total, length(trail)], [12, 12, 182, 29]),
        scaled == steps,
        total == (14 + 18 + 30 + 120 ),
        total > 0,
        total != 91,
        structuralEquals([startsWith(trail, "14|"), endsWith(trail, "60|")], [true, true]),
        structuralEquals(mapList(["6|6|6|", "|7|"], fn(k) => contains(trail, k)), [true, false])
    ])

    // An empty list performs nothing, a singleton performs once, duplicates
    // perform once per occurrence, and the nested traversal adds three more.
    checkAll("empty, singleton, duplicate and nested inputs each contribute once", [
        structuralEquals([listLength(none), listLength(one), listLength(dup)], [0, 1, 3]),
        structuralEquals([listLength(mixed), listLength(nested)], [5, 2]),
        isEmpty(none),
        !isEmpty(one),
        steps == (listLength(one) + listLength(dup) + listLength(mixed) + 3 ),
        structuralEquals([listContains(dup, 3), listContains(dup, 6), listContains(mixed, 5)], [true, false, true]),
        structuralEquals([listContains(mixed, 0), listContains(one, 7), listContains(none, 7)], [false, true, false])
    ])

    // Every traversed list is unchanged afterwards, at the first index, the
    // last index, one past the end and a negative index.
    checkAll("the traversed lists are unchanged by the effectful callback", [
        (listGet(none, 0) ?: missing) == missing,
        structuralEquals([(listGet(one, 0) ?: missing), (listGet(dup, 0) ?: missing)], [7, 3]),
        structuralEquals([(listGet(dup, 2) ?: missing), (listGet(mixed, 0) ?: missing)], [3, 1]),
        structuralEquals([(listGet(mixed, 4) ?: missing), (listGet(mixed, missing) ?: 0)], [5, 0]),
        structuralEquals([(listGet(listReverse(mixed), 0) ?: missing), listLength(listGet(nested, 0) ?: none)], [5, 2]),
        (listGet(listGet(nested, 0) ?: none, 1) ?: missing) == 20,
        (listGet(listGet(nested, 1) ?: none, 0) ?: missing) == 30,
        (listGet(one, 1) ?: missing) == missing,
        (listGet(dup, 3) ?: missing) == missing,
        (listGet(mixed, 5) ?: missing) == missing
    ])

    // The second region negates instead of doubling and touches only its own
    // cell: 1..5 negated sums to -15 while the first region's state stands.
    checkAll("a second policy over the same callback changes only its own state", [
        structuralEquals([negated, trail], ["negated", "14|6|6|6|2|4|6|8|10|20|40|60|"]),
        negatives == -15,
        negatives < 0,
        structuralEquals([(negatives + 15 ), (0 - negatives ), (1 + 2 + 3 + 4 + 5 )], [0, 15, 15]),
        structuralEquals([total, steps, scaled], [182, 12, 12]),
        negatives != total,
        negated != finished
    ])
}

/// Verify recursion inside the handled body enters the handler once per level.
///
/// The handler section states the operation result "is the value returned by
/// its active handler arm" and [EFFECTS-HANDLER-STATE] promotes the captured
/// `mut` cell so "every arm, the handled body, and code after the region
/// observe the same location". A counter incremented per arm entry therefore
/// makes a lost or duplicated recovery impossible to hide behind a right total.
fn recursiveAccumulationCase() = {
    mut visits = 0
    mut lastDepth = 0
    mut trail = ""
    mut zeroVisits = 0
    mut oneVisits = 0
    mut deepVisits = 0
    let total = {
        handle StepError {
            contribute depth => {
                visits = visits + 1 
                lastDepth = depth
                trail = "${trail}${toString(depth)}:${toString(visits)}|"
                visits * 10 
            }
        }
        descendSum(8)
    }
    let zeroTotal = {
        handle StepError {
            contribute _depth => {
                zeroVisits = zeroVisits + 1 
                99
            }
        }
        descendSum(0)
    }
    let oneTotal = {
        handle StepError {
            contribute depth => {
                oneVisits = oneVisits + 1 
                depth * 3 
            }
        }
        descendSum(1)
    }
    let deepTotal = {
        handle StepError {
            contribute depth => {
                deepVisits = deepVisits + 1 
                depth
            }
        }
        descendSum(33)
    }
    let doubled = {
        handle StepError {
            contribute depth => depth * 2 
        }
        descendSum(33)
    }

    // Eight levels answer 10, 20 ... 80 from the handler's own counter, so the
    // total is 360 and the transcript pairs each depth with its visit number.
    checkAll("each recursion level enters the handler exactly once", [
        structuralEquals([total, visits, lastDepth, length(trail), (visits * 10 )], [360, 8, 1, 32, 80]),
        total == (10 + 20 + 30 + 40 + 50 + 60 + 70 + 80 ),
        trail == "8:1|7:2|6:3|5:4|4:5|3:6|2:7|1:8|",
        structuralEquals([startsWith(trail, "8:1|"), endsWith(trail, "1:8|")], [true, true]),
        structuralEquals(mapList(["|4:5|", "9:"], fn(k) => contains(trail, k)), [true, false]),
        !contains(trail, "0:"),
        total > 0,
        total != 36
    ])

    // Depth zero performs nothing at all, so an installed arm stays untouched;
    // depth one performs exactly once and answers 1 * 3.
    checkAll("zero and one level recursions", [
        structuralEquals([zeroTotal, zeroVisits, oneTotal], [0, 0, 3]),
        structuralEquals([oneVisits, (oneTotal - zeroTotal ), (zeroVisits + oneVisits )], [1, 3, 1]),
        zeroVisits < oneVisits,
        zeroTotal != oneTotal,
        zeroTotal < oneTotal,
        oneTotal != 99,
        zeroTotal != 99,
        oneVisits != visits
    ])

    // 33 levels echoing their own depth sum to 33 * 34 / 2 == 561, and the
    // doubling policy over the same body yields exactly twice that.
    checkAll("recursion past the thirty-two level boundary", [
        structuralEquals([deepTotal, deepVisits, doubled], [561, 33, 1122]),
        structuralEquals([(doubled - deepTotal ), (deepVisits - visits )], [561, 25]),
        // `/` is always float division [ARITH-CHECKED], so the integer,
        // half-sum goes through `intDiv`.,
        deepTotal == (intDiv(33 * 34 , 2) ),
        deepVisits > 32,
        doubled == (deepTotal * 2 ),
        doubled != deepTotal,
        deepTotal > total,
        deepVisits > visits,
        deepTotal != 528
    ])

    // Across all four runs 8 + 0 + 1 + 33 == 42 arm entries happened, and each
    // run's own answer is still readable after the later regions have closed.
    checkAll("every level of every run entered its own handler", [
        structuralEquals([(visits + zeroVisits + oneVisits + deepVisits ), visits, deepVisits], [42, 8, 33]),
        structuralEquals([total, deepTotal, doubled, oneTotal, zeroTotal], [360, 561, 1122, 3, 0]),
        structuralEquals([(total + oneTotal + zeroTotal ), (deepTotal + doubled )], [363, 1683])
    ])
}

/// Verify four effects compose in one stack of nested direct regions.
///
/// "Lookup is per effect and operation", so four regions each discharge their
/// own effect while the body performs across all four
/// [EFFECTS-STATIC-DISCHARGE]. One shared `mut` transcript written by arms of
/// different effects pins the interleaving [EFFECTS-HANDLER-STATE].
fn multiEffectRegionCase() = {
    mut trail = ""
    mut notes = 0
    mut recoveries = 0
    mut shortages = 0
    mut policies = 0
    mut auditTrail = ""
    mut generousAudits = 0
    let rendered = {
        handle AuditError {
            note message => {
                notes = notes + 1 
                trail = "${trail}A(${message})|"
            }
        }
        handle RecoveryError {
            missingInt reason => {
                recoveries = recoveries + 1 
                trail = "${trail}R(${reason})|"
                6
            }
        }
        handle StockError {
            shortage requested available => {
                shortages = shortages + 1 
                trail = "${trail}S(${toString(requested)},${toString(available)})|"
                available
            }
        }
        handle PolicyError {
            score key => {
                policies = policies + 1 
                trail = "${trail}P(${key})|"
                25
            }
            label key => {
                policies = policies + 1 
                trail = "${trail}L(${key})|"
                "priority"
            }
        }
        crossEffectBody()
    }
    let reordered = {
        handle PolicyError {
            score _key => 25
            label _key => "priority"
        }
        handle StockError {
            shortage _requested available => available
        }
        handle RecoveryError {
            missingInt _reason => 6
        }
        handle AuditError {
            note message => {
                auditTrail = "${auditTrail}${message}|"
            }
        }
        crossEffectBody()
    }
    let generous = {
        handle AuditError {
            note _message => {
                generousAudits = generousAudits + 1 
            }
        }
        handle RecoveryError {
            missingInt _reason => 2
        }
        handle StockError {
            shortage requested available => requested + available 
        }
        handle PolicyError {
            score _key => 0
            label _key => "basic"
        }
        crossEffectBody()
    }

    // The body draws 6 from RecoveryError, 4 from StockError, "priority" and
    // 25 from PolicyError and audits three times, so 3+1+1+2 == 7 arm entries.
    checkAll("four effects cooperate inside one nested region stack", [
        rendered == "priority:6:4:25",
        structuralEquals([length(rendered), notes, recoveries], [15, 3, 1]),
        structuralEquals([shortages, policies, (notes + recoveries + shortages + policies )], [1, 2, 7]),
        structuralEquals([startsWith(rendered, "priority:"), endsWith(rendered, ":25")], [true, true]),
        structuralEquals(mapList([":6:4:", ":25:"], fn(k) => contains(rendered, k)), [true, false]),
        notes > recoveries,
        policies > shortages,
        recoveries == shortages
    ])

    // One transcript written by arms of four different effects records the
    // body's exact interleaving, including that `label` precedes `score`.
    checkAll("the four channels interleave in the body's order", [
        trail == "R(qty)|A(filled 6)|S(6,4)|A(allowed 4)|L(order)|P(order)|A(scored 25)|",
        length(trail) == 70,
        structuralEquals([startsWith(trail, "R(qty)|"), endsWith(trail, "A(scored 25)|")], [true, true]),
        structuralEquals(mapList(["|S(6,4)|", "|L(order)|P(order)|"], fn(k) => contains(trail, k)), [true, true]),
        structuralEquals(mapList(["P(order)|L(order)", "A(qty)"], fn(k) => contains(trail, k)), [false, false]),
        structuralEquals(mapList(["A(filled 6)", "A(allowed 4)"], fn(k) => contains(trail, k)), [true, true]),
        !contains(trail, "S(4,6)"),
        !startsWith(trail, "A("),
        !endsWith(trail, "|P(order)|"),
        contains(trail, "R(qty)|A(filled 6)|")
    ])

    // Nesting the same four regions in the opposite order changes nothing the
    // body sees, and the first stack's own state is untouched by the second.
    checkAll("reordering independent handler regions preserves every value", [
        reordered == rendered,
        structuralEquals([reordered, auditTrail], ["priority:6:4:25", "filled 6|allowed 4|scored 25|"]),
        trail == "R(qty)|A(filled 6)|S(6,4)|A(allowed 4)|L(order)|P(order)|A(scored 25)|",
        structuralEquals([length(auditTrail), notes, recoveries, policies], [29, 3, 1, 2]),
        structuralEquals([startsWith(auditTrail, "filled 6|"), endsWith(auditTrail, "scored 25|")], [true, true]),
        structuralEquals(mapList(["|allowed 4|", "qty"], fn(k) => contains(auditTrail, k)), [true, false])
    ])

    // A third stack changes every policy: 2 filled, 2+4 allocated, "basic" and
    // 0, so the render is "basic:2:6:0" while the audit count is unchanged.
    checkAll("changing the policies changes only the handled decisions", [
        structuralEquals([generous, auditTrail], ["basic:2:6:0", "filled 6|allowed 4|scored 25|"]),
        structuralEquals([length(generous), generousAudits, notes], [11, 3, 3]),
        structuralEquals([recoveries, shortages, policies], [1, 1, 2]),
        generous != rendered,
        structuralEquals([startsWith(generous, "basic:"), endsWith(generous, ":0")], [true, true]),
        structuralEquals(mapList([":2:6:", "priority"], fn(k) => contains(generous, k)), [true, false]),
        generousAudits == notes
    ])
}

/// Verify boundary values cross a direct arm without being reshaped.
///
/// Each `perform` gets its own answer from the same arm, so three requests in
/// one region are answered independently [EFFECTS-HANDLER-ARMS]. The recovered
/// text is then read with the total string builtins
/// ([BUILTIN-STRING-CONTAINS], [BUILTIN-STRING-TRANSFORM]) and the recovered
/// numbers with checked arithmetic [ARITH-CHECKED].
fn boundaryValueRecoveryCase() = {
    mut fills = 0
    mut seen = ""
    let joined = {
        handle TextError {
            fill field => {
                fills = fills + 1 
                seen = "${seen}${field}${toString(fills)}|"
                match fills {
                    1 => ""
                    2 => "x"
                    _ => "  spaced  "
                }
            }
        }
        fillAll()
    }
    let blank = {
        handle TextError {
            fill _field => ""
        }
        perform TextError.fill("blank")
    }
    let single = {
        handle TextError {
            fill _field => "z"
        }
        perform TextError.fill("single")
    }
    let digits = {
        handle TextError {
            fill _field => "007"
        }
        perform TextError.fill("digits")
    }
    let mixedCase = {
        handle TextError {
            fill _field => "OsPrey"
        }
        perform TextError.fill("case")
    }
    let punctuated = {
        handle TextError {
            fill _field => "a-b_c.d,e"
        }
        perform TextError.fill("punct")
    }
    let repeated = {
        handle TextError {
            fill _field => "abab abab"
        }
        perform TextError.fill("repeat")
    }
    let zero = {
        handle TextError {
            number _field => 0
        }
        perform TextError.number("zero")
    }
    let big = {
        handle TextError {
            number _field => 2147483647
        }
        perform TextError.number("big")
    }
    let negative = {
        handle TextError {
            number _field => -2147483647
        }
        perform TextError.number("negative")
    }

    // Three performs, two of them under the duplicate field name "a", get the
    // first, second and third answers: "" then "x" then "  spaced  ", joined
    // as "/x/  spaced  " (13 characters).
    checkAll("repeated failures in one region are answered one at a time", [
        structuralEquals([joined, trim(joined), seen], ["/x/  spaced  ", "/x/  spaced", "a1|a2|b3|"]),
        structuralEquals([length(joined), fills, length(seen)], [13, 3, 9]),
        fills != 1,
        structuralEquals([startsWith(seen, "a1|"), endsWith(seen, "b3|"), contains(seen, "|a2|")], [true, true, true]),
        structuralEquals(mapList(["b1|", "a3|"], fn(k) => contains(seen, k)), [false, false]),
        structuralEquals([startsWith(joined, "/x/"), endsWith(joined, "  ")], [true, true]),
        contains(joined, "spaced")
    ])

    // Empty, one-character and digit-bearing replacements keep their exact
    // bytes rather than being normalised on the way out of the arm.
    checkAll("empty, single-character and digit-bearing replacements", [
        structuralEquals([blank, single, digits], ["", "z", "007"]),
        isEmpty(blank),
        structuralEquals([length(blank), length(single), length(digits)], [0, 1, 3]),
        !isEmpty(single),
        single != blank,
        structuralEquals([startsWith(digits, "0"), endsWith(digits, "7"), contains(digits, "07")], [true, true, true]),
        !contains(digits, "70"),
        digits != "7"
    ])

    // Case folding is ASCII-only and total, and a substring is found at the
    // start, in the middle and at the end but not in the wrong orientation.
    checkAll("case folding and substring position at start, middle and end", [
        structuralEquals([mixedCase, toUpperCase(mixedCase), toLowerCase(mixedCase)], ["OsPrey", "OSPREY", "osprey"]),
        structuralEquals([punctuated, repeated], ["a-b_c.d,e", "abab abab"]),
        structuralEquals([length(mixedCase), length(punctuated), length(repeated)], [6, 9, 9]),
        mixedCase != toUpperCase(mixedCase),
        mixedCase != toLowerCase(mixedCase),
        toUpperCase(mixedCase) != toLowerCase(mixedCase),
        structuralEquals([startsWith(punctuated, "a-"), contains(punctuated, "_c.")], [true, true]),
        structuralEquals([endsWith(punctuated, ",e"), startsWith(punctuated, "-")], [true, false]),
        !endsWith(punctuated, "e,"),
        structuralEquals([startsWith(repeated, "abab"), endsWith(repeated, "abab")], [true, true]),
        structuralEquals(mapList(["b a", "abc"], fn(k) => contains(repeated, k)), [true, false])
    ])

    // Zero, the largest 32-bit positive and its negation cross the arm and then
    // cancel exactly under checked arithmetic.
    checkAll("numeric boundaries survive direct substitution", [
        structuralEquals([zero, big, (big + negative ), (big - big )], [0, 2147483647, 0, 0]),
        !(zero > 0),
        !(zero < 0),
        big > zero,
        big > 0,
        negative == -2147483647,
        negative < zero,
        negative < 0,
        (zero - negative ) == big,
        big != negative,
        (abs(negative) ) == big
    ])
}

/// A run that never fails must never enter a recovery arm.
///
/// The handler is installed but its operations stay untouched, so the
/// value reaching the caller is the ordinary computed one.

test("successful paths bypass recovery handlers", fn() => exactArithmetic(happyPathBypassCase))
/// A handler-supplied value resumes ordinary arithmetic where the
/// failure was performed, rather than unwinding to the handler.
test("fallback values continue at the perform site", fn() => exactArithmetic(fallbackContinuationCase))
/// Three substitutions in one handler scope observe the handler's own
/// mutable state, proving each recovery resumes into the same handler
/// instance instead of a fresh one.
test("repeated recoveries share handler-owned state", fn() => exactArithmetic(repeatedRecoveryStateCase))
/// A `Unit`-returning report operation records a broken rule and lets
/// every later rule still run, so one validation pass collects all
/// failures instead of stopping at the first.
test("Unit error reports collect without early exit", fn() => exactArithmetic(collectAllReportsCase))
/// One handler answers `int`, `string`, and `bool` operations of the
/// same effect, proving each operation keeps its own result type.
test("one handler supplies several result types", fn() => exactArithmetic(multipleResultTypesCase))
/// The same effectful function runs under two different handlers and
/// yields two different answers — the policy lives in the handler, not
/// in the function.
test("one effectful function supports two policies", fn() => exactArithmetic(twoPoliciesCase))
/// An inner handler shadows ONE operation of an effect; the outer
/// handler still answers the others, and its behavior returns once the
/// inner scope ends.
test("nested handlers override locally and restore outer behavior", fn() => exactArithmetic(nestedOverrideCase))
/// A recovery arm performs a second, outer effect while recovering from
/// the first — composition across effect boundaries.
test("a recovery arm can use an outer effect", fn() => exactArithmetic(outerEffectCompositionCase))
/// A failure performed several helper calls and recursion levels deep
/// still reaches the installed handler.
test("recovery reaches through helpers and recursion", fn() => exactArithmetic(deepRecursionCase))
/// A handler may answer with a complete `Result`, choosing success or
/// failure itself rather than only supplying a bare fallback.
///
/// # Since
/// 0.3
test("handlers can return whole Result operation values", fn() => exactArithmetic(wholeResultOperationCase))
/// A direct arm may supply `int`, `float`, `bool`, `string`, a record, a
/// tagged union, a whole `Result` or `Unit`, and each one reaches the
/// perform site with its declared type and payload intact.
test("every declared operation result type crosses a direct arm", fn() => exactArithmetic(everyResultTypeCase))
/// Discharge is per operation: partial regions cover complementary
/// operations, an inner arm overrides one operation while its siblings fall
/// through, and the outer policy answers again once the inner region ends.
test("partial and nested handlers split one effect's operations", fn() => exactArithmetic(partialOverrideLatticeCase))
/// A `perform` inside a lambda handed to `forEachList` reaches the installed
/// handler once per element, in index order, for empty, singleton, duplicate
/// and nested inputs alike.
test("a callback passed to a higher-order function reaches the handler", fn() => exactArithmetic(higherOrderRecoveryCase))
/// Recursion in the handled body enters the handler exactly once per level,
/// including at depth zero, depth one and past the thirty-two level mark.
test("recursion in the handled body enters the handler once per level", fn() => exactArithmetic(recursiveAccumulationCase))
/// Four effects performed by one body are discharged by four nested regions;
/// nesting order does not change any value, and one shared transcript records
/// the exact interleaving of the four channels.
test("four effects compose in one nested region stack", fn() => exactArithmetic(multiEffectRegionCase))
/// Empty, single-character, punctuated, repeated and case-mixed text, and
/// zero, maximum and negated numbers, all cross a direct arm unchanged.
test("boundary values cross a direct arm unchanged", fn() => exactArithmetic(boundaryValueRecoveryCase))
