(** Prompt suspends a form until its handler supplies a value. *)
effect Prompt
    (** Request the value the caller should use for `label`; the handler decides what is supplied. *)
    control ask : string => string

(** Log observes both sides of the resumed prompt. *)
effect Log
    (** Append one already-formatted line to the log. *)
    line : string => Unit

(** Log on both sides of the prompt. *)
form : Unit -> string ! [Prompt, Log]
form () =
    perform Log.line "form start"
    name = perform Prompt.ask "name"
    perform Log.line ("got " + name)
    name

(** Verify outer-handler reachability across resume. *)
resumeOuterHandlerBridgeCase () =
    mut transcript = ""
    mut logMessages = ""
    mut logCalls = 0
    mut promptCalls = 0
    mut promptSettled = 0
    mut settledAnswer = ""

    result =
        handle Log
            line message =>
                logCalls := logCalls + 1 
                logMessages := "${logMessages}${message}|"
                transcript := "${transcript}[log] ${message}\n"
        answer =
            handle Prompt
                ask field =>
                    promptCalls := promptCalls + 1 
                    transcript := "${transcript}ask ${field}\n"
                    resumedAnswer = resume "Ada"
                    promptSettled := promptSettled + 1 
                    settledAnswer := resumedAnswer
                    transcript := "${transcript}after ask: ${resumedAnswer}\n"
                    resumedAnswer
            form ()
        answer
    legacyTranscript = "${transcript}result=${result}\n"

    // Preserve the complete bridge transcript.
    checkAll "outer-handler legacy observations" [
        legacyTranscript == "[log] form start\nask name\n[log] got Ada\nafter ask: Ada\nresult=Ada\n",
        containsAll legacyTranscript ["[log] form start\n", "ask name\n", "[log] got Ada\n", "after ask: Ada\n"],
        endsWith legacyTranscript "result=Ada\n"
    ]

    // Both logs cross the prompt, which settles once.
    checkAll "outer-handler internal state" [
        structuralEquals [result, settledAnswer, logMessages] ["Ada", "Ada", "form start|got Ada|"],
        structuralEquals [logCalls, promptCalls, promptSettled] [2, 1, 1]
    ]

test "a resumed body retains its outer handlers" (\() => exactArithmetic (resumeOuterHandlerBridgeCase))

(** Ledger is handled by two nested regions, only one of which is complete. *)
effect Ledger
    (** Record an amount; both regions carry an arm for this operation. *)
    record : int => int
    (** Audit a label; only the outer region carries an arm for it. *)
    audit : string => int

(** Two records, so the delegation happens more than once. *)
ledgerWork : Unit -> int ![Ledger, Arith]
ledgerWork () =
    a = perform Ledger.record 5
    b = perform Ledger.record 7
    (a + b) 

(** Spec 0017 draws the line inside a handler arm: an arm "is not permission to
    perform its own active operation recursively", but "a different operation
    not covered by a partial handler ... may instead be discharged by an
    enclosing matching handler". The inner region below handles `record` only,
    so the `audit` its arm performs must cross to the outer region — and the
    inner `record` arm must still win over the outer one, because "the innermost
    matching arm wins". *)
partialHandlerDelegationCase () =
    mut outerRecords = 0
    mut outerAudits = 0
    mut innerRecords = 0
    mut auditLog = ""
    mut lastNoted = 0

    total =
        handle Ledger
            record amount =>
                outerRecords := outerRecords + 1 
                amount * 1000 
            audit label =>
                outerAudits := outerAudits + 1 
                auditLog := "${auditLog}${label}|"
                length label
        handle Ledger
            record amount =>
                innerRecords := innerRecords + 1 
                noted = perform Ledger.audit "record:${amount}"
                lastNoted := noted
                (amount + noted) 
        ledgerWork ()

    // The arm's own operation stays with the inner region; the operation it
    // does not cover reaches the outer one, twice.
    checkAll "a partial handler delegates the operation it lacks" [
        structuralEquals [total, innerRecords, outerAudits] [28, 2, 2],
        structuralEquals [outerRecords, lastNoted, (innerRecords + outerAudits )] [0, 8, 4],
        auditLog == "record:5|record:7|",
        innerRecords == outerAudits,
        innerRecords != outerRecords
    ]

    // The outer `record` arm multiplies by 1000, so any leak of a `record`
    // operation past the inner region would be unmistakable in the total.
    checkAll "the innermost matching arm keeps its operation" [
        total == (13 + 15 ),
        total != (5000 + 7000 ),
        total != 24,
        total < 100,
        structuralEquals [outerRecords, length auditLog] [0, 18],
        containsAll auditLog ["record:5|", "record:7|"],
        structuralEquals [containsNone auditLog ["record:12"], startsWith auditLog "record:5|"] [true, true],
        endsWith auditLog "record:7|"
    ]

    // Each delegated audit answered its own label's length, and the label the
    // outer arm saw was built from the amount the inner arm received.
    checkAll "delegated answers return to the performing arm" [
        lastNoted == length "record:7",
        structuralEquals [lastNoted, (5 + 8 ), (7 + 8 ), outerAudits] [8, 13, 15, 2],
        // `?:` is the LOWEST precedence and right-associative, so the whole,
        // sum needs its own parentheses to sit under the `==` [SYNTAX].,
        total == ((5 + 7 ) + (8 + 8 ) ),
        auditLog != "",
        auditLog != "record:5|",
        length auditLog == (9 + 9 )
    ]

test "an arm delegates an operation its own handler does not cover" (\() => exactArithmetic (partialHandlerDelegationCase))
