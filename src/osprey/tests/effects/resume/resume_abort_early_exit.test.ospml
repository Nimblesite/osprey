(** Returning from an arm stops the suspended continuation. *)
effect Stop
    (** Check `value`; the handler may resume or stop the continuation. *)
    control check : int => int

(** Observation records performer-side events without stdout. *)
effect Observation
    (** Record a performer-side event without touching stdout. *)
    line : string => Unit

(** Route one observation through the outer handler. *)
observe message = perform Observation.line message

(** The zero check prevents the final observation and return value. *)
guarded : Unit -> int ! [Stop, Observation]
guarded () =
    observe "before first check"
    a = perform Stop.check 1
    observe ("after first check: " + toString a)
    b = perform Stop.check 0
    observe ("after second check: " + toString b)
    99

(** Mixed models one handler whose two arms disagree about resuming. *)
effect Mixed
    (** Resumed arm: the handler supplies a value and the caller continues. *)
    control tally : int => int
    (** Non-resuming arm: its own value substitutes for the operation result. *)
    supply : int => int

(** Perform both Mixed operations so each arm's mode is observable. *)
mixedWork : Unit -> int ![Mixed, Observation, Arith]
mixedWork () =
    observe "work start"
    a = perform Mixed.tally 1
    observe ("after tally: " + toString a)
    b = perform Mixed.supply 2
    observe ("after supply: " + toString b)
    c = perform Mixed.supply 3
    observe ("after second supply: " + toString c)
    (a + b ) + c 

(** Verify resume, abort, unwind, and discarded work. *)
resumeAbortEarlyExitCase () =
    mut transcript = ""
    mut checks = 0
    mut resumed = 0
    mut aborted = 0

    result =
        handle Observation
            line message =>
                transcript := "${transcript}${message}\n"
        handle Stop
            check n =>
                checks := checks + 1 
                match n
                    0 =>
                        aborted := aborted + 1 
                        observe "stopping at zero"
                        999
                    _ =>
                        resumed := resumed + 1 
                        supplied = n * 10 
                        answer = resume supplied
                        observe ("continued check " + toString n + ": answer=" + toString answer)
                        answer
        guarded ()
    legacyTranscript = "${transcript}result=${toString result}\n"

    // Preserve the full five-line transcript.
    checkAll "early-exit legacy observations" [
        legacyTranscript == "before first check\nafter first check: 10\nstopping at zero\ncontinued check 1: answer=999\nresult=999\n",
        containsAll legacyTranscript ["before first check\n", "after first check: 10\n", "stopping at zero\n", "continued check 1: answer=999\n", "result=999\n"],
        containsNone legacyTranscript ["after second check", "result=99\n"]
    ]

    // Check the branch counts and replacement value.
    checkAll "early-exit internal state" [
        structuralEquals [result, checks, resumed, aborted] [999, 2, 1, 1],
        checks == (resumed + aborted )
    ]

test "returning without resume aborts the suspended continuation" (\() => exactArithmetic (resumeAbortEarlyExitCase))

(** [EFFECTS-HANDLER-ARMS] gives an arm's value one of two meanings: an arm that
    does not resume "substitutes for its operation's declared result", while an
    arm that abandons the continuation supplies "the result of the whole handle
    expression". The choice belongs to the arm that is running — `tally` resumes,
    `supply` does not — so a sibling's `resume` cannot turn `supply` into an
    early exit. Issue #177: the mode is read per region today. *)
resumeSiblingArmIndependenceCase () =
    mut transcript = ""
    mut tallyCalls = 0
    mut supplyCalls = 0
    mut lastSupplied = 0
    mut resumedAnswer = 0

    result =
        handle Observation
            line message =>
                transcript := "${transcript}${message}\n"
        handle Mixed
            tally n =>
                tallyCalls := tallyCalls + 1 
                answer = resume (n * 10 )
                resumedAnswer := answer
                answer
            supply n =>
                supplyCalls := supplyCalls + 1 
                lastSupplied := n * 100 
                lastSupplied
        mixedWork ()
    legacyTranscript = "${transcript}result=${toString result}\n"

    // The non-resuming arm substitutes: every later line of the body still runs.
    checkAll "sibling-arm legacy observations" [
        legacyTranscript == "work start\nafter tally: 10\nafter supply: 200\nafter second supply: 300\nresult=510\n",
        containsAll legacyTranscript ["work start\n", "after tally: 10\n", "after supply: 200\n", "after second supply: 300\n"],
        endsWith legacyTranscript "result=510\n",
        containsNone legacyTranscript ["result=200\n", "result=300\n"]
    ]

    // A sibling's `resume` must not turn these arms into early exits.
    checkAll "sibling-arm internal state" [
        structuralEquals [result, tallyCalls, supplyCalls] [510, 1, 2],
        structuralEquals [lastSupplied, resumedAnswer, (tallyCalls + supplyCalls )] [300, 510, 3],
        resumedAnswer == result
    ]

test "a non-resuming arm is unaffected by a sibling arm's resume" (\() => exactArithmetic (resumeSiblingArmIndependenceCase))
