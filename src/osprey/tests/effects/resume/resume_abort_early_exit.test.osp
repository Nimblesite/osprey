/// A stopped continuation returns the handler arm value and omits later work.
effect Stop {
    /// Check `value`; the handler may resume or stop the continuation.
    control check: fn(int) -> int
}

/// Observation records performer-side events without relying on stdout.
effect Observation {
    /// Record a performer-side event without touching stdout.
    line: fn(string) -> Unit
}

/// This helper routes one legacy output observation through the outer handler.
fn observe(message) !Observation = perform Observation.line(message)

/// This helper reaches a successful check before the zero check aborts it.
fn guarded() -> int ![Stop, Observation] = {
    observe("before first check")
    let a = perform Stop.check(1)
    observe("after first check: " + toString(a))
    let b = perform Stop.check(0)
    observe("after second check: " + toString(b))
    99
}

/// Mixed models one handler whose two arms disagree about resuming.
effect Mixed {
    /// Resumed arm: the handler supplies a value and the caller continues.
    control tally: fn(int) -> int
    /// Non-resuming arm: its own value substitutes for the operation result.
    supply: fn(int) -> int
}

/// This helper performs both Mixed operations so each arm's mode is observable.
fn mixedWork() -> int ![Mixed, Observation, Arith] = {
    observe("work start")
    let a = perform Mixed.tally(1)
    observe("after tally: " + toString(a))
    let b = perform Mixed.supply(2)
    observe("after supply: " + toString(b))
    let c = perform Mixed.supply(3)
    observe("after second supply: " + toString(c))
    (a + b ) + c 
}

/// This case verifies resume, abort, unwind, and the discarded continuation.
fn resumeAbortEarlyExitCase() = {
    mut transcript = ""
    mut checks = 0
    mut resumed = 0
    mut aborted = 0

    let result = {
        handle Observation {
            line message => { transcript = "${transcript}${message}\n" }
        }
        handle Stop {
            check n => {
                checks = checks + 1 
                match n {
                    0 => {
                        aborted = aborted + 1 
                        observe("stopping at zero")
                        999
                    }
                    _ => {
                        resumed = resumed + 1 
                        let supplied = n * 10 
                        let answer = resume(supplied)
                        observe("continued check " + toString(n) + ": answer=" + toString(answer))
                        answer
                    }
                }
            }
        }
        guarded()
    }
    let legacyTranscript = "${transcript}result=${toString(result)}\n"

    // Preserve the complete five-line golden transcript and every visible line.
    checkAll("early-exit legacy observations", [
        legacyTranscript == "before first check\nafter first check: 10\nstopping at zero\ncontinued check 1: answer=999\nresult=999\n",
        containsAll(legacyTranscript, ["before first check\n", "after first check: 10\n", "stopping at zero\n", "continued check 1: answer=999\n", "result=999\n"]),
        containsNone(legacyTranscript, ["after second check", "result=99\n"])
    ])

    // Assert the internal branch counts and the arm value that replaced the body.
    checkAll("early-exit internal state", [
        structuralEquals([result, checks, resumed, aborted], [999, 2, 1, 1]),
        checks == (resumed + aborted )
    ])
}

// Register the explicit-resume early-exit regression.

test("returning without resume aborts the suspended continuation", fn() => exactArithmetic(resumeAbortEarlyExitCase))

/// This case verifies an arm's mode is its own, not its siblings'.
fn resumeSiblingArmIndependenceCase() = {
    mut transcript = ""
    mut tallyCalls = 0
    mut supplyCalls = 0
    mut lastSupplied = 0
    mut resumedAnswer = 0

    let result = {
        handle Observation {
            line message => { transcript = "${transcript}${message}\n" }
        }
        handle Mixed {
            tally n => {
                tallyCalls = tallyCalls + 1 
                let answer = resume(n * 10 )
                resumedAnswer = answer
                answer
            }
            supply n => {
                supplyCalls = supplyCalls + 1 
                lastSupplied = n * 100 
                lastSupplied
            }
        }
        mixedWork()
    }
    let legacyTranscript = "${transcript}result=${toString(result)}\n"

    // The non-resuming arm substitutes: every later line of the body still runs.
    checkAll("sibling-arm legacy observations", [
        legacyTranscript == "work start\nafter tally: 10\nafter supply: 200\nafter second supply: 300\nresult=510\n",
        containsAll(legacyTranscript, ["work start\n", "after tally: 10\n", "after supply: 200\n", "after second supply: 300\n"]),
        endsWith(legacyTranscript, "result=510\n"),
        containsNone(legacyTranscript, ["result=200\n", "result=300\n"])
    ])

    // A sibling's `resume` must not turn these arms into early exits.
    checkAll("sibling-arm internal state", [
        structuralEquals([result, tallyCalls, supplyCalls], [510, 1, 2]),
        structuralEquals([lastSupplied, resumedAnswer, (tallyCalls + supplyCalls )], [300, 510, 3]),
        resumedAnswer == result
    ])
}

// Register the sibling-arm independence regression for issue #177.
test("a non-resuming arm is unaffected by a sibling arm's resume", fn() => exactArithmetic(resumeSiblingArmIndependenceCase))
