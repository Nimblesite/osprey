(** Represent pure pass, failure, and precondition-skip outcomes. *)
type Verdict = Pass | Fail string | Skip string

(** Build a Verdict from a labeled canonical-text comparison. *)
checkVerdict : string -> string -> string -> Verdict
checkVerdict label expected actual = match expected == actual
    true => Pass
    false => Fail "${label}: expected ${expected}, got ${actual}"

(** Turn a boolean precondition into Pass or Skip. *)
assume true = Pass
assume false = Skip "precondition not met"

(** Keep the first failure or skip, otherwise return the next Verdict. *)
andThen (Pass) rest = rest
andThen (Fail reason) _ = Fail reason
andThen (Skip why) _ = Skip why

(** Add two integers for the composed Verdicts. *)
add a b = a + b 

(** Fold arithmetic, interpolation, and booleans into a passing Verdict. *)
passingCase () =
    arithmetic = andThen (checkVerdict "sum" "5" (toString (add 2 3))) (checkVerdict "difference" "2" (toString (add 5 ((0 - 3) ))))
    text = andThen (checkVerdict "interpolation" "total=8" "total=${add 3 5}") (checkVerdict "bool" "true" (toString (3 < 5)))
    andThen arithmetic text

(** Preserve an unmet precondition as Skip after eager argument evaluation. *)
skippedCase () =
    andThen (assume (2 > 3)) (checkVerdict "ignored after skip" "0" "1")

test "pass folds several good interactions" (\() => exactArithmetic (passingCase))
test "skip preserves an unmet precondition" (\() => exactArithmetic (skippedCase))

(** Trace records every operation a curried body performs. *)
effect Trace
    (** Record one step and answer its 1-based index. *)
    step : string => int

(** Two whitespace parameters curry [FLAVOR-ML-CURRY]. *)
traced2 a b =
    x = perform Trace.step a
    y = perform Trace.step b
    x + y 

(** Three whitespace parameters curry the same way. *)
traced3 a b c =
    x = perform Trace.step a
    y = perform Trace.step b
    z = perform Trace.step c
    (x + y ) + z 

(** Four whitespace parameters — the exact shape [FLAVOR-ML-CURRY] warns about
    in issue #184, where an operation performed through the body is silently
    skipped. Every step below must reach the handler. *)
traced4 a b c d =
    w = perform Trace.step a
    x = perform Trace.step b
    y = perform Trace.step c
    z = perform Trace.step d
    ((w + x ) + y ) + z 

(** Five whitespace parameters: one nesting level past the reported shape. *)
traced5 a b c d e =
    v = perform Trace.step a
    w = perform Trace.step b
    x = perform Trace.step c
    y = perform Trace.step d
    z = perform Trace.step e
    (((v + w ) + x ) + y ) + z 

(** Parenthesised comma-separated parameters are explicitly flat, and the spec
    names this the form that works today — so both forms must agree. *)
tracedFlat (a, b, c, d) =
    w = perform Trace.step a
    x = perform Trace.step b
    y = perform Trace.step c
    z = perform Trace.step d
    ((w + x ) + y ) + z 

(** Curried and flat bodies perform through the same handler, so the operation
    indices they receive form one unbroken 1..18 sequence. A skipped operation
    shows up three ways at once: a short transcript, a low count, and a sum that
    no longer matches the indices its own arity should have consumed. *)
curriedEffectsReachTheHandlerCase () =
    mut seen = ""
    mut steps = 0
    traceReport =
        handle Trace
            step label =>
                steps := steps + 1 
                seen := "${seen}${label}|"
                steps
        r2 = traced2 "a" "b"
        r3 = traced3 "c" "d" "e"
        r4 = traced4 "f" "g" "h" "i"
        r5 = traced5 "j" "k" "l" "m" "n"
        rf = tracedFlat ("o", "p", "q", "r")
        "${r2}/${r3}/${r4}/${r5}/${rf}"

    // Each arity consumes consecutive indices: 1-2, 3-5, 6-9, 10-14, 15-18.
    checkAll "curried arities consume every operation index" [
        traceReport == "3/12/30/60/66",
        structuralEquals [startsWith traceReport "3/", endsWith traceReport "/66"] [true, true],
        containsAll traceReport ["/12/", "/30/", "/60/"],
        containsNone traceReport ["/0/", "//"]
    ]

    // The handler saw eighteen distinct labels, in source order, once each.
    checkAll "every performed label reached the handler" [
        steps == 18,
        seen == "a|b|c|d|e|f|g|h|i|j|k|l|m|n|o|p|q|r|",
        length seen == 36,
        structuralEquals [startsWith seen "a|b|", endsWith seen "q|r|"] [true, true],
        containsAll seen ["e|f|", "i|j|", "n|o|"],
        steps == 18,
        steps > 14,
        steps != 14,
        steps != 9
    ]

    // The arity-4 curried body and its flat twin must agree operation for
    // operation: 6+7+8+9 == 30 and 15+16+17+18 == 66, four steps each.
    checkAll "curried and flat four-parameter bodies agree" [
        // `?:` is the LOWEST precedence and right-associative, so every sum
        // that ends in one needs its own parentheses to sit under the `==`
        // [SYNTAX] — without them `x ?: 0 == 30` reads `x ?: (0 == 30)`.
        ((6 + 7 ) + (8 + 9 ) ) == 30,
        ((15 + 16 ) + (17 + 18 ) ) == 66,
        containsAll traceReport ["30", "66"],
        (1 + 2 ) == 3,
        ((3 + 4 ) + 5 ) == 12,
        (((10 + 11 ) + (12 + 13 ) ) + 14 ) == 60,
        steps == 18
    ]

(** Add three integers through whitespace parameters. *)
addThree a b c = (a + b ) + c 

(** The same addition with explicitly flat parenthesised parameters. *)
addFlat (a, b, c) = (a + b ) + c 

(** [FLAVOR-ML-CURRY]: `add 1 2` lowers to nested one-argument calls and `add 1`
    returns the remaining function, while parenthesised comma parameters are
    flat and do not partially apply. Both spellings must reach the same answer
    from every legal application shape. *)
partialApplicationCase () =
    onePart = addThree 1
    twoPart = addThree 1 2
    otherPart = addThree 10
    reused = onePart 2

    // Every grouping of the same three arguments is the same call.
    checkAll "curried application groups freely" [
        addThree 1 2 3 == 6,
        (addThree 1) 2 3 == 6,
        (addThree 1 2) 3 == 6,
        ((addThree 1) 2) 3 == 6,
        structuralEquals [onePart 2 3, twoPart 3, reused 3, addFlat (1, 2, 3)] [6, 6, 6, 6],
        addThree 1 2 3 == addFlat (1, 2, 3)
    ]

    // A partial application is a value: reusing one does not consume it, and
    // two partials of the same function stay independent.
    checkAll "partial applications are independent reusable values" [
        structuralEquals [onePart 2 3, onePart 2 4, onePart 5 5, otherPart 2 3, otherPart 20 30] [6, 7, 11, 15, 60],
        structuralEquals [twoPart 3, twoPart 30, reused 4] [6, 33, 7],
        onePart 2 3 != otherPart 2 3,
        twoPart 3 == onePart 2 3,
        addFlat (10, 2, 3) == otherPart 2 3
    ]

test "curried ML bodies perform every operation through the handler" (\() => exactArithmetic (curriedEffectsReachTheHandlerCase))
test "ML partial application follows the currying rule" (\() => exactArithmetic (partialApplicationCase))

(** Render a Verdict as canonical text so both its state and its payload are
    assertable without comparing union values directly. Adjacent clauses with a
    refutable first column form one function by cases [FLAVOR-ML-CLAUSES], and a
    parenthesised constructor pattern is the clause-head spelling
    [FLAVOR-ML-PATTERN-GROUP]; the binders take their column
    [FLAVOR-ML-CTOR-POSITIONAL]. *)
verdictLabel (Pass) = "pass"
verdictLabel (Fail reason) = "fail(${reason})"
verdictLabel (Skip why) = "skip(${why})"

(** Whether regrouping an `andThen` chain leaves the same reported outcome. *)
associates left right = verdictLabel left == verdictLabel right

(** [TESTING-VERDICT] fixes three contracts at once: `assume` turns a false
    condition into `Skip` and a true one into `Pass`; the labeled comparison
    yields `Pass` on equality and otherwise a `Fail` carrying the labeled
    mismatch; and `andThen first rest` yields `rest` when `first` is `Pass`
    while retaining a first `Fail` or `Skip`. "Keep the first non-Pass" makes
    `andThen` a monoid whose identity is `Pass`, so every fold below is checked
    against the identity and associativity laws as well as its point value — a
    fold that merely returned its last argument would satisfy the point values
    alone. *)
verdictAlgebraCase () =
    fail1 = Fail "one"
    fail2 = Fail "two"
    skip1 = Skip "first"
    skip2 = Skip "second"
    sumCheck = checkVerdict "sum"
    mismatch = verdictLabel (checkVerdict "sum" "5" "6")

    // Nine ordered pairs over {Pass, Fail, Skip}: the first non-Pass wins, and
    // the second operand's payload must never surface when it does.
    checkAll "andThen retains the first non-Pass verdict" [
        structuralEquals [verdictLabel (andThen Pass Pass), verdictLabel (andThen Pass fail2)] ["pass", "fail(two)"],
        verdictLabel (andThen Pass skip2) == "skip(second)",
        verdictLabel (andThen fail1 Pass) == "fail(one)",
        verdictLabel (andThen fail1 fail2) == "fail(one)",
        verdictLabel (andThen fail1 skip2) == "fail(one)",
        verdictLabel (andThen skip1 Pass) == "skip(first)",
        verdictLabel (andThen skip1 fail2) == "skip(first)",
        verdictLabel (andThen skip1 skip2) == "skip(first)",
        verdictLabel (andThen fail1 fail2) != verdictLabel fail2,
        verdictLabel (andThen skip1 skip2) != verdictLabel skip2,
        startsWith (verdictLabel (andThen fail1 skip2)) "fail(",
        endsWith (verdictLabel (andThen skip1 fail2)) ")",
        contains (verdictLabel (andThen fail1 fail2)) "one",
        !(contains (verdictLabel (andThen fail1 fail2)) "two"),
        !(contains (verdictLabel (andThen skip1 fail2)) "two")
    ]

    // Monoid laws: Pass is a two-sided identity and andThen associates, so a
    // regrouped fold cannot change the reported outcome.
    checkAll "Pass is the identity of andThen and andThen associates" [
        verdictLabel (andThen Pass Pass) == verdictLabel Pass,
        verdictLabel (andThen Pass fail1) == verdictLabel fail1,
        verdictLabel (andThen Pass skip1) == verdictLabel skip1,
        verdictLabel (andThen fail1 Pass) == verdictLabel fail1,
        verdictLabel (andThen skip1 Pass) == verdictLabel skip1,
        associates (andThen (andThen Pass fail1) skip2) (andThen Pass (andThen fail1 skip2)),
        associates (andThen (andThen fail1 Pass) skip2) (andThen fail1 (andThen Pass skip2)),
        associates (andThen (andThen skip1 fail2) Pass) (andThen skip1 (andThen fail2 Pass)),
        verdictLabel (andThen (andThen Pass Pass) fail2) == "fail(two)",
        verdictLabel (andThen Pass (andThen Pass fail2)) == "fail(two)",
        verdictLabel (andThen (andThen Pass Pass) Pass) == "pass",
        verdictLabel (andThen (andThen fail1 fail2) skip1) == "fail(one)",
        verdictLabel (andThen fail1 (andThen fail2 skip1)) == "fail(one)",
        verdictLabel (andThen (andThen Pass Pass) (andThen Pass skip2)) == "skip(second)",
        verdictLabel (andThen (andThen Pass skip2) (andThen Pass fail1)) == "skip(second)",
        verdictLabel (andThen (andThen Pass fail1) (andThen Pass skip2)) == "fail(one)"
    ]

    // The Fail payload is the whole labeled mismatch, verbatim. Its rendered
    // length is fixed: "fail(" + "sum: expected 5, got 6" (22) + ")" = 28.
    checkAll "the labeled mismatch is carried verbatim" [
        structuralEquals [verdictLabel (checkVerdict "sum" "5" "5"), mismatch] ["pass", "fail(sum: expected 5, got 6)"],
        verdictLabel (checkVerdict "empty" "" "") == "pass",
        verdictLabel (checkVerdict "empty" "" "x") == "fail(empty: expected , got x)",
        verdictLabel (checkVerdict "case" "A" "a") == "fail(case: expected A, got a)",
        verdictLabel (checkVerdict "space" " " " ") == "pass",
        verdictLabel (checkVerdict "space" "a b" "ab") == "fail(space: expected a b, got ab)",
        verdictLabel (checkVerdict "digits" (toString (add 2 3)) "5") == "pass",
        verdictLabel (checkVerdict "bool" (toString (3 < 5)) "true") == "pass",
        verdictLabel (checkVerdict "bool" (toString (5 < 3)) "true") ==
            "fail(bool: expected false, got true)",
        containsAll mismatch ["expected 5", "got 6"],
        startsWith mismatch "fail(sum:",
        length mismatch == 28,
        !(contains (verdictLabel (checkVerdict "sum" "5" "5")) "expected"),
        verdictLabel (sumCheck "5" "5") == "pass",
        verdictLabel (sumCheck "5" "6") == "fail(sum: expected 5, got 6)",
        verdictLabel ((checkVerdict "sum" "5") "7") == "fail(sum: expected 5, got 7)"
    ]

    // assume is the precondition gate: "skip(" + "precondition not met" (20)
    // + ")" is 26 characters, and a Skip absorbs everything after it.
    checkAll "assume converts a precondition into Pass or Skip" [
        verdictLabel (assume true) == "pass",
        verdictLabel (assume false) == "skip(precondition not met)",
        verdictLabel (assume (2 > 3)) == "skip(precondition not met)",
        verdictLabel (assume (3 > 2)) == "pass",
        verdictLabel (assume (0 == 0)) == "pass",
        verdictLabel (assume ("a" == "b")) == "skip(precondition not met)",
        verdictLabel (assume (5 >= 5)) == "pass",
        verdictLabel (assume (5 > 5)) == "skip(precondition not met)",
        verdictLabel (andThen (assume true) fail1) == "fail(one)",
        verdictLabel (andThen (assume false) fail1) == "skip(precondition not met)",
        verdictLabel (andThen fail1 (assume false)) == "fail(one)",
        verdictLabel (andThen (assume true) (assume false)) == "skip(precondition not met)",
        verdictLabel (andThen (assume true) (assume true)) == "pass",
        startsWith (verdictLabel (assume false)) "skip(",
        length (verdictLabel (assume false)) == 26,
        !(contains (verdictLabel (assume true)) "skip")
    ]

(** Four whitespace parameters, built on the existing three-parameter curried
    `addThree` so no arithmetic is duplicated: only the declared arity differs,
    which is the property [FLAVOR-ML-CURRY] is about. *)
sum4 a b c d = addThree a b c + d 

(** Five whitespace parameters. *)
sum5 a b c d e = sum4 a b c d + e 

(** Six whitespace parameters — two arities past the shape issue #184 reports. *)
sum6 a b c d e f = sum5 a b c d e + f 

(** The explicitly flat twin of `sum6`: identical body, different head. A
    parenthesised comma list is flat and does not partially apply, so the two
    must agree on every saturated call and differ only in how they are applied
    [FLAVOR-ML-CURRY], [FLAVOR-ML-TUPLE]. *)
sumFlat6 (a, b, c, d, e, f) = sum5 a b c d e + f 

(** Currying is not integer-specific: three whitespace parameters over strings. *)
tag3 a b c = a + b + c

(** Three whitespace parameters over booleans. *)
all3 a b c = a && b && c

(** Three whitespace parameters over floats, which need no `?:` because float
    arithmetic is unchecked ([ARITH-CHECKED] covers the integer operators). *)
blend3 a b c = a * b + c

(** [FLAVOR-ML-CURRY] says `add x y = body` lowers to a one-parameter function
    returning a one-parameter lambda, and [FLAVOR-ML-CALL] says whitespace
    application is left-associative — `f a b` is `Call(Call(f, [a]), [b])`.
    Together those two rules mean every parenthesisation of the same argument
    sequence is one call, and every prefix of it is a reusable value. This case
    walks the declared arities from two to six and applies each one in every
    legal grouping, then repeats the ladder over strings, booleans and floats so
    a currying defect cannot hide behind the integer representation. *)
curriedArityLadderCase () =
    inc = add 1
    p1 = sum6 1
    p2 = sum6 1 2
    p3 = sum6 1 2 3
    p4 = sum6 1 2 3 4
    p5 = sum6 1 2 3 4 5
    openTag = tag3 "<"
    bothTrue = all3 true
    scaled = blend3 2.0

    // 1+2 = 3, 1+2+3+4 = 10, 1+..+5 = 15, 1+..+6 = 21.
    checkAll "every curried arity answers its own sum" [
        structuralEquals [add 1 2, add 0 0, add 0 7, add 7 0] [3, 0, 7, 7],
        add 3 4 == add 4 3,
        structuralEquals [add 5 ((0 - 5) ), addThree 1 2 3, sum4 1 2 3 4, sum4 0 0 0 0, sum4 4 3 2 1] [0, 6, 10, 0, 10],
        structuralEquals [sum5 1 2 3 4 5, sum5 0 0 0 0 5, sum6 1 2 3 4 5 6, sum6 6 5 4 3 2 1] [15, 5, 21, 21],
        structuralEquals [sum6 0 0 0 0 0 0, sumFlat6 (1, 2, 3, 4, 5, 6)] [0, 21],
        sum6 1 2 3 4 5 6 == sumFlat6 (1, 2, 3, 4, 5, 6),
        sum6 1 2 3 4 5 6 != 20,
        sum5 1 2 3 4 5 != sum6 1 2 3 4 5 6
    ]

    // Left-associative application: the parentheses are noise, not structure.
    checkAll "every grouping of one curried call agrees" [
        (add 1) 2 == 3,
        (addThree 1) 2 3 == 6,
        (addThree 1 2) 3 == 6,
        (sum4 1) 2 3 4 == 10,
        (sum4 1 2) 3 4 == 10,
        (sum4 1 2 3) 4 == 10,
        ((sum4 1) 2) 3 4 == 10,
        ((sum4 1) 2 3) 4 == 10,
        (((sum4 1) 2) 3) 4 == 10,
        (sum5 1) 2 3 4 5 == 15,
        (sum5 1 2) 3 4 5 == 15,
        (sum5 1 2 3) 4 5 == 15,
        (sum5 1 2 3 4) 5 == 15,
        ((((sum5 1) 2) 3) 4) 5 == 15,
        (sum6 1) 2 3 4 5 6 == 21,
        (sum6 1 2 3) 4 5 6 == 21,
        (sum6 1 2 3 4 5) 6 == 21,
        (((((sum6 1) 2) 3) 4) 5) 6 == 21,
        (sum6 1 2 3 4 5 6) == 21
    ]

    // Each prefix partial of sum6 carries the arguments already supplied:
    // p1 holds 1, p2 holds 3, p3 holds 6, p4 holds 10, p5 holds 15.
    checkAll "prefix partials are reusable independent values" [
        structuralEquals [inc 41, inc 0, inc ((0 - 1) )] [42, 1, 0],
        inc 41 == inc 41,
        structuralEquals [p1 2 3 4 5 6, p2 3 4 5 6, p3 4 5 6, p4 5 6, p5 6, p5 0, p5 100] [21, 21, 21, 21, 21, 15, 115],
        structuralEquals [p4 0 0, p3 0 0 0, p2 0 0 0 0, p1 0 0 0 0 0] [10, 6, 3, 1],
        p5 6 != p5 7,
        p5 6 == p4 5 6,
        p3 4 5 6 == p2 3 4 5 6,
        p5 6 == sumFlat6 (1, 2, 3, 4, 5, 6),
        p1 2 3 4 5 6 == p5 6
    ]

    // The same ladder over strings, booleans and floats. blend3 a b c = a*b+c,
    // so blend3 2.0 3.0 1.0 = 7.0 and scaled = blend3 2.0 keeps the 2.0 factor.
    checkAll "currying is not integer-specific" [
        tag3 "a" "b" "c" == "abc",
        (tag3 "a") "b" "c" == "abc",
        (tag3 "a" "b") "c" == "abc",
        structuralEquals [openTag "x" ">", openTag "" ">", openTag "abc" "", tag3 "" "" ""] ["<x>", "<>", "<abc", ""],
        length (openTag "x" ">") == 3,
        all3 true true true,
        !(all3 true true false),
        !(all3 false true true),
        !(all3 true false true),
        bothTrue true true,
        !(bothTrue true false),
        !(bothTrue false false),
        blend3 2.0 3.0 1.0 == 7.0,
        blend3 2.0 0.0 1.0 == 1.0,
        blend3 0.0 9.0 4.5 == 4.5,
        scaled 3.0 1.0 == 7.0,
        scaled 0.5 0.0 == 1.0,
        scaled 3.0 1.0 != blend3 2.0 3.0 2.0
    ]

(** Apply a curried two-argument function value: three whitespace parameters,
    the innermost of which is itself applied by juxtaposition. *)
applyCurried f a b = f a b

(** Apply a flat two-parameter function value to one tuple — the parenthesised
    comma list on both the head and the call site [FLAVOR-ML-TUPLE]. *)
applyFlat (f, a, b) = f (a, b)

(** [FLAVOR-ML-FN]: "Lambdas follow the same split: `\x y => body` is curried and
    `\(x, y) => body` is flat." Nothing in the corpus exercised the curried
    lambda head, so this case pins it: a curried lambda must behave exactly like
    the explicit nested form `\x => \y => body`, must partially apply, and must
    stay distinguishable from the flat head, which takes one tuple and does not
    partially apply. *)
lambdaCurryingCase () =
    curriedAdd = \x y => x + y 
    flatAdd = \(x, y) => x + y 
    nestedAdd = \x => \y => x + y 
    curriedTri = \x y z => (x + y ) + z 
    bump = curriedAdd 10
    tri1 = curriedTri 1
    tri2 = curriedTri 1 2
    joinTwo = \a b => a + b
    andBoth = \a b => a && b
    offset = 100
    shifted = \x => x + offset 

    // Curried and flat heads compute the same sums from the same arguments;
    // only their application shape differs.
    checkAll "curried and flat lambda heads split as specified" [
        curriedAdd 3 4 == 7,
        (curriedAdd 3) 4 == 7,
        structuralEquals [curriedAdd 0 0, curriedAdd 0 9, curriedAdd 9 0] [0, 9, 9],
        curriedAdd 3 4 == curriedAdd 4 3,
        structuralEquals [curriedAdd 5 ((0 - 5) ), flatAdd (3, 4), flatAdd (0, 0), flatAdd (0, 9)] [0, 7, 0, 9],
        structuralEquals [flatAdd (9, 0), flatAdd (5, ((0 - 5) ))] [9, 0],
        flatAdd (3, 4) == curriedAdd 3 4,
        structuralEquals [bump 5, bump 0, bump ((0 - 10) )] [15, 10, 0],
        bump 5 != curriedAdd 5 5,
        bump 5 == curriedAdd 10 5
    ]

    // `\x y => e` and `\x => \y => e` are the same value by [FLAVOR-ML-CURRY].
    checkAll "a curried lambda head is nested one-parameter lambdas" [
        nestedAdd 3 4 == 7,
        (nestedAdd 3) 4 == 7,
        nestedAdd 3 4 == curriedAdd 3 4,
        nestedAdd 0 0 == curriedAdd 0 0,
        nestedAdd 12 30 == 42,
        curriedTri 1 2 3 == 6,
        (curriedTri 1) 2 3 == 6,
        (curriedTri 1 2) 3 == 6,
        ((curriedTri 1) 2) 3 == 6,
        structuralEquals [curriedTri 0 0 0, tri1 2 3, tri2 3] [0, 6, 6],
        tri1 2 3 == tri2 3,
        structuralEquals [tri1 0 0, tri2 0, tri1 2 4] [1, 3, 7],
        tri1 2 3 != tri1 2 4
    ]

    // A lambda keeps its arity shape when it is passed as an argument, piped
    // into, or closed over an outer binding.
    checkAll "lambdas keep their arity shape through higher-order calls" [
        structuralEquals [applyCurried curriedAdd 3 4, applyCurried nestedAdd 3 4] [7, 7],
        structuralEquals [applyCurried curriedAdd 0 0, applyCurried (\x y => x + y ) 20 22] [0, 42],
        applyCurried (\x y => (x + y ) + 1 ) 20 21 == 42,
        (applyCurried curriedAdd 3) 4 == 7,
        applyCurried curriedAdd 3 4 != applyCurried curriedAdd 3 5,
        structuralEquals [applyFlat (flatAdd, 3, 4), applyFlat (flatAdd, 0, 0)] [7, 0],
        applyFlat (flatAdd, 5, ((0 - 5) )) == 0,
        applyFlat (flatAdd, 3, 4) == applyCurried curriedAdd 3 4,
        (5 |> \x => x + 100 ) == 105,
        (5 |> (\x => x + 100 ) |> (\x => x * 2 )) == 210,
        shifted 5 == 105,
        shifted 0 == 100,
        shifted 5 == curriedAdd 100 5
    ]

    // The same lambda forms over strings and booleans.
    checkAll "curried lambdas over strings and booleans" [
        joinTwo "a" "b" == "ab",
        (joinTwo "a") "b" == "ab",
        structuralEquals [joinTwo "" "", joinTwo "" "b", joinTwo "a" ""] ["", "b", "a"],
        length (joinTwo "ab" "cde") == 5,
        structuralEquals [startsWith (joinTwo "ab" "cde") "ab", endsWith (joinTwo "ab" "cde") "cde"] [true, true],
        containsAll (joinTwo "ab" "cde") ["bc"],
        containsNone (joinTwo "ab" "cde") ["ce"],
        toUpperCase (joinTwo "ab" "cd") == "ABCD",
        toLowerCase (joinTwo "AB" "CD") == "abcd",
        andBoth true true,
        !(andBoth true false),
        !(andBoth false true),
        !(andBoth false false),
        (andBoth true) true,
        !((andBoth false) true)
    ]

(** One record with a field of each scalar kind, so an update can be observed
    field by field [FLAVOR-ML-TYPE]. *)
type Reading =
    sensor : string
    value : float
    depth : int
    valid : bool

(** The layout construction form of [FLAVOR-ML-RECORD] — an uppercase head
    followed by an indented `field = value` block. It must build exactly what
    the inline `Reading(field = value, ...)` head builds. *)
layoutBuilt =
    Reading
        sensor = "north"
        value = 1.5
        depth = 3
        valid = true

(** Whether `record` carries `sensor`, `value`, `depth` and `valid` exactly. *)
holdsFields record sensor value depth valid =
    record.sensor == sensor && record.value == value && record.depth == depth && record.valid == valid

(** [FLAVOR-ML-RECORD]: an uppercase head is construction and lowers to
    `Expr::TypeConstructor`; a lowercase inline head is a non-destructive record
    update and lowers to `Expr::Update`. "Non-destructive" is the load-bearing
    word, so every derived record below is checked field by field AND the source
    is re-read afterwards — a destructive update would pass the derived checks
    and only fail the source ones. The headless brace literal
    [FLAVOR-ML-RECORD-ANON] is deliberately absent: the spec marks it not
    implemented and pins its rejection in src/osprey/examples/failscompilation/. *)
recordLayoutAndUpdateCase () =
    inlineBuilt = Reading(sensor = "north", value = 1.5, depth = 3, valid = true)
    renamed = inlineBuilt(sensor = "south")
    revalued = inlineBuilt(value = 2.5)
    deepened = inlineBuilt(depth = 30)
    invalidated = inlineBuilt(valid = false)
    twoFields = inlineBuilt(sensor = "south", depth = 30)
    everything = inlineBuilt(sensor = "east", value = 0.0, depth = 0, valid = false)
    doubledValue = inlineBuilt.value * 2.0
    nextDepth = inlineBuilt.depth + 1 
    computed = inlineBuilt(value = doubledValue, depth = nextDepth)
    chained = renamed(depth = 4)
    reverted = renamed(sensor = inlineBuilt.sensor)

    // The layout head and the inline head must agree on all four fields.
    checkAll "layout and inline record heads build the same value" [
        holdsFields layoutBuilt "north" 1.5 3 true,
        holdsFields inlineBuilt "north" 1.5 3 true,
        layoutBuilt.sensor == inlineBuilt.sensor,
        layoutBuilt.value == inlineBuilt.value,
        layoutBuilt.depth == inlineBuilt.depth,
        layoutBuilt.valid == inlineBuilt.valid,
        length layoutBuilt.sensor == 5,
        startsWith layoutBuilt.sensor "no",
        !(layoutBuilt.value == 2.5),
        "${layoutBuilt.sensor}@${layoutBuilt.depth}" == "north@3"
    ]

    // An update replaces exactly the named fields and copies the rest.
    checkAll "an update replaces exactly the named fields" [
        structuralEquals [holdsFields renamed "south" 1.5 3 true, holdsFields revalued "north" 2.5 3 true] [true, true],
        holdsFields deepened "north" 1.5 30 true,
        !invalidated.valid,
        holdsFields invalidated "north" 1.5 3 false,
        holdsFields twoFields "south" 1.5 30 true,
        holdsFields everything "east" 0.0 0 false
    ]

    // Every derived record leaves its source untouched, including a second
    // update derived from an already-derived record.
    checkAll "every derived record leaves its source untouched" [
        holdsFields inlineBuilt "north" 1.5 3 true,
        renamed.sensor != inlineBuilt.sensor,
        revalued.value != inlineBuilt.value,
        deepened.depth != inlineBuilt.depth,
        invalidated.valid != inlineBuilt.valid,
        everything.depth != inlineBuilt.depth,
        holdsFields chained "south" 1.5 4 true,
        renamed.depth == 3,
        reverted.sensor == "north",
        reverted.depth == 3,
        reverted.sensor == inlineBuilt.sensor,
        reverted.valid == inlineBuilt.valid,
        reverted.sensor != renamed.sensor
    ]

    // An update expression may read the source's own fields: 1.5 * 2.0 = 3.0
    // and 3 + 1 = 4, with the source still reading 1.5 and 3 afterwards.
    checkAll "computed updates read the source's own fields" [
        doubledValue == 3.0,
        nextDepth == 4,
        holdsFields computed "north" 3.0 4 true,
        inlineBuilt.value == 1.5,
        inlineBuilt.depth == 3,
        computed.value == inlineBuilt.value * 2.0,
        computed.depth == (inlineBuilt.depth + 1 ),
        computed.value > inlineBuilt.value,
        computed.depth > inlineBuilt.depth,
        computed.value != inlineBuilt.value,
        structuralEquals [toString computed.value, "${computed.sensor}:${computed.depth}"] ["3.0", "north:4"],
        "${computed.value}" == "3.0"
    ]

(** A layout union mixing a two-field variant, a one-field variant and a
    payload-free variant [FLAVOR-ML-TYPE], [FLAVOR-ML-UNION-INLINE]. *)
type Level =
    Deep
        marker : string
        rank : int
    Shallow
        marker : string
    Flat

(** Adjacent clauses whose first column is refutable form one function by cases
    [FLAVOR-ML-CLAUSES]; the parenthesised constructor pattern is the clause-head
    spelling [FLAVOR-ML-PATTERN-GROUP]. *)
describeLevel (Deep marker rank) = "deep:${marker}:${rank}"
describeLevel (Shallow marker) = "shallow:${marker}"
describeLevel (Flat) = "flat"

(** [FLAVOR-ML-MATCH]: "A constructor payload binder takes its column, not the
    field that shares its spelling." Here every binder IS a declared field name,
    spelled in the opposite order, so only column order can resolve them: `rank`
    must take the string in slot 0 and `marker` the int in slot 1. *)
swappedLevel v =
    match v
        Deep rank marker => "${rank}/${marker}"
        Shallow rank => "${rank}"
        Flat => "-"

(** Integer literal clauses with a trailing wildcard [FLAVOR-ML-CLAUSES]. *)
band 0 = "zero"
band 1 = "one"
band 2 = "two"
band _ = "many"

(** String literals select a match arm by value [FLAVOR-ML-MATCH]. *)
route path =
    match path
        "" => "root"
        "/" => "root"
        "/home" => "home"
        _ => "other"

(** List patterns in clause heads: empty, singleton, exact pair, and head-tail
    [FLAVOR-ML-MATCH]. The signature pins the element type the `[]` clause cannot
    infer on its own. *)
shape : List int -> string
shape [] = "empty"
shape [only] = "one(${only})"
shape [first, second] = "two(${first},${second})"
shape [head, ...tail] = "many(${head}+${listLength tail})"

(** `Success`/`Error` are the exception to the column rule and bind by role
    [FLAVOR-ML-MATCH]; an out-of-range index takes the `Error` arm
    [BUILTIN-LIST-GET]. *)
readAt xs i =
    match listGet xs i
        Success value => "at ${i} = ${value}"
        Error _message => "miss ${i}"

(** ML's selection forms all lower to `Expr::Match` — indented match arms,
    adjacent equational clauses, and list patterns alike [FLAVOR-ML-MATCH],
    [FLAVOR-ML-CLAUSES]. This case drives each of them across its own boundary
    inputs: every variant of a three-way union, a payload binder set against its
    like-named field, every literal clause plus the wildcard that follows them,
    and the empty / singleton / pair / longer list shapes on both sides of the
    32-element-free head-tail split. *)
matchLayoutAndClausesCase () =
    deep = Deep(marker = "north", rank = 7)
    shallow = Shallow(marker = "south")
    nums = [10, 20, 30]
    single = [42]

    // One clause per variant, each reading its own payload.
    checkAll "layout union variants dispatch to their own clause" [
        structuralEquals [describeLevel deep, describeLevel shallow] ["deep:north:7", "shallow:south"],
        structuralEquals [describeLevel Flat, describeLevel (Deep(marker = "", rank = 0))] ["flat", "deep::0"],
        describeLevel (Shallow(marker = "")) == "shallow:",
        describeLevel deep != describeLevel shallow,
        structuralEquals [startsWith (describeLevel deep) "deep:", endsWith (describeLevel deep) ":7"] [true, true],
        contains (describeLevel deep) "north",
        !(contains (describeLevel shallow) "north"),
        length (describeLevel Flat) == 4,
        describeLevel (Deep(marker = "north", rank = 7)) == describeLevel deep,
        describeLevel (Deep(marker = "north", rank = 8)) != describeLevel deep,
        describeLevel (Shallow(marker = "north")) != describeLevel deep,
        describeLevel (Deep(marker = "a b", rank = 12)) == "deep:a b:12",
        describeLevel (Deep(marker = "12", rank = 12)) == "deep:12:12"
    ]

    // Column order wins over spelling: "north/7", never "7/north".
    checkAll "a payload binder takes its column, not its spelling" [
        structuralEquals [swappedLevel deep, swappedLevel shallow, swappedLevel Flat] ["north/7", "south", "-"],
        swappedLevel (Deep(marker = "x", rank = 1)) == "x/1",
        swappedLevel deep != describeLevel deep,
        structuralEquals [contains (swappedLevel deep) "/", startsWith (swappedLevel deep) "north"] [true, true],
        endsWith (swappedLevel deep) "7",
        length (swappedLevel deep) == 7,
        swappedLevel (Deep(marker = "", rank = 0)) == "/0",
        swappedLevel (Shallow(marker = "")) == "",
        !(contains (swappedLevel Flat) "north"),
        swappedLevel (Deep(marker = "7", rank = 7)) == "7/7",
        swappedLevel (Deep(marker = "north", rank = 8)) != swappedLevel deep
    ]

    // Literal clauses match their own value only; everything else falls to the
    // wildcard that follows them.
    checkAll "literal clauses and the wildcard that follows them" [
        structuralEquals [band 0, band 1, band 2, band 3, band 99] ["zero", "one", "two", "many", "many"],
        band ((0 - 1) ) == "many",
        band 0 != band 1,
        band 3 == band 99,
        structuralEquals [route "", route "/", route "/home", route "/away"] ["root", "root", "home", "other"],
        structuralEquals [route "home", route "/HOME", route (toLowerCase "/HOME")] ["other", "other", "home"],
        route " " == "other",
        route "" == route "/",
        route "/home" != route "/away"
    ]

    // List shapes: [] and [x] and [x, y] each own a clause, and everything
    // longer takes head-tail, whose tail length is one less than the list.
    checkAll "list patterns and Result arms select by shape" [
        structuralEquals [shape (List ()), shape single, shape [1, 2]] ["empty", "one(42)", "two(1,2)"],
        structuralEquals [shape nums, shape [1, 2, 3, 4]] ["many(10+2)", "many(1+3)"],
        structuralEquals [shape (listAppend nums 40), shape (listReverse nums)] ["many(10+3)", "many(30+2)"],
        shape (listPrepend nums 5) == "many(5+3)",
        shape single != shape nums,
        structuralEquals (mapList [0, 1, 2] (\k => readAt nums k)) ["at 0 = 10", "at 1 = 20", "at 2 = 30"],
        structuralEquals [readAt nums 3, readAt nums 99, readAt nums ((0 - 1) )] ["miss 3", "miss 99", "miss -1"],
        structuralEquals [readAt single 0, readAt [7] 1, readAt [7] 0] ["at 0 = 42", "miss 1", "at 0 = 7"],
        readAt nums 0 != readAt nums 1,
        contains (readAt nums 1) "20",
        !(contains (readAt nums 3) "=")
    ]

(** An indented body is a block whose preceding lines are statements and whose
    last line is its value [FLAVOR-ML-BLOCK]. Blank and comment-only lines do not
    affect layout [FLAVOR-ML-LAYOUT], and block comments nest
    [FLAVOR-ML-COMMENTS]. The result is 3n + 1. *)
staged n =
    doubled = n + n 

    // A comment-only line inside the block.
    (* A nested (* block *) comment inside the block. *)
    tripled = doubled + n 
    tripled + 1 

(** Parentheses suppress layout tokens until their matching delimiter
    [FLAVOR-ML-LAYOUT], so one expression may span several lines inside them. *)
spread a b = (a
    + b
    )

(** Layout and interpolation are the two places where ML's surface differs from
    Default without any AST difference to show for it [FLAVOR-BOUNDARY]. This
    case pins both: an indented block evaluates to its last line, a
    parenthesised expression survives being split across lines, an interpolation
    hole holds a juxtaposed call, and a checked integer operation left inside a
    hole renders arithmetic directly — `${3 + 5}` is `8`
    ([ARITH-CHECKED]). Collection literals and indexing round out the boundary
    inputs: first index, last index, one past the end, and a missing key. *)
layoutAndInterpolationCase () =
    xs = [3, 5, 8, 13]
    prices = ["apple" => 2, "banana" => 3]
    first = xs[0] ?: 0
    last = xs[3] ?: 0
    past = xs[4] ?: ((0 - 1) )
    apple = prices["apple"] ?: 0
    missing = prices["pear"] ?: ((0 - 1) )
    flavorName = "ml"
    ratio = 1.5
    text = "ab, ab, 12"

    // staged n = 3n + 1; spread a b = a + b across three source lines.
    checkAll "layout blocks and split parentheses are one expression" [
        structuralEquals [staged 0, staged 1, staged 2, staged 3, staged 4, staged 5] [1, 4, 7, 10, 13, 16],
        staged 10 == 31,
        staged 5 != staged 4,
        spread 2 3 == 5,
        spread 0 0 == 0,
        spread 2 3 == spread 3 2,
        structuralEquals [spread 20 22, spread 5 ((0 - 5) ), spread 1 2] [42, 0, 3],
        staged 5 == spread 10 6,
        staged 0 == spread 1 0
    ]

    // An interpolation hole renders the value it holds: an unwrapped int as a
    // bare number, a checked operation as its Result, a bool as true/false.
    checkAll "interpolation renders juxtaposed calls and checked arithmetic" [
        structuralEquals ["${add 3 5}", "${addThree 1 2 5}", "${staged 5}"] ["8", "8", "16"],
        structuralEquals ["${toString (staged 5)}", "${3 + 5}"] ["16", "8"],
        structuralEquals ["total=${add 3 5} raw=${3 + 5}", "${toUpperCase flavorName}"] ["total=8 raw=8", "ML"],
        structuralEquals ["${length flavorName}", "${first}/${last}", "${apple}"] ["2", "3/13", "2"],
        structuralEquals ["${missing}", "${past}"] ["-1", "-1"],
        "${3 < 5}" == "true",
        "${3 > 5}" == "false",
        structuralEquals ["${ratio}", "a${flavorName}b", "${flavorName}${flavorName}"] ["1.5", "amlb", "mlml"],
        "${spread 20 22}" == "42"
    ]

    // Indexing and map lookup at the first slot, the last slot, one past the
    // end, and a key that was never set [FLAVOR-ML-INDEX], [FLAVOR-ML-MAP].
    checkAll "list and map literals index and fall back as declared" [
        first == 3,
        last == 13,
        past == ((0 - 1) ),
        (xs[1] ?: 0) == 5,
        (xs[2] ?: 0) == 8,
        (listGet xs 0 ?: 0) == first,
        (listGet xs 3 ?: 0) == last,
        (listGet xs 4 ?: 0) == 0,
        listLength xs == 4,
        listContains xs 8,
        !(listContains xs 4),
        !(isEmpty xs),
        apple == 2,
        missing == ((0 - 1) ),
        (prices["banana"] ?: 0) == 3,
        (mapGet prices "apple" ?: 0) == apple,
        mapLength prices == 2,
        mapContains prices "apple",
        !(mapContains prices "pear"),
        mapLength (mapRemove prices "apple") == 1,
        mapLength prices == 2
    ]

    // Text boundaries: empty needle, prefix, suffix, an absent reversal, a
    // repeated substring, digits inside a string, and case folding.
    checkAll "string builtins over the boundary shapes" [
        length text == 10,
        !(isEmpty text),
        isEmpty "",
        length "" == 0,
        structuralEquals [startsWith text "ab", endsWith text "12", startsWith text ""] [true, true, true],
        structuralEquals [endsWith text "", contains text "", containsAll text [", ", "ab"]] [true, true, true],
        !(contains text "ba"),
        !(startsWith text "b"), !(endsWith text "1"),
        toUpperCase text == "AB, AB, 12",
        toLowerCase "AB, AB, 12" == text,
        toUpperCase (toLowerCase text) == toUpperCase text,
        toLowerCase text == text,
        length (toUpperCase text) == length text,
        contains (toUpperCase text) "AB",
        !(contains text "AB")
    ]

// Registration order fixes the TAP numbering, so these follow the four cases
// registered above.
test "Verdict folding obeys the andThen monoid laws" (\() => exactArithmetic (verdictAlgebraCase))
test "curried arities two through six apply in every grouping" (\() => exactArithmetic (curriedArityLadderCase))
test "curried and flat lambda heads split as specified" (\() => exactArithmetic (lambdaCurryingCase))
test "ML record layout, inline heads and updates agree" (\() => exactArithmetic (recordLayoutAndUpdateCase))
test "ML match layout, clauses and list patterns select correctly" (\() => exactArithmetic (matchLayoutAndClausesCase))
test "ML layout blocks and interpolation render juxtaposed calls" (\() => exactArithmetic (layoutAndInterpolationCase))
