(** Represent pure pass, failure, and precondition-skip outcomes. *)
type Verdict = Pass | Fail string | Skip string

(** Build a Verdict from a labeled canonical-text comparison. *)
checkVerdict : string -> string -> string -> Verdict
checkVerdict label expected actual = match expected == actual
    true => Pass
    false => Fail "${label}: expected ${expected}, got ${actual}"

(** Turn a boolean precondition into Pass or Skip. *)
assume true = Pass
assume false = Skip "precondition not met"

(** Keep the first failure or skip, otherwise return the next Verdict. *)
andThen (Pass) rest = rest
andThen (Fail reason) _ = Fail reason
andThen (Skip why) _ = Skip why

(** Whether every already-evaluated check in `checks` holds. *)
all checks = foldList checks true (\(held, ok) => held && ok)

(** Add two integers for the composed Verdicts. *)
add a b = a + b 

(** Fold arithmetic, interpolation, and booleans into a passing Verdict. *)
passingCase () =
    arithmetic = andThen (checkVerdict "sum" "5" (toString (add 2 3))) (checkVerdict "difference" "2" (toString (add 5 ((0 - 3) ))))
    text = andThen (checkVerdict "interpolation" "total=8" "total=${add 3 5}") (checkVerdict "bool" "true" (toString (3 < 5)))
    andThen arithmetic text

(** Preserve an unmet precondition as Skip after eager argument evaluation. *)
skippedCase () =
    andThen (assume (2 > 3)) (checkVerdict "ignored after skip" "0" "1")

exactTests [
    { name = "pass folds several good interactions", work = passingCase },
    { name = "skip preserves an unmet precondition", work = skippedCase }
]

(** Trace records every operation a curried body performs. *)
effect Trace
    (** Record one step and answer its 1-based index. *)
    step : string => int

(** One operation through the handler; every arity below shares this body. *)
stepOf label = perform Trace.step label

(** Each declared arity records every parameter through the handler; arity four
    is the shape [#184](issue) reports as silently skipping one [FLAVOR-ML-CURRY]. *)
traced2 a b = add (stepOf a) (stepOf b)
traced3 a b c = addThree (stepOf a) (stepOf b) (stepOf c)
traced4 a b c d = sum4 (stepOf a) (stepOf b) (stepOf c) (stepOf d)
traced5 a b c d e = sum5 (stepOf a) (stepOf b) (stepOf c) (stepOf d) (stepOf e)

(** Parenthesised comma parameters are flat, the form the spec names working. *)
tracedFlat (a, b, c, d) = traced4 a b c d

(** Curried and flat bodies perform through one handler, so their indices form
    an unbroken 1..18 sequence a skip would shorten. *)
curriedEffectsReachTheHandlerCase () =
    mut seen = ""
    mut steps = 0
    traceReport =
        handle Trace
            step label =>
                steps := steps + 1 
                seen := "${seen}${label}|"
                steps
        r2 = traced2 "a" "b"
        r3 = traced3 "c" "d" "e"
        r4 = traced4 "f" "g" "h" "i"
        r5 = traced5 "j" "k" "l" "m" "n"
        rf = tracedFlat ("o", "p", "q", "r")
        "${r2}/${r3}/${r4}/${r5}/${rf}"
    // Each arity consumes consecutive indices: 1-2, 3-5, 6-9, 10-14, 15-18.
    checkAll "curried arities consume every operation index" [
        all [traceReport == "3/12/30/60/66", startsWith traceReport "3/", endsWith traceReport "/66", containsAll traceReport ["/12/", "/30/", "/60/"], containsNone traceReport ["/0/", "//"]]
    ]
    // The handler saw eighteen distinct labels, in source order, once each.
    checkAll "every performed label reached the handler" [
        structuralEquals [steps, length seen, steps] [18, 36, 18], all [seen == "a|b|c|d|e|f|g|h|i|j|k|l|m|n|o|p|q|r|", startsWith seen "a|b|", endsWith seen "q|r|", containsAll seen ["e|f|", "i|j|", "n|o|"], steps > 14, steps != 14, steps != 9]
    ]
    // The arity-4 curried body and its flat twin must agree operation for
    // operation: 6+7+8+9 == 30 and 15+16+17+18 == 66, four steps each.
    // `?:` is the LOWEST precedence and right-associative, so every sum
    // that ends in one needs its own parentheses to sit under the `==`
    // [SYNTAX] — without them `x ?: 0 == 30` reads `x ?: (0 == 30)`.
    checkAll "curried and flat four-parameter bodies agree" [
        all [((6 + 7 ) + (8 + 9 ) ) == 30, containsAll traceReport ["30", "66"]], structuralEquals [((15 + 16 ) + (17 + 18 ) ), (1 + 2 ), ((3 + 4 ) + 5 ), (((10 + 11 ) + (12 + 13 ) ) + 14 ), steps] [66, 3, 12, 60, 18]
    ]

(** Add three integers through whitespace parameters. *)
addThree a b c = (a + b ) + c 
addFlat (a, b, c) = addThree a b c

(** [FLAVOR-ML-CURRY]: `add 1 2` lowers to nested one-argument calls and `add 1`
    returns the remaining function, while parenthesised comma parameters are
    flat and do not partially apply. Both spellings must reach the same answer
    from every legal application shape. *)
partialApplicationCase () =
    onePart = addThree 1
    twoPart = addThree 1 2
    otherPart = addThree 10
    reused = onePart 2
    // Every grouping of the same three arguments is the same call.
    checkAll "curried application groups freely" [
        structuralEquals [addThree 1 2 3, (addThree 1) 2 3, (addThree 1 2) 3, ((addThree 1) 2) 3] [6, 6, 6, 6], structuralEquals [onePart 2 3, twoPart 3, reused 3, addFlat (1, 2, 3)] [6, 6, 6, 6], addThree 1 2 3 == addFlat (1, 2, 3)
    ]
    // A partial application is a value: reusing one does not consume it, and
    // two partials of the same function stay independent.
    checkAll "partial applications are independent reusable values" [
        structuralEquals [onePart 2 3, onePart 2 4, onePart 5 5, otherPart 2 3] [6, 7, 11, 15], structuralEquals [otherPart 20 30, twoPart 3, twoPart 30, reused 4] [60, 6, 33, 7], all [onePart 2 3 != otherPart 2 3, twoPart 3 == onePart 2 3, addFlat (10, 2, 3) == otherPart 2 3]
    ]

exactTests [
    { name = "curried ML bodies perform every operation through the handler", work = curriedEffectsReachTheHandlerCase },
    { name = "ML partial application follows the currying rule", work = partialApplicationCase }
]

(** Render a Verdict as canonical text so its state and payload are assertable
    without comparing unions: adjacent refutable-first-column clauses form one
    function by cases [FLAVOR-ML-CLAUSES], the parenthesised constructor pattern
    is the clause-head spelling [FLAVOR-ML-PATTERN-GROUP], and binders take their
    column [FLAVOR-ML-CTOR-POSITIONAL]. *)
verdictLabel (Pass) = "pass"
verdictLabel (Fail reason) = "fail(${reason})"
verdictLabel (Skip why) = "skip(${why})"

(** Whether regrouping an `andThen` chain leaves the same reported outcome. *)
associates left right = verdictLabel left == verdictLabel right

(** Whether combining two verdicts renders exactly `renders`. *)
thenRenders left right renders = verdictLabel (andThen left right) == renders

(** Whether `Pass` leaves `v` unchanged on either side of `andThen`. *)
identityAround v = verdictLabel (andThen Pass v) == verdictLabel v && verdictLabel (andThen v Pass) == verdictLabel v

(** Whether the labeled comparison renders exactly `renders`. *)
labeledRenders label expected actual renders =
    verdictLabel (checkVerdict label expected actual) == renders

(** Whether the precondition gate renders exactly `renders`. *)
gateRenders condition renders = verdictLabel (assume condition) == renders

(** [TESTING-VERDICT] fixes three contracts: `assume` maps a false precondition
    to `Skip` and a true one to `Pass`; the labeled comparison yields `Pass` on
    equality and a `Fail` carrying the mismatch otherwise; and `andThen` keeps the
    first non-Pass — a monoid on `Pass`, so each fold below is checked against the
    identity and associativity laws too. *)
verdictAlgebraCase () =
    fail1 = Fail "one"
    fail2 = Fail "two"
    skip1 = Skip "first"
    skip2 = Skip "second"
    sumCheck = checkVerdict "sum"
    mismatch = verdictLabel (checkVerdict "sum" "5" "6")
    // Nine ordered pairs over {Pass, Fail, Skip}: the first non-Pass wins, and
    // the second operand's payload must never surface when it does.
    checkAll "andThen retains the first non-Pass verdict" [
        thenRenders Pass Pass "pass", thenRenders Pass fail2 "fail(two)", thenRenders Pass skip2 "skip(second)", thenRenders fail1 Pass "fail(one)", thenRenders fail1 fail2 "fail(one)", thenRenders fail1 skip2 "fail(one)", thenRenders skip1 Pass "skip(first)", thenRenders skip1 fail2 "skip(first)", thenRenders skip1 skip2 "skip(first)",
        all [verdictLabel (andThen fail1 fail2) != verdictLabel fail2, verdictLabel (andThen skip1 skip2) != verdictLabel skip2, startsWith (verdictLabel (andThen fail1 skip2)) "fail(", endsWith (verdictLabel (andThen skip1 fail2)) ")", contains (verdictLabel (andThen fail1 fail2)) "one", !(contains (verdictLabel (andThen fail1 fail2)) "two"), !(contains (verdictLabel (andThen skip1 fail2)) "two")]
    ]
    // Monoid laws: Pass is a two-sided identity and andThen associates, so a
    // regrouped fold cannot change the reported outcome.
    checkAll "Pass is the identity of andThen and andThen associates" [
        identityAround Pass, identityAround fail1, identityAround skip1, associates (andThen (andThen Pass fail1) skip2) (andThen Pass (andThen fail1 skip2)), associates (andThen (andThen fail1 Pass) skip2) (andThen fail1 (andThen Pass skip2)), associates (andThen (andThen skip1 fail2) Pass) (andThen skip1 (andThen fail2 Pass)),
        all [thenRenders (andThen Pass Pass) fail2 "fail(two)", thenRenders Pass (andThen Pass fail2) "fail(two)", thenRenders (andThen Pass Pass) Pass "pass", thenRenders (andThen fail1 fail2) skip1 "fail(one)", thenRenders fail1 (andThen fail2 skip1) "fail(one)", thenRenders (andThen Pass Pass) (andThen Pass skip2) "skip(second)", thenRenders (andThen Pass skip2) (andThen Pass fail1) "skip(second)", thenRenders (andThen Pass fail1) (andThen Pass skip2) "fail(one)"]
    ]
    // The Fail payload is the whole labeled mismatch, verbatim. Its rendered
    // length is fixed: "fail(" + "sum: expected 5, got 6" (22) + ")" = 28.
    checkAll "the labeled mismatch is carried verbatim" [
        structuralEquals [verdictLabel (checkVerdict "sum" "5" "5"), mismatch, verdictLabel (sumCheck "5" "5"), verdictLabel (sumCheck "5" "6")] ["pass", "fail(sum: expected 5, got 6)", "pass", "fail(sum: expected 5, got 6)"],
        labeledRenders "empty" "" "" "pass", labeledRenders "empty" "" "x" "fail(empty: expected , got x)", labeledRenders "case" "A" "a" "fail(case: expected A, got a)", labeledRenders "space" " " " " "pass", labeledRenders "space" "a b" "ab" "fail(space: expected a b, got ab)", labeledRenders "digits" (toString (add 2 3)) "5" "pass", labeledRenders "bool" (toString (3 < 5)) "true" "pass", labeledRenders "sum" "5" "7" "fail(sum: expected 5, got 7)", labeledRenders "bool" (toString (5 < 3)) "true" "fail(bool: expected false, got true)",
        all [containsAll mismatch ["expected 5", "got 6"], startsWith mismatch "fail(sum:", length mismatch == 28, !(contains (verdictLabel (checkVerdict "sum" "5" "5")) "expected")]
    ]
    // assume is the precondition gate: "skip(" + "precondition not met" (20)
    // + ")" is 26 characters, and a Skip absorbs everything after it.
    checkAll "assume converts a precondition into Pass or Skip" [
        gateRenders true "pass", gateRenders false "skip(precondition not met)", gateRenders (2 > 3) "skip(precondition not met)", gateRenders ("a" == "b") "skip(precondition not met)", gateRenders (5 >= 5) "pass", gateRenders (5 > 5) "skip(precondition not met)", all [thenRenders (assume true) fail1 "fail(one)", thenRenders (assume false) fail1 "skip(precondition not met)", thenRenders fail1 (assume false) "fail(one)", thenRenders (assume true) (assume false) "skip(precondition not met)", thenRenders (assume true) (assume true) "pass"],
        structuralEquals [verdictLabel (assume (3 > 2)), verdictLabel (assume (0 == 0))] ["pass", "pass"], all [startsWith (verdictLabel (assume false)) "skip(", length (verdictLabel (assume false)) == 26, !(contains (verdictLabel (assume true)) "skip")]
    ]

(** Four whitespace parameters, built on `addThree` so no arithmetic repeats [FLAVOR-ML-CURRY]. *)
sum4 a b c d = addThree a b c + d 

(** Five whitespace parameters. *)
sum5 a b c d e = sum4 a b c d + e 

(** Six whitespace parameters — two arities past the shape issue #184 reports. *)
sum6 a b c d e f = sum5 a b c d e + f 

(** The explicitly flat twin of `sum6`: a flat comma list does not partially
    apply, so the two agree on every saturated call [FLAVOR-ML-CURRY], [FLAVOR-ML-TUPLE]. *)
sumFlat6 (a, b, c, d, e, f) = sum6 a b c d e f 

(** The same three whitespace parameters over strings, booleans and floats; float
    arithmetic is unchecked, so only integers need `?:` [ARITH-CHECKED]. *)
tag3 a b c = a + b + c

(** Three whitespace parameters over booleans. *)
all3 a b c = a && b && c
blend3 a b c = a * b + c

(** [FLAVOR-ML-CURRY]/[FLAVOR-ML-CALL]: `add x y = body` lowers to a one-parameter
    function returning a one-parameter lambda, and `f a b` is `Call(Call(f, [a]),
    [b])`, so every parenthesisation of one argument sequence is one call and
    every prefix a value. This case walks arities two to six, then repeats the
    ladder over strings, booleans and floats. *)
curriedArityLadderCase () =
    inc = add 1
    p1 = sum6 1
    p2 = sum6 1 2
    p3 = sum6 1 2 3
    p4 = sum6 1 2 3 4
    p5 = sum6 1 2 3 4 5
    openTag = tag3 "<"
    bothTrue = all3 true
    scaled = blend3 2.0
    // 1+2 = 3, 1+2+3+4 = 10, 1+..+5 = 15, 1+..+6 = 21.
    checkAll "every curried arity answers its own sum" [
        structuralEquals [add 1 2, add 0 0, add 0 7, add 7 0, add 5 ((0 - 5) ), addThree 1 2 3, sum4 1 2 3 4, sum4 0 0 0 0] [3, 0, 7, 7, 0, 6, 10, 0], structuralEquals [sum4 4 3 2 1, sum5 1 2 3 4 5, sum5 0 0 0 0 5, sum6 1 2 3 4 5 6, sum6 6 5 4 3 2 1, sum6 0 0 0 0 0 0, sumFlat6 (1, 2, 3, 4, 5, 6)] [10, 15, 5, 21, 21, 0, 21], all [add 3 4 == add 4 3, sum6 1 2 3 4 5 6 == sumFlat6 (1, 2, 3, 4, 5, 6), sum6 1 2 3 4 5 6 != 20, sum5 1 2 3 4 5 != sum6 1 2 3 4 5 6]
    ]
    // Left-associative application: the parentheses are noise, not structure.
    checkAll "every grouping of one curried call agrees" [
        structuralEquals [(add 1) 2, (addThree 1) 2 3, (addThree 1 2) 3, (sum4 1) 2 3 4, (sum4 1 2) 3 4, (sum4 1 2 3) 4, ((sum4 1) 2) 3 4] [3, 6, 6, 10, 10, 10, 10], structuralEquals [((sum4 1) 2 3) 4, (((sum4 1) 2) 3) 4, (sum5 1) 2 3 4 5, (sum5 1 2) 3 4 5, (sum5 1 2 3) 4 5, (sum5 1 2 3 4) 5] [10, 10, 15, 15, 15, 15], structuralEquals [((((sum5 1) 2) 3) 4) 5, (sum6 1) 2 3 4 5 6, (sum6 1 2 3) 4 5 6, (sum6 1 2 3 4 5) 6, (((((sum6 1) 2) 3) 4) 5) 6, (sum6 1 2 3 4 5 6)] [15, 21, 21, 21, 21, 21]
    ]
    // Each prefix partial of sum6 carries the arguments already supplied:
    // p1 holds 1, p2 holds 3, p3 holds 6, p4 holds 10, p5 holds 15.
    checkAll "prefix partials are reusable independent values" [
        structuralEquals [inc 41, inc 0, inc ((0 - 1) ), p1 2 3 4 5 6, p2 3 4 5 6, p3 4 5 6, p4 5 6, p5 6, p5 0, p5 100] [42, 1, 0, 21, 21, 21, 21, 21, 15, 115], structuralEquals [p4 0 0, p3 0 0 0, p2 0 0 0 0, p1 0 0 0 0 0] [10, 6, 3, 1], all [inc 41 == inc 41, p5 6 != p5 7, p5 6 == p4 5 6, p3 4 5 6 == p2 3 4 5 6, p5 6 == sumFlat6 (1, 2, 3, 4, 5, 6), p1 2 3 4 5 6 == p5 6]
    ]
    // The same ladder over strings, booleans and floats. blend3 a b c = a*b+c,
    // so blend3 2.0 3.0 1.0 = 7.0 and scaled = blend3 2.0 keeps the 2.0 factor.
    checkAll "currying is not integer-specific" [
        structuralEquals [tag3 "a" "b" "c", (tag3 "a") "b" "c", (tag3 "a" "b") "c", openTag "x" ">", openTag "" ">", openTag "abc" "", tag3 "" "" ""] ["abc", "abc", "abc", "<x>", "<>", "<abc", ""], all [length (openTag "x" ">") == 3, answersHold (\c => all3 true true c) [true, false] [true, false], answersHold (\a => all3 a false true) [true, false] [false, false], answersHold (\a => bothTrue a true) [true] [true], answersHold (\a => bothTrue a false) [true, false] [false, false]],
        structuralEquals [blend3 2.0 3.0 1.0, blend3 2.0 0.0 1.0, blend3 0.0 9.0 4.5, scaled 3.0 1.0, scaled 0.5 0.0] [7.0, 1.0, 4.5, 7.0, 1.0], scaled 3.0 1.0 != blend3 2.0 3.0 2.0
    ]

(** Apply a curried two-argument function value: three whitespace parameters,
    the innermost of which is itself applied by juxtaposition. *)
applyCurried f a b = f a b

(** Apply a flat two-parameter function value to one tuple — the parenthesised
    comma list on both the head and the call site [FLAVOR-ML-TUPLE]. *)
applyFlat (f, a, b) = f (a, b)

(** [FLAVOR-ML-FN]: `\x y => body` is curried and `\(x, y) => body` is flat; a
    curried lambda must behave like `\x => \y => body` and partially apply. *)
lambdaCurryingCase () =
    curriedAdd = \x y => x + y 
    flatAdd = \(x, y) => x + y 
    nestedAdd = \x => \y => x + y 
    curriedTri = \x y z => (x + y ) + z 
    bump = curriedAdd 10
    tri1 = curriedTri 1
    tri2 = curriedTri 1 2
    joinTwo = \a b => a + b
    andBoth = \a b => a && b
    offset = 100
    shifted = \x => x + offset 
    // Curried and flat heads compute the same sums from the same arguments;
    // only their application shape differs.
    checkAll "curried and flat lambda heads split as specified" [
        structuralEquals [curriedAdd 3 4, (curriedAdd 3) 4, curriedAdd 0 0, curriedAdd 0 9, curriedAdd 9 0, curriedAdd 5 ((0 - 5) ), flatAdd (3, 4), flatAdd (0, 0)] [7, 7, 0, 9, 9, 0, 7, 0], structuralEquals [flatAdd (0, 9), flatAdd (9, 0), flatAdd (5, ((0 - 5) )), bump 5, bump 0, bump ((0 - 10) )] [9, 9, 0, 15, 10, 0], all [curriedAdd 3 4 == curriedAdd 4 3, flatAdd (3, 4) == curriedAdd 3 4, bump 5 != curriedAdd 5 5, bump 5 == curriedAdd 10 5]
    ]
    // `\x y => e` and `\x => \y => e` are the same value by [FLAVOR-ML-CURRY].
    checkAll "a curried lambda head is nested one-parameter lambdas" [
        structuralEquals [nestedAdd 3 4, (nestedAdd 3) 4, nestedAdd 12 30, curriedTri 1 2 3, (curriedTri 1) 2 3, (curriedTri 1 2) 3, ((curriedTri 1) 2) 3, curriedTri 0 0 0] [7, 7, 42, 6, 6, 6, 6, 0], structuralEquals [tri1 2 3, tri2 3, tri1 0 0, tri2 0, tri1 2 4] [6, 6, 1, 3, 7], all [nestedAdd 3 4 == curriedAdd 3 4, nestedAdd 0 0 == curriedAdd 0 0, tri1 2 3 == tri2 3, tri1 2 3 != tri1 2 4]
    ]
    // A lambda keeps its arity shape when it is passed as an argument, piped
    // into, or closed over an outer binding.
    checkAll "lambdas keep their arity shape through higher-order calls" [
        structuralEquals [applyCurried curriedAdd 3 4, applyCurried nestedAdd 3 4, applyCurried curriedAdd 0 0, applyCurried (\x y => x + y ) 20 22] [7, 7, 0, 42], structuralEquals [applyCurried (\x y => (x + y ) + 1 ) 20 21, (applyCurried curriedAdd 3) 4, applyFlat (flatAdd, 3, 4), applyFlat (flatAdd, 0, 0)] [42, 7, 7, 0], structuralEquals [applyFlat (flatAdd, 5, ((0 - 5) )), (5 |> \x => x + 100 ), (5 |> (\x => x + 100 ) |> (\x => x * 2 )), shifted 5, shifted 0] [0, 105, 210, 105, 100],
        all [applyCurried curriedAdd 3 4 != applyCurried curriedAdd 3 5, applyFlat (flatAdd, 3, 4) == applyCurried curriedAdd 3 4, shifted 5 == curriedAdd 100 5]
    ]
    // The same lambda forms over strings and booleans.
    checkAll "curried lambdas over strings and booleans" [
        structuralEquals [joinTwo "a" "b", (joinTwo "a") "b", joinTwo "" "", joinTwo "" "b", joinTwo "a" ""] ["ab", "ab", "", "b", "a"], structuralEquals [toUpperCase (joinTwo "ab" "cd"), toLowerCase (joinTwo "AB" "CD")] ["ABCD", "abcd"], length (joinTwo "ab" "cde") == 5, all [startsWith (joinTwo "ab" "cde") "ab", endsWith (joinTwo "ab" "cde") "cde"],
        all [containsAll (joinTwo "ab" "cde") ["bc"], containsNone (joinTwo "ab" "cde") ["ce"], andBoth true true, !(andBoth true false), !(andBoth false true), !(andBoth false false), (andBoth true) true, !((andBoth false) true)]
    ]

(** One record with a field of each scalar kind, so an update can be observed
    field by field [FLAVOR-ML-TYPE]. *)
type Reading =
    sensor : string
    value : float
    depth : int
    valid : bool

(** The layout construction form of [FLAVOR-ML-RECORD]: an uppercase head and an
    indented `field = value` block, building what the inline head builds. *)
layoutBuilt =
    Reading
        sensor = "north"
        value = 1.5
        depth = 3
        valid = true

(** Whether `record` carries `sensor`, `value`, `depth` and `valid` exactly. *)
holdsFields record sensor value depth valid =
    record.sensor == sensor && record.value == value && record.depth == depth && record.valid == valid

(** [FLAVOR-ML-RECORD]: an uppercase head constructs (`Expr::TypeConstructor`) and
    a lowercase inline head is a non-destructive update (`Expr::Update`), so every
    derived record is checked field by field AND its source re-read. The headless
    brace literal [FLAVOR-ML-RECORD-ANON] is absent: the spec marks it unimplemented
    and pins its rejection in failscompilation/. *)
recordLayoutAndUpdateCase () =
    inlineBuilt = Reading(sensor = "north", value = 1.5, depth = 3, valid = true)
    renamed = inlineBuilt(sensor = "south")
    revalued = inlineBuilt(value = 2.5)
    deepened = inlineBuilt(depth = 30)
    invalidated = inlineBuilt(valid = false)
    twoFields = inlineBuilt(sensor = "south", depth = 30)
    everything = inlineBuilt(sensor = "east", value = 0.0, depth = 0, valid = false)
    doubledValue = inlineBuilt.value * 2.0
    nextDepth = inlineBuilt.depth + 1 
    computed = inlineBuilt(value = doubledValue, depth = nextDepth)
    chained = renamed(depth = 4)
    reverted = renamed(sensor = inlineBuilt.sensor)
    // The layout head and the inline head must agree on all four fields.
    checkAll "layout and inline record heads build the same value" [
        all [holdsFields layoutBuilt "north" 1.5 3 true, holdsFields inlineBuilt "north" 1.5 3 true], all [layoutBuilt.sensor == inlineBuilt.sensor, layoutBuilt.value == inlineBuilt.value, layoutBuilt.depth == inlineBuilt.depth, layoutBuilt.valid == inlineBuilt.valid], all [length layoutBuilt.sensor == 5, startsWith layoutBuilt.sensor "no", !(layoutBuilt.value == 2.5), "${layoutBuilt.sensor}@${layoutBuilt.depth}" == "north@3"]
    ]

    // An update replaces exactly the named fields and copies the rest.
    checkAll "an update replaces exactly the named fields" [
        all [holdsFields renamed "south" 1.5 3 true, holdsFields revalued "north" 2.5 3 true, holdsFields deepened "north" 1.5 30 true, !invalidated.valid, holdsFields invalidated "north" 1.5 3 false, holdsFields twoFields "south" 1.5 30 true, holdsFields everything "east" 0.0 0 false]
    ]

    // Every derived record leaves its source untouched, including a second
    // update derived from an already-derived record.
    checkAll "every derived record leaves its source untouched" [
        all [holdsFields inlineBuilt "north" 1.5 3 true, holdsFields chained "south" 1.5 4 true, everything.depth != inlineBuilt.depth], all [renamed.sensor != inlineBuilt.sensor, revalued.value != inlineBuilt.value, deepened.depth != inlineBuilt.depth, invalidated.valid != inlineBuilt.valid], structuralEquals [renamed.depth, reverted.depth] [3, 3], all [reverted.sensor == "north", reverted.sensor == inlineBuilt.sensor, reverted.valid == inlineBuilt.valid, reverted.sensor != renamed.sensor]
    ]

    // An update expression may read the source's own fields: 1.5 * 2.0 = 3.0
    // and 3 + 1 = 4, with the source still reading 1.5 and 3 afterwards.
    checkAll "computed updates read the source's own fields" [
        structuralEquals [doubledValue, inlineBuilt.value] [3.0, 1.5], structuralEquals [nextDepth, inlineBuilt.depth] [4, 3], holdsFields computed "north" 3.0 4 true, all [computed.value == inlineBuilt.value * 2.0, computed.depth == (inlineBuilt.depth + 1 ), computed.value > inlineBuilt.value, computed.depth > inlineBuilt.depth], all [computed.value != inlineBuilt.value, toString computed.value == "3.0", "${computed.sensor}:${computed.depth}" == "north:4", "${computed.value}" == "3.0"]
    ]

(** A layout union with a two-field, a one-field and a payload-free variant [FLAVOR-ML-TYPE], [FLAVOR-ML-UNION-INLINE]. *)
type Level =
    Deep
        marker : string
        rank : int
    Shallow
        marker : string
    Flat

(** Adjacent refutable-first-column clauses form one function by cases
    [FLAVOR-ML-CLAUSES]; a parenthesised pattern is the clause-head spelling [FLAVOR-ML-PATTERN-GROUP]. *)
describeLevel (Deep marker rank) = "deep:${marker}:${rank}"
describeLevel (Shallow marker) = "shallow:${marker}"
describeLevel (Flat) = "flat"

(** [FLAVOR-ML-MATCH]: "A constructor payload binder takes its column, not the
    field that shares its spelling." Here every binder IS a declared field name,
    spelled in the opposite order, so only column order can resolve them: `rank`
    must take the string in slot 0 and `marker` the int in slot 1. *)
swappedLevel v =
    match v
        Deep rank marker => "${rank}/${marker}"
        Shallow rank => "${rank}"
        Flat => "-"

(** Both renderers must reach their Deep clause for any payload spelling. *)
deepRenders f marker rank renders = f (Deep(marker = marker, rank = rank)) == renders

(** Integer literal clauses with a trailing wildcard [FLAVOR-ML-CLAUSES]. *)
band 0 = "zero"
band 1 = "one"
band 2 = "two"
band _ = "many"

(** String literals select a match arm by value [FLAVOR-ML-MATCH]. *)
route path =
    match path
        "" => "root"
        "/" => "root"
        "/home" => "home"
        _ => "other"

(** List patterns in clause heads: empty, singleton, exact pair and head-tail
    [FLAVOR-ML-MATCH]; the signature pins the `[]` clause's element type. *)
shape : List int -> string
shape [] = "empty"
shape [only] = "one(${only})"
shape [first, second] = "two(${first},${second})"
shape [head, ...tail] = "many(${head}+${listLength tail})"

(** `Success`/`Error` bind by role, the exception to the column rule
    [FLAVOR-ML-MATCH]; an out-of-range index takes the `Error` arm [BUILTIN-LIST-GET]. *)
readAt xs i =
    match listGet xs i
        Success value => "at ${i} = ${value}"
        Error _message => "miss ${i}"

(** ML's selection forms all lower to `Expr::Match` — indented arms, adjacent
    equational clauses and list patterns alike [FLAVOR-ML-MATCH], [FLAVOR-ML-CLAUSES];
    this case drives each over its boundary inputs. *)
matchLayoutAndClausesCase () =
    deep = Deep(marker = "north", rank = 7)
    shallow = Shallow(marker = "south")
    nums = [10, 20, 30]
    single = [42]

    // One clause per variant, each reading its own payload.
    checkAll "layout union variants dispatch to their own clause" [
        structuralEquals [describeLevel deep, describeLevel shallow, describeLevel Flat, describeLevel (Deep(marker = "", rank = 0))] ["deep:north:7", "shallow:south", "flat", "deep::0"], describeLevel (Shallow(marker = "")) == "shallow:", deepRenders describeLevel "a b" 12 "deep:a b:12", deepRenders describeLevel "12" 12 "deep:12:12", describeLevel deep != describeLevel shallow, all [startsWith (describeLevel deep) "deep:", endsWith (describeLevel deep) ":7", contains (describeLevel deep) "north", !(contains (describeLevel shallow) "north"), length (describeLevel Flat) == 4],
        all [describeLevel (Deep(marker = "north", rank = 7)) == describeLevel deep, describeLevel (Deep(marker = "north", rank = 8)) != describeLevel deep, describeLevel (Shallow(marker = "north")) != describeLevel deep]
    ]

    // Column order wins over spelling: "north/7", never "7/north".
    checkAll "a payload binder takes its column, not its spelling" [
        structuralEquals [swappedLevel deep, swappedLevel shallow, swappedLevel Flat, swappedLevel (Deep(marker = "x", rank = 1))] ["north/7", "south", "-", "x/1"], structuralEquals [swappedLevel (Deep(marker = "", rank = 0)), swappedLevel (Shallow(marker = ""))] ["/0", ""], deepRenders swappedLevel "7" 7 "7/7",
        swappedLevel deep != describeLevel deep, all [contains (swappedLevel deep) "/", startsWith (swappedLevel deep) "north", endsWith (swappedLevel deep) "7", length (swappedLevel deep) == 7, !(contains (swappedLevel Flat) "north"), swappedLevel (Deep(marker = "north", rank = 8)) != swappedLevel deep]
    ]

    // Literal clauses match their own value only; everything else falls to the
    // wildcard that follows them.
    checkAll "literal clauses and the wildcard that follows them" [
        structuralEquals [band 0, band 1, band 2, band 3] ["zero", "one", "two", "many"], structuralEquals [band 99, band ((0 - 1) ), route "", route "/", route "/home", route "/away", route "home"] ["many", "many", "root", "root", "home", "other", "other"], structuralEquals [route "/HOME", route (toLowerCase "/HOME"), route " "] ["other", "home", "other"], all [band 0 != band 1, band 3 == band 99, route "" == route "/", route "/home" != route "/away"]
    ]

    // List shapes: [] and [x] and [x, y] each own a clause, and everything
    // longer takes head-tail, whose tail length is one less than the list.
    checkAll "list patterns and Result arms select by shape" [
        structuralEquals [shape (List ()), shape single, shape [1, 2], shape nums, shape [1, 2, 3, 4]] ["empty", "one(42)", "two(1,2)", "many(10+2)", "many(1+3)"], structuralEquals [shape (listAppend nums 40), shape (listReverse nums), shape (listPrepend nums 5), readAt nums 3, readAt nums 99] ["many(10+3)", "many(30+2)", "many(5+3)", "miss 3", "miss 99"], structuralEquals [readAt nums ((0 - 1) ), readAt single 0, readAt [7] 1, readAt [7] 0] ["miss -1", "at 0 = 42", "miss 1", "at 0 = 7"], structuralEquals (mapList [0, 1, 2] (\k => readAt nums k)) ["at 0 = 10", "at 1 = 20", "at 2 = 30"],
        all [shape single != shape nums, readAt nums 0 != readAt nums 1, contains (readAt nums 1) "20", !(contains (readAt nums 3) "=")]
    ]

(** An indented body is a block whose last line is its value [FLAVOR-ML-BLOCK];
    blank and comment-only lines keep layout [FLAVOR-ML-LAYOUT], comments nest [FLAVOR-ML-COMMENTS]. 3n + 1. *)
staged n =
    doubled = n + n 

    // A comment-only line inside the block.
    (* A nested (* block *) comment inside the block. *)
    tripled = doubled + n 
    tripled + 1 

(** Parentheses suppress layout tokens until their matching delimiter
    [FLAVOR-ML-LAYOUT], so one expression may span several lines inside them. *)
spread a b = (a
    + b
    )

(** Layout and interpolation are where ML's surface differs from Default with no
    AST difference to show for it [FLAVOR-BOUNDARY]: an indented block evaluates
    to its last line, a parenthesised expression survives a line split, and an
    interpolation hole holds a juxtaposed call or checked operation — `${3 + 5}`
    is `8` ([ARITH-CHECKED]). *)
layoutAndInterpolationCase () =
    xs = [3, 5, 8, 13]
    prices = ["apple" => 2, "banana" => 3]
    first = xs[0] ?: 0
    last = xs[3] ?: 0
    past = xs[4] ?: ((0 - 1) )
    apple = prices["apple"] ?: 0
    missing = prices["pear"] ?: ((0 - 1) )
    flavorName = "ml"
    ratio = 1.5
    text = "ab, ab, 12"

    // staged n = 3n + 1; spread a b = a + b across three source lines.
    checkAll "layout blocks and split parentheses are one expression" [
        structuralEquals [staged 0, staged 1, staged 2, staged 3, staged 4, staged 5, staged 10, spread 2 3] [1, 4, 7, 10, 13, 16, 31, 5], structuralEquals [spread 0 0, spread 20 22, spread 5 ((0 - 5) ), spread 1 2] [0, 42, 0, 3], all [staged 5 != staged 4, spread 2 3 == spread 3 2, staged 5 == spread 10 6, staged 0 == spread 1 0]
    ]

    // An interpolation hole renders the value it holds: an unwrapped int as a
    // bare number, a checked operation as its Result, a bool as true/false.
    checkAll "interpolation renders juxtaposed calls and checked arithmetic" [
        structuralEquals ["${add 3 5}", "${addThree 1 2 5}", "${staged 5}", "${toString (staged 5)}", "${3 + 5}"] ["8", "8", "16", "16", "8"], structuralEquals ["total=${add 3 5} raw=${3 + 5}", "${toUpperCase flavorName}", "${length flavorName}", "${first}/${last}", "${apple}"] ["total=8 raw=8", "ML", "2", "3/13", "2"], structuralEquals ["${missing}", "${past}", "${3 < 5}", "${3 > 5}", "${ratio}", "a${flavorName}b", "${flavorName}${flavorName}"] ["-1", "-1", "true", "false", "1.5", "amlb", "mlml"], "${spread 20 22}" == "42"
    ]

    // Indexing and map lookup at the first slot, the last slot, one past the
    // end, and a key that was never set [FLAVOR-ML-INDEX], [FLAVOR-ML-MAP].
    checkAll "list and map literals index and fall back as declared" [
        structuralEquals [first, last, (xs[1] ?: 0), (xs[2] ?: 0), (listGet xs 4 ?: 0), listLength xs, apple, (prices["banana"] ?: 0)] [3, 13, 5, 8, 0, 4, 2, 3], structuralEquals [mapLength prices, mapLength (mapRemove prices "apple"), mapLength prices] [2, 1, 2], all [past == ((0 - 1) ), (listGet xs 0 ?: 0) == first, (listGet xs 3 ?: 0) == last, missing == ((0 - 1) ), (mapGet prices "apple" ?: 0) == apple],
        all [listContains xs 8, !(listContains xs 4), !(isEmpty xs), mapContains prices "apple", !(mapContains prices "pear")]
    ]

    // Text boundaries: empty needle, prefix, suffix, an absent reversal, a
    // repeated substring, digits inside a string, and case folding.
    checkAll "string builtins over the boundary shapes" [
        structuralEquals [length text, length ""] [10, 0], all [!(isEmpty text), isEmpty "", containsNone text ["ba", "AB"], !(startsWith text "b"), !(endsWith text "1")], all [toUpperCase text == "AB, AB, 12", toLowerCase "AB, AB, 12" == text, toUpperCase (toLowerCase text) == toUpperCase text, toLowerCase text == text], all [length (toUpperCase text) == length text, contains (toUpperCase text) "AB"]
    ]

// Registration order fixes the TAP numbering, so these follow the four cases above.
exactTests [
    { name = "Verdict folding obeys the andThen monoid laws", work = verdictAlgebraCase },
    { name = "curried arities two through six apply in every grouping", work = curriedArityLadderCase },
    { name = "curried and flat lambda heads split as specified", work = lambdaCurryingCase },
    { name = "ML record layout, inline heads and updates agree", work = recordLayoutAndUpdateCase },
    { name = "ML match layout, clauses and list patterns select correctly", work = matchLayoutAndClausesCase },
    { name = "ML layout blocks and interpolation render juxtaposed calls", work = layoutAndInterpolationCase }
]
