// [WORKBENCH-MATH] cases: exact trees and agreement with the formula writer.
namespace workbenchtests

import workbench::Formulas
import workbenchtests::CorpusCases
import workbench::ProofTerms
import proof::Terms
import proof::Naturals
import proof::ProofNotation
import proof::Checked
import proof::Environment
import proof::Fixtures

(** The typesetting cases of [WORKBENCH-VERIFICATION]. *)
module TypesetCases
    // A textual projection used only by the corpus property, never by the tree assertions.
    flat tree = match tree
        ui::Sym text => text
        ui::Num text => text
        ui::Seq items => join (mapList (items, \item => flat item), "")
        ui::Sup base script => flat base + "^{" + flat script + "}"
        ui::Sub base script => flat base + "_{" + flat script + "}"
        ui::Frac top bottom => "(" + flat top + ")/(" + flat bottom + ")"
        ui::Root body => "√(" + flat body + ")"
        ui::Binder symbol names body => symbol + " " + join (mapList (names, \name => flat name), " ") + ", " + flat body
        ui::Op symbol left right => flat left + " " + symbol + " " + flat right
        ui::Paren body => "(" + flat body + ")"
        ui::Big symbol lower upper body => symbol + flat lower + flat upper + flat body

    sameItemsAt (left, right, at) = match at >= length left
        true => true
        false => same (listGet left at ?: ui::Sym "", listGet right at ?: ui::Sym "") && sameItemsAt (left, right, satAdd at 1)

    sameItems (left, right) = length left == length right && sameItemsAt (left, right, 0)

    sameSym (text, other) = match other
        ui::Sym found => text == found
        _ => false

    sameSeq (items, other) = match other
        ui::Seq found => sameItems (items, found)
        _ => false

    sameOp (symbol, left, right, other) = match other
        ui::Op foundSymbol foundLeft foundRight => symbol == foundSymbol && same (left, foundLeft) && same (right, foundRight)
        _ => false

    sameParen (body, other) = match other
        ui::Paren found => same (body, found)
        _ => false

    sameBinder (symbol, names, body, other) = match other
        ui::Binder foundSymbol foundNames foundBody => symbol == foundSymbol && sameItems (names, foundNames) && same (body, foundBody)
        _ => false

    // Structural equality for every constructor produced by `Formulas::typeset`.
    same (first, second) = match first
        ui::Sym text => sameSym (text, second)
        ui::Seq items => sameSeq (items, second)
        ui::Op symbol left right => sameOp (symbol, left, right, second)
        ui::Paren body => sameParen (body, second)
        ui::Binder symbol names body => sameBinder (symbol, names, body, second)
        _ => false

    differing formula = flat (Formulas::typeset formula) != Formulas::show formula

    summary failures = "${length failures}: ${listGet failures 0 ?: ""}"

    (** [WORKBENCH-MATH]: flattening every generated typesetting tree reproduces its minimal Unicode form. *)
    export corpus () = expect (summary (mapList (filterList (CorpusCases::corpus (), \formula => differing formula), \formula => Formulas::show formula)), "0: ")

    (** [WORKBENCH-MATH]: the and_swap claim has the exact binder and operator tree. *)
    export andSwap () =
        formula = workbench::Forall ["p", "q"] (workbench::Imp (workbench::And (workbench::Var "p") (workbench::Var "q")) (workbench::And (workbench::Var "q") (workbench::Var "p")))
        expected = ui::Binder "∀" [ui::Sym "p", ui::Sym "q"] (ui::Op "→" (ui::Op "∧" (ui::Sym "p") (ui::Sym "q")) (ui::Op "∧" (ui::Sym "q") (ui::Sym "p")))
        expect (same (Formulas::typeset formula, expected), true)

    (** [WORKBENCH-MATH]: a negated conjunction keeps its required parentheses. *)
    export negatedConjunction () =
        formula = workbench::Not (workbench::And (workbench::Var "p") (workbench::Var "q"))
        expected = ui::Seq [ui::Sym "¬", ui::Paren (ui::Op "∧" (ui::Sym "p") (ui::Sym "q"))]
        expect (same (Formulas::typeset formula, expected), true)

    (** [WORKBENCH-MATH]: a conditional antecedent alone is parenthesized in a nested implication. *)
    export conditionalAntecedent () =
        formula = workbench::Imp (workbench::Imp (workbench::Var "p") (workbench::Var "q")) (workbench::Var "r")
        expected = ui::Op "→" (ui::Paren (ui::Op "→" (ui::Sym "p") (ui::Sym "q"))) (ui::Sym "r")
        expect (same (Formulas::typeset formula, expected), true)

(** Imported terms keep their binding, grouping and exact overloaded
    arguments. These are presentation tests, not certificate acceptance. *)
module ProofTermCases
    check (term, expected) = expect (structuralEquals (ProofTerms::typeset (term, ["Eq", "HAdd.hAdd"]), expected), true)

    nat () = proof::Const "Nat" []

    addHead () = proof::Const "HAdd.hAdd" [proof::Zero, proof::Zero, proof::Zero]

    dictionary () = proof::App (proof::App (proof::Const "instHAdd" [proof::Zero]) (nat ())) (proof::Const "instAddNat" [])

    add (left, right) = Terms::apps (addHead (), [nat (), nat (), nat (), dictionary (), left, right])

    eq (left, right) = Terms::apps (proof::Const "Eq" [proof::Succ proof::Zero], [nat (), left, right])

    binder (name, body) = ui::Binder "∀" [ui::Paren (ui::Op ":" (ui::Sym name) (ui::Sym "Nat"))] body

    numeral value =
        literal = proof::NatLit (proof::Natural(naturalLimbs = [value]))
        Terms::apps (proof::Const "OfNat.ofNat" [proof::Zero], [nat (), literal, proof::App (proof::Const "instOfNatNat" []) literal])

    multiply (left, right) =
        multiplicationDictionary = Terms::apps (proof::Const "instHMul" [proof::Zero], [nat (), proof::Const "instMulNat" []])
        Terms::apps (proof::Const "HMul.hMul" [proof::Zero, proof::Zero, proof::Zero], [nat (), nat (), nat (), multiplicationDictionary, left, right])

    // Exact statement tree 3502 in the pinned word-seed.ndjson export.
    // Permissions here exercise presentation only, not checked declaration
    // identity or the actual import/axiom boundary.
    export runWork () =
        name = "OAI.LowSpaceSubsetSum.WordSeedPowerExecution.run"
        application = proof::App (proof::Const name []) (proof::BVar 0)
        projected = Terms::apps (proof::Const "Prod.snd" [proof::Zero, proof::Zero], [nat (), nat (), application])
        statement = proof::Pi "width" (nat ()) (eq (projected, add (multiply (numeral 3, proof::BVar 0), numeral 1)))
        left = ui::Sub (ui::Paren (ui::Seq [ui::Sym name, ui::Paren (ui::Sym "width")])) (ui::Num "2")
        right = ui::Op "+" (ui::Op "×" (ui::Num "3") (ui::Sym "width")) (ui::Num "1")
        expect (structuralEquals (ProofTerms::typeset (statement, ["Eq", "HAdd.hAdd", "HMul.hMul", "OfNat.ofNat", "Prod.snd"]), binder ("width", ui::Op "=" left right)), true)

    extendedCheck (term, expected) = expect (structuralEquals (ProofTerms::typeset (term, ["Eq", "HAdd.hAdd", "HMul.hMul", "OfNat.ofNat", "Prod.snd"]), expected), true)

    extendedRefused term = extendedCheck (term, ui::Sym (Terms::show (term, [])))

    export runWorkGuards () =
        a = proof::Const "a" []
        b = proof::Const "b" []
        c = proof::Const "c" []
        extendedCheck (multiply (a, add (b, c)), ui::Op "×" (ui::Sym "a") (ui::Paren (ui::Op "+" (ui::Sym "b") (ui::Sym "c"))))
        extendedCheck (multiply (a, multiply (b, c)), ui::Op "×" (ui::Sym "a") (ui::Paren (ui::Op "×" (ui::Sym "b") (ui::Sym "c"))))
        extendedCheck (multiply (multiply (a, b), c), ui::Op "×" (ui::Op "×" (ui::Sym "a") (ui::Sym "b")) (ui::Sym "c"))
        extendedCheck (multiply (a, numeral 3), ui::Op "×" (ui::Sym "a") (ui::Num "3"))
        extendedFailures (a, b)

    extendedFailures (a, b) =
        product = Terms::spine (multiply (a, b))
        literal = Terms::spine (numeral 3)
        wrong = proof::Const "different" []
        badProduct = Terms::apps (product.spineHead, [nat (), nat (), nat (), dictionary (), a, b])
        badNumeral = Terms::apps (literal.spineHead, [nat (), proof::NatLit (proof::Natural(naturalLimbs = [3])), proof::App (proof::Const "instOfNatNat" []) (proof::NatLit (proof::Natural(naturalLimbs = [4])))])
        terms = [badProduct, badNumeral, Terms::apps (product.spineHead, Terms::prefix (product.spineArgs, 5)), Terms::apps (product.spineHead, listAppend product.spineArgs a), Terms::apps (proof::Const "HMul.hMul" [proof::Zero, proof::Zero, proof::Succ proof::Zero], product.spineArgs), Terms::apps (proof::Const "OfNat.ofNat" [proof::Succ proof::Zero], literal.spineArgs), Terms::apps (literal.spineHead, Terms::prefix (literal.spineArgs, 2)), Terms::apps (literal.spineHead, listAppend literal.spineArgs a), Terms::apps (proof::Const "Prod.snd" [proof::Zero, proof::Zero], [wrong, nat (), a]), Terms::apps (proof::Const "Prod.snd" [proof::Zero, proof::Succ proof::Zero], [nat (), nat (), a])]
        forEachList (terms, \term => extendedRefused term)
        forEachList ([multiply (a, b), numeral 3, Terms::apps (proof::Const "Prod.snd" [proof::Zero, proof::Zero], [nat (), nat (), a])], \term => expect (structuralEquals (ProofTerms::typeset (term, []), ui::Sym (Terms::show (term, []))), true))

    export run () =
        operators ()
        permissions ()
        notationIdentities ()
        binders ()
        constantCollisions ()
        refusals ()
        fallbacks ()

    operators () =
        a = proof::Const "a" []
        b = proof::Const "b" []
        c = proof::Const "c" []
        check (eq (add (a, b), add (b, a)), ui::Op "=" (ui::Op "+" (ui::Sym "a") (ui::Sym "b")) (ui::Op "+" (ui::Sym "b") (ui::Sym "a")))
        check (add (a, add (b, c)), ui::Op "+" (ui::Sym "a") (ui::Paren (ui::Op "+" (ui::Sym "b") (ui::Sym "c"))))
        check (add (add (a, b), c), ui::Op "+" (ui::Op "+" (ui::Sym "a") (ui::Sym "b")) (ui::Sym "c"))
        check (eq (eq (a, b), c), ui::Op "=" (ui::Paren (ui::Op "=" (ui::Sym "a") (ui::Sym "b"))) (ui::Sym "c"))

    binders () =
        check (proof::Pi "x" (nat ()) (proof::Pi "x" (nat ()) (eq (proof::BVar 1, proof::BVar 0))), binder ("x", binder ("x_1", ui::Op "=" (ui::Sym "x") (ui::Sym "x_1"))))
        check (proof::Pi "x" (nat ()) (proof::Pi "unused" (nat ()) (eq (proof::BVar 1, proof::BVar 1))), binder ("x", ui::Op "→" (ui::Sym "Nat") (ui::Op "=" (ui::Sym "x") (ui::Sym "x"))))
        check (proof::Pi "_" (nat ()) (proof::BVar 0), binder ("x", ui::Sym "x"))
        check (proof::Pi "x" (nat ()) (proof::Pi "x" (nat ()) (proof::Pi "x" (nat ()) (proof::BVar 0))), ui::Op "→" (ui::Sym "Nat") (ui::Op "→" (ui::Sym "Nat") (ui::Paren (binder ("x_2", ui::Sym "x_2")))))
        check (proof::Pi "" (nat ()) (proof::BVar 0), binder ("x", ui::Sym "x"))

    refused term = check (term, ui::Sym (Terms::show (term, [])))

    constantCollisions () =
        check (proof::Pi "Prop" (proof::Sort proof::Zero) (proof::Pi "h" (proof::BVar 0) (proof::BVar 1)), ui::Binder "∀" [ui::Paren (ui::Op ":" (ui::Sym "Prop_1") (ui::Sym "Prop"))] (ui::Op "→" (ui::Sym "Prop_1") (ui::Sym "Prop_1")))
        check (proof::Lam "Type" (proof::Sort (proof::Succ proof::Zero)) (proof::Sort (proof::Succ proof::Zero)), ui::Sym "(fun (Type_1 : Type) => Type)")
        check (proof::Pi "Nat" (nat ()) (proof::Pi "m" (nat ()) (eq (proof::BVar 1, proof::BVar 0))), binder ("Nat_1", binder ("m", ui::Op "=" (ui::Sym "Nat_1") (ui::Sym "m"))))
        check (proof::Lam "f" (nat ()) (proof::App (proof::Const "f" []) (proof::BVar 0)), ui::Sym "(fun (f_1 : Nat) => (f f_1))")
        check (proof::Pi "x" (nat ()) (proof::App (proof::Const "f" []) (proof::Lam "Nat" (nat ()) (proof::App (nat ()) (proof::BVar 1)))), binder ("x", ui::Sym "(f (fun (Nat_1 : Nat) => (Nat x)))"))

    refusals () =
        value = proof::Const "a" []
        args = [nat (), nat (), nat (), dictionary (), value, value]
        wrong = proof::Const "different" []
        rejected = [addHead (), Terms::apps (addHead (), [nat (), nat (), nat (), wrong, value, value]), Terms::apps (addHead (), [wrong, nat (), nat (), dictionary (), value, value]), Terms::apps (addHead (), [nat (), wrong, nat (), dictionary (), value, value]), Terms::apps (addHead (), [nat (), nat (), wrong, dictionary (), value, value]), Terms::apps (addHead (), [nat (), nat (), nat (), dictionary (), value]), Terms::apps (addHead (), listAppend args value), Terms::apps (proof::Const "HAdd.hAdd" [proof::Succ proof::Zero, proof::Zero, proof::Zero], args), proof::Const "Eq" [proof::Succ proof::Zero], Terms::apps (proof::Const "Eq" [proof::Succ proof::Zero], [nat (), value]), Terms::apps (proof::Const "Eq" [proof::Succ proof::Zero], [nat (), value, value, value]), Terms::apps (proof::Const "Eq" [proof::Zero], [nat (), value, value])]
        _checked = mapList (rejected, \term => refused term)

    fallbacks () =
        check (proof::Sort proof::Zero, ui::Sym "Prop")
        check (proof::Sort (proof::Succ proof::Zero), ui::Sym "Type")
        check (proof::Lam "x" (nat ()) (proof::Lam "x" (nat ()) (proof::BVar 1)), ui::Sym "(fun (x : Nat) => (fun (x_1 : Nat) => x))")
        check (proof::Let "x" (nat ()) (proof::Const "v" []) (proof::Lam "x" (nat ()) (proof::BVar 1)), ui::Sym "(let x : Nat := v; (fun (x_1 : Nat) => x))")
        check (proof::Proj "Pair" 0 (proof::Lam "x" (nat ()) (proof::BVar 0)), ui::Sym "(Pair.0 (fun (x : Nat) => x))")
        check (proof::App (proof::Const "f" [proof::Param "u"]) (proof::BVar 7), ui::Sym "(f.{u} #7)")
        check (proof::Pi "x" (nat ()) (proof::App (proof::Const "f" []) (proof::Pi "x" (nat ()) (proof::BVar 1))), binder ("x", ui::Sym "(f (Nat → x))"))
        match Naturals::ofInt 42
            Success value => check (proof::NatLit value, ui::Num "42")
            Error message => expect (message, "a valid natural")

    permissions () =
        term = eq (nat (), nat ())
        expect (structuralEquals (ProofTerms::typeset (term, []), ui::Sym (Terms::show (term, []))), true)
        expect (structuralEquals (ProofTerms::typeset (term, ["HAdd.hAdd"]), ui::Sym (Terms::show (term, []))), true)
        termAdd = add (nat (), nat ())
        expect (structuralEquals (ProofTerms::typeset (termAdd, ["Eq"]), ui::Sym (Terms::show (termAdd, []))), true)

    notationIdentities () = match Checked::exported (Environment::empty (), Fixtures::natAddComm ())
        Error message => expect (message, "canonical arithmetic environment")
        Success env =>
            expect (join (ProofNotation::permitted env, ","), "Eq,HAdd.hAdd,OfNat.ofNat")
            guardedNames (env, ["Eq", "Eq.refl"], "Eq")
            guardedNames (env, ["Add", "Add.add", "Add.mk", "HAdd", "HAdd.hAdd", "HAdd.mk", "Nat", "Nat.add", "Nat.add.match_1", "Nat.below", "Nat.brecOn", "Nat.brecOn.go", "Nat.casesOn", "Nat.rec", "Nat.succ", "Nat.zero", "PProd", "PProd.mk", "PUnit", "PUnit.unit", "instAddNat", "instHAdd", "outParam"], "HAdd.hAdd")
            expect (join (ProofNotation::permitted (env(decls = mapRemove (env.decls, "Eq.rec"))), ","), "Eq,HAdd.hAdd,OfNat.ofNat")
            alphaEquality ()

    guardedNames (env, names, head) = forEachList (names, \name =>
        expect (listContains (ProofNotation::permitted (env(decls = mapRemove (env.decls, name))), head), false)
        match Environment::find (env, name)
            Error message => expect (message, "required canonical declaration")
            Success decl => expect (listContains (ProofNotation::permitted (env(decls = mapSet (env.decls, name, decl(body = proof::Axiom)))), head), false))

    alphaEquality () = match Checked::exported (Environment::empty (), Fixtures::andSwap ())
        Error message => expect (message, "canonical equality with universe u")
        Success env => expect (join (ProofNotation::permitted env, ","), "Eq")

    export runWorkIdentities () = match Checked::exported (Environment::empty (), runWorkBasis ())
        Error message => expect (message, "checked pinned word-seed notation declarations")
        Success env =>
            expect (join (ProofNotation::permitted env, ","), "Eq,HAdd.hAdd,HMul.hMul,OfNat.ofNat,Prod.snd")
            guardedNames (env, ["HMul", "HMul.hMul", "HMul.mk", "Mul", "Mul.mk", "Mul.mul", "Nat", "Nat.add", "Nat.add.match_1", "Nat.below", "Nat.brecOn", "Nat.brecOn.go", "Nat.casesOn", "Nat.mul", "Nat.mul.match_1", "Nat.rec", "Nat.succ", "Nat.zero", "OfNat", "OfNat.mk", "OfNat.ofNat", "PProd", "PProd.mk", "PUnit", "PUnit.unit", "instHMul", "instMulNat", "instOfNatNat", "outParam"], "HMul.hMul")
            guardedNames (env, ["Nat", "Nat.succ", "Nat.zero", "OfNat", "OfNat.mk", "OfNat.ofNat", "instOfNatNat"], "OfNat.ofNat")
            guardedNames (env, ["Prod", "Prod.mk", "Prod.snd"], "Prod.snd")
            expect (join (ProofNotation::permitted (env(decls = mapRemove (env.decls, "instMulNat"))), ","), "Eq,HAdd.hAdd,OfNat.ofNat,Prod.snd")
            changedProjection env

    changedProjection env = match Environment::find (env, "Prod.snd")
        Error message => expect (message, "canonical second projection")
        Success decl => expect (listContains (ProofNotation::permitted (env(decls = mapSet (env.decls, "Prod.snd", decl(body = proof::Definition (proof::BVar 0))))), "Prod.snd"), false)

    // Unchanged declaration/table rows extracted from pinned word-seed.ndjson
    // (SHA-256 14b3950c6e2ea1e73ed3fa529baf236346cb397da4bfa5d695c0049511b81a33).
    // Contains 51 checked declarations, no theorem or axiom; this tests notation identity.
