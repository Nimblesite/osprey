namespace workbenchtests

import workbenchtests::Drive
import workbenchtests::AppCases
import workbench::Benches
import workbench::BundledLibraries
import ui::Doc
import ui::Maths
import proof::ImportedProofs
import proof::CachedImports
import proof::Fixtures
import proof::Trust
import workbenchtests::ProofTermCases

(** Current imported source is checked by the shared kernel, including
    refusals and assumptions. Implements [WORKBENCH-VERDICT]. *)
module ImportedCases
    export run () =
        test ("imported id_imp exposes its actual statement and no assumptions", valid)
        test ("corrupting the current imported proof is refused", corrupted)
        test ("a missing selected imported theorem is refused", missing)
        test ("an imported axiom is never presented as a proved theorem", assumption)
        test ("unused export assumptions do not contaminate the selected proof", unused)
        test ("a checked catalogue includes each theorem's own assumptions", catalogue)
        test ("an empty export is not an empty successful proof catalogue", empty)
        test ("oversized proof exports are refused before parsing", oversized)

    checked (source, name) = described (ImportedProofs::check (source, name))

    export valid () =
        expect (checked (Fixtures::idImp (), "id_imp"), "id_imp | (∀ (p : Prop), (p → p)) | none")
        ProofTermCases::run ()

    export corrupted () = expect (startsWith (checked (Fixtures::idImpBad (), "id_imp"), "error: type mismatch:"), true)

    export missing () = expect (checked (Fixtures::idImp (), "missing"), "error: the export declares no `missing`")

    export assumption () =
        expect (checked (withUnused (), "unusedAssumption"), "error: `unusedAssumption` is not a theorem")
        definition = replace (Fixtures::idImp (), "\"thm\":", "\"def\":") ?: ""
        expect (checked (definition, "id_imp"), "error: `id_imp` is not a theorem")

    export unused () = expect (checked (withUnused (), "id_imp"), "id_imp | (∀ (p : Prop), (p → p)) | none")

    export catalogue () =
        sameSyntax ()
        match ImportedProofs::catalogue (withUnused ())
            Success entries =>
                expect (length entries, 1)
                expect (join (mapList (entries, \entry => entry.importedName), ","), "id_imp")
            Error message => expect (message, "a checked theorem catalogue")

    // The theorem `SameSyntax.lean` proves, opened as a user's own export, then with another theorem's proof.
    sameSyntax () = match FixtureFiles::read "../../examples/proof/kernel/exports/same_syntax.ndjson"
        Error problem => expect (problem, "the same_syntax export")
        Success source =>
            expectAxioms (source, "SameSyntax.same_syntax", "Classical.choice,Quot.sound")
            expectAxioms (source, "SameSyntax.lump_eq_of_tree_eq", "Quot.sound")
            expect (startsWith (checked (swappedProof source, "SameSyntax.same_syntax"), "error: type mismatch:"), true)

    expectAxioms (source, name, wanted) = expect (axiomsOf (ImportedProofs::check (source, name)), wanted)

    axiomsOf outcome = match outcome
        Success entry => join (entry.importedAxioms, ",")
        Error message => message

    // Expression 608 is the proof of lump_eq_of_tree_eq; 1221 is the proof of same_syntax.
    swappedProof source = replace (source, "\"type\":814,\"value\":1221", "\"type\":814,\"value\":608") ?: ""

    export empty () = expect (catalogueError (ImportedProofs::catalogue ""), "the export declares no theorems")

    export oversized () = padded ("x", 8388609, "an allocated oversized input", \text =>
        expect (byteLength text, 8388609)
        expect (checked (text, "id_imp"), "error: the proof export exceeds 8 MiB")
        expect (catalogueError (ImportedProofs::catalogue text), "the proof export exceeds 8 MiB"))

    /// `count` copies of `fill` handed to `work`, or the refusal reported when the allocation fails.
    export padded (fill, count, refused, work) = match repeat (fill, count)
        Error message => expect (message, refused)
        Success text => work text

    catalogueError outcome = match outcome
        Success entries => "unexpected success"
        Error message => message

    described outcome = match outcome
        Success entry => "${entry.importedName} | ${entry.importedStatement} | ${assumptions entry.importedAxioms}"
        Error message => "error: ${message}"

    assumptions names = match Trust::described (Success(value = names))
        Success text => text
        Error message => "refused: ${message}"

    export withUnused () = "${Fixtures::idImp ()}{\"in\":16,\"str\":{\"pre\":0,\"str\":\"unusedAssumption\"}}\n{\"axiom\":{\"isUnsafe\":false,\"levelParams\":[],\"name\":16,\"type\":0}}\n"

(** The real shared host flow checks current source, selection, and refusal states. *)
module ImportedFlowCases
    pane envelope = Drive::node (envelope, "library")

    actions envelope = Drive::node (envelope, "library-actions")

    shown envelope = Drive::visibleText (pane envelope)

    current envelope = Doc::field (Drive::stored envelope, "imports")

    (** The library's own notice text, checked as a string table. *)
    told (envelope, messages) = AppCases::present (Drive::visibleText (actions envelope), messages)

    // Assertion tables over the shared host flow: the inspected library text,
    // the current receipt and its refusal reason.
    shows (envelope, parts) = AppCases::present (shown envelope, parts)

    hides (envelope, parts) = AppCases::absent (shown envelope, parts)

    refusedWith (envelope, reason) =
        shows (envelope, [reason])
        hides (envelope, ["Checked theorem"])

    chosenFrom (source, name) = picked (loaded (ask (), source), name)

    picks (after, name, parts) = shows (picked (after, name), parts)

    refusesPick (after, name, reason) = refusedWith (picked (after, name), reason)

    expectKind (envelope, name, kind) = expect (AppCases::namedKind (Drive::node (envelope, "root"), name), kind)

    reads (envelope, field, wanted) = expect (Doc::text (current envelope, field), wanted)

    ask () =
        first = Drive::started ()
        asked (first, first)

    asked (first, _issued) =
        visible = Drive::press (first, "root", "Notation")
        requested = Drive::press (visible, "library-actions", "Open proof library")
        expect (Drive::tickets requested, "proof:opened")
        requested

    loaded (requested, source) = Drive::completedHeld (requested, "proof:opened", "{\"path\":\"proof.ndjson\"}", JsonObject [Doc::str ("proof:import", source)])

    picked (before, name) =
        rows = Drive::findLabel ("Theorem", pane before)
        expect (Doc::has (rows, "event"), true)
        Drive::controlOf (before, "library", Doc::number (rows, "event"), Drive::quoted name)

    expanded before =
        disclosure = Drive::findTitle ("Imported source", pane before)
        Drive::controlOf (before, "library", Doc::number (disclosure, "event"), "true")

    edited (before, source) = Drive::post (before, Drive::labelled (before, before, "library", "Current proof export", Drive::quoted source))

    export ledgerBoundaries () =
        selected = chosenFrom (receiptSource (), "root")
        reads (selected, "selected", "root")
        shows (selected, ["Axioms: \"none\""])

    receiptSource () = (replace (ImportedCases::withUnused (), "unusedAssumption", "none") ?: "") + "{\"ie\":1000,\"const\":{\"name\":16,\"us\":[]}}\n{\"ie\":1001,\"forallE\":{\"name\":0,\"type\":1000,\"body\":1000,\"binderInfo\":\"default\"}}\n{\"ie\":1002,\"lam\":{\"name\":0,\"type\":1000,\"body\":1,\"binderInfo\":\"default\"}}\n{\"in\":17,\"str\":{\"pre\":0,\"str\":\"root\"}}\n{\"thm\":{\"name\":17,\"levelParams\":[],\"type\":1001,\"value\":1002,\"all\":[]}}\n"

    export fileImport () =
        after = loaded (ask (), Fixtures::idImp ())
        reads (after, "source", Fixtures::idImp ())
        reads (after, "selected", "id_imp")
        shows (after, ["Checked theorem", "(∀ (p : Prop), (p → p))", "Axioms: none"])
        expect (Doc::text (selectedMath after, "kind"), "math")
        AppCases::kept (after, "")
        forEachList ([arithmetic, customEquality, customAddition], \probe => probe ())
        bundled ()

    export inspectionLayout () =
        initial = Drive::started ()
        before = asked (AppCases::reopened (AppCases::typed (initial, "Keep this free-form argument.")), initial)
        expectKind (before, "proof-library-inspection", "")
        after = loaded (before, Fixtures::idImp ())
        expectKind (after, "proof-library-inspection", "framed")
        expect (Doc::text (Drive::findNode ("aside", Drive::node (after, "root")), "kind"), "")
        closed = Drive::press (after, "root", "Close proof library")
        expect (Doc::text (Drive::kindedIn ("aside", closed, "root"), "kind"), "aside")
        expect (Doc::write (current closed), Doc::write (current after))
        AppCases::kept (closed, "Keep this free-form argument.")
        WorkspaceCases::withoutDrawing (Drive::stored closed)
        reopened = Drive::press (closed, "root", "Notation")
        expectKind (reopened, "proof-library-inspection", "framed")
        AppCases::agrees (Drive::stored reopened, Drive::stored before, ["text"])

    export exampleAfterImport () =
        initial = Drive::started ()
        ready = Drive::completed (Drive::completed (initial, "lessons:catalogue", "{}"), "lessons:texts", "{}")
        started = Drive::press (Drive::press (loaded (asked (ready, initial), Fixtures::idImp ()), "root", "Examples"), "catalogue", "Open conjunction example")
        expectKind (started, "proof-library-inspection", "")
        expectKind (started, "example-context", "framed")
        AppCases::present (Doc::text (Drive::stored started, "text"), ["Theorem and_swap"])
        reads (started, "selected", "id_imp")

    customEquality () = forEachList ([counterfeitEquality (), counterfeitEqualityRenamed ()], \source => customRelation (source, "claimed_equality", "Eq", "="))

    customAddition () = customRelation (counterfeitAddition (), "claimed_left", "HAdd.hAdd", "+")

    customRelation (source, name, head, symbol) =
        chosen = chosenFrom (source, name)
        shows (chosen, ["Checked theorem"])
        AppCases::present (Doc::text (selectedMath chosen, "spoken"), [head])
        AppCases::absent (Doc::write (Doc::field (selectedMath chosen, "math")), ["\"symbol\":\"${symbol}\""])

    arithmetic () =
        chosen = chosenFrom (Fixtures::natAddComm (), "Nat.add_comm")
        typeset = selectedMath chosen
        expect (Doc::write (Doc::field (typeset, "math")), Doc::write (Maths::encode (arithmeticTree ())))
        AppCases::present (Doc::text (typeset, "spoken"), ["HAdd.hAdd"])
        revealed = expanded chosen
        formal = Drive::findNamed ("proof-library-formal", pane revealed)
        expect (Doc::text (Drive::findNode ("text", formal), "text"), Doc::text (typeset, "spoken"))

    selectedMath envelope = Drive::findNode ("math", Drive::findNamed ("proof-library-result", pane envelope))

    binder (name, body) = ui::Binder "∀" [ui::Paren (ui::Op ":" (ui::Sym name) (ui::Sym "Nat"))] body

    sum (left, right) = ui::Op "+" (ui::Sym left) (ui::Sym right)

    arithmeticTree () = binder ("n", binder ("m", ui::Op "=" (sum ("n", "m")) (sum ("m", "n"))))

    export selection () =
        after = loaded (ask (), ImportedCases::withUnused ())
        picks (after, "id_imp", ["Axioms: none"])
        refusesPick (after, "not_present", "Import refused")
        refusesPick (after, "unusedAssumption", "not a theorem")
        AppCases::kept (picked (after, "unusedAssumption"), "")

    export currentSource () =
        after = expanded (loaded (ask (), Fixtures::idImp ()))
        broken = edited (after, Fixtures::idImpBad ())
        reads (broken, "source", Fixtures::idImpBad ())
        refusedWith (broken, "Import refused")
        repaired = edited (broken, Fixtures::idImp ())
        shows (repaired, ["Checked theorem"])
        reads (repaired, "selected", "id_imp")
        refusedWith (edited (repaired, ""), "Import refused")

    export refusals () =
        pendingFile ()
        requested = ask ()
        cancelled = Drive::completed (requested, "proof:opened", "{\"cancelled\":true}")
        reads (cancelled, "source", "")
        refusedWith (loaded (requested, "not NDJSON"), "Import refused")
        AppCases::flagged (Drive::stored (Drive::completed (requested, "proof:opened", "{}")), ["noticeBad"])
        AppCases::present (Doc::text (Drive::stored (Drive::post (requested, Drive::failed ("proof:opened", "Permission denied"))), "notice"), ["Permission denied"])

    pendingFile () =
        requested = Drive::press (loaded (ask (), Fixtures::idImp ()), "library-actions", "Open proof library")
        shows (requested, ["Reading the selected proof library…"])
        hides (requested, ["Checked theorem"])
        keptChecked (Drive::completed (requested, "proof:opened", "{\"cancelled\":true}"))
        keptChecked (Drive::post (requested, Drive::failed ("proof:opened", "Permission denied")))

    keptChecked envelope =
        shows (envelope, ["Checked theorem"])
        reads (envelope, "source", Fixtures::idImp ())

    withUsed () = "${Fixtures::idImp ()}{\"in\":16,\"str\":{\"pre\":0,\"str\":\"trusted_assumption\"}}\n{\"axiom\":{\"levelParams\":[],\"name\":16,\"type\":4}}\n{\"ie\":7,\"const\":{\"name\":16,\"us\":[]}}\n{\"in\":17,\"str\":{\"pre\":0,\"str\":\"uses_assumption\"}}\n{\"thm\":{\"levelParams\":[],\"name\":17,\"type\":4,\"value\":7}}\n"

    export axioms () =
        after = loaded (ask (), withUsed ())
        picks (after, "id_imp", ["Axioms: none"])
        assumed = picked (after, "uses_assumption")
        shows (assumed, ["Checked theorem", "Axioms: trusted_assumption"])
        reads (assumed, "selected", "uses_assumption")

    export largeSource () = ImportedCases::padded ("\n", 1048577, "allocated fixture padding", \padding =>
        after = loaded (ask (), Fixtures::idImp () + padding)
        AppCases::flagged (current after, ["large"])
        reads (after, "source", "")
        shows (after, ["Checked theorem"])
        lost = picked (after, "id_imp")
        hides (lost, ["Checked theorem"])
        shows (lost, ["Import refused", "The imported source is unavailable. Open the proof export again."]))

    bundled () =
        requested = Drive::press (Drive::started (), "root", "Notation")
        expect (Drive::tickets requested, "proof:catalogue")
        listed = readCompleted (requested, "proof:catalogue", "proof-libraries.json", "{\"libraries\":[{\"title\":\"Identity fixture\",\"path\":\"proof-libraries/identity.ndjson\"}]}")
        AppCases::holds (Drive::findLabel ("Identity fixture", actions listed), ["event"])
        hides (listed, ["Checked theorem"])
        selected = bundledOpen (listed, "proof:bundled:2")
        shows (bundledAt (selected, "proof:bundled:2", Fixtures::idImp ()), ["Checked theorem", "Axioms: none"])
        forEachList ([bundledLarge, bundledRefused, bundledRaces], \probe => probe selected)
        catalogueRefusals requested
        restoredCatalogue ()

    bundledLarge selected = ImportedCases::padded (" ", 1048577, "allocated large valid JSON fixture", \pad =>
        retainedBundled (selected, pad + Fixtures::idImp (), pad + Fixtures::idImpBad ()))

    bundledOpen (envelope, ticket) =
        opened = Drive::press (envelope, "library-actions", "Identity fixture")
        expect (Drive::tickets opened, ticket)
        opened

    retainedBundled (selected, source, corrupted) =
        large = bundledAt (selected, "proof:bundled:2", source)
        held = Drive::hostSlices [large]
        AppCases::flagged (current large, ["large"])
        reads (large, "selected", "id_imp")
        expect (Doc::text (held, "proof:import"), source)
        shows (large, ["Checked theorem"])
        event = Drive::labelled (large, large, "library", "Theorem", Drive::quoted "id_imp")
        shows (Drive::postHeld (large, event, held), ["Checked theorem"])
        damaged = Drive::postHeld (large, event, JsonObject [Doc::str ("proof:import", corrupted)])
        hides (damaged, ["Checked theorem"])
        shows (damaged, ["type mismatch"])

    (** A bundled library read of `source` from the canonical identity fixture path. *)
    bundledAt (envelope, ticket, source) = readCompleted (envelope, ticket, "proof-libraries/identity.ndjson", source)

    readCompleted (before, ticket, path, source) =
        file = JsonObject [Doc::str ("path", path), Doc::str ("error", ""), Doc::str ("text", source)]
        Drive::completedHeld (before, ticket, "{}", JsonObject [Doc::str (ticket, savedDoc ("files", file))])

    savedDoc (key, item) = Doc::write (JsonObject [JsonMember key (JsonArray [item])])
    bundledRefused selected = forEachList ([Fixtures::idImpBad (), ""], \source =>
        refusedWith (bundledAt (selected, "proof:bundled:2", source), "Import refused"))

    bundledRaces selected =
        choice = Drive::findTitle ("Bundled proof libraries", actions selected)
        reopened = Drive::controlOf (selected, "library-actions", Doc::number (choice, "event"), "true")
        stale = undrawnBundle (bundledOpen (reopened, "proof:bundled:3"))
        shows (bundledAt (stale, "proof:bundled:3", Fixtures::idImp ()), ["Checked theorem"])
        manual = loaded (Drive::press (selected, "library-actions", "Open proof library"), Fixtures::idImp ())
        shows (undrawnBundle manual, ["Checked theorem"])
        refusedWith (readCompleted (selected, "proof:bundled:2", "proof-libraries/wrong.ndjson", Fixtures::idImp ()), "Import refused")
        shows (Drive::post (selected, Drive::failed ("proof:bundled:2", "file unavailable")), ["Import refused"])

    undrawnBundle envelope =
        stale = bundledAt (envelope, "proof:bundled:2", Fixtures::idImpBad ())
        AppCases::undrawn stale
        stale

    catalogueRefusals requested =
        sources = ["{", "{}", "{\"libraries\":[]}", "{\"libraries\":[{\"title\":\"Escape\",\"path\":\"proof-libraries/../secret.ndjson\"}]}"]
        forEachList (sources, \source =>
            refused = readCompleted (requested, "proof:catalogue", "proof-libraries.json", source)
            told (refused, ["Bundled libraries could not be loaded"])
            hides (refused, ["Checked theorem"]))
        wrong = readCompleted (requested, "proof:catalogue", "wrong.json", "{}")
        told (wrong, ["different library catalogue"])
        told (Drive::completedHeld (requested, "proof:catalogue", "{}", JsonObject []), ["library read result is invalid"])

    restoredCatalogue () =
        path = "proof-libraries/../../secrets.ndjson"
        catalogue = savedDoc ("libraries", JsonObject [Doc::str ("title", "Forged restored entry"), Doc::str ("path", path)])
        saved = JsonObject [JsonMember "imports" (JsonObject [Doc::str ("catalogue", catalogue)])]
        asked = BundledLibraries::open (Benches::restore saved, path)
        expect (length asked.requests, 0)
        expect (isEmpty asked.stepStore.imports.exportProblem, false)

    // A custom Eq with a constructor for every pair; checked but not standard equality.
    // Implements [WORKBENCH-VERDICT].
    counterfeitEquality () = "{\"meta\":{\"exporter\":{\"name\":\"lean4export\",\"version\":\"3.1.0\"},\"format\":{\"version\":\"3.1.0\"},\"lean\":{\"githash\":\"cdd38ac5115bdeec5f609e9126cce00f51ae88b3\",\"version\":\"4.25.0\"}}}\n{\"in\":1,\"str\":{\"pre\":0,\"str\":\"Eq\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"u\"}}\n{\"il\":1,\"param\":2}\n{\"in\":3,\"str\":{\"pre\":0,\"str\":\"α\"}}\n{\"ie\":0,\"sort\":1}\n{\"in\":4,\"str\":{\"pre\":0,\"str\":\"a\"}}\n{\"bvar\":0,\"ie\":1}\n{\"in\":5,\"str\":{\"pre\":4,\"str\":\"_@\"}}\n{\"in\":6,\"str\":{\"pre\":5,\"str\":\"_internal\"}}\n{\"in\":7,\"str\":{\"pre\":6,\"str\":\"_hyg\"}}\n{\"in\":8,\"num\":{\"i\":0,\"pre\":7}}\n{\"bvar\":1,\"ie\":2}\n{\"ie\":3,\"sort\":0}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":3,\"name\":8,\"type\":2},\"ie\":4}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":4,\"name\":4,\"type\":1},\"ie\":5}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":5,\"name\":3,\"type\":0},\"ie\":6}\n{\"in\":9,\"str\":{\"pre\":1,\"str\":\"fabricated\"}}\n{\"in\":10,\"str\":{\"pre\":0,\"str\":\"b\"}}\n{\"const\":{\"name\":1,\"us\":[1]},\"ie\":7}\n{\"bvar\":2,\"ie\":8}\n{\"app\":{\"arg\":8,\"fn\":7},\"ie\":9}\n{\"app\":{\"arg\":2,\"fn\":9},\"ie\":10}\n{\"app\":{\"arg\":1,\"fn\":10},\"ie\":11}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":11,\"name\":10,\"type\":2},\"ie\":12}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":12,\"name\":4,\"type\":1},\"ie\":13}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":13,\"name\":3,\"type\":0},\"ie\":14}\n{\"in\":11,\"str\":{\"pre\":1,\"str\":\"rec\"}}\n{\"in\":12,\"str\":{\"pre\":0,\"str\":\"u_1\"}}\n{\"il\":2,\"param\":12}\n{\"in\":13,\"str\":{\"pre\":0,\"str\":\"motive\"}}\n{\"in\":14,\"str\":{\"pre\":0,\"str\":\"t\"}}\n{\"ie\":15,\"sort\":2}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":15,\"name\":14,\"type\":11},\"ie\":16}\n{\"in\":15,\"str\":{\"pre\":0,\"str\":\"fabricated\"}}\n{\"const\":{\"name\":9,\"us\":[1]},\"ie\":17}\n{\"bvar\":3,\"ie\":18}\n{\"app\":{\"arg\":18,\"fn\":17},\"ie\":19}\n{\"app\":{\"arg\":8,\"fn\":19},\"ie\":20}\n{\"app\":{\"arg\":2,\"fn\":20},\"ie\":21}\n{\"app\":{\"arg\":21,\"fn\":1},\"ie\":22}\n{\"bvar\":4,\"ie\":23}\n{\"app\":{\"arg\":23,\"fn\":7},\"ie\":24}\n{\"app\":{\"arg\":18,\"fn\":24},\"ie\":25}\n{\"app\":{\"arg\":8,\"fn\":25},\"ie\":26}\n{\"app\":{\"arg\":1,\"fn\":8},\"ie\":27}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":27,\"name\":14,\"type\":26},\"ie\":28}\n{\"forallE\":{\"binderInfo\":\"default\",\"body\":28,\"name\":15,\"type\":22},\"ie\":29}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":29,\"name\":13,\"type\":16},\"ie\":30}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":30,\"name\":8,\"type\":2},\"ie\":31}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":31,\"name\":4,\"type\":1},\"ie\":32}\n{\"forallE\":{\"binderInfo\":\"implicit\",\"body\":32,\"name\":3,\"type\":0},\"ie\":33}\n{\"ie\":34,\"lam\":{\"binderInfo\":\"default\",\"body\":1,\"name\":15,\"type\":22}}\n{\"ie\":35,\"lam\":{\"binderInfo\":\"default\",\"body\":34,\"name\":13,\"type\":16}}\n{\"ie\":36,\"lam\":{\"binderInfo\":\"default\",\"body\":35,\"name\":8,\"type\":2}}\n{\"ie\":37,\"lam\":{\"binderInfo\":\"default\",\"body\":36,\"name\":4,\"type\":1}}\n{\"ie\":38,\"lam\":{\"binderInfo\":\"default\",\"body\":37,\"name\":3,\"type\":0}}\n{\"inductive\":{\"ctors\":[{\"cidx\":0,\"induct\":1,\"isUnsafe\":false,\"levelParams\":[2],\"name\":9,\"numFields\":0,\"numParams\":3,\"type\":14}],\"recs\":[{\"all\":[1],\"isUnsafe\":false,\"k\":true,\"levelParams\":[12,2],\"name\":11,\"numIndices\":0,\"numMinors\":1,\"numMotives\":1,\"numParams\":3,\"rules\":[{\"ctor\":9,\"nfields\":0,\"rhs\":38}],\"type\":33}],\"types\":[{\"all\":[1],\"ctors\":[9],\"isRec\":false,\"isReflexive\":false,\"isUnsafe\":false,\"levelParams\":[2],\"name\":1,\"numIndices\":0,\"numNested\":0,\"numParams\":3,\"type\":6}]}}\n{\"in\":16,\"str\":{\"pre\":0,\"str\":\"claimed_equality\"}}\n{\"in\":17,\"str\":{\"pre\":0,\"str\":\"p\"