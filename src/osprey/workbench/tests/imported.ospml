(** The memo belongs to one callback, never to the saved host state. *)
effect MemoCount
    counted : Unit => Unit

module ImportMemoCases
    export run () =
        mut checks = 0
        handle MemoCount
            counted => checks := satAdd checks 1
        CachedImports::memoized (counted, probes)
        expect (checks, 3)
        CachedImports::memoized (counted, one)
        expect (checks, 4)

    counted source =
        perform MemoCount.counted ()
        ImportedProofs::catalogue source

    one () = accepts (Fixtures::idImp ())

    probes () =
        accepts (Fixtures::idImp ())
        accepts (Fixtures::idImp ())
        accepts (Fixtures::idImp () + "\n")
        refuses (Fixtures::idImpBad ())
        refuses (Fixtures::idImpBad ())

    accepts source = expect (accepted (CachedImports::check (source, "id_imp")), true)

    refuses source = expect (refused (CachedImports::check (source, "id_imp")), true)

    accepted outcome = match outcome
        Success entry => entry.importedName == "id_imp" && isEmpty entry.importedAxioms
        Error _ => false

    refused outcome = match outcome
        Success _ => false
        Error message => startsWith message "type mismatch:"
