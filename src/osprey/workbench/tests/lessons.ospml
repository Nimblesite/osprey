// [LESSONS-VERIFICATION] cases: the lesson reader, the kernel judge and the
// tutor's transitions.
namespace workbenchtests

import workbench::Lessons
import workbench::Judge
import workbench::Tutors
import workbench::Catalogues
import workbench::Tries
import workbench::FormulaKeys
import ui::Doc

(** The lesson reader, judge and tutor cases of [LESSONS-VERIFICATION]. *)
module LessonCases
    challengeAndSwapState = "challenge:and-swap/state-swapped-goal"

    marked mark = match mark
        workbench::Correct said => "right: " + said
        workbench::Incorrect said => "wrong: " + said
        workbench::Unfinished said => "unfinished: " + said

    head mark = substring (marked mark, 0, 10) ?: ""

    stateTask expected = workbench::Stating(statedVariables = ["p", "q"], statedExpected = expected)

    (** [LESSONS-STATE]: the same formula and a formula equal by definition are right; an equivalent but different one, a stray atom and a non-proposition are wrong; an unreadable one is unfinished. *)
    export stated () =
        expect (head (Judge::written (stateTask "p → q", "p → q")), "right: Rig")
        expect (head (Judge::written (stateTask "p → ⊥", "¬p")), "right: Rig")
        expect (head (Judge::written (stateTask "p ∧ q", "q ∧ p")), "wrong: The")
        expect (marked (Judge::written (stateTask "p ∧ q", "p ∧ r")), "wrong: `r` is not one of p, q")
        expect (head (Judge::written (stateTask "p ∧ q", "p and q")), "unfinished")
        expect (head (Judge::written (stateTask "p → q", "if p then q")), "unfinished")
        expect (head (Judge::written (stateTask "p ∧ q", "p ∧")), "unfinished")
        keypadTyping ()
        keypadState ()
        keypadPersistence ()
        keypadEvent ()
        crossLessonFocus ()

    stateChallenge expected =
        workbench::Challenge(challengeId = "two", challengePrompt = "Write it.", challengeHints = [], challengeTask = workbench::StateTask (stateTask expected))

    markKey (tutor, key) = match (Tutors::attempt (tutor, key)).attemptMarking
        workbench::Unmarked => "none"
        workbench::Marked mark => head mark

    inserted (tutor, key, at, text) = Tutors::insert (Tutors::moved (tutor, key, at), key, text)

    (** The stored attempt of one challenge, read through the tutor's own API. *)
    tried (tutor, key) = Tutors::attempt (tutor, key)

    answerOf (tutor, key) = (tried (tutor, key)).attemptAnswer

    caretOf (tutor, key) = (tried (tutor, key)).attemptCursor

    triesOf (tutor, key) = (tried (tutor, key)).attemptCount

    (** The actual editor of one challenge region, as the app drew it. *)
    editorOf (envelope, region) = Drive::findNode ("editor", Drive::node (envelope, region))

    answersAs (tutor, answer) = expect (answerOf (tutor, "l/two"), answer)

    caretAt (tutor, caret) = expect (caretOf (tutor, "l/two"), caret)

    (** The focus epoch the app drew on one challenge's editor. *)
    epochIs (envelope, region, expected) = expect (Doc::number (editorOf (envelope, region), "focusEpoch"), expected)

    (** [LESSONS-STATE] [WORKBENCH-NOTATION]: a formula key inserts at the caret and advances it, preserving the text around it, at the start, in the middle and past the end. *)
    keypadTyping () =
        tutor = Tutors::answer (Tutors::empty (), "l/two", "pq")
        caretAt (tutor, length "pq")
        caretAt (Tutors::answer (tutor, "l/two", "p ∧ q"), length "p ∧ q")
        caretAt (Tutors::answer (tutor, "l/two", ""), 0)
        atStart = inserted (tutor, "l/two", 0, "¬")
        answersAs (atStart, "¬pq")
        caretAt (atStart, length "¬")
        atMiddle = inserted (tutor, "l/two", 1, "∧")
        answersAs (atMiddle, "p∧q")
        caretAt (atMiddle, length "p∧")
        atEnd = inserted (tutor, "l/two", 999, "→")
        answersAs (atEnd, "pq→")
        answersAs (inserted (tutor, "l/two", -5, "¬"), "¬pq")
        expect (Tutors::cursorOf (Tutors::attempt (Tutors::moved (tutor, "l/two", -5), "l/two")), 0)
        expect (Tutors::cursorOf (Tutors::attempt (Tutors::moved (tutor, "l/two", 999), "l/two")), 2)

    (** [LESSONS-STATE]: inserting a key clears a stale mark, never submits, and leaves the other challenge's attempt alone. *)
    keypadState () =
        right = Tutors::submit (Tutors::answer (Tutors::empty (), "l/two", "p → q"), "l/two", stateChallenge "p → q")
        expect (markKey (right, "l/two"), "right: Rig")
        edited = Tutors::insert (Tutors::moved (right, "l/two", length "p → q"), "l/two", "∧")
        expect (markKey (edited, "l/two"), "none")
        expect (length edited.tutorCompleted, 1)
        expect (triesOf (edited, "l/two"), 0)
        other = Tutors::answer (edited, "l/three", "q")
        both = Tutors::insert (other, "l/two", "∨")
        expect (answerOf (both, "l/three"), "q")
        expect (startsWith (answerOf (both, "l/two"), "p → q"), true)

    (** [LESSONS-STATE]: the session carries the caret, answer and focus of each attempt, and no ruling or revealed solution. *)
    keypadPersistence () =
        moved = Tutors::moved (Tutors::answer (Tutors::empty (), "l/two", "pq"), "l/two", 1)
        saved = Tries::attemptJson (tried (moved, "l/two"))
        expect (Doc::number (saved, "cursor"), 1)
        expect (Doc::text (saved, "answer"), "pq")
        expect (Doc::number (saved, "focusEpoch"), 0)
        AppCases::lacks (saved, ["ruling", "revealed"])
        expect (Doc::number (Tries::attemptJson (tried (Tutors::moved (moved, "l/two", 999), "l/two")), "cursor"), 2)

    keypadEncoding () =
        keys = FormulaKeys::buttons (stateTask "p → q", "two")
        expect (join (mapList (keys, buttonLabel), "|"), "p|q|→ implies|¬ not|∧ and|∨ or|↔ both ways|(|)")

    buttonLabel node = match node
        ui::Button label _ _ _ _ => label
        _ => ""

    keypadInsert () =
        lesson = AppCases::opened ()
        region = challengeAndSwapState
        _editor = Drive::findNode ("editor", Drive::node (lesson, region))
        typed = Drive::choose (lesson, region, "Your formula", Drive::quoted "pq")
        moved = Drive::placed (typed, region, 1)
        Drive::press (moved, region, "→ implies")

    (** [LESSONS-STATE]: a real issued key through App::respond inserts at the actual editor caret without submitting. *)
    keypadEvent () =
        keypadEncoding ()
        next = keypadInsert ()
        saved = Drive::stored next
        tutor = Doc::field (saved, "tutor")
        work = listGet (filterList (Doc::fieldItems (tutor, "tries"), \item => Doc::text (item, "key") == "and-swap/state-swapped-goal")) 0 ?: JsonNull
        expect (Doc::text (work, "answer"), "p→q")
        expect (Doc::number (work, "cursor"), length "p→")
        expect (Doc::number (work, "count"), 0)
        expect (isEmpty (Doc::texts (tutor, "completed")), true)
        expect (Doc::text (saved, "focused"), "state-swapped-goal")
        expect (Drive::keys next, challengeAndSwapState)
        epochIs (next, challengeAndSwapState, 1)
        repeatedFocus next

    repeatedFocus previous =
        region = challengeAndSwapState
        next = Drive::press (previous, region, "q")
        epochIs (next, region, 2)
        expect (Doc::text (editorOf (next, region), "value"), "p→qq")

    (** Actual App regions separate equal challenge ids across lessons, including their focus epochs. *)
    crossLessonFocus () =
        region = challengeAndSwapState
        lesson = AppCases::opened ()
        first = foldList (toList (range (0, 8)), lesson, \(current, _) => Drive::press (current, region, "p"))
        epochIs (first, region, 8)
        Drive::after (Drive::sharedPress (first, "All lessons"), \closed =>
            expect (listContains (Drive::redrawn first, region), true)
            expect (AppCases::regionKind (closed, region), "")
            Drive::after (Drive::sharedPress (closed, "Open"), \opened => secondLessonFocus (first, opened, region)))

    secondLessonFocus (first, opened, previousRegion) =
        region = "challenge:what-is-a-proof/state-swapped-goal"
        epochIs (opened, region, 0)
        expect (Doc::text (editorOf (opened, region), "kind"), "editor")
        Drive::after (Drive::press (Drive::shared opened, region, "p"), \next =>
            epochIs (next, region, 1)
            expect (Doc::text (editorOf (next, region), "value"), "p")
            expect (Drive::draws (first, previousRegion, "p"), true)
            Drive::after (Drive::stale (Drive::shared next, first, previousRegion, "p"), \stale => FixtureFiles::ok (expect (Doc::write (Drive::stored stale), Doc::write (Drive::stored next)))))

    challenge () = workbench::Challenge(challengeId = "swap", challengePrompt = "Write the swapped conjunction.", challengeHints = ["one", "two"], challengeTask = workbench::StateTask (stateTask "q ∧ p"))

    wrongTwice () =
        typed = Tutors::answer (Tutors::empty (), "l/swap", "p ∧ q")
        Tutors::submit (Tutors::submit (typed, "l/swap", challenge ()), "l/swap", challenge ())

    (** [LESSONS-FEEDBACK]: each wrong submission counts an attempt and shows the next hint, never more hints than exist. *)
    export attempts () =
        item = Tutors::attempt (Tutors::submit (wrongTwice (), "l/swap", challenge ()), "l/swap")
        expect (item.attemptCount, 3)
        expect (item.attemptHints, 2)

    markOf tutor = markKey (tutor, "l/swap")

    (** [LESSONS-FEEDBACK]: editing the answer after a right submission clears the mark, so the badge describes the text on screen. *)
    export clearing () =
        right = Tutors::submit (Tutors::answer (Tutors::empty (), "l/swap", "q ∧ p"), "l/swap", challenge ())
        expect (markOf right, "right: Rig")
        expect (markOf (Tutors::answer (right, "l/swap", "q")), "none")
        expect (Tutors::ready (Tutors::empty (), "l/swap"), false)
        expect (Tutors::ready (Tutors::answer (Tutors::empty (), "l/swap", "   "), "l/swap"), false)
        attemptMarks right

    savedMark (tutor, key) = Doc::text (Doc::field (Tries::attemptJson (tried (tutor, key)), "mark"), "kind")

    attemptMarks right =
        expect (savedMark (right, "l/swap"), "correct")
        expect (length (Tutors::submit (right, "l/swap", challenge ())).tutorCompleted, 1)
        unfinished = Tutors::submit (Tutors::answer (Tutors::empty (), "l/swap", "q and p"), "l/swap", challenge ())
        expect (markOf unfinished, "unfinished")
        expect (savedMark (unfinished, "l/swap"), "unfinished")
        expect ((Tutors::attempt (unfinished, "l/swap")).attemptCount, 0)
        expect (isEmpty unfinished.tutorCompleted, true)
        wrong = Tutors::submit (Tutors::answer (Tutors::empty (), "l/swap", "p ∧ q"), "l/swap", challenge ())
        expect (savedMark (wrong, "l/swap"), "incorrect")
        expect ((Tutors::attempt (wrong, "l/swap")).attemptCount, 1)

    (** [LESSONS-PROGRESS]: progress saves only the completed keys and restores them; unreadable text is no progress. *)
    export progress () =
        saved = workbench::Tutor(tutorTries = [], tutorCompleted = ["a/one", "b/two"])
        expect (join ((Tutors::restore (Doc::write (Tutors::save saved))).tutorCompleted, ","), "a/one,b/two")
        expect (length (Tutors::restore "not json").tutorCompleted, 0)

    lesson blocks = shaped ("1", "demo", blocks)

    shaped (format, slug, blocks) = "{\"format\":" + format + ",\"slug\":\"" + slug + "\",\"title\":\"Demo\",\"summary\":\"A demo.\",\"stage\":1,\"minutes\":3,\"after\":[],\"blocks\":[" + blocks + "]}"

    // English proof blocks a lesson file may no longer hold ([WORKBENCH-NO-ENGLISH]).
    proveBlock () = "{\"kind\":\"challenge\",\"challenge\":{\"kind\":\"prove\",\"id\":\"one\",\"prompt\":\"Prove it.\",\"statement\":\"Theorem t. For all p, p → p.\",\"given\":[],\"solution\":[\"Assume h : p.\",\"From h.\"],\"hints\":[]}}"

    refusal source = match Lessons::read source
        Success _ => "read"
        Error problem => problem

    // Refusal tables: the exact rejected source and the rule it breaks.
    rejects (source, message) = expect (refusal (lesson source), message)

    rejectsEdit (source, from, to, message) = expect (refusal (replace source from to ?: ""), message)

    rejectsBlockEdit (block, from, to, message) = expect (refusal (lesson (replace block from to ?: "")), message)

    catalogueEdit (source, from, to, message) = expect (catalogueResult (replace source from to ?: ""), message)

    kinds lesson = join (mapList (lesson.lessonBlocks, \block => kindOf block), ",")

    kindOf block = match block
        workbench::Prose _ => "prose"
        workbench::Display _ => "formula"
        workbench::Mathematics _ _ => "math"
        workbench::Picture _ => "image"
        workbench::Clip _ => "video"
        workbench::Exercise _ => "challenge"

    everyKind () = lesson ("{\"kind\":\"prose\",\"text\":\"Hello.\"},{\"kind\":\"formula\",\"formula\":\"p ∧ q\"},{\"kind\":\"math\",\"math\":{\"kind\":\"sym\",\"text\":\"u\"},\"spoken\":\"u\"},{\"kind\":\"image\",\"source\":\"media/demo/a.jpg\",\"alt\":\"A.\",\"width\":4,\"height\":3},{\"kind\":\"video\",\"source\":\"media/demo/f.mp4\",\"poster\":\"media/demo/p.jpg\",\"captions\":\"media/demo/f.en.vtt\",\"alt\":\"F.\",\"seconds\":9}," + stateBlock () + "")

    stateBlock () = "{\"kind\":\"challenge\",\"challenge\":{\"kind\":\"state\",\"id\":\"two\",\"prompt\":\"Write it.\",\"variables\":[\"p\"],\"expected\":\"p → p\",\"hints\":[]}}"

    // English proof blocks a lesson file may no longer hold ([WORKBENCH-NO-ENGLISH]).
    judgeBlock () = "{\"kind\":\"challenge\",\"challenge\":{\"kind\":\"judge\",\"id\":\"three\",\"prompt\":\"Does it check?\",\"statement\":\"Theorem t. For all p, p → p.\",\"steps\":[\"Assume h : p.\",\"From h.\"],\"hints\":[]}}"

    (** [LESSONS-FORMAT]: every block kind and the state challenge read, in order. *)
    export everyBlock () = match Lessons::read (everyKind ())
        Error problem => expect (problem, "read")
        Success found => expect (kinds found, "prose,formula,math,image,video,challenge")

    (** [LESSONS-FORMAT] [LESSONS-FILES]: each broken form is refused with its JSON path and the rule it breaks. *)
    export refusals () =
        expect (refusal "{", "the lesson is not JSON")
        expect (refusal (shaped ("2", "demo", stateBlock ())), "this lesson needs a newer workbench (format must be 1)")
        expect (refusal (shaped ("1", "Demo Slug", stateBlock ())), "slug must be lowercase letters, digits and hyphens")
        rejects ("{\"kind\":\"poem\"}," + stateBlock (), "blocks[0].kind `poem` is not a block kind")
        rejects ("{\"kind\":\"formula\",\"formula\":\"p ∧\"}," + stateBlock (), "blocks[0].formula does not read: expected a proposition after `∧` at column 4")
        rejects ("{\"kind\":\"image\",\"source\":\"media/demo/../../x.jpg\",\"alt\":\"A.\",\"width\":4,\"height\":3}," + stateBlock (), "blocks[0].source must be a path under media/demo/ with no `..`")
        rejects ("{\"kind\":\"image\",\"source\":\"/etc/x.jpg\",\"alt\":\"A.\",\"width\":4,\"height\":3}," + stateBlock (), "blocks[0].source must be a path under media/demo/ with no `..`")
        rejects ("{\"kind\":\"prose\",\"text\":\"Only words.\"}", "a lesson needs at least one challenge")
        rejects (stateBlock () + "," + stateBlock (), "the challenge id `two` is used twice")
        headerRefusals ()
        blockRefusals ()
        taskRefusals ()
        catalogueRefusals ()

    headerRefusals () =
        source = lesson (stateBlock ())
        rejectsEdit (source, "\"title\":\"Demo\"", "\"title\":\"\"", "lesson.title must be non-empty text")
        rejectsEdit (source, "\"summary\":\"A demo.\"", "\"summary\":\"\"", "lesson.summary must be non-empty text")
        rejectsEdit (source, "\"stage\":1", "\"stage\":0", "stage must be 1, 2 or 3")
        rejectsEdit (source, "\"minutes\":3", "\"minutes\":0", "lesson.minutes must be a positive whole number")
        rejectsEdit (source, "\"after\":[]", "\"after\":[\"Bad Slug\"]", "after must list lesson slugs")

    blockRefusals () =
        rejects ("", "blocks must not be empty")
        rejects ("{\"kind\":\"prose\",\"text\":\"\"}," + stateBlock (), "blocks[0].text must be non-empty text")
        expect (startsWith (refusal (lesson ("{\"kind\":\"math\",\"math\":{\"kind\":\"unknown\"},\"spoken\":\"u\"}," + stateBlock ())), "blocks[0].math: "), true)
        rejects ("{\"kind\":\"math\",\"math\":{\"kind\":\"sym\",\"text\":\"u\"}}," + stateBlock (), "blocks[0].spoken must be non-empty text")
        rejectsEdit (everyKind (), "\"seconds\":9", "\"seconds\":0", "blocks[4].seconds must be a positive whole number")
        rejectsEdit (everyKind (), "\"width\":4", "\"width\":0", "blocks[3].width must be a positive whole number")

    taskRefusals () =
        rejectsBlockEdit (stateBlock (), "\"kind\":\"state\"", "\"kind\":\"unknown\"", "blocks[0].challenge.kind `unknown` is not a challenge kind")
        rejectsBlockEdit (stateBlock (), "\"id\":\"two\"", "\"id\":\"Bad id\"", "blocks[0].challenge.id must be lowercase letters, digits and hyphens")
        rejectsBlockEdit (stateBlock (), "\"variables\":[\"p\"]", "\"variables\":[]", "blocks[0].challenge.variables must name at least one proposition")
        rejectsBlockEdit (stateBlock (), "\"expected\":\"p → p\"", "\"expected\":\"\"", "blocks[0].challenge.expected must be non-empty text")
        rejects (proveBlock (), "blocks[0].challenge.kind `prove` is not a challenge kind")
        rejects (judgeBlock (), "blocks[0].challenge.kind `judge` is not a challenge kind")

    catalogueResult source = match Catalogues::read source
        Error problem => problem
        Success found => "read: " + join (found.catalogueSlugs, ",")

    catalogueRefusals () =
        source = "{\"format\":1,\"stages\":[{\"stage\":1,\"name\":\"Start\"}],\"lessons\":[\"demo\"]}"
        expect (catalogueResult source, "read: demo")
        expect (catalogueResult "{", "the catalogue is not JSON")
        catalogueEdit (source, "\"format\":1", "\"format\":2", "this catalogue needs a newer workbench (format must be 1)")
        catalogueEdit (source, "[\"demo\"]", "[\"demo\",\"demo\"]", "lessons must be distinct lesson slugs, at least one")
        catalogueEdit (source, "\"name\":\"Start\"", "\"name\":\"\"", "stages must each have a number and a name")
