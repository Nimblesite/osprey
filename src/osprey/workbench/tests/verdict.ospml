// [WORKBENCH-VERDICT] cases: the kernel's verdict on statements and steps built
// as values from mathematical notation ([WORKBENCH-NO-ENGLISH]), the agreement
// between the goal engine and the kernel, and the unchecked holes.
namespace workbenchtests

import workbench::Formulas

(** The kernel-verdict cases of [WORKBENCH-VERIFICATION]. *)
module VerdictCases
    // A fixture formula in notation; a typo reads as an unbound atom, so its row can never check.
    math text = match Formulas::read text
        workbench::Read formula => formula
        workbench::Faulted _ => workbench::Var ("unreadable " + text)

    claim (variables, text) = workbench::Statement(name = "t", named = true, variables = variables, claim = math text)

    assume (name, text) = workbench::Assume name (math text)

    row (name, statement, steps) = { name = name, statement = statement, steps = steps }

    judged item = workbench::Verdicts::decide (item.statement, item.steps)

    shown verdict = match verdict
        workbench::Checked => "checked"
        workbench::Rejected index message => "rejected " + toString index + ": " + message
        workbench::Unchecked reason => "unchecked: " + reason

    refusalIndex verdict = match verdict
        workbench::Rejected at _ => at
        _ => satSub 0 999

    refusalText verdict = match verdict
        workbench::Rejected _ text => text
        _ => ""

    (** [WORKBENCH-VERDICT]: the prelude is admitted by the kernel's own checks. *)
    export prelude () =
        admitted = match workbench::Preludes::build ()
            workbench::Admitted _ => true
            workbench::Refused _ => false
        expect (admitted, true)

    swap (last, final) = row ("and-swap", claim (["p", "q"], "p ∧ q → q ∧ p"), [assume ("h", "p ∧ q"), workbench::Cases "h" ["hp", "hq"], workbench::Split, workbench::Exact last, workbench::Exact final])

    (** [WORKBENCH-VERDICT]: the spec's and_swap proof is checked by the kernel. *)
    export andSwap () = expect (shown (judged (swap ("hq", "hp"))), "checked")

    (** [WORKBENCH-VERDICT]: swapping the last two steps is rejected at the step the goal engine refuses, with the kernel's mismatch. *)
    export swapped () =
        verdict = judged (swap ("hp", "hq"))
        expect (refusalIndex verdict, 3)
        expect (startsWith (refusalText verdict, "type mismatch"), true)

    pq text = claim (["p", "q"], text)

    single text = claim (["p"], text)

    // The goal table, one passing proof per row, plus the spec's and_swap.
    table () = [
    swap ("hq", "hp"),
    row ("assume-implication", single "p → p", [assume ("h", "p"), workbench::Exact "h"]),
    row ("assume-forall", single "∀ q, p → q → p", [workbench::Assume "q" workbench::Top, assume ("h", "p"), assume ("k", "q"), workbench::Exact "h"]),
    row ("cases-and", pq "p ∧ q → p", [assume ("h", "p ∧ q"), workbench::Cases "h" ["a", "b"], workbench::Exact "a"]),
    row ("cases-or", pq "p ∨ q → q ∨ p", [assume ("h", "p ∨ q"), workbench::Cases "h" ["a", "b"], workbench::Right, workbench::Exact "a", workbench::Left, workbench::Exact "b"]),
    row ("split-and", pq "p → q → p ∧ q", [assume ("a", "p"), assume ("b", "q"), workbench::Split, workbench::Exact "a", workbench::Exact "b"]),
    row ("split-iff", single "p ↔ p", [workbench::Split, assume ("h", "p"), workbench::Exact "h", assume ("k", "p"), workbench::Exact "k"]),
    row ("left", pq "p → p ∨ q", [assume ("h", "p"), workbench::Left, workbench::Exact "h"]),
    row ("right", pq "q → p ∨ q", [assume ("h", "q"), workbench::Right, workbench::Exact "h"]),
    row ("exact", pq "p ∧ q → q", [assume ("h", "p ∧ q"), workbench::Cases "h" ["a", "b"], workbench::Exact "b"]),
    row ("apply", pq "(p → q) → p → q", [assume ("f", "p → q"), assume ("x", "p"), workbench::Apply "f", workbench::Exact "x"]),
    row ("absurd", pq "p → ¬p → q", [assume ("x", "p"), assume ("y", "¬p"), workbench::Absurd "x" "y"]),
    row ("absurd-implication", pq "p → (p → ⊥) → q", [assume ("x", "p"), assume ("f", "p → ⊥"), workbench::Absurd "x" "f"]),
    row ("apply-not-hypothesis", single "p → ¬p → ⊥", [assume ("x", "p"), assume ("h", "¬p"), workbench::Apply "h", workbench::Exact "x"]),
    row ("apply-not-hypothesis-implication", single "p → (p → ⊥) → ⊥", [assume ("x", "p"), assume ("f", "p → ⊥"), workbench::Apply "f", workbench::Exact "x"]),
    row ("assume-not-target", single "¬p → ¬p", [assume ("h", "¬p"), assume ("x", "p"), workbench::Apply "h", workbench::Exact "x"]),
    row ("navier-remaining-outcome", claim (["smooth", "blowup"], "(smooth ∨ blowup) → (blowup → ⊥) → smooth"), [assume ("outcomes", "smooth ∨ blowup"), assume ("noBlowup", "blowup → ⊥"), workbench::Cases "outcomes" ["isSmooth", "isBlowup"], workbench::Exact "isSmooth", workbench::Absurd "isBlowup" "noBlowup"]),
    row ("trailing-done", single "p → p", [assume ("h", "p"), workbench::Exact "h", workbench::Done]),
    ]

    unchecked item = shown (judged item) != "checked"

    (** [WORKBENCH-VERDICT]: one passing proof per row of the goal table is checked. *)
    export rows () =
        expect (join (mapList (filterList (table (), unchecked), \item => item.name), ", "), "")

    pqr text = claim (["p", "q", "r"], text)

    // Wrong proofs whose goal engine refuses a step; the kernel must refuse the same step.
    wrong () = [
    swap ("hp", "hq"),
    row ("no-hypothesis", single "p", [workbench::Exact "h"]),
    row ("split-atom", pq "p", [workbench::Split]),
    row ("left-atom", pq "p", [workbench::Left]),
    row ("right-atom", pq "p", [workbench::Right]),
    row ("cases-atom", single "p → p", [assume ("h", "p"), workbench::Cases "h" ["a", "b"]]),
    row ("exact-mismatch", pq "p → q → p", [assume ("h", "p"), assume ("k", "q"), workbench::Exact "k"]),
    row ("apply-mismatch", pq "(p → q) → p → p", [assume ("f", "p → q"), assume ("x", "p"), workbench::Apply "f", workbench::Exact "x"]),
    row ("absurd-implication-reversed", pq "(p → ⊥) → p → q", [assume ("f", "p → ⊥"), assume ("x", "p"), workbench::Absurd "f" "x"]),
    row ("absurd-other-implication", pqr "p → (q → ⊥) → r", [assume ("x", "p"), assume ("f", "q → ⊥"), workbench::Absurd "x" "f"]),
    row ("absurd-mismatch", pqr "p → q → r", [assume ("x", "p"), assume ("y", "q"), workbench::Absurd "x" "y"]),
    row ("apply-not-implication", pq "p → q", [assume ("h", "p"), workbench::Apply "h"]),
    ]

    walk0 statement = { outcome = workbench::Advanced (workbench::Goals::start statement), at = 0, stuck = satSub 0 1 }

    moved (walk, step) = match walk.outcome
        workbench::Stuck _ => walk
        workbench::Advanced progress => refused (walk, workbench::Goals::apply (progress, step))

    refused (walk, outcome) = match outcome
        workbench::Stuck _ => { outcome = outcome, at = satAdd walk.at 1, stuck = walk.at }
        _ => { outcome = outcome, at = satAdd walk.at 1, stuck = walk.stuck }

    refusalAt (statement, stepList) = (foldList (stepList, walk0 statement, \(walk, step) => moved (walk, step))).stuck

    // "" when the goal engine and the kernel agree on a proof, its name otherwise.
    disagrees item =
        verdict = judged item
        match workbench::Goals::run (item.statement, item.steps)
            workbench::Stuck _ => match verdict
                workbench::Rejected at _ => match at == refusalAt (item.statement, item.steps)
                    true => ""
                    false => item.name
                _ => item.name
            workbench::Advanced progress => match isEmpty progress.open
                true => match verdict
                    workbench::Checked => ""
                    _ => item.name
                false => item.name

    (** [WORKBENCH-VERDICT] [WORKBENCH-GOALS]: the goal engine and the kernel agree on every right and wrong proof. *)
    export agreement () =
        bad = filterList (listConcat (table (), wrong ()), \item => disagrees item != "")
        expect (join (mapList (bad, \item => item.name), ", "), "")

    (** [WORKBENCH-VERDICT]: a proof that stops with a goal open is unchecked, naming the open goal. *)
    export openGoal () =
        expect (shown (judged (row ("open", single "p → p", [assume ("h", "p")]))), "unchecked: step 2: the goal `p` is still open")

    (** [WORKBENCH-VERDICT]: a step after the proof is complete is unchecked. *)
    export surplus () =
        expect (shown (judged (row ("surplus", single "p → p", [assume ("h", "p"), workbench::Exact "h", workbench::Exact "h"]))), "unchecked: step 3 comes after the proof is complete")

    (** [WORKBENCH-VERDICT]: an undeclared atom is rejected on the statement with the kernel's unknown-constant message. *)
    export undeclaredAtom () =
        expect (shown (judged (row ("undeclared", claim ([], "p → p"), [assume ("h", "p"), workbench::Exact "h"]))), "rejected -1: unknown constant `p`")
