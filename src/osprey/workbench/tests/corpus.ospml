// [WORKBENCH-FORMULA] generated corpus: exhaustive round trips and proof that
// every parenthesis written by `show` is needed to preserve the formula.
namespace workbenchtests

import workbench::Formulas

(** The generated formula cases of [WORKBENCH-VERIFICATION]. *)
module CorpusCases
    atoms () = [workbench::Var "p", workbench::Var "q", workbench::Bot]

    connectives (left, right) = [workbench::And left right, workbench::Or left right, workbench::Imp left right, workbench::Iff left right]

    // Every connective over every pair drawn from `lefts` and `rights`.
    binaries (lefts, rights) = foldList (lefts, [], \(outer, left) => foldList (rights, outer, \(inner, right) => listConcat (inner, connectives (left, right))))

    // Depth 1: the atoms, their negations, every connective over two atoms, and one binder.
    shallow () =
        base = atoms ()
        listConcat (listConcat (base, mapList (base, \formula => workbench::Not formula)), listConcat (binaries (base, base), mapList (base, \formula => workbench::Forall ["p"] formula)))

    // Depth 2 wraps each depth-1 formula once and pairs it with an atom on either side, which
    // puts every connective under every other connective on both sides, the cases that need parentheses.
    (** The 1,215 generated formulas shared by the writer and typesetting properties. *)
    export corpus () =
        inner = shallow ()
        base = atoms ()
        wrapped = listConcat (mapList (inner, \formula => workbench::Not formula), mapList (inner, \formula => workbench::Forall ["p", "q"] formula))
        listConcat (listConcat (inner, wrapped), listConcat (binaries (inner, base), binaries (base, inner)))

    sameNamesAt (left, right, at) = match at >= length left
        true => true
        false => (listGet left at ?: "") == (listGet right at ?: "") && sameNamesAt (left, right, satAdd at 1)

    sameNames (left, right) = length left == length right && sameNamesAt (left, right, 0)

    // The constructor as a tag, the names it binds (a variable binds itself), and its children.
    tag formula = match formula
        workbench::Var _ => "var"
        workbench::Top => "top"
        workbench::Bot => "bot"
        workbench::Not _ => "not"
        workbench::And _ _ => "and"
        workbench::Or _ _ => "or"
        workbench::Imp _ _ => "imp"
        workbench::Iff _ _ => "iff"
        workbench::Forall _ _ => "forall"

    bound formula = match formula
        workbench::Var name => [name]
        workbench::Forall names _ => names
        _ => []

    children formula = match formula
        workbench::Not inner => [inner]
        workbench::And left right => [left, right]
        workbench::Or left right => [left, right]
        workbench::Imp left right => [left, right]
        workbench::Iff left right => [left, right]
        workbench::Forall _ inner => [inner]
        _ => []

    sameChildrenAt (lefts, rights, at) = match at >= length lefts
        true => true
        false => same (listGet lefts at ?: workbench::Bot, listGet rights at ?: workbench::Bot) && sameChildrenAt (lefts, rights, satAdd at 1)

    sameChildren (lefts, rights) = length lefts == length rights && sameChildrenAt (lefts, rights, 0)

    // Structural equality, deliberately independent of both `Formulas::equal` and `show`.
    same (a, b) = tag a == tag b && sameNames (bound a, bound b) && sameChildren (children a, children b)

    readsSame (text, formula) = match Formulas::read text
        workbench::Read found => same (formula, found)
        workbench::Faulted _ => false

    roundTripBad () = filterList (corpus (), \formula => !readsSame (Formulas::show formula, formula))

    summary failures = "${length failures}: ${listGet failures 0 ?: ""}"

    (** [WORKBENCH-FORMULA]: every corpus formula reads back structurally unchanged after `show`. *)
    export roundTrip () = expect (summary (mapList (roundTripBad (), \formula => Formulas::show formula)), "0: ")

    (** [WORKBENCH-FORMULA]: the corpus has exactly the hand-derived number of formulas. *)
    export generatedCount () =
        // Depth 1: 3 atoms + 3 negations + 4 * 3 * 3 binaries + 3 binders = 45.
        // Depth 2: 45 + 45 negations + 45 binders + 4 * 45 * 3 on each side = 1215.
        expect (length (shallow ()), 45)
        expect (length (corpus ()), 1215)

    closing (text, at, depth) = match at >= length text
        true => satSub 0 1
        false => match byteAt (text, at) ?: 0
            40 => closing (text, satAdd at 1, satAdd depth 1)
            41 => match depth == 1
                true => at
                false => closing (text, satAdd at 1, satSub depth 1)
            _ => closing (text, satAdd at 1, depth)

    withoutPair (text, open, close) = take (text, open) + (substring (text, satAdd open 1, close) ?: "") + drop (text, satAdd close 1)

    checkedPair (formula, text, open, close) = match close < 0
        true => text + " [unbalanced]"
        false =>
            reduced = withoutPair (text, open, close)
            match readsSame (reduced, formula)
                true => reduced
                false => redundantFrom (formula, text, satAdd open 1)

    redundantFrom (formula, text, at) = match at >= length text
        true => ""
        false => match (byteAt (text, at) ?: 0) == 40
            true => checkedPair (formula, text, at, closing (text, satAdd at 1, 1))
            false => redundantFrom (formula, text, satAdd at 1)

    redundant formula = redundantFrom (formula, Formulas::show formula, 0)

    minimalityBad () = filterList (corpus (), \formula => redundant formula != "")

    (** [WORKBENCH-FORMULA]: removing any one matching parenthesis pair from generated output fails to read or changes the formula. *)
    export minimalParentheses () = expect (summary (mapList (minimalityBad (), \formula => Formulas::show formula + " => " + redundant formula)), "0: ")
