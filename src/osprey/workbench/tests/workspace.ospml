// [WORKBENCH-BOARD] [WORKBENCH-DOCUMENT]: actual document save/open flows retain no drawing state.
namespace workbenchtests

import workbench::Benches
import workbench::Workspaces
import ui::Doc
import workbenchtests::Drive

(** Current document persistence and mathematical editing through the real application. *)
module WorkspaceCases
    (** The workbench exposes mathematical text entry, without an unsupported ink surface. *)
    export mathematicalWorkspaceOnly () =
        first = Drive::started ()
        forEachList (["root", "board"], \key => withoutInk (Drive::node (first, key)))
        expect (AppCases::regionKind (first, "board"), "")
        editor = Drive::labelledIn ("Argument & calculations", first, "document")
        AppCases::holds (editor, ["event"])
        typed = Drive::choose (first, "document", "Argument & calculations", Drive::quoted "p → p")
        AppCases::kept (typed, "p → p")
        staleDocumentControl (first, typed)
        framed = Drive::posted (typed, \d => uitest::Drive::frame (d, 0.016))
        expect (Doc::text (Drive::stored framed, "notice"), Doc::text (Drive::stored typed, "notice"))
        AppCases::kept (framed, "p → p")
        AppCases::unasked framed

    staleDocumentControl (_issued, current) =
        refused = Drive::stray (current, 9999, "p → q")
        AppCases::identical (refused, current)
        expect (isEmpty (Drive::problem refused), false)

    withoutInk node =
        forEachList (["board", "canvas"], \kind => expect (Doc::text (Drive::findNode (kind, node), "kind"), ""))
        forEachList (["Draw", "Pan board", "Undo", "Clear", "Preview sample transcription", "Transcribe selection"], \label => AppCases::lacks (Drive::findLabel (label, node), ["event"]))


    export withoutDrawing stored = AppCases::lacks (stored, ["strokes", "lassoing", "clearing", "ink", "inks", "scale", "panX", "panY", "notes", "notesVisible", "panMode", "boardFocused", "preview", "samplePreview"])

    export opened envelope = match Workspaces::encode (Benches::restore (Drive::stored envelope))
        Error problem =>
            FixtureFiles::report problem
            envelope
        Success source => openSource (envelope, source)

    openSource (envelope, source) =
        asked = Drive::press (envelope, "heading", "Open workspace")
        Drive::completedHeld (asked, "workspace:opened", "working.json", JsonObject [Doc::str ("workspace:import", source)])

    written () =
        first = Drive::started ()
        named = Drive::post (first, Drive::labelled (first, first, "document", "Untitled solution", Drive::quoted "Conjunction proof"))
        AppCases::typed (named, WorkflowCases::savedSource ())

    export roundTrip () =
        first = written ()
        expect (AppCases::check first, "checked at -1")
        saved = Drive::press (first, "heading", "Save")
        expect (Drive::tickets saved, "workspace:saved")
        source = Doc::text (Drive::hostSlices [saved], "workspace:saved")
        doc = Doc::parse source
        expect (Doc::number (doc, "version"), 2)
        AppCases::spelled (doc, [{ key = "title", value = "Conjunction proof" }])
        AppCases::agrees (doc, Drive::stored first, ["text"])
        expect (Doc::has (doc, "board") || Doc::has (doc, "checks"), false)
        restored = openSource (AppCases::typed (Drive::started (), "Unrelated working."), source)
        expect (Doc::text (Drive::stored restored, "text"), Doc::text (Drive::stored first, "text"))
        AppCases::spelled (Drive::stored restored, [{ key = "title", value = "Conjunction proof" }])
        expect (AppCases::check restored, "checked at -1")
        expect (Doc::text (Drive::stored restored, "notice"), "Workspace opened. Supported statements have been checked again.")
        AppCases::unflagged (Drive::stored restored, ["noticeBad"])
        AppCases::unwritten restored
        AppCases::unasked restored
        withoutDrawing (Drive::stored restored)

    export versions () = forEachList (["0", "1", "3", "-1", "2.0", "2.5", "\"2\"", "null"], \version => refused ("{\"version\":" + version + ",\"title\":\"Old\",\"text\":\"p → p\"}", "version"))

    export drawingData () = forEachList (["null", "{}", "[]", "\"ink\""], \board => forEachList ([1, 2], \version => refused ("{\"version\":" + toString version + ",\"title\":\"Old\",\"text\":\"p → p\",\"board\":" + board + "}", "drawing")))

    export malformed () =
        forEachList (["not JSON", "{", "["], \source => refused (source, "JSON"))
        forEachList (["{}", "[]", "{\"version\":2,\"title\":\"Wrong\",\"text\":42}"], \source => refused (source, "written working"))
        refused ("{\"version\":2,\"text\":\"p → p\"}", "title")

    refused (source, message) =
        before = written ()
        after = openSource (before, source)
        AppCases::flagged (Drive::stored after, ["noticeBad"])
        AppCases::present (Doc::text (Drive::stored after, "notice"), [message])
        AppCases::agrees (Drive::stored after, Drive::stored before, ["text", "title"])
        AppCases::counts (Drive::stored after, Drive::stored before, ["caret"])
        expect (Doc::write (Doc::field (Drive::stored after, "checks")), Doc::write (Doc::field (Drive::stored before, "checks")))
        AppCases::unwritten after
        AppCases::unasked after
        withoutDrawing (Drive::stored after)

    export sliceIsolation () =
        first = written ()
        saved = Drive::pressIn (first, JsonObject [Doc::str ("board", "malformed unrelated slice")], "Save")
        expect (Drive::tickets saved, "workspace:saved")
        doc = Doc::parse (Doc::text (Drive::hostSlices [saved], "workspace:saved"))
        AppCases::sized (doc, [{ key = "version", value = 2 }])
        AppCases::agrees (doc, Drive::stored first, ["text"])
        AppCases::lacks (doc, ["board"])
        withoutDrawing (Drive::stored saved)
