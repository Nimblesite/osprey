// Implements [WORKBENCH-STATEMENT]: the statement the held goal engine and kernel
// check. It is built from mathematical notation only; no English heading is ever
// read into it ([WORKBENCH-NO-ENGLISH]).
namespace workbench


(** A theorem: its name, whether the writer named it, the variables `∀` binds, and the claim ([WORKBENCH-STATEMENT]). *)
type Statement =
    name : string
    named : bool
    variables : List<string>
    claim : Formula
