// Implements [WORKBENCH-STORE] and [LESSONS-STORE]: one store, one slice per
// concern, each its own record type so that each is its own signal. No slice
// holds English as mathematics or proof ([WORKBENCH-NO-ENGLISH]).
namespace workbench

import ui::Doc

(** Which side of the application leads: the checked proof library or Learn mode ([LESSONS-MODE]). *)
type Mode = Working | Learning

(** Which surface is shown, the appearance and the operation notice ([WORKBENCH-STORE]). *)
type Layout =
    mode : Mode
    slate : bool
    noticeText : string
    noticeBad : bool

(** One catalogue entry as listed: slug, title, summary, stage, minutes, its challenge keys, and the reader's fault, empty when it reads ([LESSONS-FILES]). *)
type Listing =
    entrySlug : string
    entryTitle : string
    entrySummary : string
    entryStage : int
    entryMinutes : int
    entryChallenges : List<string>
    entryFault : string

(** The lesson catalogue, the open lesson's slug and text, the challenge last typed into, and why lessons failed to load ([LESSONS-STORE]). *)
type Shelf =
    entries : List<Listing>
    openSlug : string
    openSource : string
    focused : string
    shelfProblem : string

(** Current imported source and selection, without cached proof acceptance. *)
type ImportedState =
    exportText : string
    exportLarge : bool
    exportSelected : string
    exportProblem : string
    exportExpanded : bool
    exportRevision : int
    libraryCatalogue : string
    libraryProblem : string
    libraryPending : string
    libraryTicket : string
    libraryExpanded : bool

(** The whole store ([WORKBENCH-STORE], [LESSONS-STORE]). *)
type Bench =
    layout : Layout
    shelf : Shelf
    tutor : Tutor
    imports : ImportedState

// One action union per program until Nimblesite/osprey#278; grouped by the value each binding delivers.
(** Every action a control can deliver: modes, the proof library, lessons and challenges. *)
type Act = ToWork | ToLearn | OpenProofLibrary | OpenBundledProof string | SelectProof | EditProofSource | ToggleProofSource | ToggleProofLibraries | DismissNotice | ToggleTheme | Open string | Close | Answer string | FormulaPlace string | Key string string | Submit string | Hint string

(** Creates and saves the store. *)
module Benches
    (** The checked library, no lessons yet. *)
    export fresh () = Bench(layout = Layout(mode = Working, slate = false, noticeText = "", noticeBad = false), shelf = Shelf(entries = [], openSlug = "", openSource = "", focused = "", shelfProblem = ""), tutor = Tutors::empty (), imports = emptyImports ())

    flag (key, value) = JsonMember key (JsonBool value)

    learning layout = match layout.mode
        Learning => true
        Working => false

    (** The saved store: every slice ([UI-STORE]). *)
    export save bench = JsonObject [Doc::str ("problem", bench.shelf.shelfProblem), flag ("learning", learning bench.layout), flag ("slate", bench.layout.slate), Doc::str ("notice", bench.layout.noticeText), flag ("noticeBad", bench.layout.noticeBad), Doc::str ("lesson", bench.shelf.openSlug), Doc::str ("source", bench.shelf.openSource), Doc::str ("focused", bench.shelf.focused), JsonMember "entries" (JsonArray (mapList (bench.shelf.entries, \entry => entryJson entry))), JsonMember "imports" (importsJson bench.imports), JsonMember "tutor" (Tries::save bench.tutor)]

    entryJson entry = JsonObject [Doc::str ("slug", entry.entrySlug), Doc::str ("title", entry.entryTitle), Doc::str ("summary", entry.entrySummary), Doc::num ("stage", entry.entryStage), Doc::num ("minutes", entry.entryMinutes), JsonMember "challenges" (Doc::strings entry.entryChallenges), Doc::str ("fault", entry.entryFault)]

    emptyImports () = ImportedState(exportText = "", exportLarge = false, exportSelected = "", exportProblem = "", exportExpanded = false, exportRevision = 0, libraryCatalogue = "", libraryProblem = "", libraryPending = "", libraryTicket = "", libraryExpanded = true)

    importsJson current = JsonObject [Doc::str ("source", current.exportText), Doc::str ("selected", current.exportSelected), Doc::str ("problem", current.exportProblem), flag ("large", current.exportLarge), flag ("expanded", current.exportExpanded), Doc::num ("revision", current.exportRevision), Doc::str ("catalogue", current.libraryCatalogue), Doc::str ("catalogueProblem", current.libraryProblem), Doc::str ("pending", current.libraryPending), Doc::str ("ticket", current.libraryTicket), flag ("librariesExpanded", current.libraryExpanded)]
