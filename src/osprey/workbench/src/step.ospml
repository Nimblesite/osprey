// Implements [WORKBENCH-STEPS]: the proof steps the held goal engine and kernel
// elaborate. A step is a value, never read from an English sentence
// ([WORKBENCH-NO-ENGLISH]).
namespace workbench


(** One proof step of the goal engine ([WORKBENCH-STEPS]). *)
type Step = Assume string Formula | Cases string (List<string>) | Split | Left | Right | Exact string | Apply string | Absurd string string | Done
