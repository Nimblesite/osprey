// Implements [WORKBENCH-STORE] and [LESSONS-STORE]: the one `update`. Every
// verdict comes from the kernel through `CachedImports` and `Tutors`; this
// module only routes messages to them and to the host.
namespace workbench

import ui::Runtime
import ui::Messages

(** Mode and notice taps ([WORKBENCH-STORE], [LESSONS-MODE]). *)
module Layouts
    (** The layout after a tap on a mode or notice control. *)
    export tapped (layout, action) = match action
        DismissNotice => layout(noticeText = "", noticeBad = false)
        ToggleTheme => layout(slate = !layout.slate)
        ToWork => layout(mode = Working)
        ToLearn => layout(mode = Learning)
        _ => layout

(** The application's `update` ([WORKBENCH-STORE]). *)
module Update
    // A challenge action names its lesson; one a frame of another lesson issued changes nothing.
    challenged (bench, ref, act) = match Coach::local (bench, ref)
        Success id => act id
        Error _ => Runtime::step bench

    tapped (bench, action) = match action
        OpenProofLibrary => ProofLibraries::open bench
        OpenBundledProof path => BundledLibraries::open (bench, path)
        Open slug => Runtime::step (Coach::open (bench, slug))
        Close => Runtime::step (Coach::close bench)
        Submit ref => challenged (bench, ref, \id => Coach::submit (bench, id))
        Hint ref => challenged (bench, ref, \id => Runtime::step (Coach::hint (bench, id)))
        Key ref text => challenged (bench, ref, \id => Runtime::step (Coach::insert (bench, id, text)))
        _ => Runtime::step (bench(layout = Layouts::tapped (bench.layout, action)))

    typed (bench, action, text) = match action
        SelectProof => Runtime::step (ProofLibraries::selected (bench, text))
        EditProofSource => Runtime::step (ProofLibraries::edited (bench, text))
        Answer ref => challenged (bench, ref, \id => Runtime::step (Coach::answer (bench, id, text)))
        _ => Runtime::step bench

    sized (bench, action, number) = match action
        FormulaPlace ref => challenged (bench, ref, \id => Runtime::step (Coach::moved (bench, id, number)))
        _ => Runtime::step bench

    switched (bench, action, open) = match action
        ToggleProofLibraries => Runtime::step (BundledLibraries::expanded (bench, open))
        ToggleProofSource => Runtime::step (ProofLibraries::expanded (bench, open))
        _ => Runtime::step bench

    (** The next store, requests and slice writes for `message` ([WORKBENCH-STORE]). *)
    export apply (_, bench, message) = Messages::route (message, \action => tapped (bench, action), \(action, text) => typed (bench, action, text), \(action, open) => switched (bench, action, open), \(action, number) => sized (bench, action, number), \(ticket, outcome) => Completions::completed (bench, ticket, outcome), \_ => Runtime::step bench, \(_, _) => Runtime::step bench, \(_, _) => Runtime::step bench, \_ => Runtime::step bench, \(_, _) => Runtime::step bench)
