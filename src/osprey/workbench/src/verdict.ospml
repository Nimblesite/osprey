// Implements [WORKBENCH-VERDICT]: steps become one proof term and the kernel
// of spec 0049 checks it against the statement. The verdict is the kernel's;
// the goal engine only says which step to underline when the kernel refuses.
// A proof with an unknown step or an open goal is never sent to the kernel.
namespace workbench

import workbench::Formulas
import workbench::Goals
import workbench::Lists
import workbench::Closing
import workbench::Propositions
import workbench::Preludes
import proof::Infer

(** What the kernel said about one declaration: checked, rejected at a step (`-1` for the statement) with the kernel's reason, or not checked and why. *)
type Verdict = Checked | Rejected int string | Unchecked string

(** A proof term covering the steps before `next`, or the step at which the proof has a hole and why. *)
type Built = Proved Named int | Holed int string

(** Where the goal engine first refuses a step: its index, or `-1` when it accepts them all. *)
type Refusal =
    outcome : Outcome
    at : int
    stuck : int

(** Steps to proof terms, following the tactic semantics of [WORKBENCH-GOALS]. A step that does not fit its goal still becomes a term, so the kernel, not the workbench, refuses it. *)
module Elaborate
    of formula = Propositions::of formula

    held (goal, name) = foldList (goal.hypotheses, Absent, \(found, hypothesis) => matching (found, hypothesis, name))

    matching (found, hypothesis, name) = match hypothesis.name == name
        true => Held hypothesis.formula
        false => found

    hypothesis (name, formula) = Hypothesis(name = name, formula = formula)

    wrap (built, make) = match built
        Proved term next => Proved (make term) next
        Holed at reason => Holed at reason

    both (first, steps, second, make) = match first
        Holed at reason => Holed at reason
        Proved left next => wrap (prove (second, steps, next), \right => make (left, right))

    (** The proof term of `steps` from step `at` for `goal`. *)
    export prove (goal, steps, at) = match listGet steps at
        Error _ => Holed at ("the goal `" + Formulas::show goal.target + "` is still open")
        Success step => stepped (goal, steps, at, step)

    stepped (goal, steps, at, step) = match step
        Done => prove (goal, steps, satAdd at 1)
        Unknown text => Holed at ("`" + text + "` is not a step the workbench knows")
        Assume name formula => assume (goal, steps, at, { name = name, formula = formula })
        Cases name names => cases (goal, steps, at, { name = name, names = names })
        Split => split (goal, steps, at)
        Left => side (goal, steps, at, "or_inl")
        Right => side (goal, steps, at, "or_inr")
        Exact name => Proved (NVar name) (satAdd at 1)
        Apply name => applied (goal, steps, at, name)
        Absurd name other => absurd (goal, at, name, other)

    // `Assume h : A`: a λ over `A` whose body proves the conclusion; on `∀ p ...` a λ over the next bound proposition.
    // A negated head is read as the implication it is defined to be.
    assume (goal, steps, at, step) = match Formulas::expandNot goal.target
        Imp _ conclusion => wrap (prove (Goal(hypotheses = listAppend (goal.hypotheses, Hypothesis(name = step.name, formula = step.formula)), target = conclusion), steps, satAdd at 1), \term => NLam step.name (of step.formula) term)
        Forall names body => bound (goal, steps, at, { names = names, body = body })
        _ => wrap (prove (goal, steps, satAdd at 1), \term => NLam step.name (of step.formula) term)

    bound (goal, steps, at, parts) = wrap (prove (goal(target = inner parts), steps, satAdd at 1), \term => NLam (listGet parts.names 0 ?: "") NProp term)

    inner parts = match length parts.names <= 1
        true => parts.body
        false => Forall (Lists::rest parts.names) parts.body

    cases (goal, steps, at, parts) = match held (goal, parts.name)
        Absent => Proved (NVar parts.name) (satAdd at 1)
        Held formula => casesOn (goal, steps, at, { parts = parts, formula = formula })

    casesOn (goal, steps, at, split) =
        first = listGet split.parts.names 0 ?: ""
        second = listGet split.parts.names 1 ?: ""
        kept = filterList (goal.hypotheses, \hypothesis => hypothesis.name != split.parts.name)
        match split.formula
            And left right => wrap (prove (goal(hypotheses = listConcat (kept, [hypothesis (first, left), hypothesis (second, right)])), steps, satAdd at 1), \term => Propositions::apply (NConst "and_cases", [of left, of right, of goal.target, NVar split.parts.name, NLam first (of left) (NLam second (of right) term)]))
            Or left right => both (prove (goal(hypotheses = listAppend (kept, hypothesis (first, left))), steps, satAdd at 1), steps, goal(hypotheses = listAppend (kept, hypothesis (second, right))), \(one, two) => Propositions::apply (NConst "or_cases", [of left, of right, of goal.target, NVar split.parts.name, NLam first (of left) one, NLam second (of right) two]))
            _ => Proved (NApp (NConst "and_cases") (NVar split.parts.name)) (satAdd at 1)

    split (goal, steps, at) = match goal.target
        And left right => pair (steps, at, { rule = "and_intro", left = left, right = right, first = goal(target = left), second = goal(target = right) })
        Iff left right => pair (steps, at, { rule = "iff_intro", left = left, right = right, first = goal(target = Imp left right), second = goal(target = Imp right left) })
        _ => Proved (NConst "and_intro") (satAdd at 1)

    pair (steps, at, parts) = both (prove (parts.first, steps, satAdd at 1), steps, parts.second, \(one, two) => Propositions::apply (NConst parts.rule, [of parts.left, of parts.right, one, two]))

    side (goal, steps, at, rule) = match goal.target
        Or left right => wrap (prove (goal(target = chosen (rule, left, right)), steps, satAdd at 1), \term => Propositions::apply (NConst rule, [of left, of right, term]))
        _ => Proved (NConst rule) (satAdd at 1)

    chosen (rule, left, right) = match rule == "or_inl"
        true => left
        false => right

    // `Apply h` with `h : A` on goal `A` is `h` itself, as in the goal engine.
    applied (goal, steps, at, name) = match held (goal, name)
        Held formula => match Formulas::equivalent (formula, goal.target)
            true => Proved (NVar name) (satAdd at 1)
            false => implication (goal, steps, at, { name = name, formula = formula })
        Absent => Proved (NVar name) (satAdd at 1)

    // A negated head carries the implication it is defined to be, so `h : ¬p` applies as `h : p → ⊥`.
    implication (goal, steps, at, parts) = match Formulas::expandNot parts.formula
        Imp premise _ => wrap (prove (goal(target = premise), steps, satAdd at 1), \term => NApp (NVar parts.name) term)
        _ => Proved (NVar parts.name) (satAdd at 1)

    absurd (goal, at, name, other) = match held (goal, name)
        Held formula => Proved (Propositions::apply (NConst "absurd", [of formula, of goal.target, NVar name, NVar other])) (satAdd at 1)
        Absent => Proved (NVar name) (satAdd at 1)

(** The kernel's verdict on a declaration ([WORKBENCH-VERDICT]). *)
module Verdicts
    // The index of the first step the goal engine refuses, or -1.
    stuckAt (statement, steps) = (foldList (steps, Refusal(outcome = Advanced (Goals::start statement), at = 0, stuck = 0 - 1), \(walk, step) => moved (walk, step))).stuck

    moved (walk, step) = match walk.outcome
        Stuck _ => walk
        UnsupportedStep _ _ => walk
        Advanced progress => refused (walk, Goals::apply (progress, step))

    refused (walk, outcome) = match outcome
        Stuck _ => Refusal(outcome = outcome, at = satAdd walk.at 1, stuck = walk.at)
        UnsupportedStep _ _ => walk(outcome = outcome, at = satAdd walk.at 1)
        Advanced _ => walk(outcome = outcome, at = satAdd walk.at 1)

    // Steps after the proof closes may only be `Done`.
    surplus (steps, next) = filterList (mapList (Lists::first (listReverse steps, satSub (length steps) next), \step => isDone step), \done => !done)

    isDone step = match step
        Done => true
        _ => false

    (** The statement as a kernel type: `∀ (variables : Prop), claim`. *)
    export statementTerm statement = Closing::close (Propositions::props (statement.variables, Propositions::of statement.claim), [])

    (** The kernel's verdict on `steps` as a proof of `statement` in the prelude environment. *)
    export decide (statement, steps) = match Preludes::build ()
        Refused message => Unchecked ("the prelude was refused: " + message)
        Admitted env => built (env, statement, steps, Elaborate::prove (Goal(hypotheses = [], target = statement.claim), steps, 0))

    built (env, statement, steps, result) = match result
        Holed at reason => Unchecked ("step ${satAdd at 1}: " + reason)
        Proved term next => match isEmpty (surplus (steps, next))
            true => kernel (env, statement, steps, term)
            false => Unchecked ("step ${satAdd next 1} comes after the proof is complete")

    kernel (env, statement, steps, term) =
        claim = statementTerm statement
        match Infer::sort (env, [], claim)
            Error message => Rejected (0 - 1) message
            Success _ => judged (Infer::check (env, [], Closing::close (Propositions::lambdas (statement.variables, term), []), claim), statement, steps)

    judged (result, statement, steps) = match result
        Success _ => Checked
        Error message => Rejected (stuckAt (statement, steps)) message
