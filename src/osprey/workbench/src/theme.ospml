// Implements [WORKBENCH-DESIGN-COLOUR]: the application-owned semantic token
// table and the source-role colours, sent through `@osprey/native`; a host does
// not substitute its own palette. The spacing scale and motion durations of
// [WORKBENCH-DESIGN-MOTION] ride along on the same theme value.
namespace workbench

(** The paper and chalk themes, each the full semantic token table with its spacing scale and motion durations ([WORKBENCH-DESIGN-COLOUR]). *)
module Palettes
    (** One semantic colour role: its name and its Paper and Slate column, the two appearances the table holds ([WORKBENCH-DESIGN-COLOUR]). *)
    type Role =
        roleName : string
        rolePaper : string
        roleSlate : string

    // Every semantic role of the colour table, in table order.
    roles = [
        Role(roleName = "canvas", rolePaper = "#FAFAF7", roleSlate = "#202723"),
        Role(roleName = "inset", rolePaper = "#F0F2ED", roleSlate = "#191F1C"),
        Role(roleName = "surface", rolePaper = "#FFFFFF", roleSlate = "#29322D"),
        Role(roleName = "primary", rolePaper = "#242923", roleSlate = "#ECEDE5"),
        Role(roleName = "secondary", rolePaper = "#56615B", roleSlate = "#B7C0B7"),
        Role(roleName = "accent", rolePaper = "#36635C", roleSlate = "#A6C5BB"),
        Role(roleName = "outline", rolePaper = "#727C74", roleSlate = "#7D8C80"),
        Role(roleName = "divider", rolePaper = "#D7DDD5", roleSlate = "#465348"),
        Role(roleName = "selection", rolePaper = "#E4ECE5", roleSlate = "#34473E"),
        Role(roleName = "good", rolePaper = "#315D3B", roleSlate = "#B3CE94"),
        Role(roleName = "caution", rolePaper = "#795719", roleSlate = "#E6C077"),
        Role(roleName = "danger", rolePaper = "#9A3935", roleSlate = "#F0A69B"),
        Role(roleName = "dangerSurface", rolePaper = "#F6E8E3", roleSlate = "#453330"),
        Role(roleName = "board", rolePaper = "#202723", roleSlate = "#202723"),
        Role(roleName = "chalk", rolePaper = "#ECEDE5", roleSlate = "#ECEDE5"),
        Role(roleName = "sourceKeyword", rolePaper = "#794A64", roleSlate = "#D5B0C7"),
        Role(roleName = "sourceType", rolePaper = "#426B6B", roleSlate = "#A6C5BB"),
        Role(roleName = "sourceName", rolePaper = "#704F25", roleSlate = "#DEC28F"),
        Role(roleName = "sourceComment", rolePaper = "#56615B", roleSlate = "#A6B5AA"),
    ]

    // The theme of a token list: one spacing scale and one pair of motion durations for both themes.
    themeOf tokens = ui::Theme(tokens = tokens, spacing = [4, 8, 12, 16, 24, 32], feedback = 140, settle = 240)

    // The table as tokens: `light` and `dark` pick each role's appearance value.
    tokensOf (light, dark) = mapList (roles, \role => ui::Token(tokenName = role.roleName, tokenLight = light role, tokenDark = dark role))

    (** The paper theme: ink on off-white. `tokenLight` holds the Paper column and `tokenDark` the Slate column, so the paper layout follows the system appearance ([WORKBENCH-DESIGN-COLOUR]). *)
    export paper () = themeOf (tokensOf (\role => role.rolePaper, \role => role.roleSlate))

    (** The chalk theme: the board-first layout, slate in both appearances. Every token's light and dark value is the Slate column, so the board never follows the system appearance ([WORKBENCH-DESIGN-COLOUR]). *)
    export chalk () = themeOf (tokensOf (\role => role.roleSlate, \role => role.roleSlate))

    (** The reference's initial Paper appearance, independent of the host's current appearance. *)
    export initial () =
        base = paper ()
        base(tokens = mapList (base.tokens, \item => item(tokenDark = item.tokenLight)))
