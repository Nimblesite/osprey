// Implements [WORKBENCH-REGIONS], [WORKBENCH-LIBRARY] and [LESSONS-MODE]: the Work
// regions. Work shows the checked proof library, its rules and the notation;
// nothing here reads or writes English as mathematics ([WORKBENCH-NO-ENGLISH]).
namespace workbench

import ui::Ui
import ui::Media
import ui::Maths
import ui::Frames
    plain
    text

(** The Work regions of [WORKBENCH-REGIONS] and the root that holds every region. *)
module WorkViews
    export layout () = perform Signal<Layout>.read ()

    shelf () = perform Signal<Shelf>.read ()

    working mode = match mode
        Working => true
        Learning => false

    picked on = match on
        true => ui::Prominent
        false => ui::Plain

    (** [WORKBENCH-REGIONS] [LESSONS-MODE] The Library and Lessons segment over the surface the mode shows. *)
    export root () =
        current = layout ()
        Ui::themed (palette current, Ui::framed (plain(frameName = "workbench", frameGrow = true, frameFill = "canvas"), Ui::column [Ui::framed (plain(frameHeight = 75), Ui::slot "heading"), ui::Divider, navigation current, ui::Divider, operationNotice current, surface current, footer ()]))

    palette current = match current.slate
        true => Palettes::chalk ()
        false => Palettes::initial ()

    export header () = Ui::framed (plain(frameName = "app-header", frameControlPadding = 12, frameAlign = "center", frameControlHeight = 40, frameQuietControls = true, frameFont = "sans", frameTextSize = 12, frameHeight = 75, frameLeft = 36, frameRight = 36), Ui::row [wordmark (), ui::Spacer, headerActions (layout ())])

    headerActions current = Ui::framed (plain(frameName = "header-actions", frameGap = 9, frameHug = true, frameAlign = "center"), Ui::row [Ui::button ("Play walkthrough", "play.fill", ToLearn), sizedIconButton ("Switch appearance", appearanceSymbol current, ToggleTheme, 40, 40)])

    appearanceSymbol current = match current.slate
        true => "sun.max"
        false => "moon"

    export letter (family, size, italic, content, role, tone) = Ui::framed (text (family, size, italic), Ui::styled (content, role, tone))

    iconButton (label, symbol, action) = sizedIconButton (label, symbol, action, 38, 38)

    sizedIconButton (label, symbol, action, width, height) = Ui::framed (plain(frameHug = true, frameWidth = width, frameHeight = height, frameIconOnly = true, frameQuietControls = true, frameControlHeight = height, frameAlign = "center"), Ui::button (label, symbol, action))

    wordmark () = Ui::framed (plain(frameName = "wordmark", frameGap = 10, frameTracking = -0.6, frameHug = true, frameAlign = "center"), Ui::row [letter ("serif", 27, true, "Proof", ui::Callout, ui::Primary), letter ("serif", 27, false, "Workbench", ui::Title, ui::Primary)])

    navigation current = Ui::framed (plain(frameName = "workspace-nav", frameControlPadding = 17, frameAlign = "center", frameControlHeight = 40, frameQuietControls = true, frameFont = "sans", frameTextSize = 12, frameHeight = 59, frameLeft = 36, frameRight = 36, frameGap = 8), Ui::row [Ui::action ("Library", "book", picked (working current.mode), true, ToWork), Ui::action ("Lessons", "magnifyingglass", picked (!working current.mode), true, ToLearn), ui::Spacer])

    operationNotice current = match isEmpty current.noticeText
        true => Ui::column []
        false => Ui::framed (plain(frameName = "operation-notice", frameTop = 12, frameRight = 24, frameBottom = 12, frameLeft = 24), Ui::row [Ui::styled (current.noticeText, ui::Body, noticeTone current.noticeBad), ui::Spacer, iconButton ("Dismiss message", "xmark", DismissNotice)])

    noticeTone bad = match bad
        true => ui::Danger
        false => ui::Secondary

    footer () = Ui::framed (plain(frameName = "app-footer", frameAlign = "center", frameFont = "sans", frameTextSize = 11, frameHeight = 43, frameLine = "divider", frameLineEdge = "top", frameLeft = 26, frameRight = 26), Ui::row [Ui::caption "Checked proofs are marked by the kernel.", ui::Spacer, Ui::link ("Built with Osprey", "https://ospreylang.dev/")])

    about () = Ui::section ("Built with Osprey", "Explore the language behind the workbench.", [Media::image ("osprey-logo.png", "Osprey", 64, 64), Ui::link ("Osprey website", "https://ospreylang.dev/"), Ui::link ("Language documentation", "https://ospreylang.dev/docs/"), Ui::link ("Workbench source", "https://github.com/Nimblesite/osprey/tree/main/src/osprey/workbench")])

    surface current = match current.mode
        Learning => Ui::framed (plain(frameName = "lesson-page", frameTop = 32, frameRight = 32, frameBottom = 48, frameLeft = 32, frameGap = 24), learned ())
        Working => Ui::framed (plain(frameName = "proof-library-inspection", frameGrow = true, frameTop = 32, frameRight = 32, frameBottom = 40, frameLeft = 32, frameGap = 24), Ui::slot "library")

    learned () = match isEmpty (shelf ()).openSlug
        true => Ui::slot "catalogue"
        false => Ui::slot "lesson"

    export shown formula = Maths::typeset (Formulas::typeset formula, Formulas::show formula)

    rules () = [{ ruleName = "and_intro", ruleSays = "p → q → p ∧ q" }, { ruleName = "and_cases", ruleSays = "p ∧ q → (p → q → r) → r" }, { ruleName = "or_inl", ruleSays = "p → p ∨ q" }, { ruleName = "or_inr", ruleSays = "q → p ∨ q" }, { ruleName = "or_cases", ruleSays = "p ∨ q → (p → r) → (q → r) → r" }, { ruleName = "iff_intro", ruleSays = "(p → q) → (q → p) → (p ↔ q)" }, { ruleName = "absurd", ruleSays = "p → ¬p → r" }]

    ruled item = match Formulas::read item.ruleSays
        Read formula => Ui::row [Ui::styled (item.ruleName, ui::Mono, ui::Accent), shown formula]
        Faulted _ => Ui::row [Ui::styled (item.ruleName, ui::Mono, ui::Accent), Ui::text item.ruleSays]

    (** [WORKBENCH-REGIONS] The proof library's bundled libraries and file action. *)
    export libraryActions () = ProofLibraries::actions (perform Signal<ImportedState>.read ())

    (** [WORKBENCH-REGIONS] The checked library, the prelude's rules, which the kernel itself checked, and the symbol abbreviations, read only. *)
    export library () = Ui::column [ProofLibraries::pane (perform Signal<ImportedState>.read ()), Ui::section ("Rules", "Checked by the kernel when the workbench starts.", mapList (rules (), \item => ruled item)), Ui::section ("Typing symbols", "Type a backslash and the name.", mapList (Notation::table, \entry => Ui::caption ("\\" + entry.abbreviation + "  " + entry.symbol))), about ()]
