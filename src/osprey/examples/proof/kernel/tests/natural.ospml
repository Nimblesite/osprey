namespace prooftests

import proof::Naturals
import proof
    Natural

(** Exact naturals for Lean's `natVal` literals. Every expected decimal
    beyond a few digits comes from Python 3 integers (expression beside it);
    no value is checked against itself. *)
module NaturalTests
    (** The boundary decimals the grid and the cases return to: 2^64 (one past
        the machine integer), 10^30 + 7 (a 100-bit odd), 2^200 (exactly three
        64-bit limbs), 10^27 - 1, 10^18 - 1 and 10^18 (the limb carry). *)
    twoToTheSixtyFour = "18446744073709551616"
    tenToThirtyPlusSeven = "1000000000000000000000000000007"
    twoToTheTwoHundred = "1606938044258990275541962092341162602522202993782792835301376"
    tenToTwentySevenMinusOne = "999999999999999999999999999"
    tenToEighteenMinusOne = "999999999999999999"
    tenToEighteen = "1000000000000000000"

    (** `text` read, or zero with the failure recorded. *)
    nat (text) = Support::verified ("a literal reads", "no error", Naturals::zero (), Naturals::parse text)

    shown (outcome) = match outcome
        Success n => Naturals::show n
        Error message => "error: ${message}"

    sum (a, b) = Naturals::show (Naturals::add (nat a, nat b))

    difference (a, b) = Naturals::show (Naturals::sub (nat a, nat b))

    product (a, b) = shown (Naturals::multiply (nat a, nat b))

    orderOf (a, b) = Naturals::compare (nat a, nat b)

    same (a, b) = Naturals::equal (nat a, nat b)

    atMost (a, b) = Naturals::le (nat a, nat b)

    (** `text` as an int, or `-1` where it does not fit one. *)
    asInt (text) = Naturals::toInt (nat text) ?: -1

    (** Every ordered pair of the grid, `(a + b) - b == a` and
        `a - (a + b) == 0`, counted. *)
    laws (grid) = foldList (grid, 0, \(count, a) => foldList (grid, count, \(inner, b) => satAdd inner (lawHolds (a, b))))

    lawHolds (a, b) = match Naturals::equal (Naturals::sub (Naturals::add (nat a, nat b), nat b), nat a) && Naturals::isZero (Naturals::sub (nat a, Naturals::add (nat a, nat b))) && Naturals::equal (Naturals::add (nat a, nat b), Naturals::add (nat b, nat a))
        true => 1
        false => 0

    grid () = ["0", "1", "2", "999999999", "1000000000", "1000000001", "9223372036854775807", twoToTheSixtyFour, tenToThirtyPlusSeven, twoToTheTwoHundred, tenToTwentySevenMinusOne, "123456789012345678901234567890123456789012345678901234567890"]

    (** Every case, grouped so each group stays under twenty lines. *)
    export run () =
        spellings ()
        refusals ()
        sums ()
        successors ()
        order ()
        products ()

    (** The multiplication cases: exact products past the machine range, and malformed operands refused. *)
    export products () =
        test ("multiply handles zero, one and small exact products", \() => expectAll [product ("0", twoToTheSixtyFour) == "0", product (twoToTheSixtyFour, "0") == "0", product ("1", twoToTheSixtyFour) == twoToTheSixtyFour, product ("123", "456") == "56088", product ("456", "123") == "56088"])
        test ("multiply carries exactly beyond the machine integer range", \() => expectAll [product ("999999999", "999999999") == "999999998000000001", product ("4294967296", "4294967296") == twoToTheSixtyFour, product ("12345678901234567890", "98765432109876543210") == "1219326311370217952237463801111263526900"])
        test ("multiply rejects malformed limbs before word multiplication", \() => expectAll [shown (Naturals::multiply (Natural(naturalLimbs = [0]), Naturals::one ())) == "error: invalid natural multiplication operand", shown (Naturals::multiply (Naturals::one (), Natural(naturalLimbs = [1000000000]))) == "error: invalid natural multiplication operand"])

    spellings () =
        test ("parse and show round-trip every spelling, across limb borders", \() =>
            forEachList (["0", "1", "999999999", "1000000000", "1000000001", "1000000010000000000", "1123456789", "100000000000000000000", twoToTheTwoHundred], \text => expect (shown (Naturals::parse text), text))
            expect (Naturals::isZero (nat "0"), true)
            expect (Naturals::isZero (nat "1000000000"), false))

    refusals () =
        test ("parse refuses every spelling lean4export does not write", \() => forEachList (["", "-1", "+1", "01", "00", " 1", "1 ", "1.0", "1e3", "abc", "１"], \text => expect (shown (Naturals::parse text), "error: not a natural literal: \"${text}\"")))

    sums () =
        test ("add carries across limbs exactly", \() =>
            expect (sum ("0", "0"), "0")
            expect (sum ("999999999", "1"), "1000000000")
            expect (sum (tenToTwentySevenMinusOne, "1"), "1000000000000000000000000000")
            // 2**200 + (10**30 + 7)
            expect (sum (twoToTheTwoHundred, tenToThirtyPlusSeven), "1606938044258990275541962092342162602522202993782792835301383")
            expect (sum (tenToThirtyPlusSeven, twoToTheTwoHundred), "1606938044258990275541962092342162602522202993782792835301383"))

        test ("sub borrows across limbs and truncates at zero", \() =>
            expect (difference ("1000000000", "1"), "999999999")
            expect (difference ("1000000000000000000000000000", "1"), tenToTwentySevenMinusOne)
            // 2**200 - (10**30 + 7)
            expect (difference (twoToTheTwoHundred, tenToThirtyPlusSeven), "1606938044258990275541962092340162602522202993782792835301369")
            expect (difference ("1", "2"), "0")
            expect (difference ("999999999", "1000000000"), "0")
            expect (difference ("5", "5"), "0")
            expect (difference ("0", "0"), "0"))

    successors () =
        test ("succ and predecessor are inverse, and zero has no predecessor", \() => expectAll [Naturals::show (Naturals::succ (nat tenToEighteenMinusOne)) == tenToEighteen, shown (Naturals::predecessor (nat tenToEighteen)) == tenToEighteenMinusOne, shown (Naturals::predecessor (nat "1")) == "0", shown (Naturals::predecessor (nat "0")) == "error: 0 is not a successor", Naturals::isZero (Naturals::one ()) == false])

        test ("ofInt and toInt convert exactly where an int fits, and refuse elsewhere", \() => expectAll [shown (Naturals::ofInt 0) == "0", shown (Naturals::ofInt 1000000000) == "1000000000", shown (Naturals::ofInt 9223372036854775807) == "9223372036854775807", shown (Naturals::ofInt (-1)) == "error: -1 is negative", asInt (tenToEighteenMinusOne) == 999999999999999999, asInt ("0") == 0, asInt (tenToEighteen) == -1])

    order () =
        test ("compare, equal and le order by value, not spelling length of a limb", \() => expectAll [orderOf ("999999999", "1000000000") == -1, orderOf ("1000000000", "999999999") == 1, orderOf ("1000000001", "1000000002") == -1, orderOf ("2000000001", "1000000002") == 1, orderOf ("0", "0") == 0, same (twoToTheSixtyFour, twoToTheSixtyFour) == true, same (twoToTheSixtyFour, "18446744073709551617") == false, atMost ("3", "3") == true, atMost ("4", "3") == false, atMost ("0", "123456789012345678901234567890") == true])

        test ("add and sub laws hold over every ordered pair of a 12-value grid", \() =>
            expect (laws (grid ()), 144))
