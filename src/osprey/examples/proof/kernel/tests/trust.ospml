namespace prooftests

import proof::Terms
import proof::Environment
import proof::Checked
import proof::Inductive
import proof::Infer
import proof::Trust
import proof::Fixtures
import proof::Naturals
import proof
    Zero
    Succ
    Sort
    Const
    App
    Lam
    Pi
    BVar
    Let
    Proj
    NatLit
    Decl
    Axiom
    Definition
    Theorem
    Opaque

(** Assumptions are reported per root ([PROOF-KERNEL-AXIOMS]): an axiom counts
    only when that declaration reaches it. Every positive case starts from an
    environment the kernel checked — an export through
    `Checked::exportedDeclaring`, or a declaration through `Checked::declare`
    and `Inductive::declare` — and a refused declaration fails the case before
    it can read as a pass. *)
module TrustTests
    export run () =
        adversarial ()
        reporting ()
        closure ()
        metadata ()
        traversal ()
        batch ()
        test ("a deep checked dependency chain keeps graph depth off the WASM stack", \() => expect (shown (deepEnv (), "root"), "ok: Ax"))

    export adversarial () =
        test ("an assumption named none cannot forge the empty ledger", \() => expect (shown (namedAssumption "none", "root"), "ok: \"none\""))
        test ("one comma-bearing assumption cannot forge two ledger entries", \() => expect (shown (namedAssumption "Ax, Other", "root"), "ok: \"Ax, Other\""))
        test ("ledger quotes are escaped and ordinary receipt controls stay unchanged", \() => expectAll [shown (namedAssumption "\"quoted\"", "root") == "ok: \"\\\"quoted\\\"\"", listed [] == "none", listed ["Ax", "Other"] == "Ax, Other"])

    namedAssumption name = theorem (axiomAt (Environment::empty (), name), "root", arrow name, identity name)

    reporting () =
        test ("an unused axiom in the checked file is not a dependency of the theorem", \() => expectAll [shown (idImpEnv (), "id_imp") == "ok: none", shown (idImpEnv (), "unusedAssumption") == "ok: unusedAssumption"])

        test ("an axiom the proof genuinely uses is reported", \() => expect (shown (usesAxiomEnv (), "usesAx"), "ok: Ax"))

        test ("two roots in one file report their own axioms", \() => expectAll [shown (twoRootsEnv (), "rootA") == "ok: Ax, AxProof", shown (twoRootsEnv (), "rootB") == "ok: Other, OtherProof", shown (twoRootsEnv (), "AxProof") == "ok: Ax, AxProof"])

    closure () =
        test ("a dependency reached through a definition and an opaque is reported", \() => expectAll [shown (transitiveEnv (), "viaDef") == "ok: Ax", shown (transitiveEnv (), "viaOpaque") == "ok: Ax"])

        test ("an axiom only in a declaration's type is reported", \() => expectAll [shown (hiddenTypeEnv (), "hidden") == "ok: Ax", shown (hiddenTypeEnv (), "Constant") == "ok: none"])

        test ("a dependency the environment cannot resolve is an explicit error", \() => expectAll [shown (unresolvedEnv (), "broken") == "error: unknown dependency `missing`", shown (unresolvedEnv (), "picks") == "error: unknown dependency `Absent`", shown (unresolvedEnv (), "two") == "error: unknown dependency `Nat`"])

        test ("cyclic dependencies terminate, with and without an axiom", \() => expectAll [shown (cyclicEnv (), "selfLoop") == "ok: none", shown (cyclicEnv (), "loopA") == "ok: none", shown (cyclicEnv (), "loopy") == "ok: cycAxiom"])

    metadata () =
        test ("constructor and recursor metadata retain assumptions in a field type", \() => expectAll [shown (holderEnv (), "Holder") == "ok: Ax", shown (holderEnv (), "Holder.mk") == "ok: Ax", shown (holderEnv (), "Holder.rec") == "ok: Ax"])

        test ("a checked inductive block carries no axioms of its own", \() => expectAll [shown (andEnv (), "And") == "ok: none", shown (andEnv (), "And.intro") == "ok: none", shown (andEnv (), "And.rec") == "ok: none", shown (andEnv (), "and_swap") == "ok: none"])

        test ("a recorded arithmetic proof reaches projections and literals without axioms", \() => expectAll [shown (natEnv (), "Nat.add_comm") == "ok: none", shown (natEnv (), "OfNat.ofNat") == "ok: none"])

    batch () =
        batchRepresentatives ()
        batchBoundaries ()
        batchCycles ()
        batchMetadata ()

    batchRepresentatives () =
        test ("the all-root query agrees with the single-root oracle throughout representative inventories", \() => expectAll [agrees (idImpEnv ()) == "ok", agrees (usesAxiomEnv ()) == "ok", agrees (twoRootsEnv ()) == "ok", agrees (transitiveEnv ()) == "ok", agrees (hiddenTypeEnv ()) == "ok", agrees (holderEnv ()) == "ok", agrees (cyclicEnv ()) == "ok"])

    batchBoundaries () =
        test ("empty and axiom-free inventories have an entry for every declaration and no invented assumptions", \() => expectAll [batchCount (Environment::empty ()) == "ok: 0", agrees (Environment::empty ()) == "ok", agrees (andEnv ()) == "ok", batchAt (andEnv (), "and_swap") == "ok: none"])

        test ("the all-root query does not leak an unused axiom into another root", \() => expectAll [batchAt (idImpEnv (), "id_imp") == "ok: none", batchAt (idImpEnv (), "unusedAssumption") == "ok: unusedAssumption"])

    batchCycles () =
        test ("two cyclic groups each converge on their own complete axiom union", \() => expectAll [agrees (cyclicGroupsEnv ()) == "ok", batchAt (cyclicGroupsEnv (), "cycleA1") == "ok: AxA", batchAt (cyclicGroupsEnv (), "cycleA2") == "ok: AxA", batchAt (cyclicGroupsEnv (), "cycleB1") == "ok: AxB", batchAt (cyclicGroupsEnv (), "cycleB2") == "ok: AxB"])

        test ("both members of one cycle retain distinct axioms introduced on either side", \() => expectAll [agrees (dualCycleEnv ()) == "ok", batchAt (dualCycleEnv (), "cycleA1") == "ok: AxA, AxB", batchAt (dualCycleEnv (), "cycleA2") == "ok: AxA, AxB"])

        test ("the all-root query rejects every unresolved reference explicitly", \() => expect (batchError (unresolvedEnv ()), "unknown dependency `missing`"))

    batchMetadata () =
        test ("self-recursors, projections, literals and quotients follow the oracle's references", \() => expectAll [agrees (natEnv ()) == "ok", agrees (quotientEnv ()) == "ok", batchAt (quotientEnv (), "QuotientCases.sound") == "ok: Quot.sound"])

        test ("the all-root query keeps deep dependency traversal iterative", \() => expectAll [agrees (deepEnv ()) == "ok", batchAt (deepEnv (), "root") == "ok: Ax"])

    traversal () =
        test ("constants reports every term variant's symbols in traversal order", \() => expectAll [listed (Terms::constants (Sort Zero)) == "none", listed (Terms::constants (BVar 0)) == "none", listed (Terms::constants (Const "c" [Zero])) == "c", listed (Terms::constants (App (Const "f" []) (Const "a" []))) == "f, a", listed (Terms::constants (Lam "x" (Const "d" []) (Const "b" []))) == "d, b", listed (Terms::constants (Pi "x" (Const "d" []) (Const "b" []))) == "d, b", listed (Terms::constants (Let "x" (Const "t" []) (Const "v" []) (Const "u" []))) == "t, v, u", listed (Terms::constants (Proj "Family" 0 (Const "target" []))) == "Family, target", listed (Terms::constants (NatLit (literal "2"))) == "Nat, Nat.zero, Nat.succ", listed (Terms::constants (App (Const "c" []) (Const "c" []))) == "c, c"])

    (** The recorded `id_imp` export plus one axiom the theorem never touches:
        the shape whose old report was `axioms: unusedAssumption`. *)
    idImpEnv () = exported (unusedAxiomExport (), "id_imp")

    unusedAxiomExport () = "${Fixtures::idImp ()}{\"in\":16,\"str\":{\"pre\":0,\"str\":\"unusedAssumption\"}}\n{\"axiom\":{\"isUnsafe\":false,\"levelParams\":[],\"name\":16,\"type\":0}}\n"

    usesAxiomEnv () = theorem (axiomAt (Environment::empty (), "Ax"), "usesAx", arrow "Ax", identity "Ax")

    (** Two roots that share a file and share nothing else: `AxProof` rests on
        `Ax` through its own statement, and `rootA` rests on `AxProof`. *)
    twoRootsEnv () = otherRoot (axiomRoot ())

    axiomRoot () = rootA (axiomProof (axiomAt (Environment::empty (), "Ax")))

    axiomProof (env) = assumedAt (env, "AxProof", Const "Ax" [])

    rootA (env) = theorem (env, "rootA", Const "Ax" [], Const "AxProof" [])

    otherRoot (env) = rootB (otherProof (axiomAt (env, "Other")))

    otherProof (env) = assumedAt (env, "OtherProof", Const "Other" [])

    rootB (env) = theorem (env, "rootB", Const "Other" [], Const "OtherProof" [])

    transitiveEnv () = opaqueBridge (definitionBridge (axiomAt (Environment::empty (), "Ax")))

    definitionBridge (env) = definition (env, "bridge", arrow "Ax", identity "Ax")

    opaqueBridge (env) = viaOpaque (opaqueAt (env, "bridgeOpaque", arrow "Ax", identity "Ax"))

    viaOpaque (env) = definedVia (theorem (env, "viaOpaque", arrow "Ax", Const "bridgeOpaque" []))

    definedVia (env) = theorem (env, "viaDef", arrow "Ax", Const "bridge" [])

    (** `Triv` is a `Prop` family, `Constant` ignores its argument and returns
        it, so `hidden : Constant Ax` is proved by `Triv.mk`: the axiom appears
        in the root's statement and nowhere in its proof term. *)
    hiddenTypeEnv () = hidden (constantAlias (trivial (axiomAt (Environment::empty (), "Ax"))))

    trivial (env) = verified ("the trivial family checks", Inductive::declare (env, Decl(name = "Triv", params = [], ty = Sort Zero, body = Axiom), [Decl(name = "Triv.mk", params = [], ty = Const "Triv" [], body = Axiom)], 0))

    constantAlias (env) = definition (env, "Constant", Pi "p" (Sort Zero) (Sort Zero), Lam "p" (Sort Zero) (Const "Triv" []))

    holderEnv () = holder (axiomAt (Environment::empty (), "Ax"))

    holder env = verified ("the field-bearing family checks", Inductive::declare (env, Decl(name = "Holder", params = [], ty = Sort (Succ Zero), body = Axiom), [Decl(name = "Holder.mk", params = [], ty = Pi "proof" (Const "Ax" []) (Const "Holder" []), body = Axiom)], 0))

    hidden (env) = theorem (env, "hidden", App (Const "Constant" []) (Const "Ax" []), Const "Triv.mk" [])

    deepEnv () = deepRoot (foldList (toList (range (0, 1200)), axiomAt (Environment::empty (), "Ax"), \(env, index) => definition (env, "link${index}", arrow "Ax", preceding index)))

    preceding index = match index == 0
        true => identity "Ax"
        false => Const "link${satSub index 1}" []

    deepRoot env = theorem (env, "root", arrow "Ax", Const "link1199" [])

    (** Declarations the kernel would reject, added by `Environment::add` so
        the traversal itself is observable: each case expects the explicit
        unresolved-dependency error, never a pass. *)
    unresolvedEnv () = literalRoot (familyRoot (attached (Environment::empty (), "broken", Theorem (Const "missing" []))))

    familyRoot (env) = attached (env, "picks", Theorem (Proj "Absent" 0 (Const "x" [])))

    literalRoot (env) = attached (env, "two", Theorem (NatLit (literal "2")))

    // Synthetic reference graphs test traversal, not proof acceptance.
    dualCycleEnv () = attached (cycleA1 (twoCycleAxioms ()), "cycleA2", Definition (App (Const "cycleA1" []) (Const "AxB" [])))

    cyclicGroupsEnv () = cycleB2 (cycleB1 (cycleA2 (cycleA1 (twoCycleAxioms ()))))

    twoCycleAxioms () = axiomAt (axiomAt (Environment::empty (), "AxA"), "AxB")

    cycleA1 (env) = attached (env, "cycleA1", Definition (App (Const "cycleA2" []) (Const "AxA" [])))

    cycleA2 (env) = attached (env, "cycleA2", Definition (Const "cycleA1" []))

    cycleB1 (env) = attached (env, "cycleB1", Definition (App (Const "cycleB2" []) (Const "AxB" [])))

    cycleB2 (env) = attached (env, "cycleB2", Definition (Const "cycleB1" []))

    cyclicEnv () = axiomLoop (pairLoop (selfLoop (Environment::empty ())))

    selfLoop (env) = attached (env, "selfLoop", Definition (App (Const "selfLoop" []) (Const "selfLoop" [])))

    pairLoop (env) = loopB (attached (env, "loopA", Definition (Const "loopB" [])))

    loopB (env) = attached (env, "loopB", Definition (Const "loopA" []))

    axiomLoop (env) = loopy (attached (env, "cycAxiom", Axiom))

    loopy (env) = attached (env, "loopy", Definition (App (Const "loopA" []) (Const "cycAxiom" [])))

    andEnv () = exported (Fixtures::andSwap (), "and_swap")

    natEnv () = exported (Fixtures::natAddComm (), "Nat.add_comm")

    quotientEnv () = exported (Fixtures::quotients (), "QuotientCases.sound")

    exported (text, name) = verified ("the export checks", Checked::exportedDeclaring (Environment::empty (), text, name))

    (** The declarations the kernel checks itself. A statement or value it
        refuses fails the case through `refused`, never through a fallback. *)
    theorem (env, name, ty, value) = verified ("`${name}` checks", Checked::theorem (env, name, ty, value))

    definition (env, name, ty, value) = proved (env, name, ty, value, Definition value)

    opaqueAt (env, name, ty, value) = proved (env, name, ty, value, Opaque value)

    proved (env, name, ty, value, body) = match Infer::check (env, [], value, ty)
        Success _ => stated (env, name, ty, body)
        Error message => refused (name, message)

    axiomAt (env, name) = assumedAt (env, name, Sort Zero)

    assumedAt (env, name, ty) = stated (env, name, ty, Axiom)

    stated (env, name, ty, body) = match Infer::sort (env, [], ty)
        Success _ => verified ("`${name}` is declared", Checked::declare (env, Decl(name = name, params = [], ty = ty, body = body)))
        Error message => refused (name, message)

    refused (name, message) =
        check "`${name}` checks" "success" message
        Environment::empty ()

    attached (env, name, body) = verified ("`${name}` is added", Environment::add (env, Decl(name = name, params = [], ty = Sort Zero, body = body)))

    verified (label, outcome) = Support::verified (label, "success", Environment::empty (), outcome)

    arrow (name) = Pi "h" (Const name []) (Const name [])

    identity (name) = Lam "h" (Const name []) (BVar 0)

    literal (text) = Support::verified ("the literal reads", "success", Naturals::zero (), Naturals::parse text)

    agrees (env) = match Trust::allAxioms env
        Error message => "error: ${message}"
        Success all => match foldList (env.order, "", \(differences, name) => difference (env, all, name, differences))
            "" => "ok"
            differences => differences

    difference (env, all, name, differences) = match mapGet (all, name)
        Error message => "${differences}${name}: ${message};"
        Success actual => match Trust::axioms (env, name)
            Error message => "${differences}${name}: ${message};"
            Success expected => match structuralEquals (expected, actual)
                true => differences
                false => "${differences}${name}: ${listed expected} != ${listed actual};"

    batchCount (env) = match Trust::allAxioms env
        Success all => "ok: ${toString (listLength (mapValues all))}"
        Error message => "error: ${message}"

    batchAt (env, name) = match Trust::allAxioms env
        Error message => "error: ${message}"
        Success all => match mapGet (all, name)
            Success names => "ok: ${listed names}"
            Error message => "error: ${message}"

    batchError (env) = match Trust::allAxioms env
        Success _ => "unexpected success"
        Error message => message

    shown (env, name) = match Trust::described (Trust::axioms (env, name))
        Success text => "ok: ${text}"
        Error message => "error: ${message}"

    listed (names) = match Trust::described (Success(value = names))
        Success text => text
        Error message => "error: ${message}"
