namespace prooftests

import proof::Levels
import proof::Terms
import proof::Environment
import proof::Reduce
import proof::Infer
import proof::Inductive
import proof
    Zero Succ Max IMax Param Sort BVar Const App Lam Pi Decl Axiom Definition Theorem

(** Builders and renderings the kernel cases share. Every helper that can
    fail reports the failure through a soft assertion or an `error:` string,
    so a broken kernel can never read as a pass. *)
module Support
    (** `name` applied to the innermost bound variable. *)
    export applied (name) = App (Const name []) (BVar 0)

    (** The refusal `Infer::infer` gives `term` under `env` and `context`. *)
    export inferMessage (env, context, term) = messageOf (Infer::infer (env, context, term))

    (** `fun (x : Prop) => x`. *)
    export selfLam () = Lam "x" (Sort Zero) (BVar 0)

    (** `fun (x : Prop) => #1`: an identity lambda under one more binder. *)
    export selfLamOuter () = Lam "x" (Sort Zero) (BVar 1)

    (** `∀ (x : Prop), x`. *)
    export selfPi () = Pi "x" (Sort Zero) (BVar 0)

    (** The level `max u v`. *)
    export maxUV () = Max (Param "u") (Param "v")

    (** The level `imax u v`. *)
    export imaxUV () = IMax (Param "u") (Param "v")

    (** The level `max u 1`. *)
    export maxUOne () = Max (Param "u") (Succ Zero)

    (** The level `imax u 1`. *)
    export imaxUOne () = IMax (Param "u") (Succ Zero)

    (** The level `imax u 0`. *)
    export imaxUZero () = IMax (Param "u") Zero

    (** A declaration of `name` with the given body. *)
    export decl (name, body) = Decl(name = name, params = [], ty = Sort Zero, body = body)

    (** A declaration of `name` under the universe parameters `params`. *)
    export declWith (name, params, ty, body) = Decl(name = name, params = params, ty = ty, body = body)

    (** A declaration of `name`, typed `ty`, whose body is an axiom. *)
    export axiomOf (name, ty) = declWith (name, [], ty, Axiom)

    (** An environment holding `decl`; a rejected add fails the enclosing case
        before falling back. *)
    export envWithDecl decl = match Environment::add (Environment::empty (), decl)
        Success env => env
        Error message =>
            check "the environment accepts the declaration" "no error" message
            Environment::empty ()

    (** An environment holding `c` with the given body. *)
    export envWith body = envWithDecl (decl ("c", body))

    (** The `Hidden` Prop family: one constructor of one data field, declared
        with `indices` indices. *)
    export hiddenIn (env, indices) = Inductive::declare (env, axiomOf ("Hidden", Pi "A" (Sort (Succ Zero)) (Sort Zero)), [axiomOf ("Hidden.mk", Pi "A" (Sort (Succ Zero)) (Pi "w" (BVar 0) (App (Const "Hidden" []) (BVar 1))))], indices)

    (** The `Packed` dependent family: `Packed : Type 1` with one constructor
        of two fields, the second of them in the first's type. *)
    export packedIn (env) = Inductive::declare (env, axiomOf ("Packed", Sort (Succ (Succ Zero))), [axiomOf ("Packed.mk", Pi "A" (Sort (Succ Zero)) (Pi "x" (BVar 0) (Const "Packed" [])))], 0)

    (** The payload of a checked outcome; a failure fails the enclosing case
        with `expected` before falling back to `fallback`. *)
    export verified (label, expected, fallback, outcome) = match outcome
        Success value => value
        Error message =>
            check label expected message
            fallback

    (** A fixture that must check: a failure fails the enclosing case with
        `label`, so no case reads a broken fixture as a pass. *)
    export fixture (label, outcome) = verified (label, "success", Environment::empty (), outcome)

    (** Two attempts to declare `name` in a fresh environment. *)
    export twice name = match Environment::add (Environment::empty (), decl (name, Axiom))
        Success env => Environment::add (env, decl (name, Axiom))
        Error message => Error(message = message)

    (** The error text of a result, or an obvious marker. *)
    export messageOf result = match result
        Success _ => "unexpected success"
        Error message => message

    (** A term with binder names and free variables rendered. *)
    export render term = Terms::show (term, [])

    (** The weak head normal form of `term` under `env`, rendered. *)
    export whnfOf (env, term) = render (Reduce::whnf (env, term))

    (** Definitional equality under `env`. *)
    export defeqOf (env, left, right) = Reduce::defeq (env, left, right)

    (** The inferred type of `term`, rendered. *)
    export inferred (env, context, term) = match Infer::infer (env, context, term)
        Success ty => render ty
        Error message => "error: ${message}"

    (** A successful check rendered as `ok: <expected>`. *)
    export checked (env, term, expected) = match Infer::check (env, [], term, expected)
        Success ty => "ok: ${render ty}"
        Error message => "error: ${message}"

    (** The universe level of a type, rendered. *)
    export sorted (env, context, term) = match Infer::sort (env, context, term)
        Success level => Levels::show level
        Error message => "error: ${message}"

    (** Whether `env` declares `name`. *)
    export declares (env, name) = match Environment::find (env, name)
        Success _ => true
        Error _ => false

    (** What `name` unfolds to under `env`, rendered. *)
    export unfolded (env, name) = match Environment::unfold (env, name, [])
        Success value => render value
        Error message => "error: ${message}"
