namespace prooftests

import proof::Levels
import prooftests::Support
import proof
    Zero Succ Max IMax Param

(** Normalisation, equality and printing of universe levels. *)
module LevelsTests
    one () = Succ Zero

    export run () =
        test ("imax one u equals u for zero and positive universe assignments", \() => expectAll [Levels::equal (IMax (one ()) (Param "u")) (Param "u") == true, Levels::equal (IMax Zero (Param "u")) (Param "u") == true, Levels::equal (IMax (Succ (one ())) (Param "u")) (Param "u") == false])

        test ("open successor maxima preserve the exact universe of imported stack proofs", \() => expectAll [Levels::equal (IMax (one ()) (Succ (Param "u"))) (Succ (Param "u")) == true, Levels::equal (Max (Succ (Param "u")) (Succ (Param "v"))) (Succ (Support::maxUV ())) == true, Levels::equal (Max (Max (one ()) (Param "v")) (Max (Succ (Param "u")) (Param "v"))) (Max (Succ (Param "u")) (Param "v")) == true, Levels::equal (IMax (Param "u") (Support::imaxUOne ())) (Max (one ()) (Param "u")) == true, Levels::equal (Support::maxUV ()) (Max (Param "v") (Param "u")) == true, Levels::equal (Support::imaxUV ()) (Support::maxUV ()) == false, Levels::equal (Max (one ()) (Param "u")) (Param "u") == false, Levels::equal (IMax (one ()) (Param "u")) (one ()) == false])

        test ("geq holds where every assignment agrees", \() => expectAll [Levels::geq (one ()) Zero == true, Levels::geq (Param "u") Zero == true, Levels::geq (Param "u") (Param "u") == true, Levels::geq (Succ (Param "u")) (Param "u") == true, Levels::geq (Succ (Param "u")) (Succ (Param "u")) == true, Levels::geq (Succ (Succ Zero)) (one ()) == true, Levels::geq (Support::maxUV ()) (Param "v") == true, Levels::geq (Support::maxUV ()) (Support::maxUV ()) == true, Levels::geq (Succ (Support::maxUV ())) (Succ (Param "u")) == true, Levels::geq (Support::maxUV ()) (Support::imaxUV ()) == true, Levels::geq (Support::imaxUV ()) (Param "v") == true, Levels::geq (Support::maxUOne ()) (one ()) == true])

        test ("geq refuses wherever some assignment disagrees", \() => expectAll [Levels::geq Zero (one ()) == false, Levels::geq (Param "u") (one ()) == false, Levels::geq Zero (Param "u") == false, Levels::geq (Param "u") (Param "v") == false, Levels::geq (Param "u") (Succ (Param "u")) == false, Levels::geq (one ()) (Succ (Succ Zero)) == false, Levels::geq (Param "u") (Support::maxUV ()) == false, Levels::geq (Support::imaxUV ()) (Param "u") == false, Levels::geq (Succ (Param "u")) (Succ (Succ (Param "u"))) == false, Levels::geq (Support::maxUOne ()) (Param "v") == false])

        test ("isNotZero and isZero hold only where every assignment agrees", \() => expectAll [Levels::isNotZero (one ()) == true, Levels::isNotZero (Succ (Param "u")) == true, Levels::isNotZero (Support::maxUOne ()) == true, Levels::isNotZero (Support::imaxUOne ()) == true, Levels::isNotZero Zero == false, Levels::isNotZero (Param "u") == false, Levels::isNotZero (IMax (one ()) (Param "u")) == false, Levels::isZero Zero == true, Levels::isZero (Support::imaxUZero ()) == true, Levels::isZero (Max Zero Zero) == true, Levels::isZero (Param "u") == false, Levels::isZero (one ()) == false])

        test ("normal collapses max 1 0 to 1", \() =>
            expect (Levels::show (Levels::normal (Max (one ()) Zero)), "1"))

        test ("imax u 0 is zero", \() => expectAll [Levels::show (Levels::normal (Support::imaxUZero ())) == "0", Levels::height (Support::imaxUZero ()) == 0, Levels::equal (Support::imaxUZero ()) Zero == true])

        test ("show prints 0, 1 and an open max", \() => expectAll [Levels::show Zero == "0", Levels::show (one ()) == "1", Levels::show (Support::maxUV ()) == "max u v"])

        test ("closed rejects a parameter", \() => expectAll [Levels::closed (Param "u") == false, Levels::closed (Max (one ()) Zero) == true])

        test ("equal compares levels by normal form", \() => expectAll [Levels::equal (Max Zero Zero) Zero == true, Levels::equal (one ()) (Succ (Max Zero Zero)) == true, Levels::equal (one ()) Zero == false])

        test ("equal is structural on normal forms, not a comparison of prints", \() => expectAll [Levels::equal (Param "u") (Param "v") == false, Levels::equal (Max (Param "u") (Param "u")) (Param "u") == true, Levels::equal (Support::imaxUZero ()) Zero == true, Levels::equal (Support::imaxUOne ()) (Support::maxUOne ()) == true, Levels::equal (Max Zero (Param "u")) (Param "u") == true])

        test ("instantiate replaces the named parameters by position", \() => expectAll [Levels::show (Levels::instantiate (Support::maxUV (), ["u", "v"], [one (), Zero])) == "1", Levels::show (Levels::instantiate (Succ (Param "v"), ["u"], [Zero])) == "v+1", Levels::declared (Support::maxUV (), ["u"]) == false, Levels::declared (Support::maxUV (), ["v", "u"]) == true])
