namespace prooftests

import proof::Export
import proof::Environment
import proof::Fixtures
import proof::Terms
import proof
    Single Group Decl Block Axiom TypeFormer Constructor Recursor Family Eliminator Sort Zero
import prooftests::Support

(** Reading the `inductive` line of `lean4export` NDJSON 3.1.0
    ([PROOF-EXPORT]): the recorded `AndSwap` export reads as nine items in
    file order, each inductive block's every claimed field is asserted
    against the line it came from, and a whole mutual or nested group
    reads as one block carrying every family, recursor, motive count and
    inventory it declares. The kernel's derivation and comparison of
    those claims is `Inductive::add`'s business, so nothing here checks
    the theory; the reader itself refuses an unsafe declaration, a group
    with no family or no recursor, and any member the format does not
    define. *)
module ExportInductiveTests

    (** Runs the inductive-block cases; the testing built-ins report the TAP lines. *)
    export run () =
        test ("the recorded export reads as nine items in file order", \() => expect (sequence (items ()), "group Eq | single Eq.recOn | single eq_symm | group Iff | single Iff.recOn | group And | single iff_refl | single and_swap | single And.recOn"))

        test ("the And block states its family, constructor and recursor in full", \() => expect (blockShape (thirdBlock ()), "And [] (Prop → (Prop → Prop)) {params 2, indices 0, ctors [And.intro], recursive false, reflexive false, all [And], nested 0} | And.intro [] (∀ (a : Prop), (∀ (b : Prop), (a → (b → ((And a) b))))) {family And, index 0, params 2, fields 2} | And.rec [u] (∀ (a : Prop), (∀ (b : Prop), (∀ (motive : (((And a) b) → Sort u)), ((∀ (left : a), (∀ (right : b), (motive ((((And.intro a) b) left) right)))) → (∀ (t : ((And a) b)), (motive t)))))) {family And, params 2, indices 0, minors 1, k false, rules [And.intro/2 => (fun (a : Prop) => (fun (b : Prop) => (fun (motive : (((And a) b) → Sort u)) => (fun (intro : (∀ (left : a), (∀ (right : b), (motive ((((And.intro a) b) left) right))))) => (fun (left : a) => (fun (right : b) => ((intro left) right)))))))], motives 1, all [And]}"))

        test ("the And block's constructor counts its fields without the parameters", \() => expect (ctorFacts (thirdBlock ()), "And.intro family And index 0 params 2 fields 2"))

        test ("the Eq eliminator supports K over one index, at two universe parameters", \() => expect (elimFacts (firstBlock ()), "Eq [u_1, u] indices 1 minors 1 k true rules [Eq.refl/0] motives 1 all [Eq]"))

        test ("the Iff eliminator supports no K and one rule of two fields", \() => expect (elimFacts (secondBlock ()), "Iff [u] indices 0 minors 1 k false rules [Iff.intro/2] motives 1 all [Iff]"))

        test ("the Eq block's member names and statements are the line's", \() => expect (memberNames (firstBlock ()), "Eq [u] | Eq.refl [u] | Eq.rec [u_1, u]"))

        test ("a mutual group's line reads as one block of every family it declares", \() => expect (groupShape (twice ("\"types\":[", eqType ())), "families 2, recursors 1"))

        test ("a group's every recursor reads into the same block", \() => expect (groupShape (twice ("\"recs\":[", eqRec ())), "families 1, recursors 2"))

        mutation ("a nested family's count is a claim the block carries", nestedClaim, eqType (), "\"numNested\":0", "\"numNested\":1", "nested 1")

        oneMoreAll ("a type's all is the inventory it claims", familyAllClaim, eqType ())

        oneMoreAll ("a recursor's all is the inventory it claims", recAllClaim, eqRec ())

        mutation ("a recursor's motive count is a claim the block carries", motivesClaim, eqRec (), "\"numMotives\":1", "\"numMotives\":2", "motives 2")

        refuseUnsafe ("an unsafe type former is refused", eqType ())

        refuseUnsafe ("an unsafe constructor is refused", eqCtor ())

        refuseUnsafe ("an unsafe recursor is refused", eqRec ())

        mutation ("a constructor without numParams names the missing member", refused, eqCtor (), "\"numParams\":2,", "", "line 60: no numParams")

        mutation ("a member of the wrong type names itself", refused, eqCtor (), "\"numFields\":0", "\"numFields\":\"0\"", "line 60: numFields is not an integer")

        mutation ("a boolean member of the wrong type names itself", refused, eqType (), "\"isRec\":false", "\"isRec\":0", "line 60: isRec is not a boolean")

        mutation ("the K flag of the wrong type names itself", refused, eqRec (), "\"k\":true", "\"k\":1", "line 60: k is not a boolean")

        mutation ("an unknown member on a type is refused, not dropped", refused, eqType (), "\"type\":6}", "\"type\":6,\"extra\":1}", "line 60: unknown type member `extra`")

        mutation ("an unknown member on a constructor is refused", refused, eqCtor (), "\"cidx\":0,", "\"extra\":1,\"cidx\":0,", "line 60: unknown constructor member `extra`")

        swappedRefusal ("an unknown member on the group is refused", swapped ("{\"inductive\":{\"ctors\":[{\"cidx\":0,\"induct\":1", "{\"inductive\":{\"extra\":1,\"ctors\":[{\"cidx\":0,\"induct\":1"), "line 60: unknown inductive member `extra`")

        mutation ("an unknown member on a rule is refused", refused, eqRule (), "\"rhs\":41", "\"rhs\":41,\"extra\":1", "line 60: unknown rule member `extra`")

        mutation ("a rule right-hand side the file never defined names its line", refused, eqRule (), "\"rhs\":41", "\"rhs\":999", "line 60: unknown expr 999")

        mutation ("a constructor list naming an undefined name is refused", refused, eqType (), "\"ctors\":[9]", "\"ctors\":[77]", "line 60: unknown name 77")

        mutation ("a rule naming an undefined constructor is refused", refused, eqRule (), "\"ctor\":9", "\"ctor\":78", "line 60: unknown name 78")

        mutation ("a constructor naming an undefined family is refused", refused, eqCtor (), "\"induct\":1", "\"induct\":79", "line 60: unknown name 79")

        mutation ("a type's universe parameters must be names the file defined", refused, eqType (), "\"levelParams\":[2]", "\"levelParams\":[99]", "line 60: unknown name 99")

        swappedRefusal ("a group without types names the missing member", deleted ("types", eqType ()), "line 60: no types")

        swappedRefusal ("a group without recursors names the missing member", deleted ("recs", eqRec ()), "line 60: no recs")

        swappedRefusal ("a group with no type at all is refused", emptied ("types", eqType ()), "line 60: no type")

        swappedRefusal ("a group with no recursor at all is refused", emptied ("recs", eqRec ()), "line 60: no recursor")

        swappedRefusal ("an inductive line carrying a second kind is refused, not read as the first", swapped ("{\"inductive\":{\"ctors\":[", "{\"inductive\":{},\"thm\":{\"ctors\":["), "line 60: 2 members where one kind is expected")

    (** The export read, or the reader's rejection of it. *)
    items () = match Export::read (Fixtures::andSwap ())
        Success items => items
        Error message =>
            check "the recorded export reads" "no error" message
            []

    refused (text) = Support::messageOf (Export::read text)


    (** The case `name`: `reader` of the recorded export with `old` replaced by `new` in the `kind` line reports `expected`. *)
    mutation (name, reader, kind, old, new, expected) = test (name, \() => expect (reader (recased (kind, old, new)), expected))

    (** The case `name`: the reader refuses `text` with `expected`. *)
    swappedRefusal (name, text, expected) = test (name, \() => expect (refused (text), expected))

    (** The case `name`: the reader refuses `kind` marked unsafe. *)
    refuseUnsafe (name, kind) = mutation (name, refused, kind, "\"isUnsafe\":false", "\"isUnsafe\":true", "line 60: unsupported: unsafe declaration")

    (** The case `name`: `reader` of `kind` claiming one more family in its inventory. *)
    oneMoreAll (name, reader, kind) = mutation (name, reader, kind, "\"all\":[1]", "\"all\":[1,9]", "all [Eq, Eq.refl]")

    firstBlock () = blockAt (0)

    secondBlock () = blockAt (1)

    thirdBlock () = blockAt (2)

    (** The `at`th block of the recorded export, counting only blocks. *)
    blockAt (at) = atBlock (items (), at, \block => block, missing)

    (** The `at`th block in `items` counting only blocks, given to `act`, or
        `noneOf` when the export stops short. *)
    atBlock (items, at, act, noneOf) = match items
        [] => noneOf ()
        [first, ...rest] => match first
            Single decl => atBlock (rest, at, act, noneOf)
            Group block => match at == 0
                true => act (block)
                false => atBlock (rest, satSub at 1, act, noneOf)

    (** A failed lookup fails the enclosing case before falling back. *)
    missing () =
        check "the recorded export reads as three blocks" "3" "too few"
        Block(formers = [blank ()], ctors = [], recursors = [])

    blank () = Decl(name = "", params = [], ty = Sort Zero, body = Axiom)

    blankFamily () = Family(familyParams = 0, familyIndices = 0, familyCtors = [], familyRecursive = false, familyReflexive = false, familyAll = [], familyNested = 0)

    blankElim () = Eliminator(elimFamily = "", elimAll = [], elimMotives = 0, elimParams = 0, elimIndices = 0, elimMinors = 0, elimRules = [], elimK = false)

    (** Every item's kind and name, in file order. *)
    sequence (items) = joined (mapList (items, itemKind))

    itemKind (item) = match item
        Single decl => "single ${decl.name}"
        Group block => "group ${blockName block.formers}"

    blockName (formers) = match formers
        [first, ...rest] => first.name
        [] => "?"

    (** How many families and recursors the first block of a readable
        export declares. *)
    groupShape (text) = match Export::read text
        Error message => message
        Success readItems => atBlock (readItems, 0, counted, \() => "no items")

    (** The block's family and recursor counts. *)
    counted (block) = "families ${toString (listLength block.formers)}, recursors ${toString (listLength block.recursors)}"

    (** The first declaration of the first block's `its` list in a readable
        export, or the blank when the read refuses or names no such item. *)
    claimedItem (text, its, blank) = match Export::read text
        Error message => blank
        Success readItems => atBlock (readItems, 0, \block => headDecl (its block, blank), \() => blank)

    (** The first declaration in `decls`, or the blank. *)
    headDecl (decls, blank) = listGet (decls, 0) ?: blank

    (** The first block's claimed type former, or the blank one. *)
    claimedFamily (text) = familyOf (claimedItem (text, \block => block.formers, blank ()), blankFamily ())

    (** The declaration's type former, or the blank one. *)
    familyOf (decl, blank) = match decl.body
        TypeFormer family => family
        other => blank

    (** The first block's claimed recursor, or the blank one. *)
    claimedEliminator (text) = eliminatorOf (claimedItem (text, \block => block.recursors, blank ()), blankElim ())

    (** The declaration's recursor, or the blank one. *)
    eliminatorOf (decl, blank) = match decl.body
        Recursor elim => elim
        other => blank

    nestedClaim (text) = fact ("nested", toString (claimedFamily text).familyNested)

    familyAllClaim (text) = fact ("all", listed (claimedFamily text).familyAll)

    recAllClaim (text) = fact ("all", listed (claimedEliminator text).elimAll)

    motivesClaim (text) = fact ("motives", toString (claimedEliminator text).elimMotives)

    (** A block's type formers, its constructors and its recursors, each
        with the facts the line claims about it. *)
    blockShape (block) = joined ([rendered (block.formers, formerText), rendered (block.ctors, ctorText), rendered (block.recursors, recText)])

    (** A type former's counts, constructor inventory, flags, inventory and nesting. *)
    familyFacts (family) = [fact ("params", toString family.familyParams), fact ("indices", toString family.familyIndices), fact ("ctors", listed family.familyCtors), fact ("recursive", toString family.familyRecursive), fact ("reflexive", toString family.familyReflexive), fact ("all", listed family.familyAll), fact ("nested", toString family.familyNested)]

    formerText (decl) = match decl.body
        TypeFormer family => "${declaredText decl} {${commaSeparated (familyFacts family)}}"
        other => "${declaredText decl} is not a type former"

    (** A constructor's family, index, parameter and field counts. *)
    ctorFactsOf (ctor) = [fact ("family", ctor.ctorFamily), fact ("index", toString ctor.ctorIndex), fact ("params", toString ctor.ctorParams), fact ("fields", toString ctor.ctorFields)]

    ctorText (decl) = match decl.body
        Constructor ctor => "${declaredText decl} {${commaSeparated (ctorFactsOf ctor)}}"
        other => "${declaredText decl} is not a constructor"

    (** A recursor's index, minor, K, rule, motive and inventory facts. *)
    recFacts (elim, rules) = [fact ("indices", toString elim.elimIndices), fact ("minors", toString elim.elimMinors), fact ("k", toString elim.elimK), fact ("rules", rules), fact ("motives", toString elim.elimMotives), fact ("all", listed elim.elimAll)]

    (** The recursor's family and parameter facts followed by its claimed ones. *)
    recParts (elim, rules) = listConcat ([fact ("family", elim.elimFamily), fact ("params", toString elim.elimParams)], recFacts (elim, rules))

    recText (decl) = match decl.body
        Recursor elim => "${declaredText decl} {${commaSeparated (recParts (elim, ruleTexts elim.elimRules))}}"
        other => "${declaredText decl} is not a recursor"

    (** A constant as the line gives it: its name, its universe parameters
        and its statement. *)
    declaredText (decl) = "${decl.name} ${listed decl.params} ${Terms::show (decl.ty, [])}"

    (** The one constructor's own counts, without the statement. *)
    ctorFacts (block) = folded (block.ctors, ctorFact)

    ctorFact (decl) = match decl.body
        Constructor ctor => "${decl.name} ${spaced (ctorFactsOf ctor)}"
        other => "${decl.name} is not a constructor"

    (** The one recursor's family, universe parameters and the facts it claims. *)
    elimFacts (block) = folded (block.recursors, elimFact)

    (** The recursor's bare family and universe parameters, then its claimed facts. *)
    elimParts (elim, decl, rules) = listConcat ([elim.elimFamily, listed decl.params], recFacts (elim, rules))

    elimFact (decl) = match decl.body
        Recursor elim => spaced (elimParts (elim, decl, ruleNames elim.elimRules))
        other => "${decl.name} is not a recursor"

    (** The name and universe parameters of every former and member. *)
    memberNames (block) = folded (listConcat (listConcat (block.formers, block.ctors), block.recursors), named)

    named (decl) = "${decl.name} ${listed decl.params}"

    (** A rule's constructor and field count, as `Name/N`. *)
    ruleName (rule) = "${rule.ruleCtor}/${toString rule.ruleFields}"

    ruleTexts (rules) = listed (mapList (rules, ruleText))

    ruleText (rule) = "${ruleName rule} => ${Terms::show (rule.ruleRhs, [])}"

    ruleNames (rules) = listed (mapList (rules, ruleName))

    (** A rendering of one or more parts, or of the failure that stopped it. *)
    folded (decls, part) = match decls
        [] => "no declaration"
        _ => joined (mapList (decls, part))

    (** Each declaration rendered by `part`, joined. *)
    rendered (decls, part) = joined (mapList (decls, part))

    (** `a, b` inside brackets, and `[]` for none. *)
    listed (names) = match names
        [] => "[]"
        _ => bracketed (names)

    (** The names bracketed, comma-separated. *)
    bracketed (names) = "[${commaSeparated names}]"

    (** The parts with a comma and a space between neighbours. *)
    commaSeparated (parts) = separated (parts, ", ")

    (** The parts with a space between neighbours. *)
    spaced (parts) = separated (parts, " ")

    joined (parts) = separated (parts, " | ")

    (** The parts with `sep` between neighbours. *)
    separated (parts, sep) = foldList (parts, "", \(acc, part) => "${acc}${glued (acc, sep)}${part}")

    (** `sep` once a first part exists. *)
    glued (acc, sep) = match acc == ""
        true => ""
        false => sep

    (** One claimed fact, as `label value`. *)
    fact (label, shown) = "${label} ${shown}"

    (** `object` with every occurrence of `from` replaced by `to`, or
        `fallback` when the replacement fails. *)
    replaced (object, from, to, fallback) = replace (object, from, to) ?: fallback

    (** The recorded export with every occurrence of `from` replaced by `to`,
        empty when the replacement fails. *)
    swapped (from, to) = replaced (Fixtures::andSwap (), from, to, "")

    (** `object` with every occurrence of `from` replaced by `to`, or itself
        when the replacement fails. *)
    mutated (object, from, to) = replaced (object, from, to, object)

    (** The recorded export with a second `object` appended in the list that
        `opening` introduces, so the group reads with one more member. *)
    twice (opening, object) = swapped (opening + object, opening + object + "," + object)

    (** The recorded export with `member`'s only `object` deleted from its list. *)
    deleted (member, object) = swapped (",\"${member}\":[" + object + "]", "")

    (** The recorded export with `member`'s list emptied of its `object`. *)
    emptied (member, object) = swapped ("\"${member}\":[" + object + "]", "\"${member}\":[]")

    (** The recorded export with the `Eq` object `object` replaced by the same
        object holding one edit, so each refusal is about the block it names. *)
    recased (object, from, to) = swapped (object, mutated (object, from, to))

    (** Line 60, the `Eq` group's three objects and its one rule. *)
    export eqType () = "{\"all\":[1],\"ctors\":[9],\"isRec\":false,\"isReflexive\":false,\"isUnsafe\":false,\"levelParams\":[2],\"name\":1,\"numIndices\":1,\"numNested\":0,\"numParams\":2,\"type\":6}"

    export eqCtor () = "{\"cidx\":0,\"induct\":1,\"isUnsafe\":false,\"levelParams\":[2],\"name\":9,\"numFields\":0,\"numParams\":2,\"type\":12}"

    export eqRec () = "{\"all\":[1],\"isUnsafe\":false,\"k\":true,\"levelParams\":[11,2],\"name\":10,\"numIndices\":1,\"numMinors\":1,\"numMotives\":1,\"numParams\":2,\"rules\":[" + eqRule () + "],\"type\":37}"

    export eqRule () = "{\"ctor\":9,\"nfields\":0,\"rhs\":41}"

    (** Line 173, the `Iff` group's type former. *)
    export iffType () = "{\"all\":[26],\"ctors\":[27],\"isRec\":false,\"isReflexive\":false,\"isUnsafe\":false,\"levelParams\":[],\"name\":26,\"numIndices\":0,\"numNested\":0,\"numParams\":2,\"type\":96}"
