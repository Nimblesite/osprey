namespace proof

(** A universe level of [PROOF-KERNEL-THEORY] (spec 0049). `Sort Zero` is
    `Prop`; `Sort (Succ Zero)` is `Type`. M0 needs only those two; the other
    forms are here so M1's export reader adds nothing to the theory. *)
type Level = Zero | Succ Level | Max Level Level | IMax Level Level | Param string

(** One arm of a max-plus level: `param + offset`, or the constant `offset` when `param` is `""`. *)
type LevelArm =
    param : string
    offset : int

(** Normalisation, equality, instantiation and printing of levels. *)
module Levels
    (** Whether a level mentions no parameter. *)
    export closed level = match level
        Zero => true
        Succ inner => closed inner
        Max left right => closed left && closed right
        IMax left right => closed left && closed right
        Param _name => false

    (** Whether every parameter of `level` is one of `params`. *)
    export declared (level, params) = match level
        Zero => true
        Succ inner => declared (inner, params)
        Max left right => declared (left, params) && declared (right, params)
        IMax left right => declared (left, params) && declared (right, params)
        Param name => listContains (params, name)

    (** `level` with each `Param` of `params` replaced by the argument at
        the same position; a parameter not in `params` is left alone. *)
    export instantiate (level, params, args) = match level
        Zero => Zero
        Succ inner => Succ (instantiate (inner, params, args))
        Max left right => Max (instantiate (left, params, args)) (instantiate (right, params, args))
        IMax left right => IMax (instantiate (left, params, args)) (instantiate (right, params, args))
        Param name => argument (name, params, args, level)

    argument (name, params, args, fallback) = match params
        [] => fallback
        [first, ...rest] => pick (name, first, rest, args, fallback)

    pick (name, first, rest, args, fallback) = match args
        [] => fallback
        [arg, ...more] => chosen (name == first, arg, name, rest, more, fallback)

    chosen (hit, arg, name, rest, more, fallback) = match hit
        true => arg
        false => argument (name, rest, more, fallback)

    (** The height of a closed level; a parameter counts as zero. *)
    export height level = match level
        Zero => 0
        Succ inner => satAdd (height inner) 1
        Max left right => max (height left) (height right)
        IMax left right => imaxHeight (height left) (height right)
        Param _name => 0

    imaxHeight left right = match right == 0
        true => 0
        false => max left right

    (** Normal form: a closed level collapses to `Succ^n Zero`; an open level
        keeps its parameters, with `max`/`imax` simplified where a side is
        `0` or the sides agree. Equality on this form is sound: two levels
        with the same normal form are equal under every assignment, and
        incompleteness only rejects, never accepts. *)
    export normal level = match closed level
        true => ofHeight (height level)
        false => normalOpen level

    normalOpen level = match level
        Max left right => normalMax (normal left, normal right)
        IMax left right => normalIMax (normal left, normal right)
        Succ inner => Succ (normal inner)
        other => other

    normalMax (left, right) = match atLeast left right
        true => left
        false => undominatedMax (left, right)

    undominatedMax (left, right) = match atLeast right left
        true => right
        false => normalMaxSides (left, right)

    normalMaxSides (left, right) = match left
        Zero => right
        Succ inner => normalMaxSucc (inner, right)
        other => normalMaxRight (other, right)

    (** max (u+1) (v+1) = max(u,v)+1, including imax's positive-right
        branch. Implements [PROOF-KERNEL-THEORY]. *)
    normalMaxSucc (inner, right) = match right
        Succ other => Succ (normalMax (inner, other))
        other => normalMaxRight (Succ inner, other)

    normalMaxRight (left, right) = match right
        Zero => left
        other => Max left other

    normalIMax (left, right) = match right
        Zero => Zero
        other => match atLeast (Succ Zero) left
            true => other
            false => positiveIMax (left, other)

    (** imax 0 u = imax 1 u = u: at zero both sides vanish; at a
        positive assignment u already dominates one. *)
    positiveIMax (left, right) = match isNotZero right
        true => normalMax (left, right)
        false => IMax left right

    ofHeight n = match n <= 0
        true => Zero
        false => Succ (ofHeight (satSub n 1))

    (** Equality under every assignment of the parameters, decided completely
        ([PROOF-KERNEL-THEORY]). While an `imax` may vanish on a parameter `p`,
        both `p := 0` and `p := p+1` must agree; the successor case makes that
        `imax` a `max`. Then both sides are max-plus levels, equal exactly when
        their canonical forms are. Printed names never decide equality. *)
    export equal left right = decided (left, right, 32)

    decided (left, right, budget) = split (left, right, budget, firstOf (pending left, pending right))

    split (left, right, budget, p) = match p == ""
        true => canonicalForm left == canonicalForm right
        false => budget > 0 && decided (instantiate (left, [p], [Zero]), instantiate (right, [p], [Zero]), satSub budget 1) && decided (instantiate (left, [p], [Succ (Param p)]), instantiate (right, [p], [Succ (Param p)]), satSub budget 1)

    firstOf (a, b) = match a == ""
        true => b
        false => a

    (** A parameter some `imax` of `level` may vanish on, or `""` when every
        `imax` is settled. *)
    pending level = match level
        Succ inner => pending inner
        Max a b => firstOf (pending a, pending b)
        IMax a b => firstOf (firstOf (pending a, pending b), vanishOn b)
        _ => ""

    (** A parameter `level` is zero at when it is zero, or `""` when no
        parameter decides it: `p := p+1` then removes that occurrence. *)
    vanishOn level = match level
        Param name => name
        Max a b => firstOf (vanishOn a, vanishOn b)
        IMax _ b => vanishOn b
        _ => ""

    (** The max-plus arms of a level whose every `imax` is settled: a
        parameter name (`""` for none) and the offset above it. *)
    arms level = match level
        Zero => [LevelArm(param = "", offset = 0)]
        Param name => [LevelArm(param = name, offset = 0)]
        Succ inner => mapList (arms inner, \arm => LevelArm(param = arm.param, offset = satAdd arm.offset 1))
        Max a b => listConcat (arms a, arms b)
        IMax a b => settledIMax (a, b)

    settledIMax (a, b) = match isNotZero b
        true => listConcat (arms a, arms b)
        false => [LevelArm(param = "", offset = 0)]

    (** Each parameter at its largest offset, sorted, then the constant only
        when it tops every parameter's offset: `p+k >= k` at every `p`. *)
    canonicalForm level = canonicalOf (arms level)

    canonicalOf (all) = join (listConcat (mapList (paramsIn all, \p => "${p}+${toString (largest (all, p))}"), constantPart (all)), ",")

    paramsIn (all) = listSort (foldList (all, [], \(seen, arm) => addParam (seen, arm.param)))

    addParam (seen, name) = match name == "" || listContains (seen, name)
        true => seen
        false => listAppend (seen, name)

    largest (all, p) = foldList (all, 0, \(top, arm) => maxOffset (top, arm, p))

    maxOffset (top, arm, p) = match arm.param == p && arm.offset > top
        true => arm.offset
        false => top

    constantPart (all) = constantAbove (largest (all, ""), foldList (paramsIn all, (-1), \(top, p) => max top (largest (all, p))))

    constantAbove (constant, topParam) = match constant > topParam
        true => ["${toString constant}"]
        false => []

    same left right = match left
        Zero => zeroForm right
        Succ inner => sameSucc (inner, right)
        Max a b => sameMax (a, b, right)
        IMax a b => sameIMax (a, b, right)
        Param name => sameParam (name, right)

    zeroForm level = match level
        Zero => true
        _other => false

    sameSucc (inner, right) = match right
        Succ other => same inner other
        _other => false

    sameMax (a, b, right) = match right
        Max c d => same a c && same b d
        _other => false

    sameIMax (a, b, right) = match right
        IMax c d => same a c && same b d
        _other => false

    sameParam (name, right) = match right
        Param other => name == other
        _other => false

    (** Whether `left ≥ right` under every assignment of the parameters.
        Each rule is sound on its own, so `false` may only mean "not shown":
        an inductive the rule cannot place is rejected, never one that is
        too big accepted ([PROOF-KERNEL-THEORY]). Bounding `imax a b` by its
        arms is sufficient but not necessary, so a `max` holding that very
        `imax` among its arms is also tried. *)
    export geq left right = atLeast (normal left) (normal right)

    atLeast left right = match same left right
        true => true
        false => atLeastRight (left, right)

    atLeastRight (left, right) = match right
        Zero => true
        Max a b => atLeast left a && atLeast left b
        IMax a b => (atLeast left a && atLeast left b) || atLeastLeft (left, right)
        other => atLeastLeft (left, other)

    atLeastLeft (left, right) = match left
        Max a b => atLeast a right || atLeast b right
        IMax _ b => atLeast b right
        Succ inner => atLeastSucc (inner, right)
        _ => false

    atLeastSucc (inner, right) = match right
        Succ other => atLeast inner other
        other => atLeast inner other

    (** Whether `level` is above zero under every assignment. *)
    export isNotZero level = match level
        Succ _inner => true
        Max a b => isNotZero a || isNotZero b
        IMax _ b => isNotZero b
        _ => false

    (** Whether `level` is zero under every assignment. *)
    export isZero level = zeroForm (normal level)

    (** `0`, `1`, `max u v`, `imax u v`, `u`. *)
    export show level = match closed level
        true => toString (height level)
        false => showOpen level

    showOpen level = match level
        Zero => "0"
        Succ inner => "${show inner}+1"
        Max left right => "max ${show left} ${show right}"
        IMax left right => "imax ${show left} ${show right}"
        Param name => name
