namespace proof


(** Reading the `inductive` line of [PROOF-EXPORT]: one line carries a whole
    group — its type formers, its constructors and its recursors, one per
    family plus the auxiliary recursors a nested family's lowering gives
    the group. The reader records exactly what the line claims, through the
    same three tables every other declaration uses, and checks nothing
    about the theory: the block's claims — including how many families,
    constructors and recursors the group holds, each recursor's motive
    count, and the whole group's inventory — are re-derived and compared
    by `Inductive::add` ([PROOF-KERNEL-THEORY]). The shapes the reader
    itself refuses are refused with the line number every other reader
    error carries: an unsafe declaration, a group with no family or no
    recursor, and any member the format does not define. *)
module ExportInductive
    (** The block the line states, or why it cannot be read. *)
    export blocked (tables, json) = Terms::upon (ExportJson::fieldIn (json, "inductive"), \group => Terms::upon (strict (group, groupMembers (), "inductive"), \known => grouped (tables, group)))

    (** Each reads one export field and continues with it, or stops at the first failure. *)
    intAt (json, key, next) = Terms::upon (ExportJson::intIn (json, key), next)
    boolAt (json, key, next) = Terms::upon (ExportJson::boolIn (json, key), next)
    arrayAt (json, key, next) = Terms::upon (ExportJson::arrayIn (json, key), next)

    grouped (tables, group) =
        use types <- arrayAt (group, "types")
        use families <- Terms::upon (nonEmpty (types, "type"))
        use ctors <- arrayAt (group, "ctors")
        use recs <- arrayAt (group, "recs")
        use eliminators <- Terms::upon (nonEmpty (recs, "recursor"))
        groupedAs (tables, families, ctors, eliminators)

    groupedAs (tables, families, ctors, eliminators) =
        use formers <- Terms::upon (eachOf (\json => formerOf (tables, json), families, []))
        use ctorDecls <- Terms::upon (eachOf (\json => constructorOf (tables, json), ctors, []))
        use recDecls <- Terms::upon (eachOf (\json => recursorOf (tables, json), eliminators, []))
        Success(value = Block(formers = formers, ctors = ctorDecls, recursors = recDecls))

    (** A member list that must hold at least one entry. *)
    nonEmpty (items, what) = match items
        [] => Error(message = "no ${what}")
        [first, ...rest] => Success(value = items)

    formerOf (tables, json) =
        use known <- Terms::upon (strict (json, typeMembers (), "type"))
        use safe <- Terms::upon (clean (json))
        use family <- Terms::upon (familyOf (tables, json))
        use decl <- Terms::upon (declared (tables, json, TypeFormer family))
        Success(value = decl)

    familyOf (tables, json) = Terms::upon (ExportJson::intIn (json, "numParams"), \params => Terms::upon (ExportJson::intIn (json, "numIndices"), \indices => familyFlags (tables, json, params, indices)))

    familyFlags (tables, json, params, indices) =
        use recursive <- boolAt (json, "isRec")
        use reflexive <- boolAt (json, "isReflexive")
        use nested <- intAt (json, "numNested")
        use all <- Terms::upon (allOf (tables, json))
        use ctors <- Terms::upon (ctorNames (tables, json))
        Success(value = Family(familyParams = params, familyIndices = indices, familyCtors = ctors, familyRecursive = recursive, familyReflexive = reflexive, familyAll = all, familyNested = nested))

    (** The group inventory a member claims: the `all` name list itself. *)
    allOf (tables, json) = Terms::upon (ExportJson::arrayIn (json, "all"), \items => ExportJson::nameList (tables, items, "group member"))

    ctorNames (tables, json) = Terms::upon (ExportJson::arrayIn (json, "ctors"), \items => ExportJson::nameList (tables, items, "constructor"))

    constructorOf (tables, json) =
        use known <- Terms::upon (strict (json, ctorMembers (), "constructor"))
        use safe <- Terms::upon (clean (json))
        use ctor <- Terms::upon (ctorOf (tables, json))
        use decl <- Terms::upon (declared (tables, json, Constructor ctor))
        Success(value = decl)

    ctorOf (tables, json) =
        use family <- intAt (json, "induct")
        use familyName <- Terms::upon (ExportJson::nameOf (tables, family))
        use index <- intAt (json, "cidx")
        use params <- intAt (json, "numParams")
        use fields <- intAt (json, "numFields")
        Success(value = Ctor(ctorFamily = familyName, ctorIndex = index, ctorParams = params, ctorFields = fields))

    recursorOf (tables, json) =
        use known <- Terms::upon (strict (json, recMembers (), "recursor"))
        use safe <- Terms::upon (clean (json))
        use motives <- intAt (json, "numMotives")
        use elim <- Terms::upon (elimOf (tables, json))
        use decl <- Terms::upon (declared (tables, json, Recursor elim))
        Success(value = decl)

    elimOf (tables, json) =
        use name <- Terms::upon (ExportJson::declName (tables, json))
        use all <- Terms::upon (allOf (tables, json))
        use params <- intAt (json, "numParams")
        use indices <- intAt (json, "numIndices")
        use minors <- intAt (json, "numMinors")
        use motives <- intAt (json, "numMotives")
        use rules <- Terms::upon (rulesOf (tables, json))
        use k <- boolAt (json, "k")
        Success(value = Eliminator(elimFamily = eliminatorFamily (name, all), elimAll = all, elimMotives = motives, elimParams = params, elimIndices = indices, elimMinors = minors, elimRules = rules, elimK = k))

    (** The family a recursor's claim names as its own: the group member
        its name extends, or the first member. *)
    eliminatorFamily (name, all) = prefixed (all, name, all)

    prefixed (names, name, fallback) = match names
        [] => match listGet (fallback, 0)
            Success first => first
            Error _ => name
        [first, ...rest] => match startsWith (name, "${first}.")
            true => first
            false => prefixed (rest, name, fallback)

    rulesOf (tables, json) = Terms::upon (ExportJson::arrayIn (json, "rules"), \items => eachOf (\item => ruleOf (tables, item), items, []))

    (** Every member of `items`, each read by `step`, in file order. *)
    eachOf (step, items, done) = match items
        [] => Success(value = done)
        [first, ...rest] => Terms::upon (step first, \decl => Terms::upon (eachOf (step, rest, done), \more => Success(value = listPrepend (more, decl))))

    ruleOf (tables, json) =
        use known <- Terms::upon (strict (json, ruleMembers (), "rule"))
        use ref <- intAt (json, "ctor")
        use name <- Terms::upon (ExportJson::nameOf (tables, ref))
        use fields <- intAt (json, "nfields")
        use rhs <- intAt (json, "rhs")
        use term <- Terms::upon (ExportJson::exprOf (tables, rhs))
        Success(value = Rule(ruleCtor = name, ruleFields = fields, ruleRhs = term))

    (** A block member's name, universe parameters and type, read exactly
        like a theorem's. *)
    declared (tables, json, body) =
        use name <- Terms::upon (ExportJson::declName (tables, json))
        use params <- Terms::upon (ExportJson::paramsOf (tables, json))
        use ty <- Terms::upon (ExportJson::typedOf (tables, json))
        Success(value = Decl(name = name, params = params, ty = ty, body = body))

    clean (json) = Terms::upon (ExportJson::boolIn (json, "isUnsafe"), \unsafe => unsafely (unsafe))

    unsafely (unsafe) = match unsafe
        true => Error(message = "unsupported: unsafe declaration")
        false => Success(value = true)

    (** `json` carries only the members `allowed`: one the format does not
        define is refused, never dropped. *)
    strict (json, allowed, kind) = match json
        JsonObject members => scanned (members, allowed, kind)
        other => Error(message = "not an object")

    scanned (members, allowed, kind) = match members
        [] => Success(value = true)
        [first, ...rest] => Terms::upon (knownMember (first, allowed, kind), \ok => scanned (rest, allowed, kind))

    knownMember (member, allowed, kind) = match member
        JsonMember name value => matchedMember (name, allowed, kind)
        other => Error(message = "not a member")

    matchedMember (name, allowed, kind) = match listContains (allowed, name)
        true => Success(value = true)
        false => Error(message = "unknown ${kind} member `${name}`")

    groupMembers () = ["ctors", "recs", "types"]

    typeMembers () = ["all", "ctors", "isRec", "isReflexive", "isUnsafe", "levelParams", "name", "numIndices", "numNested", "numParams", "type"]

    ctorMembers () = ["cidx", "induct", "isUnsafe", "levelParams", "name", "numFields", "numParams", "type"]

    recMembers () = ["all", "isUnsafe", "k", "levelParams", "name", "numIndices", "numMinors", "numMotives", "numParams", "rules", "type"]

    ruleMembers () = ["ctor", "nfields", "rhs"]
