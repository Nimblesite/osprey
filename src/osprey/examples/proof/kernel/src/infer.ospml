namespace proof

import proof::Levels
import proof::Terms
import proof::Environment
import proof::Reduce
import proof::Naturals

(** Type inference and checking of [PROOF-KERNEL-THEORY]. The context is
    the list of binders entered (`Binder`: name and type, the type as it was
    when the binder was entered), innermost first. Every failure is a
    message that opens with its kind (`type mismatch`, `not a type`,
    `not a function`, `unbound variable`, `unknown constant`) and then names
    the terms, printed with the binder names in scope; the kind is what a
    caller may branch on, the rendering is for people. *)
module Infer
    (** The type of `term` in `env` under `context`. *)
    export infer (env, context, term) = match term
        Sort level => Success(value = Sort (Succ level))
        BVar index => variable (context, index)
        Const name levels => constant (env, name, levels)
        App head arg => application (env, context, head, arg)
        Lam name domain body => lambda (env, context, name, domain, body)
        Pi name domain body => pi (env, context, name, domain, body)
        Let name ty value body => letIn (env, context, ty, value, body)
        Proj family index target => projection (env, context, family, index, target)
        NatLit value => natural (env, value)

    (** Literal typing requires the checked Peano family and its exact
        constructor types; a same-named axiom cannot introduce literals.
        Implements [PROOF-KERNEL-THEORY] [PROOF-RUNNABLE-LIBRARY]. *)
    natural (env, value) = match Naturals::canonical value && naturalFamily env && naturalCtor (env, "Nat.zero", Const "Nat" [], 0, 0) && naturalCtor (env, "Nat.succ", Pi "n" (Const "Nat" []) (Const "Nat" []), 1, 1)
        true => Success(value = Const "Nat" [])
        false => Error(message = "invalid natural literal or Nat declaration")

    naturalFamily (env) = match Environment::find (env, "Nat")
        Success decl => isEmpty decl.params && Terms::equal (decl.ty, Sort (Succ Zero)) && naturalFormer decl.body
        Error _ => false

    naturalFormer (body) = match body
        TypeFormer info => info.familyParams == 0 && info.familyIndices == 0 && naturalNames info.familyCtors
        other => false

    naturalNames (names) = match names
        ["Nat.zero", "Nat.succ"] => true
        other => false

    naturalCtor (env, name, ty, index, fields) = match Environment::find (env, name)
        Success decl => isEmpty decl.params && Terms::equal (decl.ty, ty) && naturalConstructor (decl.body, index, fields)
        Error _ => false

    naturalConstructor (body, index, fields) = match body
        Constructor info => info.ctorFamily == "Nat" && info.ctorIndex == index && info.ctorParams == 0 && info.ctorFields == fields
        other => false

    (** Check that `term` has type `expected`. *)
    export check (env, context, term, expected) = match infer (env, context, term)
        Success found => matches (env, context, term, found, expected)
        Error message => Error(message = message)

    matches (env, context, term, found, expected) = match Reduce::conversion (env, context, found, expected, true)
        true => Success(value = expected)
        false => Error(message = "type mismatch: `${Terms::show (term, names context)}` has type `${Terms::show (found, names context)}` but `${Terms::show (expected, names context)}` was expected")

    (** Proof irrelevance: both terms must have propositions as their types,
        and those proposition types must themselves be definitionally equal.
        A type such as `P` is not a proof, so it is never admitted here. *)
    export proofEqual (env, context, left, right) = match infer (env, context, left)
        Success leftType => proofRight (env, context, leftType, right)
        Error message => false

    proofRight (env, context, leftType, right) = match infer (env, context, right)
        Success rightType => proofTypes (env, context, leftType, rightType)
        Error message => false

    proofTypes (env, context, leftType, rightType) = match isProposition (env, context, leftType) && isProposition (env, context, rightType)
        true => Reduce::conversion (env, context, leftType, rightType, true)
        false => false

    isProposition (env, context, ty) = match infer (env, context, ty)
        Success levelType => sortIsProp (Reduce::whnf (env, levelType))
        Error message => false

    sortIsProp (term) = match term
        Sort level => Levels::isZero level
        other => false

    (** The binder names in scope, innermost first, as `Terms::show` wants. *)
    names context = match context
        [] => []
        [first, ...rest] => listPrepend (names rest, first.name)

    variable (context, index) = match listGet (context, index)
        Success binder => Success(value = Terms::shift (binder.ty, 0, satAdd index 1))
        Error message => Error(message = "unbound variable #${toString index}")

    constant (env, name, levels) = match Environment::find (env, name)
        Success decl => Environment::instantiated (decl, decl.ty, levels)
        Error message => Error(message = "unknown constant `${name}`")

    application (env, context, head, arg) = match infer (env, context, head)
        Success headType => applyTo (env, context, Reduce::whnf (env, headType), head, arg)
        Error message => Error(message = message)

    applyTo (env, context, headType, head, arg) = match headType
        Pi name domain body => applyArg (env, context, domain, body, arg)
        other => Error(message = "not a function: `${Terms::show (head, names context)}` is applied but has type `${Terms::show (other, names context)}`")

    applyArg (env, context, domain, body, arg) = match check (env, context, arg, domain)
        Success ty => Success(value = Terms::instantiate (body, arg))
        Error message => Error(message = message)

    lambda (env, context, name, domain, body) = match sort (env, context, domain)
        Success level => lambdaBody (env, context, name, domain, body)
        Error message => Error(message = message)

    lambdaBody (env, context, name, domain, body) = match infer (env, listPrepend (context, Binder(name = name, ty = domain)), body)
        Success bodyType => Success(value = Pi name domain bodyType)
        Error message => Error(message = message)

    pi (env, context, name, domain, body) = match sort (env, context, domain)
        Success u => piBody (env, context, name, domain, body, u)
        Error message => Error(message = message)

    piBody (env, context, name, domain, body, u) = match sort (env, listPrepend (context, Binder(name = name, ty = domain)), body)
        Success v => Success(value = Sort (IMax u v))
        Error message => Error(message = message)

    letIn (env, context, ty, value, body) = match check (env, context, value, ty)
        Success checked => infer (env, context, Terms::instantiate (body, value))
        Error message => Error(message = message)

    (** The universe level of a type, or an error when `term` is not a type. *)
    export sort (env, context, term) = match infer (env, context, term)
        Success ty => sortOf (context, term, Reduce::whnf (env, ty))
        Error message => Error(message = message)

    sortOf (context, term, ty) = match ty
        Sort level => Success(value = level)
        other => Error(message = "not a type: `${Terms::show (term, names context)}` has type `${Terms::show (other, names context)}`")

    (** Implements [PROOF-KERNEL-THEORY]: infer the selected constructor
        field, substituting parameters and earlier dependent projections.
        A proposition may project only proofs, never hidden data. *)
    projection (env, context, family, index, target) = match infer (env, context, target)
        Success ty => projectionHead (env, context, family, index, target, ty, Terms::spine (Reduce::whnf (env, ty)))
        Error message => Error(message = message)

    projectionHead (env, context, family, index, target, ty, spine) = match spine.spineHead
        Const name levels => projectionNamed (env, context, family, index, target, ty, spine.spineArgs, levels, name == family && index >= 0)
        other => invalidProjection (family, index)

    projectionNamed (env, context, family, index, target, ty, args, levels, valid) = match valid
        false => invalidProjection (family, index)
        true => match Environment::find (env, family)
            Success decl => projectionFormer (env, context, family, index, target, ty, args, levels, decl.body)
            Error message => Error(message = message)

    projectionFormer (env, context, family, index, target, ty, args, levels, body) = match body
        TypeFormer info => projectionFamily (env, context, family, index, target, ty, args, levels, info)
        other => invalidProjection (family, index)

    projectionFamily (env, context, family, index, target, ty, args, levels, info) = match info.familyCtors
        [ctor] => projectionArity (env, context, family, index, target, ty, args, levels, info.familyParams, ctor, listLength args == satAdd info.familyParams info.familyIndices)
        other => invalidProjection (family, index)

    projectionArity (env, context, family, index, target, ty, args, levels, params, ctor, valid) = match valid
        false => invalidProjection (family, index)
        true => match Environment::find (env, ctor)
            Success decl => projectionSorted (env, context, family, index, target, args, levels, params, decl, sort (env, context, ty))
            Error message => Error(message = message)

    projectionSorted (env, context, family, index, target, args, levels, params, ctor, sorted) = match sorted
        Success level => projectionInstantiated (env, context, family, index, target, args, params, Levels::isZero level, Environment::instantiated (ctor, ctor.ty, levels))
        Error message => Error(message = message)

    projectionInstantiated (env, context, family, index, target, args, params, prop, instantiated) = match instantiated
        Success ty => projectionParams (env, context, family, index, target, args, params, prop, ty)
        Error message => Error(message = message)

    projectionParams (env, context, family, index, target, args, params, prop, ty) = match params == 0
        true => projectionField (env, context, family, index, target, prop, ty, 0)
        false => match Reduce::whnf (env, ty)
            Pi name domain body => projectionArgument (env, context, family, index, target, args, params, prop, body)
            other => invalidProjection (family, index)

    projectionArgument (env, context, family, index, target, args, params, prop, body) = match args
        [first, ...rest] => projectionParams (env, context, family, index, target, rest, satSub params 1, prop, Terms::instantiate (body, first))
        [] => invalidProjection (family, index)

    projectionField (env, context, family, index, target, prop, ty, at) = match Reduce::whnf (env, ty)
        Pi name domain body => projectionNext (env, context, family, index, target, prop, body, at, projectionProof (env, context, family, index, domain, prop && (at == index || Terms::mentions (body, 0))))
        other => invalidProjection (family, index)

    projectionNext (env, context, family, index, target, prop, body, at, checked) = match checked
        Success domain => match at == index
            true => Success(value = domain)
            false => projectionField (env, context, family, index, target, prop, Terms::instantiate (body, Proj family at target), satAdd at 1)
        Error message => Error(message = message)

    projectionProof (env, context, family, index, domain, required) = match required
        false => Success(value = domain)
        true => match sort (env, context, domain)
            Success level => match Levels::isZero level
                true => Success(value = domain)
                false => invalidProjection (family, index)
            Error message => Error(message = message)

    invalidProjection (family, index) = Error(message = "invalid projection `${family}.${toString index}`")
