namespace proof


(** Authenticate the standard choice basis against its derived Nonempty
    family and signature. Other assumptions retain their explicit names;
    checking remains relative to those assumptions. Implements [PROOF-KERNEL-AXIOMS]. *)
module Axioms
    (** Whether `name` is the one name only the standard choice axiom may take. *)
    export reserved name = name == "Classical.choice"

    (** `decl` checked as the standard choice axiom and returned, or an error when
        its body is not an axiom, it does not take exactly one universe parameter,
        or its type is not the derived choice signature over the genuine
        `Nonempty` family. *)
    export declare (env, decl) = match decl.body
        Axiom => universal (env, decl)
        _ => Error(message = "`${decl.name}` is reserved for the standard choice axiom")

    universal (env, decl) = match decl.params
        [u] => claim (env, decl, Param u)
        _ => Error(message = "Classical.choice takes one universe parameter")

    claim (env, decl, u) = match genuine env && Terms::equal (decl.ty, choiceSignature u)
        false => Error(message = "`Classical.choice` does not have its derived choice signature over the genuine `Nonempty` family")
        true => Success(value = decl)

    choiceSignature u = overUniverse (u, Pi "h" (App (Const "Nonempty" [u]) (BVar 0)) (BVar 1))

    genuine env = matched (env, "Nonempty", former) && introduced env

    former decl = derived (decl, formerType, \body => tagged (body, familyOk, \_info => false))

    formerType u = overUniverse (u, Sort Zero)

    familyOk info = info.familyParams == 1 && info.familyIndices == 0 && DeclarationBodies::sameNames (info.familyCtors, ["Nonempty.intro"]) && !info.familyRecursive && !info.familyReflexive && DeclarationBodies::sameNames (info.familyAll, ["Nonempty"]) && info.familyNested == 0

    introduced env = matched (env, "Nonempty.intro", constructor)

    constructor decl = derived (decl, introType, \body => tagged (body, \_info => false, ctorOk))

    ctorOk info = ctorShape (info, "Nonempty", 1, 1)

    introType u = overUniverse (u, Pi "val" (BVar 0) (App (Const "Nonempty" [u]) (BVar 1)))

    (** Whether the declaration `name` is in `env` and `ok` holds of it; false when
        it is absent or `ok` refuses it. *)
    export matched (env, name, ok) = match Environment::find (env, name)
        Success decl => ok decl
        Error _ => false

    (** Whether `decl` takes one universe parameter `u`, its type equals `tyOf` at
        `u`, and `bodyOk` holds of its body. *)
    export derived (decl, tyOf, bodyOk) = match decl.params
        [u] => Terms::equal (decl.ty, tyOf (Param u)) && bodyOk decl.body
        _ => false

    (** Whether `body` is a type former `formerOk` accepts or a constructor
        `ctorOk` accepts; any other body is refused. *)
    export tagged (body, formerOk, ctorOk) = match body
        TypeFormer info => formerOk info
        Constructor info => ctorOk info
        _ => false

    (** Whether a constructor is the first constructor of `family` and takes
        `params` parameters and `fields` fields. *)
    export ctorShape (info, family, params, fields) = info.ctorFamily == family && info.ctorIndex == 0 && info.ctorParams == params && info.ctorFields == fields

    (** `body` under one more binder, `α : Sort u`. *)
    export overUniverse (u, body) = Pi "α" (Sort u) body

(** The four primitive quotient signatures, independently derived from
    Lean 4.25 kernel/quot.cpp. Exported claims never define their theory.
    Implements [PROOF-KERNEL-THEORY] [PROOF-KERNEL-AXIOMS]. *)
module Quotients
    (** Whether `name` is reserved: `Classical.choice`, or one of `Quot`, `Quot.mk`,
        `Quot.lift`, `Quot.ind` and `Quot.sound`. *)
    export reserved name = Axioms::reserved name || listContains (["Quot", "Quot.mk", "Quot.lift", "Quot.ind", "Quot.sound"], name)

    (** `env` with the reserved `decl` added once it checks, or an error naming what
        is wrong: the choice axiom as `Axioms::declare` checks it, a quotient
        primitive only in initialization order with its derived signature and a
        checked `Eq` in place, and `Quot.sound` only after `Quot.ind`. *)
    export declare (env, decl) = match Axioms::reserved decl.name
        true => choice (env, decl)
        false => listed (env, decl)

    choice (env, decl) = match Axioms::declare (env, decl)
        Success checked => typed (env, checked)
        Error message => Error(message = message)

    listed (env, decl) = match decl.body
        Quotient kind => primitive (env, decl, kind)
        Axiom => sound (env, decl)
        _ => Error(message = "`${decl.name}` is reserved for quotient theory")

    primitive (env, decl, kind) = match decl.name == Environment::quotName kind && previous (env, kind) && equalityReady env
        false => Error(message = "invalid quotient primitive `${decl.name}` or initialization order")
        true => claim (env, decl, expected (kind, decl.params))

    sound (env, decl) = match decl.name == "Quot.sound" && installed (env, "Quot.ind")
        true => claim (env, decl, soundParameters decl.params)
        false => Error(message = "invalid quotient soundness axiom `${decl.name}`")

    claim (env, decl, expectedType) = match expectedType
        Error message => Error(message = message)
        Success ty => match Terms::equal (decl.ty, ty)
            false => Error(message = "`${decl.name}` does not have its derived quotient signature")
            true => typed (env, Decl(name = decl.name, params = decl.params, ty = ty, body = decl.body))

    typed (env, decl) = Terms::upon (Infer::sort (env, [], decl.ty), \_ => Environment::add (env, decl))

    previous (env, kind) = match kind
        QuotType => true
        QuotCtor => installed (env, "Quot")
        QuotLift => installed (env, "Quot.mk")
        QuotInd => installed (env, "Quot.lift")

    installed (env, name) = match Environment::find (env, name)
        Success decl => match decl.body
            Quotient kind => Environment::quotName kind == name
            _ => false
        Error _ => false

    expected (kind, params) = match params
        [u] => singleUniverse (kind, Param u)
        [u, v] => match kind
            QuotLift => Success(value = liftType (Param u, Param v))
            _ => Error(message = "this quotient primitive takes one universe parameter")
        _ => Error(message = "invalid quotient universe parameters")

    singleUniverse (kind, u) = match kind
        QuotType => Success(value = quotientType u)
        QuotCtor => Success(value = constructorType u)
        QuotInd => Success(value = inductionType u)
        QuotLift => Error(message = "Quot.lift takes two universe parameters")

    soundParameters params = match params
        [u] => Success(value = soundType (Param u))
        _ => Error(message = "Quot.sound takes one universe parameter")

    relation depth = Pi "a" (BVar depth) (Pi "b" (BVar (satAdd depth 1)) (Sort Zero))

    quotientAt (u, depth) = Terms::apps (Const "Quot" [u], [BVar depth, BVar (satSub depth 1)])

    constructorAt (u, depth, value) = Terms::apps (Const "Quot.mk" [u], [BVar depth, BVar (satSub depth 1), value])

    equality (u, ty, left, right) = Terms::apps (Const "Eq" [u], [ty, left, right])

    quotientType u = Axioms::overUniverse (u, Pi "r" (relation 0) (Sort u))

    constructorType u = Axioms::overUniverse (u, Pi "r" (relation 0) (Pi "a" (BVar 1) (quotientAt (u, 2))))

    liftType (u, v) = Axioms::overUniverse (u, Pi "r" (relation 0) (Pi "β" (Sort v) (Pi "f" (Pi "x" (BVar 2) (BVar 1)) (Pi "h" (respects v) (Pi "q" (quotientAt (u, 4)) (BVar 3))))))

    respects v = Pi "a" (BVar 3) (Pi "b" (BVar 4) (Pi "h" (Terms::apps (BVar 4, [BVar 1, BVar 0])) (equality (v, BVar 4, App (BVar 3) (BVar 2), App (BVar 3) (BVar 1)))))

    inductionType u = Axioms::overUniverse (u, Pi "r" (relation 0) (Pi "β" (Pi "q" (quotientAt (u, 1)) (Sort Zero)) (Pi "mk" (Pi "a" (BVar 2) (App (BVar 1) (constructorAt (u, 3, BVar 0)))) (Pi "q" (quotientAt (u, 3)) (App (BVar 2) (BVar 0))))))

    soundType u = Axioms::overUniverse (u, Pi "r" (relation 0) (Pi "a" (BVar 1) (Pi "b" (BVar 2) (Pi "h" (Terms::apps (BVar 2, [BVar 1, BVar 0])) (equality (u, quotientAt (u, 4), constructorAt (u, 4, BVar 2), constructorAt (u, 4, BVar 1)))))))

    equalityReady env = Axioms::matched (env, "Eq", equalityFormer) && equalityConstructor env

    equalityFormer decl = Axioms::derived (decl, equalityType, \body => Axioms::tagged (body, equalityFamily, \_info => false))

    equalityType u = Axioms::overUniverse (u, Pi "a" (BVar 0) (Pi "b" (BVar 1) (Sort Zero)))

    equalityFamily info = info.familyParams == 2 && info.familyIndices == 1 && DeclarationBodies::sameNames (info.familyCtors, ["Eq.refl"])

    equalityConstructor env = Axioms::matched (env, "Eq.refl", reflexivity)

    reflexivity decl = Axioms::derived (decl, reflexivityType, \body => Axioms::tagged (body, \_info => false, reflexivityBody))

    reflexivityType u = Axioms::overUniverse (u, Pi "a" (BVar 0) (equality (u, BVar 1, BVar 0, BVar 0)))

    reflexivityBody info = Axioms::ctorShape (info, "Eq", 2, 0)
