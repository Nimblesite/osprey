namespace proof

import proof::Levels
import proof::Terms
import proof::Environment
import proof::DeclarationBodies
import proof::Nesting
import proof::Reduce
import proof::Infer
import proof::Telescope
import proof::Recursors

(** One field read: whether it is a proof, and how it mentions a family
    of the group (0: not at all, 1: as its type, 2: under a function). *)
type FieldRead =
    fieldProof : bool
    fieldOccurs : int

(** An inductive group's shared read: its parameter telescope and its
    result sort. *)
type Former =
    formerParams : List<Binder>
    formerSort : Level

(** One family of the group as it was read: its name and its index
    telescope. *)
type FamilyRead =
    readName : string
    readIndices : List<Binder>

(** A group as read: shared telescope, sort, level names, families. *)
type GroupRead =
    groupFormer : Former
    groupLevels : List<string>
    groupFamilies : List<FamilyRead>

(** A family an occurrence names, with its indices. *)
type Found =
    foundFamily : FamilyRead
    foundIndices : List<Term>

(** Checking an inductive declaration of [PROOF-KERNEL-THEORY]: a whole
    group — one family, a mutual block, or the internal auxiliary group
    a nested declaration lowers to — as Lean's kernel checks it. Every
    family must take the same universe parameters, open with the same
    parameter telescope and end in one sort. Every constructor belongs
    to the family its result names and must be a well-typed telescope
    that opens with the group's parameters, whose fields mention a
    family of the group only strictly positively and within the group's
    sort, and that ends in its family at full arity with indices clear
    of the group. The recursors, their ι rules, the group's elimination
    universe and K are then derived by `Recursors`, never read. *)
module Inductive
    upon (outcome, next) = match outcome
        Success value => next value
        Error message => Error(message = message)

    (** Fold `step` over `items`, threading the value and keeping the first refusal. *)
    each (items, seed, step) = foldList (items, Success(value = seed), \(so_far, x) => upon (so_far, \acc => upon (step (acc, x), \next => Success(value = next))))

    (** Whether `holds` is true of any item. *)
    anyOf (items, holds) = foldList (items, false, \(seen, x) => seen || holds (x))

    (** `ok` when `holds`, else the refusal `why`. *)
    whenHolds (holds, ok, why) = match holds
        true => Success(value = ok)
        false => Error(message = why)

    (** `pick` of the item at `i`, or `instead` when `i` is out of range. *)
    picked (items, i, pick, instead) = match listGet (items, i)
        Success x => pick x
        Error _ => instead

    (** The first item whose `pick` is `name`, or the refusal `missing`. *)
    named (items, name, pick, missing) = match items
        [] => Error(message = missing)
        [first, ...rest] => match pick first == name
            true => Success(value = first)
            false => named (rest, name, pick, missing)

    (** The first item, or the refusal `missing` when there is none. *)
    headOf (items, missing) = match items
        [] => Error(message = missing)
        [first, ...rest] => Success(value = first)

    (** Check the families `formers` with `params` shared parameters and
        their constructors `ctors`, and derive every family's recursor;
        `elimName` names the recursors' extra universe parameter when
        the group eliminates into every sort ("" picks `u`, or the first
        `u_n` the group does not use). A constructor's body is ignored;
        its result names its family. *)
    export derive (env, formers, ctors, params, elimName) = upon (formersRead (env, formers, params), \group => upon (scratch (env, formers), \withAxioms => upon (shapesGrouped (withAxioms, group, ctors), \shapeGroups => Success(value = specOf (group, shapeGroups, elimName)))))

    (** The group's shared read: every family is a type, takes the first's
        universe parameters, a defequal parameter telescope, one sort. *)
    formersRead (env, formers, params) = upon (sortedDecls (env, formers), \_ => formersFrom (env, formers, params))

    formersFrom (env, formers, params) = match formers
        [first, ...rest] => firstRead (env, first, rest, params, Telescope::peel (env, first.ty))
        [] => Error(message = "an inductive block with no family")

    sortedDecls (env, decls) = each (decls, true, \(_, decl) => upon (Infer::sort (env, [], decl.ty), \_ => Success(value = true)))

    firstRead (env, first, rest, params, peeled) = firstSplit (env, first, rest, params, peeled, Reduce::whnf (env, peeled.peeledRest))

    firstSplit (env, first, rest, params, peeled, result) = upon (whenHolds (listLength peeled.peeledBinders >= params && params >= 0, true, "`${first.name}` has fewer than ${toString params} parameters"), \_ => firstSorted (env, first, rest, params, peeled, result))

    firstSorted (env, first, rest, params, peeled, result) = match result
        Sort level => groupRead (env, first, rest, GroupRead(groupFormer = Former(formerParams = Telescope::outer (peeled.peeledBinders, params), formerSort = level), groupLevels = first.params, groupFamilies = [FamilyRead(readName = first.name, readIndices = Telescope::inner (peeled.peeledBinders, params))]))
        other => Error(message = "not a type former: `${first.name}` does not end in a sort")

    (** The group's parameter count, shared by every family. *)
    paramCount (group) = listLength group.groupFormer.formerParams

    (** A peeled telescope's group-parameter prefix. *)
    groupParams (group, peeled) = Telescope::outer (peeled.peeledBinders, paramCount group)

    (** A peeled telescope's fields after the group's parameters. *)
    groupFields (group, peeled) = Telescope::inner (peeled.peeledBinders, paramCount group)

    groupRead (env, first, rest, group) = each (rest, group, \(so_far, former) => groupWith (env, first, so_far, former))

    groupWith (env, first, group, former) = upon (familyFits (env, first, group, former, Telescope::peel (env, former.ty)), \family => Success(value = grown (group, family)))

    grown (group, family) = GroupRead(groupFormer = group.groupFormer, groupLevels = group.groupLevels, groupFamilies = listAppend (group.groupFamilies, family))

    familyFits (env, first, group, former, peeled) = upon (whenHolds (sameNames (former.params, first.params) && listLength peeled.peeledBinders >= paramCount group, true, "`${former.name}` must take the universe parameters and the parameters of `${first.name}`"), \_ => familySorted (env, group, former, peeled))

    familySorted (env, group, former, peeled) = familyLeveled (env, group, former, groupParams (group, peeled), groupFields (group, peeled), Reduce::whnf (env, peeled.peeledRest))

    familyLeveled (env, group, former, found, indices, result) = match result
        Sort level => whenHolds (Telescope::sameDomains (env, found, group.groupFormer.formerParams) && Levels::equal level group.groupFormer.formerSort, FamilyRead(readName = former.name, readIndices = indices), "`${former.name}` does not share `${headName (group)}'s parameters and result universe")
        other => Error(message = "not a type former: `${former.name}` does not end in a sort")

    headName (group) = picked (group.groupFamilies, 0, \family => family.readName, "the group")

    (** The environment with every family added as an axiom, so
        constructors are checked with all of them in scope. *)
    scratch (env, formers) = each (formers, env, \(so_far, former) => Environment::add (so_far, Decl(name = former.name, params = former.params, ty = former.ty, body = Axiom)))

    (** Every constructor of the group as the kernel checked it, grouped
        by the family its result names, in declaration order. *)
    shapesGrouped (env, group, ctors) = shapesPer (env, group, group.groupFamilies, ctors, [])

    shapesPer (env, group, families, ctors, done) = each (families, done, \(so_far, family) => upon (familyShapes (env, group, family, ctors, []), \shapes => Success(value = listAppend (so_far, shapes))))

    familyShapes (env, group, family, ctors, done) = each (ctors, done, \(so_far, ctor) => upon (shapeOwned (env, group, family, ctor), \found => Success(value = listConcat (so_far, found))))

    (** The constructor's shape when its result names `family`; nothing
        when the constructor belongs to another family of the group. *)
    shapeOwned (env, group, family, ctor) = upon (shapeHead (env, group, ctor), \owner => ownedShape (env, group, family, ctor, owner))

    ownedShape (env, group, family, ctor, owner) = match owner == family.readName
        true => shapeOf (env, group, family, ctor)
        false => Success(value = [])

    (** The family a constructor's result names: its owner in the group. *)
    shapeHead (env, group, ctor) = headPeeled (group, ctor, Telescope::peel (env, ctor.ty))

    headPeeled (group, ctor, peeled) = headSpine (group, ctor, Terms::spine peeled.peeledRest)

    headSpine (group, ctor, spine) = match spine.spineHead
        Const name levels => headNamed (group, ctor, name, levels)
        other => Error(message = "constructor `${ctor.name}` must end in a family of the group applied to its parameters")

    headNamed (group, ctor, name, levels) = upon (familyNamed (group, name), \family => namedHead (group, ctor, family, levels))

    namedHead (group, ctor, family, levels) = whenHolds (Terms::equalLevels (levels, levelsOf group), family.readName, "constructor `${ctor.name}` must end in `${family.readName}` at the group's universe parameters")

    (** The group family named `name`, if any. *)
    familyNamed (group, name) = named (group.groupFamilies, name, \family => family.readName, "the head is not the family")

    levelsOf (group) = mapList (group.groupLevels, \name => Param name)

    (** A constructor of `family`: same universe parameters as the group,
        a type, the group's parameters first, then its fields, then the
        family. *)
    shapeOf (env, group, family, ctor) = upon (whenHolds (sameNames (ctor.params, group.groupLevels), true, "constructor `${ctor.name}` must take the universe parameters of `${family.readName}`"), \_ => upon (Infer::sort (env, [], ctor.ty), \level => shapePeeled (env, group, family, ctor, Telescope::peel (env, ctor.ty))))

    shapePeeled (env, group, family, ctor, peeled) = upon (whenHolds (listLength peeled.peeledBinders >= paramCount group && Telescope::sameDomains (env, groupParams (group, peeled), group.groupFormer.formerParams), true, "constructor `${ctor.name}` must open with the parameters of `${family.readName}`"), \_ => shapeFields (env, group, family, ctor, peeled))

    shapeFields (env, group, family, ctor, peeled) = upon (fieldsFrom (env, group, family, ctor, groupParams (group, peeled), groupFields (group, peeled), []), \reads => shapeResult (group, family, ctor, peeled, reads))

    shapeResult (group, family, ctor, peeled, reads) = match occurrence (group, listLength peeled.peeledBinders, peeled.peeledRest)
        Success found => resulted (group, family, ctor, peeled, reads, found)
        Error message => Error(message = "constructor `${ctor.name}` must end in `${family.readName}` applied to its parameters: ${message}")

    resulted (group, family, ctor, peeled, reads, found) = whenHolds (found.foundFamily.readName == family.readName, [Shape(shapeName = ctor.name, shapeFields = groupFields (group, peeled), shapeIndices = found.foundIndices, shapeProofs = mapList (reads, \field => field.fieldProof), shapeOccurs = mapList (reads, \field => field.fieldOccurs))], "constructor `${ctor.name}` must end in `${family.readName}` applied to its parameters")

    (** Each field, under the binders before it: positive, and in a
        universe the group's sort bounds. The result is, per field,
        whether it is a proof. *)
    fieldsFrom (env, group, family, ctor, before, fields, reads) = match fields
        [] => Success(value = reads)
        [first, ...rest] => upon (fieldChecked (env, group, family, ctor, before, first), \field => fieldsFrom (env, group, family, ctor, listAppend (before, first), rest, listAppend (reads, field)))

    fieldChecked (env, group, family, ctor, before, field) = upon (Infer::sort (env, Telescope::context before, field.ty), \level => upon (fitting (group, family, ctor, field, level), \fits => upon (positive (env, group, family, ctor, listLength before, Reduce::whnf (env, field.ty)), \occurs => Success(value = FieldRead(fieldProof = Levels::isZero level, fieldOccurs = occurs)))))

    fitting (group, family, ctor, field, level) = whenHolds (Levels::isZero group.groupFormer.formerSort || Levels::geq group.groupFormer.formerSort level, true, "field `${field.name}` of `${ctor.name}` lives in a universe above `${family.readName}`'s")

    (** Whether any family of the group occurs in `term`. *)
    mentionsGroup (group, term) = anyOf (group.groupFamilies, \family => Terms::occurs (term, family.readName))

    (** The first family of the group occurring in `term`, for the
        refusal that names it. *)
    culprit (families, term) = match families
        [] => "the group"
        [first, ...rest] => match Terms::occurs (term, first.readName)
            true => first.readName
            false => culprit (rest, term)

    (** Strict positivity: a family of the group may occur only as the
        result of a field, under binders that do not mention it. *)
    positive (env, group, family, ctor, depth, ty) = match mentionsGroup (group, ty)
        false => Success(value = 0)
        true => positiveAt (env, group, family, ctor, depth, ty)

    positiveAt (env, group, family, ctor, depth, ty) = match ty
        Pi name domain body => positivePi (env, group, family, ctor, depth, domain, body)
        other => positiveEnd (family, ctor, occurrence (group, depth, other))

    positivePi (env, group, family, ctor, depth, domain, body) = match mentionsGroup (group, domain)
        true => Error(message = "non-positive occurrence of `${culprit (group.groupFamilies, domain)}` in constructor `${ctor.name}`")
        false => upon (positive (env, group, family, ctor, satAdd depth 1, Reduce::whnf (env, body)), \inner => Success(value = 2))

    positiveEnd (family, ctor, found) = match found
        Success value => Success(value = 1)
        Error message => Error(message = "invalid occurrence of `${family.readName}` in constructor `${ctor.name}`: ${message}")

    (** `term`, under `depth` binders whose outermost are the group's
        parameters, is a family of the group at the group's universe
        parameters applied to exactly those parameters and to indices
        clear of the group; the family and its indices if so. *)
    occurrence (group, depth, term) = occurrenceIn (group, depth, Terms::spine term)

    occurrenceIn (group, depth, spine) = match spine.spineHead
        Const name levels => occurrenceNamed (group, depth, spine, familyNamed (group, name), levels)
        other => Error(message = "the head is not the family")

    occurrenceNamed (group, depth, spine, found, levels) = upon (found, \family => occurrenceHead (group, depth, spine, family, Terms::equalLevels (levels, levelsOf group)))

    occurrenceHead (group, depth, spine, family, atLevels) = upon (whenHolds (atLevels && listLength spine.spineArgs == satAdd (paramCount group) (listLength family.readIndices), true, "not the family at its universe parameters and full arity"), \_ => occurrenceArgs (group, depth, spine.spineArgs, family))

    occurrenceArgs (group, depth, args, family) = upon (whenHolds (Terms::equalAll (Terms::prefix (args, paramCount group), Terms::vars (satSub depth (paramCount group), paramCount group)), true, "the parameters are not passed through unchanged"), \_ => occurrenceIndices (group, Terms::suffix (args, paramCount group), family))

    occurrenceIndices (group, indices, family) = match anyOf (indices, \index => mentionsGroup (group, index))
        true => Error(message = "an index mentions the family")
        false => Success(value = Found(foundFamily = family, foundIndices = indices))

    (** The recursors' shared specification: they eliminate into every
        sort unless the group is one family that may be a proposition
        which is not a syntactic subsingleton, in which case only into
        `Prop`. *)
    specOf (group, shapeGroups, elimName) = specWith (group, shapeGroups, groupLarge (group, shapeGroups), Recursors::freshElim (group.groupLevels, elimName))

    specWith (group, shapeGroups, everySort, name) = Spec(specFormers = formerSpecs (group, shapeGroups), specLevels = levelsOf group, specParams = group.groupFormer.formerParams, specSort = group.groupFormer.formerSort, specElim = elimOf (everySort, name), specRecParams = listConcat (elimNames (everySort, name), group.groupLevels), specRecLevels = listConcat (elimLevels (everySort, name), levelsOf group))

    formerSpecs (group, shapeGroups) = specsFrom (group.groupFamilies, shapeGroups, [])

    specsFrom (families, shapeGroups, done) = match families
        [] => done
        [first, ...rest] => match shapeGroups
            [] => done
            [shapes, ...more] => specsFrom (rest, more, listAppend (done, FormerSpec(formerName = first.readName, formerIndices = first.readIndices, formerRec = "${first.readName}.rec", formerShapes = shapes)))

    elimNames (everySort, name) = match everySort
        true => [name]
        false => []

    elimOf (everySort, name) = match everySort
        true => Param name
        false => Zero

    elimLevels (everySort, name) = mapList (elimNames (everySort, name), \n => Param n)

    groupLarge (group, shapeGroups) = match Levels::isNotZero group.groupFormer.formerSort
        true => true
        false => match group.groupFamilies
            [only] => singletonLarge (shapeGroups)
            other => false

    singletonLarge (shapeGroups) = match shapeGroups
        [] => true
        [only] => isEmpty only || subsingles only
        other => false

    (** One constructor whose every field is a proof or an index of the
        value it builds. *)
    subsingles (shapes) = match shapes
        [only] => fieldsDetermined (only, 0)
        other => false

    fieldsDetermined (shape, j) = picked (shape.shapeProofs, j, \proof => (proof || indexed (shape.shapeIndices, BVar (satSub (satSub (listLength shape.shapeFields) 1) j))) && fieldsDetermined (shape, satAdd j 1), true)

    indexed (indices, field) = anyOf (indices, \index => Terms::equal (index, field))

    (** Compatibility entry for ordered name comparison. *)
    export sameNames (left, right) = DeclarationBodies::sameNames (left, right)

    (** K: a one-family `Prop` group with exactly one constructor and no
        fields, the pinned kernel's `init_K_target`. *)
    export k (spec) = match spec.specFormers
        [only] => Levels::isZero spec.specSort && fieldless only.formerShapes
        other => false

    fieldless (shapes) = match shapes
        [only] => isEmpty only.shapeFields
        other => false

    (** Check one family and its constructors, derive its recursor, and
        add all of them: what a declaration written in Osprey goes
        through, as the one-family case of the group derivation. *)
    export declare (env, former, ctors, params) = upon (derive (env, [former], ctors, params, ""), \spec => install (env, [former], ctors, spec, []))

    (** Add the checked families, their constructors and recursors — the
        declaration's own under their own names, and every auxiliary
        recursor a nested lowering created under its restored name. *)
    install (env, formers, ctors, spec, nests) = upon (familiesFrom (env, formers, formers, spec, 0, nests), \withFamilies => upon (ctorsAdded (withFamilies, formers, ctors, spec), \withCtors => recursorsAdded (withCtors, spec, 0, listLength formers, nests)))

    familiesFrom (env, original, formers, spec, d, nests) = match formers
        [] => Success(value = env)
        [first, ...rest] => upon (Environment::add (env, Decl(name = first.name, params = first.params, ty = first.ty, body = TypeFormer (familyOf (spec, d, original, nests)))), \withFamily => familiesFrom (withFamily, original, rest, spec, satAdd d 1, nests))

    (** The family's checked metadata: its own counts and constructor
        names, the unchanged original inventory, and how many auxiliary
        families its nested lowering created. *)
    familyOf (spec, d, original, nests) = picked (spec.specFormers, d, \former => Family(familyParams = Recursors::paramCount spec, familyIndices = Recursors::indexCount (spec, d), familyCtors = mapList (former.formerShapes, \shape => shape.shapeName), familyRecursive = groupOccurs (spec, 1), familyReflexive = groupOccurs (spec, 2), familyAll = mapList (original, \former => former.name), familyNested = listLength nests), blankFamily ())

    (** Whether any constructor of the group marks a field recursively
        (`least` 1) or reflexively (2): the pinned kernel stores one
        group-wide flag on every family, not a per-family one. *)
    groupOccurs (spec, least) = anyOf (spec.specFormers, \former => occursAtLeast (former.formerShapes, least))

    blankFamily () = Family(familyParams = 0, familyIndices = 0, familyCtors = [], familyRecursive = false, familyReflexive = false, familyAll = [], familyNested = 0)

    occursAtLeast (shapes, least) = anyOf (shapes, \shape => anyOf (shape.shapeOccurs, \occurs => occurs >= least))

    ctorsAdded (env, formers, ctors, spec) = ctorsFrom (env, ctors, Terms::prefix (spec.specFormers, listLength formers), spec)

    ctorsFrom (env, ctors, formers, spec) = each (formers, env, \(so_far, first) => familyCtorsAdded (so_far, ctors, first.formerShapes, 0, first.formerName, spec))

    familyCtorsAdded (env, ctors, shapes, at, family, spec) = match shapes
        [] => Success(value = env)
        [first, ...rest] => upon (ctorAdded (env, ctors, first, at, family, spec), \withCtor => familyCtorsAdded (withCtor, ctors, rest, satAdd at 1, family, spec))

    ctorAdded (env, ctors, shape, at, family, spec) = upon (findCtor (ctors, shape.shapeName), \ctor => Environment::add (env, Decl(name = ctor.name, params = ctor.params, ty = ctor.ty, body = Constructor (Ctor(ctorFamily = family, ctorIndex = at, ctorParams = Recursors::paramCount spec, ctorFields = listLength shape.shapeFields)))))

    (** The claimed constructor named `name`, so its declaration is the
        one installed. *)
    findCtor (ctors, name) = named (ctors, name, \ctor => ctor.name, "the block does not declare constructor `${name}`")

    recursorsAdded (env, spec, d, nOrig, nests) = match d < listLength spec.specFormers
        true => upon (recursorDecl (env, spec, d, nOrig, nests), \decl => upon (Environment::add (env, decl), \withRec => recursorsAdded (withRec, spec, satAdd d 1, nOrig, nests)))
        false => Success(value = env)

    (** The recursor of family `d`: its own family and name when the
        family is the declaration's own; the restored auxiliary name
        `main.rec_n` eliminating the first family otherwise. *)
    recursorDecl (env, spec, d, nOrig, nests) = upon (Nesting::restore (nests, Recursors::recursorType (env, spec, d)), \ty => upon (Nesting::restoreRules (nests, Recursors::rules (env, spec, d)), \rules => Success(value = Decl(name = recursorName (spec, d, nOrig), params = spec.specRecParams, ty = ty, body = Recursor (eliminatorOf (spec, d, nOrig, rules))))))

    eliminatorOf (spec, d, nOrig, rules) = Eliminator(elimFamily = eliminatorFamily (spec, d, nOrig), elimAll = originalNames (spec, nOrig), elimMotives = Recursors::familyCount spec, elimParams = Recursors::paramCount spec, elimIndices = Recursors::indexCount (spec, d), elimMinors = Recursors::minorCount spec, elimRules = rules, elimK = k spec)

    (** Family `d`'s own `pick` when the declaration owns it, else `aux`; "?" past the group. *)
    ownedOrAux (spec, d, nOrig, pick, aux) = match listGet (spec.specFormers, d)
        Success former => match d < nOrig
            true => pick former
            false => aux
        Error _ => "?"

    recursorName (spec, d, nOrig) = ownedOrAux (spec, d, nOrig, \former => former.formerRec, auxRecName (spec, d, nOrig))

    auxRecName (spec, d, nOrig) = picked (spec.specFormers, 0, \main => "${main.formerName}.rec_${toString (satAdd (satSub d nOrig) 1)}", "?")

    eliminatorFamily (spec, d, nOrig) = ownedOrAux (spec, d, nOrig, \former => former.formerName, auxFamily (spec))

    auxFamily (spec) = picked (spec.specFormers, 0, \main => main.formerName, "?")

    originalNames (spec, nOrig) = mapList (Terms::prefix (spec.specFormers, nOrig), \former => former.formerName)

    (** Check an exported inductive block — one family, a mutual group,
        or a group one of whose constructors nests in an already checked
        family: lower the nesting, derive every family, constructor and
        recursor from the type formers and constructor types alone, add
        those, and refuse the block unless every claim — counts, group
        inventory, ownership, flags, nested count, each recursor's
        universe parameters, motive count, indices, type, rules and K —
        is the one derived. *)
    export add (env, block) = upon (firstFamily (block.formers), \family => upon (firstRecursor (block), \claimed => upon (sourceChecked (env, block.formers, block.ctors), \_ => upon (Nesting::lower (env, block.formers, block.ctors, family.familyParams), \lowered => checked (env, block, family, claimed, lowered)))))

    sourceChecked (env, formers, ctors) = upon (sortedDecls (env, formers), \_ => upon (scratch (env, formers), \withAxioms => sortedDecls (withAxioms, ctors)))

    checked (env, block, family, claimed, lowered) = upon (derive (env, lowered.loweredFormers, lowered.loweredCtors, family.familyParams, claimedElim (block.formers, claimed)), \spec => upon (install (env, block.formers, block.ctors, spec, lowered.loweredNests), \installed => agreed (installed, block, spec)))

    firstFamily (formers) = match formers
        [] => Error(message = "an inductive block with no family")
        [first, ...rest] => match first.body
            TypeFormer family => Success(value = family)
            other => Error(message = "`${first.name}` is not a type former")

    firstRecursor (block) = headOf (block.recursors, "an inductive block with no recursor")

    claimedElim (formers, claimed) = match formers
        [first, ...rest] => match listLength claimed.params == satAdd (listLength first.params) 1
            true => listGet (claimed.params, 0) ?: ""
            false => ""
        [] => ""

    agreed (installed, block, spec) = upon (inventoried (block, spec), \ok => upon (familiesAgree (installed, block.formers), \a => upon (ctorsAgree (installed, block.ctors), \b => upon (recsAgree (installed, block.recursors), \c => Success(value = installed)))))

    (** The block claims exactly what the group derives: as many
        constructors and recursors, each under a distinct name, so every
        claim is one derivation's and every derivation is claimed. *)
    inventoried (block, spec) = upon (sameCount ("constructors", listLength block.ctors, originalShapes (spec, listLength block.formers)), \a => upon (sameCount ("recursors", listLength block.recursors, listLength spec.specFormers), \b => claimedDistinct (block)))

    originalShapes (spec, nOrig) = foldList (Terms::prefix (spec.specFormers, nOrig), 0, \(total, former) => satAdd total (listLength former.formerShapes))

    sameCount (what, claimed, derived) = whenHolds (claimed == derived, true, "the block claims ${toString claimed} ${what} where the kernel derives ${toString derived}")

    (** Whether every item's name differs from the others'. *)
    distinctNames (decls) = Environment::distinct (mapList (decls, \decl => decl.name))

    claimedDistinct (block) = whenHolds (distinctNames (block.formers) && distinctNames (block.ctors) && distinctNames (block.recursors), true, "the block claims one name twice")

    familiesAgree (env, formers) = each (formers, true, \(_, former) => familyAgrees (env, former))

    (** The exported body's metadata and printed form against the derived one. *)
    bodyAgrees (env, name, body) = match Environment::find (env, name)
        Success decl => same (name, DeclarationBodies::metadata (body, decl.body), DeclarationBodies::showBody body, DeclarationBodies::showBody decl.body)
        Error message => Error(message = message)

    familyAgrees (env, former) = match former.body
        TypeFormer family => bodyAgrees (env, former.name, TypeFormer family)
        other => Error(message = "`${former.name}` is not a type former")

    ctorsAgree (env, ctors) = each (ctors, true, \(_, ctor) => ctorAgrees (env, ctor))

    ctorAgrees (env, ctor) = bodyAgrees (env, ctor.name, ctor.body)

    recsAgree (env, recs) = each (recs, true, \(_, rec) => recursorAgrees (env, rec))

    recursorAgrees (env, claimed) = match Environment::find (env, claimed.name)
        Success decl => upon (same (claimed.name, sameNames (claimed.params, decl.params), "universe parameters [${DeclarationBodies::joined claimed.params}]", "universe parameters [${DeclarationBodies::joined decl.params}]"), \a => upon (typeAgrees (claimed, decl), \b => upon (same (claimed.name, DeclarationBodies::metadata (claimed.body, decl.body), DeclarationBodies::showBody claimed.body, DeclarationBodies::showBody decl.body), \c => rulesAgree (claimed, claimed.body, decl.body))))
        Error message => Error(message = "`${claimed.name}` is not the recursor the kernel derives, `${message}`")

    (** Compare structured facts; text is only the refusal diagnostic. *)
    same (name, agrees, claimed, derived) = whenHolds (agrees, true, "`${name}` as exported claims ${claimed}, the kernel derives ${derived}${collisionNote (claimed, derived)}")

    collisionNote (claimed, derived) = match claimed == derived
        true => " (the underlying metadata differ despite identical printed descriptions)"
        false => ""

    (** The derived term is the claimed one; text is only the refusal. *)
    termAgrees (claim, mine, theirs) = whenHolds (Terms::equal (mine, theirs), true, "${claim} `${Terms::show (mine, [])}`, the kernel derives `${Terms::show (theirs, [])}`")

    typeAgrees (claimed, decl) = termAgrees ("`${claimed.name}` as exported has type", claimed.ty, decl.ty)

    rulesAgree (claimed, claimedBody, derivedBody) = match claimedBody
        Recursor mine => match derivedBody
            Recursor theirs => rulesPaired (claimed, mine.elimRules, theirs.elimRules)
            other => Error(message = "`${claimed.name}` is not a recursor")
        other => Error(message = "`${claimed.name}` is not a recursor")

    rulesPaired (claimed, rules, derived) = match rules
        [] => whenHolds (isEmpty derived, true, "`${claimed.name}` has fewer rules than constructors")
        [first, ...rest] => rulePaired (claimed, first, rest, derived)

    rulePaired (claimed, first, rest, derived) = match derived
        [] => Error(message = "`${claimed.name}` has more rules than constructors")
        [mine, ...more] => upon (ruleAgrees (claimed, first, mine), \ok => rulesPaired (claimed, rest, more))

    ruleAgrees (claimed, rule, derived) = termAgrees ("`${claimed.name}`'s rule for `${rule.ruleCtor}` as exported is", rule.ruleRhs, derived.ruleRhs)
