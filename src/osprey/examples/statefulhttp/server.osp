// ============================================================================
//  Osprey stateful HTTP server — STATE AT EVERY LEVEL OF THE API, via
//  algebraic effects. Run it, then point the TUI client at it:
//
//      osprey src/osprey/examples/statefulhttp/server.osp --run      # terminal 1
//      osprey src/osprey/examples/statefulhttp/tui.osp --run         # terminal 2
//
//  The request handler is PURE: it only `perform`s. All mutable state lives in
//  the effect handlers installed by `main`, one per architectural layer:
//
//      Persist  (infrastructure)  owns the on-disk snapshot   — writes a file
//      Metrics  (server runtime)  owns the request counter     — bumped per call
//      Db       (application)     owns the task table           — the domain data
//
//  Handler-owned state is just a `mut` the handler closes over: `perform`
//  threads a value through it and the performer resumes — a real State effect.
//  The effects even cross the C HTTP-callback boundary: the server runs the
//  pure handler on its accept thread and the `perform`s resolve to these
//  handlers. Swap the handlers and the same routes run against a mock.
// ============================================================================

effect Db {
    /// Append a task and return its new id.
    add: fn(string) -> int
    /// Render the current task table.
    list: fn() -> string
    /// Count the tasks currently stored.
    count: fn() -> int
}
effect Metrics {
    /// Record one served request for `route`.
    hit: fn(string) -> Unit
    /// Read the total requests served since boot.
    served: fn() -> int
}
effect Persist {
    /// Durably write a snapshot, returning the number of bytes written.
    flush: fn(string) -> int
}
effect Log {
    /// Record an informational `message` about server activity.
    info: fn(string) -> Unit
}

// ---- ANSI pizazz (pure string wrappers) ------------------------------------
fn esc(code: string, s: string) = "\e[${code}m${s}\e[0m"
fn c256(n: string, s: string) = esc("38;5;${n}", s)
// Counters explicitly keep their previous value on arithmetic overflow.
fn inc(x) = satAdd(x, 1)
fn mn(a, b) = match a < b { true => a  false => b }

// A colored, fixed-width method badge (black text on a colored block).
fn badge(method: string) = match method {
    "POST" => "\e[1;30;48;5;213m POST \e[0m"
    "GET"  => "\e[1;30;48;5;117m GET  \e[0m"
    _      => "\e[1;30;48;5;250m ${method} \e[0m"
}

// A bar of N filled blocks (capped) — a live gauge of how many tasks exist.
fn blocks(i: int, n: int) = match i < n {
    true  => "▰" + blocks(inc(i), n)
    false => ""
}
fn gauge(n: int) = c256("213", blocks(0, mn(n, 28)))

fn divider() = c256("239", "  ──────────────────────────────────────────────────────")

// A six-line ASCII "OSPREY" with a cyan→magenta gradient (one color per row).
fn art() =
    c256("51",  "   ██████╗ ███████╗██████╗ ██████╗ ███████╗██╗   ██╗") + "\n" +
    c256("45",  "  ██╔═══██╗██╔════╝██╔══██╗██╔══██╗██╔════╝╚██╗ ██╔╝") + "\n" +
    c256("39",  "  ██║   ██║███████╗██████╔╝██████╔╝█████╗   ╚████╔╝ ") + "\n" +
    c256("99",  "  ██║   ██║╚════██║██╔═══╝ ██╔══██╗██╔══╝    ╚██╔╝  ") + "\n" +
    c256("135", "  ╚██████╔╝███████║██║     ██║  ██║███████╗   ██║   ") + "\n" +
    c256("171", "   ╚═════╝ ╚══════╝╚═╝     ╚═╝  ╚═╝╚══════╝   ╚═╝   ")

// The whole startup banner as one string (one print, no consecutive prints).
fn banner() =
    "\n" + art() + "\n\n  " +
    c256("46", "●") + esc("2", " live  ") + esc("1", c256("159", "http://127.0.0.1:8080")) +
    esc("2", "   ·   state lives in algebraic-effect handlers") + "\n" +
    divider() + "\n  " +
    badge("GET") + "  " + esc("2", "/") + "         list tasks\n  " +
    badge("GET") + "  " + esc("2", "/stats") + "    server metrics\n  " +
    badge("POST") + " " + esc("2", "/tasks") + "    add a task " + esc("2", "(body = task text)") + "\n" +
    divider()

// The one place that touches the disk: every layer that snapshots text (the
// Persist effect and the access log) writes through it and reads the outcome.
fn saveFile(path: string, contents: string) = match writeFile(path, contents) {
    Success => length(contents)
    Error => -1
}

fn textResp(status: int, bodyText: string) = HttpResponse {
    status: status,
    headers: "Content-Type: text/plain",
    contentType: "text/plain",
    streamFd: -1,
    isComplete: true,
    partialBody: bodyText
}

// Adding a task touches every layer — Db records it, Persist writes the new
// snapshot to disk — yet not one socket, file descriptor or mutable field
// appears in this pure orchestration.
fn onPost(body: string) = {
    let id = perform Db.add(body)
    let snap = perform Db.list()
    let written = perform Persist.flush(snap)
    perform Log.info(badge("POST") + "  " + esc("92", "✚") + " " + esc("1", esc("93", "\"${body}\"")) + "  " + esc("36", "#${toString(id)}") + "  " + gauge(id) + esc("2", "  ${toString(written)}B"))
    textResp(201, "created task #${toString(id)}\n")
}

fn onGet(path: string) = {
    perform Log.info(badge("GET") + " " + esc("2", path) + esc("2", "  ·  ${toString(perform Metrics.served())} served"))
    match path {
        "/stats" => textResp(200, "requests=${toString(perform Metrics.served())} tasks=${toString(perform Db.count())}\n")
        _        => textResp(200, perform Db.list())
    }
}

fn handleReq(method: string, path: string, _headers: string, body: string) = {
    perform Metrics.hit(path)
    match method {
        "POST" => onPost(body)
        _      => onGet(path)
    }
}

// httpListen returns once the accept thread is up; this keeps `main` (and the
// handler scope that owns all state) alive while requests are served.
fn serveForever() -> Unit = {
    sleep(3600000)
    serveForever()
}

fn main() -> int {
    mut logBuf = ""       // Log layer      (access log, mirrored to a file)
    mut diskBytes = 0     // Persist layer  (infrastructure)
    mut requests = 0      // Metrics layer  (server runtime)
    mut tasks = ""        // Db layer       (application data)
    mut taskCount = 0     // Db layer

    handle Persist {
        flush snap => {
            diskBytes = saveFile("/tmp/osprey_tasks.db", snap)
            diskBytes
        }
    }
    handle Metrics {
        hit _p  => { requests = inc(requests) }
        served => requests
    }
    handle Db {
        add t => {
            taskCount = inc(taskCount)
            tasks = "${tasks}#${toString(taskCount)} ${t}\n"
            taskCount
        }
        list  => tasks
        count => taskCount
    }
    handle Log {
        info m => {
            logBuf = "${logBuf}${m}\n"
            let _w = saveFile("/tmp/osprey_server.log", logBuf)
            print("  ${m}")
        }
    }
    let listening = andThen(httpCreateServer(8080, "127.0.0.1"), |srv| => httpListen(srv, handleReq))
    match listening {
        Success => {
            print(banner())
            serveForever()
            0
        }
        Error { message } => {
            print("cannot listen on 127.0.0.1:8080: ${message}")
            1
        }
    }
}
