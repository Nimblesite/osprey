effect ctl ask() : int

fun work()
  ask() + 1

val label = "done="
val replace = handler
  return(n : int) label ++ n.show
  ctl ask() resume(41)
val around = handler
  return(n : int) label ++ n.show
  ctl ask() resume(41) ++ "!"
val stop = handler
  return(n : int) label ++ n.show
  ctl ask() "stopped"

pub fun main()
  println(replace(work))
  println(around(work))
  println(stop(work))
