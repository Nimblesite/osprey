effect Ask
    control value : Unit => int
work () = (perform Ask.value () + 1) 

replace = handler Ask
    value => resume 41
around = handler Ask
    value => ((resume 41) + 100) 
noResume = handler Ask
    value => 0
deadResume = handler Ask
    value => match false
        true => resume 0
        false => 0

report () =
    replacement = replace work
    resumed = around work
    returned = noResume work
    deadBranch = deadResume work
    "replace=${replacement}\nresume=${resumed}\nno-resume=${returned}\ndead-resume=${deadBranch}"

printExact report
