effect ValueAsk { value: fn() -> int }
effect ControlAsk { control value: fn() -> int }
fn valueWork() = (perform ValueAsk.value() + 1) 
fn controlWork() = (perform ControlAsk.value() + 1) 
let prefix = "done="
let replace = handler ValueAsk {
    value => 41
    return n => "${prefix}${n}"
}
let around = handler ControlAsk {
    value => "${resume(41)}!"
    return n => "${prefix}${n}"
}
let stop = handler ControlAsk {
    value => "stopped"
    return n => "${prefix}${n}"
}
fn report() = {
    "${replace(valueWork)}\n${around(controlWork)}\n${stop(controlWork)}"
}
printExact(report)
