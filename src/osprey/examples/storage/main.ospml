// Osprey Storage's C boundary, exported as `osprey_app_start` and
// `osprey_app_dispatch` for any Osprey Native host ([NATIVE-HOSTS-NEUTRAL]).
// Strings the host passes in are borrowed for the call; `native_slice`
// answers host-held slices, such as the walk the host measured into `measured`.
namespace app

import ui::Runtime
import storage::App

extern native_slice (key : string) -> string

start source =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::start (source, App::initial, App::regions, App::save, App::theme ())

dispatch (saved, event) =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::dispatch (saved, event, App::update, App::regions, App::save, App::restore)
