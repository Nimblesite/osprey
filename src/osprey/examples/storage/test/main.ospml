// Osprey Storage driven through the typed host event boundary every host calls
// ([NATIVE-SHM-EVENT], [NATIVE-SHM-BOUNDARY]) with fixture walks, so its rules and screens are
// checked on every operating system with no disk and no window ([NATIVE-APPS-ALL],
// [UI-EFFECTS-MEASURE]). The host the tests stand in for answers the `measured` slice from a
// fixture and reads each step's frame back through the rows the surface drew.
namespace storagetests

import ui::Doc
import ui::Hosting
import ui::Lists
import ui::Requests
import ui::Runtime
import ui::Surfaces
import storage::App
import storage::Browse
import storage::Disk
import uitest::Drive
import uitest::Read
import uitest::Views

home = "C:\\Users\\ada"

// One child as the host writes it into the measured slice; `kind` is `folder`, `hidden`, `file`, `link` or `sealed`.
entry (parent, separator, name, bytes, shown, kind) = JsonObject [Doc::str ("name", name), Doc::str ("path", parent + separator + name), Doc::num ("bytes", bytes), Doc::num ("visible", shown), Doc::num ("items", 3), Doc::bit ("hidden", kind == "hidden"), Doc::bit ("folder", kind == "folder" || kind == "hidden" || kind == "sealed"), Doc::bit ("link", kind == "link"), Doc::bit ("guarded", kind == "sealed")]

child (name, bytes, shown, kind) = entry (home, "\\", name, bytes, shown, kind)

folderDoc (path, missing, problem, unreadable, entries) = JsonObject [Doc::str ("path", path), Doc::str ("error", problem), Doc::bit ("missing", missing), Doc::bit ("truncated", false), Doc::num ("unreadable", unreadable), Doc::num ("bytes", 0), Doc::num ("visible", 0), Doc::num ("items", 0), JsonMember "volume" (JsonObject [Doc::str ("name", "Windows"), Doc::num ("total", 512000000000), Doc::num ("available", 128000000000)]), JsonMember "entries" (JsonArray entries)]

slice folders = Doc::write (JsonObject [JsonMember "folders" (JsonArray folders)])

homeWalk () = slice [folderDoc (home, false, "", 2, [child ("AppData", 45000000000, 0, "hidden"), child ("Videos", 30000000000, 30000000000, "folder"), child ("notes.txt", 4096, 4096, "file"), child ("OneDrive", 0, 0, "link"), child ("Private", 0, 0, "sealed"), child ("Code", 12000000000, 2000000000, "folder")])]

macWalk () = slice [folderDoc ("/Users/ada", false, "", 0, [entry ("/Users/ada", "/", "Movies", 1500000, 1500000, "folder")])]

goneWalk () = slice [folderDoc (home, true, "", 0, [])]

// The surface the tests drive, and the host-held walk the next step reads.
mut driven = Drive::idle (App::program (), Browse::launched ("", ""))
mut measured = ""

// Keeps the driven surface the last step drew, and the walk the host holds.
effect Host
    drive : uitest::Driven<storage::Store, storage::StorageAction> => Unit
    holding : string => Unit

bench work =
    handle Host
        drive next => driven := next
        holding text => measured := text
    Runtime::guarded work

// The host a driven test stands in for: the measured slice answered as the fixture holds it.
hosted work =
    handle ui::Slices
        fetch _ => measured
    bench work

// The step a host call leaves: the surface kept, its frame read back and the clock moved on. This
// restates uitest's own bookkeeping because Storage's tests launch with each person's real home
// folder, while `Drive::launched` fixes its home at `/home/tester`.
stepped (d, held) = d(drivenSurface = held, drivenSeen = Read::seen (Surfaces::seen (held, d.drivenProgram), held.surfaceAsked), drivenNow = satAdd d.drivenNow 1)

// Storage launched on `platform` for a person whose home is `folder`, opened with `arguments`.
launchWith (platform, folder, arguments) =
    start = Drive::idle (App::program (), Browse::launched ("", ""))
    given = foldList (arguments, start.drivenSurface, \(held, text) => Surfaces::argued (held, text))
    hosted (\() => perform Host.drive (stepped (start, ui::Views::quiet (\() => Hosting::opened (given, start.drivenProgram, start.drivenNow, 0, platform, folder, false)))))

// One typed host event, sent the way a host sends it.
post event = hosted (\() => perform Host.drive (Drive::sent (driven, event)))

// One host event for the control numbered `ordinal`, delivering `words`.
controlTouch (d, ordinal, words) = ui::Touch(touchNow = d.drivenNow, touchKind = Hosting::control, touchOrdinal = ordinal, touchWords = words, touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = false, touchShift = false)

press label = hosted (\() => perform Host.drive (Drive::press (driven, label)))

// Words sent to the control labelled `label`, as a typed value, a key or a switch's new state.
typed (label, words) = hosted (\() => perform Host.drive (Drive::choose (driven, label, words)))

// The capability of `ticket` completed: `ok` with its result `text`, or its reason.
complete (ticket, ok, text) = hosted (\() => perform Host.drive (Drive::completed (driven, ticket, ok, text)))

// The chooser of `ticket` answered with `path`; an empty path cancels it.
chose path = hosted (\() => perform Host.drive (Drive::chosen (driven, "choose", path)))

// ---- reading the last step's frame ----

seen () = driven.drivenSeen

controls () = driven.drivenSeen.renderedControls

control label = Views::control (seen (), label)

storeNow () = driven.drivenSurface.surfaceSession.sessionStore

stageOf store = store.walk.walkStage

stageNow () = stageOf (storeNow ())

openOf store = store.place.openFolder

openNow () = openOf (storeNow ())

// The regions the program draws, in order, as the boundary lowered them.
regionKeys () = hosted (\() => join (mapList ((App::program ()).programRender (storeNow (), storeNow (), [], []), \region => region.snapshotKey)) ",")

// The requests the last step sent, as `kind ticket`, in order.
askedKinds () = join (mapList (driven.drivenSurface.surfaceAsked, \request => "${Requests::kind (request.capability)} ${request.ticket}")) ";"

measureOf () = Lists::find (driven.drivenSurface.surfaceAsked, \request => Requests::kind (request.capability) == "measure-folders")

// One field of a measure request, or "" when the last step asked none.
measureField (found, field) = match found
    Error _ => ""
    Success request => match request.capability
        ui::MeasureFolders folders limit deadline sliceName => match field
            "folders" => join folders ","
            "slice" => sliceName
            "limit" => toString limit
            "deadline" => toString deadline
            _ => ""
        _ => ""

// The folders of the last step's measure request, comma-joined.
measuringNow () = measureField (measureOf (), "folders")

wordsIn words = expect (contains (Views::texts (seen ())) words, true)

shows label = expect (Drive::shows (driven, label), true)

noProblems () = expect (driven.drivenSurface.surfaceProblem, "")

askedNothing () = expect (length driven.drivenSurface.surfaceAsked, 0)

// A step that changed nothing redraws the same store and writes no slice.
changedNothing () =
    askedNothing ()
    expect (length driven.drivenSurface.surfaceWritten, 0)

// ---- the listing's rows, read and driven as a host reads them ----

isEntry binding = match binding
    ui::ChoiceInput action => enters action
    _ => false

enters action = match action
    storage::PickEntry => true
    _ => false

// ---- the told trees ([NATIVE-SHM-NODES]): what a host rebuilds from the frame's rows before it draws ----

// The frame's told trees, rebuilt the way every host rebuilds them.
trees () = hosted (\() => Read::trees (Surfaces::seen (driven.drivenSurface, driven.drivenProgram)))

// The region told under `key`, or an empty record when the frame holds none.
regionTold key = match Lists::find (trees (), \told => Read::name told == "region" && Read::words (Read::inside told, "key") == key)
    Success found => found
    Error _ => ui::ToldRecord(recordName = "", members = [])

// The component of kind `name` under `tree`, depth first, or an empty record when none is told.
kinded (name, tree) = Read::kinded ([tree], name, \_ => true)

// The component of kind `name` labelled `label` in the open folder's region, or an empty record.
labelled (name, label) = match Lists::find (filterList (Read::under (regionTold "folder"), \told => Read::words (Read::inside told, "kind") == name), \told => Read::words (Read::inside told, "label") == label)
    Success found => found
    Error _ => ui::ToldRecord(recordName = "", members = [])

// The entry records of the rows told under `region`, in drawing order.
rowsIn region = Read::inside (Read::member (Read::inside (kinded ("rows", regionTold region)), "rows"))

// The keys of the listing's rows in drawing order.
listingKeys () = mapList (rowsIn "listing", \entry => Read::words (Read::inside entry, "key"))

// The keys of the sidebar's place rows, in drawing order.
placeKeys () = mapList (rowsIn "places", \entry => Read::words (Read::inside entry, "key"))

// Chooses the listing row keyed `key`, from the frame `d` drew, as a person clicking it: the rows control holds the frame's one entry-choosing binding, and the row's key rides in the words.
chooseIn (d, key) = hosted (\() => perform Host.drive (Drive::sent (d, controlTouch (d, Lists::position (d.drivenSurface.surfaceBound, isEntry), key))))

// The last names of the listing rows' keys, in order.
rowNames () = join (mapList (listingKeys (), \key => Disk::name ("windows", key)), ",")

// The symbol leading the listing row keyed `key`, or "" when it is not drawn.
symbolOf key = match Lists::find (rowsIn "listing", \entry => Read::words (Read::inside entry, "key") == key)
    Success entry => Read::words (Read::inside entry, "symbol")
    Error _ => ""

// The symbol leading the listing row named `name`.
rowSymbol name = match Lists::find (listingKeys (), \key => Disk::name ("windows", key) == name)
    Success key => symbolOf key
    Error _ => ""

// ---- the tests' scenarios ----

// Storage launched on Windows for a person whose home is `home`.
launch () = launchWith ("windows", home, [])

// A launch whose first walk completed with the host holding `text` as the measured slice.
walkedIn text =
    launch ()
    perform Host.holding text
    complete ("walk:1", true, "")

walked () = walkedIn (homeWalk ())

test ("launch opens home and asks the host to measure it", \() => bench (\() =>
    launch ()
    expect (regionKeys (), "root,places,folder,listing")
    expect (askedKinds (), "measure-folders walk:1")
    expect (measuringNow (), home)
    expect (measureField (measureOf (), "slice"), "measured")
    expect (parseInt (measureField (measureOf (), "limit")) ?: 0, 20000)
    expect (parseInt (measureField (measureOf (), "deadline")) ?: 0, 120000)
    noProblems ()))
test ("a folder named at launch opens first, and home stays in the sidebar", \() => bench (\() =>
    launchWith ("windows", home, ["D:\\Media"])
    expect (measuringNow (), "D:\\Media")
    shows "Home"
    shows "Media"))
test ("the listing shows progress until the walk completes", \() => bench (\() =>
    launch ()
    shows "Measuring ada…"))
test ("a finished walk redraws only the listing, largest first, with unreadable folders last", \() => bench (\() =>
    walked ()
    changedNothing ()
    expect (rowNames (), "AppData,Videos,Code,notes.txt,OneDrive,Private")
    expect (rowSymbol ("Private"), "lock")
    expect (rowSymbol ("Videos"), "folder")
    expect (rowSymbol ("notes.txt"), "document")
    noProblems ()))
test ("switching hidden items off leaves them out of the ranking", \() => bench (\() =>
    launch ()
    perform Host.holding (homeWalk ())
    complete ("walk:1", true, "")
    typed ("Hidden items", "false")
    changedNothing ()
    expect (rowNames (), "Videos,Code,notes.txt,OneDrive,Private")
    wordsIn "Hidden items are left out."))
test ("a link is marked as a link and its target is not counted", \() => bench (\() =>
    walked ()
    expect (rowSymbol ("OneDrive"), "external")
    wordsIn "its target is not counted"))
test ("folders the walk could not read are counted in a note", \() => bench (\() =>
    walked ()
    wordsIn "2 folders here could not be read and are not counted. They belong to Windows or to another user."))
test ("a rescan cancels the running walk, and the old walk's completion changes nothing", \() => bench (\() =>
    launch ()
    press "Rescan"
    expect (askedKinds (), "cancel cancel:1;measure-folders walk:2")
    perform Host.holding (homeWalk ())
    complete ("walk:1", true, "")
    changedNothing ()
    expect (stageNow (), "measuring")))
test ("Up from a folder measures the folder that encloses it", \() => bench (\() =>
    launch ()
    press "Up"
    expect (measuringNow (), "C:\\Users")))
test ("Up at the top of a drive is disabled and asks for nothing", \() => bench (\() =>
    launchWith ("windows", "C:\\", [])
    up = control "Up"
    expect (up.controlKind, "button")
    expect (up.controlHint, "chevron")
    expect (Read::words (Read::inside (labelled ("button", "Up")), "role"), "plain")
    expect (up.controlEnabled, false)
    press "Up"
    askedNothing ()))
test ("a chosen folder joins the places and is measured", \() => bench (\() =>
    launch ()
    press "Choose Folder…"
    expect (askedKinds (), "choose-folder choose")
    chose "D:\\Media"
    expect (measuringNow (), "D:\\Media")
    expect (Lists::any (placeKeys (), \key => key == "D:\\Media"), true)))
test ("a cancelled choice changes nothing", \() => bench (\() =>
    launch ()
    chose ""
    changedNothing ()
    expect (openNow (), home)))
test ("a folder row opens that folder and a file row does not", \() => bench (\() =>
    launch ()
    perform Host.holding (homeWalk ())
    complete ("walk:1", true, "")
    after = driven
    chooseIn (after, home + "\\Videos")
    expect (measuringNow (), home + "\\Videos")
    chooseIn (after, home + "\\notes.txt")
    askedNothing ()
    noProblems ()))
test ("a failed walk says why", \() => bench (\() =>
    launch ()
    complete ("walk:1", false, "Access is denied.")
    expect (Read::words (Read::inside (kinded ("empty", regionTold "listing")), "detail"), "Access is denied.")))
test ("a folder that disappeared says it is gone", \() => bench (\() =>
    walkedIn (goneWalk ())
    wordsIn "This folder is gone"))
test ("words and units follow the platform", \() => bench (\() =>
    launchWith ("macos", "/Users/ada", [])
    perform Host.holding (macWalk ())
    complete ("walk:1", true, "")
    wordsIn "Show in Finder"
    wordsIn "1.5 MB"
    walked ()
    wordsIn "Show in File Explorer"
    wordsIn "27.9 GB"))
test ("Windows paths climb to the top of their drive or share", \() =>
    expect (Disk::parent ("windows", "C:\\Users\\ada"), "C:\\Users")
    expect (Disk::parent ("windows", "C:\\Users"), "C:\\")
    expect (Disk::parent ("windows", "C:\\"), "C:\\")
    expect (Disk::isRoot ("windows", "C:\\"), true)
    expect (Disk::isRoot ("windows", "C:\\Users"), false)
    expect (Disk::parent ("windows", "\\\\server\\share\\photos"), "\\\\server\\share\\")
    expect (Disk::isRoot ("windows", "\\\\server\\share"), true)
    expect (join (Disk::trail ("windows", "C:\\Users\\ada")) "|", "C:\\|C:\\Users|C:\\Users\\ada")
    expect (Disk::name ("windows", "C:\\Users\\ada"), "ada")
    expect (Disk::name ("windows", "C:\\"), "C:\\"))
test ("other systems' paths climb to /", \() =>
    expect (Disk::parent ("linux", "/home/ada"), "/home")
    expect (Disk::parent ("linux", "/home"), "/")
    expect (Disk::isRoot ("macos", "/"), true)
    expect (join (Disk::trail ("macos", "/Users/ada")) "|", "/|/Users|/Users/ada"))
test ("sizes count in the units each platform shows", \() =>
    expect (Disk::formatBytes ("windows", 1536), "1.5 KB")
    expect (Disk::formatBytes ("macos", 1500), "1.5 KB")
    expect (Disk::formatBytes ("windows", 1073741824), "1.0 GB")
    expect (Disk::formatBytes ("linux", 999), "999 B")
    expect (Disk::formatBytes ("windows", 0 - 1), "unknown")
    expect (Disk::formatCount 1234567, "1,234,567")
    expect (Disk::shareText (1, 1000), "< 1%")
    expect (Disk::shareText (0, 1000), "0%"))

// [UI-STORE]: the session is fully held in the library — what the boundary kept is restored exactly by
// replaying the same launch and the same typed events through the three entry points: no document, no
// host-held state, and the redrawn frame tells the same regions.
restoredSession () =
    launch ()
    perform Host.holding (homeWalk ())
    complete ("walk:1", true, "")
    typed ("Hidden items", "false")
    storeNow ()

test ("the session document restores the store it saved", \() => bench (\() =>
    saved = restoredSession ()
    listing = listingKeys ()
    restored = restoredSession ()
    expect (structuralEquals (saved, restored), true)
    expect (join (listingKeys ()) "|", join listing "|")))

test ("the session document restores the store it saved (extra: the restored session answers a rescan the same way)", \() => bench (\() =>
    walkedStore = restoredSession ()
    press "Rescan"
    rescanned = storeNow ()
    rescannedAsk = askedKinds ()
    replayed = restoredSession ()
    expect (structuralEquals (walkedStore, replayed), true)
    press "Rescan"
    expect (structuralEquals (storeNow (), rescanned), true)
    expect (askedKinds (), rescannedAsk)))
