"""The harness every case in `clients.cpython` and `real_cases.cpython` runs under: build, launch, report.

It keeps the suite's case registries, compiles the server for one memory backend,
waits for its listener, runs every registered case against it, and reports one
`ok <backend>/<case>` line each plus the totals. Run the suite through
`clients.cpython`, which registers the cases and calls `main`.

Two lanes: the fixture table (`gc` and `arc`, every `case`), which CI runs, and
the real weights (`real`, every `real_case`), which runs only when
`OSPREY_QWEN_GGUF` names a GGUF that exists; otherwise each real case prints a
`skip real/<case>` line, never a silent pass. The explicit `pydantic` lane
requires real weights and runs local coding/judge tests; it is never selected by default.
"""
import importlib.machinery
import os
import subprocess
import sys
import threading
import time
import types
import traceback
from pathlib import Path

import httpx
import ollama
import openai

HERE = Path(__file__).resolve().parent
PROJECT = HERE.parent
ROOT = PROJECT.parents[5]
COMPILER = Path(os.environ.get("OSPREY_COMPILER", ROOT / "target/debug/osprey"))
MODEL = "qwen3.8:27b"
CONTEXT = 65536
PORTS = {"gc": 11535, "arc": 11536, "real": 11537, "pydantic": 11538}
WEIGHTS = os.environ.get("OSPREY_QWEN_GGUF", "")
READY_SECONDS = {"gc": 60.0, "arc": 60.0, "real": 300.0, "pydantic": 300.0}
LANE_SECONDS = {"gc": 600.0, "arc": 600.0, "real": 900.0, "pydantic": 900.0}
"""The wall-clock cap on one lane: the server is killed when it runs out, so a hung
model never holds the GPU past it."""
READ_FILE = {
    "type": "function",
    "function": {
        "name": "read_file",
        "description": "Read one file from the workspace",
        "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
    },
}
RUN_TESTS = {
    "type": "function",
    "function": {
        "name": "run_tests",
        "description": "Run one test suite",
        "parameters": {"type": "object", "properties": {"suite": {"type": "string"}}, "required": ["suite"]},
    },
}
READ_PROMPT = "read the readme"
CASES = []
REAL_CASES = []
PYDANTIC_CASES = []


def case(fn):
    """Register one named case; the suite runs every case on every table backend."""
    CASES.append(fn)
    return fn


def real_case(fn):
    """Register a case that needs the real weights; it runs on the `real` lane only."""
    REAL_CASES.append(fn)
    return fn


def pydantic_case(fn):
    """Explicit local-only lane: never part of default or CI case selection."""
    PYDANTIC_CASES.append(fn)
    return fn


def base(port):
    return f"http://127.0.0.1:{port}"


def client(port):
    return ollama.Client(host=base(port), timeout=120.0)


def openai_client(port):
    return openai.OpenAI(base_url=base(port) + "/v1", api_key="osprey-local", timeout=120.0)


def load(name):
    """Load a sibling `.cpython` module by name, since its suffix is not `.py`."""
    loader = importlib.machinery.SourceFileLoader(name, str(HERE / f"{name}.cpython"))
    module = types.ModuleType(name)
    module.__file__ = str(HERE / f"{name}.cpython")
    loader.exec_module(module)
    return module


def reference():
    """The independent CPython implementation of the fixture model the server installs."""
    return load("model_reference")


def build(memory):
    binary = ROOT / "target" / "llms" / "qwen-server" / f"server-{memory}"
    binary.parent.mkdir(parents=True, exist_ok=True)
    done = subprocess.run(
        [str(COMPILER), str(PROJECT), "--compile", f"--memory={memory}", "--no-warnings", "-o", str(binary)],
        capture_output=True, text=True, timeout=600,
    )
    assert done.returncode == 0, f"compiling {PROJECT} failed:\n{done.stdout}\n{done.stderr}"
    return binary


def wait_ready(process, port, seconds):
    deadline = time.time() + seconds
    while time.time() < deadline:
        assert process.poll() is None, f"server exited {process.returncode}"
        try:
            if httpx.get(base(port) + "/api/version", timeout=1.0).status_code == 200:
                return
        except httpx.HTTPError:
            time.sleep(0.05)
    raise TimeoutError(f"server did not answer on port {port} within {seconds:.0f} seconds")


def run_cases(lane, port, weights, cases, memory):
    """Launch the `memory` binary on `port` over `weights` ("" for the table) and run `cases`."""
    log = ROOT / "target" / "llms" / "qwen-server" / f"server-{lane}.log"
    env = dict(os.environ, OSPREY_GPU=os.environ.get("OSPREY_GPU", "metal")) if weights else None
    process = subprocess.Popen([str(build(memory))], stdin=subprocess.PIPE, stdout=log.open("w"), stderr=subprocess.STDOUT, env=env)
    expired = threading.Event()
    watchdog = threading.Timer(LANE_SECONDS[lane], lambda: (expired.set(), process.kill()))
    watchdog.daemon = True
    watchdog.start()
    failures = []
    try:
        process.stdin.write(f"{port}\n{weights}\n".encode())
        process.stdin.close()
        wait_ready(process, port, READY_SECONDS[lane])
        for check in cases:
            try:
                check(port)
                print(f"ok {lane}/{check.__name__}", flush=True)
            except Exception:
                failures.append(f"{check.__name__}\n{traceback.format_exc()}")
                print(f"not ok {lane}/{check.__name__}", flush=True)
    finally:
        watchdog.cancel()
        stopped(process)
    if expired.is_set():
        failures.append(f"{lane}: the lane ran past {LANE_SECONDS[lane]:.0f} seconds and the server was killed")
    return failures


def stopped(process):
    """Stop the server, forcing it if it does not exit on its own."""
    process.terminate()
    try:
        process.wait(timeout=60)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait(timeout=60)


def lanes(argv):
    """The lanes named on the command line, or the two table backends plus `real`."""
    return [argument for argument in argv if argument in PORTS] or ["gc", "arc", "real"]


def real_lane():
    """The real lane's failures, or the named skips when no GGUF is available."""
    if WEIGHTS and Path(WEIGHTS).is_file():
        return run_cases("real", PORTS["real"], WEIGHTS, REAL_CASES, "arc"), len(REAL_CASES)
    reason = "OSPREY_QWEN_GGUF is not set" if not WEIGHTS else f"{WEIGHTS} is not a file"
    for check in REAL_CASES:
        print(f"skip real/{check.__name__}: {reason}", flush=True)
    return [], 0


def pydantic_lane():
    """Explicit real-model testing: missing dependencies or weights are hard failures."""
    os.environ["PYDANTIC_AI_NO_BANNER"] = "1"
    __import__("pydantic_ai")
    if not WEIGHTS or not Path(WEIGHTS).is_file():
        raise SystemExit("pydantic requires OSPREY_QWEN_GGUF: real weights, no fixture fallback")
    return run_cases("pydantic", PORTS["pydantic"], WEIGHTS, PYDANTIC_CASES, "arc"), len(PYDANTIC_CASES)


def main(argv):
    if not COMPILER.exists():
        raise SystemExit(f"no compiler at {COMPILER}; set OSPREY_COMPILER")
    failures, total = [], 0
    for lane in lanes(argv):
        if lane == "pydantic":
            found, ran = pydantic_lane()
        elif lane == "real":
            found, ran = real_lane()
        else:
            found, ran = run_cases(lane, PORTS[lane], "", CASES, lane), len(CASES)
        failures.extend(found)
        total += ran
    for failure in failures:
        print(failure, file=sys.stderr)
    print(f"{total - len(failures)} passed, {len(failures)} failed")
    return 1 if failures else 0
