"""Real `ollama` and `openai` clients, over real sockets, against the Osprey Qwen server.

Every expected wire shape is the client's own parsing: an assertion reads a
parsed `ollama`/`openai` object or the client's own exception, never a
hand-written JSON document. The pinned clients live in
`~/.cache/osprey-llm/oracle-venv`; run the whole suite with

    ~/.cache/osprey-llm/oracle-venv/bin/python -I \
        src/osprey/examples/llms/qwen/server/tests/clients.cpython

and pass memory backends as arguments (`gc`, `arc`) to narrow the run.
Implements [LLM-API-OLLAMA], [LLM-API-OPENAI], [LLM-API-QUEUE] and
[LLM-API-LIMIT] of docs/specs/applications/LocalCodingModel.md.
"""
import importlib.machinery
import json
import os
import subprocess
import sys
import types
import time
import traceback
from pathlib import Path

import httpx
import jsonschema
import ollama
import openai

HERE = Path(__file__).resolve().parent
PROJECT = HERE.parent
ROOT = PROJECT.parents[5]
COMPILER = Path(os.environ.get("OSPREY_COMPILER", ROOT / "target/debug/osprey"))
MODEL = "qwen3.8:27b"
CONTEXT = 65536
PORTS = {"gc": 11535, "arc": 11536}
READ_FILE = {
    "type": "function",
    "function": {
        "name": "read_file",
        "description": "Read one file from the workspace",
        "parameters": {"type": "object", "properties": {"path": {"type": "string"}}, "required": ["path"]},
    },
}
RUN_TESTS = {
    "type": "function",
    "function": {
        "name": "run_tests",
        "description": "Run one test suite",
        "parameters": {"type": "object", "properties": {"suite": {"type": "string"}}, "required": ["suite"]},
    },
}
READ_PROMPT = "read the readme"
CASES = []


def reference():
    """The independent CPython implementation of the fixture model the server installs."""
    loader = importlib.machinery.SourceFileLoader("model_reference", str(HERE / "model_reference.cpython"))
    module = types.ModuleType("model_reference")
    module.__file__ = str(HERE / "model_reference.cpython")
    loader.exec_module(module)
    return module


def case(fn):
    """Register one named case; the suite runs every case on every backend."""
    CASES.append(fn)
    return fn


def base(port):
    return f"http://127.0.0.1:{port}"


def client(port):
    return ollama.Client(host=base(port), timeout=120.0)


def openai_client(port):
    return openai.OpenAI(base_url=base(port) + "/v1", api_key="osprey-local")


# --- step 1: metadata endpoints of the Ollama protocol ---------------------


@case
def version_reports_the_protocol_version(port):
    reply = httpx.get(base(port) + "/api/version", timeout=30.0)
    assert reply.status_code == 200, reply.status_code
    assert reply.headers["content-type"] == "application/json", reply.headers
    document = reply.json()
    assert list(document) == ["version"], document
    version = document["version"]
    assert isinstance(version, str) and version, document
    assert all(part.isdigit() for part in version.split(".")), document
    assert version.count(".") >= 1, document


@case
def tags_list_exactly_the_served_model(port):
    for _ in range(3):
        listed = client(port).list()
        assert len(listed.models) == 1, listed
        model = listed.models[0]
        assert model.model == MODEL, model
        assert model.size > 0, model
        assert model.details.family == "qwen3_5", model.details
        assert "qwen3_5" in model.details.families, model.details
        assert model.details.quantization_level == "UD-Q4_K_XL", model.details
        assert model.details.parameter_size, model.details


@case
def tags_are_the_only_tagged_route(port):
    assert httpx.post(base(port) + "/api/tags", timeout=30.0).status_code == 405
    assert httpx.get(base(port) + "/api/absent", timeout=30.0).status_code == 404


@case
def show_reports_capabilities_and_context_length(port):
    for _ in range(3):
        info = client(port).show(MODEL)
        assert set(info.capabilities) >= {"completion", "tools"}, info.capabilities
        assert info.modelinfo["qwen3_5.context_length"] == CONTEXT, info.modelinfo
        assert info.modelinfo["qwen3_5.block_count"] == 64, info.modelinfo
        assert info.details.family == "qwen3_5", info.details
        assert info.details.quantization_level == "UD-Q4_K_XL", info.details


@case
def show_rejects_a_model_the_server_does_not_serve(port):
    try:
        client(port).show("absent:latest")
    except ollama.ResponseError as error:
        assert error.status_code == 404, error.status_code
        assert "absent:latest" in str(error), str(error)
    else:
        raise AssertionError("show accepted a model the server does not serve")


@case
def show_requires_a_model_name(port):
    reply = httpx.post(base(port) + "/api/show", json={}, timeout=30.0)
    assert reply.status_code == 400, reply.status_code
    assert reply.json()["error"], reply.text


@case
def ps_lists_the_running_model_with_its_context(port):
    for _ in range(3):
        state = client(port).ps()
        assert len(state.models) == 1, state
        running = state.models[0]
        assert MODEL in (running.name, running.model), running
        assert running.size > 0, running
        assert running.context_length == CONTEXT, running
        assert running.details.family == "qwen3_5", running.details


# --- step 2: /api/chat and /api/generate over NDJSON ----------------------


def json_lines(body):
    """The newline-delimited JSON objects of a streamed body, in wire order."""
    return [json.loads(line) for line in body.split("\n") if line]


def streamed(port, path, payload):
    with httpx.stream("POST", base(port) + path, json=payload, timeout=120.0) as reply:
        assert reply.status_code == 200, reply.read()
        assert reply.headers["content-type"] == "application/x-ndjson", reply.headers
        body = reply.read()
    return json_lines(body.decode("utf-8"))


@case
def chat_streams_one_ndjson_line_per_chunk(port):
    payload = {"model": MODEL, "messages": [{"role": "user", "content": READ_PROMPT}], "stream": True, "tools": [READ_FILE]}
    chunks = streamed(port, "/api/chat", payload)
    assert len(chunks) > 3, chunks
    assert [chunk["done"] for chunk in chunks] == [False] * (len(chunks) - 1) + [True], chunks
    assert all(chunk["message"]["role"] == "assistant" for chunk in chunks), chunks
    assert all(chunk["model"] == MODEL for chunk in chunks), chunks
    last = chunks[-1]
    assert last["done_reason"] == "stop", last
    assert last["eval_count"] > 0 and last["prompt_eval_count"] > 0, last
    assert all("created_at" in chunk for chunk in chunks), chunks


@case
def chat_stream_equals_the_non_streamed_turn(port):
    whole = client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE])
    pieces = list(client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE], stream=True))
    streamed_content = "".join(part.message.content or "" for part in pieces)
    streamed_calls = [call for part in pieces for call in (part.message.tool_calls or [])]
    assert streamed_content == whole.message.content, (streamed_content, whole.message.content)
    assert [call.function.name for call in streamed_calls] == [call.function.name for call in whole.message.tool_calls], streamed_calls
    assert [dict(call.function.arguments) for call in streamed_calls] == [dict(call.function.arguments) for call in whole.message.tool_calls], streamed_calls
    assert whole.done is True and whole.eval_count > 0 and whole.prompt_eval_count > 0, whole


@case
def chat_tool_call_arguments_are_schema_valid_json_objects(port):
    for _ in range(3):
        reply = client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE, RUN_TESTS])
        assert reply.message.tool_calls, reply
        call = reply.message.tool_calls[0]
        assert isinstance(call.function.arguments, dict), call.function
        declared = {tool["function"]["name"]: tool for tool in (READ_FILE, RUN_TESTS)}[call.function.name]
        jsonschema.validate(call.function.arguments, declared["function"]["parameters"])


@case
def chat_rejects_a_call_the_advertised_tools_do_not_declare(port):
    try:
        client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[RUN_TESTS])
    except ollama.ResponseError as error:
        assert error.status_code == 400, error.status_code
        assert "tool call" in str(error), str(error)
    else:
        raise AssertionError("a call to an undeclared tool reached the harness")


@case
def chat_answers_a_second_turn_of_the_same_conversation(port):
    asked = {"role": "user", "content": READ_PROMPT}
    answer = "".join(part.message.content or "" for part in client(port).chat(model=MODEL, messages=[asked], tools=[READ_FILE], stream=True))
    history = [asked, {"role": "assistant", "content": answer}, {"role": "user", "content": READ_PROMPT}]
    second = client(port).chat(model=MODEL, messages=history, tools=[READ_FILE])
    assert second.done is True and second.eval_count > 0, second
    assert second.prompt_eval_count > second.eval_count, second


@case
def generate_streams_and_agrees_with_the_chat_turn(port):
    whole = client(port).generate(model=MODEL, prompt=READ_PROMPT)
    assert whole.done is True, whole
    assert isinstance(whole.response, str) and whole.response, whole
    pieces = list(client(port).generate(model=MODEL, prompt=READ_PROMPT, stream=True))
    assert "".join(part.response for part in pieces) == whole.response, (pieces, whole)
    assert [part.done for part in pieces] == [False] * (len(pieces) - 1) + [True], pieces
    assert pieces[-1].eval_count > 0 and pieces[-1].prompt_eval_count > 0, pieces[-1]


@case
def generate_streams_ndjson_one_line_per_token(port):
    chunks = streamed(port, "/api/generate", {"model": MODEL, "prompt": READ_PROMPT, "stream": True})
    assert len(chunks) > 3, chunks
    assert all("response" in chunk for chunk in chunks), chunks
    assert [chunk["done"] for chunk in chunks] == [False] * (len(chunks) - 1) + [True], chunks
    assert "".join(chunk["response"] for chunk in chunks if not chunk["done"]), chunks


@case
def chat_and_generate_template_the_same_turn(port):
    chat = [part for part in client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE], stream=True)]
    generated = [part for part in client(port).generate(model=MODEL, prompt=READ_PROMPT, stream=True)]
    assert [part.prompt_eval_count for part in generated if part.done] == [part.prompt_eval_count for part in chat if part.done]
    assert [part.eval_count for part in generated if part.done] == [part.eval_count for part in chat if part.done]
    text = "".join(part.message.content or "" for part in chat)
    response = "".join(part.response for part in generated)
    assert "<tool_call>" in response and "<tool_call>" not in text, (response, text)
    assert [call.function.name for part in chat for call in (part.message.tool_calls or [])] == ["read_file"]


@case
def generate_matches_the_model_reference(port):
    module = reference()
    model = module.Model()
    rendered = module.rendered(READ_PROMPT)
    want = model.continuation(rendered)
    got = client(port).generate(model=MODEL, prompt=READ_PROMPT)
    assert got.response == want, (got.response, want)
    assert got.prompt_eval_count == len(model.tokenize(rendered)), got
    assert got.eval_count == len(model.tokenize(want)), got


@case
def chat_matches_the_model_reference(port):
    module = reference()
    model = module.Model()
    rendered = module.rendered(READ_PROMPT)
    name, arguments = module.call_of(model.continuation(rendered))
    reply = client(port).chat(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE, RUN_TESTS])
    assert reply.prompt_eval_count == len(model.tokenize(rendered)), reply
    call = reply.message.tool_calls[0]
    assert (call.function.name, dict(call.function.arguments)) == (name, arguments), (call, name, arguments)
    assert "<tool_call>" not in (reply.message.content or ""), reply
    assert reply.done_reason == "stop", reply


@case
def a_repeated_request_answers_identically(port):
    module = reference()
    asked = {"role": "user", "content": READ_PROMPT}
    first = client(port).chat(model=MODEL, messages=[asked], tools=[READ_FILE])
    for _ in range(3):
        again = client(port).chat(model=MODEL, messages=[asked], tools=[READ_FILE])
        assert (again.message.content, again.eval_count, again.prompt_eval_count) == (first.message.content, first.eval_count, first.prompt_eval_count), again
        assert [dict(call.function.arguments) for call in again.message.tool_calls] == [dict(call.function.arguments) for call in first.message.tool_calls], again


# --- step 3: the OpenAI protocol ------------------------------------------


@case
def openai_lists_the_served_model(port):
    listed = openai_client(port).models.list()
    assert [model.id for model in listed.data] == [MODEL], listed
    assert listed.data[0].object == "model", listed.data[0]
    assert listed.data[0].created > 0, listed.data[0]


@case
def openai_chat_completes_one_turn(port):
    reply = openai_client(port).chat.completions.create(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE, RUN_TESTS])
    choice = reply.choices[0]
    assert choice.finish_reason == "stop", choice
    assert choice.message.role == "assistant", choice.message
    call = choice.message.tool_calls[0]
    assert call.type == "function", call
    assert isinstance(call.function.arguments, str), call.function
    jsonschema.validate(json.loads(call.function.arguments), READ_FILE["function"]["parameters"])
    assert reply.usage.total_tokens == reply.usage.prompt_tokens + reply.usage.completion_tokens, reply.usage


@case
def openai_chat_answer_matches_the_model_reference(port):
    module = reference()
    model = module.Model()
    rendered = module.rendered(READ_PROMPT)
    name, arguments = module.call_of(model.continuation(rendered))
    reply = openai_client(port).chat.completions.create(model=MODEL, messages=[{"role": "user", "content": READ_PROMPT}], tools=[READ_FILE, RUN_TESTS])
    assert reply.usage.prompt_tokens == len(model.tokenize(rendered)), reply.usage
    call = reply.choices[0].message.tool_calls[0]
    assert (call.function.name, json.loads(call.function.arguments)) == (name, arguments), call


@case
def openai_chat_streams_events_that_match_the_whole_turn(port):
    asked = [{"role": "user", "content": READ_PROMPT}]
    whole = openai_client(port).chat.completions.create(model=MODEL, messages=asked, tools=[READ_FILE])
    events = list(openai_client(port).chat.completions.create(model=MODEL, messages=asked, tools=[READ_FILE], stream=True))
    assert events, "no events"
    assert all(event.object == "chat.completion.chunk" for event in events), events[0]
    content = "".join(event.choices[0].delta.content or "" for event in events)
    assert content == (whole.choices[0].message.content or ""), (content, whole.choices[0].message.content)
    calls = [call for event in events for call in (event.choices[0].delta.tool_calls or [])]
    assert [call.function.name for call in calls] == [call.function.name for call in whole.choices[0].message.tool_calls], calls
    assert [json.loads(call.function.arguments) for call in calls] == [json.loads(call.function.arguments) for call in whole.choices[0].message.tool_calls], calls
    assert [event.choices[0].finish_reason for event in events][-1] == "stop", events[-1]


@case
def openai_chat_stream_body_is_server_sent_events(port):
    payload = {"model": MODEL, "messages": [{"role": "user", "content": READ_PROMPT}], "tools": [READ_FILE], "stream": True}
    with httpx.stream("POST", base(port) + "/v1/chat/completions", json=payload, timeout=120.0, headers={"Authorization": "Bearer osprey-local"}) as reply:
        assert reply.status_code == 200, reply.read()
        assert reply.headers["content-type"].startswith("text/event-stream"), reply.headers
        body = reply.read().decode("utf-8")
    lines = [line for line in body.split("\n") if line]
    assert all(line.startswith("data: ") for line in lines), lines[:3]
    assert lines[-1] == "data: [DONE]", lines[-1]
    assert len(lines) >= 4, lines
    assert '"object":"chat.completion.chunk"' in lines[0], lines[0]


@case
def openai_rejects_a_path_it_does_not_serve(port):
    reply = httpx.get(base(port) + "/v1/absent", timeout=30.0)
    assert reply.status_code == 404, reply.status_code
    assert reply.json()["error"]["message"], reply.text


# --- the harness ----------------------------------------------------------


def build(memory):
    binary = ROOT / "target" / "llms" / "qwen-server" / f"server-{memory}"
    binary.parent.mkdir(parents=True, exist_ok=True)
    done = subprocess.run(
        [str(COMPILER), str(PROJECT), "--compile", f"--memory={memory}", "--no-warnings", "-o", str(binary)],
        capture_output=True, text=True, timeout=600,
    )
    assert done.returncode == 0, f"compiling {PROJECT} failed:\n{done.stdout}\n{done.stderr}"
    return binary


def wait_ready(process, port):
    deadline = time.time() + 60.0
    while time.time() < deadline:
        assert process.poll() is None, f"server exited {process.returncode}"
        try:
            if httpx.get(base(port) + "/api/version", timeout=1.0).status_code == 200:
                return
        except httpx.HTTPError:
            time.sleep(0.05)
    raise TimeoutError(f"server did not answer on port {port} within 60 seconds")


def run_cases(memory, port):
    log = ROOT / "target" / "llms" / "qwen-server" / f"server-{memory}.log"
    process = subprocess.Popen([str(build(memory))], stdin=subprocess.PIPE, stdout=log.open("w"), stderr=subprocess.STDOUT)
    failures = []
    try:
        process.stdin.write(f"{port}\n".encode())
        process.stdin.close()
        wait_ready(process, port)
        for check in CASES:
            try:
                check(port)
                print(f"ok {memory}/{check.__name__}", flush=True)
            except Exception:
                failures.append(f"{check.__name__}\n{traceback.format_exc()}")
                print(f"not ok {memory}/{check.__name__}", flush=True)
    finally:
        process.kill()
        process.wait(timeout=30)
    return failures


def memories(argv):
    wanted = [argument for argument in argv if argument in PORTS] or ["gc", "arc"]
    return wanted


def main(argv):
    if not COMPILER.exists():
        raise SystemExit(f"no compiler at {COMPILER}; set OSPREY_COMPILER")
    failures, total = [], 0
    for memory in memories(argv):
        found = run_cases(memory, PORTS[memory])
        failures.extend(found)
        total += len(CASES)
    for failure in failures:
        print(failure, file=sys.stderr)
    print(f"{total - len(failures)} passed, {len(failures)} failed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
