// The GPT-2 124M transformer, written once against the `Tensor` effect in
// gpt2::Backends. The model performs `build`, `get`, `matMul` and friends and
// never names a buffer type: the handler a program installs — `onLists` or
// `onGpu` — decides whether a tensor is a host list or a GPU buffer, and both
// compute the same binary32 values in the same order. The forward pass keeps every
// block's activations, so src/osprey/examples/llms/gpt2/generate reads the final state and
// src/osprey/examples/llms/gpt2/train runs the backward pass over the same trace.
//
// This is plan 0023's reference application (docs/plans/0023-gpu.md)
// and its stage 5, effect-selected execution: one model, two interpretations,
// chosen per lexical region ([STAGE-BACKEND], [GPU-DEVICE]). Under `onGpu`,
// kernels and matrix products run on Metal or OpenCL when a device is selected,
// with intermediate buffers kept on the device between operations.

namespace gpt2;

module Model {
    export let weightsDir = "src/osprey/examples/llms/gpt2/weights"

    // The GPT-2 small configuration (config.json in the same repository).
    export let vocabSize = 50257
    export let width = 768
    export let heads = 12
    export let headWidth = 64
    export let qkvWidth = 2304
    export let mlpWidth = 3072
    export let layerCount = 12
    export let positions = 1024
    export let endOfText = 50256
    export let epsilon: float32 = 0.00001
    export let widthF: float32 = 768.0
    /// 1 / sqrt(headWidth)
    export let scoreScale: float32 = 0.125
    /// sqrt(2 / pi) and the cubic coefficient of the tanh GELU approximation.
    export let geluScale: float32 = 0.7978845608028654
    export let geluCubic: float32 = 0.044715

    /// One block's parameters. `B` is whatever the installed `Tensor` handler
    /// represents a tensor as; the model never looks inside.
    export type Layer<B> = {
        ln1g: B, ln1b: B, qkvW: B, qkvB: B, projW: B, projB: B,
        ln2g: B, ln2b: B, fcW: B, fcB: B, outW: B, outB: B
    }

    /// wteT is the token embedding transposed to [width, vocab], so the tied
    /// output projection is one product instead of fifty thousand gathers per step.
    export type Weights<B> = { wte: B, wteT: B, wpe: B, lnfG: B, lnfB: B, blocks: List<Layer<B>> }

    /// Everything one block computes, in forward order: the backward pass reads
    /// each of them exactly once. `y` is the block's output and the next block's `x`.
    export type Acts<B> = { x: B, h1: B, qkv: B, probs: B, a: B, x2: B, h2: B, f: B, u: B, y: B }

    /// Causal attention keeps its probabilities [heads, t, t] beside its output.
    export type Attn<B> = { probs: B, out: B }

    /// The forward trace: one Acts per block, and the last block's output.
    export type Trace<B> = { acts: List<Acts<B>>, x: B }

    /// One block's output row for the newest position, and its qkv rows for
    /// every position so far [t, 2304] — the KV cache a later position attends to.
    export type BlockStep<B> = { y: B, qkv: B }

    /// The newest position through every block: its final row [1, width] and
    /// each block's grown cache.
    export type Stepped<B> = { x: B, caches: List<B> }

    export fn at(m, i) = perform Backends::Tensor.get(m, i)
    export fn size(m) = perform Backends::Tensor.length(m)
    export fn empty() = orStop(perform Backends::Tensor.fromList([]), empty)
    export fn device() = perform Backends::Tensor.device()
    export fn total(b) = orStop(perform Backends::Tensor.reduce(b, 0.0, addF), fn() => at(b, 0))
    export fn plus(a, b) = orStop(perform Backends::Tensor.zipWith(a, b, addF), fn() => a)
    export fn addF(a, x) = a + x
    export fn maxF(a, x) = match x > a { true => x  false => a }
    /// The largest element of a nonempty tensor, or a fault from the backend.
    export fn peak(b) = orStop(perform Backends::Tensor.reduce(b, at(b, 0), maxF), fn() => at(b, 0))
    export fn gelu(x) = toFloat32(0.5) * x * (toFloat32(1.0) + tanh(geluScale * (x + geluCubic * x * x * x)))
    export fn gelus(f) = orStop(perform Backends::Tensor.build(size(f), fn(i) => gelu(at(f, i))), empty)

    /// A tensor operation's value, or a fault that stops the run with the
    /// reason ([FAILURE-EXPLICIT]). The fault never resumes, so `abandoned` is
    /// never called; it only gives the stopped arm the result type.
    export fn orStop(result, abandoned) = match result {
        Success { value } => value
        Error { message } => {
            let _ = Backends::stop(message)
            abandoned()
        }
    }

    /// Build failures leave the surrounding strictly region before any model work.
    export fn indexOf(buffer, value) = orStop(perform Backends::Tensor.indexOf(buffer, value), fn() => size(buffer))

    /// The tensor `name` of the safetensors file at `path`; a missing or
    /// mis-typed tensor stops the run rather than fabricate a runnable model.
    export fn loaded(path, name) = orStop(perform Backends::Tensor.load(path, name), empty)

    /// One tensor of the checkpoint.
    fn tensor(name) = loaded(weightsDir + "/model.safetensors", name)

    fn layerAt(i) = {
        let p = "h.${i}."
        Layer {
            ln1g: tensor(p + "ln_1.weight"), ln1b: tensor(p + "ln_1.bias"),
            qkvW: tensor(p + "attn.c_attn.weight"), qkvB: tensor(p + "attn.c_attn.bias"),
            projW: tensor(p + "attn.c_proj.weight"), projB: tensor(p + "attn.c_proj.bias"),
            ln2g: tensor(p + "ln_2.weight"), ln2b: tensor(p + "ln_2.bias"),
            fcW: tensor(p + "mlp.c_fc.weight"), fcB: tensor(p + "mlp.c_fc.bias"),
            outW: tensor(p + "mlp.c_proj.weight"), outB: tensor(p + "mlp.c_proj.bias")
        }
    }

    export fn loadWeights() = {
        let wte = tensor("wte.weight")
        Weights {
            wte: wte, wteT: transpose(wte, vocabSize, width), wpe: tensor("wpe.weight"),
            lnfG: tensor("ln_f.weight"), lnfB: tensor("ln_f.bias"),
            blocks: range(0, layerCount) |> fold([], fn(acc, i) => listAppend(acc, layerAt(i)))
        }
    }

    export fn emptyLayer() = {
        let e = empty()
        Layer { ln1g: e, ln1b: e, qkvW: e, qkvB: e, projW: e, projB: e, ln2g: e, ln2b: e, fcW: e, fcB: e, outW: e, outB: e }
    }

    export fn layer(w, i) = listGet(w.blocks, i) ?: emptyLayer()

    /// m [rows, cols] as [cols, rows]: tensors are rank-1, so a product against a
    /// transposed operand is a gather followed by `matMul`.
    export fn transpose(m, rows, cols) = orStop(perform Backends::Tensor.build(rows * cols, fn(i) => at(m, (i % rows) * cols + intDiv(i, rows))), empty)

    /// a [rows, inner] times b [inner, cols]; operands that disagree with the
    /// stated shape stop the run.
    export fn product(a, b, rows, inner, cols) = orStop(perform Backends::Tensor.matMul(a, b, rows, inner, cols), fn() => a)

    /// `step` folded over elements i of x in start..start+n, from `init`.
    fn foldRun(x, start, n, init, step) = range(start, start + n) |> fold(init, fn(a, i) => step(a, at(x, i)))
    /// Sum of a contiguous run of a flat tensor.
    export fn sumRange(x, start, n) = foldRun(x, start, n, 0.0, addF)
    export fn squaredDeviation(x, start, n, mean) = foldRun(x, start, n, 0.0, fn(a, v) => a + (v - mean) * (v - mean))
    /// Per-row mean and variance of x [t, width], the LayerNorm statistics.
    export fn rowMeans(x, t) = orStop(perform Backends::Tensor.build(t, fn(r) => sumRange(x, r * width, width) / widthF), empty)
    export fn rowVariances(x, t, means) = orStop(perform Backends::Tensor.build(t, fn(r) => squaredDeviation(x, r * width, width, at(means, r)) / widthF), empty)

    fn normalised(x, means, variances, g, b, i) = {
        let r = intDiv(i, width)
        let c = i % width
        (at(x, i) - at(means, r)) / sqrt(at(variances, r) + epsilon) * at(g, c) + at(b, c)
    }

    /// LayerNorm over each of the t rows of x [t, width].
    export fn layerNorm(x, t, g, b) = {
        let means = rowMeans(x, t)
        let variances = rowVariances(x, t, means)
        orStop(perform Backends::Tensor.build(t * width, fn(i) => normalised(x, means, variances, g, b, i)), empty)
    }

    /// x [rows, inner] times w [inner, cols], plus the bias on every row.
    export fn linear(x, rows, inner, cols, w, bias) = {
        let value = product(x, w, rows, inner, cols)
        orStop(perform Backends::Tensor.build(rows * cols, fn(i) => at(value, i) + at(bias, i % cols)), empty)
    }

    /// qkv is [t, 2304]: query, key and value start at columns 0, `width` and 2 * `width`.
    fn qkvPart(qkv, column, r, h, d) = at(qkv, r * qkvWidth + column + h * headWidth + d)
    export fn qAt(qkv, r, h, d) = qkvPart(qkv, 0, r, h, d)
    export fn kAt(qkv, r, h, d) = qkvPart(qkv, width, r, h, d)
    export fn vAt(qkv, r, h, d) = qkvPart(qkv, 2 * width, r, h, d)
    fn score(qkv, h, r, c) = (range(0, headWidth) |> fold(0.0, fn(a, d) => a + qkvPart(qkv, 0, r, h, d) * qkvPart(qkv, width, c, h, d))) * scoreScale
    /// Row r of n attended rows is position first + r; probs are [heads, n, t].
    fn weighted(probs, qkv, t, n, first, r, h, d) = range(0, first + r + 1) |> fold(0.0, fn(a, c) => a + at(probs, (h * n + r) * t + c) * qkvPart(qkv, 2 * width, c, h, d))

    /// Whether element i of a [heads, n, t] causal score tensor is on or below the diagonal.
    fn onDiagonal(i, t, n, first) = i % t <= first + intDiv(i % (n * t), t)
    /// Element i of the causal score tensor [heads, n, t]: zero above the diagonal.
    fn causalScore(qkv, t, n, first, i) = {
        let h = intDiv(i, n * t)
        let r = first + intDiv(i % (n * t), t)
        match onDiagonal(i, t, n, first) { true => score(qkv, h, r, i % t)  false => 0.0 }
    }

    /// Softmax of each causal row of scores [heads, n, t], where row r of a head
    /// is position first + r and attends to columns c <= first + r only: the
    /// weight of element i is exp against its row's peak, or zero above the diagonal.
    fn probsOf(scores, t, n, first) = {
        let peaks = orStop(perform Backends::Tensor.build(heads * n, fn(row) => foldRun(scores, row * t, first + row % n + 1, at(scores, row * t), maxF)), empty)
        let weights = orStop(perform Backends::Tensor.build(heads * n * t, fn(i) => match onDiagonal(i, t, n, first) { true => exp(at(scores, i) - at(peaks, intDiv(i, t)))  false => 0.0 }), empty)
        let sums = orStop(perform Backends::Tensor.build(heads * n, fn(row) => sumRange(weights, row * t, t)), empty)
        orStop(perform Backends::Tensor.build(heads * n * t, fn(i) => at(weights, i) / at(sums, intDiv(i, t))), empty)
    }

    /// Element i of the attention output [n, width].
    fn attended(probs, qkv, t, n, first, i) = {
        let r = intDiv(i, width)
        let h = intDiv(i % width, headWidth)
        weighted(probs, qkv, t, n, first, r, h, i % headWidth)
    }

    /// Causal multi-head self-attention for positions first..t-1 of qkv [t, 2304],
    /// as [t - first, width]: the whole sequence when first is 0, the newest
    /// position alone when first is t - 1 — the KV-cached step, which reads the
    /// earlier positions' keys and values from qkv instead of recomputing them.
    /// Scores and probabilities are [heads, t - first, t].
    export fn attentionFrom(qkv, t, first) = {
        let n = t - first
        let probs = probsOf(orStop(perform Backends::Tensor.build(heads * n * t, fn(i) => causalScore(qkv, t, n, first, i)), empty), t, n, first)
        Attn { probs: probs, out: orStop(perform Backends::Tensor.build(n * width, fn(i) => attended(probs, qkv, t, n, first, i)), empty) }
    }

    /// Every position of qkv [t, 2304] at once, as [t, width].
    export fn attention(qkv, t) = attentionFrom(qkv, t, 0)

    /// `x` plus a linear map of `u`: one branch of a residual pair.
    fn residual(x, u, rows, inner, w, bias) = plus(x, linear(u, rows, inner, width, w, bias))

    /// A block over `rows` rows of x: pre-norm attention and MLP with residuals,
    /// `first` the first row's position and `cached` its earlier qkv rows.
    fn blockRows(x, rows, t, l, cached, first) = {
        let h1 = layerNorm(x, rows, l.ln1g, l.ln1b)
        let fresh = linear(h1, rows, width, qkvWidth, l.qkvW, l.qkvB)
        let qkv = match first == 0 { true => fresh  false => appended(cached, fresh) }
        let attn = attentionFrom(qkv, t, first)
        let x2 = residual(x, attn.out, rows, width, l.projW, l.projB)
        let h2 = layerNorm(x2, rows, l.ln2g, l.ln2b)
        let f = linear(h2, rows, width, mlpWidth, l.fcW, l.fcB)
        let u = gelus(f)
        let y = residual(x2, u, rows, mlpWidth, l.outW, l.outB)
        Acts { x: x, h1: h1, qkv: qkv, probs: attn.probs, a: attn.out, x2: x2, h2: h2, f: f, u: u, y: y }
    }

    /// One transformer block: pre-norm attention and MLP, each with a residual.
    export fn block(x, t, l) = blockRows(x, t, t, l, empty(), 0)

    /// Every block over `rows` rows of x from position `first` on, each step's KV
    /// cache read from `caches`: one loop serves the full pass and the cached step.
    fn blockPass(w, x, rows, t, i, caches, first, acc) = match i == layerCount {
        true => Trace { acts: acc, x: x }
        false => {
            let acts = blockRows(x, rows, t, layer(w, i), listGet(caches, i) ?: empty(), first)
            blockPass(w, acts.y, rows, t, i + 1, caches, first, listAppend(acc, acts))
        }
    }

    /// Token plus position embeddings of the host-side ids, [t, width]: one
    /// row per position, so every kernel sees buffers and scalars only.
    export fn embed(w, ids, t) = range(0, t) |> fold(empty(), fn(rows, p) => appended(rows, embedOne(w, listGet(ids, p) ?: 0, p)))

    /// The twelve blocks over the embedded tokens [t, width].
    export fn forward(w, ids, t) = blockPass(w, embed(w, ids, t), t, t, 0, [], 0, [])

    /// `rows` followed by `more`: a cache growing by one position.
    fn appended(rows, more) = {
        let n = size(rows)
        orStop(perform Backends::Tensor.build(n + size(more), fn(i) => match i < n { true => at(rows, i)  false => at(more, i - n) }), empty)
    }

    /// The embedding of one token at position p, [1, width].
    export fn embedOne(w, token, p) = embedRow(w.wte, w.wpe, token, p)
    fn embedRow(wte, wpe, token, p) = orStop(perform Backends::Tensor.build(width, fn(c) => at(wte, token * width + c) + at(wpe, p * width + c)), empty)

    /// The newest position, token at index t - 1, through the twelve blocks over
    /// their caches of the t - 1 earlier positions.
    export fn forwardStep(w, token, t, caches) = {
        let trace = blockPass(w, embedOne(w, token, t - 1), 1, t, 0, caches, t - 1, [])
        Stepped { x: trace.x, caches: qkvCaches(trace) }
    }

    /// Each block's qkv rows from a full pass: the caches a first forwardStep grows.
    export fn qkvCaches(trace) = range(0, layerCount) |> fold([], fn(acc, i) => listAppend(acc, match listGet(trace.acts, i) { Success { value } => value.qkv  Error _ => empty() }))
}
