// Osprey Agent's real update path with scripted completions: typing, the whole
// model and tool loop, Stop, a stale answer, failures, new conversations, keys,
// the settings pane, effort and a restart, with no network and no window
// ([NATIVE-APPS-ALL], [UI-EFFECTS]).
namespace agentapptests

import ui::Doc
import ui::Lists
import ui::Themes
import ui::Requests
import ui::Runtime
import uitest::Read
import uitest::Views
import agent::Engine
import agentapp::App
import agentapp::Model
import agentapp::McpModel
import agentapp::View
import agent::McpClient
import pydantic_ai::Mcp
import agentapptests::Drive

// A host context at `now`, launching with `arguments`.
contextAt (now, arguments) = ui::Context(now = now, offset = 0, platform = "macos", home = "/home/ada", arguments = arguments, hostDark = false)

context now = contextAt (now, ["/work/project", "/keys/env"])

toolReply = "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Looking.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"a.py\\\"}\"}},{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"arguments\":\"{\\\"path\\\":\\\"a.py\\\",\\\"content\\\":\\\"x\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}"

textReply = "{\"id\":\"r2\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Done.\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":20,\"completion_tokens\":3,\"total_tokens\":23}}"

codeReply = "{\"id\":\"rc\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Here:\\n\\n```python\\ndef add(a, b):\\n    name = \\\"x\\\"\\n    return a + b + 1  # sum\\n```\\n\\nDone.\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":4,\"total_tokens\":14}}"

blankReply = "{\"id\":\"rb\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"

busyReply = "{\"error\":\"busy\"}"

// A model reply whose whole content is one call of `tool` under `callId`, with no arguments.
callsTool (callId, tool) = "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"${callId}\",\"type\":\"function\",\"function\":{\"name\":\"${tool}\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}"

// The step after the model's reply in `store` asked the demo server for a tool and its input went out.
mcpAsked (store, reply, bytes) = mcpWrote ((answered (store, reply)).stepStore, bytes)

ok status = okDone (Doc::write (JsonObject [Doc::num ("status", status)]))

// Each test runs under the arithmetic policy the application's C boundary uses.
testing (name, body) = test (name, \() => Runtime::guarded body)

(** Steps the application's real `update` with messages a host would deliver. *)
module Drive
    (** One message, with `slice` as every host-held slice it reads. *)
    export deliver (store, message, slice) = deliverWhere (store, message, \_ => slice)

    (** One message, with each host-held slice answered by name. *)
    export deliverWhere (store, message, of) = deliverAt (100, store, message, of)

    (** The same at the host's time `now`. *)
    export deliverAt (now, store, message, of) =
        handle ui::Slices
            fetch key =>
                of (key)
        App::update (context now, store, message)

    (** The step at launch, with its key file loaded into every empty slot. *)
    export startedStep () = deliver (launchedStore (), ui::Completed(ticket = "env", outcome = ok 0), "DEEPSEEKKEY=sk-test\n")

    (** The store at launch, with its key file loaded into every empty slot. *)
    export started () = (startedStep ()).stepStore

    (** The person types `text`. *)
    export typing (store, text) = deliver (store, ui::Entered(entry = agentapp::Typed, entered = text), "")

    (** The completion of what the open conversation waits on. *)
    export answering (store, outcome, slice) = deliver (store, ui::Completed(ticket = (Model::active store).chatTicket, outcome = outcome), slice)

    (** The told rows a host reads for `view` of `store`, with the store answering its signals ([NATIVE-SHM-NODES]). *)
    export walked (store, view) =
        handle static Signal<agentapp::Chats>
            read => agentapp::Chats(chatList = store.chats)
        handle static Signal<agentapp::Draft>
            read => store.draft
        handle static Signal<agentapp::Panel>
            read => store.panel
        handle static Signal<agentapp::Settings>
            read => store.settings
        handle static Signal<agentapp::McpSignal>
            read => agentapp::McpSignal(signalState = store.mcp)
        ui::Tellings::alone (view ())

    (** A region's controls and text, with the store answering its signals. *)
    export showing (store, view) = Read::seen (walked (store, view), [])

    (** The kinds of a step's requests, joined. *)
    export kinds step = join (mapList (step.requests, \request => Requests::kind request.capability), ",")

    (** The saved key for `provider` in a store. *)
    export keyOf (store, provider) = Model::keyOf (store.settings, provider)

// The request a step made at `index`, or a cancel of nothing when it made none.
askedAt (step, index) = listGet step.requests index ?: Requests::ask ("none", ui::Cancel(cancelled = ""))

// A field of a request: its ticket, its kind, or one of its capability's own.
requestField (request, key) = match key
    "ticket" => request.ticket
    "kind" => Requests::kind request.capability
    _ => capabilityField (request.capability, key)

capabilityField (capability, key) = match capability
    ui::Run executable arguments timeout limit _ slice => match key
        "executable" => executable
        "arguments" => join arguments " "
        "timeout" => toString timeout
        "limit" => toString limit
        "slice" => slice
        _ => ""
    ui::StoreRead name limit slice => match key
        "name" => name
        "limit" => toString limit
        "slice" => slice
        _ => ""
    ui::StoreWrite name slice => match key
        "name" => name
        "slice" => slice
        _ => ""
    ui::Http method url headers body limit deadline slice => match key
        "method" => method
        "url" => url
        "headers" => join (mapList (headers, \one => "${one.headerName}: ${one.headerValue}")) "\n"
        "body" => body
        "limit" => toString limit
        "deadline" => toString deadline
        "slice" => slice
        _ => ""
    ui::ProcessStart command arguments env name => match key
        "command" => command
        "arguments" => join arguments " "
        "env" => join (mapList (env, \one => "${one.envName}=${one.envValue}")) "\n"
        "name" => name
        _ => ""
    ui::ProcessWrite name input => match key
        "name" => name
        "input" => input
        _ => ""
    ui::ProcessRead name limit deadline => match key
        "name" => name
        "limit" => toString limit
        "deadline" => toString deadline
        _ => ""
    ui::ProcessStop name => match key
        "name" => name
        _ => ""
    ui::ChooseFile _ _ slice => match key
        "slice" => slice
        _ => ""
    _ => ""

// The value of the header `name` on a step's request.
headerOf (request, name) = match request.capability
    ui::Http _ _ headers _ _ _ _ => (Lists::find (headers, \one => one.headerName == name) ?: ui::Header(headerName = "", headerValue = "")).headerValue
    _ => ""

// The value of the environment variable `name` a step's process starts with.
envOf (request, name) = match request.capability
    ui::ProcessStart _ _ env _ => (Lists::find (env, \one => one.envName == name) ?: ui::EnvVar(envName = "", envValue = "")).envValue
    _ => ""

// The body of the HTTP request a step made, empty when it made none.
httpBody step = match Lists::find (step.requests, \request => Requests::kind request.capability == "http")
    Success request => capabilityField (request.capability, "body")
    Error _ => ""

// A field of the request a step made at `index`.
askedField (step, index, key) = requestField (askedAt (step, index), key)

// The text of the only file a step wrote.
written step = (listGet step.writes 0 ?: Requests::write ("", "")).sliceText

// A step after a fresh launch had `words` typed into it.
typingAtLaunch words = Drive::typing (Drive::started (), words)

// The store after a fresh launch had `words` typed into it.
typedAtLaunch words = (typingAtLaunch words).stepStore

// The store after a fresh launch's turn on `words` was answered with `reply`.
turnDone (words, reply) = (answered (typedAtLaunch words, reply)).stepStore

// A step after `store`'s open request was answered with `reply`.
answered (store, reply) = Drive::answering (store, ok 200, reply)

// A step after `store`'s open request was answered with the model's plain text reply.
textAnswered store = answered (store, textReply)

callingAfter words = (answered ((typingAtLaunch words).stepStore, toolReply)).stepStore

// A fresh turn on the short words `words` most tests start from.
goTurn () = typedAtLaunch "Go\n"

// A completed turn on "One", the words most save and restore tests start from.
oneTurn () = answeredTurn ("One\n", 200, textReply)

// A fresh turn on `words`, its open request answered with `status` and `reply`.
answeredTurn (words, status, reply) = Drive::answering (typedAtLaunch words, ok status, reply)

// A step after `store`'s open request was answered with `reply`, the conversation left at `stage`.
answeredTo (store, reply, stage) =
    done = answered (store, reply)
    expectChatStage (done.stepStore, stage)
    done

// A step after `store`'s open request failed in words with `problem`.
failedWith (store, problem) = Drive::answering (store, Error(message = problem), "")

// A step after the person's action `act` in `store`.
acted (store, act) = Drive::deliver (store, ui::Act(act = act), "")

// A step after the person chose `chosen` in `store`'s `chooser`.
chose (store, chooser, chosen) = Drive::deliver (store, ui::Chose(chooser = chooser, chosen = chosen), "")

// A step after the person typed `text` into `store`'s `entry`.
typedInto (store, entry, text) = Drive::deliver (store, ui::Entered(entry = entry, entered = text), "")

// A step after the host completed `ticket` with `outcome`.
completed (store, ticket, outcome) = settledWith (store, ticket, outcome, "")

// A step after the host completed `ticket` successfully in `store`.
okCompleted (store, ticket) = completed (store, ticket, ok 0)

// A step after the host completed `ticket` with `outcome`, answering reads with `slice`.
settledWith (store, ticket, outcome, slice) = settledBy (store, ticket, outcome, \_ => slice)

// The same, with each host-held slice answered by name.
settledBy (store, ticket, outcome, of) = Drive::deliverWhere (store, ui::Completed(ticket = ticket, outcome = outcome), of)

// Whether `view` of `store` draws the control labelled `text`.
shows (store, view, text) = Views::shows (Drive::showing (store, view), text)

// Whether the told rows `walk` was sent, or the choices and rich runs they rebuild, hold `text` in some words.
mentions (walk, text) = Lists::any ((Read::seen (walk, [])).renderedControls, \one => contains one.controlText text || contains one.controlHint text) || Lists::any (wordsOf walk, \words => contains words text)

// Expect the told rows of `walk` to hold `text` in some control's, choice's or run's words.
expectMentions (walk, text) = expectTrue (mentions (walk, text))

// Expect the told rows of `walk` to hold `text` in no words.
expectOmits (walk, text) = expectFalse (mentions (walk, text))

// The control labelled `label` that `view` of `store` draws.
controlOf (store, view, label) = Views::control (Drive::showing (store, view), label)

// The composer's drawn view of `store`.
composerOf store = Drive::showing (store, View::composer)

// The told rows of `store`'s composer, for reading its choices as a host rebuilds them.
composerWalk store = Drive::walked (store, View::composer)

// Expect the composer of `store` to hold `text` in words, a second text, a choice or a run.
composerShows (store, text) = expectTrue (mentions (composerWalk store, text))

// The same, expecting `text` nowhere.
composerLacks (store, text) = expectOmits (composerWalk store, text)

// Expect the transcript of `store` to draw `text` as a control's words.
transcriptShows (store, text) = expectTrue (shows (store, View::transcript, text))

// The same, expecting `text` nowhere.
transcriptLacks (store, text) = expectFalse (shows (store, View::transcript, text))

// Expect the transcript of `store` to say `wanted` and never `unwanted`.
transcriptSays (store, wanted, unwanted) =
    transcriptShows (store, wanted)
    transcriptLacks (store, unwanted)

// Expect `store`'s plain-text answer to end the turn at `idle`, its transcript saying `wanted` and never `unwanted`.
answeredSaying (store, wanted, unwanted) =
    done = answeredTo (store, textReply, "idle")
    transcriptSays (done.stepStore, wanted, unwanted)

// A relaunch of the app in the same folder at time `now`.
relaunch now = (App::initial (contextAt (now, ["/work/project"]))).stepStore

// The launch step at time 100.
launchStep () = App::initial (context 100)

// The store at a bare launch, before any file read is answered.
launchedStore () = (launchStep ()).stepStore

// Expect `request`'s `key` field to be `value`.
expectField (request, key, value) = expect (requestField (request, key), value)

// Expect the request at `index` of `step` to have `key` set to `value`.
expectAsked (step, index, key, value) = expect (askedField (step, index, key), value)

// Expect the input of the request at `index` of `step` to hold `text`.
expectInput (step, index, text) = expectHas (askedField (step, index, "input"), text)

// The ticket of the request at `index` of `step`.
ticketAt (step, index) = askedField (step, index, "ticket")

// Expect `text` to say `wanted` and never `unwanted`.
expectSays (text, wanted, unwanted) =
    expectHas (text, wanted)
    expectLacks (text, unwanted)

// Expect `store`'s open conversation's `get` field to be `want`.
expectOpen (store, get, want) = expect (get (Model::active store), want)

// Expect the active conversation to be on `model` at `effort`.
expectChosen (store, model, effort) =
    expectOpen (store, \active => active.chatModel, model)
    expectOpen (store, \active => active.chatEffort, effort)

// Expect the active conversation to be titled `title` and on `model`.
expectTitled (store, title, model) =
    expectOpen (store, \active => active.chatTitle, title)
    expectOpen (store, \active => active.chatModel, model)

// Expect a turn refused with `status` to draw `text` in the conversation's transcript.
refusalSays (opened, status, text) =
    refused = Drive::answering (opened, ok status, "{}")
    transcriptShows (refused.stepStore, text)

// Expect `step`'s requests to be `kinds`.
expectKinds (step, kinds) = expect (Drive::kinds step, kinds)

// Expect `step`'s requests to be `kinds`, then `work` on the step, handing its result back.
kindsAre (step, kinds, work) =
    expectKinds (step, kinds)
    work step

// Expect `step`'s request at `index` to have `key` set to `value`, handing the request back.
askedHolding (step, index, key, value) =
    doc = askedAt (step, index)
    expectField (doc, key, value)
    doc

// Expect `step`'s requests to be `kinds`, and the request at `index` to carry `text` under `key`.
expectSent (step, kinds, index, key, text) = kindsAre (step, kinds, \s => expectHas (askedField (s, index, key), text))

// Expect `step`'s only request, an HTTP one, to carry `text` in its body.
expectBodySent (step, text) = expectSent (step, "http", 0, "body", text)

// Expect `step`'s requests to be `kinds`, and the conversation to be `stage` after them.
expectStage (step, kinds, stage) = kindsAre (step, kinds, \s => expectChatStage (s.stepStore, stage))

idleChat (step, kinds) =
    expectStage (step, kinds, "idle")
    Model::active step.stepStore

expectChatIn (chat, id, folder) =
    expect (chat.chatId, id)
    expect (chat.chatFolder, folder)

// Expect the open conversation to hold `count` finished tool results.
expectResults (store, count) = expect (length (Model::active store).chatResults, count)

// The store after the person opened a new conversation in `store`.
newChat store = (acted (store, agentapp::NewChat)).stepStore

newChatIn (store, count) =
    fresh = newChat store
    expect (length fresh.chats, count)
    fresh

expectDefaultOn (store, model, default) =
    expectOpen (store, \active => active.chatModel, model)
    expect (store.settings.defaultModel, default)

// Expect `step`'s requests to be `kinds`, and the request at `index` to have `key` set to `value`.
expectAskedKinds (step, kinds, index, key, value) = kindsAre (step, kinds, \s => expectField (askedAt (s, index), key, value))

// The field `key` of `step`'s request at `index`, with its requests expected to be `kinds`.
askedIn (step, index, key, kinds) = kindsAre (step, kinds, \s => askedField (s, index, key))

// Expect `step`'s requests to be `kinds`, and the only file it wrote to hold `text`.
expectWrote (step, kinds, text) = kindsAre (step, kinds, \s => expectHas (written s, text))

// Expect `text` to hold each of `parts`.
showsAll (text, parts) = forEachList (parts, \part => expectHas (text, part))

// Expect the told rows of `walk` to draw every one of `labels` as a control's words, a choice's key or label, or a run's text ([NATIVE-SHM-NODES]).
labelsShown (walk, labels) = forEachList (labels, \label => expectTrue (offers (walk, label)))

// Expect `seen` to draw a control labelled `label`.
expectDraws (seen, label) = expectTrue (Views::shows (seen, label))

// Expect `seen` to draw no control labelled `label`.
expectNotDraws (seen, label) = expectFalse (Views::shows (seen, label))

// Expect the told rows of `walk` to draw none of `labels`, in words or in a second text.
labelsAbsent (walk, labels) = forEachList (labels, \label => expectFalse (mentions (walk, label)))

// The key and the label a picker's choice offers.
choiceWords entry = [Read::words (Read::inside entry, "key"), Read::words (Read::inside entry, "label")]

// The words `told` offers beyond its own label: a picker's choices, or a rich node's runs.
wordsTold told = match Read::words (Read::inside told, "kind")
    "picker" => Lists::flatten (mapList (Read::entries (told, "choices"), choiceWords))
    "rich-text" => mapList (Read::entries (told, "runs"), \run => Read::words (Read::inside run, "text"))
    _ => []

// Whether the told rows `walk` was sent offer `label`: a control named `label`, or a choice or rich run carrying exactly `label` ([NATIVE-SHM-NODES]).
offers (walk, label) = Views::shows (Read::seen (walk, []), label) || Lists::any (wordsOf walk, \words => words == label)

// Every word the told rows of `walk` offer beyond a control's own words: choices' keys and labels, and rich runs' texts ([NATIVE-SHM-NODES]).
wordsOf walk = Lists::flatten (mapList (Lists::flatten (mapList (Read::trees walk, Read::under)), wordsTold))

// Whether the told rows `walk` was sent draw something inked with the token `name`, a rich run or a frame's style ([NATIVE-SHM-NODES]).
drawsInk (walk, name) = Lists::any (Read::trees walk, \tree => Lists::any (Read::under tree, \told => Read::words (Read::inside told, "ink") == name))

// Every ink code is drawn with: the two frames' own, and one per highlight kind.
codeInks = ["primary", "secondary", "codeKeyword", "codeString", "codeComment", "codeNumber", "codeFunction", "codeType", "codeBuiltin", "codeMeta", "codeInserted", "codeRemoved"]

toned (name, work) = match ui::Themes::named (App::theme (), name)
    Error _ => expect (name, "a theme token")
    Success tone => work tone

// Expect the ink `name` to read on the code fill at 4.5:1, in light and in dark ([UI-THEME]).
readsOnCode name = toned ("codeFill", \fill => toned (name, \ink =>
    expectTrue (ui::Contrast::ratio (fill.tokenLight, ink.tokenLight) >= 4.5)
    expectTrue (ui::Contrast::ratio (fill.tokenDark, ink.tokenDark) >= 4.5)))

// Whether `seen` draws a bare glyph: a button or a label carrying a symbol and no words.
loneGlyph seen = Lists::any (seen.renderedControls, \one => (one.controlKind == "button" || one.controlKind == "label") && one.controlText == "" && one.controlHint != "")

// Expect `view` of `store` to draw a plain folder button labelled `label`, enabled or not.
expectFolder (store, view, label, enabled) =
    control = controlOf (store, view, label)
    expect (control.controlKind, "button")
    expect (control.controlHint, "folder")
    expect (control.controlEnabled, enabled)

// Expect the control `label` of `seen` to carry `hint` as its second text.
expectHint (seen, label, hint) = expect ((Views::control (seen, label)).controlHint, hint)

// Expect `store`'s active conversation to be at `stage`.
expectChatStage (store, stage) = expect ((Model::active store).chatStage, stage)

// Expect `step` to have asked for nothing at all.
sendsNothing step = expectKinds (step, "")

// Expect `after` to save exactly the session document `before` saves.
expectSameSession (after, before) = expect (Doc::write (App::save after), Doc::write (App::save before))

// Expect `store`'s session document to restore to exactly itself.
expectRoundTrips store = expectSameSession (App::restore (App::save store), store)

// The second conversation of `store`, or its active one.
secondChat store = listGet store.chats 1 ?: Model::active store

// Expect the demo server's phase in `step` to be `phase`.
expectPhase (step, phase) = expect ((demoOf step).serverPhase, phase)

// The store after `store` read `name`'s document back as `text`.
readBack (store, name, text) = (settledWith (store, name, readOutcome true, text)).stepStore

// The store after `store` read the key file back as `text`.
envRead (store, text) = (settledWith (store, "env", ok 0, text)).stepStore

// The wire of a provider's model list naming `ids`.
modelsList ids = "{\"data\":[${join (mapList (ids, \id => "{\"id\":\"${id}\"}"), ",")}]}"

// The store after its open models request for `provider` was answered with `body` at `code`.
modelsSettled (store, provider, code, body) = (settledWith (store, "models:${provider}", ok code, body)).stepStore

// The store after a relaunch at `now` read `name`'s document back as `text`.
relaunchedWith (now, name, text) = readBack (relaunch now, name, text)

// The store after `step`'s chats document was written and a relaunch at `now` read it back.
relaunchedChats (now, step) = relaunchedWith (now, "chats", written step)

// Expect `step`'s requests to be `kinds`, and the request at `index` to have `key` set to `value`, handing it back.
checkedAsked (step, index, key, value, kinds) = kindsAre (step, kinds, \s => askedHolding (s, index, key, value))

// The step after `store`'s tool process finished with `output`, its requests expected to be `kinds`.
toolFinished (store, output, kinds) =
    finished = Drive::answering (store, ok 0, output)
    expectKinds (finished, kinds)
    finished

// The store after choosing `chosen` in `store`'s `chooser`, with `want` expected of what `get` reads.
expectPicked (store, chooser, chosen, get, want) =
    picked = (chose (store, chooser, chosen)).stepStore
    expect (get picked, want)
    picked

// Expect choosing `model` in the composer to set the open conversation to it.
expectModelPicked (store, model) = expectPicked (store, agentapp::PickModel, model, \p => (Model::active p).chatModel, model)

// Expect choosing `model` in the composer to leave the open conversation's effort at `want`.
expectEffortKept (store, model, want) = expectPicked (store, agentapp::PickModel, model, \p => (Model::active p).chatEffort, want)

// Expect choosing `effort` in the composer to set the open conversation's effort to `want`.
expectEffortPicked (store, effort, want) = expectPicked (store, agentapp::PickEffort, effort, \p => (Model::active p).chatEffort, want)

// Expect choosing `choice` in Settings' `chooser` to leave the default model at `want`.
expectDefaultPicked (store, chooser, choice, want) = expectPicked (store, chooser, choice, \p => p.settings.defaultModel, want)

// Expect the key `provider` pasted into `store` to survive a later key file saying `fileLine`.
expectPastedKept (store, provider, fileLine) =
    pasted = store(settings = Model::withKey (store.settings, provider, "sk-pasted"))
    expect (Drive::keyOf (envRead (pasted, fileLine), provider), "sk-pasted")

// Expect `part` somewhere in `text`.
expectHas (text, part) = expectTrue (contains text part)

// Expect `part` nowhere in `text`.
expectLacks (text, part) = expectFalse (contains text part)

// The outcome of a store read: `found` is whether its file was there, which a refused read says.
readOutcome found = match found
    true => okDone (Doc::write (JsonObject [Doc::bit ("found", true)]))
    false => Error(message = "no such store entry")

// The step after the person typed `value` into `entry` of `store` and pressed `act`.
typedThenActed (store, entry, value, act) = acted ((typedInto (store, entry, value)).stepStore, act)

// The step after the person typed `value` into `entry` of `store`'s add form and pressed Add.
typedAdded (store, entry, value) = typedThenActed (store, entry, value, agentapp::AddMcpServer)

// Expect `step`'s add form to show `problem`.
expectFormProblem (step, problem) = expectHas (step.stepStore.mcp.stateForm.formProblem, problem)

// The add form refused `step` in words with `problem`, asking for nothing.
refusedForm (step, problem) =
    sendsNothing step
    expectFormProblem (step, problem)

// Expect `step`'s add form to have forgotten what it was given.
expectFormCleared step =
    expect (step.stepStore.mcp.stateForm.formEnvironment, "")
    expect (step.stepStore.mcp.stateForm.formName, "")

// The step after the folder chooser settled on `path`, or on none when it was cancelled.
folderChosen (store, path) = completed (store, "folder", okDone path)

// Expect a folder change from `step` settled with `outcome` to leave its saved conversations alone.
expectFolderKept (step, outcome) =
    settled = completed (step.stepStore, "folder", outcome)
    expectSameSession (settled.stepStore, step.stepStore)

// The step after `store`'s save of `ticket` completed, the next document written expected to be `name`.
saveSettled (store, ticket, name) =
    done = completed (store, ticket, ok 0)
    expectAsked (done, 0, "name", name)
    done

// The step after `store` asked to persist its conversations.
persistingChats store = Model::persisting (store, "chats.json")

// A step after the demo server's process started under `pid`.
mcpStarted () = completed ((mcpLaunched ()).stepStore, "mcpstart:demo", okJson [Doc::num ("pid", 4321)])

// A step after the demo server's `written` bytes of input went out.
mcpWrote (store, writtenBytes) = completed (store, "mcpwrite:demo", okJson [Doc::num ("written", writtenBytes)])

// The step after the demo server's `written` bytes of input went out, which must be a read.
expectMcpWrote (store, writtenBytes) = kindsAre (mcpWrote (store, writtenBytes), "process-read", \s => s)

// The step after the person moved to the MCP tab, its settings expected to hold `text`.
expectMcpTab (store, text) =
    onTab = acted (store, agentapp::ShowSettingsTab(tabKey = "mcp"))
    expectTrue (shows (onTab.stepStore, View::settings, text))

// A step after the demo server's `written` bytes of input went out and it read back `text`.
mcpReadAfter (step, writtenBytes, text) = mcpRead ((mcpWrote (step.stepStore, writtenBytes)).stepStore, text)

// A step after the demo server read back `text`.
mcpRead (store, text) = completed (store, "mcpread:demo", okDone (readDone (text, false)))

settingsOpened () = (acted (Drive::started (), agentapp::OpenSettings)).stepStore

// The store of `store` with `zai`'s key typed into the settings pane.
zaiKeyTyped store = (typedInto (store, agentapp::TypedKey(keyProvider = "zai"), "sk-zai")).stepStore

// A step after `store`'s `zai` key was saved from the settings pane.
zaiKeySaved store = acted (zaiKeyTyped store, agentapp::SaveKey(keyProvider = "zai"))

// The store of a fresh launch with settings open and `zai`'s key typed in.
keyTyped () = zaiKeyTyped (settingsOpened ())

// A step after a fresh launch's `zai` key was saved from the settings pane.
keySaved () = zaiKeySaved (keyTyped ())

// The launch step at time 100, asking for the conversations, providers and the key file.
launchAsk () =
    first = launchStep ()
    expectKinds (first, "run,store-read,store-read,store-read,store-read,run")
    first

testing ("launch asks for the conversations, providers and the key file, and starts empty", \() =>
    first = launchAsk ()
    expect (length first.stepStore.chats, 1)
    expect ((Model::active first.stepStore).chatFolder, "/work/project")
    expect (Drive::keyOf (first.stepStore, "deepseek"), "")
    expect (Drive::keyOf (Drive::started (), "deepseek"), "sk-test"))

testing ("typing keeps the draft and sends nothing", \() =>
    step = typingAtLaunch "half a thou"
    expect (step.stepStore.draft.draftText, "half a thou")
    sendsNothing step)

testing ("Return sends the words to the model with the key, and clears the composer", \() =>
    step = typingAtLaunch "Fix the bug\n"
    chat = Model::active step.stepStore
    request = askedAt (step, 0)
    expectKinds (step, "http")
    expect (requestField (request, "url"), Engine::url "deepseek/deepseek-chat")
    expectField (request, "method", "POST")
    expectHas ((requestField (request, "body")), "Fix the bug")
    expect (headerOf (request, "Authorization"), "Bearer sk-test")
    expect (chat.chatStage, "thinking")
    expect (chat.chatTitle, "Fix the bug")
    expect (step.stepStore.draft.draftText, ""))

testing ("without a key nothing is sent and the words are kept", \() =>
    launched = launchedStore ()
    step = Drive::typing (launched, "Fix it\n")
    sendsNothing step
    expect (step.stepStore.draft.draftText, "Fix it")
    expectChatStage (step.stepStore, "idle"))

testing ("words alone or a busy conversation send nothing", \() =>
    sendsNothing (typingAtLaunch "   \n")
    busy = (typedAtLaunch "One\n")
    sendsNothing (Drive::typing (busy, "Two\n")))

testing ("a whole turn: model, each tool in order, model again, then saved without the key", \() =>
    calling = answeredTurn ("Fix the bug\n", 200, toolReply)
    expectStage (calling, "run", "tools")
    expect ((Model::active calling.stepStore).chatCall, "c1")
    expectAsked (calling, 0, "executable", "/bin/sh")
    second = toolFinished (calling.stepStore, "print(1)", "run")
    expect ((Model::active second.stepStore).chatCall, "c2")
    expectResults (second.stepStore, 1)
    back = toolFinished (second.stepStore, "wrote a.py", "http")
    expectResults (back.stepStore, 0)
    expectHas ((askedField (back, 0, "body")), "wrote a.py")
    done = textAnswered back.stepStore
    expectStage (done, "store-write", "idle")
    chat = Model::active done.stepStore
    expect ((Engine::usage_of chat.chatHistory).totalRequests, 2)
    expect ((Engine::usage_of chat.chatHistory).totalInput, 30)
    expect (join (Engine::files_changed chat.chatHistory, ","), "a.py")
    file = written done
    expectSays (file, "Done.", "sk-test"))

testing ("a fenced python block draws as a rich node of coloured runs, more than one ink, each readable on the code fill", \() =>
    replied = answeredTurn ("Show the code\n", 200, codeReply)
    walk = Drive::walked (replied.stepStore, View::transcript)
    expectTrue (Lists::any (wordsOf walk, \words => words == "def"))
    expectTrue (Lists::any (wordsOf walk, \words => contains words "\n"))
    forEachList (["codeKeyword", "codeString", "codeComment", "codeNumber"], \name => expectTrue (drawsInk (walk, name)))
    forEachList (codeInks, readsOnCode))

testing ("Stop cancels what runs and answers each owed call, so the next turn is accepted", \() =>
    calling = callingAfter "Go\n"
    ticket = (Model::active calling).chatTicket
    stopped = acted (calling, agentapp::StopTurn)
    chat = idleChat (stopped, "cancel,store-write")
    expect (length (Model::pendingCalls chat), 0)
    late = settledWith (stopped.stepStore, ticket, ok 0, "late")
    sendsNothing late
    expectKinds ((Drive::typing (stopped.stepStore, "Again\n")), "http"))

testing ("a refused request or a lost connection shows why, and Try again resends", \() =>
    opened = goTurn ()
    limited = Drive::answering (opened, ok 429, busyReply)
    expectChatStage (limited.stepStore, "failed")
    expectHas ((Model::active limited.stepStore).chatProblem, "status_code: 429")
    lost = failedWith (opened, "offline")
    expect ((Model::active lost.stepStore).chatProblem, "offline")
    expectKinds ((acted (lost.stepStore, agentapp::Retry)), "http"))

testing ("a blank reply fails in words and leaves no gap", \() =>
    blank = answeredTurn ("yo\n", 200, blankReply)
    chat = Model::active blank.stepStore
    expect (chat.chatStage, "failed")
    expectHas (chat.chatProblem, "no answer")
    labelsShown (Drive::walked (blank.stepStore, View::transcript), ["The model returned no answer.", "Try again"]))

testing ("each refusal status says what to do in words, with Open Settings", \() =>
    opened = goTurn ()
    refused = answeredTurn ("Go\n", 401, "{}")
    expect ((Model::active refused.stepStore).chatProblemStatus, 401)
    transcriptShows (refused.stepStore, "This key was refused.")
    forEachList ([{ status = 401, words = "Open Settings" }, { status = 403, words = "This key was refused." }, { status = 402, words = "DeepSeek has no credit left. Pick another model, or add credit." }, { status = 429, words = "DeepSeek is rate limiting: try again shortly." }], \row => refusalSays (opened, row.status, row.words)))

testing ("a failed tool tells the model and the turn goes on", \() =>
    calling = callingAfter "Go\n"
    second = failedWith (calling, "Timed out after 5 ms")
    expectHas ((listGet (Model::active second.stepStore).chatResults 0 ?: Engine::ToolResult(resultId = "", resultName = "", resultContent = "")).resultContent, "Timed out")
    expectKinds (second, "run"))

testing ("new conversations, switching and the model choice stay per conversation", \() =>
    first = (oneTurn ()).stepStore
    fresh = newChatIn (first, 2)
    expect ((Model::active fresh).chatTitle, "New chat")
    again = newChatIn (fresh, 2)
    chosen = expectModelPicked (again, "deepseek/deepseek-reasoner")
    other = secondChat chosen
    back = (chose (chosen, agentapp::PickChat, other.chatId)).stepStore
    expectTitled (back, "One", "deepseek/deepseek-chat"))

testing ("the composer pick changes only that chat, and effort is kept or cleared on a model change", \() =>
    first = (oneTurn ()).stepStore
    chosen = (chose (first, agentapp::PickModel, "zai/glm-5.3")).stepStore
    efforted = (chose (chosen, agentapp::PickEffort, "high")).stepStore
    expectChosen (efforted, "zai/glm-5.3", "high")
    kept = expectEffortKept (efforted, "kimi-coding/k3", "high")
    cleared = expectEffortKept (kept, "deepseek/deepseek-chat", "")
    other = secondChat cleared
    expect (other.chatModel, "deepseek/deepseek-chat")
    expect (other.chatEffort, ""))

testing ("the settings pane opens in place of the conversation and closes", \() =>
    opened = settingsOpened ()
    expect (opened.settings.settingsOpen, true)
    sendsNothing (acted (opened, agentapp::OpenSettings))
    labelsShown (Drive::walked (opened, View::settings), ["Providers", "MCP servers", "DeepSeek", "GLM (Z.ai API)", "Save DeepSeek key"])
    closed = (acted (opened, agentapp::CloseSettings)).stepStore
    expect (closed.settings.settingsOpen, false))

testing ("the provider's own API names the models, the pickers cascade and every picker says what it is", \() =>
    launched = Drive::startedStep ()
    asked = checkedAsked (launched, 0, "method", "GET", "http")
    expectField (asked, "url", "https://api.deepseek.com/models")
    expect (headerOf (asked, "Authorization"), "Bearer sk-test")
    composerShows (launched.stepStore, "DeepSeek Reasoner")
    composerLacks (launched.stepStore, "DeepSeek V9")
    listed = modelsSettled (launched.stepStore, "deepseek", 200, modelsList ["deepseek-v9", "deepseek-v4-pro", "deepseek-flash"])
    // The default model is gone from the provider, so the empty chat and the default both move to one it names.
    expectDefaultOn (listed, "deepseek/deepseek-flash", "deepseek/deepseek-flash")
    shown = composerWalk listed
    expectMentions (shown, "deepseek-v9")
    composerShows (App::restore (App::save listed), "deepseek-v9")
    labelsAbsent (shown, ["DeepSeek Reasoner", "DeepSeek Chat"])
    // Effort always names itself, from the first moment, and offers only what this model has.
    labelsShown (shown, ["Effort: Default", "Effort: High", "Effort: Max", "Effort: Low"])
    low = expectEffortPicked (listed, "low", "low")
    pro = expectEffortKept (low, "deepseek/deepseek-v4-pro", "")
    composerLacks (pro, "Effort: Low")
    // A model only the provider knows has no effort picker, and can be sent to with the provider's wire.
    live = (chose (pro, agentapp::PickModel, "deepseek/deepseek-v9")).stepStore
    composerLacks (live, "Effort:")
    sent = Drive::typing (live, "Hello\n")
    expectBodySent (sent, "\"model\":\"deepseek-v9\"")
    expectAsked (sent, 0, "url", "https://api.deepseek.com/chat/completions")
    // A chat with words in it keeps its model when the provider drops it; a refused list changes nothing.
    relisted = modelsSettled (sent.stepStore, "deepseek", 200, modelsList ["deepseek-flash"])
    expectDefaultOn (relisted, "deepseek/deepseek-v9", "deepseek/deepseek-flash")
    refused = modelsSettled (listed, "deepseek", 401, "{\"error\":\"no\"}")
    failed = (completed (listed, "models:deepseek", Error(message = "offline"))).stepStore
    forEachList ([refused, failed], \store => composerShows (store, "deepseek-v9"))
    // Saving a key asks that provider; its list then offers its models, and removing the key forgets them.
    typedKey = zaiKeyTyped listed
    savedKey = zaiKeySaved listed
    expectAskedKinds (savedKey, "store-write,http", 1, "url", "https://api.z.ai/api/paas/v4/models")
    zai = modelsSettled (savedKey.stepStore, "zai", 200, modelsList ["glm-9"])
    expectTrue (offers (composerWalk zai, "zai/glm-9"))
    // Settings cascades from the same answer: provider, then its live models, then that model's effort.
    settingsOpen = (acted (zai, agentapp::OpenSettings)).stepStore
    picked = expectDefaultPicked (settingsOpen, agentapp::PickProvider, "zai", "zai/glm-9")
    expect (picked.settings.defaultEffort, "")
    removed = (acted (zai, agentapp::RemoveKey(keyProvider = "zai"))).stepStore
    composerLacks (removed, "glm-9"))

travelsAsWords words = expectBodySent (typingAtLaunch "${words}\n", words)

testing ("a pasted image reaches the model as image data, a typed path never leaves the machine, and a lost image says so", \() =>
    name = "0c1d2e3f.png"
    asked = typingAtLaunch "What is in [image: ${name}] please\n"
    reading = checkedAsked (asked, 0, "executable", "/bin/sh", "run")
    expectHas ((requestField (reading, "arguments")), "/home/ada/Library/Application Support/Osprey/pasted")
    expectHas ((requestField (reading, "arguments")), name)
    expectChatStage (asked.stepStore, "thinking")
    sent = Drive::answering (asked.stepStore, ok 0, "QUJD\n")
    body = askedIn (sent, 0, "body", "http")
    expectHas (body, "\"type\":\"image_url\"")
    expectHas (body, "data:image/png;base64,QUJD")
    expectSays (body, "What is in", "[image:")
    // The next request of the turn sends the same picture again, and the saved conversation holds only its name.
    next = textAnswered sent.stepStore
    savedDoc = Doc::write (App::save next.stepStore)
    expectLacks (savedDoc, "QUJD")
    expectHas (savedDoc, name)
    again = Drive::typing (next.stepStore, "And now?\n")
    expectKinds (again, "run")
    lost = Drive::answering (again.stepStore, ok 0, "\n")
    lostBody = askedIn (lost, 0, "body", "http")
    expectSays (lostBody, "no longer available", "image_url")
    // Words pasted from a log that look like a marker read nothing and travel as the words they are.
    hostile = ["[image: ../../.ssh/id_rsa.png]", "[image: /etc/passwd]", "[image: secret.txt]", "[image: ]", "[image: unclosed.png"]
    forEachList (hostile, travelsAsWords)
    // A failed read is no failed turn: the words still go.
    failedRead = failedWith ((Drive::typing (Drive::started (), "See [image: ${name}]\n")).stepStore, "denied")
    expectBodySent (failedRead, "no longer available"))

testing ("a saved key is written to providers.json, never to the conversations file", \() =>
    saved = keySaved ()
    expectAskedKinds (saved, "store-write,http", 0, "name", "providers.json")
    content = written saved
    expectHas (content, "zai")
    expectHas (content, "sk-zai")
    expect (Drive::keyOf (saved.stepStore, "zai"), "sk-zai")
    expectLacks ((Doc::write (Model::saveDoc (saved.stepStore, "chats.json"))), "sk-zai"))

testing ("removing a key clears it and writes providers.json", \() =>
    saved = keySaved ()
    ticket = ticketAt (saved, 0)
    settled = (okCompleted (saved.stepStore, ticket)).stepStore
    removed = acted (settled, agentapp::RemoveKey(keyProvider = "zai"))
    expectKinds (removed, "store-write")
    expect (Drive::keyOf (removed.stepStore, "zai"), ""))

testing ("a key saved during a conversation write still reaches providers.json, and the reverse", \() =>
    writing = Model::persisting (keyTyped (), "chats.json")
    expectAsked (writing, 0, "name", "chats.json")
    ticket = ticketAt (writing, 0)
    queued = acted (writing.stepStore, agentapp::SaveKey(keyProvider = "zai"))
    expectKinds (queued, "http")
    next = saveSettled (queued.stepStore, ticket, "providers.json")
    nextTicket = ticketAt (next, 0)
    chatsAgain = persistingChats next.stepStore
    sendsNothing chatsAgain
    twice = persistingChats chatsAgain.stepStore
    last = saveSettled (twice.stepStore, nextTicket, "chats.json")
    lastTicket = ticketAt (last, 0)
    done = completed (last.stepStore, lastTicket, ok 0)
    expectKinds (done, ""))

testing ("a restart restores saved keys and the default model and effort", \() =>
    saved = (keySaved ()).stepStore
    providers = Doc::write (Model::providersJson saved.settings)
    restored = relaunchedWith (200, "providers", providers)
    expect (Drive::keyOf (restored, "zai"), "sk-zai"))

testing ("a dotenv fills every empty slot and never overwrites a pasted key", \() =>
    launched = launchedStore ()
    filled = envRead (launched, "ZAI_API_KEY=sk-zai\nGLM_API_KEY=sk-glm\n")
    expect (Drive::keyOf (filled, "zai"), "sk-zai")
    expect (Drive::keyOf (filled, "deepseek"), "")
    expectPastedKept (filled, "zai", "ZAI_API_KEY=sk-file\n"))

testing ("the default model, provider and effort chosen in Settings are inherited by a new chat", \() =>
    opened = settingsOpened ()
    provided = expectDefaultPicked (opened, agentapp::PickProvider, "zai", "zai/glm-5.3")
    modelled = expectDefaultPicked (provided, agentapp::PickDefaultModel, "zai/glm-5.3", "zai/glm-5.3")
    efforted = expectDefaultPicked (modelled, agentapp::PickDefaultEffort, "high", "zai/glm-5.3")
    expect (efforted.settings.defaultEffort, "high")
    fresh = newChat efforted
    expectChosen (fresh, "zai/glm-5.3", "high"))

testing ("the conversation a launch opens takes the saved default model, and a conversation already under way keeps its own", \() =>
    launched = launchedStore ()
    saved = "{\"keys\":[{\"provider\":\"zai\",\"value\":\"sk-glm\"}],\"model\":\"zai/glm-5.3\",\"effort\":\"high\"}"
    loaded = readBack (launched, "providers", saved)
    expectChosen (loaded, "zai/glm-5.3", "high")
    busy = goTurn ()
    keptModel = (Model::active busy).chatModel
    after = readBack (busy, "providers", saved)
    expect ((Model::active after).chatModel, keptModel))

testing ("the composer lists keyed providers' models and an Add an API key button with none", \() =>
    noKey = composerOf (launchedStore ())
    expectDraws (noKey, "Add an API key")
    expectNotDraws (noKey, "Send")
    labelsShown (composerWalk (Drive::started ()), ["Send", "Model"]))

testing ("no key says what is wrong in words, never as a lone lock", \() =>
    noKey = composerOf (launchedStore ())
    // A lock symbol, and a bare symbol with no words beside it, are what the composer never falls back to.
    labelsAbsent (composerWalk (launchedStore ()), ["lock"])
    expectFalse (loneGlyph noKey)
    expectDraws (noKey, "No API key for DeepSeek. Add one to send.")
    // With a key the one action is Send, its symbol carried as the hint the host draws, and no missing-key words.
    keyed = composerOf (Drive::started ())
    expectHint (keyed, "Send", "send")
    expectOmits (composerWalk (Drive::started ()), "No API key for"))

testing ("a launch with no key file argument finds the key file kept in the app's own store", \() =>
    first = App::initial (contextAt (100, []))
    expectKinds (first, "store-read,store-read,store-read,store-read,store-read,run")
    expect (Drive::keyOf (envRead (first.stepStore, "DEEPSEEKKEY=sk-kept\n"), "deepseek"), "sk-kept"))

// A failure of any kind leaves Send live, and the next send asks the provider again and can succeed.
recoversFrom status =
    opened = goTurn ()
    failed = (Drive::answering (opened, ok status, "{}")).stepStore
    expectChatStage (failed, "failed")
    typed = (Drive::typing (failed, "Again")).stepStore
    shown = composerOf typed
    expectDraws (shown, "Send")
    expect ((Views::control (shown, "Send")).controlEnabled, true)
    labelsAbsent (composerWalk typed, ["lock"])
    again = Drive::typing (failed, "Again\n")
    expectStage (again, "http", "thinking")
    expect ((Model::active again.stepStore).chatProblem, "")
    answeredSaying (again.stepStore, "Done.", "The request failed")

testing ("no credit, a refused key, a rate limit and a server fault never stop the next send", \() =>
    forEachList ([402, 401, 403, 429, 500], recoversFrom))

testing ("the sidebar shows a Settings button with a warning when the open provider has no key", \() =>
    noKey = Drive::showing (launchedStore (), View::sidebar)
    expectDraws (noKey, "Settings")
    expectHint (noKey, "Settings", "warning")
    expectHint (Drive::showing (Drive::started (), View::sidebar), "Settings", "settings"))

testing ("changing folder keeps the active history, saves it and leaves every other chat alone", \() =>
    first = (oneTurn ()).stepStore
    firstId = (Model::active first).chatId
    second = (textAnswered ((Drive::typing (newChat first, "Two\n")).stepStore)).stepStore
    secondId = (Model::active second).chatId
    chosen = (chose (second, agentapp::PickChat, firstId)).stepStore
    before = Model::active chosen
    asked = acted (chosen, agentapp::ChangeFolder)
    expectKinds (asked, "choose-folder")
    expectSameSession (asked.stepStore, chosen)
    moved = folderChosen (asked.stepStore, "/work/other")
    active = Model::active moved.stepStore
    other = listGet moved.stepStore.chats 0 ?: active
    expectChatIn (active, firstId, "/work/other")
    expect (Doc::write active.chatHistory, Doc::write before.chatHistory)
    expectChatIn (other, secondId, "/work/project")
    expectKinds (moved, "run")
    resaved = completed (moved.stepStore, "save:0", okJson [])
    expectWrote (resaved, "store-write", "/work/other")
    movedComposer = composerOf (moved.stepStore)
    expectFolder (moved.stepStore, View::composer, "other", true)
    expectNotDraws (movedComposer, "project")
    forEachList ([okDone "", Error(message = "denied")], \outcome => expectFolderKept (moved, outcome))
    inherited = (acted (moved.stepStore, agentapp::NewChat)).stepStore
    expect ((Model::active inherited).chatFolder, "/work/other"))

testing ("the folder chip follows busy state, the old sidebar action is gone and the access warning stays visible", \() =>
    started = Drive::started ()
    idle = composerOf started
    busyStore = (Drive::typing (started, "One\n")).stepStore
    busy = composerOf busyStore
    failedStore = (Drive::answering (busyStore, ok 429, busyReply)).stepStore
    failed = composerOf failedStore
    sidebar = Drive::showing (started, View::sidebar)
    warning = "Not sandboxed: the agent can run any command and change any file your account can."
    expectFolder (started, View::composer, "project", true)
    expectFolder (busyStore, View::composer, "project", false)
    expectNotDraws (sidebar, "Open folder")
    forEachList ([idle, busy, failed], \seen => expectDraws (seen, warning))
    expectHint (idle, warning, "warning"))

testing ("a restart restores conversations with distinct identities and fresh tickets", \() =>
    first = oneTurn ()
    restored = relaunchedChats (200, first)
    ids = mapList (restored.chats, \chat => chat.chatId)
    expect (length ids, 2)
    expectFalse ((listGet ids 0 ?: "") == (listGet ids 1 ?: ""))
    expect ((Model::active restored).chatTitle, "New chat")
    expect ((secondChat restored).chatTitle, "One")
    expectTrue (restored.ticketCount >= first.stepStore.ticketCount))

testing ("a turn cut off by quitting answers what it owed, so the restored conversation can go on", \() =>
    calling = turnDone ("Go\n", toolReply)
    restored = relaunchedChats (200, persistingChats calling)
    old = secondChat restored
    expect (length (Model::pendingCalls old), 0)
    expect (old.chatStage, "idle")
    keyed = (chose (restored, agentapp::PickChat, old.chatId)).stepStore
    settings = keyed.settings
    next = Drive::typing (keyed(settings = Model::withKey (settings, "deepseek", "sk-test")), "Again\n")
    expectBodySent (next, "before it ran"))

testing ("a first message the model refused is kept and is not reused as a new chat", \() =>
    refused = answeredTurn ("Keep these words\n", 429, busyReply)
    file = written refused
    expectHas (file, "Keep these words")
    expect (length (newChat (refused.stepStore)).chats, 2))

testing ("a key file arriving late never replaces a key the person pasted", \() =>
    launched = launchedStore ()
    expectPastedKept (launched, "deepseek", "DEEPSEEKKEY=sk-file\n"))

testing ("a failed save is shown and the next good save clears it", \() =>
    done = oneTurn ()
    ticket = ticketAt (done, 0)
    failed = completed (done.stepStore, ticket, Error(message = "disk full"))
    expectHas (failed.stepStore.settings.saveProblem, "disk full")
    cleared = okCompleted (failed.stepStore, ticket)
    expect (cleared.stepStore.settings.saveProblem, ""))

testing ("saves run one at a time and the newest state is written last", \() =>
    first = oneTurn ()
    ticket = askedIn (first, 0, "ticket", "store-write")
    second = persistingChats first.stepStore
    sendsNothing second
    changed = second.stepStore
    chat = Model::active changed
    renamed = Model::putChat (changed, chat(chatTitle = "Newest"))
    ended = okCompleted (renamed, ticket)
    expectWrote (ended, "store-write", "Newest")
    sendsNothing (okCompleted (ended.stepStore, ticket)))

testing ("the session document restores the store it saved", \() =>
    calling = turnDone ("Go\n", toolReply)
    expectRoundTrips calling)

replyLine (id, result) = "${Doc::write (JsonObject [Doc::str ("jsonrpc", "2.0"), JsonMember "id" id, JsonMember "result" result])}\n"

initializeReply () = replyLine (JsonInt 1, JsonObject [Doc::str ("protocolVersion", "2025-06-18"), JsonMember "capabilities" (JsonObject [JsonMember "tools" (JsonObject [])]), JsonMember "serverInfo" (JsonObject [Doc::str ("name", "osprey-test-server"), Doc::str ("version", "1")])])

toolJson (name, description) = JsonObject [Doc::str ("name", name), Doc::str ("description", description), JsonMember "inputSchema" (JsonObject [Doc::str ("type", "object")])]

toolsReply (id, names, cursor) = replyLine (JsonInt id, JsonObject [JsonMember "tools" (JsonArray (mapList (names, \name => toolJson (name, "The ${name} tool.")))), Doc::str ("nextCursor", cursor)])

callReply (id, text, failed) = replyLine (JsonInt id, JsonObject [JsonMember "content" (JsonArray [JsonObject [Doc::str ("type", "text"), Doc::str ("text", text)]]), Doc::bit ("isError", failed)])

serverPing () = "{\"jsonrpc\":\"2.0\",\"id\":\"server-ping-1\",\"method\":\"ping\"}\n"

readDone (output, exited) = Doc::write (JsonObject [Doc::str ("output", output), Doc::str ("stderr", ""), Doc::bit ("exited", exited), Doc::num ("status", 0)])

okJson members = okDone (Doc::write (JsonObject members))

okDone text = Success(value = text)

// The standard project document this suite loads: one command server, off until switched on.
projectDoc = "{\"mcpServers\":{\"local\":{\"command\":\"node\",\"args\":[\"local.js\"]}}}"

// The demo server in a step's store, or a blank one when absent.
demoOf step = McpModel::named (step.stepStore.mcp, "demo") ?: McpModel::blankServer ""

// The standard MCP documents this suite loads, with a secret that must never leave mcp.json.
mcpDoc () = "{\"mcpServers\":{\"demo\":{\"command\":\"python3\",\"args\":[\"server.py\"],\"env\":{\"MCP_TEST_WORD\":\"zephyr-secret\",\"TOKEN\":\"mcp-env-secret\"}}}}"

mcpSlice key =
    match key
        "env" => "DEEPSEEKKEY=sk-test\n"
        "mcp-file" => mcpDoc ()
        _ => ""

// The step after the person typed `words` into a connected demo server.
connectedTyping words = Drive::typing (mcpConnected (), words)

// The step after a connected demo server's turn on `words` asked for its `tool`.
askedTool (words, tool) = answered ((connectedTyping words).stepStore, callsTool ("c1", tool))

// The store after `store` read `name`'s document, `found` whether its file was there.
mcpSettled (store, name, found) = (settledBy (store, name, readOutcome found, mcpSlice)).stepStore

// Launch with the MCP documents answered, so the demo server is connecting.
mcpLaunched () =
    opened = launchStep ()
    keyed = (settledBy (opened.stepStore, "env", ok 0, mcpSlice)).stepStore
    providers = foldList (["providers", "chats", "mcp-global", "mcp-state"], keyed, \(store, name) => mcpSettled (store, name, name == "mcp-global"))
    settledBy (providers, "mcp-project", ok 0, mcpSlice)

// The project file's slice: `doc` for the project read, nothing for any other key.
projectOnly doc key =
    match key
        "mcp-project-file" => doc
        _ => ""

// The step after the project file was read as the standard document.
projectRead store = settledBy (store, "mcp-project", ok 0, projectOnly (projectDoc))


// The store after the save in flight completed, so the next queued document can be written.
saveDone step = saveTicket (step, ticketOf (step.requests))

ticketOf requests = (listGet (filterList (requests, \r => Requests::kind r.capability == "store-write")) 0 ?: Requests::ask ("none", ui::Cancel(cancelled = ""))).ticket

saveTicket (step, ticket) = settledBy (step.stepStore, ticket, okJson [], mcpSlice)


// The local project server's switch in a step's store.
expectLocalOn step want = match Lists::find (step.stepStore.mcp.stateServers, \one => one.serverName == "local")
    Success value => expect (value.serverEnabled, want)
    Error _ => expect ("local", "found")

testing ("launch asks for the MCP documents, connects enabled servers and keeps project servers off", \() =>
    first = launchAsk ()
    started = mcpLaunched ()
    // The demo stdio server starts with its configured environment.
    request = askedAt (started, 0)
    expectField (request, "kind", "process-start")
    expectField (request, "command", "python3")
    expectField (request, "name", "mcp:demo")
    expect (envOf (request, "MCP_TEST_WORD"), "zephyr-secret")
    expectPhase (started, "connecting")
    // A project server from .mcp.json stays off until the person turns it on.
    reopened = projectRead started.stepStore
    names = mapList (reopened.stepStore.mcp.stateServers, \one => "${one.serverName}:${toString one.serverEnabled}")
    expect (join (names, ","), "demo:true,local:false")
    expectMcpTab (reopened.stepStore, ".mcp.json"))

testing ("no MCP documents at all is no problem and no servers", \() =>
    missing = McpModel::projectMissing (McpModel::globalMissing (McpModel::fresh "/work/project"))
    expect (length missing.stateProblems, 0)
    expect (length missing.stateServers, 0)
    empty = McpModel::projectLoaded (McpModel::globalLoaded (McpModel::fresh "/work/project", "{}"), "{\"mcpServers\":{}}")
    expect (length empty.stateServers, 0)
    expect (join empty.stateProblems "|", "mcp.json: the configuration must have an mcpServers object")
    // The first server has to be addable: the form shows with no servers and no problems.
    launched = launchedStore ()
    onTab = acted (launched, agentapp::ShowSettingsTab(tabKey = "mcp"))
    labelsShown (Drive::walked (onTab.stepStore, View::settings), ["No MCP servers yet", "Add server", "Paste JSON"]))

// The demo server's whole connect handshake, every request checked, ending on the connected read.
mcpHandshake () =
    begun = mcpStarted ()
    expectSent (begun, "process-write", 0, "input", "\"method\":\"initialize\"")
    afterWrite = expectMcpWrote (begun.stepStore, 96)
    // The initialize answer and the server ping arrive in one read; the ping must be answered.
    answered = mcpRead (afterWrite.stepStore, initializeReply () + serverPing ())
    expectKinds (answered, "process-write")
    showsAll (askedField (answered, 0, "input"), ["notifications/initialized", "\"method\":\"tools/list\"", "\"id\":\"server-ping-1\""])
    pageTwo = mcpReadAfter (answered, 96, toolsReply (2, ["secret_word", "add"], "2"))
    expectInput (pageTwo, 0, "\"cursor\":\"2\"")
    mcpReadAfter (pageTwo, 64, toolsReply (3, ["fails", "slow", "die"], ""))

testing ("a stdio server connects: initialize, both list pages, the server ping answered, tools offered to the model", \() =>
    final = mcpHandshake ()
    server = demoOf final
    expectPhase (final, "connected")
    expect (length (Doc::items (Doc::parse server.serverTools)), 5)
    expectKinds (final, "process-read"))

// The connected state every later MCP test starts from.
mcpConnected () = (mcpHandshake ()).stepStore

testing ("a prefixed tool call goes through its server, the answer reaches the next request and isError stays tool text", \() =>
    asking = askedTool ("What is the word?\n", "demo_secret_word")
    // The call is written to the server, not run as a process.
    expectKinds (asking, "process-write")
    expectInput (asking, 0, "\"name\":\"secret_word\"")
    expect ((Model::active asking.stepStore).chatTicket, "mcpcall:demo")
    afterWrite = expectMcpWrote (asking.stepStore, 80)
    // The read that was listening is replaced by the host, and its cancellation is no failure of the call.
    superseded = completed (afterWrite.stepStore, "mcpread:demo", Error(message = "Cancelled"))
    expectStage (superseded, "", "tools")
    serverSaid = completed (superseded.stepStore, "mcpread:demo", okDone (readDone (callReply (4, "zephyr-secret", false), false)))
    // The server's real answer went back to the model in the next request's body.
    expectSent (serverSaid, "process-read,http", 1, "body", "zephyr-secret")
    expectResults (serverSaid.stepStore, 0)
    // An isError reply is the tool's text, and the turn carries on.
    afterFailWrite = mcpAsked (serverSaid.stepStore, callsTool ("c2", "demo_fails"), 70)
    failedRead = mcpRead (afterFailWrite.stepStore, callReply (5, "this tool always fails", true))
    expectHas ((askedField (failedRead, 1, "body")), "this tool always fails")
    answeredSaying (failedRead.stepStore, "Used 2 tools", "Read 2 files"))

testing ("a dead server fails its call in words, Reconnect restarts it, and a slow server times out its own call", \() =>
    opened = connectedTyping "Go\n"
    afterWrite = mcpAsked (opened.stepStore, callsTool ("c1", "demo_die"), 60)
    died = completed (afterWrite.stepStore, "mcpread:demo", okDone (readDone ("", true)))
    expectPhase (died, "failed")
    expectHas ((demoOf died).serverProblem, "exited")
    expectBodySent (died, "exited before answering")
    // Only a person pressing Reconnect restarts it.
    reconnected = acted (died.stepStore, agentapp::ReconnectMcp(mcpActionName = "demo"))
    expectAsked (reconnected, 0, "kind", "process-start")
    expectPhase (reconnected, "connecting")
    // A slow server fails that one call past its deadline, says so to the model, and stays connected.
    slowAsking = askedTool ("Go slow\n", "demo_slow")
    slowWritten = mcpWrote (slowAsking.stepStore, 60)
    stillWaiting = mcpRead (slowWritten.stepStore, "")
    expectChatStage (stillWaiting.stepStore, "tools")
    timedOut = Drive::deliverAt (100000, stillWaiting.stepStore, ui::Completed(ticket = "mcpread:demo", outcome = okDone (readDone ("", false))), \_ => "")
    expectPhase (timedOut, "connected")
    expectHas (httpBody timedOut, "did not answer within"))

testing ("remove stops the process, rewrites mcp.json and takes the tools out of the next request; the switch is remembered per folder", \() =>
    removed = acted (mcpConnected (), agentapp::RemoveMcp(mcpActionName = "demo"))
    expectAskedKinds (removed, "process-stop,store-write", 1, "name", "mcp.json")
    expectLacks ((written removed), "demo")
    expect (length removed.stepStore.mcp.stateServers, 0)
    settled = saveDone removed
    opened = Drive::typing (settled.stepStore, "Again\n")
    expectLacks ((askedField (opened, 0, "body")), "demo_secret_word")
    // A project server toggled on in one folder is remembered off in another.
    withProject = projectRead settled.stepStore
    toggled = Drive::deliver (withProject.stepStore, ui::Switched(toggle = agentapp::ToggleMcp(mcpActionName = "local"), switched = true), "")
    expectAskedKinds (toggled, "process-start,store-write", 1, "name", "mcp-state.json")
    settledToggle = saveDone toggled
    moved = folderChosen (settledToggle.stepStore, "/work/other")
    again = projectRead moved.stepStore
    expectLocalOn again false
    back = folderChosen (again.stepStore, "/work/project")
    returned = projectRead back.stepStore
    expectLocalOn returned true)

testing ("the add form validates in words, paste is atomic, broken files report words and secrets stay in mcp.json", \() =>
    started = mcpLaunched ()
    named = typedInto (started.stepStore, agentapp::McpName, "demo")
    expectMcpTab (named.stepStore, "Add server")
    named2 = typedInto (named.stepStore, agentapp::McpName, "weather")
    commanded = typedInto (named2.stepStore, agentapp::McpCommand, "python3")
    added = typedAdded ((typedInto (commanded.stepStore, agentapp::McpArguments, "server.py")).stepStore, agentapp::McpEnvironment, "KEY=mcp-env-secret")
    expectWrote (added, "process-start,store-write", "mcp-env-secret")
    // The form forgets what it was given, so a secret is never on show after Add.
    expectFormCleared added
    expectFalse (shows (added.stepStore, View::settings, "mcp-env-secret"))
    // A name that clashes is refused in words and nothing is asked.
    clash = typedAdded ((typedInto (added.stepStore, agentapp::McpName, "demo")).stepStore, agentapp::McpCommand, "python3")
    refusedForm (clash, "already exists")
    emptyName = typedAdded (clash.stepStore, agentapp::McpName, "")
    expectFormProblem (emptyName, "Enter a server name.")
    picked = chose ((typedInto (emptyName.stepStore, agentapp::McpName, "far")).stepStore, agentapp::PickMcpType, "url")
    badUrl = typedAdded (picked.stepStore, agentapp::McpUrl, "ftp://example.test/mcp")
    expectFormProblem (badUrl, "HTTPS URL")
    // Pasting the standard block adds every server at once; a broken entry adds nothing.
    settledAdd = saveDone added
    pasted = typedThenActed (settledAdd.stepStore, agentapp::McpPaste, "{\"mcpServers\":{\"one\":{\"command\":\"node\",\"args\":[\"one.js\"]}}}", agentapp::PasteMcpServers)
    expectKinds (pasted, "process-start,store-write")
    brokenPaste = typedThenActed (pasted.stepStore, agentapp::McpPaste, "{\"mcpServers\":{\"ok\":{\"command\":\"node\"},\"bad\":{}}}", agentapp::PasteMcpServers)
    refusedForm (brokenPaste, "must have either")
    // A broken file and an unsupported entry are words, never a crash.
    brokenFile = settledWith (brokenPaste.stepStore, "mcp-global", readOutcome true, "{broken")
    expectHas ((join brokenFile.stepStore.mcp.stateProblems "\n"), "not valid JSON")
    unsupported = settledWith (brokenFile.stepStore, "mcp-global", readOutcome true, "{\"mcpServers\":{\"nope\":{\"command\":\"\"},\"cwd\":{\"command\":\"x\",\"cwd\":\"/tmp\"},\"plain\":{\"url\":\"http://example.test/mcp\"}}}")
    showsAll (join unsupported.stepStore.mcp.stateProblems "\n", ["needs a command", "cwd", "HTTPS"])
    // The secrets never reach the conversations file, the switch file or the session document.
    sent = Drive::typing (unsupported.stepStore, "Done\n")
    final = (textAnswered sent.stepStore).stepStore
    forEachList ([Doc::write (Model::saveDoc (final, "chats.json")), Doc::write (McpModel::switchesJson final.mcp)], \doc => expectLacks (doc, "mcp-env-secret"))
    forEachList ([Doc::write (App::save final), Doc::write (Model::saveDoc (final, "mcp.json"))], \doc => expectLacks (doc, "zephyr-secret"))
    expectHas ((Doc::write (Model::saveDoc ((mcpLaunched ()).stepStore, "mcp.json"))), "zephyr-secret")
    expectRoundTrips final)

// `work` with every host-held slice answered empty, as this suite's scripted host does.
withSlices work =
    handle ui::Slices
        fetch _ => ""
    work ()

// Expect the driven host frame `driven` to draw `text` as a control's words.
drivenShows (driven, text) = expectTrue (uitest::Views::shows (driven.drivenSeen, text))

// The driven frame after the person pressed `label`, with every host-held slice answered empty.
pressedFrame (driven, label) = withSlices (\() => uitest::Drive::press (driven, label))

testing ("the boundary opens the window, draws the regions a host reads and delivers a typed host event", \() =>
    opened = withSlices (\() => uitest::Drive::launched (uitest::Drive::idle (App::program (), Drive::started ()), "macos", []))
    drivenShows (opened, "Add an API key")
    drivenShows (opened, "Model")
    // A press draws the next frame: the settings pane replaces the conversation column.
    onSettings = pressedFrame (opened, "Settings")
    expect (onSettings.drivenSurface.surfaceSession.sessionStore.settings.settingsOpen, true)
    drivenShows (onSettings, "Providers")
    // An event naming no control the application issued is refused, and the store is untouched.
    refused = pressedFrame (onSettings, "No such control")
    expectFalse (refused.drivenSurface.surfaceProblem == "")
    expect (refused.drivenSurface.surfaceSession.sessionStore.settings.settingsOpen, true))
