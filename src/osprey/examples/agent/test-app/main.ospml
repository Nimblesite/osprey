testing ("saves run one at a time and the newest state is written last", \() =>
    first = answered ((typingAtLaunch "One\n").stepStore, textReply)
    expect (Drive::kinds first, "store-write")
    ticket = askedField (first, 0, "ticket")
    second = Model::persisting (first.stepStore, "chats.json")
    expect (Drive::kinds second, "")
    changed = second.stepStore
    chat = Model::active changed
    renamed = Model::putChat (changed, chat(chatTitle = "Newest"))
    ended = completed (renamed, ticket, ok 0)
    expect (Drive::kinds ended, "store-write")
    expectHas ((written ended), "Newest")
    expect (Drive::kinds (completed (ended.stepStore, ticket, ok 0)), ""))

testing ("the session document restores the store it saved", \() =>
    calling = (answered ((typingAtLaunch "Go\n").stepStore, toolReply)).stepStore
    expect (Doc::write (App::save (App::restore (App::save calling))), Doc::write (App::save calling)))

replyLine (id, result) = "${Doc::write (JsonObject [Doc::str ("jsonrpc", "2.0"), JsonMember "id" id, JsonMember "result" result])}\n"

initializeReply () = replyLine (JsonInt 1, JsonObject [Doc::str ("protocolVersion", "2025-06-18"), JsonMember "capabilities" (JsonObject [JsonMember "tools" (JsonObject [])]), JsonMember "serverInfo" (JsonObject [Doc::str ("name", "osprey-test-server"), Doc::str ("version", "1")])])

toolJson (name, description) = JsonObject [Doc::str ("name", name), Doc::str ("description", description), JsonMember "inputSchema" (JsonObject [Doc::str ("type", "object")])]

toolsReply (id, names, cursor) = replyLine (JsonInt id, JsonObject [JsonMember "tools" (JsonArray (mapList (names, \name => toolJson (name, "The ${name} tool.")))), Doc::str ("nextCursor", cursor)])

callReply (id, text, failed) = replyLine (JsonInt id, JsonObject [JsonMember "content" (JsonArray [JsonObject [Doc::str ("type", "text"), Doc::str ("text", text)]]), Doc::bit ("isError", failed)])

serverPing () = "{\"jsonrpc\":\"2.0\",\"id\":\"server-ping-1\",\"method\":\"ping\"}\n"

readDone (output, exited) = JsonObject [Doc::str ("output", output), Doc::str ("stderr", ""), Doc::bit ("exited", exited), Doc::num ("status", 0)]

okJson members = Success(value = JsonObject members)

okDone result = Success(value = result)

// The demo server in a step's store, or a blank one when absent.
demoOf step = McpModel::named (step.stepStore.mcp, "demo") ?: agentapp::McpServer(serverName = "", serverOrigin = "", serverKind = "", serverEndpoint = "", serverConfig = "", serverEnabled = false, serverPhase = "", serverTools = "[]", serverProblem = "", serverBuffer = "", serverSession = "", serverRpc = "", serverAwait = "", serverNextId = 1, serverReadTicket = "", serverCallChat = "", serverCallId = "", serverCallUntil = 0, serverCallText = "", serverCallDone = false)

// Launch with the MCP documents answered, so the demo server is connecting.
// The standard MCP documents this suite loads, with a secret that must never leave mcp.json.
mcpDoc () = "{\"mcpServers\":{\"demo\":{\"command\":\"python3\",\"args\":[\"server.py\"],\"env\":{\"MCP_TEST_WORD\":\"zephyr-secret\",\"TOKEN\":\"mcp-env-secret\"}}}}"

mcpSlice key =
    match key
        "env" => "DEEPSEEKKEY=sk-test\n"
        "mcp-file" => mcpDoc ()
        _ => ""

mcpLaunched () =
    opened = App::initial (context 100)
    envDone = settledBy (opened.stepStore, "env", ok 0, mcpSlice)
    providersDone = settledBy (envDone.stepStore, "providers", readOutcome false, mcpSlice)
    chatsDone = settledBy (providersDone.stepStore, "chats", readOutcome false, mcpSlice)
    globalDone = settledBy (chatsDone.stepStore, "mcp-global", readOutcome true, mcpSlice)
    stateDone = settledBy (globalDone.stepStore, "mcp-state", readOutcome false, mcpSlice)
    settledBy (stateDone.stepStore, "mcp-project", ok 0, mcpSlice)

// The project file's slice: `doc` for the project read, nothing for any other key.
projectOnly doc key =
    match key
        "mcp-project-file" => doc
        _ => ""

// The store after the save in flight completed, so the next queued document can be written.
saveDone step = saveTicket (step, ticketOf (step.requests))

ticketOf requests = Doc::text (Requests::encode (listGet (filterList (requests, \r => Doc::text (Requests::encode r, "kind") == "store-write")) 0 ?: Requests::ask ("none", ui::Cancel(cancelled = ""))), "ticket")

saveTicket (step, ticket) = settledBy (step.stepStore, ticket, okJson [], mcpSlice)


// The local project server's switch in a step's store.
expectLocalOn step want = match Lists::find (step.stepStore.mcp.stateServers, \one => one.serverName == "local")
    Success value => expect (value.serverEnabled, want)
    Error _ => expect ("local", "found")

expectRememberedOn step want = match Lists::find (step.stepStore.mcp.stateServers, \one => one.serverName == "local")
    Success value => expect (value.serverEnabled, want)
    Error _ => expect ("local", "found")

testing ("launch asks for the MCP documents, connects enabled servers and keeps project servers off", \() =>
    first = App::initial (context 100)
    expect (Drive::kinds first, "run,store-read,store-read,store-read,store-read,run")
    started = mcpLaunched ()
    // The demo stdio server starts with its configured environment.
    request = askedAt (started, 0)
    expect (Doc::text (request, "kind"), "process-start")
    expect (Doc::text (request, "command"), "python3")
    expect (Doc::text (request, "name"), "mcp:demo")
    expectHas ((Doc::write request), "MCP_TEST_WORD")
    expectHas ((Doc::write request), "zephyr-secret")
    server = demoOf started
    expect (server.serverPhase, "connecting")
    // A project server from .mcp.json stays off until the person turns it on.
    projectDoc = "{\"mcpServers\":{\"local\":{\"command\":\"node\",\"args\":[\"local.js\"]}}}"
    reopened = settledBy (started.stepStore, "mcp-project", ok 0, projectOnly (projectDoc))
    names = mapList (reopened.stepStore.mcp.stateServers, \one => "${one.serverName}:${toString one.serverEnabled}")
    expect (join (names, ","), "demo:true,local:false")
    onTab = acted (reopened.stepStore, agentapp::ShowSettingsTab(tabKey = "mcp"))
    expectTrue (shows (onTab.stepStore, View::settings, ".mcp.json")))

testing ("no MCP documents at all is no problem and no servers", \() =>
    missing = McpModel::projectMissing (McpModel::globalMissing (McpModel::fresh "/work/project"))
    expect (length missing.stateProblems, 0)
    expect (length missing.stateServers, 0)
    empty = McpModel::projectLoaded (McpModel::globalLoaded (McpModel::fresh "/work/project", "{}"), "{\"mcpServers\":{}}")
    expect (length empty.stateServers, 0)
    expect (join empty.stateProblems "|", "mcp.json: the configuration must have an mcpServers object")
    // The first server has to be addable: the form shows with no servers and no problems.
    launched = launchedStore ()
    onTab = acted (launched, agentapp::ShowSettingsTab(tabKey = "mcp"))
    shown = Drive::showing (onTab.stepStore, View::settings)
    expectHas (shown, "No MCP servers yet")
    expectHas (shown, "Add server")
    expectHas (shown, "Paste JSON"))

testing ("a stdio server connects: initialize, both list pages, the server ping answered, tools offered to the model", \() =>
    begun = mcpStarted ()
    write = askedAt (begun, 0)
    expect (Drive::kinds begun, "process-write")
    expectHas ((Doc::text (write, "input")), "\"method\":\"initialize\"")
    afterWrite = mcpWrote (begun.stepStore, 96)
    expect (Drive::kinds afterWrite, "process-read")
    // The initialize answer and the server ping arrive in one read; the ping must be answered.
    answered = mcpRead (afterWrite.stepStore, initializeReply () + serverPing ())
    listing = askedAt (answered, 0)
    expect (Drive::kinds answered, "process-write")
    expectHas ((Doc::text (listing, "input")), "notifications/initialized")
    expectHas ((Doc::text (listing, "input")), "\"method\":\"tools/list\"")
    expectHas ((Doc::text (listing, "input")), "\"id\":\"server-ping-1\"")
    pageTwo = mcpRead ((mcpWrote (answered.stepStore, 96)).stepStore, toolsReply (2, ["secret_word", "add"], "2"))
    expectHas ((askedField (pageTwo, 0, "input")), "\"cursor\":\"2\"")
    final = mcpRead ((mcpWrote (pageTwo.stepStore, 64)).stepStore, toolsReply (3, ["fails", "slow", "die"], ""))
    server = demoOf final
    expect (server.serverPhase, "connected")
    expect (length (Doc::items (Doc::parse server.serverTools)), 5)
    expect (Drive::kinds final, "process-read"))

// The connected state every later MCP test starts from.
mcpConnected () =
    begun = mcpStarted ()
    answered = mcpRead ((mcpWrote (begun.stepStore, 96)).stepStore, initializeReply () + serverPing ())
    pageTwo = mcpRead ((mcpWrote (answered.stepStore, 96)).stepStore, toolsReply (2, ["secret_word", "add"], "2"))
    (mcpRead ((mcpWrote (pageTwo.stepStore, 64)).stepStore, toolsReply (3, ["fails", "slow", "die"], ""))).stepStore

testing ("a prefixed tool call goes through its server, the answer reaches the next request and isError stays tool text", \() =>
    connected = mcpConnected ()
    opened = Drive::typing (connected, "What is the word?\n")
    askingReply = "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Looking.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"demo_secret_word\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}"
    asking = answered (opened.stepStore, askingReply)
    // The call is written to the server, not run as a process.
    expect (Drive::kinds asking, "process-write")
    expectHas ((askedField (asking, 0, "input")), "\"name\":\"secret_word\"")
    expect ((Model::active asking.stepStore).chatTicket, "mcpcall:demo")
    afterWrite = mcpWrote (asking.stepStore, 80)
    expect (Drive::kinds afterWrite, "process-read")
    // The read that was listening is replaced by the host, and its cancellation is no failure of the call.
    superseded = completed (afterWrite.stepStore, "mcpread:demo", Error(message = "Cancelled"))
    expect (Drive::kinds superseded, "")
    expect ((Model::active superseded.stepStore).chatStage, "tools")
    serverSaid = completed (superseded.stepStore, "mcpread:demo", okDone (readDone (callReply (4, "zephyr-secret", false), false)))
    // The server's real answer went back to the model in the next request's body.
    expect (Drive::kinds serverSaid, "process-read,http")
    expectHas ((askedField (serverSaid, 1, "body")), "zephyr-secret")
    expect (length (Model::active serverSaid.stepStore).chatResults, 0)
    // An isError reply is the tool's text, and the turn carries on.
    failing = answered (serverSaid.stepStore, "{\"id\":\"r2\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"demo_fails\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":9,\"completion_tokens\":2,\"total_tokens\":11}}")
    afterFailWrite = mcpWrote (failing.stepStore, 70)
    failedRead = mcpRead (afterFailWrite.stepStore, callReply (5, "this tool always fails", true))
    expectHas ((askedField (failedRead, 1, "body")), "this tool always fails")
    done = answered (failedRead.stepStore, textReply)
    expect ((Model::active done.stepStore).chatStage, "idle")
    // A tool step names its server.
    expectTrue (shows (done.stepStore, View::transcript, "Used 2 tools"))
    expectFalse (shows (done.stepStore, View::transcript, "Read 2 files")))

testing ("a dead server fails its call in words, Reconnect restarts it, and a slow server times out its own call", \() =>
    connected = mcpConnected ()
    opened = Drive::typing (connected, "Go\n")
    asking = answered (opened.stepStore, "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"demo_die\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":8,\"completion_tokens\":2,\"total_tokens\":10}}")
    afterWrite = mcpWrote (asking.stepStore, 60)
    died = completed (afterWrite.stepStore, "mcpread:demo", okDone (readDone ("", true)))
    server = demoOf died
    expect (server.serverPhase, "failed")
    expectHas (server.serverProblem, "exited")
    expect (Drive::kinds died, "http")
    expectHas ((askedField (died, 0, "body")), "exited before answering")
    // Only a person pressing Reconnect restarts it.
    reconnected = acted (died.stepStore, agentapp::ReconnectMcp(mcpActionName = "demo"))
    expectAsked (reconnected, 0, "kind", "process-start")
    expect ((demoOf reconnected).serverPhase, "connecting")
    // A slow server fails that one call past its deadline, says so to the model, and stays connected.
    slowOpened = Drive::typing (mcpConnected (), "Go slow\n")
    slowAsking = answered (slowOpened.stepStore, "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"demo_slow\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}]}")
    slowWritten = mcpWrote (slowAsking.stepStore, 60)
    stillWaiting = mcpRead (slowWritten.stepStore, "")
    expect ((Model::active stillWaiting.stepStore).chatStage, "tools")
    timedOut = Drive::deliverAt (100000, stillWaiting.stepStore, ui::Completed(ticket = "mcpread:demo", outcome = okDone (readDone ("", false))), \_ => "")
    expect ((demoOf timedOut).serverPhase, "connected")
    expectHas ((Doc::text (listGet (filterList (Drive::asked timedOut, \asked => Doc::text (asked, "kind") == "http")) 0 ?: JsonNull, "body")), "did not answer within"))

testing ("remove stops the process, rewrites mcp.json and takes the tools out of the next request; the switch is remembered per folder", \() =>
    connected = mcpConnected ()
    removed = acted (connected, agentapp::RemoveMcp(mcpActionName = "demo"))
    expect (Drive::kinds removed, "process-stop,store-write")
    expectAsked (removed, 1, "name", "mcp.json")
    expectLacks ((written removed), "demo")
    expect (length removed.stepStore.mcp.stateServers, 0)
    settled = saveDone removed
    opened = Drive::typing (settled.stepStore, "Again\n")
    expectLacks ((askedField (opened, 0, "body")), "demo_secret_word")
    // A project server toggled on in one folder is remembered off in another.
    projectDoc = "{\"mcpServers\":{\"local\":{\"command\":\"node\",\"args\":[\"local.js\"]}}}"
    withProject = settledBy (settled.stepStore, "mcp-project", ok 0, projectOnly (projectDoc))
    toggled = Drive::deliver (withProject.stepStore, ui::Switched(toggle = agentapp::ToggleMcp(mcpActionName = "local"), switched = true), "")
    expect (Drive::kinds toggled, "process-start,store-write")
    expectAsked (toggled, 1, "name", "mcp-state.json")
    settledToggle = saveDone toggled
    moved = completed (settledToggle.stepStore, "folder", okJson [Doc::str ("path", "/work/other")])
    again = settledBy (moved.stepStore, "mcp-project", ok 0, projectOnly (projectDoc))
    expectLocalOn again false
    back = completed (again.stepStore, "folder", okJson [Doc::str ("path", "/work/project")])
    returned = settledBy (back.stepStore, "mcp-project", ok 0, projectOnly (projectDoc))
    expectRememberedOn returned true)

testing ("the add form validates in words, paste is atomic, broken files report words and secrets stay in mcp.json", \() =>
    started = mcpLaunched ()
    named = typedInto (started.stepStore, agentapp::McpName, "demo")
    onTab = acted (named.stepStore, agentapp::ShowSettingsTab(tabKey = "mcp"))
    expectTrue (shows (onTab.stepStore, View::settings, "Add server"))
    named2 = typedInto (named.stepStore, agentapp::McpName, "weather")
    commanded = typedInto (named2.stepStore, agentapp::McpCommand, "python3")
    argued = typedInto (commanded.stepStore, agentapp::McpArguments, "server.py")
    environed = typedInto (argued.stepStore, agentapp::McpEnvironment, "KEY=mcp-env-secret")
    added = acted (environed.stepStore, agentapp::AddMcpServer)
    expect (Drive::kinds added, "process-start,store-write")
    expectHas ((written added), "mcp-env-secret")
    // The form forgets what it was given, so a secret is never on show after Add.
    expect (added.stepStore.mcp.stateForm.formEnvironment, "")
    expect (added.stepStore.mcp.stateForm.formName, "")
    expectFalse (shows (added.stepStore, View::settings, "mcp-env-secret"))
    // A name that clashes is refused in words and nothing is asked.
    clashingName = typedInto (added.stepStore, agentapp::McpName, "demo")
    clashing = typedInto (clashingName.stepStore, agentapp::McpCommand, "python3")
    clash = acted (clashing.stepStore, agentapp::AddMcpServer)
    expect (Drive::kinds clash, "")
    expectHas (clash.stepStore.mcp.stateForm.formProblem, "already exists")
    cleared = typedInto (clash.stepStore, agentapp::McpName, "")
    emptyName = acted (cleared.stepStore, agentapp::AddMcpServer)
    expect (emptyName.stepStore.mcp.stateForm.formProblem, "Enter a server name.")
    renamed = typedInto (emptyName.stepStore, agentapp::McpName, "far")
    picked = chose (renamed.stepStore, agentapp::PickMcpType, "url")
    urlled = typedInto (picked.stepStore, agentapp::McpUrl, "ftp://example.test/mcp")
    badUrl = acted (urlled.stepStore, agentapp::AddMcpServer)
    expectHas (badUrl.stepStore.mcp.stateForm.formProblem, "HTTPS URL")
    // Pasting the standard block adds every server at once; a broken entry adds nothing.
    settledAdd = saveDone added
    filled = typedInto (settledAdd.stepStore, agentapp::McpPaste, "{\"mcpServers\":{\"one\":{\"command\":\"node\",\"args\":[\"one.js\"]}}}")
    pasted = acted (filled.stepStore, agentapp::PasteMcpServers)
    expect (Drive::kinds pasted, "process-start,store-write")
    refilled = typedInto (pasted.stepStore, agentapp::McpPaste, "{\"mcpServers\":{\"ok\":{\"command\":\"node\"},\"bad\":{}}}")
    brokenPaste = acted (refilled.stepStore, agentapp::PasteMcpServers)
    expect (Drive::kinds brokenPaste, "")
    expectHas (brokenPaste.stepStore.mcp.stateForm.formProblem, "must have either")
    // A broken file and an unsupported entry are words, never a crash.
    brokenFile = settledWith (brokenPaste.stepStore, "mcp-global", readOutcome true, "{broken")
    expectHas ((join brokenFile.stepStore.mcp.stateProblems "\n"), "not valid JSON")
    unsupported = settledWith (brokenFile.stepStore, "mcp-global", readOutcome true, "{\"mcpServers\":{\"nope\":{\"command\":\"\"},\"cwd\":{\"command\":\"x\",\"cwd\":\"/tmp\"},\"plain\":{\"url\":\"http://example.test/mcp\"}}}")
    expectHas ((join unsupported.stepStore.mcp.stateProblems "\n"), "needs a command")
    expectHas ((join unsupported.stepStore.mcp.stateProblems "\n"), "cwd")
    expectHas ((join unsupported.stepStore.mcp.stateProblems "\n"), "HTTPS")
    // The secrets never reach the conversations file, the switch file or the session document.
    sent = Drive::typing (unsupported.stepStore, "Done\n")
    answered = answered (sent.stepStore, textReply)
    final = answered.stepStore
    expectLacks ((Doc::write (Model::saveDoc (final, "chats.json"))), "mcp-env-secret")
    expectLacks ((Doc::write (McpModel::switchesJson final.mcp)), "mcp-env-secret")
    expectLacks ((Doc::write (App::save final)), "zephyr-secret")
    expectLacks ((Doc::write (Model::saveDoc (final, "mcp.json"))), "zephyr-secret")
    expectHas ((Doc::write (Model::saveDoc ((mcpLaunched ()).stepStore, "mcp.json"))), "zephyr-secret")
    expect (Doc::write (App::save (App::restore (App::save final))), Doc::write (App::save final)))
