testing ("changing folder keeps the active history, saves it and leaves every other chat alone", \() =>
    first = (answered ((typingAtLaunch "One\n").stepStore, textReply)).stepStore
    firstId = (Model::active first).chatId
    second = (answered ((Drive::typing ((acted (first, agentapp::NewChat)).stepStore, "Two\n")).stepStore, textReply)).stepStore
    secondId = (Model::active second).chatId
    chosen = (chose (second, agentapp::PickChat, firstId)).stepStore
    before = Model::active chosen
    asked = acted (chosen, agentapp::ChangeFolder)
    expect (Drive::kinds asked, "choose-folder")
    expect (Doc::write (App::save asked.stepStore), Doc::write (App::save chosen))
    moved = completed (asked.stepStore, "folder", Success(value = JsonObject [Doc::str ("path", "/work/other")]))
    active = Model::active moved.stepStore
    other = listGet moved.stepStore.chats 0 ?: active
    expect (active.chatId, firstId)
    expect (active.chatFolder, "/work/other")
    expect (Doc::write active.chatHistory, Doc::write before.chatHistory)
    expect (other.chatId, secondId)
    expect (other.chatFolder, "/work/project")
    expect (Drive::kinds moved, "run")
    resaved = completed (moved.stepStore, "save:0", Success(value = JsonObject []))
    expect (Drive::kinds resaved, "store-write")
    expectHas ((written resaved), "/work/other")
    movedComposer = Drive::showing (moved.stepStore, View::composer)
    expectHas (movedComposer, "\"kind\":\"button\",\"label\":\"other\",\"symbol\":\"folder\",\"role\":\"plain\",\"enabled\":true")
    expectLacks (movedComposer, "\"label\":\"project\"")
    cancelled = completed (moved.stepStore, "folder", Success(value = JsonObject [Doc::str ("path", "")]))
    expect (Doc::write (App::save cancelled.stepStore), Doc::write (App::save moved.stepStore))
    failed = completed (moved.stepStore, "folder", Error(message = "denied"))
    expect (Doc::write (App::save failed.stepStore), Doc::write (App::save moved.stepStore))
    inherited = (acted (moved.stepStore, agentapp::NewChat)).stepStore
    expect ((Model::active inherited).chatFolder, "/work/other"))

