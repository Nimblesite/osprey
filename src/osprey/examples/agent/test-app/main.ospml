// Osprey Agent's real update path with scripted completions: typing, the whole
// model and tool loop, Stop, a stale answer, failures, new conversations, keys,
// the settings pane, effort and a restart, with no network and no window
// ([NATIVE-APPS-ALL], [UI-EFFECTS]).
namespace agentapptests

import ui::Doc
import ui::Lists
import ui::Encode
import ui::Requests
import ui::Runtime
import agent::Engine
import agentapp::App
import agentapp::Model
import agentapp::McpModel
import agentapp::View
import agent::McpClient
import pydantic_ai::Mcp
import agentapptests::Drive

// A host context at `now`, launching with `arguments`.
contextAt (now, arguments) = ui::Context(now = now, offset = 0, platform = "macos", home = "/home/ada", arguments = arguments)

context now = contextAt (now, ["/work/project", "/keys/env"])

toolReply = "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Looking.\",\"tool_calls\":[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"a.py\\\"}\"}},{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"arguments\":\"{\\\"path\\\":\\\"a.py\\\",\\\"content\\\":\\\"x\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}"

textReply = "{\"id\":\"r2\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Done.\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":20,\"completion_tokens\":3,\"total_tokens\":23}}"

codeReply = "{\"id\":\"rc\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Here:\\n\\n```python\\ndef add(a, b):\\n    name = \\\"x\\\"\\n    return a + b + 1  # sum\\n```\\n\\nDone.\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":4,\"total_tokens\":14}}"

blankReply = "{\"id\":\"rb\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":1,\"completion_tokens\":1,\"total_tokens\":2}}"

busyReply = "{\"error\":\"busy\"}"

// A model reply whose whole content is one call of `tool` under `callId`, with no arguments.
callsTool (callId, tool) = "{\"id\":\"r1\",\"model\":\"m\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"${callId}\",\"type\":\"function\",\"function\":{\"name\":\"${tool}\",\"arguments\":\"{}\"}}]},\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":10,\"completion_tokens\":2,\"total_tokens\":12}}"

// The step after the model's reply in `store` asked the demo server for a tool and its input went out.
mcpAsked (store, reply, bytes) = mcpWrote ((answered (store, reply)).stepStore, bytes)

ok status = okJson [Doc::num ("status", status)]

// Each test runs under the arithmetic policy the application's C boundary uses.
testing (name, body) = test (name, \() => Runtime::guarded body)

(** Steps the application's real `update` with messages a host would deliver. *)
module Drive
    (** One message, with `slice` as every host-held slice it reads. *)
    export deliver (store, message, slice) = deliverWhere (store, message, \_ => slice)

    (** One message, with each host-held slice answered by name. *)
    export deliverWhere (store, message, of) = deliverAt (100, store, message, of)

    (** The same at the host's time `now`. *)
    export deliverAt (now, store, message, of) =
        handle ui::Slices
            fetch key =>
                of (key)
        App::update (context now, store, message)

    (** The store at launch, with its key file loaded into every empty slot. *)
    export started () = (deliver (launchedStore (), ui::Completed(ticket = "env", outcome = ok 0), "DEEPSEEKKEY=sk-test\n")).stepStore

    (** The person types `text`. *)
    export typing (store, text) = deliver (store, ui::Entered(entry = agentapp::Typed, entered = text), "")

    (** The completion of what the open conversation waits on. *)
    export answering (store, outcome, slice) = deliver (store, ui::Completed(ticket = (Model::active store).chatTicket, outcome = outcome), slice)

    (** A region's encoded controls and text, with the store answering its signals. *)
    export showing (store, view) =
        handle static Signal<agentapp::Chats>
            read => agentapp::Chats(chatList = store.chats)
        handle static Signal<agentapp::Draft>
            read => store.draft
        handle static Signal<agentapp::Panel>
            read => store.panel
        handle static Signal<agentapp::Settings>
            read => store.settings
        handle static Signal<agentapp::McpSignal>
            read => agentapp::McpSignal(signalState = store.mcp)
        jsonEncode (listGet (Encode::walk ([], view ())).nodes 0 ?: JsonNull) ?: ""

    (** A step's requests as the host receives them. *)
    export asked step = mapList (step.requests, \request => Requests::encode request)

    (** The kinds of a step's requests, joined. *)
    export kinds step = join (mapList (asked step, \request => Doc::text (request, "kind")), ",")

    (** The saved key for `provider` in a store. *)
    export keyOf (store, provider) = Model::keyOf (store.settings, provider)

// The request a step made at `index`, as the host receives it.
askedAt (step, index) = listGet (Drive::asked step) index ?: JsonNull

// A field of the request a step made at `index`.
askedField (step, index, key) = Doc::text (askedAt (step, index), key)

// The text of the only file a step wrote.
written step = (listGet step.writes 0 ?: Requests::write ("", "")).sliceText

// A step after a fresh launch had `words` typed into it.
typingAtLaunch words = Drive::typing (Drive::started (), words)

// The store after a fresh launch had `words` typed into it.
typedAtLaunch words = (typingAtLaunch words).stepStore

// The store after a fresh launch's turn on `words` was answered with `reply`.
turnDone (words, reply) = (answered (typedAtLaunch words, reply)).stepStore

// A step after `store`'s open request was answered with `reply`.
answered (store, reply) = Drive::answering (store, ok 200, reply)

callingAfter words = (answered ((typingAtLaunch words).stepStore, toolReply)).stepStore

// A fresh turn on the short words `words` most tests start from.
goTurn () = typedAtLaunch "Go\n"

// A completed turn on "One", the words most save and restore tests start from.
oneTurn () = answeredTurn ("One\n", 200, textReply)

// A fresh turn on `words`, its open request answered with `status` and `reply`.
answeredTurn (words, status, reply) = Drive::answering (typedAtLaunch words, ok status, reply)

// A step after `store`'s open request was answered with `reply`, the conversation left at `stage`.
answeredTo (store, reply, stage) =
    done = answered (store, reply)
    expectChatStage (done.stepStore, stage)
    done

// A step after the person's action `act` in `store`.
acted (store, act) = Drive::deliver (store, ui::Act(act = act), "")

// A step after the person chose `chosen` in `store`'s `chooser`.
chose (store, chooser, chosen) = Drive::deliver (store, ui::Chose(chooser = chooser, chosen = chosen), "")

// A step after the person typed `text` into `store`'s `entry`.
typedInto (store, entry, text) = Drive::deliver (store, ui::Entered(entry = entry, entered = text), "")

// A step after the host completed `ticket` with `outcome`.
completed (store, ticket, outcome) = settledWith (store, ticket, outcome, "")

// A step after the host completed `ticket` with `outcome`, answering reads with `slice`.
settledWith (store, ticket, outcome, slice) = settledBy (store, ticket, outcome, \_ => slice)

// The same, with each host-held slice answered by name.
settledBy (store, ticket, outcome, of) = Drive::deliverWhere (store, ui::Completed(ticket = ticket, outcome = outcome), of)

// Whether `view` of `store`, encoded, holds `text`.
shows (store, view, text) = contains (Drive::showing (store, view)) text

// A relaunch of the app in the same folder at time `now`.
relaunch now = (App::initial (contextAt (now, ["/work/project"]))).stepStore

// The store at a bare launch, before any file read is answered.
launchedStore () = (App::initial (context 100)).stepStore

// Expect `doc`'s `key` field to be `value`.
expectDoc (doc, key, value) = expect (Doc::text (doc, key), value)

// Expect the request at `index` of `step` to have `key` set to `value`.
expectAsked (step, index, key, value) = expect (askedField (step, index, key), value)

// Expect `text` to say `wanted` and never `unwanted`.
expectSays (text, wanted, unwanted) =
    expectHas (text, wanted)
    expectLacks (text, unwanted)

// Expect `store`'s open conversation's `get` field to be `want`.
expectOpen (store, get, want) = expect (get (Model::active store), want)

// Expect the active conversation to be on `model` at `effort`.
expectChosen (store, model, effort) =
    expectOpen (store, \active => active.chatModel, model)
    expectOpen (store, \active => active.chatEffort, effort)

// Expect the active conversation to be titled `title` and on `model`.
expectTitled (store, title, model) =
    expectOpen (store, \active => active.chatTitle, title)
    expectOpen (store, \active => active.chatModel, model)

// Expect a turn refused with `status` to draw `text` in the conversation's transcript.
refusalSays (opened, status, text) =
    refused = Drive::answering (opened, ok status, "{}")
    expectTrue (shows (refused.stepStore, View::transcript, text))

// Expect `step`'s requests to be `kinds`.
expectKinds (step, kinds) = expect (Drive::kinds step, kinds)

// Expect `step`'s requests to be `kinds`, then `work` on the step, handing its result back.
kindsAre (step, kinds, work) =
    expectKinds (step, kinds)
    work step

// Expect `step`'s request at `index` to have `key` set to `value`, handing the request back.
askedHolding (step, index, key, value) =
    doc = askedAt (step, index)
    expectDoc (doc, key, value)
    doc

// Expect `step`'s requests to be `kinds`, and the request at `index` to carry `text` under `key`.
expectSent (step, kinds, index, key, text) = kindsAre (step, kinds, \s => expectHas (askedField (s, index, key), text))

// Expect `step`'s requests to be `kinds`, and the conversation to be `stage` after them.
expectStage (step, kinds, stage) = kindsAre (step, kinds, \s => expectChatStage (s.stepStore, stage))

idleChat (step, kinds) =
    expectStage (step, kinds, "idle")
    Model::active step.stepStore

expectChatIn (chat, id, folder) =
    expect (chat.chatId, id)
    expect (chat.chatFolder, folder)

newChatIn (store, count) =
    fresh = (acted (store, agentapp::NewChat)).stepStore
    expect (length fresh.chats, count)
    fresh

expectDefaultOn (store, model, default) =
    expectOpen (store, \active => active.chatModel, model)
    expect (store.settings.defaultModel, default)

// Expect `step`'s requests to be `kinds`, and the request at `index` to have `key` set to `value`.
expectAskedKinds (step, kinds, index, key, value) = kindsAre (step, kinds, \s => expectDoc (askedAt (s, index), key, value))

// The field `key` of `step`'s request at `index`, with its requests expected to be `kinds`.
askedIn (step, index, key, kinds) = kindsAre (step, kinds, \s => askedField (s, index, key))

// Expect `step`'s requests to be `kinds`, and the only file it wrote to hold `text`.
expectWrote (step, kinds, text) = kindsAre (step, kinds, \s => expectHas (written s, text))

// Expect `text` to hold each of `parts`.
showsAll (text, parts) = forEachList (parts, \part => expectHas (text, part))

// Expect `text` to hold none of `parts`.
lacksAll (text, parts) = forEachList (parts, \part => expectLacks (text, part))

// Expect `store`'s active conversation to be at `stage`.
expectChatStage (store, stage) = expect ((Model::active store).chatStage, stage)

// Expect `step` to have asked for nothing at all.
sendsNothing step = expectKinds (step, "")

// Expect `store`'s session document to restore to exactly itself.
expectRoundTrips store = expect (Doc::write (App::save (App::restore (App::save store))), Doc::write (App::save store))

// The second conversation of `store`, or its active one.
secondChat store = listGet store.chats 1 ?: Model::active store

// Expect the demo server's phase in `step` to be `phase`.
expectPhase (step, phase) = expect ((demoOf step).serverPhase, phase)

// The store after `store` read `name`'s document back as `text`.
readBack (store, name, text) = (settledWith (store, name, readOutcome true, text)).stepStore

// The store after a relaunch at `now` read `name`'s document back as `text`.
relaunchedWith (now, name, text) = readBack (relaunch now, name, text)

// The store after `step`'s chats document was written and a relaunch at `now` read it back.
relaunchedChats (now, step) = relaunchedWith (now, "chats", written step)

// Expect `step`'s requests to be `kinds`, and the request at `index` to have `key` set to `value`, handing it back.
checkedAsked (step, index, key, value, kinds) = kindsAre (step, kinds, \s => askedHolding (s, index, key, value))

// The step after `store`'s tool process finished with `output`, its requests expected to be `kinds`.
toolFinished (store, output, kinds) =
    finished = Drive::answering (store, ok 0, output)
    expectKinds (finished, kinds)
    finished

// The store after choosing `chosen` in `store`'s `chooser`, with `want` expected of what `get` reads.
expectPicked (store, chooser, chosen, get, want) =
    picked = (chose (store, chooser, chosen)).stepStore
    expect (get picked, want)
    picked

// Expect the key `provider` pasted into `store` to survive a later key file saying `fileLine`.
expectPastedKept (store, provider, fileLine) =
    pasted = store(settings = Model::withKey (store.settings, provider, "sk-pasted"))
    expect (Drive::keyOf ((settledWith (pasted, "env", ok 0, fileLine)).stepStore, provider), "sk-pasted")

// Expect `part` somewhere in `text`.
expectHas (text, part) = expectTrue (contains text part)

// Expect `part` nowhere in `text`.
expectLacks (text, part) = expectFalse (contains text part)

// The outcome of a store read: `found` is whether its file was there.
readOutcome found = okJson [Doc::bit ("found", found)]

// The step after the person typed `value` into `entry` of `store` and pressed `act`.
typedThenActed (store, entry, value, act) = acted ((typedInto (store, entry, value)).stepStore, act)

// The step after the person typed `value` into `entry` of `store`'s add form and pressed Add.
typedAdded (store, entry, value) = typedThenActed (store, entry, value, agentapp::AddMcpServer)

// Expect `step`'s add form to show `problem`.
expectFormProblem (step, problem) = expectHas (step.stepStore.mcp.stateForm.formProblem, problem)

// The add form refused `step` in words with `problem`, asking for nothing.
refusedForm (step, problem) =
    sendsNothing step
    expectFormProblem (step, problem)

// Expect `step`'s add form to have forgotten what it was given.
expectFormCleared step =
    expect (step.stepStore.mcp.stateForm.formEnvironment, "")
    expect (step.stepStore.mcp.stateForm.formName, "")

// The step after the folder chooser settled on `path`.
folderChosen (store, path) = completed (store, "folder", okJson [Doc::str ("path", path)])

// Expect a folder change from `step` settled with `outcome` to leave its saved conversations alone.
expectFolderKept (step, outcome) =
    settled = completed (step.stepStore, "folder", outcome)
    expect (Doc::write (App::save settled.stepStore), Doc::write (App::save step.stepStore))

// The step after `store`'s save of `ticket` completed, the next document written expected to be `name`.
saveSettled (store, ticket, name) =
    done = completed (store, ticket, ok 0)
    expectAsked (done, 0, "name", name)
    done

// The step after `store` asked to persist its conversations.
persistingChats store = Model::persisting (store, "chats.json")

// A step after the demo server's process started under `pid`.
mcpStarted () = completed ((mcpLaunched ()).stepStore, "mcpstart:demo", okJson [Doc::num ("pid", 4321)])

// A step after the demo server's `written` bytes of input went out.
mcpWrote (store, writtenBytes) = completed (store, "mcpwrite:demo", okJson [Doc::num ("written", writtenBytes)])

// The step after the demo server's `written` bytes of input went out, which must be a read.
expectMcpWrote (store, writtenBytes) = kindsAre (mcpWrote (store, writtenBytes), "process-read", \s => s)

// The step after the person moved to the MCP tab, its settings expected to hold `text`.
expectMcpTab (store, text) =
    onTab = acted (store, agentapp::ShowSettingsTab(tabKey = "mcp"))
    expectTrue (shows (onTab.stepStore, View::settings, text))

// A step after the demo server's `written` bytes of input went out and it read back `text`.
mcpReadAfter (step, writtenBytes, text) = mcpRead ((mcpWrote (step.stepStore, writtenBytes)).stepStore, text)

// A step after the demo server read back `text`.
mcpRead (store, text) = completed (store, "mcpread:demo", okDone (readDone (text, false)))

settingsOpened () = (acted (Drive::started (), agentapp::OpenSettings)).stepStore

// The store of a fresh launch with settings open and `zai`'s key typed in.
keyTyped () = (typedInto ((acted (Drive::started (), agentapp::OpenSettings)).stepStore, agentapp::TypedKey(keyProvider = "zai"), "sk-zai")).stepStore

// A step after `zai`'s key was saved from the settings pane.
keySaved () = acted (keyTyped (), agentapp::SaveKey(keyProvider = "zai"))

// The launch step at time 100, asking for the conversations, providers and the key file.
launchAsk () =
    first = App::initial (context 100)
    expectKinds (first, "run,store-read,store-read,store-read,store-read,run")
    first

testing ("launch asks for the conversations, providers and the key file, and starts empty", \() =>
    first = launchAsk ()
    expect (length first.stepStore.chats, 1)
    expect ((Model::active first.stepStore).chatFolder, "/work/project")
    expect (Drive::keyOf (first.stepStore, "deepseek"), "")
    expect (Drive::keyOf (Drive::started (), "deepseek"), "sk-test"))

testing ("typing keeps the draft and sends nothing", \() =>
    step = typingAtLaunch "half a thou"
    expect (step.stepStore.draft.draftText, "half a thou")
    sendsNothing step)

testing ("Return sends the words to the model with the key, and clears the composer", \() =>
    step = typingAtLaunch "Fix the bug\n"
    chat = Model::active step.stepStore
    request = askedAt (step, 0)
    expectKinds (step, "http")
    expect (Doc::text (request, "url"), Engine::url "deepseek/deepseek-chat")
    expectDoc (request, "method", "POST")
    expectHas ((Doc::text (request, "body")), "Fix the bug")
    expectHas ((Doc::write request), "Bearer sk-test")
    expect (chat.chatStage, "thinking")
    expect (chat.chatTitle, "Fix the bug")
    expect (step.stepStore.draft.draftText, ""))

testing ("without a key nothing is sent and the words are kept", \() =>
    launched = launchedStore ()
    step = Drive::typing (launched, "Fix it\n")
    sendsNothing step
    expect (step.stepStore.draft.draftText, "Fix it")
    expectChatStage (step.stepStore, "idle"))

testing ("words alone or a busy conversation send nothing", \() =>
    sendsNothing (typingAtLaunch "   \n")
    busy = (typedAtLaunch "One\n")
    sendsNothing (Drive::typing (busy, "Two\n")))

testing ("a whole turn: model, each tool in order, model again, then saved without the key", \() =>
    calling = answeredTurn ("Fix the bug\n", 200, toolReply)
    expectStage (calling, "run", "tools")
    expect ((Model::active calling.stepStore).chatCall, "c1")
    expectAsked (calling, 0, "executable", "/bin/sh")
    second = toolFinished (calling.stepStore, "print(1)", "run")
    expect ((Model::active second.stepStore).chatCall, "c2")
    expect (length (Model::active second.stepStore).chatResults, 1)
    back = toolFinished (second.stepStore, "wrote a.py", "http")
    expect (length (Model::active back.stepStore).chatResults, 0)
    expectHas ((askedField (back, 0, "body")), "wrote a.py")
    done = answered (back.stepStore, textReply)
    expectStage (done, "store-write", "idle")
    chat = Model::active done.stepStore
    expect ((Engine::usage_of chat.chatHistory).totalRequests, 2)
    expect ((Engine::usage_of chat.chatHistory).totalInput, 30)
    expect (join (Engine::files_changed chat.chatHistory, ","), "a.py")
    file = written done
    expectSays (file, "Done.", "sk-test"))

testing ("a fenced python block draws as a rich node of coloured runs, more than one ink", \() =>
    replied = answeredTurn ("Show the code\n", 200, codeReply)
    showsAll (Drive::showing (replied.stepStore, View::transcript), ["\"kind\":\"rich-text\"", "\"ink\":\"codeKeyword\"", "\"ink\":\"codeString\"", "\"ink\":\"codeComment\"", "\"ink\":\"codeNumber\"", "\"text\":\"def\"", "\\n"]))

testing ("Stop cancels what runs and answers each owed call, so the next turn is accepted", \() =>
    calling = callingAfter "Go\n"
    ticket = (Model::active calling).chatTicket
    stopped = acted (calling, agentapp::StopTurn)
    chat = idleChat (stopped, "cancel,store-write")
    expect (length (Model::pendingCalls chat), 0)
    late = settledWith (stopped.stepStore, ticket, ok 0, "late")
    sendsNothing late
    expectKinds ((Drive::typing (stopped.stepStore, "Again\n")), "http"))

testing ("a refused request or a lost connection shows why, and Try again resends", \() =>
    opened = goTurn ()
    limited = Drive::answering (opened, ok 429, busyReply)
    expectChatStage (limited.stepStore, "failed")
    expectHas ((Model::active limited.stepStore).chatProblem, "status_code: 429")
    lost = Drive::answering (opened, Error(message = "offline"), "")
    expect ((Model::active lost.stepStore).chatProblem, "offline")
    expectKinds ((acted (lost.stepStore, agentapp::Retry)), "http"))

testing ("a blank reply fails in words and leaves no gap", \() =>
    blank = answeredTurn ("yo\n", 200, blankReply)
    chat = Model::active blank.stepStore
    expect (chat.chatStage, "failed")
    expectHas (chat.chatProblem, "no answer")
    showsAll (Drive::showing (blank.stepStore, View::transcript), ["The model returned no answer.", "Try again"]))

testing ("each refusal status says what to do in words, with Open Settings", \() =>
    opened = goTurn ()
    refused = answeredTurn ("Go\n", 401, "{}")
    expect ((Model::active refused.stepStore).chatProblemStatus, 401)
    expectTrue (shows (refused.stepStore, View::transcript, "This key was refused."))
    forEachList ([{ status = 401, words = "Open Settings" }, { status = 403, words = "This key was refused." }, { status = 402, words = "DeepSeek has no credit left. Pick another model, or add credit." }, { status = 429, words = "DeepSeek is rate limiting: try again shortly." }], \row => refusalSays (opened, row.status, row.words)))

testing ("a failed tool tells the model and the turn goes on", \() =>
    calling = callingAfter "Go\n"
    second = Drive::answering (calling, Error(message = "Timed out after 5 ms"), "")
    expectHas ((listGet (Model::active second.stepStore).chatResults 0 ?: Engine::ToolResult(resultId = "", resultName = "", resultContent = "")).resultContent, "Timed out")
    expectKinds (second, "run"))

testing ("new conversations, switching and the model choice stay per conversation", \() =>
    first = (oneTurn ()).stepStore
    fresh = newChatIn (first, 2)
    expect ((Model::active fresh).chatTitle, "New chat")
    again = newChatIn (fresh, 2)
    chosen = expectPicked (again, agentapp::PickModel, "deepseek/deepseek-reasoner", \p => (Model::active p).chatModel, "deepseek/deepseek-reasoner")
    other = secondChat chosen
    back = (chose (chosen, agentapp::PickChat, other.chatId)).stepStore
    expectTitled (back, "One", "deepseek/deepseek-chat"))

testing ("the composer pick changes only that chat, and effort is kept or cleared on a model change", \() =>
    first = (oneTurn ()).stepStore
    chosen = (chose (first, agentapp::PickModel, "zai/glm-5.3")).stepStore
    efforted = (chose (chosen, agentapp::PickEffort, "high")).stepStore
    expectChosen (efforted, "zai/glm-5.3", "high")
    kept = expectPicked (efforted, agentapp::PickModel, "kimi-coding/k3", \p => (Model::active p).chatEffort, "high")
    cleared = expectPicked (kept, agentapp::PickModel, "deepseek/deepseek-chat", \p => (Model::active p).chatEffort, "")
    other = secondChat cleared
    expect (other.chatModel, "deepseek/deepseek-chat")
    expect (other.chatEffort, ""))

testing ("the settings pane opens in place of the conversation and closes", \() =>
    opened = settingsOpened ()
    expect (opened.settings.settingsOpen, true)
    sendsNothing (acted (opened, agentapp::OpenSettings))
    showsAll (Drive::showing (opened, View::settings), ["Providers", "MCP servers", "DeepSeek", "GLM (Z.ai API)", "Save DeepSeek key"])
    closed = (acted (opened, agentapp::CloseSettings)).stepStore
    expect (closed.settings.settingsOpen, false))

testing ("the provider's own API names the models, the pickers cascade and every picker says what it is", \() =>
    launched = settledWith (launchedStore (), "env", ok 0, "DEEPSEEKKEY=sk-test\n")
    asked = checkedAsked (launched, 0, "method", "GET", "http")
    expectDoc (asked, "url", "https://api.deepseek.com/models")
    expectHas ((Doc::write asked), "Bearer sk-test")
    expectSays (Drive::showing (launched.stepStore, View::composer), "DeepSeek Reasoner", "DeepSeek V9")
    answer = "{\"data\":[{\"id\":\"deepseek-v9\"},{\"id\":\"deepseek-v4-pro\"},{\"id\":\"deepseek-flash\"}]}"
    listed = (settledWith (launched.stepStore, "models:deepseek", ok 200, answer)).stepStore
    // The default model is gone from the provider, so the empty chat and the default both move to one it names.
    expectDefaultOn (listed, "deepseek/deepseek-flash", "deepseek/deepseek-flash")
    shown = Drive::showing (listed, View::composer)
    expectHas (shown, "deepseek-v9")
    expectHas ((Drive::showing (App::restore (App::save listed), View::composer)), "deepseek-v9")
    lacksAll (shown, ["DeepSeek Reasoner", "DeepSeek Chat"])
    // Effort always names itself, from the first moment, and offers only what this model has.
    showsAll (shown, ["Effort: Default", "Effort: High", "Effort: Max", "Effort: Low"])
    low = expectPicked (listed, agentapp::PickEffort, "low", \p => (Model::active p).chatEffort, "low")
    pro = expectPicked (low, agentapp::PickModel, "deepseek/deepseek-v4-pro", \p => (Model::active p).chatEffort, "")
    expectFalse (shows (pro, View::composer, "Effort: Low"))
    // A model only the provider knows has no effort picker, and can be sent to with the provider's wire.
    live = (chose (pro, agentapp::PickModel, "deepseek/deepseek-v9")).stepStore
    expectFalse (shows (live, View::composer, "Effort:"))
    sent = Drive::typing (live, "Hello\n")
    expectSent (sent, "http", 0, "body", "\"model\":\"deepseek-v9\"")
    expectAsked (sent, 0, "url", "https://api.deepseek.com/chat/completions")
    // A chat with words in it keeps its model when the provider drops it; a refused list changes nothing.
    relisted = (settledWith (sent.stepStore, "models:deepseek", ok 200, "{\"data\":[{\"id\":\"deepseek-flash\"}]}")).stepStore
    expectDefaultOn (relisted, "deepseek/deepseek-v9", "deepseek/deepseek-flash")
    refused = (settledWith (listed, "models:deepseek", ok 401, "{\"error\":\"no\"}")).stepStore
    failed = (completed (listed, "models:deepseek", Error(message = "offline"))).stepStore
    forEachList ([refused, failed], \store => expectTrue (shows (store, View::composer, "deepseek-v9")))
    // Saving a key asks that provider; its list then offers its models, and removing the key forgets them.
    typedKey = (typedInto (listed, agentapp::TypedKey(keyProvider = "zai"), "sk-zai")).stepStore
    savedKey = acted (typedKey, agentapp::SaveKey(keyProvider = "zai"))
    expectAskedKinds (savedKey, "store-write,http", 1, "url", "https://api.z.ai/api/paas/v4/models")
    zai = (settledWith (savedKey.stepStore, "models:zai", ok 200, "{\"data\":[{\"id\":\"glm-9\"}]}")).stepStore
    expectTrue (shows (zai, View::composer, "zai/glm-9"))
    // Settings cascades from the same answer: provider, then its live models, then that model's effort.
    settingsOpen = (acted (zai, agentapp::OpenSettings)).stepStore
    picked = expectPicked (settingsOpen, agentapp::PickProvider, "zai", \p => p.settings.defaultModel, "zai/glm-9")
    expect (picked.settings.defaultEffort, "")
    removed = (acted (zai, agentapp::RemoveKey(keyProvider = "zai"))).stepStore
    expectFalse (shows (removed, View::composer, "glm-9")))

travelsAsWords words = expectSent (typingAtLaunch "${words}\n", "http", 0, "body", words)

testing ("a pasted image reaches the model as image data, a typed path never leaves the machine, and a lost image says so", \() =>
    name = "0c1d2e3f.png"
    asked = typingAtLaunch "What is in [image: ${name}] please\n"
    reading = checkedAsked (asked, 0, "executable", "/bin/sh", "run")
    expectHas ((Doc::write reading), "/home/ada/Library/Application Support/Osprey/pasted")
    expectHas ((Doc::write reading), name)
    expectChatStage (asked.stepStore, "thinking")
    sent = Drive::answering (asked.stepStore, ok 0, "QUJD\n")
    body = askedIn (sent, 0, "body", "http")
    expectHas (body, "\"type\":\"image_url\"")
    expectHas (body, "data:image/png;base64,QUJD")
    expectSays (body, "What is in", "[image:")
    // The next request of the turn sends the same picture again, and the saved conversation holds only its name.
    next = answered (sent.stepStore, textReply)
    savedDoc = Doc::write (App::save next.stepStore)
    expectLacks (savedDoc, "QUJD")
    expectHas (savedDoc, name)
    again = Drive::typing (next.stepStore, "And now?\n")
    expectKinds (again, "run")
    lost = Drive::answering (again.stepStore, ok 0, "\n")
    lostBody = askedIn (lost, 0, "body", "http")
    expectSays (lostBody, "no longer available", "image_url")
    // Words pasted from a log that look like a marker read nothing and travel as the words they are.
    hostile = ["[image: ../../.ssh/id_rsa.png]", "[image: /etc/passwd]", "[image: secret.txt]", "[image: ]", "[image: unclosed.png"]
    forEachList (hostile, travelsAsWords)
    // A failed read is no failed turn: the words still go.
    failedRead = Drive::answering ((Drive::typing (Drive::started (), "See [image: ${name}]\n")).stepStore, Error(message = "denied"), "")
    expectSent (failedRead, "http", 0, "body", "no longer available"))

testing ("a saved key is written to providers.json, never to the conversations file", \() =>
