namespace app

import ui::Runtime
import ui::Views
import agentapp::App
import agentapp::Model

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<agentapp::Store, agentapp::AgentAction> => Unit

initial () = Model::launched ("", "", "", 0)
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
