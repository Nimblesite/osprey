// Implements [NATIVE-APPS-ALL], [UI-STORE] and [UI-EFFECTS] for Osprey Agent: one
// store, one action union and a pure update. A model request is an `Http`
// capability and a tool is a `Run` capability, so the window stays live while
// the agent works, on any host that answers them.
namespace agentapp

import ui::Doc
import ui::Keyed
import ui::Lists
import ui::Messages
import ui::Pick
import ui::Requests
import ui::Runtime
import agent::Engine
import agent::McpClient
import agent::Transcript
import agent::Images
import agentapp::McpModel
import agentapp::McpRun
import agentapp::Model
import agentapp::View

(** Every step of a turn: starting one, each model answer and each tool's answer ([UI-EFFECTS]). *)
module Turn
    deadline () = 600000

    responseLimit () = 16000000

    toolDeadline () = 300000

    toolLimit () = 8000000

    // `store` with `chat` put back and one ticket spent.
    charged (store, chat) = Model::putChat (store(ticketCount = satAdd store.ticketCount 1), chat)

    (** The model request for `chat`'s next step, under a new ticket, with the key of its provider. *)
    export asking (store, chat) =
        body = bodyOf (store, chat)
        names = Images::names_in body
        match length names == 0
            true => sending (store, chat, body)
            false =>
                ticket = "images:${chat.chatId}:${store.ticketCount}"
                Runtime::asking (thinking (store, chat, ticket), [Model::imagesRead (store.settings, ticket, names)])

    bodyOf (store, chat) = Engine::request_body_with_mcp (chat.chatHistory, chat.chatModel, chat.chatEffort, McpModel::toolsDocument store.mcp)

    (** The images are read, or could not be: the request goes and says what is missing. *)
    export imagesRead (store, chat, ticket, outcome) =
        body = bodyOf (store, chat)
        output = match outcome
            Error _ => ""
            Success _ => perform ui::Slices.fetch ticket
        sending (store, chat, Images::with_images (body, Images::names_in body, output))

    // `store` holding `chat` thinking under `ticket`, with one ticket spent.
    thinking (store, chat, ticket) = charged (store, chat(chatStage = "thinking", chatTicket = ticket, chatProblem = ""))

    sending (store, chat, body) =
        ticket = "model:${chat.chatId}:${store.ticketCount}"
        key = Model::keyOf (store.settings, Engine::provider_id_of chat.chatModel)
        auth = Pick::either (key == "", [], [ui::Header(headerName = "Authorization", headerValue = "Bearer ${key}")])
        request = Requests::ask (ticket, ui::Http(method = "POST", url = Engine::url chat.chatModel, headers = listPrepend auth (ui::Header(headerName = "Content-Type", headerValue = "application/json")), body = body, responseLimit = responseLimit (), deadline = deadline (), httpSlice = ticket))
        moved = thinking (store, chat, ticket)
        Runtime::asking (moved, [request])

    // The process for one call, under a ticket naming the call.
    runCall (store, chat, call) =
        ticket = "tool:${chat.chatId}:${store.ticketCount}"
        command = Engine::tool_command (store.settings.platform, chat.chatFolder, call.callName, call.callArgs)
        request = Requests::ask (ticket, ui::Run(executable = command.executable, arguments = command.arguments, timeout = toolDeadline (), outputLimit = toolLimit (), plist = false, runSlice = ticket))
        moved = charged (store, chat(chatStage = "tools", chatTicket = ticket, chatCall = call.callId))
        Runtime::asking (moved, [request])

    // The next call still owed an answer: through its server when it is an MCP tool, else as a process.
    advance (store, chat) = match Lists::find (Model::pendingCalls chat, \_ => true)
        Success call => match McpModel::forTool (store.mcp, call.callName)
            Success server => mcpCall (store, chat, server, call)
            Error _ => runCall (store, chat, call)
        Error _ => match length chat.chatResults > 0
            true => asking (store, chat(chatHistory = Engine::add_returns (chat.chatHistory, chat.chatResults), chatResults = []))
            false => finished (store, chat)

    // A turn over: the agent idle and the conversations kept.
    finished (store, chat) =
        moved = Model::putChat (store, chat(chatStage = "idle", chatTicket = "", chatCall = ""))
        Model::persisting (moved, "chats.json")

    failed (store, chat, problem, status) = Model::persisting (Model::putChat (store, chat(chatStage = "failed", chatTicket = "", chatCall = "", chatProblem = problem, chatProblemStatus = status)), "chats.json")

    (** A model answer: add the response and run what it asks for. *)
    export modelAnswered (store, chat, ticket, outcome) = match outcome
        Error problem => failed (store, chat, problem, 0)
        Success result =>
            body = perform ui::Slices.fetch ticket
            status = Doc::number (Doc::parse result, "status")
            reply = Engine::accept (chat.chatHistory, chat.chatModel, status, body)
            match reply.replyOk
                false => failed (store, chat, reply.replyProblem, status)
                true => advance (store, chat(chatHistory = reply.replyHistory, chatStage = "tools"))

    (** A tool's answer: keep it and move on. *)
    export toolAnswered (store, chat, ticket, outcome) =
        call = Model::callNamed (chat, chat.chatCall)
        output = match outcome
            Success result => Engine::tool_result_text (call.callName, Doc::number (Doc::parse result, "status"), perform ui::Slices.fetch ticket, "")
            Error problem => Engine::tool_result_text (call.callName, 1, "", problem)
        advance (store, gathered (chat, call, output))

    (** An MCP tool's answer: its server already framed the text, whatever the server said. *)
    export mcpAnswered (store, chat, call, text) = advance (store, gathered (chat, call, text))

    // `chat` with `call`'s answer `text` gathered.
    gathered (chat, call, text) = chat(chatResults = listAppend chat.chatResults (Engine::ToolResult(resultId = call.callId, resultName = call.callName, resultContent = text)))

    // A call that cannot be sent: the server answers for it in words at once and hands the turn over.
    unable (store, chat, server, call, why) = handOver (Runtime::step (store(mcp = McpModel::putServer (store.mcp, server(serverCallChat = chat.chatId, serverCallId = call.callId, serverCallText = why, serverCallDone = true)))))

    // One tool call through its connected server, under a deadline: the request is built inline so this file owns the whole turn recursion.
    mcpCall (store, chat, server, call) =
        wire = McpClient::call_line (server.serverNextId, McpClient::bare_tool (server.serverName, call.callName), call.callArgs)
        match wire.problem == ""
            false => unable (store, chat, server, call, "The tool could not run: ${wire.problem}")
            true => match server.serverPhase == "connected"
                false => unable (store, chat, server, call, "The tool could not run: ${server.serverName} is not connected.")
                true =>
                    started = McpRun::awaiting (server, "call")
                    waiting = started(serverCallChat = chat.chatId, serverCallId = call.callId, serverCallUntil = satAdd store.clock (McpRun::callMs ()))
                    moved = charged (store(mcp = McpModel::putServer (store.mcp, waiting)), chat(chatStage = "tools", chatTicket = "mcpcall:${server.serverName}", chatCall = call.callId))
                    request = match server.serverKind
                        "url" =>
                            brief = Doc::parse (McpClient::start_brief server.serverConfig)
                            headers = McpRun::httpHeaders (brief, waiting.serverSession)
                            Requests::ask ("mcphttp:${server.serverName}", ui::Http(method = "POST", url = Doc::text (brief, "url"), headers = headers, body = wire.text, responseLimit = McpRun::httpLimit (), deadline = McpRun::callMs (), httpSlice = "mcphttp:${server.serverName}"))
                        _ => Requests::ask ("mcpwrite:${server.serverName}", ui::ProcessWrite(writeHandle = "mcp:${server.serverName}", writeBytes = wire.text))
                    Runtime::asking (moved, [request])

    // A server that finished a call hands its text to the conversation waiting on it, if it still is, keeping any requests the server still needs.
    export handOver stepped = match Lists::find (stepped.stepStore.mcp.stateServers, \server => server.serverCallDone)
        Error _ => stepped
        Success marked =>
            before = stepped.stepStore
            cleared = before(mcp = McpModel::putServer (before.mcp, marked(serverCallDone = false, serverCallText = "")))
            match Lists::find (cleared.chats, \chat => chat.chatId == marked.serverCallChat && Model::busy chat)
                Error _ => Runtime::step cleared
                Success chat =>
                    afterCall = mcpAnswered (cleared, chat, Model::callNamed (chat, marked.serverCallId), marked.serverCallText)
                    Runtime::asking (afterCall.stepStore, listConcat stepped.requests afterCall.requests)

    (** Starts a turn in the active conversation with `text`, unless it is already working, the words are empty, its provider has no key, or the model is unknown. *)
    export submit (store, text) =
        words = trim text
        chat = Model::active store
        missing = Model::ready (store.settings, Engine::provider_id_of chat.chatModel) == false
        problem = Model::modelProblem (store.settings, chat.chatModel)
        match words == "" || Model::busy chat || missing || problem != ""
            true => Runtime::step (store(draft = Draft(draftText = words)))
            false =>
                titled = Pick::either (length (Transcript::items_of chat.chatHistory) == 0, chat(chatTitle = Transcript::title_of words), chat)
                opened = titled(chatHistory = Engine::add_user (chat.chatHistory, chat.chatFolder, words))
                asking (store(draft = Draft(draftText = "")), opened)

    (** Stops the turn: whatever was asked is cancelled, and the conversation comes to rest. A call in flight through an MCP server cancels that server's outstanding request. *)
    export stop store =
        chat = Model::active store
        mcpCancels = match startsWith chat.chatTicket "mcpcall:"
            true => match McpModel::named (store.mcp, drop chat.chatTicket 8)
                Success server => [Requests::ask ("cancel:${store.ticketCount}", ui::Cancel(cancelled = Pick::either (server.serverKind == "url", "mcphttp:${server.serverName}", Pick::either (server.serverReadTicket == "", "mcpread:${server.serverName}", server.serverReadTicket))))]
                Error _ => []
            false => []
        plainCancels = Pick::either (chat.chatTicket == "" || startsWith chat.chatTicket "mcpcall:", [], [Requests::ask ("cancel:${store.ticketCount}", ui::Cancel(cancelled = chat.chatTicket))])
        cancels = listConcat plainCancels mcpCancels
        cleared = match startsWith chat.chatTicket "mcpcall:"
            true => match McpModel::named (store.mcp, drop chat.chatTicket 8)
                Success server => store(mcp = McpModel::putServer (store.mcp, McpRun::resting (server, true)))
                Error _ => store
            false => store
        moved = charged (cleared, Model::halted chat)
        saving = Model::persisting (moved, "chats.json")
        saving(requests = listConcat cancels saving.requests)

(** How Osprey Agent answers each message: taps, text, choices, flags and completions. *)
module Answers

    // `items` with `item` added when `on`, and only ever once.
    toggledIn (items, item, on) =
        others = filterList (items, \one => one != item)
        Pick::either (on, listAppend others item, others)

    // `store` with its open conversation changed by `of`, drawn afresh.
    chatStep (store, of) = Runtime::step (Model::putChat (store, of (Model::active store)))

    // `store` with its panel changed by `of`, drawn afresh.
    panelStep (store, of) =
        panel = store.panel
        Runtime::step (store(panel = of panel))

    // `store` with its settings changed by `of`, drawn afresh.
    settingsStep (store, of) = Runtime::step (store(settings = of store.settings))

    // `store` with its settings changed by `of`, saved to providers.json.
    settingsSaved (store, of) = Model::persisting (store(settings = of store.settings), "providers.json")

    // `store` with its MCP state changed by `of`, drawn afresh.
    mcpStep (store, of) = Runtime::step (store(mcp = of store.mcp))

    (** Applies a tap. *)
    export tapped (store, action) = match action
        NewChat => Runtime::step (Model::opening (store, (Model::active store).chatFolder))
        ChangeFolder => Runtime::asking (store, [Requests::ask ("folder", ui::ChooseFolder)])
        SendDraft => Turn::submit (store, store.draft.draftText)
        StopTurn => Turn::stop store
        Retry => Turn::asking (store, Model::active store)
        TogglePanel => panelStep (store, \panel => panel(panelOpen = panel.panelOpen == false))
        Suggest words => Turn::submit (store, words)
        SaveKey provider =>
            settings = store.settings
            value = Model::draftOf (settings, provider)
            match value == ""
                true => Runtime::step store
                false =>
                    keyed = Model::withKey (Model::withDraft (settings, provider, ""), provider, value)
                    saving = settingsSaved (store, \_ => keyed)
                    saving(requests = listAppend saving.requests (Model::listingOf (keyed, provider)))
        RemoveKey provider => settingsSaved (store, \settings => Model::unlisted (Model::withKey (settings, provider, ""), provider))
        ShowSettingsTab key => settingsStep (store, \settings => settings(settingsTab = key))
        OpenSettings => settingsPane (store, true, store.settings.settingsTab)
        OpenMcpSettings => settingsPane (store, true, "mcp")
        CloseSettings => settingsPane (store, false, store.settings.settingsTab)
        AddMcpServer => addServer store
        PasteMcpServers => pasteServers store
        RemoveMcp name =>
            stopped = McpRun::stop (store, name)
            after = stopped.stepStore
            mcp = after.mcp
            forgotten = stopped(stepStore = after(mcp = mcp(stateGlobal = McpClient::remove_global_text (mcp.stateGlobal, name), stateServers = filterList (mcp.stateServers, \server => server.serverName != name || server.serverOrigin != "global"))))
            Model::persistingAfter (forgotten, "mcp.json")
        ReconnectMcp name => McpRun::begin (store, name)
        _ => Runtime::step store

    // The settings pane `open` on `tab`.
    settingsPane (store, open, tab) =
        settings = store.settings
        Runtime::step (store(settings = settings(settingsOpen = open, settingsTab = tab)))

    (** Applies text or a choice: the composer's words, where a final newline sends; a conversation; a model, effort or a settings picker. *)
    export typed (store, action, text) = match action
        Typed => match endsWith text "\n"
            true => Turn::submit (store, text)
            false => Runtime::step (store(draft = Draft(draftText = text)))
        PickChat => panelStep (store, \panel => panel(panelActive = text))
        PickModel => chatStep (store, \chat => chat(chatModel = text, chatEffort = Model::effortFor (text, chat.chatEffort)))
        PickEffort => chatStep (store, \chat => chat(chatEffort = text))
        PickProvider =>
            first = listGet (Model::modelsOf (store.settings, text)) 0 ?: "deepseek-chat"
            settingsSaved (store, \settings => settings(providerOpen = text, defaultModel = Engine::full_model (text, first), defaultEffort = ""))
        PickDefaultModel => settingsSaved (store, \settings => settings(defaultModel = text, defaultEffort = Model::effortFor (text, settings.defaultEffort)))
        PickDefaultEffort => settingsSaved (store, \settings => settings(defaultEffort = text))
        TypedKey provider => settingsStep (store, \settings => Model::withDraft (settings, provider, text))
        McpName => withFormField (store, "name", text)
        McpCommand => withFormField (store, "command", text)
        McpArguments => withFormField (store, "arguments", text)
        McpUrl => withFormField (store, "url", text)
        McpEnvironment => withFormField (store, "environment", text)
        McpHeaders => withFormField (store, "headers", text)
        McpPaste => withFormField (store, "paste", text)
        PickMcpType => withFormField (store, "type", text)
        _ => Runtime::step store

    // The Add server form with `field` set to `text`, and its problem cleared.
    withFormField (store, field, text) =
        changed = fieldNamed (store.mcp.stateForm, field, text)
        mcpStep (store, \mcp => mcp(stateForm = changed(formProblem = "")))

    fieldNamed (form, field, text) = match field
        "name" => form(formName = text)
        "command" => form(formCommand = text)
        "arguments" => form(formArguments = text)
        "url" => form(formUrl = text)
        "environment" => form(formEnvironment = text)
        "headers" => form(formHeaders = text)
        "paste" => form(formPaste = text)
        "type" => form(formType = text)
        _ => form

    // Adding through the form: validate in words, then write mcp.json and connect at once.
    addServer store =
        form = store.mcp.stateForm
        entry = McpClient::form_config (form.formName, form.formType, form.formCommand, form.formArguments, form.formUrl, form.formEnvironment, form.formHeaders)
        Pick::either (entry.problem == "", McpRun::acceptSaved (store, McpClient::add_global (store.mcp.stateGlobal, trim form.formName, entry.text)), McpRun::formProblem (store, entry.problem))

    // Pasting the standard block: atomic, with each fault in words.
    pasteServers store = McpRun::acceptSaved (store, McpClient::paste_global (store.mcp.stateGlobal, store.mcp.stateForm.formPaste))

    (** Applies a disclosure's flag. *)
    export toggled (store, action, on) = match action
        ToggleSteps key => panelStep (store, \panel => panel(panelExpanded = toggledIn (panel.panelExpanded, key, on)))
        ToggleMcpTools name => mcpStep (store, \mcp => mcp(stateExpanded = toggledIn (mcp.stateExpanded, name, on)))
        ToggleMcp name =>
            moved = McpModel::withMemory (store.mcp, name, on)
            Model::persistingAfter (Pick::either (on, McpRun::connectAll (store(mcp = moved)), McpRun::stop (store(mcp = moved), name)), "mcp-state.json")
        _ => Runtime::step store

    (** Applies the inspector's new width. *)
    export sized (store, action, points) = match action
        ResizePanel => panelStep (store, \panel => panel(panelWidth = points))
        _ => Runtime::step store

    settingsLoaded (store, outcome) = match outcome
        Error _ => Runtime::step store
        Success _ =>
            settings = store.settings
            // A key pasted while the file was being read is the newer word; the dotenv fills only empty slots.
            seeded = Model::keysIn (perform ui::Slices.fetch "env")
            filled = foldList (seeded, settings, \(acc, key) => Pick::either (Model::keyOf (acc, key.keyProvider) == "" && key.keyValue != "", Model::withKey (acc, key.keyProvider, key.keyValue), acc))
            Runtime::asking (store(settings = filled), Model::newlyKeyed (settings, filled))

    // A saved document that answered: through `of` with its words when the file was found, else the store unchanged.
    readFound (store, outcome, slice, of) = match outcome
        Error _ => Runtime::step store
        Success result => match found result
            false => Runtime::step store
            true => of (perform ui::Slices.fetch slice)

    // Whether a store read's receipt says the file was there.
    found result = Doc::flag (Doc::parse result, "found")

    // `store` with the providers file's settings, and every chat given the saved defaults.
    withProviders (store, doc) =
        settings = Model::providersOf (store.settings, Doc::parse doc)
        // A conversation with nothing said yet was opened before the saved default was known.
        Runtime::asking (store(settings = settings, chats = mapList (store.chats, \chat => Model::withDefaultModel (chat, settings))), Model::newlyKeyed (store.settings, settings))

    providersLoaded (store, outcome) = readFound (store, outcome, "providers-file", \doc => withProviders (store, doc))

    chatsLoaded (store, outcome) = readFound (store, outcome, "chats-file", \doc => Runtime::step (Model::restored (store, doc)))

    folderChosen (store, outcome) = match outcome
        Error _ => Runtime::step store
        Success path => match path == ""
            true => Runtime::step store
            false =>
                chat = Model::active store
                folder = path
                mcp = store.mcp
                moved = Model::putChat (store(mcp = mcp(stateFolder = folder, stateProjectLoaded = false)), chat(chatFolder = folder))
                saving = Model::persisting (moved, "chats.json")
                saving(requests = listAppend saving.requests (Requests::ask ("mcp-project", Model::readTextAt (moved.settings.platform, "${folder}/.mcp.json", "mcp-project-file"))))

    // The MCP state from the document read for `slice`: `load` of its words when the read was `found` with words, else `missing`.
    mcpDocument (store, slice, found, load, missing) =
        text = perform ui::Slices.fetch slice
        Pick::either (found && text != "", load text, missing)

    // The three MCP documents answered: merge, stop what left the list, connect what is new.
    mcpGlobalLoaded (store, outcome) = match outcome
        Error _ => afterMcp (McpModel::globalMissing (store.mcp), store, [])
        Success result => afterMcp (mcpDocument (store, "mcp-file", found result, \text => McpModel::globalLoaded (store.mcp, text), McpModel::globalMissing (store.mcp)), store, [])

    mcpStateLoaded (store, outcome) = match outcome
        Error _ => afterMcp (McpModel::memoriesOf (store.mcp, JsonObject []), store, [])
        Success result => afterMcp (mcpDocument (store, "mcp-state-file", found result, \text => McpModel::memoriesOf (store.mcp, Doc::parse text), McpModel::memoriesOf (store.mcp, JsonObject [])), store, [])

    mcpProjectLoaded (store, outcome) = match outcome
        Error _ =>
            loaded = McpModel::projectMissing (store.mcp)
            afterMcp (loaded, store, McpRun::stopsFor (store.mcp, loaded))
        Success result =>
            loaded = mcpDocument (store, "mcp-project-file", Doc::number (Doc::parse result, "status") == 0, \text => McpModel::projectLoaded (store.mcp, text), McpModel::projectMissing (store.mcp))
            afterMcp (loaded, store, McpRun::stopsFor (store.mcp, loaded))

    // Once every document has answered, connect what is enabled and off.
    afterMcp (loaded, store, extra) = match McpModel::ready loaded
        false => Runtime::asking (store(mcp = loaded), extra)
        true =>
            connected = McpRun::connectAll (store(mcp = loaded))
            Runtime::asking (connected.stepStore, listConcat extra connected.requests)

    // One MCP ticket's kind and server name, as `mcpread:demo`.
    mcpParts ticket =
        rest = drop ticket 3
        match indexOf rest ":"
            Success at => JsonObject [Doc::str ("kind", take rest at), Doc::str ("name", drop rest (satAdd at 1))]
            Error _ => JsonObject []

    mcpAnswerOf (store, ticket, outcome) =
        parts = mcpParts ticket
        name = Doc::text (parts, "name")
        match Doc::text (parts, "kind")
            "start" => McpRun::started (store, name, outcome)
            "write" => McpRun::written (store, name, outcome)
            "read" => Turn::handOver (McpRun::readDone (store, name, outcome))
            "http" => Turn::handOver (McpRun::postDone (store, name, outcome))
            _ => Runtime::step store

    // The write in flight ended: say if it failed, and write what changed meanwhile.
    saved (store, outcome) =
        settings = store.settings
        problem = match outcome
            Error reason => "Your ${Model::saveLabel settings.saveName} could not be saved: ${reason}"
            Success _ => ""
        next = listGet settings.savePending 0 ?: ""
        settledStore = store(settings = settings(saving = false, savePending = filterList (settings.savePending, \name => name != next), saveName = "", saveProblem = problem))
        Pick::either (next == "", Runtime::step settledStore, Model::persisting (settledStore, next))

    chatOf (store, ticket) = Lists::find (store.chats, \chat => chat.chatTicket == ticket)

    (** Applies a completion: only the ticket a conversation is waiting on counts, so a stopped turn's late answer changes nothing. *)
    export completed (store, ticket, outcome) = match ticket
        "env" => settingsLoaded (store, outcome)
        "providers" => providersLoaded (store, outcome)
        "chats" => chatsLoaded (store, outcome)
        "folder" => folderChosen (store, outcome)
        "mcp-global" => mcpGlobalLoaded (store, outcome)
        "mcp-state" => mcpStateLoaded (store, outcome)
        "mcp-project" => mcpProjectLoaded (store, outcome)
        _ => match startsWith ticket "models:"
            true => Runtime::step (Model::modelsAnswered (store, ticket, outcome))
            false => answerTo (store, ticket, outcome)

    answerTo (store, ticket, outcome) = match startsWith ticket "mcp"
        true => mcpAnswerOf (store, ticket, outcome)
        false => match startsWith ticket "save:"
            true => saved (store, outcome)
            false => match chatOf (store, ticket)
                Error _ => Runtime::step store
                Success chat => match startsWith ticket "images:"
                    true => Turn::imagesRead (store, chat, ticket, outcome)
                    false => match startsWith ticket "model:"
                        true => Turn::modelAnswered (store, chat, ticket, outcome)
                        false => Turn::toolAnswered (store, chat, ticket, outcome)

(** Osprey Agent as the framework runs it: launch, update, regions, the session document and the theme ([UI-STORE], [UI-REGIONS]). *)
module App
    // A read of `name` from the app's private store, `limit` bytes at most, into `slice`.
    storeRead (ticket, name, limit, slice) = Requests::ask (ticket, ui::StoreRead(readName = name, readLimit = limit, readSlice = slice))

    (** The store at launch, with the conversations, the providers and the key file asked for. The first launch argument names the project folder and the second a dotenv file; without one, the `key.env` in the app's own store is the dotenv file, so opening the app from the Dock finds the key. *)
    export initial context =
        home = context.home
        folder = Pick::either ((listGet context.arguments 0 ?: "") == "", home, listGet context.arguments 0 ?: "")
        store = Model::launched (context.platform, home, folder, context.now)
        envFile = listGet context.arguments 1 ?: ""
        env = Requests::ask ("env", Pick::either (envFile == "", ui::StoreRead(readName = "key.env", readLimit = 1000000, readSlice = "env"), Model::readText (context.platform, envFile)))
        Runtime::asking (store, [env, storeRead ("providers", "providers.json", 1000000, "providers-file"), storeRead ("chats", "chats.json", 64000000, "chats-file"), storeRead ("mcp-global", "mcp.json", 1000000, "mcp-file"), storeRead ("mcp-state", "mcp-state.json", 1000000, "mcp-state-file"), Requests::ask ("mcp-project", Model::readTextAt (context.platform, "${folder}/.mcp.json", "mcp-project-file"))])

    (** Applies one message: a tap, text or a choice, a flag, a splitter's width or a completion. *)
    export update (context, before, message) =
        store = before(clock = context.now)
        Messages::route (message, \action => Answers::tapped (store, action), \(action, text) => Answers::typed (store, action, text), \(action, on) => Answers::toggled (store, action, on), \(action, points) => Answers::sized (store, action, points), \(ticket, outcome) => Answers::completed (store, ticket, outcome), \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, _) => Runtime::step store)

    // Whether the slice read by `read` changed from `before` to `now`, as `encode` writes it.
    changedSince (before, now, encode, read) = signalChanges before now encode (signalDependencies read)

    chatsSlice () = perform Signal<Chats>.read ()

    draftSlice () = perform Signal<Draft>.read ()

    panelSlice () = perform Signal<Panel>.read ()

    settingsSlice () = perform Signal<Settings>.read ()

    mcpSlice () = (perform Signal<McpSignal>.read ()).signalState

    (** The regions: the window's split, the sidebar, the conversation's header and transcript, the composer, the inspector and the settings pane, each rebuilt only when a slice it read changed. *)
    export regions (before, store, frames, _) =
        chats = Chats(chatList = store.chats)
        previous = Chats(chatList = before.chats)
        handle static Signal<Chats>
            read => chats
        handle static Signal<Draft>
            read => store.draft
        handle static Signal<Panel>
            read => store.panel
        handle static Signal<Settings>
            read => store.settings
        handle static Signal<McpSignal>
            read => McpSignal(signalState = store.mcp)
        mcpChanged = changedSince (before.mcp, store.mcp, McpModel::storeJson, mcpSlice)
        changed = listConcat (changedSince (previous, chats, Model::chatsJson, chatsSlice)) (listConcat (changedSince (before.draft, store.draft, Model::draftJson, draftSlice)) (listConcat (changedSince (before.panel, store.panel, Model::panelJson, panelSlice)) (listConcat (changedSince (before.settings, store.settings, Model::settingsJson, settingsSlice)) mcpChanged)))
        [Keyed::region (frames, "root", changed, View::root), Keyed::region (frames, "sidebar", changed, View::sidebar), Keyed::region (frames, "header", changed, View::header), Keyed::region (frames, "transcript", changed, View::transcript), Keyed::region (frames, "composer", changed, View::composer), Keyed::region (frames, "inspector", changed, View::inspector), Keyed::region (frames, "settings", changed, View::settings)]

    (** The store as the opaque session document. *)
    export save store = Model::storeJson store

    (** The store from a saved session document. *)
    export restore doc = Model::storeOf doc

    (** Osprey Agent as its boundary runs it: its launch, update and regions, drawn with the agent's own colours. *)
    export program () = ui::Program(programInit = initial, programUpdate = update, programRender = regions, programTheme = \_ => theme ())

    token (name, light, dark) = ui::Token(tokenName = name, tokenLight = light, tokenDark = dark)

    (** Osprey Agent's colours in light and dark appearance, its spacing scale and its motion durations ([UI-THEME]). *)
    export theme () = ui::Theme(tokens = [
        token ("primary", "#17171A", "#EDEDF0"), token ("secondary", "#6B6B76", "#9B9BA6"), token ("faint", "#9A9AA5", "#65656F"),
        token ("accent", "#4F46E5", "#8B8CFF"), token ("onAccent", "#FFFFFF", "#101018"),
        token ("good", "#14804A", "#4CC38A"), token ("caution", "#A16207", "#F5B454"), token ("danger", "#C92A2A", "#F47C7C"),
        token ("canvas", "#FBFBFC", "#141417"), token ("sidebar", "#EFEFF3", "#1B1B20"), token ("surface", "#FFFFFF", "#1E1E23"), token ("raised", "#F3F3F6", "#26262C"),
        token ("bubble", "#EEEEF3", "#2A2A31"), token ("line", "#E4E4EA", "#2C2C33"), token ("inset", "#F6F6F9", "#18181C"),
        token ("codeFill", "#F2F2F6", "#0E0E11"), token ("codeInk", "#5B45D6", "#C2B5FF"),
        token ("codeKeyword", "#6D4AE0", "#A996FF"), token ("codeString", "#116D3F", "#7CE0A5"), token ("codeComment", "#62626E", "#8E8E9B"),
        token ("codeNumber", "#9A5B00", "#F5B454"), token ("codeFunction", "#1D4FD7", "#82B1FF"), token ("codeType", "#0E7468", "#5FDFCB"),
        token ("codeBuiltin", "#B02A62", "#FF9EC7"), token ("codeMeta", "#5551C9", "#AFAAFF"), token ("codeInserted", "#116D3F", "#7CE0A5"), token ("codeRemoved", "#BC2424", "#FF9E9E"),
    ], spacing = [4, 8, 12, 16, 24, 32], feedback = 120, settle = 220)
