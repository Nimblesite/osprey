// Money formatting cases, run against the real `bank::Money` module (src/domain/money.ospml) and its sealed signature. [TESTING-BUILTINS]
namespace bank

import bank::Money

(** The exact money strings the API and UI ship. *)
module MoneyCases
    (** --- cents formatting: the exact strings the API and UI ship --- *)
    export centsCase () =
        check "whole dollars" "$50.00" (Money::show (Money::fromCents 5000))
        check "with cents" "$19.80" (Money::show (Money::fromCents 1980))
        check "single-digit cents zero-pad" "$50.05" (Money::show (Money::fromCents 5005))
        check "one cent" "$0.01" (Money::show (Money::fromCents 1))
        check "zero" "$0.00" (Money::show (Money::fromCents 0))
        check "ninety-nine cents" "$0.99" (Money::show (Money::fromCents 99))
        check "negative cent retains its sign" "-$0.01" (Money::show (Money::fromCents (-1)))
        check "negative dollars retain their sign" "-$1,002.03" (Money::show (Money::fromCents (-100203)))
        check "minimum integer formats without negating it" "-$92,233,720,368,547,758.08" (Money::show (Money::fromCents (-9223372036854775808)))
        check "maximum integer formats exactly" "$92,233,720,368,547,758.07" (Money::show (Money::fromCents 9223372036854775807))

    (** --- thousands grouping across every magnitude boundary --- *)
    export groupingCase () =
        check "under a thousand" "$999.99" (Money::show (Money::fromCents 99999))
        check "exactly one thousand" "$1,000.00" (Money::show (Money::fromCents 100000))
        check "four-figure demo balance" "$2,462.40" (Money::show (Money::fromCents 246240))
        check "vault total" "$7,980.25" (Money::show (Money::fromCents 798025))
        check "ten thousand" "$10,000.00" (Money::show (Money::fromCents 1000000))
        check "hundred thousand" "$100,000.00" (Money::show (Money::fromCents 10000000))
        check "one million" "$1,000,000.00" (Money::show (Money::fromCents 100000000))
        check "grouping zero-pads inner triples" "$1,002,003.04" (Money::show (Money::fromCents 100200304))

    (** --- the domain guard used by movable/deposit validation --- *)
    export positiveCase () =
        check "positive is true" true (Money::positive (Money::fromCents 1))
        check "large positive" true (Money::positive (Money::fromCents 500000))
        check "zero is not positive" false (Money::positive (Money::fromCents 0))
        check "negative is not positive" false (Money::positive (Money::fromCents (-100)))

    (** The public manifest alias preserves every cent; Amount stays abstract. *)
    export representationCase () =
        check "zero round trips" 0 (Money::toCents (Money::fromCents 0))
        check "minimum integer round trips" (-9223372036854775808) (Money::toCents (Money::fromCents (-9223372036854775808)))
        check "maximum integer round trips" 9223372036854775807 (Money::toCents (Money::fromCents 9223372036854775807))
        check "manifest cents compose with integers" 42 (wrapAdd (Money::toCents (Money::fromCents 41)) 1)
