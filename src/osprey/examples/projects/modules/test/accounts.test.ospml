// Account domain cases, run against the real `bank::Accounts` rules (src/domain/accounts.ospml): the pure business rules (namable/movable), the Outcome union pattern-match, the JSON encoding of an Account (escaping included), the fixed-width TUI row and a storage effect handled in place of SQLite. [TESTING-BUILTINS]
namespace bank

import bank::Accounts

(** The pure ML-flavor testing surface [TESTING-VERDICT]: a three-state Verdict
    value and combinators. A case is a pure function returning a Verdict; `test`
    pattern-matches and reports it. No exceptions, no imperative assertions. *)
type Verdict =
    Pass
    Fail
        reason : string
    Skip
        why : string

(** A small storage contract for testing the rent workflow without SQLite. *)
effect Vault
    (** Read the balance held for `account`. *)
    balance : int => int
    (** Withdraw `amount` from `account`, reporting the `Outcome`. *)
    debit : (int, int) => Outcome

(** Account rules and renderings, each case a Verdict. *)
module AccountCases
    q = "\""

    (** A refusal is a domain value, not an error: classify one exhaustively. *)
    settle o = match o
        Landed balance => "landed ${balance}"
        Refused why => "refused ${why}"

    check (label, expected, actual) = match expected == actual
        true => Pass
        false => Fail(reason = "${label}: expected ${expected}, got ${actual}")

    andThen first rest = match first
        Pass => rest
        Fail reason => Fail(reason = reason)
        Skip why => Skip(why = why)

    (** --- account-opening rule --- *)
    export namableCase () =
        real = andThen (check ("a real name is namable", true, Accounts::namable "Amelia Chen")) (check ("single char is namable", true, Accounts::namable "x"))
        andThen real (check ("empty name is refused", false, Accounts::namable ""))

    (** --- movement-amount rule --- *)
    export movableCase () =
        pos = andThen (check ("positive cents move", true, Accounts::movable 5000)) (check ("one cent moves", true, Accounts::movable 1))
        zeroNeg = andThen (check ("zero does not move", false, Accounts::movable 0)) (check ("negative does not move", false, Accounts::movable (-250)))
        andThen pos zeroNeg

    (** --- the Outcome union both API and main pattern-match --- *)
    export outcomeCase () =
        andThen (check ("landed carries the new balance", "landed 3600", settle (Landed(balance = 3600)))) (check ("refused carries the reason", "refused insufficient funds", settle (Refused(why = "insufficient funds"))))

    (** --- JSON rendering, escaping the owner name through the encoder --- *)
    export jsonCase () =
        plain = check ("plain account row", "{${q}id${q}:1,${q}owner${q}:${q}Amelia Chen${q},${q}cents${q}:246240,${q}balance${q}:${q}$2,462.40${q}}", Accounts::json (Account(id = 1, owner = "Amelia Chen", balance = 246240)))
        andThen plain (check ("owner with a quote stays valid JSON", "{${q}id${q}:9,${q}owner${q}:${q}a${bs}${q}b${q},${q}cents${q}:0,${q}balance${q}:${q}$0.00${q}}", Accounts::json (Account(id = 9, owner = "a${q}b", balance = 0))))

    (** --- fixed-width TUI row alignment --- *)
    export rowCase () =
        wide = check ("row pads owner and right-aligns money", "│  1 │ Amelia Chen  │ $2,462.40 │", Accounts::row (Account(id = 1, owner = "Amelia Chen", balance = 246240)))
        andThen wide (check ("short owner and small balance pad out", "│  3 │ Bo           │     $0.05 │", Accounts::row (Account(id = 3, owner = "Bo", balance = 5))))

    bs = "\\"

    (** The workflow under test: rent only moves when the guard says it can. *)
    payRent account cents = match Accounts::movable cents && perform Vault.balance account >= cents
        true => perform Vault.debit account cents
        false => Refused(why = "blocked by guard")

    (** Each factory call owns a balance; reusing its handler shares that balance.
        The return clause converts the completed workflow's Outcome to text. *)
    vault opening =
        mut balance = opening
        handler Vault
            balance _ => balance
            debit _ cents =>
                balance := satSub balance cents
                Landed(balance = balance)
            return outcome => settle outcome

    (** --- a reused handler keeps its balance; a fresh factory call starts its own --- *)
    export mockedVaultCase () =
        flush = vault 9000
        broke = vault 40
        rent = \() => payRent 1 2500
        landed = check ("flush vault lands the rent", "landed 6500", flush rent)
        reused = andThen landed (check ("reusing a handler keeps its balance", "landed 4000", flush rent))
        andThen reused (check ("independent handler refuses via the guard", "refused blocked by guard", broke rent))

    (** --- a refused amount never reaches storage: the spy handler stays untouched --- *)
    export guardCase () =
        mut touched = false
        spy = handler Vault
            balance _ =>
                touched := true
                999999
            debit _ _ =>
                touched := true
                Refused(why = "vault touched")
        refused = check ("zero cents are refused", "refused blocked by guard", settle (spy (\() => payRent 1 0)))
        andThen refused (check ("invalid amount performs no storage operations", false, touched))
