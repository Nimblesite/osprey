// domain/json — the TYPED JSON ENCODER. [MODULES-SIGNATURE]
//
// One place, and only one place, turns Osprey values into JSON text. No layer
// above ever splices a raw `${value}` inside a string literal — they build
// documents by composing these typed combinators, so string escaping (quotes,
// backslashes) is handled centrally and correctly. A name like
// `Amelia "Mel" Chen` round-trips through `jsonParse` instead of producing a
// broken document.
//
// The signature is the module's whole public surface, so no `export` markers
// appear inside and nothing beyond the combinators can leak.

namespace bank

signature JsonApi
    quote : string -> string
    strField : string -> string -> string
    numField : string -> int -> string
    rawField : string -> string -> string
    members : List<string> -> string
    append : string -> string -> string
    validArray : string -> int -> (int -> int -> int -> bool) -> bool
    everyRow : int -> int -> (int -> bool) -> bool
    obj : string -> string
    arr : string -> string
    error : string -> string
    getOr : string -> string -> string -> string
    scalar : int -> string -> string

module Json : JsonApi
    controlEscape code =
        digits = "0123456789abcdef"
        high = match code >= 16
            true => 1
            false => 0
        low = code % 16
        "\\u00" + take (drop digits high) 1 + take (drop digits low) 1

    escapeControl (source, code) =
        character = fromCodePoint code ?: ""
        match contains source character
            true => replace source character (controlEscape code) ?: source
            false => source

    // Escape original slashes first; later JSON escapes must remain single.
    // Runtime strings cannot contain NUL, so representable controls start at 1.
    // Folding over the control range needs no counter, so escaping is total.
    escape s =
        bslash = "\\"
        quote = "\""
        step = replace s bslash (bslash + bslash) ?: ""
        range (1, 32) |> fold (replace step quote (bslash + quote) ?: "") escapeControl

    quote s =
        quote = "\""
        quote + escape s + quote

    // `"key":"escaped value"` — a string-valued object member.
    strField key value = quote key + ":" + quote value

    // `"key":123` — a number-valued object member (integers need no escaping).
    numField key value = quote key + ":" + toString value

    // An already-encoded JSON value. Kept explicit so callers cannot confuse
    // protocol trees with ordinary escaped application strings.
    rawField key value = quote key + ":" + value

    // Wrap a comma-joined member list into an object / array. Callers join the
    // members with `,`; these only add the braces so nesting stays composable.
    obj joined = "{" + joined + "}"

    // Object members in declaration order, so a record lists its fields without
    // hand-joining the separators (one escaping rule, one separator).
    members fields = join (fields, ",")

    // Two encoded member lists joined with the one separator, either of which may be empty.
    append left right = match length left == 0
        true => right
        false => match length right == 0
            true => left
            false => left + "," + right

    arr elements = "[" + elements + "]"

    // The one canonical error body shape, so every 4xx path is identical.
    error why = obj (strField "error" why)

    // A parsed JSON array of at most `limit` rows, every one accepted by `rows`.
    // The bounds check lives here so no boundary reads a document unbounded.
    validArray source limit rows = match startsWith (trimStart source) "["
        false => false
        true => match jsonParse source
            Error _ => false
            Success doc =>
                count = jsonLength doc ""
                valid = count <= limit && rows doc 0 count
                freed = jsonFree doc ?: 0
                valid

    // A field of an already-parsed document, empty when the document lacks it.
    scalar doc path = jsonGet doc path ?: ""

    // Every row index below `count` accepted by `row`: the loop `validArray` folds.
    everyRow index count row = match index >= count
        true => true
        false => row index && everyRow (satAdd index 1) count row

    // Scalar-only projection used by the browser model boundary. Documents
    // are always freed here, so consumers cannot accidentally retain handles.
    getOr source path fallback =
        doc = jsonParse source ?: 0
        value = jsonGet doc path ?: fallback
        _freed = jsonFree doc ?: 0
        value
