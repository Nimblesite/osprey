// Implements [UI-COMPONENTS] for Talon Bank's forms: moving money, searching the journal and
// opening an account. Every field reports each edit to the store, so validation in `Update`
// sees exactly what the person typed.
namespace talon

import ui::Ui
import ui::Symbols
import talon::Parts
import talon::Screens

(** Move money, Activity and the new-account dialog. *)
module Forms
    modes () = [Ui::choice ("deposit", "Deposit"), Ui::choice ("withdraw", "Withdraw"), Ui::choice ("transfer", "Transfer")]

    amount draft = Ui::field ("Amount", draft.draftAmount, "0.00", EditAmount)

    note draft = Ui::field ("Description", draft.draftNote, "What is this for?", EditNote)

    submit (store, words) = Ui::action (words, Symbols::name ui::Send, ui::Prominent, store.bankBusy == false, SubmitMove)

    // The fields of the chosen mode: one account for a deposit or withdrawal, two for a transfer.
    accounts store =
        draft = store.bankDraft
        held = store.bankAccounts
        match store.bankMode
            "deposit" => [Parts::picker ("Deposit to", held, draft.draftAccount, PickAccount)]
            "withdraw" => [Parts::picker ("Withdraw from", held, draft.draftAccount, PickAccount)]
            _ => [Parts::picker ("From account", held, draft.draftFrom, PickFrom), Parts::picker ("To account", held, draft.draftTo, PickTo)]

    heading mode = match mode
        "deposit" => "Deposit funds"
        "withdraw" => "Withdraw funds"
        _ => "Transfer money"

    lead mode = match mode
        "deposit" => "Credit an account instantly and journal the movement."
        "withdraw" => "Debit securely. Overdraft attempts are refused and audited."
        _ => "Move funds atomically between Talon accounts."

    verb mode = match mode
        "deposit" => "Confirm deposit"
        "withdraw" => "Confirm withdrawal"
        _ => "Confirm transfer"

    form store =
        mode = store.bankMode
        Ui::section (heading mode, lead mode, listConcat (accounts store) [amount store.bankDraft, note store.bankDraft, submit (store, verb mode)])

    tip (heading, detail) = Ui::column [Ui::label (heading, Symbols::name ui::Check), Ui::caption detail]

    guidance () = Ui::section ("Every movement is protected", "", [tip ("Atomic transfers", "Both sides land together, or not at all."), tip ("Complete journal", "Successful and refused attempts are recorded."), tip ("Integer precision", "Money stays in whole cents from form to ledger.")])

    (** Deposit, withdraw or transfer, guarded by the same rules on every platform. *)
    export move store = Ui::screen ("Move money", "Client funds, in motion", Screens::tools (), [Ui::picker ("Movement", modes (), store.bankMode, PickMode), form store, guidance ()])

    kept (line, filter) = match filter
        "in" => line.movementKind == "credit"
        "out" => line.movementKind == "debit"
        "refused" => line.movementKind == "refused"
        _ => true

    found (line, query) = query == "" || contains (toLowerCase "${line.movementNote} ${line.movementOwner}") query

    (** The journal lines the filter and search keep. *)
    export shown store =
        query = toLowerCase (trim store.bankSearch)
        filterList (store.bankJournal, \line => kept (line, store.bankFilter) && found (line, query))

    filters journal = [Ui::choice ("all", "All ${length journal}"), Ui::choice ("in", "Money in ${Parts::counted (journal, "credit")}"), Ui::choice ("out", "Money out ${Parts::counted (journal, "debit")}"), Ui::choice ("refused", "Declined ${Parts::counted (journal, "refused")}")]

    (** Every credit, debit and refusal, searchable and filtered by kind. *)
    export activity store = Ui::screen ("Activity", "Audit trail", Screens::tools (), listConcat [Ui::field ("Search", store.bankSearch, "Search description or owner", EditSearch), Ui::picker ("Show", filters store.bankJournal, store.bankFilter, PickFilter)] (Parts::journal (shown store, 100, Symbols::name ui::Search, "No matching activity", "Try another search or broaden the filter.")))

    (** The new-account dialog. *)
    export opening store = Ui::dialog ("Open account", Ui::column [Ui::caption "Create a protected client account in one step. Storage stays on the server.", Ui::field ("Account owner", store.bankDraft.draftOwner, "Full legal name", EditOwner), Ui::row [Ui::button ("Cancel", Symbols::name ui::Dismiss, CloseDialog), Ui::action ("Create account", Symbols::name ui::Add, ui::Prominent, store.bankBusy == false, SubmitOpen)]], CloseDialog)
