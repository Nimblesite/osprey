namespace talon

import talon::UI
import talon::BankData
import talon::AccountView
import talon::ActivityView

module AccountsPage
    fact label value = UI::node "div" "" (UI::leaf "dt" "" label + "," + UI::leaf "dd" "" value)

    detail model =
        doc = jsonParse model.accounts ?: 0
        index = BankData::accountIndex doc model.selected
        id = BankData::value doc "[${index}].id" "—"
        owner = BankData::value doc "[${index}].owner" "No account selected"
        balance = BankData::value doc "[${index}].balance" "$0.00"
        cents = BankData::integer doc "[${index}].cents"
        freed = jsonFree doc ?: 0
        available = match cents > 0
            true => "Ready to move"
            false => "Waiting for first deposit"
        heading = UI::block "detail-heading" (UI::node "div" "" (UI::text "account-mark violet" "T" + "," + UI::node "div" "" (UI::leaf "small" "" "TALON ACCOUNT #${id}" + "," + UI::leaf "h2" "" owner)) + "," + UI::text "status-pill success" "● Active")
        balanceBlock = UI::block "detail-balance" (UI::leaf "small" "" "Available balance" + "," + UI::leaf "strong" "" balance + "," + UI::leaf "span" "" available)
        actions = UI::block "detail-actions" (UI::button "quick-deposit" "button primary" "Deposit" "+" + "," + UI::button "quick-withdraw" "button secondary" "Withdraw" "−" + "," + UI::button "quick-transfer" "button secondary" "Transfer" "↗")
        facts = UI::node "dl" (UI::cls "detail-facts") (fact "Account ID" "#${id}" + "," + fact "Ledger" "Journaled" + "," + fact "Overdrafts" "Refused")
        UI::card "account-detail" (heading + "," + balanceBlock + "," + actions + "," + facts)

    export view model =
        cards = AccountView::cards model.accounts 99 model.selected
        recent = ActivityView::rows model.activity 4 "all" ""
        pageHead = UI::pageHead "ACCOUNTS" "Client accounts" "Every managed balance and protected client account in one view." (UI::button "accounts-open" "button primary" "Open account" "+")
        allCards = UI::orEmpty "account-grid account-grid-wide" "◇" "No accounts yet" "Open an account in seconds—no paperwork required." cards
        recentBody = UI::orEmpty "activity-list" "↯" "No movements" "Activity for this account will show here." recent
        recentHead = UI::block "section-heading" (UI::append (UI::leaf "h2" "" "Latest movements") (UI::button "accounts-activity" "text-button" "See all" "→"))
        recentCard = UI::card "compact-activity" (recentHead + "," + recentBody)
        detailGrid = UI::block "account-detail-grid" (detail model + "," + recentCard)
        UI::page "accounts" (pageHead + "," + allCards + "," + detailGrid)
