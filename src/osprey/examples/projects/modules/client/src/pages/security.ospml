namespace talon

import talon::UI

module SecurityPage
    control icon title body status = UI::node "li" (UI::cls "security-control") (UI::text "security-icon" icon + "," + UI::node "span" (UI::cls "security-copy") (UI::leaf "strong" "" title + "," + UI::leaf "small" "" body) + "," + UI::text "status-pill success" status)

    layer number title code body = UI::node "li" (UI::cls "architecture-layer") (UI::text "layer-number" number + "," + UI::node "div" "" (UI::leaf "small" "" code + "," + UI::leaf "h3" "" title + "," + UI::leaf "p" "" body))

    export view model =
        pageHead = UI::pageHead "SECURITY & ARCHITECTURE" "Trust you can inspect" "One Osprey banking app, shared across web, iOS, and Android." ""
        hero = UI::node "section" (UI::cls "security-hero") (UI::block "security-orbit" (UI::text "orbit-ring ring-one" "" + "," + UI::text "orbit-ring ring-two" "" + "," + UI::leaf "strong" "" "T") + "," + UI::block "security-hero-copy" (UI::text "status-pill success" "● All systems protected" + "," + UI::leaf "h2" "" "Capability-checked by construction" + "," + UI::leaf "p" "" "The app can request bank operations, but it never receives storage authority. Osprey’s module and effect boundaries decide what code is allowed to do."))
        controls = UI::card "security-card" (UI::sectionHead "ACTIVE CONTROLS" "Protection status" "" + "," + UI::node "ul" (UI::cls "security-list") (control "◇" "Storage isolation" "The UI has no Ledger or SQLite capability." "Enforced" + "," + control "⇄" "Atomic transfers" "Debit and credit commit as one transaction." "Enforced" + "," + control "◎" "Immutable audit trail" "Refused overdrafts are journalled too." "Live" + "," + control "¢" "Whole-cent arithmetic" "No floating-point drift in money flows." "Verified"))
        layers = UI::node "ol" (UI::cls "architecture-stack") (layer "01" "Platform renderer" "HOST / VIEW" "Turns declarative nodes into a fast, accessible interface. It owns no bank logic." + "," + layer "02" "Shared Osprey app" "MODEL · UPDATE · VIEW" "Owns routing, interactions, validation, state transitions, and command descriptions." + "," + layer "03" "HTTP capability" "COMMAND / API" "The host sends typed requests to the public bank endpoints." + "," + layer "04" "Ledger service" "OSPREY / EFFECT HANDLERS" "Domain rules and SQLite authority remain on the server, beyond the UI boundary.")
        architecture = UI::node "section" (UI::cls "card architecture-card" + "," + UI::prop "id" "architecture") (UI::text "eyebrow" "HOW THIS APP RUNS" + "," + UI::leaf "h2" "" "A thin host. A serious Osprey core." + "," + UI::leaf "p" (UI::cls "architecture-lead") "The shared app emits view data and commands. React, SwiftUI, and Android render native controls and transport requests." + "," + layers)
        UI::page "security" (pageHead + "," + hero + "," + UI::block "security-grid" (controls + "," + architecture))
