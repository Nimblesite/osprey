namespace talon

import talon::UI
import talon::BankData
import talon::ActivityView

module ActivityPage
    stat icon label value = UI::block "mini-stat" (UI::leaf "span" "" icon + "," + UI::node "div" "" (UI::leaf "small" "" label + "," + UI::leaf "strong" "" (toString value)))

    export view model =
        total = BankData::activityCount model.activity
        credits = ActivityView::count model.activity "credit"
        debits = ActivityView::count model.activity "debit"
        refused = ActivityView::count model.activity "refused"
        rows = ActivityView::rows model.activity 100 model.activityFilter model.search
        pageHead = UI::pageHead "AUDIT TRAIL" "Activity" "Every credit, debit, transfer side, and refusal in one live ledger." (UI::button "activity-refresh" "button secondary" "Refresh" "↻")
        search = UI::node "label" (UI::cls "search-box" + "," + UI::prop "htmlFor" "activity-search") (UI::leaf "span" "" "⌕" + "," + UI::leaf "input" (UI::prop "id" "activity-search" + "," + UI::prop "name" "search" + "," + UI::prop "event" "input" + "," + UI::prop "value" model.search + "," + UI::prop "placeholder" "Search description or owner" + "," + UI::prop "type" "search") "")
        allActive = model.activityFilter == "all"
        inActive = model.activityFilter == "in"
        outActive = model.activityFilter == "out"
        refusedActive = model.activityFilter == "refused"
        filters = UI::block "filter-row" (UI::chip "filter-all" "All ${total}" "" allActive + "," + UI::chip "filter-in" "Money in ${credits}" "↙" inActive + "," + UI::chip "filter-out" "Money out ${debits}" "↗" outActive + "," + UI::chip "filter-refused" "Declined ${refused}" "!" refusedActive)
        summary = UI::block "mini-stat-grid" (stat "◎" "Total entries" total + "," + stat "↙" "Credits" credits + "," + stat "↗" "Debits" debits + "," + stat "!" "Protected refusals" refused)
        body = UI::orEmpty "activity-list activity-list-full" "⌕" "No matching activity" "Try another search or broaden the movement filter." rows
        ledger = UI::card "ledger-card" (UI::block "ledger-toolbar" (search + "," + filters) + "," + body)
        UI::page "activity" (pageHead + "," + summary + "," + ledger)
