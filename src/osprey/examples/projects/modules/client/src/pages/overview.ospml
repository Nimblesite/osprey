namespace talon

import talon::UI
import bank::Money
import talon::BankData
import talon::ActivityView
import talon::AccountView

module OverviewPage
    stat icon label value trend = UI::node "article" (UI::cls "stat-card") (UI::text "stat-icon" icon + "," + UI::node "span" (UI::cls "stat-copy") (UI::leaf "small" "" label + "," + UI::leaf "strong" "" value + "," + UI::leaf "em" "" trend))

    export view model =
        total = BankData::total model.accounts
        accounts = BankData::accountCount model.accounts
        movements = BankData::activityCount model.activity
        cards = AccountView::cards model.accounts 3 model.selected
        recent = ActivityView::rows model.activity 5 "all" ""
        heroCopy = UI::block "hero-copy" (UI::text "eyebrow" "MANAGED PORTFOLIO" + "," + UI::leaf "h1" "" (Money::show (Money::fromCents total)) + "," + UI::leaf "p" "" "Across ${accounts} protected client accounts" + "," + UI::block "hero-actions" (UI::button "quick-transfer" "button primary" "Move money" "↗" + "," + UI::button "quick-deposit" "button ghost-on-dark" "Add funds" "+"))
        heroArt = UI::node "div" (UI::cls "hero-art" + "," + UI::prop "aria-hidden" "true") (UI::text "orb orb-one" "" + "," + UI::text "orb orb-two" "" + "," + UI::text "hero-monogram" "T")
        hero = UI::node "section" (UI::cls "hero-card") (heroCopy + "," + heroArt)
        stats = UI::node "section" (UI::cls "stat-grid") (stat "↙" "Money in" (toString (ActivityView::count model.activity "credit")) "healthy inflow" + "," + stat "↗" "Money out" (toString (ActivityView::count model.activity "debit")) "this cycle" + "," + stat "◎" "Journal entries" (toString movements) "fully audited")
        accountsHead = UI::sectionHead "MANAGED CLIENTS" "Client accounts" (UI::button "overview-accounts" "text-button" "View all" "→")
        accountBody = UI::orEmpty "account-grid" "◇" "No accounts yet" "Open your first account to start moving money." cards
        accountsSection = UI::node "section" (UI::cls "section-block") (accountsHead + "," + accountBody)
        activityHead = UI::sectionHead "LIVE LEDGER" "Recent activity" (UI::button "overview-activity" "text-button" "Full history" "→")
        activityBody = UI::orEmpty "activity-list" "↯" "Nothing to report" "New movements will appear here instantly." recent
        activitySection = UI::card "section-block" (activityHead + "," + activityBody)
        UI::page "overview" (hero + "," + stats + "," + accountsSection + "," + activitySection)
