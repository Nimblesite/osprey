namespace talonmobile

import talonmobile::Support
import talonmobile::Mobile
import bank::Json

// One filter: its control id, the movement it keeps and the one it hides.
filterCase entry =
    activity = Support::click (Support::loaded ()) "nav-activity"
    filtered = Support::click activity entry.label
    Support::each [Support::it "matching movement remains" "true" (toString (Support::hasText filtered entry.expected)), Support::it "other movement hidden" "false" (toString (Support::hasText filtered entry.actual)), Support::it "filter needs no transport" "MISSING" (Support::projected filtered "commands[0].kind")]

filtersCase () =
    forEachList [Support::it "filter-in" "Opening deposit" "Rent payment", Support::it "filter-out" "Rent payment" "Opening deposit", Support::it "filter-refused" "Protected refusal" "Rent payment"] filterCase
    all = Support::click (Support::click (Support::loaded ()) "nav-activity") "filter-all"
    Support::each [Support::it "all includes credits" "true" (toString (Support::hasText all "Opening deposit")), Support::it "all includes debits" "true" (toString (Support::hasText all "Rent payment")), Support::it "all includes refusals" "true" (toString (Support::hasText all "Protected refusal"))]

searchCase () =
    activity = Support::click (Support::loaded ()) "nav-activity"
    owner = Support::input activity "activity-search" "  aMeLiA  "
    note = Support::input activity "activity-search" "RENT"
    missing = Support::input activity "activity-search" "nonexistent"
    Support::each [Support::it "case insensitive owner search" "true" (toString (Support::hasText owner "Opening deposit")), Support::it "nonmatching owner hidden" "false" (toString (Support::hasText owner "Rent payment")), Support::it "case insensitive description search" "true" (toString (Support::hasText note "Rent payment")), Support::it "empty results displayed" "true" (toString (Support::hasText missing "No matching activity")), Support::it "search requires no request" "MISSING" (Support::projected note "commands[0].kind")]

combinedFilterCase () =
    activity = Support::click (Support::loaded ()) "nav-activity"
    credit = Support::click activity "filter-in"
    searched = Support::input credit "activity-search" "Luca"
    Support::each [Support::it "filter and search intersect" "true" (toString (Support::hasText searched "No matching activity")), Support::it "full journal stats retained" "true" (toString (Support::hasText searched "All 3"))]

failedLoadCase () =
    first = Support::http (Mobile::start ()) "accounts" 503 "{}"
    ready = Support::http first "activity" 200 "[]"
    refreshed = Support::click ready "refresh-data"
    Support::each [Support::it "failed load visible" "Bank data unavailable" (Support::model first).noticeTitle, Support::it "both completions stop skeleton" "false" (Support::model ready).loading, Support::it "refresh displays progress" "true" (Support::model refreshed).loading, Support::it "refresh retries accounts" "accounts" (Support::projected refreshed "commands[0].id"), Support::it "refresh retries activity" "activity" (Support::projected refreshed "commands[1].id")]

transportErrorsCase () =
    loaded = Support::loaded ()
    offline = Support::http loaded "mutate-deposit" 0 "{}"
    server = Support::http loaded "mutate-deposit" 503 "{}"
    denied = Support::http loaded "mutate-deposit" 403 "{}"
    detail = Support::http loaded "mutate-deposit" 0 (Json::error "Connection timed out")
    Support::each [Support::it "offline reason visible" "true" (toString (contains (Support::model offline).noticeBody "could not reach")), Support::it "server status visible" "true" (toString (contains (Support::model server).noticeBody "503")), Support::it "refusal status visible" "true" (toString (contains (Support::model denied).noticeBody "403")), Support::it "native transport detail takes priority" "Connection timed out" (Support::model detail).noticeBody]

emptyCase () =
    loaded = Support::http (Support::http (Mobile::start ()) "accounts" 200 "[]") "activity" 200 "[]"
    accounts = Support::click loaded "nav-accounts"
    activity = Support::click loaded "nav-activity"
    Support::each [Support::it "zero portfolio" "true" (toString (Support::hasText loaded "$0.00")), Support::it "no accounts view" "true" (toString (Support::hasText accounts "No accounts yet")), Support::it "empty audit view" "true" (toString (Support::hasText activity "No matching activity"))]

unknownEventCase () =
    loaded = Support::loaded ()
    clicked = Support::click loaded "does-not-exist"
    submitted = Support::submit loaded "does-not-exist" "{}"
    entered = Support::input loaded "does-not-exist" "value"
    Support::each [Support::it "unknown click is inert" (loaded) clicked, Support::it "unknown submit is inert" (loaded) submitted, Support::it "unknown input is inert" (loaded) entered]
