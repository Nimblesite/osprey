namespace talonmobile

import talonmobile::Mobile
import talonmobile::Support
import talon::App
import talon::Bridge
import talon::Model
import bank::Json

startupCase () =
    envelope = Mobile::start ()
    Support::each [Support::it "model starts on overview" "overview" (Support::model envelope).route, Support::it "loading state" "true" (Support::model envelope).loading, Support::it "accounts requested" "accounts" (Support::projected envelope "commands[0].id"), Support::it "accounts endpoint" "/api/accounts" (Support::projected envelope "commands[0].url"), Support::it "activity requested" "activity" (Support::projected envelope "commands[1].id"), Support::it "activity endpoint" "/api/activity" (Support::projected envelope "commands[1].url"), Support::it "GET hydration" "GET" (Support::projected envelope "commands[0].method"), Support::it "shared shell emitted" "app-shell" (Support::projected envelope "view.props.className"), Support::it "loading skeleton" "true" (toString (Support::hasClass envelope "page loading-page"))]

hydrationCase () =
    initial = Mobile::start ()
    first = Support::http initial "activity" 200 (Support::activity ())
    ready = Support::http first "accounts" 200 (Support::accounts ())
    Support::each [Support::it "waits for both resources" "true" (Support::model first).loading, Support::it "loading finishes in either order" "false" (Support::model ready).loading, Support::it "accounts retained" (Support::accounts ()) (Support::model ready).accounts, Support::it "journal retained" (Support::activity ()) (Support::model ready).activity, Support::it "portfolio uses integer totals" "true" (toString (Support::hasText ready "$2,000.50")), Support::it "all clients visible" "true" (toString (Support::hasText ready "Nora Okafor")), Support::it "hydration does not loop" "MISSING" (Support::projected ready "commands[0].kind")]

handlerCase () =
    recording = handler Bridge::Render
        present envelope => "captured:" + Support::projected envelope "commands[0].id"
    Support::each [Support::it "callable handler supplies native return value" "captured:accounts" (App::start recording), Support::it "handler reusable" "captured:accounts" (App::start recording)]
    nested = handler Bridge::Render
        present envelope => perform Bridge::Render.present envelope
    check "handler arms forward to outer handler" "captured:accounts" (recording (\() => App::start nested))

restoreCase () =
    loaded = Support::click (Support::loaded ()) "nav-activity"
    searched = Support::input loaded "activity-search" "Amelia"
    restored = Support::dispatch searched (Json::strField "kind" "restore")
    Support::each [Support::it "opaque model survives native lifecycle" (Support::projected searched "model") (Support::projected restored "model"), Support::it "view survives native lifecycle" (searched) restored, Support::it "restore performs no HTTP" "MISSING" (Support::projected restored "commands[0].kind")]

routeCase route heading =
    navigated = Support::click (Support::loaded ()) "nav-${route}"
    Support::each [Support::it "route stored" route (Support::model navigated).route, Support::it "native navigation command" "#/${route}" (Support::projected navigated "commands[0].url"), Support::it "screen heading visible" "true" (toString (Support::hasText navigated heading)), Support::it "sidebar active state" "true" (toString (contains navigated (Json::strField "aria-current" "page")))]

routesCase () =
    routeCase "overview" "$2,000.50"
    routeCase "accounts" "Client accounts"
    routeCase "move" "Client funds, in motion"
    routeCase "activity" "Activity"
    routeCase "security" "Trust you can inspect"

locationCase () =
    loaded = Support::loaded ()
    accounts = Support::location loaded "#/accounts"
    direct = Support::location accounts "activity"
    invalid = Support::location direct "#/unknown"
    Support::each [Support::it "URL navigation" "accounts" (Support::model accounts).route, Support::it "native route navigation" "activity" (Support::model direct).route, Support::it "unknown route returns home" "overview" (Support::model invalid).route, Support::it "location never loops navigation" "MISSING" (Support::projected direct "commands[0].kind")]

menuCase () =
    opened = Support::click (Support::loaded ()) "toggle-menu"
    closed = Support::click opened "toggle-menu"
    navigated = Support::click opened "nav-move"
    Support::each [Support::it "drawer opens" "open" (Support::model opened).menu, Support::it "drawer marked for native renderers" "true" (toString (Support::hasClass opened "sidebar open")), Support::it "drawer toggles closed" "closed" (Support::model closed).menu, Support::it "navigation closes drawer" "closed" (Support::model navigated).menu]

selectionCase () =
    selected = Support::click (Support::loaded ()) "account-2"
    deposit = Support::click selected "quick-deposit"
    withdraw = Support::click selected "quick-withdraw"
    transfer = Support::click selected "quick-transfer"
    Support::each [Support::it "card selection persists" "2" (Support::model selected).selected, Support::it "card opens accounts" "accounts" (Support::model selected).route, Support::it "account owner is a heading node" "true" (toString (contains selected (Json::strField "tag" "h2" + "," + Json::strField "text" "Luca Moretti"))), Support::it "deposit mode" "deposit" (Support::model deposit).moveMode, Support::it "withdraw mode" "withdraw" (Support::model withdraw).moveMode, Support::it "transfer mode" "transfer" (Support::model transfer).moveMode, Support::it "quick action moves screens" "move" (Support::model deposit).route, Support::it "form uses selected account" "true" (toString (contains deposit (Json::strField "defaultValue" "2")))]

modalCase () =
    opened = Support::click (Support::loaded ()) "open-account"
    cancelled = Support::click opened "cancel-modal"
    closed = Support::click opened "close-modal"
    Support::each [Support::it "modal opened" "open" (Support::model opened).modal, Support::it "owner field receives focus" "new-owner" (Support::projected opened "commands[0].id"), Support::it "focus command kind" "focus" (Support::projected opened "commands[0].kind"), Support::it "accessible dialog" "true" (toString (contains opened (Json::strField "role" "dialog"))), Support::it "cancel dismisses" "closed" (Support::model cancelled).modal, Support::it "close dismisses" "closed" (Support::model closed).modal]

testCases [
    { name = "native startup returns shared view and hydration commands", work = startupCase },
    { name = "HTTP completions hydrate both resources in either order", work = hydrationCase },
    { name = "callable effect handlers return and forward native envelopes", work = handlerCase },
    { name = "native lifecycle restores the exact shared state and view", work = restoreCase },
    { name = "all five screens use the same route transitions and headings", work = routesCase },
    { name = "native and browser locations normalize and never loop", work = locationCase },
    { name = "mobile drawer toggles and closes after navigation", work = menuCase },
    { name = "account selection and quick actions preserve shared form defaults", work = selectionCase },
    { name = "account modal exposes focus and accessible dismiss actions", work = modalCase },
    { name = "activity filters share exact credit debit and refused semantics", work = filtersCase },
    { name = "search matches owner and note without network access", work = searchCase },
    { name = "search and filter intersect while totals remain complete", work = combinedFilterCase },
    { name = "failed hydration remains visible and refresh retries both resources", work = failedLoadCase },
    { name = "offline HTTP and ledger errors become actionable notices", work = transportErrorsCase },
    { name = "empty accounts and journal render usable shared empty states", work = emptyCase },
    { name = "unknown native events preserve model and view without commands", work = unknownEventCase },
    { name = "deposit emits exact cents and preserves escaped Unicode notes", work = depositCase },
    { name = "withdraw emits the shared protected ledger request", work = withdrawCase },
    { name = "transfer emits exact source destination and integer amount", work = transferCase },
    { name = "invalid forms reject before any native network request", work = invalidFormsCase },
    { name = "money validation rejects precision grouping signs and overflow", work = moneyCase },
    { name = "account creation trims names and closes modal after success", work = openAccountCase },
    { name = "all successful mutations show matching notices and refresh", work = successesCase },
    { name = "overdraft refusal preserves balances and refreshes the audit trail", work = refusalCase },
    { name = "pending movement cannot be submitted twice before completion", work = pendingSubmissionCase }
]
