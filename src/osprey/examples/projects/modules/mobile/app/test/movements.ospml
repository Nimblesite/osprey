namespace talonmobile

import talonmobile::Support
import talon::BankData
import bank::Json

postCase id url data cents =
    envelope = Support::submit (Support::loaded ()) id data
    Support::each [Support::it "POST method" "POST" (Support::projected envelope "commands[0].method"), Support::it "correct endpoint" (url) (Support::projected envelope "commands[0].url"), Support::it "whole cents payload" (cents) (Support::projected (Support::body envelope) "cents"), Support::it "pending mutation visible" "true" (Support::model envelope).busy, Support::it "pending notice" "info" (Support::model envelope).noticeTone]

depositCase () =
    fields = Support::fields "2" " $1,234.56 " "  Deposit \"日本語\"\nready  "
    posted = Support::submit (Support::loaded ()) "submit-deposit" fields
    postCase "submit-deposit" "/api/deposit" fields "123456"
    Support::each [Support::it "account number typed" "2" (Support::projected (Support::body posted) "account"), Support::it "Unicode quotes and newline kept" "Deposit \"日本語\"\nready" (Support::projected (Support::body posted) "note"), Support::it "completion id" "mutate-deposit" (Support::projected posted "commands[0].id")]

withdrawCase () =
    fields = Support::fields "1" "9.5" "Withdrawal"
    posted = Support::submit (Support::loaded ()) "submit-withdraw" fields
    postCase "submit-withdraw" "/api/withdraw" fields "950"
    check "withdraw completion id" "mutate-withdraw" (Support::projected posted "commands[0].id")

transferCase () =
    fields = Support::transferFields "1" "2" "25.05"
    posted = Support::submit (Support::loaded ()) "submit-transfer" fields
    postCase "submit-transfer" "/api/transfer" fields "2505"
    Support::each [Support::it "source account" "1" (Support::projected (Support::body posted) "from"), Support::it "destination account" "2" (Support::projected (Support::body posted) "to"), Support::it "transfer completion id" "mutate-transfer" (Support::projected posted "commands[0].id")]

// One rejected form: its submit id, its field values and the notice title it must show.
invalidSubmission entry =
    rejected = Support::submit (Support::loaded ()) entry.label entry.expected
    Support::each [Support::it "validation has no HTTP request" "MISSING" (Support::projected rejected "commands[0].kind"), Support::it "validation does not become busy" "false" (Support::model rejected).busy, Support::it "validation displayed" entry.actual (Support::model rejected).noticeTitle, Support::it "validation error tone" "error" (Support::model rejected).noticeTone]

invalidFormsCase () =
    forEachList [Support::it "submit-deposit" (Support::fields "0" "1" "") "Check the deposit", Support::it "submit-deposit" (Support::fields "1" "0" "") "Check the deposit", Support::it "submit-withdraw" (Support::fields "bad" "1" "") "Check the withdrawal", Support::it "submit-withdraw" (Support::fields "1" "-1" "") "Check the withdrawal", Support::it "submit-transfer" (Support::transferFields "1" "1" "2") "Choose two accounts", Support::it "submit-transfer" (Support::transferFields "1" "0" "2") "Check the transfer", Support::it "submit-transfer" (Support::transferFields "1" "2" "1.234") "Check the transfer", Support::it "submit-open-account" (Json::obj (Json::strField "name" " \t\n ")) "Owner name required"] invalidSubmission

moneyCase () =
    Support::each [Support::it "single fractional digit" "120" (toString (BankData::amountCents "1.2")), Support::it "properly grouped dollars" "123456789" (toString (BankData::amountCents "$1,234,567.89")), Support::it "leading decimal rejected" "0" (toString (BankData::amountCents ".50")), Support::it "exponent rejected" "0" (toString (BankData::amountCents "1e3")), Support::it "bad comma grouping rejected" "0" (toString (BankData::amountCents "1,23.45")), Support::it "extra fraction rejected" "0" (toString (BankData::amountCents "1.234")), Support::it "signed amount rejected" "0" (toString (BankData::amountCents "+1.00")), Support::it "integer overflow rejected" "0" (toString (BankData::amountCents "9223372036854775807.99"))]

openAccountCase () =
    name = "Nora \"N\" Okafor 日本語"
    opened = Support::click (Support::loaded ()) "open-account"
    posted = Support::submit opened "submit-open-account" (Json::obj (Json::strField "name" "  ${name}  "))
    completed = Support::http posted "mutate-open" 201 "{}"
    Support::each [Support::it "account endpoint" "/api/accounts" (Support::projected posted "commands[0].url"), Support::it "trimmed Unicode owner" (name) (Support::projected (Support::body posted) "name"), Support::it "success closes modal" "closed" (Support::model completed).modal, Support::it "success title" "Account opened" (Support::model completed).noticeTitle, Support::it "success rehydrates accounts" "accounts" (Support::projected completed "commands[0].id"), Support::it "success rehydrates journal" "activity" (Support::projected completed "commands[1].id")]

successCase id title =
    completed = Support::http (Support::loaded ()) id 200 "{}"
    Support::each [Support::it "success tone" "success" (Support::model completed).noticeTone, Support::it "correct success title" (title) (Support::model completed).noticeTitle, Support::it "busy clears" "false" (Support::model completed).busy, Support::it "successful mutation refreshes ledger" "/api/accounts" (Support::projected completed "commands[0].url")]

successesCase () =
    successCase "mutate-deposit" "Deposit complete"
    successCase "mutate-withdraw" "Withdrawal complete"
    successCase "mutate-transfer" "Transfer complete"

refusalCase () =
    loaded = Support::loaded ()
    posted = Support::submit loaded "submit-withdraw" (Support::fields "3" "9999.99" "Too much")
    refused = Support::http posted "mutate-withdraw" 400 (Json::error "insufficient funds")
    dismissed = Support::click refused "dismiss-notice"
    Support::each [Support::it "domain refusal title" "Operation refused" (Support::model refused).noticeTitle, Support::it "server detail shown" "insufficient funds" (Support::model refused).noticeBody, Support::it "balances remain until server confirms" (Support::model loaded) .accounts (Support::model refused).accounts, Support::it "refusal stops pending state" "false" (Support::model refused).busy, Support::it "refusal refreshes audit journal" "/api/activity" (Support::projected refused "commands[1].url"), Support::it "notice dismisses" "" (Support::model dismissed).noticeTone]

pendingSubmissionCase () =
    fields = Support::fields "1" "25.00" "One tap"
    pending = Support::submit (Support::loaded ()) "submit-deposit" fields
    repeated = Support::submit pending "submit-deposit" fields
    another = Support::submit pending "submit-transfer" (Support::transferFields "1" "2" "5")
    Support::each [Support::it "repeated tap emits no second request" "MISSING" (Support::projected repeated "commands[0].kind"), Support::it "different movement waits for completion" "MISSING" (Support::projected another "commands[0].kind"), Support::it "pending state preserved" (Support::projected pending "model") (Support::projected repeated "model")]
    ready = Support::http pending "mutate-deposit" 200 "{}"
    next = Support::submit ready "submit-deposit" fields
    check "next operation enabled after completion" "POST" (Support::projected next "commands[0].method")
