// The painting port end to end ([UI-SCENE], [NATIVE-SHM-EVENT]): the canvas, the two buttons and
// the sketch they drive, through the typed host event boundary every host calls, with every
// assertion read from the rows and scenes the surface was handed.
namespace paintingtests

import ui::Hosting
import ui::Lists
import ui::Runtime
import ui::Surfaces
import uitest::Drive
import uitest::Views
import painting::App
import painting::Drawing

(** Keeps the surface the step just produced, so the next step starts from it. *)
effect Bench
    drive : uitest::Driven<painting::Store, painting::Act> => Unit

mut driven = Drive::idle (App::program (), Drawing::initialStore ())

bench work =
    handle Bench
        drive next => driven := next
    ui::Views::quiet (\() => Runtime::guarded work)

step move = bench (\() =>
    next = move driven
    perform Bench.drive next)

// ---- what the host is sent, read back as typed rows and scenes ----
walked () = Surfaces::seen (driven.drivenSurface, driven.drivenProgram)

shapes () = Lists::flatten (mapList ((walked ()).walkSketches, \scene => scene.sketchedAs.sketchShapes))

// The canvas scene's whole drawing: the fixed primitives plus one path per freehand line.
shapeCount () = length (shapes ())

sketch () = driven.drivenSurface.surfaceSession.sessionStore.sketch

lines () = (sketch ()).lines

lineText index = "[${join (mapList (listGet (lines ()) index ?: []) toString) ","}]"

lastShape () = listGet (shapes ()) (satSub (length (shapes ())) 1)

outlineOf shape = match shape
    ui::Path _ outline _ _ _ _ _ => outline
    _ => ui::Fill

// The outline of the last freehand line drawn: a fill when there is none.
stroke () = match lastShape ()
    Success shape => outlineOf shape
    Error _ => ui::Fill

dashText () = match stroke ()
    ui::Line width dashes bevel => "Line ${toString width} bevel=${toString bevel} dashes=${join (mapList dashes toString) ","}"
    ui::Fill => "Fill"

// ---- one typed host event at a time ----
started () = step (\d => Drive::launched (d, "macos", []))

pointer (x, y, down) = step (\d => Drive::pointer (d, x, y, down))

// A pointer with Shift held, as a person drawing a straight line sends it.
shiftPointer (x, y, down) = step (\d => Drive::sent (d, ui::Touch(touchNow = d.drivenNow, touchKind = Hosting::pointer, touchOrdinal = d.drivenSeen.renderedOrdinal, touchWords = "", touchDetail = "", touchX = x, touchY = y, touchDown = down, touchShift = true)))

tap label = step (\d => Drive::press (d, label))

shown label = Views::shows (driven.drivenSeen, label)

// A freehand press at (100, 500).
pressLine () = pointer (100.0, 500.0, true)

// A press at (100, 500) then a second point at (150, 550): one two-point line.
twoPointLine () =
    pressLine ()
    pointer (150.0, 550.0, true)

// A start, one two-point line, and the header tap that names `label`.
tapOnDrawn label =
    started ()
    twoPointLine ()
    tap label

// A Shift-held drag from (100, 500) to (x, y), read back as the line's points.
shiftDrag (x, y) =
    started ()
    shiftPointer (100.0, 500.0, true)
    shiftPointer (x, y, true)
    lineText 0

test ("start draws the five quads and sixteen paths of the original", \() =>
    started ()
    expect (shapeCount (), 21))

test ("a press, two drags and a release draw one three-point line", \() =>
    started ()
    pressLine ()
    pointer (120.0, 510.0, true)
    pointer (140.0, 530.0, true)
    expect (shapeCount (), 22)
    pointer (140.0, 530.0, false)
    expect (length (lines ()), 1)
    expect (lineText 0, "[100.0,500.0,120.0,510.0,140.0,530.0]")
    expect ((sketch ()).painting, false))

test ("a single press draws nothing until the line has two points", \() =>
    started ()
    pointer (10.0, 600.0, true)
    expect (length (lines ()), 1)
    expect (shapeCount (), 21))

test ("Shift keeps the start's y when the drag moved more across than down", \() =>
    expect (shiftDrag (200.0, 520.0), "[100.0,500.0,200.0,500.0]"))

test ("Shift keeps the start's x when the drag moved more down than across", \() =>
    expect (shiftDrag (110.0, 600.0), "[100.0,500.0,100.0,600.0]"))

test ("Dashed restrokes every line four on two off and relabels itself Solid", \() =>
    tapOnDrawn "Dashed"
    expect (dashText (), "Line 1.0 bevel=false dashes=4.0,2.0")
    expect (shown "Solid", true)
    tap "Solid"
    expect (dashText (), "Line 1.0 bevel=false dashes="))

test ("Clear removes every line and keeps the original drawing", \() =>
    tapOnDrawn "Clear"
    expect (length (lines ()), 0)
    expect (shapeCount (), 21))
