// Runtime-driven regressions for the painting port: drawing, Shift straightening, dashes and
// clearing through the resident begin and proceed boundary the app ships ([UI-SCENE],
// [GPUI-HOST-SCENE], [UI-RESIDENT]).
namespace paintingtests

import ui::Doc
import ui::Runtime
import painting::App

(** One driven step of the resident boundary: the session to keep, its envelope and the scene shapes that step streamed outside it ([UI-RESIDENT], [UI-SCENE-STREAM]). *)
type Ran =
    ranSession : ui::Session<painting::Store>
    ranEnvelope : Json
    ranStreamed : int

mut streamed = 0

hosted work =
    handle ui::SceneStream
        shape _ => streamed := satAdd streamed 1
    work ()

kept (before, resident) = Ran(ranSession = resident.residentSession, ranEnvelope = Doc::parse resident.residentEnvelope, ranStreamed = satSub streamed before)

started () =
    before = streamed
    kept (before, hosted (\() => Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\"}", App::initial, App::regions, App::theme ())))

post (ran, event) =
    before = streamed
    kept (before, hosted (\() => Runtime::proceed (ran.ranSession, event, App::update, App::regions)))

latest (key, found, patch) = match Doc::text (patch, "key") == key
    true => Doc::number (patch, "revision")
    false => found

// Each region re-renders when its slice changes, so an event names the region's latest revision.
revision (ran, key, fallback) = foldList (Doc::items (Doc::field (ran.ranEnvelope, "patches")), fallback, \(found, patch) => latest (key, found, patch))

pointer (ran, rev, x, y, down, shift) = post (ran, "{\"kind\":\"ui\",\"region\":\"canvas\",\"revision\":${rev},\"ordinal\":0,\"value\":{\"x\":${x},\"y\":${y},\"down\":${down},\"shift\":${shift}},\"now\":2}")

nextPointer (ran, rev, x, y, down, shift) = pointer (ran, revision (ran, "canvas", rev), x, y, down, shift)

sketch ran = ran.ranSession.sessionStore.sketch

lines ran = (sketch ran).lines

lineText (ran, index) = Doc::write (JsonArray (mapList (listGet (lines ran) index ?: [], \point => JsonFloat point)))

patched (ran, key) = foldList (Doc::items (Doc::field (ran.ranEnvelope, "patches")), JsonNull, \(found, patch) => nodeOf (key, found, patch))

nodeOf (key, found, patch) = match Doc::text (patch, "key") == key
    true => Doc::field (patch, "node")
    false => found

canvasShapes ran = Doc::items (Doc::field (patched (ran, "canvas"), "shapes"))

// The canvas scene's whole drawing: the paths its patch carries plus the rects the stream carried ([UI-SCENE-STREAM]).
shapeCount ran = satAdd (length (canvasShapes ran)) ran.ranStreamed

header ran = patched (ran, "header")

// Ordinals are read from the header as it was last patched (`shown`); the revision is the latest.
tap (ran, shown, label) = post (ran, "{\"kind\":\"ui\",\"region\":\"header\",\"revision\":${revision (shown, "header", 1)},\"ordinal\":${ordinalOf (header shown, label)},\"value\":null,\"now\":2}")

ordinalOf (node, label) = foldList (Doc::items (Doc::field (node, "children")), 0 - 1, \(found, child) => labelled (found, child, label))

labelled (found, child, label) = match Doc::text (child, "label") == label
    true => Doc::number (child, "event")
    false => found

// Strokes and dashes: the second path of a freehand line is its outline array.
strokeOf ran = Doc::write (jsonIndex (listGet (canvasShapes ran) (satSub (length (canvasShapes ran)) 1) ?: JsonNull) 2 ?: JsonNull)

// A freehand press at (100, 500).
pressLine ran = pointer (ran, 1, "100.0", "500.0", "true", "false")

// A press at (100, 500) then a second point at (150, 550): one two-point line.
twoPointLine ran = nextPointer (pressLine ran, 1, "150.0", "550.0", "true", "false")

// A start, one two-point line, and the header tap that names `label`.
tapOnDrawn label =
    first = started ()
    tap (twoPointLine first, first, label)

// A Shift-held drag from (100, 500) to (x, y), read back as the line's points.
shiftDrag (x, y) =
    pressed = pointer (started (), 1, "100.0", "500.0", "true", "true")
    lineText (nextPointer (pressed, 1, x, y, "true", "true"), 0)

test ("start draws the five quads and sixteen paths of the original", \() =>
    first = started ()
    expect (shapeCount first, 21))

test ("a press, two drags and a release draw one three-point line", \() =>
    first = started ()
    pressed = pressLine first
    dragged = nextPointer (nextPointer (pressed, 1, "120.0", "510.0", "true", "false"), 1, "140.0", "530.0", "true", "false")
    released = nextPointer (dragged, 1, "140.0", "530.0", "false", "false")
    expect (length (lines released), 1)
    expect (lineText (released, 0), "[100.0,500.0,120.0,510.0,140.0,530.0]")
    expect ((sketch released).painting, false)
    expect (shapeCount dragged, 22))

test ("a single press draws nothing until the line has two points", \() =>
    pressed = pointer (started (), 1, "10.0", "600.0", "true", "false")
    expect (length (lines pressed), 1)
    expect (shapeCount pressed, 21))

test ("Shift keeps the start's y when the drag moved more across than down", \() =>
    expect (shiftDrag ("200.0", "520.0"), "[100.0,500.0,200.0,500.0]"))

test ("Shift keeps the start's x when the drag moved more down than across", \() =>
    expect (shiftDrag ("110.0", "600.0"), "[100.0,500.0,100.0,600.0]"))

test ("Dashed restrokes every line four on two off and relabels itself Solid", \() =>
    dashed = tapOnDrawn "Dashed"
    expect (strokeOf dashed, "[1,1.0,0,4.0,2.0]")
    expect (ordinalOf (header dashed, "Solid") >= 0, true)
    solid = tap (dashed, dashed, "Solid")
    expect (strokeOf solid, "[1,1.0,0]"))

test ("Clear removes every line and keeps the original drawing", \() =>
    cleared = tapOnDrawn "Clear"
    expect (length (lines cleared), 0)
    expect (shapeCount cleared, 21))
