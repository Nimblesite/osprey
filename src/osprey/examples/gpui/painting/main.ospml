// [UI-RESIDENT] Keep the painting session inside the application. Events and
// render envelopes still use JSON; the saved store no longer crosses the host.
namespace app

import ui::Runtime
import ui::Streams
import painting::App
import painting::Drawing

extern native_slice (key : string) -> string

(** Retain the next application session after the framework completes a step. *)
effect Keep
    keep : ui::Session<painting::Store> => Unit

mut live = Runtime::idle (Drawing::initialStore ())

keeping done =
    perform Keep.keep done.residentSession
    done.residentEnvelope

hosted work =
    handle Keep
        keep session => live := session
    handle ui::Slices
        fetch key => native_slice key
    keeping (Streams::shared work)

start source = hosted (\() => Runtime::begin (source, App::initial, App::regions, App::theme ()))

dispatch (_saved : string, event) = hosted (\() => Runtime::proceed (live, event, App::update, App::regions))
