// Flock's C boundary for the GPUI host ([GPUI-HOST-BOUNDARY], [UI-SCENE], [UI-RESIDENT]). The
// session lives in this library between calls, so a frame never serializes the flock.

import ui::Runtime
import flock::App
import flock::Simulation
import ui::Streams

extern native_slice (key : string) -> string

(** Hands the session the framework returned to the cell below. *)
effect Keep
    keep : ui::Session<flock::Store> => Unit

mut live = Runtime::idle (Simulation::sizedStore 1)

keeping (done : ui::Resident<flock::Store>) =
    perform Keep.keep done.residentSession
    done.residentEnvelope

hosted work =
    handle Keep
        keep session => live := session
    handle ui::Slices
        fetch key => native_slice key
    keeping (Streams::shared work)

start source = hosted (\() => Runtime::begin (source, App::initial, App::regions, App::theme ()))

dispatch (_saved : string, event) = hosted (\() => Runtime::proceed (live, event, App::update, App::regions))
