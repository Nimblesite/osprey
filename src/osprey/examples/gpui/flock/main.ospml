namespace app

import ui::Runtime
import ui::Views
import flock::App
import flock::Simulation

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<flock::Store, flock::Act> => Unit

initial () = Simulation::sizedStore 1
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
