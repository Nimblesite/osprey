// Symbolic-input harness for `osprey hunt`: stdin chooses one typed host input and drives Flock's
// real open and event boundary with it ([NATIVE-SHM-BOUNDARY], [NATIVE-SHM-EVENT],
// [GPUI-HOST-SCENE]). The input names the canvas row the first frame drew, never a position some
// other frame happened to have.
namespace flockhunt

import ui::Runtime
import ui::Views
import ui::Surfaces
import ui::Hosting
import flock::App
import flock::Simulation

// The first byte picks the input; the rest is a number scaled to reach far outside the 320 by 200 field.
kindOf line = substring line 0 1 ?: ""

amount line = parseInt (substring line 1 (length line) ?: "0") ?: 0

spread line = toFloat (amount line) * 97.0 - 5000.0

keyName line = match amount line
    0 => "left"
    1 => "right"
    2 => "up"
    3 => "down"
    4 => "p"
    5 => "escape"
    _ => "space"

pointing (ordinal, x, y, down) = ui::Touch(touchNow = 2, touchKind = Hosting::pointer, touchOrdinal = ordinal, touchWords = "", touchDetail = "", touchX = x, touchY = y, touchDown = down, touchShift = false)

pressing (ordinal, name) = ui::Touch(touchNow = 2, touchKind = Hosting::key, touchOrdinal = ordinal, touchWords = name, touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = true, touchShift = false)

timed elapsed = ui::Touch(touchNow = 3, touchKind = Hosting::frame, touchOrdinal = 0, touchWords = "", touchDetail = "", touchX = elapsed, touchY = 0.0, touchDown = false, touchShift = false)

// The input the line names, over the scene the canvas row `ordinal` carries ([NATIVE-SHM-VIEW]).
touchOf (line, ordinal) = match kindOf line
    "p" => pointing (ordinal, spread line, spread line * 0.5, true)
    "r" => pointing (ordinal, spread line, spread line, false)
    "k" => pressing (ordinal, keyName line)
    _ => timed (toFloat (amount line) * 0.01)

// The binding the first scene's canvas delivers: the number a host names that scene by.
sceneAt walk = match listGet walk.walkSketches 0
    Success first => (listGet walk.walkRows first.sketchedRow ?: Views::blank).placedAction
    Error _ => Views::none

small () = flock::Store(world = flock::World(birds = [flock::Bird(birdX = 40.0, birdY = 40.0, birdVx = 0.5, birdVy = 0.1), flock::Bird(birdX = 45.0, birdY = 42.0, birdVx = 0.4, birdVy = 0.2)], hawks = [flock::Hawk(hawkX = 60.0, hawkY = 40.0)], player = flock::Player(playerX = 160.0, playerY = 100.0), held = flock::Held(heldLeft = false, heldRight = false, heldUp = false, heldDown = false), targetX = 0.0, targetY = 0.0, targetActive = false, roundNumber = 1, scoreValue = 0, elapsedTotal = 0.0, frameCount = 0, fps = 0), settings = flock::Settings(flockSize = 2, soundOn = true, paused = false), scores = flock::Scores(best = [], loaded = false))

// A frame is walked but not written: the harness reads the rows a host would be sent, so it needs
// no host runtime ([NATIVE-SHM-VIEW]).
hosted work =
    handle ui::Slices
        fetch _ => "[]"
    ui::Views::quiet (\() => Runtime::guarded work)

main () =
    line = input ()
    opened = hosted (\() => Hosting::opened (Surfaces::idle (Simulation::sizedStore 1), App::program (), 1, 0, "macos", "", false))
    session = opened.surfaceSession
    placed = opened(surfaceSession = session(sessionStore = small ()))
    ordinal = sceneAt (Surfaces::seen (placed, App::program ()))
    after = hosted (\() => Hosting::event (placed, App::program (), touchOf (line, ordinal)))
    framedOn = hosted (\() => Hosting::event (after, App::program (), timed 0.016))
    print "dispatched ${length (Surfaces::seen (framedOn, App::program ())).walkRows}"
    0
