// Talon Bank driven through the typed host event boundary every host calls ([NATIVE-SHM-EVENT],
// [NATIVE-SHM-BOUNDARY]), with no server and no window. The host the tests stand in for holds
// each ledger reply in the slice its ticket names and completes the request with its status,
// so the same app the browser, SwiftUI and Android hosts run is checked on every platform.
namespace talontests

import ui::Lists
import ui::Requests
import ui::Runtime
import talon::Amounts
import talon::App
import talon::Update
import uitest::Drive
import uitest::Views

confirmTransfer = "Confirm transfer"
operationRefused = "Operation refused"
vintageSynthesizer = "vintage synthesizer"
noMatchingActivity = "No matching activity"
openAccount = "Open account"
accountOwner = "Account owner"
createAccount = "Create account"
confirmDeposit = "Confirm deposit"

accountsReply () = "[{\"id\":1,\"owner\":\"Amelia Chen\",\"cents\":246240,\"balance\":\"$2,462.40\"},{\"id\":2,\"owner\":\"Marcus Webb\",\"cents\":191785,\"balance\":\"$1,917.85\"},{\"id\":3,\"owner\":\"Priya Sharma\",\"cents\":360000,\"balance\":\"$3,600.00\"}]"

activityReply () = "[{\"id\":3,\"account\":2,\"kind\":\"refused\",\"cents\":999900,\"note\":\"vintage synthesizer\",\"owner\":\"Marcus Webb\"},{\"id\":2,\"account\":1,\"kind\":\"debit\",\"cents\":185000,\"note\":\"rent — 12 Fern St\",\"owner\":\"Amelia Chen\"},{\"id\":1,\"account\":1,\"kind\":\"credit\",\"cents\":425000,\"note\":\"March salary\",\"owner\":\"Amelia Chen\"}]"

// The surface the tests drive, and the replies the host holds by ticket.
mut driven = Drive::idle (App::program (), Update::launched "")
mut replies = [Held(heldTicket = "", heldText = "")]

(** One reply the host holds under its ticket. *)
type Held =
    heldTicket : string
    heldText : string

effect Host
    drive : uitest::Driven<talon::Bank, talon::BankAct> => Unit
    hold : Held => Unit

bench work =
    handle Host
        drive next => driven := next
        hold held => replies := listPrepend replies held
    Runtime::guarded work

// The newest reply held under `ticket`, or nothing.
heldUnder ticket = match Lists::find (replies, \held => held.heldTicket == ticket)
    Success held => held.heldText
    Error _ => ""

hosted work =
    handle ui::Slices
        fetch key => heldUnder key
    bench work

launchWith arguments = hosted (\() => perform Host.drive (Drive::launched (Drive::idle (App::program (), Update::launched ""), "web", arguments)))

press label = hosted (\() => perform Host.drive (Drive::press (driven, label)))

typed (label, words) = hosted (\() => perform Host.drive (Drive::choose (driven, label, words)))

// The one control of `kind`, such as the tabs or the account rows, given `words`.
picked (kind, words) =
    found = Lists::find (driven.drivenSeen.renderedControls, \c => c.controlKind == kind)
    match found
        Success c => hosted (\() => perform Host.drive (Drive::sent (driven, ui::Touch(touchNow = driven.drivenNow, touchKind = ui::Hosting::control, touchOrdinal = c.controlOrdinal, touchWords = words, touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = false, touchShift = false))))
        Error _ => expect ("no ${kind} control", "")

// The request `ticket` completed with HTTP `status`, its body held under the ticket.
reply (ticket, status, body) =
    perform Host.hold (Held(heldTicket = ticket, heldText = body))
    hosted (\() => perform Host.drive (Drive::completed (driven, ticket, true, "{\"status\":${status},\"headers\":[]}")))

refusedBy (ticket, why) = hosted (\() => perform Host.drive (Drive::completed (driven, ticket, false, why)))

loaded () =
    launchWith []
    reply ("accounts", 200, accountsReply ())
    reply ("activity", 200, activityReply ())

store () = Drive::holding driven

shows label = expect (Drive::shows (driven, label), true)

wordsIn words = expect (contains (Views::texts driven.drivenSeen) words, true)

// The requests the last step sent, as `METHOD url body`, in order.
described request = match request.capability
    ui::Http method url _ body _ _ slice => "${method} ${url} ${body} ${slice}"
    _ => Requests::kind request.capability

asked () = join (mapList (driven.drivenSurface.surfaceAsked, described)) ";"

askedNothing () = expect (asked (), "")

// Every label in `labels` must be rendered on screen.
showsAll (labels) = forEachList (labels, \label => shows label)

// The movement notes currently shown, comma-joined, must be exactly `expected`.
showsNotes (expected) = expect (join (mapList (talon::Forms::shown (store ()), \line => line.movementNote)) ",", expected)

// A deposit of `amount` with `note` sent once from the move form, asking for `expectedAsk`.
depositSent (amount, note, expectedAsk) =
    typed ("Amount", amount)
    typed ("Description", note)
    press confirmDeposit
    expect (asked (), expectedAsk)

// A tap on the deposit confirm button that must ask for nothing.
depositAskedNothing () =
    press confirmDeposit
    askedNothing ()

// The transfer form from `from` to `to` for `amount`, confirmed before anything may be asked.
transferAskedNothing (from, to, amount) =
    typed ("From account", from)
    typed ("To account", to)
    typed ("Amount", amount)
    press confirmTransfer
    askedNothing ()

// The withdrawal form taken from `from` for `amount`, confirmed.
withdrawalForm (from, amount) =
    typed ("Withdraw from", from)
    typed ("Amount", amount)
    press "Confirm withdrawal"

// The ledger answered the pending movement under `ticket`, and its notice shows `label`.
answeredNotice (ticket, status, body, label) =
    reply (ticket, status, body)
    shows label

// The listings loaded, then the tab `label` pressed.
openPage (label) =
    loaded ()
    press label

// The control `label` pressed, and the store then shows page `page`.
pressPage (label, page) =
    press label
    expect ((store ()).bankPage, page)

// The keys the picker `label` offers, comma-joined.
// The choices of the picker labelled `label`; its heading above it shares the words.
choices (label, expected) = match Lists::find (Views::labelled (driven.drivenSeen, label), \c => c.controlKind == "picker")
    Success c => expect (join c.controlChoices ",", expected)
    Error _ => expect ("no picker labelled ${label}", expected)

// Both listings answered again, as every mutation's reply asks for them.
reloaded () =
    expect ((store ()).bankLoads, 2)
    reply ("accounts", 200, accountsReply ())
    reply ("activity", 200, activityReply ())
    expect ((store ()).bankLoads, 0)

// A one-dollar withdrawal the ledger answers with HTTP `code` and `body`, then its notice dismissed.
refusedWith (code, body, detail) =
    press "Withdraw"
    withdrawalForm ("1", "1")
    answeredNotice ("withdraw", code, body, operationRefused)
    expect ((store ()).bankNotice.noticeTone, "danger")
    expect ((store ()).bankNotice.noticeDetail, detail)
    expect ((store ()).bankBusy, false)
    reloaded ()
    press "Dismiss"

// A movement in `mode` the ledger accepts, showing `heading`.
movedWith (mode, confirm, ticket, heading) =
    press mode
    typed ("Amount", "9.5")
    typed ("To account", "3")
    press confirm
    answeredNotice (ticket, 200, "{}", heading)
    expect ((store ()).bankNotice.noticeTone, "good")
    reloaded ()

test ("typed amounts read as whole cents, and anything else as zero", \() =>
    forEachList ([{ text = "$1,980.25", cents = 198025 }, { text = "1980.25", cents = 198025 }, { text = "  7.07 ", cents = 707 }, { text = "12", cents = 1200 }, { text = "0.5", cents = 50 }, { text = "1,000", cents = 100000 }, { text = "1,000,000.01", cents = 100000001 }], \row => expect (Amounts::cents row.text, row.cents))
    forEachList ([{ text = "1,2", cents = 0 }, { text = "12,34", cents = 0 }, { text = "-5", cents = 0 }, { text = "+5", cents = 0 }, { text = "1.234", cents = 0 }, { text = "1.", cents = 0 }, { text = "abc", cents = 0 }, { text = "9223372036854775807.50", cents = 0 }, { text = "92233720368547758.08", cents = 0 }, { text = "92233720368547758.07", cents = 9223372036854775807 }, { text = "99999999999999999999", cents = 0 }, { text = "", cents = 0 }], \row => expect (Amounts::cents row.text, row.cents)))
test ("a launch asks for both listings from the demo server and shows progress", \() => bench (\() =>
    launchWith []
    expect (asked (), "GET http://127.0.0.1:18790/api/accounts  accounts;GET http://127.0.0.1:18790/api/activity  activity")
    expect ((store ()).bankLoads, 2)
    showsAll (["Contacting the ledger", "Overview"])
    expect (driven.drivenSurface.surfaceProblem, "")))
test ("the first launch argument names the server", \() => bench (\() =>
    launchWith ["https://bank.example"]
    expect (asked (), "GET https://bank.example/api/accounts  accounts;GET https://bank.example/api/activity  activity")))
test ("both listings fill the overview with the total, the accounts and the journal", \() => bench (\() =>
    loaded ()
    expect ((store ()).bankLoads, 0)
    expect (length (store ()).bankAccounts, 3)
    expect (length (store ()).bankJournal, 3)
    showsAll (["$7,980.25", "Across 3 protected client accounts", vintageSynthesizer, "−$1,850.00", "+$4,250.00", "$9,999.00"])
    wordsIn "Marcus Webb · Account #2"
    expect (Drive::shows (driven, "Contacting the ledger"), false)))
test ("a failed listing says the bank data is unavailable", \() => bench (\() =>
    launchWith []
    reply ("accounts", 500, "")
    shows "Bank data unavailable"
    expect ((store ()).bankLoads, 1)
    refusedBy ("activity", "offline")
    expect ((store ()).bankLoads, 0)
    press "Refresh"
    expect ((store ()).bankLoads, 2)))
test ("the pages move between the five pages and refuse an unknown one", \() => bench (\() =>
    loaded ()
    pressPage ("Activity", "activity")
    pressPage ("Security", "security")
    shows "Storage isolation"
    expect ((Update::tapped (store (), talon::SeePage(seenPage = "vault"))).stepStore.bankPage, "security")
    pressPage ("Overview", "overview")
    pressPage ("Full history", "activity")))
test ("choosing an account opens it in detail and every form starts from it", \() => bench (\() =>
    loaded ()
    picked ("rows", "3")
    expect ((store ()).bankPage, "accounts")
    expect ((store ()).bankChosen, "3")
    expect ((store ()).bankDraft.draftAccount, "3")
    expect ((store ()).bankDraft.draftFrom, "3")
    showsAll (["$3,600.00", "Ready to move"])))
test ("activity filters by kind and searches notes and owners", \() => bench (\() =>
    openPage ("Activity")
    showsAll (["All 3", "In 1", "Out 1", "Declined 1"])
    expect (talon::Parts::counted ((store ()).bankJournal, "refused"), 1)
    press "Declined 1"
    expect ((store ()).bankFilter, "refused")
    showsNotes vintageSynthesizer
    press "Out 1"
    showsNotes "rent — 12 Fern St"
    press "All 3"
    expect ((store ()).bankFilter, "all")
    typed ("Search", "  AMELIA ")
    expect (length (talon::Forms::shown (store ())), 2)
    typed ("Search", "nobody")
    shows noMatchingActivity))
test ("a deposit is validated before anything is sent, then sent once", \() => bench (\() =>
    openPage ("Deposit")
    expect ((store ()).bankMode, "deposit")
    expect ((store ()).bankPage, "move")
    choices ("Deposit to", "1,2,3")
    typed ("Amount", "-4")
    depositAskedNothing ()
    shows "Check the amount"
    press "Dismiss"
    expect ((store ()).bankNotice.noticeHeading, "")
    depositSent ("$1,250.50", " bonus ", "POST http://127.0.0.1:18790/api/deposit {\"account\":1,\"cents\":125050,\"note\":\"bonus\"} deposit")
    expect ((store ()).bankBusy, true)
    depositAskedNothing ()
    reply ("deposit", 200, "{}")
    expect ((store ()).bankBusy, false)
    shows "Deposit complete"
    expect ((store ()).bankLoads, 2)))
test ("a refused withdrawal reports the ledger's reason and reloads the journal", \() => bench (\() =>
    loaded ()
    pressPage ("Withdraw", "move")
    expect ((store ()).bankMode, "withdraw")
    withdrawalForm ("2", "99999")
    expect (asked (), "POST http://127.0.0.1:18790/api/withdraw {\"account\":2,\"cents\":9999900,\"note\":\"\"} withdraw")
    answeredNotice ("withdraw", 422, "{\"error\":\"insufficient funds\"}", operationRefused)
    expect ((store ()).bankNotice.noticeDetail, "insufficient funds")
    expect ((store ()).bankLoads, 2)))
test ("a transfer needs two different accounts and a positive amount", \() => bench (\() =>
    openPage ("Move")
    press "Transfer"
    expect ((store ()).bankMode, "transfer")
    transferAskedNothing ("2", "2", "10")
    shows "Choose two accounts"
    typed ("To account", "3")
    typed ("Amount", "0")
    press confirmTransfer
    shows "Check the transfer"
    typed ("Amount", "62.4")
    press confirmTransfer
    expect (asked (), "POST http://127.0.0.1:18790/api/transfer {\"from\":2,\"to\":3,\"cents\":6240,\"note\":\"\"} transfer")
    answeredNotice ("transfer", 0, "", operationRefused)
    expect ((store ()).bankNotice.noticeDetail, "The app could not reach the ledger. Check your connection and try again.")))
test ("the new-account dialog needs an owner, then opens the account and closes", \() => bench (\() =>
    loaded ()
    press openAccount
    expect ((store ()).bankOpening, true)
    shows accountOwner
    press createAccount
    shows "Owner name required"
    askedNothing ()
    typed (accountOwner, "Ada Lovelace")
    press createAccount
    expect (asked (), "POST http://127.0.0.1:18790/api/accounts {\"name\":\"Ada Lovelace\"} open")
    reply ("open", 201, "{}")
    expect ((store ()).bankOpening, false)
    shows "Account opened"
    press openAccount
    press "Cancel"
    expect ((store ()).bankOpening, false)))
test ("a pending movement is sent once, and another movement waits for its reply", \() => bench (\() =>
    openPage ("Deposit")
    depositSent ("25.00", "One tap", "POST http://127.0.0.1:18790/api/deposit {\"account\":1,\"cents\":2500,\"note\":\"One tap\"} deposit")
    depositAskedNothing ()
    press "Transfer"
    transferAskedNothing ("1", "2", "5")
    expect ((store ()).bankBusy, true)
    reply ("deposit", 200, "{}")
    expect ((store ()).bankBusy, false)
    press confirmTransfer
    expect (asked (), "POST http://127.0.0.1:18790/api/transfer {\"from\":1,\"to\":2,\"cents\":500,\"note\":\"One tap\"} transfer")))
test ("every refused or unreachable reply becomes a notice that names its cause", \() => bench (\() =>
    loaded ()
    refusedWith (503, "", "The ledger failed with HTTP 503. Try again shortly.")
    refusedWith (403, "", "The ledger refused the request with HTTP 403.")
    refusedWith (0, "", "The app could not reach the ledger. Check your connection and try again.")
    refusedWith (400, "{\"error\":\"Connection timed out\"}", "Connection timed out")
    expect ((store ()).bankNotice.noticeHeading, "")))
test ("every successful movement shows its own notice and reloads both listings", \() => bench (\() =>
    loaded ()
    movedWith ("Withdraw", "Confirm withdrawal", "withdraw", "Withdrawal complete")
    movedWith ("Deposit", confirmDeposit, "deposit", "Deposit complete")
    movedWith ("Transfer", confirmTransfer, "transfer", "Transfer complete")))
test ("notes and owners keep quotes, newlines and Unicode, trimmed and escaped", \() => bench (\() =>
    openPage ("Deposit")
    typed ("Deposit to", "2")
    depositSent (" $1,234.56 ", "  Deposit \"日本語\"\nready  ", "POST http://127.0.0.1:18790/api/deposit {\"account\":2,\"cents\":123456,\"note\":\"Deposit \\\"日本語\\\"\\nready\"} deposit")
    reply ("deposit", 200, "{}")
    press openAccount
    typed (accountOwner, "  Nora \"N\" Okafor 日本語  ")
    press createAccount
    expect (asked (), "POST http://127.0.0.1:18790/api/accounts {\"name\":\"Nora \\\"N\\\" Okafor 日本語\"} open")))
test ("filter and search intersect while the journal's totals stay complete", \() => bench (\() =>
    loaded ()
    press "Activity"
    press "In 1"
    typed ("Search", "Marcus")
    shows noMatchingActivity
    shows "All 3"
    shows "Declined 1"
    typed ("Search", "salary")
    expect (join (mapList (talon::Forms::shown (store ()), \line => line.movementNote)) ",", "March salary")
    press "Declined 1"
    shows noMatchingActivity
    typed ("Search", "")
    expect (join (mapList (talon::Forms::shown (store ()), \line => line.movementNote)) ",", vintageSynthesizer)))
test ("an empty ledger draws usable empty states", \() => bench (\() =>
    launchWith []
    reply ("accounts", 200, "[]")
    reply ("activity", 200, "[]")
    expect ((store ()).bankLoads, 0)
    shows "$0.00"
    press "Accounts"
    shows "No accounts yet"
    press "Activity"
    shows "All 0"
    shows noMatchingActivity))
