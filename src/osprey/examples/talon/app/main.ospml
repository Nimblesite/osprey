namespace app

import ui::Runtime
import ui::Views
import talon::App
import talon::Update

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<talon::Bank, talon::BankAct> => Unit

initial () = Update::launched ""
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
