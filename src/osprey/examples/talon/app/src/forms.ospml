// Implements [UI-COMPONENTS] for Talon Bank's forms: moving money, searching the journal and
// opening an account. Every field reports each edit to the store, so validation in `Update`
// sees exactly what the person typed; every surface is a talon::Look frame.
namespace talon

import ui::Ui
import ui::Symbols

(** Move money, Activity and the new-account dialog. *)
module Forms
    mode (store, key, label) = Look::segment (label, store.bankMode == key, QuickMove(quickMode = key))

    modes store = Look::segments [mode (store, "deposit", "Deposit"), mode (store, "withdraw", "Withdraw"), mode (store, "transfer", "Transfer")]

    amount draft = Look::field (Ui::field ("Amount", draft.draftAmount, "0.00", EditAmount))

    note draft = Look::field (Ui::field ("Description", draft.draftNote, "What is this for?", EditNote))

    // The fields of the chosen mode: one account for a deposit or withdrawal, two for a transfer.
    accounts store =
        draft = store.bankDraft
        held = store.bankAccounts
        match store.bankMode
            "deposit" => [Parts::picker ("Deposit to", held, draft.draftAccount, PickAccount)]
            "withdraw" => [Parts::picker ("Withdraw from", held, draft.draftAccount, PickAccount)]
            _ => [Parts::picker ("From account", held, draft.draftFrom, PickFrom), Parts::picker ("To account", held, draft.draftTo, PickTo)]

    heading mode = match mode
        "deposit" => "Deposit funds"
        "withdraw" => "Withdraw funds"
        _ => "Transfer money"

    lead mode = match mode
        "deposit" => "Credit an account instantly and journal the movement."
        "withdraw" => "Debit securely. Overdraft attempts are refused and audited."
        _ => "Move funds atomically between Talon accounts."

    verb mode = match mode
        "deposit" => "Confirm deposit"
        "withdraw" => "Confirm withdrawal"
        _ => "Confirm transfer"

    form store =
        mode = store.bankMode
        head = Ui::spaced (4, [Look::heading (heading mode, 22), Look::words (lead mode, 14, "ink500")])
        Look::card (Ui::spaced (16, listConcat (listConcat [head] (accounts store)) [amount store.bankDraft, note store.bankDraft, Look::primary (verb mode, Symbols::name ui::Send, store.bankBusy == false, SubmitMove)]))

    tip (heading, detail) = Ui::spacedRow (12, [Look::chip (Symbols::name ui::Check, "ink700", "mint", 32), Ui::share (Ui::spaced (2, [Look::strong (heading, 14, "white"), Look::words (detail, 13, "ink300")]))])

    guidance () = Look::dark (Ui::spaced (16, [Look::eyebrow ("Every movement is protected", "coral"), tip ("Atomic transfers", "Both sides land together, or not at all."), tip ("Complete journal", "Successful and refused attempts are recorded."), tip ("Integer precision", "Money stays in whole cents from form to ledger.")]))

    (** Deposit, withdraw or transfer, guarded by the same rules on every platform. *)
    export move store = Ui::spaced (24, [modes store, form store, guidance ()])

    kept (line, filter) = match filter
        "in" => line.movementKind == "credit"
        "out" => line.movementKind == "debit"
        "refused" => line.movementKind == "refused"
        _ => true

    found (line, query) = query == "" || contains (toLowerCase "${line.movementNote} ${line.movementOwner}") query

    (** The journal lines the filter and search keep. *)
    export shown store =
        query = toLowerCase (trim store.bankSearch)
        filterList (store.bankJournal, \line => kept (line, store.bankFilter) && found (line, query))

    kind (store, key, label) = Look::segment (label, store.bankFilter == key, ShowKind(shownKind = key))

    filters store =
        journal = store.bankJournal
        Look::segments [kind (store, "all", "All ${length journal}"), kind (store, "in", "In ${Parts::counted (journal, "credit")}"), kind (store, "out", "Out ${Parts::counted (journal, "debit")}"), kind (store, "refused", "Declined ${Parts::counted (journal, "refused")}")]

    (** Every credit, debit and refusal, searchable and filtered by kind. *)
    export activity store = Ui::spaced (16, [Look::field (Ui::field ("Search", store.bankSearch, "Search description or owner", EditSearch)), filters store, Parts::journal (shown store, 100, Symbols::name ui::Search, "No matching activity", "Try another search or broaden the filter.")])

    (** The new-account dialog. *)
    export opening store = Ui::dialog ("Open account", Ui::column [Ui::spaced (16, [Look::heading ("Open account", 22), Look::words ("Create a protected client account in one step. Storage stays on the server.", 14, "ink500"), Look::field (Ui::field ("Account owner", store.bankDraft.draftOwner, "Full legal name", EditOwner)), Ui::spacedRow (10, [Look::secondary ("Cancel", Symbols::name ui::Dismiss, CloseDialog), Look::primary ("Create account", Symbols::name ui::Add, store.bankBusy == false, SubmitOpen)])])], CloseDialog)
