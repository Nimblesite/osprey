// Select storage, audit and request-counting policies at the application root.
// [MODULES-EXPORTS] [MODULES-STATE-MODULE] [EFFECTS-HANDLER-VALUE]

namespace bank

// One deterministic tour of the whole stack, driven over REAL HTTP by the
// in-process client: JSON mutations, a refused overdraft, the JSON listing,
// and the 404 a non-API path gets: the web client is served on its own, never by this server.
fetch client path =
    reply = httpGetResponse client path ""
    match reply
        Success value =>
            body = match httpResponseBody value
                Success text => text
                Error _ => "(no body)"
            _freed = httpResponseFree value ?: 0
            body
        Error _ => "GET ${path} failed"

// The two routes the tour drives most.
accountsPath = "/api/accounts"
depositPath = "/api/deposit"

drive client =
    amelia = httpPost client accountsPath "{\"name\":\"Amelia Chen\"}" "" ?: -1
    marcus = httpPost client accountsPath "{\"name\":\"Marcus Webb\"}" "" ?: -1
    priya = httpPost client accountsPath "{\"name\":\"Priya Sharma\"}" "" ?: -1
    salary = httpPost client depositPath "{\"account\":1,\"cents\":425000,\"note\":\"March salary — Nimble Robotics\"}" "" ?: -1
    invoice = httpPost client depositPath "{\"account\":2,\"cents\":198025,\"note\":\"freelance invoice #4021\"}" "" ?: -1
    grant = httpPost client depositPath "{\"account\":3,\"cents\":360000,\"note\":\"research grant Q1\"}" "" ?: -1
    rent = httpPost client "/api/withdraw" "{\"account\":1,\"cents\":185000,\"note\":\"rent — 12 Fern St\"}" "" ?: -1
    dinner = httpPost client "/api/transfer" "{\"from\":2,\"to\":1,\"cents\":6240,\"note\":\"dinner split\"}" "" ?: -1
    synth = httpPost client "/api/withdraw" "{\"account\":2,\"cents\":999900,\"note\":\"vintage synthesizer\"}" "" ?: -1
    print "[http] open=${amelia}/${marcus}/${priya} deposit=${salary}/${invoice}/${grant} rent=${rent} transfer=${dinner} overdraft=${synth}\n--- GET ${accountsPath} ---\n${fetch client accountsPath}\n--- GET /api/activity ---\n${fetch client "/api/activity"}\n--- GET / (API only) ---\n${fetch client "/"}"

// Playwright hold: while the configured marker exists the server keeps serving.
// The defaults preserve the standalone demo; each browser run gets isolated paths.
holdPath () = env "TALON_HOLD" ?: "/tmp/talon_bank.hold"
apiPort () = parseInt (env "TALON_API_PORT" ?: "18790")
databasePath () = env "TALON_DB" ?: "/tmp/talon_bank.db"

hold () =
    marker = readFile (holdPath ())
    match marker
        Error _ => 0
        Success _ =>
            _slept = sleep 250
            hold ()

// The TUI closing shot: render every account as a table row through the same
// pure domain renderer the API uses, stepping ids with the total `satAdd`.
table : int -> int -> Unit ! Ledger::Store
table id count = match id > count
    true => print "└────┴──────────────┴───────────┘"
    false =>
        account = Account(id = id, owner = perform Ledger::Store.owner id, balance = perform Ledger::Store.balance id)
        print (Accounts::row account)
        next = satAdd id 1
        table next count

// `Api::Audit` is in the row because `handleRequest` is registered here: every
// request the in-process client drives is audited while `serve` is still on
// the stack, so the audit capability is part of serving, not of booting.
serveListening db port server =
    client = httpCreateClient "http://127.0.0.1:${port}" 5000 ?: -1
    print "[boot] api + web listening on http://127.0.0.1:${port}"
    drive client
    print "┌────┬──────────────┬───────────┐"
    table 1 (perform Ledger::Store.count ())
    _held = hold ()
    _stopped = httpStopServer server ?: -1
    _closed = Sqlite::shutdown db
    perform Metrics::MetricsFx.total ()

listenFailed db server message =
    _stopped = httpStopServer server ?: -1
    _closed = Sqlite::shutdown db
    _report = print "Talon server could not listen: ${message}"
    1

serve : Ptr -> int -> int ! [Ledger::Store, Metrics::MetricsFx, Api::Audit]
serve db port = match httpCreateServer port "127.0.0.1"
    Error message =>
        _closed = Sqlite::shutdown db
        _report = print "Talon server could not bind: ${message}"
        1
    Success server => match httpListen server handleRequest
        Error message => listenFailed db server message
        Success _ => serveListening db port server

// SQLite and audit handlers compose around the same serving callback.
boot : int -> int ! Metrics::MetricsFx
boot port =
    database = databasePath ()
    db = Sqlite::openAt database
    _made = Ledger::schema db
    print "[boot] fresh ledger at ${database}"
    storage = Ledger::sqlite db
    consoleAudit = handler Api::Audit
        log line => print "[audit] ${line}"
    consoleAudit (\() => storage (\() => serve db port))

// The router: every request is counted by the state module, then answered by the JSON API.
handleRequest (method, path, _headers, body) =
    _seen = perform Metrics::MetricsFx.hit path
    Api::route method path body

main () =
    print "=== Talon Bank — one Osprey app, every module feature ==="
    match apiPort ()
        Error message =>
            _reported = print "Invalid TALON_API_PORT: ${message}"
            1
        Success port =>
            served = Metrics::track (\() => boot port)
            print "[metrics] ${served} requests served — goodbye"
            0
