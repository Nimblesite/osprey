// web/pages — the browser host for Talon Bank. [MODULES-NAMESPACE] [MODULES-IMPORT] [NATIVE-HOSTS-FAMILY]
//
// The browser runs the same Osprey Native application as Android and iOS, compiled to
// WebAssembly and drawn by Osprey's web host. `Bundle` is generated by
// `src/toolchain/hosts/web/scripts/build.mjs` and holds the page, its script (the host with the
// application inlined) and its stylesheet as text.
//
// This module deliberately imports no bank module. It serves the compiled application but cannot
// resolve Ledger, Sqlite, or Store; browser data crosses the same `/api/*` boundary as every
// other client.

namespace "bank/web"

(** The web client's static files and a 404. *)
module Pages
    response status contentType body =
        headers = "Content-Type: ${contentType}\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n"
        HttpResponse(status = status, headers = headers, contentType = contentType, streamFd = -1, isComplete = true, partialBody = body)

    notFound () = response 404 "text/html; charset=utf-8" "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Not found · Talon Bank</title></head><body><main><h1>That route has flown the coop.</h1><p><a href=\"/\">Return to Talon Bank</a></p></main></body></html>"

    (** The HTTP response for a browser `path`: the page, its script, its stylesheet or a 404 page. *)
    export render path = match path
        "/" => response 200 "text/html; charset=utf-8" (Bundle::page ())
        "/host.js" => response 200 "application/javascript; charset=utf-8" (Bundle::script ())
        "/host.css" => response 200 "text/css; charset=utf-8" (Bundle::style ())
        _ => notFound ()
