// Manual browser echo-server demo [BUILTIN-WEBSOCKET].

let serverId = websocketCreateServer(54321, "127.0.0.1", "/chat")
print("server=${serverId}")

let listenStatus = websocketServerListen(serverId)
print("listen=${listenStatus}")

let broadcastCount = websocketServerBroadcast(serverId, "server ready")
print("initial broadcast recipients=${broadcastCount}")
print("listening on ws://127.0.0.1:54321/chat; Ctrl-C stops the server")

websocketKeepAlive()
