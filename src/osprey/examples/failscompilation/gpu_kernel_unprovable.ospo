// [GPU-KERNEL-PURE] fails closed: a kernel received as a bare function
// parameter has unknown effects at the combinator call site, so the checker
// rejects it rather than assume purity.
effect Noise {
    blip: fn() -> Unit
}

fn runIt(f) = match toGpu([1]) {
    Success { value } => gpuMap(value, f)
    Error { message } => Error { message: message }
}

fn main() = runIt(|x| => x)
