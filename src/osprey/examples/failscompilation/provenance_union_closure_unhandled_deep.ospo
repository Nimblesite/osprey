// [EFFECTS-PROVENANCE] A closure stored in a recursive union keeps its effect
// provenance even when the aggregate nests past the widening budget: the
// effectful closure stored forty `Stack` levels deep and invoked at program
// entry with no handler must still fail closed, never be treated as pure
// (#275).
effect Log { write: fn(string) -> string }

type Node<A> = Stack { children: List<Node<A>> } | Field { value: string, edit: (string) -> A }
type Binding<A> = Edit { apply: (string) -> A }

fn collect<A>(found, node) = match node {
    Stack { children } => range(0, length(children)) |> fold(found, fn(acc, index) => match listGet(children, index) {
        Success { value } => collect(acc, value)
        Error(_) => acc
    })
    Field { edit } => listAppend(found, Edit { apply: edit })
}

fn screen(query) = Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Stack { children: [Field { value: query, edit: fn(text) => perform Log.write(text) }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }] }

fn dispatch(text) = match listGet(collect([], screen("")), 0) {
    Success { value } => match value { Edit { apply } => apply(text) }
    Error(_) => "rejected"
}

fn main() = print(dispatch("codesign"))
