// [GPU-BUFFER-ELEM]: scalar eligibility is an obligation on GpuBuffer<T>, not
// a direct-call syntax check. Generalizing this wrapper must retain that
// obligation and reject its List<string> instantiation.
fn bufferLength(xs) = match toGpu(xs) {
    Success { value } => Success { value: gpuLength(value) }
    Error { message } => Error { message: message }
}

fn main() = print(bufferLength(["a", "b"]))
