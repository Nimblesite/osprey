// [TYPE-GENERICS-FIELD-BARE] [COMPILER-RED-FAILS] #340: a record field written as a bare
// `Fiber`, `Channel`, `List`, `Map` or `Result` names no element type, so `--check`
// passed a program codegen then refused. Each field is rejected at its declaration;
// `Fiber<int>`, a type parameter and a non-generic field still check.
type Holder = { fib: Fiber, ready: Fiber<int> }
type Pipes = { ch: Channel, names: List, ages: Map, outcome: Result }
type Boxed<T> = { inner: Fiber<T>, count: int }
fn work() = 21 * 2
fn awaiter(h: Holder) = await(h.fib)
print(awaiter(Holder { fib: spawn work(), ready: spawn work() }))
