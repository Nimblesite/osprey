// osprey: flavor=ml
// A Map has no rendering, so a list of them is not printable [BUILTIN-PRINT]. Interpolating one silently produced
// an empty string, so the ML path is pinned alongside the Default twin in
// debug_interpolation.ospo.
xs = [mapSet (Map ()) "k" 1]
listLine = "[${xs}]"
expect xs xs
expectError (Error(message = \n => n + 1)) (\n => n + 1)
