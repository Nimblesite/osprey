// [EFFECTS-STATIC-DISCHARGE] A partial handler discharges only its own arms.
effect Pair {
    first: fn() -> int
    second: fn() -> int
}

fn both() = {
    let first = perform Pair.first()
    let second = perform Pair.second()
    wrapAdd(first, second)
}

let answer = {
    handle Pair {
        first => 20
    }
    both()
}
