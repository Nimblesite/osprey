// osprey: flavor=ml
// [GPU-KERNEL-PURE], [STAGE-BACKEND]: a callback a static arm forwards into a kernel is judged where it lands.
static effect Build
    build : (int, (int) -> float) => GpuBuffer<float>
effect Log
    write : string => Unit

loud i =
    perform Log.write "saw ${i}"
    toFloat i

twice n = perform Build.build n loud

out =
    handle Log
        write m => print m
    handle static Build
        build n f => gpuIota n |> gpuMap f
    twice 3
print "${gpuGet out 2 ?: 0.0}"
