// [TYPE-MATCH-EXHAUSTIVE] An arm following an irrefutable catch-all can never
// run; the compiler must reject the dead `Green` arm as unreachable.
type Color = Red | Green | Blue
fn name(c: Color) -> string = match c {
    Red   => "r"
    _     => "?"
    Green => "g"
}
print(name(Blue))

// [PATTERN-NESTED] An arm the earlier nested arms already cover is
// unreachable, whatever its spelling.
type Tree = Leaf | Node(Tree, Tree)
fn depth(tree) = match tree {
    Node(_, Leaf) => 1
    Node(_, Node(_, _)) => 2
    Node(Leaf, Leaf) => 3
    Leaf => 0
}

fn layered(r) = match r {
    Error { message: Error { message } } => "inner ${message}"
    Error { message: Success { value } } => "ok ${value}"
    Error { message: Success { value: 7 } } => "seven"
    Success { value } => "plain ${value}"
}
print("${depth(Leaf)} ${layered(Success { value: 1 })}")

// [PATTERN-OR-EXHAUSTIVE] An alternative an earlier arm, or an earlier
// alternative of the same pattern, already covers is unreachable.
fn shade(c) = match c {
    Red => "r"
    Green | Red => "g"
    Blue => "b"
}
fn twice(c) = match c {
    Blue | Blue => "b"
    _ => "?"
}
print("${shade(Red)} ${twice(Blue)}")

