// osprey: flavor=ml
// [GPU-KERNEL-PURE], [STAGE-GPU-LEGAL]: host handlers cannot discharge a kernel's dynamic effects.
effect Log
    write : string => Unit

loud x =
    perform Log.write "saw"
    x

main () =
    handle Log
        write m => print m
    match toGpu [1, 2]
        Success value => gpuMap (value, loud)
        Error message => Error(message = message)
