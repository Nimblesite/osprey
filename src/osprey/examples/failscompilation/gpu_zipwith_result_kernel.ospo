// [GPU-KERNEL-EXTRACT]: a kernel that would return an unhandled Result is
// rejected before the program links; gpuZipWith rejects the stored element.
// Handle failure inside the kernel with `?:` or `match`.
fn main() = {
    let a = toGpu([1, 2])
    let out = gpuZipWith(a, a, fn(x, y) => checkedMul(x, y))
    print(listLength([out]))
}
