// [MEM-OWNERSHIP-STATIC-BORROWS] Runs under the collector; `--memory=ownership` refuses it.
// Read out of a value the statement itself made, which only lends the field:
// `got` borrows what `made` still owns, so `reread` can't return it.
// `firstOr` yields an element its list owns on one path and a value it made
// on the other, so what it returns may still belong to the list
// [MEM-OWNERSHIP-STATIC-PATHS]. `latestText` returns what a file-scope cell
// holds, which the next write to the cell frees; `held` would borrow it across
// such a write. `missing` is a read out of a map, which only lends what it
// found: the module can't hold a value the map still owns.
type Box = { text: string }
type Wrap = { inner: Box }

effect Feed {
    push: fn(string) -> int
}

mut latest = "none${toString(0)}"
let stock = mapSet(Map(), "plum${toString(5)}", "ripe")
let missing = stock["mango"]

fn missingText() = "${missing}"

fn latestText() = latest

fn reread(n: int) = {
    let made = Box { text: "made${toString(n)}" }
    let got = Wrap { inner: made }.inner
    print(made.text)
    got
}

fn firstOr(boxes: List<Box>, n: int) = {
    let first = boxes[n] ?: Box { text: "none${toString(n)}" }
    first
}

fn main() = {
    let boxes = [Box { text: "in${toString(2)}" }]
    handle Feed {
        push text => {
            latest = "got ${text}"
            1
        }
    }
    let held = latest
    let pushed = perform Feed.push("p${toString(4)}")
    print("${reread(1).text}${firstOr(boxes, 0).text}${firstOr(boxes, 3).text}${toString(pushed)}${latestText()}${held}${missingText()}")
}
