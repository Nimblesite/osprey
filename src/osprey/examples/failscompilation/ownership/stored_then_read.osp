// [MEM-OWNERSHIP-STATIC-BORROWS] Runs under the collector; `--memory=ownership` refuses it.
// A value stored while its owner still reads it is lent, so the new value may
// not outlive that owner: here it is returned, and the owner dies in `build`.
type Box = { text: string }
type Wrap = { inner: Box }

fn build() = {
    let made = Box { text: "a${toString(1)}" }
    let wrap = Wrap { inner: made }
    print(made.text)
    wrap
}

fn main() = {
    let wrap = build()
    print(wrap.inner.text)
}
