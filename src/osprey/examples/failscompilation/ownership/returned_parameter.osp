// [MEM-OWNERSHIP-STATIC] Runs under the collector; `--memory=ownership` refuses it.
// `pick` can return its parameter, so it takes ownership of it, and one
// statement gives the same value to it twice.
type Box = { text: string }

fn pick(box, n) = match n {
    0 => box
    _ => Box { text: "none${toString(n)}" }
}

fn main() = {
    let made = Box { text: "a${toString(1)}" }
    print("${pick(made, 0).text}${pick(made, 3).text}")
}
