// [MEM-OWNERSHIP-STATIC-SHARING] Runs under the collector; `--memory=ownership` refuses it.
// A new version of a list or map is derived while the old one is read again:
// two live versions would share their nodes and elements. A list filtered or
// sorted while it is read again would share each element it keeps, and so
// would the keys or values listed out of a map that is read again. A list
// literal that only lends its elements can't give them to a derived list.
type Box = { text: string }

fn main() = {
    let names = listAppend(listAppend(List(), "a${toString(1)}"), "b")
    let more = listAppend(names, "c")
    let ages = mapSet(Map(), "ann", 30)
    let older = mapSet(ages, "bob", 41)
    let boxes = [Box { text: "x${toString(1)}" }, Box { text: "y" }]
    let short = filterList(boxes, fn(box) => length(box.text) < 2)
    let ordered = listSortBy(boxes, fn(left, right) => wrapSub(length(left.text), length(right.text)))
    let labels = mapSet(Map(), "k${toString(1)}", "v${toString(1)}")
    let keys = mapKeys(labels)
    let values = mapValues(labels)
    let lone = Box { text: "z${toString(2)}" }
    let lent = [lone, lone]
    let longer = lent + [Box { text: "w" }]
    print("${toString(length(more))} ${toString(length(names))} ${toString(length(older))} ${toString(length(ages))} ${toString(length(short))} ${toString(length(ordered))} ${toString(length(boxes))} ${toString(length(keys))} ${toString(length(values))} ${toString(length(labels))} ${toString(length(longer))}${lone.text}")
}
