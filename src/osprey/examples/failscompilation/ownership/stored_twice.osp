// [MEM-OWNERSHIP-STATIC-BORROWS] Runs under the collector; `--memory=ownership` refuses it.
// One value is stored in two fields: only one of them can own it, so the pair
// lends the other and may not leave the function that owns `made`.
type Box = { text: string }
type Pair = { left: Box, right: Box }

fn build() = {
    let made = Box { text: "a${toString(1)}" }
    Pair { left: made, right: made }
}

fn main() = {
    let pair = build()
    print("${pair.left.text}${pair.right.text}")
}
