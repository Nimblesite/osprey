// The Issue Inbox's C boundary for any Osprey Native host ([NATIVE-SHM-BOUNDARY],
// [NATIVE-SHM-EVENT]): `argument` gathers the launch arguments, `open` draws the first frame and
// `event` delivers one typed host event and draws the next. Nothing is encoded in either
// direction: the frame is view and ask rows the host seals when each call returns, the session
// stays in this library, and GitHub's HTTP body and the app store's document cross only as slice
// text the boundary decodes at the edge. Strings the host passes in are borrowed for the call.
namespace app

import ui::Runtime
import ui::Views
import inbox::Inbox
import inbox::View

extern native_slice (key : string) -> string

(** The store, and the actions its drawn controls deliver, in control order. *)
type Live =
    store : inbox::Store
    bound : List<inbox::Act>

(** Hands the next store and bindings to the cell below. *)
effect Keep
    keep : Live => Unit

// The session `open` replaces at launch.
mut held = Live(store = Inbox::blank (), bound = [])

hosted work =
    handle Keep
        keep next => held := next
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)

// Draws `step`'s store, sends what the step asks of the host and keeps the result.
drawn (step : ui::Step<inbox::Store>) =
    next = Live(store = step.stepStore, bound = Views::render (View::screen step.stepStore))
    ui::Requests::post (step.requests, step.writes)
    perform Keep.keep next
    0

// The same store drawn again with nothing asked: what a refused event answers.
refused store = satAdd (drawn (Runtime::step store)) 1

(** Gathers one launch argument, in order, before `open`. *)
argument text =
    gathered = Inbox::argued (held.store, text)
    hosted (\() => satAdd (drawn (Runtime::step gathered)) 0)

(** Draws the first frame for the host's clock, zone offset, platform, home folder and appearance. *)
open (now : int, offset : int, platform : string, home : string, dark : bool) = hosted (\() => openedWith (held.store, now, offset, platform, home, dark))

// The first frame for the host facts, kept in a local so the store update reads plainly.
openedWith (store, now, offset, platform, home, dark) = drawn (Inbox::opened (store, now, offset, platform, home, dark))

// The control numbered `ordinal` with its `words`, when the view drew one.
touched (live, ordinal, words) = match listGet live.bound ordinal
    Error _why => refused live.store
    Success action => drawn (Inbox::update (live.store, action, words))

// One host event: a control, a capability's completion, or the appearance changing.
arrived (live, kind, ordinal, words, detail, down) = match kind
    0 => touched (live, ordinal, words)
    8 => drawn (Inbox::completed (live.store, words, down, detail))
    11 => redrawn live.store down
    _other => refused live.store

// The appearance changed: the same store with its shade, drawn again.
redrawn store dark =
    shaded = store(dark = dark)
    drawn (Runtime::step shaded)

(** Delivers one host event and draws the next frame; nonzero when it was refused, which changes nothing. *)
event (_ : int, kind, ordinal, words, detail : string, _ : float, _ : float, down : bool, _ : bool) = hosted (\() => arrived (held, kind, ordinal, words, detail, down))
