// The Markdown boundary: a GitHub description becomes typed blocks and spans, and those become
// phrase rows the hosts draw as one paragraph. This file sits in the application's namespace so
// the suite can take the blocks apart as directly as the view does.
namespace inbox

import ui::Lists
import ui::Views
import inbox::Markdown
import inbox::View
import inbox::Support

module MarkdownSupport
    export blocks source = Markdown::render source

    // One block's shape as a word a case can read.
    export shape block = match block
        Passage spans => "passage:${toString (length spans)}"
        Heading major spans => match major
            true => "heading"
            false => "subheading"
        CodeBlock code => "code"
        Quotation spans => "quote"
        Divider => "rule"
        Bullet mark spans => "item:${mark}"

    export blockAt source index = match listGet (blocks source) index
        Error _missing => "MISSING"
        Success block => shape block

    export spanAt source index = match listGet (Markdown::spans source) index
        Error _missing => "MISSING"
        Success span => "${span.spanKind}:${span.spanText}"

    // One store's first issue body, as a case reads it.
    export firstBody store = match listGet store.issues 0
        Error _missing => "MISSING"
        Success issue => issue.issueBody

markdownBlocksCase () =
    source = "# Crash on launch\n\nThe app **crashes** when `main.osp` is empty.\nSecond line.\n\n### Steps\n1. Open app\n2. Reproduce\n- [x] macOS\n- [ ] iOS\n* bullet\n\n> quoted advice\n\n---\n```\nlet x = 1\n\nprint(x)\n```\ntrailing"
    Support::each [Support::it "a heading is a heading block" "heading" (MarkdownSupport::blockAt source 0), Support::it "a paragraph folds its line breaks" "passage:9" (MarkdownSupport::blockAt source 1), Support::it "a deeper heading is a subheading" "subheading" (MarkdownSupport::blockAt source 2), Support::it "an ordered item keeps its number" "item:1." (MarkdownSupport::blockAt source 3), Support::it "a done task" "item:☑" (MarkdownSupport::blockAt source 5), Support::it "an open task" "item:☐" (MarkdownSupport::blockAt source 6), Support::it "a plain bullet" "item:•" (MarkdownSupport::blockAt source 7), Support::it "a quote block" "quote" (MarkdownSupport::blockAt source 8), Support::it "a horizontal rule" "rule" (MarkdownSupport::blockAt source 9), Support::it "fenced code keeps blank lines" "code" (MarkdownSupport::blockAt source 10), Support::it "text after the fence" "passage:1" (MarkdownSupport::blockAt source 11), Support::it "nothing after the last block" "MISSING" (MarkdownSupport::blockAt source 12)]

markdownInlineCase () =
    Support::each [Support::it "an https link keeps its url" "link:docs" (MarkdownSupport::spanAt "see [docs](https://github.com/x) now" 1), Support::it "text after a link" "plain: now" (MarkdownSupport::spanAt "see [docs](https://github.com/x) now" 2), Support::it "a plain http link is literal" "plain:[" (MarkdownSupport::spanAt "[x](http://evil)" 0), Support::it "unterminated bold stays literal" "plain:**" (MarkdownSupport::spanAt "a **b" 1), Support::it "unterminated code stays literal" "plain:`" (MarkdownSupport::spanAt "tick ` mark" 1), Support::it "italic" "italic:em" (MarkdownSupport::spanAt "an *em* word" 1), Support::it "empty emphasis is literal" "plain:**" (MarkdownSupport::spanAt "****" 0), Support::it "quotes and unicode survive" "plain:say \"hi\" 🦉" (MarkdownSupport::spanAt "say \"hi\" 🦉" 0), Support::it "underscores are text" "plain:snake_case_name" (MarkdownSupport::spanAt "snake_case_name" 0), Support::it "word boundary underscore emphasis" "italic:No Description" (MarkdownSupport::spanAt "_No Description_" 0), Support::it "underscore emphasis before punctuation" "italic:this" (MarkdownSupport::spanAt "see _this_." 1), Support::it "intraword underscore after emphasis stays literal" "plain: my_var" (MarkdownSupport::spanAt "_x_ my_var" 1)]

markdownEdgeCase () =
    check "empty body renders nothing" 0 (length (Markdown::render ""))
    check "whitespace body renders nothing" 0 (length (Markdown::render " \n\n  "))
    Support::each [Support::it "a hashtag is a paragraph" "passage:1" (MarkdownSupport::blockAt "#tag" 0), Support::it "an unclosed fence still renders as code" "code" (MarkdownSupport::blockAt "```\nlost" 0), Support::it "seven hashes are text" "passage:1" (MarkdownSupport::blockAt "####### deep" 0), Support::it "a rule needs three marks" "passage:1" (MarkdownSupport::blockAt "--" 0), Support::it "an indented bullet" "item:•" (MarkdownSupport::blockAt "   - nested" 0)]

// The store with one issue whose description is `body`, opened.
openedWithBody body =
    asking = Support::fetchAsked ()
    page = "[{\"id\":101,\"number\":42,\"title\":\"Investigate\",\"user\":{\"login\":\"alice\"},\"comments\":0,\"body\":${body},\"labels\":[]}]"
    here = Support::holding (Support::fresh (), "inbox-http", page)
    loaded = Support::settled (here, asking.stepStore, asking.stepStore.fetchTicket, true, Support::receipt 200)
    Support::updated (loaded.stepStore, OpenIssue(openedId = 101), "")

rows store = (Views::drawn (View::screen store)).walkRows

shows store words = Lists::any (rows store, \seat => seat.placedWords == words)

markdownDetailCase () =
    selected = openedWithBody "\"**Steps**\\n- open\\n- crash\""
    raw = MarkdownSupport::firstBody selected
    Support::each [Support::it "the view keeps the raw markdown" "**Steps**\n- open\n- crash" raw, Support::it "the description renders phrase runs" "true" (toString (Lists::any (rows selected, \seat => seat.placedKind == Views::phrase))), Support::it "a bold run draws at weight 700" "true" (toString (Lists::any (rows selected, \seat => seat.placedKind == Views::phrase && seat.placedWords == "Steps" && seat.placedLook.heft == 700))), Support::it "a bullet draws its mark" "true" (toString (shows selected "•"))]



placeholderCase () =
    bare = openedWithBody "null"
    Support::each [Support::it "no description keeps the placeholder" "true" (toString (shows bare "The author has not added a description."))]
