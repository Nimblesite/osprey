namespace inboxtests

import bank::Json
import mobile::Model
import mobile::Github
import mobile::Storage
import mobile::Update
import mobile::View
import mobile::App
import inboxtests::Support

jsonControlCase () =
    source = "line one\nline two\t\r" + (fromCodePoint 1 ?: "")
    encoded = Json::obj (Json::strField "value" source)
    check "control characters round trip through valid JSON" source (Json::getOr encoded "value" "INVALID JSON")

test "shared JSON encoder escapes control characters" jsonControlCase

repositoryCase () =
    Support::each [Support::it "valid path" "true" (toString (Github::validRepository "rust-lang/rust")), Support::it "no traversal" "false" (toString (Github::validRepository "../rust")), Support::it "no query injection" "false" (toString (Github::validRepository "owner/repo?token=bad")), Support::it "exactly two components" "false" (toString (Github::validRepository "owner/repo/issues")), Support::it "no empty owner" "false" (toString (Github::validRepository "/repo")), Support::it "no spaces" "false" (toString (Github::validRepository "own er/repo"))]

startupCase () =
    initial = App::initial ()
    schema = Support::schemaOf initial
    fetching = Support::loadOf schema
    Support::each [Support::it "schema first" "schema" (Support::projected initial.commands "[0].id"), Support::it "prepared cache read" "inbox" (Support::projected schema.commands "[0].params[0]"), Support::it "fetch after empty cache" "http" (Support::projected fetching.commands "[0].kind"), Support::it "bounded public API URL" (Github::url "swiftlang/swift") (Support::projected fetching.commands "[0].url")]

requestHandlerCase () =
    recording = handler Storage::Requests
        sql request =>
            Support::each [Support::it "schema request id" "schema" request.id, Support::it "schema has no bound values" "[]" request.params]
            check "schema remains application SQL" true (startsWith request.statement "CREATE TABLE IF NOT EXISTS app_state")
            "recorded SQL"
    initial = recording Update::initial
    repeated = recording Update::initial
    Support::each [Support::it "handler supplies command representation" "recorded SQL" initial.commands, Support::it "same handler can run again" initial.commands repeated.commands, Support::it "state transition survives substitution" "schema" initial.model.stage]

scopedRequestsCase () =
    loaded = Support::loaded ()
    handle Storage::Requests
        http request => "${request.id}|${request.url}"
        sql request => "unexpected SQL"
    refreshed = Update::dispatch loaded.model (Support::event "refresh")
    Support::each [Support::it "scoped handler sees correlated request and URL" (refreshed.model.pending + "|" + Github::url loaded.model.repo) refreshed.commands, Support::it "refresh still enters loading state" "true" refreshed.model.loading]
    searched = Update::dispatch loaded.model (Support::value "search" "parser")
    check "local events require no host operation" "[]" searched.commands

loadedCase () =
    updated = Support::loaded ()
    view = View::render updated.model
    Support::each [Support::it "pull request excluded" "2" (Support::projected view "total"), Support::it "scalar id" "101" (Support::projected view "items[0].id"), Support::it "safe URL constructed in Osprey" "https://github.com/swiftlang/swift/issues/42" (Support::projected view "items[0].url"), Support::it "loading finished" "false" (Support::projected view "loading"), Support::it "cache emitted" "sql" (Support::projected updated.commands "[0].kind")]

searchCase () =
    loaded = Support::loaded ()
    searched = App::dispatch loaded.model (Support::value "search" "ALICE")
    view = View::render searched.model
    Support::each [Support::it "case insensitive author match" "101" (Support::projected view "items[0].id"), Support::it "second item filtered" "MISSING" (Support::projected view "items[1].id"), Support::it "total remains full inbox" "2" (Support::projected view "total"), Support::it "search is pure" "[]" searched.commands]

bookmarkCase () =
    saved = Support::bookmarked "102"
    filtered = App::dispatch saved.model (Support::value "filter" "saved")
    view = View::render filtered.model
    Support::each [Support::it "saved count changes immediately" "1" (Support::projected view "bookmarked"), Support::it "saved filter" "102" (Support::projected view "items[0].id"), Support::it "bookmark boolean" "true" (Support::projected view "items[0].bookmarked"), Support::it "prepared write" "INSERT OR REPLACE INTO app_state (key, value) VALUES (?, ?)" (Support::projected saved.commands "[0].sql")]

cacheCase () =
    saved = Support::bookmarked "101"
    snapshot = Model::snapshot saved.model
    schema = Support::schemaOf (App::initial ())
    restored = App::dispatch schema.model (Support::sql "load" true (Json::arr (Json::obj (Json::strField "value" snapshot))) "")
    Support::each [Support::it "reopen restores issues" (toString saved.model.items) (toString restored.model.items), Support::it "reopen restores bookmarks" (toString saved.model.saved) (toString restored.model.saved), Support::it "cached launch stays offline" "[]" restored.commands, Support::it "transient filter resets" "all" restored.model.filter]

staleCase () =
    first = Support::awaiting ()
    second = App::dispatch first.model (Support::value "repository" "rust-lang/rust")
    stale = App::dispatch second.model (Support::http first.model.pending 200 (Support::fixture ()) "")
    Support::each [Support::it "old response ignored" (Model::encode second.model) (Model::encode stale.model), Support::it "old response cannot persist" "[]" stale.commands]

offlineCase () =
    loaded = Support::loaded ()
    refresh = Support::refresh loaded
    failed = App::dispatch refresh.model (Support::http refresh.model.pending 0 "" "The internet connection is offline.")
    Support::each [Support::it "offline retains issues" (toString loaded.model.items) (toString failed.model.items), Support::it "error is visible" "true" (toString (contains failed.model.error "offline")), Support::it "loading stops on failure" "false" failed.model.loading, Support::it "failed response never overwrites SQLite" "[]" failed.commands]

malformedCase () =
    loaded = Support::loaded ()
    refresh = Support::refresh loaded
    failed = App::dispatch refresh.model (Support::http refresh.model.pending 200 "[{\"id\":7}]" "")
    Support::each [Support::it "invalid issue rejected" "true" (toString (contains failed.model.error "missing a valid")), Support::it "invalid API cannot replace cache" (toString loaded.model.items) (toString failed.model.items), Support::it "invalid API cannot persist" "[]" failed.commands]

sqliteFailureCase () =
    loaded = Support::loaded ()
    failed = App::dispatch loaded.model (Support::sql loaded.model.write false "[]" "disk full")
    Support::each [Support::it "save error visible" "true" (toString (contains (View::render failed.model) "disk full")), Support::it "save error retains data" (toString loaded.model.items) (toString failed.model.items), Support::it "failed save not retried silently" "[]" failed.commands]

injectionCase () =
    loaded = Support::loaded ()
    snapshot = Support::projected loaded.commands "[0].params[1]"
    Support::each [Support::it "snapshot stays bound data" (Model::snapshot loaded.model) snapshot, Support::it "quotes preserved" "true" (toString (contains snapshot "Windows paths")), Support::it "SQL contains no issue title" "false" (toString (contains (Support::projected loaded.commands "[0].sql") "Windows"))]

envelopeCase () =
    loaded = Support::loaded ()
    envelope = App::envelope loaded
    Support::each [Support::it "opaque model round trip" (Model::encode loaded.model) (Support::projected envelope "model"), Support::it "native neutral UI" "scroll" (Support::projected envelope "ui.kind"), Support::it "view included" "2" (Support::projected envelope "view.total")]

test "repository validation prevents path and query injection" repositoryCase
test "startup sequences SQLite schema load and HTTP" startupCase
test "callable request handler substitutes native SQL commands" requestHandlerCase
test "scoped request handler changes transport without changing transitions" scopedRequestsCase
test "GitHub data normalized and pull requests excluded" loadedCase
test "search reacts locally without network or SQL" searchCase
test "bookmarks derive views and prepared SQLite writes" bookmarkCase
test "SQLite snapshot restores offline across app starts" cacheCase
test "out of order HTTP response cannot replace a new repository" staleCase
test "network failure retains cached issues and reports cause" offlineCase
test "malformed successful API response is rejected" malformedCase
test "SQLite errors remain visible without losing in memory data" sqliteFailureCase
test "SQL parameter binding preserves escaped user data" injectionCase
test "one boundary returns model view commands and Osprey UI" envelopeCase

test "issue details and navigation are Osprey transitions" detailCase
test "local notes persist safely with quotes newlines and SQL text" noteCase
test "local priority changes reactively and rejects invalid values" priorityCase
test "GitHub descriptions and labels normalize for details" bodyCase
test "all control characters and Unicode survive shared JSON encoding" allControlCase
test "SQLite schema failure is visible and supports memory only operation" schemaFailureCase
test "stale SQLite completion cannot overwrite current save status" staleSaveCase
test "invalid or newer SQLite cache cannot become app state" invalidCacheCase
test "GitHub rate limit status and cause reach the user" rateLimitCase
test "clearing notes and priority releases annotation capacity" clearAnnotationCase
test "SQLite save failure cannot stop an independent HTTP loading state" saveDuringRefreshCase
test "refresh removing selected issue returns to the inbox" removedSelectionCase

test "issue body blocks become headings, lists, quotes, rules and code" markdownBlocksCase
test "inline emphasis, code and https links are spans; unmatched markers are literal" markdownInlineCase
test "degenerate Markdown never breaks rendering" markdownEdgeCase
test "the detail screen renders Markdown while the view keeps the raw body" markdownDetailCase

test "Unicode limits preserve complete GitHub description characters" unicodeBodyCase
test "Unicode limits preserve complete search characters" unicodeSearchCase
test "Unicode limits accept and restore bounded notes" unicodeNoteCase
