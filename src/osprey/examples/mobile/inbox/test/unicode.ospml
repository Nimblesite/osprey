// Unicode limits keep complete characters: descriptions, searches and notes truncate on scalar
// boundaries, never inside one.
namespace inbox

import ui::Lists
import inbox::Inbox
import inbox::Notes
import inbox::Snapshot
import inbox::Text
import inbox::View
import inbox::MarkdownSupport
import inbox::Support

unicodeBodyCase () =
    expected = (repeat "a" 1999 ?: "") + "🦉"
    page = "[{\"id\":101,\"number\":42,\"title\":\"Unicode\",\"user\":{\"login\":\"alice\"},\"comments\":0,\"body\":\"${expected}extra\"}]"
    asking = Support::fetchAsked ()
    here = Support::holding (Support::fresh (), "inbox-http", page)
    loaded = Support::settled (here, asking.stepStore, asking.stepStore.fetchTicket, true, Support::receipt 200)
    body = MarkdownSupport::firstBody loaded.stepStore
    Support::each [Support::it "a description keeps 2000 complete Unicode scalars" expected body, Support::it "the stored document remains valid JSON" "true" (toString (startsWith (Support::written loaded 0) "{"))]

unicodeSearchCase () =
    loaded = Support::loaded ()
    expected = (repeat "a" 255 ?: "") + "é"
    searched = Support::updated (loaded.stepStore, Searching, expected + "extra")
    found = View::found searched
    Support::each [Support::it "a search keeps 256 complete Unicode scalars" expected searched.search, Support::it "an overlong search matches nothing" "0" (toString (length found))]

unicodeNoteCase () =
    loaded = Support::loaded ()
    selected = Support::updated (loaded.stepStore, OpenIssue(openedId = 101), "")
    expected = repeat "界" 2000 ?: ""
    edited = Support::updated (selected, NoteIssue(notedId = 101), expected)
    rejected = Inbox::update (selected, NoteIssue(notedId = 101), expected + "x")
    triage = Notes::find edited.notes 101
    Support::each [Support::it "2000 Unicode scalars fit the note limit" "" edited.problem, Support::it "a Unicode note reaches the triage intact" expected triage.noteText, Support::it "an overlong note reports its limit" "true" (toString (contains rejected.stepStore.problem "2000"))]

unicodeCacheCase () =
    loaded = Support::loaded ()
    selected = Support::updated (loaded.stepStore, OpenIssue(openedId = 101), "")
    noted = Support::updated (selected, NoteIssue(notedId = 101), "界" + (fromCodePoint 1 ?: ""))
    saved = Inbox::update (noted, KeepIssue(keptId = 101), "")
    here = Support::holding (Support::fresh (), Snapshot::readSlice, Support::written saved 0)
    opened = Support::opened ()
    reopened = Support::settled (here, opened.stepStore, "load:1", true, "{\"found\":true}")
    triage = Notes::find reopened.stepStore.notes 101
    Support::each [Support::it "Unicode and control characters survive the stored document" "true" (toString (contains triage.noteText "界")), Support::it "a document with control characters reopens" "ready" reopened.stepStore.stage]
