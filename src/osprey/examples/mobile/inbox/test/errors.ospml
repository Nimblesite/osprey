namespace inboxtests

import bank::Json
import mobile::App
import mobile::Model
import mobile::Storage
import mobile::View
import mobile::Annotations
import inboxtests::Support
import inboxtests::TriageSupport

controlRoundTrip code = match code >= 32
    true => true
    false =>
        character = fromCodePoint code ?: ""
        source = "é🦉" + character + "\"\\"
        encoded = Json::obj (Json::strField "value" source)
        source == Json::getOr encoded "value" "INVALID" && controlRoundTrip ((satAdd code 1) )

allControlCase () = check "all representable JSON controls and Unicode round trip" true (controlRoundTrip 1)

schemaFailureCase () =
    initial = App::initial ()
    failed = App::dispatch initial.model (Support::sql "schema" false "[]" "permission denied")
    refreshed = Support::refresh failed
    response = App::dispatch refreshed.model (Support::http refreshed.model.pending 200 (Support::fixture ()) "")
    Support::each [Support::it "schema failure visible" "true" (toString (contains (View::render failed.model) "permission denied")), Support::it "memory only storage warning truthful" "true" (toString (contains response.model.storageError "only in memory"))]
    Support::each [Support::it "network remains usable" "2" (Support::projected (View::render response.model) "total"), Support::it "no write to broken database" "[]" response.commands]

staleSaveCase () =
    loaded = Support::loaded ()
    saved = App::dispatch loaded.model (Support::bookmark "101")
    stale = App::dispatch saved.model (Support::sql loaded.model.write false "[]" "old write failed")
    Support::each [Support::it "older save cannot replace latest status" (Model::encode saved.model) (Model::encode stale.model), Support::it "older save emits nothing" "[]" stale.commands]

invalidCacheCase () =
    model = Model::initial ()
    invalid = Storage::restore model "{\"version\":99,\"repo\":\"owner/repo\",\"items\":\"[]\"}"
    malformed = Storage::restore model "{\"version\":1,\"repo\":\"owner/repo\",\"items\":\"[{\\\"id\\\":7}]\"}"
    Support::each [Support::it "new schema cannot be misread" "false" (toString (invalid.valid)), Support::it "malformed cached issues rejected" "false" (toString (malformed.valid))]
    check "invalid cache does not change state" (Model::encode model) (Model::encode malformed.model)

rateLimitCase () =
    awaiting = Support::awaiting ()
    response = App::dispatch awaiting.model (Support::http awaiting.model.pending 403 "{\"message\":\"API rate limit exceeded\"}" "")
    Support::each [Support::it "HTTP status visible" "true" (toString (contains response.model.error "403")), Support::it "GitHub failure detail visible" "true" (toString (contains response.model.error "rate limit"))]

clearAnnotationCase () =
    notes = Annotations::set "[]" "101" "Remember" "high"
    cleared = Annotations::set notes "101" "" "normal"
    Support::each [Support::it "clearing annotation releases local capacity" "[]" cleared, Support::it "normal default survives removal" "normal" (Annotations::get cleared "101").priority]

saveDuringRefreshCase () =
    loaded = Support::loaded ()
    refreshing = Support::refresh loaded
    failed = App::dispatch refreshing.model (Support::sql loaded.model.write false "[]" "disk full")
    Support::each [Support::it "save failure cannot end an independent HTTP request" "true" failed.model.loading, Support::it "pending HTTP correlation remains intact" refreshing.model.pending failed.model.pending]

removedSelectionCase () =
    selected = TriageSupport::selected ()
    refreshing = Support::refresh selected
    empty = App::dispatch refreshing.model (Support::http refreshing.model.pending 200 "[]" "")
    Support::each [Support::it "removed issue closes its detail" "" empty.model.selected, Support::it "valid empty issue page replaces cache" "[]" empty.model.items]
