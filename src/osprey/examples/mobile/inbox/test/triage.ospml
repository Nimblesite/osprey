// The detail screen, its local triage and its description, as typed transitions and drawn rows.
namespace inbox

import ui::Lists
import inbox::Inbox
import inbox::Notes
import inbox::Snapshot
import inbox::View
import inbox::Support

module TriageSupport
    (** The store with the fixture's first issue open. *)
    export selected () =
        loaded = Support::loaded ()
        Support::updated (loaded.stepStore, OpenIssue(openedId = 101), "")

firstIssue store = match listGet store.issues 0
    Error _missing => noIssue
    Success issue => issue

detailCase () =
    selected = TriageSupport::selected ()
    open = firstIssue selected
    closed = Support::updated (selected, CloseDetail, "")
    Support::each [Support::it "selection is Osprey state" "101" (toString selected.selected), Support::it "the detail shows the open issue" "First issue 🦅" open.issueTitle, Support::it "back clears selection" "0" (toString closed.selected), Support::it "selection has no side effects" "0" (toString (length (Inbox::update (selected, CloseDetail, "")).requests))]

noteCase () =
    selected = TriageSupport::selected ()
    note = "Reproduce the issue."
    step = Inbox::update (selected, NoteIssue(notedId = 101), note)
    triage = Notes::find step.stepStore.notes 101
    document = Support::written step 0
    Support::each [Support::it "the note reaches the triage" note triage.noteText, Support::it "the note rides the stored document" "true" (toString (contains document "Reproduce"))]

priorityCase () =
    selected = TriageSupport::selected ()
    raised = Support::updated (selected, RankIssue(rankedId = 101, rankedLevel = "high"), "")
    invalid = Inbox::update (raised, RankIssue(rankedId = 101, rankedLevel = "urgent"), "")
    triage = Notes::find raised.notes 101
    Support::each [Support::it "high priority visible" "high" triage.noteRank, Support::it "an invalid priority does not persist" "0" (toString (length invalid.requests)), Support::it "an invalid priority is rejected" "true" (toString (contains invalid.stepStore.problem "Normal or High"))]

bodyCase () =
    body = "[{\"id\":101,\"number\":42,\"title\":\"Investigate\",\"user\":{\"login\":\"alice\"},\"comments\":0,\"body\":\"Steps:\\n1. Open app\\n2. Reproduce\",\"labels\":[{\"name\":\"bug\"},{\"name\":\"compiler\"}]}]"
    asking = Support::fetchAsked ()
    here = Support::holding (Support::fresh (), "inbox-http", body)
    loaded = Support::settled (here, asking.stepStore, asking.stepStore.fetchTicket, true, Support::receipt 200)
    selected = Support::updated (loaded.stepStore, OpenIssue(openedId = 101), "")
    open = firstIssue selected
    Support::each [Support::it "the body keeps newlines" "Steps:\n1. Open app\n2. Reproduce" open.issueBody, Support::it "labels normalized" "bug · compiler" open.issueLabels]

cacheCase () =
    loaded = Support::loaded ()
    saved = Inbox::update (loaded.stepStore, KeepIssue(keptId = 101), "")
    here = Support::holding (Support::fresh (), Snapshot::readSlice, Support::written saved 0)
    opened = Support::opened ()
    reopened = Support::settled (here, opened.stepStore, "load:1", true, "{\"found\":true}")
    Support::each [Support::it "reopen restores the issues" (toString (length saved.stepStore.issues)) (toString (length reopened.stepStore.issues)), Support::it "reopen restores bookmarks" "1" (toString (View::markedCount reopened.stepStore)), Support::it "a cached launch stays offline" "0" (toString (length reopened.requests)), Support::it "a cached launch is ready" "ready" reopened.stepStore.stage, Support::it "a cached launch resets the filter" "all" reopened.stepStore.filter]
