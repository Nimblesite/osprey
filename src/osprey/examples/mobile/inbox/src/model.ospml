namespace mobile

import bank::Json

type InboxModel =
    selected : string
    annotations : string
    repo : string
    search : string
    filter : string
    status : string
    error : string
    storageError : string
    loading : string
    items : string
    saved : string
    seq : string
    pending : string
    write : string
    stage : string
    dbReady : string

(** The inbox's model: every field a string, the initial one, and its JSON as the host reads it and as a SQLite snapshot. *)
module Model
    // The model field that carries the SQLite failure text.
    storageErrorKey = "storageError"

    (** The model at launch: the swiftlang/swift repository, nothing loaded, waiting for the SQLite schema. *)
    export initial () = InboxModel(selected = "", annotations = "[]", repo = "swiftlang/swift", search = "", filter = "all", status = "Opening SQLite…", error = "", storageError = "", loading = "true", items = "[]", saved = "|", seq = "0", pending = "", write = "", stage = "schema", dbReady = "false")

    (** The model from the JSON `source`, each field falling back to its initial value when absent. *)
    export decode source = InboxModel(selected = Json::getOr source "selected" "", annotations = Json::getOr source "annotations" "[]", repo = Json::getOr source "repo" "swiftlang/swift", search = Json::getOr source "search" "", filter = Json::getOr source "filter" "all", status = Json::getOr source "status" "Opening SQLite…", error = Json::getOr source "error" "", storageError = Json::getOr source storageErrorKey "", loading = Json::getOr source "loading" "true", items = Json::getOr source "items" "[]", saved = Json::getOr source "saved" "|", seq = Json::getOr source "seq" "0", pending = Json::getOr source "pending" "", write = Json::getOr source "write" "", stage = Json::getOr source "stage" "schema", dbReady = Json::getOr source "dbReady" "false")

    (** `m` as a JSON object with every field a string, as the host and the view read it. *)
    export encode m = Json::obj (Json::members [Json::strField "selected" m.selected, Json::strField "annotations" m.annotations, Json::strField "repo" m.repo, Json::strField "search" m.search, Json::strField "filter" m.filter, Json::strField "status" m.status, Json::strField "error" m.error, Json::strField storageErrorKey m.storageError, Json::strField "loading" m.loading, Json::strField "items" m.items, Json::strField "saved" m.saved, Json::strField "seq" m.seq, Json::strField "pending" m.pending, Json::strField "write" m.write, Json::strField "stage" m.stage, Json::strField "dbReady" m.dbReady])

    choose changed target value old = match changed == target
        true => value
        false => old

    (** `m` with its field named `changed` set to `value` and every other field kept. *)
    export set m changed value = InboxModel(selected = choose changed "selected" value m.selected, annotations = choose changed "annotations" value m.annotations, repo = choose changed "repo" value m.repo, search = choose changed "search" value m.search, filter = choose changed "filter" value m.filter, status = choose changed "status" value m.status, error = choose changed "error" value m.error, storageError = choose changed storageErrorKey value m.storageError, loading = choose changed "loading" value m.loading, items = choose changed "items" value m.items, saved = choose changed "saved" value m.saved, seq = choose changed "seq" value m.seq, pending = choose changed "pending" value m.pending, write = choose changed "write" value m.write, stage = choose changed "stage" value m.stage, dbReady = choose changed "dbReady" value m.dbReady)

    (** `m` as the version 1 JSON snapshot SQLite keeps: its repository, items, bookmarks and annotations. *)
    export snapshot m = Json::obj (
        Json::numField "version" 1 + "," + Json::strField "repo" m.repo + "," +
        Json::strField "items" m.items + "," + Json::strField "saved" m.saved + "," +
        Json::strField "annotations" m.annotations)
