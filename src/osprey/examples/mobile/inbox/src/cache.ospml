// Implements plan 0037 section 9: the SQLite cache became one JSON document in the app store,
// read with StoreRead and written with StoreWrite. The document crosses as text only at this
// edge; `restore` decodes and validates it into typed state, `document` encodes it back.
namespace inbox

import ui::Doc
import inbox::Github
import inbox::Notes
import inbox::Text

(** What the inbox keeps between launches. *)
type Cache =
    cacheRepo : string
    cacheIssues : List<Issue>
    cacheSaved : List<int>
    cacheNotes : List<Note>

module Snapshot
    export fileName = "inbox.json"
    export byteLimit = 524288
    export readSlice = "inbox-cache"
    export writeSlice = "inbox-document"

    issue doc = Issue(issueId = Doc::number (doc, "id"), issueNumber = Doc::number (doc, "number"), issueTitle = Doc::text (doc, "title"), issueAuthor = Doc::text (doc, "author"), issueComments = Doc::number (doc, "comments"), issueBody = Doc::text (doc, "body"), issueLabels = Doc::text (doc, "labels"))

    issueValid doc = Doc::number (doc, "id") > 0 && Doc::number (doc, "number") > 0 && length (Doc::text (doc, "title")) > 0 && length (Doc::text (doc, "author")) > 0 && Doc::number (doc, "comments") >= 0 && Text::within (Doc::text (doc, "body")) 2000

    issuesFrom : Json -> int -> Result<List<Issue>, string>
    issuesFrom doc index = match listGet (Doc::items doc) index
        Error _missing => Success(value = [])
        Success entry => match issueValid entry
            false => Error(message = "The stored document holds an invalid issue.")
            true => match issuesFrom doc (satAdd index 1)
                Error why => Error(message = why)
                Success rest => Success(value = listAppend rest (issue entry))

    savedFrom : Json -> int -> Result<List<int>, string>
    savedFrom doc index = match listGet (Doc::items doc) index
        Error _missing => Success(value = [])
        Success entry => match Doc::number entry > 0
            false => Error(message = "The stored document holds an invalid bookmark.")
            true => match savedFrom doc (satAdd index 1)
                Error why => Error(message = why)
                Success rest => Success(value = listAppend rest (Doc::number entry))

    notesFrom : Json -> Result<List<Note>, string>
    notesFrom doc = match Notes::valid (mapList (Doc::items doc, \entry => Note(noteId = Doc::number (entry, "id"), noteText = Doc::text (entry, "text"), noteRank = Doc::text (entry, "rank"))))
        false => Error(message = "The stored document holds an invalid note.")
        true => Success(value = mapList (Doc::items doc, \entry => Note(noteId = Doc::number (entry, "id"), noteText = Doc::text (entry, "text"), noteRank = Doc::text (entry, "rank"))))

    (** The document `text` holds, or why it cannot become the inbox. *)
    export restore text = match jsonDecode text
        Error _why => Error(message = "The app store's document is not valid JSON; refresh to replace it.")
        Success doc => match Doc::number (doc, "version") == 1 && Github::validRepository (Doc::text (doc, "repo"))
            false => Error(message = "The app store's document is invalid or uses an unsupported version; refresh to replace it.")
            true => match issuesFrom (Doc::field (doc, "issues")) 0
                Error why => Error(message = why)
                Success issues => match savedFrom (Doc::field (doc, "saved")) 0
                    Error why => Error(message = why)
                    Success saved => match notesFrom (Doc::field (doc, "notes"))
                        Error why => Error(message = why)
                        Success notes => match length issues <= 100
                            false => Error(message = "The stored document holds more issues than this inbox accepts.")
                            true => Success(value = Cache(cacheRepo = Doc::text (doc, "repo"), cacheIssues = issues, cacheSaved = saved, cacheNotes = notes))

    issueDocument issue = JsonObject [Doc::num ("id", issue.issueId), Doc::num ("number", issue.issueNumber), Doc::str ("title", issue.issueTitle), Doc::str ("author", issue.issueAuthor), Doc::num ("comments", issue.issueComments), Doc::str ("body", issue.issueBody), Doc::str ("labels", issue.issueLabels)]

    noteDocument note = JsonObject [Doc::num ("id", note.noteId), Doc::str ("text", note.noteText), Doc::str ("rank", note.noteRank)]

    (** The cache as the document the app store keeps. *)
    export document cache = JsonObject [Doc::num ("version", 1), Doc::str ("repo", cache.cacheRepo), JsonMember "issues" (JsonArray (mapList (cache.cacheIssues, issueDocument))), JsonMember "saved" (JsonArray (mapList (cache.cacheSaved, \id => JsonInt id))), JsonMember "notes" (JsonArray (mapList (cache.cacheNotes, noteDocument)))]
