// Implements [MOBILE-REACTIVE-UI] and plan 0037 section 9: GitHub's public issues feed is JSON
// only at this edge — `decode` turns one bounded response body into typed issues (pull requests
// excluded), and nothing downstream parses a document again.
namespace inbox

import ui::Doc
import inbox::Text

(** One open issue, everything the inbox shows of it. *)
type Issue =
    issueId : int
    issueNumber : int
    issueTitle : string
    issueAuthor : string
    issueComments : int
    issueBody : string
    issueLabels : string

(** What one GitHub entry reads as: an issue, a pull request, or an entry the contract rejects. *)
type Entry =
    IsIssue
        entryIssue : Issue
    IsPull
    IsBroken

module Github
    allowed code = (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 46 || code == 95

    componentFrom : string -> int -> bool
    componentFrom source index = match index >= byteLength source
        true => true
        false => allowed (byteAt source index ?: 0) && componentFrom source (satAdd index 1)

    component source = length source > 0 && length source <= 100 && source != "." && source != ".." && componentFrom source 0

    (** `owner/repository` and nothing else: no traversal, no query, no spaces. *)
    export validRepository source = match indexOf source "/"
        Error _why => false
        Success slash => component (take source slash) && component (drop source (satAdd slash 1))

    export url repo = "https://api.github.com/repos/${repo}/issues?state=open&per_page=30"

    // A `null` body reads as no body; anything else is GitHub's own text.
    body doc = match Doc::kind (Doc::field (doc, "body"))
        "null" => ""
        _other => Doc::string (Doc::field (doc, "body"))

    labelsFrom : List<Json> -> int -> int -> string
    labelsFrom doc index count = match index >= count || index >= 10
        true => ""
        false =>
            name = Doc::string (listGetDoc doc index)
            rest = labelsFrom doc (satAdd index 1) count
            match length rest > 0
                true => name + " · " + rest
                false => name

    // One label entry, or the null value when the index is past the list.
    listGetDoc : List<Json> -> int -> Json
    listGetDoc doc index = match listGet doc index
        Error _missing => JsonNull
        Success entry => entry

    labels doc = labelsFrom (Doc::fieldItems (doc, "labels")) 0 (length (Doc::fieldItems (doc, "labels")))

    (** One entry as the inbox reads it: an issue, a pull request, or a rejected entry. *)
    read doc = match Doc::kind (Doc::field (doc, "pull_request")) == "null"
        false => IsPull
        true => match Doc::number (doc, "id") > 0 && Doc::number (doc, "number") > 0 && length (Doc::text (doc, "title")) > 0 && length (Doc::text (doc, "user.login")) > 0 && Doc::number (doc, "comments") >= 0
            false => IsBroken
            true => IsIssue(entryIssue = Issue(issueId = Doc::number (doc, "id"), issueNumber = Doc::number (doc, "number"), issueTitle = Doc::text (doc, "title"), issueAuthor = Doc::text (doc, "user.login"), issueComments = Doc::number (doc, "comments"), issueBody = Text::prefix (body doc) 2000, issueLabels = labels doc))

    collect : List<Json> -> int -> int -> List<Issue> -> Result<List<Issue>, string>
    collect doc index count output = match index >= count
        true => Success(value = output)
        false =>
            next = satAdd index 1
            match read (listGetDoc doc index)
                IsPull => collect doc next count output
                IsIssue held => collect doc next count (listAppend output held)
                IsBroken => Error(message = "GitHub returned an issue missing a valid id, number, title, author, or comment count.")

    (** One bounded page of open issues, or why it cannot become the inbox. *)
    export decode source = match jsonDecode source
        Error why => Error(message = "GitHub returned invalid JSON: ${why}")
        Success doc =>
            entries = Doc::items doc
            match length entries <= 100
                false => Error(message = "GitHub returned more than 100 entries; this inbox accepts one bounded page.")
                true => collect entries 0 (length entries) []
