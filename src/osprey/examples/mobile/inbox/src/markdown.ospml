// Implements [MOBILE-MARKDOWN]: a GitHub issue body becomes typed blocks and spans — headings,
// paragraphs, lists, quotes, code, rules, inline emphasis and HTTPS links — which the view turns
// into rows. Osprey decides the structure; the hosts only draw the runs.
namespace inbox

(** One styled run of a paragraph: `plain`, `bold`, `italic`, `code` or `link`. *)
type Span =
    spanText : string
    spanKind : string
    spanUrl : string

(** One block of an issue's description. *)
type Block =
    Passage
        spans : List<Span>
    Heading
        major : bool
        spans : List<Span>
    CodeBlock
        code : string
    Quotation
        spans : List<Span>
    Divider
    Bullet
        mark : string
        spans : List<Span>

type Cut =
    head : string
    tail : string

type Scan =
    blocks : List<Block>
    paragraph : List<Span>
    code : string
    mode : string

module Markdown
    span text kind url = Span(spanText = text, spanKind = kind, spanUrl = url)

    plain content = match length content == 0
        true => []
        false => [span content "plain" ""]

    smaller : int -> int -> int
    smaller a b = match a <= b
        true => a
        false => b

    // The byte index of `needle`, or the end of `s` when it is absent.
    position s needle = indexOf s needle ?: length s

    // Inline spans: `**bold**`, `*italic*`, `_italic_`, `` `code` `` and
    // `[text](https://…)`. An unmatched marker stays literal text, so the
    // parser is total.
    export spans text = match length text == 0
        true => []
        false =>
            first = smaller (smaller (position text "**") (position text "*")) (smaller (smaller (position text "`") (position text "[")) (underscore text 0))
            match first >= length text
                true => plain text
                false => listConcat (plain (take text first)) (marker (drop text first))

    marker rest = match startsWith rest "**"
        true => wrapped rest "**" "bold" false
        false => match startsWith rest "*"
            true => wrapped rest "*" "italic" false
            false => match startsWith rest "`"
                true => wrapped rest "`" "code" false
                false => match startsWith rest "_"
                    true => wrapped rest "_" "italic" true
                    false => linked rest

    isWordByte code = (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 95
    isBreak code = code == 32 || code == 10 || code == 9 || code == 40

    // The first `_` that opens a word, or the end: GitHub's `_No Description_`
    // placeholder is emphasis, while `snake_case` identifiers stay literal.
    underscore : string -> int -> int
    underscore text offset =
        found = satAdd offset (position (drop text offset) "_")
        match found >= length text
            true => length text
            false => match found == 0 || isBreak (byteAt text (satSub found 1) ?: 0)
                true => found
                false => underscore text (satAdd found 1)

    // `rest` begins with `mark`; a later closing mark yields one styled span.
    // A word-boundary mark must also close at a word boundary.
    wrapped : string -> string -> string -> bool -> List<Span>
    wrapped rest mark kind wordBoundary =
        inner = drop rest (length mark)
        close = position inner mark
        after = byteAt inner (satAdd close 1) ?: 32
        match close >= length inner || close == 0 || (wordBoundary && isWordByte after)
            true => listConcat (plain mark) (spans inner)
            false => listConcat [span (take inner close) kind ""] (spans (drop inner (satAdd close (length mark))))

    // `rest` begins with `[`; only `[text](https://…)` becomes a link.
    linked rest =
        inner = drop rest 1
        close = position inner "]("
        after = drop inner (satAdd close 2)
        end = position after ")"
        url = take after end
        match close >= length inner || end >= length after || close == 0
            true => listConcat (plain "[") (spans inner)
            false => match startsWith url "https://"
                true => listConcat [span (take inner close) "link" url] (spans (drop after (satAdd end 1)))
                false => listConcat (plain "[") (spans inner)

    line s = match indexOf s "\n"
        Success i => Cut(head = take s i, tail = drop s (satAdd i 1))
        Error _why => Cut(head = s, tail = "")

    flushParagraph doc = match length doc.paragraph == 0
        true => doc
        false => Scan(blocks = listAppend doc.blocks (Passage(spans = doc.paragraph)), paragraph = [], code = doc.code, mode = doc.mode)

    // Code lines are kept with their newline so a blank first line survives.
    flushCode doc =
        content = take doc.code (satSub (length doc.code) 1)
        blocks = match length doc.code == 0
            true => doc.blocks
            false => listAppend doc.blocks (CodeBlock(code = content))
        Scan(blocks = blocks, paragraph = doc.paragraph, code = "", mode = "text")

    withBlock doc block =
        flushed = flushParagraph doc
        Scan(blocks = listAppend flushed.blocks block, paragraph = [], code = flushed.code, mode = flushed.mode)

    // GitHub renders a single newline inside an issue paragraph as a line break.
    withParagraph doc text =
        joined = match doc.paragraph
            [] => [span text "plain" ""]
            held => listConcat held [span "\n" "plain" "", span text "plain" ""]
        Scan(blocks = doc.blocks, paragraph = joined, code = doc.code, mode = doc.mode)

    codeMode doc text = match startsWith (trimStart text) "```"
        true => flushCode doc
        false => Scan(blocks = doc.blocks, paragraph = doc.paragraph, code = doc.code + text + "\n", mode = "code")

    openFence doc =
        flushed = flushParagraph doc
        Scan(blocks = flushed.blocks, paragraph = [], code = "", mode = "code")

    onlyOf text symbol = length text >= 3 && length (replace text symbol "" ?: text) == 0
    isRule text = onlyOf text "-" || onlyOf text "*" || onlyOf text "_"

    hashes : string -> int -> int
    hashes text count = match startsWith (drop text count) "#"
        true => hashes text (satAdd count 1)
        false => count

    // `#`…`######` followed by a space (or nothing) is a heading; `#tag` is text.
    headingLevel body =
        level = hashes body 0
        rest = drop body level
        match level >= 1 && level <= 6 && (length rest == 0 || startsWith rest " ")
            true => level
            false => 0

    isDigit code = code >= 48 && code <= 57
    digits : string -> int -> int
    digits text count = match isDigit (byteAt text count ?: 0)
        true => digits text (satAdd count 1)
        false => count

    // `1. item` keeps its own number; `- item`, `* item`, `+ item` get a bullet.
    orderedWidth body =
        width = digits body 0
        match width > 0 && startsWith (drop body width) ". "
            true => width
            false => 0

    isBullet body = startsWith body "- " || startsWith body "* " || startsWith body "+ "

    listItem doc body =
        width = orderedWidth body
        match startsWith body "- [ ] "
            true => withBlock doc (Bullet(mark = "☐", spans = spans (drop body 6)))
            false => match startsWith body "- [x] " || startsWith body "- [X] "
                true => withBlock doc (Bullet(mark = "☑", spans = spans (drop body 6)))
                false => match width > 0
                    true => withBlock doc (Bullet(mark = take body width + ".", spans = spans (drop body (satAdd width 2))))
                    false => withBlock doc (Bullet(mark = "•", spans = spans (drop body 2)))

    isItem body = isBullet body || orderedWidth body > 0

    textMode doc text =
        body = trimStart text
        level = headingLevel body
        match startsWith body "```"
            true => openFence doc
            false => match length (trim body) == 0
                true => flushParagraph doc
                false => match isRule (trim body)
                    true => withBlock doc Divider
                    false => match level > 0
                        true => withBlock doc (Heading(major = level <= 2, spans = spans (trim (drop body level))))
                        false => match startsWith body "> " || body == ">"
                            true => withBlock doc (Quotation(spans = spans (drop body 2)))
                            false => match isItem body
                                true => listItem doc body
                                false => withParagraph doc (trim body)

    step doc text = match doc.mode == "code"
        true => codeMode doc text
        false => textMode doc text

    walk : Scan -> string -> Scan
    walk doc source = match length source == 0
        true => doc
        false =>
            cut = line source
            walk (step doc cut.head) cut.tail

    // An unclosed fence still renders as code rather than vanishing.
    finish doc = match doc.mode == "code"
        true => flushCode doc
        false => flushParagraph doc

    (** `source` as blocks; none when nothing renders. *)
    export render source =
        finished = finish (walk (Scan(blocks = [], paragraph = [], code = "", mode = "text")) source)
        finished.blocks
