// Implements [MOBILE-REACTIVE-HOST]: every accepted event yields immutable state.
namespace mobile

import bank::Json
import mobile::Model
import mobile::Github
import mobile::Storage
import mobile::View
import mobile::Annotations
import mobile::Text

type InboxUpdate =
    model : InboxModel
    commands : string

module Update
    result model commands = InboxUpdate(model = model, commands = commands)

    unchanged model = result model "[]"

    failure model message = unchanged (Model::set model "error" message)

    storageProblem model message = unchanged (Model::set model "storageError" message)

    // Run `step` only when `allowed`, otherwise report `message`.
    guarded model allowed message step = match allowed
        true => step
        false => failure model message

    pick allowed step fallback = match allowed
        true => step
        false => fallback

    nextSequence model = parseInt model.seq ?: 0

    // A host event's string field, empty when the host left it out.
    eventValue event key = Json::getOr event key ""

    export initial () = result (Model::initial ()) (perform Storage::Requests.sql (Storage::schema ()))

    fetch model = match checkedAdd (nextSequence model) 1
        Error why => failure model "Request counter exhausted. Close and reopen the app."
        Success sequence =>
            prepared = Model::set (Model::set (Model::set model "seq" (toString sequence)) "loading" "true") "error" ""
            pending = Model::set (Model::set prepared "pending" "fetch:${sequence}:${model.repo}") "status" "Refreshing ${model.repo}…"
            result pending (perform Storage::Requests.http (Storage::fetch pending))

    persist model = match model.dbReady == "true"
        false => storageProblem model "SQLite is unavailable; these changes are only in memory."
        true => match checkedAdd (nextSequence model) 1
            Error why => storageProblem model "Request counter exhausted; changes were not saved. Close and reopen the app."
            Success sequence =>
                pending = Model::set (Model::set model "seq" (toString sequence)) "write" "save:${sequence}"
                result pending (perform Storage::Requests.sql (Storage::save pending))

    ready model = Model::set (Model::set model "stage" "ready") "loading" "false"

    storageError model event = Model::set model "storageError" ("SQLite failed: " + Json::getOr event "error" "unknown database error")

    whenStorageOk model event next = match eventValue event "ok" == "true"
        false => unchanged (storageError (ready model) event)
        true => next model event

    schemaDone model _ = result (Model::set (Model::set (Model::set model "stage" "load") "dbReady" "true") "status" "Reading the SQLite cache…") (perform Storage::Requests.sql (Storage::load ()))

    schema model event = whenStorageOk model event schemaDone

    restore model source =
        cached = Storage::restore (ready model) source
        match cached.valid
            false => failure (Model::set (ready model) "status" "Cache needs a refresh") cached.error
            true => unchanged (Model::set cached.model "status" "Loaded from SQLite · refresh when ready")

    loadedDone model event =
        doc = jsonParse event ?: 0
        count = jsonLength doc "rows"
        freed = jsonFree doc ?: 0
        match count
            0 => fetch (ready model)
            1 => restore model (eventValue event "rows[0].value")
            _ => failure (ready model) "SQLite returned an invalid cache result. Refresh to replace it."

    loaded model event = whenStorageOk model event loadedDone

    savedResult model event = match eventValue event "ok" == "true"
        false => unchanged (storageError (Model::set model "write" "") event)
        true => unchanged (Model::set (Model::set model "write" "") "storageError" "")

    sql model event =
        id = eventValue event "id"
        idle = pick (length model.write > 0 && id == model.write) (savedResult model event) (unchanged model)
        pick (id == "load" && model.stage == "load") (loaded model event) (pick (id == "schema" && model.stage == "schema") (schema model event) idle)

    validSelection model = pick (length model.selected == 0 || View::exists model model.selected) model (Model::set model "selected" "")

    httpSuccess model event = match Github::parse (eventValue event "body")
        Error why => failure (Model::set model "status" "Refresh failed · cached issues retained") why
        Success items => persist (validSelection (Model::set (Model::set (Model::set model "items" items) "error" "") "status" "Open issues · synced with GitHub"))

    http model event = match length model.pending > 0 && eventValue event "id" == model.pending
        false => unchanged model
        true =>
            cleared = Model::set (Model::set model "pending" "") "loading" "false"
            status = parseInt (Json::getOr event "status" "0") ?: 0
            match status >= 200 && status < 300 && eventValue event "error" == ""
                true => httpSuccess cleared event
                false => failure (Model::set cleared "status" "Refresh failed · cached issues retained") (Github::responseError event)

    repository model raw =
        repo = trim raw
        match Github::validRepository repo
            false => failure model "Use owner/repository with letters, numbers, hyphens, underscores or dots."
            true => match repo == model.repo
                true => fetch model
                false => fetch (Model::set (Model::set (Model::set (Model::set model "repo" repo) "items" "[]") "pending" "") "selected" "")

    bookmark model id = match View::exists model id
        false => failure model "That issue is no longer in the current inbox. Refresh and try again."
        true =>
            marks = match View::saved model id
                true => replace model.saved ("|" + id + "|") "|" ?: model.saved
                false => model.saved + id + "|"
            persist (Model::set model "saved" marks)

    filter model value = guarded model (value == "all" || value == "saved") "Unknown inbox filter. Choose All or Saved." (unchanged (Model::set model "filter" value))

    annotate model id note priority = guarded model (View::exists model id && Annotations::capacity model.annotations id) "Cannot annotate this issue: it is missing or the 200-issue local note limit is reached." (persist (Model::set model "annotations" (Annotations::set model.annotations id note priority)))

    annotationEdit model event allowed message priorityEdit =
        id = eventValue event "id"
        value = eventValue event "value"
        current = Annotations::get model.annotations id
        match priorityEdit
            true => guarded model allowed message (annotate model id current.note value)
            false => guarded model allowed message (annotate model id value current.priority)

    note model event = annotationEdit model event (Text::within (eventValue event "value") 2000) "Keep local notes within 2000 characters." false

    priority model event = annotationEdit model event ((eventValue event "value") == "normal" || (eventValue event "value") == "high") "Choose Normal or High priority." true

    openIssue model id = guarded model (View::exists model id) "This issue is no longer in the inbox. Refresh to find current issues." (unchanged (Model::set model "selected" id))

    detailEvent model event = match eventValue event "type"
        "open" => openIssue model (eventValue event "id")
        "back" => unchanged (Model::set model "selected" "")
        "note" => note model event
        "priority" => priority model event
        _ => failure model "The host sent an unsupported inbox event."

    interaction model event = match eventValue event "type"
        "refresh" => fetch model
        "repository" => repository model (eventValue event "value")
        "search" => unchanged (Model::set model "search" (Text::prefix (eventValue event "value") 256))
        "filter" => filter model (Json::getOr event "value" "all")
        "bookmark" => bookmark model (eventValue event "id")
        _ => detailEvent model event

    export dispatch model event = match eventValue event "type"
        "sql" => sql model event
        "http" => http model event
        _ => match model.stage == "ready"
            true => interaction model event
            false => unchanged model
