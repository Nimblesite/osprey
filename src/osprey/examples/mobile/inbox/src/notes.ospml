// Implements [MOBILE-REACTIVE-UI]: a person's local triage — a note and a priority per issue —
// as a typed list, bounded to 200 issues, with the same rules on every host.
namespace inbox

import inbox::Text

(** One issue's local triage; an empty note at `normal` is no triage at all. *)
type Note =
    noteId : int
    noteText : string
    noteRank : string

module Notes
    plain = Note(noteId = 0, noteText = "", noteRank = "normal")

    findFrom : List<Note> -> int -> int -> Note
    findFrom notes id index = match listGet notes index
        Error _why => plain
        Success note => match note.noteId == id
            true => note
            false => findFrom notes id (satAdd index 1)

    (** The triage `id` carries, or an empty note at `normal` when it has none. *)
    export find notes id = findFrom notes id 0

    // The list without `id`'s triage, as a plain list for rebuilding.
    without : List<Note> -> int -> int -> List<Note>
    without notes id index = match listGet notes index
        Error _why => []
        Success note => match note.noteId == id
            true => without notes id (satAdd index 1)
            false => listAppend (without notes id (satAdd index 1)) note

    (** The list with `id`'s triage replaced; an empty note at `normal` removes it. *)
    export set notes id text rank = match text == "" && rank == "normal"
        true => without notes id 0
        false => listAppend (without notes id 0) (Note(noteId = id, noteText = text, noteRank = rank))

    validFrom : List<Note> -> int -> bool
    validFrom notes index = match listGet notes index
        Error _why => true
        Success note => note.noteId > 0 && Text::within note.noteText 2000 && (note.noteRank == "normal" || note.noteRank == "high") && validFrom notes (satAdd index 1)

    (** Every triage is well formed and the list is within the 200-issue bound. *)
    export valid notes = length notes <= 200 && validFrom notes 0

    (** Whether `id` may take a triage: the list has room, or it already has one. *)
    export room notes id = match length notes < 200
        true => true
        false => seated notes id

    seated notes id =
        present = find notes id
        present.noteText != "" || present.noteRank != "normal"
