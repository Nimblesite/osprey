// The Prism synth's voice ([UI-MACHINE-FLOW-SYNTH]): the signal-flow graph's
// inputs read as an oscillator, an LFO-swept low-pass filter and a master
// switch, rendered to an 8-bit mono WAV. Every sample is a pure function of
// the patch and its index, so a test inspects exactly what the speakers play.
namespace synth

import ui::Machines
import ui::Requests

(** What the graph asks the speakers for: the struck key's pitch in hertz, whether the oscillator, filter and master are on, the oscillator's wave, the filter's cutoff in hertz, the LFO's sweep depth from 0 to 1 and rate in hertz, and the master level from 0 to 1. *)
type Patch =
    pitch : float
    sounding : bool
    filtered : bool
    wave : string
    cutoff : float
    depth : float
    lfo : float
    audible : bool
    volume : float

(** Renders a patch and asks the host to play it. *)
module Synth
    (** Samples per second. *)
    export rate = 11025

    // Semitones above C of each natural note.
    naturals = ["C", "D", "E", "F", "G", "A", "B"]

    steps = [0, 2, 4, 5, 7, 9, 11]

    (** A key's pitch in equal temperament from its name, as the keyboard sets `note`: "A3" is 220 Hz, "C#4" is 277.18 Hz. *)
    export frequency note =
        sharp = contains note "#"
        semitone = listGet steps (ui::Lists::position (naturals, \n => n == take note 1)) ?: 9
        octave = parseFloat (drop note (ui::Pick::either (sharp, 2, 1))) ?: 3.0
        midi = 12.0 * (octave + 1.0) + toFloat semitone + ui::Pick::either (sharp, 1.0, 0.0)
        440.0 * pow (2.0, (midi - 69.0) / 12.0)

    (** How many octaves the LFO sweeps the cutoff each way at full depth. *)
    export octaves = 2.0

    (** Where a clip is written before the host plays it. *)
    export clipPath = "/tmp/osprey-synth.wav"

    tau = 6.283185307179586

    (** An LFO rate as a note length at 120 bpm, in hertz: a quarter note is 2 Hz. *)
    export hertz rate = match rate
        "1/1" => 0.5
        "1/2" => 1.0
        "1/8" => 4.0
        "1/16" => 8.0
        _ => 2.0

    (** The patch the machine's inputs describe: the Prism skin's Filter cutoff sweeps 20 Hz to 20 kHz, as its `expo:1:0.02:20` readout shows. *)
    export patch machine = Patch(pitch = frequency (Machines::text (machine, "note")), sounding = Machines::flag (machine, "sourceOn"), filtered = Machines::flag (machine, "processOn"), wave = Machines::text (machine, "wave"), cutoff = 20.0 * pow (1000.0, Machines::number (machine, "process")), depth = ui::Pick::either (Machines::flag (machine, "controlOn"), Machines::number (machine, "control"), 0.0), lfo = hertz (Machines::text (machine, "rate")), audible = Machines::flag (machine, "outputOn"), volume = Machines::number (machine, "volume"))

    (** A patch written out, so two patches compare by what they sound like. *)
    export describe p = "${toString p.pitch} ${toString p.sounding} ${toString p.filtered} ${p.wave} ${toString p.cutoff} ${toString p.depth} ${toString p.lfo} ${toString p.audible} ${toString p.volume}"

    (** Whether a patch makes no sound at all. *)
    export silent p = p.sounding == false || p.audible == false || p.volume <= 0.0

    // The cutoff at sample `n`, swept by the LFO.
    swept (p, n) = p.cutoff * pow (2.0, p.depth * octaves * sin (tau * p.lfo * toFloat n / toFloat rate))

    // A two-pole Butterworth low-pass's gain at the key's pitch.
    passed (p, n) = ui::Pick::either (p.filtered, 1.0 / sqrt (1.0 + pow (p.pitch / swept (p, n), 4.0)), 1.0)

    (** The wave from -1 to 1 at `turns` cycles, as the Oscillator draws it. *)
    export shaped (wave, turns) =
        t = turns - floor turns
        match wave
            "Triangle" => 1.0 - 4.0 * abs (t - 0.5)
            "Saw" => 2.0 * t - 1.0
            "Square" => ui::Pick::either (t < 0.5, 1.0, -1.0)
            _ => sin (tau * t)

    (** Sample `n` from -1 to 1. *)
    export sample (p, n) = ui::Pick::either (silent p, 0.0, p.volume * passed (p, n) * shaped (p.wave, p.pitch * toFloat n / toFloat rate))

    (** One second of the patch as unsigned 8-bit samples centred on 128. *)
    export samples p = mapList (toList (range (0, rate)), \n => satAdd 128 (floatToInt (round (sample (p, n) * 100.0)) ?: 0))

    (** The largest distance of any sample from silence. *)
    export peak values = foldList (values, 0, \(most, v) => ui::Pick::either (abs (v - 128) > most, abs (v - 128), most))

    digit d = substring "0123456789ABCDEF" d (satAdd d 1) ?: "0"

    byte b = "${digit (bitAnd (shiftRight b 4) 15)}${digit (bitAnd b 15)}"

    le16 n = "${byte (bitAnd n 255)}${byte (bitAnd (shiftRight n 8) 255)}"

    le32 n = "${le16 (bitAnd n 65535)}${le16 (bitAnd (shiftRight n 16) 65535)}"

    // "RIFF", "WAVE", "fmt ", "data" in ASCII hex.
    header count = "52494646${le32 (satAdd count 36)}57415645666D7420${le32 16}${le16 1}${le16 1}${le32 rate}${le32 rate}${le16 1}${le16 8}64617461${le32 count}"

    (** The samples as a mono 8-bit PCM WAV file, in hex. *)
    export wav values = "${header (length values)}${join (mapList (values, byte)) ""}"

    // Writes the clip from hex and replaces itself with afplay, so the host owns one process per clip.
    script = "open my $f, '>', $ARGV[1] or exit 1; binmode $f; print $f pack('H*', $ARGV[0]); close $f; exec '/usr/bin/afplay', $ARGV[1]"

    (** The host request that plays a patch: none for a silent one. *)
    export played p = match silent p
        true => []
        false => [Requests::ask ("play", ui::Run(executable = "/usr/bin/perl", arguments = ["-e", script, wav (samples p), clipPath], timeout = 5000, outputLimit = 4096, plist = false, runSlice = "synth-play"))]
