// [PRISM-ROUTING-EDITOR] Every host sends the same typed actions to the modular editor.
namespace synth

import ui::Runtime
import ui::Messages

(** The modular graph editor's host-independent application boundary. *)
module EditorApp
    initial context = match length (filterList (context.arguments, \arg => arg == "--empty")) > 0
        true => Runtime::step (EditorState::initial ())
        false => Runtime::step (EditorState::preset ())

    tapped (context, editor, action) = match action
        Audition => Preview::play (editor, context.platform)
        _ => Runtime::step (EditorState::tapped (editor, action))

    typed (editor, action, value) = Runtime::step (EditorState::typed (editor, action, value))

    update (context, editor, message) = Messages::route (message, \action => tapped (context, editor, action), \(action, value) => typed (editor, action, value), \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \(ticket, outcome) => Preview::completed (editor, ticket, outcome), \_ => Runtime::step editor, \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \_ => Runtime::step editor, \(_, _) => Runtime::step editor)

    (** Native controls and the canvas observe the same typed graph and applied edit revision. *)
    export program () = ui::Program(programInit = initial, programUpdate = update, programRender = EditorView::regions, programTheme = \_ => EditorView::theme ())
