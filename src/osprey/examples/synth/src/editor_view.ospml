// [PRISM-ROUTING-EDITOR] Native controls and the canvas share the same typed graph snapshot.
namespace synth

import ui::Ui
import ui::Keyed
import ui::Scenes

(** The modular patch's component menu, canvas, ports and parameter inspector. *)
module EditorView
    editorSlice () = perform Signal<Editor<Graph, GraphPending<Graph, ProcessorMemory<KernelState>>, GraphState<ProcessorMemory<KernelState>>, ui::Machine>>.read ()

    processorTitle processor = match processor
        Granular _ _ _ => "Grain cloud"
        Lfo => "LFO"
        ModulatedGain => "Modulated gain"
        MidiNotes => "MIDI notes"
        Stereo => "Mono to stereo"
        Oscillator => "Oscillator"
        Filter => "Filter"
        Amplifier => "Gain"
        Mixer => "Mixer"
        Sink => "Output"
        Delay _ => "Delay"
        External identifier => identifier

    componentName (editor, n) = match listGet (filterList (editor.pluginBindings, \binding => binding.pluginNode == n.identity)) 0
        Success binding => "${binding.pluginName} ${n.identity}"
        Error _ => "${processorTitle n.processor} ${n.identity}"

    plugins editor = Ui::column [Ui::field ("VST3 bundle", editor.pluginPath, "Path to a .vst3 bundle", PluginPath), Ui::button ("Scan VST3", "", ScanVst), Ui::picker ("Add VST3", mapList (editor.catalog, \entry => Ui::choice (entry.classId, entry.className)), "", CreateVst(identifier = ""))]

    menu () = Ui::picker ("Add component", mapList (EditorState::kinds, \kind => Ui::choice (kind, EditorState::title kind)), "", Add(kind = ""))

    sourcePort (n, index) = match listGet n.outputs index
        Error _ => Ui::caption "Output port unavailable"
        Success port => Ui::button ("Use ${port.name} output", "external", Source(identity = n.identity, outlet = index))

    inputName (n, port) = match (port.rate == Control)
        false => port.name
        true => match listGet (filterList (n.parameters, \p => p.key == port.name)) 0
            Error _ => port.name
            Success p => p.label

    inputPort (n, index) = match listGet n.inputs index
        Error _ => Ui::caption "Input port unavailable"
        Success port => Ui::column [Ui::caption (inputName (n, port)), Ui::column [Ui::button ("Connect ${inputName (n, port)}", "", Connect(identity = n.identity, inlet = index)), Ui::button ("Disconnect ${inputName (n, port)}", "", Disconnect(identity = n.identity, inlet = index))]]

    parameter (n, p) =
        field = Ui::field (p.label, "${p.initial}", "${p.minimum} to ${p.maximum}", EditParameter(identity = n.identity, key = p.key))
        match n.processor
            External _ => match p.automatable
                true => Ui::column [field, Ui::button ("Modulate ${p.label}", "", Modulate(identity = n.identity, key = p.key))]
                false => Ui::pair (p.label, "${p.initial} (read-only)")
            _ => field

    ports n = listConcat (mapList (toList (range (0, length n.outputs)), \index => sourcePort (n, index))) (mapList (toList (range (0, length n.inputs)), \index => inputPort (n, index)))

    component n =
        parameters = match (length n.parameters == 0)
            true => []
            false => [Ui::section ("Parameters", "", mapList (n.parameters, \p => parameter (n, p)))]
        Ui::column (listConcat parameters [Ui::section ("Connections", "", ports n), Ui::action ("Remove module", "delete", ui::Destructive, true, Remove)])

    x index = index.layoutX

    y index = index.layoutY

    portRate (editor, index, output, port) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => Audio
        Valid n => match listGet (ui::Pick::either (output, n.outputs, n.inputs)) port
            Error _ => Audio
            Success p => p.rate

    halfWidth (editor, index) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => 146.0
        Valid n => match n.processor
            Oscillator => 138.5
            Lfo => 123.0
            Sink => 141.0
            Amplifier => 141.0
            ModulatedGain => 141.0
            _ => 146.0

    (** Whether a graph node exists and runs the given processor. *)
    export runs (editor, identity, processor) = match Graphs::node (editor.graph, identity)
        Invalid _ => false
        Valid n => structuralEquals (n.processor, processor)

    isFilter (editor, index) = runs (editor, index.layoutNode, Filter)

    sink (editor, index) = runs (editor, index.layoutNode, Sink)

    (** Horizontal position of a real graph socket. *)
    export portX (editor, index, output, port) = match sink (editor, index)
        true => x index - 2.0
        false => ordinaryPortX (editor, index, output, port)

    ordinaryPortX (editor, index, output, port) = match (portRate (editor, index, output, port) == Control)
        true => x index + ui::Pick::either (isFilter (editor, index), -1.0, 1.0)
        false => match output
            true => x index + halfWidth (editor, index)
            false => x index - halfWidth (editor, index)

    (** Vertical position of a real graph socket. *)
    export portY (editor, index, output, port) = match sink (editor, index)
        true => y index - 81.0
        false => ordinaryPortY (editor, index, output, port)

    ordinaryPortY (editor, index, output, port) = match (portRate (editor, index, output, port) == Control)
        true => match output
            true => y index + 78.0
            false => y index - ui::Pick::either (isFilter (editor, index), 87.0, 88.0)
        false => y index + audioOffset (editor, index) + toFloat port * 24.0

    audioOffset (editor, index) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => 0.0
        Valid n => match n.processor
            Filter => 6.0
            Oscillator => -0.5
            _ => 1.5

    indices ports = toList (range (0, length ports))

    (** Consistent audio, modulation and event cable colours. *)
    export ink rate = match rate
        Control => Scenes::rgb (191, 126, 250)
        Events => Scenes::rgb (81, 225, 215)
        Audio => Scenes::rgb (255, 132, 66)

    portShapes (editor, index, ports, output) = foldList (indices ports, [], \(all, port) =>
        match listGet ports port
            Error _ => all
            Success p => listConcat all [Scenes::disc (portX (editor, index, output, port), portY (editor, index, output, port), 9.0, ink p.rate, 6), Scenes::disc (portX (editor, index, output, port), portY (editor, index, output, port), 6.0, Scenes::rgb (16, 13, 33), 7)])

    (** A named canvas hit area shared with native accessibility. *)
    export accessible (label, left, top, width, height, selected) = ui::Accessible(accessRole = ui::Pressable, accessLabel = label, accessLeft = left, accessTop = top, accessWidth = width, accessHeight = height, accessValue = 0.0, accessMin = 0.0, accessMax = 0.0, accessMovable = false, accessSelected = selected)

    portLabel output = match output
        true => "output"
        false => "input"

    portAccess (editor, n, index, ports, output) = mapList (indices ports, \port => accessible ("Canvas ${portLabel output} ${n.identity}:${port}", portX (editor, index, output, port) - 10.0, portY (editor, index, output, port) - 10.0, 20.0, 20.0, false))

    nodeAccess (editor, n) =
        index = EditorLayout::position (editor, n.identity)
        listConcat [accessible ("Canvas ${componentName (editor, n)}", x index - 120.0, y index - 78.0, 240.0, 156.0, editor.selected == n.identity)] (listConcat (portAccess (editor, n, index, n.inputs, false)) (portAccess (editor, n, index, n.outputs, true)))

    (** Inclusive bounds for canvas hit testing. *)
    export inside (px, py, cx, cy, halfWidth, halfHeight) = px >= cx - halfWidth && px <= cx + halfWidth && py >= cy - halfHeight && py <= cy + halfHeight

    (** Resolve a pointer to a declared socket, never decorative artwork. *)
    export hitPort (editor, index, ports, output, px, py) = listGet (filterList (indices ports, \port => inside (px, py, portX (editor, index, output, port), portY (editor, index, output, port), 10.0, 10.0))) 0

    nodeOrder editor = listConcat (filterList (editor.graph.nodes, \n => n.identity != editor.selected)) (filterList (editor.graph.nodes, \n => n.identity == editor.selected))

    (** Hit testing follows complete card layers, so covered controls cannot steal a click. *)
    export nodeAt (editor, px, py) = foldList (nodeOrder editor, -1, \(found, n) =>
        at = EditorLayout::position (editor, n.identity)
        ui::Pick::either (inside (px, py, x at, y at, halfWidth (editor, at) + 12.0, 90.0), n.identity, found))

    hitNode (editor, n, px, py) = match CableCanvas::monitorAt (editor, n, px, py)
        true => CableCanvas::begin (editor, n.identity, 0, px, py, true)
        false => ordinaryNode (editor, n, px, py)

    ordinaryNode (editor, n, px, py) =
        index = EditorLayout::position (editor, n.identity)
        match hitPort (editor, index, n.outputs, true, px, py)
            Success port => CableCanvas::begin (editor, n.identity, port, px, py, false)
            Error _ => match hitPort (editor, index, n.inputs, false, px, py)
                Success port => EditorState::tapped (editor, Connect(identity = n.identity, inlet = port))
                Error _ => match inside (px, py, x index, y index, 120.0, 78.0)
                    true => EditorLayout::begin (editor, n.identity, px, py)
                    false => editor

    paletteHit py = listGet (filterList (toList (range (0, length EditorState::kinds)), \i => py >= CanvasGeometry::paletteY (toFloat i) - 18.0 && py <= CanvasGeometry::paletteY (toFloat i) + 18.0)) 0

    (** The open library owns its rectangle, including controls covered by its overlay. *)
    export paletteAt (editor, px, py) = editor.paletteShown && px >= 0.0 && px < 196.0 && py >= 66.0 && py < 774.0

    placeAdded editor =
        candidates = mapList (toList (range (0, 9)), \i => NodePosition(layoutNode = editor.selected, layoutX = CanvasGeometry::gridX (toFloat (i % 3)), layoutY = CanvasGeometry::gridY (toFloat (intDiv i 3))))
        occupied = mapList (filterList (editor.graph.nodes, \n => n.identity != editor.selected), \n => EditorLayout::position (editor, n.identity))
        empty = filterList (candidates, \at => length (filterList (occupied, \other => inside (x at, y at, x other, y other, 300.0, 210.0))) == 0)
        at = listGet empty 0 ?: EditorLayout::position (editor, editor.selected)
        editor(positions = listAppend editor.positions at, paletteShown = false)

    dropModule (editor, px, py) =
        kind = editor.paletteDrag
        released = editor(paletteDrag = "")
        match paletteAt (editor, px, py)
            true => match paletteHit py
                Success i => match (listGet EditorState::kinds i ?: "") == kind
                    true => clicked (released, kind)
                    false => released
                Error _ => released
            false => dropped (released, kind, px, py)

    clicked (editor, kind) =
        added = EditorState::tapped (editor, Add(kind = kind))
        match added.nextIdentity > editor.nextIdentity
            false => added
            true => placeAdded added

    dropped (editor, kind, px, py) = match px >= 205.0 && CanvasGeometry::valid (px, py)
            false => editor
            true =>
                added = EditorState::tapped (editor, Add(kind = kind))
                match added.nextIdentity > editor.nextIdentity
                    false => added
                    true => EditorLayout::drag (added(dragging = added.selected, paletteShown = false, grabX = 0.0, grabY = 0.0), px, py, false)

    (** Palette drops, card dragging and cable edits all change the same patch. *)
    export pointed (editor, px, py, down) = match editor.wireDragging
        true => CableCanvas::drag (editor, px, py, down)
        false => ordinaryPointer (editor, px, py, down)

    ordinaryPointer (editor, px, py, down) = match editor.paletteDrag != ""
        true => match down
            true => editor
            false => dropModule (editor, px, py)
        false => match editor.dragging >= 0
            true => EditorLayout::drag (editor, px, py, down)
            false => match down
                false => editor
                true => match paletteAt (editor, px, py)
                    true => match paletteHit py
                        Error _ => editor
                        Success i => editor(paletteDrag = listGet EditorState::kinds i ?: "")
                    false => match Graphs::node (editor.graph, nodeAt (editor, px, py))
                        Invalid _ => CableCanvas::selected (editor, px, py)
                        Valid n => hitNode (editor, n, px, py)

    // Prism's rounded panel, shared by cards and palette rows.
    (** Prism's rounded panel shared with contextual cable controls. *)
    export panel (left, top, width, height, colour, depth) = paintedPanel (left, top, width, height, ui::Solid(tint = Scenes::hex (colour, 1.0)), depth)

    paintedPanel (left, top, width, height, paint, depth) =
        right = left + width
        bottom = top + height
        steps = [ui::MoveTo(toX = left + 10.0, toY = top), ui::LineTo(toX = right - 10.0, toY = top), ui::CurveTo(toX = right, toY = top + 10.0, ctrlX = right, ctrlY = top), ui::LineTo(toX = right, toY = bottom - 10.0), ui::CurveTo(toX = right - 10.0, toY = bottom, ctrlX = right, ctrlY = bottom), ui::LineTo(toX = left + 10.0, toY = bottom), ui::CurveTo(toX = left, toY = bottom - 10.0, ctrlX = left, ctrlY = bottom), ui::LineTo(toX = left, toY = top + 10.0), ui::CurveTo(toX = left + 10.0, toY = top, ctrlX = left, ctrlY = top), ui::Close]
        Scenes::path (steps, ui::Fill, paint, depth)

    (** Shared canvas text styling for nodes and cable actions. *)
    export text (words, left, top, size, colour, depth) = Scenes::lettering (words, left, top, size, Scenes::rgb (colour, colour, 255), 0, 500.0, depth)

    shape (editor, n) =
        at = EditorLayout::position (editor, n.identity)
        listConcat (listConcat (listConcat (nodeArtwork (editor, n, at)) (cardTitle (editor, n, at))) (monitorTrace (editor, n, at))) (listConcat (portShapes (editor, at, n.inputs, false)) (portShapes (editor, at, n.outputs, true)))

    nodeArtwork (editor, n, at) = match n.processor
        Granular samples _ _ => listConcat (moduleCard (editor, n, at)) (grainTrace (samples, at))
        Oscillator => PrismArt::card (editor, n)
        Lfo => PrismArt::card (editor, n)
        Filter => PrismArt::card (editor, n)
        Amplifier => PrismArt::card (editor, n)
        ModulatedGain => PrismArt::card (editor, n)
        Sink => PrismArt::card (editor, n)
        _ => moduleCard (editor, n, at)

    moduleCard (editor, n, at) =
        border = ui::Pick::either (editor.selected == n.identity, 16745538, 6246296)
        paint = ui::Linear(angle = 90.0, from = Scenes::hex (2364225, 1.0), fromAt = 0.0, to = Scenes::hex (1117472, 1.0), toAt = 1.0, oklab = false)
        caption = match n.processor
            Granular _ _ _ => ""
            _ => match listGet n.parameters 0
                Error _ => "${length n.inputs} inputs · ${length n.outputs} outputs"
                Success p => "${p.label}: ${p.initial}"
        returnShapes = [panel (x at - 146.0, y at - 87.0, 292.0, 174.0, border, 2), paintedPanel (x at - 144.0, y at - 85.0, 288.0, 170.0, paint, 3), text (componentName (editor, n), x at - 124.0, y at - 67.0, 18.0, 238, 5), panel (x at - 124.0, y at - 27.0, 248.0, 64.0, 986652, 4), text (caption, x at - 108.0, y at - 3.0, 14.0, 190, 5), text ("Edit in Patch controls", x at - 124.0, y at + 58.0, 12.0, 155, 5)]
        returnShapes

    grainTrace (samples, at) = [Scenes::strip (foldList (toList (range (0, 48)), [], \(points, index) =>
        match floatToInt (CanvasGeometry::grainIndex (toFloat index, toFloat (length samples)))
            Error _ => points
            Success source => match listGet samples source
                Error _ => points
                Success value => listConcat points [CanvasGeometry::grainX (x at, toFloat index), CanvasGeometry::waveY (y at + 5.0, value)]), Scenes::rgb (80, 229, 216), 2.0, 6), text ("Built-in harmonic sample", x at - 120.0, y at - 34.0, 11.0, 190, 7)]

    cardTitle (editor, n, at) = [text (componentName (editor, n), x at - 120.0, y at - 104.0, 11.0, 160, 8)]

    monitorTrace (editor, n, at) = match n.processor == Sink && length editor.scopeSamples > 1
        false => []
        true => [Scenes::strip (foldList (toList (range (0, length editor.scopeSamples)), [], \(points, i) =>
            match listGet editor.scopeSamples i
                Error _ => points
                Success value => listConcat points [CanvasGeometry::waveX (x at, toFloat i), CanvasGeometry::waveY (y at, value)]), Scenes::rgb (80, 229, 216), 2.5, 6)]

    customInspector editor = match Graphs::node (editor.graph, editor.selected)
        Invalid _ => []
        Valid n => match PrismArt::role n.processor == "custom"
            false => []
            true => listConcat [Scenes::rect (rightX (editor, 1374.0), 266.0, 304.0, 330.0, 0.0, Scenes::rgb (19, 17, 35), 7), text (componentName (editor, n), rightX (editor, 1234.0), 128.0, 24.0, 240, 8), text ("Parameters", rightX (editor, 1234.0), 290.0, 16.0, 210, 8), text ("Edit in Patch controls", rightX (editor, 1234.0), 250.0, 13.0, 170, 8)] (foldList (toList (range (0, ui::Pick::either (length n.parameters < 4, length n.parameters, 4))), [], \(all, i) =>
                match listGet n.parameters i
                    Error _ => all
                    Success p => listAppend all (text ("${p.label}: ${p.initial}", rightX (editor, 1234.0), 325.0 + toFloat i * 32.0, 14.0, 210, 8))))

    connectionRows editor = foldList (toList (range (0, length (filterList (editor.graph.cables, \c => c.source == editor.selected || c.destination == editor.selected)))), [], \(all, i) =>
        match listGet (filterList (editor.graph.cables, \c => c.source == editor.selected || c.destination == editor.selected)) i
            Error _ => all
            Success c =>
                incoming = c.destination == editor.selected
                other = match incoming
                    true => c.source
                    false => c.destination
                label = match Graphs::node (editor.graph, other)
                    Invalid _ => "Missing component"
                    Valid n => componentName (editor, n)
                direction = match incoming
                    true => "In   ←"
                    false => "Out  →"
                listConcat all [Scenes::disc (rightX (editor, 1243.0), 497.0 + toFloat i * 36.0, 8.0, Scenes::rgb (255, 132, 66), 6), text ("${direction}  ${label}", rightX (editor, 1264.0), 488.6 + toFloat i * 36.0, 14.0, 230, 6)])

    palette () = listConcat [Scenes::rect (98.0, 420.0, 196.0, 708.0, 0.0, Scenes::rgb (19, 16, 36), 20), text ("MODULES", 18.0, 82.0, 15.0, 166, 22), text ("Click or drag to add", 18.0, 104.0, 12.0, 135, 22)] (foldList (toList (range (0, length EditorState::kinds)), [], \(all, i) => listConcat all [panel (12.0, CanvasGeometry::paletteY (toFloat i) - 17.0, 172.0, 35.0, 2563389, 21), text (EditorState::title (listGet EditorState::kinds i ?: ""), 22.0, CanvasGeometry::paletteY (toFloat i) - 8.0, 12.0, 224, 22)]))

    paletteAccess () = mapList (toList (range (0, length EditorState::kinds)), \i => accessible ("Add ${EditorState::title (listGet EditorState::kinds i ?: "")}", 12.0, CanvasGeometry::paletteY (toFloat i) - 17.0, 172.0, 35.0, false))

    toolbar () = [text ("Modules", 380.0, 25.0, 16.0, 236, 12), text ("Patch controls", 500.0, 25.0, 16.0, 236, 12), text ("Audition", 680.0, 25.0, 16.0, 236, 12), text ("Play", 800.0, 25.0, 16.0, 236, 12), text ("Stop", 880.0, 25.0, 16.0, 236, 12), text ("Keyboard", 950.0, 25.0, 16.0, 236, 12)]

    toolbarItems () = [accessible ("Modules", 370.0, 10.0, 110.0, 45.0, false), accessible ("Patch controls", 490.0, 10.0, 170.0, 45.0, false), accessible ("Audition patch", 670.0, 10.0, 110.0, 45.0, false), accessible ("Play patch", 790.0, 10.0, 70.0, 45.0, false), accessible ("Stop playback", 870.0, 10.0, 70.0, 45.0, false), accessible ("Keyboard", 940.0, 10.0, 120.0, 45.0, false), accessible ("Undo", 1108.0, 15.0, 40.0, 37.0, false), accessible ("Redo", 1160.0, 15.0, 40.0, 37.0, false)]

    rightX (editor, base) = CanvasGeometry::shifted (base, ui::Machines::number (editor.skin, "spareWidth"))

    toolbarAccess editor = mapList (toolbarItems (), \area =>
        match area.accessLabel == "Undo" || area.accessLabel == "Redo"
            true => area(accessLeft = rightX (editor, area.accessLeft))
            false => area)

    (** Header commands retain the same action path as native controls. *)
    export toolbarAction index = match index
        0 => ShowModules
        1 => ShowDetails
        2 => Audition
        3 => PlayGraph
        4 => StopGraph
        6 => Undo
        7 => Redo
        _ => ShowKeyboard

    (** Match the compact command hit boxes in the original header. *)
    export toolbarAt (editor, x, y) = listGet (filterList (toList (range (0, 8)), \i =>
        match listGet (toolbarAccess editor) i
            Error _ => false
            Success a => x >= a.accessLeft && x <= a.accessLeft + a.accessWidth && y >= a.accessTop && y <= a.accessTop + a.accessHeight)) 0

    raised (primitive, offset) = match primitive
        ui::Rect x y w h angle colour depth => ui::Rect(x = x, y = y, w = w, h = h, angle = angle, color = colour, depth = satAdd depth offset)
        ui::Disc x y radius colour depth => ui::Disc(x = x, y = y, radius = radius, color = colour, depth = satAdd depth offset)
        ui::Strip points colour stroke depth => ui::Strip(points = points, color = colour, stroke = stroke, depth = satAdd depth offset)
        ui::Sprite sprite x y w h angle colour depth => ui::Sprite(sprite = sprite, x = x, y = y, w = w, h = h, angle = angle, color = colour, depth = satAdd depth offset)
        ui::Glyphs words x y size colour depth => ui::Glyphs(glyphs = words, x = x, y = y, size = size, color = colour, depth = satAdd depth offset)
        ui::Lettering words x y size colour depth anchor weight => ui::Lettering(letters = words, x = x, y = y, size = size, color = colour, depth = satAdd depth offset, anchor = anchor, weight = weight)
        ui::Path steps outline paint x y scale depth => ui::Path(steps = steps, outline = outline, paint = paint, moveX = x, moveY = y, scale = scale, depth = satAdd depth offset)

    canvas editor =
        ordered = nodeOrder editor
        nodes = foldList (toList (range (0, length ordered)), [], \(all, i) =>
            match listGet ordered i
                Error _ => all
                Success n => listConcat all (mapList (shape (editor, n), \primitive => raised (primitive, satMul (satAdd i 1) 100))))
        library = match editor.paletteShown || editor.paletteDrag != ""
            true => mapList (palette (), \primitive => raised (primitive, satMul (satAdd (length ordered) 1) 100))
            false => []
        details = match editor.detailsShown
            true => []
            false => listConcat (customInspector editor) (connectionRows editor)
        shapes = listConcat (listConcat (PrismArt::background editor) details) (listConcat (CableCanvas::shapes editor) (listConcat nodes (listConcat (listAppend (toolbar ()) (text (editor.message, 32.0, 767.0, 12.0, 170, 12))) library)))
        scene = Ui::zoomed (0.75, ui::Pick::either (editor.detailsShown, 1212.0, 1536.0), 828.0, PrismArt::atlas editor.skin, shapes, Surface)
        access = listConcat (toolbarAccess editor) (foldList (editor.graph.nodes, [], \(all, n) => listConcat all (listConcat (nodeAccess (editor, n)) (PrismArt::sliders (editor, n)))))
        extra = match editor.paletteShown
            true => paletteAccess ()
            false => []
        Ui::described (scene, listConcat (listConcat access (CableCanvas::access editor)) extra)

    inspector editor =
        style = ui::Frames::inset (16, 12, 16, 12)
        selected = filterList (editor.graph.nodes, \n => n.identity == editor.selected)
        chooser = Ui::picker ("Module", mapList (editor.graph.nodes, \n => Ui::choice ("${n.identity}", componentName (editor, n))), "${editor.selected}", Select(identity = -1))
        heading = Ui::row [Ui::styled ("Patch", ui::Heading, ui::Primary), ui::Spacer, Ui::button ("Close", "dismiss", ShowDetails)]
        transport = Ui::row [Ui::button ("Audition", "", Audition), Ui::action ("Play", "", ui::Prominent, true, PlayGraph), Ui::button ("Stop", "", StopGraph)]
        local = theme ()
        Ui::themed (local(spacing = [4, 8, 8, 16, 24, 32]), Ui::framed (style(frameTextSize = 12, frameControlHeight = 28), Ui::column (listConcat [heading, transport, Ui::caption editor.message, chooser] (listConcat (mapList (selected, component)) [Ui::section ("Add to patch", "", [menu (), plugins editor])]))))

    keyboardDock editor =
        dock = PrismArt::keyboardEditor editor
        closeX = editor.keyboardWidth - 156.0
        marks = listAppend (PrismArt::deck dock) (text ("Close keyboard ×", closeX + 8.0, 8.0, 14.0, 190, 12))
        keys = mapList (PrismArt::keyboardAccess dock, \key => key(accessTop = key.accessTop - 828.0))
        access = listAppend keys (accessible ("Close keyboard", closeX, 0.0, 150.0, 32.0, false))
        style = ui::Frames::plain
        Ui::framed (style(frameHeight = 135), Ui::described (Ui::zoomed (0.75, 1536.0, 180.0, PrismArt::atlas editor.skin, marks, Keyboard), access))

    root () =
        editor = editorSlice ()
        pane = match editor.detailsShown
            false => canvas editor
            true => Ui::aside (canvas editor, ui::Trailing, inspector editor, 280, Surface)
        grow = ui::Frames::plain
        workspace = Ui::framed (grow(frameGrow = true), pane)
        match editor.keyboardShown
            false => workspace
            true => Ui::column [workspace, keyboardDock editor]

    stamp editor = JsonString "${editor.revision}:${editor.layoutRevision}:${editor.selected}:${editor.source}:${editor.outlet}:${editor.wireDragging}:${editor.wireMonitor}:${editor.wireX}:${editor.wireY}:${editor.selectedCable}:${editor.message}:${editor.pluginPath}:${editor.pluginSerial}:${length editor.catalog}:${editor.note}:${editor.armedNote}:${editor.paletteDrag}:${editor.paletteShown}:${editor.detailsShown}:${editor.keyboardShown}:${editor.keyboardWidth}:${length editor.scopeSamples}"

    (** One coherent Signal rebuilds native and canvas controls after an accepted command. *)
    export regions (before, editor, frames, _) =
        handle static Signal<Editor<Graph, GraphPending<Graph, ProcessorMemory<KernelState>>, GraphState<ProcessorMemory<KernelState>>, ui::Machine>>
            read => editor
        changed = signalChanges before editor stamp (signalDependencies editorSlice)
        [Keyed::region (frames, "root", changed, root)]

    token (name, light, dark) = ui::Token(tokenName = name, tokenLight = light, tokenDark = dark)

    (** Prism's theme is independent of a fixed machine document. *)
    export theme () = ui::Theme(tokens = [token ("button", "#E6DFF5", "#29213F"), token ("buttonText", "#201630", "#F2EDFF"), token ("accent", "#6944BA", "#BA9EFF"), token ("caution", "#986400", "#FFCD75"), token ("good", "#14776F", "#4FDAD3"), token ("danger", "#BE294B", "#FF7892"), token ("background", "#F4EFFB", "#100D21"), token ("text", "#201630", "#F2EDFF")], spacing = [4, 0, 12, 20, 28, 36], feedback = 120, settle = 220)
