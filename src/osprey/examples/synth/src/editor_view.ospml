// [PRISM-ROUTING-EDITOR] Native controls and the canvas share the same typed graph snapshot.
namespace synth

import ui::Ui
import ui::Keyed
import ui::Scenes

(** The modular patch's component menu, canvas, ports and parameter inspector. *)
module EditorView
    editorSlice () = perform Signal<Editor<Graph>>.read ()

    processorTitle processor = match processor
        Oscillator => "Oscillator"
        Filter => "Filter"
        Amplifier => "Gain"
        Mixer => "Mixer"
        Sink => "Output"
        Delay _ => "Delay"
        External identifier => identifier

    componentName (editor, n) = match listGet (filterList (editor.pluginBindings, \binding => binding.pluginNode == n.identity)) 0
        Success binding => "${binding.pluginName} ${n.identity}"
        Error _ => "${processorTitle n.processor} ${n.identity}"

    plugins editor = Ui::row [Ui::field ("VST3 bundle", editor.pluginPath, "Path to a .vst3 bundle", PluginPath), Ui::button ("Scan VST3", "", ScanVst), Ui::picker ("Add VST3", mapList (editor.catalog, \entry => Ui::choice (entry.classId, entry.className)), "", CreateVst(identifier = ""))]

    menu () = Ui::picker ("Add component", mapList (EditorState::kinds, \kind => Ui::choice (kind, EditorState::title kind)), "", Add(kind = ""))

    sourcePort (n, index) = match listGet n.outputs index
        Error _ => Ui::caption "Output port unavailable"
        Success port => Ui::button ("Source ${n.identity}: ${port.name}", "", Source(identity = n.identity, outlet = index))

    inputPort (n, index) = match listGet n.inputs index
        Error _ => Ui::caption "Input port unavailable"
        Success port => Ui::row [Ui::button ("Connect ${n.identity}: ${port.name}", "", Connect(identity = n.identity, inlet = index)), Ui::button ("Disconnect ${n.identity}: ${port.name}", "", Disconnect(identity = n.identity, inlet = index))]

    parameter (n, p) = Ui::field ("${n.identity}: ${p.label}", "${p.initial}", "${p.minimum} to ${p.maximum}", EditParameter(identity = n.identity, key = p.key))

    ports n = listConcat (mapList (toList (range (0, length n.outputs)), \index => sourcePort (n, index))) (mapList (toList (range (0, length n.inputs)), \index => inputPort (n, index)))

    component (editor, n) = Ui::section (componentName (editor, n), "", listConcat [Ui::button ("Select ${n.identity}", "", Select(identity = n.identity))] (listConcat (ports n) (mapList (n.parameters, \p => parameter (n, p)))))

    indexOf (graph, identity) = ui::Lists::position (graph.nodes, \n => n.identity == identity)

    x index = 100.0 + toFloat (index % 4) * 210.0

    y index = 65.0 + toFloat (intDiv index 4) * 130.0

    portX (index, output) = match output
        true => x index + 85.0
        false => x index - 85.0

    portY (index, port) = y index + toFloat port * 20.0

    indices ports = toList (range (0, length ports))

    portShapes (index, ports, output) = mapList (indices ports, \port => Scenes::disc (portX (index, output), portY (index, port), 7.0, Scenes::rgb (79, 218, 211), 3))

    accessible (label, left, top, width, height, selected) = ui::Accessible(accessRole = ui::Pressable, accessLabel = label, accessLeft = left, accessTop = top, accessWidth = width, accessHeight = height, accessValue = 0.0, accessMin = 0.0, accessMax = 0.0, accessMovable = false, accessSelected = selected)

    portLabel output = match output
        true => "output"
        false => "input"

    portAccess (n, index, ports, output) = mapList (indices ports, \port => accessible ("Canvas ${portLabel output} ${n.identity}:${port}", portX (index, output) - 10.0, portY (index, port) - 10.0, 20.0, 20.0, false))

    nodeAccess (editor, n) =
        index = indexOf (editor.graph, n.identity)
        listConcat [accessible ("Canvas ${componentName (editor, n)}", x index - 70.0, y index - 35.0, 140.0, 70.0, editor.selected == n.identity)] (listConcat (portAccess (n, index, n.inputs, false)) (portAccess (n, index, n.outputs, true)))

    inside (px, py, cx, cy, halfWidth, halfHeight) = px >= cx - halfWidth && px <= cx + halfWidth && py >= cy - halfHeight && py <= cy + halfHeight

    hitPort (index, ports, output, px, py) = listGet (filterList (indices ports, \port => inside (px, py, portX (index, output), portY (index, port), 10.0, 10.0))) 0

    hitNode (editor, n, px, py) =
        index = indexOf (editor.graph, n.identity)
        match hitPort (index, n.outputs, true, px, py)
            Success port => EditorState::tapped (editor, Source(identity = n.identity, outlet = port))
            Error _ => match hitPort (index, n.inputs, false, px, py)
                Success port => EditorState::tapped (editor, Connect(identity = n.identity, inlet = port))
                Error _ => match inside (px, py, x index, y index, 70.0, 35.0)
                    true => EditorState::tapped (editor, Select(identity = n.identity))
                    false => editor

    (** Canvas ports use the same checked commands as native controls. *)
    export pointed (editor, px, py, down) = match down
        false => editor
        true => foldList (editor.graph.nodes, editor, \(current, n) => hitNode (current, n, px, py))

    shape (editor, n) =
        index = indexOf (editor.graph, n.identity)
        fill = match editor.selected == n.identity
            true => Scenes::rgb (88, 59, 164)
            false => Scenes::rgb (40, 34, 66)
        listConcat (listConcat (portShapes (index, n.inputs, false)) (portShapes (index, n.outputs, true))) [Scenes::rect (x index, y index, 170.0, 80.0, 12.0, fill, 1), Scenes::glyphs (componentName (editor, n), x index - 68.0, y index - 8.0, 14.0, Scenes::rgb (242, 237, 255), 2)]

    wire (graph, cable) =
        source = indexOf (graph, cable.source)
        destination = indexOf (graph, cable.destination)
        Scenes::strip ([portX (source, true), portY (source, cable.outlet), portX (destination, false), portY (destination, cable.inlet)], Scenes::rgb (79, 218, 211), 2.0, 0)

    canvas editor =
        nodes = foldList (editor.graph.nodes, [], \(all, n) => listConcat all (shape (editor, n)))
        scene = Ui::zoomed (0.0, 850.0, 600.0, [], listConcat (mapList (editor.graph.cables, \c => wire (editor.graph, c))) nodes, Surface)
        Ui::described (scene, foldList (editor.graph.nodes, [], \(all, n) => listConcat all (nodeAccess (editor, n))))

    root () =
        editor = editorSlice ()
        Ui::column [Ui::row [Ui::styled ("PRISM", ui::Title, ui::Accent), menu (), Ui::button ("Audition patch", "", Audition), Ui::button ("Remove selected", "", Remove)], plugins editor, Ui::caption editor.message, canvas editor, Ui::column (mapList (editor.graph.nodes, \n => component (editor, n)))]

    stamp editor = JsonString "${editor.revision}:${editor.selected}:${editor.source}:${editor.outlet}:${editor.message}:${editor.pluginPath}:${editor.pluginSerial}:${length editor.catalog}"

    (** One coherent Signal rebuilds native and canvas controls after an accepted command. *)
    export regions (before, editor, frames, _) =
        handle static Signal<Editor<Graph>>
            read => editor
        changed = signalChanges before editor stamp (signalDependencies editorSlice)
        [Keyed::region (frames, "root", changed, root)]

    token (name, light, dark) = ui::Token(tokenName = name, tokenLight = light, tokenDark = dark)

    (** Prism's theme is independent of a fixed machine document. *)
    export theme () = ui::Theme(tokens = [token ("accent", "#6944BA", "#BA9EFF"), token ("caution", "#986400", "#FFCD75"), token ("good", "#14776F", "#4FDAD3"), token ("danger", "#BE294B", "#FF7892"), token ("background", "#F4EFFB", "#100D21"), token ("text", "#201630", "#F2EDFF")], spacing = [4, 8, 12, 20, 28, 36], feedback = 120, settle = 220)
