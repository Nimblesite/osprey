// The synth given room ([UI-MACHINE-FLOW-SYNTH], [UI-MACHINE-CANVAS]): a larger window drops the
// keyboard deck to its bottom and moves the inspector to its right, each key and switch its own
// size, and a struck key still plays the patch at its pitch from where it now is.

import uitest::Drive

viewed (width, height) = post (\d => Drive::viewed (d, width, height))

topOf label = (element label).accessTop

leftOf label = (element label).accessLeft

widthOf label = (element label).accessWidth

// The deck `dy` lower and the inspector `dx` further right than at the design size, `gap` being their distance there; the graph's nodes stay.
roomFor (gap, dx, dy) =
    near (topOf "Play C4", 866.0 + dy)
    near (leftOf "Play C4", 480.0)
    near (widthOf "Play C4", 60.0)
    near (topOf "Play C#4", 866.0 + dy)
    near (leftOf "Inspector bypass: Bypass Filter" - leftOf "Bypass Filter", gap + dx)

roomyKeys () =
    begun ()
    knobNumber ("spareHeight", 0.0)
    gap = leftOf "Inspector bypass: Bypass Filter" - leftOf "Bypass Filter"
    roomFor (gap, 0.0, 0.0)
    viewed (1836.0, 1258.0)
    knobNumber ("spareWidth", 300.0)
    knobNumber ("spareHeight", 250.0)
    roomFor (gap, 300.0, 250.0)
    expect (runCount (), 0)
    struck ("C4", 261.6256)
    struck ("A#4", 466.1638)
    tap "Inspector bypass: Bypass Filter"
    flag ("processOn", false)
    expect (runCount (), 0)
    tap "Inspector bypass: Enable Filter"
    flag ("processOn", true)
    viewed (1536.0, 1008.0)
    roomFor (gap, 0.0, 0.0)
    struck ("E3", 164.8138)

// [PRISM-ROUTING-EDITOR] The same real host event path used by the modular surface.
editorUiJourney () =
    idle = Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ())
    opened = Drive::launched (idle, "macos", ["--empty"])
    expect (Drive::shows (opened, "Add component"), true)
    source = Drive::choose (opened, "Add component", "sine")
    gain = Drive::choose (source, "Add component", "gain")
    output = Drive::choose (gain, "Add component", "output")
    drawn = ui::Surfaces::seen (output.drivenSurface, output.drivenProgram)
    forEachList (drawn.walkSketches, \sketch => forEachList (sketch.sketchedAs.sketchShapes, \shape =>
        match shape
            ui::Rect _ _ _ _ angle _ _ => expect (angle, 0.0)
            _ => expect (true, true)))
    expect (Drive::shows (output, "Source 0: audio"), true)
    expect (Drive::letters (output, "Oscillator 0"), true)
    expect (uitest::Semantics::offered (output.drivenSeen.renderedAccess, "Canvas input 1:0"), true)
    targetPort = uitest::Semantics::element (output.drivenSeen.renderedAccess, "Canvas input 1:0")
    expect (targetPort.accessLeft, 215.0)
    expect (targetPort.accessTop, 55.0)
    canvasSource = Drive::pointer (output, 185.0, 65.0, true)
    expect (canvasSource.drivenSurface.surfaceSession.sessionStore.source, 0)
    canvasCable = Drive::pointer (Drive::pointer (canvasSource, 185.0, 65.0, false), 225.0, 65.0, true)
    expect (canvasCable.drivenSurface.surfaceSession.sessionStore.message, "Patch updated.")
    expect ("canvas cables: ${length canvasCable.drivenSurface.surfaceSession.sessionStore.graph.cables}", "canvas cables: 1")
    canvasSelected = Drive::pointer (Drive::pointer (canvasCable, 225.0, 65.0, false), 310.0, 65.0, true)
    expect ("canvas selection: ${canvasSelected.drivenSurface.surfaceSession.sessionStore.selected}", "canvas selection: 1")
    background = Drive::pointer (canvasSelected, 800.0, 500.0, true)
    expect (structuralEquals (background.drivenSurface.surfaceSession.sessionStore.graph, canvasSelected.drivenSurface.surfaceSession.sessionStore.graph), true)
    wired = Drive::press (Drive::press (output, "Source 0: audio"), "Connect 1: audio")
    second = Drive::press (Drive::press (wired, "Source 1: audio"), "Connect 2: audio")
    expect (length second.drivenSurface.surfaceSession.sessionStore.graph.cables, 2)
    feedbackSource = Drive::pointer (second, 395.0, 65.0, true)
    feedback = Drive::pointer (feedbackSource, 225.0, 65.0, true)
    expect (structuralEquals (feedback.drivenSurface.surfaceSession.sessionStore.graph, second.drivenSurface.surfaceSession.sessionStore.graph), true)
    expect (contains feedback.drivenSurface.surfaceSession.sessionStore.message "loop", true)
    heard = Drive::press (second, "Audition patch")
    expect (length heard.drivenSurface.surfaceAsked, 1)
    match listGet heard.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::Run executable arguments _ _ _ _ =>
                expect (executable, "/usr/bin/perl")
                expect (startsWith (listGet arguments 2 ?: "") "52494646", true)
                expect (contains (listGet arguments 2 ?: "") "0300010080BB0000", true)
            _ => expect (false, true)
    receiptFailed = Drive::completed (heard, "prism-preview", true, "{\"status\":1,\"stderr\":\"device disconnected\"}")
    expect (Drive::shows (receiptFailed, "Playback failed: device disconnected"), true)
    receiptOk = Drive::completed (heard, "prism-preview", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (Drive::shows (receiptOk, "Preview finished."), true)
    malformedReceipt = Drive::completed (heard, "prism-preview", true, "{}")
    expect (Drive::shows (malformedReceipt, "Playback failed: The host returned no valid process exit status."), true)
    failed = Drive::ran (heard, "prism-preview", 1, "device disconnected")
    expect (Drive::shows (failed, "Playback failed: device disconnected"), true)
    unrelated = Drive::ran (failed, "another-job", 0, "")
    expect (unrelated.drivenSurface.surfaceSession.sessionStore.message, failed.drivenSurface.surfaceSession.sessionStore.message)
    tuned = Drive::choose (second, "0: Frequency", "880")
    match synth::Graphs::node (tuned.drivenSurface.surfaceSession.sessionStore.graph, 0)
        synth::Invalid _ => expect (false, true)
        synth::Valid n => match listGet n.parameters 0
            Error _ => expect (false, true)
            Success parameter => expect (parameter.initial, 880.0)
    invalid = Drive::choose (tuned, "0: Frequency", "not a frequency")
    expect (structuralEquals (invalid.drivenSurface.surfaceSession.sessionStore.graph, tuned.drivenSurface.surfaceSession.sessionStore.graph), true)
    selected = Drive::press (invalid, "Select 1")
    removed = Drive::press (selected, "Remove selected")
    expect (length removed.drivenSurface.surfaceSession.sessionStore.graph.nodes, 2)
    expect (length removed.drivenSurface.surfaceSession.sessionStore.graph.cables, 0)
    expect (uitest::Views::letters (removed.drivenSeen, "Gain 1"), false)

zeroStereoResponse () = "4F535631020000000200000000000000" + join (mapList (toList (range (0, 48)), \_ => "0001000000000000" + join (mapList (toList (range (0, 512)), \_ => "00000000")) "")) ""

descriptorFixture = "{\"id\":\"0CDBB66985D548A9BFD8371909D24BB3\",\"name\":\"ADelay\",\"inputs\":2,\"outputs\":2,\"notes\":false,\"parameters\":[{\"id\":100,\"name\":\"Delay\",\"initial\":1.0,\"automatable\":true}]}"

// [PRISM-ROUTING-VST] Discovery and creation travel through host requests, receipts and slices.
pluginUiJourney () =
    handle ui::Slices
        fetch key => match key
            "prism-vst:scan:2" => "{\"event\":\"vst.class\",\"id\":\"0CDBB66985D548A9BFD8371909D24BB3\",\"name\":\"ADelay\",\"categories\":\"Fx|Delay\"}\n"
            "prism-vst:describe:3" => descriptorFixture
            "prism-vst:describe:4" => descriptorFixture
            "prism-audio:1:0" => zeroStereoResponse ()
            "prism-audio:1:1" => zeroStereoResponse ()
            _ => "malformed metadata"
    idle = Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ())
    opened = Drive::launched (idle, "macos", ["--empty", "--vst-worker", "/worker/osprey-vst-worker"])
    expect (Drive::shows (opened, "Scan VST3"), true)
    path = Drive::choose (opened, "VST3 bundle", "/plugins/adelay.vst3")
    scanning = Drive::press (path, "Scan VST3")
    expect (length scanning.drivenSurface.surfaceAsked, 1)
    match listGet scanning.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::Run executable arguments timeout limit _ _ =>
                expect (executable, "/worker/osprey-vst-worker")
                expect (structuralEquals (arguments, ["scan", "/plugins/adelay.vst3"]), true)
                expect (timeout, 10000)
                expect (limit, 1048576)
            _ => expect (false, true)
    scanned = Drive::completed (scanning, "prism-vst:scan:2", true, "{\"status\":0,\"stderr\":\"\"}")
    loading = Drive::choose (scanned, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    expect (length loading.drivenSurface.surfaceAsked, 1)
    added = Drive::completed (loading, "prism-vst:describe:3", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length added.drivenSurface.surfaceSession.sessionStore.graph.nodes, 1)
    expect (Drive::shows (added, "0: Delay"), true)
    expect (Drive::letters (added, "ADelay 0"), true)
    invalid = Drive::choose (added, "0: Delay", "1.5")
    expect (structuralEquals (invalid.drivenSurface.surfaceSession.sessionStore.graph, added.drivenSurface.surfaceSession.sessionStore.graph), true)
    stale = Drive::completed (added, "prism-vst:describe:3", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length stale.drivenSurface.surfaceSession.sessionStore.graph.nodes, 1)
    secondLoading = Drive::choose (added, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    twice = Drive::completed (secondLoading, "prism-vst:describe:4", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length twice.drivenSurface.surfaceSession.sessionStore.graph.nodes, 2)
    expect (length twice.drivenSurface.surfaceSession.sessionStore.pluginBindings, 2)
    connected = Drive::press (Drive::press (twice, "Source 0: audio"), "Connect 1: audio")
    expect (length connected.drivenSurface.surfaceSession.sessionStore.graph.cables, 1)
    oscillator = Drive::choose (connected, "Add component", "sine")
    stereo = Drive::choose (oscillator, "Add component", "stereo")
    sink = Drive::choose (stereo, "Add component", "stereo-output")
    widened = Drive::press (Drive::press (sink, "Source 2: audio"), "Connect 3: audio")
    fed = Drive::press (Drive::press (widened, "Source 3: audio"), "Connect 0: audio")
    finished = Drive::press (Drive::press (fed, "Source 1: audio"), "Connect 4: audio")
    audition = Drive::press (finished, "Audition patch")
    expect (length audition.drivenSurface.surfaceAsked, 1)
    match listGet audition.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::HostCall host operation arguments timeout limit slice =>
                expect (host, "process")
                expect (operation, "input")
                expect (timeout, 10000)
                expect (limit, 4194304)
                expect (startsWith slice "prism-audio:", true)
                expect (length arguments > 3, true)
            _ => expect (false, true)
    busy = Drive::press (audition, "Audition patch")
    expect (length busy.drivenSurface.surfaceAsked, 0)
    changed = Drive::press (Drive::press (audition, "Select 1"), "Remove selected")
    expect (length changed.drivenSurface.surfaceSession.sessionStore.pluginBindings, 1)
    nextEffect = Drive::completed (changed, "prism-audio:1:0", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (nextEffect.drivenSurface.surfaceSession.sessionStore.renderNode, 1)
    expect (length nextEffect.drivenSurface.surfaceAsked, 1)
    staleAudio = Drive::completed (nextEffect, "prism-audio:1:0", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (staleAudio.drivenSurface.surfaceSession.sessionStore.renderTicket, "prism-audio:1:1")
    played = Drive::completed (nextEffect, "prism-audio:1:1", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (Drive::shows (played, "Playing the current patch."), true)
    expect (length played.drivenSurface.surfaceAsked, 1)
    expect (played.drivenSurface.surfaceSession.sessionStore.renderTicket, "")
    crashed = Drive::completed (audition, "prism-audio:1:0", true, "{\"status\":1,\"stderr\":\"plug-in failed\"}")
    expect (Drive::shows (crashed, "Graph playback failed: plug-in failed"), true)
    expect (length crashed.drivenSurface.surfaceSession.sessionStore.renderClips, 0)
    thirdLoading = Drive::choose (twice, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    malformed = Drive::completed (thirdLoading, "prism-vst:describe:5", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (structuralEquals (malformed.drivenSurface.surfaceSession.sessionStore.graph, twice.drivenSurface.surfaceSession.sessionStore.graph), true)
    failed = Drive::completed (scanning, "prism-vst:scan:2", true, "{\"status\":1,\"stderr\":\"module unavailable\"}")
    expect (Drive::shows (failed, "VST3 inspection failed: module unavailable"), true)
    replaced = Drive::choose (scanning, "VST3 bundle", "/different.vst3")
    ignored = Drive::completed (replaced, "prism-vst:scan:2", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length ignored.drivenSurface.surfaceSession.sessionStore.catalog, 0)
    removedSecond = Drive::press (connected, "Remove selected")
    expect (length removedSecond.drivenSurface.surfaceSession.sessionStore.pluginBindings, 1)
    expect (length removedSecond.drivenSurface.surfaceSession.sessionStore.graph.cables, 0)
    removed = Drive::press (added, "Remove selected")
    expect (length removed.drivenSurface.surfaceSession.sessionStore.graph.nodes, 0)
    expect (length removed.drivenSurface.surfaceSession.sessionStore.pluginBindings, 0)

// [SYNTH-HOST-STREAM] Independent wire bytes, channel layouts and malformed worker replies.
hostWireJourney () =
    layout = synth::HostLayout(inputChannels = 1, outputChannels = 1, acceptsNotes = false)
    block = synth::HostBlock(frames = 2, notes = [], parameters = [], samples = [0.25, -0.5])
    match synth::HostPackets::clip (layout, block)
        Error _ => expect (false, true)
        Success hex => expect (hex, "0200000000000000000000000000803E000000BF")
    response = "4F53563101000000010000000000000002000000000000000000803E000000BF"
    match synth::HostResponses::clip (response, layout, 2)
        Error _ => expect (false, true)
        Success rendered =>
            expect (rendered.renderFrames, 2)
            expect (rendered.renderChannels, 1)
            expect (structuralEquals (rendered.renderSamples, [0.25, -0.5]), true)
    forEachList ([response + "00", take response 62, ""], \text =>
        match synth::HostResponses::clip (text, layout, 2)
            Success _ => expect (false, true)
            Error _ => expect (true, true))
    forEachList ([block(frames = 0), block(samples = [0.25]), block(parameters = [synth::HostParameter(identity = 100, offset = 2, value = 0.5)])], \bad =>
        match synth::HostPackets::packet (1, bad)
            Success _ => expect (false, true)
            Error _ => expect (true, true))
    note = synth::HostNote(kind = 1, offset = 300, pitch = 60, channel = 0, identity = 42, velocity = 0.5)
    match synth::HostPackets::clip (layout(inputChannels = 0, outputChannels = 2, acceptsNotes = true), block(frames = 512, notes = [note], samples = []))
        Error _ => expect (false, true)
        Success hex => expect (hex, "000100000000000000000000000100000100000000000000010000002C0000003C000000000000002A0000000000003F")
    match synth::WaveFiles::interleaved (48000, 2, [0.25, -0.5, 0.0, 1.0])
        Error _ => expect (false, true)
        Success hex =>
            expect (contains hex "0300020080BB000000DC050008002000", true)
            expect (contains hex "6661637404000000020000006461746110000000", true)

// [PRISM-ROUTING-MIDI] MIDI sources and stereo sinks are genuine menu-created graph components.
midiMenuJourney () =
    idle = Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ())
    opened = Drive::launched (idle, "macos", ["--empty"])
    notes = Drive::choose (opened, "Add component", "midi-note")
    expect (length notes.drivenSurface.surfaceSession.sessionStore.graph.nodes, 1)
    expect (Drive::shows (notes, "0: Pitch"), true)
    expect (Drive::shows (notes, "0: Velocity"), true)
    expect (Drive::shows (notes, "Source 0: notes"), true)
    output = Drive::choose (notes, "Add component", "stereo-output")
    expect (length output.drivenSurface.surfaceSession.sessionStore.graph.nodes, 2)
    incompatible = Drive::press (Drive::press (output, "Source 0: notes"), "Connect 1: audio")
    expect (length incompatible.drivenSurface.surfaceSession.sessionStore.graph.cables, 0)
    expect (contains incompatible.drivenSurface.surfaceSession.sessionStore.message "different rates", true)
    lfo = Drive::choose (output, "Add component", "lfo")
    gain = Drive::choose (lfo, "Add component", "modulated-gain")
    expect (length gain.drivenSurface.surfaceSession.sessionStore.graph.nodes, 4)
    expect (Drive::shows (gain, "2: Frequency"), true)
    modulated = Drive::press (Drive::press (gain, "Source 2: control"), "Connect 3: control")
    expect (length modulated.drivenSurface.surfaceSession.sessionStore.graph.cables, 1)
    refused = Drive::press (Drive::press (modulated, "Source 2: control"), "Connect 1: audio")
    expect (length refused.drivenSurface.surfaceSession.sessionStore.graph.cables, 1)
    tuned = Drive::choose (output, "0: Pitch", "72")
    invalid = Drive::choose (tuned, "0: Velocity", "1.1")
    expect (structuralEquals (invalid.drivenSurface.surfaceSession.sessionStore.graph, tuned.drivenSurface.surfaceSession.sessionStore.graph), true)

// [SYNTH-HOST-MIDI] Independent event expectations exercise exact block-boundary ownership.
midiTimingJourney () =
    source = synth::Components::midiNote (7, 60.0, 0.75, 256.0)
    on = synth::HostNote(kind = 1, offset = 0, pitch = 60, channel = 0, identity = 7, velocity = 0.75)
    off = on(kind = 2, velocity = 0.0)
    match synth::MidiClips::window (source, 0, 256)
        Error _ => expect (false, true)
        Success notes => expect (structuralEquals (notes, [on]), true)
    match synth::MidiClips::window (source, 256, 256)
        Error _ => expect (false, true)
        Success notes => expect (structuralEquals (notes, [off]), true)
    match synth::MidiClips::window (source, 0, 512)
        Error _ => expect (false, true)
        Success notes =>
            expect (structuralEquals (notes, [on, off(offset = 256)]), true)
            layout = synth::HostLayout(inputChannels = 0, outputChannels = 2, acceptsNotes = true)
            block = synth::HostBlock(frames = 512, notes = notes, parameters = [], samples = [])
            match synth::HostPackets::clip (layout, block)
                Error _ => expect (false, true)
                Success bytes => expect (length bytes > 100, true)
    match synth::MidiClips::window (source, 512, 256)
        Error _ => expect (false, true)
        Success notes => expect (length notes, 0)
    forEachList ([synth::Components::midiNote (7, 60.5, 0.75, 256.0), synth::Components::midiNote (7, 60.0, 1.01, 256.0), synth::Components::midiNote (7, 60.0, 0.75, 256.5), synth::Components::sine (7, 440.0)], \bad =>
        match synth::MidiClips::window (bad, 0, 512)
            Error _ => expect (true, true)
            Success _ => expect (false, true))
    match synth::MidiClips::window (source, 65535, 2)
        Error _ => expect (true, true)
        Success _ => expect (false, true)

// [SYNTH-HOST-GRAPH] Built-in kernels agree exactly across graph execution strategies.
graphClipJourney () =
    modulationJourney ()
    graph = (synth::EditorState::preset ()).graph
    match synth::Graphs::prepare graph
        synth::Invalid _ => expect (false, true)
        synth::Valid plan => match synth::Renderer::start graph
            Error _ => expect (false, true)
            Success held => match synth::Renderer::block (plan, 48000.0, synth::Parameters::initial graph, held, 257)
                Error _ => expect (false, true)
                Success reference => match synth::GraphClips::advance (graph, [], 257)
                    Error _ => expect (false, true)
                    Success action => match action
                        synth::ClipWaiting _ _ _ => expect (false, true)
                        synth::ClipReady clips => match synth::ClipInputs::completed (clips, 3)
                            Error _ => expect (false, true)
                            Success output =>
                                expect (structuralEquals (output.clipSamples, reference.samples), true)
                                expect (output.clipChannels, 1)
                                expect (length output.clipSamples, 257)
                                malformed = output(clipSamples = [0.0])
                                match synth::GraphClips::advance (graph, [malformed], 257)
                                    Error _ => expect (true, true)
                                    Success _ => expect (false, true)
                                match synth::GraphClips::advance (graph, [output, output], 257)
                                    Error _ => expect (true, true)
                                    Success _ => expect (false, true)
    forEachList ([0, -1, 32769], \frames =>
        match synth::GraphClips::advance (graph, [], frames)
            Error _ => expect (true, true)
            Success _ => expect (false, true))
    match synth::GraphClips::advance (graph(cables = []), [], 257)
        Error _ => expect (true, true)
        Success _ => expect (false, true)

modulationPatch () =
    commands = [synth::Add(kind = "sine"), synth::Add(kind = "stereo"), synth::Add(kind = "lfo"), synth::Add(kind = "modulated-gain"), synth::Add(kind = "stereo-output"), synth::Source(identity = 0, outlet = 0), synth::Connect(identity = 1, inlet = 0), synth::Source(identity = 1, outlet = 0), synth::Connect(identity = 3, inlet = 0), synth::Source(identity = 2, outlet = 0), synth::Connect(identity = 3, inlet = 1), synth::Source(identity = 3, outlet = 0), synth::Connect(identity = 4, inlet = 0)]
    editor = foldList (commands, synth::EditorState::initial (), synth::EditorState::tapped)
    tuned = synth::EditorState::typed (editor, synth::EditParameter(identity = 0, key = "frequency"), "12000")
    synth::EditorState::typed (tuned, synth::EditParameter(identity = 2, key = "frequency"), "0")

clipOutput graph = match synth::GraphClips::advance (graph, [], 8)
    Error why => Error(message = why)
    Success action => match action
        synth::ClipWaiting _ _ _ => Error(message = "Unexpected external processor")
        synth::ClipReady clips => synth::ClipInputs::completed (clips, 4)

// [SYNTH-GRAPH-MODULATION] One control stream broadcasts across both stereo channels.
modulationJourney () =
    editor = modulationPatch ()
    expect (length editor.graph.cables, 4)
    match clipOutput editor.graph
        Error _ => expect (false, true)
        Success output =>
            expect (output.clipChannels, 2)
            expected = [0.0, 0.0, 0.25, 0.25, 0.0, 0.0, -0.25, -0.25, 0.0, 0.0, 0.25, 0.25, 0.0, 0.0, -0.25, -0.25]
            expect (length output.clipSamples, length expected)
            forEachList (toList (range (0, length expected)), \index =>
                match listGet output.clipSamples index
                    Error _ => expect (false, true)
                    Success value => near (value, listGet expected index ?: 99.0))
            moving = synth::EditorState::typed (editor, synth::EditParameter(identity = 2, key = "frequency"), "20")
            match clipOutput moving.graph
                Error _ => expect (false, true)
                Success modulated => expect (structuralEquals (modulated.clipSamples, output.clipSamples), false)
    invalid = synth::NodeClip(clipNode = 2, clipChannels = 1, clipSamples = mapList (toList (range (0, 8)), \_ => -0.1), clipNotes = [])
    match synth::GraphClips::advance (editor.graph, [invalid], 8)
        Error _ => expect (true, true)
        Success _ => expect (false, true)
    missing = synth::EditorState::tapped (editor, synth::Disconnect(identity = 3, inlet = 1))
    match clipOutput missing.graph
        Error _ => expect (true, true)
        Success _ => expect (false, true)
