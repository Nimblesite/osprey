// The synth given room ([UI-MACHINE-FLOW-SYNTH], [UI-MACHINE-CANVAS]): a larger window drops the
// keyboard deck to its bottom and moves the inspector to its right, each key and switch its own
// size, and a struck key still plays the patch at its pitch from where it now is.

import uitest::Drive

viewed (width, height) = post (\d => Drive::viewed (d, width, height))

topOf label = (element label).accessTop

leftOf label = (element label).accessLeft

widthOf label = (element label).accessWidth

// The deck `dy` lower and the inspector `dx` further right than at the design size, `gap` being their distance there; the graph's nodes stay.
roomFor (gap, dx, dy) =
    near (topOf "Play C4", 866.0 + dy)
    near (leftOf "Play C4", 480.0)
    near (widthOf "Play C4", 60.0)
    near (topOf "Play C#4", 866.0 + dy)
    near (leftOf "Inspector bypass: Bypass Filter" - leftOf "Bypass Filter", gap + dx)

roomyKeys () =
    begun ()
    knobNumber ("spareHeight", 0.0)
    gap = leftOf "Inspector bypass: Bypass Filter" - leftOf "Bypass Filter"
    roomFor (gap, 0.0, 0.0)
    viewed (1836.0, 1258.0)
    knobNumber ("spareWidth", 300.0)
    knobNumber ("spareHeight", 250.0)
    roomFor (gap, 300.0, 250.0)
    expect (runCount (), 0)
    struck ("C4", 261.6256)
    struck ("A#4", 466.1638)
    tap "Inspector bypass: Bypass Filter"
    flag ("processOn", false)
    expect (runCount (), 0)
    tap "Inspector bypass: Enable Filter"
    flag ("processOn", true)
    viewed (1536.0, 1008.0)
    roomFor (gap, 0.0, 0.0)
    struck ("E3", 164.8138)

// [PRISM-ROUTING-EDITOR] The same real host event path used by the modular surface.
editorUiJourney () =
    launched = editorLaunched ["--empty"]
    opened = clickAt (launched, 550.0, 32.0)
    showsIn (opened, "Add component", true)
    source = Drive::choose (opened, "Add component", "sine")
    gain = Drive::choose (source, "Add component", "gain")
    output = Drive::choose (gain, "Add component", "output")
    drawn = ui::Surfaces::seen (output.drivenSurface, output.drivenProgram)
    forEachList (drawn.walkSketches, \sketch => forEachList (sketch.sketchedAs.sketchShapes, \shape =>
        match shape
            ui::Rect _ _ _ _ angle _ _ => expect (angle, 0.0)
            _ => expect (true, true)))
    showsIn (inspectorSelected (output, 0), "Use audio output", true)
    expect (Drive::letters (output, "Oscillator 0"), true)
    offeredIn (output, "Canvas input 1:0", true)
    portAt (output, "Canvas input 1:0", 509.0, 161.5)
    canvasSource = Drive::pointer (output, 488.5, 169.5, true)
    expect ((Drive::holding canvasSource).source, 0)
    canvasCable = Drive::pointer (Drive::pointer (canvasSource, 488.5, 169.5, false), 519.0, 171.5, true)
    expect ((Drive::holding canvasCable).message, "Patch updated.")
    expect ("canvas cables: ${length (Drive::holding canvasCable).graph.cables}", "canvas cables: 1")
    canvasSelected = Drive::pointer (Drive::pointer (canvasCable, 519.0, 171.5, false), 660.0, 170.0, true)
    expect ("canvas selection: ${(Drive::holding canvasSelected).selected}", "canvas selection: 1")
    background = Drive::pointer (canvasSelected, 800.0, 500.0, true)
    sameGraph (background, canvasSelected)
    // [PRISM-ROUTING-LAYOUT] Dragging moves ports and cables without changing the audio graph.
    dragged = Drive::pointer (canvasSelected, 720.0, 300.0, true)
    movedPort = uitest::Semantics::element (dragged.drivenSeen.renderedAccess, "Canvas input 1:0")
    expect (movedPort.accessLeft, 569.0)
    expect (movedPort.accessTop, 291.5)
    sameGraph (dragged, canvasSelected)
    layout = ui::Surfaces::seen (dragged.drivenSurface, dragged.drivenProgram)
    cables = ui::Lists::flatten (mapList (layout.walkSketches, \sketch => filterList (sketch.sketchedAs.sketchShapes, \shape =>
        match shape
            ui::Path _ outline _ _ _ _ _ => structuralEquals (outline, ui::Line(width = 3.0, dashes = [], bevel = false))
            _ => false)))
    expect (length cables, 1)
    forEachList (cables, \shape =>
        match shape
            ui::Path steps _ paint _ _ _ _ =>
                expect (structuralEquals (paint, ui::Solid(tint = ui::Scenes::hex (16745538, 1.0))), true)
                expect (structuralEquals (steps, [ui::MoveTo(toX = 488.5, toY = 169.5), ui::CubicTo(toX = 579.0, toY = 301.5, ctrlAX = 558.5, ctrlAY = 169.5, ctrlBX = 509.0, ctrlBY = 301.5)]), true)
            _ => expect (false, true))
    expect ((Drive::holding dragged).revision, (Drive::holding canvasSelected).revision)
    released = Drive::pointer (dragged, 720.0, 300.0, false)
    hovered = Drive::pointer (released, 600.0, 400.0, false)
    still = uitest::Semantics::element (hovered.drivenSeen.renderedAccess, "Canvas input 1:0")
    expect (still.accessLeft, movedPort.accessLeft)
    expect (still.accessTop, movedPort.accessTop)
    disconnected = inspectorAction (released, 1, "Disconnect audio")
    rearmed = Drive::pointer (disconnected, 488.5, 169.5, true)
    reconnected = Drive::pointer (Drive::pointer (rearmed, 488.5, 169.5, false), 579.0, 301.5, true)
    cablesOf (reconnected, 1)
    erased = inspectorAction (released, 0, "Remove module")
    portAt (erased, "Canvas input 1:0", 569.0, 291.5)
    offsetGrab = Drive::pointer (released, 730.0, 310.0, true)
    offsetMove = Drive::pointer (offsetGrab, 750.0, 340.0, true)
    portAt (offsetMove, "Canvas input 1:0", 589.0, 321.5)
    invalidPoint = synth::EditorView::pointed ((Drive::holding offsetMove), floatFromBits 9221120237041090560, 0.0, false)
    expect (invalidPoint.dragging, -1)
    expect (structuralEquals (invalidPoint.positions, (Drive::holding offsetMove).positions), true)
    bounded = Drive::pointer (offsetMove, -100.0, 1000.0, false)
    portAt (bounded, "Canvas input 1:0", 4.0, 691.5)
    wired = inspectorAction (inspectorAction (output, 0, "Use audio output"), 1, "Connect audio")
    second = inspectorAction (inspectorAction (wired, 1, "Use audio output"), 2, "Connect audio")
    cablesOf (second, 2)
    feedbackSource = Drive::pointer (second, 801.0, 171.5, true)
    feedbackMoved = Drive::pointer (feedbackSource, 519.0, 171.5, true)
    expect ((Drive::holding feedbackMoved).wireDragging, true)
    feedback = Drive::pointer (feedbackMoved, 519.0, 171.5, false)
    sameGraph (feedback, second)
    expect (contains (Drive::holding feedback).message "loop", true)
    heard = Drive::press (second, "Audition")
    askedOf (heard, 1)
    match listGet heard.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::Run executable arguments _ _ _ _ =>
                expect (executable, "/usr/bin/perl")
                expect (startsWith (listGet arguments 2 ?: "") "52494646", true)
                expect (contains (listGet arguments 2 ?: "") "0300010080BB0000", true)
            _ => expect (false, true)
    receiptFailed = previewed (heard, "{\"status\":1,\"stderr\":\"device disconnected\"}")
    showsIn (receiptFailed, "Playback failed: device disconnected", true)
    receiptOk = previewed (heard, "{\"status\":0,\"stderr\":\"\"}")
    showsIn (receiptOk, "Preview finished.", true)
    malformedReceipt = previewed (heard, "{}")
    showsIn (malformedReceipt, "Playback failed: The host returned no valid process exit status.", true)
    failed = Drive::ran (heard, "prism-preview", 1, "device disconnected")
    showsIn (failed, "Playback failed: device disconnected", true)
    unrelated = Drive::ran (failed, "another-job", 0, "")
    expect ((Drive::holding unrelated).message, (Drive::holding failed).message)
    tuned = Drive::choose (inspectorSelected (second, 0), "Frequency", "880")
    parameterAt ((Drive::holding tuned).graph, 0, 0, \parameter => expect (parameter.initial, 880.0))
    invalid = Drive::choose (inspectorSelected (tuned, 0), "Frequency", "not a frequency")
    sameGraph (invalid, tuned)
    selected = inspectorSelected (invalid, 1)
    removed = Drive::press (selected, "Remove module")
    expect (length (Drive::holding removed).graph.nodes, 2)
    cablesOf (removed, 0)
    expect (uitest::Views::letters (removed.drivenSeen, "Gain 1"), false)

descriptorFixture = "{\"id\":\"0CDBB66985D548A9BFD8371909D24BB3\",\"name\":\"ADelay\",\"inputs\":2,\"outputs\":2,\"notes\":false,\"parameters\":[{\"id\":100,\"name\":\"Delay\",\"initial\":1.0,\"automatable\":true}]}"

// [PRISM-ROUTING-VST] Discovery and creation travel through host requests, receipts and slices.
pluginUiJourney () =
    handle ui::Slices
        fetch key => match key
            "prism-vst:scan:2" => "{\"event\":\"vst.class\",\"id\":\"0CDBB66985D548A9BFD8371909D24BB3\",\"name\":\"ADelay\",\"categories\":\"Fx|Delay\"}\n"
            "prism-vst:describe:3" => descriptorFixture
            "prism-vst:describe:4" => descriptorFixture
            _ => match startsWith key "prism-worker:"
                true => zeroStereoResponse ()
                false => "malformed metadata"
    launched = editorLaunched ["--empty", "--vst-worker", "/worker/osprey-vst-worker"]
    opened = clickAt (launched, 550.0, 32.0)
    showsIn (opened, "Scan VST3", true)
    path = Drive::choose (opened, "VST3 bundle", "/plugins/adelay.vst3")
    scanning = Drive::press (path, "Scan VST3")
    askedOf (scanning, 1)
    match listGet scanning.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::Run executable arguments timeout limit _ _ =>
                expect (executable, "/worker/osprey-vst-worker")
                expect (structuralEquals (arguments, ["scan", "/plugins/adelay.vst3"]), true)
                expect (timeout, 10000)
                expect (limit, 1048576)
            _ => expect (false, true)
    scanned = Drive::completed (scanning, "prism-vst:scan:2", true, "{\"status\":0,\"stderr\":\"\"}")
    loading = Drive::choose (scanned, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    askedOf (loading, 1)
    added = Drive::completed (loading, "prism-vst:describe:3", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length (Drive::holding added).graph.nodes, 1)
    showsIn (inspectorSelected (added, 0), "Delay", true)
    expect (Drive::letters (added, "ADelay 0"), true)
    current = Drive::holding added
    original = current.graph
    frozen = original(nodes = mapList (original.nodes, nonAutomatable))
    disabled = current(graph = frozen)
    refusedControl = synth::EditorState::typed (disabled, synth::EditParameter(identity = 0, key = "vst:100"), "0.25")
    expect (structuralEquals (refusedControl.graph, frozen), true)

    invalid = Drive::choose (inspectorSelected (added, 0), "Delay", "1.5")
    sameGraph (invalid, added)
    stale = Drive::completed (added, "prism-vst:describe:3", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length (Drive::holding stale).graph.nodes, 1)
    secondLoading = Drive::choose (added, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    twice = Drive::completed (secondLoading, "prism-vst:describe:4", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length (Drive::holding twice).graph.nodes, 2)
    expect (length (Drive::holding twice).pluginBindings, 2)
    connected = inspectorAction (inspectorAction (twice, 0, "Use audio output"), 1, "Connect audio")
    cablesOf (connected, 1)
    oscillator = Drive::choose (connected, "Add component", "sine")
    stereo = Drive::choose (oscillator, "Add component", "stereo")
    sink = Drive::choose (stereo, "Add component", "stereo-output")
    widened = inspectorAction (inspectorAction (sink, 2, "Use audio output"), 3, "Connect audio")
    fed = inspectorAction (inspectorAction (widened, 3, "Use audio output"), 0, "Connect audio")
    finished = inspectorAction (inspectorAction (fed, 1, "Use audio output"), 4, "Connect audio")
    lfoPatch = Drive::choose (finished, "Add component", "lfo")
    armedModulator = inspectorAction (lfoPatch, 5, "Use control output")
    showsIn (inspectorSelected (armedModulator, 0), "Modulate Delay", true)
    controlled = inspectorAction (armedModulator, 0, "Modulate Delay")
    cablesOf (controlled, 5)
    hostedModulationJourney (Drive::holding controlled).graph
    unbound = inspectorAction (controlled, 0, "Disconnect Delay")
    cablesOf (unbound, 4)
    match synth::GraphClips::advance ((Drive::holding unbound).graph, [], 256)
        Error _ => expect (false, true)
        Success action => match action
            synth::ClipReady _ => expect (false, true)
            synth::ClipWaiting _ block _ => succeeds (listGet block.parameters 0, \restored => expect (restored.value, 1.0))
    wrongSource = inspectorAction (controlled, 2, "Use audio output")
    refusedModulation = inspectorAction (wrongSource, 0, "Modulate Delay")
    sameGraph (refusedModulation, controlled)
    audition = Drive::press (finished, "Audition")
    askedOf (audition, 1)
    match listGet audition.drivenSurface.surfaceAsked 0
        Error _ => expect (false, true)
        Success request => match request.capability
            ui::HostCall host operation arguments timeout limit slice =>
                expect (host, "process")
                expect (operation, "session-open")
                expect (timeout, 10000)
                expect (limit, 4194304)
                expect (startsWith slice "prism-audio:", true)
                expect (length arguments > 3, true)
            _ => expect (false, true)
    busy = Drive::press (audition, "Audition")
    askedOf (busy, 0)
    heldAudition = Drive::holding audition
    forEachList ([[], listConcat heldAudition.renderPending heldAudition.renderPending], \pending =>
        lost = synth::GraphPreview::completed (heldAudition(renderPending = pending), heldAudition.renderTicket, Success(value = "{\"status\":0,\"session\":\"orphan\"}"))
        expect (contains lost.stepStore.message "no unique pending graph request", true)
        expect (length lost.stepStore.renderPending, 0)
        expect (lost.stepStore.renderTicket, ""))
    changed = inspectorAction (audition, 1, "Remove module")
    expect (length (Drive::holding changed).pluginBindings, 1)
    openedAudio = Drive::completed (changed, "prism-audio:1:0:open", true, "{\"status\":0,\"session\":\"effect-zero\"}")
    expect (length (Drive::holding openedAudio).renderSessions, 1)
    nextEffect = Drive::completed (openedAudio, "prism-audio:1:0:0:block", true, "{\"status\":0,\"stderr\":\"\"}")
    match (Drive::holding nextEffect).renderPending
        [pending] =>
            expect (pending.pendingNode, 1)
            expect (length pending.pendingGraph.nodes, length (Drive::holding audition).graph.nodes)
        _ => expect (false, true)
    askedOf (nextEffect, 1)
    staleAudio = Drive::completed (nextEffect, "prism-audio:1:0:0:block", true, "{\"status\":0,\"stderr\":\"\"}")
    expect ((Drive::holding staleAudio).renderTicket, "prism-audio:1:1:open")
    openedSecond = Drive::completed (nextEffect, "prism-audio:1:1:open", true, "{\"status\":0,\"session\":\"effect-one\"}")
    firstPair = Drive::completed (openedSecond, "prism-audio:1:1:0:block", true, "{\"status\":0,\"stderr\":\"\"}")
    expect ((Drive::holding firstPair).renderTicket, "prism-audio:device:1:open")
    deviceOpened = audioDone firstPair
    expect (length (Drive::holding deviceOpened).renderSessions, 3)
    deviceCounterJourney (Drive::holding deviceOpened)
    secondPair = audioDone deviceOpened
    expect ((Drive::holding secondPair).renderTicket, "prism-audio:1:0:2048:block")
    played = foldList (toList (range (0, 30)), secondPair, \(previous, _) =>
        match (Drive::holding previous).renderTicket == ""
            true => previous
            false => audioDone previous)
    showsIn (played, "Preview finished.", true)
    askedOf (played, 3)
    expect (length (Drive::holding played).renderSessions, 0)
    expect ((Drive::holding played).renderTicket, "")
    forEachList ([firstPair, deviceOpened, secondPair], \running =>
        stopped = audioDone (Drive::press (running(drivenProgram = synth::EditorApp::program ()), "Stop"))
        showsIn (stopped, "Playback stopped.", true)
        expect (length (Drive::holding stopped).renderSessions, 0)
        expect ((Drive::holding stopped).renderTicket, ""))
    live = Drive::press (finished, "Play")
    continuing = foldList (toList (range (0, 40)), live, \(previous, _) => audioDone previous)
    expect ((Drive::holding continuing).renderContinuous, true)
    expect ((Drive::holding continuing).renderTicket != "", true)
    expect (Drive::shows (audioDone (Drive::press (continuing(drivenProgram = synth::EditorApp::program ()), "Stop")), "Playback stopped."), true)
    crashed = Drive::completed (audition, "prism-audio:1:0:open", true, "{\"status\":1,\"stderr\":\"plug-in failed\"}")
    showsIn (crashed, "Graph playback failed: plug-in failed", true)
    expect (length (Drive::holding crashed).renderPending, 0)
    thirdLoading = Drive::choose (twice, "Add VST3", "0CDBB66985D548A9BFD8371909D24BB3")
    malformed = Drive::completed (thirdLoading, "prism-vst:describe:5", true, "{\"status\":0,\"stderr\":\"\"}")
    sameGraph (malformed, twice)
    failed = Drive::completed (scanning, "prism-vst:scan:2", true, "{\"status\":1,\"stderr\":\"module unavailable\"}")
    showsIn (failed, "VST3 inspection failed: module unavailable", true)
    replaced = Drive::choose (scanning, "VST3 bundle", "/different.vst3")
    ignored = Drive::completed (replaced, "prism-vst:scan:2", true, "{\"status\":0,\"stderr\":\"\"}")
    expect (length (Drive::holding ignored).catalog, 0)
    removedSecond = Drive::press (connected, "Remove module")
    expect (length (Drive::holding removedSecond).pluginBindings, 1)
    cablesOf (removedSecond, 0)
    removed = Drive::press (added, "Remove module")
    expect (length (Drive::holding removed).graph.nodes, 0)
    expect (length (Drive::holding removed).pluginBindings, 0)

// [SYNTH-HOST-STREAM] Independent wire bytes, channel layouts and malformed worker replies.
hostWireJourney () =
    layout = synth::HostLayout(inputChannels = 1, outputChannels = 1, acceptsNotes = false)
    block = synth::HostBlock(frames = 2, notes = [], parameters = [], samples = [0.25, -0.5])
    succeeds (synth::HostPackets::clip (layout, block), \hex => expect (hex, "0200000000000000000000000000803E000000BF"))
    response = "4F53563101000000010000000000000002000000000000000000803E000000BF"
    succeeds (synth::HostResponses::clip (response, layout, 2), \rendered =>
        expect (rendered.renderFrames, 2)
        expect (rendered.renderChannels, 1)
        expect (structuralEquals (rendered.renderSamples, [0.25, -0.5]), true))
    forEachList ([response + "00", take response 62, ""], \text =>
        errs (synth::HostResponses::clip (text, layout, 2)))
    forEachList ([block(frames = 0), block(samples = [0.25]), block(parameters = [synth::HostParameter(identity = 100, offset = 2, value = 0.5)])], \bad =>
        errs (synth::HostPackets::packet (1, bad)))
    note = synth::HostNote(kind = 1, offset = 300, pitch = 60, channel = 0, identity = 42, velocity = 0.5)
    succeeds (synth::HostPackets::clip (layout(inputChannels = 0, outputChannels = 2, acceptsNotes = true), block(frames = 512, notes = [note], samples = [])), \hex => expect (hex, "000100000000000000000000000100000100000000000000010000002C0000003C000000000000002A0000000000003F"))
    succeeds (synth::WaveFiles::interleaved (48000, 2, [0.25, -0.5, 0.0, 1.0]), \hex =>
        expect (contains hex "0300020080BB000000DC050008002000", true)
        expect (contains hex "6661637404000000020000006461746110000000", true))

// [PRISM-ROUTING-MIDI] MIDI sources and stereo sinks are genuine menu-created graph components.
midiMenuJourney () =
    launched = editorLaunched ["--empty"]
    opened = clickAt (launched, 550.0, 32.0)
    notes = Drive::choose (opened, "Add component", "midi-note")
    expect (length (Drive::holding notes).graph.nodes, 1)
    showsIn (inspectorSelected (notes, 0), "Pitch", true)
    showsIn (inspectorSelected (notes, 0), "Velocity", true)
    showsIn (inspectorSelected (notes, 0), "Use notes output", true)
    output = Drive::choose (notes, "Add component", "stereo-output")
    expect (length (Drive::holding output).graph.nodes, 2)
    incompatible = inspectorAction (inspectorAction (output, 0, "Use notes output"), 1, "Connect audio")
    cablesOf (incompatible, 0)
    expect (contains (Drive::holding incompatible).message "different rates", true)
    lfo = Drive::choose (output, "Add component", "lfo")
    gain = Drive::choose (lfo, "Add component", "modulated-gain")
    expect (length (Drive::holding gain).graph.nodes, 4)
    showsIn (inspectorSelected (gain, 2), "Frequency", true)
    modulated = inspectorAction (inspectorAction (gain, 2, "Use control output"), 3, "Connect control")
    cablesOf (modulated, 1)
    refused = inspectorAction (inspectorAction (modulated, 2, "Use control output"), 1, "Connect audio")
    cablesOf (refused, 1)
    tuned = Drive::choose (inspectorSelected (output, 0), "Pitch", "72")
    invalid = Drive::choose (inspectorSelected (tuned, 0), "Velocity", "1.1")
    sameGraph (invalid, tuned)

// [SYNTH-HOST-MIDI] Independent event expectations exercise exact block-boundary ownership.
midiTimingJourney () =
    source = synth::Components::midiNote (7, 60.0, 0.75, 256.0)
    on = synth::HostNote(kind = 1, offset = 0, pitch = 60, channel = 0, identity = 7, velocity = 0.75)
    off = on(kind = 2, velocity = 0.0)
    succeeds (synth::MidiClips::window (source, 0, 256), \notes => expect (structuralEquals (notes, [on]), true))
    succeeds (synth::MidiClips::window (source, 256, 256), \notes => expect (structuralEquals (notes, [off]), true))
    succeeds (synth::MidiClips::window (source, 0, 512), \notes =>
        expect (structuralEquals (notes, [on, off(offset = 256)]), true)
        layout = synth::HostLayout(inputChannels = 0, outputChannels = 2, acceptsNotes = true)
        block = synth::HostBlock(frames = 512, notes = notes, parameters = [], samples = [])
        succeeds (synth::HostPackets::clip (layout, block), \bytes => expect (length bytes > 100, true)))
    succeeds (synth::MidiClips::window (source, 512, 256), \notes => expect (length notes, 0))
    forEachList ([synth::Components::midiNote (7, 60.5, 0.75, 256.0), synth::Components::midiNote (7, 60.0, 1.01, 256.0), synth::Components::midiNote (7, 60.0, 0.75, 256.5), synth::Components::sine (7, 440.0)], \bad =>
        errs (synth::MidiClips::window (bad, 0, 512)))
    errs (synth::MidiClips::window (source, 65535, 2))

// [SYNTH-HOST-GRAPH] Built-in kernels agree exactly across graph execution strategies.
graphClipJourney () =
    modulationJourney ()
    graph = (synth::EditorState::preset ()).graph
    match synth::Graphs::prepare graph
        synth::Invalid _ => expect (false, true)
        synth::Valid plan => match synth::Renderer::start graph
            Error _ => expect (false, true)
            Success held => match synth::Renderer::block (plan, 48000.0, synth::Parameters::initial graph, held, 257)
                Error _ => expect (false, true)
                Success reference => match synth::GraphClips::advance (graph, [], 257)
                    Error _ => expect (false, true)
                    Success action => match action
                        synth::ClipWaiting _ _ _ => expect (false, true)
                        synth::ClipReady clips => succeeds (synth::ClipInputs::completed (clips, 3), \output =>
                            expect (structuralEquals (output.clipSamples, reference.samples), true)
                            expect (output.clipChannels, 1)
                            expect (length output.clipSamples, 257)
                            malformed = output(clipSamples = [0.0])
                            errs (synth::GraphClips::advance (graph, [malformed], 257))
                            errs (synth::GraphClips::advance (graph, [output, output], 257)))
    forEachList ([0, -1, 32769], \frames =>
        errs (synth::GraphClips::advance (graph, [], frames)))
    errs (synth::GraphClips::advance (graph(cables = []), [], 257))

modulationPatch () =
    commands = [synth::Add(kind = "sine"), synth::Add(kind = "stereo"), synth::Add(kind = "lfo"), synth::Add(kind = "modulated-gain"), synth::Add(kind = "stereo-output"), synth::Source(identity = 0, outlet = 0), synth::Connect(identity = 1, inlet = 0), synth::Source(identity = 1, outlet = 0), synth::Connect(identity = 3, inlet = 0), synth::Source(identity = 2, outlet = 0), synth::Connect(identity = 3, inlet = 1), synth::Source(identity = 3, outlet = 0), synth::Connect(identity = 4, inlet = 0)]
    editor = foldList (commands, synth::EditorState::initial (), synth::EditorState::tapped)
    tuned = synth::EditorState::typed (editor, synth::EditParameter(identity = 0, key = "frequency"), "12000")
    synth::EditorState::typed (tuned, synth::EditParameter(identity = 2, key = "frequency"), "0")

clipOutput graph = match synth::GraphClips::advance (graph, [], 8)
    Error why => Error(message = why)
    Success action => match action
        synth::ClipWaiting _ _ _ => Error(message = "Unexpected external processor")
        synth::ClipReady clips => synth::ClipInputs::completed (clips, 4)

// [SYNTH-GRAPH-MODULATION] One control stream broadcasts across both stereo channels.
modulationJourney () =
    editor = modulationPatch ()
    expect (length editor.graph.cables, 4)
    succeeds (clipOutput editor.graph, \output =>
        expect (output.clipChannels, 2)
        expected = [0.0, 0.0, 0.25, 0.25, 0.0, 0.0, -0.25, -0.25, 0.0, 0.0, 0.25, 0.25, 0.0, 0.0, -0.25, -0.25]
        expect (length output.clipSamples, length expected)
        forEachList (toList (range (0, length expected)), \index =>
            succeeds (listGet output.clipSamples index, \value => near (value, listGet expected index ?: 99.0)))
        moving = synth::EditorState::typed (editor, synth::EditParameter(identity = 2, key = "frequency"), "20")
        succeeds (clipOutput moving.graph, \modulated => expect (structuralEquals (modulated.clipSamples, output.clipSamples), false)))
    invalid = synth::NodeClip(clipNode = 2, clipChannels = 1, clipSamples = mapList (toList (range (0, 8)), \_ => -0.1), clipNotes = [])
    errs (synth::GraphClips::advance (editor.graph, [invalid], 8))
    missing = synth::EditorState::tapped (editor, synth::Disconnect(identity = 3, inlet = 1))
    errs (clipOutput missing.graph)

// [SYNTH-HOST-MODULATION] Graph cables become exact normalized native automation points.
hostedModulationJourney graph =
    match synth::GraphClips::advance (graph, [], 256)
        Error _ => expect (false, true)
        Success action => match action
            synth::ClipReady _ => expect (false, true)
            synth::ClipWaiting identity block _ =>
                expect (identity, 0)
                expect (length block.parameters, 2)
                expect (length block.samples, 512)
                succeeds (listGet block.parameters 0, \first =>
                    expect (first.identity, 100)
                    expect (first.offset, 0)
                    expect (first.value, 0.5))
                succeeds (listGet block.parameters 1, \second =>
                    expect (second.offset, 128)
                    expect (second.value > 0.5 && second.value < 1.0, true))
    valid (synth::HostModulation::connect (graph, 5, 0, 0, "vst:100"), \same => expect (structuralEquals (same, graph), true))
    refusesGraph (synth::HostModulation::connect (graph, 5, 0, 0, "vst:unknown"))
    invalid = synth::NodeClip(clipNode = 5, clipChannels = 1, clipSamples = mapList (toList (range (0, 256)), \_ => 1.1), clipNotes = [])
    errs (synth::GraphClips::advance (graph, [invalid], 256))

// Fails the test unless `result` is an error.
// One press and release at the same canvas point.
clickAt (driven, x, y) = Drive::pointer (Drive::pointer (driven, x, y, true), x, y, false)

// The Prism editor, freshly launched on macOS with these arguments.
editorLaunched args = Drive::launched (Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ()), "macos", args)

errs result = match result
    Error _ => expect (true, true)
    Success _ => expect (false, true)

// Fails the test unless `outcome` is refused.
refusesGraph outcome = match outcome
    synth::Invalid _ => expect (true, true)
    synth::Valid _ => expect (false, true)

nonAutomatable n = n(parameters = mapList (n.parameters, \p => p(automatable = false)))
