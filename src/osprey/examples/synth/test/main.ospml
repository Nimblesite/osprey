// The Prism synth end to end ([UI-MACHINE-FLOW-SYNTH]): its voice is checked
// directly, then the real editor is driven through the typed host event boundary
// every host calls ([NATIVE-SHM-EVENT]), by pointer events aimed through each
// control's accessible label. Every control is silent; every struck key's host
// playback request is compared with the patch, at the key's pitch, that made it.

import ui::Runtime
import ui::Canvases
import ui::MachineDocs
import ui::Machines
import ui::Requests
import uitest::Drive
import uitest::Semantics
import uitest::Views
import signalflow::App
import synth::Studio
import synth::Synth
import synth::Voice

(** The bench's only write: the driven surface. *)
effect Bench
    drive : uitest::Driven<signalflow::Store, ui::Lever> => Unit

// The bench starts from one freshly documented studio, neither launched nor driven.
blank () = Drive::idle (Studio::program (), signalflow::Flow::store (MachineDocs::faulty ""))

mut driven = blank ()

kept next = perform Bench.drive next

hosted work =
    handle ui::Slices
        fetch _ => ""
    ui::Views::quiet work

bench work =
    handle Bench
        drive d => driven := d
    Runtime::guarded work

begun () =
    perform Bench.drive (blank ())
    hosted (\() => kept (Drive::launched (driven, "macos", [])))

// One typed host event, sent the way a host sends it.
post step = hosted (\() => kept (step driven))

pointer (x, y, down) = post (\d => Drive::pointer (d, x, y, down))

tapAt (label, fraction) =
    at = Semantics::point (element label, fraction)
    pointer (at.pointX, at.pointY, true)
    pointer (at.pointX, at.pointY, false)

tap label = tapAt (label, 0.5)

machine () = driven.drivenSurface.surfaceSession.sessionStore.screen.screenMachine

currentPatch () = Synth::patch (machine ())

described () = Voice::describe (currentPatch ())

// Two values that must not match.
apart (one, other) = expect (one == other, false)

// A patch that must differ from `before`.
changed before = apart (described (), before)

elements () = Canvases::semantics (machine ())

labels () = Semantics::labels (elements ())

element label = Semantics::element (elements (), label)

// A check that names what was missing, so a silent false still says why it failed.
reports (ok, missing) = match ok
    true => true
    false =>
        print "# ${missing}"
        false

offers label = reports (Semantics::offered (elements (), label), "not offered: ${label}; the tree offers ${labels ()}")

offered label = expect (offers label, true)

letters text = reports (Views::letters (driven.drivenSeen, text), "not lettered: ${text}; the artboard letters ${Views::lettered driven.drivenSeen}")

// The console's readout `name`, read by `read`, against what it must show.
shows (read, name, expected) = expect (read (machine (), name), expected)

flag (name, expected) = shows (Machines::flag, name, expected)

knobText (name, expected) = shows (Machines::text, name, expected)

knobNumber (name, expected) =
    actual = Machines::number (machine (), name)
    expect (actual - expected < 0.000001 && expected - actual < 0.000001, true)

layer (name, expected) = shows (Machines::current, name, expected)

// ---- the host requests of the last step, read as the typed asks they are ----

runRequests () = filterList (driven.drivenSurface.surfaceAsked, \r => Requests::kind r.capability == "run")

runCount () = length (runRequests ())

request () = listGet (runRequests ()) 0 ?: Requests::ask ("", ui::Run(executable = "", arguments = [], timeout = 0, outputLimit = 0, plist = false, runSlice = ""))

runArguments () = match (request ()).capability
    ui::Run _ arguments _ _ _ _ => arguments
    _ => []

runExecutable () = match (request ()).capability
    ui::Run executable _ _ _ _ _ => executable
    _ => ""

argument index = listGet (runArguments ()) index ?: ""

// The clip the last key played, which must differ from `previous`; `label` is picked next.
apartThen (label, previous) =
    apart (argument 2, previous)
    tap label

currentWav () = Voice::wav (Voice::samples (currentPatch ()))

nearPeak (patch, expected) = expect (abs (Voice::peak (Voice::samples patch) - expected) <= 1, true)

played expectedPeak =
    expect (runCount (), 1)
    expect ((request ()).ticket, "play")
    expect (runExecutable (), "/usr/bin/perl")
    expect (length (runArguments ()), 4)
    expect (argument 0, "-e")
    expect (argument 2, currentWav ())
    expect (argument 3, Synth::clipPath)
    nearPeak (currentPatch (), expectedPeak)

// The readout shows `readout`: the `name` key then plays at `peak`.
readThenPlay (readout, name, peak) =
    expect (letters readout, true)
    sounds (name, peak)

// Nothing reached the host, so the patch it would have played is untouched.
silent () = expect (runCount (), 0)

// An edit that plays nothing, then the key that plays the patch it left behind.
quietKey peak =
    silent ()
    sounds ("A3", peak)

quietPatch before =
    silent ()
    expect (described (), before)

// A pointer event at `x`, `y` that moves nothing.
quietAt (before, x, y, down) =
    pointer (x, y, down)
    quietPatch before

// An edit that changes the patch and plays nothing.
quietEdit before =
    silent ()
    changed before

// A press or release on a control: it moves nothing and it plays nothing.
quietPointer (point, down) =
    pointer (point.pointX, point.pointY, down)
    silent ()

quietClick (before, label) =
    tap label
    quietPatch before

// A press, its release and the menu it closed, all silent.
pressedAt (before, x, y) =
    pointer (x, y, true)
    pointer (x, y, false)
    quietPatch before
    layer ("menu", "closed")

// The first clip, then the chooser `menu` opens.
firstClip (menu, name) =
    sounds ("A3", 17)
    pressed = argument 2
    tap menu
    layer ("menu", name)
    pressed

// A menu entry picked, the readout it set and the silent key that follows.
picked (label, wave) =
    tap label
    knobText ("wave", wave)
    quietKey 17

undone name =
    tap "Undo"
    flag (name, true)

// A key struck: it lights, the readout shows it, and the patch plays at its pitch.
struck (name, hertz) =
    tap "Play ${name}"
    knobText ("note", name)
    near ((currentPatch ()).pitch, hertz)
    knobNumber ("hertz", (currentPatch ()).pitch)
    expect (letters name, true)
    expect (runCount (), 1)
    expect (argument 2, currentWav ())

sounds (name, expectedPeak) =
    struck (name, Voice::frequency name)
    played expectedPeak

// ---- launch, editing and history through the Prism skin ----

// The readout shows `readout`: the patch it shows is the one `described ()` gives.
startingAt readout =
    expect (letters readout, true)
    described ()

// A slider dragged to `fraction` moves input `name` to `value`.
slid (label, fraction, name, value) =
    tapAt (label, fraction)
    knobNumber (name, value)

// A bypass pressed: it clears `name`, and the next key plays at `peak`.
bypassed (label, name, peak) =
    tap label
    flag (name, false)
    quietKey peak

// The rate `label` picked and the readout it shows.
ratePicked (label, shown) =
    tap label
    knobText ("rate", shown)

// The LFO sweeps at `hertz`: the next key plays at `peak`.
swept (hertz, peak) =
    near ((currentPatch ()).lfo, hertz)
    quietKey peak

launchAndCutoff () =
    begun ()
    offered "Skin: Prism"
    knobText ("selected", "process")
    knobText ("wave", "Sine")
    knobText ("rate", "1/4")
    knobNumber ("volume", 0.75)
    knobNumber ("keys", 1.0)
    knobText ("note", "A3")
    silent ()
    expect (letters "Click a key to play the patch.", true)
    expect (letters "220.0 Hz", true)
    offered "Play C3"
    offered "Play C#3"
    offered "Play B4"
    sounds ("A3", 75)
    before = startingAt "220.0 Hz"
    slid ("Filter Cutoff", 0.1, "process", 0.1)
    quietEdit before
    readThenPlay ("0.0 kHz", "A3", 17)

filterHistory () =
    bypassed ("Bypass LFO", "controlOn", 2)
    bypassed ("Bypass Filter", "processOn", 75)
    undone "processOn"
    quietKey 2
    undone "controlOn"
    quietKey 17
    knobText ("note", "A3")

// Every key of both octaves plays at its own pitch, the same key twice plays twice, and the readout follows.
keyboard () =
    tap "Bypass Filter"
    tap "Bypass LFO"
    sounds ("A3", 75)
    sounds ("A3", 75)
    a3 = argument 2
    sounds ("A4", 75)
    apart (argument 2, a3)
    expect (letters "440.0 Hz", true)
    struck ("C3", 130.8128)
    struck ("C#3", 138.5913)
    struck ("F#3", 184.9972)
    struck ("C4", 261.6256)
    expect (letters "261.6 Hz", true)
    struck ("D#4", 311.127)
    struck ("B4", 493.8833)
    readThenPlay ("493.9 Hz", "A3", 75)
    expect (argument 2, a3)
    tap "Undo"
    knobText ("note", "A3")
    flag ("controlOn", true)
    silent ()

// Each wave from the Oscillator's chooser plays its own clip at the filtered peak.
waves () =
    sine = firstClip ("Oscillator Wave: Sine", "waves")
    silent ()
    picked ("Square", "Square")
    square = argument 2
    apartThen ("Oscillator Wave: Square", sine)
    picked ("Saw", "Saw")
    apartThen ("Oscillator Wave: Saw", square)
    tap "Triangle"
    knobText ("wave", "Triangle")
    silent ()
    picked ("Undo", "Saw")
    expect (letters "Saw", true)

// Each LFO rate sweeps the cutoff at its own speed, so the clip changes.
rates () =
    clip = firstClip ("LFO Rate: 1/4", "rates")
    ratePicked ("1/16", "1/16")
    swept (8.0, 17)
    fast = argument 2
    apartThen ("LFO Rate: 1/16", clip)
    ratePicked ("1/1", "1/1")
    swept (0.5, 17)
    apart (argument 2, fast)
    ratePicked ("Undo", "1/16")
    quietKey 17
    expect (argument 2, fast)

// The Master Level slider scales the clip; the inspector's slider is the same control.
levels () =
    tapAt ("Filter Cutoff", 0.7)
    quietKey 75
    slid ("Master Level", 1.0, "volume", 1.0)
    quietKey 100
    expect (letters "0.0 dB", true)
    tap "Select Master"
    silent ()
    slid ("Inspector: Level", 0.5, "volume", 0.5)
    quietKey 50
    before = startingAt "-12.0 dB"
    slid ("Master Level", 0.0, "volume", 0.0)
    quietEdit before
    tap "Play A3"
    silent ()
    knobText ("note", "A3")
    tap "Undo"
    knobNumber ("volume", 0.5)
    quietKey 50

muteHistory () =
    before = described ()
    tap "Bypass Oscillator"
    muted (before, "sourceOn")
    tap "Play C4"
    silent ()
    tap "Enable Oscillator"
    flag ("sourceOn", true)
    quietKey 50
    tap "Bypass Master"
    silent ()
    flag ("outputOn", false)
    tap "Play A3"
    silent ()
    undone "outputOn"
    quietKey 50

muted (before, name) =
    silent ()
    flag (name, false)
    changed before

// ---- menus, skins and selection never ask the voice to play ----

quietMenu before =
    quietClick (before, "Skin: Prism")
    layer ("menu", "skins")
    pressedAt (before, 1400.0, 700.0)
    quietClick (before, "Skin: Prism")
    quietClick (before, "Topology")
    knobText ("skin", "topology")
    quietClick (before, "Skin: Topology")
    quietClick (before, "Prism")
    knobText ("skin", "prism")
    quietClick (before, "Oscillator Wave: Sine")
    pressedAt (before, 900.0, 700.0)

quietSelection (name, role, before) =
    tap "Select ${name}"
    quietPatch before
    knobText ("selected", role)
    offered "Inspector: Bypass ${name}"

quietSelections before =
    quietSelection ("LFO", "control", before)
    quietSelection ("Oscillator", "source", before)
    quietSelection ("Filter", "process", before)
    quietSelection ("Master", "output", before)
    quietSelection ("Scope", "monitor", before)

// Pressing, dragging, dropping and hovering over a node move it and stay silent.
quietDrag before =
    body = Semantics::point (element "Select Oscillator", 0.5)
    x = body.pointX + 80.0
    y = body.pointY + 30.0
    quietAt (before, body.pointX, body.pointY, true)
    quietAt (before, x, y, true)
    knobNumber ("sourceX", 80.0)
    quietAt (before, x, y, false)
    quietAt (before, body.pointX, body.pointY, false)
    knobNumber ("sourceY", 30.0)

// A slider dragged across and let go is silent throughout; the next key plays its final level.
slidQuietly () =
    low = Semantics::point (element "Master Level", 0.2)
    high = Semantics::point (element "Master Level", 0.6)
    quietPointer (low, true)
    forEachList ([true, false], \down =>
        quietPointer (high, down)
        knobNumber ("volume", 0.6))
    sounds ("A3", 60)

// A key is struck on release: pressing it, or hovering over it, plays nothing.
keyPress () =
    at = Semantics::point (element "Play E3", 0.5)
    quietPointer (at, false)
    quietPointer (at, true)
    knobText ("note", "A3")
    pointer (at.pointX, at.pointY, false)
    expect (runCount (), 1)
    knobText ("note", "E3")
    quietPointer (at, false)

test ("the voice renders each wave, rate and level, exact silence and a PCM WAV header", \() => Runtime::guarded (\() =>
    shapes ()
    voiceCases ()
    descriptionsDiffer ()
    wavCase ()))

// The window paints Prism's own background around the canvas, never the host's black.
windowBackground () = match ui::Themes::named (App::theme "prism", "background")
    Success token => expect (token.tokenDark, "#100D21")
    Error _ => expect ("no background token", "#100D21")

test ("launch is silent; bypasses and undo are silent; each key plays exactly the current patch at its pitch", \() => bench (\() =>
    windowBackground ()
    launchAndCutoff ()
    filterHistory ()
    keyboard ()))

test ("every wave, LFO rate and master level is silent, then a key plays its own clip, and undoes", \() => bench (\() =>
    begun ()
    tapAt ("Filter Cutoff", 0.1)
    waves ()
    rates ()
    levels ()
    muteHistory ()))

test ("menus, skin changes, node selections, node and slider drags stay quiet; a key plays on release", \() => bench (\() =>
    begun ()
    silent ()
    before = described ()
    quietMenu before
    quietSelections before
    quietDrag before
    slidQuietly ()
    keyPress ()))

test ("a larger window drops the keyboard and moves the inspector at their size, and the keys still play", \() => bench (\() =>
    roomyKeys ()))
