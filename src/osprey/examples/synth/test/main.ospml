// The Prism synth end to end ([UI-MACHINE-FLOW-SYNTH]): its voice is checked
// directly, then the real editor is driven by pointer events aimed through each
// control's accessible label. Every control is silent; every struck key's host
// playback request is compared with the patch, at the key's pitch, that made it.

import ui::Doc
import ui::Runtime
import ui::Canvases
import ui::MachineDocs
import ui::Machines
import uitest::Events
import uitest::Read
import uitest::Semantics
import uitest::Views
import signalflow::App
import synth::Studio
import synth::Synth

(** The decoded view, the latest envelope's text and the clock used for host events. *)
type Sight =
    sightSeen : uitest::Rendered
    sightEnvelope : string
    sightNow : int

(** The bench's only writes: retain the live session and the latest rendered sight. *)
effect Bench
    keep : ui::Session<signalflow::Store> => Unit
    see : Sight => Unit

mut sight = Sight(sightSeen = Read::blank (), sightEnvelope = "", sightNow = 1)
mut live = Runtime::idle (signalflow::Flow::store (MachineDocs::faulty ""))

kept (resident : ui::Resident<signalflow::Store>) =
    perform Bench.keep resident.residentSession
    perform Bench.see (sight(sightSeen = Read::envelope (sight.sightSeen, resident.residentEnvelope), sightEnvelope = resident.residentEnvelope, sightNow = sight.sightNow + 1))

hosted work =
    handle ui::Slices
        fetch _ => ""
    handle ui::SceneStream
        shape _ => 0
    work ()

bench work =
    handle Bench
        keep session => live := session
        see s => sight := s
    Runtime::guarded work

begun () =
    perform Bench.see (Sight(sightSeen = Read::blank (), sightEnvelope = "", sightNow = 1))
    hosted (\() => kept (Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\",\"arguments\":[]}", Studio::initial, App::regions, App::theme "prism")))

post event = hosted (\() => kept (Runtime::proceed (live, event, Studio::update, App::regions)))

pointer (x, y, down) = post (Events::pointer (sight.sightSeen.renderedRevision, sight.sightSeen.renderedOrdinal, x, y, down, sight.sightNow))

tapAt (label, fraction) =
    at = Semantics::point (element label, fraction)
    pointer (at.pointX, at.pointY, true)
    pointer (at.pointX, at.pointY, false)

tap label = tapAt (label, 0.5)

machine () = live.sessionStore.screen.screenMachine

currentPatch () = Synth::patch (machine ())

described () = Synth::describe (currentPatch ())

elements () = Canvases::semantics (machine ())

labels () = Semantics::labels (elements ())

element label = Semantics::element (elements (), label)

offers label = match Semantics::offered (elements (), label)
    true => true
    false =>
        print "# not offered: ${label}; the tree offers ${labels ()}"
        false

offered label = expect (offers label, true)

letters text = match Views::letters (sight.sightSeen, text)
    true => true
    false =>
        print "# not lettered: ${text}; the artboard letters ${Views::lettered sight.sightSeen}"
        false

flag (name, expected) = expect (Machines::flag (machine (), name), expected)
knobText (name, expected) = expect (Machines::text (machine (), name), expected)

knobNumber (name, expected) =
    actual = Machines::number (machine (), name)
    expect (actual - expected < 0.000001 && expected - actual < 0.000001, true)

layer (name, expected) = expect (Machines::current (machine (), name), expected)

// ---- the host requests in the latest envelope, read at the boundary ----

runRequests () = filterList (Doc::items (Doc::field (Doc::parse sight.sightEnvelope, "requests")), \request => Doc::text (request, "kind") == "run")

runCount () = length (runRequests ())

request () = listGet (runRequests ()) 0 ?: JsonNull

arguments () = Doc::texts (request (), "arguments")

argument index = listGet (arguments ()) index ?: ""

currentWav () = Synth::wav (Synth::samples (currentPatch ()))

nearPeak (patch, expected) = expect (abs (Synth::peak (Synth::samples patch) - expected) <= 1, true)

played expectedPeak =
    expect (runCount (), 1)
    forEachList ([("ticket", "play"), ("executable", "/usr/bin/perl")], \(field, want) => expect (Doc::text (request (), field), want))
    expect (length (arguments ()), 4)
    expect (argument 0, "-e")
    expect (argument 2, currentWav ())
    expect (argument 3, Synth::clipPath)
    nearPeak (currentPatch (), expectedPeak)

// Nothing reached the host, so the patch it would have played is untouched.
silent () = expect (runCount (), 0)

// An edit that plays nothing, then the key that plays the patch it left behind.
quietKey peak =
    silent ()
    sounds ("A3", peak)

quietPatch before =
    silent ()
    expect (described (), before)

// An edit that changes the patch and plays nothing.
quietEdit before =
    silent ()
    expect (described () == before, false)

// A press or release on a control: it moves nothing and it plays nothing.
quietPointer (point, down) =
    pointer (point.pointX, point.pointY, down)
    silent ()

quietClick (before, label) =
    tap label
    quietPatch before

// A press, its release and the menu it closed, all silent.
pressedAt (before, x, y) =
    pointer (x, y, true)
    pointer (x, y, false)
    quietPatch before
    layer ("menu", "closed")

// The first clip, then the chooser `menu` opens.
firstClip (menu, name) =
    sounds ("A3", 17)
    pressed = argument 2
    tap menu
    layer ("menu", name)
    pressed

// A menu entry picked, the readout it set and the silent key that follows.
picked (label, wave) =
    tap label
    knobText ("wave", wave)
    quietKey 17

rateChosen label =
    tap label
    knobText ("rate", "1/16")
lfoAt (hertz, peak) =
    near ((currentPatch ()).lfo, hertz)
    quietKey peak

volumeAt (level, peak) =
    knobNumber ("volume", level)
    quietKey peak

heldAt (point, down, level) =
    quietPointer (point, down)
    knobNumber ("volume", level)

stillPointer (x, y, down, before) =
    pointer (x, y, down)
    quietPatch before

undone name =
    tap "Undo"
    flag (name, true)

// A key struck: it lights, the readout shows it, and the patch plays at its pitch.
struck (name, hertz) =
    tap "Play ${name}"
    knobText ("note", name)
    near ((currentPatch ()).pitch, hertz)
    knobNumber ("hertz", (currentPatch ()).pitch)
    lettered name
    expect (runCount (), 1)
    expect (argument 2, currentWav ())

sounds (name, expectedPeak) =
    struck (name, Synth::frequency name)
    played expectedPeak

lettered text = expect (letters text, true)
differs previous = expect (argument 2 == previous, false)

// A different clip, then the chooser `menu` reopened for the next choice.
retuned (menu, previous) =
    differs previous
    tap menu

hear (text, peak) =
    lettered text
    sounds ("A3", peak)

editingAfter text =
    lettered text
    described ()

// ---- launch, editing and history through the Prism skin ----

launchAndCutoff () =
    begun ()
    offered "Skin: Prism"
    forEachList ([("selected", "process"), ("wave", "Sine"), ("rate", "1/4")], \(name, value) => knobText (name, value))
    forEachList ([("volume", 0.75), ("keys", 1.0)], \(name, value) => knobNumber (name, value))
    knobText ("note", "A3")
    silent ()
    forEachList (["Click a key to play the patch.", "220.0 Hz"], \text => lettered text)
    forEachList (["Play C3", "Play C#3", "Play B4"], \label => offered label)
    sounds ("A3", 75)
    before = editingAfter "220.0 Hz"
    tapAt ("Filter Cutoff", 0.1)
    knobNumber ("process", 0.1)
    quietEdit before
    hear ("0.0 kHz", 17)

filterHistory () =
    tap "Bypass LFO"
    flag ("controlOn", false)
    quietKey 2
    tap "Bypass Filter"
    flag ("processOn", false)
    quietKey 75
    undone "processOn"
    quietKey 2
    undone "controlOn"
    quietKey 17
    knobText ("note", "A3")

// Every key of both octaves plays at its own pitch, the same key twice plays twice, and the readout follows.
keyboard () =
    forEachList (["Bypass Filter", "Bypass LFO"], \label => tap label)
    forEachList ([75, 75], \peak => sounds ("A3", peak))
    a3 = argument 2
    sounds ("A4", 75)
    differs a3
    lettered "440.0 Hz"
    forEachList ([("C3", 130.8128), ("C#3", 138.5913), ("F#3", 184.9972), ("C4", 261.6256)], \(name, hertz) => struck (name, hertz))
    lettered "261.6 Hz"
    forEachList ([("D#4", 311.127), ("B4", 493.8833)], \(name, hertz) => struck (name, hertz))
    hear ("493.9 Hz", 75)
    sounds ("A3", 75)
    expect (argument 2, a3)
    tap "Undo"
    knobText ("note", "A3")
    flag ("controlOn", true)
    silent ()

// Each wave from the Oscillator's chooser plays its own clip at the filtered peak.
waves () =
    sine = firstClip ("Oscillator Wave: Sine", "waves")
    silent ()
    picked ("Square", "Square")
    square = argument 2
    retuned ("Oscillator Wave: Square", sine)
    picked ("Saw", "Saw")
    retuned ("Oscillator Wave: Saw", square)
    tap "Triangle"
    knobText ("wave", "Triangle")
    silent ()
    picked ("Undo", "Saw")
    lettered "Saw"

// Each LFO rate sweeps the cutoff at its own speed, so the clip changes.
rates () =
    clip = firstClip ("LFO Rate: 1/4", "rates")
    rateChosen "1/16"
    lfoAt (8.0, 17)
    fast = argument 2
    retuned ("LFO Rate: 1/16", clip)
    tap "1/1"
    lfoAt (0.5, 17)
    differs fast
    rateChosen "Undo"
    quietKey 17
    expect (argument 2, fast)

// The Master Level slider scales the clip; the inspector's slider is the same control.
levels () =
    tapAt ("Filter Cutoff", 0.7)
    quietKey 75
    tapAt ("Master Level", 1.0)
    volumeAt (1.0, 100)
    lettered "0.0 dB"
    tap "Select Master"
    silent ()
    tapAt ("Inspector: Level", 0.5)
    volumeAt (0.5, 50)
    before = editingAfter "-12.0 dB"
    tapAt ("Master Level", 0.0)
    knobNumber ("volume", 0.0)
    quietEdit before
    tap "Play A3"
    silent ()
    knobText ("note", "A3")
    tap "Undo"
    volumeAt (0.5, 50)

muteHistory () =
    before = described ()
    tap "Bypass Oscillator"
    muted (before, "sourceOn")
    tap "Play C4"
    silent ()
    tap "Enable Oscillator"
    flag ("sourceOn", true)
    quietKey 50
    tap "Bypass Master"
    silent ()
    flag ("outputOn", false)
    tap "Play A3"
    silent ()
    undone "outputOn"
    quietKey 50

muted (before, name) =
    silent ()
    flag (name, false)
    expect (described () == before, false)

// ---- menus, skins and selection never ask the voice to play ----

quietMenu before =
    quietClick (before, "Skin: Prism")
    layer ("menu", "skins")
    pressedAt (before, 1400.0, 700.0)
    quietClick (before, "Skin: Prism")
    quietClick (before, "Topology")
    knobText ("skin", "topology")
    quietClick (before, "Skin: Topology")
    quietClick (before, "Prism")
    knobText ("skin", "prism")
    quietClick (before, "Oscillator Wave: Sine")
    pressedAt (before, 900.0, 700.0)

quietSelection (name, role, before) =
    tap "Select ${name}"
    quietPatch before
    knobText ("selected", role)
    offered "Inspector: Bypass ${name}"

quietSelections before = forEachList ([("LFO", "control"), ("Oscillator", "source"), ("Filter", "process"), ("Master", "output"), ("Scope", "monitor")], \(name, role) => quietSelection (name, role, before))

// Pressing, dragging, dropping and hovering over a node move it and stay silent.
quietDrag before =
    body = Semantics::point (element "Select Oscillator", 0.5)
    stillPointer (body.pointX, body.pointY, true, before)
    stillPointer (body.pointX + 80.0, body.pointY + 30.0, true, before)
    knobNumber ("sourceX", 80.0)
    stillPointer (body.pointX + 80.0, body.pointY + 30.0, false, before)
    stillPointer (body.pointX, body.pointY, false, before)
    knobNumber ("sourceY", 30.0)

// A slider dragged across and let go is silent throughout; the next key plays its final level.
slidQuietly () =
    low = Semantics::point (element "Master Level", 0.2)
    high = Semantics::point (element "Master Level", 0.6)
    quietPointer (low, true)
    heldAt (high, true, 0.6)
    heldAt (high, false, 0.6)
    sounds ("A3", 60)

// A key is struck on release: pressing it, or hovering over it, plays nothing.
keyPress () =
    at = Semantics::point (element "Play E3", 0.5)
    quietPointer (at, false)
    quietPointer (at, true)
    knobText ("note", "A3")
    pointer (at.pointX, at.pointY, false)
    expect (runCount (), 1)
    knobText ("note", "E3")
    quietPointer (at, false)

test ("the voice renders each wave, rate and level, exact silence and a PCM WAV header", \() => Runtime::guarded (\() =>
    shapes ()
    voiceCases ()
    descriptionsDiffer ()
    wavCase ()))

// The window paints Prism's own background around the canvas, never the host's black.
windowBackground () = match ui::Themes::named (App::theme "prism", "background")
    Success token => expect (token.tokenDark, "#100D21")
    Error _ => expect ("no background token", "#100D21")

test ("launch is silent; bypasses and undo are silent; each key plays exactly the current patch at its pitch", \() => bench (\() =>
    windowBackground ()
    launchAndCutoff ()
    filterHistory ()
    keyboard ()))

test ("every wave, LFO rate and master level is silent, then a key plays its own clip, and undoes", \() => bench (\() =>
    begun ()
    tapAt ("Filter Cutoff", 0.1)
    waves ()
    rates ()
    levels ()
    muteHistory ()))

test ("menus, skin changes, node selections, node and slider drags stay quiet; a key plays on release", \() => bench (\() =>
    begun ()
    silent ()
    before = described ()
    quietMenu before
    quietSelections before
    quietDrag before
    slidQuietly ()
    keyPress ()))

test ("a larger window drops the keyboard and moves the inspector at their size, and the keys still play", \() => bench (\() =>
    roomyKeys ()))
