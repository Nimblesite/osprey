// The Prism synth's voice checked directly, without an editor ([UI-MACHINE-FLOW-SYNTH]): each wave's
// shape, each patch's clip and peak, descriptions that tell patches apart and the WAV header.

import uitest::Drive
import uitest::Semantics
import ui::Lists
import synth::Synth
import synth::Voice

// [PRISM-ROUTING-EDITOR] One selected module, compact controls, unchanged graph actions.
inspectorJourney () =
    launched = Drive::launched (Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ()), "macos", ["--empty"])
    opened = Drive::pointer (Drive::pointer (launched, 550.0, 32.0, true), 550.0, 32.0, false)
    oscillator = Drive::choose (opened, "Add component", "sine")
    filter = Drive::choose (oscillator, "Add component", "filter")
    expect (uitest::Views::shows (filter.drivenSeen, "Module"), true)
    expect (uitest::Views::shows (filter.drivenSeen, "Cutoff"), true)
    expect (uitest::Views::shows (filter.drivenSeen, "Frequency"), false)
    expect (uitest::Views::shows (filter.drivenSeen, "Select 1"), false)
    selected = Drive::choose (filter, "Module", "0")
    expect ((Drive::holding selected).selected, 0)
    expect (uitest::Views::shows (selected.drivenSeen, "Frequency"), true)
    expect (uitest::Views::shows (selected.drivenSeen, "Cutoff"), false)
    sourced = Drive::press (selected, "Use audio output")
    connected = Drive::press (Drive::choose (sourced, "Module", "1"), "Connect audio")
    expect (length (Drive::holding connected).graph.cables, 1)
    disconnected = Drive::press (connected, "Disconnect audio")
    expect (length (Drive::holding disconnected).graph.cables, 0)
    expect (uitest::Views::shows (disconnected.drivenSeen, "Remove module"), true)
    expect (length (Drive::holding disconnected).graph.nodes, 2)

patch (wave, process, depth, lfo, volume) = synth::Patch(pitch = 220.0, sounding = true, filtered = true, wave = wave, cutoff = 20.0 * pow (1000.0, process), depth = depth, lfo = lfo, audible = true, volume = volume)

defaultPatch () = patch ("Sine", 0.7, 0.7, 2.0, 0.75)

// One second of `p` per case: every voice case renders the whole second.
sized p = expect (length (Voice::samples p), Voice::rate)

voiceCase (p, expectedPeak) =
    sized p
    nearPeak (p, expectedPeak)
    expect (length (Synth::played p), 1)

silentCase p =
    sized p
    samples = Voice::samples p
    expect (Voice::peak samples, 0)
    expect (ui::Lists::all (samples, \sample => sample == 128), true)
    expect (length (Synth::played p), 0)

near (actual, expected) = expect (actual - expected < 0.0001 && expected - actual < 0.0001, true)

shapes () =
    near (Voice::shaped ("Sine", 0.25), 1.0)
    near (Voice::shaped ("Sine", 0.75), -1.0)
    near (Voice::shaped ("Triangle", 0.0), -1.0)
    near (Voice::shaped ("Triangle", 0.5), 1.0)
    near (Voice::shaped ("Triangle", 0.25), 0.0)
    near (Voice::shaped ("Saw", 0.0), -1.0)
    near (Voice::shaped ("Saw", 0.75), 0.5)
    near (Voice::shaped ("Square", 0.2), 1.0)
    near (Voice::shaped ("Square", 0.7), -1.0)
    near (Voice::shaped ("Sine", 1.25), 1.0)
    near (Voice::hertz "1/1", 0.5)
    near (Voice::hertz "1/2", 1.0)
    near (Voice::hertz "1/4", 2.0)
    near (Voice::hertz "1/8", 4.0)
    near (Voice::hertz "1/16", 8.0)
    near (Voice::frequency "A3", 220.0)
    near (Voice::frequency "A4", 440.0)
    near (Voice::frequency "C3", 130.8128)
    near (Voice::frequency "C4", 261.6256)
    near (Voice::frequency "C#4", 277.1826)
    near (Voice::frequency "F#3", 184.9972)
    near (Voice::frequency "B4", 493.8833)

voiceCases () =
    voiceCase (defaultPatch (), 75)
    voiceCase (patch ("Sine", 0.1, 0.7, 2.0, 0.75), 17)
    voiceCase (patch ("Sine", 0.1, 0.0, 2.0, 0.75), 2)
    voiceCase (patch ("Sine", 0.7, 0.7, 2.0, 1.0), 100)
    voiceCase (patch ("Sine", 0.7, 0.7, 2.0, 0.5), 50)
    voiceCase (patch ("Square", 0.7, 0.7, 2.0, 0.75), 75)
    voiceCase (patch ("Saw", 0.1, 0.7, 8.0, 0.75), 17)
    d = defaultPatch ()
    silentCase (d(sounding = false))
    silentCase (d(audible = false))
    silentCase (patch ("Sine", 0.7, 0.7, 2.0, 0.0))

// Two patches whose clips must not match.
differ (one, other) = expect (Voice::wav (Voice::samples one) == Voice::wav (Voice::samples other), false)

// Table rows: each patch must describe itself differently from `base`.
renamed (base, others) = forEachList (others, \other => expect (Voice::describe other == base, false))

// Every field of a patch changes what it sounds like.
descriptionsDiffer () =
    d = defaultPatch ()
    base = Voice::describe d
    renamed (base, [patch ("Saw", 0.7, 0.7, 2.0, 0.75), patch ("Sine", 0.1, 0.7, 2.0, 0.75), patch ("Sine", 0.7, 0.3, 2.0, 0.75), patch ("Sine", 0.7, 0.7, 8.0, 0.75), patch ("Sine", 0.7, 0.7, 2.0, 0.5), d(filtered = false), d(pitch = 440.0)])
    differ (d(pitch = 440.0), d)
    differ (patch ("Square", 0.1, 0.7, 2.0, 0.75), patch ("Saw", 0.1, 0.7, 2.0, 0.75))
    differ (patch ("Sine", 0.1, 0.7, 0.5, 0.75), patch ("Sine", 0.1, 0.7, 8.0, 0.75))

wavCase () =
    clip = Voice::wav (Voice::samples (defaultPatch ()))
    expect (length clip, (44 + Voice::rate) * 2)
    expect (startsWith clip "52494646352B000057415645666D7420", true)
    expect (contains clip "112B0000112B0000", true)
    expect (take (drop clip 72) 16, "64617461112B0000")

zeroStereoResponse () = "4F535631020000000200000000000000" + join (mapList (toList (range (0, 8)), \_ => "0001000000000000" + join (mapList (toList (range (0, 512)), \_ => "00000000")) "")) ""

// [SYNTH-DEVICE-QUEUE] The application harness supplies typed counter receipts;
// the native worker journey separately consumes real AudioQueue buffers.
// Reconstruct the concrete program so the compiler can prove callable effect provenance.
deviceDone given =
    driven = uitest::Driven(drivenSurface = given.drivenSurface, drivenProgram = synth::EditorApp::program (), drivenSeen = given.drivenSeen, drivenNow = given.drivenNow)
    held = uitest::Drive::holding driven
    match held.renderDevicePending
        [pending] =>
            draining = held.renderInput == "!drain"
            running = match draining
                true => "false"
                false => "true"
            handle ui::Slices
                fetch _ => "{\"status\":0,\"acceptedFrames\":${pending.deviceState.graphPosition},\"returnedFrames\":${pending.deviceState.graphPosition},\"queuedFrames\":0,\"channels\":${pending.deviceChannels},\"emptyCallbacks\":0,\"running\":${running}}"
            uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"stderr\":\"\"}")
        _ =>
            expect (false, true)
            driven

audioDone given =
    driven = uitest::Driven(drivenSurface = given.drivenSurface, drivenProgram = synth::EditorApp::program (), drivenSeen = given.drivenSeen, drivenNow = given.drivenNow)
    held = uitest::Drive::holding driven
    match startsWith held.renderTicket "prism-audio:device:"
        true => match held.renderDeviceKey == ""
            true => uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"session\":\"device\"}")
            false => deviceDone driven
        false => match held.renderOpening
            true => uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"session\":\"${held.renderTicket}\"}")
            false =>
                handle ui::Slices
                    fetch _ => zeroStereoResponse ()
                uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"stderr\":\"\"}")

// [SYNTH-DEVICE-QUEUE] Reject inconsistent device receipts without advancing graph state.
deviceCounterJourney editor =
    deviceWarningJourney editor
    valid = "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":0,\"queuedFrames\":2048,\"channels\":2,\"emptyCallbacks\":0,\"running\":false}"
    match synth::GraphDevice::checked (editor, valid)
        Success receipt => expect (receipt.acceptedFrames, 2048)
        Error _ => expect (false, true)
    forEachList (["{}", "invalid", replace valid "\"status\":0" "\"status\":1" ?: "invalid", replace valid "\"acceptedFrames\":2048" "\"acceptedFrames\":2049" ?: "invalid", replace valid "\"returnedFrames\":0" "\"returnedFrames\":-1" ?: "invalid", replace valid "\"queuedFrames\":2048" "\"queuedFrames\":0" ?: "invalid", replace valid "\"channels\":2" "\"channels\":1" ?: "invalid", replace valid "\"emptyCallbacks\":0" "\"emptyCallbacks\":-1" ?: "invalid", replace valid "false" "\"false\"" ?: "invalid"], \text =>
        match synth::GraphDevice::checked (editor, text)
            Success _ => expect (false, true)
            Error _ => expect (true, true))
    forEachList ([[], listConcat editor.renderDevicePending editor.renderDevicePending], \pending =>
        match synth::GraphDevice::checked (editor(renderDevicePending = pending), valid)
            Success _ => expect (false, true)
            Error _ => expect (true, true))
    match synth::GraphDevice::checked (editor(renderInput = "!drain"), valid)
        Success _ => expect (false, true)
        Error _ => expect (true, true)
    lost = synth::GraphPreview::completed (editor, editor.renderTicket, Error(message = "output disconnected"))
    expect (contains lost.stepStore.message "output disconnected", true)
    expect (length lost.stepStore.renderSessions, 0)
    expect (length lost.requests, 3)
    expect (length lost.writes, 6)
    cleanup = synth::GraphPreview::completed (lost.stepStore, "prism-audio:close:1:-1", Error(message = "already closed"))
    expect (contains cleanup.stepStore.message "output disconnected", true)
    expect (contains cleanup.stepStore.message "already closed", true)

// [SYNTH-DEVICE-QUEUE] Queue starvation must be visible at the controller boundary.
deviceWarningJourney editor =
    handle ui::Slices
        fetch _ => "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":2048,\"queuedFrames\":0,\"channels\":2,\"emptyCallbacks\":1,\"running\":true}"
    warned = synth::GraphPreview::completed (editor, editor.renderTicket, Success(value = "{\"status\":0,\"stderr\":\"\"}"))
    expect (contains warned.stepStore.message "Audio queue ran empty", true)
    expect (warned.stepStore.renderEmptyCallbacks, 1)
    stale = "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":2048,\"queuedFrames\":0,\"channels\":2,\"emptyCallbacks\":0,\"running\":true}"
    match synth::GraphDevice::checked (editor(renderEmptyCallbacks = 1), stale)
        Success _ => expect (false, true)
        Error _ => expect (true, true)

// [PRISM-ROUTING-PRESENTATION] Main's artwork controls edit the same live patch.
prismIntegratedJourney () =
    idle = Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ())
    opened = Drive::launched (idle, "macos", [])
    expect (length (Drive::holding opened).graph.nodes, 5)
    expect (length (Drive::holding opened).graph.cables, 4)
    forEachList (["Filter Cutoff", "Master Level", "Play C#3", "Modules", "Patch controls"], \label => expect (Semantics::offered (opened.drivenSeen.renderedAccess, label), true))
    cutoff = Semantics::point (Semantics::element (opened.drivenSeen.renderedAccess, "Filter Cutoff"), 0.5)
    changed = Drive::pointer (Drive::pointer (opened, cutoff.pointX, cutoff.pointY, true), cutoff.pointX, cutoff.pointY, false)
    match synth::Graphs::node ((Drive::holding changed).graph, 1)
        synth::Invalid _ => expect (false, true)
        synth::Valid n => match listGet n.parameters 0
            Error _ => expect (false, true)
            Success p => near (p.initial, synth::CanvasGeometry::cutoffFrequency 0.5)
    expect (length (Drive::holding changed).graph.cables, 4)
    level = Semantics::point (Semantics::element (changed.drivenSeen.renderedAccess, "Master Level"), 0.25)
    quieter = Drive::pointer (Drive::pointer (changed, level.pointX, level.pointY, true), level.pointX, level.pointY, false)
    match synth::Graphs::node ((Drive::holding quieter).graph, 2)
        synth::Invalid _ => expect (false, true)
        synth::Valid n => match listGet n.parameters 0
            Error _ => expect (false, true)
            Success p => near (p.initial, 0.25)
    library = Drive::pointer (Drive::pointer (quieter, 420.0, 32.0, true), 420.0, 32.0, false)
    expect ((Drive::holding library).paletteShown, true)
    added = Drive::pointer (Drive::pointer (library, 80.0, 130.0, true), 350.0, 230.0, false)
    expect (length (Drive::holding added).graph.nodes, 6)
    expect (length (Drive::holding added).graph.cables, 4)
    expect ((Drive::holding added).selected, 5)
    expect ((Drive::holding added).paletteDrag, "")
    prismControlJourney quieter
    keyboardDockJourney quieter

prismTap (driven, label) =
    point = Semantics::point (Semantics::element (driven.drivenSeen.renderedAccess, label), 0.5)
    Drive::pointer (Drive::pointer (driven, point.pointX, point.pointY, true), point.pointX, point.pointY, false)

prismControlJourney opened =
    menu = prismTap (opened, "Oscillator Wave: Sine")
    triangle = prismTap (menu, "Triangle")
    expect (Semantics::offered (triangle.drivenSeen.renderedAccess, "Oscillator Wave: Triangle"), true)
    bypassed = prismTap (triangle, "Bypass Oscillator")
    expect (Semantics::offered (bypassed.drivenSeen.renderedAccess, "Enable Oscillator"), true)
    match synth::Graphs::node ((Drive::holding bypassed).graph, 0)
        synth::Invalid _ => expect (false, true)
        synth::Valid n =>
            expect (length (filterList (n.parameters, \p => p.key == "waveform" && p.initial == 1.0)), 1)
            expect (length (filterList (n.parameters, \p => p.key == "enabled" && p.initial == 0.0)), 1)
    prismAudioJourney ((Drive::holding opened).graph, (Drive::holding triangle).graph, (Drive::holding bypassed).graph)
    enabled = prismTap (bypassed, "Enable Oscillator")
    rates = prismTap (enabled, "LFO Rate: 1/4")
    faster = prismTap (rates, "1/8")
    expect (Semantics::offered (faster.drivenSeen.renderedAccess, "LFO Rate: 1/8"), true)
    expect (length (Drive::holding faster).graph.cables, 4)

prismAudio graph = match synth::GraphClips::advance (graph, [], 128)
    Error why => Error(message = why)
    Success action => match action
        synth::ClipWaiting _ _ _ => Error(message = "Built-in graph unexpectedly requested a plug-in.")
        synth::ClipReady clips => synth::ClipInputs::completed (clips, 3)

prismAudioJourney (sine, triangle, muted) = match prismAudio sine
    Error _ => expect (false, true)
    Success first => match prismAudio triangle
        Error _ => expect (false, true)
        Success second => match prismAudio muted
            Error _ => expect (false, true)
            Success silent =>
                expect (length first.clipSamples, 128)
                expect (length second.clipSamples, 128)
                expect (structuralEquals (first.clipSamples, second.clipSamples), false)
                expect (length (filterList (silent.clipSamples, \value => value != 0.0)), 0)

// [PRISM-ROUTING-PRESENTATION] The dock owns a separate native scene and can be closed/reopened.
keyboardDockJourney opened =
    scenes = filterList (opened.drivenSeen.renderedControls, \control => control.controlKind == "scene")
    expect (length scenes, 2)
    near ((Semantics::element (opened.drivenSeen.renderedAccess, "Play C4")).accessTop, 38.0)
    taller = Drive::viewed (opened, 1836.0, 1258.0)
    near (ui::Machines::number ((Drive::holding taller).skin, "spareHeight"), 430.0)
    near ((Semantics::element (taller.drivenSeen.renderedAccess, "Play C4")).accessTop, 38.0)
    before = (Drive::holding taller).graph
    closed = dockTap (taller, "Close keyboard")
    expect ((Drive::holding closed).keyboardShown, false)
    expect (Semantics::offered (closed.drivenSeen.renderedAccess, "Play C4"), false)
    expect (length (filterList (closed.drivenSeen.renderedControls, \control => control.controlKind == "scene")), 1)
    expect (structuralEquals ((Drive::holding closed).graph, before), true)
    reopened = prismTap (closed, "Keyboard")
    expect ((Drive::holding reopened).keyboardShown, true)
    expect (Semantics::offered (reopened.drivenSeen.renderedAccess, "Play C4"), true)
    expect (structuralEquals ((Drive::holding reopened).graph, before), true)
    expect ((Drive::holding reopened).armedNote, -1)

dockTap (driven, label) =
    point = Semantics::point (Semantics::element (driven.drivenSeen.renderedAccess, label), 0.5)
    scenes = filterList (driven.drivenSeen.renderedControls, \control => control.controlKind == "scene")
    match listGet scenes 1
        Error _ =>
            expect (false, true)
            driven
        Success scene =>
            pressed = ui::Touch(touchNow = driven.drivenNow, touchKind = ui::Hosting::pointer, touchOrdinal = scene.controlOrdinal, touchWords = "", touchDetail = "", touchX = point.pointX, touchY = point.pointY, touchDown = true, touchShift = false)
            down = Drive::sent (driven, pressed)
            Drive::sent (down, pressed(touchNow = down.drivenNow, touchDown = false))
