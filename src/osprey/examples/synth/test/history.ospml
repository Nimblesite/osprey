import uitest::Drive

// [PRISM-ROUTING-EDITOR] History must edit the live graph, not only the retained skin.
graphHistoryJourney () =
    opened = editorLaunched ["--empty"]
    library = prismTap (opened, "Modules")
    added = prismTap (library, "Add Sine oscillator")
    expect (length (Drive::holding added).graph.nodes, 1)
    undone = prismTap (added, "Undo")
    expect (length (Drive::holding undone).graph.nodes, 0)
    redone = prismTap (undone, "Redo")
    expect (structuralEquals ((Drive::holding redone).graph, (Drive::holding added).graph), true)
    branched = prismTap (prismTap (prismTap (redone, "Undo"), "Modules"), "Add Low-pass filter")
    expect (length (Drive::holding branched).graph.nodes, 1)
    expect ((Drive::holding branched).selected > (Drive::holding added).selected, true)
    noRedo = prismTap (branched, "Redo")
    expect (structuralEquals ((Drive::holding noRedo).graph, (Drive::holding branched).graph), true)
    expect (length (Drive::holding noRedo).future, 0)
    historyRemovalJourney ()

// Deleting a routed module restores its parameters, position and cables as one operation.
historyRemovalJourney () =
    opened = prismTap (editorLaunched [], "Patch controls")
    changed = Drive::choose (opened, "Cutoff", "3200")
    removed = Drive::press (changed, "Remove module")
    expect (length (Drive::holding removed).graph.nodes, 4)
    restored = prismTap (removed, "Undo")
    expect (structuralEquals ((Drive::holding restored).graph, (Drive::holding changed).graph), true)
    expect (structuralEquals ((Drive::holding restored).positions, (Drive::holding changed).positions), true)
    original = prismTap (restored, "Undo")
    expect (structuralEquals ((Drive::holding original).graph, (Drive::holding opened).graph), true)
    historyDragJourney ()

// Moving a module through several pointer positions creates exactly one reversible edit.
historyDragJourney () =
    opened = editorLaunched []
    before = Drive::holding opened
    grabbed = Drive::pointer (opened, 560.0, 370.0, true)
    moved = Drive::pointer (Drive::pointer (grabbed, 580.0, 380.0, true), 600.0, 390.0, true)
    released = Drive::pointer (moved, 620.0, 400.0, false)
    after = Drive::holding released
    expect (structuralEquals (after.positions, before.positions), false)
    expect (length after.past, length before.past + 1)
    undone = prismTap (released, "Undo")
    expect (structuralEquals ((Drive::holding undone).positions, before.positions), true)
    redone = prismTap (undone, "Redo")
    expect (structuralEquals ((Drive::holding redone).positions, after.positions), true)
