// The Prism synth's C boundary for any Osprey Native host ([NATIVE-SHM-BOUNDARY],
// [NATIVE-SHM-EVENT]): `argument` gathers the launch arguments, `open` draws the first frame and
// `event` delivers one typed host event and draws the next. Nothing is encoded in either
// direction: the frame is view, scene and ask rows the host seals when each call returns, and the
// session stays in this library.

import ui::Runtime
import ui::Views
import ui::Surfaces
import ui::Hosting
import synth::EditorApp
import synth::Studio

extern native_slice (key : string) -> string

(** Hands the next surface to the cell below. *)
effect Keep
    keep : ui::Surface<synth::Editor<synth::Graph, synth::GraphPending<synth::Graph, synth::KernelState>, synth::GraphState<synth::KernelState>>, synth::EditorAction> => Unit

// [PRISM-ROUTING-PRESENTATION] The polished studio remains the normal launch;
// the routing workspace is explicitly selected while its presentation is integrated.
effect KeepStudio
    keepStudio : ui::Surface<signalflow::Store, ui::Lever> => Unit

mut studio = Surfaces::idle (signalflow::Flow::store (ui::MachineDocs::faulty ""))
mut held = Surfaces::idle (synth::EditorState::initial ())

hosted work =
    handle KeepStudio
        keepStudio next => studio := next
    handle Keep
        keep next => held := next
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)

kept next =
    perform Keep.keep next
    Hosting::answer next

keptStudio next =
    perform KeepStudio.keepStudio next
    Hosting::answer next

(** Gathers one launch argument, in order, before `open`. *)
argument text =
    hosted (\() =>
        perform Keep.keep (Surfaces::argued (held, text))
        keptStudio (Surfaces::argued (studio, text)))

(** Draws the first frame for the host's clock, zone offset, platform, home folder and appearance. *)
open (now, offset, platform, home, dark) = hosted (\() =>
    match ui::Lists::any (held.surfaceArguments, \arg => arg == "--routing")
        true => kept (Hosting::opened (held, EditorApp::program (), now, offset, platform, home, dark))
        false => keptStudio (Hosting::opened (studio, Studio::program (), now, offset, platform, home, dark)))

(** Delivers one host event and draws the next frame; nonzero when it was refused, which changes nothing. *)
event (now, kind, ordinal, words, detail, x, y, down, shift) = hosted (\() =>
    match ui::Lists::any (held.surfaceArguments, \arg => arg == "--routing")
        true => kept (Hosting::touched (held, EditorApp::program (), now, kind, ordinal, words, detail, x, y, down, shift))
        false => keptStudio (Hosting::touched (studio, Studio::program (), now, kind, ordinal, words, detail, x, y, down, shift)))
