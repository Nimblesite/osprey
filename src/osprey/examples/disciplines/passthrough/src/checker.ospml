//! The `passthrough` reference type discipline of [TYPES-DISCIPLINE-REFERENCE]
//! (spec 0050). It checks nothing of its own: it runs the compiler's ordinary
//! rules on the module and returns the module's inferred signature and the
//! module itself as its erased form. Its value is the round trip — an `hm`
//! module importing a `passthrough` one and the reverse, with output identical
//! to the same program under `hm` alone.
//!
//! This directory is the checker project: the compiler builds it as one program
//! whose entry, `main.ospml`, answers the one request line the seam writes to
//! standard input. The protocol, the rewrite, the diagnostic parser and the
//! import stubs live here; `tests/suite.ospml` asserts on them, and
//! `osprey test` on the package runs that suite.
//!
//! A single-file `--check` cannot resolve imports, so the checker appends what
//! it can of them to the scratch copy as ML `extern` declarations built from
//! `imports[].signature`. An `extern` carries no type parameters, no record or
//! union type and no zero-argument form, so a module importing any of those, or
//! anything an inferred signature omits, is refused with `passthrough/imports`
//! instead of checked against a weaker stub.

namespace passthrough

(** The marker spellings the seam scans for ([TYPES-DISCIPLINE-SELECT]). *)
markerPrefixes = ["// osprey: types=", "//osprey: types=", "# osprey: types=", "#osprey: types="]
hmMarker = "// osprey: types=hm"
hmMarkerPython = "# osprey: types=hm"
(** The compiler prefixes each of these with `passthrough/`. *)
codeCheck = "check"
codeImports = "imports"
codeInternal = "internal"
protocolVersion = 2
signaturePrefix = "signature "
(** A stub for an imported module that exports nothing at all. *)
emptyStub = "    extern __passthrough_imported (p0 : int) -> int\n"
(** Type names an `extern` declaration can spell. A type outside this list is
    one the signature does not define, which no stub may invent. *)
knownTypes = ["int", "float", "string", "bool", "Unit", "List", "Map", "Result", "Json", "JsonMember", "Error", "any", "printable", "never"]
identifierChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
notFlat = "is not a flat `(parameters) -> result` type"

(** One `rejected` protocol JSON line carrying the single diagnostic `code`, `line`, `column` and `message`; an absent position is spelled `null`. *)
rejectedLine (code, line, column, message) = "{\"version\":2,\"result\":\"rejected\",\"signature\":\"\",\"erased\":null,\"diagnostics\":[{\"code\":\"" + code + "\",\"severity\":\"error\",\"line\":" + line + ",\"column\":" + column + ",\"message\":\"" + message + "\"}]}"

(** One `rejected` protocol JSON line from the checker's own unpositioned `internal` diagnostic. *)
internalLine message = rejectedLine ("internal", "null", "null", message)

(** The last element of `parts`; used for a bare file name and a module title. *)
lastPart parts = foldList (parts, "", \(_, part) => part)

(** One request line of the checker protocol, decoded. *)
type Request =
    path : string
    flavor : string
    source : string
    cache : string
    compiler : string
    imports : List<Imported>
type Imported =
    name : string
    text : string
    omitted : List<string>
type Erased =
    flavor : string
    source : string
type Diagnostic =
    code : string
    line : int
    column : int
    message : string
type Ran =
    code : int
    out : string
    err : string
type Decoded = IsRequest Request | NotRequest string
type Response = Accepted string Erased | Rejected List<Diagnostic>
(** What one import's stub became, or why it cannot be stubbed. *)
type Attempt = Held string | Refused string
type Stubbed = Ready string | Unstubbable string
type Declaration = Declared string | Undeclared string

(** Rewriting the discipline marker on the way into the compiler. *)
module Marker
    (** `source` with every marker line rewritten to `hm`; the marker is a
        comment, so this changes no layout and no code.
    # Examples
    ```osprey
    print (Marker::rewrite "// osprey: types=passthrough\nf x = x")
    ```
    ```output
    // osprey: types=hm
    f x = x
    ```
    *)
    export rewrite source = join (mapList (split (source, "\n") ?: [source], rewritten), "\n")

    (** The file name after the last `/`, or `\` on Windows, kept with its
        extension so the compiler resolves the same flavor for the scratch copy.
    # Examples
    ```osprey
    print "${Marker::basename "src/deep/checker.ospml"} ${Marker::basename "plain.osp"} ${Marker::basename "C:\\r\\src\\count.ospml"}"
    ```
    ```output
    checker.ospml plain.osp count.ospml
    ```
    *)
    export basename path = lastPart (split (replace (path, "\\", "/") ?: path, "/") ?: [path])

    rewritten text = match marked (trim text)
        true => replacement text
        false => text

    marked (text) = foldList (markerPrefixes, false, \(found, prefix) => found || startsWith (text, prefix))

    replacement text = match startsWith (trim text) "#"
        true => hmMarkerPython
        false => hmMarker

(** Answering with one JSON line ([TYPES-DISCIPLINE-PROTOCOL]). *)
module Replies
    (** `accepted` with the inferred signature and the erased module.
    # Examples
    ```osprey
    print (Replies::accepted ("f : int -> int", Erased(flavor = "ml", source = "f x = x")))
    ```
    ```output
    {"version":2,"result":"accepted","signature":"f : int -> int","erased":{"flavor":"ml","source":"f x = x"},"diagnostics":[]}
    ```
    *)
    export accepted (text, erased) = encoded (acceptedJson (text, erased))

    (** `rejected` carrying every positioned diagnostic the check found.
    # Examples
    ```osprey
    print (Replies::rejected [Diagnostic(code = "check", line = 2, column = 4, message = "unknown y")])
    ```
    ```output
    {"version":2,"result":"rejected","signature":"","erased":null,"diagnostics":[{"code":"check","severity":"error","line":2,"column":4,"message":"unknown y"}]}
    ```
    *)
    export rejected diagnostics = encoded (rejectedJson diagnostics)
    (** A rejection of the checker's own doing.
    # Examples
    ```osprey
    print (Replies::internal "no request")
    ```
    ```output
    {"version":2,"result":"rejected","signature":"","erased":null,"diagnostics":[{"code":"internal","severity":"error","line":null,"column":null,"message":"no request"}]}
    ```
    *)
    export internal message = refusing (codeInternal, message)

    (** A `rejected` reply carrying the one unpositioned diagnostic `code`/`message`.
    # Examples
    ```osprey
    print (Replies::refusing ("imports", "no stub"))
    ```
    ```output
    {"version":2,"result":"rejected","signature":"","erased":null,"diagnostics":[{"code":"imports","severity":"error","line":null,"column":null,"message":"no stub"}]}
    ```
    *)
    export refusing (code, message) = rejected ([Diagnostic(code = code, line = -1, column = -1, message = message)])

    encoded json = jsonEncode json ?: fallback ()
    acceptedJson (text, erased) = envelope ("accepted", text, erasedJson erased, [])

    rejectedJson diagnostics = envelope ("rejected", "", JsonNull, mapList (diagnostics, diagnosticJson))

    (** The protocol envelope both replies share, with every member the result shape leaves open filled in. *)
    envelope (result, text, erased, diagnostics) = JsonObject [
        JsonMember("version", JsonInt protocolVersion),
        JsonMember("result", JsonString result),
        JsonMember("signature", JsonString text),
        JsonMember("erased", erased),
        JsonMember("diagnostics", JsonArray diagnostics)]

    erasedJson erased = JsonObject [
        JsonMember("flavor", JsonString erased.flavor),
        JsonMember("source", JsonString erased.source)]

    diagnosticJson diagnostic = JsonObject [
        JsonMember("code", JsonString diagnostic.code),
        JsonMember("severity", JsonString "error"),
        JsonMember("line", position diagnostic.line),
        JsonMember("column", position diagnostic.column),
        JsonMember("message", JsonString diagnostic.message)]

    position at = match at < 0
        true => JsonNull
        false => JsonInt at

    (** The line `encoded` answers with when the encoder itself fails. *)
    fallback () = internalLine "the checker could not encode its response"

(** Turning the compiler's stderr into diagnostics, with the positions it wrote. *)
module Checks
    (** One diagnostic per non-blank stderr line, `path:line:col:` parsed. The
        compiler names a Windows file with `\`, where the checker joined its
        scratch path with `/`, so both read as `/` when the line is matched.
    # Examples
    ```osprey
    shown () = join (mapList (Checks::diagnostics ("C:\\c/m.ospml", "C:\\c\\m.ospml:3:5: unknown y\n\nlinker failed"), \d => "${d.line}:${d.column} ${d.message}"), " | ")
    print (exactArithmetic shown)
    ```
    ```output
    3:5 unknown y | -1:-1 linker failed
    1..0
    # tests=0 passed=0 failed=0 skipped=0
    ```
    *)
    export diagnostics (path, stderr) =
        filterList (mapList (split (stderr, "\n") ?: [], read (path)), \one => !isEmpty one.message)

    read (path) line = match startsWith (slashed line, slashed path + ":")
        true => positioned (drop (line, length path + 1))
        false => whole line

    slashed text = replace (text, "\\", "/") ?: text

    (** `next` with the integer or offset `found` carries, or the whole `rest` as one unpositioned diagnostic when it holds none. *)
    counted (rest, found, next) = match found
        Error _ => whole rest
        Success at => next at

    positioned rest = counted (rest, indexOf (rest, ":"), \first => numbered (rest, first))

    numbered (rest, first) =
        column = drop (rest, first + 1)
        counted (rest, indexOf (column, ":"), \second => measured (rest, column, first, second))

    measured (rest, column, first, second) = counted (rest, parseInt (substring (rest, 0, first) ?: ""), atLine rest column second)

    (** The positioned diagnostic at `at`, once `column`'s integer is read too. *)
    atLine rest column second at = match parseInt (substring (column, 0, second) ?: "")
        Error _ => whole rest
        Success where => Diagnostic(code = codeCheck, line = at, column = where, message = trim (drop (column, second + 1)))

    whole message = Diagnostic(code = codeCheck, line = -1, column = -1, message = trim message)

(** The `extern` declarations that stand in for the signatures a module imports. *)
module Signatures
    (** The stub source to append to the scratch copy of the module.
    # Examples
    ```osprey
    shown () = match Signatures::stubs []
        Ready text => "ready [${text}]"
        Unstubbable why => "refused ${why}"
    print (exactArithmetic shown)
    ```
    ```output
    ready []
    1..0
    # tests=0 passed=0 failed=0 skipped=0
    ```
    *)
    export stubs imports = gathered (imports, [])

    (** The module names the stubs stand in for, so their signature blocks are
        not returned as part of the checked module's own signature.
    # Examples
    ```osprey
    print (join (Signatures::titles [Imported(name = "tools::Text", text = "", omitted = []), Imported(name = "Plain", text = "", omitted = [])], ","))
    ```
    ```output
    Text,Plain
    ```
    *)
    export titles imports = mapList (imports, \imported => lastPart (split (imported.name, "::") ?: [imported.name]))

    gathered (imports, stubs) = match imports
        [] => Ready (join (stubs, ""))
        [first, ...rest] => appended (stub first, rest, stubs)
    appended (attempt, rest, stubs) = match attempt
        Held text => gathered (rest, listAppend (stubs, text))
        Refused why => Unstubbable why

    stub imported = match split (imported.name, "::")
        Success parts => piece (parts, imported)
        Error _ => notScoped imported

    piece (parts, imported) = match parts
        [space, title] => checked (space, title, imported)
        _ => notScoped imported

    notScoped imported = Refused ("import `" + imported.name + "` is not a `namespace::Module` name")

    checked (space, title, imported) = match imported.omitted
        [] => body (space, title, linesOf imported.text, [])
        omitted => Refused ("import `" + imported.name + "` exports " + join (omitted, ", ")
            + ", which an inferred signature names but does not describe, so the module cannot be checked on its own")

    body (space, title, lines, items) = match lines
        [] => Held ("namespace " + space + "\nmodule " + title + "\n" + spelled items)
        [first, ...rest] => match declaration first
            Declared text => body (space, title, rest, listAppend (items, text))
            Undeclared why => Refused ("import `" + title + "` item `" + trim first + "` " + why)

    spelled items = match items
        [] => emptyStub
        _ => join (items, "")

    linesOf text = filterList (split (text, "\n") ?: [], \line => !isEmpty (trim line) && !startsWith (trim line, signaturePrefix))

    declaration line = match indexOf (line, ":")
        Error _ => Undeclared "is not a `name : type` signature item"
        Success colon => named (trim (substring (line, 0, colon) ?: ""), trim (drop (line, colon + 1)))

    named (name, ty) = match contains name "<"
        true => Undeclared "is polymorphic, which an `extern` declaration cannot spell"
        false => typed (name, ty)
    typed (name, ty) = match startsWith (trim ty) "("
        true => opened (name, trim ty, indexOf (trim ty, ")"))
        false => Undeclared notFlat

    opened (name, ty, close) = match close
        Error _ => Undeclared notFlat
        Success at => flat (name, ty, at)

    flat (name, ty, at) =
        rest = trim (drop (ty, at + 1))
        match startsWith rest "->"
            true => argumented (name, splitArguments (substring (ty, 1, at) ?: ""), trim (drop (rest, 2)))
            false => Undeclared notFlat

    argumented (name, arguments, result) = match arguments
        [] => Undeclared "takes no arguments, which an `extern` declaration cannot spell"
        _ => admitted (name, arguments, result)

    admitted (name, arguments, result) = match unsupported (arguments, result)
        [] => Declared ("    export extern " + name + parameters (arguments, 0) + " -> " + result + "\n")
        reasons => Undeclared ("uses " + join (reasons, ", ") + ", which an `extern` declaration cannot express")

    (** Every reason `arguments` or `result` cannot be written in an `extern`. *)
    unsupported (arguments, result) =
        foldList (arguments, reasons result, \(all, argument) => listConcat (all, reasons argument))

    reasons ty = matched (ty, shapes ty)

    matched (ty, found) = match found
        [] => unnamed (filterList (identifiers (ty, 0, "", []), \(word) => !listContains (knownTypes, word)))
        _ => found

    shapes ty = joined ([
        marked (ty, "{", "a record type"),
        marked (ty, "|", "a union type"),
        marked (ty, "!", "an effect row"),
        marked (ty, "->", "a function type")])

    unnamed (words) = mapList (words, \word => "the type `" + word + "`")

    marked (ty, sign, label) = match contains ty sign
        true => [label]
        false => []

    joined (groups) = foldList (groups, [], \(all, group) => listConcat (all, group))

    parameters (arguments, at) = match arguments
        [] => ""
        [first, ...rest] => " (p" + toString at + " : " + first + ")" + parameters (rest, at + 1)

    (** The one character at `at` of `text`, or nothing past the end. *)
    charAt (text, at) = substring (text, at, at + 1) ?: ""

    (** The parameters of a list type, split at commas outside brackets. *)
    splitArguments params = parts (params, 0, 0, 0, [])

    parts (text, at, depth, start, found) = match at >= length text
        true => listReverse (listAppend (found, trim (substring (text, start, length text) ?: "")))
        false => stepped (text, at, depth, start, found, charAt (text, at))

    stepped (text, at, depth, start, found, char) = match contains ("([{<", char)
        true => parts (text, at + 1, depth + 1, start, found)
        false => match contains (")]}>", char)
            true => parts (text, at + 1, depth - 1, start, found)
            false => separated (text, at, depth, start, found, char)

    separated (text, at, depth, start, found, char) = match char == "," && depth == 0
        true => parts (text, at + 1, depth, at + 1, listAppend (found, trim (substring (text, start, at) ?: "")))
        false => parts (text, at + 1, depth, start, found)

    (** Every identifier one type spelling contains. *)
    identifiers (ty, at, current, found) = match at >= length ty
        true => ended (current, found)
        false => scanning (ty, at, current, found, charAt (ty, at))

    scanning (ty, at, current, found, char) = match contains identifierChars char
        true => identifiers (ty, at + 1, current + char, found)
        false => identifiers (ty, at + 1, "", ended (current, found))

    ended (current, found) = match isEmpty current
        true => found
        false => listAppend (found, current)

(** Running the compiler the seam runs, with both streams captured to files. *)
module Tool
    (** Run `command` through the shell, capturing stdout and stderr. The
        runner creates the result cache before it spawns a checker, so the
        directory the capture files land in already exists.
    # Examples
    ```osprey
    ran = Tool::capture ("/tmp", "passthrough-doc", "echo hi; echo oops >&2")
    print "${ran.code} ${trim ran.out} ${trim ran.err}"
    ```
    ```output
    0 hi oops
    ```
    *)
    export capture (directory, name, command) =
        out = directory + "/" + name + ".out"
        err = directory + "/" + name + ".err"
        status = exited (spawnProcess (lineFor (onWindows (), "( " + command + " ) >" + quoted out + " 2>" + quoted err), quiet))
        Ran(code = status, out = content (readFile out), err = content (readFile err))

    // Windows always sets SystemRoot, and MSYS2's shell keeps it where it drops OS.
    onWindows () = !isEmpty (env "SystemRoot" ?: "")

    (** The line the host's spawner runs: `/bin/sh` takes it as written, while
        `cmd.exe` strips the outer pair of quotes from a line that starts with
        one, so on Windows the line goes in one more pair.
    # Examples
    ```osprey
    print "${Tool::lineFor (false, "'a' >'b'")} ${Tool::lineFor (true, "\"a\" >\"b\"")}"
    ```
    ```output
    'a' >'b' ""a" >"b""
    ```
    *)
    export lineFor (windows, line) = match windows
        true => "\"" + line + "\""
        false => line

    exited result = match result
        Success id => awaitProcess id
        Error _ => -1
    content result = match result
        Success text => text
        Error _ => ""

    (** `text` as one word for this host's spawner. *)
    export quoted text = quotedFor (onWindows (), text)

    (** `text` as one word: single-quoted for a POSIX shell, each embedded `'`
        escaped; double-quoted for `cmd.exe`, which knows no single quotes (no
        Windows path holds a `"`).
    # Examples
    ```osprey
    print "${Tool::quotedFor (false, "it's here")} ${Tool::quotedFor (true, "C:\\it's here")}"
    ```
    ```output
    'it'\''s here' "C:\it's here"
    ```
    *)
    export quotedFor (windows, text) = match windows
        true => "\"" + text + "\""
        false => "'" + (replace (text, "'", "'\\''") ?: text) + "'"

    quiet (_id, _kind, _data) = cleanupProcess 0

(** The checker program of [TYPES-DISCIPLINE-PROTOCOL]. *)
module Checker
    (** The one response line for the request line `line`.
    # Examples
    ```osprey
    print (exactArithmetic (\() => Checker::answer "not json"))
    ```
    ```output
    {"version":2,"result":"rejected","signature":"","erased":null,"diagnostics":[{"code":"internal","severity":"error","line":null,"column":null,"message":"the request line is not one JSON object of the checker protocol"}]}
    1..0
    # tests=0 passed=0 failed=0 skipped=0
    ```
    *)
    export answer line = match decoded line
        IsRequest request => inspect request
        NotRequest why => Replies::internal why

    decoded (line) = match jsonDecode line
        Error _ => NotRequest "the request line is not one JSON object of the checker protocol"
        Success document => requestOf document
    requestOf document =
        source = textAt (document, "module", "source")
        cache = textAt (document, "options", "cache_dir")
        compiler = textAt (document, "options", "compiler")
        match isEmpty source || isEmpty cache || isEmpty compiler
            true => NotRequest "the request names no module source, cache directory or compiler"
            false => IsRequest (Request(
                path = textAt (document, "module", "path"),
                flavor = textAt (document, "module", "flavor"),
                source = source,
                cache = cache,
                compiler = compiler,
                imports = importsOf document))

    textAt (document, section, key) = jsonText (field (field (document, section), key)) ?: ""
    field (json, name) = jsonField (json, name) ?: JsonNull

    importsOf document = match field (document, "imports")
        JsonArray items => mapList (items, importedOf)
        _ => []

    importedOf item = Imported(
        name = textOf (item, "name"),
        text = textOf (item, "signature"),
        omitted = namesOf (field (item, "omitted")))

    textOf (json, name) = jsonText (field (json, name)) ?: ""

    namesOf json = match json
        JsonArray items => mapList (items, \item => jsonText item ?: "")
        _ => []

    inspect request = match Signatures::stubs request.imports
        Unstubbable why => Replies::refusing (codeImports, why)
        Ready stubs => written (request, stubs)

    written (request, stubs) =
        erased = Marker::rewrite request.source
        name = Marker::basename request.path
        directory = request.cache
        target = directory + "/" + name
        match writeFile (target, erased + stubs)
            Error why => Replies::internal ("cannot create " + directory + " or write " + target + ": " + why)
            Success _ => checked (request, directory, name, target, erased)

    checked (request, directory, name, target, erased) =
        ran = Tool::capture (directory, name + ".check", checkCommand (request, target))
        match ran.code == 0
            true => signed (request, directory, name, target, erased)
            false => rejectedBy (target, erased, ran.err)

    (** The quoted compiler invocation on the scratch copy, with `flags` appended. *)
    compiling (request, target, flags) = Tool::quoted request.compiler + " " + Tool::quoted target + " " + flags

    checkCommand (request, target) = compiling (request, target, "--check --no-warnings")

    rejectedBy (target, erased, stderr) = match Checks::diagnostics (target, stderr)
        [] => Replies::refusing (codeCheck, "the compiler rejected the module without a diagnostic")
        found => Replies::rejected (mapList (found, \one => marked (one, lineCount erased)))

    (** A diagnostic past the module's last line can only be about the stub the
        checker appended, so it is the checker's fault, never the user's. *)
    marked (diagnostic, lines) = match diagnostic.line > lines
        true => Diagnostic(
            code = codeInternal,
            line = diagnostic.line,
            column = diagnostic.column,
            message = "the checker's own import stub was rejected: " + diagnostic.message)
        false => diagnostic

    lineCount text = listLength (split (text, "\n") ?: [text])

    signed (request, directory, name, target, erased) =
        ran = Tool::capture (directory, name + ".signature", compiling (request, target, "--signature"))
        match ran.code == 0
            true => exported (request, erased, kept (ran.out, Signatures::titles request.imports))
            false => Replies::internal ("the compiler checked the module but refused its signature: " + trim ran.err)

    exported (request, erased, text) = match isEmpty (trim text)
        true => Replies::internal ("the compiler inferred no signature for `" + request.path + "`")
        false => Replies::accepted (text, Erased(flavor = request.flavor, source = erased))

    (** The signature text without the blocks the imported stubs contributed.
        The stubs are appended after the module, so the first stub block ends
        the module's own text. *)
    kept (text, titles) = ending (split (text, "\n") ?: [], titles, [])

    ending (lines, titles, kept) = match lines
        [] => join (listReverse kept, "\n")
        [first, ...rest] => match stubBlock (first, titles)
            true => join (listReverse kept, "\n")
            false => ending (rest, titles, listPrepend (kept, first))

    (** Whether `line` opens one of the imported stubs' signature blocks, where the module's own text ends. *)
    stubBlock (line, titles) = match startsWith line signaturePrefix
        true => listContains (titles, trim (drop (line, length signaturePrefix)))
        false => false
