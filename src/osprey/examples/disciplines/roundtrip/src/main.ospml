namespace roundtrip

import roundtrip::Count
import roundtrip::Numbers

// The erased `Count` is ordinary Osprey with an `Arith` row, so the entry
// supplies the arithmetic policy ([ARITH-EFFECT]).
main () =
    handle Arith
        overflow _op _lhs _rhs wrapped => wrapped
        divideByZero _op _lhs => 0.0
        remainderByZero _lhs => 0
    print "count doubled 3 = ${toString (Count::doubled 3)}\ncount label 5 = ${Count::label 5}\ncount total 2 5 = ${toString (Count::total (2, 5))}\nnumbers twice 4 = ${toString (Numbers::twice 4)}"
