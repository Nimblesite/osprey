// The casting player's C boundary for the GPUI host ([GPUI-HOST-BOUNDARY], [UI-RESIDENT]). The
// session stays in this library between calls, the canvas's rects, discs and sprites go to the host
// one call at a time ([UI-SCENE-STREAM]), and every device byte goes through the
// @osprey/chromecast port's real `Wire.Native` handler.

import ui::Runtime
import casting::App
import ui::Streams

extern native_slice (key : string) -> string

(** Hands the session the framework returned to the cell below. *)
effect Keep
    keep : ui::Session<casting::Store> => Unit

mut live = Runtime::idle (casting::Link::store (ui::MachineDocs::faulty ""))

keeping (done : ui::Resident<casting::Store>) =
    perform Keep.keep done.residentSession
    done.residentEnvelope

hosted work =
    handle Keep
        keep session => live := session
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => chromecast::Wire::Native (\() => keeping (Streams::shared work)))

// [UI-THEME] The launch is prepared once, so the host's first envelope carries the theme of the store it started: the chosen machine's skin, not an empty one.
start source = hosted (\() => App::begun source)

dispatch (_saved : string, event) = hosted (\() => Runtime::proceed (live, event, App::update, App::regions))
