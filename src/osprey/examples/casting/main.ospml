// The casting player's C boundary for any Osprey Native host ([NATIVE-SHM-BOUNDARY],
// [NATIVE-SHM-EVENT]): `argument` gathers the launch arguments, `open` draws the first frame and
// `event` delivers one typed host event and draws the next. Nothing is encoded in either
// direction: the frame is view, scene and ask rows the host seals when each call returns, and the
// session stays in this library. Every device byte goes through the @osprey/chromecast port's real
// `Wire.Native` handler.

import ui::Runtime
import ui::Views
import ui::Surfaces
import ui::Hosting
import ui::Templates
import casting::App

extern native_slice (key : string) -> string

(** Hands the next surface to the cell below. *)
effect Keep
    keep : ui::Surface<casting::Store, ui::Lever> => Unit

mut held = Surfaces::idle (casting::Link::store (ui::MachineDocs::faulty ""))

program () = ui::Program(programInit = App::initial, programUpdate = App::update, programRender = App::regions, programTheme = \store => Templates::theme store.screen.screenMachine)

hosted work =
    handle Keep
        keep next => held := next
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => chromecast::Wire::Native (\() => Views::shared work))

kept next =
    perform Keep.keep next
    Hosting::answer next

(** Gathers one launch argument, in order, before `open`. *)
argument text = hosted (\() => kept (Surfaces::argued (held, text)))

(** Draws the first frame for the host's clock, zone offset, platform, home folder and appearance. *)
open (now, offset, platform, home, dark) = hosted (\() => kept (Surfaces::open (held, program (), Runtime::host (now, offset, platform, home, []), dark)))

(** Delivers one host event and draws the next frame; nonzero when it was refused, which changes nothing. *)
event (now, kind, ordinal, words, detail, x, y, down, shift) = hosted (\() => kept (Hosting::event (held, program (), ui::Touch(touchNow = now, touchKind = kind, touchOrdinal = ordinal, touchWords = words, touchDetail = detail, touchX = x, touchY = y, touchDown = down, touchShift = shift))))
