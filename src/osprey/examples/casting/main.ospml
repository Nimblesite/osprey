namespace app

import ui::Runtime
import ui::Views
import casting::App

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<casting::Store, ui::Lever> => Unit

initial () = casting::Link::store (ui::MachineDocs::faulty "")
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => chromecast::Wire::Native (\() => Views::shared work))
