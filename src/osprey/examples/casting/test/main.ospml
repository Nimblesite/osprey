// The casting player end to end ([UI-MACHINE], [UI-MACHINE-TEST], [CAST-DESIGN-STATE]): the real
// machine document, the real adapter and the real @osprey/chromecast port, driven through the
// typed host event boundary every host calls ([NATIVE-SHM-EVENT]), against an in-memory Cast
// device: a handler for the port's `Wire` effect that reads every frame the sender writes and
// answers as a Default Media Receiver does; receiver keys follow [CAST-MOBILE-RECEIVER-IDENTITY].
import ui::Doc
import ui::Canvases
import ui::Requests
import ui::Themes
import ui::Templates
import ui::Lists
import uitest::Drive
import uitest::Semantics
import uitest::Views
import casting::App
import chromecast::Protocol
(** The in-memory device: bytes queued for the sender, the message types it heard, its last read's status, its player, whether it can be reached, the folder a render makes ("" when the sender cannot render) and the content type the last LOAD named. *)
type Fake =
    fakeInbox : string
    fakeSaid : string
    fakeOut : string
    fakeRead : int
    fakePosition : float
    fakeVolume : float
    fakeRate : float
    fakePlaying : string
    fakeReason : string
    fakeReachable : bool
    fakeRender : string
    fakeLoaded : string
    fakeClosed : int
    fakeCloseCode : int
    fakeStopped : int
effect Bench
    rig : Fake => Unit
    drive : uitest::Driven<casting::Store, ui::Lever> => Unit
    list : string => Unit
fresh () = Fake(fakeInbox = "", fakeSaid = "", fakeOut = "", fakeRead = 0, fakePosition = 0.0, fakeVolume = 1.0, fakeRate = 1.0, fakePlaying = "IDLE", fakeReason = "", fakeReachable = true, fakeRender = "", fakeLoaded = "", fakeClosed = 0, fakeCloseCode = 0, fakeStopped = 0)
browse = "Living\\032Room\\032TV._googlecast._tcp SRV 0 0 8009 living-room.local. ;\nLiving\\032Room\\032TV._googlecast._tcp TXT \"id=1\" \"fn=Living Room TV\"\nKitchen._googlecast._tcp SRV 0 0 8009 kitchen.local. ;\nKitchen._googlecast._tcp TXT \"fn=Kitchen\"\n"
mut fake = fresh ()
mut browsed = browse
mut driven = Drive::idle (App::program (), casting::Link::store (ui::MachineDocs::faulty ""))
framed (ns, json) = Protocol::frame ("receiver-0", ns, json)
queued (f, hex) = f(fakeInbox = "${f.fakeInbox}${hex}")
mediaStatus f = "{\"type\":\"MEDIA_STATUS\",\"requestId\":0,\"status\":[{\"mediaSessionId\":1,\"playerState\":\"${f.fakePlaying}\"${ui::Pick::either (f.fakeReason == "", "", ",\"idleReason\":\"${f.fakeReason}\"")},\"currentTime\":${toString f.fakePosition},\"playbackRate\":${toString f.fakeRate},\"supportedMediaCommands\":15,\"media\":{\"duration\":200.0}}]}"
receiverStatus f = "{\"type\":\"RECEIVER_STATUS\",\"requestId\":1,\"status\":{\"applications\":[{\"appId\":\"CC1AD845\",\"sessionId\":\"S-1\",\"transportId\":\"web-7\"}],\"volume\":{\"level\":${toString f.fakeVolume},\"muted\":false}}}"
becomes (f, next) =
    moved = f(fakePlaying = next)
    queued (moved, framed ("media", mediaStatus moved))
said hex = Doc::parse (Protocol::parse (drop hex 8)).payload
receiverReply f = queued (f, framed ("receiver", receiverStatus f))
answer (f, message) = match Doc::text (message, "type")
    "LAUNCH" => receiverReply f
    "LOAD" => becomes (becomes (f(fakeLoaded = Doc::text (Doc::field (message, "media"), "contentType")), "BUFFERING"), "PLAYING")
    "PAUSE" => becomes (f, "PAUSED")
    "PLAY" => becomes (f, "PLAYING")
    "SEEK" => becomes (f(fakePosition = Doc::decimal (message, "currentTime")), f.fakePlaying)
    "SET_PLAYBACK_RATE" => becomes (f(fakeRate = Doc::decimal (message, "playbackRate")), f.fakePlaying)
    "SET_VOLUME" => receiverReply (f(fakeVolume = Doc::decimal (Doc::field (message, "volume"), "level")))
    "STOP" => becomes (f(fakeReason = "CANCELLED"), "IDLE")
    "PING" => queued (f, framed ("tp.heartbeat", "{\"type\":\"PONG\"}"))
    _ => f
heard (f, hex) =
    message = said hex
    answer (f(fakeSaid = "${f.fakeSaid}${Doc::text (message, "type")} "), message)
onDevice work =
    handle chromecast::Wire::Wire
        dial _ _ _ => ui::Pick::either (fake.fakeReachable, 7, 0 - 4)
        write _ hex =>
            fake := heard (fake, hex)
            0
        read _ count _ =>
            fake := match length fake.fakeInbox >= count * 2
                true => fake(fakeOut = take fake.fakeInbox (count * 2), fakeInbox = drop fake.fakeInbox (count * 2), fakeRead = 0)
                false => fake(fakeOut = "", fakeRead = 1)
            fake.fakeOut
        status _ => fake.fakeRead
        close _ =>
            fake := fake(fakeClosed = satAdd fake.fakeClosed 1)
            fake.fakeCloseCode
        route _ => "192.168.1.20"
        serve _ _ _ => 5123
        unserve _ =>
            fake := fake(fakeStopped = satAdd fake.fakeStopped 1)
            0
        render _ => fake.fakeRender
        unrender _ => 0
    work ()
heardTypes () = fake.fakeSaid
reset () =
    perform Bench.rig (fresh ())
    perform Bench.list browse
    perform Bench.drive (Drive::idle (App::program (), casting::Link::store (ui::MachineDocs::faulty "")))
unplug () = perform Bench.rig (fake(fakeReachable = false))
rendering folder = perform Bench.rig (fake(fakeRender = folder))
finishTrack () = perform Bench.rig (becomes (fake(fakeReason = "FINISHED", fakePosition = 200.0), "IDLE"))
browsing text = perform Bench.list text
kept next = perform Bench.drive next
hostedIn saved work =
    handle ui::Slices
        fetch key => match key == "casting.saved-skin"
            true => saved
            false => browsed
    onDevice work
hosted work = hostedIn "" work
bench work =
    handle Bench
        rig f => fake := f
        drive d => driven := d
        list text => browsed := text
    ui::Runtime::guarded work
// A launch: the platform, then the arguments the host was opened with.
beganIn (saved, platform, arguments) =
    reset ()
    hostedIn saved (\() => kept (Drive::launched (driven, platform, arguments)))
began arguments = beganIn ("", "macos", arguments)
launch = []
midnightSkin = ["--skin", "midnight"]
started () = began midnightSkin
// The canvas session: the Sherbet artboard, driven only by pointer events ([UI-MACHINE-CANVAS]).
drawn () = began ["--skin", "sherbet"]
machineNow () = driven.drivenSurface.surfaceSession.sessionStore.screen.screenMachine
token name = match Themes::named (Templates::theme (machineNow ()), name)
    Success found => found.tokenLight
    Error _ => "missing"
// One typed host event, sent the way a host sends it.
post step = hosted (\() => kept (step driven))
completedIn (saved, ticket, ok, problem) = hostedIn saved (\() => kept (Drive::completed (driven, ticket, ok, problem)))
// ---- the appearance the host keeps between runs [CAST-MOBILE-SKIN-PERSISTENCE] ----
// What the last step asked of the host, read as the typed requests and slice writes it sent.
askOf ticket = Lists::find (driven.drivenSurface.surfaceAsked, \r => r.ticket == ticket)
named (field, name, slice, limit) = match field
    "name" => name
    "slice" => slice
    "limit" => toString limit
    _ => ""
argument (arguments, key) = (Lists::find (arguments, \h => h.headerName == key) ?: ui::Header(headerName = "", headerValue = "")).headerValue
detail (capability, field) = match capability
    ui::StoreRead name limit slice => named (field, name, slice, limit)
    ui::StoreWrite name slice => named (field, name, slice, 0)
    ui::HostCall space operation arguments _ _ _ => match field
        "namespace" => space
        "operation" => operation
        _ => argument (arguments, field)
    _ => ""
described (capability, field) = match field
    "kind" => Requests::kind capability
    _ => detail (capability, field)
asked (ticket, field) = match askOf ticket
    Success r => described (r.capability, field)
    Error _ => ""
askedLimit ticket = parseInt (asked (ticket, "limit")) ?: 0
writeOf key = Lists::find (driven.drivenSurface.surfaceWritten, \w => w.sliceKey == key)
staged key = (writeOf key ?: Requests::write ("", "")).sliceText
hasSlice key = match writeOf key
    Success _ => true
    Error _ => false
skinNow () = ui::Machines::text (machineNow (), "skin")
// A Windows launch, whose host names its own browse helper with `--browse` ([CAST-DESIGN-NATIVE]).
helped () = beganIn ("", "windows", ["--skin", "midnight", "--browse", "C:/Apps/casting/cast-browse.exe"])
seen () = driven.drivenSeen
shows label = Drive::shows (driven, label)
control label = Views::control (seen (), label)
enabledOf label = (control label).controlEnabled
selected label = (control label).controlSelected
requested kind = Views::requested (seen (), kind)
browser () = match driven.drivenSurface.surfaceSession.sessionStore.finder
    ui::Run executable arguments _ _ _ _ => join (listConcat [executable] arguments) " "
    _ => ""
// ---- the canvas's accessibility tree [UI-MACHINE-A11Y] ----
elements () = (seen ()).renderedAccess
labels () = Semantics::labels (elements ())
element label = Semantics::element (elements (), label)
valueOf label = Semantics::value (elements (), label)
offers label = Drive::offers (elements (), label)
letters text = Drive::letters (driven, text)
press label = post (\d => Drive::press (d, label))
choose (label, key) = post (\d => Drive::choose (d, label, key))
pointer (x, y, down) = post (\d => Drive::pointer (d, x, y, down))
tapAt (label, fraction) =
    p = Semantics::point (element label, fraction)
    pointer (p.pointX, p.pointY, true)
    pointer (p.pointX, p.pointY, false)
tap label = tapAt (label, 0.5)
hover label =
    p = Semantics::point (element label, 0.5)
    pointer (p.pointX, p.pointY, false)
opened path = post (\d => Drive::opened (d, path))
frame seconds = post (\d => Drive::frame (d, seconds))
discovered () = post (\d => Drive::ran (d, "discover", 0, ""))
picked path = post (\d => Drive::chosen (d, "choose", path))
// A frame the host served, then what the controls and the artboard settled on.
afterFrame work =
    frame 0.2
    work ()
settled text = afterFrame (\() => expect (shows text, true))
lettered text = afterFrame (\() => expect (letters text, true))
// One line per table row: every input keeps the value it must produce.
expects (read, texts, wanted) = forEachList (texts, \text => expect (read text, wanted))
shown texts = expects (shows, texts, true)
unshown texts = expects (shows, texts, false)
asks kinds = expects (requested, kinds, true)
letteredIn texts = expects (letters, texts, true)
unlettered texts = expects (letters, texts, false)
offersAll labels = expects (offers, labels, true)
stagedSlices keys = expects (hasSlice, keys, true)
absentSlices keys = expects (hasSlice, keys, false)
skinStaged key = expect (staged "casting.selected-skin", key)
unwritten ticket = expect (asked (ticket, "kind"), "")
clearTree () = expect (Semantics::unclear (elements ()), "")
skinPhase (phase, _) = post (\d => Drive::phase (d, phase))
skinShown (phase, now, key) =
    skinPhase (phase, now)
    expect (selected "Skin", key)
skinKept (skin, warned) =
    expect (skinNow (), skin)
    stagedSlices (ui::Pick::either (warned, ["casting.appearance-warning"], []))
ready title =
    expect (shows title, true)
    expect (enabledOf "Play", true)
discoverFailed (reason, _) = post (\d => Drive::completed (d, "discover", false, reason))
readBack where = completedIn (where, "appearance:read", true, "")
readAs skin =
    readBack "poolside"
    expect (skinNow (), skin)
chosenSkin key =
    skinStaged key
    readAs key
viewedAs (width, height) = post (\d => Drive::viewed (d, width, height))
// A closed native shell releases its connection and media server exactly once ([CAST-MOBILE-DELIVERY]).
closedAt now =
    post (\d => Drive::phase (d, "closed"))
    services (1, 1)
services (closed, stopped) =
    expect (fake.fakeClosed, closed)
    expect (fake.fakeStopped, stopped)
// The TV found, a file picked and the play the host was asked for.
playing file =
    started ()
    discovered ()
    picked file
    press "Play"
choseFile activate =
    activate "Open file…"
    asks ["choose-file"]
    picked "/music/Sunroom.mp3"
castBegun (activate, read, text) =
    activate "Play"
    expect (heardTypes (), "CONNECT LAUNCH ")
    expect (read text, true)
    frame 0.2
again () =
    press "Search again"
    shown ["Looking for TVs…"]
noTVsFound relaunch =
    relaunch ()
    browsing ""
    discovered ()
noTVsLetters finish =
    unlettered ["Looking for TVs…"]
    letteredIn ["No TVs found"]
    finish ()
sherbetArt () =
    drawn ()
    expect (token "background", "#FFF8EF")
test ("a whole cast: find TVs, open a file, play, pause, seek, change volume and speed, stop and replay", \() => bench (\() =>
    started ()
    shown ["Looking for TVs…", "Choose an audio file"]
    asks ["run", "animate"]
    discovered ()
    shown ["Receiver"]
    expect (selected "Receiver", "living-room.local:8009")
    expect (length (control "Receiver").controlChoices, 2)
    expect (enabledOf "Play", false)
    choseFile press
    ready "Sunroom"
    opened "/music/Bullshit Jobs - Track 003.mp3"
    ready "Bullshit Jobs - Track 003"
    opened "/music/Sunroom.mp3"
    shown ["Sunroom"]
    castBegun (press, shows, "Connecting to Living Room TV…")
    expect (heardTypes (), "CONNECT LAUNCH CONNECT LOAD ")
    expect (fake.fakeLoaded, "audio/mpeg")
    settled "Playing on Living Room TV"
    shown ["Pause", "03:20"]
    skinShown ("skin:poolside", 2, "poolside")
    expect (enabledOf "Back 10 seconds", true)
    press "Pause"
    settled "Paused"
    shown ["Resume"]
    press "Resume"
    settled "Playing on Living Room TV"
    press "Forward 10 seconds"
    settled "00:10"
    choose ("Volume 100%", "0.5")
    settled "Volume 50%"
    choose ("Speed", "1.5")
    frame 0.2
    expect (selected "Speed", "1.5")
    expect (heardTypes (), "CONNECT LAUNCH CONNECT LOAD PAUSE PLAY SEEK SET_VOLUME SET_PLAYBACK_RATE ")
    press "Stop"
    settled "Finished"
    shown ["Play"]
    press "Play"
    frame 0.2
    settled "Playing on Living Room TV"
    finishTrack ()
    settled "Finished"))
test ("a Windows launch finds the TVs with the helper `--browse` names, a Mac launch with dns-sd", \() => bench (\() =>
    helped ()
    expect (browser (), "C:/Apps/casting/cast-browse.exe")
    shown ["Looking for TVs…"]
    asks ["run"]
    discovered ()
    expect (selected "Receiver", "living-room.local:8009")
    expect (length (control "Receiver").controlChoices, 2)
    started ()
    expect (browser (), "/usr/bin/perl -e alarm 3; exec @ARGV /usr/bin/dns-sd -Z _googlecast._tcp local")))
tone (theme, key, name, work) = match ui::Themes::named (theme, name)
    Error _ => expect (key + " " + name, "present")
    Success fill => work fill
skinContrast key = match readFile "src/osprey/examples/casting/player.machine.json"
    Error problem => expect (problem, "readable casting machine")
    Success source =>
        base = App::loaded source
        machine = ui::Machines::feed (base.screen.screenMachine, [ui::Fact(factName = "skin", factValue = ui::Values::text key)])
        theme = ui::Templates::theme machine
        tone (theme, key, "accent", \fill => tone (theme, key, "onAccent", \ink =>
            expect (ui::Contrast::ratio (fill.tokenLight, ink.tokenLight) >= 4.5, true)
            expect (ui::Contrast::ratio (fill.tokenDark, ink.tokenDark) >= 4.5, true)))
test ("skins change the palette, never the controls", \() => bench (\() =>
    started ()
    expect (token "background", "#10192B")
    expect (token "accent", "#A8EED4")
    discovered ()
    choose ("Skin", "midnight")
    expect (selected "Skin", "midnight")
    shown ["Open file…"]
    skinShown ("skin:poolside", 2, "poolside")
    skinShown ("skin:unknown", 3, "poolside")
    forEachList (["sherbet", "midnight", "poolside"], skinContrast)
    began launch
    expect (token "background", "#FFF8EF")
    sherbetArt ()
    offersAll ["Appearance: Sherbet Signal"]
    tap "Appearance: Sherbet Signal"
    expect (labels (), "Sherbet Signal|Midnight Mint|Poolside Pop|Receiver: none|Play|Open file…")
    tap "Midnight Mint"
    expect (token "background", "#10192B")))
test ("the appearance the host keeps is read, restored, repaired and never overwritten by a stale read", \() => bench (\() =>
    beganIn ("", "macos", launch)
    expect (asked ("appearance:read", "kind"), "store-read")
    expect (asked ("appearance:read", "name"), "casting-appearance.txt")
    expect (askedLimit "appearance:read", 128)
    expect (asked ("appearance:read", "slice"), "casting.saved-skin")
    completedIn ("", "appearance:read", false, "no such store entry casting-appearance.txt")
    skinStaged "sherbet"
    absentSlices ["casting.appearance-warning"]
    beganIn ("poolside", "macos", launch)
    readAs "poolside"
    expect (asked ("appearance:write", "kind"), "store-write")
    expect (asked ("appearance:write", "name"), "casting-appearance.txt")
    expect (asked ("appearance:write", "slice"), "casting.selected-skin")
    skinStaged "poolside"
    absentSlices ["casting.appearance-warning"]
    completedIn ("poolside", "appearance:write", false, "permission denied")
    skinKept ("poolside", true)
    expect (staged "casting.appearance-error", "permission denied")
    unwritten "appearance:write"
    beganIn ("neon", "macos", launch)
    readBack "neon"
    skinKept ("sherbet", true)
    expect (asked ("appearance:notice", "kind"), "host-call")
    expect (asked ("appearance:notice", "namespace"), "ui")
    expect (asked ("appearance:notice", "operation"), "notice")
    expect (asked ("appearance:notice", "title"), "Appearance restored")
    skinStaged "sherbet"
    began launch
    readBack ""
    skinKept ("sherbet", true)
    skinStaged "sherbet"
    beganIn ("poolside", "macos", launch)
    completedIn ("poolside", "appearance:read", false, "store entry casting-appearance.txt exceeds limit 128")
    expect (skinNow (), "sherbet")
    stagedSlices ["casting.appearance-warning", "casting.appearance-error"]
    absentSlices ["casting.selected-skin"]
    unwritten "appearance:write"
    beganIn ("poolside", "macos", midnightSkin)
    unwritten "appearance:read"
    chosenSkin "midnight"
    absentSlices ["casting.appearance-warning"]
    began launch
    tap "Appearance: Sherbet Signal"
    tap "Sherbet Signal"
    chosenSkin "sherbet"
    unwritten "appearance:write"))
test ("no TVs found offers another search, and an unreachable TV shows why", \() => bench (\() =>
    noTVsFound started
    shown ["No TVs found"]
    browsing browse
    again ()
    discoverFailed ("browse ran past its deadline", 2)
    shown ["browse ran past its deadline"]
    unshown ["Looking for TVs…"]
    shown ["No TVs found"]
    again ()
    discovered ()
    picked "/music/Sunroom.mp3"
    unplug ()
    press "Play"
    shown ["living-room.local:8009: connection refused or timed out"]
    shown ["Play"]
    expect (length (filterList ((seen ()).renderedControls, \c => c.controlTone == "danger")), 1)))
test ("the canvas: every control is reached by its accessible label, through pointer events alone", \() => bench (\() =>
    sherbetArt ()
    letteredIn ["Looking for TVs…"]
    expect (labels (), "Appearance: Sherbet Signal|Receiver: none|Play|Open file…")
    discovered ()
    letteredIn ["Living Room TV", "Choose an audio file"]
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Living Room TV|Play|Open file…")
    tap "Play"
    expect (requested "choose-file", false)
    expect (heardTypes (), "")
    hover "Open file…"
    expect (requested "choose-file", false)
    choseFile tap
    letteredIn ["Sunroom", "Ready"]
    rendering "/tmp/osprey-cast.test"
    castBegun (tap, letters, "Connecting…")
    frame 0.2
    expect (fake.fakeLoaded, "application/x-mpegURL")
    letteredIn ["Playing"]
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1×|Pause|Stop|Open file…|Position|Volume")
    expect (valueOf "Volume", 1.0)
    expect ((element "Volume").accessMin, 0.0)
    expect ((element "Volume").accessMax, 1.0)
    expect ((element "Position").accessMax, 200.0)
    expect (Semantics::role (elements (), "Position"), "slider")
    expect (Semantics::role (elements (), "Pause"), "button")
    expect ((element "Volume").accessWidth, 302.0)
    beforeResize = heardTypes ()
    viewedAs (868.0, 1670.0)
    expect ((element "Open file…").accessTop, 1564.0)
    expect ((element "Volume").accessTop, 1582.0)
    viewedAs (1080.0, 1800.0)
    expect ((element "Open file…").accessLeft, 763.0)
    expect ((element "Volume").accessTop, 1712.0)
    expect (heardTypes (), beforeResize)
    tap "Pause"
    lettered "Paused"
    offersAll ["Resume"]
    tap "Resume"
    lettered "Playing"
    tapAt ("Volume", 0.5)
    frame 0.2
    expect (valueOf "Volume", 0.5)
    tapAt ("Position", 0.25)
    lettered "00:50"
    expect (valueOf "Position", 50.0)
    tap "Speed: 1×"
    expect (labels (), "0.75×|1×|1.25×|1.5×|2×|Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1×|Pause|Stop|Open file…|Position|Volume")
    tap "1.5×"
    frame 0.2
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1.5×|Pause|Stop|Open file…|Position|Volume")
    letteredIn ["1.5×"]
    tap "Receiver: Living Room TV"
    expect (labels (), "Living Room TV|Kitchen|Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1.5×|Pause|Stop|Open file…|Position|Volume")
    letteredIn ["✓"]
    pointer (10.0, 10.0, true)
    pointer (10.0, 10.0, false)
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1.5×|Pause|Stop|Open file…|Position|Volume")
    tap "Receiver: Living Room TV"
    tap "Kitchen"
    letteredIn ["Kitchen"]
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Kitchen|Speed: 1.5×|Pause|Stop|Open file…|Position|Volume")
    expect (heardTypes (), "CONNECT LAUNCH CONNECT LOAD PAUSE PLAY SET_VOLUME SEEK SET_PLAYBACK_RATE ")
    tap "Stop"
    lettered "Finished"
    expect (labels (), "Appearance: Sherbet Signal|Receiver: Kitchen|Play|Open file…")
    unplug ()
    tap "Play"
    letteredIn ["kitchen.local:8009: connection refused or t…"]
    opened "/music/A very long name that will not fit on the title line at all.mp3"
    letteredIn ["A very long name that will no…"]))
test ("the player's accessibility tree reads clearly to an agent while it searches, once it has found none and once it has found some, and the artboard letters which", \() => bench (\() =>
    drawn ()
    clearTree ()
    offersAll ["Receiver: none", "Open file…"]
    letteredIn ["Looking for TVs…"]
    unlettered ["No TVs found"]
    discoverFailed ("the browse failed", 2)
    noTVsLetters clearTree
    noTVsFound drawn
    noTVsLetters drawn
    browsing browse
    discovered ()
    unlettered ["Looking for TVs…", "No TVs found"]
    offersAll ["Receiver: Living Room TV"]
    clearTree ()))
test ("closing the native shell releases its connection and media server exactly once", \() => bench (\() =>
    playing "/music/Sunroom.mp3"
    services (0, 0)
    closedAt 3
    closedAt 4
    playing "/music/Sunroom.mp3"
    frame 0.2
    settled "Playing on Living Room TV"
    perform Bench.rig (fake(fakeCloseCode = 0 - 1))
    closedAt 5
    shown ["Cannot close cast services (-1)"]
    closedAt 6))
