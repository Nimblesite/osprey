// The casting player's application callbacks ([UI-MACHINE], [UI-STORE]): the
// interface is src/osprey/examples/casting/player.machine.json, rendered by
// `ui::Templates`; this module routes framework messages to the machine and
// the adapter.
namespace casting

import ui::Runtime
import ui::Requests
import ui::Messages
import ui::MachineDocs
import ui::Doc
import ui::Values
import ui::Templates
import ui::Machines
import ui::Keyed
import casting::Link

(** The application exported through the two-function C boundary. *)
module App
    // The launch argument after `flag`, or `otherwise`.
    after (arguments, flag, otherwise) =
        at = ui::Lists::position (arguments, \a => a == flag)
        ui::Pick::either (at >= 0, listGet arguments (satAdd at 1) ?: otherwise, otherwise)

    (** The document the interface is read from: `--machine <path>` among the launch arguments, else the repository copy. *)
    export documentPath arguments = after (arguments, "--machine", "src/osprey/examples/casting/player.machine.json")

    // An MP3 the app was opened with: `--open <path>`, or a bare path ending in .mp3, as Finder passes one.
    opened arguments = after (arguments, "--open", (listGet (filterList (arguments, \a => endsWith (toLowerCase a) ".mp3")) 0) ?: "")

    (** The store from a machine document's text: a refused document shows its problems in place of the player. *)
    export loaded source = match MachineDocs::load source
        Success machine => Link::store machine
        Error problem => Link::store (MachineDocs::faulty problem)

    (** Loads the document, applies `--skin`, `--browse` and an opened MP3, starts the frame clock, answers the initial states' requests and reads the appearance the last run saved. *)
    export initial context =
        path = documentPath context.arguments
        launched = Link::launched (loaded (readFile path ?: ""), MachineDocs::folder path, after (context.arguments, "--skin", ""), opened context.arguments)
        found = launched(finder = Link::browse (after (context.arguments, "--browse", "")))
        first = Link::settled found
        restored (context.arguments, remember (asking (first)))

    (** [UI-THEME] Begin once with the initialized store's skin, including `--machine`, `--skin` and the document's fallback. *)
    export begun source =
        first = initial (Runtime::context (Doc::parse source))
        Runtime::begin (source, \_ => first, regions, Templates::theme first.stepStore.screen.screenMachine)

    // [CAST-MOBILE-APPEARANCE-RECOVERY] A rejected launch choice must never fail silently.
    restored (arguments, next) =
        wanted = after (arguments, "--skin", "")
        chosen = selected next.stepStore
        match ui::Lists::position (arguments, \a => a == "--skin") >= 0 && chosen != "" && wanted != chosen
            true => next(writes = listAppend next.writes (Requests::write ("casting.appearance-warning", "The selected appearance is unavailable. The default appearance has been restored.")))
            false => next

    // [CAST-MOBILE-SKIN-PERSISTENCE] Publish the rendered choice once, then ask for the read that restores it.
    selected store = (Templates::skin store.screen.screenMachine).skinName

    // [CAST-MOBILE-SKIN-PERSISTENCE] Published before the completion: a `StoreRead` success carries no text, only its slice.
    remembers (next, publish) =
        read = Requests::ask ("appearance:read", ui::StoreRead(readName = "casting-appearance.txt", readLimit = 128, readSlice = "casting.saved-skin"))
        wrote = ui::Pick::either (publish, [Requests::ask ("appearance:write", ui::StoreWrite(writeName = "casting-appearance.txt", writeSlice = "casting.selected-skin"))], [])
        Runtime::asking (next.stepStore, listConcat (listPrepend read wrote) [])

    asking first = listConcat first.requests [Requests::ask ("clock", ui::Animate(animated = true))]

    // A missing entry is a first run, deliberately silent; anything else the host refused is reported, never swallowed.
    unread (next, problem) = ui::Pick::either (startsWith problem "no such store entry", Runtime::step next.stepStore, warned (next, "Your saved appearance could not be read, so the current one is used. "))

    warned (next, note) =
        next(stepStore = next.stepStore, writes = listAppend next.writes (Requests::write ("casting.appearance-warning", note)))

    (** Routes every framework message: controls pull the machine's levers, completions and frames go to the adapter. *)
    export update (context, store, message) =
        next = Messages::route (message, \lever => Link::pulled (store, lever, Values::none ()), \(lever, text) => Link::pulled (store, lever, Values::text text), \(lever, on) => Link::pulled (store, lever, Values::flag on), \(_, _) => Runtime::step store, \(ticket, outcome) => completed (context, store, ticket, outcome), \phase => Link::phased (store, phase), \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \seconds => Link::ticked (store, seconds), \(_, input) => Link::pointed (store, input))
        match selected store == selected next.stepStore
            true => next
            false => remembers (next, true)

    // [CAST-MOBILE-SKIN-PERSISTENCE] `--skin` wins; otherwise the saved skin is restored, unless the person already chose one.
    export completed (context, store, ticket, outcome) = match ticket
        "appearance:read" => read (context, store, outcome)
        "appearance:write" => written (store, outcome)
        _ => Link::completed (store, ticket, outcome)

    written (store, outcome) = match outcome
        Error problem => warned (Runtime::step store, "Your appearance could not be saved, so it may not return next time. ")
        Success _ => Runtime::step store

    // [CAST-MOBILE-SKIN-PERSISTENCE] An entry that is empty, unknown or already current says so, and keeps the current look.
    read (context, store, outcome) = match outcome
        Error problem => unread (Runtime::step store, problem)
        Success _ => Runtime::step (ui::Pick::either (explicitSkin (context.arguments), store, repaired (store, perform ui::Slices.fetch "casting.saved-skin")))

    explicitSkin arguments = after (arguments, "--skin", "") != ""

    known (machine, key) = Lists::any (Machines::choicesOf (machine, "skins"), \choice => choice.choiceKey == key)

    repaired (store, saved) = match Machines::text (store.screen.screenMachine, "skin") == "sherbet" && known (store.screen.screenMachine, saved)
        true => repairedSkin (store, saved)
        false => store

    repairedSkin (store, saved) = Link::fed (store, [ui::Fact(factName = "skin", factValue = Values::text saved)])

    screenSlice () = perform Signal<Screen>.read ()

    (** The whole player: the machine's view in its chosen skin. *)
    export root () = Templates::view (screenSlice ()).screenMachine

    (** Rebuilds the player whenever the machine changes. *)
    export regions (before, store, frames, _) =
        handle static Signal<Screen>
            read => store.screen
        changed = signalChanges before.screen store.screen (\s => MachineDocs::snapshot s.screenMachine) (signalDependencies screenSlice)
        [Keyed::region (frames, "root", changed, root)]
