// Implements [IOS-TARGET-MACOS]: the browser's rules and screens run natively
// under a fixed handler, so they are verified without Swift or a particular disk.
namespace storagetests

import bank::Json
import storage::Disk
import storage::Browse
import storage::View

home = "/Users/ada"

entry path bytes visible hidden folder = storage::Entry(path = path, bytes = bytes, visible = visible, hidden = hidden, folder = folder, guarded = false, link = false)

guarded path = storage::Entry(path = path, bytes = 0, visible = 0, hidden = false, folder = true, guarded = true, link = false)

homeEntries () = [
    entry "/Users/ada/Downloads" 30000000000 30000000000 false true,
    entry "/Users/ada/Library" 450000000000 450000000000 true true,
    entry "/Users/ada/notes.txt" 4096 4096 false false,
    entry "/Users/ada/Code" 120000000000 20000000000 false true,
    entry "/Users/ada/.cache" 99000000000 0 true true,
]

mail = "/Users/ada/Library/Containers/com.apple.mail"

listingFor path = match path
    "/Users/ada" => storage::Listing(entries = homeEntries (), blocked = 2, measured = true)
    "/Users/ada/Code" => storage::Listing(entries = [entry "/Users/ada/Code/app/.git" 100000000000 0 true true], blocked = 0, measured = true)
    "/Users/ada/Library/Containers" => storage::Listing(entries = [entry "/Users/ada/Library/Containers/org.example" 2000 2000 false true, guarded mail], blocked = 0, measured = true)
    _ => storage::Listing(entries = [], blocked = 0, measured = false)

ssd = storage::Volume(name = "Macintosh HD", total = 1000000000000, available = 250000000000, important = 300000000000)

browser path hidden stage = storage::Browser(platform = "macos", full = false, home = home, root = home, path = path, hidden = hidden, stage = stage, walking = home, items = 0, bytes = 0)

kind name items bytes = storage::PhotoKind(name = name, items = items, bytes = bytes)

pictures status bytes = storage::Photos(status = status, items = 9000, bytes = bytes, cloud = 60000000000, kinds = [kind "videos" 400 30000000000, kind "photos" 8000 8000000000, kind "live" 0 0, kind "screenshots" 600 2000000000])

names ranking = join (range (0, ranking.kept) |> fold [] (\(output, index) => listAppend output (Disk::name "" (listGet ranking.top index ?: entry "" 0 0 false false).path))) ","

(** One claim about a rendered screen: what it asserts and the words it must find ([IOS-TARGET-MACOS]). *)
type Claim =
    claimLabel : string
    claimWords : string

claims (text, rows) = forEachList (rows, \row => checkTrue row.claimLabel (contains text row.claimWords))

refutes (text, rows) = forEachList (rows, \row => checkFalse row.claimLabel (contains text row.claimWords))

walkOf commands = Json::getOr commands "[0].kind" "" + " " + Json::getOr commands "[0].path" "" + " graft=" + Json::getOr commands "[0].graft" ""

screen model =
    handle Disk::Facts
        volume _ => ssd
        listing path => listingFor path
        photos => storage::Photos(status = "unavailable", items = 0, bytes = 0, cloud = 0, kinds = [])
    View::render model

// An iPhone app's home holds little; the photo library is measured apart.
phoneScreen photos = phoneAt "/var/app" photos

phoneAt path photos =
    model = storage::Browser(platform = "ios", full = false, home = "/var/app", root = "/var/app", path = path, hidden = true, stage = "ready", walking = "/var/app", items = 0, bytes = 0)
    handle Disk::Facts
        volume _ => ssd
        listing _ => storage::Listing(entries = [entry "/var/app/Library" 5000000000 5000000000 false true], blocked = 1, measured = true)
        photos => photos
    View::render model

formatCase () =
    check "bytes" "999 B" (Disk::formatBytes 999)
    check "rounds across a unit" "1.0 MB" (Disk::formatBytes 999960)
    check "gigabytes" "4.1 GB" (Disk::formatBytes 4143181824)
    check "host failure" "unknown" (Disk::formatBytes (0 - 1))
    check "small count" "999" (Disk::formatCount 999)
    check "grouped count" "1,234,005" (Disk::formatCount 1234005)
    check "share" 60 (Disk::percent (450, 750))
    check "unknown whole" 0 (Disk::percent (5, 0 - 1))
    check "sliver" "< 1%" (Disk::shareText (1, 1000))
    check "nothing" "0%" (Disk::shareText (0, 1000))
    check "thousandths" 375 (Disk::permille (3, 8))

rankCase () =
    shown = Disk::rank true 3 (homeEntries ())
    check "largest first, hidden included" "Library,Code,.cache" (names shown)
    check "counts every measured entry" 5 shown.count
    check "sizes every entry" 699000004096 shown.bytes
    sighted = Disk::rank false 10 (homeEntries ())
    check "hidden entries left out" "Downloads,Code,notes.txt" (names sighted)
    check "hidden contents left out" 50000004096 sighted.bytes
    many = range (0, 5000) |> fold [] (\(output, index) => listAppend output (entry "/x/${index}" (index % 977) 0 false false))
    check "a wide folder keeps only the largest, ties in arrival order" "976,1953,2930" (names (Disk::rank true 3 many))

pathCase () =
    check "name" "Library" (Disk::name "" "/Users/ada/Library")
    check "volume root" "Macintosh HD" (Disk::name "Macintosh HD" "/")
    check "parent" "/Users" (Disk::parent "/Users/ada")
    check "parent of a top folder" "/" (Disk::parent "/Users")
    check "trail" "/Users/ada|/Users/ada/Code|/Users/ada/Code/app" (join (Disk::trail home "/Users/ada/Code/app") "|")
    check "trail at the root" "/Users/ada" (join (Disk::trail home home) "|")
    check "app" "app.fill" (Disk::look (entry "/Applications/Xcode.app" 1 1 false true)).symbol
    check "Finder folder" "arrow.down.circle.fill" (Disk::look (entry "/Users/ada/Downloads" 1 1 false true)).symbol
    check "movie" "purple" (Disk::look (entry "/a/Trip.MOV" 1 1 false false)).tint
    check "unknown file" "doc.fill" (Disk::look (entry "/a/README" 1 1 false false)).symbol

browseCase () =
    started = Browse::start home "macos" false
    check "the Mac measures the whole disk" "measure / graft=false" (walkOf started.commands)
    check "the walk never enters another app's data" "/Users/ada/Library/Group Containers" (Json::getOr started.commands "[0].apps[1]" "")
    check "unless the Mac granted Full Disk Access" "none" (Json::getOr (Browse::start home "macos" true).commands "[0].apps[0]" "none")
    check "the Mac has no photo library to ask for" "none" (Json::getOr started.commands "[1].kind" "none")
    phone = Browse::start "/var/app" "ios" false
    check "an iPhone measures the app's own folder" "measure /var/app graft=false" (walkOf phone.commands)
    check "whose folders are never guarded" "none" (Json::getOr phone.commands "[0].apps[0]" "none")
    check "and asks for the photo library" "photos" (Json::getOr phone.commands "[1].kind" "")
    check "again when allowed later" "[{\"kind\":\"photos\",\"path\":\"/var/app\"}]" (Browse::dispatch phone.model "{\"type\":\"allow\"}").commands
    checkTrue "hidden files shown by default" started.model.hidden
    chosen = Browse::dispatch started.model "{\"type\":\"picked\",\"value\":\"/Users/ada\"}"
    check "a chosen folder starts its own walk" "measure /Users/ada graft=false" (walkOf chosen.commands)
    ready = (Browse::dispatch chosen.model "{\"type\":\"measured\",\"path\":\"/Users/ada\"}").model
    check "walk finished" "ready" ready.stage
    stale = Browse::dispatch chosen.model "{\"type\":\"measured\",\"path\":\"/Volumes/Old\"}"
    check "a stale walk is ignored" "measuring" stale.model.stage
    inside = (Browse::dispatch ready "{\"type\":\"open\",\"value\":\"/Users/ada/Code\"}").model
    check "opens a folder" "/Users/ada/Code" inside.path
    check "never leaves the measured folder" home (Browse::dispatch ready "{\"type\":\"open\",\"value\":\"/Users/adam\"}").model.path
    check "up" home (Browse::dispatch inside "{\"type\":\"up\"}").model.path
    check "up stops at the root" home (Browse::dispatch ready "{\"type\":\"up\"}").model.path
    checkFalse "hides hidden files" (Browse::dispatch ready "{\"type\":\"hidden\",\"value\":\"false\"}").model.hidden
    check "asks for a folder" "[{\"kind\":\"pick\",\"path\":\"/Users/ada\"}]" (Browse::dispatch ready "{\"type\":\"choose\"}").commands
    check "opens the platform's privacy settings" "[{\"kind\":\"settings\",\"path\":\"\"}]" (Browse::dispatch ready "{\"type\":\"settings\"}").commands
    moved = Browse::dispatch ready "{\"type\":\"picked\",\"value\":\"/Volumes/Archive\"}"
    check "measures the chosen folder" "/Volumes/Archive" moved.model.root
    check "and requests its walk" "measure /Volumes/Archive graft=false" (walkOf moved.commands)
    granted = Browse::dispatch ready "{\"type\":\"picked\",\"value\":\"${mail}\"}"
    check "an app's data chosen inside joins the walk" "measure ${mail} graft=true" (walkOf granted.commands)
    check "and keeps the measured folder" home granted.model.root
    check "and opens the chosen one" mail granted.model.path
    check "its walk reports by its own path" "ready" (Browse::dispatch granted.model "{\"type\":\"measured\",\"path\":\"${mail}\"}").model.stage
    check "a folder opens in Finder" "[{\"kind\":\"reveal\",\"path\":\"/Users/ada/Code\"}]" (Browse::dispatch ready "{\"type\":\"reveal\",\"value\":\"/Users/ada/Code\"}").commands
    check "but only inside the measured folder" "[]" (Browse::dispatch ready "{\"type\":\"reveal\",\"value\":\"/Users/adam\"}").commands
    check "an app's data is chosen in the picker" "[{\"kind\":\"pick\",\"path\":\"${mail}\"}]" (Browse::dispatch ready "{\"type\":\"grant\",\"value\":\"${mail}\"}").commands
    counted = (Browse::dispatch chosen.model "{\"type\":\"progress\",\"path\":\"/Users/ada\",\"items\":1200,\"bytes\":5000}").model
    check "progress" 1200 counted.items
    check "progress of a folder since left" 0 (Browse::dispatch chosen.model "{\"type\":\"progress\",\"path\":\"/Volumes/Old\",\"items\":9,\"bytes\":9}").model.items
    check "round trip" (Browse::encode inside) (Browse::encode (Browse::decode (Browse::encode inside)))

linkCase () =
    linked = entry "/Users/ada/etc" 0 0 false true
    handle Disk::Facts
        volume _ => ssd
        listing _ => storage::Listing(entries = [linked(link = true)], blocked = 0, measured = true)
        photos => pictures "unavailable" 0
    links = View::render (browser home true "ready")
    checkTrue "links explain why no target bytes count here" (contains links "Symbolic link")

screenCase () =
    shown = screen (browser home true "ready")
    disk = browser "/" true "ready"
    containers = screen (browser "/Users/ada/Library/Containers" true "ready")
    phone = phoneScreen (pictures "ready" 40000000000)
    sighted = screen (browser home false "ready")
    deeper = screen (browser "/Users/ada/Code" false "ready")
    plain = browser home true "ready"
    walking = screen (Browse::dispatch (Browse::start home "macos" false).model "{\"type\":\"progress\",\"path\":\"/\",\"items\":1200,\"bytes\":5000}").model
    claims (shown, [
        Claim(claimLabel = "folder totals identify measured bytes", claimWords = "699.0 GB measured · 5 items"),
        Claim(claimLabel = "the open folder names the screen", claimWords = "\"kind\":\"navigation\",\"id\":\"/Users/ada\",\"text\":\"Home\""),
        Claim(claimLabel = "purgeable space counts as available, as in Settings", claimWords = "700.0 GB of 1.0 TB used"),
        Claim(claimLabel = "and is named", claimWords = "300.0 GB available, 50.0 GB of it purgeable"),
        Claim(claimLabel = "hidden folder ranked", claimWords = "\"text\":\".cache\""),
        Claim(claimLabel = "hidden entries dimmed", claimWords = "\"style\":\"hidden\""),
        Claim(claimLabel = "unreadable folders explained", claimWords = "2 folders here could not be read"),
        Claim(claimLabel = "and says Full Disk Access counts the rest", claimWords = "need Full Disk Access"),
        Claim(claimLabel = "offers Full Disk Access", claimWords = "\"text\":\"Allow Full Disk Access…\",\"event\":{\"type\":\"settings\""),
        Claim(claimLabel = "folders open", claimWords = "\"event\":{\"type\":\"open\",\"value\":\"/Users/ada/Code\"}"),
        Claim(claimLabel = "a folder's context menu opens it in Finder", claimWords = "\"menu\":[{\"kind\":\"button\",\"symbol\":\"folder\",\"text\":\"Open in Finder\",\"event\":{\"type\":\"reveal\",\"value\":\"/Users/ada/Code\"}}]"),
        Claim(claimLabel = "toggle reflects the setting", claimWords = "\"text\":\"Hidden Files\",\"value\":\"true\"")
    ])
    claims (screen (disk(root = "/")), [
        Claim(claimLabel = "disk title uses the same used space as its gauge", claimWords = "700.0 GB used")
    ])
    claims (containers, [
        Claim(claimLabel = "other apps' data listed apart", claimWords = "Other apps' data"),
        Claim(claimLabel = "and chosen to measure", claimWords = "\"event\":{\"type\":\"grant\",\"value\":\"${mail}\"}"),
        Claim(claimLabel = "an app's data opens in Finder too", claimWords = "\"event\":{\"type\":\"reveal\",\"value\":\"${mail}\"}")
    ])
    claims (sighted, [
        Claim(claimLabel = "visible size only", claimWords = "\"text\":\"Code\",\"symbol\":\"folder.fill\",\"tint\":\"blue\",\"accent\":\"purple\",\"style\":\"\",\"detail\":\"20.0 GB\"")
    ])
    claims (deeper, [
        Claim(claimLabel = "everything inside is hidden", claimWords = "Everything here is hidden"),
        Claim(claimLabel = "path bar starts at Home", claimWords = "\"kind\":\"pathbar\",\"children\":[{\"kind\":\"button\",\"symbol\":\"house.fill\",\"text\":\"Home\""),
        Claim(claimLabel = "a folder below Home goes by its name", claimWords = "\"kind\":\"navigation\",\"id\":\"/Users/ada/Code\",\"text\":\"Code\""),
        Claim(claimLabel = "way up", claimWords = "Enclosing Folder")
    ])
    claims (walking, [
        Claim(claimLabel = "progress", claimWords = "Measuring Macintosh HD…"),
        Claim(claimLabel = "counts so far", claimWords = "1,200 items · 5.0 KB so far"),
        Claim(claimLabel = "and says macOS asks once for Documents", claimWords = "macOS asks once before the app reads Desktop, Documents")
    ])
    claims (screen (browser home true "failed"), [
        Claim(claimLabel = "failure", claimWords = "Cannot measure Home")
    ])
    claims (screen (browser "/Users/ada/Downloads" true "ready"), [
        Claim(claimLabel = "unmeasured folder", claimWords = "Not measured yet")
    ])
    refutes (screen (plain(full = true)), [
        Claim(claimLabel = "until it is granted", claimWords = "Allow Full Disk Access")
    ])
    refutes (shown, [
        Claim(claimLabel = "a file has no Finder item", claimWords = "\"value\":\"/Users/ada/notes.txt\""),
        Claim(claimLabel = "no way up from the root", claimWords = "Enclosing Folder")
    ])
    refutes (sighted, [
        Claim(claimLabel = "hidden folder gone", claimWords = "\"text\":\".cache\"")
    ])
    refutes (phone, [
        Claim(claimLabel = "an iPhone has no Finder", claimWords = "Open in Finder")
    ])

phoneCase () =
    shown = phoneScreen (pictures "ready" 40000000000)
    crowded = phoneScreen (pictures "ready" 900000000000)
    denied = phoneScreen (pictures "denied" 0)
    small = phoneAt "/var/app/Library" (pictures "ready" 0)
    claims (shown, [
        Claim(claimLabel = "the app's own folder is the phone's storage", claimWords = "\"kind\":\"navigation\",\"id\":\"/var/app\",\"text\":\"Storage\""),
        Claim(claimLabel = "what uses the device", claimWords = "On this Macintosh HD"),
        Claim(claimLabel = "photos measured", claimWords = "\"text\":\"Photos & Videos\",\"symbol\":\"photo.on.rectangle.angled\",\"tint\":\"orange\",\"accent\":\"orange\",\"detail\":\"40.0 GB\""),
        Claim(claimLabel = "this app", claimWords = "\"text\":\"Osprey Storage\",\"symbol\":\"app.fill\",\"tint\":\"indigo\",\"accent\":\"indigo\",\"detail\":\"5.0 GB\""),
        Claim(claimLabel = "the rest, which iOS keeps from apps", claimWords = "\"text\":\"Other apps & iOS\",\"symbol\":\"square.stack.3d.up.fill\",\"tint\":\"gray\",\"accent\":\"gray\",\"detail\":\"655.0 GB\""),
        Claim(claimLabel = "and says where to split it by app", claimWords = "Settings › General › iPhone Storage"),
        Claim(claimLabel = "a folder in Files can be measured", claimWords = "Measure a Folder in Files…"),
        Claim(claimLabel = "the library by kind, with counts", claimWords = "\"text\":\"Videos · 400\",\"symbol\":\"video.fill\",\"tint\":\"purple\",\"accent\":\"purple\",\"detail\":\"30.0 GB\",\"caption\":\"75%\""),
        Claim(claimLabel = "screenshots apart", claimWords = "\"text\":\"Screenshots · 600\""),
        Claim(claimLabel = "what only iCloud holds", claimWords = "\"text\":\"Only in iCloud\",\"symbol\":\"icloud.fill\",\"tint\":\"gray\",\"accent\":\"gray\",\"detail\":\"60.0 GB\""),
        Claim(claimLabel = "and why it takes no space here", claimWords = "9,000 items, hidden ones included")
    ])
    claims (crowded, [
        Claim(claimLabel = "the rest never goes below nothing", claimWords = "\"text\":\"Other apps & iOS\",\"symbol\":\"square.stack.3d.up.fill\",\"tint\":\"gray\",\"accent\":\"gray\",\"detail\":\"0 B\",\"caption\":\"0%\"")
    ])
    claims (denied, [
        Claim(claimLabel = "denied photos lead to Settings", claimWords = "\"detail\":\"Allow in Settings\",\"caption\":\"\",\"value\":\"0\",\"event\":{\"type\":\"settings\""),
        Claim(claimLabel = "and count toward the rest", claimWords = "\"detail\":\"695.0 GB\"")
    ])
    claims (small, [
        Claim(claimLabel = "unreadable folders explained for iOS", claimWords = "iOS keeps them from the app.")
    ])
    claims (phoneScreen (pictures "unasked" 0), [
        Claim(claimLabel = "unasked photos can be allowed", claimWords = "\"event\":{\"type\":\"allow\"")
    ])
    claims (phoneScreen (pictures "limited" 40000000000), [
        Claim(claimLabel = "a partial library says so", claimWords = "only some photos")
    ])
    refutes (shown, [
        Claim(claimLabel = "no bar of a folder that holds little", claimWords = "measured here"),
        Claim(claimLabel = "nor the app's own files", claimWords = "Largest items"),
        Claim(claimLabel = "a kind with nothing is left out", claimWords = "Live Photos"),
        Claim(claimLabel = "no Full Disk Access on iPhone", claimWords = "Full Disk Access")
    ])
    refutes (small, [
        Claim(claimLabel = "and the device story stays at the top", claimWords = "Other apps & iOS")
    ])
    refutes (denied, [
        Claim(claimLabel = "with no breakdown", claimWords = "Only in iCloud")
    ])

test "sizes, counts and shares read as Finder writes them" formatCase
test "ranking keeps the largest entries under the hidden-files setting" rankCase
test "paths, trails and symbols" pathCase
test "events move the browser and request host work" browseCase
test "screens show what the disk holds" screenCase
test "an iPhone shows what uses it, as far as iOS lets an app see" phoneCase

test "links explain their disk accounting" linkCase
