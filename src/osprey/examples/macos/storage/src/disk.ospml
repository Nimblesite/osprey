// Implements [IOS-TARGET-MACOS]: Osprey decides everything the storage browser
// shows. The host measures the disk once and answers each question, so this
// module never touches the file system and its tests need no particular disk.
namespace storage

type Entry =
    path : string
    bytes : int
    visible : int
    hidden : bool
    folder : bool
    guarded : bool
    link : bool

type Volume =
    name : string
    total : int
    available : int
    important : int

// One kind of asset in the photo library: `videos`, `screenshots`, `live` or
// `photos`, with the bytes of it stored on the device.
type PhotoKind =
    name : string
    items : int
    bytes : int

// `status` is `unasked`, `measuring`, `denied`, `limited`, `ready` or
// `unavailable` (a Mac, whose photo library is a folder the walk measures).
// `bytes` is what the device stores; `cloud` is what only iCloud holds.
type Photos =
    status : string
    items : int
    bytes : int
    cloud : int
    kinds : List<PhotoKind>

type Listing =
    entries : List<Entry>
    blocked : int
    measured : bool

type Ranking =
    top : List<Entry>
    kept : int
    floor : int
    bytes : int
    count : int

type Look =
    symbol : string
    tint : string

// One row of a look table: the names it answers for and the look they get.
type Rule =
    keys : List<string>
    look : Look

module Disk
    (** What the browser asks the platform. The host answers from Foundation's volume keys and from one measured walk of the tree, where `bytes` counts everything below an entry and `visible` leaves out the hidden items below it; the photo library comes from Photos once the person allows it; tests answer from fixed data. *)
    export effect Facts
        volume : string => Volume
        listing : string => Listing
        photos : Unit => Photos

    (** What an entry counts for: everything below it, or only what is in sight. *)
    export size hidden entry = match hidden
        true => entry.bytes
        false => entry.visible

    (** Whether the hidden-files setting shows an entry. *)
    export inSight hidden entry = hidden || entry.hidden == false

    // A protected folder was never entered, so it has no size to rank.
    counted hidden entry = inSight hidden entry && entry.guarded == false

    (** The first `count` items. *)
    export top count items = match items
        [] => []
        [first, ...rest] => match count > 0
            true => listPrepend (top (satSub count 1) rest) first
            false => []

    last items fallback = match items
        [] => fallback
        [first, ...rest] => last rest first

    placed hidden entry items = match items
        [] => [entry]
        [first, ...rest] => match size hidden entry > size hidden first
            true => listPrepend items entry
            false => listPrepend (placed hidden entry rest) first

    // A full ranking only changes when an entry beats its smallest member, so
    // most entries of a large folder cost one comparison.
    keep hidden limit ranking entry =
        bytes = size hidden entry
        totals = ranking(bytes = satAdd ranking.bytes bytes, count = satAdd ranking.count 1)
        match ranking.kept >= limit && bytes <= ranking.floor
            true => totals
            false =>
                ranked = top limit (placed hidden entry ranking.top)
                totals(top = ranked, kept = length ranked, floor = size hidden (last ranked entry))

    step hidden limit entries ranking index = match listGet entries index
        Error _ => ranking
        Success entry => match counted hidden entry
            true => keep hidden limit ranking entry
            false => ranking

    (** The `limit` largest entries counted under the hidden-files setting, largest first, with the size and number of everything counted. A loop, not recursion, visits the entries, so a folder of any size keeps the stack flat. *)
    export rank hidden limit entries =
        empty = Ranking(top = [], kept = 0, floor = 0, bytes = 0, count = 0)
        range (0, length entries) |> fold empty (\(ranking, index) => step hidden limit entries ranking index)

    nonEmpty kept piece = match length piece > 0
        true => listAppend kept piece
        false => kept

    segments path =
        pieces = split path "/" ?: []
        range (0, length pieces) |> fold [] (\(kept, index) => nonEmpty kept (listGet pieces index ?: ""))

    (** The last component of a path; the volume root has none and goes by `fallback`. *)
    export name fallback path = last (segments path) fallback

    joined base pieces = match length pieces > 0
        false => base
        true => match endsWith base "/"
            true => base + join pieces "/"
            false => base + "/" + join pieces "/"

    (** The enclosing folder; the volume root encloses itself. *)
    export parent path =
        pieces = segments path
        joined "/" (top (satSub (length pieces) 1) pieces)

    (** The folders from `root` down to `path`, outermost first. *)
    export trail root path =
        below = segments (drop path (length root))
        range (0, length below) |> fold [root] (\(folders, index) => listAppend folders (joined root (top (satAdd index 1) below)))

    extension path =
        pieces = split (name "" path) "." ?: []
        match length pieces > 1
            true => toLowerCase (last pieces "")
            false => ""

    // Every look the browser gives, in the order it is tried: a file row keys on
    // the extensions it answers for, a folder row on the one folder name it does.
    looks () = [
        Rule(keys = ["mov", "mp4", "m4v", "avi", "mkv", "webm", "braw", "prores"], look = Look(symbol = "film.fill", tint = "purple")),
        Rule(keys = ["png", "jpg", "jpeg", "heic", "gif", "tif", "tiff", "dng", "raw", "psd", "webp", "svg"], look = Look(symbol = "photo.fill", tint = "orange")),
        Rule(keys = ["mp3", "m4a", "wav", "aif", "aiff", "flac", "aac", "caf"], look = Look(symbol = "waveform", tint = "pink")),
        Rule(keys = ["zip", "gz", "tgz", "tar", "xz", "bz2", "7z", "rar", "dmg", "iso", "pkg", "ipa", "xip", "img", "qcow2", "vmdk", "vdi"], look = Look(symbol = "shippingbox.fill", tint = "brown")),
        Rule(keys = ["swift", "rs", "c", "h", "m", "mm", "cpp", "js", "ts", "py", "go", "java", "kt", "json", "osp", "ospml", "sh", "html", "css"], look = Look(symbol = "chevron.left.forwardslash.chevron.right", tint = "teal")),
        Rule(keys = ["pdf", "txt", "md", "rtf", "doc", "docx", "pages", "key", "numbers", "xls", "xlsx", "ppt", "pptx", "csv", "epub"], look = Look(symbol = "doc.richtext.fill", tint = "green")),
        Rule(keys = ["Applications"], look = Look(symbol = "square.grid.3x3.fill", tint = "blue")), Rule(keys = ["Desktop"], look = Look(symbol = "menubar.dock.rectangle", tint = "blue")),
        Rule(keys = ["Documents"], look = Look(symbol = "doc.text.fill", tint = "blue")), Rule(keys = ["Downloads"], look = Look(symbol = "arrow.down.circle.fill", tint = "blue")),
        Rule(keys = ["Library"], look = Look(symbol = "building.columns.fill", tint = "blue")), Rule(keys = ["Movies"], look = Look(symbol = "film.stack.fill", tint = "blue")),
        Rule(keys = ["Music"], look = Look(symbol = "music.note", tint = "blue")), Rule(keys = ["Pictures"], look = Look(symbol = "photo.on.rectangle.angled", tint = "blue")),
        Rule(keys = ["Developer"], look = Look(symbol = "hammer.fill", tint = "blue")), Rule(keys = [".Trash"], look = Look(symbol = "trash.fill", tint = "blue")),
    ]

    // The look of the first row of `kind`'s sort naming `key`, else `fallback`.
    firstRule folder fallback key rules = match rules
        [] => fallback
        [first, ...rest] => match folder == (length first.keys == 1) && listContains first.keys key
            true => first.look
            false => firstRule folder fallback key rest

    fileLook kind = firstRule false (Look(symbol = "doc.fill", tint = "gray")) kind (looks ())
    // Finder's own folders keep their familiar symbols.
    folderLook title = firstRule true (Look(symbol = "folder.fill", tint = "blue")) title (looks ())

    (** The symbol and tint for an entry: apps and Finder's folders by name, files by kind. *)
    export look entry = match entry.link
        true => Look(symbol = "arrowshape.turn.up.right.fill", tint = "blue")
        false => entryLook entry

    entryLook entry = match entry.folder
        false => fileLook (extension entry.path)
        true => match extension entry.path == "app"
            true => Look(symbol = "app.fill", tint = "indigo")
            false => folderLook (name "" entry.path)

    scaled tenths unit larger = match larger
        [] => shown tenths unit
        [next, ...rest] => match tenths >= 10000
            true => scaled (intDiv (satAdd tenths 500) 1000) next rest
            false => shown tenths unit

    shown tenths "B" = "${intDiv tenths 10} B"
    shown tenths unit = "${intDiv tenths 10}.${tenths % 10} ${unit}"

    (** Decimal units with one rounded decimal, as Finder and System Settings count them. *)
    export formatBytes bytes = match bytes < 0
        true => "unknown"
        false => scaled (satMul bytes 10) "B" ["KB", "MB", "GB", "TB"]

    (** A count with thousands separators. *)
    export formatCount count = match count < 1000
        true => toString count
        false => formatCount (intDiv count 1000) + "," + (padStart (toString (count % 1000)) 3 "0" ?: "")

    ratio scale part whole = match whole > 0
        false => 0
        true =>
            handle Arith
                overflow _ _ _ _ => 0
                remainderByZero _ => 0
            intDiv (satAdd (satMul part scale) (intDiv whole 2)) whole

    // Settings counts the space the system can purge on demand as available.
    roomy volume = match volume.important > volume.available
        true => volume.important
        false => volume.available

    (** The space used on a volume as Settings counts it: purgeable space is free. *)
    export used volume = satSub volume.total (roomy volume)

    (** The kinds of asset the photo library is broken into, in the order shown. *)
    export photoKinds () = ["videos", "photos", "live", "screenshots"]

    (** The share of `whole`, rounded to a whole percent; an unknown or empty whole gives no share. *)
    export percent (part, whole) = ratio 100 part whole

    (** The same share in thousandths, for drawing. *)
    export permille (part, whole) = ratio 1000 part whole

    (** A share as people read it: a sliver is "< 1%", never "0%". *)
    export shareText (part, whole) = match percent (part, whole) == 0 && part > 0
        true => "< 1%"
        false => "${percent (part, whole)}%"
