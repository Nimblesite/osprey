// Implements [IOS-TARGET-MACOS] and [MOBILE-REACTIVE-UI]: the whole screen is
// an Osprey tree of native nodes. SwiftUI draws each one with the platform's
// own navigation, list, toolbar, gauge and toggle, on the Mac and on iPhone.
namespace storage

import bank::Json
import storage::Disk

module Native
    export field key value = Json::strField key value

    export node kind fields = Json::obj (join (listPrepend fields (field "kind" kind)) ",")

    export nodes key items = Json::rawField key (Json::arr (join items ","))

    export event kind value = Json::rawField "event" (Json::obj (field "type" kind + "," + field "value" value))

    export button symbol caption action = node "button" [field "symbol" symbol, field "text" caption, action]

    (** A toolbar button with a key equivalent; the `navigation` placement leads the toolbar. *)
    export tool placement symbol caption key action = node "button" [field "style" placement, field "symbol" symbol, field "text" caption, field "key" key, action]

    export section header footer rows = node "section" [field "text" header, field "detail" footer, nodes "children" rows]

    (** Buttons shown when the node is right-clicked: its context menu. *)
    export menu items = nodes "menu" items

    export notice symbol tint title detail = node "empty" [field "symbol" symbol, field "tint" tint, field "text" title, field "detail" detail]

module Phone
    pick flag yes no = match flag
        true => yes
        false => no

    sized title symbol tint bytes whole = Native::node "entry" [
        Native::field "text" title,
        Native::field "symbol" symbol,
        Native::field "tint" tint,
        Native::field "accent" tint,
        Native::field "detail" (Disk::formatBytes bytes),
        Native::field "caption" (Disk::shareText (bytes, whole)),
        Native::field "value" (toString (Disk::permille (bytes, whole))),
    ]

    waiting detail action = Native::node "entry" (listConcat [
        Native::field "text" "Photos & Videos",
        Native::field "symbol" "photo.on.rectangle.angled",
        Native::field "tint" "orange",
        Native::field "accent" "gray",
        Native::field "detail" detail,
        Native::field "caption" "",
        Native::field "value" "0",
    ] action)

    counts photos = photos.status == "ready" || photos.status == "limited"

    library photos used = match counts photos
        true => sized "Photos & Videos" "photo.on.rectangle.angled" "orange" photos.bytes used
        false => match photos.status
            "measuring" => waiting "Measuring…" []
            "denied" => waiting "Allow in Settings" [Native::event "settings" ""]
            _ => waiting "Allow to measure" [Native::event "allow" ""]

    limits photos = pick (photos.status == "limited") " You allowed only some photos, so only those count." ""

    // iOS shows no app what another app holds, so the phone's own story is the
    // space used less what this app may measure: its folder and, once the
    // person allows it, the part of the photo library kept on the device.
    breakdown volume ranking photos =
        used = Disk::used volume
        pictured = pick (counts photos) photos.bytes 0
        rest = satSub (satSub used pictured) ranking.bytes
        Native::section "On this ${volume.name}" "iOS lets no app look inside another, so only Settings › General › iPhone Storage splits the rest by app." [
            library photos used,
            sized "Osprey Storage" "app.fill" "indigo" ranking.bytes used,
            sized "Other apps & iOS" "square.stack.3d.up.fill" "gray" (pick (rest > 0) rest 0) used,
            Native::button "folder.badge.plus" "Measure a Folder in Files…" (Native::event "choose" ""),
        ]

    title kind = match kind
        "videos" => "Videos"
        "screenshots" => "Screenshots"
        "live" => "Live Photos"
        _ => "Photos"

    symbol kind = match kind
        "videos" => "video.fill"
        "screenshots" => "camera.viewfinder"
        "live" => "livephoto"
        _ => "photo.fill"

    tint kind = match kind
        "videos" => "purple"
        "screenshots" => "teal"
        "live" => "pink"
        _ => "orange"

    kindRow photos output index = match listGet photos.kinds index
        Error _ => output
        Success kind => match kind.items > 0
            true => listAppend output (sized "${title kind.name} · ${Disk::formatCount kind.items}" (symbol kind.name) (tint kind.name) kind.bytes photos.bytes)
            false => output

    // Originals iCloud keeps while the device holds a smaller copy, or none.
    cloudRow photos = pick (photos.cloud > 0) [Native::node "entry" [
        Native::field "text" "Only in iCloud",
        Native::field "symbol" "icloud.fill",
        Native::field "tint" "gray",
        Native::field "accent" "gray",
        Native::field "detail" (Disk::formatBytes photos.cloud),
        Native::field "caption" "",
        Native::field "value" "0",
    ]] []

    kinds photos =
        rows = range (0, length photos.kinds) |> fold [] (\(output, index) => kindRow photos output index)
        footer = "${Disk::formatCount photos.items} items, hidden ones included. Only what is stored on this device counts; Optimise iPhone Storage keeps full-size originals in iCloud, where they take no space here.${limits photos}"
        Native::section "Photos & Videos" footer (listConcat rows (cloudRow photos))

    (** Whether the browser is at an iPhone app's own folder, where the screen shows the whole device. *)
    export device model = model.platform == "ios" && model.root == model.home && model.path == model.root

    (** On iPhone, at the app's own folder: what uses the device, as far as iOS lets an app see, and what the photo library holds. *)
    export sections model volume ranking photos = pick (device model && volume.total > 0) (listConcat [breakdown volume ranking photos] (pick (counts photos) [kinds photos] [])) []

module View
    limit () = 120

    // Ranks one to five each own a colour in the composition bar and their rows.
    palette () = ["blue", "purple", "orange", "pink", "teal"]

    accent index = listGet (palette ()) index ?: "gray"

    pick flag yes no = match flag
        true => yes
        false => no

    used volume = Disk::used volume

    capacity volume = match volume.important > volume.available
        true => "${Disk::formatBytes volume.important} available, ${Disk::formatBytes (satSub volume.important volume.available)} of it purgeable"
        false => "${Disk::formatBytes volume.available} available"

    phone model = model.platform == "ios"

    pressure share = match share >= 900
        true => "red"
        false => pick (share >= 750) "orange" "blue"

    gauge volume =
        share = Disk::permille (used volume, volume.total)
        Native::node "gauge" [
            Native::field "symbol" "internaldrive.fill",
            Native::field "tint" (pressure share),
            Native::field "text" volume.name,
            Native::field "value" (toString share),
            Native::field "detail" "${Disk::formatBytes (used volume)} of ${Disk::formatBytes volume.total} used",
            Native::field "caption" (capacity volume),
        ]

    overview volume = match volume.total > 0
        true => Native::section "" "" [gauge volume]
        false => Native::section "" "" [Native::notice "internaldrive" "gray" "Capacity unavailable" "This folder's volume does not report its size."]

    // Home is the person's folder on the Mac; on iPhone it is the app's own,
    // where the screen tells the whole phone's story.
    title model volume path = match path == model.home
        true => pick (phone model) "Storage" "Home"
        false => Disk::name volume.name path

    reach model = pick (phone model) "Everything in this app's folder counts. iOS keeps every other app's files private from all apps." "Every file counts: apps, the system, hidden files, caches and package contents. macOS asks once before the app reads Desktop, Documents, Downloads and iCloud Drive; allow it so they count."

    measuring model volume =
        progress = Native::node "progress" [Native::field "text" "Measuring ${title model volume model.root}…", Native::field "detail" "${Disk::formatCount model.items} items · ${Disk::formatBytes model.bytes} so far"]
        Native::section "" (reach model) [progress]

    failed model volume = Native::section "" "" [Native::notice "exclamationmark.triangle.fill" "orange" "Cannot measure ${title model volume model.root}" "The folder no longer exists, or macOS did not allow it to be read. Choose another folder, or rescan."]

    // Lists are visited by loops, so no folder is deep or wide enough to
    // exhaust the stack.
    crumb model volume path = Native::button (pick (path == model.home) "house.fill" "folder.fill") (title model volume path) (Native::event "open" path)

    pathbar volume model =
        folders = Disk::trail model.root model.path
        crumbs = range (0, length folders) |> fold [] (\(output, index) => listAppend output (crumb model volume (listGet folders index ?: model.root)))
        Native::section "" "" [Native::node "pathbar" [Native::nodes "children" crumbs]]

    plural count one many = match count == 1
        true => "1 ${one}"
        false => "${Disk::formatCount count} ${many}"

    summary model volume ranking =
        whole = model.path == "/" || Phone::device model
        size = pick (whole && volume.total > 0) "${Disk::formatBytes (used volume)} used" "${Disk::formatBytes ranking.bytes} measured"
        "${size} · ${plural ranking.count "item" "items"}"

    nothing () = Entry(path = "", bytes = 0, visible = 0, hidden = false, folder = false, guarded = false, link = false)

    capped share = pick (share > 1000) 1000 share

    // A folder's context menu on the Mac opens it in Finder. An iPhone has no Finder.
    finder model path = pick (model.platform == "macos") [Native::menu [Native::button "folder" "Open in Finder" (Native::event "reveal" path)]] []

    folderRow model fields path = Native::node "entry" (listConcat (listAppend fields (Native::event "open" path)) (finder model path))

    segment ranking index title bytes = Native::node "segment" [
        Native::field "text" title,
        Native::field "tint" (accent index),
        Native::field "value" (toString (Disk::permille (bytes, ranking.bytes))),
        Native::field "detail" (Disk::shareText (bytes, ranking.bytes)),
    ]

    leader model ranking leading output index =
        entry = listGet leading index ?: nothing ()
        listAppend output (segment ranking index (Disk::name "" entry.path) (Disk::size model.hidden entry))

    sizes model entries = range (0, length entries) |> fold 0 (\(total, index) => satAdd total (Disk::size model.hidden (listGet entries index ?: nothing ())))

    composition model volume ranking =
        leading = Disk::top (length (palette ())) ranking.top
        rest = satSub ranking.bytes (sizes model leading)
        others = pick (rest > 0) [segment ranking (length (palette ())) "Everything else" rest] []
        bar = Native::node "stack" [Native::nodes "children" (listConcat (range (0, length leading) |> fold [] (\(output, index) => leader model ranking leading output index)) others)]
        scope = pick model.hidden "hidden files included" "hidden files left out"
        footer = "${Disk::formatBytes ranking.bytes} measured here, ${scope}: ${Disk::shareText (ranking.bytes, used volume)} of the space used on ${volume.name}."
        Native::section "" footer [bar]

    row model ranking largest output index =
        entry = listGet ranking.top index ?: nothing ()
        look = Disk::look entry
        bytes = Disk::size model.hidden entry
        fields = [
            Native::field "text" (Disk::name "" entry.path),
            Native::field "symbol" look.symbol,
            Native::field "tint" look.tint,
            Native::field "accent" (accent index),
            Native::field "style" (pick entry.hidden "hidden" ""),
            Native::field "detail" (pick entry.link "Symbolic link" (Disk::formatBytes bytes)),
            Native::field "caption" (pick entry.link "Target size excluded" (Disk::shareText (bytes, ranking.bytes))),
            Native::field "value" (toString (capped (Disk::permille (bytes, largest)))),
        ]
        listAppend output (pick entry.folder (folderRow model fields entry.path) (Native::node "entry" fields))

    remainder model ranking largest =
        count = satSub ranking.count ranking.kept
        bytes = satSub ranking.bytes (sizes model ranking.top)
        pick (count > 0) [Native::node "entry" [
            Native::field "text" "${plural count "smaller item" "smaller items"}",
            Native::field "symbol" "ellipsis.circle.fill",
            Native::field "tint" "gray",
            Native::field "accent" "gray",
            Native::field "detail" (Disk::formatBytes bytes),
            Native::field "caption" (Disk::shareText (bytes, ranking.bytes)),
            Native::field "value" (toString (capped (Disk::permille (bytes, largest)))),
        ]] []

    unreadable model = match phone model
        true => "iOS keeps them from the app."
        false => pick model.full "They belong to the system or to another user." "Mail, Messages, Safari and other apps' private data need Full Disk Access."

    blockedNote model count = match count > 0
        true => "${plural count "folder" "folders"} here could not be read and are not counted. ${unreadable model}"
        false => ""

    sealed model output entry = match entry.guarded && Disk::inSight model.hidden entry
        false => output
        true => listAppend output (Native::node "entry" (listConcat [
            Native::field "text" (Disk::name "" entry.path),
            Native::field "symbol" "lock.fill",
            Native::field "tint" "gray",
            Native::field "accent" "gray",
            Native::field "style" (pick entry.hidden "hidden" ""),
            Native::field "detail" "Choose to measure",
            Native::field "caption" "",
            Native::field "value" "0",
            Native::event "grant" entry.path,
        ] (finder model entry.path)))

    protectedSection model listing =
        rows = range (0, length listing.entries) |> fold [] (\(output, index) => sealed model output (listGet listing.entries index ?: nothing ()))
        pick (length rows > 0) [Native::section "Other apps' data" "macOS asks before any app reads another app's data. Choose one to measure it, or allow Full Disk Access to measure them all." rows] []

    // Without Full Disk Access, macOS keeps other apps' data out of every total.
    access model = pick (phone model == false && model.full == false) [Native::section "Full Disk Access" "Without it, Mail, Messages, Safari and other apps' data are not counted. Turn on Osprey Storage in the list, then quit and reopen it." [Native::button "lock.shield" "Allow Full Disk Access…" (Native::event "settings" "")]] []

    items model ranking listing =
        largest = Disk::size model.hidden (listGet ranking.top 0 ?: nothing ())
        rows = listConcat (range (0, ranking.kept) |> fold [] (\(output, index) => row model ranking largest output index)) (remainder model ranking largest)
        Native::section "Largest items" (blockedNote model listing.blocked) rows

    emptied model = match model.hidden
        true => Native::notice "tray" "gray" "Nothing here" "This folder is empty."
        false => Native::notice "eye.slash" "gray" "Everything here is hidden" "Turn on Hidden Files to see what this folder holds."

    contents model volume listing ranking = match listing.measured
        false => [Native::section "" "" [Native::notice "questionmark.folder" "gray" "Not measured yet" "Rescan to measure this folder."]]
        true => match ranking.count > 0
            true => pick (Phone::device model) [] (listConcat [composition model volume ranking, items model ranking listing] (protectedSection model listing))
            false => listPrepend (protectedSection model listing) (Native::section "" (blockedNote model listing.blocked) [emptied model])

    enclosing model = match model.path == model.root
        true => []
        false => [Native::tool "navigation" "chevron.left" "Enclosing Folder" "command+up" (Native::event "up" "")]

    visibility model = Native::node "toggle" [
        Native::field "text" "Hidden Files",
        Native::field "value" (toString model.hidden),
        Native::field "symbol" (pick model.hidden "eye" "eye.slash"),
        Native::field "key" "command+shift+.",
        Native::event "hidden" "",
    ]

    toolbar model = listConcat (enclosing model) [
        visibility model,
        Native::tool "" "arrow.clockwise" "Rescan" "command+r" (Native::event "rescan" ""),
        Native::tool "" "folder.badge.plus" "Choose Folder…" "command+o" (Native::event "choose" ""),
    ]

    // The open folder names the screen, so each folder starts at its top.
    screen model volume subtitle sections = Native::node "navigation" [
        Native::field "id" model.path,
        Native::field "text" (title model volume model.path),
        Native::field "detail" subtitle,
        Native::nodes "toolbar" (toolbar model),
        Native::nodes "children" sections,
    ]

    ready model volume listing photos =
        ranking = Disk::rank model.hidden (limit ()) listing.entries
        head = pick (model.path == model.root) (listConcat (listPrepend (Phone::sections model volume ranking photos) (overview volume)) (access model)) [pathbar volume model]
        screen model volume (summary model volume ranking) (listConcat head (contents model volume listing ranking))

    (** The screen for a browser: the volume, the walk's progress or failure, or the ranked contents of the open folder. *)
    export render model =
        volume = perform Disk::Facts.volume model.root
        match model.stage
            "measuring" => screen model volume "Measuring…" [overview volume, measuring model volume]
            "failed" => screen model volume "" [overview volume, failed model volume]
            _ => ready model volume (perform Disk::Facts.listing model.path) (perform Disk::Facts.photos ())
