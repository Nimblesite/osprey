// [SYNTH-HOST-STREAM-SESSION-DESKTOP] Native session calls for plug-in editor windows.
namespace synth

import ui::Requests

(** Bounded native session calls. *)
module GraphWorkers
    (** One process argument pair at the native boundary. *)
    export header (key, value) = ui::Header(headerName = key, headerValue = value)

    (** One bounded native session operation and its reusable output slice. *)
    export call (ticket, operation, arguments, slice) = Requests::ask (ticket, ui::HostCall(hostNamespace = "process", hostOperation = operation, hostArguments = arguments, hostTimeout = 10000, hostLimit = 4194304, hostSlice = slice))
