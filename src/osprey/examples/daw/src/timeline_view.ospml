// [DAW-PAGES] The timeline: every track's lane, the selected track's piano roll and its inspector.
namespace synth

import ui::Scenes

(** Scene shapes shared by the daw's pages, and the Timeline page itself. *)
module TimelineView
    (** Text with its left (0), centre (1) or right (2) edge at x. *)
    export label (words, x, y, size, colour, anchor, depth) = Scenes::lettering (words, x, y, size, colour, anchor, ui::Pick::either (size >= 17.0, 550.0, 400.0), depth)

    (** A rectangle by its top-left corner. *)
    export box (left, top, width, height, colour, depth) = Scenes::rect (left + width / 2.0, top + height / 2.0, width, height, 0.0, colour, depth)

    (** A hit area by its top-left corner. *)
    export area (name, left, top, width, height, selected) = EditorView::accessible (name, left, top, width, height, selected)

    (** The main text colour. *)
    export ink () = Scenes::rgb (240, 236, 255)
    (** Secondary text and rule colour. *)
    export dim () = Scenes::rgb (150, 140, 190)
    (** Orange used for selected tracks and signal flow. *)
    export accent () = Scenes::rgb (255, 132, 66)
    (** Colour for inactive track data. *)
    export lavender () = Scenes::rgb (170, 158, 230)
    (** The track inspector background. *)
    export panelInk () = Scenes::rgb (24, 20, 44)

    names = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"]

    (** A MIDI pitch's name, middle C (60) as C4. *)
    export noteName pitch = "${listGet names (pitch % 12) ?: "?"}${satSub (intDiv pitch 12) 1}"

    (** An instrument's kind as the timeline names it. *)
    export instrumentName instrument = match instrument
        daw::PatchInstrument routing => match routing.nodes
            [voice, sink] => ui::Pick::either (voice.component == "sample" && sink.component == "output", "Sample", "Patch")
            _ => "Patch"
        daw::PluckInstrument _ _ => "Pluck"
        daw::BowInstrument _ _ _ => "Bow"
        daw::BellInstrument _ _ => "Bell"
        daw::MalletInstrument _ _ => "Mallet"
        daw::OperatorInstrument _ => "Operator"
        daw::DrumInstrument _ => "Drum"

    (** A value to two decimals. *)
    export hundredths value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${intDiv whole 100}.${ui::Pick::either (whole % 100 < 10, "0", "")}${whole % 100}"

    (** Format a normalized control value as a whole percent. *)
    export percent value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${whole}%"

    (** Pan as L, C or R and a whole percent. *)
    export pan value = match TimelineGeometry::percent value == 0.0
        true => "C"
        false => "${ui::Pick::either (value < 0.0, "L", "R")} ${percent (ui::Pick::either (value < 0.0, 0.0 - value, value))}"

    (** The header's hit areas: the page tabs, then Play and Stop ([DAW-HEADER]). *)
    export headerAreas editor = Header::songAreas editor

    (** The page's place among the header tabs. *)
    export pageIndex page = match page
        PatchPage => 0
        TimelinePage => 1
        MixPage => 2

    tile (a, fill) = [EditorView::panel (a.accessLeft, a.accessTop, a.accessWidth, a.accessHeight, fill, 10), label (a.accessLabel, a.accessLeft + a.accessWidth / 2.0, a.accessTop + 12.0, 16.0, ink (), 1, 11)]

    track editor = listGet editor.song.tracks editor.track

    songBeats song =
        duration = daw::Arrangements::beats song
        ui::Pick::either (duration < 4.0, 4.0, duration)

    (** The song's length in beats, never under one bar. *)
    export beats editor = songBeats editor.song

    spanFor (editor, duration) = TimelineGeometry::laneSpan (duration, editor.laneZoom)

    originFor (editor, duration, span) = TimelineGeometry::laneFirst (editor.laneStart, span, duration)

    laneWindow (editor, duration) =
        span = spanFor (editor, duration)
        { span = span, origin = originFor (editor, duration, span) }

    (** [DAW-TIMELINE-ZOOM] How many beats the lanes show. *)
    export shownBeats editor = spanFor (editor, beats editor)

    (** The first beat the lanes show. *)
    export shownFrom editor = (laneWindow (editor, beats editor)).origin

    viewed (editor, zoom, start) = editor(laneZoom = zoom, laneStart = start, laneTraces = traces (editor.song, zoom, start, editor.laneTop))

    (** The lanes zoomed by `factor` about the playhead: above 1 closer, below 1 wider, 0 the whole song. Only
        the view changes: not the song, the playhead, the selection or the undo history. *)
    export zoomedBy (editor, factor) =
        duration = beats editor
        window = laneWindow (editor, duration)
        zoom = ui::Pick::either (factor <= 0.0, 1.0, TimelineGeometry::zoomed (editor.laneZoom, factor, duration))
        viewed (editor, zoom, TimelineGeometry::zoomFirst (cursor editor, window.origin, window.span, TimelineGeometry::laneSpan (duration, zoom), duration))

    (** The lanes moved, when they must, so the playhead and the piano roll's two bars stay in view. *)
    export following editor =
        duration = beats editor
        window = laneWindow (editor, duration)
        start = TimelineGeometry::followFirst (cursor editor, window.origin, window.span, duration)
        match start == window.origin
            true => editor
            false => viewed (editor, editor.laneZoom, start)

    pageSize = 7
    rowHeight = 31.0

    visible editor =
        first = editor.laneTop
        stop = satAdd first pageSize
        toList (range (first, ui::Pick::either (stop < length editor.song.tracks, stop, length editor.song.tracks)))

    (** The lanes scrolled so track `top` is the first one shown, with every lane's notes drawn at its new row. *)
    export scrolled (editor, top) = match top == editor.laneTop
        true => editor
        false => editor(laneTop = top, laneTraces = traces (editor.song, editor.laneZoom, editor.laneStart, top), revision = satAdd editor.revision 1)

    (** The first lane to show so track `index` is in view, moving the lanes no further than that needs. *)
    export keeping (editor, index) = floatToInt (TimelineGeometry::keptTop (toFloat editor.laneTop, toFloat index, toFloat pageSize, toFloat (length editor.song.tracks))) ?: 0

    // [DAW-LAYOUT-FILL] More tracks than lanes: the lanes scroll, one row at a time.
    scrolls editor = length editor.song.tracks > pageSize

    noteTrace (voice, top, height, origin, span) =
        low = toFloat (lowest voice.notes)
        high = toFloat (highest voice.notes)
        ui::Lists::flatten (mapList (voice.notes, \note => segment (top, height, origin, span, low, high, note)))

    // A note outside the beats span draws nothing; one that crosses an edge is cut there.
    segment (top, height, origin, span, low, high, note: daw::Note) =
        left = TimelineGeometry::laneX (note.start, origin, span)
        right = TimelineGeometry::laneX (note.start + note.length, origin, span)
        near = TimelineGeometry::laneEdge left
        far = TimelineGeometry::laneEdge right
        y = TimelineGeometry::lanePitch (top, height, toFloat note.pitch, low, high)
        match right < 198.0 || left > 1092.0
            true => []
            false => [ui::MoveTo(toX = near, toY = y), ui::LineTo(toX = ui::Pick::either (far < near + 1.0, near + 1.0, far), toY = y)]

    (** Cache the pitch traces of the beats span, on open and on zoom. Selecting a note or moving a fader only
        changes the overlay. *)
    export traces (song, zoom, start, top) =
        height = rowHeight
        span = TimelineGeometry::laneSpan (songBeats song, zoom)
        origin = TimelineGeometry::laneFirst (start, span, songBeats song)
        mapList (toList (range (0, length song.tracks)), \i =>
            match listGet song.tracks i
                Error _ => []
                Success voice => noteTrace (voice, TimelineGeometry::rowY (toFloat (satSub i top), height), height, origin, span))

    traceShape (steps, colour) = Scenes::path (steps, ui::Line(width = 1.7, dashes = [], bevel = false), ui::Solid(tint = Scenes::hex (shiftRight colour 8, 1.0)), 4)

    // Consume complete UTF-8 scalars. The inspector keeps the unabbreviated track name.
    laneTitle (name, at, remaining) = match at >= length name
        true => name
        false => match remaining == 0
            true => "${substring name 0 at ?: ""}…"
            false => match codePointAt name at
                Error _ => "${substring name 0 at ?: ""}…"
                Success point => laneTitle (name, satAdd at (codePointWidth point ?: 1), satSub remaining 1)

    lane (editor, index, voice) =
        height = rowHeight
        top = TimelineGeometry::rowY (toFloat (satSub index editor.laneTop), height)
        chosen = index == editor.track
        colour = ui::Pick::either (chosen, accent (), lavender ())
        size = 13.0
        [box (0.0, top, 1132.0, height, ui::Pick::either (chosen, Scenes::rgb (58, 34, 46), ui::Pick::either (index % 2 == 0, Scenes::rgb (20, 17, 38), Scenes::rgb (17, 14, 34))), 2), box (0.0, top, 3.0, height, ui::Pick::either (chosen, accent (), panelInk ()), 3), label ("${satAdd index 1}", 24.0, top + 8.0, size, dim (), 0, 3), label (laneTitle (voice.name, 0, 14), 40.0, top + 1.0, ui::Pick::either (length voice.name > 12, 11.0, size), ui::Pick::either (chosen, ink (), lavender ()), 0, 3), label (instrumentName voice.instrument, 40.0, top + 16.0, 11.0, dim (), 0, 3), traceShape (listGet editor.laneTraces index ?: [], colour)]

    whole value = floatToInt value ?: 0

    rulerLabel (editor, beat, major) =
        measure = DawSession::measure editor.song
        bar = satAdd (whole (TimelineGeometry::bar (beat, measure))) 1
        match major < measure
            true => "${bar}.${whole (TimelineGeometry::beatInBar (beat, measure, DawSession::unit editor.song))}"
            false => "${bar}"

    // [DAW-TIMELINE-ZOOM] One ruler line of the beats shown, numbered when it falls on a major division.
    division (editor, origin, span, step, major, duration, index) =
        beat = TimelineGeometry::rulerBeat (origin, step, toFloat index)
        x = TimelineGeometry::laneX (beat, origin, span)
        strong = TimelineGeometry::onDivision (beat, major) > 0.5
        line = box (x, 221.0, 1.0, 217.0, ui::Pick::either (strong, Scenes::rgb (54, 46, 73), Scenes::rgb (36, 30, 52)), 3)
        tick = box (x, 215.0, 1.0, ui::Pick::either (strong, 8.0, 4.0), dim (), 4)
        match x >= 197.5 && x <= 1092.5 && beat <= duration
            false => []
            true => match strong
                true => [line, tick, label (rulerLabel (editor, beat, major), x, 200.0, 11.0, dim (), 0, 4)]
                false => [line, tick]

    // Share the visible interval across all ticks. A duration lookup traverses every track's notes.
    ruler (editor, duration, origin, span) =
        step = TimelineGeometry::rulerStep (span, DawSession::measure editor.song, DawSession::unit editor.song)
        major = TimelineGeometry::rulerMajor (span, DawSession::measure editor.song, DawSession::unit editor.song)
        ui::Lists::flatten (mapList (toList (range (0, whole (TimelineGeometry::rulerCount (span, step)))), \index => division (editor, origin, span, step, major, duration, index)))

    // A marker: a line down the lanes with its handle on the ruler, when it is in view.
    marker (at, colour) = match at < 197.5 || at > 1092.5
        true => []
        false => [box (at, 211.0, 1.0, 227.0, colour, 7), box (at - 3.0, 210.0, 7.0, 5.0, colour, 7)]

    markerAt (beat, origin, span, colour) = marker (TimelineGeometry::laneX (beat, origin, span), colour)

    // [DAW-TRANSPORT-RANGE] [DAW-TRANSPORT-PLAYHEAD] [DAW-TRANSPORT-FOLLOW]
    // The two draggable endpoints and the sounding beat share the ruler's scale.
    markers (editor, origin, span) =
        finish = markerAt (DawSession::rangeEnd editor, origin, span, ink ())
        start = markerAt (DawSession::rangeStart editor, origin, span, accent ())
        sounding = match editor.playBeat < 0.0
            true => []
            false => markerAt (editor.playBeat, origin, span, Scenes::rgb (120, 232, 150))
        ui::Lists::flatten [finish, start, sounding, scroll editor]

    arrangement (editor, duration) =
        window = laneWindow (editor, duration)
        heading = [label ("Arrangement", 24.0, 160.0, 18.0, ink (), 0, 4), label ("${length editor.song.tracks} tracks", 154.0, 163.0, 13.0, dim (), 0, 4), label ("Bars 1–${satAdd (DawSession::bar (editor.song, duration)) 1}", 1108.0, 163.0, 13.0, dim (), 2, 4), label ("TRACKS", 24.0, 200.0, 12.0, dim (), 0, 3)]
        rows = foldList (visible editor, [], \(all, index) =>
            match listGet editor.song.tracks index
                Error _ => all
                Success voice => listConcat all (lane (editor, index, voice)))
        ui::Lists::flatten [heading, ruler (editor, duration, window.origin, window.span), rows, markers (editor, window.origin, window.span)]

    scroll editor = match scrolls editor
        false => []
        true =>
            count = toFloat (length editor.song.tracks)
            [box (1119.0, 221.0, 5.0, 217.0, panelInk (), 6), box (1119.0, TimelineGeometry::thumbTop (toFloat editor.laneTop, count), 5.0, TimelineGeometry::thumbHeight (toFloat pageSize, count), dim (), 7)]

    // [DAW-TRANSPORT-RANGE] A press on a marker's handle or anywhere down its line takes hold of that marker alone:
    // the start and the end move independently.
    grabbed (editor, x, y) = match y >= 193.0 && y < 438.0 && x >= 198.0 && x <= 1098.0
        false => Error(message = "No marker here.")
        true =>
            window = laneWindow (editor, beats editor)
            match TimelineGeometry::grabs (x, TimelineGeometry::laneX (DawSession::rangeStart editor, window.origin, window.span))
                true => Success(value = MoveStart(bar = editor.rollBar))
                false => match TimelineGeometry::grabs (x, TimelineGeometry::laneX (DawSession::rangeEnd editor, window.origin, window.span))
                    true => Success(value = MoveEnd(bar = endAt (editor, x)))
                    false => Error(message = "No marker here.")

    marked (editor, x, y) = match grabbed (editor, x, y)
        Success action => Success(value = action)
        Error _ => lanePick (editor, x, y)

    (** Every lane's hit area: a press on a marker takes hold of it; elsewhere a tap picks the track at that bar,
        and its name opens the patch. *)
    export laneAt (editor, x, y) = match x >= 1113.0 && x < 1132.0 && y >= 221.0 && y < 438.0 && scrolls editor
        true => Success(value = ScrollLanes(top = floatToInt (TimelineGeometry::scrollTop (y, toFloat pageSize, toFloat (length editor.song.tracks))) ?: 0))
        false => marked (editor, x, y)

    lanePick (editor, x, y) =
        within = floatToInt (TimelineGeometry::rowAt (y, rowHeight)) ?: -1
        row = satAdd editor.laneTop within
        match within >= 0 && within < pageSize && row < length editor.song.tracks && y >= 221.0 && x < 1113.0
            false => rulerAt (editor, x, y)
            true => match x < 198.0
                true => Success(value = OpenTrack(index = row))
                false => Success(value = PickTrack(index = row, bar = barAt (editor, x)))

    beatAt (editor, x, duration) =
        window = laneWindow (editor, duration)
        TimelineGeometry::laneBeat (x, window.origin, window.span, duration)

    // The bar under `x`, kept inside the song so Play always has music under it.
    barAt (editor, x) =
        duration = beats editor
        floatToInt (TimelineGeometry::playableBar (beatAt (editor, x, duration), duration, DawSession::measure editor.song)) ?: 0

    (** [DAW-TRANSPORT-RANGE] The end marker's bar line under `x`: the nearest one, after the start marker. *)
    export endAt (editor, x) = floatToInt (TimelineGeometry::endBar (beatAt (editor, x, beats editor), toFloat editor.rollBar, DawSession::measure editor.song)) ?: 0

    (** [DAW-TRANSPORT-RANGE] The start marker's bar line under `x`: the nearest one, before the end marker. *)
    export startAt (editor, x) =
        duration = beats editor
        floatToInt (TimelineGeometry::startBar (beatAt (editor, x, duration), toFloat editor.playEnd, duration, DawSession::measure editor.song)) ?: 0

    // [DAW-TRANSPORT-PLAYHEAD] A press on the ruler away from the markers moves the start marker to that bar and keeps the track.
    rulerAt (editor, x, y) = match y >= 193.0 && y < 221.0 && x >= 198.0 && x <= 1098.0
        true => Success(value = PickTrack(index = editor.track, bar = barAt (editor, x)))
        false => Error(message = "No lane here.")

    (** Accessibility regions for the arrangement track rows. *)
    export laneAccess editor = mapList (visible editor, \index => area ("Track ${satAdd index 1}", 0.0, TimelineGeometry::rowY (toFloat (satSub index editor.laneTop), rowHeight), 1132.0, rowHeight, index == editor.track))

    // The first of the two bars the piano roll shows: the start marker's, or the page being heard.
    shownBar editor = match editor.playBeat < 0.0
        true => editor.rollBar
        false => floatToInt (TimelineGeometry::rollPage (editor.playBeat, toFloat editor.rollBar, DawSession::measure editor.song)) ?: editor.rollBar

    rollStart editor = TimelineGeometry::barStart (toFloat (shownBar editor), DawSession::measure editor.song)

    // What the lanes follow and zoom about: the beat being heard, or the start marker.
    cursor editor = ui::Pick::either (editor.playBeat < 0.0, DawSession::rangeStart editor, editor.playBeat)

    playing (editor, note: daw::Note) = note.start + note.length > rollStart editor && note.start < rollStart editor + 2.0 * DawSession::measure editor.song

    shown (editor, voice) = filterList (voice.notes, \note => playing (editor, note))

    lowest notes = foldList (notes, 127, \(low, note: daw::Note) => ui::Pick::either (note.pitch < low, note.pitch, low))

    highest notes = foldList (notes, 0, \(high, note: daw::Note) => ui::Pick::either (note.pitch > high, note.pitch, high))

    // `start` and `length` name fields of several records, so the note's type is stated.
    rollNote (editor, first, high, rows, chosen, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first, DawSession::measure editor.song)
        width = TimelineGeometry::rollWidth (note.start, note.length, first, DawSession::measure editor.song)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match chosen
            true => Scenes::rgb (255, 211, 158)
            false => ui::Pick::either (note.velocity >= 0.7, accent (), Scenes::rgb (191, 125, 82))
        shape = box (left, top + 1.0, width, ui::Pick::either (height > 3.0, height - 2.0, 1.0), colour, 7)
        stem = TimelineGeometry::velocityHeight note.velocity
        stemColour = ui::Pick::either (chosen, Scenes::rgb (255, 219, 122), accent ())
        markers = [shape, box (left, 894.0 - stem, 2.5, stem, stemColour, 7), Scenes::disc (left + 1.0, 894.0 - stem, 2.8, stemColour, 8)]
        size = TimelineGeometry::noteLabelSize height
        match width >= 28.0 && size >= 7.0
            true => listAppend markers (label (noteName note.pitch, left + 4.0, TimelineGeometry::noteLabelY (top, height, size), size, Scenes::rgb (40, 20, 10), 0, 8))
            false => markers

    blackKey pitch = match pitch % 12
        1 => true
        3 => true
        6 => true
        8 => true
        10 => true
        _ => false

    keyRow (high, rows, row) =
        pitch = satSub high row
        top = TimelineGeometry::pitchY (toFloat pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match blackKey pitch
            true => Scenes::rgb (18, 15, 34)
            false => Scenes::rgb (25, 21, 45)
        stripe = box (76.0, top, 1034.0, height, colour, 4)
        ivory = box (0.0, top, 74.0, height, Scenes::rgb (227, 224, 244), 4)
        match blackKey pitch
            true => [stripe, ivory, box (0.0, top, 47.0, height, Scenes::rgb (40, 33, 61), 5)]
            false => match pitch % 12 == 0
                true => [stripe, ivory, label (noteName pitch, 69.0, top, ui::Pick::either (height >= 13.0, 11.0, height), panelInk (), 2, 6)]
                false => [stripe, ivory]

    pianoKeys (high, rows) = foldList (toList (range (0, rows)), [], \(all, row) => listConcat all (keyRow (high, rows, row)))

    beatLines editor = mapList (toList (range (0, satAdd (satMul editor.song.meterTop 8) 1)), \step =>
        x = TimelineGeometry::rollX (rollStart editor + toFloat step * DawSession::unit editor.song / 4.0, rollStart editor, DawSession::measure editor.song)
        box (x, 542.0, ui::Pick::either (step % (satMul editor.song.meterTop 4) == 0, 2.0, 1.0), 260.0, ui::Pick::either (step % 4 == 0, Scenes::rgb (59, 50, 82), Scenes::rgb (34, 29, 52)), 5))

    bars editor = mapList (toList (range (0, satMul editor.song.meterTop 2)), \beat => label ("${satAdd (satAdd (shownBar editor) (intDiv beat editor.song.meterTop)) 1}.${satAdd (beat % editor.song.meterTop) 1}", TimelineGeometry::rollX (rollStart editor + toFloat beat * DawSession::unit editor.song, rollStart editor, DawSession::measure editor.song) + 4.0, 520.0, 11.0, dim (), 0, 5))

    // [DAW-TRANSPORT-FOLLOW] The beat sounding now, down the piano roll.
    rollSounding editor = match editor.playBeat < 0.0
        true => []
        false => [box (TimelineGeometry::rollX (editor.playBeat, rollStart editor, DawSession::measure editor.song), 542.0, 2.0, 352.0, Scenes::rgb (120, 232, 150), 8)]

    pitchTop notes = match notes
        [] => 72
        _ => ui::Pick::either (highest notes >= 127, 127, satAdd (highest notes) 1)

    pitchRows (notes, high) = match notes
        [] => 13
        _ =>
            span = satAdd (satSub high (lowest notes)) 2
            ui::Pick::either (span < 13, 13, span)

    captured (editor, voice) = match editor.rollDrag
        RollIdle => voice
        RollHeld motion => daw::Projects::withNote (voice, editor.selectedNote, motion.preview)

    (** Freeze row spacing from the unedited track for the duration of a drag. *)
    export rowSize (editor, voice) =
        notes = shown (editor, voice)
        TimelineGeometry::pitchHeight (toFloat (pitchRows (notes, pitchTop notes)))

    selected (editor, voice, note) = match listGet voice.notes editor.selectedNote
        Error _ => false
        Success picked => structuralEquals (note, picked)

    selectedCursor (editor, voice) = match listGet voice.notes editor.selectedNote
        Error _ => []
        Success note => match playing (editor, note)
            false => []
            true =>
                x = TimelineGeometry::rollX (note.start, rollStart editor, DawSession::measure editor.song)
                [box (x, 538.0, 1.0, 357.0, accent (), 6), Scenes::path ([ui::Polygon(corners = [x - 4.0, 535.0, x + 4.0, 535.0, x, 542.0], closed = true)], ui::Fill, ui::Solid(tint = Scenes::hex (16745538, 1.0)), 7)]

    velocityGrid editor = mapList (toList (range (0, satAdd (satMul editor.song.meterTop 8) 1)), \tick =>
        x = TimelineGeometry::rollX (rollStart editor + toFloat tick * DawSession::unit editor.song / 4.0, rollStart editor, DawSession::measure editor.song)
        box (x, 850.0, 1.0, 45.0, ui::Pick::either (tick % 4 == 0, Scenes::rgb (44, 38, 60), Scenes::rgb (29, 25, 43)), 4))

    roll editor = match track editor
        Error _ => [label ("Open a song to see its tracks.", 24.0, 500.0, 18.0, dim (), 0, 3)]
        Success original =>
            bounds = shown (editor, original)
            high = pitchTop bounds
            rows = pitchRows (bounds, high)
            voice = captured (editor, original)
            notes = match editor.rollDrag
                RollIdle => bounds
                RollHeld _ => shown (editor, voice)
            heading = [box (0.0, 437.0, 1132.0, 18.0, panelInk (), 3), box (0.0, 511.0, 1132.0, 30.0, panelInk (), 3), label ("PITCH", 16.0, 520.0, 10.0, dim (), 0, 5), label ("VELOCITY", 8.0, 815.0, 10.0, dim (), 0, 5), label ("0–1", 28.0, 870.0, 10.0, dim (), 0, 5), box (0.0, 803.0, 1132.0, 1.0, Scenes::rgb (50, 42, 70), 4), box (76.0, 894.0, 1034.0, 1.0, dim (), 4), label ("Piano roll", 24.0, 477.0, 18.0, ink (), 0, 3), label ("${voice.name}    ${length notes} of ${length voice.notes} notes", 130.0, 481.0, 14.0, accent (), 0, 3)]
            listConcat (ui::Lists::flatten [heading, pianoKeys (high, rows), beatLines editor, bars editor, selectedCursor (editor, voice), velocityGrid editor, rollSounding editor]) (foldList (notes, [], \(all, note) => listConcat all (rollNote (editor, rollStart editor, high, rows, selected (editor, voice, note), note))))

    (** The empty dry destination in a project is the direct Master input. *)
    export destination voice = ui::Pick::either (voice.bus == "", "Master", voice.bus)

    fact (name, value, top) = [label (name, 1154.0, top, 14.0, dim (), 0, 9), label (value, 1416.0, top, 14.0, ink (), 2, 9)]

    section (name, top) = [box (1154.0, top, 262.0, 1.0, Scenes::rgb (53, 45, 72), 8), label (name, 1154.0, top + 12.0, 11.0, dim (), 0, 9)]

    fader (name, value, unit, maximum, top) =
        width = TimelineGeometry::meter (unit, maximum, 262.0)
        listConcat (fact (name, value, top)) [box (1154.0, top + 24.0, 262.0, 3.0, Scenes::rgb (61, 52, 84), 9), box (1154.0, top + 24.0, width, 3.0, accent (), 10), Scenes::disc (1154.0 + width, top + 25.5, 4.0, accent (), 10)]

    details (editor, voice) = ui::Lists::flatten [
        [label (voice.name, 1154.0, 196.0, 26.0, ink (), 0, 9), label ("Track ${satAdd editor.track 1}    ·    ${instrumentName voice.instrument} instrument", 1154.0, 236.0, 13.0, dim (), 0, 9)],
        section ("MIX", 270.0), fader ("Gain", "${hundredths voice.gain}×", voice.gain, 4.0, 322.0),
        fader ("Pan", pan voice.pan, voice.pan + 1.0, 2.0, 381.0), section ("BUS ROUTING", 440.0),
        [label ("Output", 1154.0, 491.0, 14.0, dim (), 0, 9), box (1154.0, 518.0, 262.0, 36.0, Scenes::rgb (46, 39, 66), 9), Scenes::disc (1173.0, 536.0, 4.0, accent (), 10), label (destination voice, 1188.0, 529.0, 14.0, ink (), 0, 10), label ("›", 1400.0, 526.0, 18.0, dim (), 2, 10)]]

    (** The track inspector writes its controls through the same checked mixer action as the routing table. *)
    export inspectorAt (editor, x, y) = match track editor
        Error _ => Error(message = "Select a track first.")
        Success voice => match x >= 1154.0 && x <= 1416.0
            false => Error(message = "No control here.")
            true => match y >= 338.0 && y <= 358.0
                true => Success(value = AdjustMix(index = editor.track, gain = TimelineGeometry::fader (x, 1154.0, 262.0, 0.0, 4.0), pan = voice.pan))
                false => match y >= 397.0 && y <= 417.0
                    true => Success(value = AdjustMix(index = editor.track, gain = voice.gain, pan = TimelineGeometry::fader (x, 1154.0, 262.0, -1.0, 1.0)))
                    false => match y >= 518.0 && y <= 554.0
                        true => Success(value = ChooseOutput(index = editor.track, offset = -1))
                        false => Error(message = "No control here.")

    noteDetails (editor, voice) = match listGet voice.notes editor.selectedNote
        Error _ => []
        Success note => listConcat (listConcat (listConcat (section ("SELECTED NOTE", 665.0)) [label (noteName note.pitch, 1154.0, 717.0, 26.0, ink (), 0, 9), label ("MIDI ${note.pitch}", 1416.0, 727.0, 12.0, dim (), 2, 9)]) (fact ("Start (beats)", hundredths note.start, 770.0))) (listConcat (fact ("Length (beats)", hundredths note.length, 807.0)) (listConcat (fact ("Velocity", percent note.velocity, 844.0)) [box (1154.0, 872.0, 262.0, 5.0, dim (), 9), box (1154.0, 872.0, TimelineGeometry::meter (note.velocity, 1.0, 262.0), 5.0, accent (), 10)]))

    hitNote (editor, first, high, rows, x, y, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first, DawSession::measure editor.song)
        right = TimelineGeometry::rollX (note.start + note.length, first, DawSession::measure editor.song)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        inside = y >= top && y < top + TimelineGeometry::pitchHeight (toFloat rows) && x >= left && x <= right
        right > left && (inside || y >= 815.0 && y <= 900.0 && x >= left - 3.0 && x <= left + 4.0)

    (** Hit-test notes and velocity stems against the same clipped positions used to draw them. *)
    export rollAt (editor, x, y) = match x >= 1154.0 && x <= 1416.0 && y >= 856.0 && y <= 891.0 && editor.selectedNote >= 0
        true => Success(value = SetVelocity(value = TimelineGeometry::fader (x, 1154.0, 262.0, 0.0, 1.0)))
        false => match track editor
            Success voice =>
                notes = shown (editor, voice)
                high = pitchTop notes
                rows = pitchRows (notes, high)
                index = ui::Lists::position (voice.notes, \note => hitNote (editor, rollStart editor, high, rows, x, y, note))
                // [DAW-ROLL-KEYS] A press on the keyboard beside the roll sounds that pitch through the track's patch.
                match x >= 0.0 && x < 76.0 && y >= 542.0 && y < 802.0
                    true => Success(value = Strike(note = floatToInt (TimelineGeometry::keyPitch (y, toFloat high, toFloat rows)) ?: 60))
                    false => Success(value = SelectNote(index = index))
            Error _ => Error(message = "Select a track first.")

    chosen editor = match track editor
        Error _ => []
        Success voice => listConcat (details (editor, voice)) (noteDetails (editor, captured (editor, voice)))

    (** The selected track and its current routing and note. *)
    export inspector editor = listConcat [box (1132.0, 142.0, 308.0, 767.0, panelInk (), 8), label ("TRACK INSPECTOR", 1154.0, 164.0, 12.0, dim (), 0, 9)] (chosen editor)

    (** Focus and accessibility bounds for the inspector faders. *)
    export inspectorAreas () = [area ("Track gain", 1154.0, 338.0, 262.0, 20.0, false), area ("Track pan", 1154.0, 397.0, 262.0, 20.0, false), area ("Show output routing", 1154.0, 518.0, 262.0, 36.0, false)]

    (** The whole Timeline page. *)
    export shapes editor = listConcat (arrangement (editor, beats editor)) (ui::Lists::flatten [roll editor, inspector editor, RoutingPicker::shapes editor])

(** [DAW-PIANO-DRAG] The pressed note owns the pointer until release, even across neighbouring stems. *)
module RollEdits
    (** Invalidate the scene when a captured note preview changes. *)
    export stamp drag = match drag
        RollIdle => ""
        RollHeld motion => "${motion.preview.pitch} ${motion.preview.start} ${motion.preview.velocity}"

    (** Capture the selected note and the scale under the press. *)
    export start (editor, index, x, y) = match listGet editor.song.tracks editor.track
        Error _ => ui::Runtime::step editor
        Success track => match listGet track.notes index
            Error _ => ui::Runtime::step (editor(selectedNote = -1, rollDrag = RollIdle))
            Success original =>
                motion = RollMotion(anchorX = x, anchorY = y, rowSize = TimelineView::rowSize (editor, track), stem = y >= 815.0, original = original, preview = original)
                ui::Runtime::step (editor(selectedNote = index, rollDrag = RollHeld(motion = motion)))

    shifted (editor, motion: RollMotion, x, y) =
        note = motion.original
        match abs (x - motion.anchorX) < 2.0 && abs (y - motion.anchorY) < 2.0
            true => note
            false => match motion.stem
                true => note(velocity = TimelineGeometry::stemVelocity y)
                false => note(start = TimelineGeometry::draggedStart (note.start, x - motion.anchorX, DawSession::measure editor.song), pitch = floatToInt (TimelineGeometry::draggedPitch (toFloat note.pitch, motion.anchorY - y, motion.rowSize)) ?: note.pitch)

    (** Preview pointer movement and publish one project edit on release. *)
    export pointer (editor, motion: RollMotion, x, y, down) =
        note = shifted (editor, motion, x, y)
        match down
            true => ui::Runtime::step (editor(rollDrag = RollHeld(motion = motion(preview = note))))
            false => match structuralEquals (motion.original, note)
                true => ui::Runtime::step (editor(rollDrag = RollIdle))
                false => DawSession::dragged (editor(rollDrag = RollIdle), motion, note)
