// [DAW-PAGES] The timeline: every track's lane, the selected track's piano roll and its inspector.
namespace synth

import ui::Scenes

(** Scene shapes shared by the daw's pages, and the Timeline page itself. *)
module TimelineView
    (** Text with its left (0), centre (1) or right (2) edge at x. *)
    export label (words, x, y, size, colour, anchor, depth) = Scenes::lettering (words, x, y, size, colour, anchor, 500.0, depth)

    (** A rectangle by its top-left corner. *)
    export box (left, top, width, height, colour, depth) = Scenes::rect (left + width / 2.0, top + height / 2.0, width, height, 0.0, colour, depth)

    (** A hit area by its top-left corner. *)
    export area (name, left, top, width, height, selected) = EditorView::accessible (name, left, top, width, height, selected)

    (** The main text colour. *)
    export ink () = Scenes::rgb (240, 236, 255)
    (** Secondary text and rule colour. *)
    export dim () = Scenes::rgb (150, 140, 190)
    (** Orange used for selected tracks and signal flow. *)
    export accent () = Scenes::rgb (255, 132, 66)
    (** Colour for inactive track data. *)
    export lavender () = Scenes::rgb (170, 158, 230)
    (** The track inspector background. *)
    export panelInk () = Scenes::rgb (24, 20, 44)

    names = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"]

    (** A MIDI pitch's name, middle C (60) as C4. *)
    export noteName pitch = "${listGet names (pitch % 12) ?: "?"}${satSub (intDiv pitch 12) 1}"

    (** An instrument's kind as the timeline names it. *)
    export instrumentName instrument = match instrument
        daw::PatchInstrument _ => "Patch"
        daw::PluckInstrument _ _ => "Pluck"
        daw::BowInstrument _ _ _ => "Bow"
        daw::BellInstrument _ _ => "Bell"
        daw::MalletInstrument _ _ => "Mallet"
        daw::OperatorInstrument _ => "Operator"
        daw::DrumInstrument _ => "Drum"

    (** A value to two decimals. *)
    export hundredths value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${intDiv whole 100}.${ui::Pick::either (whole % 100 < 10, "0", "")}${whole % 100}"

    (** Format a normalized control value as a whole percent. *)
    export percent value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${whole}%"

    (** Pan as L, C or R and a whole percent. *)
    export pan value = match TimelineGeometry::percent value == 0.0
        true => "C"
        false => "${ui::Pick::either (value < 0.0, "L", "R")} ${percent (ui::Pick::either (value < 0.0, 0.0 - value, value))}"

    (** The header's hit areas: the page tabs, then Play and Stop ([DAW-HEADER]). *)
    export headerAreas editor = listConcat (Header::tabAreas editor) (Header::transportAreas (1412.0, 70.0, "Play", "Stop"))

    (** The page's place among the header tabs. *)
    export pageIndex page = match page
        PatchPage => 0
        TimelinePage => 1
        MixPage => 2

    (** The command behind header area `index`. *)
    export headerAction index = match index
        3 => PlaySong
        4 => StopSong
        _ => ShowPage(page = Header::tabPage index)

    tile (a, fill) = [EditorView::panel (a.accessLeft, a.accessTop, a.accessWidth, a.accessHeight, fill, 10), label (a.accessLabel, a.accessLeft + a.accessWidth / 2.0, a.accessTop + 12.0, 16.0, ink (), 1, 11)]

    // The skin's header art (logo and name) when the skin has it; a skin without it letters the name.
    brand editor = match length (PrismArt::atlas editor.skin) > 11
        true => [Scenes::sprite (11, 540.0, 33.0, 1080.0, 66.0, 0.0, Scenes::rgb (255, 255, 255), 2)]
        false => [label ("Prism", 184.0, 14.0, 24.0, ink (), 0, 3)]

    (** The page background, the header and the song strip. *)
    export frame editor = listConcat (listConcat [box (0.0, 0.0, 1536.0, 828.0, Scenes::rgb (16, 13, 33), 0), box (0.0, 0.0, 1536.0, 66.0, Scenes::rgb (17, 16, 33), 1), box (0.0, 66.0, 1536.0, 1.0, Scenes::rgb (44, 38, 72), 3), box (0.0, 112.0, 1536.0, 1.0, Scenes::rgb (44, 38, 72), 1)] (brand editor)) (listConcat (Header::tabs editor) (Header::strip editor))

    track editor = listGet editor.song.tracks editor.track

    beats editor =
        duration = daw::Arrangements::beats editor.song
        ui::Pick::either (duration < 4.0, 4.0, duration)

    rowHeight editor = TimelineGeometry::rowHeight (toFloat (length editor.song.tracks))

    // Keep full timing on the editable roll. Sample across dense scores for the whole-song overview,
    // rotating the offset so repeated patterns display their different pitches.
    overview notes = match length notes <= 64
        true => notes
        false =>
            stride = intDiv (satAdd (length notes) 63) 64
            indices = filterList (toList (range (0, length notes)), \i => i == 0 || i == satSub (length notes) 1 || i % stride == (intDiv i stride) % stride)
            foldList (indices, [], \(kept, i) =>
                match listGet notes i
                    Success note => listAppend kept note
                    Error _ => kept)

    noteTrace (voice, top, height, duration) =
        low = toFloat (lowest voice.notes)
        high = toFloat (highest voice.notes)
        ui::Lists::flatten (mapList (overview voice.notes, \note => segment (top, height, duration, low, high, note)))

    segment (top, height, duration, low, high, note: daw::Note) =
        left = TimelineGeometry::laneX (note.start, duration)
        right = TimelineGeometry::laneX (note.start + note.length, duration)
        y = TimelineGeometry::lanePitch (top, height, toFloat note.pitch, low, high)
        [ui::MoveTo(toX = left, toY = y), ui::LineTo(toX = ui::Pick::either (right < left + 1.0, left + 1.0, right), toY = y)]

    (** Cache song-wide pitch traces on open. Selecting a note or moving a fader only changes the overlay. *)
    export traces song =
        height = TimelineGeometry::rowHeight (toFloat (length song.tracks))
        duration = daw::Arrangements::beats song
        mapList (toList (range (0, length song.tracks)), \i =>
            match listGet song.tracks i
                Error _ => []
                Success voice => noteTrace (voice, TimelineGeometry::rowY (toFloat i, height), height, ui::Pick::either (duration < 4.0, 4.0, duration)))

    traceShape (steps, colour) = Scenes::path (steps, ui::Line(width = 1.7, dashes = [], bevel = false), ui::Solid(tint = Scenes::hex (shiftRight colour 8, 1.0)), 4)

    lane (editor, index, voice) =
        height = rowHeight editor
        top = TimelineGeometry::rowY (toFloat index, height)
        chosen = index == editor.track
        colour = ui::Pick::either (chosen, accent (), lavender ())
        size = ui::Pick::either (height < 18.0, height - 5.0, 13.0)
        [box (0.0, top, 1210.0, height - 1.0, ui::Pick::either (chosen, Scenes::rgb (58, 34, 46), ui::Pick::either (index % 2 == 0, Scenes::rgb (20, 17, 38), Scenes::rgb (17, 14, 34))), 2), label ("${satAdd index 1}", 24.0, top + 3.0, size, dim (), 0, 3), label (voice.name, 52.0, top + 3.0, size, ui::Pick::either (chosen, ink (), lavender ()), 0, 3), label (instrumentName voice.instrument, 150.0, top + 3.0, size, dim (), 0, 3), traceShape (listGet editor.laneTraces index ?: [], colour)]

    ruler duration = ui::Lists::flatten (mapList (toList (range (0, satAdd (DawSession::bar duration) 1)), \at =>
        x = TimelineGeometry::laneX (TimelineGeometry::barStart (toFloat at), duration)
        major = at % 4 == 0
        line = box (x, 140.0, 1.0, 336.0, ui::Pick::either (major, Scenes::rgb (54, 46, 73), Scenes::rgb (36, 30, 52)), 3)
        tick = box (x, 136.0, 1.0, ui::Pick::either (major, 8.0, 4.0), dim (), 4)
        match major
            true => [line, tick, label ("${satAdd at 1}", x, 124.0, 11.0, dim (), 0, 4)]
            false => [line, tick]))

    viewport (editor, duration) =
        left = TimelineGeometry::laneX (rollStart editor, duration)
        right = TimelineGeometry::laneX (rollStart editor + 8.0, duration)
        [Scenes::strip ([left, 142.0, right, 142.0, right, 476.0, left, 476.0, left, 142.0], accent (), 2.0, 6)]

    arrangement (editor, duration) = listConcat (listConcat [label ("TRACKS", 24.0, 124.0, 12.0, dim (), 0, 3), label ("VOICE", 150.0, 124.0, 12.0, dim (), 0, 3)] (ruler duration)) (listConcat (foldList (toList (range (0, length editor.song.tracks)), [], \(all, index) =>
        match listGet editor.song.tracks index
            Error _ => all
            Success voice => listConcat all (lane (editor, index, voice)))) (listConcat (viewport (editor, duration)) (playhead (editor, duration))))

    // [DAW-TRANSPORT-PLAYHEAD] Where Start plays from: a line down the lanes with its handle on the ruler; the piano roll names the bars.
    playhead (editor, duration) =
        at = TimelineGeometry::laneX (rollStart editor, duration)
        [box (at - 1.0, 120.0, 2.0, 356.0, ink (), 7), box (at - 5.0, 116.0, 10.0, 8.0, ink (), 7)]

    (** Every lane's hit area: a tap picks the track at that bar; its name opens the patch. *)
    export laneAt (editor, x, y) =
        row = floatToInt (TimelineGeometry::rowAt (y, rowHeight editor)) ?: -1
        match row >= 0 && row < length editor.song.tracks && y >= 146.0
            false => rulerAt (editor, x, y)
            true => match x < 230.0
                true => Success(value = OpenTrack(index = row))
                false => Success(value = PickTrack(index = row, bar = barAt (editor, x)))

    // The bar under `x`, kept inside the song so Play always has music under it.
    barAt (editor, x) = floatToInt (TimelineGeometry::playableBar (TimelineGeometry::laneBeat (x, beats editor), beats editor)) ?: 0

    // [DAW-TRANSPORT-PLAYHEAD] A tap on the ruler moves the playhead to that bar and keeps the track.
    rulerAt (editor, x, y) = match y >= 112.0 && y < 146.0 && x >= 230.0 && x <= 1200.0
        true => Success(value = PickTrack(index = editor.track, bar = barAt (editor, x)))
        false => Error(message = "No lane here.")

    (** Accessibility regions for the arrangement track rows. *)
    export laneAccess editor = mapList (toList (range (0, length editor.song.tracks)), \index => area ("Track ${satAdd index 1}", 0.0, TimelineGeometry::rowY (toFloat index, rowHeight editor), 1210.0, rowHeight editor, index == editor.track))

    rollStart editor = TimelineGeometry::barStart (toFloat editor.rollBar)

    playing (editor, note: daw::Note) = note.start + note.length > rollStart editor && note.start < rollStart editor + 8.0

    shown (editor, voice) = filterList (voice.notes, \note => playing (editor, note))

    lowest notes = foldList (notes, 127, \(low, note: daw::Note) => ui::Pick::either (note.pitch < low, note.pitch, low))

    highest notes = foldList (notes, 0, \(high, note: daw::Note) => ui::Pick::either (note.pitch > high, note.pitch, high))

    // `start` and `length` name fields of several records, so the note's type is stated.
    rollNote (first, high, rows, chosen, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first)
        width = TimelineGeometry::rollWidth (note.start, note.length, first)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match chosen
            true => Scenes::rgb (255, 211, 158)
            false => ui::Pick::either (note.velocity >= 0.7, accent (), Scenes::rgb (191, 125, 82))
        shape = box (left, top + 1.0, width, ui::Pick::either (height > 3.0, height - 2.0, 1.0), colour, 7)
        stem = TimelineGeometry::velocityHeight note.velocity
        stemColour = ui::Pick::either (chosen, Scenes::rgb (255, 219, 122), accent ())
        markers = [shape, box (left, 810.0 - stem, 2.5, stem, stemColour, 7), Scenes::disc (left + 1.0, 810.0 - stem, 2.8, stemColour, 8)]
        match width >= 23.0 && height >= 8.0
            true => listAppend markers (label (noteName note.pitch, left + 4.0, top + 1.0, ui::Pick::either (height > 16.0, 12.0, height - 2.0), Scenes::rgb (40, 20, 10), 0, 8))
            false => markers

    blackKey pitch = match pitch % 12
        1 => true
        3 => true
        6 => true
        8 => true
        10 => true
        _ => false

    keyRow (high, rows, row) =
        pitch = satSub high row
        top = TimelineGeometry::pitchY (toFloat pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match blackKey pitch
            true => Scenes::rgb (18, 15, 34)
            false => Scenes::rgb (25, 21, 45)
        stripe = box (70.0, top, 1130.0, height, colour, 4)
        ivory = box (0.0, top, 68.0, height, Scenes::rgb (227, 224, 244), 4)
        match blackKey pitch
            true => [stripe, ivory, box (0.0, top, 44.0, height, Scenes::rgb (40, 33, 61), 5)]
            false => match pitch % 12 == 0
                true => [stripe, ivory, label (noteName pitch, 65.0, top, ui::Pick::either (height >= 13.0, 11.0, height), panelInk (), 2, 6)]
                false => [stripe, ivory]

    pianoKeys (high, rows) = foldList (toList (range (0, rows)), [], \(all, row) => listConcat all (keyRow (high, rows, row)))

    beatLines editor = mapList (toList (range (0, 33)), \step =>
        x = TimelineGeometry::rollX (rollStart editor + toFloat step / 4.0, rollStart editor)
        box (x, 520.0, ui::Pick::either (step % 16 == 0, 2.0, 1.0), 230.0, ui::Pick::either (step % 4 == 0, Scenes::rgb (59, 50, 82), Scenes::rgb (34, 29, 52)), 5))

    bars editor = mapList (toList (range (0, 8)), \beat => label ("${satAdd (satAdd editor.rollBar (intDiv beat 4)) 1}.${satAdd (beat % 4) 1}", TimelineGeometry::rollX (rollStart editor + toFloat beat, rollStart editor) + 4.0, 502.0, 11.0, dim (), 0, 5))

    pitchTop notes = match notes
        [] => 72
        _ => ui::Pick::either (highest notes >= 127, 127, satAdd (highest notes) 1)

    pitchRows (notes, high) = match notes
        [] => 13
        _ =>
            span = satAdd (satSub high (lowest notes)) 2
            ui::Pick::either (span < 13, 13, span)

    selected (editor, voice, note) = match listGet voice.notes editor.selectedNote
        Error _ => false
        Success picked => structuralEquals (note, picked)

    roll editor = match track editor
        Error _ => [label ("Open a song to see its tracks.", 24.0, 500.0, 18.0, dim (), 0, 3)]
        Success voice =>
            notes = shown (editor, voice)
            high = pitchTop notes
            rows = pitchRows (notes, high)
            heading = [label ("VELOCITY", 8.0, 758.0, 10.0, dim (), 0, 5), label ("0–1", 28.0, 789.0, 10.0, dim (), 0, 5), box (0.0, 751.0, 1210.0, 1.0, Scenes::rgb (50, 42, 70), 4), box (70.0, 810.0, 1130.0, 1.0, dim (), 4), label ("Piano roll", 24.0, 484.0, 18.0, ink (), 0, 3), label ("${voice.name} · ${length notes} of ${length voice.notes} notes in bars ${satAdd editor.rollBar 1}–${satAdd editor.rollBar 2}", 160.0, 487.0, 14.0, accent (), 0, 3)]
            listConcat (listConcat heading (listConcat (pianoKeys (high, rows)) (listConcat (beatLines editor) (bars editor)))) (foldList (notes, [], \(all, note) => listConcat all (rollNote (rollStart editor, high, rows, selected (editor, voice, note), note))))

    (** The empty dry destination in a project is the direct Master input. *)
    export destination voice = ui::Pick::either (voice.bus == "", "Master", voice.bus)

    fact (name, value, top) = [label (name, 1236.0, top, 14.0, dim (), 0, 9), label (value, 1514.0, top, 14.0, ink (), 2, 9)]

    section (name, top) = [box (1236.0, top, 276.0, 1.0, Scenes::rgb (53, 45, 72), 8), label (name, 1236.0, top + 12.0, 11.0, dim (), 0, 9)]

    fader (name, value, unit, maximum, top) =
        width = TimelineGeometry::meter (unit, maximum, 276.0)
        listConcat (fact (name, value, top)) [box (1236.0, top + 24.0, 276.0, 3.0, Scenes::rgb (61, 52, 84), 9), box (1236.0, top + 24.0, width, 3.0, accent (), 10), Scenes::disc (1236.0 + width, top + 25.5, 4.0, accent (), 10)]

    details (editor, voice) = ui::Lists::flatten [
        [label (voice.name, 1236.0, 150.0, 26.0, ink (), 0, 9), label ("Track ${satAdd editor.track 1}    ·    ${instrumentName voice.instrument} instrument", 1236.0, 185.0, 13.0, dim (), 0, 9)],
        section ("MIX", 213.0), fader ("Gain", "${hundredths voice.gain}×", voice.gain, 4.0, 247.0),
        fader ("Pan", pan voice.pan, voice.pan + 1.0, 2.0, 292.0), section ("BUS ROUTING", 343.0),
        fact ("Output", destination voice, 377.0), fader ("Space send", percent voice.reverb, voice.reverb, 1.0, 423.0),
        [label ("Post-gain · pre-pan", 1236.0, 458.0, 11.0, dim (), 0, 9)]]

    (** The track inspector writes its controls through the same checked mixer action as the routing table. *)
    export inspectorAt (editor, x, y) = match track editor
        Error _ => Error(message = "Select a track first.")
        Success voice => match x >= 1236.0 && x <= 1512.0
            false => Error(message = "No control here.")
            true => match y >= 263.0 && y <= 283.0
                true => Success(value = AdjustMix(index = editor.track, gain = TimelineGeometry::fader (x, 1236.0, 276.0, 0.0, 4.0), pan = voice.pan, reverb = voice.reverb))
                false => match y >= 308.0 && y <= 328.0
                    true => Success(value = AdjustMix(index = editor.track, gain = voice.gain, pan = TimelineGeometry::fader (x, 1236.0, 276.0, -1.0, 1.0), reverb = voice.reverb))
                    false => match y >= 439.0 && y <= 459.0
                        true => Success(value = AdjustMix(index = editor.track, gain = voice.gain, pan = voice.pan, reverb = TimelineGeometry::fader (x, 1236.0, 276.0, 0.0, 1.0)))
                        false => Error(message = "No control here.")

    noteDetails (editor, voice) = match listGet voice.notes editor.selectedNote
        Error _ => []
        Success note => listConcat (listConcat (listConcat (section ("SELECTED NOTE", 479.0)) (fact ("Pitch", noteName note.pitch, 522.0))) (fact ("Start (beats)", hundredths note.start, 555.0))) (listConcat (fact ("Length (beats)", hundredths note.length, 588.0)) (listConcat (fact ("Velocity", percent note.velocity, 631.0)) [box (1236.0, 665.0, 276.0, 5.0, dim (), 9), box (1236.0, 665.0, TimelineGeometry::meter (note.velocity, 1.0, 276.0), 5.0, accent (), 10)]))

    hitNote (first, high, rows, x, y, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first)
        right = TimelineGeometry::rollX (note.start + note.length, first)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        inside = y >= top && y < top + TimelineGeometry::pitchHeight (toFloat rows) && x >= left && x <= right
        right > left && (inside || y >= 758.0 && y <= 811.0 && x >= left - 3.0 && x <= left + 4.0)

    (** Hit-test notes and velocity stems against the same clipped positions used to draw them. *)
    export rollAt (editor, x, y) = match x >= 1236.0 && x <= 1512.0 && y >= 650.0 && y <= 687.0 && editor.selectedNote >= 0
        true => Success(value = SetVelocity(value = TimelineGeometry::fader (x, 1236.0, 276.0, 0.0, 1.0)))
        false => match track editor
            Success voice =>
                notes = shown (editor, voice)
                high = pitchTop notes
                rows = pitchRows (notes, high)
                index = ui::Lists::position (voice.notes, \note => hitNote (rollStart editor, high, rows, x, y, note))
                Success(value = SelectNote(index = index))
            Error _ => Error(message = "Select a track first.")

    chosen editor = match track editor
        Error _ => []
        Success voice => listConcat (details (editor, voice)) (noteDetails (editor, voice))

    (** The selected track and its current routing and note. *)
    export inspector editor = listConcat [box (1220.0, 113.0, 316.0, 715.0, panelInk (), 8), label ("TRACK INSPECTOR", 1236.0, 128.0, 12.0, dim (), 0, 9)] (chosen editor)

    (** Focus and accessibility bounds for the inspector faders. *)
    export inspectorAreas () = [area ("Track gain", 1236.0, 263.0, 276.0, 20.0, false), area ("Track pan", 1236.0, 308.0, 276.0, 20.0, false), area ("Track Space send", 1236.0, 439.0, 276.0, 20.0, false)]

    (** The whole Timeline page. *)
    export shapes editor = listConcat (listConcat (frame editor) (arrangement (editor, beats editor))) (listConcat (roll editor) (inspector editor))
