// [DAW-PAGES] The timeline: every track's lane, the selected track's piano roll and its inspector.
namespace synth

import ui::Scenes

(** Scene shapes shared by the daw's pages, and the Timeline page itself. *)
module TimelineView
    (** Text with its left (0), centre (1) or right (2) edge at x. *)
    export label (words, x, y, size, colour, anchor, depth) = Scenes::lettering (words, x, y, size, colour, anchor, 500.0, depth)

    (** A rectangle by its top-left corner. *)
    export box (left, top, width, height, colour, depth) = Scenes::rect (left + width / 2.0, top + height / 2.0, width, height, 0.0, colour, depth)

    (** A hit area by its top-left corner. *)
    export area (name, left, top, width, height, selected) = EditorView::accessible (name, left, top, width, height, selected)

    (** The main text colour. *)
    export ink () = Scenes::rgb (240, 236, 255)
    (** Secondary text and rule colour. *)
    export dim () = Scenes::rgb (150, 140, 190)
    (** Orange used for selected tracks and signal flow. *)
    export accent () = Scenes::rgb (255, 132, 66)
    (** Colour for inactive track data. *)
    export lavender () = Scenes::rgb (170, 158, 230)
    (** The track inspector background. *)
    export panelInk () = Scenes::rgb (24, 20, 44)

    names = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"]

    (** A MIDI pitch's name, middle C (60) as C4. *)
    export noteName pitch = "${listGet names (pitch % 12) ?: "?"}${satSub (intDiv pitch 12) 1}"

    (** An instrument's kind as the timeline names it. *)
    export instrumentName instrument = match instrument
        daw::PatchInstrument _ => "Patch"
        daw::PluckInstrument _ _ => "Pluck"
        daw::BowInstrument _ _ _ => "Bow"
        daw::BellInstrument _ _ => "Bell"
        daw::MalletInstrument _ _ => "Mallet"
        daw::OperatorInstrument _ => "Operator"
        daw::DrumInstrument _ => "Drum"

    (** A value to two decimals. *)
    export hundredths value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${intDiv whole 100}.${ui::Pick::either (whole % 100 < 10, "0", "")}${whole % 100}"

    (** Format a normalized control value as a whole percent. *)
    export percent value =
        whole = floatToInt (TimelineGeometry::percent value) ?: 0
        "${whole}%"

    (** Pan as L, C or R and a whole percent. *)
    export pan value = match TimelineGeometry::percent value == 0.0
        true => "C"
        false => "${ui::Pick::either (value < 0.0, "L", "R")} ${percent (ui::Pick::either (value < 0.0, 0.0 - value, value))}"

    tabs = ["Patch", "Timeline", "Mix"]
    buttons = ["Open song", "Play", "Render song", "Stop"]

    (** The header's tabs and transport, left to right; their hit areas are `headerAreas`. *)
    export headerAreas editor = listConcat (listConcat (mapList (toList (range (0, 3)), \i => area (listGet tabs i ?: "", 360.0 + toFloat i * 130.0, 10.0, 120.0, 45.0, i == pageIndex editor.page))) (mapList (toList (range (0, 4)), \i => area (listGet buttons i ?: "", 1025.0 + toFloat i * 122.0, 10.0, 115.0, 45.0, false)))) [area ("Save project", 895.0, 10.0, 120.0, 45.0, false), area ("Keyboard", 765.0, 10.0, 120.0, 45.0, editor.keyboardShown)]

    (** The page's place among the header tabs. *)
    export pageIndex page = match page
        PatchPage => 0
        TimelinePage => 1
        MixPage => 2

    (** The command behind header area `index`. *)
    export headerAction index = match index
        0 => ShowPage(page = PatchPage)
        1 => ShowPage(page = TimelinePage)
        2 => ShowPage(page = MixPage)
        3 => OpenTrack(index = -2)
        4 => PlaySong
        5 => RenderSong
        7 => SaveProject
        8 => ShowKeyboard
        _ => StopSong

    // [DAW-TRANSPORT] Play and Stop are the transport, green and red, never mistaken for the page tabs.
    fillOf a = match a.accessLabel
        "Play" => 2067035
        "Stop" => 11546684
        _ => ui::Pick::either (a.accessSelected, 4004714, 2163246)

    tile (a, fill) = [EditorView::panel (a.accessLeft, a.accessTop, a.accessWidth, a.accessHeight, fill, 10), label (a.accessLabel, a.accessLeft + a.accessWidth / 2.0, a.accessTop + 12.0, 16.0, ink (), 1, 11)]

    status editor = DawSession::phase editor

    (** The page background, header and song strip. *)
    export frame (editor, subtitle) = listConcat [box (0.0, 0.0, 1536.0, 828.0, Scenes::rgb (16, 13, 33), 0), box (0.0, 0.0, 1536.0, 66.0, Scenes::rgb (21, 17, 40), 1), label ("Prism", 110.0, 10.0, 24.0, ink (), 0, 3), label (subtitle, 110.0, 40.0, 13.0, dim (), 0, 3), label (editor.song.title, 24.0, 76.0, 22.0, ink (), 0, 3), label ("${hundredths editor.song.tempo} BPM · 4/4 · ${length editor.song.tracks} tracks · ${status editor}", 1510.0, 72.0, 14.0, dim (), 2, 3), label (editor.message, 1510.0, 92.0, 13.0, accent (), 2, 3), box (0.0, 112.0, 1536.0, 1.0, Scenes::rgb (44, 38, 72), 1)] (foldList (headerAreas editor, [], \(all, a) => listConcat all (tile (a, fillOf a))))

    track editor = listGet editor.song.tracks editor.track

    beats editor =
        duration = daw::Arrangements::beats editor.song
        ui::Pick::either (duration < 4.0, 4.0, duration)

    rowHeight editor = TimelineGeometry::rowHeight (toFloat (length editor.song.tracks))

    // The bars a track plays in, once each, from notes in time order.
    played notes = foldList (notes, [], \(found, note: daw::Note) =>
        at = DawSession::bar note.start
        match (listGet found (satSub (length found) 1) ?: -1) == at
            true => found
            false => listAppend found at)

    lane (editor, index, voice, duration) =
        height = rowHeight editor
        top = TimelineGeometry::rowY (toFloat index, height)
        chosen = index == editor.track
        colour = ui::Pick::either (chosen, accent (), lavender ())
        cells = mapList (played voice.notes, \at => box (TimelineGeometry::laneX (TimelineGeometry::barStart (toFloat at), duration) + 1.0, top + height * 0.3, TimelineGeometry::meter (4.0, duration, 970.0) - 2.0, height * 0.4, colour, 4))
        size = ui::Pick::either (height < 18.0, height - 5.0, 13.0)
        listConcat [box (0.0, top, 1210.0, height - 1.0, ui::Pick::either (chosen, Scenes::rgb (58, 34, 46), ui::Pick::either (index % 2 == 0, Scenes::rgb (20, 17, 38), Scenes::rgb (17, 14, 34))), 2), label ("${satAdd index 1}", 24.0, top + 3.0, size, dim (), 0, 3), label (voice.name, 52.0, top + 3.0, size, ui::Pick::either (chosen, ink (), lavender ()), 0, 3), label (instrumentName voice.instrument, 150.0, top + 3.0, size, dim (), 0, 3)] cells

    ruler duration = foldList (toList (range (0, satAdd (DawSession::bar (duration)) 1)), [], \(all, at) =>
        match at % 4 == 0
            false => all
            true => listConcat all [label ("${satAdd at 1}", TimelineGeometry::laneX (TimelineGeometry::barStart (toFloat at), duration), 124.0, 12.0, dim (), 0, 3), box (TimelineGeometry::laneX (TimelineGeometry::barStart (toFloat at), duration), 140.0, 1.0, 336.0, Scenes::rgb (40, 34, 66), 3)])

    viewport (editor, duration) =
        left = TimelineGeometry::laneX (rollStart editor, duration)
        right = TimelineGeometry::laneX (rollStart editor + 8.0, duration)
        [Scenes::strip ([left, 142.0, right, 142.0, right, 476.0, left, 476.0, left, 142.0], accent (), 2.0, 6)]

    arrangement (editor, duration) = listConcat (listConcat [label ("TRACKS", 24.0, 124.0, 12.0, dim (), 0, 3), label ("VOICE", 150.0, 124.0, 12.0, dim (), 0, 3)] (ruler duration)) (listConcat (foldList (toList (range (0, length editor.song.tracks)), [], \(all, index) =>
        match listGet editor.song.tracks index
            Error _ => all
            Success voice => listConcat all (lane (editor, index, voice, duration)))) (listConcat (viewport (editor, duration)) (playhead (editor, duration))))

    // [DAW-TRANSPORT-PLAYHEAD] Where Start plays from: a line down the lanes with its handle on the ruler; the piano roll names the bars.
    playhead (editor, duration) =
        at = TimelineGeometry::laneX (rollStart editor, duration)
        [box (at - 1.0, 120.0, 2.0, 356.0, ink (), 7), box (at - 5.0, 116.0, 10.0, 8.0, ink (), 7)]

    (** Every lane's hit area: a tap picks the track at that bar; its name opens the patch. *)
    export laneAt (editor, x, y) =
        row = floatToInt (TimelineGeometry::rowAt (y, rowHeight editor)) ?: -1
        match row >= 0 && row < length editor.song.tracks && y >= 146.0
            false => rulerAt (editor, x, y)
            true => match x < 230.0
                true => Success(value = OpenTrack(index = row))
                false => Success(value = PickTrack(index = row, bar = barAt (editor, x)))

    // The bar under `x`, kept inside the song so Play always has music under it.
    barAt (editor, x) = floatToInt (TimelineGeometry::playableBar (TimelineGeometry::laneBeat (x, beats editor), beats editor)) ?: 0

    // [DAW-TRANSPORT-PLAYHEAD] A tap on the ruler moves the playhead to that bar and keeps the track.
    rulerAt (editor, x, y) = match y >= 112.0 && y < 146.0 && x >= 230.0 && x <= 1200.0
        true => Success(value = PickTrack(index = editor.track, bar = barAt (editor, x)))
        false => Error(message = "No lane here.")

    (** Accessibility regions for the arrangement track rows. *)
    export laneAccess editor = mapList (toList (range (0, length editor.song.tracks)), \index => area ("Track ${satAdd index 1}", 0.0, TimelineGeometry::rowY (toFloat index, rowHeight editor), 1210.0, rowHeight editor, index == editor.track))

    rollStart editor = TimelineGeometry::barStart (toFloat editor.rollBar)

    playing (editor, note: daw::Note) = note.start + note.length > rollStart editor && note.start < rollStart editor + 8.0

    shown (editor, voice) = filterList (voice.notes, \note => playing (editor, note))

    lowest notes = foldList (notes, 127, \(low, note: daw::Note) => ui::Pick::either (note.pitch < low, note.pitch, low))

    highest notes = foldList (notes, 0, \(high, note: daw::Note) => ui::Pick::either (note.pitch > high, note.pitch, high))

    // `start` and `length` name fields of several records, so the note's type is stated.
    rollNote (first, high, rows, chosen, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first)
        width = TimelineGeometry::rollWidth (note.start, note.length, first)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match chosen
            true => 16767866
            false => ui::Pick::either (note.velocity >= 0.7, 16745538, 13789239)
        shape = EditorView::panel (left, top + 1.0, width, height - 2.0, colour, 7)
        stem = TimelineGeometry::velocityHeight note.velocity
        stemColour = ui::Pick::either (chosen, Scenes::rgb (255, 219, 122), accent ())
        markers = [shape, box (left, 810.0 - stem, 2.5, stem, stemColour, 7), Scenes::disc (left + 1.0, 810.0 - stem, 2.8, stemColour, 8)]
        match width > 36.0 && height > 11.0
            true => listAppend markers (label (noteName note.pitch, left + 4.0, top + 1.0, ui::Pick::either (height > 16.0, 12.0, height - 2.0), Scenes::rgb (40, 20, 10), 0, 8))
            false => markers

    blackKey pitch = match pitch % 12
        1 => true
        3 => true
        6 => true
        8 => true
        10 => true
        _ => false

    keyRow (high, rows, row) =
        pitch = satSub high row
        top = TimelineGeometry::pitchY (toFloat pitch, toFloat high, toFloat rows)
        height = TimelineGeometry::pitchHeight (toFloat rows)
        colour = match blackKey pitch
            true => Scenes::rgb (18, 15, 34)
            false => Scenes::rgb (25, 21, 45)
        stripe = box (70.0, top, 1130.0, height, colour, 4)
        match pitch % 12 == 0
            true => [stripe, label (noteName pitch, 24.0, top, ui::Pick::either (height >= 14.0, 12.0, height), dim (), 0, 5)]
            false => [stripe]

    pianoKeys (high, rows) = foldList (toList (range (0, rows)), [], \(all, row) => listConcat all (keyRow (high, rows, row)))

    beatLines editor = mapList (toList (range (0, 9)), \beat => box (TimelineGeometry::rollX (rollStart editor + toFloat beat, rollStart editor), 520.0, ui::Pick::either (beat % 4 == 0, 2.0, 1.0), 230.0, Scenes::rgb (48, 42, 80), 5))

    bars editor = mapList (toList (range (0, 2)), \at => label ("Bar ${satAdd (satAdd editor.rollBar at) 1}", TimelineGeometry::rollX (rollStart editor + TimelineGeometry::barStart (toFloat at), rollStart editor) + 4.0, 500.0, 12.0, dim (), 0, 5))

    pitchTop voice = match voice.notes
        [] => 72
        _ => satAdd (highest voice.notes) 1

    pitchRows (voice, high) =
        span = satAdd (satSub high (lowest voice.notes)) 2
        ui::Pick::either (span < 13, 13, span)

    selected (editor, voice, note) = match listGet voice.notes editor.selectedNote
        Error _ => false
        Success picked => structuralEquals (note, picked)

    roll editor = match track editor
        Error _ => [label ("Open a song to see its tracks.", 24.0, 500.0, 18.0, dim (), 0, 3)]
        Success voice =>
            notes = shown (editor, voice)
            high = pitchTop voice
            rows = pitchRows (voice, high)
            heading = [label ("Velocity", 14.0, 769.0, 12.0, dim (), 0, 5), box (70.0, 810.0, 1130.0, 1.0, dim (), 4), label ("Piano roll", 24.0, 484.0, 18.0, ink (), 0, 3), label ("${voice.name} · ${length notes} of ${length voice.notes} notes in bars ${satAdd editor.rollBar 1}–${satAdd editor.rollBar 2}", 160.0, 487.0, 14.0, accent (), 0, 3)]
            listConcat (listConcat heading (listConcat (pianoKeys (high, rows)) (listConcat (beatLines editor) (bars editor)))) (foldList (notes, [], \(all, note) => listConcat all (rollNote (rollStart editor, high, rows, selected (editor, voice, note), note))))

    fact (name, value, top) = [label (name, 1236.0, top, 14.0, dim (), 0, 9), label (value, 1514.0, top, 14.0, ink (), 2, 9)]

    (** The selected track's inspector; its Open patch button is `openArea`. *)
    details (editor, voice) = listConcat (listConcat [label (voice.name, 1236.0, 152.0, 28.0, ink (), 0, 9), label ("Track ${satAdd editor.track 1} · ${instrumentName voice.instrument} instrument", 1236.0, 192.0, 13.0, dim (), 0, 9)] (listConcat (listConcat (fact ("Gain", "${hundredths voice.gain}×", 236.0)) (fact ("Pan", pan voice.pan, 266.0))) (listConcat (listConcat (fact ("Space send", percent voice.reverb, 296.0)) (fact ("Output", "Master", 326.0))) (fact ("Notes", "${length voice.notes}", 356.0))))) (tile (openArea (), 4004714))

    noteDetails (editor, voice) = match listGet voice.notes editor.selectedNote
        Error _ => []
        Success note => listConcat (listConcat (fact ("Note", noteName note.pitch, 522.0)) (fact ("Start (beats)", hundredths note.start, 555.0))) (listConcat (fact ("Length (beats)", hundredths note.length, 588.0)) (listConcat (fact ("Velocity", percent note.velocity, 631.0)) [box (1236.0, 665.0, 276.0, 5.0, dim (), 9), box (1236.0, 665.0, TimelineGeometry::meter (note.velocity, 1.0, 276.0), 5.0, accent (), 10)]))

    hitNote (first, high, rows, x, y, note: daw::Note) =
        left = TimelineGeometry::rollX (note.start, first)
        right = TimelineGeometry::rollX (note.start + note.length, first)
        top = TimelineGeometry::pitchY (toFloat note.pitch, toFloat high, toFloat rows)
        inside = y >= top && y < top + TimelineGeometry::pitchHeight (toFloat rows) && x >= left && x <= right
        right > left && (inside || y >= 758.0 && y <= 811.0 && x >= left - 3.0 && x <= left + 4.0)

    (** Hit-test notes and velocity stems against the same clipped positions used to draw them. *)
    export rollAt (editor, x, y) = match x >= 1236.0 && x <= 1512.0 && y >= 650.0 && y <= 687.0 && editor.selectedNote >= 0
        true => Success(value = SetVelocity(value = TimelineGeometry::fader (x, 1236.0, 276.0, 0.0, 1.0)))
        false => match track editor
            Success voice =>
                high = pitchTop voice
                rows = pitchRows (voice, high)
                index = ui::Lists::position (voice.notes, \note => hitNote (rollStart editor, high, rows, x, y, note))
                Success(value = SelectNote(index = index))
            Error _ => Error(message = "Select a track first.")

    chosen editor = match track editor
        Error _ => []
        Success voice => listConcat (details (editor, voice)) (noteDetails (editor, voice))

    (** The selected track's inspector; its Open patch button is `openArea`. *)
    export inspector editor = listConcat [box (1220.0, 113.0, 316.0, 715.0, panelInk (), 8), label ("TRACK INSPECTOR", 1236.0, 128.0, 12.0, dim (), 0, 9)] (chosen editor)

    (** The inspector button that opens the selected track in Prism. *)
    export openArea () = area ("Open patch", 1236.0, 400.0, 284.0, 48.0, false)

    (** The whole Timeline page. *)
    export shapes editor = listConcat (listConcat (frame (editor, "Timeline")) (arrangement (editor, beats editor))) (listConcat (roll editor) (inspector editor))
