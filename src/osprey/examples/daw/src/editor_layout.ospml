// [PRISM-ROUTING-LAYOUT] Layout belongs to the UI; moving a card never edits the audio graph.
namespace synth

(** Stable component positions and pointer capture for the modular canvas. *)
module EditorLayout
    availableRow (saved, x, row) = match ui::Lists::any (saved, \p => CanvasGeometry::collides (x, CanvasGeometry::gridY (toFloat row), p.layoutX, p.layoutY))
        true => availableRow (saved, x, satAdd row 1)
        false => row

    place (inputs, saved, held, id) =
        parents = mapGet inputs (toString id) ?: []
        depth = foldList (parents, 0, \(largest, parent) =>
            next = satAdd (mapGet held.depths (toString parent) ?: -1) 1
            ui::Pick::either (next > largest, next, largest))
        key = toString depth
        x = CanvasGeometry::signalX (toFloat depth)
        row = availableRow (saved, x, mapGet held.rows key ?: 0)
        at = daw::NodePosition(layoutNode = id, layoutX = x, layoutY = CanvasGeometry::gridY (toFloat row))
        { depths = mapSet held.depths (toString id) depth, rows = mapSet held.rows key (satAdd row 1), placed = listPrepend held.placed at }

    (** Compute default positions once on open, in the graph scheduler's dependency order. *)
    export flow (plan, saved) =
        inputs = Graphs::inputSources plan.graph.cables
        (foldList (plan.order, { depths = Map(), rows = Map(), placed = [] }, \(held, id) => place (inputs, saved, held, id))).placed

    stored (editor, identity) = match ui::Lists::find (editor.positions, \p => p.layoutNode == identity)
        Success at => at
        Error _ => ui::Lists::find (editor.flowPositions, \p => p.layoutNode == identity) ?: daw::NodePosition(layoutNode = identity, layoutX = CanvasGeometry::gridX (toFloat (identity % 3)), layoutY = CanvasGeometry::gridY (toFloat (intDiv identity 3)))

    (** Painting, socket hit testing and accessibility share the same viewport coordinates. *)
    export position (editor, identity) =
        at = stored (editor, identity)
        at(layoutX = CanvasGeometry::offset (at.layoutX, editor.panX), layoutY = CanvasGeometry::offset (at.layoutY, editor.panY))

    (** Convert a placed canvas card back to project coordinates before saving. *)
    export world (editor, at: daw::NodePosition) = at(layoutX = CanvasGeometry::shifted (at.layoutX, editor.panX), layoutY = CanvasGeometry::shifted (at.layoutY, editor.panY))

    (** Capture the viewport extent once when a background drag begins. *)
    export background (editor, x, y) = match editor.selectedCable >= 0
        true => editor
        false =>
            far = foldList (editor.graph.nodes, { x = 0.0, y = 0.0 }, \(edge, n) =>
                at = stored (editor, n.identity)
                { x = ui::Pick::either (at.layoutX > edge.x, at.layoutX, edge.x), y = ui::Pick::either (at.layoutY > edge.y, at.layoutY, edge.y) })
            editor(panning = PanHeld(lastX = far.x, lastY = far.y), grabX = x, grabY = y)

    (** Keep the graph reachable while panning without changing a single stored card. *)
    export panned (editor, x, y, down) = match editor.panning
        PanIdle => editor
        PanHeld lastX lastY => match CanvasGeometry::valid (x, y)
            false => editor(panning = PanIdle)
            true => editor(panning = ui::Pick::either (down, editor.panning, PanIdle), grabX = x, grabY = y, panX = CanvasGeometry::panOffset (editor.panX, editor.grabX, x, lastX, CanvasGeometry::gridX 0.0), panY = CanvasGeometry::panOffset (editor.panY, editor.grabY, y, lastY, CanvasGeometry::gridY 0.0))

    (** Keep the initial pointer offset so clicking away from the centre does not snap the card. *)
    export begin (editor, identity, px, py) =
        at = position (editor, identity)
        editor(selected = identity, selectedCable = -1, dragging = identity, grabX = CanvasGeometry::offset (px, at.layoutX), grabY = CanvasGeometry::offset (py, at.layoutY))

    moved (editor, px, py) =
        at = daw::NodePosition(layoutNode = editor.dragging, layoutX = CanvasGeometry::dragX (px, editor.grabX, ui::Machines::number (editor.skin, "spareWidth")), layoutY = CanvasGeometry::dragY (py, editor.grabY, ui::Machines::number (editor.skin, "spareHeight")))
        previous = position (editor, editor.dragging)
        match at.layoutX == previous.layoutX && at.layoutY == previous.layoutY
            true => editor
            false => editor(positions = listAppend (filterList (editor.positions, \p => p.layoutNode != editor.dragging)) (world (editor, at)), layoutRevision = satAdd editor.layoutRevision 1)

    (** Ignore nonfinite coordinates and release capture even when a release position is invalid. *)
    export drag (editor, px, py, down) =
        next = match CanvasGeometry::valid (px, py)
            true => moved (editor, px, py)
            false => editor
        match down
            true => next
            false => next(dragging = -1)

(** Draw the actual Prism skin from main; graph nodes supply its live inputs and positions. *)
module PrismArt
    (** The original skin role used by each processor. *)
    export role processor = match processor
        Oscillator => "source"
        Lfo => "control"
        Filter => "process"
        Amplifier => "output"
        ModulatedGain => "output"
        Sink => "monitor"
        _ => "custom"

    centreX name = match name
        "source" => 175.5
        "control" => 605.0
        "process" => 607.0
        "monitor" => 609.0
        _ => 1035.0

    centreY name = match name
        "source" => 438.5
        "control" => 161.0
        "process" => 432.0
        "monitor" => 695.0
        _ => 436.5

    refers (measure, name) = match measure
        ui::Templated value => contains value "{{${name}"
        _ => false

    belongs (mark, name) = refers (mark.markX, name) || refers (mark.markY, name) || length (filterList (mark.markPoints, \point => refers (point, name))) > 0

    owns (mark, name) = belongs (mark, name) && length (filterList (["source", "process", "control", "output", "monitor"], \other => other != name && belongs (mark, other))) == 0

    parameter (n, key, otherwise) = match synth::Graphs::parameterNamed (n, key)
        Error _ => otherwise
        Success p => p.initial

    rateName hz = match hz
        0.5 => "1/1"
        1.0 => "1/2"
        4.0 => "1/8"
        8.0 => "1/16"
        _ => "1/4"

    fact (name, value) = ui::Machines::fact (name, ui::Values::number value)

    (** Fill the original skin from one real graph node. *)
    export prepared (editor, n) =
        name = role n.processor
        at = EditorLayout::position (editor, n.identity)
        selected = match editor.selected == n.identity
            true => name
            false => ""
        skin = editor.skin
        base = match editor.selected == n.identity
            true => editor.skin
            false => skin(currents = mapList (editor.skin.currents, \current =>
                match current.currentLayer == "menu"
                    true => current(currentState = "closed")
                    false => current))
        ui::Machines::feed (base, [ui::Machines::fact ("${name}On", ui::Values::flag (parameter (n, "enabled", 1.0) == 1.0)), fact ("${name}X", at.layoutX - centreX name), fact ("${name}Y", at.layoutY - centreY name), fact ("process", CanvasGeometry::cutoffPosition (parameter (n, "cutoff", 2500.0))), fact ("volume", parameter (n, "gain", 0.5)), ui::Machines::fact ("selected", ui::Values::text selected), ui::Machines::fact ("wave", ui::Values::text (waveName (parameter (n, "waveform", 0.0)))), ui::Machines::fact ("rate", ui::Values::text (rateName (parameter (n, "frequency", 2.0))))])

    (** Expand only the requested original skin marks. *)
    export shapes (machine, accept) = movedShapes (machine, accept, 0.0)

    movedShapes (machine, accept, dy) = match (ui::Templates::skin machine).skinBoard
        ui::Unboarded => []
        ui::Boarded w h zoom atlas marks _ => match ui::Canvases::artboard (machine, zoom, w, h, atlas, mapList (filterList (marks, accept), \mark => shiftedMark (machine, mark, dy)))
            ui::Scene _ _ _ _ primitives _ _ => primitives
            _ => []

    // Preserve repeat expressions until the canvas expands them (especially the grid).
    shiftedMark (machine, mark, dy) = match dy == 0.0
        true => mark
        false => mark(markY = ui::Fixed(fixedAt = ui::Templates::measure (machine, mark.markY) + dy))

    (** Resolve the original atlas against the packaged asset folder. *)
    export atlas machine = match (ui::Templates::skin machine).skinBoard
        ui::Unboarded => []
        ui::Boarded _ _ _ paths _ _ => mapList (paths, \path => ui::Templates::fill (machine, path))

    roles = ["source", "process", "control", "output", "monitor"]

    (** Each card role's own marks, and the scenery (marks of no card), sorted once per skin: matching marks by
        their templates on every event cost most of an event's time. *)
    export classified machine = match (ui::Templates::skin machine).skinBoard
        ui::Unboarded => []
        ui::Boarded _ _ _ _ marks _ => listAppend (mapList (roles, \name => CardMarks(cardRole = name, cardMarks = filterList (marks, \mark => owns (mark, name))))) (CardMarks(cardRole = "scenery", cardMarks = filterList (marks, \mark => length (filterList (roles, \name => belongs (mark, name))) == 0)))

    // An editor made without the cache (a test's, say) sorts the marks when asked.
    roleMarks (editor, name) =
        cards = match length editor.cards == 0
            true => classified editor.skin
            false => editor.cards
        foldList (filterList (cards, \found => found.cardRole == name), [], \(_, found) => found.cardMarks)

    drawn (machine, marks) = match (ui::Templates::skin machine).skinBoard
        ui::Unboarded => []
        ui::Boarded w h zoom atlas _ _ => match ui::Canvases::artboard (machine, zoom, w, h, atlas, marks)
            ui::Scene _ _ _ _ primitives _ _ => primitives
            _ => []

    (** Only the chosen node's original artwork; cross-node wires come from the real graph. *)
    export card (editor, n) =
        drawn (prepared (editor, n), filterList (roleMarks (editor, role n.processor), \mark => !(n.processor == Sink && mark.markFigure == ui::PolylineFigure)))

    (** Original header, inspector, legend and keyboard, driven by the current selection. *)
    export background editor = mapList (backgroundPart (editor, false), \part => fixedPart (editor, part))

    fixedPart (editor, part) = match grid part
        true => part
        false => Header::placedShape (part, 0.0, 0.0, chromeLayer editor)

    grid part = match part
        ui::Sprite sprite _ _ _ _ _ _ _ => sprite == 0
        _ => false

    (** Keep fixed panels above every card when the graph pans beneath them. *)
    export chromeLayer editor = satMul (satAdd (length editor.graph.nodes) 1) 100

    (** Keyboard artwork in local dock coordinates. *)
    export deck editor = backgroundPart (editor, true)

    backgroundPart (editor, keyboard) =
        selected = match Graphs::node (editor.graph, editor.selected)
            Invalid _ => editor.skin
            Valid n => prepared (editor, n)
        bare = match Graphs::node (editor.graph, editor.selected)
            Invalid _ => true
            Valid _ => false
        machine = ui::Machines::feed (selected, [fact ("keys", 1.0), fact ("hertz", CanvasGeometry::frequency (toFloat editor.note)), ui::Machines::fact ("note", ui::Values::text (noteName editor.note))])
        dy = ui::Pick::either (keyboard, -828.0, 0.0)
        drawn (machine, mapList (filterList (roleMarks (editor, "scenery"), \mark => backgroundMark (editor, machine, mark, keyboard, bare)), \mark => shiftedMark (machine, mark, dy)))

    // `bare`: no module is selected, so the skin's own inspector (its sample Filter) is left out.
    backgroundMark (editor, machine, mark, keyboard, bare) =
        grid = mark.markFigure == ui::SpriteFigure && ui::Templates::measure (machine, mark.markIndex) == 0.0
        match grid
            true => !keyboard
            false => (ui::Templates::measure (machine, mark.markY) >= 828.0 + ui::Machines::number (machine, "spareHeight")) == keyboard && !(editor.detailsShown && !keyboard && ui::Templates::measure (machine, mark.markX) >= 1210.0) && !(bare && !keyboard && ui::Templates::measure (machine, mark.markX) >= 1210.0 && ui::Templates::measure (machine, mark.markY) >= 70.0) && !connectionMark (machine, mark)

    connectionMark (machine, mark) =
        y = ui::Templates::measure (machine, mark.markY)
        refers (mark.markX, "spareWidth") && y >= 475.0 && y < 785.0 && mark.markFigure != ui::SpriteFigure

    noteNames = ["C3", "C#3", "D3", "D#3", "E3", "F3", "F#3", "G3", "G#3", "A3", "A#3", "B3", "C4", "C#4", "D4", "D#4", "E4", "F4", "F#4", "G4", "G#4", "A4", "A#4", "B4"]

    (** Musical names match the original key labels, including accidentals. *)
    export noteName note = listGet noteNames (satSub note 48) ?: "—"

    (** Original keyboard hit boxes, rather than approximated white and black key geometry. *)
    export keyboardAccess editor = filterList (ui::Canvases::semantics (ui::Machines::feed (editor.skin, [fact ("keys", 1.0)])), \area => startsWith area.accessLabel "Play ")

    (** Decode only a key the original keyboard actually exposes. *)
    export keyAt (editor, x, y) = match listGet (filterList (keyboardAccess editor, \a => EditorView::covers (a, x, y))) 0
        Error _ => Error(message = "index out of bounds")
        Success area =>
            index = ui::Lists::position (noteNames, \name => "Play ${name}" == area.accessLabel)
            match index >= 0
                true => Success(value = satAdd index 48)
                false => Error(message = "Unknown keyboard note.")


    waveName value = match value
        1.0 => "Triangle"
        2.0 => "Saw"
        3.0 => "Square"
        _ => "Sine"

    controlName processor = match processor
        Oscillator => "Oscillator"
        Lfo => "LFO"
        Filter => "Filter"
        Sink => "Scope"
        Amplifier => "Master"
        ModulatedGain => "Master"
        _ => "!unsupported"

    supports (n, area) =
        label = area.accessLabel
        toggle = contains label (controlName n.processor) && (contains label "Bypass" || contains label "Enable")
        slider = area.accessRole == ui::Slidable && ((n.processor == Filter && contains label "Cutoff") || ((n.processor == Amplifier || n.processor == ModulatedGain) && contains label "Level"))
        menu = (n.processor == Oscillator && (startsWith label "Oscillator Wave" || length (filterList (["Sine", "Triangle", "Saw", "Square"], \wave => wave == label)) > 0)) || (n.processor == Lfo && (startsWith label "LFO Rate" || startsWith label "1/"))
        toggle || slider || menu

    (** Inspector controls stay pinned when their module moves. *)
    export inspectorArea a = startsWith a.accessLabel "Inspector"

    (** Original controls are scoped to an independently positioned graph node. *)
    export sliders (editor, n) = match role n.processor
        "custom" => []
        _ => filterList (ui::Canvases::semantics (prepared (editor, n)), \a => !inspectorArea a && supports (n, a))

    sliderAt (editor, n, px, py) = length (filterList (CardArts::controls (editor, n), \a => EditorView::covers (a, px, py))) > 0

    numberChange (editor, n, before, after, input, key, convert) = match ui::Machines::number (before, input) == ui::Machines::number (after, input)
        true => editor
        false => EditorState::typed (editor, EditParameter(identity = n.identity, key = key), "${convert (ui::Machines::number (after, input))}")

    enabledChange (editor, n, before, after) =
        input = "${role n.processor}On"
        match ui::Machines::flag (before, input) == ui::Machines::flag (after, input)
            true => editor
            false => EditorState::configured (editor, n.identity, "enabled", "Enabled", 1.0, ui::Pick::either (ui::Machines::flag (after, input), 1.0, 0.0))

    waveChange (editor, n, before, after) = match ui::Machines::text (before, "wave") == ui::Machines::text (after, "wave")
        true => editor
        false => EditorState::configured (editor, n.identity, "waveform", "Waveform", 3.0, toFloat (ui::Lists::position (["Sine", "Triangle", "Saw", "Square"], \wave => wave == ui::Machines::text (after, "wave"))))

    rateValue name = match name
        "1/1" => 0.5
        "1/2" => 1.0
        "1/8" => 4.0
        "1/16" => 8.0
        _ => 2.0

    rateChange (editor, n, before, after) = match ui::Machines::text (before, "rate") == ui::Machines::text (after, "rate")
        true => editor
        false => EditorState::typed (editor, EditParameter(identity = n.identity, key = "frequency"), "${rateValue (ui::Machines::text (after, "rate"))}")

    slide (editor, n, machine, px, py, down) =
        moved = ui::Canvases::pointer (machine, px, py, down)
        next = editor(skin = moved, selected = n.identity, layoutRevision = satAdd editor.layoutRevision 1)
        cutoff = numberChange (next, n, machine, moved, "process", "cutoff", CanvasGeometry::cutoffFrequency)
        level = numberChange (cutoff, n, machine, moved, "volume", "gain", \value => value)
        rateChange (waveChange (enabledChange (level, n, machine, moved), n, machine, moved), n, machine, moved)

    (** Original capture updates the same validated graph as the native inspector. *)
    export pointed (editor, px, py, down) = match ui::Canvases::holding editor.skin
        true => match Graphs::node (editor.graph, editor.selected)
            Invalid _ => Error(message = "The selected component was removed.")
            Valid n => Success(value = slide (editor, n, editor.skin, px, py, down))
        false => match listGet (filterList (candidates (editor, px, py), \n => frontmost (editor, n, px, py) && sliderAt (editor, n, px, py))) 0
            Error _ => Error(message = "index out of bounds")
            Success n => Success(value = slide (editor, n, prepared (editor, n), px, py, down))

    // Only the card under the pointer, or the selected node (whose inspector and open menu lie outside its
    // card), can own a control there: hit-testing every node's controls made every tap slow.
    candidates (editor, px, py) =
        top = EditorView::nodeAt (editor, px, py)
        filterList (editor.graph.nodes, \n => n.identity == top || n.identity == editor.selected)

    frontmost (editor, n, px, py) =
        top = EditorView::nodeAt (editor, px, py)
        menu = length (filterList (editor.skin.currents, \current => current.currentLayer == "menu" && current.currentState != "closed")) > 0
        top < 0 || top == n.identity || (menu && editor.selected == n.identity)

    (** A workspace and its dock use independent viewports, retaining the original artwork. *)
    export sized (machine, width, height) = machine(machineSkins = mapList (machine.machineSkins, \skin =>
        match skin.skinBoard
            ui::Unboarded => skin
            ui::Boarded _ _ zoom atlas marks areas => skin(skinBoard = ui::Boarded(boardWidth = ui::Fixed(fixedAt = width), boardHeight = ui::Fixed(fixedAt = height), boardZoom = zoom, boardAtlas = atlas, boardMarks = marks, boardAreas = areas))))

(** [PRISM-ROUTING-CABLES] One curve supplies painting, hit testing and accessible actions. *)
module CableCanvas
    endpoints (editor, cable) =
        source = EditorLayout::position (editor, cable.source)
        target = EditorLayout::position (editor, cable.destination)
        CableCurve(sx = sourceX (editor, source, cable.outlet, monitorCable (editor, cable)), sy = sourceY (editor, source, cable.outlet, monitorCable (editor, cable)), dx = EditorView::portX (editor, target, false, cable.inlet), dy = EditorView::portY (editor, target, false, cable.inlet))

    monitorCable (editor, cable) = EditorView::runs (editor, cable.source, Filter) && EditorView::runs (editor, cable.destination, Sink)

    sourceX (editor, at, outlet, monitor) = ui::Pick::either (monitor, at.layoutX, EditorView::portX (editor, at, true, outlet))

    sourceY (editor, at, outlet, monitor) = ui::Pick::either (monitor, at.layoutY + 89.0, EditorView::portY (editor, at, true, outlet))

    (** The cyan monitor socket is an alias of the Filter's real audio output. *)
    export monitorAt (editor, n, px, py) =
        at = EditorLayout::position (editor, n.identity)
        n.processor == Filter && EditorView::inside (px, py, at.layoutX, at.layoutY + 89.0, 10.0, 10.0)

    monitorAccess (editor, n) =
        at = EditorLayout::position (editor, n.identity)
        EditorView::accessible ("Monitor output ${n.identity}", at.layoutX - 10.0, at.layoutY + 79.0, 20.0, 20.0, false)

    rate (editor, identity, outlet) = match Graphs::node (editor.graph, identity)
        Invalid _ => Audio
        Valid n => match listGet n.outputs outlet
            Error _ => Audio
            Success p => p.rate

    curve (sx, sy, dx, dy, colour, stroke, dashed, depth) = ui::Scenes::path ([ui::MoveTo(toX = sx, toY = sy), ui::CubicTo(toX = dx, toY = dy, ctrlAX = sx + 70.0, ctrlAY = sy, ctrlBX = dx - 70.0, ctrlBY = dy)], ui::Line(width = stroke, dashes = ui::Pick::either (dashed, [6.0, 5.0], []), bevel = false), ui::Solid(tint = ui::Scenes::hex (shiftRight colour 8, 1.0)), depth)

    wire (editor, cable, index) =
        at = endpoints (editor, cable)
        kind = ui::Pick::either (monitorCable (editor, cable), Events, rate (editor, cable.source, cable.outlet))
        colour = ui::Pick::either (editor.selectedCable == index, ui::Scenes::rgb (242, 237, 255), EditorView::ink kind)
        curve (at.sx, at.sy, at.dx, at.dy, colour, ui::Pick::either (editor.selectedCable == index, 5.0, 3.0), kind == Control, 1)

    preview editor = match editor.wireDragging
        false => []
        true =>
            source = EditorLayout::position (editor, editor.source)
            kind = ui::Pick::either (editor.wireMonitor, Events, rate (editor, editor.source, editor.outlet))
            [curve (sourceX (editor, source, editor.outlet, editor.wireMonitor), sourceY (editor, source, editor.outlet, editor.wireMonitor), editor.wireX, editor.wireY, EditorView::ink kind, 3.0, kind == Control, 30000)]

    midpoint (editor, cable) =
        at = endpoints (editor, cable)
        CablePoint(x = CanvasGeometry::cableX (at.sx, at.dx, 24.0), y = CanvasGeometry::cableY (at.sy, at.dy, 24.0))

    deletion editor = match listGet editor.graph.cables editor.selectedCable
        Error _ => []
        Success cable =>
            at = midpoint (editor, cable)
            [EditorView::panel (at.x - 67.0, at.y + 18.0, 134.0, 32.0, 2563389, 30001), EditorView::text ("Delete cable ×", at.x - 53.0, at.y + 26.0, 14.0, 240, 30002)]

    (** The close button and drag preview remain above the node layers. *)
    export shapes editor = listConcat (cables (editor, [], wire)) (listConcat (preview editor) (deletion editor))

    (** Each cable with its index, appended after `first`. *)
    cables (editor, first, each) = EditorView::indexed (editor.graph.cables, first, \(cable, index) => [each (editor, cable, index)])

    cableAccess (editor, cable, index) =
        at = midpoint (editor, cable)
        EditorView::accessible ("Cable ${cable.source}:${cable.outlet} to ${cable.destination}:${cable.inlet}", at.x - 8.0, at.y - 8.0, 16.0, 16.0, editor.selectedCable == index)

    (** Screen readers and host tests invoke the same physical canvas hit areas. *)
    export access editor =
        wires = cables (editor, mapList (filterList (editor.graph.nodes, \n => n.processor == Filter), \n => monitorAccess (editor, n)), cableAccess)
        match listGet editor.graph.cables editor.selectedCable
            Error _ => wires
            Success cable =>
                at = midpoint (editor, cable)
                listAppend wires (EditorView::accessible ("Delete selected cable", at.x - 67.0, at.y + 18.0, 134.0, 32.0, false))

    hit (editor, cable, px, py) =
        at = endpoints (editor, cable)
        ui::Lists::any (toList (range (0, 48)), \i => CanvasGeometry::nearSegment (px, py, CanvasGeometry::cableX (at.sx, at.dx, toFloat i), CanvasGeometry::cableY (at.sy, at.dy, toFloat i), CanvasGeometry::cableX (at.sx, at.dx, toFloat (satAdd i 1)), CanvasGeometry::cableY (at.sy, at.dy, toFloat (satAdd i 1))))

    (** Only exposed cable curves receive selection; cards retain their controls. *)
    export selected (editor, px, py) =
        centred = ui::Lists::position (editor.graph.cables, \cable =>
            at = midpoint (editor, cable)
            EditorView::inside (px, py, at.x, at.y, 1.0, 1.0))
        selected = match centred >= 0
            true => centred
            false => ui::Lists::position (editor.graph.cables, \cable => hit (editor, cable, px, py))
        editor(selectedCable = selected, source = -1, message = ui::Pick::either (selected >= 0, "Delete the selected cable with × or Backspace.", "Drag from an output socket to an input socket."))

    (** The contextual close control uses the painted cable midpoint. *)
    export deleteAt (editor, px, py) = match listGet editor.graph.cables editor.selectedCable
        Error _ => false
        Success cable =>
            at = midpoint (editor, cable)
            EditorView::inside (px, py, at.x, at.y + 34.0, 67.0, 16.0)

    (** Pressing an output arms both drag-to-connect and click-to-connect. *)
    export begin (editor, identity, outlet, px, py, monitor) =
        armed = EditorState::tapped (editor, Source(identity = identity, outlet = outlet))
        armed(wireDragging = true, wireMonitor = monitor, wireX = px, wireY = py, selectedCable = -1)

    sameOutput (editor, n, px, py) = match EditorView::hitPort (editor, EditorLayout::position (editor, n.identity), n.outputs, true, px, py)
        Error _ => false
        Success outlet => outlet == editor.outlet

    dropped (editor, px, py) = match Graphs::node (editor.graph, EditorView::targetAt (editor, px, py))
        Invalid _ => editor(source = -1, message = "Connection cancelled. Drop on an input socket.")
        Valid n => match EditorView::hitPort (editor, EditorLayout::position (editor, n.identity), n.inputs, false, px, py)
            Success inlet => EditorState::tapped (editor, Connect(identity = n.identity, inlet = inlet))
            Error _ => match n.identity == editor.source && (monitorAt (editor, n, px, py) || sameOutput (editor, n, px, py))
                true => editor
                false => editor(source = -1, message = "Connection cancelled. Drop on an input socket.")

    (** Pointer capture survives crossing cards; no graph mutation occurs until release. *)
    export drag (editor, px, py, down) = match CanvasGeometry::valid (px, py)
        false => editor(wireDragging = down, source = -1)
        true => match down
            true => editor(wireX = px, wireY = py)
            false => dropped (editor(wireDragging = false, wireX = px, wireY = py), px, py)

    (** Escape cancels a gesture; Delete and Backspace remove only the selected cable. *)
    export keyed (editor, key, down) = match down
        false => editor
        true => match key
            "escape" => editor(wireDragging = false, source = -1, selectedCable = -1, message = "Connection cancelled.")
            "backspace" => erase editor
            "delete" => erase editor
            _ => editor

    erase editor = match editor.selectedCable >= 0
        true => EditorState::tapped (editor, RemoveCable)
        false => editor

(** [PRISM-ROUTING-EDITOR] Context actions belong to the card under the secondary click. *)
module NodeContext
    export open (editor, x, y) = match editor.page == PatchPage && (editor.outputEdit == OutputClosed || showing editor) && !EditorView::paletteAt (editor, x, y)
        false => ui::Runtime::step editor
        true =>
            id = EditorView::nodeAt (editor, x, y)
            limit = ui::Pick::either (editor.detailsShown, 1072.0, 1396.0)
            left = ui::Pick::either (x > limit, limit, x)
            top = ui::Pick::either (y > 752.0, 752.0, y)
            menu = ui::Pick::either (id < 0, OutputClosed, NodeMenu(nodeId = id, left = left, top = top))
            ui::Runtime::step (editor(outputEdit = menu))

    showing editor = match editor.outputEdit
        NodeMenu _ _ _ => true
        _ => false

    export pointed (editor, id, left, top, x, y, down) = match down
        false => ui::Runtime::step editor
        true =>
            closed = editor(outputEdit = OutputClosed)
            hit = EditorView::inside (x, y, left + 70.0, top + 18.0, 70.0, 18.0)
            match hit && ui::Lists::any (editor.graph.nodes, \n => n.identity == id)
                true => ui::Runtime::step (EditorState::tapped (closed(selected = id), Remove))
                false => ui::Runtime::step closed

    export shapes editor = match editor.outputEdit
        NodeMenu _ x y => [EditorView::panel (x, y, 140.0, 36.0, 3944028, 40000), EditorView::text ("Delete node", x + 14.0, y + 9.0, 16.0, 250, 40001)]
        _ => []

    export access editor = match editor.outputEdit
        NodeMenu _ x y => [EditorView::accessible ("Delete node", x, y, 140.0, 36.0, false)]
        _ => []
