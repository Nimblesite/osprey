// [PRISM-ROUTING-EDITOR] Native controls and the canvas share the same typed graph snapshot.
namespace synth

import ui::Ui
import ui::Keyed
import ui::Scenes

(** The modular patch's component menu, canvas, ports and parameter inspector. *)
module EditorView
    editorSlice () = perform Signal<Editor<Graph, ui::Machine>>.read ()

    (** The name Prism shows for a processor. *)
    export processorTitle processor = match processor
        SamplePlayer _ => "Sample"
        Granular _ _ _ => "Grain cloud"
        Lfo => "LFO"
        ModulatedGain => "Modulated gain"
        MidiNotes => "MIDI notes"
        FormulaNotes _ => "Formula melody"
        Stereo => "Mono to stereo"
        Panner => "Panner"
        Split => "Channel split"
        Join => "Channel join"
        Route _ => "Channel route"
        Oscillator => "Oscillator"
        Filter => "Filter"
        Amplifier => "Gain"
        Mixer => "Mixer"
        Sink => "Output"
        Delay _ => "Delay"
        Exciter _ => "Exciter"
        Resonator => "Resonator"
        Modal => "Modal bank"
        Waveguide _ => "Waveguide string"
        FractionalDelay _ => "Fractional delay"
        LossFilter => "Loss filter"
        Allpass => "Allpass dispersion"
        TableOscillator _ => "Wavetable"
        Additive => "Additive partials"
        Spectral _ _ => "Spectral processor"
        Shaper => "Waveshaper"
        Reverb => "FDN reverb"
        Shifter => "Frequency shifter"
        PhaseOperator => "Phase operator"
        Bowed _ => "Bowed string"
        Smoother => "Smoother"
        StrikeComb _ => "Strike comb"
        Downmix => "Stereo to mono"
        External identifier _ => identifier

    (** A module's name on the canvas: its plugin's, or its processor's, with its identity. *)
    export componentName (editor, n) = match listGet (filterList (editor.pluginBindings, \binding => binding.pluginNode == n.identity)) 0
        Success binding => "${binding.pluginName} ${n.identity}"
        Error _ => "${processorTitle n.processor} ${n.identity}"

    menu editor =
        builtins = mapList (EditorState::pickerKinds (), \kind => Ui::choice (kind, EditorState::title kind))
        plugins = match editor.scanQueue
            [_, ..._] => []
            [] => mapList (editor.catalog, \entry => Ui::choice ("vst:${entry.classId}", entry.className))
        Ui::picker ("Add component", listConcat [Ui::choice ("", "Choose module…")] (listConcat builtins plugins), "", Add(kind = ""))

    // [DAW-CONTROLS-DIAL] Patch Controls draws the module's numbers as the canvas does: a dial and its value.
    dialTop () = 4.0 + Dials::pitch () / 2.0

    dialRows (editor, n) =
        height = 8.0 + toFloat (Dials::rowCount (editor, n)) * Dials::pitch ()
        plain = ui::Frames::plain
        scene = Ui::zoomed (1.0, 248.0, height, PrismArt::atlas editor.skin, Dials::shapes (editor, n, 0.0, dialTop (), 248.0, 2), Controls)
        Ui::framed (plain(frameHeight = floatToInt height ?: 0), Ui::described (scene, Dials::access (editor, n, 0.0, dialTop (), 248.0)))

    (** The pointer over Patch Controls' dials. *)
    export dialled (editor, px, py, down) = match Graphs::node (editor.graph, editor.selected)
        Invalid _ => editor
        Valid n => match Dials::pointed (editor, n, 0.0, dialTop (), 248.0, px, py, down)
            Success next => next
            Error _ => editor

    // A press on a dial that never moved asks for its value in figures: one field, sent on Return.
    entry (editor, n) = match ui::Lists::find (n.parameters, \p => p.key == editor.dialEntry)
        Error _ => []
        Success p => [ParameterModes::entry (n, p)]

    // A plug-in's parameters can be driven by a control cable.
    modulations n = match n.processor
        External _ _ => mapList (filterList (n.parameters, \p => p.automatable), \p => Ui::button ("Modulate ${p.label}", "", Modulate(identity = n.identity, key = p.key)))
        _ => []

    // [SYNTH-FORMULA-NOTES] A melody's formula over the step t, applied on Return, above the notes it plays.
    formulaSection n = match n.processor
        FormulaNotes formula => [Ui::section ("Formula", "", [ui::Field(label = "Formula over step t", value = formula, prompt = "60 + t * 7 % 12", secure = false, multiline = false, commit = ui::OnSubmit, bind = EditFormula(identity = n.identity)), Ui::caption (melody formula)])]
        _ => []

    heard note = match note
        Rest => "rest"
        Sounded pitch => TimelineView::noteName pitch

    melody formula = match Formulas::parse formula
        Error why => Faults::detail why
        Success term => "Plays ${join (mapList (Formulas::notes (term, 16), heard), " ")}"

    component (editor, n) =
        parameters = match (length n.parameters == 0)
            true => []
            false => [Ui::section ("Parameters", "", listConcat [dialRows (editor, n)] (listConcat (entry (editor, n)) (modulations n)))]
        sample = match n.processor
            SamplePlayer resource => [Ui::section ("Sample", "", [Ui::caption (daw::PatchVoices::fileName resource.name), Ui::button ("Load WAV sample", "", LoadSample)])]
            Granular resource _ _ => [Ui::section ("Sample", "", [Ui::caption ("${daw::PatchVoices::fileName resource.name} · ${resource.sampleRate} Hz · ${resource.sourceChannels} source channels · ${SampleResources::frames resource} frames · ${WaveMath::seconds (toFloat (SampleResources::frames resource), toFloat resource.sampleRate)} s"), Ui::button ("Load WAV sample", "", LoadSample), Ui::button ("Use built-in harmonic sample", "", BuiltinSample)])]
            _ => []
        native = match n.processor
            External _ _ => match ui::Lists::find (editor.editorWindows, \w => w.windowNode == n.identity && w.windowTrack == editor.patchTrack && w.windowProject == editor.songPath)
                Error _ => [Ui::button ("Open plug-in window", "", OpenPluginWindow(identity = n.identity))]
                Success w =>
                    focus = match w.windowCycle > 1
                        true => Ui::button ("Focus plug-in window", "", OpenPluginWindow(identity = n.identity))
                        false => Ui::caption "Opening plug-in window…"
                    [focus, Ui::button ("Close plug-in window", "", ClosePluginWindow(identity = n.identity))]
            _ => []
        Ui::column (listConcat native (listConcat sample (listConcat (formulaSection n) parameters)))

    x index = index.layoutX

    y index = index.layoutY

    portRate (editor, index, output, port) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => Audio
        Valid n => match listGet (ui::Pick::either (output, n.outputs, n.inputs)) port
            Error _ => Audio
            Success p => p.rate

    halfWidth (editor, index) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => 146.0
        Valid n => match n.processor
            Oscillator => 138.5
            Lfo => 123.0
            Sink => 141.0
            Amplifier => 141.0
            ModulatedGain => 141.0
            _ => 146.0

    (** Whether a graph node exists and runs the given processor. *)
    export runs (editor, identity, processor) = match Graphs::node (editor.graph, identity)
        Invalid _ => false
        Valid n => structuralEquals (n.processor, processor)

    isFilter (editor, index) = runs (editor, index.layoutNode, Filter)

    sink (editor, index) = runs (editor, index.layoutNode, Sink)

    (** Horizontal position of a real graph socket. *)
    export portX (editor, index, output, port) = match sink (editor, index)
        true => x index - 2.0
        false => ordinaryPortX (editor, index, output, port)

    ordinaryPortX (editor, index, output, port) = match (portRate (editor, index, output, port) == Control)
        true => controlX (editor, index, output, port)
        false => match output
            true => x index + halfWidth (editor, index)
            false => x index - halfWidth (editor, index)

    // [PRISM-ROUTING-CABLES] Each control socket has a distinct slot along this edge.
    controlX (editor, index, output, port) =
        centre = x index + ui::Pick::either (isFilter (editor, index), -1.0, 1.0)
        match Graphs::node (editor.graph, index.layoutNode)
            Invalid _ => centre
            Valid n =>
                ports = ui::Pick::either (output, n.outputs, n.inputs)
                slots = filterList (indices ports, \i =>
                    match listGet ports i
                        Success p => p.rate == Control
                        Error _ => false)
                CanvasGeometry::controlSocketX (centre, toFloat (ui::Lists::position (slots, \i => i == port)), toFloat (length slots))

    (** Vertical position of a real graph socket. *)
    export portY (editor, index, output, port) = match sink (editor, index)
        true => y index - 81.0
        false => ordinaryPortY (editor, index, output, port)

    ordinaryPortY (editor, index, output, port) = match (portRate (editor, index, output, port) == Control)
        true => match output
            true => y index + 78.0
            false => y index - ui::Pick::either (isFilter (editor, index), 87.0, 88.0)
        false => y index + audioOffset (editor, index) + toFloat port * 24.0

    audioOffset (editor, index) = match Graphs::node (editor.graph, index.layoutNode)
        Invalid _ => 0.0
        Valid n => match n.processor
            Filter => 6.0
            Oscillator => -0.5
            _ => 1.5

    (** The index of every item of `items`, in order. *)
    export indices items = toList (range (0, length items))

    (** `first`, then every item of `items` with its index, each followed by the list `each` gives it. *)
    export indexed (items, first, each) = foldList (indices items, first, \(all, index) =>
        match listGet items index
            Error _ => all
            Success item => listConcat all (each (item, index)))

    (** Consistent audio, modulation and event cable colours. *)
    export ink rate = match rate
        Control => Scenes::rgb (191, 126, 250)
        Events => Scenes::rgb (81, 225, 215)
        Audio => Scenes::rgb (255, 132, 66)

    portShapes (editor, index, ports, output) = foldList (indices ports, [], \(all, port) =>
        match listGet ports port
            Error _ => all
            Success p => listConcat all [Scenes::disc (portX (editor, index, output, port), portY (editor, index, output, port), 9.0, ink p.rate, 6), Scenes::disc (portX (editor, index, output, port), portY (editor, index, output, port), 6.0, Scenes::rgb (16, 13, 33), 7)])

    (** A named canvas hit area shared with native accessibility. *)
    export accessible (label, left, top, width, height, selected) = ui::Accessible(accessRole = ui::Pressable, accessLabel = label, accessLeft = left, accessTop = top, accessWidth = width, accessHeight = height, accessValue = 0.0, accessMin = 0.0, accessMax = 0.0, accessMovable = false, accessSelected = selected)

    (** Locate the accessible control at a point in scene coordinates. *)
    export areaAt (areas, x, y) = ui::Lists::position (areas, \a => inside (x, y, a.accessLeft + a.accessWidth / 2.0, a.accessTop + a.accessHeight / 2.0, a.accessWidth / 2.0, a.accessHeight / 2.0))

    portLabel output = match output
        true => "output"
        false => "input"

    portAccess (editor, n, index, ports, output) = mapList (indices ports, \port => accessible ("Canvas ${portLabel output} ${n.identity}:${port}", portX (editor, index, output, port) - 14.0, portY (editor, index, output, port) - 14.0, 28.0, 28.0, false))

    nodeAccess (editor, n) =
        index = EditorLayout::position (editor, n.identity)
        listConcat [accessible ("Canvas ${componentName (editor, n)}", x index - 120.0, y index - 78.0, 240.0, 156.0, editor.selected == n.identity)] (listConcat (portAccess (editor, n, index, n.inputs, false)) (portAccess (editor, n, index, n.outputs, true)))

    (** Inclusive bounds for canvas hit testing. *)
    export inside (px, py, cx, cy, halfWidth, halfHeight) = px >= cx - halfWidth && px <= cx + halfWidth && py >= cy - halfHeight && py <= cy + halfHeight

    (** Whether the point `px`, `py` lies within the inclusive bounds of the accessible `area`. *)
    export covers (area, px, py) = px >= area.accessLeft && px <= area.accessLeft + area.accessWidth && py >= area.accessTop && py <= area.accessTop + area.accessHeight

    (** Resolve a pointer to a declared socket, never decorative artwork. *)
    export hitPort (editor, index, ports, output, px, py) = listGet (filterList (indices ports, \port => inside (px, py, portX (editor, index, output, port), portY (editor, index, output, port), 14.0, 14.0))) 0

    nodeOrder editor = listConcat (filterList (editor.graph.nodes, \n => n.identity != editor.selected)) (filterList (editor.graph.nodes, \n => n.identity == editor.selected))

    (** Hit testing follows complete card layers, so covered controls cannot steal a click. *)
    export nodeAt (editor, px, py) = match graphArea (editor, py)
        true => cardAt (editor, px, py)
        false => -1

    graphArea (editor, py) = py >= 66.0 && py < 789.0 + ui::Machines::number (editor.skin, "spareHeight")

    cardAt (editor, px, py) = foldList (nodeOrder editor, -1, \(found, n) =>
        at = EditorLayout::position (editor, n.identity)
        ui::Pick::either (inside (px, py, x at, y at, halfWidth (editor, at) + 12.0, 90.0), n.identity, found))

    // Whether the pointer is on one of the module's sockets.
    onSocket (editor, n, px, py) = match ordinaryPort (editor, n, px, py)
        Success _ => true
        Error _ => false

    ordinaryPort (editor, n, px, py) =
        index = EditorLayout::position (editor, n.identity)
        match hitPort (editor, index, n.outputs, true, px, py)
            Success port => Success(value = port)
            Error _ => hitPort (editor, index, n.inputs, false, px, py)

    (** The module whose socket is under the pointer, else the module whose card is: a socket is a hand-sized
        target and is never lost to a card that overlaps it [PRISM-ROUTING-CABLES]. *)
    export targetAt (editor, px, py) = match listGet (filterList (nodeOrder editor, \n => onSocket (editor, n, px, py))) 0
        Success n => n.identity
        Error _ => nodeAt (editor, px, py)

    hitNode (editor, n, px, py) = match CableCanvas::monitorAt (editor, n, px, py)
        true => CableCanvas::begin (editor, n.identity, 0, px, py, true)
        false => ordinaryNode (editor, n, px, py)

    ordinaryNode (editor, n, px, py) =
        index = EditorLayout::position (editor, n.identity)
        match hitPort (editor, index, n.outputs, true, px, py)
            Success port => CableCanvas::begin (editor, n.identity, port, px, py, false)
            Error _ => match hitPort (editor, index, n.inputs, false, px, py)
                Success port => EditorState::tapped (editor, Connect(identity = n.identity, inlet = port))
                Error _ => match inside (px, py, x index, y index, 120.0, 78.0)
                    true => EditorLayout::begin (editor, n.identity, px, py)
                    false => editor

    paletteHit py = listGet (filterList (toList (range (0, length EditorState::kinds)), \i => py >= CanvasGeometry::paletteY (toFloat i) - 18.0 && py <= CanvasGeometry::paletteY (toFloat i) + 18.0)) 0

    (** The open library owns its rectangle, including controls covered by its overlay. *)
    export paletteAt (editor, px, py) = editor.paletteShown && px >= 0.0 && px < 196.0 && py >= 66.0 && py < 774.0

    placeAdded editor =
        candidates = mapList (toList (range (0, 9)), \i => daw::NodePosition(layoutNode = editor.selected, layoutX = CanvasGeometry::gridX (toFloat (i % 3)), layoutY = CanvasGeometry::gridY (toFloat (intDiv i 3))))
        occupied = mapList (filterList (editor.graph.nodes, \n => n.identity != editor.selected), \n => EditorLayout::position (editor, n.identity))
        empty = filterList (candidates, \at => length (filterList (occupied, \other => inside (x at, y at, x other, y other, 300.0, 210.0))) == 0)
        at = listGet empty 0 ?: EditorLayout::position (editor, editor.selected)
        editor(positions = listAppend editor.positions (EditorLayout::world (editor, at)), paletteShown = false)

    dropModule (editor, px, py) =
        kind = editor.paletteDrag
        released = editor(paletteDrag = "")
        match paletteAt (editor, px, py)
            true => match paletteHit py
                Success i => match (listGet EditorState::kinds i ?: "") == kind
                    true => clicked (released, kind)
                    false => released
                Error _ => released
            false => dropped (released, kind, px, py)

    clicked (editor, kind) =
        added = EditorState::tapped (editor, Add(kind = kind))
        match added.nextIdentity > editor.nextIdentity
            false => added
            true => placeAdded added

    dropped (editor, kind, px, py) = match px >= 205.0 && CanvasGeometry::valid (px, py)
            false => editor
            true =>
                added = EditorState::tapped (editor, Add(kind = kind))
                match added.nextIdentity > editor.nextIdentity
                    false => added
                    true => EditorLayout::drag (added(dragging = added.selected, paletteShown = false, grabX = 0.0, grabY = 0.0), px, py, false)

    (** Palette drops, card dragging and cable edits all change the same patch. *)
    export pointed (editor, px, py, down) = match editor.wireDragging
        true => CableCanvas::drag (editor, px, py, down)
        false => ordinaryPointer (editor, px, py, down)

    ordinaryPointer (editor, px, py, down) = match editor.dragging >= 0 || editor.paletteDrag != "" || graphArea (editor, py)
        true => canvasPointer (editor, px, py, down)
        false => editor

    canvasPointer (editor, px, py, down) = match editor.paletteDrag != ""
        true => match down
            true => editor
            false => dropModule (editor, px, py)
        false => match editor.dragging >= 0
            true => EditorLayout::drag (editor, px, py, down)
            false => match down
                false => editor
                true => match paletteAt (editor, px, py)
                    true => match paletteHit py
                        Error _ => editor
                        Success i => editor(paletteDrag = listGet EditorState::kinds i ?: "")
                    false => match Graphs::node (editor.graph, targetAt (editor, px, py))
                        Invalid _ => EditorLayout::background (CableCanvas::selected (editor, px, py), px, py)
                        Valid n => hitNode (editor, n, px, py)

    // Prism's rounded panel, shared by cards and palette rows.
    (** Prism's rounded panel shared with contextual cable controls. *)
    export panel (left, top, width, height, colour, depth) = rounded (left, top, width, height, 10.0, ui::Fill, ui::Solid(tint = Scenes::hex (colour, 1.0)), depth)

    (** A rectangle with corners of radius `r`, filled or stroked as `outline` says. *)
    export rounded (left, top, width, height, r, outline, paint, depth) =
        right = left + width
        bottom = top + height
        Scenes::path ([ui::MoveTo(toX = left + r, toY = top), ui::LineTo(toX = right - r, toY = top), ui::CurveTo(toX = right, toY = top + r, ctrlX = right, ctrlY = top), ui::LineTo(toX = right, toY = bottom - r), ui::CurveTo(toX = right - r, toY = bottom, ctrlX = right, ctrlY = bottom), ui::LineTo(toX = left + r, toY = bottom), ui::CurveTo(toX = left, toY = bottom - r, ctrlX = left, ctrlY = bottom), ui::LineTo(toX = left, toY = top + r), ui::CurveTo(toX = left + r, toY = top, ctrlX = left, ctrlY = top), ui::Close], outline, paint, depth)

    (** Shared canvas text styling for nodes and cable actions. *)
    export text (words, left, top, size, colour, depth) = Scenes::lettering (words, left, top, size, Scenes::rgb (colour, colour, 255), 0, 500.0, depth)

    shape (editor, n, layer) =
        at = EditorLayout::position (editor, n.identity)
        artwork = mapList ((CardArts::card (editor, n)).artShapes, \item => Header::placedShape (item, at.layoutX, at.layoutY, layer))
        details = listConcat (cardTitle (editor, n, at)) (listConcat (portShapes (editor, at, n.inputs, false)) (portShapes (editor, at, n.outputs, true)))
        listConcat artwork (mapList (details, \item => Header::placedShape (item, 0.0, 0.0, layer)))

    (** A module's card, drawn from the skin: the costly part `CardArts` keeps. *)
    export nodeArtwork (editor, n, at) = match n.processor
        SamplePlayer resource => listConcat (moduleCard (editor, n, at)) (grainTrace (resource, at))
        Granular resource _ _ => listConcat (moduleCard (editor, n, at)) (grainTrace (resource, at))
        Oscillator => PrismArt::card (editor, n)
        Lfo => PrismArt::card (editor, n)
        Filter => PrismArt::card (editor, n)
        Amplifier => PrismArt::card (editor, n)
        ModulatedGain => PrismArt::card (editor, n)
        Sink => PrismArt::card (editor, n)
        _ => moduleCard (editor, n, at)

    moduleCard (editor, n, at) =
        border = ui::Pick::either (editor.selected == n.identity, 16745538, 6246296)
        paint = ui::Linear(angle = 90.0, from = Scenes::hex (2364225, 1.0), fromAt = 0.0, to = Scenes::hex (1117472, 1.0), toAt = 1.0, oklab = false)
        caption = match n.processor
            SamplePlayer _ => ""
            Granular _ _ _ => ""
            _ => match listGet n.parameters 0
                Error _ => ""
                Success p => Dials::summary p
        returnShapes = [panel (x at - 146.0, y at - 87.0, 292.0, 174.0, border, 2), rounded (x at - 144.0, y at - 85.0, 288.0, 170.0, 10.0, ui::Fill, paint, 3), text (componentName (editor, n), x at - 124.0, y at - 67.0, 18.0, 238, 5), panel (x at - 124.0, y at - 27.0, 248.0, 64.0, 986652, 4), text (caption, x at - 108.0, y at - 3.0, 14.0, 190, 5)]
        returnShapes

    grainTrace (resource, at) = [Scenes::strip (foldList (toList (range (0, 48)), [], \(points, index) =>
        match floatToInt (CanvasGeometry::grainIndex (toFloat index, toFloat (SampleResources::frames resource)))
            Error _ => points
            Success source => match SampleResources::monoAt (resource, source)
                Error _ => points
                Success value => listConcat points [CanvasGeometry::grainX (x at, toFloat index), CanvasGeometry::waveY (y at + 5.0, value)]), Scenes::rgb (80, 229, 216), 2.0, 6), text (resource.name, x at - 120.0, y at - 34.0, 11.0, 190, 7)]

    midiLabel (editor, n, at) = match n.processor
        Oscillator => [Scenes::lettering ("MIDI", portX (editor, at, false, 0) - 12.0, portY (editor, at, false, 0) - 7.0, 11.0, Scenes::rgb (210, 210, 255), 2, 500.0, 8)]
        _ => []

    cardTitle (editor, n, at) = listConcat [text (componentName (editor, n), x at - 120.0, y at - 104.0, 11.0, 160, 8)] (midiLabel (editor, n, at))

    palette () = listConcat [Scenes::rect (98.0, 420.0, 196.0, 708.0, 0.0, Scenes::rgb (19, 16, 36), 20), text ("MODULES", 18.0, 82.0, 15.0, 166, 22), text ("Click or drag to add", 18.0, 104.0, 12.0, 135, 22)] (foldList (toList (range (0, length EditorState::kinds)), [], \(all, i) => listConcat all [panel (12.0, CanvasGeometry::paletteY (toFloat i) - 17.0, 172.0, 35.0, 2563389, 21), text (EditorState::title (listGet EditorState::kinds i ?: ""), 22.0, CanvasGeometry::paletteY (toFloat i) - 8.0, 12.0, 224, 22)]))

    paletteAccess () = mapList (toList (range (0, length EditorState::kinds)), \i => accessible ("Add ${EditorState::title (listGet EditorState::kinds i ?: "")}", 12.0, CanvasGeometry::paletteY (toFloat i) - 17.0, 172.0, 35.0, false))

    (** Where artwork pinned to the right edge sits once the region is wider than the skin. *)
    export rightX (editor, base) = CanvasGeometry::shifted (base, ui::Machines::number (editor.skin, "spareWidth"))

    // [DAW-HEADER] The Patch page's header: the shared tabs, the transport and Add module. Every other command
    // is in the window's menu bar ([DAW-MENU]).
    toolbar editor = listConcat (listConcat (Header::patchSubtitle editor) (Header::tabs (editor, Header::patchScale ()))) (listAppend (Header::plaque (943.0, 14.0, 134.0, 38.0, Scenes::rgb (52, 41, 110), 11)) (Scenes::lettering ("+  Add module", 1010.0, 25.0, 14.0, Scenes::rgb (240, 236, 255), 1, 500.0, 13)))

    toolbarItems editor =
        buttons = [accessible ("Modules", 943.0, 14.0, 134.0, 38.0, editor.paletteShown), accessible ("Undo", rightX (editor, 1108.0), 15.0, 40.0, 37.0, false), accessible ("Redo", rightX (editor, 1160.0), 15.0, 40.0, 37.0, false)]
        listConcat buttons (Header::tabAreas (editor, Header::patchScale ()))

    (** The command behind header area `index` of the Patch page. *)
    export toolbarAction index = match index
        0 => ShowModules
        1 => Undo
        2 => Redo
        _ => ShowPage(page = Header::tabPage (satSub index 3))

    (** The header area under a point of the Patch page, if any. *)
    export toolbarAt (editor, x, y) = listGet (filterList (toList (range (0, length (toolbarItems editor))), \i =>
        match listGet (toolbarItems editor) i
            Error _ => false
            Success a => covers (a, x, y))) 0

    // [DAW-LAYOUT-FIXED-SCALE] One scene unit is one point at every window size (a negative zoom is that scale
    // exactly): resizing the window shows more or less of the page and never resizes a control.
    pageZoom = -1.0

    // The Timeline and Mix pages draw the song instead of the patch, on the same surface.
    songPage editor =
        open = length editor.song.tracks > 0
        body = match editor.page
            MixPage => MixView::shapes editor
            _ => TimelineView::shapes editor
        areas = match editor.page
            MixPage => MixView::access editor
            _ => listConcat (TimelineView::laneAccess editor) (TimelineView::inspectorAreas ())
        shapes = listConcat (Header::bar editor) (Header::placed (editor, Header::page (editor, ui::Pick::either (open, body, []))))
        Ui::described (Ui::zoomed (pageZoom, 1440.0, 940.0, PrismArt::atlas editor.skin, shapes, Surface), listConcat (Header::songAreas editor) (Header::placedAreas (editor, ui::Pick::either (open, areas, []))))

    canvas editor = match editor.page
        PatchPage => patchCanvas editor
        _ => songPage editor

    patchCanvas editor =
        ordered = nodeOrder editor
        nodes = foldList (toList (range (0, length ordered)), [], \(all, i) =>
            match listGet ordered i
                Error _ => all
                Success n => listConcat all (shape (editor, n, satMul (satAdd i 1) 100)))
        library = match editor.paletteShown || editor.paletteDrag != ""
            true => mapList (palette (), \primitive => Header::placedShape (primitive, 0.0, 0.0, satMul (satAdd (length ordered) 1) 100))
            false => []
        chrome = listAppend (toolbar editor) (text (editor.message, 32.0, 767.0, 12.0, 170, 12))
        shapes = ui::Lists::flatten [(CardArts::scenery editor).artShapes, CableCanvas::shapes editor, nodes, mapList (chrome, \item => Header::placedShape (item, 0.0, 0.0, PrismArt::chromeLayer editor)), library, NodeContext::shapes editor]
        scene = Ui::zoomed (pageZoom, ui::Pick::either (editor.detailsShown, 1212.0, 1536.0), 828.0, PrismArt::atlas editor.skin, shapes, ui::Pick::either (editor.patchWindowSerial > 0, PatchSurface, Surface))
        access = listConcat (toolbarItems editor) (foldList (editor.graph.nodes, [], \(all, n) => listConcat all (listConcat (nodeAccess (editor, n)) (CardArts::controls (editor, n)))))
        extra = match editor.paletteShown
            true => paletteAccess ()
            false => []
        Ui::described (scene, listConcat (listConcat access (CableCanvas::access editor)) (listConcat extra (NodeContext::access editor)))

    inspector editor =
        style = ui::Frames::inset (16, 12, 16, 12)
        selected = filterList (editor.graph.nodes, \n => n.identity == editor.selected)
        chooser = Ui::picker ("Module", mapList (editor.graph.nodes, \n => Ui::choice ("${n.identity}", componentName (editor, n))), "${editor.selected}", Select(identity = -1))
        heading = Ui::row [Ui::styled ("Patch", ui::Heading, ui::Primary), ui::Spacer, Ui::button ("Close", "dismiss", ShowDetails)]
        local = theme ()
        Ui::themed (local(spacing = [4, 8, 8, 16, 24, 32]), Ui::framed (style(frameTextSize = 12, frameControlHeight = 28), Ui::column (listConcat [heading, menu editor, chooser] (mapList (selected, \n => component (editor, n))))))

    // [DAW-MENU] [DAW-KEYS] The window's menu bar holds every command, each with the shortcut the keymap in use
    // gives it. A command that cannot run now is disabled, which also frees its keys for its counterpart.
    command (editor, label, name, enabled, action) = Ui::action (label, Keymaps::keys (editor.keymap, name), ui::Plain, enabled, action)

    keymapChoice (editor, name) = Ui::action (name, "", ui::Pick::either (editor.keymap.name == name, ui::Prominent, ui::Plain), true, UseKeymap(name = name))

    menus editor =
        song = length editor.song.tracks > 0
        playing = editor.songTicket != ""
        last = satSub (length editor.song.tracks) 1
        [
            Ui::section ("File", "", [command (editor, "Settings…", "settings", true, ShowSettings), command (editor, "Open Song…", "open", true, OpenTrack(index = -2)), command (editor, "Save", "save", true, SaveProject), command (editor, "Render Song", "render", song, RenderSong)]),
            Ui::section ("Edit", "", [command (editor, "Undo", "undo", length editor.past > 0, Undo), command (editor, "Redo", "redo", length editor.future > 0, Redo)]),
            Ui::section ("View", "", [command (editor, "Timeline", "timeline", true, ShowPage(page = TimelinePage)), command (editor, "Track Patch", "patch", true, ShowPage(page = PatchPage)), command (editor, "Bus Routing", "routing", true, ShowPage(page = MixPage)), command (editor, "Modules", "modules", true, ShowModules), command (editor, "Patch Controls", "controls", true, ShowDetails), command (editor, "Zoom In", "zoomIn", song && editor.page == TimelinePage, ZoomLanes(factor = 1.25)), command (editor, "Zoom Out", "zoomOut", song && editor.page == TimelinePage, ZoomLanes(factor = 0.8)), command (editor, "Zoom to Fit", "zoomFit", song && editor.page == TimelinePage, ZoomLanes(factor = 0.0))]),
            Ui::section ("Transport", "", [command (editor, "Return to Start", "start", song, PickTrack(index = editor.track, bar = 0)), command (editor, "Play Song", "playSong", song && !playing, PlaySong), command (editor, "Stop Song", "stopSong", playing, StopSong), command (editor, "Loop", "loop", song && !playing, ToggleLoop), command (editor, "Previous Track", "previousTrack", song && editor.track > 0, PickTrack(index = satSub editor.track 1, bar = editor.rollBar)), command (editor, "Next Track", "nextTrack", song && editor.track < last, PickTrack(index = satAdd editor.track 1, bar = editor.rollBar)), command (editor, "Previous Bar", "previousBar", song && editor.rollBar > 0, PickTrack(index = editor.track, bar = satSub editor.rollBar 1)), command (editor, "Next Bar", "nextBar", song, PickTrack(index = editor.track, bar = satAdd editor.rollBar 1))]),
            Ui::section ("Shortcuts", "", listAppend (mapList (Keymaps::names, \name => keymapChoice (editor, name))) (Ui::button ("Load From File…", "", LoadKeymap)))]

    routeInspector (editor, content) =
        frame = ui::Frames::plain
        header = Ui::framed (frame(frameHeight = ui::Pick::either (editor.page == PatchPage, 40, 114)), ui::Spacer)
        panel = Ui::framed (frame(frameGrow = true), content)
        Ui::row [ui::Spacer, Ui::framed (frame(frameWidth = 310), Ui::column [header, panel])]

    root () = content (paneled (editorSlice ()))

    detached () =
        editor = editorSlice ()
        content (paneled (editor(page = PatchPage)))

    (** [DAW-INSPECTOR] A Patch page shows the chosen module's properties in the patch panel docked beside the canvas, never on the canvas. *)
    export paneled editor = editor(detailsShown = editor.detailsShown || editor.selected >= 0)

    (** The stored editor after a step taken on its paneled view: the panel stays as stored unless the step itself opened or closed it. *)
    export unpaneled (before, after) = after(detailsShown = ui::Pick::either (after.detailsShown == (paneled before).detailsShown, before.detailsShown, after.detailsShown))

    content editor =
        match editor.outputEdit
            SongTiming bpm meter => Ui::layer [workspace editor, SongTimingEditor::form (editor, bpm, meter)]
            PluginSettings folder => Ui::layer [workspace editor, Ui::dialog ("Settings", Ui::column [Ui::field ("VST3 folder", folder, "Folder containing VST3 plug-ins", PluginPath), Ui::caption editor.message, Ui::row [Ui::button ("Cancel", "", CloseOutput), Ui::button ("Save settings", "", SaveSettings)]], CloseOutput)]
            BrowsingSends offset => Ui::layer [workspace editor, routeInspector (editor, SendList::form (editor, offset))]
            EditingSend draft => Ui::layer [workspace editor, routeInspector (editor, SendEditor::form (editor, draft))]
            EditingBus name => Ui::layer [workspace editor, routeInspector (editor, BusOutputs::form (editor, name))]
            NamingGroup proposed => Ui::layer [workspace editor, RoutingPicker::form (editor, proposed)]
            _ => Ui::contextMenu (workspace editor, listConcat (menus editor) (MixView::menus editor))

    workspace editor =
        pane = match editor.detailsShown && TimelineView::pageIndex editor.page == 0
            false => canvas editor
            true => Ui::aside (canvas editor, ui::Trailing, inspector editor, 320, Surface)
        grow = ui::Frames::plain
        Ui::framed (grow(frameGrow = true), pane)

    readyWindows editor = length (filterList (editor.editorWindows, \w => w.windowCycle > 1))

    stamp editor = JsonString "${readyWindows editor}:${length editor.editorWindows}:${editor.patchWindowSerial}:${editor.revision}:${editor.layoutRevision}:${editor.panX}:${editor.panY}:${editor.selected}:${editor.source}:${editor.outlet}:${editor.wireDragging}:${editor.wireMonitor}:${editor.wireX}:${editor.wireY}:${editor.selectedCable}:${editor.message}:${editor.pluginPath}:${editor.pluginSerial}:${length editor.catalog}:${editor.note}:${editor.armedNote}:${editor.paletteDrag}:${editor.paletteShown}:${editor.detailsShown}:${TimelineView::pageIndex editor.page}:${editor.track}:${editor.patchTrack}:${editor.selectedNote}:${RollEdits::stamp editor.rollDrag}:${editor.rollBar}:${editor.laneTop}:${editor.laneZoom}:${editor.laneStart}:${RoutingPicker::stamp editor}:${editor.songTicket}:${editor.keymap.name}:${editor.dial != DialIdle}:${editor.dialEntry}:${editor.dialOffset}:${editor.fineHeld}:${editor.songPath}:${length editor.song.tracks}"

    (** One coherent Signal rebuilds native and canvas controls after an accepted command. *)
    export regions (before, editor, frames, _) =
        handle static Signal<Editor<Graph, ui::Machine>>
            read => editor
        changed = signalChanges before editor stamp (signalDependencies editorSlice)
        primary = [Keyed::region (frames, "root", changed, root)]
        match editor.patchWindowSerial > 0 && editor.patchTrack >= 0
            false => primary
            true => match listGet editor.song.tracks editor.patchTrack
                Error _ => primary
                Success track => listAppend primary (Keyed::region (frames, "window:${editor.patchWindowSerial}:Patch — ${track.name}", changed, detached))

    token (name, light, dark) = ui::Token(tokenName = name, tokenLight = light, tokenDark = dark)

    (** Prism's theme is independent of a fixed machine document. *)
    export theme () = ui::Theme(tokens = [token ("button", "#E6DFF5", "#29213F"), token ("buttonText", "#201630", "#F2EDFF"), token ("accent", "#C2551C", "#FF8442"), token ("caution", "#986400", "#FFCD75"), token ("good", "#14776F", "#4FDAD3"), token ("danger", "#BE294B", "#FF7892"), token ("background", "#F4EFFB", "#100D21"), token ("text", "#201630", "#F2EDFF")], spacing = [4, 0, 12, 20, 28, 36], feedback = 120, settle = 220)
