// [DAW-TRACK-PATCH] Prism's edits go back into the project: the inverse of TrackPatches.
namespace daw

(** A graph Prism edited becomes the track's routing again, so the one project file holds every patch.
    A setting that followed the note keeps following it: its value is divided back by middle C's frequency
    (pitch) or full velocity. Every other parameter is stored as a constant. *)
module PatchRecords
    middle () = synth::Waves::midiFrequency 60.0

    // The routing name of each module a project can hold; the rest exist only inside Prism.
    named (prior, n) = match n.processor
        synth::Exciter seed => Success(value = PatchNode(identity = 0, component = "exciter", size = 0, seed = seed, asset = "", settings = []))
        synth::SamplePlayer resource => Success(value = PatchNode(identity = 0, component = "sample", size = 0, seed = 0, asset = ui::Pick::either (resource.name == PatchVoices::builtinName, "", resource.name), settings = []))
        synth::Granular resource capacity seed => Success(value = PatchNode(identity = 0, component = "grainCloud", size = capacity, seed = seed, asset = ui::Pick::either (resource.name == PatchVoices::builtinName, "", resource.name), settings = []))
        synth::Oscillator => plain (ui::Pick::either (length n.inputs == 0, "sine", "midiOscillator"))
        synth::TableOscillator table => configured ("wavetable", table.size, "harmonics", table.harmonics)
        synth::Additive => plain "additive"
        synth::PhaseOperator => plain "operator"
        synth::Bowed capacity => sized ("bowed", capacity)
        synth::Lfo => plain "lfo"
        synth::Resonator => plain "resonator"
        synth::Modal => plain "modal"
        synth::Waveguide capacity => sized ("waveguide", capacity)
        synth::StrikeComb capacity => sized ("strikeComb", capacity)
        synth::FractionalDelay capacity => sized ("fractionalDelay", capacity)
        synth::LossFilter => plain "lossFilter"
        synth::Allpass => plain "allpass"
        synth::Filter => plain (ui::Pick::either (length n.inputs == 2, "modulatedLowpass", "lowpass"))
        _ => processing (prior, n)

    processing (prior, n) = match n.processor
        synth::External identifier latency => synth::Outcomes::carried (synth::PluginDocuments::stored (n, identifier, latency), \descriptor => Success(value = PatchNode(identity = n.identity, component = "vst3", size = 0, seed = 0, asset = descriptor, settings = [])))
        synth::Shaper => plain "shaper"
        synth::Shifter => plain "shifter"
        synth::Spectral size hop => spectral (prior, n, size, hop)
        synth::Reverb => plain "reverb"
        synth::Smoother => plain "smoother"
        synth::Amplifier => plain "gain"
        synth::ModulatedGain => plain (ui::Pick::either (stereo n.inputs, "stereoModulatedGain", "modulatedGain"))
        synth::Mixer => outputWidth ("mixer", n)
        synth::Panner => outputWidth ("panner", n)
        synth::Delay samples => sized ("delay", samples)
        synth::MidiNotes => plain "midiNote"
        synth::Split => sized ("split", length n.outputs)
        synth::Join => sized ("join", length n.inputs)
        synth::Route entries => savedMap (n, entries)
        synth::Stereo => plain "stereo"
        synth::Downmix => plain "downmix"
        synth::Sink => plain (ui::Pick::either (stereo n.inputs, "stereoOutput", "output"))
        _ => Error(message = "${synth::Kinds::kind n.processor} modules can't be saved in a song project yet.")

    // A full spectral module keeps its authored name and hop. The pitch preset has a fixed quarter-window hop.
    spectral (prior, n, size, hop) = match hop == intDiv size 4 && ui::Lists::any (n.parameters, \p => p.key == "transform" && p.initial == 6.0) && !ui::Lists::any (prior, \item => item.component == "spectral")
        true => sized ("pitchShifter", size)
        false => configured ("spectral", size, "hop", hop)

    savedMap (n, entries) = match listGet n.inputs 0
        Error _ => Error(message = "The channel route needs an input port.")
        Success port => synth::Outcomes::carried (sized ("route", port.channels), \item => Success(value = item(settings = mapList (toList (range (0, length entries)), \i => Setting(key = "channel${i}", value = toFloat (listGet entries i ?: -1), follow = Constant)))))

    stereo inputs = match listGet inputs 0
        Success port => port.channels == 2
        Error _ => false

    configured (component, size, key, amount) = synth::Outcomes::carried (sized (component, size), \item => Success(value = item(settings = [Setting(key = key, value = toFloat amount, follow = Constant)])))

    plain component = sized (component, 0)

    outputWidth (component, n) = synth::Outcomes::carried (PatchVoices::told (synth::ClipLayouts::channels n), \width => sized (component, width))

    sized (component, size) = Success(value = PatchNode(identity = 0, component = component, size = size, seed = 0, asset = "", settings = []))

    // A setting the routing had keeps its follow; its value comes back from the graph.
    kept (setting, value) = match setting.follow
        Constant => setting(value = value)
        Pitched => match ArrangeMath::scaled (setting.value, middle ()) == value
            true => setting
            false => setting(value = synth::FitMath::normalised (value, 0.0, middle ()))
        Struck => setting(value = value)

    follows (n, key) = match n.processor
        synth::Granular _ _ _ => key == "rate"
        _ => key == "frequency" && synth::Kinds::keyFrequency n.processor

    // Preserve explicit authored bindings. A voice added from the library transposes with the timeline.
    setting (prior, n, p: synth::Parameter) = match listGet prior 0
        Success before => match listGet (filterList (before.settings, \s => s.key == p.key)) 0
            Success had => kept (had, p.initial)
            Error _ => Setting(key = p.key, value = p.initial, follow = Constant)
        Error _ => match follows (n, p.key)
            true => Setting(key = p.key, value = synth::FitMath::normalised (p.initial, 0.0, middle ()), follow = Pitched)
            false => Setting(key = p.key, value = p.initial, follow = Constant)

    record (routing, n) =
        prior = filterList (routing.nodes, \item => item.identity == n.identity)
        synth::Outcomes::carried (named (prior, n), \item => Success(value = item(identity = n.identity, settings = listConcat item.settings (mapList (n.parameters, \p => setting (prior, n, p))))))

    appended (carry, n, routing) = match carry
        Error why => Error(message = why)
        Success nodes => synth::Outcomes::carried (record (routing, n), \item => Success(value = listAppend nodes item))

    (** The routing `graph` stores, settings that followed the note in `routing` still following it. *)
    export routed (routing, graph) = synth::Outcomes::carried (foldList (graph.nodes, Success(value = []), \(carry, n) => appended (carry, n, routing)), \nodes => Success(value = routing(nodes = nodes, cables = mapList (graph.cables, \c => PatchCable(source = c.source, outlet = c.outlet, destination = c.destination, inlet = c.inlet)))))

    (** The track with `graph` as its patch; a built-in instrument whose patch is unchanged stays built in. *)
    export stored (track, graph) = match TrackPatches::patch track
        Success opened => match structuralEquals (opened, graph)
            true => Success(value = track)
            false => edited (track, graph)
        Error _ => edited (track, graph)

    edited (track, graph) = synth::Outcomes::carried (routed (TrackPatches::routing track.instrument, graph), \routing => Success(value = track(instrument = PatchInstrument(routing = routing))))

    (** Publish an edited patch without reloading the saved instrument or its samples on the UI thread. *)
    export live (song, index, graph) = match listGet song.tracks index
        Error _ => Error(message = "The selected track is missing.")
        Success track => synth::Outcomes::carried (edited (track, graph), \next => Projects::replaced (song, index, next))

    (** The arrangement with track `index` storing `graph`. *)
    export saved (arrangement, index, graph) = match listGet arrangement.tracks index
        Error _ => Error(message = "The arrangement has no track ${satAdd index 1}.")
        Success track => synth::Outcomes::carried (stored (track, graph), \next => Projects::replaced (arrangement, index, next))

    (** Keep the canvas coordinates with their track. Moving a module leaves an unchanged built-in instrument intact. *)
    export savedAt (arrangement, index, graph, positions) = match listGet arrangement.tracks index
        Error _ => Error(message = "The selected track is missing.")
        Success track => synth::Outcomes::carried (stored (track, graph), \next => Projects::replaced (arrangement, index, next(positions = filterList (positions, \at => ui::Lists::any (graph.nodes, \node => node.identity == at.layoutNode)))))
