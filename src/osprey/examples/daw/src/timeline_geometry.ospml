namespace synth

(** Timeline, piano roll and mix table placement, in Prism's 1440 × 940 scene units [DAW-PAGES]. *)
module TimelineGeometry
    (** The bar (from 0, four beats each) a beat falls in. *)
    export measure (top, bottom) = floatDiv (top * 4.0, bottom)

    (** Bar. *)
    export bar (beat, size) = floor (floatDiv (beat, size))

    (** The bar a beat falls in, but never past the bar holding the song's last sound: a song `beats` long that ends on a bar line has no bar after it to play [DAW-TRANSPORT-PLAYHEAD]. *)
    export playableBar (beat: float, beats, size) =
        last = match beats <= 0.0
            true => 0.0
            false => ceil (floatDiv (beats, size)) - 1.0
        FitMath::clip (bar (beat, size), 0.0, last)

    (** The beat a bar (from 0) starts on. *)
    export barStart (index: float, size) = index * size

    (** The song overview in the strip spans x 468 to 792: one column per bar, two units apart, as tall as the bar is busy (2 to 25 units above y 122) [DAW-HEADER]. *)
    export overviewX (index, bars) = 468.0 + floatDiv (index, bars) * 324.0

    (** Overview width. *)
    export overviewWidth bars = floatDiv (324.0, bars) - 2.0

    (** Overview top. *)
    export overviewTop (count, most) = match most <= 0.0
        true => 120.0
        false => 120.0 - floatDiv (count, most) * 23.0

    (** A song page is 1440 by 940 units and fits its region whole. In a region wider than that shape the page keeps its height (the region is 940 units tall) and sits in the middle: this is how far right it starts. *)
    export centred (viewWidth, viewHeight) = match viewHeight > 939.0 && viewHeight < 941.0 && viewWidth > 1440.0
        true => (viewWidth - 1440.0) / 2.0
        false => 0.0

    (** Arrangement lanes span x 198 to 1092. They show `span` beats from beat `first`: the whole song until it is zoomed [DAW-TIMELINE-ZOOM]. *)
    export laneX (beat, first, span) = 198.0 + floatDiv (beat - first, span) * 894.0

    (** Lane beat. *)
    export laneBeat (x, first, span, beats) = FitMath::clip (first + (x - 198.0) / 894.0 * span, 0.0, beats)

    (** A lane position kept between the lanes' two edges. *)
    export laneEdge x = FitMath::clip (x, 198.0, 1092.0)

    (** Zoom 1 fits the whole song; the closest zoom shows one beat across the lanes. *)
    export zoomed (zoom, factor, beats) =
        most = match beats < 1.0
            true => 1.0
            false => beats
        FitMath::clip (zoom * factor, 1.0, most)

    (** Lane span. *)
    export laneSpan (beats, zoom) = floatDiv (beats, zoom)

    (** The first beat shown: never before the song, nor so late that the view runs past its end. *)
    export laneFirst (start, span, beats) = FitMath::clip (start, 0.0, beats - span)

    (** The first beat shown after a zoom to `next` beats that keeps `anchor` where it was; an anchor outside the view comes to its nearer edge. *)
    export zoomFirst (anchor, first, span, next, beats: float) = laneFirst (anchor - FitMath::clip (floatDiv (anchor - first, span), 0.0, 1.0) * next, next, beats)

    (** The first beat shown once the playhead moved: unchanged while the playhead and the two bars after it are in view, else the playhead comes to the nearer edge. *)
    export followFirst (playhead, first, span, beats: float) =
        reach = match span < 8.0
            true => span
            false => 8.0
        match playhead < first
            true => laneFirst (playhead, span, beats)
            false => match playhead + reach > first + span
                true => laneFirst (playhead + reach - span, span, beats)
                false => first

    (** Ruler divisions in beats: a line every `rulerStep`, a number every `rulerMajor`. Bars with every fourth numbered, then every bar, then beats, then sixteenths, so labels never crowd or thin out. *)
    export rulerStep (span, size, unit) = match span > size * 4.0
        true => size
        false => match span > size
            true => unit
            false => unit / 4.0

    (** Ruler major. *)
    export rulerMajor (span, size, unit) = match span > size * 16.0
        true => size * 4.0
        false => match span > size
            true => size
            false => unit

    (** Ruler beat. *)
    export rulerBeat (first, step, index) = (floor (floatDiv (first, step)) + index) * step

    (** Ruler count. *)
    export rulerCount (span, step) = ceil (floatDiv (span, step)) + 2.0

    (** 1 when `beat` falls on a multiple of `major`, else 0. *)
    export onDivision (beat, major) = match beat - floor (floatDiv (beat, major)) * major < 0.001
        true => 1.0
        false => 0.0

    (** The beat within its bar, from 1. *)
    export beatInBar (beat, size, unit) = floor (floatDiv (beat - floor (floatDiv (beat, size)) * size, unit)) + 1.0

    (** [DAW-LAYOUT-FILL] The lanes' scrollbar runs y 221 to 438 beside `rows` visible lanes of `count` tracks. Its thumb starts at the share of the tracks above the first visible one and is as tall as the share that is visible. *)
    export thumbTop (top, count) = 221.0 + floatDiv (217.0 * top, count)

    (** Thumb height. *)
    export thumbHeight (rows, count) = floatDiv (217.0 * rows, count)

    (** The first visible track when the thumb's middle is put under `y`: any row, not only whole pages. *)
    export scrollTop (y, rows, count) = FitMath::clip (floor ((y - 221.0) / 217.0 * count - rows / 2.0 + 0.5), 0.0, count - rows)

    (** The first visible track that keeps track `index` in view, moving no further than it must. *)
    export keptTop (top, index, rows, count) =
        wanted = match index < top
            true => index
            false => match index >= top + rows
                true => index - rows + 1.0
                false => top
        last = match count > rows
            true => count - rows
            false => 0.0
        FitMath::clip (wanted, 0.0, last)

    (** Row y. *)
    export rowY (index, height) = 221.0 + index * height

    (** Row at. *)
    export rowAt (y, height) = floor (floatDiv (y - 221.0, height))

    (** The pitch silhouette of a track fits between the two inset edges of its lane. *)
    export lanePitch (top, height, pitch, low, high) = match high <= low
        true => top + height / 2.0
        false => top + 2.0 + floatDiv (high - pitch, high - low) * (height - 4.0)

    (** The piano roll shows two bars (eight beats) from x 76 to 1110. *)
    export rollX (beat, first, size) = 76.0 + FitMath::clip (floatDiv (beat - first, size), 0.0, 2.0) * 517.0

    (** Roll width. *)
    export rollWidth (beat: float, length, first: float, size) = rollX (beat + length, first, size) - rollX (beat, first, size)

    (** Pitch rows fill y 542 to 802, the highest pitch at the top. *)
    export pitchHeight rows = floatDiv (260.0, rows)

    (** Pitch y. *)
    export pitchY (pitch, high, rows) = 542.0 + (high - pitch) * floatDiv (260.0, rows)

    (** [DAW-ROLL-KEYS] The pitch of the key row under `y`: the inverse of `pitchY`. *)
    export keyPitch (y, high, rows) = high - floor (floatDiv (y - 542.0, floatDiv (260.0, rows)))

    (** Reserve the native typeface's ascent and descent within the two inset note edges. *)
    export noteLabelSize height = FitMath::clip ((height - 2.0) / 1.32, 0.0, 12.0)

    (** Note label y. *)
    export noteLabelY (top, height, size) = top + (height - size * 1.32) / 2.0 - 1.0

    (** Velocity stems share the same note start coordinate as the piano roll. *)
    export velocityHeight value = FitMath::clip (value, 0.0, 1.0) * 43.0

    (** Dragging preserves the note's original timing offset and moves by sixteenths (one quarter beat). *)
    export draggedStart (start, offset, size) =
        beat = start + floor (offset * size / 517.0 * 4.0 + 0.5) / 4.0
        match beat < 0.0
            true => 0.0
            false => beat

    (** One vertical pitch row is one semitone. *)
    export draggedPitch (pitch, offset, height) = FitMath::clip (pitch + floor (floatDiv (offset, height) + 0.5), 0.0, 127.0)

    (** The stem baseline is y 894 and its 43-unit range is the full velocity. *)
    export stemVelocity y = FitMath::clip ((894.0 - y) / 43.0, 0.0, 1.0)

    (** Mix table rows start at y 235 and share 629 units, at most 37 each. *)
    export mixHeight count = match count <= 17.0
        true => 37.0
        false => floatDiv (629.0, count)

    (** Mix y. *)
    export mixY (index, height) = 235.0 + index * height

    (** Mix at. *)
    export mixAt (y, height) = floor (floatDiv (y - 235.0, height))

    (** A level meter's filled width: `value` of `full`, within `width`. *)
    export meter (value, full, width) = FitMath::clip (floatDiv (value, full), 0.0, 1.0) * width

    (** Read a horizontal fader on its labelled range, rounded to hundredths. *)
    export fader (x, left, width, low, high) = floor ((low + FitMath::clip (floatDiv (x - left, width), 0.0, 1.0) * (high - low)) * 100.0 + 0.5) / 100.0

    (** Whole percent and hundredths, rounded to nearest. *)
    export percent value = floor (value * 100.0 + 0.5)

    (** [DAW-TRANSPORT-LIVE] Seconds of audio heard: the frame clock advanced by `elapsed`, held between what the device has finished (`returned` frames) and what it was given (`accepted`), so the playhead waits when sound does. *)
    export heardSeconds (clock, elapsed, returned, accepted, rate) = FitMath::clip (clock + elapsed, floatDiv (returned, rate), floatDiv (accepted, rate))

    (** The beat sounding `seconds` into one pass from `first` over `span` beats; it stops at the end. *)
    export passBeat (first, span, seconds, tempo) = first + FitMath::clip (seconds * tempo / 60.0, 0.0, span)

    (** The beat sounding `seconds` into a loop of `span` beats from `first`: each pass starts again at `first`. *)
    export loopBeat (first, span, seconds, tempo) =
        beats = seconds * tempo / 60.0
        first + (beats - floor (floatDiv (beats, span)) * span)

    (** The first bar of the two the piano roll shows while `beat` sounds: it turns the page every two bars from the start marker's bar `start`. *)
    export rollPage (beat, start, size) = match beat < start * size
        true => start
        false => start + floor (floatDiv (beat - start * size, 2.0 * size)) * 2.0

    (** [DAW-TRANSPORT-RANGE] The beat Play ends on: the end marker's bar line when it is after the start bar and inside the song, else the song's end. *)
    export rangeEnd (start: float, finish, beats, size) = match finish > start && finish * size < beats
        true => finish * size
        false => beats

    (** The end marker's bar under beat `beat`: the nearest bar line, at least one bar after the start bar. *)
    export endBar (beat, start, size) =
        nearest = floor (floatDiv (beat, size) + 0.5)
        match nearest <= start
            true => start + 1.0
            false => nearest

    (** The start marker's bar under beat `beat`: the nearest bar line, from the first bar to the bar before the end marker (`finish` bar lines from 0, or 0 for the song's end) [DAW-TRANSPORT-RANGE]. *)
    export startBar (beat, finish, beats, size) =
        whole = match beats <= 0.0
            true => 0.0
            false => ceil (floatDiv (beats, size)) - 1.0
        last = match finish > 0.0 && finish * size < beats
            true => finish - 1.0
            false => whole
        FitMath::clip (floor (floatDiv (beat, size) + 0.5), 0.0, last)

    (** A marker's handle at `at` is grabbed by a press at `x`: within six units either side. *)
    export grabs (x, at) = x >= at - 6.0 && x <= at + 6.0
