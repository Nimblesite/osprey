// [PRISM-TIMELINE-GRAPH] The same dry-output chooser opens on the inspector or a mixer row.
namespace synth

import ui::Ui
import ui::Scenes
import ui::Runtime

(** The selected track’s output menu, shared by Timeline and Mix. *)
module RoutingPicker
    capacity = 4
    rowHeight = 43.0
    width = 292.0

    (** Available dry destinations in display order. The empty name denotes Master. *)
    export names editor = listConcat [""] (mapList (editor.song.buses, \bus => bus.name))

    (** Whether the canvas is choosing an output. *)
    export choosing editor = match editor.outputEdit
        ChoosingOutput _ => true
        _ => false

    (** The picker state that requires its region to redraw. *)
    export stamp editor = match editor.outputEdit
        BrowsingSends offset => "sends ${offset}"
        EditingBus name => "bus ${name}"
        EditingSend draft => "send ${draft.editingId} ${draft.routeOffset} ${draft.sourceKey} ${draft.targetBus} ${draft.levelText} ${draft.sendActive}"
        SongTiming bpm meter => "timing ${bpm} ${meter}"
        PluginSettings folder => "settings ${folder}"
        NodeMenu id x y => "node ${id} ${x} ${y}"
        OutputClosed => "closed"
        ChoosingOutput focus => "choose ${focus}"
        NamingGroup proposed => "name ${proposed}"

    (** Open on the current destination, or on the first destination of a requested page. *)
    export open (editor, index, offset) = match listGet editor.song.tracks index
        Error _ => Runtime::step (editor(message = "Select a track first."))
        Success track =>
            selected = DawSession::focused (editor, index)
            focus = match offset < 0
                true => ui::Lists::position (names selected, \name => name == track.bus)
                false => offset
            Runtime::step (selected(outputEdit = ChoosingOutput(focus = focus)))

    start (editor, focus) =
        last = satSub (length (names editor)) 1
        satMul (intDiv (ui::Pick::either (focus > last, last, focus)) capacity) capacity

    visible (editor, offset) =
        count = length (names editor)
        end = satAdd offset capacity
        toList (range (offset, ui::Pick::either (end < count, end, count)))

    left editor = ui::Pick::either (editor.page == MixPage, 364.0, 1124.0)

    top editor = match editor.page
        MixPage =>
            height = TimelineGeometry::mixHeight (toFloat (length editor.song.tracks))
            y = TimelineGeometry::mixY (toFloat editor.track, height) + height
            ui::Pick::either (y > 612.0, y - 282.0 - height, y)
        _ => 562.0

    rowsEnd (editor, offset) = top editor + 38.0 + toFloat (length (visible (editor, offset))) * rowHeight

    paged editor = length (names editor) > capacity

    words (text, x, y, size, colour) = TimelineView::label (text, x, y, size, colour, 0, 44)

    option (editor, current, offset, focus, index) = match listGet (names editor) index
        Error _ => []
        Success name =>
            x = left editor
            y = top editor + 38.0 + toFloat (satSub index offset) * rowHeight
            selected = name == current
            label = ui::Pick::either (name == "", "Master", name)
            detail = ui::Pick::either (name == "", "Stereo output", "Stereo group")
            mark = ui::Pick::either (selected, "✓", "")
            [TimelineView::box (x + 5.0, y, width - 10.0, rowHeight - 1.0, ui::Pick::either (index == focus, Scenes::rgb (64, 45, 59), Scenes::rgb (35, 24, 59)), 42), Scenes::disc (x + 17.0, y + 18.0, 4.0, TimelineView::accent (), 44), words (label, x + 36.0, y + 3.0, 15.0, TimelineView::ink ()), words (detail, x + 36.0, y + 23.0, 11.0, TimelineView::dim ()), words (mark, x + width - 29.0, y + 10.0, 15.0, TimelineView::accent ())]

    pages (editor, offset, y) = match paged editor
        false => []
        true => [words ("‹ Previous", left editor + 15.0, y + 6.0, 13.0, ui::Pick::either (offset > 0, TimelineView::ink (), TimelineView::dim ())), words ("Next ›", left editor + 199.0, y + 6.0, 13.0, ui::Pick::either (satAdd offset capacity < length (names editor), TimelineView::ink (), TimelineView::dim ()))]

    shapesAt (editor, focus, current) =
        offset = start (editor, focus)
        x = left editor
        y = top editor
        end = rowsEnd (editor, offset)
        foot = end + ui::Pick::either (paged editor, 32.0, 0.0)
        panel = EditorView::panel (x, y, width, foot + 48.0 - y, 6175374, 40)
        fill = EditorView::panel (x + 1.0, y + 1.0, width - 2.0, foot + 46.0 - y, 2299963, 41)
        ui::Lists::flatten [[panel, fill, words ("OUTPUT DESTINATION", x + 14.0, y + 13.0, 11.0, TimelineView::dim ())], ui::Lists::flatten (mapList (visible (editor, offset), \i => option (editor, current, offset, focus, i))), pages (editor, offset, end), [TimelineView::box (x + 8.0, foot, width - 16.0, 1.0, TimelineView::dim (), 43), words ("+   New stereo bus…", x + 14.0, foot + 16.0, 15.0, ui::Pick::either (focus == length (names editor), TimelineView::accent (), TimelineView::ink ()))]]

    (** Draw the open picker above the existing track view. *)
    export shapes editor = match editor.outputEdit
        ChoosingOutput offset => match listGet editor.song.tracks editor.track
            Success track => shapesAt (editor, offset, track.bus)
            Error _ => []
        _ => []

    (** Resolve a pointer on the open chooser or dismiss it when the pointer is outside. *)
    export at (editor, focus, x, y) =
        offset = start (editor, focus)
        end = rowsEnd (editor, offset)
        foot = end + ui::Pick::either (paged editor, 32.0, 0.0)
        match x >= left editor && x < left editor + width && y >= top editor + 38.0 && y < foot + 48.0
            false => Success(value = CloseOutput)
            true => match y >= foot
                true => Success(value = NewGroup)
                false => match y >= end
                    true => Success(value = ChooseOutput(index = editor.track, offset = pageAt (editor, offset, x)))
                    false => match listGet (names editor) (satAdd offset (floatToInt ((y - top editor - 38.0) / rowHeight) ?: 0))
                        Success name => Success(value = AssignBus(index = editor.track, bus = name))
                        Error _ => Error(message = "The destination is no longer available.")

    pageAt (editor, offset, x) = match x < left editor + width / 2.0
        true => ui::Pick::either (offset >= capacity, satSub offset capacity, 0)
        false => ui::Pick::either (satAdd offset capacity < length (names editor), satAdd offset capacity, offset)

    (** Arrow keys step through every project bus. Enter assigns the focused destination. *)
    export key (editor, focus, name, down) = match down
        false => Runtime::step editor
        true => match name
            "escape" => Runtime::step (editor(outputEdit = OutputClosed))
            "up" => open (editor, editor.track, ui::Pick::either (focus > 0, satSub focus 1, 0))
            "down" => open (editor, editor.track, ui::Pick::either (focus < length (names editor), satAdd focus 1, focus))
            "enter" => match listGet (names editor) focus
                Success bus => DawSession::routed (editor, editor.track, bus)
                Error _ => Runtime::step (editor(outputEdit = NamingGroup(proposed = ""), message = ""))
            _ => Runtime::step editor

    (** A native text field and a single action that saves both the group and its assignment. *)
    export form (editor, name) =
        style = ui::Frames::plain
        buttons = Ui::row [Ui::button ("Cancel", "", CloseOutput), Ui::action ("Create and assign", "", ui::Prominent, trim name != "", CommitGroup)]
        fields = [Ui::field ("Bus name", name, "Keys bus", GroupName), buttons]
        body = match editor.message == ""
            true => fields
            false => listAppend fields (Ui::text editor.message)
        Ui::framed (style(frameWidth = 340, frameHeight = 196), Ui::themed (EditorView::theme (), Ui::section ("New stereo bus", "", body)))

(** [DAW-MIX-BUS-OUTPUT] Inspect and reassign any named stereo group's onward output. *)
module BusOutputs
    (** Select the source group whose path is shown. *)
    export picked (editor, name) = match daw::BusMix::named (editor.song, name)
        Error why => ui::Runtime::step (editor(message = why))
        Success bus => ui::Runtime::step (editor(outputEdit = EditingBus(busName = bus.name), message = ""))

    (** Start with the selected track's group, or the first declared group. *)
    export open editor = match listGet editor.song.buses 0
        Error _ => ui::Runtime::step (editor(message = "Create a stereo bus first."))
        Success first => match listGet editor.song.tracks editor.track
            Success voice => picked (editor, ui::Pick::either (voice.bus == "", first.name, voice.bus))
            Error _ => picked (editor, first.name)

    (** A valid selection commits once and displays the routed graph. A refused cycle retains its last output. *)
    export route (editor, destination) = match editor.outputEdit
        EditingBus name =>
            result = daw::BusPaths::routed (editor.song, name, ui::Pick::either (destination == "Master", "", destination))
            step = DawSession::savedTrack (editor, editor.track, result)
            next = step.stepStore
            step(stepStore = next(outputEdit = EditingBus(busName = name)))
        _ => ui::Runtime::step editor

    (** The output controls and complete signal path to Master for the selected group. *)
    export form (editor, name) =
        groups = editor.song.buses
        choices = mapList (groups, \bus => ui::Ui::choice (bus.name, bus.name))
        output = match daw::BusMix::named (editor.song, name)
            Success bus => ui::Pick::either (bus.output == "", "Master", bus.output)
            Error _ => ""
        path = daw::BusPaths::path (groups, name) ?: []
        current = ui::Ui::picker ("Group bus", choices, name, PickBus)
        destinations = listPrepend (filterList (choices, \item => item.choiceKey != name)) (ui::Ui::choice ("Master", "Master"))
        next = ui::Ui::picker ("Stereo output", destinations, output, RouteBus)
        message = ui::Pick::either (editor.message == "" || startsWith editor.message "Saved ", [], [ui::Ui::text editor.message])
        style = EditorView::theme ()
        controls = [ui::Ui::styled ("BUS ROUTING", ui::Eyebrow, ui::Secondary), ui::Ui::styled ("Group outputs", ui::Heading, ui::Primary), current, next, ui::Ui::section ("Signal path", "", mapList (path, ui::Ui::text))]
        ui::Ui::themed (style(spacing = [4, 6, 12, 20, 28, 36]), ui::Ui::column (listConcat controls (listAppend message (ui::Ui::button ("Close", "", CloseOutput)))))
