// [PRISM-ROUTING-AUDIO] The preview renders the actual typed graph, never a parallel fixed patch.
namespace synth

import ui::Runtime
import ui::Requests

(** Bounded offline graph audition while the continuous device engine is integrated. *)
module Preview
    blocks (plan, snapshot, held, remaining, chunks) = match remaining == 0
        true => WaveFiles::monoFloat (48000, foldList (chunks, [], \(all, chunk) => listConcat all chunk))
        false => synth::Outcomes::carried (Renderer::block (plan, 48000.0, snapshot, held, 256), \next => blocks (plan, snapshot, next, satSub remaining 1, listAppend chunks next.samples))

    (** Render 256 ms of the connected mono graph as float32 PCM, with explicit failures. *)
    export wave graph = match Graphs::prepare graph
        Invalid _ => Error(message = InvalidConfiguration(detail = "The patch has invalid routes."))
        Valid plan => synth::Outcomes::carried (Renderer::start graph, \initial => blocks (plan, Parameters::initial graph, initial, 48, []))

    // File::Temp creates the file exclusively and removes it after playback, including failures.
    script = "use File::Temp qw(tempfile); die 'invalid PCM hex' unless $ARGV[0] =~ /\\A[0-9A-F]+\\z/ && length($ARGV[0]) % 2 == 0; my ($f,$path)=tempfile('osprey-prism-XXXXXX',TMPDIR=>1,UNLINK=>1); binmode $f; print {$f} pack('H*',$ARGV[0]) or die 'PCM write failed'; close $f or die 'PCM close failed'; system('/usr/bin/afplay',$path)==0 or die 'Audio playback failed'; print qq({\"event\":\"audio.preview\",\"frames\":12288}\\n);"

    (** Play checked PCM from either the built-in or hosted graph renderer. *)
    export playWave (editor, hex) = Runtime::asking (editor(message = "Playing the current patch."), [Requests::ask ("prism-preview", ui::Run(executable = "/usr/bin/perl", arguments = ["-e", script, hex], timeout = 10000, outputLimit = 4096, plist = false, runSlice = "prism-preview"))])

    (** Device work stays in a host request; graph construction and PCM stay in Osprey. *)
    export play (editor, platform) = match platform == "macos"
        false => Runtime::step (editor(message = "This preview device adapter currently requires macOS."))
        true => match wave editor.graph
            Error why => Runtime::step (editor(message = Faults::detail why))
            Success hex => playWave (editor, hex)

    (** Host failures remain visible instead of silently leaving the app in a playing state. *)
    export completed (editor, ticket, outcome) = match ticket == "prism-preview"
        false => Runtime::step editor
        true => match ProcessResults::checked outcome
            Error why => Runtime::step (editor(message = "Playback failed: ${why}"))
            Success _ => Runtime::step (editor(message = "Preview finished."))
