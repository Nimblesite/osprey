namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type PluginClass =
    classId : string
    className : string
    bundle : string

type PluginWindow =
    windowNode : int
    windowClass : string
    windowTrack : int
    windowProject : string
    windowSerial : int
    windowCycle : int
    windowFocus : bool
    windowClosing : bool
    windowHandle : string
    windowSent : List<float>

type PluginBinding =
    pluginNode : int
    pluginModule : string
    pluginClass : string
    pluginName : string

type RenderSession =
    sessionNode : int
    sessionKey : string

type DevicePending S =
    deviceState : S
    deviceChannels : int

type DeviceReceipt =
    acceptedFrames : int
    returnedFrames : int
    queuedFrames : int
    deviceChannels : int
    emptyCallbacks : int
    deviceRunning : bool

type CablePoint =
    x : float
    y : float

type CableCurve =
    sx : float
    sy : float
    dx : float
    dy : float

type GraphSnapshot G =
    savedGraph : G
    savedSong : daw::Arrangement
    savedTrack : int
    savedPatchTrack : int
    savedTimelineNote : int
    savedNextIdentity : int
    savedPositions : List<daw::NodePosition>
    savedFlow : List<daw::NodePosition>
    savedBindings : List<PluginBinding>
