// [DAW-INSPECTOR] A module the skin has no artwork for gets the inspector the others have: its name, a dial
// for every parameter ([DAW-CONTROLS-DIAL]), drawn on the canvas in the skin's style. Nothing here points at
// another panel: what can be changed is changed where it is shown.
namespace synth

import ui::Scenes

(** The canvas inspector's parts that come from the graph: a custom module's parameters. Cables are read on the canvas, never listed here. *)
module ModuleInspector
    track () = 276.0

    left editor = EditorView::rightX (editor, 1234.0)

    // The selected module when the skin draws no inspector for it.
    custom editor = match Graphs::node (editor.graph, editor.selected)
        Invalid _ => []
        Valid n => ui::Pick::either (!editor.detailsShown && PrismArt::role n.processor == "custom", [n], [])

    dialTop () = 240.0

    customShapes (editor, n) =
        x = left editor
        rows = length n.parameters
        heading = ui::Pick::either (rows == 0, [], [EditorView::text ("Parameters", x, 190.0, 16.0, 210, 9)])
        listConcat [Scenes::rect (EditorView::rightX (editor, 1374.0), 446.0, 304.0, 690.0, 0.0, Scenes::rgb (19, 17, 35), 7), EditorView::text (EditorView::componentName (editor, n), x, 128.0, 24.0, 240, 8)] (listConcat heading (Dials::shapes (editor, n, x, dialTop (), track (), 9)))

    (** What the graph adds to the canvas inspector for the selected module. *)
    export shapes editor = match listGet (custom editor) 0
        Error _ => []
        Success n => customShapes (editor, n)

    (** A custom module's dials as hit areas, named after the module and the parameter. *)
    export access editor = match listGet (custom editor) 0
        Error _ => []
        Success n => Dials::access (editor, n, left editor, dialTop (), track ())

    (** A press or a drag on one of those dials turns its parameter; anywhere else is not the inspector's. *)
    export pointed (editor, px, py, down) = match listGet (custom editor) 0
        Error _ => Error(message = "")
        Success n => Dials::pointed (editor, n, left editor, dialTop (), track (), px, py, down)
