// [DAW-PROJECT] The one song project file: timeline notes, each track's routing (gain, pan)
// and each track's patch all live in it. These are the checked edits the daw makes to it.
namespace daw

(** Pure edits to a song project, and the excerpt the transport plays. A refused edit changes nothing. *)
module Projects
    swapped (tracks, index, next, at) = match at == index
        true => next
        false => listGet tracks at ?: next

    (** The item at `index`, or `complaint` when the list holds nothing there. *)
    export required (items, index, complaint) = match listGet items index
        Error _ => Error(message = complaint)
        Success item => Success(value = item)

    (** The value when it lies from `low` to `high`, else `complaint`. *)
    export limited (value, low, high, complaint) = match value >= low && value <= high
        false => Error(message = complaint)
        true => Success(value = value)

    (** The project with the track at `index` replaced by `next`. *)
    export replaced (arrangement, index, next) = synth::Outcomes::carried (required (arrangement.tracks, index, "There is no track ${satAdd index 1}."), \_ =>
        Success(value = arrangement(tracks = mapList (toList (range (0, length arrangement.tracks)), \at => swapped (arrangement.tracks, index, next, at)))))

    (** Set track `index`'s gain (0–4) and pan (−1 left to 1 right). *)
    export mixed (arrangement, index, gain, pan) = match ArrangeMath::mixable (gain, pan)
        false => Error(message = "Gain must be 0 to 4 and pan -1 to 1.")
        true => synth::Outcomes::carried (required (arrangement.tracks, index, "There is no track ${satAdd index 1}."), \voice =>
            replaced (arrangement, index, voice(gain = gain, pan = pan)))

    (** Set the gain on an existing group bus. *)
    export busGain (song, name, gain) = synth::Outcomes::carried (limited (gain, 0.0, 4.0, "Group gain must be 0 to 4."), \_ =>
        synth::Outcomes::carried (BusMix::named (song, name), \_ => Success(value = song(buses = mapList (song.buses, \bus => ui::Pick::either (bus.name == name, bus(gain = gain), bus))))))

    (** Assign the dry output to Master (empty name) or one of the open project's buses. *)
    export routed (song, index, bus) = synth::Outcomes::carried (required (song.tracks, index, "There is no track ${satAdd index 1}."), \track =>
        match bus == ""
            true => replaced (song, index, track(bus = ""))
            false => synth::Outcomes::carried (BusMix::named (song, bus), \found => replaced (song, index, track(bus = found.name))))

    (** A new stereo group starts at unity gain with a flat EQ and a unity-ratio compressor. *)
    export grouped (song, index, proposed) =
        name = trim proposed
        exists = ui::Lists::any (song.buses, \bus => toLowerCase bus.name == toLowerCase name)
        match name == "" || toLowerCase name == "master" || exists
            true => Error(message = "Choose a unique bus name other than Master.")
            false =>
                bus = Bus(name = name, output = "", gain = 1.0, equaliser = Equaliser(low = 0.0, mid = 0.0, high = 0.0), compressor = Compressor(threshold = 0.0, ratio = 1.0, knee = 0.0, attack = 0.01, release = 0.1, sidechain = ""))
                routed (song(buses = listAppend song.buses bus), index, name)

    (** Replace one note by its index, preserving its siblings and the project instrument. *)
    export withNote (voice, index, edited: Note) = voice(notes = mapList (toList (range (0, length voice.notes)), \at => swapped (voice.notes, index, edited, at)))

    (** Apply an edit to exactly one piano-roll note. *)
    export editedNote (song, track, index, change) = synth::Outcomes::carried (required (song.tracks, track, "Select a track first."), \voice =>
        synth::Outcomes::carried (required (voice.notes, index, "Select a note first."), \original =>
            replaced (song, track, withNote (voice, index, change original))))

    (** Change velocity without altering the note's pitch, timing or duration. *)
    export velocity (song, track, index, value) = match ArrangeMath::audible value
        false => Error(message = "Velocity must be between 0 and 1.")
        true => editedNote (song, track, index, \note => note(velocity = value))

    // The text is read back before it replaces the file, so a project that would not reopen is never written.
    checked text = synth::Outcomes::carried (SongFiles::decode text, \_ => Success(value = text))

    (** Write the project to `path` as the same JSON `SongFiles::decode` reads; the old file stays when encoding fails. *)
    export saved (arrangement, path) = match SongFiles::safe path
        false => Error(message = "A project path cannot contain a quote.")
        true => synth::Outcomes::carried (synth::Outcomes::carried (SongFiles::encode arrangement, checked), \text => synth::Outcomes::carried (writeFile path text, \_ => Success(value = path)))

    // `start` names a field of two records, so the note's type is stated.
    within (from, beats, note: Note) = ArrangeMath::inWindow (note.start, from, beats)

    cut (from, beats, voice) = voice(notes = mapList (filterList (voice.notes, \note => within (from, beats, note)), \note => note(start = ArrangeMath::shifted (note.start, from))))

    (** The `beats` from `from` as a piece of its own: notes starting inside the window, moved to its start.
        Notes keep their full length, so a release rings past the window. *)
    export excerpt (arrangement, from, beats) = arrangement(tracks = mapList (arrangement.tracks, \voice => cut (from, beats, voice)))
