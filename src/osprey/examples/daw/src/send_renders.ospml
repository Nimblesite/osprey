// Implements [DAW-MIX-BUS-TAP]. Capture the dry signal and the named stereo sends in one voice pass.
namespace daw

import synth::Outcomes

(** Prepare the ports feeding a track's buses, then collect them from each evaluated DSP block. *)
module SendRenders
    ok value = Success(value = value)

    (** Collect checked values in their original order. *)
    export collect (items, read) = foldList (items, ok [], \(held, item) => Outcomes::carried (held, \values => Outcomes::carried (read item, \value => ok (listAppend values value))))

    lane (node, outlet, channel, gain) = TapLane(tapNode = node, tapOutlet = outlet, tapChannel = channel, tapGain = gain)

    lanes (graph, routeSend) = Outcomes::carried (PatchVoices::told (synth::ClipInputs::audioPort (graph, routeSend.source, routeSend.outlet)), \port =>
        match port.channels
            1 => ok [lane (routeSend.source, routeSend.outlet, 0, ArrangeMath::scaled (routeSend.level, ArrangeMath::panLeft 0.0)), lane (routeSend.source, routeSend.outlet, 0, ArrangeMath::scaled (routeSend.level, ArrangeMath::panRight 0.0))]
            2 => ok [lane (routeSend.source, routeSend.outlet, 0, routeSend.level), lane (routeSend.source, routeSend.outlet, 1, routeSend.level)]
            _ => Error(message = "Split the multichannel outlet before sending to a stereo bus."))

    // [DAW-MODULAR-LAYOUT] The output's own channels: a mono output sits in the centre at equal power.
    dry sink = match listGet sink.inputs 0
        Success port => match port.channels
            1 => ok [lane (sink.identity, -1, 0, ArrangeMath::panLeft 0.0), lane (sink.identity, -1, 0, ArrangeMath::panRight 0.0)]
            2 => ok [lane (sink.identity, -1, 0, 1.0), lane (sink.identity, -1, 1, 1.0)]
            _ => Error(message = "Split a wider output into the project's two channels.")
        Error _ => Error(message = "The patch output has no audio input.")

    (** A left and a right dry lane, then a left and a right lane per enabled send. *)
    export outputs (graph, sends) = match filterList (graph.nodes, \n => n.processor == synth::Sink)
        [sink] => Outcomes::carried (dry sink, \own => Outcomes::carried (collect (sends, \routeSend => lanes (graph, routeSend)), \pairs => ok (foldList (pairs, own, listConcat))))
        _ => Error(message = "The patch needs one main audio output.")

    // The mono scheduler has already resolved each selected audio port to one sample.
    monoFrame (ports, buffers, frame) = collect (toList (range (0, length ports)), \index =>
        match listGet ports index
            Success port => Outcomes::carried (synth::RenderInputs::sample (frame, port.tapNode), \value =>
                match listGet buffers index
                    Success samples => ok (listPrepend samples value)
                    Error _ => Error(message = synth::MissingResource(detail = "A send lane is missing.")))
            _ => Error(message = synth::MissingResource(detail = "A send port is missing.")))

    // One channel of the output's interleaved clip.
    channelOf (clip, channel) = match clip.clipChannels > channel && channel >= 0
        false => Error(message = synth::IncompatibleLayout(detail = "The output has no such channel."))
        true => Success(value = toList (map (range (0, intDiv (length clip.clipSamples) clip.clipChannels), \frame => listGet clip.clipSamples (satAdd (satMul frame clip.clipChannels) channel) ?: 0.0)))

    fromClip (graph, clips, port) = match port.tapOutlet < 0
        true => PatchVoices::told (Outcomes::carried (synth::ClipInputs::completed (clips, port.tapNode), \clip => channelOf (clip, port.tapChannel)))
        false => PatchVoices::told (synth::ClipInputs::tapped (graph, clips, port.tapNode, port.tapOutlet, port.tapChannel))

    extend (graph, clips, ports, buffers, index) = match listGet ports index
        Error _ => Error(message = "A send port is missing.")
        Success port => Outcomes::carried (fromClip (graph, clips, port), \samples =>
            match listGet buffers index
                Success prior => ok (listConcat prior samples)
                Error _ => Error(message = "A send lane is missing."))

    block (graph, ports, progress, count) = match count > 0
        false => ok progress
        true => Outcomes::carried (PatchVoices::told (synth::GraphClips::next (graph, progress.captureState, count)), \step =>
            match step
                synth::BlockWaiting _ _ => Error(message = "An external plug-in needs its audio worker.")
                synth::BlockReady held clips => Outcomes::carried (collect (toList (range (0, length ports)), \i => extend (graph, clips, ports, progress.captureLanes, i)), \buffers => ok (Capture(captureState = held, captureLanes = buffers))))

    // [DAW-MODULAR-LAYOUT] A one-channel voice sits in the centre of both channels at equal power, and so do its sends.
    centred (samples, level) = [mapList (samples, \v => ArrangeMath::scaled (v, ArrangeMath::scaled (level, ArrangeMath::panLeft 0.0))), mapList (samples, \v => ArrangeMath::scaled (v, ArrangeMath::scaled (level, ArrangeMath::panRight 0.0)))]

    builtIn (samples, sends) = foldList (sends, centred (samples, 1.0), \(lanes, routeSend) => listConcat lanes (centred (samples, routeSend.level)))

    usable (song, voice, routeSend) =
        unique = length (filterList (voice.sends, \s => s.sendId == routeSend.sendId)) == 1
        match unique && routeSend.sendId >= 0 && routeSend.source >= 0 && routeSend.outlet >= 0 && ArrangeMath::audible routeSend.level
            false => Error(message = "Each send needs a unique identity, a source outlet and a level from zero to one.")
            true => Outcomes::carried (BusMix::named (song, routeSend.bus), \_ => ok routeSend)

    sourcePorts (voice, sends) = match voice.instrument
        PatchInstrument routing => Outcomes::carried (PatchVoices::enveloped routing, \_ => Outcomes::carried (PatchVoices::patched (Note(pitch = 60, start = 0.0, length = 1.0, velocity = 1.0), routing), \graph => Outcomes::carried (outputs (graph, sends), \_ => ok voice)))
        _ => match ui::Lists::all (sends, \s => s.source == 1 && s.outlet == 0)
            true => ok voice
            false => Error(message = "A built-in voice has one audio outlet on node 1.")

    (** Validate even muted sends and tracks without notes before the project or mix is published. *)
    export checked (song, voice) = match voice.sends
        [] => ok voice
        sends => Outcomes::carried (collect (sends, \s => usable (song, voice, s)), \accepted => sourcePorts (voice, accepted))

    (** Validate the project boundaries that join track graphs to their destination buses. *)
    export project song = Outcomes::carried (collect (song.tracks, \voice => checked (song, voice)), \_ => ok song)

    // [DAW-TRANSPORT-LIVE-CONTROLS] Edited notes retain oscillator phase, filter memory and their original gate.
    memory graph = match ui::Lists::any (graph.nodes, synth::ClipLayouts::requiresClips)
        true => ok (MultichannelNote(clock = synth::GraphState(graphHosted = [], graphPosition = 0, graphKernels = [])))
        false => Outcomes::carried (PatchVoices::told (synth::Renderer::start graph), \audio => ok (ScalarNote(audio = audio)))

    preparedNote (graph, ports, span, routing, cue) = match synth::Graphs::prepare graph
        synth::Invalid why => Error(message = "The live patch cannot be scheduled: ${why}.")
        synth::Valid plan => Outcomes::carried (memory graph, \held =>
            ok (Sounding(cue = cue, at = cue.due, lanes = [], driver = PerformingNote(patch = ActivePatch(plan = plan, ports = ports, span = span, attack = routing.attack, release = routing.release, memory = held)))))

    (** Prepare a routed note for the blocks the playhead actually reaches. *)
    export started (song, voice, sends, routing, cue, sounding) = match ui::Lists::find (sounding, \sound => performing sound)
        Success sound => starting (song, voice, sends, routing, cue, rebuilt (sound, cue.note, routing))
        Error _ => starting (song, voice, sends, routing, cue, PatchVoices::patched (cue.note, routing))

    performing sound = match sound.driver
        PerformingNote _ => true
        _ => false

    starting (song, voice, sends, routing, cue, built) = Outcomes::carried (NoteRenders::checkedSpan (cue.note, song.tempo, toFloat song.sampleRate, voice.instrument), \span =>
        Outcomes::carried (built, \graph => Outcomes::carried (outputs (graph, sends), \ports =>
            Outcomes::carried (PatchVoices::grounded graph, \whole => Outcomes::carried (PatchVoices::audible (whole, mapList (sends, \s => s.source)), \heard =>
                preparedNote (heard, ports, span, routing, cue))))))

    scalarBlock (patch, audio, size, rate, empty) =
        controls = synth::Parameters::initial patch.plan.graph
        match patch.ports
            [left, right] => match left.tapNode == right.tapNode && left.tapChannel == right.tapChannel
                true => Outcomes::carried (PatchVoices::dryBlock (patch.plan, rate, controls, synth::Timeline(audio = audio, observation = []), size, left.tapNode), \next =>
                    ok (Capture(captureState = ScalarNote(audio = next.audio), captureLanes = [next.observation, next.observation])))
                false => scalarLanes (patch, audio, size, rate, empty, controls)
            _ => scalarLanes (patch, audio, size, rate, empty, controls)

    scalarLanes (patch, audio, size, rate, empty, controls) = Outcomes::carried (PatchVoices::told (synth::Renderer::capture (patch.plan, rate, controls, synth::Timeline(audio = audio, observation = empty), size, \(buffers, frame) => monoFrame (patch.ports, buffers, frame))), \next =>
        ok (Capture(captureState = ScalarNote(audio = next.audio), captureLanes = mapList (next.observation, listReverse))))

    capturedBlock (patch, held, size, rate) =
        empty = mapList (patch.ports, \_ => [])
        match held
            ScalarNote audio => scalarBlock (patch, audio, size, rate, empty)
            MultichannelNote clock => Outcomes::carried (block (patch.plan.graph, patch.ports, Capture(captureState = clock, captureLanes = empty), size), \next =>
                ok (Capture(captureState = MultichannelNote(clock = next.captureState), captureLanes = next.captureLanes)))

    // Append one checked block per lane; large offline windows still use bounded graph blocks.
    accumulated (patch, rate, prior, size) = match size > 0
        false => ok prior
        true => Outcomes::carried (capturedBlock (patch, prior.captureState, size, rate), \next =>
            Outcomes::carried (collect (toList (range (0, length patch.ports)), \i =>
                match listGet prior.captureLanes i
                    Error _ => Error(message = "The sounding note lost an output lane.")
                    Success samples => match listGet next.captureLanes i
                        Error _ => Error(message = "The rendered note lost an output lane.")
                        Success block => ok (listConcat samples block)), \lanes => ok (next(captureLanes = lanes))))

    shapedLane (patch, lanes, offset, rate, index) = match listGet patch.ports index
        Error _ => Error(message = "The sounding note lost an output port.")
        Success port => match listGet lanes index
            Error _ => Error(message = "The sounding note lost its audio lane.")
            Success samples => ok (mapList (toList (range (0, length samples)), \i => ArrangeMath::scaled (ArrangeMath::enveloped (listGet samples i ?: 0.0, toFloat (satAdd offset i), patch.span.gate, patch.attack, patch.release, rate), port.tapGain)))

    portion (sound, patch, first, count, rate) =
        initial = Capture(captureState = patch.memory, captureLanes = mapList (patch.ports, \_ => []))
        Outcomes::carried (foldList (PatchVoices::counts (count, 1024), ok initial, \(result, size) => Outcomes::carried (result, \prior => accumulated (patch, rate, prior, size))), \played =>
            Outcomes::carried (collect (toList (range (0, length patch.ports)), \i => shapedLane (patch, played.captureLanes, satSub first sound.cue.due, rate, i)), \lanes =>
                ok (sound(at = first, lanes = lanes, driver = PerformingNote(patch = patch(memory = played.captureState))))))

    (** Start a built-in voice at its first frame; it makes only the blocks the graph asks for. *)
    export voiceStarted (song, voice, sends, cue) =
        rate = toFloat song.sampleRate
        Outcomes::carried (NoteRenders::checkedSpan (cue.note, song.tempo, rate, voice.instrument), \span =>
            Outcomes::carried (NoteRenders::voiceStarted (cue.note, span, rate, voice.instrument, sends), \built => ok (Sounding(cue = cue, at = cue.due, lanes = [], driver = PerformingVoice(voice = built)))))

    voicePortion (sound, built, first, stop, rate) =
        run = NoteRenders::voiceFrames (sound.cue.note, built, rate, satSub first sound.cue.due, satSub stop sound.cue.due)
        match run.fault == ""
            false => Error(message = run.fault)
            true => ok (sound(at = first, lanes = builtIn (run.samples, built.sends), driver = PerformingVoice(voice = built(current = run.held))))

    (** Start the built-in operator pair at its first frame; it makes only the blocks the graph asks for. *)
    export operatorStarted (song, voice, sends, tone, cue) =
        rate = toFloat song.sampleRate
        Outcomes::carried (NoteRenders::checkedSpan (cue.note, song.tempo, rate, voice.instrument), \span =>
            Outcomes::carried (NoteRenders::operatorPair (cue.note, span, rate, tone, sends), \pair => ok (Sounding(cue = cue, at = cue.due, lanes = [], driver = PerformingOperator(pair = pair)))))

    operatorPortion (sound, pair, first, stop, rate) =
        run = NoteRenders::operatorFrames (sound.cue.note, pair, rate, satSub first sound.cue.due, satSub stop sound.cue.due)
        ok (sound(at = first, lanes = builtIn (run.samples, pair.sends), driver = PerformingOperator(pair = pair(phases = run.held))))

    (** Render the overlap with this device block, continuing the same note at its exact sample age. *)
    export window (sound, from, until, rate) =
        first = ui::Pick::either (from > sound.cue.due, from, sound.cue.due)
        match sound.driver
            PerformingVoice built => voicePortion (sound, built, first, stopAt (sound.cue.due, built.span.total, until), rate)
            PerformingOperator pair => operatorPortion (sound, pair, first, stopAt (sound.cue.due, pair.span.total, until), rate)
            PerformingNote patch =>
                stop = stopAt (sound.cue.due, patch.span.total, until)
                portion (sound, patch, first, ui::Pick::either (stop > first, satSub stop first, 0), rate)

    stopAt (onset, span, until) =
        end = satAdd onset span
        ui::Pick::either (until < end, until, end)

    // Parameter-only changes keep memory. A changed layout is prepared at the same position in its note.
    structure graph = mapList (graph.nodes, \n => n(parameters = []))

    transfer (fresh, old, from, rate) = match fresh.driver
        PerformingNote patch => match old.driver
            PerformingNote last => match structuralEquals (structure last.plan.graph, structure patch.plan.graph) && structuralEquals (last.plan.graph.cables, patch.plan.graph.cables)
                true => ok (fresh(driver = PerformingNote(patch = patch(memory = last.memory))))
                false => window (fresh, fresh.cue.due, from, rate)
            _ => window (fresh, fresh.cue.due, from, rate)
        _ => Error(message = "The edited note has no prepared patch.")

    rebuilt (old, note, routing) = match old.driver
        PerformingNote patch => PatchVoices::repatched (note, routing, patch.plan.graph)
        _ => PatchVoices::patched (note, routing)

    (** Switch a sounding note to the accepted parameters without replaying its attack or losing its phase. *)
    export retuned (song, voice, sends, sound, from, routing) = Outcomes::carried (starting (song, voice, sends, routing, sound.cue, rebuilt (sound, sound.cue.note, routing)), \fresh => transfer (fresh, sound, from, toFloat song.sampleRate))
