// [SYNTH-ARRANGEMENT] Piano-roll tracks rendered, overlap-added and mixed to stereo, offline.
namespace daw

(** A track is rendered note by note in start order: frames before the next note start are final and move
    to the output, later frames wait in an overlap carry. Tracks then add into left, right and reverb
    buses; the reverb bus feeds two feedback-delay networks of different size, one per side. *)
module Arrangements
    ordered (one, other) = match one.start < other.start
        true => -1
        false => match one.start > other.start
            true => 1
            false => 0

    // Move `count` settled frames from the overlap carry to the output (silence past its end).
    emitted (samples, carry, count) = foldList (toList (range (0, count)), samples, \(done, index) => listAppend done (listGet carry index ?: 0.0))

    // The mix's output once frames up to `upto` have settled out of its carry.
    settled (mix, upto) = emitted (mix.samples, mix.carry, satSub upto mix.cursor)

    longer (one, other) = match one > other
        true => one
        false => other

    // The carry after `gap` frames settled, with the new note overlap-added from its first frame.
    overlapped (carry, gap, note) = foldList (toList (range (0, longer (satSub (length carry) gap, length note))), [], \(done, index) => listAppend done ((listGet carry (satAdd gap index) ?: 0.0) + (listGet note index ?: 0.0)))

    placed (mix, start, note) = TrackMix(cursor = start, carry = overlapped (mix.carry, satSub start mix.cursor, note), samples = settled (mix, start), fault = "")

    noted (arrangement, part, mix, note) = match mix.fault == ""
        false => mix
        true => match frame (arrangement, note.start)
            Error _ => mix(fault = "${part.name}: a note start is not finite.")
            Success start => match start >= mix.cursor
                false => mix(fault = "${part.name}: a note starts before the piece.")
                true => match NoteRenders::render (note, arrangement.tempo, toFloat arrangement.sampleRate, part.instrument)
                    Error why => mix(fault = "${part.name}: ${why}")
                    Success samples => placed (mix, start, samples)

    (** One track's notes as a mono buffer of exactly `frames` frames; later sound is cut. *)
    export part (arrangement, voice, frames) =
        mix = foldList (listSortBy (voice.notes, ordered), TrackMix(cursor = 0, carry = [], samples = [], fault = ""), \(mix, note) => noted (arrangement, voice, mix, note))
        match mix.fault == ""
            false => Error(message = mix.fault)
            true => Success(value = settled (mix, frames))

    close (latest, note) = synth::TableMath::larger (latest, note.start + note.length)

    (** The beat the last note ends on. *)
    export beats arrangement = foldList (arrangement.tracks, 0.0, \(latest, voice) => foldList (voice.notes, latest, close))

    valid arrangement = arrangement.drive >= 0.1 && arrangement.drive <= 4.0 && arrangement.tempo >= 20.0 && arrangement.tempo <= 400.0 && arrangement.sampleRate >= 8000 && arrangement.sampleRate <= 192000 && length arrangement.tracks >= 1 && length arrangement.tracks <= 64

    (** Frames in the piece: its last note end plus the reverb decay and two seconds; at most 28,800,000. *)
    export frames arrangement = match valid arrangement
        false => Error(message = "An arrangement needs a tempo of 20 to 400, a rate of 8000 to 192000, a drive of 0.1 to 4 and 1 to 64 tracks.")
        true => match floatToInt (ArrangeMath::pieceFrames (beats arrangement, arrangement.tempo, toFloat arrangement.sampleRate, arrangement.space.decay))
            Error _ => Error(message = "The arrangement length is not finite.")
            Success count => match count >= 1 && count <= 28800000
                false => Error(message = "An arrangement must last 1 to 28800000 frames.")
                true => Success(value = count)

    (** `samples` enter `offset` frames into the bus, scaled by `gain`; the bus grows to hold them. *)
    export bused (existing, samples, offset, gain) = foldList (toList (range (0, longer (length existing, satAdd offset (length samples)))), [], \(done, index) => listAppend done (ArrangeMath::bused (listGet existing index ?: 0.0, gain, listGet samples (satSub index offset) ?: 0.0)))

    // One bus takes the mono buffer from frame `offset`, scaled by `gain * shade`.
    sent (bus, samples, offset, gain, shade) = bused (bus, samples, offset, ArrangeMath::scaled (gain, shade))

    (** Silent buses. *)
    export empty = Buses(left = [], right = [], wet = [], groups = [], keys = [])

    (** Add a mono buffer to the buses from frame `offset` (0 or later): gain 0–4, pan −1 (left) to 1
        (right), reverb send 0–1. *)
    export layered (buses, samples, offset, gain, pan, reverb) = match offset >= 0 && ArrangeMath::mixable (gain, pan, reverb)
        false => Error(message = "Gain must be 0 to 4, pan -1 to 1, reverb 0 to 1 and the offset not negative.")
        true => Success(value = buses(left = sent (buses.left, samples, offset, gain, ArrangeMath::panLeft pan), right = sent (buses.right, samples, offset, gain, ArrangeMath::panRight pan), wet = sent (buses.wet, samples, offset, gain, reverb)))

    (** The frame at which `beat` starts. *)
    export frame (arrangement, beat) = match floatToInt (ArrangeMath::beatFrames (beat, arrangement.tempo, toFloat arrangement.sampleRate))
        Error _ => Error(message = "A start beat is not finite.")
        Success start => Success(value = start)

    // A track that keys a bus compressor is kept, at its gain, for the bus stage ([DAW-MIX-BUS]).
    kept (arrangement, buses, voice, samples) = match BusMix::keys (arrangement, voice.name)
        true => buses(keys = listAppend buses.keys (Keyed(name = voice.name, samples = mapList (samples, \s => ArrangeMath::scaled (s, voice.gain)))))
        false => buses

    group (buses, name) = listGet (filterList (buses.groups, \g => g.name == name)) 0 ?: Stereo(name = name, left = [], right = [])

    others (buses, name) = filterList (buses.groups, \g => g.name != name)

    joined (buses, name, fed) = Buses(left = buses.left, right = buses.right, wet = fed.wet, groups = listAppend (others (buses, name)) (Stereo(name = name, left = fed.left, right = fed.right)), keys = buses.keys)

    // The track's dry sides sum into its bus; its Space send still goes straight to the shared reverb.
    grouped (buses, voice, samples) =
        inner = group (buses, voice.bus)
        sides = Buses(left = inner.left, right = inner.right, wet = buses.wet, groups = [], keys = [])
        synth::Outcomes::carried (layered (sides, samples, 0, voice.gain, voice.pan, voice.reverb), \fed => Success(value = joined (buses, voice.bus, fed)))

    routed (arrangement, buses, voice, samples) = match voice.bus == ""
        true => layered (buses, samples, 0, voice.gain, voice.pan, voice.reverb)
        false => synth::Outcomes::carried (BusMix::named (arrangement, voice.bus), \_ => grouped (buses, voice, samples))

    tappedNote (song, voice, sends, buffers, note) = synth::Outcomes::carried (frame (song, note.start), \start =>
        match start >= 0
            false => Error(message = "A note starts before the piece.")
            true => synth::Outcomes::carried (SendRenders::note (voice, sends, note, song.tempo, toFloat song.sampleRate), \lanes =>
                SendRenders::collect (toList (range (0, length lanes)), \i =>
                    match listGet buffers i
                        Error _ => Error(message = "A routed track lane is missing.")
                        Success mix => match listGet lanes i
                            Error _ => Error(message = "A rendered send lane is missing.")
                            Success lane => Success(value = placed (mix, start, lane)))))

    (** Sum a stereo signal into a named group without a second pan stage. *)
    export feedGroup (buses, name, left, right, gain) =
        previous = group (buses, name)
        next = Stereo(name = name, left = bused (previous.left, left, 0, gain), right = bused (previous.right, right, 0, gain))
        buses(groups = listAppend (others (buses, name)) next)

    // Overlay the send's two channels without panning the stereo signal a second time.
    sentGroup (buses, routeSend, lanes, index) = match listGet lanes (satAdd 1 (satMul 2 index))
        Error _ => Error(message = "The send has no left channel.")
        Success left => match listGet lanes (satAdd 2 (satMul 2 index))
            Error _ => Error(message = "The send has no right channel.")
            Success right => Success(value = feedGroup (buses, routeSend.bus, left, right, 1.0))

    finishedSends (song, buses, voice, sends, lanes) = match listGet lanes 0
        Error _ => Error(message = "The track has no main output.")
        Success dry => synth::Outcomes::carried (routed (song, kept (song, buses, voice, dry), voice, dry), \fed =>
            foldList (toList (range (0, length sends)), Success(value = fed), \(held, i) => synth::Outcomes::carried (held, \prior =>
                match listGet sends i
                    Error _ => Error(message = "Missing track send.")
                    Success routeSend => sentGroup (prior, routeSend, lanes, i))))

    withSends (song, buses, voice, sends, count) =
        initial = mapList (toList (range (0, satAdd 1 (satMul 2 (length sends)))), \_ => TrackMix(cursor = 0, carry = [], samples = [], fault = ""))
        mix = foldList (listSortBy (voice.notes, ordered), Success(value = initial), \(held, note) => synth::Outcomes::carried (held, \buffers => tappedNote (song, voice, sends, buffers, note)))
        synth::Outcomes::carried (mix, \buffers => finishedSends (song, buses, voice, sends, mapList (buffers, \lane => settled (lane, count))))

    (** Render a track once and route its main output and independent internal audio sends. *)
    export added (arrangement, buses, voice, count) = match voice.sends
        [] => plainTrack (arrangement, buses, voice, count)
        _ => synth::Outcomes::carried (SendRenders::checked (arrangement, voice), \_ =>
            match filterList (voice.sends, \s => s.enabled && s.level > 0.0)
                [] => plainTrack (arrangement, buses, voice, count)
                sends => withSends (arrangement, buses, voice, sends, count))

    plainTrack (arrangement, buses, voice, count) = match part (arrangement, voice, count)
        Error why => Error(message = why)
        Success samples => match routed (arrangement, kept (arrangement, buses, voice, samples), voice, samples)
            Error why => Error(message = "${voice.name}: ${why}")
            Success next => Success(value = next)

    room (arrangement, scale) = synth::ReverbConfig(sampleRate = toFloat arrangement.sampleRate, size = ArrangeMath::scaled (arrangement.space.size, scale), decay = arrangement.space.decay, damping = arrangement.space.damping, diffusion = 0.7, mix = 1.0, freeze = false)

    echoStep (config, run, input) = match run.fault == ""
        false => run
        true => match synth::Reverbs::next (config, run.held, input)
            Error why => run(fault = why)
            Success step => NoteRun(held = step.next, samples = listAppend run.samples step.sample, fault = "")

    echoed (config, wet) = match synth::Reverbs::configure config
        Error why => Error(message = why)
        Success accepted => synth::Outcomes::carried (synth::Reverbs::initial accepted, \held => NoteRenders::finished (foldList (wet, NoteRun(held = held, samples = [], fault = ""), \(run, input) => echoStep (accepted, run, input))))

    peak (high, value) = synth::TableMath::larger (high, synth::TableMath::magnitude value)

    // Master's ceiling, about −1 dBTP, and its limiter's lookahead and release.
    ceiling = 0.89

    lookahead = 1.5

    release = 0.08

    lift (side, gain) = mapList (side, \value => ArrangeMath::scaled (value, gain))

    limited (left, right, top, gains) = Mixdown(left = synth::Limiters::applied (left, gains, ceiling), right = synth::Limiters::applied (right, gains, ceiling), peak = top)

    levelled (rate, left, right, drive) =
        top = foldList (right, foldList (left, 0.0, peak), peak)
        gain = ArrangeMath::lifted (top, drive, ceiling)
        near = lift (left, gain)
        far = lift (right, gain)
        synth::Outcomes::carried (synth::Limiters::gains (near, far, rate, ceiling, lookahead, release), \gains => Success(value = limited (near, far, top, gains)))

    (** Stereo mixdown [DAW-DYNAMICS-LIMITER]: each side is its dry bus plus its own reverb of the shared send. The
        mix is scaled so its peak meets the ceiling (0.89, about −1 dBTP), `drive` (0.1–4) times louder, then both
        sides pass the linked true-peak brick-wall limiter, so a drive above 1 is louder without clipping;
        `peak` is the level before it. *)
    export mixed (arrangement, buses) = match [echoed (room (arrangement, 1.0), buses.wet), echoed (room (arrangement, 0.91), buses.wet)]
        [Error why, _] => Error(message = why)
        [Success _, Error why] => Error(message = why)
        [Success near, Success far] => levelled (toFloat arrangement.sampleRate, bused (buses.left, near, 0, 1.0), bused (buses.right, far, 0, 1.0), arrangement.drive)

    interleave (mix, done, index) = listAppend (listAppend done (listGet mix.left index ?: 0.0)) (listGet mix.right index ?: 0.0)

    (** Interleaved left/right samples for frames `from` up to `until`, for chunked file writing. *)
    export interleaved (mix, from, until) = foldList (toList (range (from, longer (from, until))), [], \(done, index) => interleave (mix, done, index))
