// [SYNTH-ARRANGEMENT] [DAW-RENDER-PLAY] Piano-roll tracks played into their buses, one window of time at a time.
namespace daw

import synth::Outcomes

(** A track plays as cued notes: each note starts sounding when the window reaching its start frame plays,
    every lane (the dry output and each send's two sides) is summed over the window from the notes then
    sounding, and the window is routed into the shared buses: its group or Master, its sidechain key and its
    sends. A note stops once it has ended. `Playback` advances every track over the same window together. *)
module Arrangements
    ok value = Success(value = value)

    ordered (one, other) = match one.start < other.start
        true => -1
        false => match one.start > other.start
            true => 1
            false => 0

    longer (one, other) = match one > other
        true => one
        false => other

    close (latest, note) = synth::TableMath::larger (latest, note.start + note.length)

    (** The beat the last note ends on. *)
    export beats arrangement = foldList (arrangement.tracks, 0.0, \(latest, voice) => foldList (voice.notes, latest, close))

    (** Accepted time signatures use one to thirty-two beats and a power-of-two denominator. *)
    export validMeter (top, bottom) = top >= 1 && top <= 32 && (bottom == 1 || bottom == 2 || bottom == 4 || bottom == 8 || bottom == 16 || bottom == 32)

    valid arrangement = validMeter (arrangement.meterTop, arrangement.meterBottom) && arrangement.tempo >= 20.0 && arrangement.tempo <= 400.0 && arrangement.sampleRate >= 8000 && arrangement.sampleRate <= 192000 && length arrangement.tracks >= 1 && length arrangement.tracks <= 64

    (** Frames in the piece: its last note end plus two seconds; at most 28,800,000. *)
    export frames arrangement = match valid arrangement
        false => Error(message = "An arrangement needs a tempo of 20 to 400, a rate of 8000 to 192000 and 1 to 64 tracks.")
        true => match floatToInt (ArrangeMath::pieceFrames (beats arrangement, arrangement.tempo, toFloat arrangement.sampleRate))
            Error _ => Error(message = "The arrangement length is not finite.")
            Success count => match count >= 1 && count <= 28800000
                false => Error(message = "An arrangement must last 1 to 28800000 frames.")
                true => Success(value = count)

    (** `samples` enter `offset` frames into the bus, scaled by `gain`; the bus grows to hold them. *)
    export bused (existing, samples, offset, gain) = match length samples == 0 && offset <= length existing
        true => existing
        false => toList (map (range (0, longer (length existing, satAdd offset (length samples))), \index => ArrangeMath::bused (listGet existing index ?: 0.0, gain, listGet samples (satSub index offset) ?: 0.0)))

    // One bus takes the mono buffer from frame `offset`, scaled by `gain * shade`.
    sent (bus, samples, offset, gain, shade) = bused (bus, samples, offset, ArrangeMath::scaled (gain, shade))

    (** Silent buses. *)
    export empty = Buses(left = [], right = [], groups = [], keys = [])

    (** Add a mono buffer to the buses from frame `offset` (0 or later): gain 0–4, pan −1 (left) to 1 (right). *)
    export layered (buses, samples, offset, gain, pan) = match offset >= 0 && ArrangeMath::mixable (gain, pan)
        false => Error(message = "Gain must be 0 to 4, pan -1 to 1 and the offset not negative.")
        true => Success(value = buses(left = sent (buses.left, samples, offset, gain, ArrangeMath::panLeft pan), right = sent (buses.right, samples, offset, gain, ArrangeMath::panRight pan)))

    (** The frame at which `beat` starts. *)
    export frame (arrangement, beat) = match floatToInt (ArrangeMath::beatFrames (beat, arrangement.tempo, toFloat arrangement.sampleRate))
        Error _ => Error(message = "A start beat is not finite.")
        Success start => Success(value = start)

    // A track that keys a bus compressor is kept, at its gain, for the bus stage ([DAW-MIX-BUS]).
    kept (arrangement, buses, voice, samples) = match BusMix::keys (arrangement, voice.name)
        true => buses(keys = listAppend buses.keys (Keyed(name = voice.name, samples = mapList (samples, \s => ArrangeMath::scaled (s, voice.gain)))))
        false => buses

    group (buses, name) = listGet (filterList (buses.groups, \g => g.name == name)) 0 ?: Stereo(name = name, left = [], right = [])

    others (buses, name) = filterList (buses.groups, \g => g.name != name)

    joined (buses, name, fed) = Buses(left = buses.left, right = buses.right, groups = listAppend (others (buses, name)) (Stereo(name = name, left = fed.left, right = fed.right)), keys = buses.keys)

    // The track's two sides sum into its bus.
    grouped (buses, voice, samples) =
        inner = group (buses, voice.bus)
        sides = Buses(left = inner.left, right = inner.right, groups = [], keys = [])
        Outcomes::carried (layered (sides, samples, 0, voice.gain, voice.pan), \fed => Success(value = joined (buses, voice.bus, fed)))

    routed (buses, voice, samples) = match voice.bus == ""
        true => layered (buses, samples, 0, voice.gain, voice.pan)
        false => grouped (buses, voice, samples)

    (** Sum a stereo signal into a named group without a second pan stage. *)
    export feedGroup (buses, name, left, right, gain) =
        previous = group (buses, name)
        next = Stereo(name = name, left = bused (previous.left, left, 0, gain), right = bused (previous.right, right, 0, gain))
        buses(groups = listAppend (others (buses, name)) next)

    // Overlay the send's two channels without panning the stereo signal a second time.
    sentGroup (buses, routeSend, lanes, index) = match listGet lanes (satAdd 1 (satMul 2 index))
        Error _ => Error(message = "The send has no left channel.")
        Success left => match listGet lanes (satAdd 2 (satMul 2 index))
            Error _ => Error(message = "The send has no right channel.")
            Success right => Success(value = feedGroup (buses, routeSend.bus, left, right, 1.0))

    // The dry lane to its bus (and key), then each send's two lanes to its group.
    fed (song, buses, voice, sends, lanes) = match listGet lanes 0
        Error _ => Error(message = "The track has no main output.")
        Success dry => Outcomes::carried (routed (kept (song, buses, voice, dry), voice, dry), \main =>
            foldList (toList (range (0, length sends)), Success(value = main), \(held, i) => Outcomes::carried (held, \prior =>
                match listGet sends i
                    Error _ => Error(message = "Missing track send.")
                    Success routeSend => sentGroup (prior, routeSend, lanes, i))))

    named (voice, outcome) = match outcome
        Error why => Error(message = "${voice.name}: ${why}")
        Success value => Success(value = value)

    cue (song, voice, note) = match frame (song, note.start)
        Error _ => Error(message = "${voice.name}: a note start is not finite.")
        Success due => match due >= 0
            false => Error(message = "${voice.name}: a note starts before the piece.")
            true => ok (Cue(due = due, note = note))

    // A track names a bus the song declares, or plays straight into Master.
    reachable (song, voice) = match voice.bus == ""
        true => ok voice
        false => named (voice, Outcomes::carried (BusMix::named (song, voice.bus), \_ => ok voice))

    live (song, voice) = match voice.sends
        [] => ok []
        _ => Outcomes::carried (SendRenders::checked (song, voice), \_ => ok (filterList (voice.sends, \s => s.enabled && s.level > 0.0)))

    (** A track before it plays: every note cued at its start frame in start order, with its live sends. A
        note start that is not finite or before the piece, or a bus the song lacks, fails here. *)
    export opened (song, voice) = Outcomes::carried (reachable (song, voice), \_ => Outcomes::carried (live (song, voice), \sends =>
        Outcomes::carried (SendRenders::collect (listSortBy (voice.notes, ordered), \note => cue (song, voice, note)), \cues => ok (TrackPlay(edited = false, pending = cues, sounding = [], sends = sends, made = [], recordings = [])))))

    (** One note's lanes: the dry output alone, or with each send's two sides from the same evaluation. *)
    export lanesOf (song, voice, sends, note) = match sends
        [] => Outcomes::carried (NoteRenders::render (note, song.tempo, toFloat song.sampleRate, voice.instrument), \samples => ok [samples])
        _ => SendRenders::note (voice, sends, note, song.tempo, toFloat song.sampleRate)

    (** Whether two notes sound the same wherever they start: the same pitch, length and velocity. *)
    export same (one, other) = one.pitch == other.pitch && one.length == other.length && one.velocity == other.velocity

    // A note starts sounding at its frame; a note this track has made before reuses its lanes.
    struck (song, voice, play, due, streaming) = match ui::Lists::find (play.made, \m => same (m.struck, due.note))
        Success made => ok (play(sounding = listAppend play.sounding (Sounding(cue = due, at = due.due, driver = RecordedNote, lanes = made.chord))))
        Error _ => match voice.instrument
            PatchInstrument routing => match play.edited || streaming
                true => Outcomes::carried (SendRenders::started (song, voice, play.sends, routing, due, play.sounding), \sound => ok (play(sounding = listAppend play.sounding sound)))
                false => recorded (song, voice, play, due)
            _ => recorded (song, voice, play, due)

    recorded (song, voice, play, due) = Outcomes::carried (lanesOf (song, voice, play.sends, due.note), \lanes =>
        ok (play(sounding = listAppend play.sounding (Sounding(cue = due, at = due.due, driver = RecordedNote, lanes = lanes)), made = listAppend play.made (Made(struck = due.note, chord = lanes)))))

    (** Only the instrument and its sends affect a cached note's dry and send lanes. *)
    export sameVoice (voice, prior) = structuralEquals (voice.instrument, prior.instrument) && structuralEquals (voice.sends, prior.sends)

    (** Promote sounding patch notes when the track gains focus, before its first parameter changes. *)
    export focused (song, voice, play, from) = match voice.instrument
        PatchInstrument _ => match play.edited
            true => ok play
            false => Outcomes::carried (SendRenders::collect (play.sounding, \sound => SendRenders::activeBefore (song, voice, play.sends, sound, from)), \sounds =>
                ok (play(edited = true, sounding = sounds, made = [], recordings = [])))
        _ => ok play

    (** Rebuild sounding lanes at their original onset and discard cached notes when the instrument or sends change. *)
    export refreshed (song, voice, prior, play, from) = match sameVoice (voice, prior)
        true => ok play
        false => Outcomes::carried (live (song, voice), \sends =>
            Outcomes::carried (SendRenders::collect (play.sounding, \sound => revised (song, voice, prior, play.sends, sends, sound, from)), \sounds =>
                ok (play(edited = true, sounding = sounds, sends = sends, made = [], recordings = []))))

    revised (song, voice, prior, oldSends, sends, sound, from) = match voice.instrument
        PatchInstrument routing => SendRenders::retuned (song, voice, prior, oldSends, sends, sound, from, routing)
        _ => Outcomes::carried (lanesOf (song, voice, sends, sound.cue.note), \lanes => ok (sound(at = sound.cue.due, driver = RecordedNote, lanes = lanes)))

    // Notes due before `until` start sounding.
    begun (song, voice, play, until, streaming) = Outcomes::carried (foldList (filterList (play.pending, \c => c.due < until), ok play, \(outcome, c) => Outcomes::carried (outcome, \held => struck (song, voice, held, c, streaming))), \next =>
        ok (next(pending = filterList (play.pending, \c => c.due >= until))))

    // A sounding note's sample at song frame `at`, silent before it starts and after it ends.
    heard (samples, start, at) = match at >= start
        true => listGet samples (satSub at start) ?: 0.0
        false => 0.0

    overlaid (sum, samples, start, from) = mapList (toList (range (0, length sum)), \i => (listGet sum i ?: 0.0) + heard (samples, start, satAdd from i))

    layer (sum, voice, lane, from) = match listGet voice.lanes lane
        Error _ => sum
        Success samples => overlaid (sum, samples, voice.at, from)

    (** One lane of the sounding notes over song frames `from` up to `until`, summed. *)
    export window (sounding, lane, from, until) = foldList (sounding, mapList (toList (range (from, longer (from, until))), \_ => 0.0), \(sum, voice) => layer (sum, voice, lane, from))

    (** Whether a sounding note still has sound after frame `until`. *)
    export lasting (until, voice) = match voice.driver
        PerformingNote patch => satAdd voice.cue.due patch.span.total > until
        RecordedNote => satAdd voice.at (length (listGet voice.lanes 0 ?: [])) > until

    activeLane (voices, lane, from, until) = match voices
        [] => []
        _ => window (voices, lane, from, until)

    (** Advance one track over song frames `from` up to `until` into `buses`: notes due start sounding, each
        lane is summed for the window and routed, and notes that have ended stop. *)
    export advanceWindow (song, buses, voice, play, from, until, streaming) = named (voice, Outcomes::carried (begun (song, voice, play, until, streaming), \began =>
        Outcomes::carried (sounding (song, began, from, until, streaming), \next => mixedWindow (song, buses, voice, next, from, until))))

    export advanced (song, buses, voice, play, from, until) = advanceWindow (song, buses, voice, play, from, until, false)

    sounding (song, play, from, until, streaming) = match streaming || play.edited
        false => ok play
        true => Outcomes::carried (SendRenders::collect (play.sounding, \sound => SendRenders::window (sound, from, until, toFloat song.sampleRate)), \sounds => ok (remember (play(sounding = sounds), until)))

    // Reuse the exact dry and send lanes of an uninterrupted voice after it finishes.
    remember (play, until) = match play.edited
        true => play
        false => foldList (play.sounding, play, \(current, sound) => rememberSound (current, until, sound))

    sameTake (take, sound) = take.struck.start == sound.cue.note.start && same (take.struck, sound.cue.note)

    rememberSound (play, until, sound) = match sound.driver
        RecordedNote => match play.recordings
            [] => play
            _ => play(recordings = filterList (play.recordings, \take => !sameTake (take, sound)))
        _ => match ui::Lists::find (play.recordings, \take => sameTake (take, sound))
            Success take => match length (listGet take.chord 0 ?: []) == satSub sound.at sound.cue.due
                true => storeTake (play, until, sound, Made(struck = take.struck, chord = extended (take.chord, sound.lanes)))
                false => play
            Error _ => match sound.at == sound.cue.due && !ui::Lists::any (play.made, \take => same (take.struck, sound.cue.note)) && ui::Lists::any (play.pending, \cue => same (sound.cue.note, cue.note)) && !ui::Lists::any (play.recordings, \take => same (take.struck, sound.cue.note))
                true => storeTake (play, until, sound, Made(struck = sound.cue.note, chord = sound.lanes))
                false => play

    extended (prior, lanes) = synth::Sequences::mapIndexed (lanes, \(index, samples) => synth::Sequences::joined (listGet prior index ?: [], samples))

    storeTake (play, until, sound, take) =
        others = filterList (play.recordings, \item => !sameTake (item, sound))
        match lasting (until, sound)
            true => play(recordings = listPrepend others take)
            false => match ui::Lists::any (play.made, \item => same (item.struck, take.struck))
                true => play(recordings = others)
                false => play(recordings = others, made = listAppend play.made take)

    mixedWindow (song, buses, voice, next, from, until) =
        lanes = toList (map (range (0, satAdd 1 (satMul 2 (length next.sends))), \lane => activeLane (next.sounding, lane, from, until)))
        Outcomes::carried (fed (song, buses, voice, next.sends, lanes), \into => ok (Advanced(play = next(sounding = filterList (next.sounding, \v => lasting (until, v))), buses = into)))

    (** One track alone, played from the start for `frames` frames as its dry mono output; later sound is cut. *)
    export part (song, voice, frames) = Outcomes::carried (opened (song, voice), \play => named (voice, Outcomes::carried (begun (song, voice, play, frames, false), \next => ok (window (next.sounding, 0, 0, frames)))))

    (** One track alone, played from the start for `count` frames into `buses`. *)
    export added (song, buses, voice, count) = Outcomes::carried (opened (song, voice), \play => Outcomes::carried (advanced (song, buses, voice, play, 0, count), \step => ok step.buses))

    peak (high, value) = synth::TableMath::larger (high, synth::TableMath::magnitude value)

    // Master's ceiling, about −1 dBTP, and its limiter's lookahead and release.
    ceiling = 0.89

    lookahead = 1.5

    release = 0.08

    lift (side, gain) = mapList (side, \value => ArrangeMath::scaled (value, gain))

    limited (left, right, top, gains) = Mixdown(left = synth::Limiters::applied (left, gains, ceiling), right = synth::Limiters::applied (right, gains, ceiling), peak = top)

    (** Master's last stage [DAW-DYNAMICS-LIMITER], over the whole played Master: it is scaled so its peak meets the
        ceiling (0.89, about −1 dBTP), then both sides pass the linked true-peak brick-wall limiter; `peak` is the
        level before it. *)
    export levelled (rate, left, right) =
        top = foldList (right, foldList (left, 0.0, peak), peak)
        gain = ArrangeMath::lifted (top, ceiling)
        near = lift (left, gain)
        far = lift (right, gain)
        synth::Outcomes::carried (PatchVoices::told (synth::Limiters::gains (near, far, rate, ceiling, lookahead, release)), \gains => Success(value = limited (near, far, top, gains)))

    interleave (mix, done, index) = listAppend (listAppend done (listGet mix.left index ?: 0.0)) (listGet mix.right index ?: 0.0)

    (** Interleaved left/right samples for frames `from` up to `until`, for chunked file writing. *)
    export interleaved (mix, from, until) = foldList (toList (range (from, longer (from, until))), [], \(done, index) => interleave (mix, done, index))
