namespace daw

(** Piano-roll timing, note envelopes and mix gains [SYNTH-ARRANGEMENT]. *)
module ArrangeMath
    (** Frames covered by `beats` at `tempo` beats per minute. *)
    export beatFrames (beats, tempo, sampleRate) = floor (floatDiv (beats * 60.0, tempo) * sampleRate + 0.5)

    (** Frames covered by `time` seconds. *)
    export secondFrames (time, sampleRate) = floor (time * sampleRate + 0.5)

    (** Gate envelope: linear attack over `attack` frames, hold while the note is down, linear release over `release` frames after `gate`; exactly zero once released. *)
    export gated (frame, gate, attack, release) =
        rise = match frame >= attack
            true => 1.0
            false => floatDiv (frame, attack)
        match frame < gate
            true => rise
            false => match frame >= gate + release
                true => 0.0
                false => rise * (1.0 - floatDiv (frame - gate, release))

    (** Exponential ring reaching −60 dB after `decay` seconds. *)
    export ringing (frame, decay, sampleRate) = exp (floatDiv ((-6.907755278982137) * frame, decay * sampleRate))

    (** Drum pitch sweep: starts `sweep` times above the note and settles with a 25 ms time constant. *)
    export swept (frequency, sweep, frame, sampleRate) = frequency * (1.0 + sweep * exp (floatDiv ((-1.0) * frame, 0.025 * sampleRate)))

    (** Phase-distortion breakpoint easing from its struck value toward 0.5 (a sine) over `bloom` seconds. *)
    export bloomed (breakpoint, frame, bloom, sampleRate) = 0.5 - (0.5 - breakpoint) * exp (floatDiv ((-1.0) * frame, bloom * sampleRate))

    (** Delayed 5.4 Hz vibrato: `depth` is the peak relative deviation, reached about 1 s into the note. *)
    export vibrato (frequency, frame, depth, sampleRate) =
        onset = 1.0 - exp (floatDiv ((-1.0) * frame, 0.35 * sampleRate))
        frequency * (1.0 + depth * onset * sin (floatDiv (33.929200658769766 * frame, sampleRate)))

    (** Frequency moved by `cents` hundredths of a semitone. *)
    export detuned (frequency, cents) = frequency * pow (2.0, cents / 1200.0)

    (** Equal-power pan gains for pan −1 (left) to 1 (right). *)
    export panLeft pan = cos (0.7853981633974483 * (pan + 1.0))

    (** Right-channel equal-power pan gain. *)
    export panRight pan = sin (0.7853981633974483 * (pan + 1.0))

    (** Master lift: the gain that puts the mix's peak on `ceiling`. A silent mix stays silent. *)
    export lifted (peak, ceiling) = match peak <= 0.0
        true => 0.0
        false => floatDiv (ceiling, peak)

    (** A deterministic, normalised single-cycle harmonic sample for the initial grain-cloud patch. *)
    export grainSample index = 0.5 * sin (6.283185307179586 * index / 1024.0) + 0.25 * sin (18.84955592153876 * index / 1024.0) + 0.125 * sin (43.982297150257104 * index / 1024.0)

    (** A track's mix is playable: gain 0–4, pan −1 (left) to 1 (right). *)
    export mixable (gain, pan) = gain >= 0.0 && gain <= 4.0 && pan >= (-1.0) && pan <= 1.0

    (** A note velocity is 0 (silent) to 1 (full). *)
    export audible velocity = velocity >= 0.0 && velocity <= 1.0

    (** A note starting at `start` falls in the `beats` long window beginning at `first`. *)
    export inWindow (start: float, first, beats) = start >= first && start - first < beats

    (** A start beat moved so the window beginning at `first` starts at beat 0. *)
    export shifted (start: float, first) = start - first

    (** `value` times `factor`: a gain applied, or a setting following the note's frequency or velocity. *)
    export scaled (value: float, factor) = value * factor

    (** A bus sample with `sample` mixed in at `gain`. *)
    export bused (existing: float, gain, sample) = existing + gain * sample

    (** `sample` under a gate envelope whose attack and release are in seconds. *)
    export enveloped (sample, frame, gate, attack, release, sampleRate) = sample * gated (frame, gate, attack * sampleRate, release * sampleRate)

    (** Loop storage for one period of `frequency`, with eight frames of headroom. *)
    export loopRoom (sampleRate, frequency) = ceil (floatDiv (sampleRate, frequency)) + 8.0

    (** A pluck's noise colour: softer notes are darker. *)
    export pickColour velocity = 0.7 * (1.0 - velocity)

    (** Bow speed: 0.3 of the velocity, with an 80 ms attack and a 100 ms release. *)
    export bowSpeed (velocity, frame, gate, sampleRate) = 0.3 * velocity * gated (frame, gate, 0.08 * sampleRate, 0.1 * sampleRate)

    (** One of the operator pair's level: half the velocity under the tone's envelope. *)
    export operatorLevel (velocity, frame, gate, attack, release, sampleRate) = 0.5 * velocity * gated (frame, gate, attack * sampleRate, release * sampleRate)

    (** A drum body's level: the share of the hit that is not noise, ringing out over `decay` s. *)
    export drumBody (velocity, noise, frame, decay: float, sampleRate: float) = velocity * (1.0 - noise) * ringing (frame, decay, sampleRate)

    (** The piece's frames: the last note end plus two seconds for its sound to ring out. *)
    export pieceFrames (beats, tempo, sampleRate) = beatFrames (beats, tempo, sampleRate) + secondFrames (2.0, sampleRate)

    (** One step of a one-pole low-pass toward `input`; `coefficient` comes from `poleCoefficient`. *)
    export onePole (previous: float, input, coefficient) = input + coefficient * (previous - input)

    (** One-pole coefficient for a corner at `frequency` Hz. *)
    export poleCoefficient (frequency, sampleRate) = exp (floatDiv ((-6.283185307179586) * frequency, sampleRate))

    (** Three-band EQ from two low-pass splits: `low` below the low corner, `band - low` between the corners and `input - band` above, each at its gain in dB. At 0 dB the three bands add back up to the input. *)
    export banded (input, low, band, lowGain, midGain, highGain) =
        bass = exp (lowGain * 0.1151292546497023)
        mid = exp (midGain * 0.1151292546497023)
        treble = exp (highGain * 0.1151292546497023)
        treble * input + (mid - treble) * band + (bass - mid) * low

    (** A bus is playable: gain 0–4, EQ gains −24 to 24 dB, ratio 1–20, knee 0–24 dB, attack and release 0–2 s. *)
    export busValid (gain, low, mid, high, ratio, knee, attack, release) = gain >= 0.0 && gain <= 4.0 && low >= (-24.0) && low <= 24.0 && mid >= (-24.0) && mid <= 24.0 && high >= (-24.0) && high <= 24.0 && ratio >= 1.0 && ratio <= 20.0 && knee >= 0.0 && knee <= 24.0 && attack >= 0.0 && attack <= 2.0 && release >= 0.0 && release <= 2.0

    (** [DAW-TRANSPORT-LIVE] A live sample: Master three quarters up, through a cubic soft clip that never leaves -1 to 1, since live play cannot know the song's peak before it sounds. *)
    export live sample =
        raw = sample * 0.75
        held = match raw < (-1.0)
            true => -1.0
            false => match raw > 1.0
                true => 1.0
                false => raw
        1.5 * held - 0.5 * held * held * held
