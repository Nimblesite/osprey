// [DAW-TRACK-PATCH] Every track is what Prism edits: tapping a track on the timeline opens its patch.
namespace daw

(** The bridge between the timeline and Prism. A routed track opens as its own graph; a built-in instrument
    opens as one voice node (the synth component nearest it, carrying the instrument's own settings) wired
    to the output. Settings are resolved at middle C and full velocity. *)
module TrackPatches
    reference () = Note(pitch = 60, start = 0.0, length = 1.0, velocity = 1.0)

    // Room for the lowest pitch a string or bow voice plays: 48 kHz / 2,048 samples is under 24 Hz.
    stringRoom = 2048

    fixed (key, value) = Setting(key = key, value = value, follow = Constant)

    pitched () = Setting(key = "frequency", value = 1.0, follow = Pitched)

    (** One voice node (identity 1) feeding the output (identity 2). *)
    voice (component, size, settings) = Routing(nodes = [PatchNode(identity = 1, component = component, size = size, seed = 1, asset = "", settings = settings), PatchNode(identity = 2, component = "output", size = 0, seed = 0, asset = "", settings = [])], cables = [PatchCable(source = 1, outlet = 0, destination = 2, inlet = 0)], attack = 0.005, release = 0.2)

    (** The routing a track's instrument plays: its own, or one voice node for a built-in instrument. *)
    export routing instrument = match instrument
        PatchInstrument routed => routed
        PluckInstrument brightness decay => voice ("waveguide", stringRoom, [pitched (), fixed ("brightness", brightness), fixed ("decay", decay)])
        BowInstrument pressure brightness _ => voice ("bowed", stringRoom, [pitched (), fixed ("pressure", pressure), fixed ("brightness", brightness)])
        BellInstrument decay brightness => voice ("modal", 0, [pitched (), fixed ("body", 3.0), fixed ("decay", decay), fixed ("brightness", brightness)])
        MalletInstrument decay brightness => voice ("modal", 0, [pitched (), fixed ("body", 1.0), fixed ("decay", decay), fixed ("brightness", brightness)])
        OperatorInstrument tone => voice ("operator", 0, [pitched (), fixed ("breakpoint", tone.breakpoint), fixed ("feedback", tone.feedback)])
        DrumInstrument hit => voice ("exciter", 0, [fixed ("colour", hit.colour)])

    (** The graph Prism shows for `track`. *)
    export patch track = PatchVoices::patched (reference (), routing track.instrument)

    (** The patch of the track at `index`: the one a tap on that timeline row opens. *)
    export picked (arrangement, index) = match listGet arrangement.tracks index
        Error _ => Error(message = "The arrangement has no track ${toString index}.")
        Success track => patch track
