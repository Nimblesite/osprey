// [SYNTH-ARRANGEMENT-FILE] The JSON boundary: a song project decoded into the typed arrangement.
namespace daw

(** A song project is one JSON object that mirrors `daw.td` exactly: every key is the field name of the type it
    holds (an `Arrangement`, its `Track`s, each `Routing`'s `PatchNode`s and `PatchCable`s, `Note`s and
    `NodePosition`s). A union value is an object whose `kind` is the variant's name, with that variant's fields
    beside it; a variant with no fields (a setting's `follow`) is just its name. The intro `recording` is `~/`
    for the home folder or relative to the working folder; "" means the piece stands alone. *)
module SongFiles

    follow name = match name
        "Constant" => Success(value = Constant)
        "Pitched" => Success(value = Pitched)
        "Struck" => Success(value = Struck)
        other => Error(message = "A setting's follow must be Constant, Pitched or Struck, not \"${other}\".")

    setting doc = synth::Outcomes::carried (follow (ui::Doc::text (doc, "follow")), \how => Success(value = ProjectCodec::readSetting (doc, how)))

    node doc = synth::Outcomes::carried (folded (doc, "settings", setting), \settings => Success(value = ProjectCodec::readPatchNode (doc, settings)))

    each (doc, key, read) = mapList (ui::Doc::fieldItems (doc, key), read)

    // A routing must carry a playable gate; a missing `routing`, `attack` or `release` reads as 0 and is refused here.
    routing doc = synth::Outcomes::carried (folded (doc, "nodes", node), \nodes => PatchVoices::enveloped (ProjectCodec::readRouting (doc, nodes, each (doc, "cables", ProjectCodec::readPatchCable))))

    instrument doc = match ui::Doc::text (doc, "kind")
        "PluckInstrument" => Success(value = ProjectCodec::readPluckInstrument doc)
        "BowInstrument" => Success(value = ProjectCodec::readBowInstrument doc)
        "BellInstrument" => Success(value = ProjectCodec::readBellInstrument doc)
        "MalletInstrument" => Success(value = ProjectCodec::readMalletInstrument doc)
        "OperatorInstrument" => Success(value = ProjectCodec::readOperatorInstrument (ProjectCodec::readTone (ui::Doc::field (doc, "tone"))))
        "DrumInstrument" => Success(value = ProjectCodec::readDrumInstrument (ProjectCodec::readHit (ui::Doc::field (doc, "hit"))))
        "PatchInstrument" => synth::Outcomes::carried (routing (ui::Doc::field (doc, "routing")), \routed => Success(value = ProjectCodec::readPatchInstrument routed))
        other => Error(message = "Unknown instrument kind \"${other}\".")

    note doc = match jsonInt (ui::Doc::field (doc, "pitch"))
        Error _ => Error(message = "A note's pitch must be a whole MIDI number.")
        Success _ => Success(value = ProjectCodec::readNote doc)

    appended (carry, decoded) = match carry
        Error why => Error(message = why)
        Success kept => synth::Outcomes::carried (decoded, \next => Success(value = listAppend kept next))

    folded (doc, key, read) = foldList (ui::Doc::fieldItems (doc, key), Success(value = []), \(carry, item) => appended (carry, read item))

    failed (doc, why) = Error(message = "${ui::Doc::text (doc, "name")}: ${why}")

    position doc = match jsonInt (ui::Doc::field (doc, "layoutNode"))
        Success id => match id >= 0 && ui::Doc::kind (ui::Doc::field (doc, "layoutX")) == "number" && ui::Doc::kind (ui::Doc::field (doc, "layoutY")) == "number"
            true => Success(value = ProjectCodec::readNodePosition doc)
            false => Error(message = "A node position needs a node identity and numeric layoutX and layoutY.")
        Error _ => Error(message = "A node position needs a whole layoutNode identity.")

    uniquePositions positions = match foldList (positions, true, \(ok, p) => ok && length (filterList (positions, \other => other.layoutNode == p.layoutNode)) == 1)
        true => Success(value = positions)
        false => Error(message = "A patch node has two layout positions.")

    // [DAW-MIX-BUS] A bus with its EQ and compressor.
    bus doc = match ui::Doc::has (doc, "output") && ui::Doc::kind (ui::Doc::field (doc, "output")) != "text"
        true => Error(message = "A bus output must be a bus name or the empty Master output.")
        false => Success(value = ProjectCodec::readBus (doc, ProjectCodec::readEqualiser (ui::Doc::field (doc, "equaliser")), ProjectCodec::readCompressor (ui::Doc::field (doc, "compressor"))))

    routeSend doc = match jsonInt (ui::Doc::field (doc, "sendId"))
        Success identity => match jsonInt (ui::Doc::field (doc, "source"))
            Success source => match jsonInt (ui::Doc::field (doc, "outlet"))
                Success outlet => match identity >= 0 && source >= 0 && outlet >= 0 && ui::Doc::kind (ui::Doc::field (doc, "bus")) == "text" && ui::Doc::kind (ui::Doc::field (doc, "level")) == "number" && ui::Doc::kind (ui::Doc::field (doc, "enabled")) == "bool"
                    true => Success(value = ProjectCodec::readAudioSend doc)
                    false => Error(message = "A send needs a bus, level and enabled flag.")
                Error _ => Error(message = "The send outlet must be a whole number.")
            Error _ => Error(message = "The send needs a source node identity.")
        Error _ => Error(message = "The send needs an identity.")

    sends doc = match ui::Doc::has (doc, "sends") && ui::Doc::kind (ui::Doc::field (doc, "sends")) != "list"
        true => Error(message = "A track’s sends must be a list.")
        false => folded (doc, "sends", routeSend)

    track doc = match instrument (ui::Doc::field (doc, "instrument"))
        Error why => failed (doc, why)
        Success sound => match folded (doc, "notes", note)
            Error why => failed (doc, why)
            Success notes => synth::Outcomes::carried (synth::Outcomes::carried (folded (doc, "positions", position), uniquePositions), \positions => synth::Outcomes::carried (sends doc, \sends => Success(value = ProjectCodec::readTrack (doc, sound, sends, positions, notes))))

    (** Whether `path` can be single-quoted on a command line. *)
    export safe path = contains path "'" == false

    // No recording means the piece stands alone; a recording must be a quotable path, its held tail lasts
    // 0.5–10 s and the crossfade fits inside it.
    checked recording = match recording.recording == "" || safe recording.recording && recording.tail >= 0.5 && recording.tail <= 10.0 && recording.crossfade > 0.0 && recording.crossfade <= recording.tail
        true => Success(value = recording)
        false => Error(message = "The intro needs a recording path without quotes, a tail of 0.5–10 seconds and a crossfade no longer than the tail.")

    arranged (doc, tracks, buses) =
        ProjectCodec::readArrangement (doc, ProjectCodec::readSpace (ui::Doc::field (doc, "space")), ProjectCodec::readIntro (ui::Doc::field (doc, "intro")), each (doc, "sustains", ProjectCodec::readAfterglow), buses, tracks)

    // Every sustain appearance must play and every track name is unique (a sidechain keys on the name), so a bad
    // project is refused on opening, not halfway through a render.
    playable song = match length (filterList (song.sustains, \glow => Sustains::valid glow == false)) == 0
        false => Error(message = "A sustain appearance has controls out of range or holds more than 119 s.")
        true => match listGet (filterList (song.tracks, \voice => length (filterList (song.tracks, \other => other.name == voice.name)) > 1)) 0
            Success twin => Error(message = "Track names must be unique: \"${twin.name}\" names more than one track.")
            Error _ => opened song

    // A project with tracks must be one the renderer can play; a new, empty one still opens and saves.
    opened song = match length song.tracks == 0
        true => Success(value = song)
        false => synth::Outcomes::carried (Arrangements::frames song, \_ => Success(value = song))

    (** Decode a song project; malformed JSON, an unknown instrument, a malformed note, a routing without a playable
        gate, a sustain out of range, a repeated track name, or a tempo, rate, drive or track count the renderer cannot
        play is an error. *)
    export decode source = match jsonDecode source
        Error _ => Error(message = "The song project is not valid JSON.")
        Success doc => match checked (ProjectCodec::readIntro (ui::Doc::field (doc, "intro")))
            Error why => Error(message = why)
            Success _ => synth::Outcomes::carried (folded (doc, "tracks", track), \tracks => synth::Outcomes::carried (folded (doc, "buses", bus), \buses => synth::Outcomes::carried (BusPaths::order buses, \_ => synth::Outcomes::carried (SendRenders::project (arranged (doc, tracks, buses)), \song => playable song))))

    (** Write the complete project as JSON. *)
    export encode arrangement = match jsonEncode (ProjectCodec::writeArrangement arrangement)
        Error why => Error(message = "The project could not be written as JSON: ${why}")
        Success text => Success(value = text)
