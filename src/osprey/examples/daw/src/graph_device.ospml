// [SYNTH-DEVICE-QUEUE] Device I/O stays at the app boundary; graph state remains typed.
namespace synth

import ui::Requests
import ui::Doc

(** Transfer completed graph blocks into one owned native audio queue. *)
module GraphDevice
    submit (editor, operation, position, text) =
        ticket = "prism-audio:device:${editor.renderSerial}:${position}:${operation}"
        next = editor(renderTicket = ticket, renderInput = text)
        session = GraphWorkers::header ("session", editor.renderDeviceKey)
        match editor.audioPath != ""
            true => ui::Runtime::asking (next, [GraphWorkers::call (ticket, "session-exchange", [session, GraphWorkers::header ("stdinText", text)], "")])
            false =>
                input = "prism-worker:-1:input"
                arguments = [session, GraphWorkers::header ("stdinSlice", input)]
                ui::Step(stepStore = next, requests = [GraphWorkers::call (ticket, "session-exchange", arguments, GraphWorkers::output -1)], writes = [Requests::write (input, text)])

    prepared (editor, pending, hex) =
        next = editor(renderDevicePending = [pending], renderPending = [], renderInput = hex, renderOpening = false)
        match next.renderDeviceKey == ""
            false => submit (next, "block", pending.deviceState.graphPosition, hex)
            true =>
                ticket = "prism-audio:device:${next.renderSerial}:open"
                executable = ui::Pick::either (next.audioPath == "", next.workerPath, next.audioPath)
                arguments = [GraphWorkers::header ("executable", executable), GraphWorkers::header ("argv", "audio-device")]
                ui::Runtime::asking (next(renderTicket = ticket), [GraphWorkers::call (ticket, "session-open", arguments, ticket)])

    // A bounded visual snapshot of real output; no device callback reads UI state.
    monitored clip = foldList (toList (range (0, 64)), [], \(samples, index) =>
        match listGet clip.clipSamples (satMul (satMul index 16) clip.clipChannels)
            Error _ => samples
            Success value => listAppend samples value)

    (** Decode/encode PCM outside the device callback, then hold the exact next graph state. *)
    export request (editor, held, clip) = synth::Outcomes::carried (WaveFiles::interleaved (48000, clip.clipChannels, clip.clipSamples), \hex => Success(value = prepared (editor(scopeSamples = monitored clip), DevicePending(deviceState = held, deviceChannels = clip.clipChannels), hex)))

    (** Adopt the device handle before sending data, so any later failure can release it. *)
    export opened (editor, text) = match GraphWorkers::opened (editor, text)
        Error why => Error(message = why)
        Success next => match next.renderDevicePending
            [pending] => match filterList (next.renderSessions, \held => held.sessionNode == -1)
                [held] => Success(value = submit (next(renderDeviceKey = held.sessionKey), "block", pending.deviceState.graphPosition, next.renderInput))
                _ => Success(value = GraphWorkers::release (ui::Runtime::step (next(message = "Graph playback failed: no unique device handle."))))
            _ => Success(value = GraphWorkers::release (ui::Runtime::step (next(message = "Graph playback failed: no unique device block."))))

    whole (doc, key) = match jsonInt (Doc::field (doc, key))
        Error _ => false
        Success _ => true

    counters doc = length (filterList (["acceptedFrames", "returnedFrames", "queuedFrames", "channels", "emptyCallbacks"], \key => whole (doc, key))) == 5 && Doc::kind (Doc::field (doc, "running")) == "bool"

    decoded doc = match counters doc
        false => Error(message = "The device returned incomplete queue counters.")
        true => Success(value = DeviceReceipt(acceptedFrames = Doc::number (doc, "acceptedFrames"), returnedFrames = Doc::number (doc, "returnedFrames"), queuedFrames = Doc::number (doc, "queuedFrames"), deviceChannels = Doc::number (doc, "channels"), emptyCallbacks = Doc::number (doc, "emptyCallbacks"), deviceRunning = Doc::flag (doc, "running")))

    valid (receipt, pending, draining, previous) = receipt.acceptedFrames == pending.deviceState.graphPosition && receipt.deviceChannels == pending.deviceChannels && receipt.returnedFrames >= 0 && receipt.returnedFrames <= receipt.acceptedFrames && receipt.queuedFrames == satSub receipt.acceptedFrames receipt.returnedFrames && receipt.queuedFrames <= 32768 && receipt.emptyCallbacks >= previous && (draining == false || (receipt.deviceRunning == false && receipt.queuedFrames == 0))

    (** Queue acknowledgments must match the exact submitted graph clock and layout. *)
    received (editor, text) = match editor.renderDevicePending
        [pending] => match jsonDecode text
            Error why => Error(message = why)
            Success doc => match decoded doc
                Error why => Error(message = why)
                Success receipt => match valid (receipt, pending, editor.renderInput == "!drain", editor.renderEmptyCallbacks)
                    false => Error(message = "The device counters differ from the submitted graph block.")
                    true => Success(value = receipt)
        _ => Error(message = "The device reply has no unique pending graph block.")

    (** Both the worker status and the counters must acknowledge the submitted block. *)
    export checked (editor, text) = synth::Outcomes::carried (ProcessResults::checked (Success(value = text)), \_ => received (editor, text))

    (** Wait for device consumption before releasing an audition's worker. *)
    export drain (editor, position) = submit (editor, "drain", position, "!drain")
