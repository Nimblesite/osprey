// [PRISM-ROUTING-EDITOR] History stores the editable project and its working patch, never audio sessions or UI resources.
namespace synth

(** Bounded project history, independent of runtime session ownership. *)
module EditorHistory
    (** The project and working patch as they stand, for history or to hold while a gesture is under way. *)
    export snapshot editor = GraphSnapshot(savedGraph = editor.graph, savedSong = editor.song, savedTrack = editor.track, savedPatchTrack = editor.patchTrack, savedTimelineNote = editor.selectedNote, savedNextIdentity = editor.nextIdentity, savedPositions = editor.positions, savedFlow = editor.flowPositions, savedBindings = editor.pluginBindings, savedSelected = editor.selected, savedNote = editor.note)

    same (a, b) = structuralEquals (a.savedGraph, b.savedGraph) && structuralEquals (a.savedPositions, b.savedPositions) && structuralEquals (a.savedBindings, b.savedBindings)

    window (frames, first, limit) =
        collected = foldList (frames, { index = 0, kept = [] }, \(held, frame) =>
            included = held.index >= first && held.index < limit
            { index = satAdd held.index 1, kept = ui::Pick::either (included, listAppend held.kept frame, held.kept) })
        collected.kept

    // Bound retained graphs while preserving the newest edit first.
    pushed (frame, frames) = listConcat [frame] (window (frames, 0, 63))

    remaining frames = window (frames, 1, length frames)

    restore (editor, frame) = editor(song = frame.savedSong, track = frame.savedTrack, patchTrack = frame.savedPatchTrack, selectedNote = frame.savedTimelineNote, nextIdentity = ui::Pick::either (editor.nextIdentity >= frame.savedNextIdentity, editor.nextIdentity, frame.savedNextIdentity), rollDrag = RollIdle, outputEdit = OutputClosed, graph = frame.savedGraph, positions = frame.savedPositions, flowPositions = frame.savedFlow, panning = PanIdle, pluginBindings = frame.savedBindings, selected = frame.savedSelected, note = frame.savedNote, armedNote = -1, selectedCable = -1, source = -1, dragging = -1, wireDragging = false, paletteDrag = "", gesture = [], mixFader = FaderIdle, revision = satAdd editor.revision 1, layoutRevision = satAdd editor.layoutRevision 1)

    (** Restore the preceding edit from any project view. *)
    export undo editor = match listGet editor.past 0
        Error _ => editor(message = "Nothing to undo.")
        Success frame =>
            next = restore (editor, frame)
            next(past = remaining editor.past, future = pushed (snapshot editor, editor.future), message = "Undid edit.")

    (** Reapply the edit and its saved project state. *)
    export redo editor = match listGet editor.future 0
        Error _ => editor(message = "Nothing to redo.")
        Success frame =>
            next = restore (editor, frame)
            next(past = pushed (snapshot editor, editor.past), future = remaining editor.future, message = "Redid edit.")

    (** Only committed mixer, routing or note changes enter history. *)
    export project (before, after) = match structuralEquals (before.song, after.song)
        true => after
        false => after(past = pushed (snapshot before, before.past), future = [])

    changed (before, after) = match same (before, snapshot after)
        true => after
        false => after(past = pushed (before, after.past), future = [])

    // Pointer motion is provisional: commit the entire movement only on release.
    tracked (before, after) = match after.dragging >= 0
        true => match length before.gesture == 0
            true => after(gesture = [snapshot before])
            false => after
        false => match listGet before.gesture 0
            Success frame => changed (frame, after(gesture = []))
            Error _ => changed (snapshot before, after)

    (** Record successful edits and collapse a pointer drag into one history entry. *)
    // The mixer owns its snapshot from first motion through release, including its single project undo.
    export record (before, after) = match DawSession::holding after || DawSession::holding before || length before.past != length after.past || length before.future != length after.future || before.patchTrack != after.patchTrack
        true => after
        false => match before.revision == after.revision && before.layoutRevision == after.layoutRevision && before.dragging == after.dragging
            true => after
            false => tracked (before, after)
