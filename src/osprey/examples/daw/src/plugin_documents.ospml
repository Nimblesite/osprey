// [PRISM-ROUTING-VST] JSON exists only at this worker-output boundary.
namespace synth

import ui::Doc

(** Strict worker receipts become typed metadata before reaching the editor. *)
module PluginDocuments
    isText (doc, key) = Doc::kind (Doc::field (doc, key)) == "text"

    isInt (doc, key) = match jsonInt (Doc::field (doc, key))
        Success _ => true
        Error _ => false

    isBool (doc, key) = Doc::kind (Doc::field (doc, key)) == "bool"

    scanned text = match jsonDecode text
        Error why => Error(message = why)
        Success doc => match isText (doc, "id") && isText (doc, "name") && Doc::text (doc, "bundle") != "" && Doc::text (doc, "event") == "vst.class" && length (Doc::text (doc, "id")) == 32 && Doc::text (doc, "name") != ""
            false => Error(message = "The worker returned an invalid VST class.")
            true => Success(value = PluginClass(classId = Doc::text (doc, "id"), className = Doc::text (doc, "name"), bundle = Doc::text (doc, "bundle")))

    scanLine (outcome, text) = match outcome
        Error why => Error(message = why)
        Success classes => match scanned text
            Error why => Error(message = why)
            Success entry => match length (filterList (classes, \c => c.classId == entry.classId)) > 0
                true => Error(message = "The worker returned a duplicate VST class.")
                false => Success(value = listAppend classes entry)

    (** Parse the worker's bounded JSON-lines class inventory, rejecting incomplete rows. *)
    export scan text = match split text "\n"
        Error why => Error(message = why)
        Success lines =>
            rows = filterList (lines, \line => trim line != "")
            match length rows <= 4096
                false => Error(message = "The module contains no supported classes or too many classes.")
                true => foldList (rows, Success(value = []), scanLine)

    export bundles text = match jsonDecode text
        Error why => Error(message = why)
        Success doc =>
            paths = mapList (Doc::items doc, Doc::string)
            match Doc::kind doc == "list" && length paths <= 4096 && !ui::Lists::any (paths, \p => p == "")
                true => Success(value = paths)
                false => Error(message = "Invalid VST3 folder inventory.")

    control doc = match isInt (doc, "id") && isText (doc, "name") && Doc::kind (Doc::field (doc, "initial")) == "number" && isBool (doc, "automatable")
        false => Error(message = "The worker returned an invalid VST parameter.")
        true => Success(value = HostControl(identity = Doc::number (doc, "id"), name = Doc::text (doc, "name"), initial = Doc::decimal (doc, "initial"), automatable = Doc::flag (doc, "automatable")))

    readControl (outcome, doc) = match outcome
        Error why => Error(message = why)
        Success controls => synth::Outcomes::carried (control doc, \entry => Success(value = listAppend controls entry))

    metadata doc = match (!Doc::has (doc, "latency") || isInt (doc, "latency")) && isText (doc, "id") && isText (doc, "name") && isInt (doc, "inputs") && isInt (doc, "outputs") && isBool (doc, "notes") && Doc::kind (Doc::field (doc, "parameters")) == "list" && length (Doc::fieldItems (doc, "parameters")) <= 1024
        false => Error(message = "The worker returned an incomplete VST descriptor.")
        true => synth::Outcomes::carried (foldList (Doc::fieldItems (doc, "parameters"), Success(value = []), readControl), \controls => Success(value = HostDescriptor(latency = Doc::number (doc, "latency"), identifier = Doc::text (doc, "id"), name = Doc::text (doc, "name"), inputChannels = Doc::number (doc, "inputs"), outputChannels = Doc::number (doc, "outputs"), notes = Doc::flag (doc, "notes"), controls = controls)))

    (** Decode required fields; graph validation then checks ranges and unique IDs. *)
    export describe text = synth::Outcomes::carried (jsonDecode text, \doc => metadata doc)

    // A project stores the graph-facing interface. Bundle paths come only from local discovery.
    controlDoc (outcome, p: Parameter) = Outcomes::carried (outcome, \docs =>
        match parseInt (drop p.key 4)
            Error _ => Error(message = "Invalid hosted parameter key.")
            Success id => Success(value = listAppend docs (JsonObject [JsonMember "id" (JsonInt id), JsonMember "name" (JsonString p.label), JsonMember "initial" (JsonFloat p.initial), JsonMember "automatable" (JsonBool p.automatable)])))

    export stored (n, identifier, latency) = match ClipInputs::layout n
        Error _ => Error(message = "The VST3 node has an invalid layout.")
        Success layout => Outcomes::carried (foldList (n.parameters, Success(value = []), controlDoc), \controls =>
            modulation = mapList (filterList (n.inputs, \p => p.rate == Control), \p => JsonString p.name)
            jsonEncode (JsonObject [JsonMember "latency" (JsonInt latency), JsonMember "id" (JsonString identifier), JsonMember "name" (JsonString identifier), JsonMember "inputs" (JsonInt layout.inputChannels), JsonMember "outputs" (JsonInt layout.outputChannels), JsonMember "notes" (JsonBool layout.acceptsNotes), JsonMember "parameters" (JsonArray controls), JsonMember "modulation" (JsonArray modulation)]))

    restoredPort (outcome, key) = Outcomes::carried (outcome, \n =>
        match ui::Lists::any (n.parameters, \p => p.key == key && p.automatable) && !ui::Lists::any (n.inputs, \p => p.name == key)
            false => Error(message = "The project contains an invalid VST3 modulation port.")
            true => Success(value = n(inputs = listAppend n.inputs (Port(name = key, rate = Control, channels = 1, unit = Normalised)))))

    export restored (identity, text) = Outcomes::carried (jsonDecode text, \doc => Outcomes::carried (metadata doc, \descriptor =>
        match Hosted::component (identity, descriptor)
            Invalid _ => Error(message = "The saved VST3 descriptor is invalid.")
            Valid n => foldList (Doc::texts (doc, "modulation"), Success(value = n), restoredPort)))
