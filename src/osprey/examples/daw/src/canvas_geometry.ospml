namespace synth

(** Canvas placement, card geometry and musical keyboard [PRISM-ROUTING-LAYOUT]. *)
module CanvasGeometry
    (** Node centres leave a dedicated palette at the left of the canvas. *)
    export gridX column = 350.0 + column * 310.0

    (** Grid y. *)
    export gridY row = 170.0 + row * 235.0

    (** Leave room between the widest Prism cards for the cable and both sockets. *)
    export signalX depth = 350.0 + depth * 340.0

    (** Collides. *)
    export collides (x, y, otherX, otherY) = abs (x - otherX) < 320.0 && abs (y - otherY) < 205.0

    (** Centre a row of control sockets with a gap between their 28-point hit targets. *)
    export controlSocketX (centre, rank, count) = centre + (rank - (count - 1.0) / 2.0) * 34.0

    (** Offset. *)
    export offset (pointer: float, centre) = pointer - centre

    (** Right-anchored artwork and its hit areas share the viewport expansion. *)
    export shifted (base: float, extra) = base + extra

    (** Pan offset. *)
    export panOffset (origin, grab, pointer, last, first) =
        limit = match last > first
            true => last - first
            false => 0.0
        FitMath::clip (origin + grab - pointer, 0.0, limit)

    (** Node hit areas remain entirely in the graph, outside the palette. *)
    export dragX (pointer, grab, spareWidth) = FitMath::clip (pointer - grab, 155.0, 1065.0 + spareWidth)

    (** Drag y. *)
    export dragY (pointer, grab, spareHeight) = FitMath::clip (pointer - grab, 155.0, 700.0 + spareHeight)

    (** Valid. *)
    export valid (px, py) = px == px && py == py && abs px <= 1000000.0 && abs py <= 1000000.0

    (** Equal temperament, A4 = 440 Hz. *)
    export frequency note = 440.0 * pow (2.0, (note - 69.0) / 12.0)

    (** Palette row centre and keyboard white-key left edge. *)
    export paletteY index = 130.0 + index * 48.0

    (** Key x. *)
    export keyX index = 24.0 + index * 56.0

    (** Wave y. *)
    export waveY (centre, sample) = centre - FitMath::clip (sample, -1.0, 1.0) * 25.0

    (** Match the original Prism logarithmic cutoff slider. *)
    export cutoffPosition hz = floatDiv (ln (hz / 20.0), ln 1000.0)

    (** Inverse of the original logarithmic cutoff slider. *)
    export cutoffFrequency position = FitMath::clip (20.0 * pow (1000.0, FitMath::clip (position, 0.0, 1.0)), 20.0, 19000.0)

    (** The cable painter and hit testing share the same cubic curve. *)
    cubic (a, b, c, d, t) = (1.0 - t) * (1.0 - t) * (1.0 - t) * a + 3.0 * (1.0 - t) * (1.0 - t) * t * b + 3.0 * (1.0 - t) * t * t * c + t * t * t * d

    (** Cable x. *)
    export cableX (source, target, index) = cubic (source, source + 70.0, target - 70.0, target, index / 48.0)

    (** Cable y. *)
    export cableY (source, target, index) = cubic (source, source, target, target, index / 48.0)

    (** A bounded point-to-segment test avoids gaps between sampled cable points. *)
    export nearSegment (px, py, ax, ay, endX, endY) =
        dx = endX - ax
        dy = endY - ay
        length = dx * dx + dy * dy
        t = match length == 0.0
            true => 0.0
            false => FitMath::clip (floatDiv ((px - ax) * dx + (py - ay) * dy, length), 0.0, 1.0)
        ex = px - (ax + t * dx)
        ey = py - (ay + t * dy)
        ex * ex + ey * ey <= 100.0

    (** Static source display decimation, independent of live audio activity. *)
    export grainIndex (index, count) = floor (index * (count - 1.0) / 47.0)

    (** Grain x. *)
    export grainX (centre, index) = centre - 116.0 + index * 232.0 / 47.0
