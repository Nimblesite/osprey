// [DAW-PAGES] The mix: every track's gain and pan into Master, and the selected track's path.
namespace synth

import ui::Scenes

(** The Mix page: the routing table and the selected track's signal flow to the stereo out. *)
module MixView
    label (words, x, y, size, colour, anchor) = TimelineView::label (words, x, y, size, colour, anchor, 8)

    height editor = TimelineGeometry::mixHeight (toFloat (length editor.song.tracks))

    rail (left, top, width, value, full, chosen) = [TimelineView::box (left, top, width, 3.0, Scenes::rgb (52, 46, 84), 3), TimelineView::box (left, top, TimelineGeometry::meter (value, full, width), 3.0, ui::Pick::either (chosen, TimelineView::accent (), TimelineView::lavender ()), 4)]

    row (editor, index, voice) =
        top = TimelineGeometry::mixY (toFloat index, height editor)
        chosen = index == editor.track
        mid = top + height editor / 2.0
        colour = ui::Pick::either (chosen, TimelineView::accent (), TimelineView::dim ())
        fill = ui::Pick::either (chosen, Scenes::rgb (49, 33, 53), ui::Pick::either (index % 2 == 0, Scenes::rgb (22, 19, 40), Scenes::rgb (18, 15, 34)))
        ui::Lists::flatten [[TimelineView::box (0.0, top, 710.0, height editor, fill, 2), TimelineView::box (0.0, top, 3.0, height editor, ui::Pick::either (chosen, colour, fill), 3), label ("${satAdd index 1}", 24.0, mid - 7.0, 11.0, colour, 0), label (voice.name, 56.0, mid - 9.0, 15.0, TimelineView::ink (), 0),
            label ("${TimelineView::hundredths voice.gain}×", 215.0, mid - 10.0, 12.0, TimelineView::ink (), 0), label (TimelineView::pan voice.pan, 294.0, mid - 10.0, 12.0, TimelineView::ink (), 0),
            Scenes::disc (380.0, mid, 5.0, TimelineView::accent (), 4), Scenes::disc (380.0, mid, 2.8, fill, 5), label (TimelineView::destination voice, 396.0, mid - 8.0, 13.0, TimelineView::ink (), 0), label ("⌄", 480.0, mid - 8.0, 13.0, TimelineView::dim (), 1)], rail (215.0, mid + 10.0, 55.0, voice.gain, 4.0, chosen), rail (294.0, mid + 10.0, 56.0, voice.pan + 1.0, 2.0, chosen)]

    table editor = listConcat [label ("Track routing", 24.0, 161.0, 19.0, TimelineView::ink (), 0), label ("${length editor.song.tracks} tracks", 151.0, 167.0, 12.0, TimelineView::dim (), 0), TimelineView::box (0.0, 201.0, 710.0, 34.0, TimelineView::panelInk (), 2),
        label ("TRACK", 24.0, 213.0, 11.0, TimelineView::dim (), 0), label ("GAIN", 215.0, 213.0, 11.0, TimelineView::dim (), 0), label ("PAN", 294.0, 213.0, 11.0, TimelineView::dim (), 0), label ("OUTPUT", 375.0, 213.0, 11.0, TimelineView::dim (), 0)] (foldList (toList (range (0, length editor.song.tracks)), [], \(all, index) =>
        match listGet editor.song.tracks index
            Error _ => all
            Success voice => listConcat all (row (editor, index, voice))))

    edge = 6246296

    card (left, top, title, detail, colour) = [EditorView::panel (left, top, 222.0, 74.0, colour, 5), EditorView::panel (left + 1.0, top + 1.0, 220.0, 72.0, 2103862, 6), TimelineView::box (left + 12.0, top + 40.0, 198.0, 1.0, TimelineView::panelInk (), 7), label (title, left + 21.0, top + 12.0, 17.0, TimelineView::ink (), 0), label (detail, left + 14.0, top + 49.0, 12.0, TimelineView::dim (), 0)]

    port (x, y) = [Scenes::disc (x, y, 5.0, TimelineView::accent (), 8), Scenes::disc (x, y, 2.7, TimelineView::panelInk (), 9)]

    wire points = Scenes::strip (points, TimelineView::accent (), 1.8, 4)

    forkY voice = ui::Pick::either (voice.bus != "", 321.0, 345.0)

    border selected = ui::Pick::either (selected, 16745538, edge)

    patchArea voice = TimelineView::area ("Open ${voice.name} patch", 963.0, 208.0, 222.0, 74.0, false)

    gainArea bus =
        area = TimelineView::area ("${bus.name} gain", 961.0, 813.0, 180.0, 40.0, false)
        area(accessRole = ui::Slidable, accessValue = bus.gain, accessMax = 4.0)

    busAreas (editor, voice) = match daw::BusMix::named (editor.song, voice.bus)
        Error _ => [patchArea voice]
        Success bus => [patchArea voice, TimelineView::area ("Choose group output", 738.0, 853.0, 210.0, 44.0, false), gainArea bus]

    sendAreas voice = match voice.sends
        [] => []
        _ => [TimelineView::area ("Inspect patch sends", 726.0, 208.0, 222.0, 74.0, false)]

    sendAt (voice, x, y) = match EditorView::areaAt (sendAreas voice, x, y) >= 0
        false => Error(message = "No bus here.")
        true => match voice.sends
            [tap] => Success(value = BeginSend(identity = tap.sendId))
            _ => Success(value = BrowseSends(offset = 0))

    graphAt (editor, x, y) = synth::Outcomes::carried (daw::Projects::required (editor.song.tracks, editor.track, "Select a track first."), \voice =>
        match EditorView::areaAt (busAreas (editor, voice), x, y)
            0 => Success(value = OpenTrack(index = editor.track))
            1 => Success(value = BrowseBuses)
            2 => synth::Outcomes::carried (daw::BusMix::named (editor.song, voice.bus), \bus =>
                area = gainArea bus
                Success(value = AdjustBusGain(name = bus.name, gain = TimelineGeometry::fader (x, area.accessLeft, area.accessWidth, area.accessMin, area.accessMax))))
            _ => sendAt (voice, x, y))

    onward bus = ui::Pick::either (bus.output == "", "Master", bus.output)

    via bus = match bus.output == ""
        true => []
        false => [TimelineView::box (906.0, 510.0, 115.0, 19.0, TimelineView::panelInk (), 6), label ("via ${bus.output}", 912.0, 511.0, 12.0, TimelineView::ink (), 0)]

    group (editor, voice) = match daw::BusMix::named (editor.song, voice.bus)
        Error _ => []
        Success bus => listConcat (card (789.0, 430.0, bus.name, "EQ · compressor · ${TimelineView::hundredths bus.gain}×", border true)) (ui::Lists::flatten [port (900.0, 430.0), port (900.0, 504.0), via bus])

    sendPath (voice, master) = match voice.sends
        [] => []
        [first, ...more] =>
            active = length (filterList (voice.sends, \tap => tap.enabled && tap.level > 0.0))
            title = ui::Pick::either (length more == 0, first.bus, "Patch sends")
            detail = ui::Pick::either (length more == 0, "Pre-fader · ${TimelineView::percent first.level}", "${active} / ${length voice.sends} active · Pre-fader")
            colour = ui::Pick::either (active > 0, TimelineView::accent (), TimelineView::dim ())
            ui::Lists::flatten [card (726.0, 208.0, title, detail, edge), [Scenes::strip ([758.0, 282.0, 758.0, master + 37.0, 963.0, master + 37.0], colour, 1.8, 4)], port (758.0, 282.0)]

    flow (editor, voice) =
        grouped = voice.bus != ""
        fork = forkY voice
        master = ui::Pick::either (grouped, 542.0, 490.0)
        base = ui::Pick::either (grouped, 504.0, fork + 74.0)
        joinY = master - 31.0
        patch = patchArea voice
        ui::Lists::flatten [sendPath (voice, master), card (patch.accessLeft, patch.accessTop, voice.name, "Patch output · ${TimelineView::hundredths voice.gain}× gain", edge),
            card (789.0, fork, "Stereo pan", "${TimelineView::pan voice.pan} · Left / Right", edge),
            group (editor, voice), card (963.0, master, "Master", "Sum L/R", edge),
            [wire [1074.0, 282.0, 1074.0, fork - 25.0, 900.0, fork - 25.0, 900.0, fork]],
            ui::Pick::either (grouped, [wire [900.0, fork + 74.0, 900.0, 430.0]], []),
            [wire [900.0, base, 900.0, joinY, 1023.0, joinY, 1023.0, master], wire [1074.0, master + 74.0, 1074.0, master + 102.0], label ("Stereo out", 1074.0, master + 108.0, 13.0, TimelineView::ink (), 1)],
            port (1074.0, 282.0), port (900.0, fork), port (900.0, fork + 74.0), port (1023.0, master), port (1074.0, master + 74.0)]

    routing (editor, voice) = match voice.bus == ""
        true => []
        false => groupInspector (editor, voice)

    groupInput : (daw::Track, string) -> bool
    groupInput (track, name) = track.bus == name || ui::Lists::any (track.sends, \tap => tap.bus == name)

    groupInspector (editor, voice) = match daw::BusMix::named (editor.song, voice.bus)
        Error _ => []
        Success bus =>
            inputs = mapList (filterList (editor.song.tracks, \t => groupInput (t, bus.name)), \t => t.name)
            feeders = mapList (filterList (editor.song.buses, \other => other.output == bus.name), \other => other.name)
            joined = join (listConcat inputs feeders) ", "
            shown = ui::Pick::either (length joined > 24, ui::Pick::either (length feeders == 0, "${length inputs} tracks", "${length inputs} tracks · ${length feeders} groups"), joined)
            detector = ui::Pick::either (bus.compressor.sidechain == "", "Self", bus.compressor.sidechain)
            area = gainArea bus
            listConcat (rail (area.accessLeft, area.accessTop + area.accessHeight - 7.0, area.accessWidth, bus.gain, area.accessMax, true)) [label (bus.name, 738.0, 735.0, 23.0, TimelineView::ink (), 0), label ("Group bus", 1410.0, 740.0, 12.0, TimelineView::dim (), 2),
                label ("INPUTS", 738.0, 787.0, 11.0, TimelineView::dim (), 0), label ("BUS GAIN", 961.0, 787.0, 11.0, TimelineView::dim (), 0), label ("CHANNELS", 1191.0, 787.0, 11.0, TimelineView::dim (), 0),
                label (shown, 738.0, 819.0, 16.0, TimelineView::ink (), 0), label ("${TimelineView::hundredths bus.gain}×", 961.0, 819.0, 16.0, TimelineView::ink (), 0), label ("Stereo", 1191.0, 819.0, 16.0, TimelineView::ink (), 0),
                label ("Output     ${onward bus}   ›", 738.0, 871.0, 12.0, TimelineView::dim (), 0), label ("Detector   ${detector}     ·     ${TimelineView::hundredths bus.compressor.ratio}× compression", 961.0, 871.0, 12.0, TimelineView::dim (), 0)]

    grid () = listConcat (mapList (toList (range (0, 37)), \i => TimelineView::box (711.0 + toFloat i * 20.0, 143.0, 1.0, 537.0, Scenes::rgb (30, 25, 44), 2))) (mapList (toList (range (0, 27)), \i => TimelineView::box (711.0, 143.0 + toFloat i * 20.0, 729.0, 1.0, Scenes::rgb (30, 25, 44), 2)))

    side editor = ui::Lists::flatten [grid (), [TimelineView::box (710.0, 142.0, 1.0, 767.0, TimelineView::dim (), 3), TimelineView::box (711.0, 680.0, 729.0, 1.0, TimelineView::dim (), 3), label ("Signal flow", 736.0, 161.0, 19.0, TimelineView::ink (), 0), label ("BUS INSPECTOR", 738.0, 702.0, 11.0, TimelineView::dim (), 0)], picked editor]

    picked editor = match listGet editor.song.tracks editor.track
        Error _ => []
        Success voice => listConcat (flow (editor, voice)) (routing (editor, voice))

    destination (index, current, name) =
        title = ui::Pick::either (name == "", "Master", name)
        shown = ui::Pick::either (name == current, "✓  ${title}", title)
        ui::Ui::action (shown, "", ui::Plain, name != current, AssignBus(index = index, bus = name))

    sendCommands voice = [ui::Ui::button ("Add send…", "", BeginSend(identity = -1)), ui::Ui::action ("Patch sends…", "", ui::Plain, length voice.sends > 0, BrowseSends(offset = 0))]

    (** Native destinations follow the open project and its selected track. *)
    export menus editor = match editor.page == MixPage || RoutingPicker::choosing editor
        false => match editor.page == PatchPage && editor.songPath != ""
            false => []
            true => match listGet editor.song.tracks editor.track
                Error _ => []
                Success voice => [ui::Ui::section ("Routing", "", sendCommands voice)]
        true => match listGet editor.song.tracks editor.track
            Error _ => []
            Success voice =>
                entries = mapList (RoutingPicker::names editor, \name => destination (editor.track, voice.bus, name))
                [ui::Ui::section ("Routing", "", listConcat (listAppend entries (ui::Ui::button ("New stereo bus…", "", NewGroup))) (listAppend (sendCommands voice) (ui::Ui::action ("Bus outputs…", "", ui::Plain, length editor.song.buses > 0, BrowseBuses))))]

    (** The whole Mix page. *)
    export shapes editor = listConcat (table editor) (listConcat (side editor) (RoutingPicker::shapes editor))

    controlAt (voice, index, x) = match x >= 215.0 && x <= 270.0
        true => AdjustMix(index = index, gain = TimelineGeometry::fader (x, 215.0, 55.0, 0.0, 4.0), pan = voice.pan)
        false => match x >= 294.0 && x <= 350.0
            true => AdjustMix(index = index, gain = voice.gain, pan = TimelineGeometry::fader (x, 294.0, 56.0, -1.0, 1.0))
            false => match x >= 370.0 && x <= 490.0
                true => ChooseOutput(index = index, offset = -1)
                false => PickTrack(index = index, bar = -1)

    (** A tap on a row picks its track; on its name, opens its patch. *)
    export rowAt (editor, x, y) =
        index = floatToInt (TimelineGeometry::mixAt (y, height editor)) ?: -1
        match index >= 0 && index < length editor.song.tracks && y >= 235.0 && x < 710.0
            false => graphAt (editor, x, y)
            true => match x < 183.0
                true => Success(value = OpenTrack(index = index))
                false => match listGet editor.song.tracks index
                    Success voice => Success(value = controlAt (voice, index, x))
                    Error _ => Error(message = "No track here.")

    (** Accessible row bounds for the mixer. *)
    export access editor = match listGet editor.song.tracks editor.track
        Success voice => ui::Lists::flatten [rows editor, busAreas (editor, voice), sendAreas voice]
        Error _ => rows editor

    rows editor = mapList (toList (range (0, length editor.song.tracks)), \index => TimelineView::area ("Mix track ${satAdd index 1}", 0.0, TimelineGeometry::mixY (toFloat index, height editor), 710.0, height editor, index == editor.track))
