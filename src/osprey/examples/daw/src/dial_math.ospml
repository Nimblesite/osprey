namespace synth

(** The round dial of [DAW-CONTROLS-DIAL]: where a value sits on its arc, and what a vertical drag makes of it. *)
module DialMath
    (** How far round its dial a value is: 0 at the minimum, 1 at the maximum. A range that is all positive and spans more than a hundredfold (a frequency, a time) is turned on a logarithmic scale, so its small values get as much travel as its large ones; any other range is turned evenly. *)
    export turn (value, low, high) = match high <= low
        true => 0.0
        false => match low > 0.0 && floatDiv (high, low) > 100.0
            true => FitMath::clip (floatDiv (ln (floatDiv (FitMath::clip (value, low, high), low)), ln (floatDiv (high, low))), 0.0, 1.0)
            false => FitMath::clip (floatDiv (value - low, high - low), 0.0, 1.0)

    (** The value at a turn: the inverse of `turn`. *)
    export valueAt (turned, low, high) = match high <= low
        true => low
        false => match low > 0.0 && floatDiv (high, low) > 100.0
            true => low * exp (FitMath::clip (turned, 0.0, 1.0) * ln (floatDiv (high, low)))
            false => low + FitMath::clip (turned, 0.0, 1.0) * (high - low)

    (** A drag that began at `start`: lifting the pointer 180 units crosses the whole range, a tenth as fast when `fine` (Shift) is held. The result is rounded to four significant places of its range so it reads cleanly. *)
    export dragged (start, lift, low, high, fine) =
        pace = match fine > 0.5
            true => 0.1
            false => 1.0
        value = valueAt (turn (start, low, high) + lift / 180.0 * pace, low, high)
        grain = match fine > 0.5
            true => 1000.0
            false => match high - low > 1000.0
                true => 1.0
                false => match high - low > 20.0
                    true => 10.0
                    false => 100.0
        FitMath::clip (floatDiv (floor (value * grain + 0.5), grain), low, high)

    (** A press becomes a drag once the pointer has moved two units up or down; sideways movement never turns. *)
    export moved (startY, y) = match abs (y - startY) >= 2.0
        true => 1.0
        false => 0.0

    (** The dial sweeps three quarters of a circle, from lower left over the top to lower right. This is the angle of a turn in radians, clockwise from straight up. *)
    export angle turned = (FitMath::clip (turned, 0.0, 1.0) * 1.5 - 0.75) * 3.141592653589793

    (** The point at `radius` from the centre on the dial's arc at a turn. *)
    export tipX (centre, radius, turned) = centre + radius * sin (angle turned)

    (** Tip y. *)
    export tipY (centre, radius, turned) = centre - radius * cos (angle turned)

    (** The row a height falls in when rows are `pitch` apart and the first is centred on `top`. *)
    export row (y, top, pitch) = floor (floatDiv (y - top, pitch) + 0.5)
