// [PRISM-ROUTING-VST] Untrusted modules are inspected in bounded disposable workers.
namespace synth

import ui::Runtime
import ui::Requests

(** Native discovery and node creation; stale completions never edit a newer patch. *)
module Plugins
    problem (editor, text) = Runtime::step (editor(pluginTicket = "", message = text))

    requested (editor, operation, arguments, selectedClass) =
        serial = satAdd editor.pluginSerial 1
        ticket = "prism-vst:${operation}:${serial}"
        next = editor(pluginSerial = serial, pluginTicket = ticket, pluginClassId = selectedClass, message = "Inspecting VST3 module.")
        Runtime::asking (next, [Requests::ask (ticket, ui::Run(executable = editor.workerPath, arguments = arguments, timeout = 10000, outputLimit = 1048576, plist = false, runSlice = ticket))])

    (** Explicit bundle path keeps scans user-directed; no recursive background loading. *)
    export scan editor = match editor.workerPath != "" && editor.pluginPath != "" && editor.pluginSerial < 9223372036854775807
        false => problem (editor, "Choose a VST3 bundle and launch Prism with its packaged VST worker.")
        true => requested (editor(catalog = []), "scan", ["scan", editor.pluginPath], "")

    (** Instantiate only a class offered by the current module scan. *)
    export create (editor, identifier) = match length (filterList (editor.catalog, \entry => entry.classId == identifier)) == 1 && editor.pluginSerial < 9223372036854775807
        false => problem (editor, "Scan the module and choose one of its VST3 classes.")
        true => requested (editor, "describe", ["describe", editor.pluginPath, identifier], identifier)

    (** Editing the module path invalidates every older scan and descriptor completion. *)
    export path (editor, text) = editor(pluginPath = text, catalog = [], pluginSerial = satAdd editor.pluginSerial 1, pluginTicket = "", pluginClassId = "", message = "Scan this VST3 module to see its instruments and effects.")

    added (editor, descriptor, n) = match Graphs::add (editor.graph, n)
        Invalid _ => problem (editor, "The VST3 node could not be added to this graph.")
        Valid graph =>
            binding = PluginBinding(pluginNode = n.identity, pluginModule = editor.pluginPath, pluginClass = descriptor.identifier, pluginName = descriptor.name)
            Runtime::step (editor(graph = graph, pluginBindings = listAppend editor.pluginBindings binding, selected = n.identity, nextIdentity = satAdd n.identity 1, revision = satAdd editor.revision 1, pluginTicket = "", message = "Added ${descriptor.name}."))

    described (editor, text) = match PluginDocuments::describe text
        Error why => problem (editor, why)
        Success descriptor => match descriptor.identifier == editor.pluginClassId && descriptor.name != "" && editor.nextIdentity < 9223372036854775807
            false => problem (editor, "The VST3 descriptor does not match the requested class.")
            true => match Hosted::component (editor.nextIdentity, descriptor)
                Invalid _ => problem (editor, "The VST3 descriptor has invalid ports or parameters.")
                Valid n => added (editor, descriptor, n)

    scanned (editor, text) = match PluginDocuments::scan text
        Error why => problem (editor, why)
        Success classes => Runtime::step (editor(catalog = classes, pluginTicket = "", message = "Choose a VST3 instrument or effect to add."))

    (** Only the exact outstanding ticket may consume its host-held output slice. *)
    export completed (editor, ticket, outcome) = match ticket != editor.pluginTicket || ticket == ""
        true => Runtime::step editor
        false => match ProcessResults::checked outcome
            Error why => problem (editor, "VST3 inspection failed: ${why}")
            Success _ => match editor.pluginClassId == ""
                true => scanned (editor, perform ui::Slices.fetch ticket)
                false => described (editor, perform ui::Slices.fetch ticket)
