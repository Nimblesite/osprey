// [PRISM-ROUTING-EDITOR] Every host sends the same typed actions to the modular editor.
namespace synth

import ui::Runtime
import ui::Messages

(** The modular graph editor's host-independent application boundary. *)
module EditorApp
    initial context =
        editor = match length (filterList (context.arguments, \arg => arg == "--empty")) > 0
            true => EditorState::initial ()
            false => EditorState::studioPreset ()
        at = ui::Lists::position (context.arguments, \arg => arg == "--vst-worker")
        worker = match at >= 0
            true => listGet context.arguments (satAdd at 1) ?: ""
            false => ""
        art = (signalflow::App::opened (context, "prism")).stepStore.screen.screenMachine
        audio = match context.platform == "windows"
            true => ui::Lists::after (context.arguments, "--audio-worker", "")
            false => ""
        song = ui::Lists::after (context.arguments, "--song", "")
        keys = "${context.home}/.prism/shortcuts.json"
        opened = editor(keysPath = keys, keymap = Keymaps::stored keys, skin = PrismArt::sized (art, 1536.0, 828.0), cards = PrismArt::classified art, workerPath = worker, audioPath = audio, assetFolder = "${ui::MachineDocs::folder (signalflow::App::documentPath context.arguments)}/skins/prism", renderer = ui::Lists::after (context.arguments, "--renderer", ""))
        first = match song == ""
            true => Runtime::step opened
            false => DawSession::opening (opened, song)
        Plugins::startup (context, first)

    // View commands open the selected track's patch from any page and toggle the tool once there.
    patchVisible editor = editor.page == PatchPage || (editor.patchWindowSerial > 0 && editor.patchTrack == editor.track)

    patchTool (editor, next) = match patchVisible editor
        true => Runtime::step next
        false => DawSession::shown (next, PatchPage)

    tapped (context, editor, action) = match action
        ShowModules => patchTool (editor, editor(paletteShown = !(patchVisible editor) || !editor.paletteShown))
        ShowDetails => patchTool (editor, editor(detailsShown = !(patchVisible editor) || !editor.detailsShown))
        ShowKeyboard => patchTool (editor, editor(keyboardShown = !(patchVisible editor) || !editor.keyboardShown, armedNote = -1))
        Undo => DawSession::restored (editor, EditorHistory::undo editor)
        Redo => DawSession::restored (editor, EditorHistory::redo editor)
        Strike note => match editor.renderContinuous || editor.renderTicket != ""
            true => Runtime::step (editor(armedNote = -1, message = "Stop playback before playing a new note."))
            false => strike (editor, note, context.platform)
        LoadSample => SamplePicker::choose editor
        BuiltinSample => SamplePicker::builtin editor
        EditTiming => SongTimingEditor::open editor
        ApplyTiming => SongTimingEditor::apply editor
        ShowSettings => Runtime::step (editor(outputEdit = PluginSettings(folder = editor.pluginPath)))
        ClosePluginWindow identity => PluginWindows::close (editor, identity)
        OpenPluginWindow identity => PluginWindows::open (editor, identity, context.platform)
        SaveSettings => Plugins::save editor
        Audition => GraphPreview::play (editor, context.platform)
        PlayGraph => GraphPreview::live (editor, context.platform)
        StopGraph => GraphPreview::stop editor
        ShowPage page => DawSession::shown (editor(outputEdit = OutputClosed), page)
        PickTrack index bar => Runtime::step (TimelineView::following (DawSession::pickedAt (editor, index, bar)))
        SelectNote index => Runtime::step (editor(selectedNote = index))
        SetVelocity value => DawSession::velocity (editor, value)
        AdjustMix index gain pan => DawSession::adjusted (editor, index, gain, pan)
        AdjustBusGain name gain => DawSession::savedTrack (editor, editor.track, daw::Projects::busGain (editor.song, name, gain))
        ScrollLanes top => Runtime::step (TimelineView::scrolled (editor, top))
        ZoomLanes factor => Runtime::step (TimelineView::zoomedBy (editor, factor))
        ChooseOutput index offset => RoutingPicker::open (editor, index, offset)
        CloseOutput => Runtime::step (editor(outputEdit = OutputClosed))
        BrowseSends offset => DawSession::saving (editor, \ready => Runtime::step (ready(outputEdit = BrowsingSends(offset = offset), message = "")))
        BrowseBuses => BusOutputs::open editor
        BeginSend identity => DawSession::saving (editor, \ready => SendEditor::open (ready, identity))
        PagePortRoutes offset => SendEditor::page (editor, offset)
        CommitSend => SendEditor::commit editor
        DeleteSend => SendEditor::remove editor
        FlipSend => SendEditor::typed (editor, action, "")
        NewGroup => Runtime::step (editor(outputEdit = NamingGroup(proposed = ""), message = ""))
        CommitGroup => DawSession::group editor
        AssignBus index bus => DawSession::routed (editor, index, bus)
        OpenTrack index => match index == -2
            true => DawSession::saving (editor, DawSession::choose)
            false => DawSession::saving (editor, \saved => Runtime::step (DawSession::detached (saved, index)))
        SaveProject => DawSession::save editor
        UseKeymap name => Runtime::step (Keymaps::chosen (editor, Keymaps::preset name))
        LoadKeymap => Runtime::asking (editor, [ui::Requests::ask ("prism-keys", ui::ChooseFile(types = ["json"], chosenLimit = 0, chosenSlice = ""))])
        PlaySong => DawSession::saving (editor, DawSession::play)
        RenderSong => DawSession::saving (editor, DawSession::bounce)
        StopSong => DawSession::stop editor
        ToggleLoop => DawSession::looped editor
        MoveEnd bar => DawSession::ended (editor, bar)
        MoveStart bar => DawSession::started (editor, bar)
        _ => Runtime::step (EditorState::tapped (editor, action))

    // Preview captures the pitched voice. The project keeps its authored parameters, even after many key presses.
    strike (editor, note, platform) = match editor.songPath == ""
        true => match EditorState::tune (editor, note)
            Error why => Runtime::step (editor(armedNote = -1, message = why))
            Success tuned => GraphPreview::play (tuned, platform)
        false => match listGet editor.song.tracks editor.track
            Error _ => Runtime::step (editor(armedNote = -1, message = "Select a track to play its patch."))
            Success track => soundTrack (editor, track, note, platform)

    soundTrack (editor, track, note, platform) =
        voice = match editor.track == editor.patchTrack
            true => daw::PatchRecords::audition (track, editor.graph, note)
            false => daw::PatchVoices::patched (daw::Note(pitch = note, start = 0.0, length = 1.0, velocity = 1.0), daw::TrackPatches::routing track.instrument)
        match voice
            Error why => Runtime::step (editor(armedNote = -1, message = why))
            Success graph =>
                sounded = GraphPreview::play (editor(graph = graph, note = note, armedNote = -1), platform)
                played = sounded.stepStore
                sounded(stepStore = played(graph = editor.graph))

    typed (editor, action, value) = match action
        PickBus => BusOutputs::picked (editor, value)
        RouteBus => BusOutputs::route (editor, value)
        SendSource => SendEditor::typed (editor, action, value)
        SendDestination => SendEditor::typed (editor, action, value)
        SendLevel => SendEditor::typed (editor, action, value)
        GroupName => Runtime::step (editor(outputEdit = NamingGroup(proposed = value), message = ""))
        TempoText => SongTimingEditor::typed (editor, value, true)
        PickMeter => SongTimingEditor::typed (editor, value, false)
        PluginPath => Runtime::step (editor(outputEdit = PluginSettings(folder = value)))
        Add _ => match startsWith value "vst:"
            true => Plugins::create (editor, drop value 4)
            false => Runtime::step (EditorState::typed (editor, action, value))
        _ => Runtime::step (EditorState::typed (editor, action, value))

    completed (editor, ticket, outcome) = match startsWith ticket "prism-sample:"
        true => SamplePicker::completed (editor, ticket, outcome)
        false => match ticket == "prism-keys"
            true => Runtime::step (Keymaps::loaded (editor, outcome))
            false => otherCompletion (editor, ticket, outcome)

    otherCompletion (editor, ticket, outcome) = match startsWith ticket "daw-"
        true => DawSession::completed (editor, ticket, outcome)
        false => toolCompletion (editor, ticket, outcome)

    toolCompletion (editor, ticket, outcome) = match startsWith ticket "prism-editor:"
        true => PluginWindows::completed (editor, ticket, outcome)
        false => workerCompletion (editor, ticket, outcome)

    workerCompletion (editor, ticket, outcome) = match startsWith ticket "prism-vst:"
        true => Plugins::completed (editor, ticket, outcome)
        false => match startsWith ticket "prism-audio:"
            true => GraphPreview::completed (editor, ticket, outcome)
            false => Preview::completed (editor, ticket, outcome)

    keyPointer (context, editor, x, y, down) =
        note = PrismArt::keyAt (editor, x, y)
        match down
            true => Runtime::step (editor(armedNote = note ?: -1))
            false => match note
                Success value => match editor.armedNote == value
                    true => tapped (context, editor, Strike(note = value))
                    false => Runtime::step (editor(armedNote = -1))
                Error _ => Runtime::step (editor(armedNote = -1))

    surfacePointer (context, editor, x, y, down) = match editor.outputEdit
        SongTiming _ _ => Runtime::step editor
        PluginSettings _ => Runtime::step editor
        NodeMenu id left top => NodeContext::pointed (editor, id, left, top, x, y, down)
        EditingSend _ => Runtime::step editor
        BrowsingSends _ => Runtime::step editor
        EditingBus _ => Runtime::step editor
        _ => workspacePointer (context, editor, x, y, down)

    workspacePointer (context, editor, x, y, down) = match editor.page
        PatchPage => patchPointer (context, editor, x, y, down)
        TimelinePage => match editor.rollDrag
            RollHeld motion => RollEdits::pointer (editor, motion, x - Header::shift editor, y, down)
            RollIdle => songPointer (context, editor, x, y, down)
        _ => songPointer (context, editor, x, y, down)

    // [DAW-TRANSPORT-RANGE] `armedNote` while the end marker's handle is held.
    endHeld = -3

    // The held end marker follows the pointer to the nearest bar line; release lets go.
    endDrag (editor, x, down) = match down
        true => DawSession::ended (editor, TimelineView::endAt (editor, x - Header::shift editor))
        false => Runtime::step (editor(armedNote = -1))

    // [DAW-MIX-DRAG] The held fader takes the value under the pointer; off the fader it keeps its last value.
    faderAt (editor, x, y) = match DawSession::tappedAt (editor, x, y)
        Success (AdjustMix index gain pan) => match structuralEquals (editor.mixFader, TrackFader(index = index))
            true => DawSession::slid (editor, index, gain, pan)
            false => editor
        Success (AdjustBusGain name gain) => match structuralEquals (editor.mixFader, GroupFader(name = name))
            true => DawSession::busSlid (editor, name, gain)
            false => editor
        _ => editor

    faderDrag (editor, x, y, down) = match down
        true => Runtime::step (faderAt (editor, x, y))
        false => DawSession::dropped (faderAt (editor, x, y))

    // [DAW-TRANSPORT-RANGE] `armedNote` while the start marker is held.
    startHeld = -4

    // The held start marker follows the pointer to the nearest bar line before the end marker; release lets go.
    startDrag (editor, x, down) = match down
        true => DawSession::started (editor, TimelineView::startAt (editor, x - Header::shift editor))
        false => Runtime::step (editor(armedNote = -1))

    songPointer (context, editor, x, y, down) = match editor.armedNote == endHeld
        true => endDrag (editor, x, down)
        false => match editor.armedNote == startHeld
            true => startDrag (editor, x, down)
            false => match DawSession::holding editor
                true => faderDrag (editor, x, y, down)
                false => songTap (context, editor, x, y, down)

    songTap (context, editor, x, y, down) = match DawSession::tappedAt (editor, x, y)
        Success (SelectNote index) => match down
            true => RollEdits::start (editor, index, x - Header::shift editor, y)
            false => Runtime::step editor
        Success action => pagePointer (context, editor, action, down)
        Error _ => Runtime::step (editor(armedNote = -1))

    pagePointer (context, editor, action, down) = match action
        MoveEnd bar => match down
            true => DawSession::ended (editor(armedNote = endHeld), bar)
            false => Runtime::step editor
        MoveStart _ => match down
            true => Runtime::step (editor(armedNote = startHeld))
            false => Runtime::step editor
        AdjustMix index gain pan => match down
            true => Runtime::step (DawSession::slid (editor, index, gain, pan))
            false => Runtime::step editor
        AdjustBusGain name gain => match down
            true => Runtime::step (DawSession::busSlid (editor, name, gain))
            false => Runtime::step editor
        SetVelocity _ => match down
            true => Runtime::step (editor(armedNote = editor.selectedNote))
            false => match editor.selectedNote >= 0 && editor.armedNote == editor.selectedNote
                true => tapped (context, editor(armedNote = -1), action)
                false => Runtime::step editor
        _ => match down
            true => tapped (context, editor(armedNote = -1), action)
            false => Runtime::step (editor(armedNote = -1))

    capturedPointer (editor, x, y, down) =
        next = EditorView::pointed (editor, x, y, down)
        match down || editor.dragging < 0 || editor.patchTrack < 0 || editor.songPath == ""
            true => Runtime::step next
            false => match editor.gesture
                [start, ..._] => match structuralEquals (start.savedPositions, next.positions)
                    true => Runtime::step next
                    false => match DawSession::synced next
                        Success saved => Runtime::step saved
                        Error why => Runtime::step (next(message = why))
                [] => Runtime::step next

    patchPointer (context, editor, x, y, down) = match editor.panning
        PanHeld _ _ => Runtime::step (EditorLayout::panned (editor, x, y, down))
        PanIdle => patchControl (context, editor, x, y, down)

    patchControl (context, editor, x, y, down) = match editor.dragging >= 0 || editor.paletteDrag != "" || editor.wireDragging
        true => capturedPointer (editor, x, y, down)
        false => match CableCanvas::deleteAt (editor, x, y)
            true => Runtime::step (ui::Pick::either (down, EditorState::tapped (editor, RemoveCable), editor))
            false => uncapturedPointer (context, editor, x, y, down)

    uncapturedPointer (context, editor, x, y, down) = match EditorView::toolbarAt (editor, x, y)
        Error _ => match EditorView::paletteAt (editor, x, y)
            true => Runtime::step (EditorView::pointed (editor, x, y, down))
            false => match PrismArt::pointed (editor, x, y, down)
                Success next => Runtime::step next
                Error _ => Runtime::step (EditorView::pointed (editor, x, y, down))
        Success index => match down
            true => Runtime::step (editor(armedNote = satSub -10 index))
            false => match editor.armedNote == satSub -10 index
                true => tapped (context, editor(armedNote = -1), EditorView::toolbarAction index)
                false => Runtime::step editor


    viewed (editor, width, height) =
        boardWidth = ui::Pick::either (editor.detailsShown, 1212.0, 1536.0)
        skin = ui::Canvases::viewed (PrismArt::sized (editor.skin, boardWidth, 828.0), width, height)
        match ui::Machines::number (editor.skin, "viewWidth") == width && ui::Machines::number (editor.skin, "viewHeight") == height
            true => Runtime::step editor
            false => Runtime::step (editor(skin = skin, layoutRevision = satAdd editor.layoutRevision 1))

    dockPointer (context, editor, x, y, down) = match x >= editor.keyboardWidth - 156.0 && y <= 32.0
        true => match down
            true => Runtime::step (editor(armedNote = -30))
            false => match editor.armedNote == -30
                true => tapped (context, editor, ShowKeyboard)
                false => Runtime::step (editor(armedNote = -1))
        false =>
            step = keyPointer (context, PrismArt::keyboardEditor editor, x, y + 828.0, down)
            next = step.stepStore
            step(stepStore = next(skin = editor.skin))

    surfaceKey (editor, key, down) = match editor.outputEdit
        ChoosingOutput focus => RoutingPicker::key (editor, focus, key, down)
        OutputClosed => match (key == "escape" && down && editor.rollDrag != RollIdle)
            true => Runtime::step (editor(rollDrag = RollIdle))
            false => match (key == "escape" && down && editor.dial != DialIdle)
                true => Runtime::step (Dials::escaped editor)
                false => Runtime::step (CableCanvas::keyed (editor, key, down))
        _ => Runtime::step (ui::Pick::either (down && key == "escape", editor(outputEdit = OutputClosed), editor))

    controlled (context, editor, action, input) = match action
        Keyboard => ui::Inputs::route (input, \(_, _) => Runtime::step editor, \(x, y, down, _) => dockPointer (context, editor, x, y, down), \(w, _) => Runtime::step (editor(keyboardWidth = w)), \(_, _) => Runtime::step editor)
        PatchSurface =>
            patch = editor(page = PatchPage)
            moved = surface (context, patch, input)
            next = moved.stepStore
            moved(stepStore = next(page = editor.page))
        Surface => surface (context, editor, input)
        Controls => dialInput (editor, input)
        _ => Runtime::step editor

    surface (context, editor, input) = ui::Inputs::route (input, \(key, down) => surfaceKey (editor, key, down), \(x, y, down, shift) => surfacePointer (context, editor(fineHeld = shift), x, y, down), \(w, h) => viewed (editor, w, h), \(x, y) => NodeContext::open (editor, x, y))

    dialInput (editor, input) = ui::Inputs::route (input, \(key, down) => Runtime::step (ui::Pick::either (down && key == "escape", Dials::escaped editor, editor)), \(x, y, down, shift) => Runtime::step (EditorView::dialled (editor(fineHeld = shift), x, y, down)), \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor)

    routed (context, editor, message) = Messages::route (message, \action => tapped (context, editor, action), \(action, value) => typed (editor, action, value), \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \(ticket, outcome) => completed (editor, ticket, outcome), \_ => Runtime::step editor, \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \elapsed => DawSession::framed (editor, elapsed), \(action, input) => controlled (context, editor, action, input))

    update (context, editor, message) =
        step = routed (context, editor, message)
        accepted = GraphPreview::liveEdit (editor, DawSession::liveEdit (editor, step.stepStore))
        view = match accepted.selected == editor.selected && accepted.patchTrack == editor.patchTrack && accepted.songPath == editor.songPath
            true => accepted
            false => accepted(dialOffset = 0)
        step(stepStore = CardArts::refreshed (editor, EditorHistory::record (editor, view)))

    (** Native controls and the canvas observe the same typed graph and applied edit revision. *)
    export program () = ui::Program(programInit = initial, programUpdate = update, programRender = EditorView::regions, programTheme = \_ => EditorView::theme ())

(** [SYNTH-ADVANCED-GRAINS-IMPORT] Prepare a selected WAV outside rendering, with playback stopped. *)
module SamplePicker
    idle editor = editor.renderTicket == "" && editor.renderDeviceKey == "" && editor.renderContinuous == false && editor.renderStopping == false
    ticket (editor, serial) = "prism-sample:${serial}:${editor.selected}:${editor.revision}:${editor.renderSerial}"
    problem (editor, text) =
        title = match Graphs::node (editor.graph, editor.selected)
            Valid n => EditorView::processorTitle n.processor
            Invalid _ => "Module"
        Runtime::step (editor(sampleTicket = "", message = "${title} ${editor.selected}: ${text}"))

    (** Open the native WAV chooser for the selected grain cloud. *)
    export choose editor = match idle editor && editor.sampleSerial < 9223372036854775807
        false => problem (editor, "Sample selection is unavailable while playing or when request IDs run out.")
        true => match Graphs::node (editor.graph, editor.selected)
            Valid n => match n.processor
                Granular _ _ _ => request editor
                SamplePlayer _ => request editor
                _ => problem (editor, "Select a Sample or Grain cloud to load a WAV sample.")
            Invalid _ => problem (editor, "Select a Sample or Grain cloud to load a WAV sample.")

    request editor =
        serial = satAdd editor.sampleSerial 1
        key = ticket (editor, serial)
        Runtime::asking (editor(sampleSerial = serial, sampleTicket = key), [ui::Requests::ask (key, ui::ChooseFile(types = ["wav"], chosenLimit = 0, chosenSlice = ""))])

    retained (previous, rate, descriptor) = match descriptor.key == "rate"
        true => descriptor(initial = rate)
        false => match listGet (filterList (previous, \p => p.key == descriptor.key)) 0
            Error _ => descriptor
            Success p => descriptor(initial = ui::Pick::either (p.initial > descriptor.maximum, descriptor.maximum, p.initial))

    replaceNode (editor, old, resource, capacity, seed, rate) =
        fresh = Components::granular (old.identity, resource, capacity, seed)
        next = fresh(parameters = mapList (fresh.parameters, \p => retained (old.parameters, rate, p)))
        graph = editor.graph
        draft = graph(nodes = mapList (graph.nodes, \n => ui::Pick::either (n.identity == old.identity, next, n)))
        match GrainGraph::prepare next
            Error why => problem (editor, why)
            Success _ => publish (editor, draft, resource)

    publish (editor, draft, resource) = match Graphs::prepare draft
        Invalid _ => problem (editor, "The patch rejected this sample.")
        Valid prepared => match ClipLayouts::bounded (prepared.graph, 1)
            false => problem (editor, "The patch exceeds the renderer limits.")
            true => Runtime::step (editor(graph = prepared.graph, revision = satAdd editor.revision 1, sampleTicket = "", message = "Loaded ${daw::PatchVoices::fileName resource.name}."))

    apply (editor, resource) = match Graphs::node (editor.graph, editor.selected)
        Invalid _ => problem (editor, "Select a Sample or Grain cloud.")
        Valid n => match n.processor
            SamplePlayer _ =>
                graph = editor.graph
                next = n(processor = SamplePlayer(resource = resource))
                publish (editor, graph(nodes = mapList (graph.nodes, \item => ui::Pick::either (item.identity == next.identity, next, item))), resource)
            Granular _ capacity seed => match SampleResources::playbackRate (resource, toFloat editor.note, 48000.0)
                Error why => problem (editor, why)
                Success rate => replaceNode (editor, n, resource, capacity, seed, rate)
            _ => problem (editor, "Select a Sample or Grain cloud.")

    (** Restore the original harmonic resource through the same graph edit. *)
    export builtin editor = match idle editor
        false => problem (editor, "Stop playback before replacing the sample.")
        true => apply (editor, daw::PatchVoices::builtinSample ())

    (** Handle only the current selection, patch revision and playback generation. *)
    export completed (editor, key, outcome) = match key == editor.sampleTicket
        false => Runtime::step editor
        true => match key == ticket (editor, editor.sampleSerial) && idle editor
            false => Runtime::step (editor(sampleTicket = ""))
            true => match outcome
                Error why => problem (editor, why)
                Success path => match path == ""
                    true => Runtime::step (editor(sampleTicket = ""))
                    false => match daw::PatchVoices::sampled path
                        Error why => problem (editor, why)
                        Success resource => apply (editor, resource)
