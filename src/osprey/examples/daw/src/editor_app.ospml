// [PRISM-ROUTING-EDITOR] Every host sends the same typed actions to the modular editor.
namespace synth

import ui::Runtime
import ui::Messages

(** The modular graph editor's host-independent application boundary. *)
module EditorApp
    initial context =
        editor = match length (filterList (context.arguments, \arg => arg == "--empty")) > 0
            true => EditorState::initial ()
            false => EditorState::studioPreset ()
        at = ui::Lists::position (context.arguments, \arg => arg == "--vst-worker")
        worker = match at >= 0
            true => listGet context.arguments (satAdd at 1) ?: ""
            false => ""
        art = (signalflow::App::opened (context, "prism")).stepStore.screen.screenMachine
        audio = match context.platform == "windows"
            true => ui::Lists::after (context.arguments, "--audio-worker", "")
            false => ""
        song = ui::Lists::after (context.arguments, "--song", "")
        opened = editor(skin = PrismArt::sized (art, 1536.0, 828.0), cards = PrismArt::classified art, workerPath = worker, audioPath = audio, assetFolder = "${ui::MachineDocs::folder (signalflow::App::documentPath context.arguments)}/skins/prism", renderer = ui::Lists::after (context.arguments, "--renderer", ""))
        match song == ""
            true => Runtime::step opened
            false => Runtime::step (DawSession::loaded (opened, song))

    tapped (context, editor, action) = match action
        Strike note => match editor.renderContinuous || editor.renderTicket != ""
            true => Runtime::step (editor(armedNote = -1, message = "Stop playback before playing a new note."))
            false => strike (editor, note, context.platform)
        LoadSample => SamplePicker::choose editor
        BuiltinSample => SamplePicker::builtin editor
        ScanVst => Plugins::scan editor
        Audition => GraphPreview::play (editor, context.platform)
        PlayGraph => GraphPreview::live (editor, context.platform)
        StopGraph => GraphPreview::stop editor
        ShowPage page => DawSession::shown (editor, page)
        PickTrack index bar => Runtime::step (DawSession::pickedAt (editor, index, bar))
        SelectNote index => Runtime::step (editor(selectedNote = index))
        SetVelocity value => DawSession::velocity (editor, value)
        AdjustMix index gain pan reverb => DawSession::adjusted (editor, index, gain, pan, reverb)
        OpenTrack index => match index == -2
            true => DawSession::saving (editor, DawSession::choose)
            false => DawSession::saving (editor, \saved => Runtime::step (DawSession::opened (saved, index)))
        PlaySong => DawSession::saving (editor, DawSession::play)
        StopSong => DawSession::stop editor
        _ => Runtime::step (EditorState::tapped (editor, action))

    // Preview captures the pitched voice. The project keeps its authored parameters, even after many key presses.
    strike (editor, note, platform) = match editor.songPath == ""
        true => match EditorState::tune (editor, note)
            Error why => Runtime::step (editor(armedNote = -1, message = why))
            Success tuned => GraphPreview::play (tuned, platform)
        false => match listGet editor.song.tracks editor.track
            Error _ => Runtime::step (editor(armedNote = -1, message = "Select a track to play its patch."))
            Success track => soundTrack (editor, track, note, platform)

    soundTrack (editor, track, note, platform) =
        voice = match editor.track == editor.patchTrack
            true => daw::PatchRecords::audition (track, editor.graph, note)
            false => daw::PatchVoices::patched (daw::Note(pitch = note, start = 0.0, length = 1.0, velocity = 1.0), daw::TrackPatches::routing track.instrument)
        match voice
            Error why => Runtime::step (editor(armedNote = -1, message = why))
            Success graph =>
                sounded = GraphPreview::play (editor(graph = graph, note = note, armedNote = -1), platform)
                played = sounded.stepStore
                sounded(stepStore = played(graph = editor.graph))

    typed (editor, action, value) = match action
        PluginPath => Runtime::step (Plugins::path (editor, value))
        CreateVst _ => Plugins::create (editor, value)
        _ => Runtime::step (EditorState::typed (editor, action, value))

    completed (editor, ticket, outcome) = match startsWith ticket "prism-sample:"
        true => SamplePicker::completed (editor, ticket, outcome)
        false => otherCompletion (editor, ticket, outcome)

    otherCompletion (editor, ticket, outcome) = match startsWith ticket "daw-"
        true => DawSession::completed (editor, ticket, outcome)
        false => toolCompletion (editor, ticket, outcome)

    toolCompletion (editor, ticket, outcome) = match startsWith ticket "prism-vst:"
        true => Plugins::completed (editor, ticket, outcome)
        false => match startsWith ticket "prism-audio:"
            true => GraphPreview::completed (editor, ticket, outcome)
            false => Preview::completed (editor, ticket, outcome)

    keyPointer (context, editor, x, y, down) =
        note = PrismArt::keyAt (editor, x, y)
        match down
            true => Runtime::step (editor(armedNote = note ?: -1))
            false => match note
                Success value => match editor.armedNote == value
                    true => tapped (context, editor, Strike(note = value))
                    false => Runtime::step (editor(armedNote = -1))
                Error _ => Runtime::step (editor(armedNote = -1))

    surfacePointer (context, editor, x, y, down) = match editor.page
        PatchPage => patchPointer (context, editor, x, y, down)
        _ => match DawSession::tappedAt (editor, x, y)
            Success action => pagePointer (context, editor, action, down)
            Error _ => Runtime::step (editor(armedNote = -1))

    pagePointer (context, editor, action, down) = match action
        AdjustMix index _ _ _ => match down
            true => Runtime::step (editor(armedNote = index))
            false => match editor.armedNote == index
                true => tapped (context, editor(armedNote = -1), action)
                false => Runtime::step editor
        SetVelocity _ => match down
            true => Runtime::step (editor(armedNote = editor.selectedNote))
            false => match editor.selectedNote >= 0 && editor.armedNote == editor.selectedNote
                true => tapped (context, editor(armedNote = -1), action)
                false => Runtime::step editor
        _ => match down
            true => tapped (context, editor(armedNote = -1), action)
            false => Runtime::step (editor(armedNote = -1))

    patchPointer (context, editor, x, y, down) = match editor.dragging >= 0 || editor.paletteDrag != "" || editor.wireDragging
        true => Runtime::step (EditorView::pointed (editor, x, y, down))
        false => match CableCanvas::deleteAt (editor, x, y)
            true => Runtime::step (ui::Pick::either (down, EditorState::tapped (editor, RemoveCable), editor))
            false => uncapturedPointer (context, editor, x, y, down)

    uncapturedPointer (context, editor, x, y, down) = match EditorView::toolbarAt (editor, x, y)
        Error _ => match EditorView::paletteAt (editor, x, y)
            true => Runtime::step (EditorView::pointed (editor, x, y, down))
            false => match PrismArt::pointed (editor, x, y, down)
                Success next => Runtime::step next
                Error _ => Runtime::step (EditorView::pointed (editor, x, y, down))
        Success index => match down
            true => Runtime::step (editor(armedNote = satSub -10 index))
            false => match editor.armedNote == satSub -10 index
                true => tapped (context, editor(armedNote = -1), EditorView::toolbarAction index)
                false => Runtime::step editor


    viewed (editor, width, height) =
        boardWidth = ui::Pick::either (editor.detailsShown, 1212.0, 1536.0)
        skin = ui::Canvases::viewed (PrismArt::sized (editor.skin, boardWidth, 828.0), width, height)
        match ui::Machines::number (editor.skin, "viewWidth") == width && ui::Machines::number (editor.skin, "viewHeight") == height
            true => Runtime::step editor
            false => Runtime::step (editor(skin = skin, layoutRevision = satAdd editor.layoutRevision 1))

    dockPointer (context, editor, x, y, down) = match x >= editor.keyboardWidth - 156.0 && y <= 32.0
        true => match down
            true => Runtime::step (editor(armedNote = -30))
            false => match editor.armedNote == -30
                true => tapped (context, editor, ShowKeyboard)
                false => Runtime::step (editor(armedNote = -1))
        false =>
            step = keyPointer (context, PrismArt::keyboardEditor editor, x, y + 828.0, down)
            next = step.stepStore
            step(stepStore = next(skin = editor.skin))

    controlled (context, editor, action, input) = match action
        Keyboard => ui::Inputs::route (input, \(_, _) => Runtime::step editor, \(x, y, down, _) => dockPointer (context, editor, x, y, down), \(w, _) => Runtime::step (editor(keyboardWidth = w)))
        Surface => ui::Inputs::route (input, \(key, down) => Runtime::step (CableCanvas::keyed (editor, key, down)), \(x, y, down, _) => surfacePointer (context, editor, x, y, down), \(w, h) => viewed (editor, w, h))
        _ => Runtime::step editor

    routed (context, editor, message) = Messages::route (message, \action => tapped (context, editor, action), \(action, value) => typed (editor, action, value), \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \(ticket, outcome) => completed (editor, ticket, outcome), \_ => Runtime::step editor, \(_, _) => Runtime::step editor, \(_, _) => Runtime::step editor, \_ => Runtime::step editor, \(action, input) => controlled (context, editor, action, input))

    update (context, editor, message) =
        step = routed (context, editor, message)
        step(stepStore = CardArts::refreshed (editor, EditorHistory::record (editor, step.stepStore)))

    (** Native controls and the canvas observe the same typed graph and applied edit revision. *)
    export program () = ui::Program(programInit = initial, programUpdate = update, programRender = EditorView::regions, programTheme = \_ => EditorView::theme ())

(** [SYNTH-ADVANCED-GRAINS-IMPORT] Prepare a selected WAV outside rendering, with playback stopped. *)
module SamplePicker
    idle editor = editor.renderTicket == "" && editor.renderDeviceKey == "" && editor.renderContinuous == false && editor.renderStopping == false
    ticket (editor, serial) = "prism-sample:${serial}:${editor.selected}:${editor.revision}:${editor.renderSerial}"
    problem (editor, text) = Runtime::step (editor(sampleTicket = "", message = "Grain cloud ${editor.selected}: ${text}"))

    (** Open the native WAV chooser for the selected grain cloud. *)
    export choose editor = match idle editor && editor.sampleSerial < 9223372036854775807
        false => problem (editor, "Sample selection is unavailable while playing or when request IDs run out.")
        true => match Graphs::node (editor.graph, editor.selected)
            Valid n => match n.processor
                Granular _ _ _ =>
                    serial = satAdd editor.sampleSerial 1
                    key = ticket (editor, serial)
                    Runtime::asking (editor(sampleSerial = serial, sampleTicket = key), [ui::Requests::ask (key, ui::ChooseFile(types = ["wav"], chosenLimit = 0, chosenSlice = ""))])
                _ => problem (editor, "Select a Grain cloud to load a WAV sample.")
            Invalid _ => problem (editor, "Select a Grain cloud to load a WAV sample.")

    retained (previous, rate, descriptor) = match descriptor.key == "rate"
        true => descriptor(initial = rate)
        false => match listGet (filterList (previous, \p => p.key == descriptor.key)) 0
            Error _ => descriptor
            Success p => descriptor(initial = ui::Pick::either (p.initial > descriptor.maximum, descriptor.maximum, p.initial))

    replaceNode (editor, old, resource, capacity, seed, rate) =
        fresh = Components::granular (old.identity, resource, capacity, seed)
        next = fresh(parameters = mapList (fresh.parameters, \p => retained (old.parameters, rate, p)))
        graph = editor.graph
        draft = graph(nodes = mapList (graph.nodes, \n => ui::Pick::either (n.identity == old.identity, next, n)))
        match GrainGraph::prepare next
            Error why => problem (editor, why)
            Success _ => publish (editor, draft, resource)

    publish (editor, draft, resource) = match Graphs::prepare draft
        Invalid _ => problem (editor, "The patch rejected this sample.")
        Valid prepared => match ClipLayouts::bounded (prepared.graph, 1)
            false => problem (editor, "The patch exceeds the renderer limits.")
            true => Runtime::step (editor(graph = prepared.graph, revision = satAdd editor.revision 1, sampleTicket = "", message = "Loaded ${daw::PatchVoices::fileName resource.name}."))

    apply (editor, resource) = match Graphs::node (editor.graph, editor.selected)
        Invalid _ => problem (editor, "Select a Grain cloud.")
        Valid n => match n.processor
            Granular _ capacity seed => match SampleResources::playbackRate (resource, toFloat editor.note, 48000.0)
                Error why => problem (editor, why)
                Success rate => replaceNode (editor, n, resource, capacity, seed, rate)
            _ => problem (editor, "Select a Grain cloud.")

    (** Restore the original harmonic resource through the same graph edit. *)
    export builtin editor = match idle editor
        false => problem (editor, "Stop playback before replacing the sample.")
        true => apply (editor, daw::PatchVoices::builtinSample ())

    (** Handle only the current selection, patch revision and playback generation. *)
    export completed (editor, key, outcome) = match key == editor.sampleTicket
        false => Runtime::step editor
        true => match key == ticket (editor, editor.sampleSerial) && idle editor
            false => Runtime::step (editor(sampleTicket = ""))
            true => match outcome
                Error why => problem (editor, why)
                Success path => match path == ""
                    true => Runtime::step (editor(sampleTicket = ""))
                    false => match daw::PatchVoices::sampled path
                        Error why => problem (editor, why)
                        Success resource => apply (editor, resource)
