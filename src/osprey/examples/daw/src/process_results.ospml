// [PRISM-ROUTING-AUDIO] Process delivery and child exit status are distinct failures.
namespace synth

import ui::Doc

(** Strictly decode the process receipt shared by desktop audio and VST commands. *)
module ProcessResults
    exited doc = match jsonInt (Doc::field (doc, "status"))
        Error _ => Error(message = "The host returned no valid process exit status.")
        Success status => match status == 0
            true => Success(value = "")
            false => match jsonText (Doc::field (doc, "stderr"))
                Success message => match message == ""
                    true => Error(message = "The process exited with status ${status}.")
                    false => Error(message = message)
                Error _ => Error(message = "The process exited with status ${status}.")

    (** A delivered receipt succeeds only when its explicit child status is zero. *)
    export checked outcome = match outcome
        Error why => Error(message = why)
        Success text => match jsonDecode text
            Error _ => Error(message = "The host returned an invalid process receipt.")
            Success doc => exited doc
