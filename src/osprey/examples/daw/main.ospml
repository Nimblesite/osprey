namespace app

import ui::Runtime
import ui::Views
import synth::EditorApp

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<synth::Editor<synth::Graph, synth::GraphPending<synth::Graph, synth::ProcessorMemory<synth::KernelState>>, synth::GraphState<synth::ProcessorMemory<synth::KernelState>>, ui::Machine>, synth::EditorAction> => Unit

initial () = synth::EditorState::initial ()
program () = EditorApp::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
