---
layout: base.njk
title: "Modules & Instruments"
description: "Physical models, 16-voice granular clouds, spectral morphing, and modular DSP instruments in Perception Studio."
---

<section class="section grid-backdrop" style="border-top:0">
  <div class="shell">
    <div class="prose">
      <p class="prose-eyebrow"><a href="/learn/" style="text-decoration:none">← Learn</a> · Modules</p>
      <h1>Instruments &amp; DSP Modules</h1>
      <p class="prose-lead">
        Filter by synthesis family and tap any card to inspect its signal path, parameters, and architecture.
      </p>
    </div>

    <div class="filter-bar" role="group" aria-label="Filter modules by category">
      <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">All</button>
      <button type="button" class="filter-btn" data-filter="modular" aria-pressed="false">Modular</button>
      <button type="button" class="filter-btn" data-filter="spectral" aria-pressed="false">Granular &amp; Spectral</button>
      <button type="button" class="filter-btn" data-filter="physical" aria-pressed="false">Physical</button>
      <button type="button" class="filter-btn" data-filter="synth" aria-pressed="false">Synthesis</button>
      <button type="button" class="filter-btn" data-filter="percussion" aria-pressed="false">Percussion</button>
    </div>
    <p id="filter-status" class="mono dim" style="font-size:0.8rem; margin: -10px 0 20px;" aria-live="polite">
      Showing all {{ site.instruments.length }} modules
    </p>

    <div class="card-grid">
      {% for inst in site.instruments %}
      <button
        type="button"
        class="card card-interactive"
        data-category="{{ inst.category }}"
        data-module-card
        data-mod-name="{{ inst.kind }}"
        data-mod-cat="{{ inst.category }}"
        data-mod-ports="{{ inst.ports }}"
        data-mod-controls="{{ inst.controls }}"
        data-mod-details="{{ inst.details }}"
      >
        <span class="card-tag{% if inst.category == 'physical' or inst.category == 'spectral' %} is-monitor{% elif inst.category == 'modular' %} is-mod{% endif %}">{{ inst.category }}</span>
        <h3 class="mono">{{ inst.kind }}</h3>
        <p>{{ inst.summary }}</p>
        <span class="card-cta">Inspect specs →</span>
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<dialog id="module-dialog" class="lightbox module-modal" closedby="any" aria-labelledby="mod-modal-title">
  <div class="lightbox-frame">
    <div class="lightbox-head">
      <span id="mod-modal-cat" class="card-tag">modular</span>
      <form method="dialog">
        <button type="submit" class="btn btn-ghost" aria-label="Close module details">Close ✕</button>
      </form>
    </div>
    <div class="module-modal-body prose">
      <h2 id="mod-modal-title" class="mono" style="margin-top:0">PatchInstrument</h2>
      <p id="mod-modal-details"></p>
      <div class="prose-table-wrap">
        <table class="prose-table">
          <tbody>
            <tr><th>Signal path</th><td><code id="mod-modal-ports"></code></td></tr>
            <tr><th>Controls</th><td><code id="mod-modal-controls"></code></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</dialog>
