---
layout: base.njk
---

<article class="section grid-backdrop">
  <div class="shell">
    <div class="prose">
      <p class="eyebrow"><span class="dot dot-signal" aria-hidden="true"></span>{{ tag }} · {{ date }} · {{ readTime }}</p>
      <h1>{{ title }}</h1>
      <p class="hero-lead">{{ description }}</p>
    </div>

    {% if image %}
    <figure class="blog-hero">
      <img src="{{ image }}" alt="{{ alt or title }}" fetchpriority="high" decoding="async">
    </figure>
    {% endif %}

    <div class="prose">
      {{ content | safe }}
      <p style="margin-top:32px"><a class="btn btn-ghost" href="/blog/">← All posts</a></p>
    </div>
  </div>
</article>
