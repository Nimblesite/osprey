<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- MANDATORY: Declare support for both light and dark themes -->
  <meta name="color-scheme" content="dark light">
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.tagline }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="icon" type="image/svg+xml" href="/assets/perception-mark.svg">
  <link rel="stylesheet" href="{{ '/assets/perception.css' | versioned }}">
  <script src="{{ '/assets/perception.js' | versioned }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="studio-bar">
    <div class="shell studio-bar-inner">
      <a class="brand" href="/" aria-label="{{ site.name }} home">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="28" height="28" fill="none">
            <defs>
              <linearGradient id="p-grad" x1="4" y1="28" x2="28" y2="4" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#4FDAD3"/>
                <stop offset="52%" stop-color="#AA9EE6"/>
                <stop offset="100%" stop-color="#FF8442"/>
              </linearGradient>
            </defs>
            <rect x="1.5" y="1.5" width="29" height="29" rx="7" fill="#18142C" stroke="#342E54" stroke-width="1.5"/>
            <path d="M16 6.5 L25 22.5 L7 22.5 Z" stroke="url(#p-grad)" stroke-width="2.2" stroke-linejoin="round"/>
            <circle cx="16" cy="17.2" r="2.6" fill="#FF8442"/>
          </svg>
        </span>
        <span class="brand-copy">
          <span class="brand-name">{{ site.name }}</span>
          <span class="brand-sub">Modular DAW</span>
        </span>
      </a>

      <nav class="studio-nav" aria-label="Primary">
        {% for item in site.nav %}
        <a class="studio-tab{% if page.url == item.href %} is-active{% endif %}" href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>
          {{ item.label }}
        </a>
        {% endfor %}
      </nav>

      <div class="studio-readout" aria-label="Engine specification">
        <span class="readout-pill"><span class="dot dot-signal" aria-hidden="true"></span>{{ site.sampleRate }}</span>
        <span class="readout-pill">{{ site.channels }}</span>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="studio-footer">
    <div class="shell footer-inner">
      <div class="footer-brand">
        <span class="status-led" aria-hidden="true"></span>
        <strong>{{ site.name }}</strong>
        <span class="dim">Every node visible. Master-only playback &amp; rendering.</span>
      </div>
      <div class="footer-meta">
        <span>48 kHz · 32-bit float · Stereo</span>
        <span aria-hidden="true">·</span>
        <a href="/architecture/">Architecture</a>
        <a href="/modules/">Modules</a>
        <a href="/tracks/">Tracks</a>
      </div>
    </div>
  </footer>

  <!-- Light-dismiss native modal lightbox for high-res studio screenshots -->
  <dialog id="lightbox" class="lightbox" closedby="any" aria-labelledby="lightbox-title">
    <div class="lightbox-frame">
      <div class="lightbox-head">
        <h2 id="lightbox-title" class="lightbox-title">Studio view</h2>
        <form method="dialog">
          <button type="submit" class="btn btn-ghost" aria-label="Close preview">Close ✕</button>
        </form>
      </div>
      <figure class="lightbox-body">
        <img id="lightbox-img" src="" alt="" decoding="async">
        <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
      </figure>
    </div>
  </dialog>
</body>
</html>
