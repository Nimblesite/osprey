test ("A held mix fader, the following note, Undo and Redo affect the playing song", \() => Runtime::guarded (\() => hosted (\() => forEachList ([false, true], liveMixJourney))))

test ("Send level edits and cancellation reach a held note while the project stays saved", \() => Runtime::guarded (\() => hosted liveSendJourney))
