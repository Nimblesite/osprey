// The patch editor's graph journeys: modules, sockets, cables, cutoff audio and plug-in packets.

import uitest::Drive
import uitest::Semantics
import uitest::Views

canvasOutput00 = "Canvas output 0:0"
firstCable = "Cable 0:0 to 1:0"
nextParameters = "Next parameters"
previousParameters = "Previous parameters"
sendLevel = "Send level (%)"

// Select through the visible inspector before exercising a module-specific action.
inspectorSelected (session, identity) =
    next = Drive::choose (session, "Module", "${identity}")
    selectedIs (next, identity)
    next

inspectorAction (session, identity, label) = Drive::press (inspectorSelected (session, identity), label)

// [PRISM-ROUTING-EDITOR] One selected module, compact controls, unchanged graph actions.
inspectorJourney () =
    opened = openedEditor ["--empty"]
    oscillator = Drive::choose (opened, addComponent, "sine")
    filter = Drive::choose (oscillator, addComponent, "filter")
    viewShows (filter, "Module", true)
    expect (Drive::letters (filter, "Cutoff"), true)
    expect (Drive::letters (filter, "Frequency"), false)
    viewShows (filter, "Select 1", false)
    selected = Drive::choose (filter, "Module", "0")
    selectedIs (selected, 0)
    expect (Drive::letters (selected, "Frequency"), true)
    expect (Drive::letters (selected, "Cutoff"), false)
    panelDialJourney selected
    viewShows (selected, "Connections", false)
    sourced = prismTap (spacedFilter selected, canvasOutput00)
    connected = prismTap (sourced, canvasInput10)
    cablesOf (connected, 1)
    disconnected = cutCable (connected, firstCable)
    cablesOf (disconnected, 0)
    forEachList (["Remove module", "Scan VST3", "VST3 bundle"], \label => viewShows (disconnected, label, false))
    nodesOf (disconnected, 2)
    cableGestureJourney ()

near (actual, expected) = expect (actual - expected < 0.0001 && expected - actual < 0.0001, true)

zeroStereoResponse () = "4F535631020000000200000000000000" + join (mapList (toList (range (0, 8)), \_ => "0001000000000000" + join (mapList (toList (range (0, 512)), \_ => "00000000")) "")) ""

prismIntegratedJourney () =
    opened = editorLaunched []
    nodesOf (opened, 5)
    cablesOf (opened, 4)
    forEachList (["Filter Cutoff", "Master Level", "Modules", "Undo", "Redo", "Timeline", "Track patch", "Bus routing"], \label => offeredIn (opened, label, true))
    forEachList (["Patch controls", "Save project"], \label => offeredIn (opened, label, false))
    cutoff = controlPoint (opened, "Filter Cutoff", 0.5)
    changed = clickAt (opened, cutoff.pointX, cutoff.pointY)
    parameterAt ((Drive::holding changed).graph, 1, 0, \p => near (p.initial, synth::CanvasGeometry::cutoffFrequency 0.5))
    cablesOf (changed, 4)
    level = controlPoint (changed, "Master Level", 0.25)
    quieter = clickAt (changed, level.pointX, level.pointY)
    parameterAt ((Drive::holding quieter).graph, 2, 0, \p => near (p.initial, 0.25))
    library = prismTap (quieter, "Modules")
    expect ((Drive::holding library).paletteShown, true)
    added = Drive::pointer (Drive::pointer (library, 80.0, 130.0, true), 350.0, 230.0, false)
    nodesOf (added, 6)
    cablesOf (added, 4)
    selectedIs (added, 5)
    expect ((Drive::holding added).paletteDrag, "")
    prismControlJourney quieter
    paletteClickJourney quieter
    readingsShown ()
    forEachList (synth::EditorState::pickerKinds (), \kind =>
        added = component (quieter, kind)
        insertedDescribed (added, Drive::holding added))
    filterSocketJourney ()
    cutoffAudioJourney ()
    menuJourney opened

// Every visible module row supports one click as well as drag, without editing covered controls.
paletteClickJourney opened = forEachList (synth::EditorState::kinds, \kind =>
    library = prismTap (opened, "Modules")
    added = prismTap (library, "Add ${synth::EditorState::title kind}")
    addedEditor = Drive::holding added
    expect (length addedEditor.graph.nodes, 6)
    expect (addedEditor.selected, 5)
    expect (addedEditor.paletteShown, false)
    expect (addedEditor.paletteDrag, "")
    expect (structuralEquals (addedEditor.graph.cables, (Drive::holding opened).graph.cables), true)
    expect (structuralEquals (filterList (addedEditor.graph.nodes, \n => n.identity < 5), (Drive::holding opened).graph.nodes), true)
    expect (Semantics::offered (added.drivenSeen.renderedAccess, "Canvas input 5:0") || Semantics::offered (added.drivenSeen.renderedAccess, "Canvas output 5:0"), true)
    insertedDescribed (added, addedEditor)
    match kind == "mixer"
        true => overlappingModuleJourney added
        false => expect (true, true))

// [SYNTH-ADVANCED-PRISM] An inserted module's defaults sit inside their declared ranges, and its inspector's first
// page offers one dial per descriptor parameter, carrying that parameter's value and range.
insertedDescribed (added, editor) = valid (synth::Graphs::node (editor.graph, 5), \n =>
    forEachList (n.parameters, \p => expect ("${p.key} ${p.minimum <= p.initial && p.initial <= p.maximum}", "${p.key} true"))
    forEachList (ui::Lists::slice (n.parameters, 0, 10), \p =>
        dial = Semantics::element (added.drivenSeen.renderedAccess, "${synth::EditorView::componentName (editor, n)} ${(synth::ParameterModes::describe p).title}")
        expect ("${p.key} ${dial.accessValue} ${dial.accessMin} ${dial.accessMax}", "${p.key} ${p.initial} ${p.minimum} ${p.maximum}")))

// [DAW-CONTROLS-DIAL] A dial reads hundredths unless its value carries three to five decimals or sits under 0.01,
// with a true minus sign and its unit.
readingsShown () = forEachList ([
    { unit = synth::Hertz, key = "frequency", value = 440.0, want = "440.00 Hz" },
    { unit = synth::Ratio, key = "mix", value = 0.125, want = "0.125" },
    { unit = synth::Ratio, key = "mix", value = 0.25, want = "0.25" },
    { unit = synth::Ratio, key = "pan", value = -0.5, want = "−0.50" },
    { unit = synth::Seconds, key = "attack", value = 0.005, want = "0.005 s" },
    { unit = synth::Ratio, key = "mix", value = 3.14159265, want = "3.14" },
    { unit = synth::Ratio, key = "drive", value = 2.0, want = "2.00×" },
    { unit = synth::Seconds, key = "release", value = 0.0, want = "0.00 s" }], \c =>
    p = synth::Parameter(key = c.key, label = c.key, unit = c.unit, minimum = -1000.0, maximum = 1000.0, initial = c.value, automatable = true)
    expect ("${c.value}: ${synth::Dials::reading p}", "${c.value}: ${c.want}"))

overlappingModuleJourney added =
    at = controlPoint (added, "Canvas Mixer 5", 0.5)
    moved = Drive::pointer (Drive::pointer (added, at.pointX, at.pointY, true), 607.0, 432.0, false)
    covered = prismTap (moved, "Bypass Filter")
    selectedIs (covered, 5)
    sameGraph (covered, moved)

controlPoint (driven, label, fraction) = Semantics::point (Semantics::element (driven.drivenSeen.renderedAccess, label), fraction)

prismTap (driven, label) =
    point = controlPoint (driven, label, 0.5)
    clickAt (driven, point.pointX, point.pointY)

prismControlJourney opened =
    menu = prismTap (opened, "Oscillator Wave: Sine")
    triangle = prismTap (menu, "Triangle")
    offeredIn (triangle, "Oscillator Wave: Triangle", true)
    bypassed = prismTap (triangle, "Bypass Oscillator")
    offeredIn (bypassed, "Enable Oscillator", true)
    valid (synth::Graphs::node ((Drive::holding bypassed).graph, 0), \n =>
        expect (length (filterList (n.parameters, \p => p.key == "waveform" && p.initial == 1.0)), 1)
        expect (length (filterList (n.parameters, \p => p.key == "enabled" && p.initial == 0.0)), 1))
    prismAudioJourney ((Drive::holding opened).graph, (Drive::holding triangle).graph, (Drive::holding bypassed).graph)
    enabled = prismTap (bypassed, "Enable Oscillator")
    rates = prismTap (enabled, "LFO Rate: 1/4")
    faster = prismTap (rates, "1/8")
    offeredIn (faster, "LFO Rate: 1/8", true)
    cablesOf (faster, 4)

prismAudio graph = clipReady (graph, 128, 3)

prismAudioJourney (sine, triangle, muted) = match prismAudio sine
    Error _ => expect (false, true)
    Success first => match prismAudio triangle
        Error _ => expect (false, true)
        Success second => succeeds (prismAudio muted, \silent =>
            expect (length first.clipSamples, 128)
            expect (length second.clipSamples, 128)
            expect (structuralEquals (first.clipSamples, second.clipSamples), false)
            expect (length (filterList (silent.clipSamples, \value => value != 0.0)), 0))

menuPage (driven, label, index) =
    opened = Drive::press (driven, label)
    expect (synth::TimelineView::pageIndex (Drive::holding opened).page, index)
    opened

// [DAW-MENU] The window's menu bar names every command once, each with its shortcut, and a menu command runs
// the same action as the header's.
menuJourney driven =
    forEachList (["Open Song…", "Save", "Render Song", "Undo", "Redo", "Timeline", "Track Patch", "Bus Routing", "Modules", patchControls, "Play Song", "Stop Song", "Return to Start", "Previous Track", "Next Track", "Previous Bar", "Next Bar", "Ableton Style", "Logic Style", "Load From File…"], \label => expect (length (Views::labelled (driven.drivenSeen, label)), 1))
    expect ((Views::control (driven.drivenSeen, "Save")).controlKind, "button")
    logic = Drive::press (driven, "Logic Style")
    expect ((Drive::holding logic).keymap.name, "Logic Style")
    expect ((Views::control (logic.drivenSeen, "Bus Routing")).controlKind, "button")
    timeline = menuPage (logic, "Timeline", 1)
    viewShows (timeline, "Save", true)
    mix = menuPage (timeline, "Bus Routing", 2)
    patch = menuPage (mix, "Track Patch", 0)
    library = Drive::press (patch, "Modules")
    expect ((Drive::holding library).paletteShown, true)
    details = Drive::press (library, patchControls)
    panel = \held => (synth::EditorView::paneled (Drive::holding held)).detailsShown
    expect (panel details, panel library == false)
    expect (panel (Drive::press (details, patchControls)), panel library)
    sameGraph (details, driven)

// Leave an exposed cable span between the two cards.
spacedFilter driven =
    at = controlPoint (driven, "Canvas Filter 1", 0.5)
    held = grabbedAt (driven, at.pointX, at.pointY - 60.0)
    moved = Drive::pointer (held, at.pointX + 200.0, at.pointY - 60.0, false)
    expect ((controlPoint (moved, "Canvas Filter 1", 0.5)).pointX, at.pointX + 200.0)
    moved

// [PRISM-ROUTING-CABLES] Physical press/move/release, cancellation and direct removal.
cableGestureJourney () =
    opened = openedEditor ["--empty"]
    disconnected = spacedFilter (Drive::choose (Drive::choose (opened, addComponent, "sine"), addComponent, "filter"))
    oscillator = controlPoint (disconnected, canvasOutput00, 0.5)
    filter = controlPoint (disconnected, canvasInput10, 0.5)
    armed = grabbedAt (disconnected, oscillator.pointX, oscillator.pointY)
    expect ((Drive::holding armed).wireDragging, true)
    preview = Drive::pointer (armed, 450.0, 300.0, true)
    cablesOf (preview, 0)
    expect ((Drive::holding preview).wireX, 450.0)
    cancelled = Drive::pointer (preview, 450.0, 300.0, false)
    expect ((Drive::holding cancelled).wireDragging, false)
    cablesOf (cancelled, 0)
    source = grabbedAt (cancelled, oscillator.pointX, oscillator.pointY)
    connected = clickAt (source, filter.pointX, filter.pointY)
    cablesOf (connected, 1)
    expect ((Drive::holding connected).wireDragging, false)
    selected = prismTap (connected, firstCable)
    expect ((Drive::holding selected).selectedCable, 0)
    offeredIn (selected, "Delete selected cable", true)
    removed = prismTap (selected, "Delete selected cable")
    cablesOf (removed, 0)
    nodesOf (removed, 2)
    clicked = prismTap (prismTap (removed, canvasOutput00), canvasInput10)
    cablesOf (clicked, 1)
    chosen = prismTap (clicked, firstCable)
    deleted = Drive::key (chosen, "backspace", true)
    cablesOf (deleted, 0)
    expect ((Drive::holding deleted).selectedCable, -1)
    expect (structuralEquals ((Drive::holding deleted).graph.nodes, (Drive::holding disconnected).graph.nodes), true)

// The original Filter's purple/cyan sockets are backed by real graph routes and audio.
filterSocketJourney () =
    opened = editorLaunched []
    before = (Drive::holding opened).graph
    controlled = prismTap (prismTap (opened, "Canvas output 4:0"), "Canvas input 1:1")
    cablesOf (controlled, 5)
    succeeds (prismAudio before, \original => succeeds (prismAudio (Drive::holding controlled).graph, \modulated => expect (structuralEquals (original.clipSamples, modulated.clipSamples), false)))
    monitored = prismTap (prismTap (controlled, "Monitor output 1"), "Canvas input 3:0")
    expect (length (filterList ((Drive::holding monitored).graph.cables, \c => c.source == 1 && c.destination == 3)), 1)
    cablesOf (monitored, 5)
    invalid = prismTap (prismTap (monitored, "Canvas output 4:0"), canvasInput10)
    sameGraph (invalid, monitored)

// [PRISM-ROUTING-CABLES] Normalized cutoff endpoints and invalid samples exercise real DSP.
cutoffOutput (graph, value) =
    control = synth::NodeClip(clipNode = 4, clipChannels = 1, clipSamples = mapList (toList (range (0, 128)), \_ => value), clipNotes = [])
    unhosted (synth::GraphClips::advance (graph, 48000.0, [control], 128), 3)

cutoffAudioJourney () =
    base = synth::EditorState::preset ()
    lfo = synth::EditorState::tapped (base, synth::Add(kind = "lfo"))
    connected = synth::EditorState::tapped (synth::EditorState::tapped (lfo, synth::Source(identity = 4, outlet = 0)), synth::Connect(identity = 1, inlet = 1))
    match prismAudio base.graph
        Error _ => expect (false, true)
        Success original => forEachList ([0.0, 0.25, 0.5, 1.0], \value =>
            succeeds (cutoffOutput (connected.graph, value), \rendered =>
                expect (length rendered.clipSamples, 128)
                expect (structuralEquals (rendered.clipSamples, original.clipSamples), value == 1.0)))
    forEachList ([-0.1, 1.1, floatFromBits 9221120237041090560], \value => errs (cutoffOutput (connected.graph, value)))

patched kinds =
    opened = openedEditor ["--empty", "--vst-worker", "/worker/osprey-vst-worker"]
    added = foldList (kinds, opened, \(d, kind) => Drive::choose (d, addComponent, kind))
    wired = foldList (toList (range (1, length kinds)), added, \(d, i) => prismTap (prismTap (d, "Canvas output ${i - 1}:0"), "Canvas input ${i}:0"))
    cablesOf (wired, length kinds - 1)
    wired

// The host draws the timeline and the detached patch in separate regions.
dialTarget (d, ordinal) = boundTo (d, ordinal, synth::Controls)

// A pointer on the Patch Controls scene, Shift held or not.
dialPointer (d, x, y, down, shift) = sceneEvent (d, synth::Controls, ui::Hosting::pointer, x, y, down, shift)

// The controls drawn by the Patch Controls scene at this scene index.
dialAccess (d, index) = match listGet d.drivenSeen.renderedScenes index
    Error _ => []
    Success ordinal => match dialTarget (d, ordinal)
        false => []
        true => walkAccess (d, index)

// The Patch Controls dial of the parameter `label`, as the host sees it.
dialOf (d, label) =
    scenes = synth::EditorView::indices d.drivenSeen.renderedScenes
    accessible = ui::Lists::flatten (mapList (scenes, \index => dialAccess (d, index)))
    listGet (filterList (accessible, \a => endsWith a.accessLabel " ${label}")) 0

// One press and release on the point `at`: the tap a host sends a dial.
dialTappedAt (d, at) = dialPointer (dialPointer (d, at.pointX, at.pointY, true, false), at.pointX, at.pointY, false, false)

// [DAW-CONTROLS-DIAL] A press on a dial that never moves asks for the value in figures.
dialTapped (d, label) = match dialOf (d, label)
    Error _ =>
        expect ("a dial for ${label}", "")
        d
    Success a =>
        asked = dialTappedAt (d, Semantics::point (a, 0.5))
        expect ((Drive::holding asked).dialEntry != "", true)
        asked

// [DAW-CONTROLS-DIAL] One press and release on a Patch Controls page button, turning the panel's dial pages.
pageTapped (d, label) = dialTappedAt (d, controlPoint (d, label, 0.5))

tuned (driven, node, label, words) = Drive::choose (dialTapped (inspectorSelected (driven, node), label), label, words)

panelFrequency driven = initialOf ((Drive::holding driven).graph, 0, "frequency")

panelDialHistory (selected, released, coarse) =
    undone = prismTap (released, "Undo")
    sameGraph (undone, selected)
    redone = prismTap (undone, "Redo")
    expect (panelFrequency redone, coarse)
    asked = dialTapped (prismTap (redone, "Undo"), "Frequency")
    expect ((Drive::holding asked).dialEntry, "frequency")
    viewShows (asked, "Frequency", true)
    refused = Drive::choose (asked, "Frequency", "loud")
    expect ((Drive::holding refused).dialEntry, "frequency")
    sameGraph (refused, selected)
    typed = Drive::choose (refused, "Frequency", "523.25")
    expect (panelFrequency typed, 523.25)
    expect ((Drive::holding typed).dialEntry, "")
    viewShows (typed, "Frequency", false)
    expect (Drive::letters (typed, "523.25 Hz"), true)

// [DAW-CONTROLS-DIAL] The Patch Controls panel turns a module's numbers with dials: a held drag upward raises the
// value, Shift turns a tenth as fast, sideways movement does nothing, the whole turn is one undo, and the value
// can be typed after a press that never moved; a bad entry is refused and the field stays open.
panelDialJourney selected =
    // The chosen module's panel docks one Controls scene beside the canvas; the keyboard deck no longer renders by default.
    expect (length selected.drivenSeen.renderedScenes, 2)
    expect (length (filterList (selected.drivenSeen.renderedScenes, \ordinal => dialTarget (selected, ordinal))), 1)
    viewShows (selected, "Parameters", true)
    before = (Drive::holding selected).graph
    expect (panelFrequency selected, 440.0)
    expect (Drive::letters (selected, "440.00 Hz"), true)
    valid (synth::Graphs::node (before, 0), \n => forEachList (filterList (n.parameters, \p => p.key == "frequency"), \p =>
        expect ([p.minimum, p.maximum], [0.0, 19000.0])
        // The oscillator includes DC. A strictly positive frequency range turns logarithmically.
        near (synth::DialMath::valueAt (synth::DialMath::turn (440.0, p.minimum, p.maximum), p.minimum, p.maximum), 440.0)
        expect (synth::DialMath::turn (p.minimum, p.minimum, p.maximum), 0.0)
        expect (synth::DialMath::turn (p.maximum, p.minimum, p.maximum), 1.0)
        near (synth::DialMath::turn (440.0, p.minimum, p.maximum), 440.0 / 19000.0)
        logTurn = synth::DialMath::turn (440.0, 20.0, 20000.0)
        expect (logTurn > 0.3 && logTurn < 0.6, true)
        near (synth::DialMath::valueAt (logTurn, 20.0, 20000.0), 440.0)
        expect (synth::DialMath::dragged (440.0, 0.0, p.minimum, p.maximum, 0.0), 440.0)
        expect (synth::DialMath::dragged (440.0, 1000.0, p.minimum, p.maximum, 0.0), p.maximum)
        expect (synth::DialMath::dragged (440.0, 0.0 - 1000.0, p.minimum, p.maximum, 0.0), p.minimum)
        expect (synth::DialMath::dragged (440.0, 18.0, p.minimum, p.maximum, 1.0) < synth::DialMath::dragged (440.0, 18.0, p.minimum, p.maximum, 0.0), true)))
    expect (synth::DialMath::turn (0.0, 0.0 - 1.0, 1.0), 0.5)
    expect (synth::DialMath::valueAt (0.75, 0.0 - 1.0, 1.0), 0.5)
    expect (synth::DialMath::moved (100.0, 101.0), 0.0)
    expect (synth::DialMath::moved (100.0, 98.0), 1.0)
    near (synth::DialMath::tipX (50.0, 10.0, 0.5), 50.0)
    near (synth::DialMath::tipY (50.0, 10.0, 0.5), 40.0)
    expect (synth::DialMath::tipX (50.0, 10.0, 0.0) < 50.0 && synth::DialMath::tipX (50.0, 10.0, 1.0) > 50.0, true)
    expect (synth::DialMath::tipY (50.0, 10.0, 0.0) > 50.0 && synth::DialMath::tipY (50.0, 10.0, 1.0) > 50.0, true)
    match dialOf (selected, "Frequency")
        Error _ => expect ("a Frequency dial", "")
        Success a =>
            expect (a.accessValue, 440.0)
            expect (a.accessMin < 440.0 && a.accessMax > 440.0, true)
            at = Semantics::point (a, 0.5)
            pressed = dialPointer (selected, at.pointX, at.pointY, true, false)
            expect ((Drive::holding pressed).dial != synth::DialIdle, true)
            sameGraph (pressed, selected)
            sideways = dialPointer (pressed, at.pointX + 80.0, at.pointY + 1.0, true, false)
            sameGraph (sideways, selected)
            lifted = dialPointer (sideways, at.pointX + 80.0, at.pointY - 36.0, true, false)
            coarse = panelFrequency lifted
            expect (coarse > 440.0, true)
            expect ((Drive::holding lifted).dragging, 0)
            fine = dialPointer (lifted, at.pointX, at.pointY - 36.0, true, true)
            expect (panelFrequency fine > 440.0 && panelFrequency fine < coarse, true)
            lowered = dialPointer (fine, at.pointX, at.pointY + 36.0, true, false)
            expect (panelFrequency lowered < 440.0, true)
            back = dialPointer (lowered, at.pointX, at.pointY - 36.0, true, false)
            expect (panelFrequency back, coarse)
            released = dialPointer (back, at.pointX, at.pointY - 36.0, false, false)
            expect ((Drive::holding released).dial, synth::DialIdle)
            expect ((Drive::holding released).dragging, 0 - 1)
            expect ((Drive::holding released).dialEntry, "")
            expect (panelFrequency released, coarse)
            panelDialHistory (selected, released, coarse)

dialPagesJourney () =
    grain = prismTap (prismTap (editorLaunched ["--empty"], "Modules"), "Add Grain cloud")
    editor = Drive::holding grain
    valid (synth::Graphs::node (editor.graph, 0), \n => forEachList ([10, 11, 21], \count =>
        cut = n(parameters = ui::Lists::slice (n.parameters, 0, count))
        rows = synth::Dials::access (editor, cut, 0.0, 30.0, 248.0)
        expect (Semantics::offered (rows, nextParameters), count > 10)
        expect (length rows, ui::Pick::either (count == 10, 10, 11))
        at = satMul (intDiv (satSub count 1) 10) 10
        end = synth::Dials::access (editor(dialOffset = at), cut, 0.0, 30.0, 248.0)
        reads (listGet cut.parameters (satSub count 1), \p => expect (Semantics::offered (end, "Grain cloud 0 ${(synth::ParameterModes::describe p).title}"), true))
        expect (Semantics::offered (end, nextParameters), false)))
    offeredIn (grain, previousParameters, false)
    offeredIn (grain, nextParameters, true)
    middle = pageTapped (grain, nextParameters)
    offeredIn (middle, "Grain cloud 0 Pan spread", true)
    last = pageTapped (middle, nextParameters)
    offeredIn (last, "Grain cloud 0 Boundary", true)
    offeredIn (last, nextParameters, false)
    // The grain cloud keeps the panel docked on its own: View → Patch Controls would put it away, not open it.
    viewShows (last, "Parameters", true)
    previous = controlPoint (last, previousParameters, 0.5)
    back = dialTappedAt (last, previous)
    spread = dialTapped (back, "Pan spread")
    changed = Drive::choose (spread, "Pan spread", "0.5")
    reads (dialOf (changed, "Pan spread"), \a => expect (a.accessValue, 0.5))
    small = Drive::choose (changed, addComponent, "sine")
    offeredIn (small, previousParameters, false)
    offeredIn (small, nextParameters, false)
    reads (dialOf (small, "Frequency"), \a => expect (a.accessValue > 0.0, true))
    shaper = Drive::choose (small, addComponent, "shaper")
    offeredIn (shaper, "Waveshaper 2 Curve", true)
    reads (dialOf (shaper, "Antiderivative antialiasing"), \a =>
        expect (a.accessSelected, true)
        point = Semantics::point (a, 0.5)
        toggled = dialPointer (shaper, point.pointX, point.pointY, true, false)
        still = dialPointer (toggled, point.pointX, point.pointY + 1.0, true, false)
        released = dialPointer (still, point.pointX, point.pointY, false, false)
        reads (dialOf (released, "Antiderivative antialiasing"), \off =>
            expect (off.accessSelected, false)
            expect (off.accessValue, 0.0)))
    exact = Drive::choose (dialTapped (shaper, "Drive"), "Drive", "1.808")
    expect (Drive::letters (exact, "1.808×"), true)
    reads (dialOf (exact, "Drive"), \a =>
        point = Semantics::point (a, 0.5)
        held = dialPointer (exact, point.pointX, point.pointY, true, true)
        moved = dialPointer (held, point.pointX, point.pointY - 9.0, true, true)
        expect (Drive::letters (moved, "Fine adjustment"), true)
        reads (dialOf (moved, "Drive"), \p => expect (p.accessValue > 1.808 && p.accessValue < 2.0, true))
        up = dialPointer (moved, point.pointX, point.pointY - 9.0, false, false)
        expect (Views::letters (up.drivenSeen, "Fine adjustment"), false))

// [DAW-PAGES-STRIP] Each tab names its page once. An output has no parameter section.
namedPage (driven, label) =
    expect (length (filterList (driven.drivenSeen.renderedLetters, \word => word == label)), 1)
    offeredIn (driven, label, true)

pageHeadingsJourney () =
    opened = editorLaunched ["--empty"]
    namedPage (opened, "Track patch")
    timelinePage = prismTap (opened, "Timeline")
    namedPage (timelinePage, "Timeline")
    routing = prismTap (timelinePage, "Bus routing")
    namedPage (routing, "Bus routing")
    patch = prismTap (routing, "Track patch")
    selected = Drive::choose (Drive::press (patch, patchControls), addComponent, "stereo-output")
    expect (Views::letters (selected.drivenSeen, "Parameters"), false)
    viewShows (selected, "Parameters", false)
    hidden = Drive::press (selected, patchControls)
    expect (Views::letters (hidden.drivenSeen, "Parameters"), false)

// [DAW-TRANSPORT-LIVE-CONTROLS] Every live journey's opening: the folder, the saved song, its launched editor and Play.
liveLaunched (place, tab, score, check) =
    succeeds (daw::Projects::saved (score, "${place}/knobs.json"), \source =>
        session = editorLaunched ["--song", "${place}/knobs.json", "--renderer", "${place}/daw", "--vst-worker", "${place}/worker"]
        started = Drive::press (prismTap (session, tab), "Play Song")
        expect ((Drive::holding started).songTicket, "daw-song:live:${place}/knobs/live")
        check (source, started))

// The song proven audible after `frames`, handed to `check` as a live stream.
heardStream (score, frames, check) = succeeds (daw::Playback::start score, \initial =>
    succeeds (daw::Playback::step (score, initial, frames), \before =>
        audible before.left
        check (daw::LiveStream(playing = before.playing, controlVersion = 0, controlScore = score, noteFolders = []))))

// [DAW-TRANSPORT-LIVE-CONTROLS] Read the same controls and audio block as the renderer between UI events.
liveMixHistory (place, released, muted) =
    undone = Drive::press (released, "Undo")
    expect ((Drive::holding undone).songTicket, (Drive::holding released).songTicket)
    liveDialBlock (place, muted, \(loud, heard) =>
        expect (heard.controlVersion > muted.controlVersion, true)
        bothAudible loud
        _redone = Drive::press (undone, "Redo")
        liveDialBlock (place, heard, \(quiet, again) =>
            expect (again.controlVersion > heard.controlVersion, true)
            expect (again.playing.cursor, 640)
            bothSilent quiet))

liveMixJourney group =
    place = ui::Pick::either (group, madeRoom "live-group", madeRoom "live-mixer")
    track = keysTrack ()
    first = beatNote 0.02
    arrangement = timeline [track(bus = ui::Pick::either (group, "pads", ""), notes = [first, first(pitch = 67, start = 0.02)])]
    score = arrangement(buses = ui::Pick::either (group, [padsBus (1.0, "")], []))
    liveLaunched (place, ui::Pick::either (group, "Bus routing", "Timeline"), score, \(_, started) =>
        label = ui::Pick::either (group, "pads gain", "Track gain")
        offeredIn (started, label, true)
        point = controlPoint (started, label, 0.0)
        down = Drive::pointer (started, point.pointX, point.pointY, true)
        expect (synth::DawSession::holding (Drive::holding down), true)
        heardStream (score, 448, \stream => liveDialBlock (place, stream, \(quiet, muted) =>
            // The held note crosses into the second note at frame 480 while the fader is still down.
            bothSilent quiet
            up = Drive::pointer (down, point.pointX, point.pointY, false)
            expect (synth::DawSession::holding (Drive::holding up), false)
            liveMixHistory (place, up, muted))))

// The control `label` shows, then is pressed: the next state after the press.
shownPressed (driven, label) =
    viewShows (driven, label, true)
    Drive::press (driven, label)

// [DAW-MIX-BUS-TAP] The send is the only audible route, so its edit is verified at the output.
liveSendJourney () =
    place = madeRoom "live-send"
    keys = keysTrack ()
    tap = daw::AudioSend(sendId = 1, source = 1, outlet = 0, bus = "pads", level = 0.5, enabled = true)
    track = keys(gain = 0.0, sends = [tap], notes = [beatNote 0.125])
    base = timeline [track]
    score = base(buses = [padsBus (1.0, "")])
    use source, started <- liveLaunched (place, "Bus routing", score)
    list = shownPressed (started, "Patch sends…")
    panel = shownPressed (list, "Edit send 1 · pads…")
    viewShows (panel, sendLevel, true)
    muted = Drive::choose (panel, sendLevel, "0")
    use stream <- heardStream (score, 512)
    use quiet, applied <- liveDialBlock (place, stream)
    bothSilent quiet
    invalid = Drive::choose (muted, sendLevel, "101")
    use still, retained <- liveDialBlock (place, applied)
    expect (retained.controlVersion, applied.controlVersion)
    expect (loudest still.left, 0.0)
    cancelled = Drive::press (invalid, "Cancel")
    use restored, last <- liveDialBlock (place, retained)
    expect (last.controlVersion > retained.controlVersion, true)
    bothAudible restored
    expect ((Drive::holding cancelled).songTicket, (Drive::holding started).songTicket)
    use saved <- succeeds (readFile source)
    use disk <- succeeds (daw::SongFiles::decode saved)
    expect (structuralEquals (disk, score), true)
