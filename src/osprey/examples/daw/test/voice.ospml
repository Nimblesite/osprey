// The Prism synth's voice checked directly, without an editor ([UI-MACHINE-FLOW-SYNTH]): each wave's
// shape, each patch's clip and peak, descriptions that tell patches apart and the WAV header.

import uitest::Drive
import uitest::Semantics
import ui::Lists
import synth::Synth
import synth::Voice

// Select through the visible inspector before exercising a module-specific action.
inspectorSelected (session, identity) =
    next = Drive::choose (session, "Module", "${identity}")
    selectedIs (next, identity)
    next

inspectorAction (session, identity, label) = Drive::press (inspectorSelected (session, identity), label)

// [PRISM-ROUTING-EDITOR] One selected module, compact controls, unchanged graph actions.
inspectorJourney () =
    launched = editorLaunched ["--empty"]
    opened = Drive::press (launched, "Patch Controls")
    oscillator = Drive::choose (opened, "Add component", "sine")
    filter = Drive::choose (oscillator, "Add component", "filter")
    viewShows (filter, "Module", true)
    viewShows (filter, "Cutoff", true)
    viewShows (filter, "Frequency", false)
    viewShows (filter, "Select 1", false)
    selected = Drive::choose (filter, "Module", "0")
    selectedIs (selected, 0)
    viewShows (selected, "Frequency", true)
    viewShows (selected, "Cutoff", false)
    sourced = Drive::press (selected, "Use audio output")
    connected = Drive::press (Drive::choose (sourced, "Module", "1"), "Connect audio")
    cablesOf (connected, 1)
    disconnected = Drive::press (connected, "Disconnect audio")
    cablesOf (disconnected, 0)
    viewShows (disconnected, "Remove module", true)
    expect (length (Drive::holding disconnected).graph.nodes, 2)
    cableGestureJourney ()

patch (wave, process, depth, lfo, volume) = synth::Patch(pitch = 220.0, sounding = true, filtered = true, wave = wave, cutoff = 20.0 * pow (1000.0, process), depth = depth, lfo = lfo, audible = true, volume = volume)

defaultPatch () = patch ("Sine", 0.7, 0.7, 2.0, 0.75)

// One second of `p` per case: every voice case renders the whole second.
sized p = expect (length (Voice::samples p), Voice::rate)

// Where a Windows package keeps the player it launches the synth with.
helper = "C:\\Program Files\\WindowsApps\\Osprey.synth\\app\\play-wav.exe"

windowsLaunch = ["--machine", "C:\\app\\signal_flow.machine.json", "--play", helper]

// `--play` hands `p`'s whole clip to its helper as the one argument, in place of perl and afplay.
playedBy p = match listGet (Synth::played (windowsLaunch, p)) 0
    Success ask => match ask.capability
        ui::Run executable arguments timeout _ _ slice =>
            expect (ask.ticket, "play")
            expect (executable, helper)
            expect (length arguments, 1)
            expect (listGet arguments 0 ?: "", Voice::wav (Voice::samples p))
            expect (timeout, 5000)
            expect (slice, "synth-play")
        _ => expect ("not a run", "run")
    Error _ => expect ("nothing played", "played")

// A `--play` with no path after it is no player: the Mac's perl plays the clip.
macPlayer p = match listGet (Synth::played (["--play"], p)) 0
    Success ask => match ask.capability
        ui::Run executable _ _ _ _ _ => expect (executable, "/usr/bin/perl")
        _ => expect ("not a run", "run")
    Error _ => expect ("nothing played", "played")

voiceCase (p, expectedPeak) =
    sized p
    nearPeak (p, expectedPeak)
    expect (length (Synth::played ([], p)), 1)
    playedBy p
    macPlayer p

silentCase p =
    sized p
    samples = Voice::samples p
    expect (Voice::peak samples, 0)
    expect (ui::Lists::all (samples, \sample => sample == 128), true)
    expect (length (Synth::played ([], p)), 0)
    expect (length (Synth::played (windowsLaunch, p)), 0)

near (actual, expected) = expect (actual - expected < 0.0001 && expected - actual < 0.0001, true)

shapes () =
    near (Voice::shaped ("Sine", 0.25), 1.0)
    near (Voice::shaped ("Sine", 0.75), -1.0)
    near (Voice::shaped ("Triangle", 0.0), -1.0)
    near (Voice::shaped ("Triangle", 0.5), 1.0)
    near (Voice::shaped ("Triangle", 0.25), 0.0)
    near (Voice::shaped ("Saw", 0.0), -1.0)
    near (Voice::shaped ("Saw", 0.75), 0.5)
    near (Voice::shaped ("Square", 0.2), 1.0)
    near (Voice::shaped ("Square", 0.7), -1.0)
    near (Voice::shaped ("Sine", 1.25), 1.0)
    near (Voice::hertz "1/1", 0.5)
    near (Voice::hertz "1/2", 1.0)
    near (Voice::hertz "1/4", 2.0)
    near (Voice::hertz "1/8", 4.0)
    near (Voice::hertz "1/16", 8.0)
    near (Voice::frequency "A3", 220.0)
    near (Voice::frequency "A4", 440.0)
    near (Voice::frequency "C3", 130.8128)
    near (Voice::frequency "C4", 261.6256)
    near (Voice::frequency "C#4", 277.1826)
    near (Voice::frequency "F#3", 184.9972)
    near (Voice::frequency "B4", 493.8833)

voiceCases () =
    voiceCase (defaultPatch (), 75)
    voiceCase (patch ("Sine", 0.1, 0.7, 2.0, 0.75), 17)
    voiceCase (patch ("Sine", 0.1, 0.0, 2.0, 0.75), 2)
    voiceCase (patch ("Sine", 0.7, 0.7, 2.0, 1.0), 100)
    voiceCase (patch ("Sine", 0.7, 0.7, 2.0, 0.5), 50)
    voiceCase (patch ("Square", 0.7, 0.7, 2.0, 0.75), 75)
    voiceCase (patch ("Saw", 0.1, 0.7, 8.0, 0.75), 17)
    d = defaultPatch ()
    silentCase (d(sounding = false))
    silentCase (d(audible = false))
    silentCase (patch ("Sine", 0.7, 0.7, 2.0, 0.0))

// Two patches whose clips must not match.
differ (one, other) = expect (Voice::wav (Voice::samples one) == Voice::wav (Voice::samples other), false)

// Table rows: each patch must describe itself differently from `base`.
renamed (base, others) = forEachList (others, \other => expect (Voice::describe other == base, false))

// Every field of a patch changes what it sounds like.
descriptionsDiffer () =
    d = defaultPatch ()
    base = Voice::describe d
    renamed (base, [patch ("Saw", 0.7, 0.7, 2.0, 0.75), patch ("Sine", 0.1, 0.7, 2.0, 0.75), patch ("Sine", 0.7, 0.3, 2.0, 0.75), patch ("Sine", 0.7, 0.7, 8.0, 0.75), patch ("Sine", 0.7, 0.7, 2.0, 0.5), d(filtered = false), d(pitch = 440.0)])
    differ (d(pitch = 440.0), d)
    differ (patch ("Square", 0.1, 0.7, 2.0, 0.75), patch ("Saw", 0.1, 0.7, 2.0, 0.75))
    differ (patch ("Sine", 0.1, 0.7, 0.5, 0.75), patch ("Sine", 0.1, 0.7, 8.0, 0.75))

wavCase () =
    clip = Voice::wav (Voice::samples (defaultPatch ()))
    expect (length clip, (44 + Voice::rate + bitAnd Voice::rate 1) * 2)
    expect (startsWith clip "52494646362B000057415645666D7420", true)
    expect (contains clip "112B0000112B0000", true)
    expect (take (drop clip 72) 16, "64617461112B0000")

zeroStereoResponse () = "4F535631020000000200000000000000" + join (mapList (toList (range (0, 8)), \_ => "0001000000000000" + join (mapList (toList (range (0, 512)), \_ => "00000000")) "")) ""

// [SYNTH-DEVICE-QUEUE] The application harness supplies typed counter receipts;
// the native worker journey separately consumes real AudioQueue buffers.
// Reconstruct the concrete program so the compiler can prove callable effect provenance.
deviceDone given =
    driven = uitest::Driven(drivenSurface = given.drivenSurface, drivenProgram = synth::EditorApp::program (), drivenSeen = given.drivenSeen, drivenNow = given.drivenNow)
    held = uitest::Drive::holding driven
    match held.renderDevicePending
        [pending] =>
            draining = held.renderInput == "!drain"
            running = match draining
                true => "false"
                false => "true"
            handle ui::Slices
                fetch _ => "{\"status\":0,\"acceptedFrames\":${pending.deviceState.graphPosition},\"returnedFrames\":${pending.deviceState.graphPosition},\"queuedFrames\":0,\"channels\":${pending.deviceChannels},\"emptyCallbacks\":0,\"running\":${running}}"
            uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"stderr\":\"\"}")
        _ =>
            expect (false, true)
            driven

audioDone given =
    driven = uitest::Driven(drivenSurface = given.drivenSurface, drivenProgram = synth::EditorApp::program (), drivenSeen = given.drivenSeen, drivenNow = given.drivenNow)
    held = uitest::Drive::holding driven
    match startsWith held.renderTicket "prism-audio:device:"
        true => match held.renderDeviceKey == ""
            true => uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"session\":\"device\"}")
            false => deviceDone driven
        false => match held.renderOpening
            true => uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"session\":\"${held.renderTicket}\"}")
            false =>
                handle ui::Slices
                    fetch _ => zeroStereoResponse ()
                uitest::Drive::completed (driven, held.renderTicket, true, "{\"status\":0,\"stderr\":\"\"}")

// [SYNTH-DEVICE-QUEUE] Reject inconsistent device receipts without advancing graph state.
deviceCounterJourney editor =
    deviceWarningJourney editor
    valid = "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":0,\"queuedFrames\":2048,\"channels\":2,\"emptyCallbacks\":0,\"running\":false}"
    succeeds (synth::GraphDevice::checked (editor, valid), \receipt => expect (receipt.acceptedFrames, 2048))
    forEachList (["{}", "invalid", replace valid "\"status\":0" "\"status\":1" ?: "invalid", replace valid "\"acceptedFrames\":2048" "\"acceptedFrames\":2049" ?: "invalid", replace valid "\"returnedFrames\":0" "\"returnedFrames\":-1" ?: "invalid", replace valid "\"queuedFrames\":2048" "\"queuedFrames\":0" ?: "invalid", replace valid "\"channels\":2" "\"channels\":1" ?: "invalid", replace valid "\"emptyCallbacks\":0" "\"emptyCallbacks\":-1" ?: "invalid", replace valid "false" "\"false\"" ?: "invalid"], \text =>
        errs (synth::GraphDevice::checked (editor, text)))
    forEachList ([[], listConcat editor.renderDevicePending editor.renderDevicePending], \pending =>
        errs (synth::GraphDevice::checked (editor(renderDevicePending = pending), valid)))
    errs (synth::GraphDevice::checked (editor(renderInput = "!drain"), valid))
    lost = synth::GraphPreview::completed (editor, editor.renderTicket, Error(message = "output disconnected"))
    expect (contains lost.stepStore.message "output disconnected", true)
    expect (length lost.stepStore.renderSessions, 0)
    expect (length lost.requests, 3)
    expect (length lost.writes, 6)
    cleanup = synth::GraphPreview::completed (lost.stepStore, "prism-audio:close:1:-1", Error(message = "already closed"))
    expect (contains cleanup.stepStore.message "output disconnected", true)
    expect (contains cleanup.stepStore.message "already closed", true)

// [SYNTH-DEVICE-QUEUE] Queue starvation must be visible at the controller boundary.
deviceWarningJourney editor =
    handle ui::Slices
        fetch _ => "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":2048,\"queuedFrames\":0,\"channels\":2,\"emptyCallbacks\":1,\"running\":true}"
    warned = synth::GraphPreview::completed (editor, editor.renderTicket, Success(value = "{\"status\":0,\"stderr\":\"\"}"))
    expect (contains warned.stepStore.message "Audio queue ran empty", true)
    expect (warned.stepStore.renderEmptyCallbacks, 1)
    stale = "{\"status\":0,\"acceptedFrames\":2048,\"returnedFrames\":2048,\"queuedFrames\":0,\"channels\":2,\"emptyCallbacks\":0,\"running\":true}"
    errs (synth::GraphDevice::checked (editor(renderEmptyCallbacks = 1), stale))

// [SYNTH-DEVICE-QUEUE] Windows hands the edited graph's audio to its packaged worker.
windowsAudioJourney () =
    worker = "C:\\Prism\\play-wav.exe"
    opened = Drive::launched (Drive::idle (synth::EditorApp::program (), synth::EditorState::initial ()), "windows", ["--audio-worker", worker])
    playing = synth::GraphPreview::play (Drive::holding opened, "windows")
    reads (listGet playing.requests 0, \request =>
        match request.capability
            ui::HostCall space operation args _ _ _ =>
                expect (space, "process")
                expect (operation, "session-open")
                expect (structuralEquals (mapList (args, \arg => arg.headerValue), [worker, "audio-device"]), true)
            _ => expect (false, true))
    exchanged = synth::GraphPreview::completed (playing.stepStore, playing.stepStore.renderTicket, Success(value = "{\"status\":0,\"session\":\"windows-device\"}"))
    reads (listGet exchanged.requests 0, \request =>
        match request.capability
            ui::HostCall _ operation args _ _ slice =>
                expect (operation, "session-exchange")
                expect (slice, "")
                expect (structuralEquals (mapList (args, \arg => arg.headerName), ["session", "stdinText"]), true)
                expect (startsWith exchanged.stepStore.renderInput "52494646", true)
            _ => expect (false, true))
    expect (length exchanged.writes, 0)

// [PRISM-ROUTING-PRESENTATION] Main's artwork controls edit the same live patch.
prismIntegratedJourney () =
    opened = editorLaunched []
    expect (length (Drive::holding opened).graph.nodes, 5)
    cablesOf (opened, 4)
    forEachList (["Filter Cutoff", "Master Level", "Play C#3", "Modules", "Play patch", "Stop playback", "Undo", "Redo", "Timeline", "Patch", "Mix"], \label => expect (Semantics::offered (opened.drivenSeen.renderedAccess, label), true))
    forEachList (["Patch controls", "Audition patch", "Keyboard", "Save project"], \label => expect (Semantics::offered (opened.drivenSeen.renderedAccess, label), false))
    cutoff = Semantics::point (Semantics::element (opened.drivenSeen.renderedAccess, "Filter Cutoff"), 0.5)
    changed = clickAt (opened, cutoff.pointX, cutoff.pointY)
    parameterAt ((Drive::holding changed).graph, 1, 0, \p => near (p.initial, synth::CanvasGeometry::cutoffFrequency 0.5))
    cablesOf (changed, 4)
    level = Semantics::point (Semantics::element (changed.drivenSeen.renderedAccess, "Master Level"), 0.25)
    quieter = clickAt (changed, level.pointX, level.pointY)
    parameterAt ((Drive::holding quieter).graph, 2, 0, \p => near (p.initial, 0.25))
    library = prismTap (quieter, "Modules")
    expect ((Drive::holding library).paletteShown, true)
    added = Drive::pointer (Drive::pointer (library, 80.0, 130.0, true), 350.0, 230.0, false)
    expect (length (Drive::holding added).graph.nodes, 6)
    cablesOf (added, 4)
    selectedIs (added, 5)
    expect ((Drive::holding added).paletteDrag, "")
    prismControlJourney quieter
    keyboardDockJourney quieter
    paletteClickJourney quieter
    filterSocketJourney ()
    cutoffAudioJourney ()

// Every visible module row supports one click as well as drag, without editing covered controls.
paletteClickJourney opened = forEachList (synth::EditorState::kinds, \kind =>
    library = prismTap (opened, "Modules")
    added = prismTap (library, "Add ${synth::EditorState::title kind}")
    addedEditor = Drive::holding added
    expect (length addedEditor.graph.nodes, 6)
    expect (addedEditor.selected, 5)
    expect (addedEditor.paletteShown, false)
    expect (addedEditor.paletteDrag, "")
    expect (structuralEquals (addedEditor.graph.cables, (Drive::holding opened).graph.cables), true)
    expect (structuralEquals (filterList (addedEditor.graph.nodes, \n => n.identity < 5), (Drive::holding opened).graph.nodes), true)
    expect (Semantics::offered (added.drivenSeen.renderedAccess, "Canvas input 5:0") || Semantics::offered (added.drivenSeen.renderedAccess, "Canvas output 5:0"), true)
    match kind == "mixer"
        true => overlappingModuleJourney added
        false => expect (true, true))

overlappingModuleJourney added =
    at = Semantics::point (Semantics::element (added.drivenSeen.renderedAccess, "Canvas Mixer 5"), 0.5)
    moved = Drive::pointer (Drive::pointer (added, at.pointX, at.pointY, true), 607.0, 432.0, false)
    before = (Drive::holding moved).graph
    covered = prismTap (moved, "Bypass Filter")
    selectedIs (covered, 5)
    expect (structuralEquals ((Drive::holding covered).graph, before), true)

prismTap (driven, label) =
    point = Semantics::point (Semantics::element (driven.drivenSeen.renderedAccess, label), 0.5)
    clickAt (driven, point.pointX, point.pointY)

prismControlJourney opened =
    menu = prismTap (opened, "Oscillator Wave: Sine")
    triangle = prismTap (menu, "Triangle")
    offeredIn (triangle, "Oscillator Wave: Triangle", true)
    bypassed = prismTap (triangle, "Bypass Oscillator")
    offeredIn (bypassed, "Enable Oscillator", true)
    valid (synth::Graphs::node ((Drive::holding bypassed).graph, 0), \n =>
        expect (length (filterList (n.parameters, \p => p.key == "waveform" && p.initial == 1.0)), 1)
        expect (length (filterList (n.parameters, \p => p.key == "enabled" && p.initial == 0.0)), 1))
    prismAudioJourney ((Drive::holding opened).graph, (Drive::holding triangle).graph, (Drive::holding bypassed).graph)
    enabled = prismTap (bypassed, "Enable Oscillator")
    rates = prismTap (enabled, "LFO Rate: 1/4")
    faster = prismTap (rates, "1/8")
    offeredIn (faster, "LFO Rate: 1/8", true)
    cablesOf (faster, 4)

prismAudio graph = match synth::GraphClips::advance (graph, [], 128)
    Error why => Error(message = why)
    Success action => match action
        synth::ClipWaiting _ _ _ => Error(message = "Built-in graph unexpectedly requested a plug-in.")
        synth::ClipReady clips => synth::ClipInputs::completed (clips, 3)

prismAudioJourney (sine, triangle, muted) = match prismAudio sine
    Error _ => expect (false, true)
    Success first => match prismAudio triangle
        Error _ => expect (false, true)
        Success second => succeeds (prismAudio muted, \silent =>
            expect (length first.clipSamples, 128)
            expect (length second.clipSamples, 128)
            expect (structuralEquals (first.clipSamples, second.clipSamples), false)
            expect (length (filterList (silent.clipSamples, \value => value != 0.0)), 0))

// [PRISM-ROUTING-PRESENTATION] The dock owns a separate native scene and can be closed/reopened.
keyboardDockJourney opened =
    scenes = filterList (opened.drivenSeen.renderedControls, \control => control.controlKind == "scene")
    expect (length scenes, 2)
    near ((Semantics::element (opened.drivenSeen.renderedAccess, "Play C4")).accessTop, 38.0)
    taller = Drive::viewed (opened, 1836.0, 1258.0)
    near (ui::Machines::number ((Drive::holding taller).skin, "spareHeight"), 430.0)
    near ((Semantics::element (taller.drivenSeen.renderedAccess, "Play C4")).accessTop, 38.0)
    before = (Drive::holding taller).graph
    closed = dockTap (taller, "Close keyboard")
    expect ((Drive::holding closed).keyboardShown, false)
    offeredIn (closed, "Play C4", false)
    expect (length (filterList (closed.drivenSeen.renderedControls, \control => control.controlKind == "scene")), 1)
    expect (structuralEquals ((Drive::holding closed).graph, before), true)
    reopened = Drive::press (closed, "Keyboard")
    expect ((Drive::holding reopened).keyboardShown, true)
    offeredIn (reopened, "Play C4", true)
    expect (structuralEquals ((Drive::holding reopened).graph, before), true)
    expect ((Drive::holding reopened).armedNote, -1)
    menuJourney reopened

// [DAW-MENU] The window's menu bar names every command once, each with its shortcut, and a menu command runs
// the same action as the header's.
menuJourney driven =
    forEachList (["Open Song…", "Save", "Render Song", "Undo", "Redo", "Timeline", "Mix", "Modules", "Patch Controls", "Keyboard", "Play Song", "Stop Song", "Play Patch", "Audition Patch", "Stop Patch"], \label => expect (length (Views::labelled (driven.drivenSeen, label)), 1))
    expect ((Views::control (driven.drivenSeen, "Save")).controlKind, "button")
    timeline = Drive::press (driven, "Timeline")
    expect (synth::TimelineView::pageIndex (Drive::holding timeline).page, 1)
    expect (Views::shows (timeline.drivenSeen, "Save"), true)
    mix = Drive::press (timeline, "Mix")
    expect (synth::TimelineView::pageIndex (Drive::holding mix).page, 2)
    patch = Drive::press (mix, "Patch")
    expect (synth::TimelineView::pageIndex (Drive::holding patch).page, 0)
    hidden = Drive::press (patch, "Keyboard")
    expect ((Drive::holding hidden).keyboardShown, false)
    library = Drive::press (hidden, "Modules")
    expect ((Drive::holding library).paletteShown, true)
    details = Drive::press (library, "Patch Controls")
    expect ((Drive::holding details).detailsShown, (Drive::holding library).detailsShown == false)
    expect (structuralEquals ((Drive::holding details).graph, (Drive::holding driven).graph), true)

dockTap (driven, label) =
    point = Semantics::point (Semantics::element (driven.drivenSeen.renderedAccess, label), 0.5)
    scenes = filterList (driven.drivenSeen.renderedControls, \control => control.controlKind == "scene")
    match listGet scenes 1
        Error _ =>
            expect (false, true)
            driven
        Success scene =>
            pressed = ui::Touch(touchNow = driven.drivenNow, touchKind = ui::Hosting::pointer, touchOrdinal = scene.controlOrdinal, touchWords = "", touchDetail = "", touchX = point.pointX, touchY = point.pointY, touchDown = true, touchShift = false)
            down = Drive::sent (driven, pressed)
            Drive::sent (down, pressed(touchNow = down.drivenNow, touchDown = false))

// [PRISM-ROUTING-CABLES] Physical press/move/release, cancellation and direct removal.
cableGestureJourney () =
    launched = editorLaunched ["--empty"]
    opened = Drive::press (launched, "Patch Controls")
    disconnected = Drive::choose (Drive::choose (opened, "Add component", "sine"), "Add component", "filter")
    armed = Drive::pointer (disconnected, 488.5, 169.5, true)
    expect ((Drive::holding armed).wireDragging, true)
    preview = Drive::pointer (armed, 450.0, 300.0, true)
    cablesOf (preview, 0)
    expect ((Drive::holding preview).wireX, 450.0)
    cancelled = Drive::pointer (preview, 450.0, 300.0, false)
    expect ((Drive::holding cancelled).wireDragging, false)
    cablesOf (cancelled, 0)
    source = Drive::pointer (cancelled, 488.5, 169.5, true)
    connected = clickAt (source, 514.0, 176.0)
    cablesOf (connected, 1)
    expect ((Drive::holding connected).wireDragging, false)
    selected = clickAt (connected, 501.25, 172.75)
    expect ((Drive::holding selected).selectedCable, 0)
    offeredIn (selected, "Delete selected cable", true)
    removed = prismTap (selected, "Delete selected cable")
    cablesOf (removed, 0)
    expect (length (Drive::holding removed).graph.nodes, 2)
    clicked = prismTap (prismTap (removed, "Canvas output 0:0"), "Canvas input 1:0")
    cablesOf (clicked, 1)
    chosen = prismTap (clicked, "Cable 0:0 to 1:0")
    deleted = Drive::key (chosen, "backspace", true)
    cablesOf (deleted, 0)
    expect ((Drive::holding deleted).selectedCable, -1)
    expect (structuralEquals ((Drive::holding deleted).graph.nodes, (Drive::holding disconnected).graph.nodes), true)

// The original Filter's purple/cyan sockets are backed by real graph routes and audio.
filterSocketJourney () =
    opened = editorLaunched []
    before = (Drive::holding opened).graph
    controlled = prismTap (prismTap (opened, "Canvas output 4:0"), "Canvas input 1:1")
    cablesOf (controlled, 5)
    succeeds (prismAudio before, \original => succeeds (prismAudio (Drive::holding controlled).graph, \modulated => expect (structuralEquals (original.clipSamples, modulated.clipSamples), false)))
    monitored = prismTap (prismTap (controlled, "Monitor output 1"), "Canvas input 3:0")
    expect (length (filterList ((Drive::holding monitored).graph.cables, \c => c.source == 1 && c.destination == 3)), 1)
    cablesOf (monitored, 5)
    invalid = prismTap (prismTap (monitored, "Canvas output 4:0"), "Canvas input 1:0")
    sameGraph (invalid, monitored)

// [PRISM-ROUTING-CABLES] Normalized cutoff endpoints and invalid samples exercise real DSP.
cutoffOutput (graph, value) =
    control = synth::NodeClip(clipNode = 4, clipChannels = 1, clipSamples = mapList (toList (range (0, 128)), \_ => value), clipNotes = [])
    match synth::GraphClips::advance (graph, [control], 128)
        Error why => Error(message = why)
        Success action => match action
            synth::ClipWaiting _ _ _ => Error(message = "A built-in filter requested a plug-in.")
            synth::ClipReady clips => synth::ClipInputs::completed (clips, 3)

cutoffAudioJourney () =
    base = synth::EditorState::preset ()
    lfo = synth::EditorState::tapped (base, synth::Add(kind = "lfo"))
    connected = synth::EditorState::tapped (synth::EditorState::tapped (lfo, synth::Source(identity = 4, outlet = 0)), synth::Connect(identity = 1, inlet = 1))
    match prismAudio base.graph
        Error _ => expect (false, true)
        Success original => forEachList ([0.0, 0.25, 0.5, 1.0], \value =>
            succeeds (cutoffOutput (connected.graph, value), \rendered =>
                expect (length rendered.clipSamples, 128)
                expect (structuralEquals (rendered.clipSamples, original.clipSamples), value == 1.0)))
    forEachList ([-0.1, 1.1, floatFromBits 9221120237041090560], \value => errs (cutoffOutput (connected.graph, value)))

// [SYNTH-DEVICE-QUEUE] The audio device is an effect: every float32 WAV block the app writes to it is heard here.
effect Speaker
    heard : string => Unit

type Heard =
    blocks : List<string>

spoken given =
    held = Drive::holding given
    perform Speaker.heard (ui::Pick::either (startsWith held.renderTicket "prism-audio:device:" && contains held.renderTicket ":block", held.renderInput, ""))
    audioDone given

// Audition through the real worker/device path; returns the decoded samples the device received.
auditioned driven =
    mut speaker = Heard(blocks = [])
    handle Speaker
        heard hex => speaker := speaker(blocks = listConcat speaker.blocks (filterList ([hex], \h => h != "")))
    finished = foldList (toList (range (0, 40)), Drive::press (driven, "Audition"), \(previous, _) =>
        match (Drive::holding previous).renderTicket == ""
            true => previous
            false => spoken previous)
    showsIn (finished, "Preview finished.", true)
    expect (length speaker.blocks, 6)
    foldList (speaker.blocks, [], \(all, hex) => listConcat all (pcm hex))

// The exact mono 48 kHz IEEE float32 WAV GraphDevice writes, header field by field.
pcm hex =
    count = intDiv (satSub (length hex) 116) 8
    expect (take hex 8, "52494646")
    expect (take (drop hex 40) 32, "0300010080BB000000EE020004002000")
    expect (take (drop hex 100) 16, "6461746100200000")
    expect (count, 2048)
    mapList (toList (range (0, count)), \i => synth::PcmWords::sample (hex, satAdd 116 (satMul i 8)) ?: 99.0)

// Running measurements of the heard signal: crossings, energy, peak and steepest step.
type Meter =
    previous : float
    index : int
    first : float
    last : float
    rising : int
    energy : float
    peak : float
    steepest : float

metered (m, sample) =
    at = toFloat (m.index - 1) + m.previous / (m.previous - sample)
    crossed = m.index > 0 && m.previous < 0.0 && sample >= 0.0
    step = abs (sample - m.previous)
    next = m(previous = sample, index = satAdd m.index 1, energy = m.energy + sample * sample, peak = ui::Pick::either (abs sample > m.peak, abs sample, m.peak), steepest = ui::Pick::either (m.index > 0 && step > m.steepest, step, m.steepest))
    match crossed
        false => next
        true => next(first = ui::Pick::either (m.rising == 0, at, m.first), last = at, rising = satAdd m.rising 1)

meter samples = foldList (samples, Meter(previous = 0.0, index = 0, first = 0.0, last = 0.0, rising = 0, energy = 0.0, peak = 0.0, steepest = 0.0), metered)

// Fundamental from interpolated rising zero crossings.
hertz m = ui::Pick::either (m.rising < 2, 0.0, toFloat (m.rising - 1) * 48000.0 / (m.last - m.first))

rms m = sqrt (m.energy / toFloat (ui::Pick::either (m.index == 0, 1, m.index)))

within (actual, expected, tolerance) = expect (abs (actual - expected) <= tolerance, true)

patched kinds =
    opened = Drive::press (editorLaunched ["--empty", "--vst-worker", "/worker/osprey-vst-worker"], "Patch Controls")
    added = foldList (kinds, opened, \(d, kind) => Drive::choose (d, "Add component", kind))
    wired = foldList (toList (range (1, length kinds)), added, \(d, i) => prismTap (prismTap (d, "Canvas output ${i - 1}:0"), "Canvas input ${i}:0"))
    expect (length (Drive::holding wired).graph.cables, length kinds - 1)
    wired

tuned (driven, node, label, words) = Drive::choose (inspectorSelected (driven, node), label, words)

// A pure tone reaches the device at its exact pitch and level with no click at any block boundary.
toneJourney hz =
    m = meter (auditioned (tuned (patched ["sine", "output"], 0, "Frequency", "${hz}")))
    expect (m.index, 12288)
    within (hertz m, hz, 0.05)
    within (rms m, 0.70711, 0.002)
    within (m.peak, 1.0, 0.01)
    expect (m.steepest <= 6.2832 * hz / 48000.0 + 0.000001, true)

// [PRISM-ROUTING-CABLES] Gain scales, and the low-pass attenuates by cutoff, on the heard output.
deviceAudioJourney () =
    forEachList ([110.0, 440.0, 1000.0, 2500.0, 7000.0], toneJourney)
    halved = meter (auditioned (tuned (tuned (patched ["sine", "gain", "output"], 0, "Frequency", "440"), 1, "Gain", "0.5")))
    within (hertz halved, 440.0, 0.05)
    within (rms halved, 0.35355, 0.002)
    filtered = tuned (patched ["sine", "filter", "output"], 0, "Frequency", "4000")
    cutoffHeard (filtered, "400", 0.0, 0.02)
    cutoffHeard (filtered, "19000", 0.70711, 0.03)

cutoffHeard (filtered, cutoff, level, tolerance) =
    m = meter (auditioned (tuned (filtered, 1, "Cutoff", cutoff)))
    within (hertz m, 4000.0, 1.0)
    within (rms m, level, tolerance)
