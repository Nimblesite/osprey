import uitest::Drive

octaveArpeggio = "48 + t % 4 * 12"

// [SYNTH-FORMULA-NOTES] A person adds a formula melody from the Add component picker, types formulas into its
// inspector and reads the notes each one plays; a formula that does not parse is refused with its column and
// leaves the patch as it was; a saved melody reopens with its formula.
formulaChoice (driven, text) = Drive::choose (driven, "Formula over step t", text)

melodyText processor = match processor
    synth::FormulaNotes formula => formula
    _ => "not a melody"

formulaOf editor = match synth::Graphs::node (editor.graph, 0)
    synth::Invalid _ => "no melody"
    synth::Valid n => melodyText n.processor

formulaHeld (driven, want) = heldIs (driven, formulaOf, want)

// The caption under the formula: the first sixteen notes it plays.
plays (driven, notes) = showsIn (driven, "Plays ${notes}", true)

repeated (text, times) = join (mapList (toList (range (0, times)), \_ => text), " ")

formulaMenuJourney () =
    opened = openedEditor ["--empty"]
    melody = component (opened, "formula-notes")
    nodesOf (melody, 1)
    selected = inspectorSelected (melody, 0)
    formulaHeld (selected, "60 + t * 7 % 12")
    plays (selected, "C4 G4 D4 A4 E4 B4 F♯4 C♯4 G♯4 D♯4 A♯4 F4 C4 G4 D4 A4")
    forEachList (["Velocity", "Step (frames)", "Gate (frames)", "Steps"], \text => reads (dialOf (selected, text), \dial => expect (dial.accessMax > dial.accessMin, true)))
    offeredIn (selected, "Canvas output 0:0", true)
    octaves = formulaChoice (selected, octaveArpeggio)
    formulaHeld (octaves, octaveArpeggio)
    mentions (octaves, "Patch updated.")
    plays (octaves, repeated ("C3 C4 C5 C6", 4))
    broken = formulaChoice (octaves, "48 + )")
    formulaHeld (broken, octaveArpeggio)
    mentions (broken, "Formula: unexpected ')' at column 6.")
    sameGraph (broken, octaves)
    unknown = formulaChoice (octaves, "48 + x")
    mentions (unknown, "Formula: unknown name 'x'; use t, sin, cos, abs, floor, round or sqrt.")
    sameGraph (unknown, octaves)
    resting = formulaChoice (octaves, "60 / (t % 2)")
    formulaHeld (resting, "60 / (t % 2)")
    plays (resting, repeated ("rest C4", 8))
    folded = formulaChoice (resting, "130 + t")
    plays (folded, "A♯8 B8 C9 C♯9 D9 D♯9 E9 F9 F♯9 G9 G♯8 A8 A♯8 B8 C9 C♯9")

// A saved melody keeps its formula in the project's asset and reopens as the same graph; a project whose
// formula no longer parses says why the track cannot open.
projectFormulaJourney () =
    melody = synth::Components::formulaMelody (21, octaveArpeggio)
    sine = synth::Components::sine (22, 440.0)
    voice = sine(inputs = [synth::Port(name = "notes", rate = synth::Events, channels = 1, unit = synth::Notes)])
    valid (synth::Patches::built ([melody, voice, synth::Components::output 23], [synth::Components::route (21, 0, 22, 0), synth::Components::route (22, 0, 23, 0)]), \graph =>
        withSavedPatch (graph, \changed => encoded (changed, \source =>
            expect (contains source "\"component\":\"formulaNotes\"", true)
            expect (contains source "\"asset\":\"48 + t % 4 * 12\"", true)
            decoded (source, \opened =>
                succeeds (daw::TrackPatches::picked (opened, 0), \again => expect (structuralEquals (again, graph), true))))))
    broken = daw::PatchNode(identity = 1, component = "formulaNotes", size = 0, seed = 0, asset = "60 +", settings = [])
    brokenTrack = freshTrack ("broken", daw::PatchInstrument(routing = daw::Routing(nodes = [broken], cables = [], attack = 0.01, release = 0.1)))
    failsWith (daw::TrackPatches::patch brokenTrack, "formulaNotes 1: Formula: the formula ends where a number, t, a function or '(' belongs.")

// [PRISM-ROUTING-VERIFY] The graph-edit journey through the hosted canvas: seven modules from the Add component
// menu, cables drawn by tapping an output socket then an input socket, a cycle and an event-into-audio route
// refused with the snapshot unchanged, a cable cut and redrawn, and a connected node deleted from its menu.
socketRoutes = [{ s = 0, d = 2, i = 0 }, { s = 0, d = 3, i = 0 }, { s = 2, d = 4, i = 0 }, { s = 3, d = 4, i = 1 }, { s = 4, d = 5, i = 0 }]

socketRefused (patched, bad) =
    refused = linked (patched, bad.s, bad.d, bad.i)
    sameGraph (refused, patched)
    expect ((Drive::holding refused).message != "", true)

socketGraphJourney () =
    added = chained (openedEditor ["--empty"], ["sine", "sine", "gain", "gain", "mixer", "output", "midi-note"])
    nodesOf (added, 7)
    patched = foldList (socketRoutes, added, \(d, c) => linked (d, c.s, c.d, c.i))
    cablesOf (patched, 5)
    forEachList (socketRoutes, \c => offeredIn (patched, "Cable ${c.s}:0 to ${c.d}:${c.i}", true))
    forEachList ([{ s = 6, d = 2, i = 0 }, { s = 4, d = 2, i = 0 }], \bad => socketRefused (patched, bad))
    offeredIn (patched, "Canvas input 5:3", false)
    unplugged = cutCable (patched, "Cable 0:0 to 3:0")
    cablesOf (unplugged, 4)
    offeredIn (unplugged, "Cable 0:0 to 3:0", false)
    rerouted = linked (unplugged, 1, 3, 0)
    cablesOf (rerouted, 5)
    offeredIn (rerouted, "Cable 1:0 to 3:0", true)
    gone = deleteNode (rerouted, 4)
    expect (mapList ((Drive::holding gone).graph.nodes, \n => n.identity), [0, 1, 2, 3, 5, 6])
    cablesOf (gone, 2)
    forEachList (["Cable 0:0 to 2:0", "Cable 1:0 to 3:0"], \label => offeredIn (gone, label, true))
