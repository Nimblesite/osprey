// [DAW-TRANSPORT-LIVE] daw <project.json> <folder> <from-beat> <beats> live|loop: Master as device blocks on standard output.
namespace daw

(** Live play: the project's graph played block by block, each block printed as soon as it is made, as one line
    of hex holding a 48 kHz float WAV the audio device adapter accepts. Nothing is kept and nothing is mastered
    over the whole song: each sample passes `ArrangeMath::live`. *)
module Streams
    // Frames per printed block: half the device's largest, so sound starts and stops sooner.
    block = 4096

    // The most passes a loop makes before it ends by itself.
    passes = 100000

    side (samples, index) = ArrangeMath::live (listGet samples index ?: 0.0)

    weave (played, index) = match index % 2 == 0
        true => side (played.left, intDiv index 2)
        false => side (played.right, intDiv index 2)

    // Left and right interleaved, each sample through the live soft clip.
    woven played = mapList (toList (range (0, satMul (length played.left) 2)), \index => weave (played, index))

    printed (hex, playing) =
        print hex
        Success(value = playing)

    sent (arrangement, played) = synth::Outcomes::carried (PatchVoices::told (synth::WaveFiles::interleaved (arrangement.sampleRate, 2, woven played)), \hex => printed (hex, played.playing))

    least (one, other) = match one < other
        true => one
        false => other

    silent = TrackPlay(pending = [], sounding = [], sends = [], made = [])

    warm (dirs, playing, index, until) =
        track = listGet playing.tracks index ?: silent
        match listGet dirs index
            Error _ => track
            Success dir => NoteCache::seeded (dir, track, until)

    // Notes due in the next block that a maker has kept are read, not made ([DAW-TRANSPORT-LIVE-SPEED]).
    seeded (dirs, playing, until) = playing(tracks = mapList (toList (range (0, length playing.tracks)), \index => warm (dirs, playing, index, until)))

    // The interactive stream limits each device packet to 256 frames; offline streams retain their larger batch.
    size path = ui::Pick::either (path == "", block, 256)

    changed (folder, stream, next) = match next.controlVersion == stream.controlVersion
        true => Success(value = next)
        false => synth::Outcomes::carried (NoteCache::found (next.controlScore, folder), \dirs => Success(value = next(noteFolders = dirs)))

    advanced (folder, path, count, stream) =
        frames = least (size path, satSub count stream.playing.cursor)
        synth::Outcomes::carried (LiveControls::receive (path, stream), \received =>
            synth::Outcomes::carried (changed (folder, stream, received), \next =>
                synth::Outcomes::carried (Playback::next (next.controlScore, seeded (next.noteFolders, next.playing, satAdd next.playing.cursor frames), frames), \played =>
                    synth::Outcomes::carried (sent (next.controlScore, played), \playing => Success(value = next(playing = playing))))))

    pass (folder, path, count, start) = foldList (toList (range (0, intDiv (satAdd count (satSub (size path) 1)) (size path))), start, \(outcome, _) =>
        synth::Outcomes::carried (outcome, \stream => advanced (folder, path, count, stream)))

    kept (fresh, last, index) =
        track = listGet fresh.tracks index ?: silent
        prior = listGet last.tracks index ?: track
        track(made = prior.made)

    // The project back at its first frame, every track keeping the notes it has already made: a loop makes each
    // distinct note once, in its first pass.
    rewound (arrangement, last) = synth::Outcomes::carried (Playback::start arrangement, \fresh => Success(value = fresh(tracks = mapList (toList (range (0, length fresh.tracks)), \index => kept (fresh, last, index)))))

    again (folder, path, count, outcome) = synth::Outcomes::carried (outcome, \last =>
        pass (folder, path, count, synth::Outcomes::carried (rewound (last.controlScore, last.playing), \playing => Success(value = last(playing = playing)))))

    // A loop is exactly its beats, pass after pass; one pass rings out to the piece's end.
    measured (request, arrangement, loop) = match loop
        true => Arrangements::frame (arrangement, request.beats)
        false => Arrangements::frames arrangement

    ran (request, path, count, loop, initial) = match count >= size path
        false => Error(message = "There is too little here to play.")
        true => match loop
            true => foldList (toList (range (0, passes)), initial, \(outcome, _) => again (request.folder, path, count, outcome))
            false => pass (request.folder, path, count, initial)

    initial (arrangement, folder) = synth::Outcomes::carried (Playback::start arrangement, \playing =>
        synth::Outcomes::carried (NoteCache::found (arrangement, folder), \dirs =>
            Success(value = LiveStream(playing = playing, controlVersion = 0, controlScore = arrangement, noteFolders = dirs))))

    (** Play the requested window, reading live parameter revisions between device blocks. *)
    export played (request, arrangement, loop, path) = match arrangement.sampleRate == 48000
        false => Error(message = "Live play needs a 48 kHz project; this one is ${arrangement.sampleRate} Hz.")
        true => synth::Outcomes::carried (measured (request, arrangement, loop), \count => ran (request, path, count, loop, initial (arrangement, request.folder)))
