// [DAW-TRANSPORT-LIVE] daw <project.json> <folder> <from-beat> <beats> live|loop: Master as device blocks on standard output.
namespace daw

(** Live play: the project's graph played block by block, each block printed as soon as it is made, as one line
    of hex holding a 48 kHz float WAV the audio device adapter accepts. Nothing is kept and nothing is mastered
    over the whole song: each sample passes `ArrangeMath::live`. *)
module Streams
    // Frames per printed block: half the device's largest, so sound starts and stops sooner.
    block = 4096

    // The most passes a loop makes before it ends by itself.
    passes = 100000

    side (samples, drive, index) = ArrangeMath::live (listGet samples index ?: 0.0, drive)

    weave (played, drive, index) = match index % 2 == 0
        true => side (played.left, drive, intDiv index 2)
        false => side (played.right, drive, intDiv index 2)

    // Left and right interleaved, each sample through the live soft clip.
    woven (played, drive) = mapList (toList (range (0, satMul (length played.left) 2)), \index => weave (played, drive, index))

    printed (hex, playing) =
        print hex
        Success(value = playing)

    sent (arrangement, played) = synth::Outcomes::carried (synth::WaveFiles::interleaved (arrangement.sampleRate, 2, woven (played, arrangement.drive)), \hex => printed (hex, played.playing))

    least (one, other) = match one < other
        true => one
        false => other

    advanced (arrangement, count, playing) = match playing.cursor >= count
        true => Success(value = playing)
        false => synth::Outcomes::carried (Playback::next (arrangement, playing, least (block, satSub count playing.cursor)), \played => sent (arrangement, played))

    stepped (arrangement, count, outcome) = synth::Outcomes::carried (outcome, \playing => advanced (arrangement, count, playing))

    // One pass over the first `count` frames, from `start`.
    pass (arrangement, count, start) = foldList (toList (range (0, intDiv (satAdd count (satSub block 1)) block)), start, \(outcome, _) => stepped (arrangement, count, outcome))

    kept (fresh, last, index) =
        track = listGet fresh.tracks index ?: TrackPlay(pending = [], sounding = [], sends = [], made = [])
        prior = listGet last.tracks index ?: track
        track(made = prior.made)

    // The project back at its first frame, every track keeping the notes it has already made: a loop makes each
    // distinct note once, in its first pass.
    rewound (arrangement, last) = synth::Outcomes::carried (Playback::start (arrangement, []), \fresh => Success(value = fresh(tracks = mapList (toList (range (0, length fresh.tracks)), \index => kept (fresh, last, index)))))

    again (arrangement, count, outcome) = synth::Outcomes::carried (outcome, \last => pass (arrangement, count, rewound (arrangement, last)))

    // A loop is exactly its beats, pass after pass; one pass rings out to the piece's end.
    measured (request, arrangement, loop) = match loop
        true => Arrangements::frame (arrangement, request.beats)
        false => Arrangements::frames arrangement

    ran (arrangement, count, loop) = match count >= block
        false => Error(message = "There is too little here to play.")
        true => match loop
            true => foldList (toList (range (0, passes)), Playback::start (arrangement, []), \(outcome, _) => again (arrangement, count, outcome))
            false => pass (arrangement, count, Playback::start (arrangement, []))

    (** Play `arrangement` to standard output: once to its end, or its `request.beats` again and again. *)
    export played (request, arrangement, loop) = match arrangement.sampleRate == 48000
        false => Error(message = "Live play needs a 48 kHz project; this one is ${arrangement.sampleRate} Hz.")
        true => synth::Outcomes::carried (measured (request, arrangement, loop), \count => ran (arrangement, count, loop))
