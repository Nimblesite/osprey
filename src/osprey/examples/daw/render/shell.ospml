// [SYNTH-ARRANGEMENT-PLAYER] Host tools the player runs: every command is bounded by `timeout`.
namespace daw

(** The host's process spawner: one POSIX shell line in, the line that spawner runs out. *)
effect HostShell
    line : string => string

(** Runs one host command to completion. Paths are single-quoted; callers refuse a path `SongFiles::safe` rejects. *)
module Shell
    reported (_process, kind, text) = match kind == 2 && text != ""
        true => print text
        false => print ""

    ended (command, process, code) =
        _released = cleanupProcess process
        match code == 0
            true => Success(value = code)
            false => Error(message = "Exit ${code}: ${command}")

    character (text, index) = synth::PcmWords::byte (byteAt text index ?: 32)

    (** `text`'s bytes as lowercase hex digits. *)
    export hex text = join (mapList (toList (range (0, length text)), \index => character (text, index))) ""

    (** Run `command` under `timeout seconds`; a non-zero exit is an error naming the command. *)
    export ran (seconds, command) = match spawnProcess (perform HostShell.line "timeout ${seconds} ${command}") reported
        Error _ => Error(message = "Could not start: ${command}")
        Success process => ended (command, process, awaitProcess process)

    (** A safe path in single quotes. *)
    export quoted path = "'${path}'"

    (** POSIX hosts spawn through `/bin/sh`, which runs the line as written. *)
    export posix work =
        handle HostShell
            line command => command
        work ()

    // Windows spawns through cmd.exe, which knows no single quotes, so the POSIX line goes to MSYS2's `sh` as
    // hex: cmd sees only digits inside one double-quoted word. `IFS=` and `set -f` keep the decoded line one
    // unglobbed word for `eval`.
    (** Windows hosts hand the line to MSYS2's `sh`. *)
    export windows work =
        handle HostShell
            line command => "sh -c \"set -f; IFS=; eval $(echo ${hex command} | xxd -r -p)\""
        work ()

    (** The handler for the host this program runs on, chosen once at the entry point. *)
    export hosted work = match (env "OS" ?: "") == "Windows_NT"
        true => windows work
        false => posix work
