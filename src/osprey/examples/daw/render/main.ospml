// [SYNTH-ARRANGEMENT-PLAYER] daw <project.json> <output-folder> [<from-beat> <beats>]

usage = "usage: daw <project.json> <output-folder> [<from-beat> <beats>]"

// A number argument; absent reads 0 (the whole song), malformed reads -1 (refused).
beatArgument (items, index) = match listGet items index
    Error _ => 0.0
    Success text => parseFloat text ?: -1.0

request items = daw::Request(project = listGet items 0 ?: "", folder = listGet items 1 ?: "", from = beatArgument (items, 2), beats = beatArgument (items, 3))

// The whole song, or only the window an excerpt request names.
windowed (request, arrangement) = match request.beats > 0.0
    true => daw::Projects::excerpt (arrangement, request.from, request.beats)
    false => arrangement

finished outcome = match outcome
    Error why => print "daw: ${why}"
    Success path => print "daw: wrote ${path}"

performed (request, source) = match daw::SongFiles::decode source
    Error why => print "daw: ${why}"
    Success arrangement => match makeDir request.folder
        Error why => print "daw: ${why}"
        Success _ =>
            print "daw: ${arrangement.title}, ${arrangement.tempo} bpm, ${length arrangement.tracks} tracks"
            finished (daw::Player::rendered (request, windowed (request, arrangement)))

started request = match request.project != "" && request.folder != "" && request.from >= 0.0 && request.beats >= 0.0 && daw::SongFiles::safe request.project && daw::SongFiles::safe request.folder
    false => print usage
    true => match readFile request.project
        Error why => print "daw: ${why}"
        Success source => performed (request, source)

main () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    started (request (args ()))
