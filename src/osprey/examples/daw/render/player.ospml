// [SYNTH-ARRANGEMENT-PLAYER] [DAW-RENDER-MASTER] [DAW-RENDER-PLAY] Play a song project's graph into Master and write Master to one WAV.
namespace daw

(** The engine plays the project's graph once into Master; `ffmpeg` only joins the rendered parts. *)
module Player
    // Frames per WAV part: 960,000 interleaved samples, half the encoder's limit.
    chunk = 480000

    piecePath request = (pathJoin (request.folder, "piece.wav"))

    songPath request = (pathJoin (request.folder, "song.wav"))

    least (one, other) = match one < other
        true => one
        false => other

    stored (held, name, stem, hex) = match writeFile "${stem}.hex" hex
        Error why => held(fault = why)
        Success _ => match Shell::ran (120, "xxd -r -p ${Shell::quoted "${stem}.hex"} ${Shell::quoted "${stem}.wav"} && rm ${Shell::quoted "${stem}.hex"}")
            Error why => held(fault = why)
            Success _ => held(parts = listAppend held.parts "${name}.wav")

    written (request, arrangement, mix, held, index) = match held.fault == ""
        false => held
        true => match PatchVoices::told (synth::WaveFiles::interleaved (arrangement.sampleRate, 2, Arrangements::interleaved (mix, satMul index chunk, least (satMul (satAdd index 1) chunk, length mix.left))))
            Error why => held(fault = why)
            Success hex => stored (held, "part-${index}", pathJoin (request.folder, "part-${index}"), hex)

    parts (request, arrangement, mix) =
        held = foldList (toList (range (0, intDiv (satAdd (length mix.left) (satSub chunk 1)) chunk)), Written(parts = [], fault = ""), \(held, index) => written (request, arrangement, mix, held, index))
        match held.fault == ""
            true => Success(value = held.parts)
            false => Error(message = held.fault)

    // The concat list names parts relative to itself.
    assembled (stage, files, destination) = match writeFile (pathJoin (stage.folder, "parts.txt")) (join (mapList (files, \path => "file ${Shell::quoted path}")) "\n")
        Error why => Error(message = why)
        Success _ =>
            wav = Shell::quoted (piecePath stage)
            command = "ffmpeg -v error -y -f concat -safe 0 -i ${Shell::quoted (pathJoin (stage.folder, "parts.txt"))} -c copy ${wav} && mv -f ${wav} ${Shell::quoted destination}"
            synth::Outcomes::carried (Shell::ran (300, command), \_ => Success(value = destination))

    // Parts and the unfinished join are private to this render. Only a successful join replaces the last WAV.
    // A umask, not `mkdir -m`: MSYS2 mounts NTFS `noacl`, so its mkdir cannot set a mode and fails after creating.
    staged (request, arrangement, mix) =
        destination = ui::Pick::either (request.beats > 0.0, piecePath request, songPath request)
        stage = request(folder = pathJoin (request.folder, ".render-${random ()}"))
        synth::Outcomes::carried (Shell::ran (10, "sh -c 'umask 077 && mkdir \"$1\"' sh ${Shell::quoted stage.folder}"), \_ =>
            result = synth::Outcomes::carried (parts (stage, arrangement, mix), \files => assembled (stage, files, destination))
            synth::Outcomes::carried (Shell::ran (10, "rm -rf ${Shell::quoted stage.folder}"), \_ => result))

    // [DAW-ANALYSIS-SPECTRUM] Master's octave bands in whole dB, where a full-scale sine reads 0.
    decibel level = toString (floatToInt (synth::SpectralMath::nearest level) ?: -120)

    hertz centre = match centre < 1000.0
        true => "${toString (floatToInt (synth::SpectralMath::nearest centre) ?: 0)} Hz"
        false => "${toString (floatToInt (synth::SpectralMath::nearest (centre / 1000.0)) ?: 0)} kHz"

    // The mid channel: the average of both sides.
    middle mix = mapList (toList (range (0, length mix.left)), \index => ArrangeMath::bused (ArrangeMath::scaled (listGet mix.left index ?: 0.0, 0.5), 0.5, listGet mix.right index ?: 0.0))

    analysed (arrangement, mix) = match PatchVoices::told (synth::Spectra::bands (middle mix, toFloat arrangement.sampleRate, 4096, 4096))
        Error why => print "  Master spectrum: ${why}"
        Success bands => print "  Master spectrum (mean / loudest dB): ${join (mapList (bands, \band => "${hertz band.centre} ${decibel band.level}/${decibel band.peak}")) " · "}"

    // Progress through the song in time, every 64 blocks.
    reported (arrangement, count, played) = match played.playing.cursor % (Playback::block * 64) == 0
        true =>
            print "  played ${intDiv played.playing.cursor arrangement.sampleRate} of ${intDiv count arrangement.sampleRate} s"
            played
        false => played

    kept (take, played) = Take(playing = played.playing, lefts = listPrepend take.lefts played.left, rights = listPrepend take.rights played.right)

    taken (arrangement, count, outcome) = synth::Outcomes::carried (outcome, \take =>
        synth::Outcomes::carried (Playback::step (arrangement, take.playing, least (Playback::block, satSub count take.playing.cursor)), \played => Success(value = kept (take, reported (arrangement, count, played)))))

    // [DAW-RENDER-PLAY] The whole graph played once, block by block, keeping only Master.
    played (arrangement, count) = synth::Outcomes::carried (Playback::start arrangement, \playing =>
        foldList (toList (range (0, intDiv (satAdd count (satSub Playback::block 1)) Playback::block)), Success(value = Take(playing = playing, lefts = [], rights = [])), \(outcome, _) => taken (arrangement, count, outcome)))

    loudest (high, value) = synth::TableMath::larger (high, synth::TableMath::magnitude value)

    // [DAW-TRANSPARENCY] Master exactly as the graph made it: measured, never scaled or limited.
    mastered (take: Take) =
        left = ui::Lists::flatten (listReverse take.lefts)
        right = ui::Lists::flatten (listReverse take.rights)
        Mixdown(left = left, right = right, peak = foldList (right, foldList (left, 0.0, loudest), loudest))

    mixed (request, arrangement, take) =
        mix = mastered take
        print "  Master: ${length mix.left} frames, peak ${mix.peak}"
        analysed (arrangement, mix)
        staged (request, arrangement, mix)

    (** Render the song into the request's folder; the result is the finished WAV's path. *)
    export rendered (request, arrangement) = match Arrangements::frames arrangement
        Error why => Error(message = why)
        Success count => synth::Outcomes::carried (played (arrangement, count), \take => mixed (request, arrangement, take))
