// [SYNTH-ARRANGEMENT-PLAYER] [DAW-RENDER-MASTER] Render a song project to one WAV, the Master mix (never per-track stems), after the recording it continues.
namespace daw

(** The engine renders every track and the held end of the intro; `ffmpeg` only cuts the intro's last
    seconds, joins the rendered parts and crossfades them after the intro. *)
module Player
    // Frames per WAV part: 960,000 interleaved samples, half the encoder's limit.
    chunk = 480000

    tailPath request = "${request.folder}/tail.wav"

    piecePath request = "${request.folder}/piece.wav"

    songPath request = "${request.folder}/song.wav"

    decoded (request, size) = match readFileBytes (tailPath request) 0 size
        Error why => Error(message = why)
        Success bytes => synth::Outcomes::carried (synth::WaveImport::decode bytes, \wave => Success(value = wave.samples))

    // The intro's last `tail` seconds as mono at the song's rate.
    tail (request, arrangement) = match Shell::ran (120, "ffmpeg -v error -y -sseof -${arrangement.intro.tail} -i ${Shell::located arrangement.intro.recording} -ac 1 -ar ${arrangement.sampleRate} -c:a pcm_s16le ${Shell::quoted (tailPath request)}")
        Error why => Error(message = why)
        Success _ => synth::Outcomes::carried (fileSize (tailPath request), \size => decoded (request, size))

    glowed (arrangement, raw, outcome, glow) = match outcome
        Error why => Error(message = why)
        Success buses => match Sustains::voiced (toFloat arrangement.sampleRate, raw, glow)
            Error why => Error(message = why)
            Success pad => synth::Outcomes::carried (Arrangements::frame (arrangement, glow.start), \start => Arrangements::layered (buses, pad, start, glow.gain, 0.0, glow.reverb))

    held (arrangement, buses, source) = synth::Outcomes::carried (Sustains::frozen (toFloat arrangement.sampleRate, source, Sustains::needed (toFloat arrangement.sampleRate, arrangement.sustains)), \raw => foldList (arrangement.sustains, Success(value = buses), \(outcome, glow) => glowed (arrangement, raw, outcome, glow)))

    // Without an intro recording there is no held end to sustain.
    bridged (request, arrangement, buses) = match length arrangement.sustains == 0 || arrangement.intro.recording == ""
        true => Success(value = buses)
        false => match tail (request, arrangement)
            Error why => Error(message = why)
            Success source =>
                print "  holding the intro's last moment (${length arrangement.sustains} appearances)"
                held (arrangement, buses, source)

    tracked (arrangement, count, outcome, voice) = match outcome
        Error why => Error(message = why)
        Success buses =>
            print "  rendering ${voice.name} (${length voice.notes} notes)"
            Arrangements::added (arrangement, buses, voice, count)

    least (one, other) = match one < other
        true => one
        false => other

    stored (held, name, stem, hex) = match writeFile "${stem}.hex" hex
        Error why => held(fault = why)
        Success _ => match Shell::ran (120, "xxd -r -p ${Shell::quoted "${stem}.hex"} ${Shell::quoted "${stem}.wav"} && rm ${Shell::quoted "${stem}.hex"}")
            Error why => held(fault = why)
            Success _ => held(parts = listAppend held.parts "${name}.wav")

    written (request, arrangement, mix, held, index) = match held.fault == ""
        false => held
        true => match synth::WaveFiles::interleaved (arrangement.sampleRate, 2, Arrangements::interleaved (mix, satMul index chunk, least (satMul (satAdd index 1) chunk, length mix.left)))
            Error why => held(fault = why)
            Success hex => stored (held, "part-${index}", "${request.folder}/part-${index}", hex)

    parts (request, arrangement, mix) =
        held = foldList (toList (range (0, intDiv (satAdd (length mix.left) (satSub chunk 1)) chunk)), Written(parts = [], fault = ""), \(held, index) => written (request, arrangement, mix, held, index))
        match held.fault == ""
            true => Success(value = held.parts)
            false => Error(message = held.fault)

    // The intro at the piece's rate, then an equal-gain crossfade of `crossfade` seconds into the piece.
    crossfade arrangement = "[0:a]aresample=${arrangement.sampleRate},aformat=sample_fmts=flt:channel_layouts=stereo[intro];[intro][1:a]acrossfade=d=${arrangement.intro.crossfade}:c1=tri:c2=tri"

    joined (request, arrangement) = match arrangement.intro.recording == ""
        true => synth::Outcomes::carried (Shell::ran (60, "mv ${Shell::quoted (piecePath request)} ${Shell::quoted (songPath request)}"), \_ => Success(value = songPath request))
        false => introduced (request, arrangement)

    introduced (request, arrangement) = synth::Outcomes::carried (Shell::ran (300, "ffmpeg -v error -y -i ${Shell::located arrangement.intro.recording} -i ${Shell::quoted (piecePath request)} -filter_complex \"${crossfade arrangement}\" -c:a pcm_s24le ${Shell::quoted (songPath request)}"), \_ => Success(value = songPath request))

    // The concat list names parts relative to itself.
    assembled (request, arrangement, files) = match writeFile "${request.folder}/parts.txt" (join (mapList (files, \path => "file ${Shell::quoted path}")) "\n")
        Error why => Error(message = why)
        Success _ => synth::Outcomes::carried (Shell::ran (300, "ffmpeg -v error -y -f concat -safe 0 -i ${Shell::quoted "${request.folder}/parts.txt"} -c copy ${Shell::quoted (piecePath request)}"), \_ => delivered (request, arrangement))

    // An excerpt is the piece alone; the whole song follows its intro.
    delivered (request, arrangement) = match request.beats > 0.0
        true => Success(value = piecePath request)
        false => joined (request, arrangement)

    mixed (request, arrangement, buses) = match synth::Outcomes::carried (BusMix::mastered (arrangement, buses), \master => Arrangements::mixed (arrangement, master))
        Error why => Error(message = why)
        Success mix =>
            print "  mixed ${length mix.left} frames, peak ${mix.peak}"
            synth::Outcomes::carried (parts (request, arrangement, mix), \files => assembled (request, arrangement, files))

    (** Render the song into the request's folder; the result is the finished WAV's path. *)
    export rendered (request, arrangement) = match Arrangements::frames arrangement
        Error why => Error(message = why)
        // The held intro comes first, so a bad sustain fails before the long track renders.
        Success count => match bridged (request, arrangement, Arrangements::empty)
            Error why => Error(message = why)
            Success buses => synth::Outcomes::carried (foldList (arrangement.tracks, Success(value = buses), \(outcome, voice) => tracked (arrangement, count, outcome, voice)), \all => mixed (request, arrangement, all))

