// The shared harness: the real src modules under test-selected handlers.
// Every case installs the same outer ring the app's composition root does,
// over fixture cells — proving the use cases run with no web server
// ([EXAMPLE-CLEANARCH-BOOK-DETAILS], [EXAMPLE-CLEANARCH-INV-TESTS]).

namespace todo;


/// One what-if question for `TodoHarness::probed`.
type Question =
    WhoMayRun { request: Request }
    | WhichFixesWork { request: Request }
    | PagePlan { listId: int }

/// Request builders, one per request kind: the shape every case sends, so
/// the cases spell their data, not their plumbing.
fn newList(title, colour) = CreateList { list: NewList { title: title, colour: colour } }
fn editList(id, title, colour) = UpdateList { edit: ListEdit { id: id, title: title, colour: colour } }
fn dropList(id) = DeleteList { id: id }
fn newItem(listId, title) = CreateItem { item: NewItem { listId: listId, title: title } }
fn editItem(id, title, done) = UpdateItem { edit: ItemEdit { id: id, title: title, done: done } }
fn dropItem(id) = DeleteItem { id: id }
fn itemDetail(id, listId, priority, note) = UpdateItemDetail {
    detail: ItemDetail { id: id, listId: listId, priority: priority, note: note }
}
fn itemQuery(listId, pageNumber, pageSize) = ItemsWithPagination {
    query: ItemQuery { listId: listId, pageNumber: pageNumber, pageSize: pageSize }
}

module TodoHarness {
    /// The signed-in administrator: the role and the CanPurge policy.
    export fn admin() = Principal {
        name: "admin@example.com",
        roles: ["Administrator"],
        policies: ["CanPurge"]
    }

    /// A signed-in plain user.
    export fn user() = Principal { name: "alice@example.com", roles: ["User"], policies: [] }

    /// The anonymous request: IUser.Id == null.
    export fn anonymous() = Principal { name: "", roles: [], policies: [] }

    /// A seeded list row.
    export fn seedList(id, title, colour) = TodoList { id: id, title: title, colour: colour }

    /// A seeded item row.
    export fn seedItem(id, listId, title, done) = TodoItem {
        id: id,
        listId: listId,
        title: title,
        note: "",
        priority: LevelNone,
        done: done
    }

    /// The store with its transactions, as the composition root installs them.
    fn stored(seedLists, seedItems, work) =
        TodoHost::withStore(seedLists, seedItems, fn() => TodoReplay::withRollback(work))

    /// The quiet Log handler: the caller that wants the lines uses
    /// `witnessed` instead.
    fn quiet(work) = {
        handle Log {
            info _message => {}
            warn _message => {}
            error _message => {}
        }
        work()
    }

    /// `work` inside the whole request region: the principal, a clock that
    /// starts at 0 and steps `clockStep` per reading, and the store with its
    /// transactions — the ring the composition root installs.
    fn region(principal, clockStep, seedLists, seedItems, work) =
        TodoHost::withAuth(principal, fn() =>
            TodoHost::withClock(0, clockStep, fn() =>
                TodoReplay::asSent(fn() => stored(seedLists, seedItems, work))))

    /// One request through the whole pipeline, under the caller's Log
    /// handler: answers `{ settled, events }`.
    fn staged(principal, clockStep, seedLists, seedItems, ask) =
        region(principal, clockStep, seedLists, seedItems, fn() =>
            TodoHost::withEventReport(fn() => TodoDispatch::dispatch(ask)))

    /// `staged` with the log silenced.
    export fn request(principal, clockStep, seedLists, seedItems, ask) =
        quiet(fn() => staged(principal, clockStep, seedLists, seedItems, ask))

    /// `request` by the admin at clock step 0, the shape most cases ask in.
    export fn adminAsks(seedLists, seedItems, ask) = request(admin(), 0, seedLists, seedItems, ask)

    /// `request` with the log captured: answers `{ settled, events, lines }`.
    export fn witnessed(principal, clockStep, seedLists, seedItems, ask) = {
        mut lines = []
        handle Log {
            info message => { lines = listAppend(lines, "info: ${message}") }
            warn message => { lines = listAppend(lines, "warn: ${message}") }
            error message => { lines = listAppend(lines, "error: ${message}") }
        }
        let report = staged(principal, clockStep, seedLists, seedItems, ask)
        { settled: report.settled, events: report.events, lines: lines }
    }

    /// One route through the edge over seeded rows, as the server would answer it.
    export fn routeOver(seedLists, seedItems, principal, method, path, body) =
        quiet(fn() => region(principal, 0, seedLists, seedItems, fn() =>
            TodoHost::withEventReport(fn() => EdgeTodo::answer(method, path, body)).settled))

    /// `routeOver` an empty store.
    export fn route(principal, method, path, body) = routeOver([], [], principal, method, path, body)

    /// The probe a question names.
    fn asked(question) = match question {
        WhoMayRun { request } => TodoProbe::whoMayRun(request)
        WhichFixesWork { request } => TodoProbe::whichFixesWork(request)
        PagePlan { listId } => TodoProbe::pagePlan(listId)
    }

    /// A what-if question over the pipeline: its probe answers one of the
    /// app's `many` operations itself, so it resumes the same request several
    /// times. Answers `{ answers, events, readings, lists, items }`; the
    /// clock advances one per reading, so `readings` counts every reading
    /// made before this one.
    export fn probed(principal, seedLists, seedItems, question) =
        quiet(fn() => region(principal, 1, seedLists, seedItems, fn() => {
            let report = TodoHost::withEventReport(fn() => asked(question))
            {
                answers: report.settled,
                events: report.events,
                readings: perform Clock.nowMs(),
                lists: perform Store.lists(),
                items: perform Store.items()
            }
        }))

    /// One request sent while each of `rivals` commits first: every queued
    /// rival wins one attempt's commit, so the transaction handler resumes
    /// the request again. Answers `{ settled, events, readings, lists, items }`.
    export fn contested(rivals, seedLists, seedItems, ask) =
        quiet(fn() => TodoHost::withClock(0, 1, fn() =>
            stored(seedLists, seedItems, fn() => {
                forEachList(rivals, fn(title) => perform Rollback.rival(title))
                let report = TodoHost::withAuth(admin(), fn() =>
                    TodoReplay::asSent(fn() => TodoHost::withEventReport(fn() => TodoDispatch::dispatch(ask))))
                {
                    settled: report.settled,
                    events: report.events,
                    readings: perform Clock.nowMs(),
                    lists: perform Store.lists(),
                    items: perform Store.items()
                }
            })))

    /// The stored rows after `ask` ran, read inside the store's region:
    /// answers `{ settled, events, lists, items }`.
    export fn rowsAfter(principal, clockStep, seedLists, seedItems, ask) =
        quiet(fn() => region(principal, clockStep, seedLists, seedItems, fn() => {
            let report = TodoHost::withEventReport(fn() => TodoDispatch::dispatch(ask))
            {
                settled: report.settled,
                events: report.events,
                lists: perform Store.lists(),
                items: perform Store.items()
            }
        }))

    /// The checks that failed, each as `label #position`: empty when every one
    /// holds. `checkAll` takes only a list literal, so a computed list of checks
    /// is asserted as `expect(TodoHarness::failures(label, checks), [])`.
    export fn failures(label, checks) = foldList(checks, { at: 0, failed: [] }, fn(walk, holds) => match holds {
        true => { at: satAdd(walk.at, 1), failed: walk.failed }
        false => { at: satAdd(walk.at, 1), failed: listAppend(walk.failed, "${label} #${toString(walk.at)}") }
    }).failed
}
