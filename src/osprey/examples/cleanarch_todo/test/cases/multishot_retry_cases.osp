// The retry transaction, asserted thickly ([EXAMPLE-CLEANARCH-MULTISHOT-RETRY],
// [MULTI-REPLAY]): every command kind crossed with rival counts, duplicate rival
// titles asserting the queue's FIFO order (each queued rival wins exactly one
// commit), stores seeded to several sizes so new ids shift, and the exact
// conflict text with its versions ([FAILURE-EXPLICIT]).
//
// Derivation: `contested` queues the rivals, then sends once as the
// administrator. A lost commit restores the attempt's opening rows, saves the
// rival list under the next list id, bumps the store version and fails with
// "attempt N: store changed under transaction at V, now V+1"; the transaction
// handler then resumes the SAME request from Tx.begin, at most three attempts.
// `dispatch` reads the clock once before and once after the whole transaction
// whatever the attempt count, and the report's own reading is the third, so
// readings == 3 for every run here ([MULTI-HANDLE-MANY]).

namespace todo;

/// The CreateList ask naming a list "Mine": the request every retry case replays.
fn mineListAsk() = newList("Mine", "")

/// A single rival queued to steal one commit.
let loneRival = ["Rival"]

/// Two generic rivals queued to steal two commits.
let twoRivals = ["X", "Y"]

/// Three generic rivals queued to steal three commits.
let threeRivals = ["X", "Y", "Z"]

/// The first two of the named rivals, in queue order.
let twoNamedRivals = ["Rival", "Other"]

/// Three distinct named rivals, in queue order.
let namedRivals = ["Rival", "Other", "Third"]

/// The titles of the two seeded lists, in id order.
let seedTitles = ["Shopping", "Banking"]

/// The stored titles once three rivals have landed on the seeds, in id order.
let titlesAfterThreeRivals = ["Shopping", "Banking", "X", "Y", "Z"]

/// Rivals alternating "A" and "B", in queue order.
let alternatingRivals = ["A", "B", "A"]

/// The fault a colliding title answers, as faults() expects it.
let uniqueTitleFault = ["'Title' must be unique."]

/// The stored row ids after two rows exist.
let firstTwoIds = [1, 2]

/// The stored row ids after three rows exist.
let firstThreeIds = [1, 2, 3]

/// All five stored row ids once five lists have landed.
let idsOneToFive = [1, 2, 3, 4, 5]

/// Two seeded lists, ids 1 and 2: Shopping grey, Banking purple.
fn retryLists() = authzTwoLists()

/// Three seeded items, ids 1-3: Milk and Bread in list 1, Tax in list 2.
fn retryItems() = authzThreeItems()

/// Five lists titled "L1".."L5", so new list ids start at 6.
fn retryFiveLists() = mapList(range(1, 6) |> toList, fn(i) =>
    TodoHarness::seedList(i, "L" + toString(i), "#78909C"))

/// Four items "T1".."T4" in list 1, so new item ids start at 5.
fn retryFourItems() = mapList(range(1, 5) |> toList, fn(i) =>
    TodoHarness::seedItem(i, 1, "T" + toString(i), false))

/// Seven items "T1".."T7" in list 1, titled so title order is id order.
fn retrySevenItems() = mapList(range(1, 8) |> toList, fn(i) =>
    TodoHarness::seedItem(i, 1, "T" + toString(i), false))

/// The stored list titles, ids and colours, and item ids, in stored order.
fn retryIds(lists) = mapList(lists, fn(list) => list.id)
fn retryColours(lists) = mapList(lists, fn(list) => list.colour)
fn retryItemIds(items) = mapList(items, fn(item) => item.id)

/// A run's stored list titles / ids / colours and item ids, in stored order.
fn retryTitlesAre(run, titles) = structuralEquals(authzTitlesOf(run.lists), titles)
fn retryIdsAre(run, ids) = structuralEquals(retryIds(run.lists), ids)

/// A run's stored titles and ids together, in stored order.
fn retryStoredAs(run, titles, ids) = retryTitlesAre(run, titles) && retryIdsAre(run, ids)
fn retryColoursAre(run, colours) = structuralEquals(retryColours(run.lists), colours)
fn retryItemIdsAre(run, ids) = structuralEquals(retryItemIds(run.items), ids)

/// A contested `ask` over the two seeded lists and `items`.
fn retryAsked(rivals, items, ask) = TodoHarness::contested(rivals, retryLists(), items, ask)

/// A contested `ask` over an empty store.
fn retryBareAsked(rivals, ask) = TodoHarness::contested(rivals, [], [], ask)

/// The conflict text an exhausted retry answers, with its exact versions.
fn retryThird() = "attempt 3: store changed under transaction at 3, now 4"

/// `run` gave up with the attempt-3 conflict.
fn retryExpectGaveUp(run) = expect(retryWhy(run.settled), retryThird())

/// Each of `runs` read the clock exactly three times ([MULTI-HANDLE-MANY]).
fn retryReadsThree(runs) = mapList(runs, fn(run) => run.readings == 3)

/// Each of `runs` published no event.
fn retryQuiet(runs) = mapList(runs, noEvents)

/// Each of `runs` took the three readings and published no event ([MULTI-HANDLE-MANY]).
fn retryCalm(runs) = listConcat(retryReadsThree(runs), retryQuiet(runs))

/// `run` settled as a plain Updated.
fn retryExpectUpdated(run) = expect(run.settled, updatedOk())

/// `run` refused an empty title.
fn retryExpectEmptyTitle(run) = expect(run.settled, faults(["'Title' must not be empty."]))

/// `run` refused an over-long title.
fn retryExpectTooLong(run) = expect(run.settled, faults(["'Title' must be at most 200 characters."]))

/// `run` answered the typed NotFound for `kind` `id`.
fn retryExpectMissing(run, kind, id) = expect(run.settled, missingRow(kind, id))

/// The run's items are exactly the three seeded items.
fn retryItemsKept(run) = structuralEquals(run.items, retryItems())
/// How many of `titles` equal `title`.
fn retryCount(titles, title) = length(filterList(titles, fn(each) => each == title))

/// Exactly `n` of `run`'s stored titles equal `title`.
fn retryHasTitles(run, title, n) = retryCount(authzTitlesOf(run.lists), title) == n

/// Whether item `id` is stored done.
fn retryDoneOf(items, id) = foldList(items, false, fn(found, item) =>
    found || (item.id == id && item.done))

/// The conflict's explanation, or "" for any other outcome.
fn retryWhy(outcome) = match outcome {
    Error { message: Conflict { why } } => why
    _ => ""
}

/// A title of `size` `fill` characters.
fn retryWideTitle(size, fill) = foldList(range(0, size) |> toList, "", fn(built, _i) => built + fill)

/// A title of `size` x characters.
fn retryWide(size) = retryWideTitle(size, "x")

/// One item as every query reports it.
fn retryRow(id, title) = ItemView { id: id, title: title, done: false, priority: "None", note: "" }

/// The lookups and colour choices every TodosView carries.
fn retryLookups() = [
    Lookup { id: 0, name: "None" }, Lookup { id: 1, name: "Low" },
    Lookup { id: 2, name: "Medium" }, Lookup { id: 3, name: "High" }
]

fn retryColourChoices() = [
    ColourChoice { code: "#E05C4D", name: "Red" }, ColourChoice { code: "#D98B2B", name: "Orange" },
    ColourChoice { code: "#4CAF50", name: "Green" }, ColourChoice { code: "#26A69A", name: "Teal" },
    ColourChoice { code: "#5C6BC0", name: "Blue" }, ColourChoice { code: "#AB47BC", name: "Purple" },
    ColourChoice { code: "#78909C", name: "Grey" }
]

/// A TodosView over the given lists.
fn retryTodosView(lists) = TodosView { priorities: retryLookups(), colours: retryColourChoices(), lists: lists }

module MultishotRetryCases {
    /// 0..5 rivals against one CreateList: each of the first k ≤ 2 rivals
    /// burns one attempt (landing as ids 1..k) and the next lands "Mine" as
    /// id k+1; k ≥ 3 exhausts the attempts, only the first three rivals are
    /// saved, and attempt 3's conflict answers; readings stay 3 because
    /// retries resume after the start reading.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY].
    export fn retryRivalCountsCase() = {
        let ask = mineListAsk()
        let none = retryBareAsked([], ask)
        let one = retryBareAsked(loneRival, ask)
        let two = retryBareAsked(twoNamedRivals, ask)
        let three = retryBareAsked(namedRivals, ask)
        let four = retryBareAsked(["Rival", "Other", "Third", "Fourth"], ask)
        let five = retryBareAsked(["Rival", "Other", "Third", "Fourth", "Fifth"], ask)
        expect(none.settled, createdId(1))
        expect(one.settled, createdId(2))
        expect(two.settled, createdId(3))
        forEachList([three, four, five], fn(run) => retryExpectGaveUp(run))
        expect(TodoHarness::failures("each lost commit burns one id and lands one rival; three attempts at most", listConcat([
            retryStoredAs(none, ["Mine"], [1]),
            retryStoredAs(one, ["Rival", "Mine"], firstTwoIds),
            retryStoredAs(two, ["Rival", "Other", "Mine"], firstThreeIds),
            retryStoredAs(three, namedRivals, firstThreeIds),
            retryStoredAs(four, namedRivals, firstThreeIds),
            retryStoredAs(five, namedRivals, firstThreeIds),
            retryColoursAre(one, ["#78909C", "#78909C"]),
            retryColoursAre(three, ["#78909C", "#78909C", "#78909C"]),
            length(none.items) == 0, length(two.items) == 0
        ], listConcat(retryQuiet([none, three, five]),
            retryReadsThree([none, one, two, three, four, five])))), [])
    }

    /// Duplicate rival titles: the queue is FIFO, so EACH queued rival wins
    /// exactly one commit — ["Rival","Rival"] burns attempts 1 and 2 and
    /// "Mine" lands as id 3, and three duplicates exhaust the attempts with
    /// attempt 3's conflict; versions climb 1→2→3→4 whatever the titles.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY], [MULTI-HANDLE-MANY].
    export fn retryDuplicateRivalsCase() = {
        let ask = mineListAsk()
        let pair = retryBareAsked(["Rival", "Rival"], ask)
        let twoDup = retryBareAsked(["A", "A"], ask)
        let triple = retryBareAsked(["A", "A", "A"], ask)
        let mixed = retryBareAsked(alternatingRivals, ask)
        let fourDup = retryBareAsked(["A", "B", "A", "B"], ask)
        expect(pair.settled, createdId(3))
        expect(twoDup.settled, createdId(3))
        forEachList([triple, mixed, fourDup], fn(run) => retryExpectGaveUp(run))
        expect(TodoHarness::failures("every queued rival wins one commit and lands once, in queue order", listConcat([
            retryStoredAs(pair, ["Rival", "Rival", "Mine"], firstThreeIds),
            retryHasTitles(pair, "Rival", 2), length(pair.lists) == 3,
            retryTitlesAre(twoDup, ["A", "A", "Mine"]), retryHasTitles(twoDup, "A", 2),
            retryStoredAs(triple, ["A", "A", "A"], firstThreeIds),
            retryHasTitles(triple, "A", 3),
            retryStoredAs(mixed, alternatingRivals, firstThreeIds),
            retryHasTitles(mixed, "A", 2), retryHasTitles(mixed, "B", 1),
            retryTitlesAre(fourDup, alternatingRivals),
            retryHasTitles(fourDup, "A", 2), retryHasTitles(fourDup, "B", 1),
            noEvents(pair), noEvents(triple),
            noEvents(mixed), noEvents(fourDup)
        ], retryReadsThree([pair, twoDup, triple, mixed, fourDup]))), [])
    }

    /// Validation re-runs on every fresh snapshot: a rival named like the
    /// request makes attempt 2's uniqueness check fail after that rival
    /// landed as id 3, while a request that fails validation never reaches
    /// its commit, so no rival is consumed; a whitespace-only title is valid
    /// as sent (only "" is empty) and stores verbatim.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY],
    /// [EXAMPLE-CLEANARCH-INV-FAITHFUL].
    export fn retryCreateListValidationCase() = {
        let ask = mineListAsk()
        let rival = retryAsked(["Mine"], [], ask)
        let twinRivals = retryAsked(["Mine", "Mine"], [], ask)
        let badColour = retryAsked(loneRival, [], newList("Fresh", "#HotPink"))
        let spaces = retryAsked(loneRival, [], newList("   ", ""))
        let tooLong = retryAsked(twoNamedRivals, [], newList(retryWide(201), ""))
        let empty = retryAsked(loneRival, [], newList("", ""))
        expect(rival.settled, faults(uniqueTitleFault))
        expect(twinRivals.settled, faults(uniqueTitleFault))
        expect(badColour.settled, Error { message: ValidationFault {
            problems: ["UnsupportedColour: '#HotPink' is not a supported colour"] } })
        expect(spaces.settled, createdId(4))
        retryExpectTooLong(tooLong)
        expect(empty.settled, Error { message: ValidationFault {
            problems: ["'Title' must not be empty."] } })
        let refused = [badColour, tooLong, empty]
        expect(TodoHarness::failures("the landed rival collides on the retry; a refused attempt burns no rival", listConcat([
            retryStoredAs(rival, ["Shopping", "Banking", "Mine"], firstThreeIds),
            retryTitlesAre(twinRivals, ["Shopping", "Banking", "Mine"]), retryHasTitles(twinRivals, "Mine", 1),
            retryStoredAs(badColour, seedTitles, firstTwoIds),
            length(badColour.lists) == 2,
            retryTitlesAre(tooLong, seedTitles),
            retryTitlesAre(empty, seedTitles),
            retryTitlesAre(spaces, ["Shopping", "Banking", "Rival", "   "]),
            retryIdsAre(spaces, [1, 2, 3, 4]),
            retryColoursAre(rival, ["#78909C", "#AB47BC", "#78909C"])
        ], retryCalm(listConcat([rival, twinRivals, spaces], refused)))), [])
    }

    /// UpdateList re-lands after every lost commit: the edited row re-saves
    /// at the store's end, blank colour keeps the list's own, and a rival
    /// named like the new title fails attempt 2's uniqueness check; a
    /// missing list answers NotFound before any commit, burning no rival.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY].
    export fn retryUpdateListCase() = {
        let ask = editList(1, "Chores", "")
        let calm = retryAsked([], retryItems(), ask)
        let twice = retryAsked(twoRivals, retryItems(), ask)
        let lost = retryAsked(threeRivals, retryItems(), ask)
        let collide = retryAsked(["Chores"], retryItems(), ask)
        let missing = retryAsked(twoRivals, retryItems(), editList(9, "Ninth", ""))
        let recolour = retryAsked(loneRival, retryItems(), editList(2, "Banking", "#4CAF50"))
        retryExpectUpdated(calm)
        retryExpectUpdated(twice)
        retryExpectGaveUp(lost)
        expect(collide.settled, faults(uniqueTitleFault))
        retryExpectMissing(missing, "TodoList", 9)
        retryExpectUpdated(recolour)
        let landed = [calm, twice, collide, recolour]
        expect(TodoHarness::failures("the edit re-lands after the rivals; a refused attempt burns none", listConcat([
            retryStoredAs(calm, ["Banking", "Chores"], [2, 1]),
            retryColoursAre(calm, ["#AB47BC", "#78909C"]),
            retryStoredAs(twice, ["Banking", "X", "Y", "Chores"], [2, 3, 4, 1]),
            retryStoredAs(lost, titlesAfterThreeRivals, idsOneToFive),
            retryStoredAs(collide, ["Shopping", "Banking", "Chores"], firstThreeIds),
            retryTitlesAre(missing, seedTitles),
            retryStoredAs(recolour, ["Shopping", "Rival", "Banking"], [1, 3, 2]),
            retryColoursAre(recolour, ["#78909C", "#78909C", "#4CAF50"])
        ], retryCalm(listConcat(landed, [lost, missing])))), [])
    }

    /// DeleteList: every lost commit restores the list and its cascaded
    /// items, and only the committing attempt deletes; three rivals keep the
    /// seeds and every item; a missing list refuses before any commit.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY].
    export fn retryDeleteListCase() = {
        let calm = retryAsked([], retryItems(), dropList(1))
        let one = retryAsked(loneRival, retryItems(), dropList(2))
        let twice = retryAsked(twoRivals, retryItems(), dropList(1))
        let lost = retryAsked(threeRivals, retryItems(), dropList(1))
        let missing = retryAsked(threeRivals, retryItems(), dropList(9))
        retryExpectUpdated(calm)
        retryExpectUpdated(one)
        retryExpectUpdated(twice)
        retryExpectGaveUp(lost)
        retryExpectMissing(missing, "TodoList", 9)
        expect(TodoHarness::failures("each lost commit restores the cascade; only the committing attempt deletes", listConcat([
            retryStoredAs(calm, ["Banking"], [2]), retryItemIdsAre(calm, [3]),
            retryStoredAs(one, ["Shopping", "Rival"], [1, 3]), retryItemIdsAre(one, firstTwoIds),
            retryStoredAs(twice, ["Banking", "X", "Y"], [2, 3, 4]),
            retryItemIdsAre(twice, [3]),
            retryStoredAs(lost, titlesAfterThreeRivals, idsOneToFive),
            retryItemIdsAre(lost, firstThreeIds), retryItemsKept(lost),
            retryTitlesAre(missing, seedTitles), retryItemIdsAre(missing, firstThreeIds)
        ], retryCalm([calm, one, twice, lost, missing]))), [])
    }

    /// PurgeTodoLists as the administrator: the count is the rows the
    /// committing attempt reads, so landed rivals count, and the purge
    /// clears lists and items together; three or more rivals keep
    /// everything and only the first three rivals ever land.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY].
    export fn retryPurgeCase() = {
        let calm = retryAsked([], retryItems(), PurgeTodoLists)
        let twice = retryAsked(twoRivals, retryItems(), PurgeTodoLists)
        let lost = retryAsked(threeRivals, retryItems(), PurgeTodoLists)
        let five = retryAsked(["X", "Y", "Z", "Fourth", "Fifth"], retryItems(), PurgeTodoLists)
        expect(calm.settled, purgedCount(2))
        expect(twice.settled, purgedCount(4))
        forEachList([lost, five], fn(run) => retryExpectGaveUp(run))
        expect(TodoHarness::failures("the committing attempt purges seeds and landed rivals together", listConcat([
            length(calm.lists) == 0, length(calm.items) == 0,
            length(twice.lists) == 0, length(twice.items) == 0,
            retryStoredAs(lost, titlesAfterThreeRivals, idsOneToFive),
            length(lost.lists) == 5, length(lost.items) == 3, retryItemIdsAre(lost, firstThreeIds),
            retryStoredAs(five, titlesAfterThreeRivals, idsOneToFive),
            length(five.lists) == 5, length(five.items) == 3, retryItemIdsAre(five, firstThreeIds),
            retryHasTitles(five, "Fourth", 0), retryHasTitles(five, "Fifth", 0),
            retryHasTitles(lost, "X", 1), retryHasTitles(lost, "Y", 1), retryHasTitles(lost, "Z", 1)
        ], retryCalm([calm, twice, lost, five]))), [])
    }

    /// A false→true completion under 0..5 rivals: each lost attempt's event
    /// is rewound and the committing attempt publishes exactly once; three
    /// or more lost attempts publish nothing and leave every item seeded.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY], [MULTI-HANDLE-MANY].
    export fn retryCompleteItemCase() = {
        let ask = editItem(1, "Milk", true)
        let seeds = retryItems()
        let none = retryAsked([], seeds, ask)
        let one = retryAsked(loneRival, seeds, ask)
        let two = retryAsked(twoNamedRivals, seeds, ask)
        let bread = retryAsked(loneRival, seeds, editItem(2, "Bread", true))
        retryExpectUpdated(none)
        retryExpectUpdated(one)
        retryExpectUpdated(two)
        retryExpectUpdated(bread)
        let three = retryAsked(namedRivals, seeds, ask)
        let four = retryAsked(["Rival", "Other", "Third", "Fourth"], seeds, ask)
        let five = retryAsked(["Rival", "Other", "Third", "Fourth", "Fifth"], seeds, ask)
        forEachList([three, four, five], fn(run) => retryExpectGaveUp(run))
        expect(two.events, [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }])
        expect(bread.events, [TodoItemCompleted { itemId: 2, listId: 1, title: "Bread" }])
        let exhausted = [three, four, five]
        expect(TodoHarness::failures("the flip publishes exactly once, and never when every attempt loses", listConcat([
            retryDoneOf(none.items, 1), retryDoneOf(one.items, 1), retryDoneOf(two.items, 1),
            retryDoneOf(bread.items, 2), !retryDoneOf(bread.items, 1),
            !retryDoneOf(three.items, 1), !retryDoneOf(four.items, 1), !retryDoneOf(five.items, 1),
            length(none.events) == 1, length(one.events) == 1, length(two.events) == 1,
            length(bread.events) == 1,
            structuralEquals(three.items, seeds), structuralEquals(five.items, seeds),
            retryItemIdsAre(two, [2, 3, 1]),
            retryTitlesAre(five, ["Shopping", "Banking", "Rival", "Other", "Third"]),
            retryIdsAre(five, idsOneToFive), length(five.lists) == 5
        ], listConcat(retryQuiet(exhausted),
            retryReadsThree(listConcat([none, one, two, bread], exhausted))))), [])
    }

    /// Updates that never flip: a done item kept done, a done item undone,
    /// and a renaming under three rivals — no event is ever published, the
    /// lost attempts leave the seeds exactly, and a refusal (missing item,
    /// empty or over-long title) burns no rival.
    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY], [MULTI-REPLAY].
    export fn retryUpdateItemWithoutFlipCase() = {
        let doneSeeds = [
            TodoHarness::seedItem(1, 1, "Milk", true),
            TodoHarness::seedItem(2, 1, "Bread", false),
            TodoHarness::seedItem(3, 2, "Tax", false)
        ]
        let keep = retryAsked(twoRivals, doneSeeds, editItem(1, "Milk", true))
        let undo = retryAsked(twoRivals, doneSeeds, editItem(1, "Milk", false))
        let rename = retryAsked(threeRivals, retryItems(), editItem(1, "Oat Milk", false))
        let missing = retryAsked(twoRivals, retryItems(), editItem(9, "Ninth", false))
        let empty = retryAsked(loneRival, retryItems(), editItem(1, "", false))
        let long = retryAsked([], retryItems(), editItem(3, retryWide(201), false))
        retryExpectUpdated(keep)
        retryExpectUpdated(undo)
        retryExpectGaveUp(rename)
        retryExpectMissing(missing, "TodoItem", 9)
        retryExpectEmptyTitle(empty)
        retryExpectTooLong(long)
        expect(TodoHarness::failures("no flip, no event; refused attempts burn no rival and keep the seeds", listConcat([
            retryDoneOf(keep.items, 1), !retryDoneOf(undo.items, 1),
            retryItemsKept(rename), retryItemsKept(missing),
            retryItemsKept(empty), retryItemsKept(long),
            retryStoredAs(missing, seedTitles, firstTwoIds),
            retryTitlesAre(empty, seedTitles),
            retryItemIdsAre(keep, [2, 3, 1]), length(keep.items) == 3, length(undo.items) == 3
        ], retryCalm([keep, undo, rename, missing, empty, long]))), [])
    }
}
