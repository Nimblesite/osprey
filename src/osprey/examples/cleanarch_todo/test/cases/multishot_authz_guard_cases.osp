// Authorization what-if over pages, the purge rules and the starting principal ([EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]).
// The fixtures and helpers are the ones at the top of `multishot_authz_cases.osp`
// and `fixtures.osp`.

namespace todo;

import todo::TodoDomain
import todo::TodoHarness
import todo::TodoProbe

/// The refusal triple every guarded request answers: Unauthorized, "not in
/// role", then the administrator's own answer.
fn guardLadder(adminAnswer) = [unauthorized(), denied("not in role"), adminAnswer]

module MultishotAuthzGuardCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]:
    /// ItemsWithPagination has no rule, so all three branches answer the same
    /// page: title-ordered rows, the list's total, `hasPrevious` = page > 1
    /// and `hasNext` = page*size < total over seven A-G items.
    export fn whoMayPaginateCase() = {
        let seeds = sevenItems()
        // page 1 of 5 = A-E with hasNext (5 < 7); page 2 of 5 = F,G with hasPrevious; 10 or 50 per page = all
        // seven, hasNext false in both.
        authzPagesHold("four page shapes x three branches: reads store nothing, publish nothing [MULTI-REPLAY]", [
            { ask: authzAsAnonymous, list: 1, page: 1, size: 5 }, { ask: authzAsUser, list: 1, page: 2, size: 5 },
            { ask: authzAsAdmin, list: 1, page: 1, size: 10 }, { ask: authzAsAnonymous, list: 1, page: 1, size: 50 }
        ], fn(report) => structuralEquals(report.lists, twoLists()) && length(report.answers) == 3)
        let empty = authzAsAdmin(twoLists(), seeds, query(2, 1, 5))
        // List 2 holds no items: every branch answers an empty page, totalCount 0, hasPrevious false, hasNext false.
        authzAllAnswers(empty, authzPageView(2, seeds, 1, 5))
        checkAll("an empty list plans the same empty page three times", [
            empty.readings == 7, length(empty.events) == 0, length(empty.items) == 7
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: pagination edges
    /// from one store: a middle page, the last row alone, a missing list id
    /// and an empty list asked from page 3 — every branch answers the same
    /// view, and a missing list id is an empty page, never a NotFound.
    export fn whoMayPaginateEdgesCase() = {
        let seeds = sevenItems()
        // p2 s2 = C,D (hasNext, 4 < 7); p4 s2 = G alone (hasNext false, 8 >= 7); a missing list id is an empty
        // page; page 3 of an empty list keeps hasPrevious true.
        authzPagesHold("four edges x three branches: same page for every principal [MULTI-HANDLE-MANY]", [
            { ask: authzAsAnonymous, list: 1, page: 2, size: 2 }, { ask: authzAsUser, list: 1, page: 4, size: 2 },
            { ask: authzAsAdmin, list: 99, page: 1, size: 5 }, { ask: authzAsAnonymous, list: 2, page: 3, size: 3 }
        ], fn(report) => structuralEquals(authzBranchTexts(report), ["page view", "page view", "page view"]))
        let starts = authzFromEachStart(twoLists(), seeds, query(1, 2, 2))
        expect(TodoHarness::failures("the start principal changes nothing", authzStartsAgree(starts)), [])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: PurgeTodoLists
    /// answers how many lists went: 0, 1, 2 and 5 seeds answer exactly that
    /// count in the administrator branch only, and the drop is undone.
    export fn whoMayPurgeCountsCase() = {
        let bare = authzAsAnonymous([], [], PurgeTodoLists)
        let solo = authzAsUser(authzOneList(), [], PurgeTodoLists)
        let pair = authzAdmin(PurgeTodoLists)
        let five = authzAsAnonymous(authzFiveLists(), [], PurgeTodoLists)
        // Anonymous breaks sign-in first, the user breaks the Administrator role, and the administrator purges
        // exactly length(lists) lists: 0, 1, 2 and 5.
        expect(bare.answers, guardLadder(purged(0)))
        expect(solo.answers, guardLadder(purged(1)))
        expect(pair.answers, guardLadder(purged(2)))
        expect(five.answers, guardLadder(purged(5)))
        checkAll("four store sizes: rows equal the seeds after every probe [MULTI-REPLAY]", [
            authzReadsEveryBranch([bare, solo, pair, five]),
            authzThree([bare, pair]), length(five.items) == 0,
            structuralEquals(bare.lists, []),
            structuralEquals(titlesOf(solo.lists), ["Solo"]),
            structuralEquals(pair.lists, twoLists()),
            structuralEquals(pair.items, threeItems()),
            structuralEquals(titlesOf(five.lists), ["City1", "City2", "City3", "City4", "City5"]),
            authzNoEvents([bare, solo, pair, five])
        ])
        let starts = authzStarts(PurgeTodoLists)
        checkAll("the start principal changes nothing", [authzStarted(starts),
            authzEvery(starts, fn(report) => structuralEquals(report.items, threeItems()))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: the purge rules
    /// fire in order — sign-in, then the Administrator role, then CanPurge —
    /// so each branch's answer names the first broken rule, and a second run
    /// from another start answers the same three branches: resumption is
    /// deterministic ([MULTI-HANDLE-MANY]).
    export fn whoMayPurgeRuleLadderCase() = {
        let probe = authzUser(PurgeTodoLists)
        // Exact denials: Unauthorized for the anonymous branch, "not in role" for the user branch (role is
        // broken before policy is ever consulted), Purged 2 for the administrator branch.
        expect(probe.answers, guardLadder(purged(2)))
        let again = authzAdmin(PurgeTodoLists)
        // The same question from another start principal: the identical three answers, branch for branch.
        expect(again.answers, probe.answers)
        let five = authzAsAnonymous(authzFiveLists(), [], PurgeTodoLists)
        // The ladder is store-independent: only the count follows the seeds.
        expect(five.answers, guardLadder(purged(5)))
        checkAll("three runs: exact branch texts, rows restored, events empty [MULTI-REPLAY]", [
            authzReadsEveryBranch([probe, again, five]),
            authzThree([probe, again, five]),
            authzKeeps([probe, again], twoLists(), threeItems()),
            structuralEquals(five.items, []),
            structuralEquals(titlesOf(five.lists), ["City1", "City2", "City3", "City4", "City5"]),
            authzNoEvents([probe, again, five]),
            structuralEquals(authzBranchTexts(probe), ["unauthorized", "forbidden not in role", "purged 2"]),
            structuralEquals(authzBranchTexts(five), ["unauthorized", "forbidden not in role", "purged 5"])
        ])
        let starts = authzStarts(PurgeTodoLists)
        expect(TodoHarness::failures("every start principal reports the same refusal-and-purge triple", listConcat(authzStartsAgree(starts), [
            authzEvery(starts, fn(report) => structuralEquals(report.lists, twoLists()))
        ])), [])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-HANDLE-MANY], [MULTI-REPLAY]:
    /// every request without an access rule runs in all three branches: eight
    /// different request kinds, each answering three identical successes from
    /// an anonymous start, with rows restored and events empty.
    export fn whoMayUnguardedRequestsCase() = {
        checkAll("the catalogue holds the eight rule-free requests for three branch principals", [
            length(authzUnguardedRequests()) == 8,
            length(TodoProbe::principals()) == 3
        ])
        forEachList(authzUnguardedRequests(), fn(ask) => {
            let probe = authzAnon(ask)
            // No rule, no denial: all three branches succeed and answer identically however the request mutates the store.
            checkAll("a rule-free request runs and answers identically in all three branches [MULTI-HANDLE-MANY]", [
                length(probe.answers) == 3,
                match probe.answers { [Success _, Success _, Success _] => true _ => false },
                match authzBranchTexts(probe) { [one, two, three] => one == two && two == three _ => false },
                probe.readings == 7,
                structuralEquals(probe.lists, twoLists()),
                structuralEquals(probe.items, threeItems()),
                length(probe.events) == 0
            ])
        })
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: only GetTodos and
    /// PurgeTodoLists carry rules; from an anonymous start each still answers
    /// three branch answers — refused exactly where the branch's own principal
    /// lacks sign-in or the role.
    export fn whoMayGuardedRequestsCase() = {
        let reads = authzAnon(GetTodos)
        let view = authzGetTodosView(twoLists(), threeItems())
        // MustSignIn alone: the anonymous branch refuses, user and administrator branches read the identical view.
        expect(reads.answers, [unauthorized(), Success { value: view }, Success { value: view }])
        let purge = authzAnon(PurgeTodoLists)
        // The full ladder: Unauthorized, then "not in role", then the purge of two lists.
        expect(purge.answers, guardLadder(purged(2)))
        checkAll("the two guarded requests, three branches each [MULTI-HANDLE-MANY]", [
            authzReadsEveryBranch([reads, purge]),
            authzThree([reads, purge]),
            length(reads.items) == 3, length(purge.items) == 3,
            authzKeeps([reads, purge], twoLists(), threeItems()),
            authzNoEvents([reads, purge]),
            structuralEquals(authzBranchTexts(reads), ["unauthorized", "todos view", "todos view"]),
            structuralEquals(authzBranchTexts(purge), ["unauthorized", "forbidden not in role", "purged 2"]),
            match reads.answers { [_, Success { value: mine }, Success { value: root }] => structuralEquals(mine, root) _ => false }
        ])
        let readStarts = authzStarts(GetTodos)
        let purgeStarts = authzStarts(PurgeTodoLists)
        checkAll("the start principal changes neither guarded answer", [authzStarted(readStarts), authzStarted(purgeStarts),
            authzEvery(readStarts, fn(report) => structuralEquals(report.items, threeItems())),
            authzEvery(purgeStarts, fn(report) => structuralEquals(report.lists, twoLists()))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-HANDLE-MANY], [MULTI-REPLAY]:
    /// the start principal is inert — `whoMayRun` handles `Auth.who` itself —
    /// so every question reports the same three answers, readings, rows and
    /// events whether the run started anonymous, as user or as administrator.
    export fn whoMayStartPrincipalCase() = {
        let reads = authzStarts(GetTodos)
        let creates = authzStarts(newList("Travel", "#AB47BC"))
        let purges = authzStarts(PurgeTodoLists)
        checkAll("GetTodos: the same refusal-and-view triple from every start",
            [authzStarted(reads), authzKeeps(reads, twoLists(), threeItems())])
        checkAll("CreateList: the same new id 3 from every start", [authzStarted(creates),
            authzEvery(creates, fn(report) => structuralEquals(authzBranchTexts(report), ["created 3", "created 3", "created 3"]) && structuralEquals(report.items, threeItems()))
        ])
        checkAll("PurgeTodoLists: the same unauthorized, forbidden, purge-2 triple from every start", [authzStarted(purges),
            authzEvery(purges, fn(report) => structuralEquals(authzBranchTexts(report), ["unauthorized", "forbidden not in role", "purged 2"]) && structuralEquals(report.lists, twoLists()))
        ])
        let first = authzAnon(newItem(1, "Dentist"))
        let second = authzUser(newItem(1, "Dentist"))
        let third = authzAdmin(newItem(1, "Dentist"))
        // The three branch answers are identical across all three start principals, item id 4 each time.
        authzAllAnswers(first, created(4))
        authzAllAnswers(second, created(4))
        authzAllAnswers(third, created(4))
        checkAll("three explicit starts agree branch for branch", [
            authzReadsEveryBranch([first, second, third]),
            structuralEquals(authzBranchTexts(first), authzBranchTexts(second)),
            structuralEquals(authzBranchTexts(second), authzBranchTexts(third)),
            length(TodoProbe::principals()) == 3,
            structuralEquals(mapList(TodoProbe::principals(), fn(who) => who.name), ["", "alice@example.com", "admin@example.com"])
        ])
    }
}
