// Authorization what-if ([EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ]): every request
// kind sent once through `TodoProbe::whoMayRun`, which resumes the SAME
// captured continuation as the anonymous party, a user and the administrator
// ([MULTI-HANDLE-MANY]). Each branch's writes and events are undone before the
// next branch ([MULTI-REPLAY]), so after any probe the rows equal the seeds,
// `events` is empty, and every branch saw the same store version and ids.
// `Auth.who` is `dispatch`'s first perform, so each branch re-runs the whole
// request: 2 clock readings per branch, 3 branches, + the report's own = 7.

namespace todo;

import todo::TodoDomain
import todo::TodoHarness
import todo::TodoItems
import todo::TodoProbe

/// One seeded list, id 1: `nextList` starts at 2.
fn authzOneList() = [TodoHarness::seedList(1, "Solo", "#4CAF50")]

/// Five seeded lists, ids 1-5: purge must answer 5.
fn authzFiveLists() = mapList(range(1, 6) |> toList, fn(id) =>
    TodoHarness::seedList(id, "City${toString(id)}", "#4CAF50"))

/// One list's rows in title order: the order every page and view reports.
fn authzRows(listId, items) = listSortBy(filterList(items, fn(item) => item.listId == listId), TodoDomain::byItemTitle)

/// The [(page-1)*size, page*size) slice, `TodoItems::rowsOf`'s window arithmetic.
fn authzSlice(rows, pageNumber, pageSize) = foldList(rows, { at: 0, kept: [] }, fn(walk, item) => {
    let from = satMul(satSub(pageNumber, 1), pageSize)
    match walk.at >= from && walk.at < satAdd(from, pageSize) {
        true => { at: satAdd(walk.at, 1), kept: listAppend(walk.kept, item) }
        false => { at: satAdd(walk.at, 1), kept: walk.kept }
    }
}).kept

/// The page `ItemsWithPagination` must answer: title-ordered rows, the list's
/// total, `hasPrevious` = page > 1, `hasNext` = page*size < total.
fn authzPageView(listId, items, pageNumber, pageSize) = {
    let rows = authzRows(listId, items)
    pageOf(mapList(authzSlice(rows, pageNumber, pageSize), TodoItems::itemView),
        length(rows), pageNumber > 1, satMul(pageNumber, pageSize) < length(rows))
}

/// The view `GetTodos` must answer: the four priority lookups, every supported
/// colour, and the lists by title with each one's items nested by title.
fn authzGetTodosView(lists, items) = TodosView {
    priorities: lookups(),
    colours: mapList(TodoDomain::supportedColours(), fn(code) => ColourChoice { code: code, name: TodoDomain::colourName(code) }),
    lists: mapList(listSortBy(lists, TodoDomain::byListTitle), fn(list) => ListView {
        id: list.id, title: list.title, colour: list.colour,
        items: mapList(authzRows(list.id, items), TodoItems::itemView)
    })
}

/// How many lists, priorities and colours a `TodosView` holds.
fn authzViewSizes(view) = match view {
    TodosView { priorities, colours, lists } => [length(lists), length(priorities), length(colours)]
    _ => []
}

/// The lists of a `TodosView`.
fn authzViewLists(view) = match view {
    TodosView { lists } => lists
    _ => []
}

/// One `WhoMayRun` probe from one named start principal.
fn authzProbed(principal, seedLists, seedItems, request) =
    TodoHarness::probed(principal, seedLists, seedItems, WhoMayRun { request: request })
fn authzAsAnonymous(seedLists, seedItems, request) = authzProbed(TodoHarness::anonymous(), seedLists, seedItems, request)
fn authzAsUser(seedLists, seedItems, request) = authzProbed(TodoHarness::user(), seedLists, seedItems, request)
fn authzAsAdmin(seedLists, seedItems, request) = authzProbed(TodoHarness::admin(), seedLists, seedItems, request)

/// The question probed once per start principal, in `TodoProbe::principals()` order.
fn authzFromEachStart(seedLists, seedItems, request) = mapList(TodoProbe::principals(), fn(who) =>
    authzProbed(who, seedLists, seedItems, request))

/// The same probes over the two seeded lists and three seeded items.
fn authzAnon(request) = authzAsAnonymous(twoLists(), threeItems(), request)
fn authzUser(request) = authzAsUser(twoLists(), threeItems(), request)
fn authzAdmin(request) = authzAsAdmin(twoLists(), threeItems(), request)
fn authzStarts(request) = authzFromEachStart(twoLists(), threeItems(), request)

/// The eight requests with no access rule, each valid against two lists and three items.
fn authzUnguardedRequests() = [
    newList("Travel", "#5C6BC0"), editList(2, "Budget", "#4CAF50"), dropList(2),
    newItem(1, "Dentist"), editItem(1, "Milk", true), itemDetail(1, 2, 2, "call first"),
    dropItem(3), query(1, 1, 5)
]

/// One collected validation problem list as one comparable text.
fn authzJoined(problems) = foldList(problems, "", fn(built, problem) => built + "|" + problem)

/// One branch's answer as plain text, so whole reports from different start
/// principals can be compared with structuralEquals; the exact answers are
/// asserted case by case against literals.
fn authzAnswerText(outcome) = match outcome {
    Success { value: CreatedId { value } } => "created ${toString(value)}"
    Success { value: Updated } => "updated"
    Success { value: Purged { count } } => "purged ${toString(count)}"
    Success { value: TodosView _ } => "todos view"
    Success { value: ItemsPageView _ } => "page view"
    Error { message: Unauthorized } => "unauthorized"
    Error { message: Forbidden { why } } => "forbidden ${why}"
    Error { message: NotFound { kind, id } } => "missing ${kind}#${toString(id)}"
    Error { message: ValidationFault { problems } } => "faults${authzJoined(problems)}"
    Error { message: Conflict { why } } => "conflict ${why}"
}

/// A report's three branch answers, as texts.
fn authzBranchTexts(report) = mapList(report.answers, authzAnswerText)

/// Every report answers its three branches identically, whatever principal
/// started the run: the start principal is inert because `whoMayRun` handles
/// `Auth.who` itself ([MULTI-HANDLE-MANY]).
fn authzSameAnswers(reports) = match reports {
    [first, ...rest] => foldList(rest, true, fn(same, report) =>
        same && structuralEquals(authzBranchTexts(report), authzBranchTexts(first)))
    [] => false
}

/// `holds` true of every report.
fn authzEvery(reports, holds) = foldList(reports, true, fn(ok, report) => ok && holds(report))

/// No report published an event.
fn authzNoEvents(reports) = authzEvery(reports, fn(report) => length(report.events) == 0)

/// Every report left exactly the seeded rows.
fn authzKeeps(reports, lists, items) =
    authzEvery(reports, fn(report) => structuralEquals(report.lists, lists) && structuralEquals(report.items, items))

/// Each of `reports` answered once per principal branch: three answers.
fn authzThree(reports) = authzEvery(reports, fn(report) => length(report.answers) == 3)

/// Each probe charges two clock readings per branch and one for the report.
fn authzReadsEveryBranch(reports) = authzEvery(reports, fn(report) => report.readings == 7)

/// What every "the start principal changes nothing" block proves: three
/// starts, same answers, readings 7, no events.
/// The three starts agree: same answers, readings and no events, as one condition.
fn authzStarted(starts) = length(starts) == 3 && authzSameAnswers(starts) && authzReadsEveryBranch(starts) && authzNoEvents(starts)

fn authzStartsAgree(starts) = [
    length(starts) == 3, authzSameAnswers(starts),
    authzReadsEveryBranch(starts),
    authzNoEvents(starts)
]

/// Every branch of `probe` answered the one literal `answer`.
fn authzAllAnswers(probe, answer) = expect(probe.answers, allBranches(answer))

/// Each listed run's branches all answered its one literal answer.
fn authzVerdicts(runs) = forEachList(runs, fn(run) => authzAllAnswers(run.probe, run.answer))

/// Each `{ ask, list, page, size }` page query asked over the two lists and `seeds`,
/// beside the page view every branch must answer.
fn authzPages(seeds, asks) = mapList(asks, fn(page) => {
    probe: page.ask(twoLists(), seeds, query(page.list, page.page, page.size)),
    answer: authzPageView(page.list, seeds, page.page, page.size)
})

/// Each of `asks` over the seven A-G items answers its page in every branch, reads
/// the store, publishes nothing, keeps the seven rows and satisfies `holds`.
fn authzPagesHold(why, asks, holds) = {
    let pages = authzPages(sevenItems(), asks)
    let probes = mapList(pages, fn(page) => page.probe)
    authzVerdicts(pages)
    checkAll(why, [
        authzReadsEveryBranch(probes), authzNoEvents(probes),
        authzEvery(probes, fn(report) => length(report.items) == 7 && holds(report))
    ])
}

module MultishotAuthzCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: CreateList has no
    /// access rule, so all three branches succeed; each branch reopens the
    /// same snapshot ([MULTI-REPLAY-STATE]), so all three get the same id and
    /// nothing is stored.
    export fn whoMayCreateListCase() = {
        let bare = authzAsAnonymous([], [], newList("Travel", "#5C6BC0"))
        let solo = authzAsUser(authzOneList(), [], newList("Travel", "#5C6BC0"))
        let pair = authzAsAdmin(twoLists(), [], newList("Travel", "#5C6BC0"))
        // nextListId = length(seedLists)+1 in every branch: the id follows the seeds, never a branch counter.
        authzAllAnswers(bare, created(1))
        authzAllAnswers(solo, created(2))
        authzAllAnswers(pair, created(3))
        // Auth.who is dispatch's first perform: 3 branches x 2 readings + the report's own = 7 [MULTI-HANDLE-MANY].
        checkAll("three resumes per store shape; no branch's list survives [MULTI-REPLAY]", [
            authzReadsEveryBranch([bare, solo, pair]),
            structuralEquals(bare.lists, []),
            structuralEquals(titlesOf(solo.lists), ["Solo"]),
            structuralEquals(titlesOf(pair.lists), ["Shopping", "Banking"]),
            authzNoEvents([bare, solo, pair])
        ])
        let blank = authzAsAdmin(authzOneList(), [], newList("Travel", ""))
        // A blank colour is no access concern: the branch still answers the same new id.
        authzAllAnswers(blank, created(2))
        checkAll("the blank-colour branch is undone like the rest", [
            blank.readings == 7, length(blank.events) == 0,
            structuralEquals(titlesOf(blank.lists), ["Solo"])
        ])
        let starts = authzFromEachStart([], [], newList("Travel", ""))
        // The start principal never reaches the branches: whoMayRun answers Auth itself.
        expect(TodoHarness::failures("the start principal changes no answer, no reading, no row", listConcat(authzStartsAgree(starts), [
            authzEvery(starts, fn(report) => structuralEquals(report.lists, []) && structuralEquals(report.items, []))
        ])), [])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: UpdateList has no
    /// rule, so even the anonymous branch may rename; a missing id answers the
    /// typed NotFound fault in every branch, and validation runs before the
    /// lookup, so a broken title refuses before the id is ever read.
    export fn whoMayUpdateListCase() = {
        let rename = authzAsAnonymous(twoLists(), [], editList(2, "Budget", "#4CAF50"))
        let blank = authzAsAdmin(twoLists(), [], editList(1, "Shopping", ""))
        let dup = authzAsUser(twoLists(), [], editList(2, "Shopping", ""))
        let missing = authzAsAdmin(twoLists(), [], editList(99, "Budget", "#4CAF50"))
        let invalid = authzAsAnonymous(twoLists(), [], editList(99, "", ""))
        // rename: fresh title, supported colour; blank: the list's own colour stays; dup: list 1 already holds
        // "Shopping"; missing: valid data, absent id; invalid: empty title collected before the lookup.
        authzVerdicts([{ probe: rename, answer: updated() }, { probe: blank, answer: updated() },
            { probe: dup, answer: faults([uniqueTitleRule()]) }, { probe: missing, answer: notFound("TodoList", 99) },
            { probe: invalid, answer: faults([emptyTitleRule()]) }])
        checkAll("five shapes x three branches: full re-run, no write and no event survives [MULTI-REPLAY]", [
            authzReadsEveryBranch([rename, blank, dup, missing, invalid]),
            length(missing.answers) == 3,
            authzKeeps([rename, blank, dup, missing], twoLists(), []),
            length(blank.items) == 0, authzNoEvents([rename, invalid, missing])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: DeleteList has no
    /// rule, so all three branches answer Updated; a missing id (or an empty
    /// store) answers the typed NotFound fault, and each branch's cascade drop
    /// is undone.
    export fn whoMayDeleteListCase() = {
        let drop = authzAnon(dropList(1))
        let keep = authzUser(dropList(2))
        let missing = authzAdmin(dropList(99))
        let bare = authzAsAnonymous([], [], dropList(1))
        // Existing ids answer Updated in all branches; id 99 and an empty store answer NotFound with kind and id asked.
        authzVerdicts([{ probe: drop, answer: updated() }, { probe: keep, answer: updated() },
            { probe: missing, answer: notFound("TodoList", 99) }, { probe: bare, answer: notFound("TodoList", 1) }])
        checkAll("four shapes x three branches: rows equal the seeds, events empty [MULTI-REPLAY]", [
            authzReadsEveryBranch([drop, keep, missing, bare]),
            authzThree([keep, bare]),
            authzKeeps([drop, keep, missing], twoLists(), threeItems()),
            length(bare.lists) == 0, length(bare.items) == 0,
            authzNoEvents([drop, keep, missing])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: GetTodos demands
    /// only sign-in, so the anonymous branch answers Unauthorized while the
    /// user and administrator branches answer the identical full view; the
    /// abandoned reads publish nothing and store nothing.
    export fn whoMayGetTodosCase() = {
        let view = authzGetTodosView(twoLists(), threeItems())
        let reads = authzAnon(GetTodos)
        // MustSignIn is the first and only rule: anonymous refused, both signed-in branches get the same view.
        expect(reads.answers, [unauthorized(), Success { value: view }, Success { value: view }])
        let bare = authzAsAdmin([], [], GetTodos)
        let bareView = authzGetTodosView([], [])
        // An empty store answers the same lookups with no lists.
        expect(bare.answers, [unauthorized(), Success { value: bareView }, Success { value: bareView }])
        checkAll("two shapes x three branches; the view is title-sorted with nested items", [
            authzReadsEveryBranch([reads, bare]),
            length(reads.answers) == 3, length(reads.items) == 3, length(bare.answers) == 3,
            structuralEquals(titlesOf(reads.lists), ["Shopping", "Banking"]),
            authzKeeps([reads], twoLists(), threeItems()),
            structuralEquals(bare.lists, []), structuralEquals(bare.items, []),
            authzNoEvents([reads, bare]),
            match reads.answers { [_, Success { value: mine }, Success { value: root }] => structuralEquals(mine, root) _ => false },
            match bare.answers { [_, Success { value: mine }, Success { value: root }] => structuralEquals(mine, root) _ => false },
            structuralEquals(authzViewSizes(view), [2, 4, 7]),
            structuralEquals(authzViewSizes(bareView), [0, 4, 7]),
            structuralEquals(titlesOf(authzViewLists(view)), ["Banking", "Shopping"]),
            match authzViewLists(view) { [banking, shopping] => length(banking.items) == 1 && length(shopping.items) == 2 _ => false }
        ])
        let starts = authzStarts(GetTodos)
        checkAll("the start principal changes nothing", [authzStarted(starts),
            authzEvery(starts, fn(report) => structuralEquals(report.items, threeItems()) && structuralEquals(authzBranchTexts(report), ["unauthorized", "todos view", "todos view"]))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: CreateItem has no
    /// rule and the ported validator checks only the title, so even a missing
    /// parent list answers the new id; an empty title collects its one
    /// problem; every branch's row is undone.
    export fn whoMayCreateItemCase() = {
        let fresh = authzAnon(newItem(1, "Dentist"))
        let bare = authzAsUser([], [], newItem(1, "First"))
        let orphan = authzAdmin(newItem(99, "Dentist"))
        let empty = authzAnon(newItem(1, ""))
        // nextItemId = length(seedItems)+1 per branch (4 with three items, 1 bare); the parent listId is never
        // checked; an empty title collects exactly the empty-title problem.
        authzVerdicts([{ probe: fresh, answer: created(4) }, { probe: bare, answer: created(1) },
            { probe: orphan, answer: created(4) }, { probe: empty, answer: faults([emptyTitleRule()]) }])
        checkAll("four shapes x three branches: same id per branch, no row kept [MULTI-REPLAY]", [
            authzReadsEveryBranch([fresh, bare, orphan, empty]),
            authzThree([bare, empty]),
            authzKeeps([fresh, orphan, empty], twoLists(), threeItems()),
            structuralEquals(bare.items, []),
            authzNoEvents([fresh, orphan, empty, bare])
        ])
        let starts = authzStarts(newItem(1, "Dentist"))
        checkAll("the start principal changes nothing", [
            length(starts) == 3, authzSameAnswers(starts),
            authzEvery(starts, fn(report) => structuralEquals(authzBranchTexts(report), ["created 4", "created 4", "created 4"])),
            authzReadsEveryBranch(starts)
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: UpdateItem has no
    /// rule, so all three branches may flip Done either way; the completion
    /// event a false->true flip raises is undone with the branch, so `events`
    /// stays empty, and a missing item answers the typed NotFound fault.
    export fn whoMayCompleteItemCase() = {
        let flip = authzAnon(editItem(1, "Milk", true))
        let doneSeeds = milkOnly(true)
        let doneList = shoppingList()
        let again = authzAsUser(doneList, doneSeeds, editItem(1, "Milk", true))
        let down = authzAsAdmin(doneList, doneSeeds, editItem(1, "Milk", false))
        let idle = authzAnon(editItem(3, "Tax", false))
        let missing = authzUser(editItem(99, "Milk", true))
        // false->true, true->true and true->false all answer Updated (only the flip up raises, and it is
        // rewound); false on an already-open item answers Updated; a missing id answers NotFound TodoItem 99.
        authzVerdicts([{ probe: flip, answer: updated() }, { probe: again, answer: updated() },
            { probe: down, answer: updated() }, { probe: idle, answer: updated() },
            { probe: missing, answer: notFound("TodoItem", 99) }])
        checkAll("six shapes x three branches: events empty and rows restored every time [MULTI-REPLAY]", [
            authzReadsEveryBranch([flip, again, down, idle, missing]),
            length(missing.answers) == 3,
            structuralEquals(flip.items, threeItems()), structuralEquals(again.items, doneSeeds),
            structuralEquals(down.items, doneSeeds), structuralEquals(idle.items, threeItems()),
            structuralEquals(missing.items, threeItems()), structuralEquals(again.lists, doneList),
            authzNoEvents([flip, again, down, idle, missing])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: UpdateItemDetail
    /// has no rule, so every priority wire number (0-4 and the unknown -1)
    /// runs in all three branches: six priorities x (one expect + five checks)
    /// prove the answers, readings, rows and events.
    export fn whoMayUpdateItemDetailCase() = {
        forEachList([0, 1, 2, 3, 4, -1], fn(level) => {
            let probe = authzAnon(itemDetail(1, 2, level, "call first"))
            // No rule and no validator on detail: all three branches answer Updated whatever the wire number.
            authzAllAnswers(probe, updated())
            checkAll("priority ${toString(level)}: full re-run per branch, row and event undone [MULTI-REPLAY]", [
                length(probe.answers) == 3,
                probe.readings == 7,
                structuralEquals(probe.items, threeItems()),
                structuralEquals(probe.lists, twoLists()),
                length(probe.events) == 0
            ])
        })
        let missing = authzAdmin(itemDetail(99, 2, 2, "call first"))
        // authorize and validate both pass for detail, so the lookup runs and NotFound names kind and id.
        authzAllAnswers(missing, notFound("TodoItem", 99))
        checkAll("the missing item refuses in all three branches [MULTI-HANDLE-MANY]", [
            missing.readings == 7, length(missing.answers) == 3,
            structuralEquals(missing.items, threeItems()),
            length(missing.events) == 0
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ], [MULTI-REPLAY]: DeleteItem has no
    /// rule; every branch answers Updated or the typed NotFound fault, and the
    /// removal is undone, leaving exactly the seed rows.
    export fn whoMayDeleteItemCase() = {
        let drop = authzAnon(dropItem(2))
        let missing = authzUser(dropItem(99))
        let bare = authzAsAdmin([], [], dropItem(1))
        // Item 2 exists, id 99 and an empty store do not: Updated or NotFound { kind: "TodoItem", id } per branch.
        authzVerdicts([{ probe: drop, answer: updated() }, { probe: missing, answer: notFound("TodoItem", 99) },
            { probe: bare, answer: notFound("TodoItem", 1) }])
        checkAll("three shapes x three branches: rows equal the seeds, events empty [MULTI-REPLAY]", [
            authzReadsEveryBranch([drop, missing, bare]),
            authzThree([drop, bare, missing]),
            authzKeeps([drop, missing], twoLists(), threeItems()),
            length(bare.items) == 0, length(bare.lists) == 0,
            authzNoEvents([drop, missing, bare])
        ])
        let starts = authzStarts(dropItem(3))
        expect(TodoHarness::failures("the start principal changes nothing", listConcat(authzStartsAgree(starts), [
            authzEvery(starts, fn(report) => structuralEquals(report.items, threeItems()))
        ])), [])
    }
}
