// End-to-end cases for the todo item use cases: creation, the completion
// domain event, detail updates, deletion and every pagination edge
// ([EXAMPLE-CLEANARCH-INV-FAITHFUL], [EXAMPLE-CLEANARCH-INV-TESTS]).

namespace todo;

import todo::TodoHarness

/// A seeded five-item store for the pagination edges.
fn pagedSeeds() = {
    lists: shoppingList(),
    items: [
        TodoHarness::seedItem(1, 1, "Apples", false),
        TodoHarness::seedItem(2, 1, "Bread", false),
        TodoHarness::seedItem(3, 1, "Cherries", false),
        TodoHarness::seedItem(4, 1, "Dates", false),
        TodoHarness::seedItem(5, 1, "Eggs", false)
    ]
}

module ItemsCases {
    /// CreateTodoItem answers the id and validates the title.
    export fn createItemCase() = {
        let made = ask(shoppingList(), [], newItem(1, "Milk"))
        expectCreated(made, 1)
        let untitled = ask([], [], newItem(1, ""))
        expectFaults(untitled, [emptyTitleRule()])
    }

    /// Completing an item raises TodoItemCompletedEvent exactly once;
    /// un-completing raises nothing; completing again raises again.
    export fn completionEventCase() = {
        let seeds = milkOnly(false)
        let lists = shoppingList()
        let done = ask(lists, seeds, editItem(1, "Milk", true))
        expectUpdated(done)
        expect(done.events, [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }])
        let undone = ask(lists, milkOnly(true), editItem(1, "Milk", false))
        expectUpdated(undone)
        expect(undone.events, [])
        let redone = ask(lists, milkOnly(false), editItem(1, "Milk", true))
        expectUpdated(redone)
        expect(redone.events, [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }])
    }

    /// UpdateTodoItemDetail moves lists, sets the priority and the note.
    export fn detailCase() = {
        let after = TodoHarness::rowsAfter(TodoHarness::admin(), 0, twoLists(),
            milkOnly(false), itemDetail(1, 2, 3, "switch banks"))
        expect(after.items, [TodoItem {
            id: 1,
            listId: 2,
            title: "Milk",
            note: "switch banks",
            priority: LevelHigh,
            done: false
        } ])
        expect(after.events, [])
    }

    /// Missing items answer the typed NotFound fault.
    export fn missingItemCase() = {
        let edited = ask(shoppingList(), [], editItem(9, "Ghost", false))
        expectMissing(edited, "TodoItem", 9)
        let detailed = ask([], [], itemDetail(9, 1, 0, ""))
        expectMissing(detailed, "TodoItem", 9)
        let deleted = ask([], [], dropItem(9))
        expectMissing(deleted, "TodoItem", 9)
    }

    /// DeleteTodoItem removes the row.
    export fn deleteItemCase() = {
        let after = TodoHarness::rowsAfter(TodoHarness::admin(), 0, shoppingList(),
            [TodoHarness::seedItem(1, 1, "Milk", true), TodoHarness::seedItem(2, 1, "Bread", false)], dropItem(1))
        expect(after.items, [TodoHarness::seedItem(2, 1, "Bread", false)])
    }

    /// Pagination edges: first page, middle page, last page, past the end,
    /// an oversize page and an empty list ([EXAMPLE-CLEANARCH-INV-FAITHFUL]).
    export fn paginationEdgesCase() = {
        let seeds = pagedSeeds()
        let at = fn(number, size) => ask(seeds.lists, seeds.items, query(1, number, size))
        expect(at(1, 2).settled, pageOf([row(1, "Apples"), row(2, "Bread")], 5, false, true))
        expect(at(2, 2).settled, pageOf([row(3, "Cherries"), row(4, "Dates")], 5, true, true))
        expect(at(3, 2).settled, pageOf([row(5, "Eggs")], 5, true, false))
        expect(at(4, 2).settled, pageOf([], 5, true, false))
        expect(at(1, 100).settled, pageOf([
            row(1, "Apples"),
            row(2, "Bread"),
            row(3, "Cherries"),
            row(4, "Dates"),
            row(5, "Eggs")
        ], 5, false, false))
        expect(ask(seeds.lists, [], query(1, 1, 10)).settled, pageOf([], 0, false, false))    }

    /// The page query only ever reports its own list's items.
    export fn paginationIsPerListCase() = {
        let view = ask(twoLists(), milkAndTax(true), query(2, 1, 10))
        expect(view.settled, pageOf([ItemView { id: 2, title: "Tax", done: true, priority: "None", note: "" }], 1, false, false))
    }
}
