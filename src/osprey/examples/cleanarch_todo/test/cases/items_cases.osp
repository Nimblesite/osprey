// End-to-end cases for the todo item use cases: creation, the completion
// domain event, detail updates, deletion and every pagination edge
// ([EXAMPLE-CLEANARCH-INV-FAITHFUL], [EXAMPLE-CLEANARCH-INV-TESTS]).

namespace todo;


/// One page's expected shape, for brevity in the pagination cases.
fn pageOf(rows, total, hasPrevious, hasNext) = Success { value: ItemsPageView {
    rows: rows,
    totalCount: total,
    hasPrevious: hasPrevious,
    hasNext: hasNext
} }

/// A seeded five-item store for the pagination edges.
fn pagedSeeds() = {
    lists: [TodoHarness::seedList(1, "Shopping", "#78909C")],
    items: [
        TodoHarness::seedItem(1, 1, "Apples", false),
        TodoHarness::seedItem(2, 1, "Bread", false),
        TodoHarness::seedItem(3, 1, "Cherries", false),
        TodoHarness::seedItem(4, 1, "Dates", false),
        TodoHarness::seedItem(5, 1, "Eggs", false)
    ]
}

/// An ItemView row by id and title, as the seeded items read back.
fn row(id, title) = ItemView { id: id, title: title, done: false, priority: "None", note: "" }

module ItemsCases {
    /// CreateTodoItem answers the id and validates the title.
    export fn createItemCase() = {
        let made = TodoHarness::adminAsks([
            TodoHarness::seedList(1, "Shopping", "#78909C")
        ], [], newItem(1, "Milk"))
        expect(made.settled, Success { value: CreatedId { value: 1 } })
        let untitled = TodoHarness::adminAsks([], [], newItem(1, ""))
        expect(untitled.settled, Error { message: ValidationFault {
            problems: ["'Title' must not be empty."]
        } })
    }

    /// Completing an item raises TodoItemCompletedEvent exactly once;
    /// un-completing raises nothing; completing again raises again.
    export fn completionEventCase() = {
        let lists = [TodoHarness::seedList(1, "Shopping", "#78909C")]
        let completed = [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }]
        let flips = [
            { seeded: false, done: true, events: completed },
            { seeded: true, done: false, events: [] },
            { seeded: false, done: true, events: completed }
        ]
        forEachList(flips, fn(flip) => {
            let run = TodoHarness::adminAsks(lists, [
                TodoHarness::seedItem(1, 1, "Milk", flip.seeded)
            ], editItem(1, "Milk", flip.done))
            expect(run.settled, Success { value: Updated })
            expect(run.events, flip.events)
        })
    }

    /// UpdateTodoItemDetail moves lists, sets the priority and the note.
    export fn detailCase() = {
        let after = TodoHarness::rowsAfter(TodoHarness::admin(), 0, authzTwoLists(),
            [TodoHarness::seedItem(1, 1, "Milk", false)], itemDetail(1, 2, 3, "switch banks"))
        expect(after.items, [TodoItem {
            id: 1,
            listId: 2,
            title: "Milk",
            note: "switch banks",
            priority: LevelHigh,
            done: false
        } ])
        expect(after.events, [])
    }

    /// Missing items answer the typed NotFound fault.
    export fn missingItemCase() = {
        let edited = TodoHarness::adminAsks([
            TodoHarness::seedList(1, "Shopping", "#78909C")
        ], [], editItem(9, "Ghost", false))
        expect(edited.settled, Error { message: NotFound { kind: "TodoItem", id: 9 } })
        let detailed = TodoHarness::adminAsks([], [], itemDetail(9, 1, 0, ""))
        expect(detailed.settled, Error { message: NotFound { kind: "TodoItem", id: 9 } })
        let deleted = TodoHarness::adminAsks([], [], dropItem(9))
        expect(deleted.settled, Error { message: NotFound { kind: "TodoItem", id: 9 } })
    }

    /// DeleteTodoItem removes the row.
    export fn deleteItemCase() = {
        let after = TodoHarness::rowsAfter(TodoHarness::admin(), 0, [
            TodoHarness::seedList(1, "Shopping", "#78909C")
        ], [
            TodoHarness::seedItem(1, 1, "Milk", true),
            TodoHarness::seedItem(2, 1, "Bread", false)
        ], dropItem(1))
        expect(after.items, [TodoHarness::seedItem(2, 1, "Bread", false)])
    }

    /// Pagination edges: first page, middle page, last page, past the end,
    /// an oversize page and an empty list ([EXAMPLE-CLEANARCH-INV-FAITHFUL]).
    export fn paginationEdgesCase() = {
        let seeds = pagedSeeds()
        let ask = fn(number, size) => TodoHarness::adminAsks(seeds.lists, seeds.items, itemQuery(1, number, size))
        expect(ask(1, 2).settled, pageOf([row(1, "Apples"), row(2, "Bread")], 5, false, true))
        expect(ask(2, 2).settled, pageOf([row(3, "Cherries"), row(4, "Dates")], 5, true, true))
        expect(ask(3, 2).settled, pageOf([row(5, "Eggs")], 5, true, false))
        expect(ask(4, 2).settled, pageOf([], 5, true, false))
        expect(ask(1, 100).settled, pageOf([
            row(1, "Apples"),
            row(2, "Bread"),
            row(3, "Cherries"),
            row(4, "Dates"),
            row(5, "Eggs")
        ], 5, false, false))
        expect(TodoHarness::adminAsks(seeds.lists, [], itemQuery(1, 1, 10)).settled, pageOf([], 0, false, false))
    }

    /// The page query only ever reports its own list's items.
    export fn paginationIsPerListCase() = {
        let view = TodoHarness::adminAsks(authzTwoLists(), [
            TodoHarness::seedItem(1, 1, "Milk", false),
            TodoHarness::seedItem(2, 2, "Tax", true)
        ], itemQuery(2, 1, 10))
        expect(view.settled, pageOf([
            ItemView { id: 2, title: "Tax", done: true, priority: "None", note: "" }
        ], 1, false, false))
    }
}
