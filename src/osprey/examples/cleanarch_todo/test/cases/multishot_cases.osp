// The four multi-shot uses, asserted directly ([EXAMPLE-CLEANARCH-INV-MULTISHOT],
// [EXAMPLE-CLEANARCH-INV-NO-SKIP], [EXAMPLE-CLEANARCH-INV-TESTS]). Each case
// counts how often the captured request resumed, checks every branch's own
// answer, and checks that an abandoned branch left no write and no event.
//
// The fixture clock advances one per reading. A request reads it when it
// starts and when it settles, so `readings` tells how much of the request a
// resumption re-ran: nothing before the captured point runs again.

namespace todo;

import todo::TodoHarness
import todo::TodoProbe

/// The page a plan branch answers over the seven A-G items.
fn pageOfTitles(titles, hasPrevious, hasNext) = pageOf(
    mapList(titles, fn(title) => row(length(titlesUpTo(title)), title)),
    7, hasPrevious, hasNext)

module MultishotCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ]: one sent request, resumed as the
    /// anonymous party, a user and the administrator. Each branch answers for
    /// its own principal, and the administrator's purge is undone.
    export fn whoMayPurgeCase() = {
        let probe = TodoHarness::probed(TodoHarness::anonymous(), twoLists(), threeItems(), WhoMayRun { request: PurgeTodoLists })
        expect(probe.answers, [unauthorized(), denied("not in role"), purged(2)])
        checkAll("three resumptions; the purge that ran is rolled back", [
            probe.readings == 7,
            structuralEquals(titlesOf(probe.lists), ["Shopping", "Banking"]),
            length(probe.items) == 3,
            length(probe.events) == 0
        ])
    }

    /// The same question over a query and two commands: branches that
    /// succeed get the same id, because each starts from the same store, and
    /// a completion event raised in an abandoned branch is never published.
    export fn whoMayRunCommandsCase() = {
        let reads = TodoHarness::probed(TodoHarness::admin(), twoLists(), threeItems(), WhoMayRun { request: GetTodos })
        checkAll("the query is refused anonymously and identical for both signed-in parties", [
            match reads.answers {
                [Error { message: Unauthorized }, Success { value: user }, Success { value: administrator }] =>
                    structuralEquals(user, administrator)
                _ => false
            },
            reads.readings == 7
        ])
        let creates = TodoHarness::probed(TodoHarness::anonymous(), twoLists(), [], WhoMayRun { request: newList("Travel", "") })
        expect(creates.answers, allBranches(created(3)))
        checkAll("every branch created list 3 and none of them is left behind", [
            structuralEquals(titlesOf(creates.lists), ["Shopping", "Banking"]),
            creates.readings == 7
        ])
        let completes = TodoHarness::probed(TodoHarness::anonymous(), twoLists(), threeItems(), WhoMayRun { request: editItem(1, "Milk", true) })
        expect(completes.answers, allBranches(updated()))
        checkAll("three completions ran and none published or persisted", [
            length(completes.events) == 0,
            structuralEquals(completes.items, threeItems()),
            completes.readings == 7
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-VALIDATE]: one invalid request, resumed
    /// once per candidate fix. Every branch still collects all of its own
    /// failures, and the request's start is never re-run: one start reading,
    /// one settle reading per branch.
    export fn whichFixesWorkCase() = {
        let hopeless = TodoHarness::probed(TodoHarness::admin(), twoLists(), [], WhichFixesWork { request: newList(wide(201), "#HotPink") })
        expect(hopeless.answers, fixHotPinkAnswers())
        let fixable = TodoHarness::probed(TodoHarness::admin(), twoLists(), [], WhichFixesWork { request: newList(wide(201), "#AB47BC") })
        expect(fixable.answers, [
            faults([tooLongRule()]),
            faults([tooLongRule()]),
            created(3),
            faults([tooLongRule()])
        ])
        let padded = TodoHarness::probed(TodoHarness::admin(), twoLists(), [], WhichFixesWork { request: newList("  Shopping  ", "") })
        expect(padded.answers, [created(3), faults([uniqueTitleRule()]), created(3), created(3)])
        checkAll("four resumptions each, one start, and no branch's list is kept", [
            foldList([hopeless, fixable, padded], true, fn(ok, run) =>
                ok && run.readings == 6 && structuralEquals(titlesOf(run.lists), ["Shopping", "Banking"])),
            length(TodoProbe::fixes()) == 4
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN]: one captured query, resumed with
    /// four page shapes.
    export fn pagePlanCase() = {
        let plan = TodoHarness::probed(TodoHarness::admin(), twoLists(), sevenItems(), PagePlan { listId: 1 })
        expect(plan.answers, [
            pageOfTitles(["A", "B", "C", "D", "E"], false, true),
            pageOfTitles(["F", "G"], true, false),
            pageOfTitles(["A", "B", "C", "D", "E", "F", "G"], false, false),
            pageOfTitles(["A", "B", "C", "D", "E", "F", "G"], false, false)
        ])
        let empty = TodoHarness::probed(TodoHarness::admin(), twoLists(), sevenItems(), PagePlan { listId: 2 })
        checkAll("four resumptions of one query; an empty list plans four empty pages", [
            plan.readings == 6,
            length(TodoProbe::shapes()) == 4,
            length(empty.answers) == 4,
            empty.readings == 6,
            length(plan.items) == 7
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY]: a rival commit wins, so the
    /// transaction handler resumes the same request again. The lost
    /// attempt's write is gone and the retried write lands exactly once.
    export fn retryAfterConflictCase() = {
        let ask = newList("Mine", "")
        let calm = TodoHarness::contested([], [], [], ask)
        let once = TodoHarness::contested(["Rival"], [], [], ask)
        let twice = TodoHarness::contested(["Rival", "Other"], [], [], ask)
        expectCreated(calm, 1)
        expectCreated(once, 2)
        expectCreated(twice, 3)
        checkAll("one, two and three attempts; each lost write and its id rolled back", [
            structuralEquals(titlesOf(calm.lists), ["Mine"]),
            structuralEquals(titlesOf(once.lists), ["Rival", "Mine"]),
            structuralEquals(titlesOf(twice.lists), ["Rival", "Other", "Mine"]),
            calm.readings == 3,
            foldList([once, twice], true, fn(ok, run) => ok && run.readings == 3)
        ])
    }

    /// Three rivals beat all three attempts: the conflict names the third,
    /// and nothing of the request is stored.
    export fn retryGivesUpCase() = {
        let lost = TodoHarness::contested(["Rival", "Other", "Third"], [], [], newList("Mine", ""))
        checkAll("the third attempt's conflict is the answer and no write survives", [
            contains(conflictWhy(lost.settled), "attempt 3:"),
            contains(conflictWhy(lost.settled), "store changed under transaction"),
            structuralEquals(titlesOf(lost.lists), ["Rival", "Other", "Third"]),
            lost.readings == 3
        ])
    }

    /// A retried completion publishes its event once: the lost attempt's
    /// event is rewound before the request resumes.
    export fn retryPublishesOnceCase() = {
        let ask = editItem(1, "Milk", true)
        let seeds = milkOnly(false)
        let lists = shoppingList()
        let retried = TodoHarness::contested(["Rival"], lists, seeds, ask)
        let lost = TodoHarness::contested(["Rival", "Other", "Third"], lists, seeds, ask)
        expectUpdated(retried)
        expect(retried.events, [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }])
        expect(retried.items, milkOnly(true))
        checkAll("three lost attempts publish nothing and leave the item as it was", [
            length(lost.events) == 0,
            structuralEquals(lost.items, seeds),
            contains(conflictWhy(lost.settled), "attempt 3:")
        ])
    }
}
