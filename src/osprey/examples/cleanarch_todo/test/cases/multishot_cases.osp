// The four multi-shot uses, asserted directly ([EXAMPLE-CLEANARCH-INV-MULTISHOT],
// [EXAMPLE-CLEANARCH-INV-NO-SKIP], [EXAMPLE-CLEANARCH-INV-TESTS]). Each case
// counts how often the captured request resumed, checks every branch's own
// answer, and checks that an abandoned branch left no write and no event.
//
// The fixture clock advances one per reading. A request reads it when it
// starts and when it settles, so `readings` tells how much of the request a
// resumption re-ran: nothing before the captured point runs again.

namespace todo;


/// The titles of the two seeded lists, in id order.
let seededTitles = ["Shopping", "Banking"]

/// The seven titles of list 1, in id order.
let sevenTitles = ["A", "B", "C", "D", "E", "F", "G"]

/// What the title length rule answers.
let titleTooLong = ValidationFault { problems: ["'Title' must be at most 200 characters."] }

/// The page a plan branch answers.
fn pageOfTitles(titles, hasPrevious, hasNext) = Success { value: ItemsPageView {
    rows: mapList(titles, fn(title) => ItemView {
        id: length(authzTitlesUpTo(title)),
        title: title,
        done: false,
        priority: "None",
        note: ""
    }),
    totalCount: 7,
    hasPrevious: hasPrevious,
    hasNext: hasNext
} }

/// The stored list titles, in stored order.
fn titlesOf(lists) = mapList(lists, fn(list) => list.title)

/// The conflict's explanation, or "" for any other outcome.
fn conflictWhy(outcome) = match outcome {
    Error { message: Conflict { why } } => why
    _ => ""
}

module MultishotCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-AUTHZ]: one sent request, resumed as the
    /// anonymous party, a user and the administrator. Each branch answers for
    /// its own principal, and the administrator's purge is undone.
    export fn whoMayPurgeCase() = {
        let probe = TodoHarness::probed(TodoHarness::anonymous(), authzTwoLists(), authzThreeItems(), WhoMayRun { request: PurgeTodoLists })
        expect(probe.answers, [
            Error { message: Unauthorized },
            Error { message: Forbidden { why: "not in role" } },
            Success { value: Purged { count: 2 } }
        ])
        checkAll("three resumptions; the purge that ran is rolled back", [
            probe.readings == 7,
            structuralEquals(titlesOf(probe.lists), seededTitles),
            length(probe.items) == 3,
            length(probe.events) == 0
        ])
    }

    /// The same question over a query and two commands: branches that
    /// succeed get the same id, because each starts from the same store, and
    /// a completion event raised in an abandoned branch is never published.
    export fn whoMayRunCommandsCase() = {
        let reads = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), authzThreeItems(), WhoMayRun { request: GetTodos })
        checkAll("the query is refused anonymously and identical for both signed-in parties", [
            match reads.answers {
                [Error { message: Unauthorized }, Success { value: user }, Success { value: administrator }] =>
                    structuralEquals(user, administrator)
                _ => false
            },
            reads.readings == 7
        ])
        let creates = TodoHarness::probed(TodoHarness::anonymous(), authzTwoLists(), [], WhoMayRun { request: newList("Travel", "") })
        expect(creates.answers, [
            Success { value: CreatedId { value: 3 } },
            Success { value: CreatedId { value: 3 } },
            Success { value: CreatedId { value: 3 } }
        ])
        checkAll("every branch created list 3 and none of them is left behind", [
            structuralEquals(titlesOf(creates.lists), seededTitles),
            creates.readings == 7
        ])
        let completes = TodoHarness::probed(TodoHarness::anonymous(), authzTwoLists(), authzThreeItems(), WhoMayRun { request: editItem(1, "Milk", true) })
        expect(completes.answers, [
            Success { value: Updated },
            Success { value: Updated },
            Success { value: Updated }
        ])
        checkAll("three completions ran and none published or persisted", [
            length(completes.events) == 0,
            structuralEquals(completes.items, authzThreeItems()),
            completes.readings == 7
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-VALIDATE]: one invalid request, resumed
    /// once per candidate fix. Every branch still collects all of its own
    /// failures, and the request's start is never re-run: one start reading,
    /// one settle reading per branch.
    export fn whichFixesWorkCase() = {
        let hopeless = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), [], WhichFixesWork { request: newList(retryWide(201), "#HotPink") })
        expect(hopeless.answers, [
            Error { message: ValidationFault { problems: [
                "'Title' must be at most 200 characters.",
                "UnsupportedColour: '#HotPink' is not a supported colour"
            ] } },
            Error { message: ValidationFault { problems: [
                "'Title' must be at most 200 characters.",
                "UnsupportedColour: '#HotPink' is not a supported colour"
            ] } },
            Error { message: ValidationFault { problems: [
                "UnsupportedColour: '#HotPink' is not a supported colour"
            ] } },
            Error { message: titleTooLong }
        ])
        let fixable = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), [], WhichFixesWork { request: newList(retryWide(201), "#AB47BC") })
        expect(fixable.answers, [
            Error { message: titleTooLong },
            Error { message: titleTooLong },
            Success { value: CreatedId { value: 3 } },
            Error { message: titleTooLong }
        ])
        let padded = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), [], WhichFixesWork { request: newList("  Shopping  ", "") })
        expect(padded.answers, [
            Success { value: CreatedId { value: 3 } },
            Error { message: ValidationFault { problems: ["'Title' must be unique."] } },
            Success { value: CreatedId { value: 3 } },
            Success { value: CreatedId { value: 3 } }
        ])
        checkAll("four resumptions each, one start, and no branch's list is kept", [
            hopeless.readings == 6,
            fixable.readings == 6,
            padded.readings == 6,
            structuralEquals(titlesOf(hopeless.lists), seededTitles),
            structuralEquals(titlesOf(fixable.lists), seededTitles),
            structuralEquals(titlesOf(padded.lists), seededTitles),
            length(TodoProbe::fixes()) == 4
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN]: one captured query, resumed with
    /// four page shapes.
    export fn pagePlanCase() = {
        let plan = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), authzSevenItems(), PagePlan { listId: 1 })
        expect(plan.answers, [
            pageOfTitles(authzTitlesUpTo("E"), false, true),
            pageOfTitles(["F", "G"], true, false),
            pageOfTitles(sevenTitles, false, false),
            pageOfTitles(sevenTitles, false, false)
        ])
        let empty = TodoHarness::probed(TodoHarness::admin(), authzTwoLists(), authzSevenItems(), PagePlan { listId: 2 })
        checkAll("four resumptions of one query; an empty list plans four empty pages", [
            plan.readings == 6,
            length(TodoProbe::shapes()) == 4,
            length(empty.answers) == 4,
            empty.readings == 6,
            length(plan.items) == 7
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-RETRY]: a rival commit wins, so the
    /// transaction handler resumes the same request again. The lost
    /// attempt's write is gone and the retried write lands exactly once.
    export fn retryAfterConflictCase() = {
        let ask = newList("Mine", "")
        let calm = TodoHarness::contested([], [], [], ask)
        let once = TodoHarness::contested(["Rival"], [], [], ask)
        let twice = TodoHarness::contested(["Rival", "Other"], [], [], ask)
        expect(calm.settled, Success { value: CreatedId { value: 1 } })
        expect(once.settled, Success { value: CreatedId { value: 2 } })
        expect(twice.settled, Success { value: CreatedId { value: 3 } })
        checkAll("one, two and three attempts; each lost write and its id rolled back", [
            structuralEquals(titlesOf(calm.lists), ["Mine"]),
            structuralEquals(titlesOf(once.lists), ["Rival", "Mine"]),
            structuralEquals(titlesOf(twice.lists), ["Rival", "Other", "Mine"]),
            calm.readings == 3,
            once.readings == 3,
            twice.readings == 3
        ])
    }

    /// Three rivals beat all three attempts: the conflict names the third,
    /// and nothing of the request is stored.
    export fn retryGivesUpCase() = {
        let lost = TodoHarness::contested(namedRivals, [], [], newList("Mine", ""))
        checkAll("the third attempt's conflict is the answer and no write survives", [
            contains(conflictWhy(lost.settled), "attempt 3:"),
            contains(conflictWhy(lost.settled), "store changed under transaction"),
            structuralEquals(titlesOf(lost.lists), namedRivals),
            lost.readings == 3
        ])
    }

    /// A retried completion publishes its event once: the lost attempt's
    /// event is rewound before the request resumes.
    export fn retryPublishesOnceCase() = {
        let ask = editItem(1, "Milk", true)
        let seeds = [TodoHarness::seedItem(1, 1, "Milk", false)]
        let lists = [TodoHarness::seedList(1, "Shopping", "#78909C")]
        let retried = TodoHarness::contested(["Rival"], lists, seeds, ask)
        let lost = TodoHarness::contested(namedRivals, lists, seeds, ask)
        expect(retried.settled, Success { value: Updated })
        expect(retried.events, [TodoItemCompleted { itemId: 1, listId: 1, title: "Milk" }])
        expect(retried.items, [TodoHarness::seedItem(1, 1, "Milk", true)])
        checkAll("three lost attempts publish nothing and leave the item as it was", [
            length(lost.events) == 0,
            structuralEquals(lost.items, seeds),
            contains(conflictWhy(lost.settled), "attempt 3:")
        ])
    }
}
