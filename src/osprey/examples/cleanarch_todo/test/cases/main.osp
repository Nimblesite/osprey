// Every case, registered in one run: the behaviour of the ported app, then the four
// multi-shot uses asserted directly ([EXAMPLE-CLEANARCH-INV-TESTS], [EXAMPLE-CLEANARCH-INV-NO-SKIP]).

namespace todo;

import todo::AccessCases
import todo::EdgeCases
import todo::ItemsCases
import todo::ListsCases
import todo::MultishotAuthzCases
import todo::MultishotAuthzGuardCases
import todo::MultishotCases
import todo::MultishotMatrixCases
import todo::MultishotPlanCases
import todo::MultishotPlanListsCases
import todo::MultishotRetryCases
import todo::MultishotRetryItemsCases
import todo::MultishotValidateCases
import todo::PipelineCases

test("create answers the id and GetTodos shows the list", ListsCases::createRoundTripCase)
test("every supported colour round-trips; unsupported colours are typed faults", ListsCases::colourPermutationsCase)
test("create collects every title and colour problem", ListsCases::collectsEveryListProblemCase)
test("update renames, keeps colour and enforces uniqueness", ListsCases::updateAndRenameCase)
test("missing lists answer the typed NotFound fault", ListsCases::missingListAnswersNotFoundCase)
test("delete cascades the list's items away", ListsCases::deleteCascadesCase)
test("GetTodos orders by title and nests items", ListsCases::getTodosOrdersByTitleCase)
test("purge clears everything and answers the count", ListsCases::purgeClearsEverythingCase)
test("create item answers the id and validates the title", ItemsCases::createItemCase)
test("completion publishes the domain event exactly once per flip", ItemsCases::completionEventCase)
test("update detail moves lists and sets priority and note", ItemsCases::detailCase)
test("missing items answer the typed NotFound fault", ItemsCases::missingItemCase)
test("delete item removes the row", ItemsCases::deleteItemCase)
test("pagination covers first, middle, last, past-end, oversize and empty", ItemsCases::paginationEdgesCase)
test("pagination reports only the asked list's items", ItemsCases::paginationIsPerListCase)
test("the sign-in rule rejects anonymous and admits users", AccessCases::signInRuleCase)
test("purge demands the Administrator role and the CanPurge policy", AccessCases::purgeGuardsCase)
test("the policy rule is separate from the role rule", AccessCases::policyRuleCase)
test("logging writes one structured line per request", PipelineCases::loggingCase)
test("the rescue arm passes expected faults through quietly", PipelineCases::rescueCase)
test("the 500ms warning fires only when the clock says so", PipelineCases::performanceCase)
test("domain events publish once, after the request settles", PipelineCases::eventPublicationCase)
test("POST /api/TodoLists answers 201 with location", EdgeCases::createListRouteCase)
test("GET /api/TodoLists answers the view or 401", EdgeCases::getListsRouteCase)
test("invalid POST answers 400 problem details", EdgeCases::invalidListRouteCase)
test("PUT and DELETE /api/TodoLists/{id} match the C# statuses", EdgeCases::updateAndDeleteListRouteCase)
test("the item routes match the C# statuses", EdgeCases::itemRoutesCase)
test("one request resumes as three principals and the purge is undone", MultishotCases::whoMayPurgeCase)
test("authorization branches share one store state and publish nothing", MultishotCases::whoMayRunCommandsCase)
test("each candidate fix resumes validation and collects every failure", MultishotCases::whichFixesWorkCase)
test("one query resumes with four page shapes", MultishotCases::pagePlanCase)
test("a lost commit resumes the request and the write lands once", MultishotCases::retryAfterConflictCase)
test("three lost commits give up with the third attempt's conflict", MultishotCases::retryGivesUpCase)
test("a retried completion publishes its event once", MultishotCases::retryPublishesOnceCase)
test("who may create a list: three branches, one new id, nothing kept", MultishotAuthzCases::whoMayCreateListCase)
test("who may update a list: every branch renames and none persists", MultishotAuthzCases::whoMayUpdateListCase)
test("who may delete a list: the cascade is undone after every branch", MultishotAuthzCases::whoMayDeleteListCase)
test("who may read the todos: only the anonymous branch is refused", MultishotAuthzCases::whoMayGetTodosCase)
test("who may create an item: three branches share one item id", MultishotAuthzCases::whoMayCreateItemCase)
test("who may complete an item: no branch's completion event survives", MultishotAuthzCases::whoMayCompleteItemCase)
test("who may update item detail: every priority, no write kept", MultishotAuthzCases::whoMayUpdateItemDetailCase)
test("who may delete an item: the row is back after every branch", MultishotAuthzCases::whoMayDeleteItemCase)
test("who may paginate: three branches answer the same page", MultishotAuthzGuardCases::whoMayPaginateCase)
test("who may paginate the edges: past-end, oversize and empty pages", MultishotAuthzGuardCases::whoMayPaginateEdgesCase)
test("who may purge: the administrator's count follows the seeds", MultishotAuthzGuardCases::whoMayPurgeCountsCase)
test("who may purge: the first broken rule answers each branch", MultishotAuthzGuardCases::whoMayPurgeRuleLadderCase)
test("unguarded requests answer alike for all three principals", MultishotAuthzGuardCases::whoMayUnguardedRequestsCase)
test("only GetTodos and purge distinguish the principals", MultishotAuthzGuardCases::whoMayGuardedRequestsCase)
test("the starting principal never changes a what-if answer", MultishotAuthzGuardCases::whoMayStartPrincipalCase)
test("each candidate fix answers every title length edge", MultishotValidateCases::titleLengthsCase)
test("padded, tabbed and blank titles: which fix repairs which", MultishotValidateCases::paddedTitleCase)
test("a trimmed duplicate title is still a duplicate, except its own", MultishotValidateCases::trimmedDuplicateListCase)
test("a missing list is missing in every fix branch", MultishotValidateCases::missingListEveryBranchCase)
test("every supported colour passes every fix branch", MultishotValidateCases::everySupportedColourCase)
test("only the colour reset repairs an unsupported colour", MultishotValidateCases::unsupportedColourCase)
test("blank and whitespace colours mean grey in every branch", MultishotValidateCases::blankColourGreyCase)
test("item titles follow the two title rules in every branch", MultishotValidateCases::createItemTitleRulesCase)
test("item updates take the title fixes and ignore the colour reset", MultishotValidateCases::updateItemFixesCase)
test("every fix branch collects all of its problems in rule order", MultishotValidateCases::collectsAllProblemsInOrderCase)
test("the fixes answer alike for every principal", MultishotValidateCases::fixesArePrincipalFreeCase)
test("every fix branch creates the same id, set by the seed count", MultishotValidateCases::seedCountSetsNewIdCase)
test("validation resumes once per candidate fix", MultishotValidateCases::resumeCountIsFixesCase)
test("an abandoned fix branch publishes no completion event", MultishotValidateCases::abandonedBranchEventsCase)
test("the page plan answers its four shapes in order", MultishotPlanCases::planShapesOrderCase)
test("an empty list plans four empty pages", MultishotPlanCases::planEmptyListCase)
test("a list with no rows plans four empty pages", MultishotPlanCases::planMissingListCase)
test("one row plans onto page one of every size", MultishotPlanCases::planOneItemCase)
test("four rows plan in title order", MultishotPlanCases::planFourItemsCase)
test("exactly five rows fill page one and leave page two empty", MultishotPlanCases::planExactlyFiveCase)
test("nine rows split five and four", MultishotPlanCases::planNineItemsCase)
test("exactly ten rows fill the ten-row page with no next", MultishotPlanCases::planExactlyTenCase)
test("eleven rows leave a next page behind every small shape", MultishotPlanCases::planElevenItemsCase)
test("the plan sorts digits, upper case and lower case by title", MultishotPlanCases::planSortStressCase)
test("the plan pages only the asked list's rows", MultishotPlanListsCases::planMultiListCase)
test("the anonymous party plans the same pages", MultishotPlanListsCases::planAnonymousPlanCase)
test("zero to five rivals: the request lands after each lost commit", MultishotRetryCases::retryRivalCountsCase)
test("duplicate rival titles each win exactly one commit", MultishotRetryCases::retryDuplicateRivalsCase)
test("validation re-runs against every retried snapshot", MultishotRetryCases::retryCreateListValidationCase)
test("a retried list update re-lands once", MultishotRetryCases::retryUpdateListCase)
test("a retried list delete restores the cascade until it commits", MultishotRetryCases::retryDeleteListCase)
test("a retried purge counts the rivals that landed", MultishotRetryCases::retryPurgeCase)
test("a retried completion publishes once and never when all attempts lose", MultishotRetryCases::retryCompleteItemCase)
test("retried updates that do not flip publish nothing", MultishotRetryCases::retryUpdateItemWithoutFlipCase)
test("a retried item create keeps the seed-count id", MultishotRetryItemsCases::retryCreateItemCase)
test("a retried item detail re-lands once", MultishotRetryItemsCases::retryItemDetailCase)
test("a retried item delete removes the row once", MultishotRetryItemsCases::retryDeleteItemCase)
test("a retried GetTodos reads the rivals that landed", MultishotRetryItemsCases::retryGetTodosCase)
test("seed sizes shift every id a retry hands out", MultishotRetryItemsCases::retrySeedSizesCase)
test("every request kind gives up with the same attempt-3 conflict", MultishotRetryItemsCases::retryConflictTextCase)
test("a retried page query answers the same page", MultishotRetryItemsCases::retryPaginationCase)
test("matrix: every retried request is an independent run after its rivals", MultishotMatrixCases::retriesMatchIndependentRunsCase)
test("matrix: an exhausted retry keeps only the rivals", MultishotMatrixCases::exhaustedRetriesKeepNothingCase)
test("matrix: each authorization branch equals an independent run", MultishotMatrixCases::authzBranchesMatchIndependentRunsCase)
test("matrix: what-if answers ignore the starting principal", MultishotMatrixCases::authzIgnoresTheStartingPrincipalCase)
test("matrix: the guarded requests answer by principal over every store", MultishotMatrixCases::authzGuardsEveryStoreCase)
test("matrix: each list fix branch equals an independent run", MultishotMatrixCases::listFixBranchesMatchIndependentRunsCase)
test("matrix: each item fix branch equals an independent run", MultishotMatrixCases::itemFixBranchesMatchIndependentRunsCase)
test("matrix: a request no fix rewrites answers alike in every branch", MultishotMatrixCases::untouchedRequestsAnswerAlikeCase)
test("matrix: each plan branch equals an independent query", MultishotMatrixCases::planBranchesMatchIndependentQueriesCase)
test("matrix: plan flags follow every page shape", MultishotMatrixCases::planFlagsFollowEveryShapeCase)
