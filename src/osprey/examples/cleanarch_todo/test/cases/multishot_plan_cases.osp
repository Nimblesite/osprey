// Page-plan permutations: one captured pagination query, resumed with four page
// shapes ([EXAMPLE-CLEANARCH-MULTISHOT-PLAN], [MULTI-HANDLE-MANY]). Every case
// asks `PagePlan` over seeded rows and pins all four answers exactly: the rows
// in title order, totalCount, hasPrevious and hasNext. The captured point is
// `Paging.window`, so nothing before it re-runs: one start reading, one settle
// reading per branch and the harness's own reading give `readings == 6`
// ([MULTI-HANDLE-MANY]). A page query writes nothing, so the stored rows stay
// the seeds and no event is published ([MULTI-REPLAY], [MULTI-DECL]).

namespace todo;

import todo::TodoHarness
import todo::TodoProbe

/// The widths `from` up to and including `to`.
fn planWidths(from, to) = foldList(range(from, satAdd(to, 1)) |> toList, [], fn(acc, w) => listAppend(acc, w))

/// The widths `to` down to 1: the insertion order whose title order is its exact reverse.
fn planDescWidths(to) = foldList(planWidths(1, to), [], fn(acc, w) => listConcat([w], acc))

/// Items in `listId` titled widest-first: width `w` gets id `count - w + 1`, so id 1 sorts last.
fn planWideSeeds(listId, count) = mapList(planDescWidths(count), fn(w) =>
    TodoHarness::seedItem(satAdd(satSub(count, w), 1), listId, wide(w), false))

/// The branch answer for the wide rows widths `from`..`to` of a `count`-item list (id = count - w + 1);
/// shapes() order is (page 1 of 5), (page 2 of 5), (page 1 of 10), (page 1 of 50).
fn planWidePage(count, from, to, total, hasPrevious, hasNext) = pageOf(
    mapList(planWidths(from, to), fn(w) => spec(satAdd(satSub(count, w), 1), wide(w), false)),
    total, hasPrevious, hasNext)

/// Items titled `titles` in `listId`, seeded in that order (id = position), done exactly for `flipped`.
fn planSeeds(listId, titles, flipped) = foldList(titles, { next: 1, rows: [] }, fn(walk, title) => {
    next: satAdd(walk.next, 1),
    rows: listAppend(walk.rows, TodoHarness::seedItem(walk.next, listId, title, listContains(flipped, title)))
}).rows

/// What branch `at` answered. A nested `Success { value: Success { .. } }` pattern
/// does not compile yet, so the cases read one level at a time.
fn planAnswer(answers, at) = listGet(answers, at) ?: Error { message: NotFound { kind: "branch", id: at } }

/// The rows the `at`th branch answered ([] when the branch is missing or misshaped).
fn planRows(answers, at) = match planAnswer(answers, at) {
    Success { value: ItemsPageView { rows } } => rows
    _ => []
}

/// The row titles / ids / count the `at`th branch answered, in answer order.
fn planTitles(answers, at) = mapList(planRows(answers, at), fn(row) => row.title)

fn planIds(answers, at) = mapList(planRows(answers, at), fn(row) => row.id)

fn planCount(answers, at) = length(planRows(answers, at))

/// The totalCount the `at`th branch answered (0 - 1 when misshaped: every real total is >= 0).
fn planTotal(answers, at) = match planAnswer(answers, at) {
    Success { value: ItemsPageView { totalCount } } => totalCount
    _ => satSub(0, 1)
}

/// Both flags the `at`th branch answered: hasPrevious is `pageNumber > 1`, hasNext `page*size < total`.
fn planFlags(answers, at, hasPrevious, hasNext) = match planAnswer(answers, at) {
    Success { value: ItemsPageView { hasPrevious: before, hasNext: after } } => before == hasPrevious && after == hasNext
    _ => false
}

/// The `row`th row answered exactly as `spec`, with the seeded priority "None" and note "".
fn planRowIs(answers, at, row, spec) = match listGet(planRows(answers, at), row) {
    Success { value: answer } => toString(answer) == toString(spec)
    _ => false
}

/// Branch `at` answered exactly `titles` in order and `ids` beneath them.
fn planShows(answers, at, titles, ids) =
    structuralEquals(planTitles(answers, at), titles) && structuralEquals(planIds(answers, at), ids)

/// The four branch answers of a list that splits across the (1,5) seam: the
/// first page, the rest alone on page 2 with a previous page, then the whole
/// list twice over — `first`'s and `second`'s hasNext flags given per shape.
fn planSplit(first, second, total, firstNext, secondNext) = {
    let all = listConcat(first, second)
    [pageOf(first, total, false, firstNext), pageOf(second, total, true, secondNext),
     pageOf(all, total, false, false), pageOf(all, total, false, false)]
}

/// Every branch answered `total` rows in all, `counts` of them on its page and `nexts` for hasNext;
/// only branch 1 (page 2) has a previous page.
fn planShaped(answers, total, counts, nexts) = foldList(range(0, 4) |> toList, true, fn(ok, at) =>
    ok && planTotal(answers, at) == total && planCount(answers, at) == (listGet(counts, at) ?: satSub(0, 1))
        && planFlags(answers, at, at == 1, listGet(nexts, at) ?: false))

/// One start reading, one settle per branch and the harness reading; four answers; no event.
fn planCalm(plan) = plan.readings == 6 && length(plan.answers) == 4 && length(plan.events) == 0

/// What every page-plan probe proves about its surroundings ([MULTI-REPLAY]):
/// calm, and the stored rows and lists exactly the seeds.
fn planKept(plan, seeds, lists) = [
    planCalm(plan),
    structuralEquals(plan.items, seeds),
    structuralEquals(plan.lists, lists)
]

/// The stored rows as the queries see them, in stored order.
fn planStoredTitles(items) = mapList(items, fn(item) => item.title)

fn planStoredDones(items) = mapList(items, fn(item) => item.done)

/// The one shape most cases here take: probe list 1 of the one `list` over
/// `seeds`, pin the four branch answers, and prove the probe kept the seeds —
/// plus whatever `extra` checks the case needs.
fn planCase(list, seeds, answers, extra) = {
    let plan = TodoHarness::probed(TodoHarness::admin(), [list], seeds, PagePlan { listId: 1 })
    expect(plan.answers, answers)
    expect(TodoHarness::failures("the four answers in shapes() order; the store stays the seeds",
        listConcat(planKept(plan, seeds, [list]), extra(plan))), [])
}

module MultishotPlanCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] the four shapes in shapes() order over six
    /// unsorted rows: title order d,n,o,p,s,t comes from seeds [t,o,d,s,p,n] (ids 1..6,
    /// "p" done), so sorted ids are [3,6,2,5,4,1].
    /// [MULTI-HANDLE-MANY] one start + one settle reading per branch + the harness
    /// reading = readings 6; [MULTI-REPLAY] a page query writes nothing.
    export fn planShapesOrderCase() = {
        let seeds = planSeeds(1, ["t", "o", "d", "s", "p", "n"], ["p"])
        let first5 = [spec(3, "d", false), spec(6, "n", false), spec(2, "o", false), spec(5, "p", true), spec(4, "s", false)]
        // N=6: (1,5) five rows, hasNext 5 < 6 true; (2,5) the sixth alone; (1,10) and (1,50) all six
        planCase(TodoHarness::seedList(1, "Work", "#78909C"), seeds,
            planSplit(first5, [spec(1, "t", false)], 6, true, false),
            fn(plan) => [
                structuralEquals(TodoProbe::shapes(), ["page 1 of 5", "page 2 of 5", "page 1 of 10", "page 1 of 50"]),
                length(TodoProbe::shapes()) == 4,
                length(plan.items) == 6,
                planShows(plan.answers, 0, ["d", "n", "o", "p", "s"], [3, 6, 2, 5, 4]), planShows(plan.answers, 1, ["t"], [1]),
                structuralEquals(planTitles(plan.answers, 2), ["d", "n", "o", "p", "s", "t"]), structuralEquals(planTitles(plan.answers, 3), ["d", "n", "o", "p", "s", "t"]),
                planShaped(plan.answers, 6, [5, 1, 6, 6], [true, false, false, false]),
                planRowIs(plan.answers, 0, 0, spec(3, "d", false)), planRowIs(plan.answers, 0, 3, spec(5, "p", true)),
                planRowIs(plan.answers, 1, 0, spec(1, "t", false))
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] zero rows in the asked list: every branch
    /// answers an empty page with totalCount 0 and hasNext false, while branch 2 still
    /// answers hasPrevious true (pageNumber > 1, however few rows). The two rows of the
    /// other list never leak in: the page filters items by the asked listId only.
    export fn planEmptyListCase() = {
        let others = planSeeds(2, ["K1", "K2"], [])
        planCase(TodoHarness::seedList(1, "Empty", "#26A69A"), others, planSplit([], [], 0, false, false), fn(plan) => [
            length(plan.items) == 2,
            structuralEquals(planTitles(plan.answers, 0), []), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), []), structuralEquals(planTitles(plan.answers, 3), []),
            structuralEquals(planRows(plan.answers, 0), []), structuralEquals(planRows(plan.answers, 1), []),
            planShaped(plan.answers, 0, [0, 0, 0, 0], [false, false, false, false]),
            structuralEquals(planStoredTitles(plan.items), ["K1", "K2"]),
            structuralEquals(retryItemIds(plan.items), [1, 2]), structuralEquals(planStoredDones(plan.items), [false, false])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] a listId with no rows answers four empty
    /// pages — never NotFound: the page query filters items by listId and never reads
    /// the list row itself, so a missing id and an existing but bare list row plan
    /// the same four pages ([MULTI-HANDLE-MANY] readings 6 for each ask).
    export fn planMissingListCase() = {
        let lists = [TodoHarness::seedList(1, "Work", "#5C6BC0")]
        let gone = TodoHarness::probed(TodoHarness::admin(), lists, [], PagePlan { listId: 99 })
        let bare = TodoHarness::probed(TodoHarness::admin(), lists, [], PagePlan { listId: 1 })
        // no items anywhere: both asks plan four empty pages; hasPrevious follows pageNumber alone
        let empty: List<Result<Reply, Fault>> = planSplit([], [], 0, false, false)
        expect(gone.answers, empty)
        expect(bare.answers, empty)
        checkAll("a missing listId and a bare list row both plan four empty pages", [
            gone.readings == 6, bare.readings == 6,
            length(gone.answers) == 4, length(bare.answers) == 4,
            length(gone.events) == 0, length(bare.events) == 0,
            planTotal(gone.answers, 0) == 0, planTotal(gone.answers, 1) == 0, planTotal(gone.answers, 2) == 0, planTotal(gone.answers, 3) == 0,
            planTotal(bare.answers, 0) == 0, planTotal(bare.answers, 1) == 0, planTotal(bare.answers, 2) == 0, planTotal(bare.answers, 3) == 0,
            planCount(gone.answers, 0) == 0, planCount(gone.answers, 1) == 0, planCount(gone.answers, 2) == 0, planCount(gone.answers, 3) == 0,
            planCount(bare.answers, 0) == 0, planCount(bare.answers, 3) == 0,
            planFlags(gone.answers, 1, true, false), planFlags(gone.answers, 3, false, false),
            planFlags(bare.answers, 0, false, false), planFlags(bare.answers, 2, false, false),
            structuralEquals(gone.items, []), structuralEquals(bare.items, []),
            structuralEquals(gone.lists, lists), structuralEquals(bare.lists, lists)
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] one done row: page 1 of 5/10/50 answers it
    /// with `done` carried through, page 2 of 5 answers empty but hasPrevious true
    /// (pageNumber > 1 regardless). [MULTI-REPLAY] the stored row keeps done true,
    /// untouched by any branch, and no event publishes for a plain read.
    export fn planOneItemCase() = {
        let seeds = planSeeds(1, ["Q"], ["Q"])
        let done = [spec(1, "Q", true)]
        // totalCount 1: page 2 is empty; hasNext 5 < 1, 10 < 1 and 50 < 1 are all false
        planCase(TodoHarness::seedList(1, "Solo", "#D98B2B"), seeds,
            planSplit(done, [], 1, false, false),
            fn(plan) => [
                planShows(plan.answers, 0, ["Q"], [1]), structuralEquals(planTitles(plan.answers, 1), []),
                planShows(plan.answers, 2, ["Q"], [1]), planShows(plan.answers, 3, ["Q"], [1]),
                planShaped(plan.answers, 1, [1, 0, 1, 1], [false, false, false, false]),
                planRowIs(plan.answers, 0, 0, spec(1, "Q", true)), planRowIs(plan.answers, 3, 0, spec(1, "Q", true)),
                structuralEquals(planStoredTitles(plan.items), ["Q"]),
                structuralEquals(planStoredDones(plan.items), [true])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] four titles in numeric-lex order ("1" is a
    /// prefix of "10" and "1..." sorts before "2..."): title order 1,10,2,20 differs
    /// from the seed order [10,2,1,20] and from id order. Page 2 of 5 is empty with
    /// hasPrevious true, and every hasNext is false because 5, 10 and 50 all pass 4.
    export fn planFourItemsCase() = {
        let seeds = planSeeds(1, ["10", "2", "1", "20"], ["2"])
        let rows = [spec(3, "1", false), spec(1, "10", false), spec(2, "2", true), spec(4, "20", false)]
        // sorted 1(id3), 10(id1), 2(id2, done), 20(id4); N=4: (2,5) empty, all hasNext false
        planCase(TodoHarness::seedList(1, "Digits", "#4CAF50"), seeds,
            planSplit(rows, [], 4, false, false),
            fn(plan) => [
                planShows(plan.answers, 0, ["1", "10", "2", "20"], [3, 1, 2, 4]), structuralEquals(planTitles(plan.answers, 1), []),
                planShows(plan.answers, 2, ["1", "10", "2", "20"], [3, 1, 2, 4]), structuralEquals(planTitles(plan.answers, 3), ["1", "10", "2", "20"]),
                planShaped(plan.answers, 4, [4, 0, 4, 4], [false, false, false, false]),
                planRowIs(plan.answers, 0, 2, spec(2, "2", true)), planRowIs(plan.answers, 3, 0, spec(3, "1", false)),
                structuralEquals(planStoredTitles(plan.items), ["10", "2", "1", "20"]),
                structuralEquals(retryItemIds(plan.items), [1, 2, 3, 4]), structuralEquals(planStoredDones(plan.items), [false, true, false, false])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] exactly five rows, the (1,5) boundary: page
    /// 1 of 5 fills up with hasNext false (5 < 5 fails), page 2 of 5 is empty with
    /// hasPrevious true, and pages 1 of 10/50 repeat all five. Seeds [m,k,i,g,e] sort
    /// to e,g,i,k,m — the exact reverse of both seed and id order.
    export fn planExactlyFiveCase() = {
        let seeds = planSeeds(1, ["m", "k", "i", "g", "e"], [])
        let rows = [spec(5, "e", false), spec(4, "g", false), spec(3, "i", false), spec(2, "k", false), spec(1, "m", false)]
        // sorted e(id5), g(id4), i(id3), k(id2), m(id1); N=5: (1,5) full with hasNext 5 < 5 false
        planCase(TodoHarness::seedList(1, "Five", "#E05C4D"), seeds,
            planSplit(rows, [], 5, false, false),
            fn(plan) => [
                length(plan.items) == 5,
                planShows(plan.answers, 0, ["e", "g", "i", "k", "m"], [5, 4, 3, 2, 1]), structuralEquals(planTitles(plan.answers, 1), []),
                planShows(plan.answers, 2, ["e", "g", "i", "k", "m"], [5, 4, 3, 2, 1]), planShows(plan.answers, 3, ["e", "g", "i", "k", "m"], [5, 4, 3, 2, 1]),
                planTotal(plan.answers, 0) == 5, planTotal(plan.answers, 1) == 5, planTotal(plan.answers, 2) == 5, planTotal(plan.answers, 3) == 5,
                planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 0,
                planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
                planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
                planRowIs(plan.answers, 0, 0, spec(5, "e", false)), planRowIs(plan.answers, 0, 4, spec(1, "m", false)),
                structuralEquals(planStoredTitles(plan.items), ["m", "k", "i", "g", "e"])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] nine rows: page 1 of 5 stops at five with
    /// hasNext true (5 < 9), page 2 of 5 holds the remaining four in title order with
    /// hasPrevious true and hasNext false (10 passes 9), and pages 1 of 10/50 hold
    /// all nine. The done row "f" keeps its flag through the split.
    export fn planNineItemsCase() = {
        let seeds = planSeeds(1, ["j", "h", "f", "b", "d", "i", "g", "c", "e"], ["f"])
        let first5 = [spec(4, "b", false), spec(8, "c", false), spec(5, "d", false), spec(9, "e", false), spec(3, "f", true)]
        let last4 = [spec(7, "g", false), spec(2, "h", false), spec(6, "i", false), spec(1, "j", false)]
        // sorted b(4),c(8),d(5),e(9),f(3 done),g(7),h(2),i(6),j(1); N=9: 5 + 4 across the (1,5)/(2,5) seam
        planCase(TodoHarness::seedList(1, "Nine", "#AB47BC"), seeds,
            planSplit(first5, last4, 9, true, false),
            fn(plan) => [
                planShows(plan.answers, 0, ["b", "c", "d", "e", "f"], [4, 8, 5, 9, 3]), planShows(plan.answers, 1, ["g", "h", "i", "j"], [7, 2, 6, 1]),
                structuralEquals(planTitles(plan.answers, 2), ["b", "c", "d", "e", "f", "g", "h", "i", "j"]) && structuralEquals(planTitles(plan.answers, 3), ["b", "c", "d", "e", "f", "g", "h", "i", "j"]),
                planShaped(plan.answers, 9, [5, 4, 9, 9], [true, false, false, false]),
                planRowIs(plan.answers, 0, 4, spec(3, "f", true)), planRowIs(plan.answers, 1, 0, spec(7, "g", false)),
                structuralEquals(planStoredTitles(plan.items), ["j", "h", "f", "b", "d", "i", "g", "c", "e"]),
                structuralEquals(planStoredDones(plan.items), [false, false, true, false, false, false, false, false, false])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] exactly ten rows, the (1,10) boundary: page
    /// 1 of 10 answers everything with hasNext false (10 < 10 fails) while page 1 of 5
    /// still splits with hasNext true (5 < 10), and page 2 of 5 answers rows 6..10 in
    /// title order. [MULTI-HANDLE-MANY] four resumptions, readings 6.
    export fn planExactlyTenCase() = {
        let seeds = planSeeds(1, ["r", "p", "n", "l", "t", "j", "h", "f", "v", "x"], ["l"])
        let first5 = [spec(8, "f", false), spec(7, "h", false), spec(6, "j", false), spec(4, "l", true), spec(3, "n", false)]
        let last5 = [spec(2, "p", false), spec(1, "r", false), spec(5, "t", false), spec(9, "v", false), spec(10, "x", false)]
        // sorted f(8),h(7),j(6),l(4 done),n(3),p(2),r(1),t(5),v(9),x(10); N=10: page 2 of 5 is rows 6..10
        planCase(TodoHarness::seedList(1, "Ten", "#78909C"), seeds,
            planSplit(first5, last5, 10, true, false),
            fn(plan) => [
                planShows(plan.answers, 0, ["f", "h", "j", "l", "n"], [8, 7, 6, 4, 3]), planShows(plan.answers, 1, ["p", "r", "t", "v", "x"], [2, 1, 5, 9, 10]),
                structuralEquals(planTitles(plan.answers, 2), ["f", "h", "j", "l", "n", "p", "r", "t", "v", "x"]) && structuralEquals(planTitles(plan.answers, 3), ["f", "h", "j", "l", "n", "p", "r", "t", "v", "x"]),
                planShaped(plan.answers, 10, [5, 5, 10, 10], [true, false, false, false]),
                planRowIs(plan.answers, 0, 3, spec(4, "l", true)), planRowIs(plan.answers, 1, 4, spec(10, "x", false)),
                planRowIs(plan.answers, 2, 9, spec(10, "x", false)),
                structuralEquals(planStoredTitles(plan.items), ["r", "p", "n", "l", "t", "j", "h", "f", "v", "x"])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] eleven rows, the first shape with three
    /// hasNext true: page 1 of 5 has 5 < 11, page 2 of 5 and page 1 of 10 have
    /// 10 < 11, page 1 of 50 fills all eleven. The done row "z5x" sorts between
    /// "z5" and "z6" (prefix rule, then digit order) — character-wise title order.
    export fn planElevenItemsCase() = {
        let seeds = planSeeds(1, ["z1", "z9", "z3", "z7", "z5", "z2", "z8", "z4", "z6", "z0", "z5x"], ["z5x"])
        let z04 = [spec(10, "z0", false), spec(1, "z1", false), spec(6, "z2", false), spec(3, "z3", false), spec(8, "z4", false)]
        let z58 = [spec(5, "z5", false), spec(11, "z5x", true), spec(9, "z6", false), spec(4, "z7", false), spec(7, "z8", false)]
        let all11 = listAppend(listConcat(z04, z58), spec(2, "z9", false))
        // sorted z0(10),z1(1),z2(6),z3(3),z4(8),z5(5),z5x(11 done),z6(9),z7(4),z8(7),z9(2)
        planCase(TodoHarness::seedList(1, "Eleven", "#26A69A"), seeds,
            [pageOf(z04, 11, false, true), pageOf(z58, 11, true, true), pageOf(listConcat(z04, z58), 11, false, true), pageOf(all11, 11, false, false)],
            fn(plan) => [
                planShows(plan.answers, 0, ["z0", "z1", "z2", "z3", "z4"], [10, 1, 6, 3, 8]), planShows(plan.answers, 1, ["z5", "z5x", "z6", "z7", "z8"], [5, 11, 9, 4, 7]),
                planShaped(plan.answers, 11, [5, 5, 10, 11], [true, true, true, false]),
                planRowIs(plan.answers, 1, 1, spec(11, "z5x", true)), planRowIs(plan.answers, 3, 10, spec(2, "z9", false)),
                planRowIs(plan.answers, 0, 0, spec(10, "z0", false)),
                structuralEquals(planStoredTitles(plan.items), ["z1", "z9", "z3", "z7", "z5", "z2", "z8", "z4", "z6", "z0", "z5x"])
            ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] sort stress: digits, upper case and lower
    /// case in one list — character codes order them 1 < 10 < 2 < 20 < A < B < aa <
    /// b < c, which differs from the seed order AND from id order AND from any
    /// case-folded order. [MULTI-HANDLE-MANY] four resumptions of one captured query.
    export fn planSortStressCase() = {
        let seeds = planSeeds(1, ["b", "A", "10", "2", "aa", "B", "1", "20", "c"], ["A"])
        let first5 = [spec(7, "1", false), spec(3, "10", false), spec(4, "2", false), spec(8, "20", false), spec(2, "A", true)]
        let last4 = [spec(6, "B", false), spec(5, "aa", false), spec(1, "b", false), spec(9, "c", false)]
        // sorted 1(7),10(3),2(4),20(8),A(2 done),B(6),aa(5),b(1),c(9) from seeds [b,A,10,2,aa,B,1,20,c]
        planCase(TodoHarness::seedList(1, "Mixed", "#D98B2B"), seeds,
            planSplit(first5, last4, 9, true, false),
            fn(plan) => [
                planShows(plan.answers, 0, ["1", "10", "2", "20", "A"], [7, 3, 4, 8, 2]), planShows(plan.answers, 1, ["B", "aa", "b", "c"], [6, 5, 1, 9]),
                structuralEquals(planTitles(plan.answers, 2), ["1", "10", "2", "20", "A", "B", "aa", "b", "c"]) && structuralEquals(planTitles(plan.answers, 3), ["1", "10", "2", "20", "A", "B", "aa", "b", "c"]),
                planShaped(plan.answers, 9, [5, 4, 9, 9], [true, false, false, false]),
                planRowIs(plan.answers, 0, 4, spec(2, "A", true)), planRowIs(plan.answers, 1, 0, spec(6, "B", false)),
                planRowIs(plan.answers, 1, 3, spec(9, "c", false)),
                structuralEquals(planStoredTitles(plan.items), ["b", "A", "10", "2", "aa", "B", "1", "20", "c"]),
                structuralEquals(retryItemIds(plan.items), [1, 2, 3, 4, 5, 6, 7, 8, 9])
            ])
    }
}
