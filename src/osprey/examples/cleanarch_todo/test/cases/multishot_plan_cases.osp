// Page-plan permutations: one captured pagination query, resumed with four page
// shapes ([EXAMPLE-CLEANARCH-MULTISHOT-PLAN], [MULTI-HANDLE-MANY]). Every case
// asks `PagePlan` over seeded rows and pins all four answers exactly: the rows
// in title order, totalCount, hasPrevious and hasNext. The captured point is
// `Paging.window`, so nothing before it re-runs: one start reading, one settle
// reading per branch and the harness's own reading give `readings == 6`
// ([MULTI-HANDLE-MANY]). A page query writes nothing, so the stored rows stay
// the seeds and no event is published ([MULTI-REPLAY], [MULTI-DECL]).

namespace todo;

import todo::TodoHarness
import todo::TodoProbe

/// `size` copies of "x": the title whose sort rank is its length ("x" < "xx" < "xxx").
fn planWide(size) = foldList(range(0, size) |> toList, "", fn(built, _i) => built + "x")

/// The widths `from` up to and including `to`.
fn planWidths(from, to) = foldList(range(from, satAdd(to, 1)) |> toList, [], fn(acc, w) => listAppend(acc, w))

/// The widths `to` down to 1: the insertion order whose title order is its exact reverse.
fn planDescWidths(to) = foldList(planWidths(1, to), [], fn(acc, w) => listConcat([w], acc))

/// Items in `listId` titled widest-first: width `w` gets id `count - w + 1`, so id 1 sorts last.
fn planWideSeeds(listId, count) = mapList(planDescWidths(count), fn(w) =>
    TodoHarness::seedItem(satAdd(satSub(count, w), 1), listId, planWide(w), false))

/// The branch answer for the wide rows widths `from`..`to` of a `count`-item list (id = count - w + 1);
/// shapes() order is (page 1 of 5), (page 2 of 5), (page 1 of 10), (page 1 of 50).
fn planWidePage(count, from, to, total, hasPrevious, hasNext) = Success { value: ItemsPageView { rows: mapList(planWidths(from, to), fn(w) => ItemView { id: satAdd(satSub(count, w), 1), title: planWide(w), done: false, priority: "None", note: "" }), totalCount: total, hasPrevious: hasPrevious, hasNext: hasNext } }

/// Items titled `titles` in `listId`, seeded in that order (id = position), done exactly for `flipped`.
fn planSeeds(listId, titles, flipped) = foldList(titles, { next: 1, rows: [] }, fn(walk, title) => {
    next: satAdd(walk.next, 1),
    rows: listAppend(walk.rows, TodoHarness::seedItem(walk.next, listId, title, listContains(flipped, title)))
}).rows

/// The branch answer for rows `specs` (a seeded row exactly as every query reports it), the stored count and the flags.
fn planPage(specs, total, hasPrevious, hasNext) = Success { value: ItemsPageView { rows: mapList(specs, fn(spec) => ItemView { id: spec.id, title: spec.title, done: spec.done, priority: "None", note: "" }), totalCount: total, hasPrevious: hasPrevious, hasNext: hasNext } }

/// The rows the `at`th branch answered ([] when the branch is missing or misshaped).
fn planRows(answers, at) = match listGet(answers, at) {
    Success { value: Success { value: ItemsPageView { rows } } } => rows
    _ => []
}

/// The row titles / ids / count the `at`th branch answered, in answer order.
fn planTitles(answers, at) = mapList(planRows(answers, at), fn(row) => row.title)

fn planIds(answers, at) = mapList(planRows(answers, at), fn(row) => row.id)

fn planCount(answers, at) = length(planRows(answers, at))

/// The totalCount the `at`th branch answered (0 - 1 when misshaped: every real total is >= 0).
fn planTotal(answers, at) = match listGet(answers, at) {
    Success { value: Success { value: ItemsPageView { totalCount } } } => totalCount
    _ => 0 - 1
}

/// Both flags the `at`th branch answered: hasPrevious is `pageNumber > 1`, hasNext `page*size < total`.
fn planFlags(answers, at, hasPrevious, hasNext) = match listGet(answers, at) {
    Success { value: Success { value: page } } => page.hasPrevious == hasPrevious && page.hasNext == hasNext
    _ => false
}

/// The `row`th row answered exactly as `spec`, with the seeded priority "None" and note "".
fn planRowIs(answers, at, row, spec) = match listGet(planRows(answers, at), row) {
    Success { value: answer } => answer.id == spec.id && answer.title == spec.title && answer.done == spec.done && answer.priority == "None" && answer.note == ""
    _ => false
}

/// The stored rows as the queries see them, in stored order.
fn planStoredTitles(items) = mapList(items, fn(item) => item.title)

fn planStoredIds(items) = mapList(items, fn(item) => item.id)

fn planStoredDones(items) = mapList(items, fn(item) => item.done)

module MultishotPlanCases {
    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] the four shapes in shapes() order over six
    /// unsorted rows: title order d,n,o,p,s,t comes from seeds [t,o,d,s,p,n] (ids 1..6,
    /// "p" done), so sorted ids are [3,2,6,5,4,1] — by title, not id or seed order.
    /// [MULTI-HANDLE-MANY] one start + one settle reading per branch + the harness
    /// reading = readings 6; [MULTI-REPLAY] a page query writes nothing.
    export fn planShapesOrderCase() = {
        let seeds = planSeeds(1, ["t", "o", "d", "s", "p", "n"], ["p"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Work", "#78909C")], seeds, PagePlan { listId: 1 })
        let first5 = [{ id: 3, title: "d", done: false }, { id: 6, title: "n", done: false }, { id: 2, title: "o", done: false }, { id: 5, title: "p", done: true }, { id: 4, title: "s", done: false }]
        let all6 = listAppend(first5, { id: 1, title: "t", done: false })
        // N=6: (1,5) five rows, hasNext 5 < 6 true; (2,5) the sixth alone; (1,10) and (1,50) all six
        expect(plan.answers, [planPage(first5, 6, false, true), planPage([{ id: 1, title: "t", done: false }], 6, true, false), planPage(all6, 6, false, false), planPage(all6, 6, false, false)])
        checkAll("four resumptions in shapes() order; sorting is by title, not id or seed order", [
            structuralEquals(TodoProbe::shapes(), ["page 1 of 5", "page 2 of 5", "page 1 of 10", "page 1 of 50"]),
            length(TodoProbe::shapes()) == 4,
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 6,
            structuralEquals(planTitles(plan.answers, 0), ["d", "n", "o", "p", "s"]), structuralEquals(planTitles(plan.answers, 1), ["t"]),
            structuralEquals(planTitles(plan.answers, 2), ["d", "n", "o", "p", "s", "t"]), structuralEquals(planTitles(plan.answers, 3), ["d", "n", "o", "p", "s", "t"]),
            structuralEquals(planIds(plan.answers, 0), [3, 2, 6, 5, 4]), structuralEquals(planIds(plan.answers, 1), [1]),
            planTotal(plan.answers, 0) == 6, planTotal(plan.answers, 1) == 6, planTotal(plan.answers, 2) == 6, planTotal(plan.answers, 3) == 6,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 1, planCount(plan.answers, 2) == 6, planCount(plan.answers, 3) == 6,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 0, { id: 3, title: "d", done: false }), planRowIs(plan.answers, 0, 3, { id: 5, title: "p", done: true }),
            planRowIs(plan.answers, 1, 0, { id: 1, title: "t", done: false }),
            structuralEquals(plan.items, seeds),
            structuralEquals(plan.lists, [TodoHarness::seedList(1, "Work", "#78909C")])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] zero rows in the asked list: every branch
    /// answers an empty page with totalCount 0 and hasNext false, while branch 2 still
    /// answers hasPrevious true (pageNumber > 1, however few rows). The two rows of the
    /// other list never leak in: the page filters items by the asked listId only.
    export fn planEmptyListCase() = {
        let others = planSeeds(2, ["K1", "K2"], [])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Empty", "#26A69A")], others, PagePlan { listId: 1 })
        // no rows in list 1: rows [], totalCount 0, hasNext p*s < 0 false; branch 2 keeps hasPrevious true
        expect(plan.answers, [planPage([], 0, false, false), planPage([], 0, true, false), planPage([], 0, false, false), planPage([], 0, false, false)])
        checkAll("four empty pages for the asked list only; the other list's rows stay put", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 2,
            structuralEquals(planTitles(plan.answers, 0), []), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), []), structuralEquals(planTitles(plan.answers, 3), []),
            structuralEquals(planRows(plan.answers, 0), []), structuralEquals(planRows(plan.answers, 1), []),
            planTotal(plan.answers, 0) == 0, planTotal(plan.answers, 1) == 0, planTotal(plan.answers, 2) == 0, planTotal(plan.answers, 3) == 0,
            planCount(plan.answers, 0) == 0, planCount(plan.answers, 1) == 0, planCount(plan.answers, 2) == 0, planCount(plan.answers, 3) == 0,
            planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            structuralEquals(plan.items, others), structuralEquals(planStoredTitles(plan.items), ["K1", "K2"]),
            structuralEquals(planStoredIds(plan.items), [1, 2]), structuralEquals(planStoredDones(plan.items), [false, false]),
            structuralEquals(plan.lists, [TodoHarness::seedList(1, "Empty", "#26A69A")])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] a listId with no rows answers four empty
    /// pages — never NotFound: the page query filters items by listId and never reads
    /// the list row itself, so a missing id and an existing but bare list row plan
    /// the same four pages ([MULTI-HANDLE-MANY] readings 6 for each ask).
    export fn planMissingListCase() = {
        let lists = [TodoHarness::seedList(1, "Work", "#5C6BC0")]
        let gone = TodoHarness::probed(TodoHarness::admin(), lists, [], PagePlan { listId: 99 })
        let bare = TodoHarness::probed(TodoHarness::admin(), lists, [], PagePlan { listId: 1 })
        // no items anywhere: both asks plan four empty pages; hasPrevious follows pageNumber alone
        let empty = [planPage([], 0, false, false), planPage([], 0, true, false), planPage([], 0, false, false), planPage([], 0, false, false)]
        expect(gone.answers, empty)
        expect(bare.answers, empty)
        checkAll("a missing listId and a bare list row both plan four empty pages", [
            gone.readings == 6, bare.readings == 6,
            length(gone.answers) == 4, length(bare.answers) == 4,
            length(gone.events) == 0, length(bare.events) == 0,
            planTotal(gone.answers, 0) == 0, planTotal(gone.answers, 1) == 0, planTotal(gone.answers, 2) == 0, planTotal(gone.answers, 3) == 0,
            planTotal(bare.answers, 0) == 0, planTotal(bare.answers, 1) == 0, planTotal(bare.answers, 2) == 0, planTotal(bare.answers, 3) == 0,
            planCount(gone.answers, 0) == 0, planCount(gone.answers, 1) == 0, planCount(gone.answers, 2) == 0, planCount(gone.answers, 3) == 0,
            planCount(bare.answers, 0) == 0, planCount(bare.answers, 3) == 0,
            planFlags(gone.answers, 1, true, false), planFlags(gone.answers, 3, false, false),
            planFlags(bare.answers, 0, false, false), planFlags(bare.answers, 2, false, false),
            structuralEquals(gone.items, []), structuralEquals(bare.items, []),
            structuralEquals(gone.lists, lists), structuralEquals(bare.lists, lists)
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] one done row: page 1 of 5/10/50 answers it
    /// with `done` carried through, page 2 of 5 answers empty but hasPrevious true
    /// (pageNumber > 1 regardless). [MULTI-REPLAY] the stored row keeps done true,
    /// untouched by any branch, and no event publishes for a plain read.
    export fn planOneItemCase() = {
        let seeds = planSeeds(1, ["Q"], ["Q"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Solo", "#D98B2B")], seeds, PagePlan { listId: 1 })
        let done = [{ id: 1, title: "Q", done: true }]
        // totalCount 1: page 2 is empty; hasNext 5 < 1, 10 < 1 and 50 < 1 are all false
        expect(plan.answers, [planPage(done, 1, false, false), planPage([], 1, true, false), planPage(done, 1, false, false), planPage(done, 1, false, false)])
        checkAll("the single done row repeats on pages 1 of 5/10/50 and never on page 2", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["Q"]), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), ["Q"]), structuralEquals(planTitles(plan.answers, 3), ["Q"]),
            structuralEquals(planIds(plan.answers, 0), [1]), structuralEquals(planIds(plan.answers, 2), [1]), structuralEquals(planIds(plan.answers, 3), [1]),
            planTotal(plan.answers, 0) == 1, planTotal(plan.answers, 1) == 1, planTotal(plan.answers, 2) == 1, planTotal(plan.answers, 3) == 1,
            planCount(plan.answers, 0) == 1, planCount(plan.answers, 1) == 0, planCount(plan.answers, 2) == 1, planCount(plan.answers, 3) == 1,
            planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 0, { id: 1, title: "Q", done: true }), planRowIs(plan.answers, 3, 0, { id: 1, title: "Q", done: true }),
            structuralEquals(plan.items, seeds), structuralEquals(planStoredTitles(plan.items), ["Q"]),
            structuralEquals(planStoredDones(plan.items), [true]),
            structuralEquals(plan.lists, [TodoHarness::seedList(1, "Solo", "#D98B2B")])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] four titles in numeric-lex order ("1" is a
    /// prefix of "10" and "1..." sorts before "2..."): title order 1,10,2,20 differs
    /// from the seed order [10,2,1,20] and from id order. Page 2 of 5 is empty with
    /// hasPrevious true, and every hasNext is false because 5, 10 and 50 all pass 4.
    export fn planFourItemsCase() = {
        let seeds = planSeeds(1, ["10", "2", "1", "20"], ["2"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Digits", "#4CAF50")], seeds, PagePlan { listId: 1 })
        let rows = [{ id: 3, title: "1", done: false }, { id: 1, title: "10", done: false }, { id: 2, title: "2", done: true }, { id: 4, title: "20", done: false }]
        // sorted 1(id3), 10(id1), 2(id2, done), 20(id4); N=4: (2,5) empty, all hasNext false
        expect(plan.answers, [planPage(rows, 4, false, false), planPage([], 4, true, false), planPage(rows, 4, false, false), planPage(rows, 4, false, false)])
        checkAll("title order 1,10,2,20 on pages 1 of 5/10/50; page 2 of 5 plans nothing", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["1", "10", "2", "20"]), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), ["1", "10", "2", "20"]), structuralEquals(planTitles(plan.answers, 3), ["1", "10", "2", "20"]),
            structuralEquals(planIds(plan.answers, 0), [3, 1, 2, 4]), structuralEquals(planIds(plan.answers, 2), [3, 1, 2, 4]),
            planTotal(plan.answers, 0) == 4, planTotal(plan.answers, 1) == 4, planTotal(plan.answers, 2) == 4, planTotal(plan.answers, 3) == 4,
            planCount(plan.answers, 0) == 4, planCount(plan.answers, 1) == 0, planCount(plan.answers, 2) == 4, planCount(plan.answers, 3) == 4,
            planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 2, { id: 2, title: "2", done: true }), planRowIs(plan.answers, 3, 0, { id: 3, title: "1", done: false }),
            structuralEquals(plan.items, seeds), structuralEquals(planStoredTitles(plan.items), ["10", "2", "1", "20"]),
            structuralEquals(planStoredIds(plan.items), [1, 2, 3, 4]), structuralEquals(planStoredDones(plan.items), [false, false, true, false])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] exactly five rows, the (1,5) boundary: page
    /// 1 of 5 fills up with hasNext false (5 < 5 fails), page 2 of 5 is empty with
    /// hasPrevious true, and pages 1 of 10/50 repeat all five. Seeds [m,k,i,g,e] sort
    /// to e,g,i,k,m — the exact reverse of both seed and id order.
    export fn planExactlyFiveCase() = {
        let seeds = planSeeds(1, ["m", "k", "i", "g", "e"], [])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Five", "#E05C4D")], seeds, PagePlan { listId: 1 })
        let rows = [{ id: 5, title: "e", done: false }, { id: 4, title: "g", done: false }, { id: 3, title: "i", done: false }, { id: 2, title: "k", done: false }, { id: 1, title: "m", done: false }]
        // sorted e(id5), g(id4), i(id3), k(id2), m(id1); N=5: (1,5) full with hasNext 5 < 5 false
        expect(plan.answers, [planPage(rows, 5, false, false), planPage([], 5, true, false), planPage(rows, 5, false, false), planPage(rows, 5, false, false)])
        checkAll("five rows on pages 1 of 5/10/50 and an empty page 2; the page boundary holds", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 5,
            structuralEquals(planTitles(plan.answers, 0), ["e", "g", "i", "k", "m"]), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), ["e", "g", "i", "k", "m"]), structuralEquals(planTitles(plan.answers, 3), ["e", "g", "i", "k", "m"]),
            structuralEquals(planIds(plan.answers, 0), [5, 4, 3, 2, 1]), structuralEquals(planIds(plan.answers, 2), [5, 4, 3, 2, 1]),
            structuralEquals(planIds(plan.answers, 3), [5, 4, 3, 2, 1]),
            planTotal(plan.answers, 0) == 5, planTotal(plan.answers, 1) == 5, planTotal(plan.answers, 2) == 5, planTotal(plan.answers, 3) == 5,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 0,
            planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 0, { id: 5, title: "e", done: false }), planRowIs(plan.answers, 0, 4, { id: 1, title: "m", done: false }),
            structuralEquals(plan.items, seeds), structuralEquals(planStoredTitles(plan.items), ["m", "k", "i", "g", "e"])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] nine rows: page 1 of 5 stops at five with
    /// hasNext true (5 < 9), page 2 of 5 holds the remaining four in title order with
    /// hasPrevious true and hasNext false (10 passes 9), and pages 1 of 10/50 hold
    /// all nine. The done row "f" keeps its flag through the split.
    export fn planNineItemsCase() = {
        let seeds = planSeeds(1, ["j", "h", "f", "b", "d", "i", "g", "c", "e"], ["f"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Nine", "#AB47BC")], seeds, PagePlan { listId: 1 })
        let first5 = [{ id: 4, title: "b", done: false }, { id: 8, title: "c", done: false }, { id: 5, title: "d", done: false }, { id: 9, title: "e", done: false }, { id: 3, title: "f", done: true }]
        let last4 = [{ id: 7, title: "g", done: false }, { id: 2, title: "h", done: false }, { id: 6, title: "i", done: false }, { id: 1, title: "j", done: false }]
        let all9 = listConcat(first5, last4)
        // sorted b(4),c(8),d(5),e(9),f(3 done),g(7),h(2),i(6),j(1); N=9: 5 + 4 across the (1,5)/(2,5) seam
        expect(plan.answers, [planPage(first5, 9, false, true), planPage(last4, 9, true, false), planPage(all9, 9, false, false), planPage(all9, 9, false, false)])
        checkAll("5 + 4 rows split at the (1,5)/(2,5) seam, then all nine twice over", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["b", "c", "d", "e", "f"]), structuralEquals(planTitles(plan.answers, 1), ["g", "h", "i", "j"]),
            structuralEquals(planTitles(plan.answers, 2), ["b", "c", "d", "e", "f", "g", "h", "i", "j"]),
            structuralEquals(planTitles(plan.answers, 3), ["b", "c", "d", "e", "f", "g", "h", "i", "j"]),
            structuralEquals(planIds(plan.answers, 0), [4, 8, 5, 9, 3]), structuralEquals(planIds(plan.answers, 1), [7, 2, 6, 1]),
            planTotal(plan.answers, 0) == 9, planTotal(plan.answers, 1) == 9, planTotal(plan.answers, 2) == 9, planTotal(plan.answers, 3) == 9,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 4, planCount(plan.answers, 2) == 9, planCount(plan.answers, 3) == 9,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 4, { id: 3, title: "f", done: true }), planRowIs(plan.answers, 1, 0, { id: 7, title: "g", done: false }),
            structuralEquals(plan.items, seeds),
            structuralEquals(planStoredTitles(plan.items), ["j", "h", "f", "b", "d", "i", "g", "c", "e"]),
            structuralEquals(planStoredDones(plan.items), [false, false, true, false, false, false, false, false, false])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] exactly ten rows, the (1,10) boundary: page
    /// 1 of 10 answers everything with hasNext false (10 < 10 fails) while page 1 of 5
    /// still splits with hasNext true (5 < 10), and page 2 of 5 answers rows 6..10 in
    /// title order. [MULTI-HANDLE-MANY] four resumptions, readings 6.
    export fn planExactlyTenCase() = {
        let seeds = planSeeds(1, ["r", "p", "n", "l", "t", "j", "h", "f", "v", "x"], ["l"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Ten", "#78909C")], seeds, PagePlan { listId: 1 })
        let first5 = [{ id: 8, title: "f", done: false }, { id: 7, title: "h", done: false }, { id: 6, title: "j", done: false }, { id: 4, title: "l", done: true }, { id: 3, title: "n", done: false }]
        let last5 = [{ id: 2, title: "p", done: false }, { id: 1, title: "r", done: false }, { id: 5, title: "t", done: false }, { id: 9, title: "v", done: false }, { id: 10, title: "x", done: false }]
        let all10 = listConcat(first5, last5)
        // sorted f(8),h(7),j(6),l(4 done),n(3),p(2),r(1),t(5),v(9),x(10); N=10: page 2 of 5 is rows 6..10
        expect(plan.answers, [planPage(first5, 10, false, true), planPage(last5, 10, true, false), planPage(all10, 10, false, false), planPage(all10, 10, false, false)])
        checkAll("5 + 5 rows on pages of 5; one full page of 10 twice with hasNext false", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["f", "h", "j", "l", "n"]), structuralEquals(planTitles(plan.answers, 1), ["p", "r", "t", "v", "x"]),
            structuralEquals(planTitles(plan.answers, 2), ["f", "h", "j", "l", "n", "p", "r", "t", "v", "x"]),
            structuralEquals(planTitles(plan.answers, 3), ["f", "h", "j", "l", "n", "p", "r", "t", "v", "x"]),
            structuralEquals(planIds(plan.answers, 0), [8, 7, 6, 4, 3]), structuralEquals(planIds(plan.answers, 1), [2, 1, 5, 9, 10]),
            planTotal(plan.answers, 0) == 10, planTotal(plan.answers, 1) == 10, planTotal(plan.answers, 2) == 10, planTotal(plan.answers, 3) == 10,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 5, planCount(plan.answers, 2) == 10, planCount(plan.answers, 3) == 10,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 3, { id: 4, title: "l", done: true }), planRowIs(plan.answers, 1, 4, { id: 10, title: "x", done: false }),
            planRowIs(plan.answers, 2, 9, { id: 10, title: "x", done: false }),
            structuralEquals(plan.items, seeds),
            structuralEquals(planStoredTitles(plan.items), ["r", "p", "n", "l", "t", "j", "h", "f", "v", "x"])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] eleven rows, the first shape with three
    /// hasNext true: page 1 of 5 has 5 < 11, page 2 of 5 and page 1 of 10 have
    /// 10 < 11, page 1 of 50 fills all eleven. The done row "z5x" sorts between
    /// "z5" and "z6" (prefix rule, then digit order) — character-wise title order.
    export fn planElevenItemsCase() = {
        let seeds = planSeeds(1, ["z1", "z9", "z3", "z7", "z5", "z2", "z8", "z4", "z6", "z0", "z5x"], ["z5x"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Eleven", "#26A69A")], seeds, PagePlan { listId: 1 })
        let z04 = [{ id: 10, title: "z0", done: false }, { id: 1, title: "z1", done: false }, { id: 6, title: "z2", done: false }, { id: 3, title: "z3", done: false }, { id: 8, title: "z4", done: false }]
        let z58 = [{ id: 5, title: "z5", done: false }, { id: 11, title: "z5x", done: true }, { id: 9, title: "z6", done: false }, { id: 4, title: "z7", done: false }, { id: 7, title: "z8", done: false }]
        let all11 = listAppend(listConcat(z04, z58), { id: 2, title: "z9", done: false })
        // sorted z0(10),z1(1),z2(6),z3(3),z4(8),z5(5),z5x(11 done),z6(9),z7(4),z8(7),z9(2)
        expect(plan.answers, [planPage(z04, 11, false, true), planPage(z58, 11, true, true), planPage(listConcat(z04, z58), 11, false, true), planPage(all11, 11, false, false)])
        checkAll("5 + 5 + 10 + 11 rows; z5x sorts between z5 and z6 by characters alone", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["z0", "z1", "z2", "z3", "z4"]), structuralEquals(planTitles(plan.answers, 1), ["z5", "z5x", "z6", "z7", "z8"]),
            structuralEquals(planTitles(plan.answers, 2), ["z0", "z1", "z2", "z3", "z4", "z5", "z5x", "z6", "z7", "z8"]),
            structuralEquals(planTitles(plan.answers, 3), ["z0", "z1", "z2", "z3", "z4", "z5", "z5x", "z6", "z7", "z8", "z9"]),
            structuralEquals(planIds(plan.answers, 0), [10, 1, 6, 3, 8]), structuralEquals(planIds(plan.answers, 1), [5, 11, 9, 4, 7]),
            planTotal(plan.answers, 0) == 11, planTotal(plan.answers, 1) == 11, planTotal(plan.answers, 2) == 11, planTotal(plan.answers, 3) == 11,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 5, planCount(plan.answers, 2) == 10, planCount(plan.answers, 3) == 11,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, true),
            planFlags(plan.answers, 2, false, true), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 1, 1, { id: 11, title: "z5x", done: true }), planRowIs(plan.answers, 3, 10, { id: 2, title: "z9", done: false }),
            planRowIs(plan.answers, 0, 0, { id: 10, title: "z0", done: false }),
            structuralEquals(plan.items, seeds),
            structuralEquals(planStoredTitles(plan.items), ["z1", "z9", "z3", "z7", "z5", "z2", "z8", "z4", "z6", "z0", "z5x"])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] sort stress: digits, upper case and lower
    /// case in one list — character codes order them 1 < 10 < 2 < 20 < A < B < aa <
    /// b < c, which differs from the seed order AND from id order AND from any
    /// case-folded order. [MULTI-HANDLE-MANY] four resumptions of one captured query.
    export fn planSortStressCase() = {
        let seeds = planSeeds(1, ["b", "A", "10", "2", "aa", "B", "1", "20", "c"], ["A"])
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Mixed", "#D98B2B")], seeds, PagePlan { listId: 1 })
        let first5 = [{ id: 7, title: "1", done: false }, { id: 3, title: "10", done: false }, { id: 4, title: "2", done: false }, { id: 8, title: "20", done: false }, { id: 2, title: "A", done: true }]
        let last4 = [{ id: 6, title: "B", done: false }, { id: 5, title: "aa", done: false }, { id: 1, title: "b", done: false }, { id: 9, title: "c", done: false }]
        let all9 = listConcat(first5, last4)
        // sorted 1(7),10(3),2(4),20(8),A(2 done),B(6),aa(5),b(1),c(9) from seeds [b,A,10,2,aa,B,1,20,c]
        expect(plan.answers, [planPage(first5, 9, false, true), planPage(last4, 9, true, false), planPage(all9, 9, false, false), planPage(all9, 9, false, false)])
        checkAll("digits before upper case before lower case, on every page shape", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["1", "10", "2", "20", "A"]), structuralEquals(planTitles(plan.answers, 1), ["B", "aa", "b", "c"]),
            structuralEquals(planTitles(plan.answers, 2), ["1", "10", "2", "20", "A", "B", "aa", "b", "c"]),
            structuralEquals(planTitles(plan.answers, 3), ["1", "10", "2", "20", "A", "B", "aa", "b", "c"]),
            structuralEquals(planIds(plan.answers, 0), [7, 3, 4, 8, 2]), structuralEquals(planIds(plan.answers, 1), [6, 5, 1, 9]),
            planTotal(plan.answers, 0) == 9, planTotal(plan.answers, 1) == 9, planTotal(plan.answers, 2) == 9, planTotal(plan.answers, 3) == 9,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 4, planCount(plan.answers, 2) == 9, planCount(plan.answers, 3) == 9,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 4, { id: 2, title: "A", done: true }), planRowIs(plan.answers, 1, 0, { id: 6, title: "B", done: false }),
            planRowIs(plan.answers, 1, 3, { id: 9, title: "c", done: false }),
            structuralEquals(plan.items, seeds),
            structuralEquals(planStoredTitles(plan.items), ["b", "A", "10", "2", "aa", "B", "1", "20", "c"]),
            structuralEquals(planStoredIds(plan.items), [1, 2, 3, 4, 5, 6, 7, 8, 9])
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] rows spread over three lists (4, 5 and 6
    /// items): only the asked list's rows are planned, per ask — the other lists'
    /// rows never appear, and totalCount counts the asked list alone. Each ask is
    /// its own capture ([MULTI-HANDLE-MANY], readings 6 each); [MULTI-REPLAY] no
    /// branch writes, so all three sees the same untouched store.
    export fn planMultiListCase() = {
        let seeds = listConcat(listConcat(planSeeds(1, ["a1", "a3", "a2", "a4"], ["a3"]), planSeeds(2, ["b2", "b1", "b4", "b3", "b5"], ["b4"])), planSeeds(3, ["c3", "c1", "c2", "c6", "c4", "c5"], ["c6"]))
        let lists = [TodoHarness::seedList(1, "Alpha", "#5C6BC0"), TodoHarness::seedList(2, "Beta", "#AB47BC"), TodoHarness::seedList(3, "Gamma", "#E05C4D")]
        let one = TodoHarness::probed(TodoHarness::admin(), lists, seeds, PagePlan { listId: 1 })
        let two = TodoHarness::probed(TodoHarness::admin(), lists, seeds, PagePlan { listId: 2 })
        let three = TodoHarness::probed(TodoHarness::admin(), lists, seeds, PagePlan { listId: 3 })
        // list 1 sorted a1(1),a2(3),a3(2 done),a4(4), N=4; list 2 sorted b1(2),b2(1),b3(4),b4(3 done),b5(5), N=5;
        // list 3 sorted c1(2),c2(3),c3(1),c4(5),c5(6),c6(4 done), N=6: (1,5) five rows hasNext true, (2,5) the sixth
        let a = [{ id: 1, title: "a1", done: false }, { id: 3, title: "a2", done: false }, { id: 2, title: "a3", done: true }, { id: 4, title: "a4", done: false }]
        let b = [{ id: 2, title: "b1", done: false }, { id: 1, title: "b2", done: false }, { id: 4, title: "b3", done: false }, { id: 3, title: "b4", done: true }, { id: 5, title: "b5", done: false }]
        let c5 = [{ id: 2, title: "c1", done: false }, { id: 3, title: "c2", done: false }, { id: 1, title: "c3", done: false }, { id: 5, title: "c4", done: false }, { id: 6, title: "c5", done: false }]
        let c = listAppend(c5, { id: 4, title: "c6", done: true })
        expect(one.answers, [planPage(a, 4, false, false), planPage([], 4, true, false), planPage(a, 4, false, false), planPage(a, 4, false, false)])
        expect(two.answers, [planPage(b, 5, false, false), planPage([], 5, true, false), planPage(b, 5, false, false), planPage(b, 5, false, false)])
        expect(three.answers, [planPage(c5, 6, false, true), planPage([{ id: 4, title: "c6", done: true }], 6, true, false), planPage(c, 6, false, false), planPage(c, 6, false, false)])
        checkAll("three asks, one list each; every ask sees the same untouched store", [
            one.readings == 6, two.readings == 6, three.readings == 6,
            length(one.answers) == 4, length(two.answers) == 4, length(three.answers) == 4,
            length(one.events) == 0, length(two.events) == 0, length(three.events) == 0, length(seeds) == 15,
            planTotal(one.answers, 0) == 4, planTotal(two.answers, 0) == 5, planTotal(three.answers, 0) == 6,
            planCount(one.answers, 0) == 4, planCount(one.answers, 1) == 0,
            planCount(two.answers, 0) == 5, planCount(two.answers, 1) == 0,
            planCount(three.answers, 0) == 5, planCount(three.answers, 1) == 1, planCount(three.answers, 3) == 6,
            planFlags(one.answers, 1, true, false), planFlags(two.answers, 1, true, false),
            planFlags(three.answers, 0, false, true), planFlags(three.answers, 1, true, false), planFlags(three.answers, 3, false, false),
            structuralEquals(planTitles(one.answers, 0), ["a1", "a2", "a3", "a4"]),
            structuralEquals(planTitles(two.answers, 0), ["b1", "b2", "b3", "b4", "b5"]),
            structuralEquals(planTitles(three.answers, 1), ["c6"]),
            planRowIs(one.answers, 0, 2, { id: 2, title: "a3", done: true }), planRowIs(two.answers, 0, 3, { id: 3, title: "b4", done: true }),
            planRowIs(three.answers, 1, 0, { id: 4, title: "c6", done: true }),
            structuralEquals(one.items, seeds), structuralEquals(two.items, seeds), structuralEquals(three.items, seeds),
            structuralEquals(one.lists, lists), structuralEquals(three.lists, lists)
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] 49 rows seeded widest-first, so title order
    /// ("x" < "xx" < ...) is the exact reverse of id and seed order: width w carries
    /// id 50 - w. Every hasNext on pages of 5 and 10 is true (5, 10 < 49); page 1 of
    /// 50 answers all 49 with hasNext false (50 < 49 fails).
    export fn planWide49Case() = {
        let seeds = planWideSeeds(1, 49)
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Wide", "#AB47BC")], seeds, PagePlan { listId: 1 })
        // (1,5) widths 1..5, hasNext 5<49 true; (2,5) widths 6..10, hasNext 10<49 true; (1,10) hasNext true; (1,50) all, hasNext false
        expect(plan.answers, [planWidePage(49, 1, 5, 49, false, true), planWidePage(49, 6, 10, 49, true, true), planWidePage(49, 1, 10, 49, false, true), planWidePage(49, 1, 49, 49, false, false)])
        checkAll("49 widest-first rows plan as widths 1..5, 6..10, 1..10 and 1..49", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 49,
            structuralEquals(plan.items, seeds),
            structuralEquals(planTitles(plan.answers, 0), mapList(planWidths(1, 5), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 1), mapList(planWidths(6, 10), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 3), mapList(planWidths(1, 49), fn(w) => planWide(w))),
            structuralEquals(planIds(plan.answers, 0), [49, 48, 47, 46, 45]), structuralEquals(planIds(plan.answers, 1), [44, 43, 42, 41, 40]),
            structuralEquals(planIds(plan.answers, 2), mapList(planWidths(1, 10), fn(w) => satSub(50, w))),
            planTotal(plan.answers, 0) == 49, planTotal(plan.answers, 1) == 49, planTotal(plan.answers, 2) == 49, planTotal(plan.answers, 3) == 49,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 5, planCount(plan.answers, 2) == 10, planCount(plan.answers, 3) == 49,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, true),
            planFlags(plan.answers, 2, false, true), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 0, { id: 49, title: planWide(1), done: false }), planRowIs(plan.answers, 1, 4, { id: 40, title: planWide(10), done: false }),
            planRowIs(plan.answers, 3, 48, { id: 1, title: planWide(49), done: false }),
            structuralEquals(planStoredDones(plan.items), mapList(planWidths(1, 49), fn(_w) => false))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] 50 rows, the (1,50) boundary: page 1 of 50
    /// answers everything with hasNext false (50 < 50 fails), while pages 1 of 5 and
    /// 1 of 10 still split with hasNext true (5, 10 < 50). Width w carries id 51 - w,
    /// so the widest title (id 1) sorts to the last row of the full page.
    export fn planWide50Case() = {
        let seeds = planWideSeeds(1, 50)
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Wide", "#4CAF50")], seeds, PagePlan { listId: 1 })
        // (1,5) widths 1..5; (2,5) widths 6..10; (1,10) widths 1..10 — hasNext true each; (1,50) all, hasNext 50<50 false
        expect(plan.answers, [planWidePage(50, 1, 5, 50, false, true), planWidePage(50, 6, 10, 50, true, true), planWidePage(50, 1, 10, 50, false, true), planWidePage(50, 1, 50, 50, false, false)])
        checkAll("fifty rows plan as 5, 5, 10 and one full page of 50; the widest sorts last", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 50,
            structuralEquals(plan.items, seeds),
            structuralEquals(planTitles(plan.answers, 0), mapList(planWidths(1, 5), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 1), mapList(planWidths(6, 10), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 2), mapList(planWidths(1, 10), fn(w) => planWide(w))),
            structuralEquals(planIds(plan.answers, 0), [50, 49, 48, 47, 46]), structuralEquals(planIds(plan.answers, 1), [45, 44, 43, 42, 41]),
            structuralEquals(planIds(plan.answers, 3), mapList(planWidths(1, 50), fn(w) => satSub(51, w))),
            planTotal(plan.answers, 0) == 50, planTotal(plan.answers, 1) == 50, planTotal(plan.answers, 2) == 50, planTotal(plan.answers, 3) == 50,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 5, planCount(plan.answers, 2) == 10, planCount(plan.answers, 3) == 50,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, true),
            planFlags(plan.answers, 2, false, true), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 0, { id: 50, title: planWide(1), done: false }), planRowIs(plan.answers, 3, 49, { id: 1, title: planWide(50), done: false }),
            structuralEquals(planStoredTitles(plan.items), mapList(planDescWidths(50), fn(w) => planWide(w)))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] 51 rows: page 1 of 50 answers widths 1..50
    /// with hasNext true (50 < 51), and the widest row (width 51, id 1) appears on no
    /// branch at all — it sorts past every page the four shapes read. Width w gets
    /// id 52 - w. [MULTI-HANDLE-MANY] the same one capture, resumed four times.
    export fn planWide51Case() = {
        let seeds = planWideSeeds(1, 51)
        let plan = TodoHarness::probed(TodoHarness::admin(), [TodoHarness::seedList(1, "Wide", "#78909C")], seeds, PagePlan { listId: 1 })
        // (1,5) hasNext 5<51 true; (2,5) hasNext 10<51 true; (1,10) hasNext true; (1,50) 50 rows, hasNext 50<51 true
        expect(plan.answers, [planWidePage(51, 1, 5, 51, false, true), planWidePage(51, 6, 10, 51, true, true), planWidePage(51, 1, 10, 51, false, true), planWidePage(51, 1, 50, 51, false, true)])
        checkAll("the widest row is planned away; page 1 of 50 stops at width 50 with hasNext true", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0, length(plan.items) == 51,
            structuralEquals(plan.items, seeds),
            structuralEquals(planTitles(plan.answers, 0), mapList(planWidths(1, 5), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 1), mapList(planWidths(6, 10), fn(w) => planWide(w))),
            structuralEquals(planTitles(plan.answers, 3), mapList(planWidths(1, 50), fn(w) => planWide(w))),
            structuralEquals(planIds(plan.answers, 0), [51, 50, 49, 48, 47]), structuralEquals(planIds(plan.answers, 1), [46, 45, 44, 43, 42]),
            structuralEquals(planIds(plan.answers, 3), mapList(planWidths(1, 50), fn(w) => satSub(52, w))),
            listContains(planIds(plan.answers, 3), 1) == false, listContains(planIds(plan.answers, 0), 1) == false,
            planTotal(plan.answers, 0) == 51, planTotal(plan.answers, 1) == 51, planTotal(plan.answers, 2) == 51, planTotal(plan.answers, 3) == 51,
            planCount(plan.answers, 0) == 5, planCount(plan.answers, 1) == 5, planCount(plan.answers, 2) == 10, planCount(plan.answers, 3) == 50,
            planFlags(plan.answers, 0, false, true), planFlags(plan.answers, 1, true, true),
            planFlags(plan.answers, 2, false, true), planFlags(plan.answers, 3, false, true),
            planRowIs(plan.answers, 0, 0, { id: 51, title: planWide(1), done: false }), planRowIs(plan.answers, 3, 49, { id: 2, title: planWide(50), done: false }),
            planRowIs(plan.answers, 2, 9, { id: 42, title: planWide(10), done: false }),
            structuralEquals(planStoredDones(plan.items), mapList(planWidths(1, 51), fn(_w) => false))
        ])
    }

    /// [EXAMPLE-CLEANARCH-MULTISHOT-PLAN] the anonymous party plans pages too: the
    /// pagination query carries no access rule (only GetTodos and PurgeTodoLists
    /// guard themselves), so all four resumptions answer without Unauthorized.
    /// [MULTI-HANDLE-MANY] the same readings 6; [MULTI-REPLAY] the store stays put.
    export fn planAnonymousPlanCase() = {
        let seeds = planSeeds(1, ["p4", "p1", "p3", "p2"], ["p2"])
        let plan = TodoHarness::probed(TodoHarness::anonymous(), [TodoHarness::seedList(1, "Open", "#5C6BC0")], seeds, PagePlan { listId: 1 })
        let rows = [{ id: 2, title: "p1", done: false }, { id: 4, title: "p2", done: true }, { id: 3, title: "p3", done: false }, { id: 1, title: "p4", done: false }]
        // sorted p1(2),p2(4 done),p3(3),p4(1); N=4: (2,5) empty with hasPrevious true, all hasNext false
        expect(plan.answers, [planPage(rows, 4, false, false), planPage([], 4, true, false), planPage(rows, 4, false, false), planPage(rows, 4, false, false)])
        checkAll("no sign-in needed to plan pages; four answers, store untouched", [
            plan.readings == 6, length(plan.answers) == 4, length(plan.events) == 0,
            structuralEquals(planTitles(plan.answers, 0), ["p1", "p2", "p3", "p4"]), structuralEquals(planTitles(plan.answers, 1), []),
            structuralEquals(planTitles(plan.answers, 2), ["p1", "p2", "p3", "p4"]), structuralEquals(planTitles(plan.answers, 3), ["p1", "p2", "p3", "p4"]),
            structuralEquals(planIds(plan.answers, 0), [2, 4, 3, 1]), structuralEquals(planIds(plan.answers, 2), [2, 4, 3, 1]),
            planTotal(plan.answers, 0) == 4, planTotal(plan.answers, 1) == 4, planTotal(plan.answers, 2) == 4, planTotal(plan.answers, 3) == 4,
            planCount(plan.answers, 0) == 4, planCount(plan.answers, 1) == 0, planCount(plan.answers, 2) == 4, planCount(plan.answers, 3) == 4,
            planFlags(plan.answers, 0, false, false), planFlags(plan.answers, 1, true, false),
            planFlags(plan.answers, 2, false, false), planFlags(plan.answers, 3, false, false),
            planRowIs(plan.answers, 0, 1, { id: 4, title: "p2", done: true }), planRowIs(plan.answers, 3, 3, { id: 1, title: "p4", done: false }),
            structuralEquals(plan.items, seeds), structuralEquals(planStoredTitles(plan.items), ["p4", "p1", "p3", "p2"]),
            structuralEquals(planStoredDones(plan.items), [false, false, true, false]),
            structuralEquals(plan.lists, [TodoHarness::seedList(1, "Open", "#5C6BC0")])
        ])
    }
}
