// [SYNTH-ARRANGEMENT-PLAYER] Render a song project, join it to its intro recording and play it.
namespace songs

(** The engine renders every track and the held end of the intro; `ffmpeg` only cuts the intro's last
    seconds, joins the rendered parts and crossfades them after the intro, and `afplay` plays the result. *)
module Player
    // Frames per WAV part: 960,000 interleaved samples, half the encoder's limit.
    chunk = 480000

    tailPath request = "${request.folder}/tail.wav"

    piecePath request = "${request.folder}/piece.wav"

    (** The finished recording: the intro (when given) crossfaded into the rendered piece. *)
    export songPath request = "${request.folder}/song.wav"

    decoded (request, size) = match readFileBytes (tailPath request) 0 size
        Error why => Error(message = why)
        Success bytes => match synth::WaveImport::decode bytes
            Error why => Error(message = why)
            Success wave => Success(value = wave.samples)

    // The intro's last 1.5 s as mono at the song's rate.
    tail (request, arrangement) = match Shell::ran (120, "ffmpeg -v error -y -sseof -1.5 -i ${Shell::quoted request.intro} -ac 1 -ar ${arrangement.sampleRate} -c:a pcm_s16le ${Shell::quoted (tailPath request)}")
        Error why => Error(message = why)
        Success _ => match fileSize (tailPath request)
            Error why => Error(message = why)
            Success size => decoded (request, size)

    glowed (arrangement, raw, outcome, glow) = match outcome
        Error why => Error(message = why)
        Success buses => match synth::Sustains::voiced (toFloat arrangement.sampleRate, raw, glow)
            Error why => Error(message = why)
            Success pad => match synth::Arrangements::frame (arrangement, glow.start)
                Error why => Error(message = why)
                Success start => synth::Arrangements::layered (buses, pad, start, glow.gain, 0.0, glow.reverb)

    held (arrangement, buses, source) = match synth::Sustains::frozen (toFloat arrangement.sampleRate, source, synth::Sustains::needed (toFloat arrangement.sampleRate, arrangement.sustains))
        Error why => Error(message = why)
        Success raw => foldList (arrangement.sustains, Success(value = buses), \(outcome, glow) => glowed (arrangement, raw, outcome, glow))

    bridged (request, arrangement, buses) = match request.intro == "" || length arrangement.sustains == 0
        true => Success(value = buses)
        false => match tail (request, arrangement)
            Error why => Error(message = why)
            Success source =>
                print "  holding the intro's last moment (${length arrangement.sustains} appearances)"
                held (arrangement, buses, source)

    tracked (arrangement, count, outcome, voice) = match outcome
        Error why => Error(message = why)
        Success buses =>
            print "  rendering ${voice.name} (${length voice.notes} notes)"
            synth::Arrangements::added (arrangement, buses, voice, count)

    least (one, other) = match one < other
        true => one
        false => other

    stored (held, name, stem, hex) = match writeFile "${stem}.hex" hex
        Error why => held(fault = why)
        Success _ => match Shell::ran (120, "xxd -r -p ${Shell::quoted "${stem}.hex"} ${Shell::quoted "${stem}.wav"} && rm ${Shell::quoted "${stem}.hex"}")
            Error why => held(fault = why)
            Success _ => held(parts = listAppend held.parts "${name}.wav")

    written (request, arrangement, mix, held, index) = match held.fault == ""
        false => held
        true => match synth::WaveFiles::interleaved (arrangement.sampleRate, 2, synth::Arrangements::interleaved (mix, satMul index chunk, least (satMul (satAdd index 1) chunk, length mix.left)))
            Error why => held(fault = why)
            Success hex => stored (held, "part-${index}", "${request.folder}/part-${index}", hex)

    parts (request, arrangement, mix) =
        held = foldList (toList (range (0, intDiv (satAdd (length mix.left) (satSub chunk 1)) chunk)), Written(parts = [], fault = ""), \(held, index) => written (request, arrangement, mix, held, index))
        match held.fault == ""
            true => Success(value = held.parts)
            false => Error(message = held.fault)

    // The intro at the piece's rate, then a 0.35 s equal-gain crossfade into the piece.
    crossfade arrangement = "[0:a]aresample=${arrangement.sampleRate},aformat=sample_fmts=flt:channel_layouts=stereo[intro];[intro][1:a]acrossfade=d=0.35:c1=tri:c2=tri"

    joined (request, arrangement) = match request.intro == ""
        true => Shell::ran (120, "cp ${Shell::quoted (piecePath request)} ${Shell::quoted (songPath request)}")
        false => Shell::ran (300, "ffmpeg -v error -y -i ${Shell::quoted request.intro} -i ${Shell::quoted (piecePath request)} -filter_complex \"${crossfade arrangement}\" -c:a pcm_s24le ${Shell::quoted (songPath request)}")

    // The concat list names parts relative to itself.
    assembled (request, arrangement, files) = match writeFile "${request.folder}/parts.txt" (join (mapList (files, \path => "file ${Shell::quoted path}")) "\n")
        Error why => Error(message = why)
        Success _ => match Shell::ran (300, "ffmpeg -v error -y -f concat -safe 0 -i ${Shell::quoted "${request.folder}/parts.txt"} -c copy ${Shell::quoted (piecePath request)}")
            Error why => Error(message = why)
            Success _ => joined (request, arrangement)

    mixed (request, arrangement, buses) = match synth::Arrangements::mixed (arrangement, buses)
        Error why => Error(message = why)
        Success mix =>
            print "  mixed ${length mix.left} frames, peak ${mix.peak}"
            match parts (request, arrangement, mix)
                Error why => Error(message = why)
                Success files => assembled (request, arrangement, files)

    (** Render the song into the request's folder; the result is `songPath request`. *)
    export rendered (request, arrangement) = match synth::Arrangements::frames arrangement
        Error why => Error(message = why)
        // The held intro comes first, so a bad sustain fails before the long track renders.
        Success count => match bridged (request, arrangement, synth::Arrangements::empty)
            Error why => Error(message = why)
            Success buses => match foldList (arrangement.tracks, Success(value = buses), \(outcome, voice) => tracked (arrangement, count, outcome, voice))
                Error why => Error(message = why)
                Success all => mixed (request, arrangement, all)

    (** Play the finished recording through the default output; bounded at one hour. *)
    export played request = Shell::ran (3600, "afplay ${Shell::quoted (songPath request)}")
