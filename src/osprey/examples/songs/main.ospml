// [SYNTH-ARRANGEMENT-PLAYER] songs <project.json> <output-folder>

usage = "usage: songs <project.json> <output-folder>"

request items = songs::Request(project = listGet items 0 ?: "", folder = listGet items 1 ?: "")

finished outcome = match outcome
    Error why => print "songs: ${why}"
    Success path => print "songs: wrote ${path}"

performed (request, source) = match songs::SongFiles::decode source
    Error why => print "songs: ${why}"
    Success arrangement => match makeDir request.folder
        Error why => print "songs: ${why}"
        Success _ =>
            print "songs: ${arrangement.title}, ${arrangement.tempo} bpm, ${length arrangement.tracks} tracks"
            finished (songs::Player::rendered (request, arrangement))

started request = match request.project != "" && request.folder != "" && songs::Shell::safe request.project && songs::Shell::safe request.folder
    false => print usage
    true => match readFile request.project
        Error why => print "songs: ${why}"
        Success source => performed (request, source)

main () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    started (request (args ()))
