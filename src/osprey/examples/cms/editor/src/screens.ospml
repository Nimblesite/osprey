// Implements [CMS-EDITOR] screens: the sidebar's tree and upload, the top bar, the formatted and raw
// editors with their ribbon, the media view and the empty state, assembled only from studio::Kit.
namespace studio

import ui::Editors
import ui::Frames
import ui::Media
import ui::Ui
import studio::Blocks
import studio::Design
import studio::Kit
import studio::Names
import studio::Preview

(** The studio's screens. *)
module Screens
    symbolOf kind = match kind
        "markdown" => "document"
        "image" => "sparkle"
        "video" => "play"
        "audio" => "play"
        _ => "package"

    shown (store, item) = store.filter == "" || contains (toLowerCase item.entryPath) (toLowerCase store.filter)

    rootOf path = listGet (split path "/" ?: []) 0 ?: ""

    // A file in the tree: its kind's symbol, its path inside its root, grouped under that root.
    treeEntry item = Ui::entry (item.entryPath, symbolOf item.entryKind, rootOf item.entryPath, Kit::say (drop item.entryPath (satAdd (length (rootOf item.entryPath)) 1), "small", "ink"))

    tree store =
        style = Frames::plain
        files = mapList (filterList (store.files, \item => shown (store, item)), treeEntry)
        Ui::framed (style(frameGrow = true, frameScrollY = true, frameFlatRows = true, frameGap = 2), Ui::rows (files, store.opened, Open))

    brand () =
        mark = Kit::surface ("accent", "", Design::radius "sm", 0)
        logo = Ui::framed (mark(frameWidth = 34, frameHeight = 34, frameInk = "accentInk", frameAlign = "center", frameCross = "center", frameSymbolSize = 18), Ui::icon "sparkle")
        Ui::spacedRow (10, [logo, Ui::spaced (0, [Kit::strong ("Osprey Studio", "body", "sidebarInk"), Kit::say ("Content, versioned in git", "micro", "sidebarMuted")])])

    folders store = Kit::segmented (mapList (store.roots, \root => Kit::choice (root, root == store.folder, PickFolder)))

    uploader store =
        style = Kit::surface ("sidebarRaised", "", Design::radius "md", 14)
        Ui::framed (style(frameGap = 10), Ui::column [Kit::eyebrow ("Add media", "sidebarMuted"), Kit::button ("primary", "Upload media", "add", store.busy == false, ChooseMedia), Kit::say ("Saved into ${store.folder}/ and committed.", "micro", "sidebarMuted")])

    (** The dark sidebar: brand, search, the tree and the uploader. *)
    export sidebar store =
        style = Kit::surface ("sidebar", "edge", 0, 16)
        Ui::framed (style(frameName = "sidebar", frameLineEdge = "right", frameWidth = 280, frameViewportHeightInset = 0, frameGap = 16), Ui::column [brand (), Kit::input ("Search files", store.filter, Search), tree store, uploader store])

    // Folders muted with a separator after each, the open file itself in ink.
    crumb part = [Kit::say (part, "small", "inkMuted"), Kit::say ("›", "small", "inkMuted")]

    crumbs path =
        parts = split path "/" ?: []
        folders = range (0, satSub (length parts) 1) |> fold [] (\(out, index) => listConcat out (crumb (listGet parts index ?: "")))
        Ui::cluster (6, listAppend folders (Kit::strong (Names::base path, "small", "ink")))

    edited store = match store.text == store.saved
        true => [Kit::status ("good", "Saved")]
        false => [Kit::status ("accent", "Unsaved changes")]

    // The open file's state; with nothing open there is nothing to report.
    stateOf store = match store.loads > 0 || store.busy
        true => [Kit::status ("warn", "Working…")]
        false => match store.opened
            "" => []
            _ => edited store

    commitChip store = match store.commit
        "" => []
        sha => [Kit::chip (take sha 7)]

    // Publish names how many saved commits are not yet live; with none, the site is simply live.
    publishing store = match store.unpublished > 0
        true => [Kit::button ("primary", "Publish ${store.unpublished}", "send", true, Publish)]
        false => [Kit::status ("good", "Live")]

    publishArea store = match store.remote
        true => publishing store
        false => []

    (** The bar over the work: where you are, its state, and what you can do. *)
    export topbar store =
        style = Kit::surface ("panel", "edge", 0, 14)
        actions = [Kit::iconButton ("History", "clock", store.showingHistory, ToggleHistory), Kit::iconButton ("Refresh", "refresh", false, Refresh), Kit::button ("secondary", "New page", "add", true, NewPage), Kit::button ("secondary", "Save", "check", store.text != store.saved, Save)]
        place = listConcat [Ui::share (Ui::spacedRow (12, listConcat [crumbs store.opened] (deleting store)))] (stateOf store)
        Ui::framed (style(frameLineEdge = "bottom", frameRadius = 0), Ui::row (listConcat (listConcat (listConcat place (commitChip store)) actions) (publishArea store)))

    // Delete sits by the file it deletes, quiet until wanted, and only when a file is open.
    deleting store = match store.opened
        "" => []
        _ => [Kit::button ("danger", "Delete", "delete", true, Delete)]

    modes store = Kit::segmented [Kit::choice ("Formatted", store.mode == "formatted", Formatted), Kit::choice ("Markdown", store.mode == "markdown", Raw)]

    // The focused block's style, which the ribbon lights.
    current store = (Blocks::blockAt ((Blocks::page store.text).pageBlocks, store.focus)).blockStyle

    styled (store, label, style) = Kit::tool (label, store.mode == "formatted" && current store == style, Restyle(styleName = style))

    styleTools store = [styled (store, "Body", "paragraph"), styled (store, "H1", "h1"), styled (store, "H2", "h2"), styled (store, "H3", "h3")]

    inlineTools () = [Kit::tool ("B", false, Emphasis(marker = "**")), Kit::tool ("I", false, Emphasis(marker = "*")), Kit::tool ("Code", false, Emphasis(marker = "`"))]

    blockTools store = [styled (store, "• List", "bullets"), styled (store, "❝ Quote", "quote")]

    insertTools () = [Kit::tool ("Link", false, Insert(snippet = "[link text](https://)")), Kit::tool ("Image", false, Insert(snippet = "![Describe the image](/media/)"))]

    (** The ribbon: modes, then styles, emphasis, blocks and inserts. *)
    export ribbon store = Ui::spacedRow (12, [modes store, Kit::ribbon [styleTools store, inlineTools (), blockTools store, insertTools ()]])

    paperStyle () =
        style = Kit::surface ("panel", "edge", Design::radius "lg", 48)
        style(frameShadow = "floating", frameWidth = 820, frameGap = 18)

    typeOf style = match style
        "h1" => "h1"
        "h2" => "h2"
        "h3" => "h3"
        "quote" => "h3"
        _ => "body"

    faceOf style = match style
        "code" => Design::mono ()
        _ => Design::sans ()

    // The focused block, editable in place in its own type; code edits as monospaced lines.
    blockEditor (store, index, item) =
        style = Frames::text (faceOf item.blockStyle, Design::size (typeOf item.blockStyle), false)
        edit = EditBlock(blockIndex = index)
        place = PlaceBlock(placedIndex = index)
        field = match item.blockStyle
            "code" => Editors::editor ("code", item.blockText, store.blockCursor, [], edit, place)
            style => Editors::focused (style, item.blockText, store.blockCursor, store.focusEpoch, edit, place)
        Ui::framed (style(frameHug = false, frameQuietControls = true, frameLineHeight = toFloat (Design::size (typeOf item.blockStyle)) * 1.5), field)

    flat () =
        style = Frames::plain
        style(frameFlatRows = true)

    // Every other block reads as it will publish; choosing it moves the editor there.
    // The empty paragraph Enter opened, right after the block it came from.
    freshAfter (store, index) = match store.fresh == satAdd index 1
        true =>
            style = Frames::text (Design::sans (), Design::size "body", false)
            [Ui::framed (style(frameHug = false, frameQuietControls = true, frameLineHeight = 22.5), Editors::focused ("paragraph", "", 0, store.focusEpoch, EditFresh, PlaceBlock(placedIndex = store.fresh)))]
        false => []

    blockView (store, index, item) = match index == store.focus
        true => blockEditor (store, index, item)
        false => Ui::framed (flat (), Ui::rows ([Ui::item (toString index, Preview::block item)], "", FocusBlock))

    formatted store =
        blocks = (Blocks::page store.text).pageBlocks
        page = Ui::framed (paperStyle (), Ui::column (range (0, length blocks) |> fold [] (\(out, index) => listConcat (listAppend out (blockView (store, index, Blocks::blockAt (blocks, index)))) (freshAfter (store, index)))))
        Ui::spaced (0, [page])

    raw store =
        source = Kit::surface ("panel", "edge", Design::radius "lg", 20)
        reader = Kit::surface ("panel", "edge", Design::radius "lg", 32)
        editor = Ui::framed (source(frameFont = Design::mono (), frameTextSize = Design::size "body", frameGrow = true, frameViewportHeightInset = 220), Editors::editor ("Markdown", store.text, store.cursor, [], Edit, Place))
        split = Frames::plain
        Ui::framed (split(frameGap = 16, frameGrow = true), Ui::row [editor, Ui::framed (reader(frameGrow = true, frameScrollY = true, frameViewportHeightInset = 220), Preview::page store.text)])

    workStyle () =
        style = Kit::surface ("bg", "", 0, 24)
        style(frameGrow = true, frameScrollY = true, frameGap = 18, frameCross = "center")

    surfaceOf store = match store.mode
        "markdown" => raw store
        _ => formatted store

    (** The open page: the ribbon over the formatted or raw editor. *)
    export markdown store = Ui::framed (pageStyle store, Ui::column [ribbon store, surfaceOf store])

    // The formatted page is a centred sheet; the Markdown split stretches across the work area.
    pageStyle store = match store.mode
        "markdown" =>
            style = workStyle ()
            style(frameCross = "stretch")
        _ => workStyle ()

    // A picture shows once its bytes arrive; until then the card says it is loading.
    picture store = match store.preview
        "" => Kit::say ("Loading the preview…", "body", "inkMuted")
        source => Media::image (source, Names::base store.opened, 640, 400)

    mediaOf store = match Names::kind store.opened
        "image" => picture store
        "video" => Kit::say ("Videos play on the site; there is no preview here.", "body", "inkMuted")
        "audio" => Kit::say ("Audio files play on the site; there is no preview here.", "body", "inkMuted")
        _ => Kit::say ("This file has no preview.", "body", "inkMuted")

    (** An open image, video or audio file. *)
    export media store =
        title = Ui::spacedRow (12, [Ui::share (Kit::heading (Names::base store.opened, "h3", "ink")), Kit::button ("danger", "Delete file", "delete", true, Delete)])
        Ui::framed (workStyle (), Ui::column [Kit::card (24, [title, Kit::chip store.opened, mediaOf store])])

    (** Nothing open yet. *)
    export welcome () =
        style = Kit::surface ("bg", "", 0, 24)
        start = Kit::button ("primary", "New page", "add", true, NewPage)
        Ui::framed (style(frameGrow = true, frameAlign = "center", frameCross = "center", frameGap = 16), Ui::column [Kit::empty ("document", "Pick a page to edit", "Choose a page or media file on the left, or start a new page."), start])
