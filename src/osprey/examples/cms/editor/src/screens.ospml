// Implements [CMS-EDITOR] screens: the sidebar's tree and upload, the top bar, the formatted and raw
// editors with their ribbon, the media view and the empty state, assembled only from studio::Kit.
namespace studio

import ui::Editors
import ui::Frames
import ui::Media
import ui::Ui
import studio::Blocks
import studio::Design
import studio::Kit
import studio::Names
import studio::Preview

(** The studio's screens. *)
module Screens
    symbolOf kind = match kind
        "markdown" => "document"
        "other" => "package"
        _ => "star"

    shown (store, item) = store.filter == "" || contains (toLowerCase item.entryPath) (toLowerCase store.filter)

    rootOf path = listGet (split path "/" ?: []) 0 ?: ""

    // A file in the tree: its kind's symbol, its path inside its root, grouped under that root.
    treeEntry item = Ui::entry (item.entryPath, symbolOf item.entryKind, rootOf item.entryPath, Kit::say (drop item.entryPath (satAdd (length (rootOf item.entryPath)) 1), "small", "ink"))

    tree store =
        style = Frames::plain
        files = mapList (filterList (store.files, \item => shown (store, item)), treeEntry)
        Ui::framed (style(frameGrow = true, frameScrollY = true, frameFlatRows = true, frameGap = 2), Ui::rows (files, store.opened, Open))

    brand () =
        mark = Kit::surface ("accent", "", Design::radius "sm", 0)
        logo = Ui::framed (mark(frameWidth = 34, frameHeight = 34, frameInk = "accentInk", frameAlign = "center", frameCross = "center", frameSymbolSize = 18), Ui::icon "sparkle")
        Kit::row (10, [logo, Kit::stack (0, [Kit::strong ("Osprey Studio", "body", "sidebarInk"), Kit::say ("Content, versioned in git", "micro", "sidebarMuted")])])

    folders store = Kit::segmented (mapList (store.roots, \root => Kit::choice (root, root == store.folder, PickFolder)))

    uploader store =
        style = Kit::surface ("sidebarRaised", "", Design::radius "md", 14)
        Ui::framed (style(frameGap = 10), Ui::column [Kit::eyebrow ("Add media", "sidebarMuted"), Kit::button ("primary", "Upload image, video or audio", "add", store.busy == false, ChooseMedia), Kit::say ("Saved into ${store.folder}/ and committed.", "micro", "sidebarMuted")])

    (** The dark sidebar: brand, search, the tree and the uploader. *)
    export sidebar store =
        style = Kit::surface ("sidebar", "edge", 0, 16)
        Ui::framed (style(frameName = "sidebar", frameLineEdge = "right", frameWidth = 280, frameViewportHeightInset = 0, frameGap = 16), Ui::column [brand (), Kit::input ("Search files", store.filter, Search), tree store, uploader store])

    crumbs path = Kit::cluster (6, mapList (split path "/" ?: [], \part => Kit::say (part, "small", "inkMuted")))

    stateOf store = match store.loads > 0 || store.busy
        true => Kit::status ("warn", "Saving…")
        false => match store.text == store.saved
            true => Kit::status ("good", "Saved")
            false => Kit::status ("accent", "Unsaved changes")

    commitChip store = match store.commit
        "" => []
        sha => [Kit::chip (take sha 7)]

    // Publish names how many saved commits are not yet live, and is off when there are none or no remote.
    publishButton store = Kit::button ("primary", "Publish ${store.unpublished}", "send", store.remote && store.unpublished > 0, Publish)

    (** The bar over the work: where you are, its state, and what you can do. *)
    export topbar store =
        style = Kit::surface ("panel", "edge", 0, 14)
        actions = [Kit::iconButton ("History", "clock", store.showingHistory, ToggleHistory), Kit::iconButton ("Refresh", "refresh", false, Refresh), Kit::button ("secondary", "New page", "add", true, NewPage), Kit::button ("danger", "Delete", "delete", store.opened != "", Delete), Kit::button ("primary", "Save", "check", store.text != store.saved, Save), publishButton store]
        Ui::framed (style(frameLineEdge = "bottom", frameRadius = 0), Ui::row (listConcat (listConcat [Kit::grow (crumbs store.opened), stateOf store] (commitChip store)) actions))

    modes store = Kit::segmented [Kit::choice ("Formatted", store.mode == "formatted", Formatted), Kit::choice ("Markdown", store.mode == "markdown", Raw)]

    styleTools () = [Kit::tool ("Body", false, Restyle(styleName = "paragraph")), Kit::tool ("H1", false, Restyle(styleName = "h1")), Kit::tool ("H2", false, Restyle(styleName = "h2")), Kit::tool ("H3", false, Restyle(styleName = "h3"))]

    inlineTools () = [Kit::tool ("B", false, Emphasis(marker = "**")), Kit::tool ("I", false, Emphasis(marker = "*")), Kit::tool ("Code", false, Emphasis(marker = "`"))]

    blockTools () = [Kit::tool ("• List", false, Restyle(styleName = "bullets")), Kit::tool ("❝ Quote", false, Restyle(styleName = "quote"))]

    insertTools () = [Kit::tool ("Link", false, Insert(snippet = "[link text](https://)")), Kit::tool ("Image", false, Insert(snippet = "![Describe the image](/media/)"))]

    (** The ribbon: modes, then styles, emphasis, blocks and inserts. *)
    export ribbon store = Kit::row (12, [modes store, Kit::ribbon [styleTools (), inlineTools (), blockTools (), insertTools ()]])

    paperStyle () =
        style = Kit::surface ("panel", "edge", Design::radius "lg", 48)
        style(frameShadow = "floating", frameWidth = 820, frameGap = 18)

    typeOf style = match style
        "h1" => "h1"
        "h2" => "h2"
        "h3" => "h3"
        "quote" => "h3"
        _ => "body"

    faceOf style = match style
        "code" => Design::mono ()
        _ => Design::sans ()

    // The focused block, editable in place in its own type; code edits as monospaced lines.
    blockEditor (store, index, item) =
        style = Frames::text (faceOf item.blockStyle, Design::size (typeOf item.blockStyle), false)
        edit = EditBlock(blockIndex = index)
        place = PlaceBlock(placedIndex = index)
        field = match item.blockStyle
            "code" => Editors::editor ("code", item.blockText, store.blockCursor, [], edit, place)
            style => Editors::inline (style, item.blockText, store.blockCursor, edit, place)
        Ui::framed (style(frameHug = false, frameQuietControls = true, frameLineHeight = toFloat (Design::size (typeOf item.blockStyle)) * 1.5), field)

    flat () =
        style = Frames::plain
        style(frameFlatRows = true)

    // Every other block reads as it will publish; choosing it moves the editor there.
    blockView (store, index, item) = match index == store.focus
        true => blockEditor (store, index, item)
        false => Ui::framed (flat (), Ui::rows ([Ui::item (toString index, Preview::block item)], "", FocusBlock))

    formatted store =
        blocks = (Blocks::page store.text).pageBlocks
        page = Ui::framed (paperStyle (), Ui::column (range (0, length blocks) |> fold [] (\(out, index) => listAppend out (blockView (store, index, Blocks::blockAt (blocks, index))))))
        Kit::stack (0, [page])

    raw store =
        source = Kit::surface ("panel", "edge", Design::radius "lg", 20)
        reader = Kit::surface ("panel", "edge", Design::radius "lg", 32)
        editor = Ui::framed (source(frameFont = Design::mono (), frameTextSize = Design::size "body", frameGrow = true), Editors::editor ("Markdown", store.text, store.cursor, [], Edit, Place))
        Kit::row (16, [editor, Ui::framed (reader(frameGrow = true, frameScrollY = true), Preview::page store.text)])

    workStyle () =
        style = Kit::surface ("bg", "", 0, 24)
        style(frameGrow = true, frameScrollY = true, frameGap = 18, frameCross = "center")

    surfaceOf store = match store.mode
        "markdown" => raw store
        _ => formatted store

    (** The open page: the ribbon over the formatted or raw editor. *)
    export markdown store = Ui::framed (workStyle (), Ui::column [ribbon store, surfaceOf store])

    mediaOf store = match Names::kind store.opened
        "video" => Media::video (store.preview, "", "", Names::base store.opened, 0)
        "image" => Media::image (store.preview, Names::base store.opened, 640, 400)
        _ => Kit::say ("Audio files play on the site; there is no preview here.", "body", "inkMuted")

    (** An open image, video or audio file. *)
    export media store = Ui::framed (workStyle (), Ui::column [Kit::card (24, [Kit::heading (Names::base store.opened, "h3", "ink"), Kit::chip store.opened, mediaOf store])])

    (** Nothing open yet. *)
    export welcome () = Ui::framed (workStyle (), Kit::empty ("document", "Pick a page to edit", "Choose a page or media file on the left, or start a new page."))
