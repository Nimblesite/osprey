// ============================================================================
//  FastAPI benchmark report — turns target/fastapi/benchmark/results.json
//  (produced by benchmark.cpython [FASTAPI-BENCHMARK-SUBSET]) into a
//  self-contained HTML report comparing Osprey (GC / ARC) against CPython
//  FastAPI. Run from the repository root:
//
//      make fastapi-benchreport
//
//  or directly: target/release/osprey src/osprey/packages/fastapi/tests/benchreport.osp --run
//
//  Reads results.json, writes report.html next to it. Every failure — unread
//  file, unexpected shape, unwritable output — is a typed Result printed as a
//  message with a non-zero exit, never a crash or a fake number.
// ============================================================================

let inputPath = "target/fastapi/benchmark/results.json"
let outputPath = "target/fastapi/benchmark/report.html"
let baselineKey = "cpython"

type Workload = {
    name: string,
    permutations: int,
    rps: float,
    latencyMs: float,
    p95Ms: float,
    rssMib: float
}
type RuntimeResult = { key: string, workloads: List<Workload> }
type Refs = { python: string, fastapiVersion: string, uvicorn: string }
type Meta = {
    recordedUtc: string,
    refs: Refs,
    platform: string,
    workers: int,
    samples: int,
    trials: int,
    warmup: int,
    scope: string,
    method: string,
    memoryNote: string
}
type Report = { meta: Meta, runtimes: List<RuntimeResult> }
type Compare = { pct: int, faster: bool, tied: bool }
type MaybeWorkload = NoWorkload | Got { workload: Workload }
type Metric = Rps | Latency | P95 | Rss

/// `then` threads a Result through the next decoding step, keeping every
/// chain linear instead of match-nested.
fn then(result, next) = match result {
    Success { value } => next(value)
    Error { message } => Error { message: message }
}

/// Keeps every success, or remembers the first failure.
fn keepOk(acc, item) = match acc {
    Error => acc
    Success { value } => {
        let kept = value
        match item {
            Error => acc
            Success { value } => Success { value: listAppend(kept, value) }
        }
    }
}

// --- edge: results.json -> Report (the only place Json values are touched) ---

fn decodeReport(source) = match jsonDecode(source) {
    Success { value } => then(decodeMeta(value), fn(meta) =>
        then(decodeRuntimes(value), fn(runtimes) =>
            Success { value: buildReport(meta, runtimes) }))
    Error { message } => Error { message: "results.json is not valid JSON: ${message}" }
}

fn buildReport(meta, runtimes) = Report { meta: meta, runtimes: runtimes }

fn decodeMeta(doc) = then(field(doc, "metadata"), fn(m) =>
    then(txt(m, "recorded_utc"), fn(recordedUtc) =>
        then(decodeRefs(m), fn(refs) =>
            Success { value: buildMeta(m, recordedUtc, refs) })))

fn buildMeta(m, recordedUtc, refs) = Meta {
    recordedUtc: recordedUtc,
    refs: refs,
    platform: optText(m, "platform"),
    workers: optInt(m, "workers"),
    samples: optInt(m, "samples"),
    trials: optInt(m, "trials"),
    warmup: optInt(m, "warmup"),
    scope: optText(m, "scope"),
    method: optText(m, "method"),
    memoryNote: optText(m, "memory")
}

fn decodeRefs(m) = then(field(m, "reference"), fn(ref) =>
    then(txt(ref, "python"), fn(python) =>
        then(txt(ref, "fastapi"), fn(fastapiVersion) =>
            then(txt(ref, "uvicorn"), fn(uvicorn) =>
                Success { value: Refs { python: python, fastapiVersion: fastapiVersion, uvicorn: uvicorn } }))))

fn decodeRuntimes(doc) = then(field(doc, "results"), fn(items) => match items {
    JsonArray { values } => then(map(values, decodeRuntime) |> fold(Success { value: List() }, keepOk), fn(runtimes) =>
        Success { value: runtimes })
    _ => Error { message: "results.results is not a runtime array" }
})

fn decodeRuntime(json) = then(txt(json, "runtime"), fn(key) =>
    then(field(json, "workloads"), fn(items) => match items {
        JsonArray { values } => then(map(values, decodeWorkload) |> fold(Success { value: List() }, keepOk), fn(workloads) =>
            Success { value: RuntimeResult { key: key, workloads: workloads } })
        _ => Error { message: "workloads of ${key} are not an array" }
    }))

fn decodeWorkload(json) = then(txt(json, "name"), fn(name) =>
    then(num(json, "median_requests_per_second"), fn(rps) =>
        then(num(json, "median_latency_ms"), fn(latencyMs) =>
            then(num(json, "max_sampled_rss_mib"), fn(rssMib) =>
                Success { value: buildWorkload(json, name, rps, latencyMs, rssMib) }))))

fn buildWorkload(json, name, rps, latencyMs, rssMib) = Workload {
    name: name,
    permutations: optInt(json, "input_permutations"),
    rps: rps,
    latencyMs: latencyMs,
    p95Ms: medianP95(json),
    rssMib: rssMib
}

/// The median of each trial's p95, so tail latency is one honest number.
fn medianP95(json) = match field(json, "trials") {
    Success { value } => match value {
        JsonArray { values } => median(toList(map(values, trialP95)))
        _ => 0.0
    }
    Error => 0.0
}

fn trialP95(json) = optNum(json, "p95_latency_ms")

fn txt(json, key) = match jsonField(json, key) {
    Success { value } => match value {
        JsonString { value } => Success { value: value }
        _ => Error { message: "${key} is not text" }
    }
    Error => Error { message: "missing ${key}" }
}

fn num(json, key) = match jsonField(json, key) {
    Success { value } => match jsonFloat(value) {
        Success { value } => Success { value: value }
        Error => match jsonInt(value) {
            Success { value } => Success { value: toFloat(value) }
            Error => Error { message: "${key} is not a number" }
        }
    }
    Error => Error { message: "missing ${key}" }
}

fn field(json, key) = match jsonField(json, key) {
    Success { value } => Success { value: value }
    Error => Error { message: "missing ${key}" }
}

fn optText(json, key) = match txt(json, key) {
    Success { value } => value
    Error => ""
}

fn optNum(json, key) = match num(json, key) {
    Success { value } => value
    Error => 0.0
}

fn optInt(json, key) = match jsonField(json, key) {
    Success { value } => match jsonInt(value) {
        Success { value } => value
        Error => 0
    }
    Error => 0
}

// --- pure: comparisons over the typed report --------------------------------

fn median(xs) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
    }
    let ordered = listSortBy(xs, byAsc)
    match listGet(ordered, floatToInt(floor(toFloat(listLength(ordered)) / 2.0)) ?: 0) {
        Success { value } => value
        Error => 0.0
    }
}

fn byAsc(a, b) = match a >= b {
    true => 1
    false => -1
}

fn findRuntime(r, key) = foldList(r.runtimes, NoWorkload, fn(acc, entry) =>
    match acc {
        Got { workload } => acc
        NoWorkload => match entry.key == key {
            true => firstOf(entry)
            false => NoWorkload
        }
    })

fn firstOf(entry) = match listGet(entry.workloads, 0) {
    Success { value } => Got { workload: value }
    Error => NoWorkload
}

fn findWorkload(entry, name) = foldList(entry.workloads, NoWorkload, fn(acc, candidate) =>
    match acc {
        Got { workload } => acc
        NoWorkload => match candidate.name == name {
            true => Got { workload: candidate }
            false => NoWorkload
        }
    })

fn compare(score, baseline) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
    }
    match baseline > 0.0 {
        true => {
            let pct = floatToInt(round((score / baseline - 1.0) * 100.0)) ?: 0
            Compare { pct: pct, faster: pct > 2, tied: pct >= -2 && pct <= 2 }
        }
        false => Compare { pct: 0, faster: false, tied: true }
    }
}

fn pickMetric(w, m) = match m {
    Rps => w.rps
    Latency => w.latencyMs
    P95 => w.p95Ms
    Rss => w.rssMib
}

/// The best metric value across every runtime for one workload; the Metric
/// itself encodes the direction (higher or lower is better).
fn bestOf(r, row, m) = foldList(r.runtimes, pickMetric(row, m), fn(acc, entry) =>
    match findWorkload(entry, row.name) {
        Got { workload } => match pickMetric(workload, m) > pickMetric(row, m) {
            true => pickMetric(workload, m)
            false => acc
        }
        NoWorkload => acc
    })

fn workloadsOf(r) = foldList(r.runtimes, List(), pickWorkloads)

fn pickWorkloads(acc, entry) = match entry.key == baselineKey {
    true => entry.workloads
    false => match listLength(acc) {
        0 => entry.workloads
        _ => acc
    }
}

// --- pure: formatting --------------------------------------------------------

fn fixed(x) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
    }
    toString(round(x * 100.0) / 100.0)
}

fn rate(rps) = toString(round(rps))

fn pctLabel(c) = match c.tied {
    true => "≈ tied"
    false => match c.faster {
        true => "▲ ${toString(c.pct)}% faster"
        false => "▼ ${toString(abs(c.pct))}% slower"
    }
}

fn esc(s) = {
    let amp = replace(s, "&", "&amp;") ?: ""
    let lt = replace(amp, "<", "&lt;") ?: ""
    let gt = replace(lt, ">", "&gt;") ?: ""
    replace(gt, "\"", "&quot;") ?: ""
}

fn displayName(key) = match key {
    "osprey-arc" => "Osprey · ARC"
    "osprey-gc" => "Osprey · GC"
    _ => "Python + FastAPI"
}

fn barColor(key) = match key {
    "osprey-arc" => "c-arc"
    "osprey-gc" => "c-gc"
    _ => "c-py"
}

fn chipClass(c) = match c.tied {
    true => "chip tie"
    false => match c.faster {
        true => "chip win"
        false => "chip lose"
    }
}

// --- pure: HTML --------------------------------------------------------------

let pageCss = "
:root { --bg:#0f1420; --card:#1a2233; --line:#2a3550; --ink:#e8edf7; --dim:#9aa7c0;
  --win:#3fb96f; --lose:#e05656; --tie:#c9a24b; --accent:#5aa2ff; --gold:#f5b942 }
* { box-sizing:border-box; margin:0; padding:0 }
body { background:var(--bg); color:var(--ink); font:15px/1.55 -apple-system,'Segoe UI',Roboto,sans-serif; padding:40px 20px }
.wrap { max-width:960px; margin:0 auto }
h1 { font-size:26px; margin-bottom:6px }
.sub { color:var(--dim); margin-bottom:22px }
.card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:20px 22px; margin-bottom:18px }
h2 { font-size:17px; margin-bottom:14px }
h2 small { color:var(--dim); font-weight:400; font-size:13px }
.howto { display:flex; gap:12px; flex-wrap:wrap }
.dir { flex:1; min-width:220px; border-radius:10px; padding:14px 16px; border:1px solid var(--line) }
.dir b { display:block; font-size:15px }
.dir span { color:var(--dim); font-size:13px }
.up { border-left:4px solid var(--win) } .down { border-left:4px solid var(--accent) } .mem { border-left:4px solid var(--gold) }
table { width:100%; border-collapse:collapse; margin-top:10px }
th, td { text-align:right; padding:8px 10px; border-bottom:1px solid var(--line) }
th:first-child, td:first-child { text-align:left }
th { color:var(--dim); font-weight:600; font-size:13px }
td { font-variant-numeric:tabular-nums }
.best { color:var(--win); font-weight:700 }
.best::after { content:' ◀ best'; font-size:11px; font-weight:600 }
.baseline { color:var(--dim) }
.chip { display:inline-block; border-radius:999px; padding:2px 12px; font-size:12.5px; font-weight:700; white-space:nowrap }
.win { background:rgba(63,185,111,.16); color:var(--win) }
.lose { background:rgba(224,86,86,.16); color:var(--lose) }
.tie { background:rgba(201,162,75,.16); color:var(--tie) }
.bar { height:26px; border-radius:6px; margin:6px 0; display:flex; align-items:center; min-width:260px; padding:0 10px }
.bar span { font-size:12.5px; font-weight:700; color:#0d1220; white-space:nowrap }
.c-arc { background:#6ee7a8 } .c-gc { background:#7fb2ff } .c-py { background:#f0c266 }
.legend { font-size:12.5px; color:var(--dim); margin-top:10px }
.verdict { font-size:17px; line-height:1.7 }
.verdict b.good { color:var(--win) } .verdict b.bad { color:var(--lose) }
.kv { color:var(--dim); font-size:13px; line-height:1.9 }
.kv b { color:var(--ink); font-weight:600 }
footer { color:var(--dim); font-size:12.5px; margin-top:26px }
"

fn page(title, body) = "<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>${esc(title)}</title>
<style>${pageCss}</style>
</head>
<body>
<div class=\"wrap\">
${body}
</div>
</body>
</html>
"

fn headerHtml(r) = "<h1>Osprey FastAPI vs Python FastAPI</h1>
<p class=\"sub\">Recorded ${esc(r.meta.recordedUtc)} · Python ${esc(r.meta.refs.python)} + FastAPI ${esc(r.meta.refs.fastapiVersion)} + uvicorn ${esc(r.meta.refs.uvicorn)} · ${esc(r.meta.platform)}</p>
<div class=\"card\">
  <h2>How to read this report</h2>
  <div class=\"howto\">
    <div class=\"dir up\"><b>↑ Throughput (req/s)</b><span>HIGHER is better — more requests served per second.</span></div>
    <div class=\"dir down\"><b>↓ Latency (ms)</b><span>LOWER is better — less waiting time per request.</span></div>
    <div class=\"dir mem\"><b>↓ Memory (MiB)</b><span>LOWER is better — less RAM while serving.</span></div>
  </div>
  <p class=\"legend\">Green ◀ best marks the winner of each column. The chips on every row compare that runtime against the Python baseline: ▲ faster, ▼ slower, ≈ within ±2%.</p>
</div>
${verdictHtml(r)}"

fn verdictHtml(r) = "<div class=\"card\">
  <h2>Verdict — Osprey (ARC) vs Python + FastAPI</h2>
  <p class=\"verdict\">Osprey (ARC) wins <b class=\"${verdictTone(arcWins(r))}\">${toString(arcWins(r))} of ${toString(listLength(workloadsOf(r)))}</b> workloads: ${ratioSummary(r)}${memoryVerdict(r)}.</p>
  <p class=\"legend\">Osprey (GC) currently trails Python on every workload — the tables below show where.</p>
</div>"

fn verdictTone(wins) = match wins > 0 {
    true => "good"
    false => "bad"
}

fn ratioSummary(r) = foldList(workloadsOf(r), "", fn(acc, row) =>
    match findRuntime(r, "osprey-arc") {
        NoWorkload => acc
        Got { workload } => ratioText(entryOf(r), row, workload, acc)
    })

fn ratioText(baselineEntry, row, arc, acc) = match findWorkload(baselineEntry, row.name) {
    Got { workload } => {
        let c = compare(arc.rps, workload.rps)
        "${acc}<b>${esc(row.name)}</b> <span class=\"${chipClass(c)}\">${esc(pctLabel(c))}</span> · "
    }
    NoWorkload => acc
}

fn entryOf(r) = foldList(r.runtimes, headOf(r), fn(acc, entry) => match entry.key == baselineKey {
    true => entry
    false => acc
})

fn headOf(r) = match listGet(r.runtimes, 0) {
    Success { value } => value
    Error => RuntimeResult { key: "", workloads: List() }
}

fn memoryVerdict(r) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
    }
    let arcRss = rssOf(r, "osprey-arc")
    let pyRss = rssOf(r, baselineKey)
    match arcRss > 0.0 && pyRss > 0.0 {
        true => " and uses <b class=\"good\">${fixed(pyRss / arcRss)}× less memory</b> (${fixed(arcRss)} MiB vs ${fixed(pyRss)} MiB)"
        false => ""
    }
}

fn rssOf(r, key) = match findRuntime(r, key) {
    Got { workload } => workload.rssMib
    NoWorkload => 0.0
}

fn arcWins(r) = foldList(workloadsOf(r), 0, fn(acc, w) =>
    match findRuntime(r, "osprey-arc") {
        NoWorkload => acc
        Got { workload } => match compare(workload.rps, baselineWorkload(r, w.name).rps).faster {
            true => plusOne(acc)
            false => acc
        }
    })

fn plusOne(acc) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
    }
    acc + 1
}

fn baselineWorkload(r, name) = match findWorkload(entryOf(r), name) {
    Got { workload } => workload
    NoWorkload => Workload { name: name, permutations: 0, rps: 0.0, latencyMs: 0.0, p95Ms: 0.0, rssMib: 0.0 }
}

/// One card per workload: throughput bars plus the full metric table.
fn workloadHtml(r, workload) = "<div class=\"card\">
  <h2>${esc(workload.name)} <small>· ${toString(workload.permutations)} input permutations</small></h2>
  ${foldList(r.runtimes, "", fn(acc, entry) => barText(r, entry, workload, acc))}
  <table>
    <tr><th>Runtime</th><th>Throughput req/s ↑</th><th>Latency p50 ms ↓</th><th>Latency p95 ms ↓</th><th>Memory MiB ↓</th><th>vs Python</th></tr>
    ${foldList(r.runtimes, "", fn(acc, entry) => rowText(r, workload, entry, acc))}
  </table>
</div>"

fn barText(r, entry, row, acc) = match findWorkload(entry, row.name) {
    Got { workload } => "${acc}<div class=\"bar ${barColor(entry.key)}\" style=\"width:${toString(barWidth(r, row, workload))}%\"><span>${esc(displayName(entry.key))} — ${rate(workload.rps)} req/s</span></div>"
    NoWorkload => acc
}

fn barWidth(r, row, w) = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
    }
    match floatToInt(round(w.rps / bestOf(r, row, Rps) * 100.0)) {
        Success { value } => value
        Error => 100
    }
}

fn rowText(r, row, entry, acc) = match findWorkload(entry, row.name) {
    Got { workload } => "${acc}<tr>${nameCell(entry)}${cell(r, row, workload, Rps, rate(workload.rps))}${cell(r, row, workload, Latency, fixed(workload.latencyMs))}${cell(r, row, workload, P95, fixed(workload.p95Ms))}${cell(r, row, workload, Rss, fixed(workload.rssMib))}${compareCell(r, row, workload, entry)}</tr>"
    NoWorkload => acc
}

fn nameCell(entry) = match entry.key == baselineKey {
    true => "<td class=\"baseline\">${esc(displayName(entry.key))} — baseline</td>"
    false => "<td>${esc(displayName(entry.key))}</td>"
}

fn cell(r, row, w, m, rendered) = "<td class=\"${bestClass(pickMetric(w, m), bestOf(r, row, m))}\">${rendered}</td>"

fn bestClass(value, best) = match value == best {
    true => "best"
    false => ""
}

fn compareCell(r, row, w, entry) = match entry.key == baselineKey {
    true => "<td class=\"baseline\">baseline</td>"
    false => {
        let c = compare(w.rps, baselineWorkload(r, row.name).rps)
        "<td><span class=\"${chipClass(c)}\">${esc(pctLabel(c))}</span></td>"
    }
}

fn methodHtml(r) = "<div class=\"card\">
  <h2>Method &amp; caveats</h2>
  <p class=\"kv\"><b>Scope:</b> ${esc(r.meta.scope)}<br>
  <b>Method:</b> ${esc(r.meta.method)}<br>
  <b>Trials:</b> ${toString(r.meta.trials)} × ${toString(r.meta.samples)} requests per workload · ${toString(r.meta.workers)} workers · ${toString(r.meta.warmup)} warm-up responses<br>
  <b>Memory note:</b> ${esc(r.meta.memoryNote)}</p>
</div>"

fn render(r) = page(
    "Osprey FastAPI vs Python FastAPI",
    "${headerHtml(r)}${foldList(workloadsOf(r), "", fn(acc, w) => "${acc}${workloadHtml(r, w)}")}${methodHtml(r)}<footer>Generated by src/osprey/packages/fastapi/tests/benchreport.osp from ${esc(inputPath)} · every reply was validated by the benchmark harness</footer>"
)

// --- effects: read, decode, render, write ------------------------------------

fn main() = {
    handle Arith {
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    }
    match generate() {
        Error { message } => {
            print("benchreport: ${message}")
            1
        }
        Success { value } => {
            print("wrote ${value}")
            0
        }
    }
}

fn generate() = match readFile(inputPath) {
    Error { message } => Error { message: "cannot read ${inputPath}: ${message}" }
    Success { value } => match decodeReport(value) {
        Error { message } => Error { message: message }
        Success { value } => match writeFile(outputPath, render(value)) {
            Error { message } => Error { message: "cannot write ${outputPath}: ${message}" }
            Success => Success { value: outputPath }
        }
    }
}
