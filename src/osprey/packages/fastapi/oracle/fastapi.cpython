"""CPython oracle for @osprey/fastapi: request parsing and route matching.

Builds a reference app from scratch with the real FastAPI (0.135.3) and drives it
over real loopback HTTP, so every recorded status and JSON body is FastAPI's own
verdict on the same wire call an Osprey port must reproduce. The reference app
has three route groups:

* `GET /configs/{config_id}` — a `uuid.UUID` path parameter, a bounded integer
  query (`limit`, 1..100, default 20), a `Literal["day", "hour"]` query
  (`period`, default "day") and a required `X-API-Key` header;
* `GET /bundle/{path:path}` — a greedy path parameter plus a repeated `tags`
  query list that defaults to empty;
* `GET /ordered/me` declared before `GET /ordered/{value}`, so the static route
  wins.

The cases cover canonical, 32-digit, braced and URN UUIDs and the malformed ones,
integer spellings (`3.0`, exponents, signs, whitespace, empty), every rejection
reason for `limit`/`period`, a missing/empty/mixed-case key header, duplicate
query keys, percent-encoded Unicode, slash, question mark, hash, plus and space in
path and query, repeated and missing `tags`, and both halves of the ordered route
pair. Output is a JSON array on stdout; a provenance line goes to stderr. The
HTTP client does not follow redirects, so the trailing-slash `/ordered/me/` case keeps
FastAPI's own 307 instead of a followed 200.

Run from the repository root with the pinned interpreter:

    /Users/christianfindlay/Documents/Code/NimblesiteAgenticPlatform/.venv/bin/python \\
        -I src/osprey/packages/testing/oracle/oracle.cpython fastapi
"""

from __future__ import annotations

import http.client
import importlib.machinery
import importlib.metadata
import importlib.util
import json
import socket
import sys
import threading
import time
import uuid
from pathlib import Path
from typing import Annotated, Literal
from urllib.parse import quote

import uvicorn
from expected_module import write
from fastapi import FastAPI, Header, Query

CONFIG_ID = uuid.UUID("3f2504e0-4f89-11d3-9a0c-0305e82c3301")
CONFIG = f"/configs/{CONFIG_ID}"
KEY = {"X-API-Key": "s3cret"}
# Accepted UUID text first, then every malformed shape: see config_uuid_cases.
UUID_SHAPES = [
    str(CONFIG_ID),
    str(CONFIG_ID).upper(),
    CONFIG_ID.hex,
    "{" + str(CONFIG_ID) + "}",
    "urn:uuid:" + str(CONFIG_ID),
    "{" + CONFIG_ID.hex + "}",
    CONFIG_ID.hex[:-1],
    CONFIG_ID.hex + "0",
    "0x" + CONFIG_ID.hex,
    "{" + CONFIG_ID.hex,
    str(CONFIG_ID).replace("0", "g"),
    "not-a-uuid",
    "3f2504e-4f89-11d3-9a0c-0305e82c3301",
    "3f2504e0-4f8-11d3-9a0c-0305e82c3301",
    "3f2504e0-4f89-11d-9a0c-0305e82c3301",
    "3f2504e0-4f89-11d3-9a0-0305e82c3301",
    "3f2504e0-4f89-11d3-9a0c-0305e82c330",
    "{}",
]

app = FastAPI()


@app.get("/configs/{config_id}")
def read_config(
    config_id: uuid.UUID,
    x_api_key: Annotated[str, Header(alias="X-API-Key")],
    limit: Annotated[int, Query(ge=1, le=100)] = 20,
    period: Literal["day", "hour"] = "day",
):
    """Echo the parsed config request; validation is the whole point."""
    return {
        "config_id": str(config_id),
        "limit": limit,
        "period": period,
        "key": x_api_key,
    }


@app.get("/usage")
def read_usage(
    agent_config_id: uuid.UUID,
    limit: Annotated[int, Query(ge=1, le=100)],
    period: Literal["day", "hour"],
    x_api_key: Annotated[str, Header(alias="X-API-Key")],
):
    return {"config_id": str(agent_config_id), "limit": limit, "period": period, "key": x_api_key}


@app.get("/metrics")
def metrics():
    return {"latency": float("inf")}


@app.get("/bundle/{path:path}")
def read_bundle(path: str, tags: Annotated[list[str], Query(default_factory=list)]):
    """Echo a greedy path and the repeated `tags` query values."""
    return {"path": path, "tags": tags}


@app.get("/ordered/me")
def ordered_me():
    """Static route that must shadow `/ordered/{value}`."""
    return {"value": "me"}


@app.get("/ordered/{value}")
def ordered_value(value: str):
    """Catch-all route ordered after the static one."""
    return {"value": value}


def case(port: int, method: str, path: str, headers: dict | None = None):
    """One real wire call and FastAPI's status with its parsed JSON body."""
    sent = dict(headers or {})
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
    try:
        connection.request(method, path, headers=sent)
        response = connection.getresponse()
        body = response.read()
        return {"method": method, "path": path, "headers": sent,
                "status": response.status, "body": response_body(response, body), "body_text": body.decode()}
    finally:
        connection.close()


def response_body(response, body):
    if not body:
        return None
    if response.getheader("Content-Type", "").startswith("application/json"):
        return json.loads(body)
    return body.decode()


def encoded(value: str) -> str:
    """`value` percent-encoded for one path segment or query value."""
    return quote(value, safe="")


def config_uuid_cases(port: int):
    """Every UUID spelling FastAPI accepts and the malformed shapes it rejects."""
    return [case(port, "GET", f"/configs/{encoded(v)}", KEY) for v in UUID_SHAPES]


def config_limit_cases(port: int):
    """Accepted integers and each integer rejection reason."""
    values = [
        "1", "20", "37", "100", "0", "101", "-5", "3.0", "1e2", "1E2",
        "+5", " 5 ", "05", "", "ten", "1.5", "100 ", "0x10",
    ]
    return [case(port, "GET", f"{CONFIG}?limit={encoded(v)}", KEY) for v in values]


def config_period_cases(port: int):
    """Both literals, the default, and values the literal rejects."""
    values = ["day", "hour", "Day", "week", "", " day", "hours"]
    return [case(port, "GET", f"{CONFIG}?period={encoded(v)}", KEY) for v in values]


def config_header_cases(port: int):
    """The required key header: absent, empty, mixed case, duplicated."""
    paths = [
        (CONFIG, {}),
        (CONFIG, {"X-API-Key": ""}),
        (CONFIG, {"x-api-key": "s3cret"}),
        (CONFIG, {"X-API-KEY": "s3cret"}),
        (CONFIG, {"X-Api-Key": "s3cret"}),
        (CONFIG, {"X-API-Key": "  s3cret  "}),
        (CONFIG, {"X-API-Key": "s3cret", "x-api-key": "other"}),
    ]
    return [case(port, "GET", path, headers) for path, headers in paths]


def config_duplicate_cases(port: int):
    """Repeated query keys: which value a scalar parameter keeps."""
    paths = [
        f"{CONFIG}?limit=10&limit=20",
        f"{CONFIG}?limit=20&limit=10",
        f"{CONFIG}?period=hour&period=day",
        f"{CONFIG}?period=day&period=week",
        f"{CONFIG}?limit=10&limit=200",
        f"{CONFIG}?limit=10&limit=20&period=hour&period=day",
    ]
    return [case(port, "GET", path, KEY) for path in paths]


def config_combined_cases(port: int):
    """UUID shapes, bounds and the key header together, plus unknown keys."""
    paths = [
        f"{CONFIG}?limit=100&period=hour",
        f"{CONFIG}?limit=1&period=day",
        f"/configs/{CONFIG_ID.hex}?limit=100&period=hour&extra=ignored",
        f"/configs/{{{CONFIG_ID}}}?limit=1",
        f"/configs/urn:uuid:{CONFIG_ID}?period=hour",
        "/configs/",
        "/configs",
        f"/configs/{CONFIG_ID}/extra",
    ]
    return [case(port, "GET", path, KEY) for path in paths]


def bundle_cases(port: int):
    """Greedy path decoding for Unicode, slash, question, hash, plus and space."""
    paths = [
        "/bundle/",
        "/bundle/one",
        "/bundle/files/a.txt",
        "/bundle/a%2Fb",
        "/bundle/a%2Fb%2Fc%2Fd.txt",
        "/bundle/a%20b",
        "/bundle/a+b",
        "/bundle/a%2Bb",
        "/bundle/what%3F",
        "/bundle/hash%23tag",
        "/bundle/%E6%97%A5%E6%9C%AC%E8%AA%9E/%F0%9F%98%80",
        "/bundle/space%20and%2Fslash",
        "/bundle/.hidden",
    ]
    return [case(port, "GET", path) for path in paths]


def bundle_tag_cases(port: int):
    """Repeated, comma-joined, empty and encoded `tags` query values."""
    paths = [
        "/bundle/x?tags=a",
        "/bundle/x?tags=a&tags=b",
        "/bundle/x?tags=a&tags=b&tags=a",
        "/bundle/x?tags=a,b",
        "/bundle/x?tags=",
        "/bundle/x?tags=&tags=",
        "/bundle/x?tags=%C3%A9lan&tags=%F0%9F%98%80",
        "/bundle/x?tags=a+b&tags=c%2Bd",
        "/bundle/x?tag=a&tags=b",
        "/bundle/files/a.txt?tags=one&tags=two",
    ]
    return [case(port, "GET", path) for path in paths]


def ordered_cases(port: int):
    """Route order: `/ordered/me` shadows `/ordered/{value}`; extra segments miss."""
    paths = [
        "/ordered/me",
        "/ordered/me/",
        "/ordered/you",
        "/ordered/ME",
        "/ordered/me?x=1",
        "/ordered/",
        "/ordered",
        "/ordered/me/extra",
        "/ordered/%E6%97%A5%E6%9C%AC%E8%AA%9E",
        "/ordered/a%2Fb",
    ]
    return [case(port, "GET", path) for path in paths]


def malformed_cases(port: int):
    paths = ["/bundle", "/bundle/%", "/bundle/%A", "/bundle/%GG", "/bundle/%80",
             "/bundle/%C0%AF", "/bundle/%E2", "/bundle/%E2%82", "/bundle/%E2x",
             "/bundle/%E2%GG", "/bundle/%E0%80%80", "/bundle/%ED%A0%80",
             "/bundle/%F0%80%80%80", "/bundle/%F4%90%80%80", "/bundle/%F5%80",
             "/bundle/x?tags", "/bundle/x?tags=a=b", "/bundle/x?tags=%GG", "/bundle/x?tags=%E2%82"]
    calls = [case(port, "GET", path) for path in paths]
    calls.extend([case(port, "GET", "/configs/not-uuid?limit=x&period=week"),
                  case(port, "GET", f"{CONFIG}?limit=x&period=week"),
                  case(port, "GET", "/configs/not-uuid?limit=x&period=week", KEY)])
    return calls


def usage_cases(port: int):
    paths = ["/metrics", "/usage", "/usage?limit=1", "/usage?period=day",
             f"/usage?agent_config_id={CONFIG_ID}",
             f"/usage?agent_config_id={CONFIG_ID}&limit=1",
             f"/usage?agent_config_id={CONFIG_ID}&period=day",
             f"/usage?agent_config_id={CONFIG_ID}&limit=1&period=day",
             "/usage?agent_config_id=bad&limit=x&period=bad"]
    return [case(port, "GET", path, KEY) for path in paths]


def all_cases(port: int):
    """Every recorded case, in route order."""
    groups = [
        config_uuid_cases,
        config_limit_cases,
        config_period_cases,
        config_header_cases,
        config_duplicate_cases,
        config_combined_cases,
        bundle_cases,
        bundle_tag_cases,
        ordered_cases,
        malformed_cases,
        usage_cases,
    ]
    return [record for group in groups for record in group(port)]


def start_reference(application=app):
    """Use a reserved random port and a live ASGI server, including HTTP header parsing."""
    listener = socket.socket()
    listener.bind(("127.0.0.1", 0))
    server = uvicorn.Server(uvicorn.Config(application, log_level="error", lifespan="off"))
    worker = threading.Thread(target=server.run, kwargs={"sockets": [listener]}, daemon=True)
    worker.start()
    for _ in range(500):
        if server.started:
            return server, worker, listener, listener.getsockname()[1]
        if not worker.is_alive():
            raise RuntimeError("Reference HTTP server exited before startup")
        time.sleep(0.01)
    server.should_exit = True
    worker.join(5)
    listener.close()
    raise TimeoutError("Reference server failed to start")


def dependency_cases():
    """Collect the sibling dependency corpus over its own real reference listener."""
    path = Path(__file__).with_name("fastapi_dependencies.cpython")
    loader = importlib.machinery.SourceFileLoader("fastapi_dependency_reference", str(path))
    spec = importlib.util.spec_from_file_location(loader.name, path, loader=loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    cases, _challenge = module.reference_cases()
    module.checked_cases(cases)
    return cases


def write_header_fixture(cases):
    """Native and CPython clients replay the identical Latin-1 header wire bytes."""
    wires = ["".join(f"{name}: {value}\r\n" for name, value in case["headers"].items()).encode("latin-1") for case in cases]
    if any(b"\x1e" in wire or b"\x00" in wire for wire in wires):
        raise ValueError("header fixture cannot contain record separators or NUL")
    (Path(__file__).resolve().parents[1] / "tests/parameters.headers.bin").write_bytes(b"\x1e".join(wires))


def main():
    """Print the reference wire cases and report pinned package versions."""
    version = importlib.metadata.version("fastapi")
    if version != "0.135.3":
        raise ValueError(f"Expected FastAPI 0.135.3, found {version}")
    server, worker, listener, port = start_reference()
    try:
        cases = all_cases(port)
    finally:
        server.should_exit = True
        worker.join(5)
        listener.close()
    if worker.is_alive():
        raise TimeoutError("Reference HTTP server failed to stop")
    if len({json.dumps(c, sort_keys=True) for c in cases}) != len(cases):
        raise ValueError("Duplicate case: fix the corpus instead of dropping one")
    cases += dependency_cases()
    write_header_fixture(cases)
    write("fastapi", "Real HTTP reference cases for routing, validation and dependency lifecycles.", {"fastapi": version}, {"CASES_JSON": json.dumps(cases, ensure_ascii=False, separators=(",", ":"))})
    print(json.dumps(cases, ensure_ascii=False, separators=(",", ":")))
    print(f"{len(cases)} real HTTP cases from fastapi {version}", file=sys.stderr)


if __name__ == "__main__":
    main()
