// ============================================================================
//  FastAPI benchmark report — reads target/fastapi/benchmark/results.json
//  (written by tests/benchmark.cpython [FASTAPI-BENCHMARK-SUBSET]) and renders the
//  self-contained target/fastapi/benchmark/report.html comparing Osprey (GC
//  and ARC) against CPython FastAPI.
//
//      make -C src/toolchain/benchmarks fastapi-benchreport
//
//  The JSON document is decoded once, at this edge, into the typed records
//  below; everything after is pure string building. Every failure — unread
//  input, unexpected shape, degenerate measurement, unwritable output — is a
//  typed Result or a handled Arith fault, reported with a non-zero exit: the
//  program never crashes and never writes a half-honest report.
// ============================================================================

// The two whole paths this report reads and writes. No separator handling
// happens here — joining, splitting and any Windows vs mac/linux difference
// live only in fs::Path [REPO-ROOT-LAYOUT]; these strings are passed through
// untouched.
type Paths = { input: string, output: string }

fn benchmarkPaths() =
Paths { input: "target/fastapi/benchmark/results.json", output: "target/fastapi/benchmark/report.html" }
let baselineKey = "cpython"
let arcKey = "osprey-arc"
let gcKey = "osprey-gc"

type Refs = { python: string, fastapiVersion: string, uvicorn: string }
type Counts = { workers: int, samples: int, trials: int, warmup: int }
type Notes = { platform: string, scope: string, method: string, memory: string }
type Meta = { recordedUtc: string, refs: Refs, counts: Counts, notes: Notes }
type Workload = {
    name: string,
    permutations: int,
    rps: float,
    latencyMs: float,
    p95Ms: float,
    rssMib: float
}
type Runtime = { key: string, workloads: List<Workload> }
type Report = { meta: Meta, runtimes: List<Runtime> }
type Compare = { pct: int, faster: bool, tied: bool }
type Found = Absent | Present { workload: Workload }

/// Threads a Result through the next decoding step so chains stay linear.
fn then(result, next) = match result {
    Success { value } => next(value)
    Error { message } => Error { message: message }
}

/// Decodes every element, or fails with the first element's error.
fn collectDecode(values, decode) = foldList(values, Success { value: List() }, fn(acc, item) =>
    then(acc, fn(kept) => then(decode(item), fn(one) => Success { value: listAppend(kept, one) })))

/// Threads four decoded fields into one record constructor.
fn then4(first, second, third, fourth, build) = then(first, fn(a) => then(second, fn(b) =>
    then(third, fn(c) => then(fourth, fn(d) => Success { value: build(a, b, c, d) }))))

// --- edge: results.json -> Report — the only code that touches Json ---------

fn decodeReport(source) = match jsonDecode(source) {
    Error { message } => Error { message: "${benchmarkPaths().input} is not valid JSON: ${message}" }
    Success { value } => then(decodeMeta(value), fn(meta) =>
        then(decodeRuntimes(value), fn(runtimes) =>
            Success { value: Report { meta: meta, runtimes: runtimes } }))
}

fn decodeMeta(doc) = then(fieldAt(doc, "metadata"), fn(m) =>
    then(stringAt(m, "recorded_utc"), fn(recordedUtc) =>
        then(decodeRefs(m), fn(refs) =>
            then(decodeCounts(m), fn(counts) =>
                then(decodeNotes(m), fn(notes) =>
                    Success { value: Meta { recordedUtc: recordedUtc, refs: refs, counts: counts, notes: notes } })))))

fn decodeRefs(m) = then(fieldAt(m, "reference"), fn(ref) =>
    then(stringAt(ref, "python"), fn(python) =>
        then(stringAt(ref, "fastapi"), fn(fastapiVersion) =>
            then(stringAt(ref, "uvicorn"), fn(uvicorn) =>
                Success { value: Refs { python: python, fastapiVersion: fastapiVersion, uvicorn: uvicorn } }))))

fn decodeCounts(m) = then4(intAt(m, "workers"), intAt(m, "samples"), intAt(m, "trials"), intAt(m, "warmup"),
    fn(workers, samples, trials, warmup) => Counts { workers: workers, samples: samples, trials: trials, warmup: warmup })

fn decodeNotes(m) = then4(stringAt(m, "platform"), stringAt(m, "scope"), stringAt(m, "method"), stringAt(m, "memory"),
    fn(platform, scope, method, memory) => Notes { platform: platform, scope: scope, method: method, memory: memory })

fn decodeRuntimes(doc) = then(fieldAt(doc, "results"), fn(items) => match items {
        JsonArray(values) => collectDecode(values, decodeRuntime)
        _ => Error { message: "results is not a runtime array" }
})

fn decodeRuntime(json) = then(stringAt(json, "runtime"), fn(key) =>
    then(fieldAt(json, "workloads"), fn(items) => match items {
            JsonArray(values) => then(collectDecode(values, decodeWorkload), fn(workloads) =>
                Success { value: Runtime { key: key, workloads: workloads } })
            _ => Error { message: "workloads of ${key} is not an array" }
}))

fn decodeWorkload(json) = then(stringAt(json, "name"), fn(name) =>
    then(intAt(json, "input_permutations"), fn(permutations) =>
        then(floatAt(json, "median_requests_per_second"), fn(rps) =>
            then(floatAt(json, "median_latency_ms"), fn(latencyMs) =>
                then(floatAt(json, "max_sampled_rss_mib"), fn(rssMib) =>
                    then(medianP95(json), fn(p95Ms) =>
                        Success { value: Workload { name: name, permutations: permutations, rps: rps, latencyMs: latencyMs, p95Ms: p95Ms, rssMib: rssMib } }))))))

/// The median of every trial's p95, so tail latency is one honest number.
fn medianP95(json) = then(fieldAt(json, "trials"), fn(items) => match items {
        JsonArray(values) => match length(values) {
            0 => Error { message: "trials is empty" }
            _ => then(collectDecode(values, trialP95), fn(p95s) => Success { value: median(p95s) })
        }
        _ => Error { message: "trials is not an array" }
})

fn trialP95(json) = floatAt(json, "p95_latency_ms")

// --- Json field accessors; every failure names its field ---------------------

fn fieldAt(json, key) = match jsonField(json, key) {
    Success { value } => Success { value: value }
    Error => Error { message: "missing ${key}" }
}

fn stringAt(json, key) = then(fieldAt(json, key), fn(value) => match value {
        JsonString(text) => Success { value: text }
        _ => Error { message: "${key} is not text" }
})

/// One numeric field, converted or failing with the field's own name.
fn numberAt(json, key, convert, kind) = then(fieldAt(json, key), fn(value) => match convert(value) {
        Success { value } => Success { value: value }
        Error => Error { message: "${key} is not ${kind}" }
})

fn intAt(json, key) = numberAt(json, key, jsonInt, "an integer")

fn floatAt(json, key) = numberAt(json, key, jsonFloat, "a number")

// --- pure: lookups and comparisons over the typed report ---------------------

/// The middle value; the upper middle for even counts.
fn median(xs) = match listGet(listSortBy(xs, byAsc), floatToInt(toFloat(length(xs)) / 2.0) ?: 0) {
    Success { value } => value
    Error => 0.0
}

fn byAsc(a, b) = match a >= b {
    true => 1
    false => -1
}

/// Runtime entries carrying one key.
fn entryOf(r, key) = filterList(r.runtimes, fn(entry) => entry.key == key)

/// The rows every table is laid out by: the baseline's workloads, or the
/// first runtime's when no baseline was recorded.
fn rowsOf(r) = match listGet(entryOf(r, baselineKey), 0) {
    Success { value } => value.workloads
    Error => match listGet(r.runtimes, 0) {
        Success { value } => value.workloads
        Error => []
    }
}

fn workloadOf(entry, name) = match listGet(filterList(entry.workloads, fn(w) => w.name == name), 0) {
    Success { value } => Present { workload: value }
    Error => Absent
}

/// One runtime's measurement of one workload.
fn runtimeWorkload(r, key, name) = match listGet(entryOf(r, key), 0) {
    Success { value } => workloadOf(value, name)
    Error => Absent
}

/// Throughput ratio vs the baseline as a whole percent. A zero baseline is a
/// degenerate measurement: its Arith divideByZero fault fails the whole
/// render instead of inventing a percentage.
fn compare(score, baseline) = {
    let pct = floatToInt(round((score / baseline - 1.0) * 100.0)) ?: 0
    Compare { pct: pct, faster: pct > 2, tied: pct >= -2 && pct <= 2 }
}

/// The winning value of one metric across runtimes; `wins` encodes direction.
fn bestOf(r, row, metric, wins) = foldList(r.runtimes, metric(row), fn(acc, entry) => match workloadOf(entry, row.name) {
        Present { workload } => match wins(metric(workload), acc) {
            true => metric(workload)
            false => acc
        }
        Absent => acc
})

fn higher(a, b) = a > b
fn lower(a, b) = a < b

/// True when one runtime serves measurably more requests than the baseline
/// for that row (beyond the ±2% tie band).
fn beatsBaseline(r, key, row) = match runtimeWorkload(r, key, row.name) {
    Present { workload } => {
        let score = workload.rps
        match runtimeWorkload(r, baselineKey, row.name) {
            Present { workload } => compare(score, workload.rps).faster
            Absent => false
        }
    }
    Absent => false
}

/// How many rows one runtime wins against the baseline.
fn winsOf(r, key) = foldList(rowsOf(r), 0, fn(acc, row) => match beatsBaseline(r, key, row) {
        true => acc + 1
        false => acc
})

/// Median sampled memory across the rows one runtime served.
fn medianRss(r, key) = median(foldList(rowsOf(r), [], fn(acc, row) => match runtimeWorkload(r, key, row.name) {
            Present { workload } => listAppend(acc, workload.rssMib)
            Absent => acc
}))

fn rpsMetric(w) = w.rps
fn p50Metric(w) = w.latencyMs
fn p95Metric(w) = w.p95Ms
fn rssMetric(w) = w.rssMib

// --- pure: text formatting ---------------------------------------------------

/// Two decimal places; latencies and memory keep a stable column width.
fn fixed(x) = toString(round(x * 100.0) / 100.0)

/// Thousands-grouped whole requests per second.
fn rate(rps) = grouped(toString(floatToInt(round(rps)) ?: 0))

fn grouped(s) = match length(s) > 3 {
    true => "${take(s, length(s) - 3)},${grouped(drop(s, length(s) - 3))}"
    false => s
}

fn pctLabel(c) = match c.tied {
    true => "≈ tied"
    false => match c.faster {
        true => "▲ ${toString(c.pct)}% faster"
        false => "▼ ${toString(abs(c.pct))}% slower"
    }
}

/// HTML text escaping. The constant needles cannot error; the fallback is the
/// unescaped input, never a fabricated string.
fn esc(s) = {
    let a = replace(s, "&", "&amp;") ?: s
    let b = replace(a, "<", "&lt;") ?: s
    let c = replace(b, ">", "&gt;") ?: s
    replace(c, "\"", "&quot;") ?: s
}

fn displayName(key) = match key {
    "osprey-arc" => "Osprey · ARC"
    "osprey-gc" => "Osprey · GC"
    _ => "Python + FastAPI"
}

fn barColor(key) = match key {
    "osprey-arc" => "c-arc"
    "osprey-gc" => "c-gc"
    _ => "c-py"
}

fn chipClass(c) = match c.tied {
    true => "chip tie"
    false => match c.faster {
        true => "chip win"
        false => "chip lose"
    }
}

// --- pure: HTML --------------------------------------------------------------

let pageCss = "
:root { --bg:#0f1420; --card:#1a2233; --line:#2a3550; --ink:#e8edf7; --dim:#9aa7c0;
  --win:#3fb96f; --lose:#e05656; --tie:#c9a24b; --accent:#5aa2ff; --gold:#f5b942 }
* { box-sizing:border-box; margin:0; padding:0 }
body { background:var(--bg); color:var(--ink); font:15px/1.55 -apple-system,'Segoe UI',Roboto,sans-serif; padding:40px 20px }
.wrap { max-width:960px; margin:0 auto }
h1 { font-size:26px; margin-bottom:6px }
.sub { color:var(--dim); margin-bottom:22px }
.card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:20px 22px; margin-bottom:18px }
h2 { font-size:17px; margin-bottom:14px }
h2 small { color:var(--dim); font-weight:400; font-size:13px }
.howto { display:flex; gap:12px; flex-wrap:wrap }
.dir { flex:1; min-width:220px; border-radius:10px; padding:14px 16px; border:1px solid var(--line) }
.dir b { display:block; font-size:15px }
.dir span { color:var(--dim); font-size:13px }
.up { border-left:4px solid var(--win) } .down { border-left:4px solid var(--accent) } .mem { border-left:4px solid var(--gold) }
table { width:100%; border-collapse:collapse; margin-top:10px }
th, td { text-align:right; padding:8px 10px; border-bottom:1px solid var(--line) }
th:first-child, td:first-child { text-align:left }
th { color:var(--dim); font-weight:600; font-size:13px }
td { font-variant-numeric:tabular-nums }
.best { color:var(--win); font-weight:700 }
.best::after { content:' ◀ best'; font-size:11px; font-weight:600 }
.baseline { color:var(--dim) }
.chip { display:inline-block; border-radius:999px; padding:2px 12px; font-size:12.5px; font-weight:700; white-space:nowrap }
.win { background:rgba(63,185,111,.16); color:var(--win) }
.lose { background:rgba(224,86,86,.16); color:var(--lose) }
.tie { background:rgba(201,162,75,.16); color:var(--tie) }
.bar { height:26px; border-radius:6px; margin:6px 0; display:flex; align-items:center; min-width:260px; padding:0 10px }
.bar span { font-size:12.5px; font-weight:700; color:#0d1220; white-space:nowrap }
.c-arc { background:#6ee7a8 } .c-gc { background:#7fb2ff } .c-py { background:#f0c266 }
.legend { font-size:12.5px; color:var(--dim); margin-top:10px }
.verdict { font-size:17px; line-height:1.7 }
.verdict b.good { color:var(--win) } .verdict b.bad { color:var(--lose) }
.kv { color:var(--dim); font-size:13px; line-height:1.9 }
.kv b { color:var(--ink); font-weight:600 }
footer { color:var(--dim); font-size:12.5px; margin-top:26px }
"

let howtoHtml = "<div class=\"card\">
  <h2>How to read this report</h2>
  <div class=\"howto\">
    <div class=\"dir up\"><b>↑ Throughput (req/s)</b><span>HIGHER is better — more requests served per second.</span></div>
    <div class=\"dir down\"><b>↓ Latency (ms)</b><span>LOWER is better — less waiting time per request.</span></div>
    <div class=\"dir mem\"><b>↓ Memory (MiB)</b><span>LOWER is better — less RAM while serving.</span></div>
  </div>
  <p class=\"legend\">Green ◀ best marks the winner of each column. Chips compare each runtime against the Python baseline: ▲ faster, ▼ slower, ≈ within ±2%.</p>
</div>"

/// The document wrapper: head, stylesheet, body, footer.
fn page(body) = "<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>Osprey FastAPI vs Python FastAPI</title>
<style>${pageCss}</style>
</head>
<body>
<div class=\"wrap\">
${body}
</div>
<footer>Generated by src/osprey/packages/fastapi/bench/src/benchreport.osp from ${esc(benchmarkPaths().input)} · every reply was validated by the benchmark harness.</footer>
</div>
</body>
</html>"

fn headerHtml(r) = "<h1>Osprey FastAPI vs Python FastAPI</h1>
<p class=\"sub\">Recorded ${esc(r.meta.recordedUtc)} · Python ${esc(r.meta.refs.python)} + FastAPI ${esc(r.meta.refs.fastapiVersion)} + uvicorn ${esc(r.meta.refs.uvicorn)} · ${esc(r.meta.notes.platform)}</p>
${howtoHtml}
${verdictHtml(r)}"

fn verdictHtml(r) = {
    let total = length(rowsOf(r))
    let arc = winsOf(r, arcKey)
    let gc = winsOf(r, gcKey)
    "<div class=\"card\">
  <h2>Verdict — throughput vs Python + FastAPI</h2>
  <p class=\"verdict\">Osprey (ARC) serves more requests on <b class=\"${tone(arc, total)}\">${toString(arc)} of ${toString(total)}</b> workloads; Osprey (GC) on <b class=\"${tone(gc, total)}\">${toString(gc)} of ${toString(total)}</b>.</p>
  ${memoryHtml(r)}
  <p class=\"legend\">A win means more than the ±2% tie band above the baseline.</p>
</div>"
}

fn tone(wins, total) = match wins * 2 > total {
    true => "good"
    false => "bad"
}

/// Median sampled memory of both stacks, only when both were measured.
fn memoryHtml(r) = {
    let arc = medianRss(r, arcKey)
    let py = medianRss(r, baselineKey)
    match arc > 0.0 && py > 0.0 {
        true => match py >= arc {
            true => memoryLine(arc, py, "Python", py / arc)
            false => memoryLine(arc, py, "Osprey (ARC)", arc / py)
        }
        false => ""
    }
}

fn memoryLine(arc, py, who, ratio) = "<p class=\"verdict\">Median sampled memory: Osprey (ARC) <b>${fixed(arc)} MiB</b> vs Python <b>${fixed(py)} MiB</b> — ${who} uses ${fixed(ratio)}× more.</p>"

/// One card per workload: throughput bars, then every metric in one table.
fn workloadHtml(r, row) = "<div class=\"card\">
  <h2>${esc(row.name)} <small>· ${toString(row.permutations)} input permutations</small></h2>
  ${foldList(r.runtimes, "", barHtml(r, row))}
  <table>
    <tr><th>Runtime</th><th>Throughput req/s ↑</th><th>Latency p50 ms ↓</th><th>Latency p95 ms ↓</th><th>Memory MiB ↓</th><th>vs Python</th></tr>
    ${foldList(r.runtimes, "", tableRowHtml(r, row))}
  </table>
</div>"

fn barHtml(r, row) = fn(acc, entry) => match workloadOf(entry, row.name) {
    Present { workload } => "${acc}<div class=\"bar ${barColor(entry.key)}\" style=\"width:${toString(barWidth(r, row, workload))}%\"><span>${esc(displayName(entry.key))} — ${rate(workload.rps)} req/s</span></div>"
    Absent => acc
}

/// Bar width as a percentage of the row's best throughput.
fn barWidth(r, row, workload) = floatToInt(round(workload.rps / bestOf(r, row, rpsMetric, higher) * 100.0)) ?: 100

fn tableRowHtml(r, row) = fn(acc, entry) => match workloadOf(entry, row.name) {
    Present { workload } => "${acc}<tr>${nameCell(entry)}${metricCell(r, row, workload, rpsMetric, higher, rate(workload.rps))}${metricCell(r, row, workload, p50Metric, lower, fixed(workload.latencyMs))}${metricCell(r, row, workload, p95Metric, lower, fixed(workload.p95Ms))}${metricCell(r, row, workload, rssMetric, lower, fixed(workload.rssMib))}${chipCell(r, row, workload, entry)}</tr>"
    Absent => acc
}

fn nameCell(entry) = match entry.key == baselineKey {
    true => "<td class=\"baseline\">${esc(displayName(entry.key))} — baseline</td>"
    false => "<td>${esc(displayName(entry.key))}</td>"
}

/// One metric cell, green when it wins its column.
fn metricCell(r, row, workload, metric, wins, rendered) = match metric(workload) == bestOf(r, row, metric, wins) {
    true => "<td class=\"best\">${rendered}</td>"
    false => "<td>${rendered}</td>"
}

fn chipCell(r, row, workload, entry) = match entry.key == baselineKey {
    true => "<td class=\"baseline\">baseline</td>"
    false => {
        let rps = workload.rps
        match runtimeWorkload(r, baselineKey, row.name) {
            Present { workload } => {
                let c = compare(rps, workload.rps)
                "<td><span class=\"${chipClass(c)}\">${esc(pctLabel(c))}</span></td>"
            }
            Absent => "<td class=\"baseline\">no baseline</td>"
        }
    }
}

fn methodHtml(r) = "<div class=\"card\">
  <h2>Method &amp; caveats</h2>
  <p class=\"kv\"><b>Scope:</b> ${esc(r.meta.notes.scope)}<br>
  <b>Method:</b> ${esc(r.meta.notes.method)}<br>
  <b>Trials:</b> ${toString(r.meta.counts.trials)} × ${toString(r.meta.counts.samples)} requests per workload · ${toString(r.meta.counts.workers)} workers · ${toString(r.meta.counts.warmup)} warm-up responses<br>
  <b>Memory note:</b> ${esc(r.meta.notes.memory)}</p>
</div>"

/// The whole report page: header and verdict, one card per workload, method.
fn render(r) = page("${headerHtml(r)}${foldList(rowsOf(r), "", fn(acc, row) => "${acc}${workloadHtml(r, row)}")}${methodHtml(r)}")

// --- effects: read, decode, render, write ------------------------------------

/// Set by the Arith handler: any arithmetic fault while rendering is fatal to
/// the whole report — no percentage or bar is ever invented.
mut arithFault = ""

fn main() = guarded(fn() => match renderFile() {
        Success { value } => {
            print("report: ${value}")
            0
        }
        Error { message } => {
            print("benchreport: ${message}")
            1
        }
})

/// Reads and decodes the results, renders, and writes the page only when the
/// render was arithmetically clean.
fn renderFile() = {
    let paths = benchmarkPaths()
    match readFile(paths.input) {
        Error { message } => Error { message: "cannot read ${paths.input}: ${message}" }
        Success { value } => match decodeReport(value) {
            Error { message } => Error { message: message }
            Success { value } => {
                let html = render(value)
                match arithFault {
                    "" => writeReport(html, paths.output)
                    _ => Error { message: "${arithFault} while rendering; ${paths.output} not written" }
                }
            }
        }
    }
}

fn writeReport(html, outputPath) = match writeFile(outputPath, html) {
    Error { message } => Error { message: "cannot write ${outputPath}: ${message}" }
    Success => Success { value: outputPath }
}

fn guarded(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            arithFault = "integer overflow (${op})"
            wrapped
        }
        divideByZero op _ => {
            arithFault = "division by zero (${op})"
            0.0
        }
    }
    work()
}
