namespace json_tests

import ui::Doc

sample () = Doc::parse "{\"text\":\"hello\\n\\\"world\\\"\",\"empty\":\"\",\"integer\":-42,\"decimal\":2.5,\"yes\":true,\"no\":false,\"nothing\":null,\"list\":[null,true,1,1.5,\"x\",[],{}],\"object\":{\"first\":1,\"second\":2}}"

// One assertion per case in a table: `read` answers for each case's `at` and the
// case names the value it must answer with.
checked (read, cases) = forEachList (cases, \c => expect (read c.at, c.want))

// The same table for cases that already hold the value they were read into.
same (cases) = checked (\value => value, cases)

test ("parse reads complete documents and falls back to null for malformed input", \() =>
    doc = sample ()
    same ([{ at = Doc::kind doc, want = "object" }, { at = Doc::text (doc, "text"), want = "hello\n\"world\"" }, { at = Doc::kind (Doc::field (doc, "nothing")), want = "null" }, { at = join (Doc::keys (Doc::field (doc, "object"))) ",", want = "first,second" }, { at = Doc::write (Doc::parse "{not json"), want = "null" }])
    same ([{ at = Doc::number (doc, "integer"), want = 0 - 42 }, { at = length (Doc::items (Doc::field (doc, "list"))), want = 7 }])
    expect (Doc::decimal (doc, "decimal"), 2.5)
    same ([{ at = Doc::flag (doc, "yes"), want = true }, { at = Doc::flag (doc, "no"), want = false }])
    forEachList ([{ text = "{not json", want = "null" }, { text = "", want = "null" }, { text = "[]", want = "list" }, { text = "{}", want = "object" }], \c => expect (Doc::kind (Doc::parse c.text), c.want)))

test ("field and has distinguish absent members from present null and reject non-objects", \() =>
    doc = sample ()
    checked (\key => Doc::has (doc, key), [{ at = "nothing", want = true }, { at = "missing", want = false }, { at = "text", want = true }, { at = "", want = false }])
    checked (\key => Doc::kind (Doc::field (doc, key)), [{ at = "missing", want = "null" }, { at = "nothing", want = "null" }])
    expect (Doc::text (Doc::field (doc, "object"), "first"), "")
    expect (Doc::number (Doc::field (doc, "object"), "first"), 1)
    forEachList ([{ holder = JsonNull, key = "x", want = false }, { holder = JsonArray [JsonInt 1], key = "0", want = false }, { holder = JsonString "x", key = "x", want = false }], \c => expect (Doc::has (c.holder, c.key), c.want))
    forEachList ([{ holder = JsonArray [JsonInt 1], want = "null" }, { holder = JsonInt 1, want = "null" }], \c => expect (Doc::kind (Doc::field (c.holder, "x")), c.want)))

test ("typed member readers return values only for their kinds and neutral values otherwise", \() =>
    doc = sample ()
    checked (\key => Doc::text (doc, key), [{ at = "text", want = "hello\n\"world\"" }, { at = "empty", want = "" }, { at = "missing", want = "" }, { at = "integer", want = "" }, { at = "nothing", want = "" }, { at = "object", want = "" }])
    checked (\key => Doc::number (doc, key), [{ at = "integer", want = 0 - 42 }, { at = "missing", want = 0 }, { at = "decimal", want = 0 }, { at = "text", want = 0 }, { at = "yes", want = 0 }])
    checked (\key => Doc::decimal (doc, key), [{ at = "decimal", want = 2.5 }, { at = "integer", want = 0.0 - 42.0 }, { at = "missing", want = 0.0 }, { at = "text", want = 0.0 }, { at = "yes", want = 0.0 }])
    checked (\key => Doc::flag (doc, key), [{ at = "yes", want = true }, { at = "no", want = false }, { at = "missing", want = false }, { at = "integer", want = false }, { at = "text", want = false }, { at = "nothing", want = false }]))

test ("kind and real and string handle every JSON variant including numeric widening", \() =>
    checked (Doc::kind, [{ at = JsonNull, want = "null" }, { at = JsonBool false, want = "bool" }, { at = JsonInt (0 - 9), want = "number" }, { at = JsonFloat (0.0 - 0.25), want = "number" }, { at = JsonString "", want = "text" }, { at = JsonArray [], want = "list" }, { at = JsonObject [], want = "object" }])
    checked (Doc::real, [{ at = JsonNull, want = 0.0 }, { at = JsonBool true, want = 0.0 }, { at = JsonInt (0 - 9), want = 0.0 - 9.0 }, { at = JsonFloat 3.75, want = 3.75 }, { at = JsonString "3.75", want = 0.0 }, { at = JsonArray [JsonInt 1], want = 0.0 }, { at = JsonObject [], want = 0.0 }])
    checked (Doc::string, [{ at = JsonString "value", want = "value" }, { at = JsonString "", want = "" }, { at = JsonNull, want = "" }, { at = JsonBool true, want = "" }, { at = JsonInt 3, want = "" }, { at = JsonFloat 3.0, want = "" }, { at = JsonArray [], want = "" }, { at = JsonObject [], want = "" }]))

test ("items and at traverse arrays totally across empty negative and out-of-range cases", \() =>
    doc = Doc::field (sample (), "list")
    expect (length (Doc::items doc), 7)
    same ([{ at = Doc::kind (Doc::at (doc, 0)), want = "null" }, { at = Doc::string (Doc::at (doc, 4)), want = "x" }])
    expect (Doc::flag (Doc::parse "{\"v\":${Doc::write (Doc::at (doc, 1))}}", "v"), true)
    checked (\at => Doc::real (Doc::at (doc, at)), [{ at = 2, want = 1.0 }, { at = 3, want = 1.5 }])
    checked (\at => Doc::kind (Doc::at (doc, at)), [{ at = 5, want = "list" }, { at = 6, want = "object" }, { at = 7, want = "null" }, { at = 0 - 1, want = "null" }])
    checked (\at => Doc::kind (Doc::at (at, 0)), [{ at = JsonArray [], want = "null" }, { at = JsonObject [], want = "null" }, { at = JsonString "x", want = "null" }])
    checked (\at => length (Doc::items at), [{ at = JsonArray [], want = 0 }, { at = JsonNull, want = 0 }, { at = JsonObject [], want = 0 }, { at = JsonString "abc", want = 0 }]))

test ("members and keys preserve object order and return none for other kinds", \() =>
    doc = Doc::parse "{\"z\":null,\"a\":1,\"middle\":2,\"nested\":{\"k\":true}}"
    same ([{ at = length (Doc::members doc), want = 4 }, { at = Doc::number (doc, "a"), want = 1 }])
    expect (Doc::flag (Doc::field (doc, "nested"), "k"), true)
    same ([{ at = join (Doc::keys doc) ",", want = "z,a,middle,nested" }, { at = join (Doc::keys (JsonObject [])) ",", want = "" }, { at = join (Doc::keys (JsonArray [JsonInt 1])) ",", want = "" }])
    checked (\at => length (Doc::members at), [{ at = JsonObject [], want = 0 }, { at = JsonArray [JsonInt 1], want = 0 }, { at = JsonNull, want = 0 }, { at = JsonString "{}", want = 0 }]))

test ("texts maps arrays member-wise and substitutes empty strings for wrong element kinds", \() =>
    doc = Doc::parse "{\"mixed\":[\"a\",1,null,true,2.5,{},\"b\"],\"empty\":[],\"wrong\":\"ab\"}"
    mixed = Doc::texts (doc, "mixed")
    expect (length mixed, 7)
    same ([{ at = join mixed ",", want = "a,,,,,,b" }, { at = join (Doc::texts (doc, "empty")) ",", want = "" }, { at = join (Doc::texts (Doc::parse "{\"v\":[\"\",\"x\\ny\",\"λ\"]}", "v")) "|", want = "|x\ny|λ" }])
    forEachList ([{ holder = doc, key = "empty" }, { holder = doc, key = "wrong" }, { holder = doc, key = "missing" }, { holder = JsonNull, key = "mixed" }], \c => expect (length (Doc::texts (c.holder, c.key)), 0)))

test ("member and array builders compose into exact compact JSON", \() =>
    doc = JsonObject [Doc::str ("s", "x\n\""), Doc::num ("n", 0 - 7), Doc::dec ("d", 0.0 - 0.25), Doc::bit ("b", false), JsonMember "items" (Doc::strings ["a", "", "λ"])]
    same ([{ at = Doc::write doc, want = "{\"s\":\"x\\n\\\"\",\"n\":-7,\"d\":-0.25,\"b\":false,\"items\":[\"a\",\"\",\"λ\"]}" }, { at = Doc::text (doc, "s"), want = "x\n\"" }, { at = join (Doc::texts (doc, "items")) ",", want = "a,,λ" }])
    expect (Doc::number (doc, "n"), 0 - 7)
    expect (Doc::decimal (doc, "d"), 0.0 - 0.25)
    expect (Doc::flag (doc, "b"), false)
    checked (Doc::write, [{ at = Doc::strings [], want = "[]" }, { at = Doc::strings ["\"", "\\", "\n"], want = "[\"\\\"\",\"\\\\\",\"\\n\"]" }, { at = JsonObject [], want = "{}" }, { at = JsonArray [], want = "[]" }, { at = JsonNull, want = "null" }, { at = JsonBool true, want = "true" }, { at = JsonInt (0 - 1), want = "-1" }, { at = JsonFloat 0.5, want = "0.5" }, { at = JsonString "ok", want = "\"ok\"" }]))

test ("a realistic nested document survives reading rebuilding and writing without losing types", \() =>
    source = "{\"user\":{\"name\":\"Ada\",\"active\":true,\"score\":9,\"ratio\":0.5},\"tags\":[\"admin\",\"ops\"],\"attempts\":-2,\"note\":null}"
    doc = Doc::parse source
    user = Doc::field (doc, "user")
    rebuilt = JsonObject [Doc::str ("name", Doc::text (user, "name")), Doc::bit ("active", Doc::flag (user, "active")), Doc::num ("score", Doc::number (user, "score")), Doc::dec ("ratio", Doc::decimal (user, "ratio")), JsonMember "tags" (Doc::field (doc, "tags")), Doc::num ("attempts", Doc::number (doc, "attempts")), JsonMember "note" (Doc::field (doc, "note"))]
    same ([{ at = Doc::text (user, "name"), want = "Ada" }, { at = join (Doc::texts (doc, "tags")) "+", want = "admin+ops" }, { at = Doc::kind (Doc::field (doc, "note")), want = "null" }, { at = Doc::write rebuilt, want = "{\"name\":\"Ada\",\"active\":true,\"score\":9,\"ratio\":0.5,\"tags\":[\"admin\",\"ops\"],\"attempts\":-2,\"note\":null}" }, { at = join (Doc::keys rebuilt) ",", want = "name,active,score,ratio,tags,attempts,note" }])
    same ([{ at = Doc::number (user, "score"), want = 9 }, { at = Doc::number (doc, "attempts"), want = 0 - 2 }])
    expect (Doc::flag (user, "active"), true)
    expect (Doc::decimal (user, "ratio"), 0.5)
    expect (Doc::has (doc, "note"), true))
