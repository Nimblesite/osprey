"""CPython Jinja2 render and value oracles for the supported chat subset.

Two reference paths share this file. `TEMPLATES` renders through a plain
`jinja2.Environment(trim_blocks=True, lstrip_blocks=True)`. The Qwen3.8 chat
template renders through transformers' own chat-template environment —
`transformers.utils.chat_template_utils.render_jinja_template`, the exact render
step `apply_chat_template` calls — so its `tojson` override, `raise_exception`
and sandbox match what a model's tokenizer does. The template fixture is byte
identical to Qwen/Qwen3.8-27B at revision 1d4bf0f2ff6012fd82039f2fa52739d0dd7c60c0
(`chat_template.jinja`).
"""
import jinja2
import json
import pathlib
from expected_module import write

