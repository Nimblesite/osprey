    ("chat tools", [user("weather in Zürich?")], TOOLS, {}),
    ("chat tools with prompt", [user("weather?")], TOOLS, {"add_generation_prompt": True}),
    ("chat tools with system", [{"role": "system", "content": "You are a weather bot."}, user("weather?")], TOOLS,
     {"add_generation_prompt": True}),
    ("chat tools with empty system", [{"role": "system", "content": ""}, user("weather?")], TOOLS, {}),
    ("chat tools empty list", [user("hi")], [], {}),
    ("chat tool call", [user("weather?"), assistant("", calls=[CALL])], TOOLS, {}),
    ("chat tool call with text", [user("weather?"), assistant("Let me check.", calls=[CALL])], TOOLS, {}),
    ("chat tool call all types", [user("search"), assistant("", calls=[CALL_ALL_TYPES])], TOOLS,
     {"add_generation_prompt": True}),
    ("chat tool call nested function", [user("search"), assistant("", calls=[NESTED_CALL])], TOOLS, {}),
    ("chat tool call empty arguments", [user("search"), assistant("", calls=[{"function": {"name": "search", "arguments": ""}}])],
     TOOLS, {}),
    ("chat tool call no arguments", [user("search"), assistant("", calls=[{"function": {"name": "search"}}])], TOOLS, {}),
    ("chat tool result", [user("weather?"), assistant("", calls=[CALL]), tool("sunny, 21C")], TOOLS,
     {"add_generation_prompt": True}),
    ("chat tool results twice", [user("weather?"), assistant("", calls=[CALL, CALL]),
                                 tool("sunny"), tool("rainy")], TOOLS, {"add_generation_prompt": True}),
    ("chat tool multi step", [user("weather?"), assistant("", calls=[CALL]), tool("sunny"),
                              assistant("", calls=[CALL]), tool("rainy"), assistant("done"), user("again")],
     TOOLS, {"add_generation_prompt": True}),
    ("chat two tool turns", [user("q1"), assistant("", calls=[CALL]), tool("r1"), user("q2"),
                             assistant("", calls=[CALL]), tool("r2")], TOOLS, {"add_generation_prompt": True}),
    ("chat tool response tagged user", [user("q"), assistant("", calls=[CALL]), tool("r"), user("next")], TOOLS, {}),
    ("chat unicode", [{"role": "system", "content": "Règles: 日本語 🙂"},
                      user("émoji 🙂 中文 \u0001 combining e\u0301 rtl \u05d0\u05d1")], None,
     {"add_generation_prompt": True}),
    ("chat unicode assistant", [user("q"), assistant("回答 🙃", reasoning="思考…"), user("q2")], None, {}),
    ("chat multi turn deep", [{"role": "system", "content": "sys"}, user("u1"), assistant("a1"), user("u2"),
                               assistant("a2"), user("u3"), assistant("a3"), user("u4")], None,
     {"add_generation_prompt": True}),
    ("chat add vision id unused", [user("hi")], None, {"add_vision_id": False, "add_generation_prompt": True}),
    ("chat image in user", [user([{"type": "image", "image": "x"}])], None, {"add_generation_prompt": True}),
    ("chat image url in user", [user([{"image_url": "http://example/x.png"}])], None, {}),
    ("chat text and image", [user([{"type": "text", "text": "look"}, {"type": "image"}])], None, {}),
    ("chat two images", [user([{"type": "image"}, {"type": "image"}])], None, {"add_generation_prompt": True}),
    ("chat video in user", [user([{"type": "video", "video": "v"}])], None, {}),
    ("chat long message", [user(LONG_MESSAGE)], None, {"add_generation_prompt": True}),
]

CHAT_ERROR = [
    ("chat no messages", [], None, {}),
    ("chat system not first", [user("q"), {"role": "system", "content": "late"}], None, {}),
    ("chat unexpected role", [user("q"), {"role": "wizard", "content": "x"}], None, {}),
    ("chat assistant only", [assistant("x")], None, {}),
    ("chat tool response only", [user("<tool_response>\nr\n</tool_response>")], None, {}),
    ("chat unexpected content type", [{"role": "user", "content": 42}], None, {}),
    ("chat unexpected item type", [user([{"type": "audio"}])], None, {}),
    ("chat image in system", [{"role": "system", "content": [{"type": "image", "image": "x"}]}, user("q")],
     None, {}),
    ("chat video in system", [{"role": "system", "content": [{"type": "video", "video": "x"}]}, user("q")],
     None, {}),
    ("chat bad effort", [user("q")], None, {"reasoning_effort": "extreme"}),
]


def chat_cases():
    """The conversations the template renders, as (name, messages, tools, kwargs)."""
    return CHAT


def chat_error_cases():
    """The conversations the template rejects, as (name, messages, tools, kwargs)."""
    return CHAT_ERROR


if __name__ == "__main__":
    main()
