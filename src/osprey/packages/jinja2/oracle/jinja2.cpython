def main():
    env = jinja2.Environment(trim_blocks=True, lstrip_blocks=True)
    context = dict(name="world", nums=[1, 2, 3], enabled=True, nothing=None, obj={"x": 4})
    cases = [[name, template, env.from_string(template).render(context)] for name, template in TEMPLATES]
    errors = [[name, template, error_message(env, template, context)] for name, template in ERROR_TEMPLATES]
    macro_source = "{% macro hi(x) %}Hi {{ x }}{% endmacro %}"
    macro = env.parse(macro_source).body[0]
    template = TEMPLATE_FIXTURE.read_text(encoding="utf-8")
    renders = [[name, chat_context(messages, tools, kwargs), chat_render(template, messages, tools, kwargs)]
               for name, messages, tools, kwargs in chat_cases()]
    rejected = [[name, chat_context(messages, tools, kwargs), chat_error(template, messages, tools, kwargs)]
                for name, messages, tools, kwargs in chat_error_cases()]
    write("jinja2", "Jinja2 chat-environment renders and failure messages over a fixed JSON-like context, plus the "
          "unmodified Qwen3.8 chat template rendered through transformers' own chat-template environment.",
          {"jinja2": jinja2.__version__, "transformers": transformers_version()}, {
              "RENDERS": cases, "CHARS": list("aé🙂"), "REVERSED": "aé🙂"[::-1],
              "SPLIT": " a\t b\n c ".split(), "SEP_SPLIT": "a,,b,".split(","),
              "CAPITALIZED": "hELLO".capitalize(), "REPR": repr("a\nb"), "BOOL_TEXT": str(True),
              "JSON": json.dumps({"x": 2}), "PRETTY_JSON": json.dumps({"x": 2}, indent=2),
              "PRETTY_LIST_JSON": json.dumps([1, 2], indent=2),
              "FLOORDIV": -7 // 3, "MODULO": -7 % 3,
              "MACRO_SOURCE": macro_source, "MACRO_NAME": macro.name, "MACRO_PARAMS": [arg.name for arg in macro.args],
              "ERRORS": errors, "CHAT_TEMPLATE": template, "CHAT_RENDERS": renders, "CHAT_ERRORS": rejected,
          })


def error_message(env, template, context):
    """CPython's exception text for a template the port also rejects."""
    try:
        env.from_string(template).render(context)
    except Exception as error:
        return str(error)
    raise AssertionError(f"oracle template unexpectedly rendered: {template}")


# The Qwen3.8 chat template, through transformers' chat-template environment.

def transformers_version():
    """transformers' version, imported here so `main` states it in the module header."""
    import transformers

    return transformers.__version__


def chat_context(messages, tools, kwargs):
    """The template's context as one JSON object: messages, tools when given, and each template keyword."""
    context = {"messages": messages}
    if tools is not None:
        context["tools"] = tools
    context.update(kwargs)
    return json.dumps(context, ensure_ascii=False)


def chat_render(template, messages, tools, kwargs):
    """`apply_chat_template`'s render step for one conversation."""
    from transformers.utils.chat_template_utils import render_jinja_template

    rendered, _ = render_jinja_template(conversations=[messages], tools=tools, chat_template=template, **kwargs)
    return rendered[0]


def chat_error(template, messages, tools, kwargs):
    """transformers' exception text for a conversation this template rejects."""
    try:
        chat_render(template, messages, tools, kwargs)
    except Exception as error:
        return str(error)
    raise AssertionError(f"oracle conversation unexpectedly rendered: {messages}")


