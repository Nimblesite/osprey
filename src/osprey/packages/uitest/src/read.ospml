// What a host is sent, read back as typed records ([UI-MACHINE-TEST], [NATIVE-SHM-VIEW]): the
// rows, fits and scenes `ui::Surfaces::seen` walks, and the requests the last step sent. Nothing
// is decoded: a test reads the very rows a host lays out.
namespace uitest

import ui::Lists
import ui::Pick
import ui::Views
import ui::Requests

(** One drawn control: its kind, its words, its second text (a prompt, a picker's name or an icon), the control number its events name (-1 for none), its ink, whether it takes input, the key of its chosen option and its options' keys. *)
type Control =
    controlKind : string
    controlText : string
    controlHint : string
    controlOrdinal : int
    controlInk : int
    controlEnabled : bool
    controlSelected : string
    controlChoices : List<string>

(** What a host last saw: the controls, the canvas's lettering, curves and accessibility tree, the kinds of the requests the last step made and the control number of the first scene. *)
type Rendered =
    renderedControls : List<Control>
    renderedLetters : List<string>
    renderedCurves : List<List<float>>
    renderedAccess : List<ui::Accessible>
    renderedRequests : List<string>
    renderedOrdinal : int

(** Reads a walked view as a host would ([NATIVE-SHM-VIEW]). *)
module Read
    (** Nothing seen yet. *)
    export blank () = Rendered(renderedControls = [], renderedLetters = [], renderedCurves = [], renderedAccess = [], renderedRequests = [], renderedOrdinal = 0 - 1)

    kinds = ["column", "line", "label", "press", "entry", "gap", "scroll", "layer", "toggle", "picker", "option", "rule", "image", "canvas", "editor", "menu", "sheet"]

    kindName kind = listGet kinds kind ?: "unknown"

    // Every fit of the row at `index`, its flags added up.
    flags (walk, index) = foldList (filterList (walk.walkFits, \f => f.fittedRow == index), 0, \(all, f) => bitOr all f.fittedAs.traits)

    hints (walk, index) = mapList (filterList (walk.walkFits, \f => f.fittedRow == index && f.fittedAs.hint != ""), \f => f.fittedAs.hint)

    hint (walk, index) = listGet (hints (walk, index)) 0 ?: ""

    // The rows whose parent is `index`, by their own indices.
    children (walk, index) = filterList (toList (range (0, length walk.walkRows)), \i => (listGet walk.walkRows i ?: Views::blank).placedParent == index)

    options (walk, index) = filterList (children (walk, index), \i => (listGet walk.walkRows i ?: Views::blank).placedKind == Views::option)

    chosenKey (walk, index) = listGet (mapList (filterList (options (walk, index), \i => bitAnd (flags (walk, i)) Views::chosen != 0), \i => hint (walk, i))) 0 ?: ""

    control (walk, index) =
        row = listGet walk.walkRows index ?: Views::blank
        Control(controlKind = kindName row.placedKind, controlText = row.placedWords, controlHint = hint (walk, index), controlOrdinal = row.placedAction, controlInk = row.placedLook.ink, controlEnabled = bitAnd (flags (walk, index)) Views::disabled == 0, controlSelected = chosenKey (walk, index), controlChoices = mapList (options (walk, index), \i => hint (walk, i)))

    lettered shape = match shape
        ui::Lettering text _ _ _ _ _ _ _ => [text]
        ui::Glyphs text _ _ _ _ _ => [text]
        _ => []

    // A path that moves to a point and runs a cubic curve to another is a curve between them, read as x1, y1, x2, y2.
    curve steps = match listGet steps 0
        Success first => match listGet steps 1
            Success second => joined (first, second)
            Error _ => []
        Error _ => []

    joined (first, second) = match first
        ui::MoveTo x1 y1 => match second
            ui::CubicTo x2 y2 _ _ _ _ => [[x1, y1, x2, y2]]
            _ => []
        _ => []

    curved shape = match shape
        ui::Path steps _ _ _ _ _ _ => curve steps
        _ => []

    shapes walk = Lists::flatten (mapList (walk.walkSketches, \s => s.sketchedAs.sketchShapes))

    sceneOrdinal walk = match listGet walk.walkSketches 0
        Success first => (listGet walk.walkRows first.sketchedRow ?: Views::blank).placedAction
        Error _ => 0 - 1

    (** A walked view and the requests its step sent, as a host reads them. *)
    export seen (walk, asked) = Rendered(renderedControls = mapList (toList (range (0, length walk.walkRows)), \i => control (walk, i)), renderedLetters = Lists::flatten (mapList (shapes walk, lettered)), renderedCurves = Lists::flatten (mapList (shapes walk, curved)), renderedAccess = Lists::flatten (mapList (walk.walkSketches, \s => s.sketchedAs.sketchAccess)), renderedRequests = mapList (asked, \r => Requests::kind r.capability), renderedOrdinal = sceneOrdinal walk)
