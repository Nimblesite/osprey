// Readers for a rendered native view ([UI-MACHINE-TEST]): controls found by
// what a person or an agent reads on them, never by position.
namespace uitest

import ui::Lists

(** Finds rendered controls by their label, text or title, and the canvas's lettering. *)
module Views
    (** Every drawn control whose words, or whose prompt or picker's name, are `label`. *)
    export labelled (seen, label) = filterList (seen.renderedControls, \c => c.controlText == label || c.controlHint == label || (c.controlValue == label && label != ""))

    (** The first drawn control matching `label`, or an empty one with no kind when none does. *)
    export control (seen, label) = listGet (labelled (seen, label)) 0 ?: Control(controlKind = "", controlText = "", controlHint = "", controlValue = "", controlTone = "", controlOrdinal = 0 - 1, controlEnabled = false, controlSelected = "", controlChoices = [])

    (** Whether any drawn control matches `label`. *)
    export shows (seen, label) = length (labelled (seen, label)) > 0

    (** Every control's nonempty words in the view, `|`-separated, for a failure message. *)
    export texts seen = join (filterList (mapList (seen.renderedControls, \c => c.controlText), \t => t != "")) "|"

    (** Whether the last step made a request of `kind`. *)
    export requested (seen, kind) = Lists::any (seen.renderedRequests, \k => k == kind)

    (** The strings the canvas letters, `|`-separated. *)
    export lettered seen = join seen.renderedLetters "|"

    (** Whether the canvas letters `text` exactly. *)
    export letters (seen, text) = Lists::any (seen.renderedLetters, \t => t == text)
