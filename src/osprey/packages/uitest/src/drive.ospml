// A test's hold on one live surface ([UI-MACHINE-TEST], [NATIVE-SHM-EVENT]): the surface, the
// program it runs and the host clock. Every step is the typed host event a real host sends,
// delivered through `ui::Hosting::event`, so a test names controls by label and drives the very
// boundary a host calls. The frame each step draws is written nowhere: `quiet` takes its rows,
// and the test reads the same rows back through `ui::Surfaces::seen`.
namespace uitest

import ui::Hosting
import ui::Surfaces
import ui::Runtime
import ui::Lists

(** One live surface as a test drives it: the surface, its program, what it last showed and the host clock. *)
type Driven S A =
    drivenSurface : ui::Surface<S, A>
    drivenProgram : ui::Program<S, A>
    drivenSeen : Rendered
    drivenNow : int

(** Sends typed host events to a driven surface and explains failed lookups. *)
module Drive
    looked (d, held) = d(drivenSurface = held, drivenSeen = Read::seen (Surfaces::seen (held, d.drivenProgram), held.surfaceAsked), drivenNow = satAdd d.drivenNow 1)

    (** A surface holding `store` before its host opens it, the clock at 1. *)
    export idle (program, store) = Driven(drivenSurface = Surfaces::idle store, drivenProgram = program, drivenSeen = Read::blank (), drivenNow = 1)

    (** `d` opened on `platform` with the launch `arguments`, its home `/home/tester` and its appearance light. *)
    export launched (d, platform, arguments) =
        given = foldList (arguments, d.drivenSurface, \(held, text) => Surfaces::argued (held, text))
        looked (d, ui::Views::quiet (\() => Hosting::opened (given, d.drivenProgram, d.drivenNow, 0, platform, "/home/tester", false)))

    touch (d, kind, ordinal, words, detail, x, y, down, shift) = ui::Touch(touchNow = d.drivenNow, touchKind = kind, touchOrdinal = ordinal, touchWords = words, touchDetail = detail, touchX = x, touchY = y, touchDown = down, touchShift = shift)

    (** `d` after the host event `event`. *)
    export sent (d, event) = looked (d, ui::Views::quiet (\() => Hosting::event (d.drivenSurface, d.drivenProgram, event)))

    // The control a person or an agent finds by `label`.
    numbered (d, label) = (Views::control (d.drivenSeen, label)).controlOrdinal

    (** A press of the control labelled `label`. *)
    export press (d, label) = sent (d, touch (d, Hosting::control, numbered (d, label), "", "", 0.0, 0.0, false, false))

    (** `words` typed into, or a key chosen on, the control labelled `label`. *)
    export choose (d, label, words) = sent (d, touch (d, Hosting::control, valued (d, label), words, "", 0.0, 0.0, false, false))

    // The control `label` names that takes a value, ahead of a heading or press with the same words.
    valued (d, label) = match Lists::find (Views::labelled (d.drivenSeen, label), \c => Lists::any (["field", "editor", "picker", "toggle", "rows", "tabs", "disclosure", "aside"], \kind => kind == c.controlKind))
        Success found => found.controlOrdinal
        Error _ => numbered (d, label)

    (** A pointer at `x`, `y` on the scene, pressed or released. *)
    export pointer (d, x, y, down) = sent (d, touch (d, Hosting::pointer, d.drivenSeen.renderedOrdinal, "", "", x, y, down, false))

    (** A key going down or up over the scene. *)
    export key (d, name, down) = sent (d, touch (d, Hosting::key, d.drivenSeen.renderedOrdinal, name, "", 0.0, 0.0, down, false))

    (** The scene's region measured at `width` by `height` scene units, as the host reports it on showing or resizing. *)
    export viewed (d, width, height) = sent (d, touch (d, Hosting::viewed, d.drivenSeen.renderedOrdinal, "", "", width, height, false, false))

    (** A display frame `seconds` after the last. *)
    export frame (d, seconds) = sent (d, touch (d, Hosting::frame, 0, "", "", seconds, 0.0, false, false))

    (** The capability of request `ticket` completed: `ok` with its result `text`, or its reason. *)
    export completed (d, ticket, ok, text) = sent (d, touch (d, Hosting::completed, 0, ticket, text, 0.0, 0.0, ok, false))

    (** The file picker of request `ticket` answered with `path`; an empty path is a cancel. *)
    export chosen (d, ticket, path) = completed (d, ticket, true, path)

    (** The process of request `ticket` finished: a zero `status` succeeds, any other fails with `stderr`. *)
    export ran (d, ticket, status, stderr) = completed (d, ticket, status == 0, stderr)

    (** The host reaching the lifecycle `phase`, such as `resume` or `open:<path>`. *)
    export phase (d, name) = sent (d, touch (d, Hosting::phase, 0, name, "", 0.0, 0.0, false, false))

    (** The platform opening `path` with the app. *)
    export opened (d, path) = phase (d, "open:${path}")

    explained (ok, why) = match ok
        true => true
        false =>
            print "# ${why}"
            false

    (** Whether the view shows `label`; when not, prints what it does show. *)
    export shows (d, label) = explained (Views::shows (d.drivenSeen, label), "not shown: ${label}; the view shows ${Views::texts d.drivenSeen}")

    (** Whether the canvas letters `text`; when not, prints what it does letter. *)
    export letters (d, text) = explained (Views::letters (d.drivenSeen, text), "not lettered: ${text}; the artboard letters ${Views::lettered d.drivenSeen}")

    (** Whether the accessibility tree offers `label`; when not, prints the tree as an agent reads it. *)
    export offers (elements, label) = explained (Semantics::offered (elements, label), "not offered: ${label}; the tree offers:\n${Semantics::outline elements}")
