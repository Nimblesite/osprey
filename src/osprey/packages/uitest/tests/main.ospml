// @osprey/uitest end to end ([UI-MACHINE-CANVAS], [UI-MACHINE-EACH],
// [UI-MACHINE-MENU], [UI-MACHINE-A11Y], [UI-MACHINE-TEST]): a real machine
// document driven without an application, session, host or window.

import ui::Canvases
import ui::Doc
import ui::Inputs
import ui::Keyed
import ui::MachineDocs
import ui::Machines
import ui::Messages
import ui::Runtime
import ui::Templates
import ui::Values
import uitest::Drive
import uitest::Events
import uitest::Read
import uitest::Semantics
import uitest::Views
loaded work = match MachineDocs::load (readFile "src/osprey/packages/uitest/tests/fixture.machine.json" ?: "")
    Success machine => work machine
    Error problem => expect ("fixture loads: ${problem}", "fixture loads")

withFixture work = Runtime::guarded (\() => loaded work)
seen machine = Read::tree (Runtime::tree (Templates::view machine))

// The machine's canvas, and what a test reads off it.
canvas machine = Canvases::semantics machine
value machine = Semantics::value (canvas machine, "Level")
letters (machine, text) = Views::letters (seen machine, text)
feed (machine, name, text) = Machines::feed (machine, [Machines::fact (name, Values::text text)])
releasedAt (machine, label, fraction) =
    p = Semantics::point (Semantics::element (canvas machine, label), fraction)
    Canvases::released (machine, p.pointX, p.pointY)

// Acting on the slider at `fraction` of its width leaves it reading `fraction`.
slidTo (machine, fraction) =
    moved = Canvases::act (machine, "Level", fraction)
    expect (value moved, fraction)
    moved

// Lettering that has arrived, and lettering that has gone: `read` answers for one name.
letteredOver (read, shown, gone) =
    forEachList (shown, \text => expect (read text, true))
    forEachList (gone, \text => expect (read text, false))

lettering (machine, shown, gone) = letteredOver (\text => letters (machine, text), [shown], [gone])

// Where the slider's track sits at `fraction` of its width.
tracked (slider, spot) =
    p = Semantics::point (slider, spot.fraction)
    expect (p.pointX, spot.x)
    expect (p.pointY, 315.0)

// Feeding a fresh caption shows its lettering and retires the previous one.
captioned (machine, shown, gone) =
    fed = feed (machine, "caption", shown)
    lettering (fed, shown, gone)
    fed

// An event as the host's wire carries it, for checking the encoder's contract.
wire event = Doc::parse event

// A canvas whose menu is shut: its labels, and no dismissal on offer.
shut (machine, names) =
    expect (Semantics::labels (canvas machine), names)
    expect (Semantics::offered (canvas machine, "Dismiss"), false)

// Wire fields, one assertion per `{ name = …, value = … }`, read as the encoder writes them.
readFields (read, wired, fields) = forEachList (fields, \field => expect (read (wired, field.name), field.value))

test ("the canvas use case: accessible controls, geometry, sliders, repeated menus, dismissal and live lettering", \() => withFixture (\fresh =>
    expect (Semantics::offered (canvas fresh, "Menu"), true)
    shut (fresh, "Menu|Press|Level")
    forEachList ([{ named = "Menu", played = "popup" }, { named = "Press", played = "button" }, { named = "Level", played = "slider" }, { named = "Missing", played = "none" }], \spot => expect (Semantics::role (canvas fresh, spot.named), spot.played))
    expect (value fresh, 0.25)
    expect (letters (fresh, "Hello"), true)
    slider = Semantics::element (canvas fresh, "Level")
    forEachList ([{ fraction = 0.0, x = 20.0 }, { fraction = 0.5, x = 120.0 }, { fraction = 1.0, x = 220.0 }], \spot => tracked (slider, spot))
    pressed = Canvases::act (fresh, "Press", 0.5)
    lettering (pressed, "Pressed", "Hello")
    full = slidTo (slidTo (slidTo (pressed, 0.0), 0.5), 1.0)
    released = releasedAt (full, "Level", 0.75)
    expect (value released, 0.75)
    opened = Canvases::act (released, "Menu", 0.5)
    shut (opened, "One|Two|Three|Menu|Press|Level")
    expect (Semantics::role (canvas opened, "One"), "menuitem")
    letteredOver (\text => letters (opened, text), ["One", "Two", "Three"], [])
    dismissed = Canvases::released (opened, 5.0, 5.0)
    shut (dismissed, "Menu|Press|Level")
    reopened = Canvases::act (dismissed, "Menu", 0.5)
    chosen = Canvases::act (reopened, "Two", 0.5)
    shut (chosen, "Menu|Press|Level")
    expect (letters (chosen, "Choice two"), true)
    updated = captioned (chosen, "Updated", "Pressed")
    again = captioned (updated, "Second input", "Updated")
    expect (value again, 0.75)))

test ("native views are found by what they say, and every host event keeps its wire contract", \() => withFixture (\fresh =>
    native = Machines::feed (fresh, [Machines::fact ("skin", Values::text "plain"), Machines::fact ("caption", Values::text "Native"), Machines::fact ("selected", Values::text "two")])
    shown = seen native
    expect (length shown.renderedControls > 1, true)
    expect (length (Views::labelled (shown, "Native")), 1)
    forEachList ([{ named = "Native action", shown = true }, { named = "Missing", shown = false }], \row => expect (Views::shows (shown, row.named), row.shown))
    forEachList ([{ named = "Native action", kind = "button" }, { named = "Missing", kind = "" }], \row => expect ((Views::control (shown, row.named)).controlKind, row.kind))
    expect (Views::texts shown, "Native|Native action|two|Pick|One|Two|Three")
    expect (Views::lettered shown, "")
    asked = Read::envelope (Read::blank (), "{\"requests\":[{\"kind\":\"run\"},{\"kind\":\"animate\"}]}")
    forEachList ([{ kinds = ["run", "animate"], want = true }, { kinds = ["choose-file"], want = false }], \row => reading (row.kinds, \kind => Views::requested (asked, kind), row.want))
    expect (asked.renderedRevision, 0)
    press = wire (Events::press (4, 2, 10))
    readFields (Doc::text, press, [{ name = "kind", value = "ui" }, { name = "region", value = "root" }])
    readFields (Doc::number, press, [{ name = "revision", value = 4 }, { name = "ordinal", value = 2 }, { name = "now", value = 10 }])
    expect (Doc::kind (Doc::field (press, "value")), "null")
    choose = wire (Events::choose (5, 3, "two \"quoted\"", 11))
    readFields (Doc::text, choose, [{ name = "value", value = "two \"quoted\"" }])
    pointer = Doc::field (wire (Events::pointer (6, 4, 12.5, 20.0, true, 12)), "value")
    readFields (Doc::decimal, pointer, [{ name = "x", value = 12.5 }, { name = "y", value = 20.0 }])
    readFields (Doc::flag, pointer, [{ name = "down", value = true }])
    chosen = wire (Events::chosen ("choose", "/music/a \"b\".mp3", 13))
    readFields (Doc::text, chosen, [{ name = "kind", value = "completed" }, { name = "ticket", value = "choose" }])
    readFields (Doc::flag, chosen, [{ name = "ok", value = true }])
    expect (Doc::text (Doc::field (chosen, "result"), "path"), "/music/a \"b\".mp3")
    expect (Doc::flag (Doc::field (wire (Events::cancelled ("choose", 14)), "result"), "cancelled"), true)
    ran = Doc::field (wire (Events::ran ("discover", 2, "no route", 15)), "result")
    readFields (Doc::number, ran, [{ name = "status", value = 2 }])
    readFields (Doc::text, ran, [{ name = "stderr", value = "no route" }])
    expect (Doc::decimal (wire (Events::frame (0.25, 16)), "elapsed"), 0.25)
    expect (Doc::text (wire (Events::lifecycle ("resume", 17)), "phase"), "resume")
    expect (Doc::text (wire (Events::open ("/tmp/example.mp3", 18)), "phase"), "open:/tmp/example.mp3")))

test ("a broken document is refused with every problem named by its path", \() => Runtime::guarded (\() =>
    refused = match MachineDocs::load "not json"
        Success _ => "loaded"
        Error problem => problem
    expect (refused, "the machine document is not JSON")
    broken = "{\"schema\":2,\"inputs\":{\"a\":{\"type\":\"colour\"},\"b\":{\"type\":\"number\",\"value\":\"x\"}},\"layers\":[{\"name\":\"l\",\"initial\":\"gone\",\"states\":{\"s\":{}},\"transitions\":[{\"from\":\"q\",\"to\":\"s\"}]}],\"view\":{\"kind\":\"button\",\"colour\":\"red\",\"on\":{\"fire\":\"nope\"},\"children\":[{\"kind\":\"widget\"}]}}"
    expect (join (MachineDocs::problems (Doc::parse broken)) "\n", join ["schema: expected 1", "inputs.a.type: expected one of bool, number, text, trigger, list", "inputs.b.value: not a number", "layers[0].initial: no state named \"gone\"", "layers[0].transitions[0].from: no state named \"q\"", "view.colour: not a member of button", "view.on: no input named \"nope\"", "view.children[0].kind: no node kind \"widget\""] "\n")
    faulty = MachineDocs::faulty "boom"
    expect (faulty.machineFault, "boom")
    expect (Views::texts (seen faulty), "This interface could not load")))

// The same fixture as a resident application: its machine is the store, its
// ordinary template is the root region and every host event comes from Drive.
effect Bench
    drive : uitest::Driven<ui::Machine> => Unit

mut driven = Drive::idle (Runtime::idle (MachineDocs::faulty ""))

kept (resident : ui::Resident<ui::Machine>) = perform Bench.drive (Drive::moved (driven, resident))
fixture () = match MachineDocs::load (readFile "src/osprey/packages/uitest/tests/fixture.machine.json" ?: "")
    Success machine => machine
    Error problem => MachineDocs::faulty problem

initial context =
    skin = listGet context.arguments 1 ?: "tiny"
    caption = ui::Pick::either (skin == "plain", "Native", "Hello")
    Runtime::step (Machines::feed (fixture (), [Machines::fact ("skin", Values::text skin), Machines::fact ("caption", Values::text caption)]))

pulled (machine, lever, value) = Runtime::step (Machines::pull (machine, lever, value))
pointed (machine, input) = Inputs::route (input, \(_, _) => Runtime::step machine, \(x, y, down, _) => Runtime::step (Canvases::pointer (machine, x, y, down)), \(width, height) => Runtime::step (Canvases::viewed (machine, width, height)))
update (_, machine, message) = Messages::route (message, \lever => pulled (machine, lever, Values::none ()), \(lever, text) => pulled (machine, lever, Values::text text), \(lever, on) => pulled (machine, lever, Values::flag on), \(_, _) => Runtime::step machine, \(_, _) => Runtime::step machine, \_ => Runtime::step machine, \(_, _) => Runtime::step machine, \(_, _) => Runtime::step machine, \_ => Runtime::step machine, \(_, input) => pointed (machine, input))
machineSlice () = perform Signal<ui::Machine>.read ()
root () = Templates::view (machineSlice ())
regions (before, after, frames, _) =
    handle static Signal<ui::Machine>
        read => after
    changed = signalChanges before after MachineDocs::snapshot (signalDependencies machineSlice)
    [Keyed::region (frames, "root", changed, root)]

hosted work =
    handle ui::Slices
        fetch _ => ""
    handle ui::SceneStream
        shape _ => 0
    work ()

bench work =
    handle Bench
        drive d => driven := d
    Runtime::guarded work

begun skin =
    perform Bench.drive (Drive::idle driven.drivenSession)
    hosted (\() => kept (Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\",\"arguments\":[\"--skin\",\"${skin}\"]}", initial, regions, Templates::theme (fixture ()))))

post event = hosted (\() => kept (Runtime::proceed (driven.drivenSession, event, update, regions)))

// Host events, each as the driver carries it.
press label = post (Drive::press (driven, label))
choose (label, key) = post (Drive::choose (driven, label, key))
pointer (x, y, down) = post (Drive::pointer (driven, x, y, down))
viewed (width, height) = post (Drive::viewed (driven, width, height))
elements () = driven.drivenSeen.renderedAccess
elementAt label = Semantics::element (elements (), label)
tapAt (label, fraction) =
    p = Semantics::point (elementAt label, fraction)
    clickAt (p.pointX, p.pointY)

clickAt (x, y) =
    pointer (x, y, true)
    pointer (x, y, false)

tap label = tapAt (label, 0.5)
level () = Semantics::value (elements (), "Level")

// Runs of readings that only their label distinguishes: `read` answers for one label.
reading (labels, read, want) = forEachList (labels, \label => expect (read label, want))
lettered (texts, want) = reading (texts, \text => Drive::letters (driven, text), want)

// Which of `names` the driver offers, and which it shows.
offering (names, want) = reading (names, \label => Drive::offers (elements (), label), want)
showing (names, want) = reading (names, \label => Drive::shows (driven, label), want)

// Lettering that has arrived, and lettering that has gone; and the chosen item's on show.
inLetters (shown, hidden) = letteredOver (\text => Drive::letters (driven, text), shown, hidden)
choiceShown () = lettered (["Choice two"], true)

// A menu item that has been chosen: no longer offered, its lettering on show.
retiredItem (label) =
    offering ([label], false)
    choiceShown ()

// Dragging the slider to `fraction` of its width leaves it reading `want`.
levelAt (fraction, want) =
    tapAt ("Level", fraction)
    expect (level (), want)

selected () = (Views::control (driven.drivenSeen, "Pick")).controlSelected

// Choosing `key` from the picker leaves it selected and on show.
pickedKey (key) =
    choose ("Pick", key)
    expect (selected (), key)
    showing ([key], true)

// A control that is on show and one that has gone.
shownNow (shown, gone) = letteredOver (\text => Drive::shows (driven, text), [shown], [gone])

// A freshly begun session reads its first frame on the second tick.
restarted skin =
    begun skin
    expect (driven.drivenNow, 2)

// A completion the host finishes with a chosen path.
completed path = post (Drive::chosen (driven, "choose", path))

test ("a resident fixture is driven by labels, pointers, completions, lifecycle and frames while its curves and diagnostics are read", \() => bench (\() =>
    restarted "tiny"
    expect (driven.drivenSeen.renderedRevision, 1)
    expect (length driven.drivenSeen.renderedCurves, 1)
    curve = listGet driven.drivenSeen.renderedCurves 0 ?: []
    forEachList ([{ at = 0, want = 10.0 }, { at = 1, want = 20.0 }, { at = 2, want = 110.0 }, { at = 3, want = 80.0 }], \reading => expect (listGet curve reading.at ?: 0.0, reading.want))
    inLetters (["Hello", "Choice "], ["Missing lettering"])
    forEachList ([{ names = ["Menu", "Level"], want = true }, { names = ["Dismiss"], want = false }], \row => offering (row.names, row.want))
    tap "Press"
    inLetters (["Pressed"], ["Hello"])
    forEachList ([{ fraction = 0.0, want = 0.0 }, { fraction = 0.5, want = 0.5 }, { fraction = 1.0, want = 1.0 }, { fraction = 0.75, want = 0.75 }], \row => levelAt (row.fraction, row.want))
    tap "Menu"
    offering (["One", "Two", "Three"], true)
    lettered (["One", "Two", "Three"], true)
    tap "Two"
    retiredItem "One"
    expect (level (), 0.75)
    tap "Menu"
    clickAt (5.0, 5.0)
    retiredItem "Three"
    forEachList ([{ width = 400.0, height = 400.0 }, { width = 800.0, height = 600.0 }], \size => viewed (size.width, size.height))
    choiceShown ()
    post (Drive::frame (driven, 0.25))
    expect (driven.drivenSession.sessionStore.machineFault, "")
    completed "/music/a \"b\".mp3"
    choiceShown ()
    completed "/music/second.mp3"
    post (Drive::ran (driven, "discover", 0, ""))
    post (Drive::ran (driven, "discover", 2, "no route"))
    expect (level (), 0.75)
    post (Drive::opened (driven, "/music/opened.mp3"))
    choiceShown ()
    expect (driven.drivenNow > 20, true)
    expect (driven.drivenSession.sessionContext.platform, "macos")))

test ("native controls are pressed and repeatedly chosen through Drive, including successful and explained failed lookups", \() => bench (\() =>
    restarted "plain"
    forEachList ([{ names = ["Native", "Native action", "Pick"], want = true }, { names = ["Missing control"], want = false }], \row => showing (row.names, row.want))
    expect (selected (), "")
    press "Native action"
    shownNow ("Pressed", "Native")
    pickedKey "one"
    pickedKey "three"
    showing (["one"], false)
    pickedKey "two"
    showing (["two", "Pressed"], true)
    post (Drive::frame (driven, 0.5))
    post (Drive::opened (driven, "/tmp/native.mp3"))
    completed "/tmp/chosen.mp3"
    post (Drive::ran (driven, "run", 1, "failed"))
    expect (selected (), "two")
    showing (["Pressed"], true)
    restarted "plain"
    expect (selected (), "")
    shownNow ("Native", "Pressed")))

spotted (role, label, x) = ui::Accessible(accessRole = role, accessLabel = label, accessLeft = x, accessTop = 10.0, accessWidth = 100.0, accessHeight = 20.0, accessValue = 0.5, accessMin = 0.0, accessMax = 1.0, accessSelected = false, accessMovable = false)

// Where an activation a quarter across each named control lands, horizontally.
landed (nodes, spots) = forEachList (spots, \spot => expect ((Semantics::spot (nodes, spot.named, 0.25)).pointX, spot.lands))

test ("the accessibility tree reads clearly to an agent: roles, values and ranges, where an activation lands, and what makes it unclear", \() =>
    play = spotted (ui::Pressable, "Play", 0.0)
    volume = spotted (ui::Slidable, "Volume", 100.0)
    menu = spotted (ui::Popup, "Speed: 1x", 200.0)
    item = spotted (ui::MenuItem, "Kitchen", 300.0)
    node = play(accessLabel = "Select Filter", accessMovable = true)
    picked = item(accessSelected = true)
    clear = [play, volume, menu, item, node]
    forEachList ([{ node = play, words = "button \"Play\"" }, { node = volume, words = "slider \"Volume\" value 0.5 of 0.0 to 1.0" }, { node = menu, words = "popup \"Speed: 1x\"" }, { node = item, words = "menuitem \"Kitchen\"" }, { node = picked, words = "menuitem \"Kitchen\" selected" }, { node = node, words = "button \"Select Filter\" movable" }], \one => expect (Semantics::announced one.node, one.words))
    forEachList ([{ nodes = [play, item, picked], named = "Kitchen", found = true }, { nodes = clear, named = "Kitchen", found = false }, { nodes = [play], named = "Missing", found = false }], \one => expect (Semantics::selected (one.nodes, one.named), one.found))
    expect (Semantics::outline [play, picked], "button \"Play\"\nmenuitem \"Kitchen\" selected")
    forEachList ([{ nodes = clear, said = "" }, { nodes = [play, play], said = "twice: \"Play\"|twice: \"Play\"" }, { nodes = [spotted (ui::Pressable, "", 0.0)], said = "unnamed: \"\"" }, { nodes = [spotted (ui::Popup, "Receiver: ", 0.0)], said = "unnamed: \"Receiver: \"" }], \one => expect (Semantics::unclear one.nodes, one.said))
    landed (clear, [{ named = "Volume", lands = 125.0 }, { named = "Play", lands = 50.0 }, { named = "Nope", lands = 0.0 }])
    expect ((Semantics::spot (clear, "Volume", 0.25)).pointY, 20.0))
