    "",
    "   ",
    "Hello world!",
    "hello,world",
    "don't",
    "The quick brown fox jumps over the lazy dog.",
    "How are you doing?",
    "Caf\u00e9 au lait",
    "\u00c5ngstr\u00f6m",
