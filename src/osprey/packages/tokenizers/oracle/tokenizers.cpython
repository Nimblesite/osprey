def build_wordlevel():
    tok = Tokenizer(models.WordLevel(vocab={t: i for i, t in enumerate(WL_VOCAB)}, unk_token="<unk>"))
    tok.pre_tokenizer = pre_tokenizers.Whitespace()
    return tok


