namespace vscode_tests
import ui::Runtime
import vscode::Editor
import ui::Requests

// Every request the Editor builds, read as the typed `HostCall` it carries:
// no envelope is written or parsed anywhere.

asked result = match result
    Success request => Success(value = request.capability)
    Error problem => Error(message = problem)

refused result = match result
    Error _ => true
    Success _ => false

// Every request in `requests` must be refused, each with its own assertion.
allRefused requests = forEachList (requests, \request => expect (refused request, true))

kindOf capability = Runtime::guarded (\() => Requests::kind capability)

valueIn (name, header) = match header.headerName == name
    true => header.headerValue
    false => ""

argumentsOf (capability, name) = match capability
    ui::HostCall _ _ arguments _ _ _ => join (filterList (mapList (arguments, \header => valueIn (name, header)), \value => value != "")) ","
    _ => ""

fieldOf capability = match capability
    ui::HostCall space operation _ _ _ _ => space + "|" + operation
    _ => "|"

boundOf (capability, timeout) = match capability
    ui::HostCall _ _ _ hostTimeout hostLimit _ => match timeout
        true => hostTimeout
        false => hostLimit
    _ => 0

kind result = match asked result
    Success capability => kindOf capability
    Error _ => ""

ticketOf result = match result
    Success request => request.ticket
    Error _ => ""

field result = match asked result
    Success capability => fieldOf capability
    Error _ => "|"

argumentText (result, name) = match asked result
    Success capability => argumentsOf (capability, name)
    Error _ => ""

bound (result, timeout) = match asked result
    Success capability => boundOf (capability, timeout)
    Error _ => 0

test ("editor workspace requests use the shared typed capability", \() =>
    result = Editor::workspaces "workspace:1"
    expect (kind result, "host-call")
    expect (field result, "vscode|workspace.snapshot")
    expect (argumentText (result, "uri"), "")
    expect (ticketOf result, "workspace:1"))

test ("opening a document preserves its URI and source location", \() =>
    result = Editor::openDocument ("open:1", "file:///work/my%20app/main.osp", 12, 4)
    expect (field result, "vscode|document.open")
    expect (argumentText (result, "uri"), "file:///work/my%20app/main.osp")
    expect (argumentText (result, "line"), "12")
    expect (argumentText (result, "column"), "4")
    allRefused [Editor::openDocument ("bad", "command:workbench.action.closeWindow", 1, 1), Editor::openDocument ("bad", "file:///work/main.osp", 0, 1)])

test ("process input is data with explicit workspace, timeout and output bounds", \() =>
    result = Editor::processInput ("run:1", "osprey-pkg", ["tree", "--direct"], "--json tree --direct\n", "file:///work/my%20app", 30000, 1048576, "client/report")
    expect (field result, "vscode|process.input")
    expect (argumentText (result, "stdin"), "--json tree --direct\n")
    expect (argumentText (result, "workspace"), "file:///work/my%20app")
    expect (argumentText (result, "argv"), "tree,--direct")
    expect (bound (result, false), 1048576)
    expect (bound (result, true), 30000)
    allRefused [Editor::processInput ("bad", "tool", [], "", "file:///work", 0, 10, "out"), Editor::processInput ("bad", "tool", [], "", "file:///work", 1, 0, "out")])

test ("configuration and view requests preserve resource scope", \() =>
    result = Editor::configuration ("config:1", "osprey.packages", "vscode-remote://ssh-remote+dev/work/app")
    expect (field result, "vscode|configuration.read")
    expect (argumentText (result, "section"), "osprey.packages")
    expect (argumentText (result, "workspace"), "vscode-remote://ssh-remote+dev/work/app")
    expect (field (Editor::revealView ("view:1", "osprey.packages")), "vscode|webview.reveal")
    allRefused [Editor::configuration ("bad", "", "file:///work"), Editor::configuration ("bad", "section", "https://example.test"), Editor::revealView ("bad", "")])

test ("invalid tickets process scope and excessive limits fail explicitly", \() =>
    allRefused [Editor::workspaces "", Editor::processInput ("bad", "", [], "", "file:///work", 1, 10, "out"), Editor::processInput ("bad", "tool", [], "", "https://example.test", 1, 10, "out"), Editor::processInput ("bad", "tool", [], "", "file:///work", 1, 10, ""), Editor::processInput ("bad", "tool", [], "", "file:///work", 120001, 10, "out"), Editor::processInput ("bad", "tool", [], "", "file:///work", 1, 16777217, "out")])
