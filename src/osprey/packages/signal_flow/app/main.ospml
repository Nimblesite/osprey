namespace app

import ui::Runtime
import ui::Views
import signalflow::App

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<signalflow::Store, ui::Lever> => Unit

initial () = signalflow::Flow::store (ui::MachineDocs::faulty "")
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
