// The signal-flow editor's application callbacks ([UI-MACHINE], [UI-STORE]):
// this module loads the document and routes framework messages to the adapter.
namespace signalflow

import ui::Runtime
import ui::Messages
import ui::MachineDocs
import ui::Values
import ui::Templates
import ui::Keyed

(** The application exported through the two-function C boundary. *)
module App

    (** The document the interface is read from: `--machine <path>` among the launch arguments, else the repository copy. *)
    export documentPath arguments = ui::Lists::after (arguments, "--machine", "src/osprey/packages/signal_flow/signal_flow.machine.json")

    (** The store from a machine document's text: a refused document shows its problems in place of the editor. *)
    export loaded source = match MachineDocs::load source
        Success machine => Flow::store machine
        Error problem => Flow::store (MachineDocs::faulty problem)

    (** The store from the document at `path`: a read that fails shows the path and its reason in place of the editor. *)
    export read path = match readFile path
        Success source => loaded source
        Error reason => Flow::store (MachineDocs::faulty "the machine document could not be read: ${reason}")

    (** Loads the document in `skin` unless `--skin` names another, and answers the initial states' requests; an application built on the editor picks its own skin. A document that did not load is shown as it is: launching it would bury its fault under one about the launch inputs. *)
    export opened (context, skin) =
        path = documentPath context.arguments
        store = read path
        match (store.screen.screenMachine).machineFault == ""
            true => Flow::settled (Flow::launched (store, MachineDocs::folder path, ui::Lists::after (context.arguments, "--skin", skin)))
            false => Flow::settled store

    (** Loads the document, applies `--skin` and answers the initial states' requests. *)
    export initial context = opened (context, "")

    (** Routes every framework message: controls pull the machine's levers and canvas releases hit its listeners. *)
    export update (_, store, message) = Messages::route (message, \lever => Flow::pulled (store, lever, Values::none ()), \(lever, text) => Flow::pulled (store, lever, Values::text text), \(lever, on) => Flow::pulled (store, lever, Values::flag on), \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, input) => Flow::pointed (store, input))

    screenSlice () = perform Signal<Screen>.read ()

    (** The whole editor: the machine's view in its chosen skin. *)
    export root () = Templates::view (screenSlice ()).screenMachine

    (** Rebuilds the editor whenever the machine changes. *)
    export regions (before, store, frames, _) =
        handle static Signal<Screen>
            read => store.screen
        changed = signalChanges before.screen store.screen (\s => MachineDocs::snapshot s.screenMachine) (signalDependencies screenSlice)
        [Keyed::region (frames, "root", changed, root)]

    (** The repository document's colours in `skin`, or its default skin when empty: the window paints its background around the view. *)
    export theme skin =
        store = Flow::launched (read (documentPath []), "", skin)
        Templates::theme store.screen.screenMachine

    (** The editor as its boundary runs it: the store drawn with its machine's live skin's theme. *)
    export program () = ui::Program(programInit = initial, programUpdate = update, programRender = regions, programTheme = \store => Templates::theme store.screen.screenMachine)
