// Signal-flow end to end ([UI-MACHINE], [UI-MACHINE-TEST], [UI-MACHINE-CANVAS]):
// the real document and adapter, driven entirely by pointer events aimed through
// each canvas control's accessible label, with its inputs, states and lettering read back.

import ui::Runtime
import ui::Surfaces
import ui::Lists
import ui::Canvases
import ui::MachineDocs
import ui::Machines
import uitest::Drive
import uitest::Semantics
import signalflow::App

(** The bench's only write: the driven surface. *)
effect Bench
    drive : uitest::Driven<signalflow::Store, ui::Lever> => Unit

mut driven = Drive::idle (App::program (), signalflow::Flow::store (MachineDocs::faulty ""))

kept next = perform Bench.drive next

// One sprite the last frame drew, as atlas index, x and y; any other shape draws none.
placed primitive = match primitive
    ui::Sprite index x y _ _ _ _ _ => [[toFloat index, x, y]]
    _ => []

// Every sprite the last frame drew: the host's view of where each node is.
sprites () =
    walk = Surfaces::seen (driven.drivenSurface, driven.drivenProgram)
    shapes = Lists::flatten (mapList (walk.walkSketches, \s => s.sketchedAs.sketchShapes))
    Lists::flatten (mapList (shapes, placed))

hosted work =
    handle ui::Slices
        fetch _ => ""
    work ()

bench work =
    handle Bench
        drive d => driven := d
    Runtime::guarded work

begun skin =
    perform Bench.drive (Drive::idle (App::program (), signalflow::Flow::store (MachineDocs::faulty "")))
    hosted (\() => kept (Drive::launched (driven, "macos", ["--skin", skin])))

// One typed host event, sent the way a host sends it.
post step = hosted (\() => kept (step driven))

pointer (x, y, down) = post (\d => Drive::pointer (d, x, y, down))

// A click at `fraction` across the element labelled `label`, as a pointer or a screen reader would.
tapAt (label, fraction) =
    at = Semantics::point (element label, fraction)
    pointer (at.pointX, at.pointY, true)
    pointer (at.pointX, at.pointY, false)

tap label = tapAt (label, 0.5)

machine () = driven.drivenSurface.surfaceSession.sessionStore.screen.screenMachine

elements () = Canvases::semantics (machine ())

labels () = Semantics::labels (elements ())

element label = Semantics::element (elements (), label)

offers label = Drive::offers (elements (), label)

letters text = Drive::letters (driven, text)

offered label = expect (offers label, true)

missing label = expect (Semantics::offered (elements (), label), false)

// Input `name` must read `expected`, read by `reader` from the machine.
knob (reader, name, expected) = expect (reader (machine (), name), expected)

flag (name, expected) = knob (Machines::flag, name, expected)

knobText (name, expected) = knob (Machines::text, name, expected)

knobNumber (name, expected) =
    actual = Machines::number (machine (), name)
    expect (actual - expected < 0.000001 && expected - actual < 0.000001, true)

layer (name, expected) = knob (Machines::current, name, expected)

// A pointer press and release at (x, y), which closes the menu.
pressed (x, y) =
    pointer (x, y, true)
    pointer (x, y, false)
    layer ("menu", "closed")

// A press on `label`, then the read it must leave behind, read by `check`.
tapped (check, label, name, expected) =
    tap label
    check (name, expected)

// A press opening a chooser, without choosing.
opened (label, menu) = tapped (layer, label, "menu", menu)

// The skins menu opened from `from`, choosing `choice`, which the `skin` knob must record.
skinChosen (from, choice, skin) =
    tap "Skin: ${from}"
    tap choice
    knobText ("skin", skin)
    layer ("menu", "closed")

// Runs of reads that only their literals distinguish are tables: each case names the
// control and the value it must read.
reads (reader, cases) = forEachList (cases, \c => reader (c.at, c.want))

lettered (texts) = forEachList (texts, \text => expect (letters text, true))

offereds (labels) = forEachList (labels, offered)

// A run of checks, in the order given.
eachOf (steps) = forEachList (steps, \step => step ())

// The folder the machine file's document sits in, for each document path.
folders (cases) = forEachList (cases, \c => expect (MachineDocs::folder c.path, c.want))

// A node's bypass press, with the bypass its switch must then record.
bypassing (label, role) =
    tap label
    bypassed role

// A node's enable press: its switch on, and the health its report must show.
enabled (label, onRole, healthRole) =
    tap label
    flag ("${onRole}On", true)
    knobText ("${healthRole}Health", "Healthy")

// The knobs a move must leave, then the lettering it must show.
numbersAndLetters (cases, texts) =
    reads (knobNumber, cases)
    lettered texts

// The knobs a move leaves behind, with the lettering it must show.
knobsShow (cases, text) = numbersAndLetters (cases, [text])

// A slider pressed at `fraction` across `label`, the knobs it must move and the lettering it must show.
slid (label, fraction, cases, texts) =
    tapAt (label, fraction)
    numbersAndLetters (cases, texts)

// A press on a control that selects, and the selection it must leave behind.
selected (label, role) = tapped (knobText, label, "selected", role)

// A selection across the tree, the lettering its inspector shows and the controls it offers.
inspected (label, role, texts, offers) =
    selected (label, role)
    lettered texts
    offereds offers

// The nodes a run of selections leaves selected.
selects (cases) = forEachList (cases, \c => selected (c.label, c.role))

// A history button pressed, then the reads its press must leave behind.
reverted (button, reader, cases) =
    tap button
    reads (reader, cases)

// A node selected by label, whose inspector shows no parameters.
bare name =
    tap "Select ${name}"
    expect (letters "No parameters", true)

// A node's switch after the pointer pressed it, with the health it reports: off is bypassed, on healthy.
health (on, report, role) =
    flag ("${role}On", on)
    knobText ("${role}Health", report)

bypassed role = health (false, "Bypassed", role)

healthy role = health (true, "Healthy", role)

// A switch flipped off and back on, in the two presses its labels name.
switched (offLabel, onLabel, role) =
    tap offLabel
    flag ("${role}On", false)
    tap onLabel
    flag ("${role}On", true)

history (undo, redo) =
    flag ("canUndo", undo)
    flag ("canRedo", redo)

// A slider's edit kept across skin switches: its knobs, its selection and its undo.
editedSession () =
    reads (knobNumber, [{ at = "control", want = 0.6 }, { at = "process", want = 0.7 }])
    knobText ("selected", "source")
    flag ("canUndo", true)

topologyInitial () =
    expect (labels (), "Skin: Topology|Bypass Policy|Bypass Client|Bypass Gateway|Bypass Service|Bypass Telemetry|Policy Threshold|Gateway Rate limit|Inspector: Bypass Gateway|Inspector: Rate limit|Select Policy|Select Client|Select Gateway|Select Service|Select Telemetry")
    lettered (["70%", "490 r/s", "Healthy", "Gateway", "Connections (4)"])
    skinned ("topology", [{ at = "control", want = 0.7 }, { at = "process", want = 0.7 }, { at = "level", want = 0.49 }])
    folders ([{ path = "C:\\Program Files\\Osprey\\app\\signal_flow.machine.json", want = "C:/Program Files/Osprey/app" }, { path = "/opt/osprey/signal_flow.machine.json", want = "/opt/osprey" }, { path = "signal_flow.machine.json", want = "" }])

topologyBypass () =
    tap "Bypass Gateway"
    bypassed "process"
    knobsShow ([{ at = "process", want = 0.7 }, { at = "level", want = 1.0 }], "1000 r/s")
    offered "Undo"
    tapAt ("Gateway Rate limit", 0.25)
    knobNumber ("process", 0.25)
    bypassed "process"
    knobsShow ([{ at = "level", want = 1.0 }], "25%")
    expect (Semantics::value (elements (), "Gateway Rate limit"), 0.25)

topologyHistory () =
    undone = \() => reverted ("Undo", knobNumber, [{ at = "process", want = 0.7 }])
    undone ()
    flag ("processOn", false)
    expect (letters "70%", true)
    undone ()
    healthy "process"
    knobNumber ("level", 0.49)
    history (false, true)
    reverted ("Redo", flag, [{ at = "processOn", want = false }])
    reads (knobNumber, [{ at = "process", want = 0.7 }, { at = "level", want = 1.0 }])
    offered "Enable Gateway"
    tap "Enable Gateway"
    flag ("processOn", true)
    knobNumber ("level", 0.49)

topologySelection () =
    inspected ("Select Client", "source", ["Client", "Connections (1)", "No parameters"], ["Inspector: Bypass Client"])
    missing "Inspector: Rate limit"
    inspected ("Select Telemetry", "monitor", ["Telemetry", "Connections (1)", "No parameters"], ["Inspector: Bypass Telemetry"])
    inspected ("Select Policy", "control", ["Policy", "Connections (1)"], ["Inspector: Threshold", "Inspector: Bypass Policy"])

topologySignal () =
    slid ("Inspector: Threshold", 0.5, [{ at = "control", want = 0.5 }, { at = "level", want = 0.35 }], ["350 r/s"])
    bypassing ("Bypass Client", "source")
    reads (knobText, [{ at = "processHealth", want = "Offline" }, { at = "outputHealth", want = "Offline" }, { at = "monitorHealth", want = "Offline" }])
    knobsShow ([{ at = "level", want = 0.0 }], "0 r/s")
    enabled ("Enable Client", "source", "process")
    tapAt ("Gateway Rate limit", 0.2)
    reads (knobNumber, [{ at = "process", want = 0.2 }, { at = "level", want = 0.1 }])
    knobText ("processHealth", "Degraded")
    expect (letters "100 r/s", true)

menuOpened () =
    begun "topology"
    tapAt ("Policy Threshold", 0.6)
    tap "Select Client"
    editedSession ()
    opened ("Skin: Topology", "skins")
    expect (take (labels ()) 29, "Topology|Notation|Paper|Prism")
    offereds (["Topology", "Notation", "Paper", "Prism"])

menuChoice () =
    pressed (1400.0, 700.0)
    missing "Topology"
    tap "Skin: Topology"
    tap "Prism"
    knobText ("skin", "prism")
    reads (layer, [{ at = "menu", want = "closed" }, { at = "commands", want = "idle" }])
    expect (take (labels ()) 11, "Skin: Prism")
    editedSession ()
    flag ("canRedo", false)
    lettered (["+60%", "2.5 kHz"])

menuCycle () =
    skinChosen ("Prism", "Notation", "notation")
    lettered (["0.60", "H(s)"])
    skinChosen ("Notation", "Paper", "paper")
    lettered (["0.60", "Transform.in"])
    editedSession ()

freshSkin skin =
    begun skin
    skinned (skin, [{ at = "control", want = 0.7 }, { at = "process", want = 0.7 }])

// The reads any freshly opened skin must leave: its skin and selection, its idle commands and
// menu, the knobs it leaves where they were and a history with nothing to undo or redo.
skinned (skin, knobs) =
    reads (knobText, [{ at = "skin", want = skin }, { at = "selected", want = "process" }])
    reads (knobNumber, knobs)
    reads (layer, [{ at = "commands", want = "idle" }, { at = "menu", want = "closed" }])
    history (false, false)

exercise (name, role) =
    tapAt ("Select ${name}", 0.1)
    knobText ("selected", role)
    offered "Inspector: Bypass ${name}"
    bypassing ("Bypass ${name}", role)
    offered "Enable ${name}"
    offered "Inspector: Enable ${name}"
    enabled ("Enable ${name}", role, role)
    offered "Inspector: Bypass ${name}"

// The roles a skin's nodes take, in the order its tree lists them.
nodeRoles = ["control", "source", "process", "output", "monitor"]

// Every node of a skin, named in tree order, exercised as the role at its place.
skinJourney (skin, names) =
    freshSkin skin
    forEachList (toList (range (0, length names)), \i => exercise (listGet names i ?: "", listGet nodeRoles i ?: ""))

// A skin opened on `process`, whose inspector offers its bypass switch.
inspectorSkin (skin, bypassOffer) =
    begun skin
    knobText ("selected", "process")
    offered bypassOffer

// The inspector's enable press restoring the node, then the cutoff slider it offers.
restored (enableLabel, sliderLabel) =
    tap enableLabel
    healthy "process"
    tapAt (sliderLabel, 0.5)

notationInspector () =
    inspectorSkin ("notation", "Inspector enabled: Bypass H(s)")
    offered "Inspector: Cutoff  ωc"
    bypassing ("Inspector enabled: Bypass H(s)", "process")
    offered "Inspector enabled: Enable H(s)"
    restored ("Inspector enabled: Enable H(s)", "Inspector: Cutoff  ωc")
    knobsShow ([{ at = "process", want = 0.5 }, { at = "level", want = 0.35 }], "0.50")

prismInspector () =
    inspectorSkin ("prism", "Inspector bypass: Bypass Filter")
    bypassing ("Inspector bypass: Bypass Filter", "process")
    offered "Inspector bypass: Enable Filter"
    missing "Inspector bypass: Bypass Filter"
    offered "Inspector: Enable Filter"
    restored ("Inspector bypass: Enable Filter", "Filter Cutoff")
    reads (knobNumber, [{ at = "process", want = 0.5 }, { at = "level", want = 0.35 }, { at = "delivered", want = 0.2625 }])
    lettered (["0.6 kHz", "+70%", "-6.0 dB", "-17.7"])
    tap "Bypass Master"
    knobText ("outputHealth", "Bypassed")
    knobsShow ([{ at = "delivered", want = 0.0 }], "-24.0")
    reverted ("Undo", flag, [{ at = "outputOn", want = true }])
    expect (letters "-17.7", true)
    offered "Redo"
    reverted ("Redo", flag, [{ at = "outputOn", want = false }])
    missing "Redo"

prismInitial () =
    begun "prism"
    expect (labels (), "Skin: Prism|LFO Rate: 1/4|Oscillator Wave: Sine|Bypass LFO|Bypass Oscillator|Bypass Filter|Bypass Master|Bypass Scope|Filter Cutoff|Master Level|Inspector: Bypass Filter|Inspector bypass: Bypass Filter|Inspector: Cutoff|Select LFO|Select Oscillator|Select Filter|Select Master|Select Scope")
    reads (knobText, [{ at = "rate", want = "1/4" }, { at = "wave", want = "Sine" }])
    reads (knobNumber, [{ at = "volume", want = 0.75 }, { at = "delivered", want = 0.3675 }])
    lettered (["1/4", "Sine", "-6.0 dB", "2.5 kHz", "-15.2"])
    layer ("menu", "closed")

// Opens the chooser `prefix` labels with the value `from`, checks its choices lead the tree, picks
// `to` and checks it took and was recorded.
chosen (prefix, menu, name, choices, from, to) =
    tap "${prefix}${from}"
    layer ("menu", menu)
    expect (take (labels ()) (length choices), choices)
    tap to
    layer ("menu", "closed")
    knobText (name, to)
    offered "${prefix}${to}"
    expect (letters to, true)
    flag ("canUndo", true)

// Each pick a chooser must take: the value it shows and the one it holds after.
picks (prefix, menu, name, choices, moves) =
    forEachList (moves, \m => chosen (prefix, menu, name, choices, m.from, m.to))

prismRates () =
    picks ("LFO Rate: ", "rates", "rate", "1/1|1/2|1/4|1/8|1/16", [{ from = "1/4", to = "1/16" }, { from = "1/16", to = "1/1" }, { from = "1/1", to = "1/8" }])
    reverted ("Undo", knobText, [{ at = "rate", want = "1/1" }])
    offered "LFO Rate: 1/1"
    reverted ("Redo", knobText, [{ at = "rate", want = "1/8" }])
    opened ("LFO Rate: 1/8", "rates")
    pressed (900.0, 700.0)
    knobText ("rate", "1/8")
    missing "1/16"

prismWaves () =
    picks ("Oscillator Wave: ", "waves", "wave", "Sine|Triangle|Saw|Square", [{ from = "Sine", to = "Triangle" }, { from = "Triangle", to = "Saw" }, { from = "Saw", to = "Square" }])
    opened ("Oscillator Wave: Square", "waves")
    opened ("LFO Rate: 1/8", "rates")
    offered "1/2"
    missing "Triangle"
    opened ("LFO Rate: 1/8", "closed")
    knobText ("wave", "Square")
    reverted ("Undo", knobText, [{ at = "wave", want = "Saw" }])
    expect (letters "Saw", true)

prismLevels () =
    slid ("Master Level", 1.0, [{ at = "volume", want = 1.0 }, { at = "delivered", want = 0.49 }], ["0.0 dB", "-12.2"])
    slid ("Master Level", 0.0, [{ at = "volume", want = 0.0 }, { at = "delivered", want = 0.0 }], ["-24.0 dB"])
    selected ("Select Master", "output")
    offered "Inspector: Level"
    missing "Inspector: Cutoff"
    expect (letters "Level", true)
    slid ("Inspector: Level", 0.5, [{ at = "volume", want = 0.5 }, { at = "delivered", want = 0.245 }], ["-12.0 dB"])
    reverted ("Undo", knobNumber, [{ at = "volume", want = 0.0 }])
    reverted ("Redo", knobNumber, [{ at = "volume", want = 0.5 }])

prismParameters () =
    selected ("Select LFO", "control")
    offered "Inspector: Depth"
    slid ("Inspector: Depth", 0.3, [{ at = "control", want = 0.3 }, { at = "level", want = 0.21 }], ["+30%"])
    tap "Select Filter"
    tapAt ("Inspector: Cutoff", 1.0)
    knobsShow ([{ at = "process", want = 1.0 }], "20.0 kHz")
    tapAt ("Filter Cutoff", 0.0)
    reads (knobNumber, [{ at = "process", want = 0.0 }])
    knobText ("processHealth", "Degraded")
    forEachList (["Oscillator", "Scope"], bare)
    missing "Inspector: Level"

// The suite: each case names itself and, in order, the checks it drives.
suites () = [
    { name = "topology: pointer editing, history, inspectors and signal health", steps = [\() => begun "topology", topologyInitial, topologyBypass, topologyHistory, topologySelection, topologySignal] },
    { name = "the skin menu dismisses, switches skins and preserves the session", steps = [menuOpened, menuChoice, menuCycle] },
    { name = "every skin: every node selects, bypasses, enables and tracks its inspector", steps = [\() => skinJourney ("topology", ["Policy", "Client", "Gateway", "Service", "Telemetry"]), \() => skinJourney ("notation", ["k", "x(t)", "H(s)", "y(t)", "Scope"]), \() => skinJourney ("paper", ["Parameter", "Source", "Transform", "Output", "Monitor"]), \() => skinJourney ("prism", ["LFO", "Oscillator", "Filter", "Master", "Scope"])] },
    { name = "notation and prism inspector switches and parameter lettering", steps = [notationInspector, prismInspector] },
    { name = "prism: every chooser, slider, switch and the history drive the patch", steps = [prismInitial, prismRates, prismWaves, prismLevels, prismParameters] },
    { name = "prism: nodes drag with their cables, controls and sprites; clicks, hovers and slider drags act once", steps = [\() => begun "prism", hovering, filterDrag, movedControls, scopeDrag, sliderDrag] },
    { name = "prism: a larger window moves the inspector, undo and legend to its edges at their size and leaves more grid; a smaller one spares none", steps = [grown, grownControls, shrunk] }
]

runSuites () = forEachList (suites (), \s => test (s.name, \() => bench (\() => eachOf (s.steps))))

runSuites ()

clearly skin =
    begun skin
    expect (Semantics::unclear (elements ()), "")
    expect (length (elements ()) > 5, true)

test ("every skin's accessibility tree reads clearly to an agent, and a Prism node says a drag moves it", \() => bench (\() =>
    forEachList (["topology", "notation", "paper", "prism"], clearly)
    begun "topology"
    expect (startsWith (Semantics::outline (elements ())) "popup \"Skin: Topology\"\n", true)
    begun "prism"
    expect (contains (Semantics::outline (elements ())) "button \"Select Filter\" movable", true)))

// The repository document as a store, not yet settled.
document () = App::loaded (readFile "src/osprey/packages/signal_flow/signal_flow.machine.json" ?: "")

// The store after one lever, each history's length read back.
histories (store, lever) =
    after = (signalflow::Flow::pulled (store, ui::Fire(fireName = lever), ui::Values::none ())).stepStore
    "${length after.past}/${length after.future}"

test ("undo and redo at the edges of their history, a refused document shown in place, and the repository theme", \() => Runtime::guarded (\() =>
    fresh = document ()
    expect ((fresh.screen.screenMachine).machineFault, "")
    // Nothing recorded yet: undo and redo restore nothing, and the lever's own change is the first snapshot.
    expect (length fresh.past, 0)
    forEachList (["undo", "redo"], \lever => expect (histories (fresh, lever), "1/0"))
    settled = (signalflow::Flow::settled fresh).stepStore
    forEachList (["undo", "redo"], \lever => expect (histories (settled, lever), "${length settled.past}/0"))
    refused = App::loaded "not json"
    expect ((refused.screen.screenMachine).machineFault, "the machine document is not JSON")
    expect (length refused.past, 0)
    forEachList (["", "topology", "paper"], \skin => expect (length (App::theme skin).tokens > 0, true))))
