import synth::Graphs
import synth::Parameters
import synth::Components
import synth::Renderer
import synth::Repatch

// [PRISM-ROUTING-VERIFY] Editing a live patch is transactional, including failed rewiring.
// [SYNTH-GRAPH-REPLACE] A block-boundary edit preserves surviving DSP and parameter state.
// [SYNTH-PCM-FLOAT] Independent IEEE754 words and RIFF sizes, not an encoder-derived oracle.
hostNode outcome = match outcome
    synth::Valid n => n
    synth::Invalid _ =>
        expect (false, true)
        node (-1, synth::Sink, [], [])

// [SYNTH-HOST-DESCRIPTOR] Real worker layouts become checked graph ports and normalized controls.
succeeds (outcome, check) = match outcome
    Success value => check value
    Error why => expect (synth::Faults::detail why, "successful operation")

reads (outcome, check) = match outcome
    Success value => check value
    Error why => expect ("no element ${why.index} of ${why.length}", "an element")

// [SYNTH-RENDER-BLOCKS] Kernel state must survive unequal streaming block boundaries.
partitionedKernel (component, channels) =
    routes = match length component.inputs > 0
        true => [cable (0, 1)]
        false => []
    generator = Components::sine (0, 440.0)
    graph = built ([generator(outputs = [synth::Port(name = "audio", rate = synth::Audio, channels = channels, unit = synth::Amplitude)]), component], routes)
    plan = planFor graph
    initial = mapList (toList (range (0, channels)), \_ => synth::RenderInputs::initialState component)
    samples = mapList (toList (range (0, 256 * channels)), \i => (toFloat (i % channels) + 1.0) * 0.25)
    source = audioClipFixture (0, channels, samples)
    match synth::ClipKernels::block (plan, [source], component, 256, initial)
        Error why => expect (synth::Faults::detail why, "whole kernel block")
        Success whole => match synth::ClipKernels::block (plan, [source], component, 31, initial)
            Error why => expect (synth::Faults::detail why, "first kernel block")
            Success first => succeeds (synth::ClipKernels::block (plan, [source], component, 225, first.heldKernel), \last =>
                sameSamples (whole.kernelSamples, listConcat first.kernelSamples last.kernelSamples)
                sameStructure (whole.heldKernel, last.heldKernel)
                expect (length last.heldKernel, channels))
    trial = { target = component, frames = 1, states = initial }
    cases = [
        trial(states = []), trial(states = [synth::RenderInputs::initialState (Components::sine (99, 440.0))]),
        trial(frames = 0), trial(states = listConcat initial initial),
        trial(target = component(outputs = [])), trial(target = component(processor = synth::Sink)) ]
    forEachList (cases, \row => renderRefused (synth::ClipKernels::block (plan, [source], row.target, row.frames, row.states)))

// [SYNTH-RENDER-BLOCKS] The complete graph advances one clock across block partitions.
partitionedGraph (graph, output) =
    match synth::GraphClips::start (graph, 31)
        Error why => expect (synth::Faults::detail why, "first graph block")
        Success first => match first
            synth::BlockWaiting _ _ => unexpected ()
            synth::BlockReady held clips =>
                expect (held.graphPosition, 31)
                match synth::GraphClips::next (graph, held, 225)
                    Error why => expect (synth::Faults::detail why, "continued graph block")
                    Success last => match last
                        synth::BlockWaiting _ _ => unexpected ()
                        synth::BlockReady finished buffers =>
                            expect (finished.graphPosition, 256)
                            match synth::ClipInputs::completed (clips, output)
                                Error why => expect (synth::Faults::detail why, "first output")
                                Success a => match synth::ClipInputs::completed (buffers, output)
                                    Error why => expect (synth::Faults::detail why, "last output")
                                    Success b => match synth::GraphClips::advance (graph, [], 256)
                                        Error why => expect (synth::Faults::detail why, "reference graph clip")
                                        Success reference => match reference
                                            synth::ClipWaiting _ _ _ => unexpected ()
                                            synth::ClipReady all => succeeds (synth::ClipInputs::completed (all, output), \whole => sameSamples (whole.clipSamples, listConcat a.clipSamples b.clipSamples))

// [SYNTH-HOST-GRAPH] A complete stereo/modulation chain shares the reusable kernels.
hostDescriptor () = synth::HostDescriptor(latency = 0, identifier = "instrument", name = "Fixture", inputChannels = 0, outputChannels = 2, notes = true, controls = [synth::HostControl(identity = 100, name = "Tone", initial = 0.25, automatable = true)])

// The LFO-to-host-parameter modulation every hosted-graph test wires in.
reconnected (graph) = accepted (synth::HostModulation::connect (graph, 3, 0, 2, "vst:100"))

hostClip (samples) = audioClipFixture (2, 2, samples)

nodeClipAt (identity, samples) = audioClipFixture (identity, 1, samples)

steady (count, level) = mapList (toList (range (0, count)), \_ => level)

pointValue (request, want) = reads (listGet request.parameters 0, \point => expect (point.value, want))

// A half-open MIDI window either owns its note or is rejected outright.
timelineAt (note, start, span, admitted) = match admitted
    true => succeeds (synth::MidiClips::timeline (note, start, span), \notes => expect (length notes, 0))
    false => renderRefused (synth::MidiClips::timeline (note, start, span))

requested (request, kind, offset, value) =
    expect (length request.notes, 1)
    reads (listGet request.notes 0, \note => expect (note.kind == kind && note.offset == offset, true))
    expect (length request.parameters, 1)
    reads (listGet request.parameters 0, \point => expect (point.offset == offset && value point.value, true))

hostGraph () = built ([Components::midiNote (1, 60.0, 0.8, 128.0), hostNode (synth::Hosted::component (2, hostDescriptor ())), Components::lfo (3, 2.0), Components::stereoOutput 4], [cable (1, 2), cable (2, 4)])

retainedDialEdits () =
    descriptor = hostDescriptor ()
    tone = synth::HostControl(identity = 100, name = "Tone", initial = 0.25, automatable = true)
    mix = tone(identity = 101, name = "Mix", initial = 0.5)
    original = hostNode (synth::Hosted::component (2, descriptor(controls = [tone, mix])))
    previous = synth::HostModulation::stamps (built ([original], []))
    updated = hostNode (synth::Hosted::component (2, descriptor(controls = [tone(initial = 0.75), mix])))
    graph = built ([updated], [])
    scheduled = mapList (toList (range (1, 1024)), \offset => synth::HostParameter(identity = 101, offset = offset, value = 0.25))
    edited = synth::HostParameter(identity = 100, offset = 0, value = 0.75)
    succeeds (synth::HostModulation::edits (graph, previous, updated, scheduled), \points => sameStructure (points, listPrepend scheduled edited))
    full = listAppend scheduled (synth::HostParameter(identity = 101, offset = 1024, value = 0.5))
    succeeds (synth::HostModulation::edits (graph, synth::HostModulation::stamps graph, updated, full), \points => sameStructure (points, full))
    match synth::HostModulation::edits (graph, previous, updated, full)
        Error why => expect (synth::Faults::detail why, "VST edits exceed the block automation budget.")
        Success _ => unexpected ()

stereoMarker frame = match frame
    0 => [0.75, -0.5]
    255 => [-0.5, 0.75]
    _ => [0.25, -0.25]

// [SYNTH-HOST-GRAPH] A real host resumes each suspended node separately.
twoPluginBlock frames =
    instrument = hostDescriptor ()
    reverb = instrument(identifier = "reverb", inputChannels = 2, notes = false, controls = mapList (instrument.controls, \p => p(initial = 0.75)))
    graph = built ([Components::midiNote (1, 72.0, 0.75, 1.0), hostNode (synth::Hosted::component (2, instrument)), hostNode (synth::Hosted::component (3, reverb)), Components::stereoOutput 4], [cable (1, 2), cable (2, 3), cable (3, 4)])
    dry = hostClip (foldList (toList (range (0, frames)), [], \(samples, frame) => listConcat samples (stereoMarker frame)))
    match synth::GraphClips::start (graph, frames)
        Error _ => unexpected ()
        Success action => match action
            synth::BlockReady _ _ => unexpected ()
            synth::BlockWaiting request pending =>
                expect (pending.pendingNode, 2)
                expect (request.frames, frames)
                pointValue (request, 0.25)
                expect (length request.parameters, 1)
                reads (listGet request.notes 0, \note => expect (note.pitch == 72 && note.kind == 1 && note.offset == 0, true))
                match frames > 1
                    true =>
                        expect (length request.notes, 2)
                        reads (listGet request.notes 1, \note => expect (note.kind == 2 && note.offset == 1, true))
                    false => expect (length request.notes, 1)
                renderRefused (synth::GraphClips::replied (pending, dry(clipNode = 3)))
                succeeds (synth::GraphClips::replied (pending, dry), \next => twoPluginEffect (next, dry, frames))

twoPluginEffect (action, dry, frames) = match action
    synth::BlockReady _ _ => unexpected ()
    synth::BlockWaiting request pending =>
        expect (pending.pendingNode, 3)
        expect (length request.notes, 0)
        expect (request.frames, frames)
        pointValue (request, 0.75)
        expect (length request.parameters, 1)
        sameSamples (request.samples, dry.clipSamples)
        wet = dry(clipNode = 3, clipSamples = mapList (dry.clipSamples, \value => value * -0.5))
        forEachList ([dry, wet(clipChannels = 1), wet(clipSamples = listAppend wet.clipSamples 0.0)], \bad => renderRefused (synth::GraphClips::replied (pending, bad)))
        match synth::GraphClips::replied (pending, wet)
            Error _ => unexpected ()
            Success next => match next
                synth::BlockWaiting _ _ => unexpected ()
                synth::BlockReady held clips =>
                    expect (held.graphPosition, frames)
                    succeeds (synth::ClipInputs::completed (clips, 4), \output => sameSamples (output.clipSamples, wet.clipSamples))

hostReply () = "4F5356310000000002000000010000000001000000000000" + join (mapList (toList (range (0, 256)), \_ => "0000803E000000BF")) ""

hostBlock (outcome, phase, inspect) = match outcome
    Error why => expect (synth::Faults::detail why, phase)
    Success step => inspect step

readyBlock (step, inspect) = match step
    synth::BlockWaiting _ _ => unexpected ()
    synth::BlockReady held clips => inspect (held, clips)

streamedHost graph =
    hostBlock (synth::GraphClips::start (graph, 64), "first hosted block", \first =>
        waitingBlock (first, \(request, pending) =>
            expect (pending.pendingNode, 2)
            requested (request, 1, 0, \level => level == 0.5)
            reply = hostClip (steady (128, 0.25))
            forEachList ([{ pend = pending, back = reply(clipNode = 99) }, { pend = pending, back = reply(clipSamples = []) }, { pend = pending(pendingNode = 4), back = reply(clipNode = 4) }, { pend = pending(pendingNode = 99), back = reply(clipNode = 99) }, { pend = pending(pendingClips = listAppend pending.pendingClips reply), back = reply }], \r => renderRefused (synth::GraphClips::replied (r.pend, r.back)))
            hostBlock (synth::GraphClips::replied (pending, reply), "completed first hosted block", \completed =>
                readyBlock (completed, \(held, _) =>
                    expect (held.graphPosition, 64)
                    forEachList ([{ held = held(graphKernels = []), frames = 192 }, { held = held(graphKernels = listConcat held.graphKernels held.graphKernels), frames = 192 }, { held = held(graphPosition = 9223372036854775807), frames = 1 }], \r => renderRefused (synth::GraphClips::next (graph, r.held, r.frames)))
                    streamedHostTail (graph, held)))))

streamedHostTail (graph, held) =
    hostBlock (synth::GraphClips::next (graph, held, 192), "continued hosted block", \action =>
        waitingBlock (action, \(request, pending) =>
            requested (request, 2, 64, \level => level > 0.5)
            reply = hostClip (steady (384, -0.25))
            hostBlock (synth::GraphClips::replied (pending, reply), "completed second hosted block", \completed =>
                readyBlock (completed, \(finished, clips) =>
                    expect (finished.graphPosition, 256)
                    succeeds (synth::ClipInputs::completed (clips, 4), \output => sameSamples (output.clipSamples, reply.clipSamples))))))

// [SYNTH-HOST-STREAM] Independent fixture words exercise suspension, transport and resumption.
// [SYNTH-HOST-MIDI] Whole-number controls and half-open windows own each note exactly once.
// [SYNTH-HOST-STREAM] Malformed native data must fail before it becomes playable audio.
// [SYNTH-GRAPH] Public prepared/state records are checked even outside the editor.

// [PRISM-ROUTING-VST] The worker returns the input five frames late. The parallel dry branch
// must reach the mixer on the same frame across unequal blocks and an initial short block.
latencyPartitions (graph, held, history, sizes) = match sizes
    [] => expect (held.graphPosition, 26)
    [size, ...rest] => hostBlock (synth::GraphClips::next (graph, held, size), "latency block", \action =>
        waitingBlock (action, \(request, pending) =>
                match held.graphPosition
                    0 => sameStructure (request.parameters, [synth::HostParameter(identity = 100, offset = 0, value = 0.25)])
                    2 => sameStructure (request.parameters, [synth::HostParameter(identity = 100, offset = 0, value = 0.125)])
                    _ => expect (length request.parameters, 0)
                joined = listConcat history request.samples
                expected = synth::Sequences::take (joined, size)
                wet = audioClipFixture (2, 1, expected)
                hostBlock (synth::GraphClips::replied (pending, wet), "latency reply", \reply =>
                    readyBlock (reply, \(next, clips) =>
                            sameSamples ((clipFrom (clips, 5)).clipSamples, expected)
                            sameSamples ((clipFrom (clips, 4)).clipSamples, expected)
                            edited = match held.graphPosition == 0
                                true => graph(nodes = mapList (graph.nodes, moveHostDial))
                                false => graph
                            latencyPartitions (edited, next, synth::Sequences::drop (joined, size), rest)))))

moveHostDial n = match n.identity == 2
    true => n(parameters = mapList (n.parameters, \p => p(initial = 0.125)))
    false => n

latencyJourney () =
    plain = hostDescriptor ()
    descriptor = plain(inputChannels = 1, outputChannels = 1, notes = false, latency = 5)
    valid (synth::Hosted::component (2, descriptor), \hosted =>
        graph = built ([Components::sine (1, 440.0), hosted, Components::mix (3, 1, 0.5, 0.5), Components::output 4], [cable (1, 2), cable (2, 3), Components::route (1, 0, 3, 1), cable (3, 4)])
        match synth::Hosted::compensated graph
            Error why => expect (why, "compensated graph")
            Success aligned =>
                expect (length aligned.nodes, 5)
                expect (length graph.nodes, 4)
                latencyPartitions (aligned, synth::GraphState(graphHosted = [], graphPosition = 0, graphKernels = []), steady (5, 0.0), [2, 3, 9, 12]))

(** [SYNTH-HOST-MODULATION] Inspect a running VST awaiting its next audio block. *)
waitingBlock (step, consume) = match step
    synth::BlockReady _ _ => unexpected ()
    synth::BlockWaiting request pending => consume (request, pending)

afterUnplug (graph, reply) = readyBlock (reply, \(held, _) =>
    succeeds (synth::GraphRebase::rebased (graph, held), \next =>
        expect (next.graphPosition, 3)
        succeeds (synth::GraphClips::next (graph, next, 1), \step => waitingBlock (step, \(request, _) =>
            sameStructure (request.parameters, [synth::HostParameter(identity = 100, offset = 0, value = 0.25)])))))

unpluggedDial () =
    plain = hostGraph ()
    succeeds (synth::GraphClips::start (reconnected plain, 3), \step => waitingBlock (step, \(request, pending) =>
        expect (length request.parameters, 1)
        succeeds (synth::GraphClips::replied (pending, hostClip (steady (6, 0.0))), \reply => afterUnplug (plain, reply))))

// Register the unchanged hosted graph journeys from the suite entry point.
registerHostedJourneys () =
    audio = monoPort ("audio", synth::Audio, synth::Amplitude)
    test ("edit routes and remove connected components without corrupting the previous playable graph", \() => arithmetic (\() =>
        source = node (1, synth::Oscillator, [], [audio])
        gain = node (2, synth::Amplifier, [audio], [audio])
        output = node (3, synth::Sink, [audio], [])
        nodes = added ([source, gain, output], Graphs::empty)
        chain = wired (chainRoute (), nodes)
        bypassed = bypass chain
        sameStructure (bypassed.cables, fanRoute ())
        sameStructure (chain.cables, chainRoute ())
        prepared (bypassed, 3)
        wrong = cable (1, 3)
        forEachList ([{ bad = cable (99, 3), why = synth::MissingNode }, { bad = cable (2, 2), why = synth::Cycle }, { bad = wrong(outlet = 8), why = synth::InvalidPort }], \r => refused (Graphs::rewire (chain, r.bad), r.why))
        disconnected = accepted (Graphs::disconnect (chain, cable (2, 3)))
        sameStructure (disconnected.cables, [cable (1, 2)])
        refused (Graphs::disconnect (disconnected, cable (2, 3)), synth::InvalidPort)
        removed = accepted (Graphs::remove (chain, 2))
        sameStructure (removed.nodes, [source, output])
        expect (length removed.cables, 0)
        refused (Graphs::remove (chain, 99), synth::MissingNode)
        restored = bypass removed
        prepared (restored, 2)
        expect (length chain.nodes == 3 && length chain.cables == 2, true)
        audible = sineChain ()
        direct = bypass audible
        quiet = blockOf (audible, 128)
        loud = blockOf (direct, 128)
        sameSamples (mapList (quiet.samples, \sample => sample * 4.0), loud.samples)
        expect ((listGet loud.samples 10 ?: 0.0) > (listGet quiet.samples 10 ?: 0.0), true)))
    test ("replace a playing graph without resetting phase, lose deleted state and refuse incomplete audio routes", \() => arithmetic (\() =>
        original = sineChain ()
        snapshot = Parameters::initial original
        first = blockOf (original, 31)
        bypassed = bypass original
        succeeds (Repatch::apply (original, bypassed, Renderer::observed (snapshot, first), first), \next =>
            expect (next.audio.position, 31)
            expect (next.observation.samplePosition, 31)
            expect (next.observation.revision == 1 && structuralEquals (next.audio.states, first.states), true)
            expect (length next.audio.samples, 0)
            continued = rendered (Renderer::block (planFor bypassed, 48000.0, next.observation, next.audio, 127))
            reference = rendered (Renderer::block (planFor original, 48000.0, snapshot, first, 127))
            sameSamples (continued.samples, mapList (reference.samples, \sample => sample * 4.0)))
        removed = accepted (Graphs::remove (bypassed, 2))
        succeeds (Repatch::apply (original, removed, Renderer::observed (snapshot, first), first), \next =>
            expect (length next.audio.states == 2 && length next.observation.parameters == 1, true))
        incomplete = accepted (Graphs::disconnect (original, cable (2, 3)))
        now = Renderer::observed (snapshot, first)
        forEachList ([{ target = incomplete, observation = now }, { target = bypassed, observation = snapshot }], \r => renderRefused (Repatch::apply (original, r.target, r.observation, first)))
        expect (first.position, 31)
        match Parameters::apply (original, now, synth::ParameterChange(node = 1, key = "frequency", value = 880.0, revision = 0, samplePosition = 31))
            synth::Invalid _ => unexpected ()
            synth::Valid tuned => succeeds (Repatch::apply (original, bypassed, tuned, first), \next =>
                expect (next.observation.revision == 2 && structuralEquals (next.observation.parameters, tuned.parameters), true))
        changed = serial ([Components::sine (1, 440.0), Components::delay (2, 2), Components::output 3])
        succeeds (Repatch::apply (original, changed, now, first), \next =>
            reads (listGet next.audio.states 1, \held => expect (length held.delay, 2))
            expect (length next.observation.parameters, 1))
        expanded = accepted (Graphs::add (original, Components::sine (4, 880.0)))
        succeeds (Repatch::apply (original, expanded, now, first), \next => expect (length next.audio.states, 4))
        bounded = Components::sine (1, 220.0)
        narrowed = serial ([bounded(parameters = mapList (bounded.parameters, \p => p(maximum = 400.0))), Components::gain (2, 0.25), Components::output 3])
        forEachList ([{ target = original(nodes = []), observation = now, prior = first }, { target = narrowed, observation = now, prior = first }, { target = bypassed, observation = now(revision = 9223372036854775807), prior = first }, { target = bypassed, observation = now, prior = first(states = []) }], \r => renderRefused (Repatch::apply (original, r.target, r.observation, r.prior)))))
    test ("float PCM export retains sample precision and rejects invalid rates and samples", \() => arithmetic (\() =>
        succeeds (synth::WaveFiles::monoFloat (48000, [0.0, 0.25, -0.5, 1.0]), \hex =>
            expect (startsWith hex "524946464200000057415645666D7420120000000300010080BB000000EE02000400200000006661637404000000040000006461746110000000", true)
            expect (endsWith hex "000000000000803E000000BF0000803F", true)
            expect (length hex, 148))
        expect (synth::PcmWords::float32 (-0.5), "000000BF")
        expect (synth::PcmWords::float64 0.5, "000000000000E03F")
        succeeds (synth::PcmWords::sample ("000000BF", 0), \value => expect (value, -0.5))
        renderRefused (synth::PcmWords::sample ("0000807F", 0))
        forEachList (toList (range (1, 128)), hexDigitCase)
        forEachList (["0000000Z", "0000"], \word => renderRefused (synth::PcmWords::read32 (word, 0)))
        renderRefused (synth::WaveFiles::interleaved (48000, 2, [0.0]))
        renderRefused (synth::WaveFiles::monoFloat (0, [0.0]))
        forEachList ([9218868437227405312, 9221120237041090560], \bits => renderRefused (synth::WaveFiles::monoFloat (48000, [floatFromBits bits])))))
    test ("parallel hosted and dry paths arrive at the mixer on the same sample", \() => arithmetic latencyJourney)
    test ("external descriptors preserve channel types, MIDI ports and independent parameter identities", \() => arithmetic (\() =>
        control = synth::HostControl(identity = 100, name = "Delay", initial = 1.0, automatable = true)
        descriptor = synth::HostDescriptor(latency = 0, identifier = "0CDBB66985D548A9BFD8371909D24BB3", name = "ADelay", inputChannels = 2, outputChannels = 2, notes = false, controls = [control])
        first = hostNode (synth::Hosted::component (10, descriptor))
        second = hostNode (synth::Hosted::component (11, descriptor))
        expect (length first.inputs, 1)
        expect (length first.outputs, 1)
        expect ((listGet first.inputs 0 ?: missingPort ()).channels, 2)
        graph = accepted (Graphs::add (accepted (Graphs::add (Graphs::empty, first)), second))
        linked = accepted (Graphs::rewire (graph, synth::Components::route (10, 0, 11, 0)))
        expect (length linked.cables, 1)
        expect (length (synth::Parameters::initial linked).parameters, 2)
        instrument = hostNode (synth::Hosted::component (12, descriptor(inputChannels = 0, notes = true)))
        expect (length instrument.inputs, 1)
        expect ((listGet instrument.inputs 0 ?: missingPort ()).rate == synth::Events, true)
        badDescriptor = { shape = descriptor(outputChannels = 0), why = synth::InvalidNode }
        forEachList ([badDescriptor, badDescriptor(shape = descriptor(inputChannels = 65)), badDescriptor(shape = descriptor(identifier = "")), badDescriptor(shape = descriptor(controls = [control, control]), why = synth::DuplicateParameter), badDescriptor(shape = descriptor(controls = [control(initial = floatFromBits 9221120237041090560)]), why = synth::InvalidParameter)], \r => refused (synth::Hosted::component (13, r.shape), r.why))
        forEachList ([control(identity = -1), control(name = "")], \bad => refused (synth::Hosted::component (13, descriptor(controls = [bad])), synth::InvalidParameter))))
    test ("offline clips render filters, delays, mixing, stereo conversion and independent control signals", \() => arithmetic (\() =>
        forEachList ([Components::sine (1, 440.0), Components::lfo (1, 2.0), Components::lowpass (1, 4000.0, 0.7), Components::delay (1, 17), Components::gain (1, 0.5)], \n => partitionedKernel (n, 1))
        stereoFilter = Components::lowpass (1, 4000.0, 0.7)
        partitionedKernel (stereoFilter(inputs = [audio(channels = 2)], outputs = [audio(channels = 2)]), 2)
        nodes = [Components::sine (1, 440.0), Components::lowpass (2, 4000.0, 0.7), Components::gain (3, 0.5), Components::delay (4, 2), Components::mixer 5, Components::stereo 6, Components::modulatedGain (7, 2, 0.5), Components::lfo (8, 2.0), Components::stereoOutput 9, Components::midiNote (10, 60.0, 0.8, 128.0)]
        routes = [cable (1, 2), cable (2, 3), cable (3, 4), cable (4, 5), Components::route (3, 0, 5, 1), cable (5, 6), cable (6, 7), Components::route (8, 0, 7, 1), cable (7, 9)]
        graph = built (nodes, routes)
        partitionedGraph (graph, 9)
        match synth::GraphClips::advance (graph, [], 256)
            Error why => expect (synth::Faults::detail why, "rendered clip")
            Success action => match action
                synth::ClipWaiting _ _ _ => unexpected ()
                synth::ClipReady clips =>
                    expect (length clips, 10)
                    succeeds (synth::ClipInputs::completed (clips, 9), \output =>
                        expect (output.clipChannels, 2)
                        energetic (output.clipSamples, 512)
                        forEachList (toList (range (0, 256)), \frame => near (listGet output.clipSamples (satMul frame 2) ?: 99.0, listGet output.clipSamples (satAdd (satMul frame 2) 1) ?: 98.0, 0.0))
                        renderRefused (synth::GraphClips::advance (graph, [output, output], 256))
                        renderRefused (synth::GraphClips::advance (graph, [output(clipSamples = [])], 256)))
                    succeeds (synth::GraphClips::advance (graph, clips, 256), \again => sameStructure (again, action))
        forEachList ([-1, 0, 32769], \frames => renderRefused (synth::GraphClips::advance (graph, [], frames)))
        renderRefused (synth::GraphClips::advance (graph(cables = []), [], 256))
        renderRefused (synth::GraphClips::advance (Graphs::empty, [], 256))))
    test ("MIDI and modulation become checked native packets, then real-shaped stereo responses resume the graph", \() => arithmetic (\() =>
        unpluggedDial ()
        original = hostGraph ()
        graph = reconnected original
        expect (length graph.cables, 3)
        streamedHost graph
        forEachList ([1, 2, 255, 256, 257], twoPluginBlock)
        match synth::GraphClips::advance (graph, [], 256)
            Error why => expect (synth::Faults::detail why, "hosted clip")
            Success action => match action
                synth::ClipReady _ => unexpected ()
                synth::ClipWaiting identity request clips =>
                    expect (identity, 2)
                    expect (length request.notes == 2 && length request.parameters == 2, true)
                    reads (listGet request.notes 1, \off => expect (off.offset, 128))
                    pointValue (request, 0.5)
                    layout = synth::HostLayout(inputChannels = 0, outputChannels = 2, acceptsNotes = true)
                    succeeds (synth::HostPackets::clip (layout, request), \bytes => expect (startsWith bytes "000100000200000002000000", true))
                    succeeds (synth::HostResponses::clip (hostReply (), layout, 256), \reply =>
                        expect (reply.renderChannels, 2)
                        expect (reply.renderFrames, 256)
                        expect (reply.renderLatency, 0)
                        result = hostClip (reply.renderSamples)
                        match synth::GraphClips::advance (graph, listAppend clips result, 256)
                            Error why => expect (synth::Faults::detail why, "resumed graph")
                            Success finished => match finished
                                synth::ClipWaiting _ _ _ => unexpected ()
                                synth::ClipReady completed => succeeds (synth::ClipInputs::completed (completed, 4), \output => sameSamples (output.clipSamples, reply.renderSamples)))
                    forEachList ([hostReply () + "00", take (hostReply ()) 100, "", "4F535631010000000200000001000000"], \reply => renderRefused (synth::HostResponses::clip (reply, layout, 256)))
                    renderRefused (synth::HostPackets::clip (layout(acceptsNotes = false), request))
                    forEachList ([{ slot = 0, bad = request(frames = 0) }, { slot = 1, bad = request(samples = []) }], \r => renderRefused (synth::HostPackets::packet (r.slot, r.bad)))
                    renderRefused (synth::HostPackets::slice ([0.0], 1, 1))
        badRoute = { source = 3, target = 2, key = "vst:100", why = synth::InvalidParameter }
        forEachList ([badRoute(source = 1, why = synth::IncompatiblePorts), badRoute(key = "missing"), badRoute(target = 1, why = synth::InvalidNode), badRoute(target = 99, why = synth::MissingNode)], \r => refused (synth::HostModulation::connect (graph, r.source, 0, r.target, r.key), r.why))
        sameStructure (reconnected graph, graph)
        released = accepted (Graphs::disconnect (graph, Components::route (3, 0, 2, 1)))
        match synth::GraphClips::advance (released, [], 256)
            Error _ => unexpected ()
            Success action => match action
                synth::ClipReady _ => unexpected ()
                synth::ClipWaiting _ request _ => pointValue (request, 0.25)))
    test ("MIDI windows preserve note ownership and reject malformed control values", \() => arithmetic (\() =>
        note = Components::midiNote (5, 60.0, 0.75, 256.0)
        forEachList ([0, 256], \first => succeeds (synth::MidiClips::window (note, first, 256), \notes => expect (length notes, 1)))
        succeeds (synth::MidiClips::window (note, 512, 256), \notes => expect (length notes, 0))
        forEachList ([Components::midiNote (5, -1.0, 0.75, 256.0), Components::midiNote (5, 60.5, 0.75, 256.0), Components::midiNote (5, 60.0, 1.1, 256.0), Components::midiNote (5, 60.0, 0.75, 1.5), note(parameters = []), Components::sine (5, 440.0)], \bad => renderRefused (synth::MidiClips::window (bad, 0, 512)))
        renderRefused (synth::MidiClips::window (note, 65535, 2))
        forEachList ([{ start = 65535, span = 2, admitted = true }, { start = 9223372036854775806, span = 1, admitted = true }, { start = 9223372036854775807, span = 1, admitted = false }, { start = 0, span = 65537, admitted = false }], \r => timelineAt (note, r.start, r.span, r.admitted))))
    test ("retained VST dial edits preserve scheduled points and enforce the automation budget", \() => arithmetic retainedDialEdits)
    test ("worker transport rejects malformed headers, nonfinite PCM, bad events and excessive automation", \() => arithmetic (\() =>
        layout = synth::HostLayout(inputChannels = 2, outputChannels = 2, acceptsNotes = false)
        block = synth::HostBlock(frames = 257, notes = [], parameters = [], samples = steady (514, 0.25))
        succeeds (synth::HostPackets::clip (layout, block), \bytes => expect (length bytes, 4160))
        short = "4F53563102000000020000000000000002000000000000000000803E000000BF0000803E000000BF"
        succeeds (synth::HostResponses::clip (short, layout, 2), \reply => sameSamples (reply.renderSamples, [0.25, -0.5, 0.25, -0.5]))
        forEachList (["4F535631ZZZZZZZZ", "4F53563102000000ZZZZZZZZ", "4F5356310200000002000000ZZZZZZZZ", "4F535631020000000200000000000000ZZZZZZZZ", "4F53563102000000020000000000000002000000ZZZZZZZZ", "4F53563102000000020000000000000002000000FFFFFFFF", "4F5356310200000002000000000000000100000000000000", "4F53563102000000020000000000000002000000000000000000807F000000000000000000000000"], \reply => renderRefused (synth::HostResponses::clip (reply, layout, 2)))
        // [SYNTH-HOST-STREAM] A wide input can exceed the worker's one-MiB read limit even with a mono output.
        wide = block(frames = 4096, samples = synth::Sequences::zeros 262144, notes = [], parameters = [])
        renderRefused (synth::HostPackets::clip (layout(inputChannels = 64, outputChannels = 1), wide))
        forgedInput = "4F53563141000000" + drop short 16
        renderRefused (synth::HostResponses::clip (forgedInput, layout(inputChannels = 65), 2))
        badNote = synth::HostNote(kind = 1, offset = 256, pitch = 60, channel = 0, identity = 1, velocity = 0.8)
        forEachList ([block(frames = 2, samples = [floatFromBits 9218868437227405312, 0.0, 0.0, 0.0]), block(frames = 2, notes = [badNote], samples = [0.0, 0.0, 0.0, 0.0]), block(parameters = [synth::HostParameter(identity = 100, offset = 257, value = 0.5)])], \bad => renderRefused (synth::HostPackets::clip (layout, bad)))
        graph = hostGraph ()
        hosted = hostNode (Graphs::node (graph, 2))
        forEachList (["invalid", "vst:invalid", "vst:4294967296"], \key => renderRefused (synth::HostModulation::points (graph, [], hosted(parameters = [synth::Parameter(key = key, label = key, unit = synth::Normalised, minimum = 0.0, maximum = 1.0, initial = 0.5, automatable = true)]), 256)))
        renderRefused (synth::HostModulation::points (graph, [], hosted, 0))
        controlled = reconnected graph
        n = hostNode (Graphs::node (controlled, 2))
        forEachList ([[], [audioClipFixture (3, 2, [])], [audioClipFixture (3, 1, [1.1])]], \clips => renderRefused (synth::HostModulation::points (controlled, clips, n, 256)))
        duplicated = controlled(cables = listAppend controlled.cables (Components::route (3, 0, 2, 1)))
        renderRefused (synth::HostModulation::points (duplicated, [], n, 256))
        renderRefused (synth::ClipInputs::request (controlled, [], n, 256))
        noVelocity = Components::midiNote (1, 60.0, 0.5, 1.0)
        renderRefused (synth::MidiClips::window (noVelocity(parameters = filterList (noVelocity.parameters, \p => p.key != "velocity")), 0, 2))))
    test ("corrupt graph layouts, buffers and kernel states return explicit failures", \() => arithmetic (\() =>
        source = Components::sine (1, 440.0)
        gain = Components::gain (2, 0.5)
        graph = serial ([source, gain, Components::output 3])
        plan = planFor graph
        clip = nodeClipAt (1, [0.25, 0.5])
        forEachList ([[], [clip(clipSamples = [])]], \clips => renderRefused (synth::ClipKernels::render (plan, clips, gain, 2, 1)))
        forEachList ([0, 65], \channels => renderRefused (synth::ClipKernels::render (plan, [clip], gain, 2, channels)))
        missing = graph(nodes = [gain, Components::output 3])
        renderRefused (synth::ClipKernels::render (plan(graph = missing), [clip], gain, 2, 1))
        wrong = graph(cables = [Components::route (1, 9, 2, 0), cable (2, 3)])
        renderRefused (synth::ClipKernels::render (plan(graph = wrong), [clip], gain, 2, 1))
        widened = Components::stereo 8
        modulated = Components::modulatedGain (9, 2, 1.0)
        lfo = Components::lfo (10, 2.0)
        forEachList ([source(outputs = []), widened(inputs = []), gain(inputs = [], outputs = []), modulated(outputs = []), lfo(outputs = [])], \bad => expect (synth::ClipLayouts::supported bad, false))
        renderRefused (synth::GraphClips::advance (graph(nodes = [source, source, gain, Components::output 3]), [], 2))
        looped = built ([Components::mixer 1, Components::delay (2, 1), Components::output 3], [cable (2, 1), Components::route (2, 0, 1, 1), cable (1, 2), cable (1, 3)])
        renderRefused (synth::GraphClips::advance (looped, [], 2))
        renderRefused (synth::ClipInputs::routed (graph, [clip], 99, 0))
        invalidBus = hostNode (synth::Hosted::component (4, hostDescriptor ()))
        forEachList ([invalidBus(inputs = [audio, audio]), invalidBus(outputs = [audio, audio])], \bad => renderRefused (synth::ClipInputs::layout bad))
        initial = rendered (synth::Renderer::start graph)
        snapshot = Parameters::initial graph
        succeeds (synth::Renderer::block (plan, 48000.0, snapshot, initial, 17), \normal =>
            succeeds (synth::Renderer::block (plan, 48000.0, snapshot, initial(states = listReverse initial.states), 17), \reordered =>
                sameStructure (normal.samples, reordered.samples)
                sameStructure (normal.states, listReverse reordered.states)))
        renderRefused (synth::Renderer::block (plan, 48000.0, snapshot, initial(states = []), 1))
        frame = synth::SampleFrame(states = [], values = [])
        forEachList ([99, 1], \frames => renderRefused (synth::RenderKernels::step (plan, 48000.0, Parameters::initial graph, frame, frames)))
        renderRefused (synth::RenderInputs::sample (frame, 1))
        renderRefused (synth::RenderInputs::sample (frame(values = [synth::NodeSample(identity = 1, value = floatFromBits 9218868437227405312)]), 1))
        forEachList ([source(parameters = []), source(parameters = [synth::Parameter(key = "frequency", label = "Frequency", unit = synth::Hertz, minimum = -1.0, maximum = 19000.0, initial = -1.0, automatable = true)])], \bad => renderRefused (synth::ClipKernels::render (plan(graph = graph(nodes = [bad, gain, Components::output 3])), [], bad, 2, 1)))
        filtered = Components::lowpass (2, 1000.0, 0.7)
        missingResonance = filtered(parameters = filterList (filtered.parameters, \p => p.key != "resonance"))
        invalidGain = gain(parameters = [synth::Parameter(key = "gain", label = "Gain", unit = synth::Amplitude, minimum = -1.0, maximum = 8.0, initial = -1.0, automatable = true)])
        forEachList ([gain(parameters = []), invalidGain, filtered(parameters = []), missingResonance, Components::lowpass (2, 0.0, 0.7), Components::mixer 2, Components::delay (2, 0)], \bad => renderRefused (synth::ClipKernels::render (plan(graph = graph(nodes = [source, bad, Components::output 3])), [clip], bad, 2, 1)))
        controlledGain = Components::modulatedGain (2, 1, 1.0)
        controlGraph = graph(nodes = [source, controlledGain, Components::lfo (4, 2.0), Components::output 3], cables = [cable (1, 2), Components::route (4, 0, 2, 1), cable (2, 3)])
        controlClip = nodeClipAt (4, [0.5, 0.5])
        renderRefused (synth::ClipKernels::render (plan(graph = controlGraph), [clip, controlClip(clipSamples = [1.1, 1.1])], controlledGain, 2, 1))
        forEachList ([controlledGain(parameters = []), controlledGain(parameters = invalidGain.parameters)], \bad => renderRefused (synth::ClipKernels::render (plan(graph = controlGraph(nodes = [source, bad, Components::lfo (4, 2.0), Components::output 3])), [clip, controlClip], bad, 2, 1)))
        started = rendered (Renderer::start graph)
        renderRefused (Renderer::block (plan, 48000.0, Parameters::initial graph, started(states = []), 1))))
