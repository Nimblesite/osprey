import synth::Components
import synth::Formulas
import synth::Kinds

configurationText = "configuration"
middleCFive = [60, 60, 60, 60, 60]

// [SYNTH-FORMULA-NOTES] A typed formula over the step number t becomes one MIDI note per step.
pitchOf note = match note
    synth::Rest => -1
    synth::Sounded pitch => pitch

// The first five pitches a formula names, -1 for each rest.
formulaPitches (formula, expected) = succeeds (Formulas::parse formula, \term => expect (mapList (Formulas::notes (term, 5), pitchOf), expected))

formulaFault (formula, why) = refusedAs (Formulas::parse formula, configurationText, "Formula: ${why}")

melody (formula, stepFrames, gateFrames, steps) = Components::formulaNotes (1, formula, 0.5, stepFrames, gateFrames, steps)

timelineIs (n, first, count, expected) = succeeds (synth::MidiClips::timeline (n, first, count), \notes => expect (structuralEquals (notes, expected), true))

// One sounded step: its note-on at `on` and note-off at `off`.
sounded (pitch, on, off) = [keyed (1, on, pitch, 1, 0.5), keyed (2, off, pitch, 1, 0.0)]

allSounded steps = foldList (steps, [], \(all, step) => listConcat all step)

tooLong () = foldList (toList (range (0, 257)), "", \(text, _) => text + "1")

registerFormulaJourney () =
    test ("note formulas parse with precedence, evaluate totally and fold every pitch into MIDI range [SYNTH-FORMULA-NOTES]", \() => arithmetic (\() =>
        formulaPitches ("60", middleCFive)
        formulaPitches ("  60\t+ t ", [60, 61, 62, 63, 64])
        formulaPitches ("60 + t * 2", [60, 62, 64, 66, 68])
        formulaPitches ("(60 + t) * 2", [120, 122, 124, 126, 116])
        formulaPitches ("60 + t % 3 * 4", [60, 64, 68, 60, 64])
        formulaPitches ("(t - 5) % 12 + 60", [67, 68, 69, 70, 71])
        formulaPitches ("2 ^ 3 ^ 2", [116, 116, 116, 116, 116])
        formulaPitches ("-2 ^ 2 + 64", middleCFive)
        formulaPitches ("--60 + t", [60, 61, 62, 63, 64])
        formulaPitches ("60 + 12 * sin(t * 3.14159265358979 / 2)", [60, 72, 60, 48, 60])
        formulaPitches ("cos(t * 0) * 60", middleCFive)
        formulaPitches ("48 + floor(t / 2) * 7", [48, 48, 55, 55, 62])
        formulaPitches ("abs(t - 2) * 12 + round(2.4) + 46", [72, 60, 48, 60, 72])
        formulaPitches ("60 / (t - 2)", [6, 0, -1, 60, 30])
        formulaPitches ("sqrt(t - 2) + 60", [-1, -1, 60, 61, 61])
        formulaPitches ("t % 0", [-1, -1, -1, -1, -1])
        formulaPitches ("-1 - t", [11, 10, 9, 8, 7])
        formulaPitches ("1000000", [124, 124, 124, 124, 124])
        formulaPitches ("1000001 + t", [-1, -1, -1, -1, -1])
        formulaPitches ("((((t))))", [0, 1, 2, 3, 4])))
    test ("a formula the parser cannot read is refused with the column it stopped at", \() => arithmetic (\() =>
        formulaFault ("", "write 1 to 256 characters.")
        formulaFault (tooLong (), "write 1 to 256 characters.")
        formulaFault ("60 +", "the formula ends where a number, t, a function or '(' belongs.")
        formulaFault ("60 ^", "the formula ends where a number, t, a function or '(' belongs.")
        formulaFault ("(60 + t", "a '(' is never closed.")
        formulaFault ("sin(1", "a '(' is never closed.")
        formulaFault ("60 + x", "unknown name 'x'; use t, sin, cos, abs, floor, round or sqrt.")
        formulaFault ("SIN(0)", "unknown name 'SIN'; use t, sin, cos, abs, floor, round or sqrt.")
        formulaFault ("sin t", "sin needs '(' at column 5.")
        formulaFault ("sin", "sin needs '(' and an argument.")
        formulaFault ("60 $ 2", "unexpected character at column 4.")
        formulaFault ("1.5.2", "unexpected character at column 4.")
        formulaFault ("é", "unexpected character at column 1.")
        formulaFault ("60 )", "unexpected ')' at column 4.")
        formulaFault ("()", "unexpected ')' at column 2.")
        formulaFault ("60 61", "unexpected number at column 4.")
        formulaFault ("t t", "unexpected 't' at column 3.")))
    test ("a formula note source steps its notes at exact frames across any window, cuts long gates and skips rests", \() => arithmetic (\() =>
        rising = melody ("60 + t * 4", 100.0, 50.0, 3.0)
        expect (Kinds::kind rising.processor, "synth.formula-notes")
        expect (Kinds::noteSource rising.processor && Kinds::noteSource (Components::midiNote (1, 60.0, 0.5, 8.0)).processor, true)
        expect (Kinds::noteSource (Components::sine (1, 440.0)).processor, false)
        expect (synth::ClipLayouts::supported rising && synth::ClipLayouts::requiresClips rising, true)
        expect (synth::ClipLayouts::supported (rising(inputs = [midiOutlet ()])), false)
        succeeds (synth::ClipLayouts::channels rising, \width => expect (width, 0))
        timelineIs (rising, 0, 400, allSounded [sounded (60, 0, 50), sounded (64, 100, 150), sounded (68, 200, 250)])
        timelineIs (rising, 100, 100, sounded (64, 0, 50))
        timelineIs (rising, 150, 100, [keyed (2, 0, 64, 1, 0.0), keyed (1, 50, 68, 1, 0.5)])
        timelineIs (rising, 300, 100, [])
        timelineIs (melody ("60", 100.0, 500.0, 2.0), 0, 300, allSounded [sounded (60, 0, 100), sounded (60, 100, 200)])
        timelineIs (melody ("60 / (t - 1)", 100.0, 50.0, 3.0), 0, 300, allSounded [sounded (0, 0, 50), sounded (60, 200, 250)])
        refusedAs (synth::MidiClips::timeline (melody ("60 +", 100.0, 50.0, 3.0), 0, 64), configurationText, "Formula: the formula ends where a number, t, a function or '(' belongs.")
        forEachList ([melody ("t", 100.0, 50.0, 300.0), melody ("t", 8.0, 50.0, 3.0), melody ("t", 100.0, 0.0, 3.0)], \n =>
            refusedAs (synth::MidiClips::timeline (n, 0, 64), configurationText, "The MIDI generator parameter is outside its range."))
        refusedAs (synth::MidiClips::timeline (melody ("t", 100.0, 50.0, 2.5), 0, 64), configurationText, "MIDI pitch and gate frames must be whole numbers.")
        refusedAs (synth::MidiClips::timeline (Components::formulaNotes (1, "t", 1.5, 100.0, 50.0, 3.0), 0, 64), configurationText, "MIDI velocity must be between zero and one.")
        refusedAs (synth::MidiClips::timeline (rising(parameters = []), 0, 64), "resource", "The MIDI generator is missing a required parameter.")
        refusedAs (synth::MidiClips::timeline (rising, -1, 64), configurationText, "Invalid MIDI generator or sample window.")
        refusedAs (synth::MidiClips::timeline (Components::sine (1, 440.0), 0, 64), configurationText, "Invalid MIDI generator or sample window.")))
    test ("a formula melody plays a connected oscillator like a MIDI note and re-attacks on every step", \() => arithmetic (\() =>
        tune = serial ([Components::formulaNotes (1, "69", 0.5, 128.0, 8.0, 2.0), midiOscillator (), Components::output 3])
        single = outputClip (3, synth::GraphClips::advance (midiInstrument (69.0, 0.5, 8.0), 48000.0, [], 128))
        first = outputClip (3, synth::GraphClips::advance (tune, 48000.0, [], 128))
        clipIs (first, 1, 128)
        sameSamples (first.clipSamples, single.clipSamples)
        whole = outputClip (3, synth::GraphClips::advance (tune, 48000.0, [], 256))
        clipIs (whole, 1, 256)
        forEachList ([[64, 64, 128], [128, 128], [1, 255], [200, 56]], \sizes => graphRun (tune, 3, sizes, \_clock audio => sameSamples (audio, whole.clipSamples)))
        graphRun (tune, 3, [256], \clock _audio =>
            expect (clock.graphPosition, 256)
            heldVoice (clock, 2, \voice => expect (voice.pitch == 69 && voice.noteIdentity == 1 && voice.active == false, true)))))
