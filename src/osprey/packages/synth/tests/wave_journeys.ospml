import synth::WaveImport
import synth::SampleResources
import synth::WaveMath
import synth::Waves
import synth::SpectralStreams
import synth::SpectralMath
import synth::Components
import synth::Limiters
import synth::Spectra

// [SYNTH-ADVANCED-GRAINS-IMPORT] Decoding and downmixing real WAV bytes into grain resources.
// [SYNTH-ADVANCED-GRAINS-IMPORT] Every refusal carries its own message; nothing fails silently.
// [MATH-CODE] The generated WaveMath/Waves oracles are checked against hand-computed IEEE754 results.

wavJoin parts = foldList (parts, [], \(joined, part) => listConcat (joined, part))

wavCharacter (text, at) = match byteAt text at
    Error _ => 0
    Success byte => byte

wavText text = mapList (toList (range (0, length text)), \at => wavCharacter (text, at))

wavWord16 value = [bitAnd value 255, bitAnd (shiftRight value 8) 255]

wavWord32 value = [bitAnd value 255, bitAnd (shiftRight value 8) 255, bitAnd (shiftRight value 16) 255, bitAnd (shiftRight value 24) 255]

wavHeader size = wavJoin [wavText "RIFF", wavWord32 size, wavText "WAVE"]

// An odd chunk body is stored with its required pad byte.
wavPadded body = match bitAnd (length body) 1
    1 => listAppend body 0
    _ => body

// A stored RIFF chunk: header, body, and the pad byte odd bodies require.
wavChunk (tag, body) = listConcat (wavJoin [wavText tag, wavWord32 (length body)], wavPadded body)

// A chunk written without its pad byte, to corrupt the stream on purpose.
wavUnpadded (tag, body) = listConcat (wavJoin [wavText tag, wavWord32 (length body)], body)

wavFormatBody (encoding, channels, rate, align, byteRate, bits) = wavJoin [wavWord16 encoding, wavWord16 channels, wavWord32 rate, wavWord32 byteRate, wavWord16 align, wavWord16 bits]

wavPack chunks =
    body = wavJoin chunks
    listConcat (wavHeader (satAdd (length body) 4), body)

wavFile (encoding, channels, rate, bits, data) = wavPack [wavChunk ("fmt ", wavFormatBody (encoding, channels, rate, satMul (shiftRight bits 3) channels, satMul rate (satMul (shiftRight bits 3) channels), bits)), wavChunk ("data", data)]

// The refusals below assert the exact user-facing message, not merely failure.
refusedWith (outcome, why) = match outcome
    Error actual => expect (actual, why)
    Success _ => unexpected ()

// One shared runner per assertion shape: rows carry the inputs and the expected value.
exactRows rows = forEachList (rows, \c => expect (c.got, c.want))

nearRows rows = forEachList (rows, \c => near (c.got, c.want, c.within))

wavMonoFmt () = wavChunk ("fmt ", wavFormatBody (1, 1, 48000, 2, 96000, 16))

wavMonoData () = wavChunk ("data", [0, 64, 0, 128])

// [SYNTH-ADVANCED-SPECTRAL-FORMANT] A vowel-like voice: harmonics of 156.25 Hz under one resonance at 1 kHz.
formantRate = 16000.0

formantVoiceAt (centre, n) = foldList (toList (range (1, 40)), 0.0, \(sum, k) => sum + sin (6.283185307179586 * 156.25 * toFloat k * toFloat n / formantRate) / (1.0 + pow ((156.25 * toFloat k - centre) / 120.0, 2.0)))

formantVoice n = formantVoiceAt (1000.0, n)

formantTone (level, n) = level * sin (6.283185307179586 * 500.0 * toFloat n / formantRate)

formantConfig (ratio, formant) = synth::SpectralConfig(sampleRate = formantRate, size = 1024, hop = 256, transform = synth::SpectralPitch(ratio = ratio, formant = formant), mix = 1.0)

formantStep (config, voices, carry, n) = match carry
    Error why => Error(message = why)
    Success run => match SpectralStreams::next (config, run.held, voices.main n, voices.side n)
        Error why => Error(message = why)
        Success step => Success(value = { held = step.next, samples = listAppend run.samples step.sample })

// 4,096 samples; the last 1,024 lie past the transform's 1,023-sample latency.
spectralRendered (config, voices) = foldList (toList (range (0, 4096)), Success(value = { held = SpectralStreams::initial config, samples = [] }), \(carry, n) => formantStep (config, voices, carry, n))

formantRendered config = spectralRendered (config, { main = formantVoice, side = \_ => 0.0 })

formantWindowed (samples, n) = (listGet samples n ?: 0.0) * (0.5 - 0.5 * cos (6.283185307179586 * toFloat (n - 3072) / 1024.0))

// Hann-windowed DFT magnitude of the final 1,024 samples at one frequency.
formantLevel (samples, frequency) =
    tail = toList (range (3072, 4096))
    re = foldList (tail, 0.0, \(sum, n) => sum + formantWindowed (samples, n) * cos (6.283185307179586 * frequency * toFloat n / formantRate))
    im = foldList (tail, 0.0, \(sum, n) => sum + formantWindowed (samples, n) * sin (6.283185307179586 * frequency * toFloat n / formantRate))
    sqrt (re * re + im * im)

formantLevels config = match formantRendered config
    Error why => { fault = why, kept = 0.0, raised = 0.0, between = 0.0, old = 0.0, root = 0.0 }
    Success run => { fault = "", kept = formantLevel (run.samples, 937.5), raised = formantLevel (run.samples, 1406.25), between = formantLevel (run.samples, 1093.75), old = formantLevel (run.samples, 156.25), root = formantLevel (run.samples, 234.375) }

morphConfig (amount, mode) = synth::SpectralConfig(sampleRate = formantRate, size = 1024, hop = 256, transform = synth::SpectralMorph(amount = amount, mode = mode), mix = 1.0)

// Output level at one frequency once the morph has settled, as a sine amplitude (Hann window gain 1/2, DFT N/2).
morphLevel (config, voices, frequency) = match spectralRendered (config, voices)
    Error _ => -1.0
    Success run => formantLevel (run.samples, frequency) / 256.0

// A harmonic tone: six partials falling as 1/k.
partialsTone (fundamental, count, n) = foldList (toList (range (1, satAdd count 1)), 0.0, \(sum, k) => sum + sin (6.283185307179586 * fundamental * toFloat k * toFloat n / formantRate) / toFloat k)

harmonicTone (fundamental, n) = partialsTone (fundamental, 6, n)

// Blend of two 500 Hz sines at levels m and s lands on the geometric path exp((1 - a) ln m + a ln s), within 5%.
blendLanded (c) = near (morphLevel (morphConfig (c.a, synth::Blend), { main = \n => formantTone (c.m, n), side = \n => formantTone (c.s, n) }, 500.0) / exp ((1.0 - c.a) * ln c.m + c.a * ln c.s), 1.0, 0.05)

// The 1.875 kHz : 937.5 Hz level ratio of the main vowel under the side vowel's envelope at amount a.
envelopeTilt a = match spectralRendered (morphConfig (a, synth::Envelope), { main = formantVoice, side = \n => formantVoiceAt (1875.0, n) })
    Error _ => -1.0
    Success run => formantLevel (run.samples, 1875.0) / formantLevel (run.samples, 937.5)

// Six main harmonics against three side harmonics: three pairs glide, the main's harmonics 4-6 fade by 1 - a where they stand.
orphansLanded (c) = match spectralRendered (morphConfig (c.a, synth::Partial), { main = \n => partialsTone (220.0, 6, n), side = \n => partialsTone (330.0, 3, n) })
    Error why => expect (why, "")
    Success run =>
        glide = exp ((1.0 - c.a) * ln 220.0 + c.a * ln 330.0)
        forEachList ([1.0, 2.0, 3.0], \k => near (formantLevel (run.samples, glide * k) / 256.0 * k, 1.0, 0.2))
        forEachList ([4.0, 5.0, 6.0], \k => near (formantLevel (run.samples, 220.0 * k) / 256.0 * k / (1.0 - c.a), 1.0, 0.2))

// One rendered Partial morph from a harmonic tone at `low` to one at `high`: harmonic k must land at k x the
// geometric glide with level 1/k (within 20%), and each source's own harmonics must sit 30 dB below it.
partialLanded (c) = match spectralRendered (morphConfig (c.a, synth::Partial), { main = \n => harmonicTone (c.low, n), side = \n => harmonicTone (c.high, n) })
    Error why => expect (why, "")
    Success run =>
        glide = exp ((1.0 - c.a) * ln c.low + c.a * ln c.high)
        forEachList ([1.0, 2.0, 3.0], \k => near (formantLevel (run.samples, glide * k) / 256.0 * k, 1.0, 0.2))
        forEachList (filterList ([c.low, c.high], \f => abs (f - glide) > 25.0), \f => expect (formantLevel (run.samples, f) / 256.0 < 0.032, true))

configured config = match SpectralStreams::configure config
    Error _ => false
    Success _ => true

registerWaveJourneys () =
    test ("decoded WAV keeps every PCM width, channel layout and stereo downmix exact", \() => arithmetic (\() =>
        succeeds (WaveImport::decode (wavFile (1, 1, 48000, 16, [0, 64, 0, 128])), \wave =>
            sameSamples (wave.samples, [0.5, -1.0])
            expect (wave.sampleRate, 48000)
            expect (wave.channels, 1)
            expect (wave.frames, 2))
        forEachList ([
            { bytes = wavFile (1, 1, 44100, 8, [0, 128, 255]), want = [-1.0, 0.0, 0.9921875], channels = 1, frames = 3 },
            { bytes = wavFile (1, 1, 8000, 24, [0, 0, 128, 0, 0, 64, 255, 255, 127]), want = [-1.0, 0.5, 0.9999998807907104], channels = 1, frames = 3 },
            { bytes = wavFile (1, 1, 192000, 32, [0, 0, 0, 128, 255, 255, 255, 127]), want = [-1.0, 0.9999999995343387], channels = 1, frames = 2 },
            { bytes = wavFile (3, 2, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 191, 0, 0, 128, 191, 0, 0, 128, 63]), want = [0.25, 0.0], channels = 2, frames = 2 },
            { bytes = wavFile (1, 2, 48000, 16, [0, 64, 0, 192, 255, 127, 0, 128]), want = [0.0, -0.0000152587890625], channels = 2, frames = 2 }],
            \held => succeeds (WaveImport::decode held.bytes, \wave =>
                sameSamples (wave.samples, held.want)
                expect (wave.channels, held.channels)
                expect (wave.frames, held.frames)
                expect (wave.sampleRate > 0, true)
                expect (length wave.samples == wave.frames, true)))
        // An 18-byte format extension, a metadata chunk and odd-body padding all survive.
        succeeds (WaveImport::decode (wavPack [wavChunk ("fmt ", listConcat (wavFormatBody (1, 1, 48000, 2, 96000, 16)) (wavWord16 0)), wavChunk ("LIST", [9, 8, 7]), wavMonoData ()]), \wave => sameSamples (wave.samples, [0.5, -1.0]))))
    test ("WAV import refuses corrupt sizes, headers, chunks, formats and out-of-range samples", \() => arithmetic (\() =>
        fmt = wavMonoFmt ()
        data = wavMonoData ()
        standard = wavFormatBody (1, 1, 48000, 2, 96000, 16)
        forEachList ([
            { why = "WAV file size must be between 12 bytes and 8 MiB.", bad = [[], wavText "RIFF"] },
            { why = "Expected a complete little-endian RIFF/WAVE file.", bad = [wavJoin [wavText "RIFX", wavWord32 4, wavText "WAVE"], wavJoin [wavText "RIFF", wavWord32 4, wavText "WAVX"], wavJoin [wavText "RIFF", wavWord32 99, wavText "WAVE"]] },
            { why = "WAV input contains a value outside the byte range.", bad = [wavJoin [[999, 73, 70, 70], wavWord32 4, wavText "WAVE"], wavJoin [[-1, 73, 70, 70], wavWord32 4, wavText "WAVE"], listConcat (wavHeader 12) [999, 85, 78, 75, 4, 0, 0, 0]] },
            { why = "Truncated WAV chunk header or too many chunks (limit 1024).", bad = [listConcat (wavHeader 10) [74, 85, 78, 75, 0, 0], wavPack (mapList (toList (range (0, 1025)), \_ => wavChunk ("LIST", [])))] },
            { why = "Truncated WAV chunk body or padding.", bad = [wavPack [fmt, wavJoin [wavText "data", wavWord32 100]], wavPack [fmt, wavUnpadded ("LIST", [1, 2, 3])]] },
            { why = "Duplicate or short WAV format chunk.", bad = [wavPack [fmt, fmt, data], wavPack [wavChunk ("fmt ", wavJoin [wavWord16 1, wavWord16 1, wavWord32 48000, wavWord32 96000, wavWord16 2, [16]]), data]] },
            { why = "Duplicate WAV data chunk.", bad = [wavPack [fmt, data, data]] },
            { why = "WAV requires one format chunk and one data chunk.", bad = [wavPack [fmt], wavPack [data]] },
            { why = "Truncated WAV format extension.", bad = [wavPack [wavChunk ("fmt ", listAppend (standard, 0)), data]] },
            { why = "Extended WAV formats are not supported by this importer.", bad = [wavPack [wavChunk ("fmt ", listConcat (standard, wavWord16 2)), data], wavPack [wavChunk ("fmt ", listConcat (standard, listAppend (wavWord16 0, 0))), data], wavPack [wavChunk ("fmt ", listConcat (standard, listAppend (wavWord16 2, 0))), data]] },
            { why = "WAV requires 2–1048576 complete sample frames.", bad = [wavFile (1, 1, 48000, 16, [0, 64]), wavFile (1, 1, 48000, 16, [0, 64, 0, 128, 0])] },
            { why = "WAV samples must be finite and within [-1, 1].", bad = [wavFile (3, 1, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 64]), wavFile (3, 1, 48000, 32, [0, 0, 128, 63, 0, 0, 192, 127]), wavFile (3, 2, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 64, 0, 0, 128, 63, 0, 0, 0, 64])] }],
            \held => forEachList (held.bad, \bad => refusedWith (WaveImport::decode bad, held.why)))
        // Unsupported encodings and widths, three channels, rates outside 8–192 kHz, misaligned frames, wrong byte rate.
        forEachList ([wavFormatBody (1, 1, 48000, 1, 48000, 12), wavFormatBody (2, 1, 48000, 2, 96000, 16), wavFormatBody (3, 1, 48000, 2, 96000, 16), wavFormatBody (1, 3, 48000, 6, 288000, 16), wavFormatBody (1, 1, 7999, 2, 15998, 16), wavFormatBody (1, 1, 192001, 2, 384002, 16), wavFormatBody (1, 1, 48000, 3, 96000, 16), wavFormatBody (1, 1, 48000, 2, 48000, 16)],
            \body => refusedWith (WaveImport::decode (wavPack [wavChunk ("fmt ", body), wavMonoData ()]), "WAV requires PCM 8/16/24/32 or float32, mono/stereo, 8–192 kHz and consistent frame/byte rates."))))
    test ("sample resources validate metadata, prepare grains and transpose by root pitch", \() => arithmetic (\() =>
        kit = synth::SampleResource(name = "loop", sampleRate = 48000, sourceChannels = 2, rootFrequency = 261.6255653005986, samples = [0.5, -0.5])
        longName = join (mapList (toList (range (0, 256)), \_ => "x")) ""
        forEachList ([
            { r = kit, want = true },
            { r = kit(name = "x"), want = true },
            { r = kit(name = longName), want = true },
            { r = kit(sampleRate = 8000), want = true },
            { r = kit(sampleRate = 192000), want = true },
            { r = kit(sourceChannels = 1), want = true },
            { r = kit(rootFrequency = 1.0), want = true },
            { r = kit(rootFrequency = 20000.0), want = true },
            { r = kit(name = ""), want = false },
            { r = kit(name = join (mapList (toList (range (0, 257)), \_ => "x")) ""), want = false },
            { r = kit(sampleRate = 7999), want = false },
            { r = kit(sampleRate = 192001), want = false },
            { r = kit(sourceChannels = 0), want = false },
            { r = kit(sourceChannels = 3), want = false },
            { r = kit(rootFrequency = 0.99), want = false },
            { r = kit(rootFrequency = 20000.1), want = false }],
            \held => expect (SampleResources::metadata held.r, held.want))
        succeeds (SampleResources::prepare kit, \prepared => expect (structuralEquals prepared kit, true))
        // kit(samples=...) variants fail inside grain preparation; the last fails metadata first.
        forEachList ([kit(samples = []), kit(samples = [0.5]), kit(samples = [0.5, 1.5])], \bad => refusedWith (SampleResources::prepare bad, "Grains require 2–1048576 finite normalised mono samples and capacity 1–256."))
        refusedWith (SampleResources::prepare (kit(sampleRate = 192001)), "Invalid sample resource name, sample rate, source channels or root frequency.")
        wave = synth::WaveSamples(sampleRate = 48000, channels = 2, frames = 2, samples = [0.25, -0.25])
        succeeds (SampleResources::fromWave ("loop", 60.0, wave), \resource =>
            expect (resource.name, "loop")
            expect (resource.sampleRate, 48000)
            expect (resource.sourceChannels, 2)
            near (resource.rootFrequency, 261.6255653005986, 0.000000001)
            sameSamples (resource.samples, [0.25, -0.25]))
        forEachList ([-0.5, 127.5], \root => refusedWith (SampleResources::fromWave ("loop", root, wave), "Invalid sample root pitch or decoded frame count."))
        refusedWith (SampleResources::fromWave ("loop", 60.0, wave(frames = 3)), "Invalid sample root pitch or decoded frame count.")
        refusedWith (SampleResources::fromWave ("loop", 60.0, wave(samples = [2.0, -2.0])), "Grains require 2–1048576 finite normalised mono samples and capacity 1–256.")
        refusedWith (SampleResources::fromWave ("loop", 60.0, wave(channels = 3)), "Invalid sample resource name, sample rate, source channels or root frequency.")
        succeeds (SampleResources::decodeWave ("loop", 60.0, wavFile (1, 1, 48000, 16, [0, 64, 0, 128])), \resource => sameSamples (resource.samples, [0.5, -1.0]))
        refusedWith (SampleResources::decodeWave ("loop", 60.0, wavText "RIFF"), "WAV file size must be between 12 bytes and 8 MiB.")
        succeeds (SampleResources::fromWave ("loop", 60.0, wave), \tuned =>
            forEachList ([{ note = 60.0, rate = 48000.0, want = 1.0 }, { note = 72.0, rate = 48000.0, want = 2.0 }, { note = 48.0, rate = 96000.0, want = 0.25 }, { note = 60.0, rate = 44100.0, want = 1.08843537414966 }],
                \held => succeeds (SampleResources::playbackRate (tuned, held.note, held.rate), \speed => near (speed, held.want, 0.000000001)))
            forEachList ([-1.0, 128.0], \note => refusedWith (SampleResources::playbackRate (tuned, note, 48000.0), "Invalid sample pitch or output rate."))
            forEachList ([7999.0, 384001.0], \rate => refusedWith (SampleResources::playbackRate (tuned, 60.0, rate), "Invalid sample pitch or output rate."))
            expect (SampleResources::metadata kit, true))
        refusedWith (SampleResources::playbackRate (kit(sampleRate = 192001), 60.0, 48000.0), "Invalid sample pitch or output rate.")
        succeeds (SampleResources::fromWave ("sub", 0.0, wave), \low => refusedWith (SampleResources::playbackRate (low, 127.0, 48000.0), "The requested sample transposition exceeds the grain rate limit."))))
    test ("generated wave math: PCM words, downmix, tuning and polyBLEP shapes hit exact IEEE754 values", \() => arithmetic (\() =>
        exactRows ([{ got = WaveMath::pcm (0.0, 8.0), want = -1.0 }, { got = WaveMath::pcm (128.0, 8.0), want = 0.0 }, { got = WaveMath::pcm (255.0, 8.0), want = 0.9921875 }, { got = WaveMath::pcm (0.0, 16.0), want = 0.0 }, { got = WaveMath::pcm (16384.0, 16.0), want = 0.5 }, { got = WaveMath::pcm (32767.0, 16.0), want = 0.999969482421875 }, { got = WaveMath::pcm (32768.0, 16.0), want = -1.0 }, { got = WaveMath::pcm (65535.0, 16.0), want = -0.000030517578125 }, { got = WaveMath::pcm (4194304.0, 24.0), want = 0.5 }, { got = WaveMath::pcm (8388608.0, 24.0), want = -1.0 }, { got = WaveMath::pcm (16777215.0, 24.0), want = -0.00000011920928955078125 }, { got = WaveMath::pcm (0.0, 32.0), want = 0.0 }, { got = WaveMath::pcm (2147483648.0, 32.0), want = -1.0 }, { got = WaveMath::pcm (4294967295.0, 32.0), want = -0.00000000046566128730773926 }])
        exactRows ([{ got = WaveMath::mono (0.25, -0.5), want = -0.125 }, { got = WaveMath::mono (-1.0, 1.0), want = 0.0 }, { got = WaveMath::mono (0.5, 0.5), want = 0.5 }, { got = WaveMath::mono (0.75, 0.25), want = 0.5 }])
        nearRows ([
            { got = WaveMath::playbackRate (48000.0, 48000.0, 440.0, 220.0), want = 2.0, within = 0.000000001 },
            { got = WaveMath::playbackRate (48000.0, 96000.0, 880.0, 880.0), want = 0.5, within = 0.000000001 },
            { got = WaveMath::playbackRate (44100.0, 48000.0, 440.0, 440.0), want = 0.91875, within = 0.000000001 },
            { got = WaveMath::playbackRate (24000.0, 48000.0, 440.0, 220.0), want = 1.0, within = 0.000000001 }])
        nearRows ([{ got = Waves::midiFrequency 69.0, want = 440.0, within = 0.0 }, { got = Waves::midiFrequency 81.0, want = 880.0, within = 0.0 }, { got = Waves::midiFrequency 57.0, want = 220.0, within = 0.0 }, { got = Waves::midiFrequency 60.0, want = 261.6255653005986, within = 0.000000001 }, { got = Waves::midiFrequency 0.0, want = 8.175798915643707, within = 0.000000001 }])
        exactRows ([{ got = Waves::velocitySample (0.5, 0.8), want = 0.4 }, { got = Waves::velocitySample (-1.0, 0.25), want = -0.25 }, { got = Waves::velocitySample (0.25, 0.0), want = 0.0 }])
        exactRows ([{ got = Waves::wrap 0.25, want = 0.25 }, { got = Waves::wrap 1.25, want = 0.25 }, { got = Waves::wrap (-0.25), want = 0.75 }, { got = Waves::wrap 3.0, want = 0.0 }])
        nearRows ([{ got = Waves::blep (0.25, 0.5), want = -0.25, within = 0.000000001 }, { got = Waves::blep (0.75, 0.5), want = 0.25, within = 0.000000001 }, { got = Waves::blep (0.5, 0.5), want = 0.0, within = 0.000000001 }, { got = Waves::blep (0.3, 0.0), want = 0.0, within = 0.000000001 }, { got = Waves::blep (0.3, -0.5), want = 0.0, within = 0.000000001 }, { got = Waves::blep (0.999, 0.01), want = 0.81, within = 0.000000001 }])
        nearRows ([{ got = Waves::blamp (0.25, 0.5), want = 0.0416666666666667, within = 0.000000001 }, { got = Waves::blamp (0.75, 0.5), want = 0.0416666666666667, within = 0.000000001 }, { got = Waves::blamp (0.1, 0.2), want = 0.0416666666666667, within = 0.000000001 }, { got = Waves::blamp (0.5, 0.5), want = 0.0, within = 0.000000001 }, { got = Waves::blamp (0.9, 0.0), want = 0.0, within = 0.000000001 }])
        nearRows ([{ got = Waves::sine 0.25, want = 1.0, within = 0.000000000001 }, { got = Waves::sine 0.0, want = 0.0, within = 0.0 }, { got = Waves::sine 0.5, want = 0.0, within = 0.000000000001 }, { got = Waves::sine 0.75, want = -1.0, within = 0.000000000001 }, { got = Waves::sine 0.125, want = sin (6.283185307179586 * 0.125), within = 0.0 }])
        exactRows ([{ got = Waves::saw (0.0, 0.01), want = 0.0 }, { got = Waves::saw (0.25, 0.01), want = -0.5 }, { got = Waves::saw (0.5, 0.01), want = 0.0 }, { got = Waves::saw (0.75, 0.01), want = 0.5 }])
        exactRows ([{ got = Waves::pulse (0.25, 0.01, 0.5), want = 1.0 }, { got = Waves::pulse (0.75, 0.01, 0.5), want = -1.0 }, { got = Waves::pulse (0.0, 0.01, 0.5), want = 0.0 }, { got = Waves::pulse (0.5, 0.01, 0.5), want = 0.0 }])
        nearRows ([{ got = Waves::triangle (0.5, 0.0), want = 1.0, within = 0.0 }, { got = Waves::triangle (0.25, 0.0), want = 0.0, within = 0.0 }, { got = Waves::triangle (0.0, 0.0), want = -1.0, within = 0.0 }, { got = Waves::triangle (0.75, 0.01), want = 0.0, within = 0.000000000001 }, { got = Waves::triangle (0.5, 0.01), want = 0.9866666666666667, within = 0.000000001 }, { got = Waves::harmonic (0.25, 0.01, 3.0), want = -1.0, within = 0.000000000001 }, { got = Waves::harmonic (0.125, 0.01, 2.0), want = 1.0, within = 0.000000000001 }])
        exactRows ([{ got = Waves::harmonic (0.25, 0.2, 3.0), want = 0.0 }, { got = Waves::harmonic (0.25, 0.25, 2.0), want = 0.0 }])
        nearRows ([{ got = Waves::glass (0.25, 0.01, 0.0), want = 1.0, within = 0.000000000001 }, { got = Waves::glass (0.25, 0.01, 1.0), want = sin (6.283185307179586 * 0.25) * 0.7 + sin (6.283185307179586 * 0.75) * 0.3, within = 0.000000000001 }, { got = Waves::bass (0.25, 0.2, 1.0), want = sin (6.283185307179586 * 0.25) * 0.65, within = 0.000000000001 }, { got = Waves::bass (0.125, 0.01, 0.0), want = sin (6.283185307179586 * 0.125) * 0.65 + sin (6.283185307179586 * 0.25) * 0.1, within = 0.000000000001 }, { got = Waves::hollow (0.25, 0.2, 1.0), want = sin (6.283185307179586 * 0.25) * 0.6, within = 0.000000000001 }, { got = Waves::hollow (0.25, 0.01, 1.0), want = sin (6.283185307179586 * 0.25) * 0.6 + sin (6.283185307179586 * 0.75) * 0.25 + sin (6.283185307179586 * 1.25) * 0.15, within = 0.000000000001 }])
        expect (Waves::modulated (0.0, 0.0), 0.0)
        near (Waves::modulated (0.25, 1.0), sin (6.283185307179586 * (0.25 + 0.35 * sin (6.283185307179586 * 0.5))), 0.000000000001)
        exactRows ([{ got = Waves::ring (0.5, 0.0, 0.0), want = 0.5 }, { got = Waves::ring (0.5, 0.0, 1.0), want = 0.0 }])
        near (Waves::ring (0.5, 0.25, 1.0), sin (6.283185307179586 * 1.75) * 0.5, 0.000000000001)
        exactRows ([{ got = Waves::unipolar (-1.0), want = 0.0 }, { got = Waves::unipolar 0.0, want = 0.5 }, { got = Waves::unipolar 0.25, want = 0.625 }, { got = Waves::unipolar 1.0, want = 1.0 }])
        exactRows ([{ got = Waves::controlledGain (0.5, 2.0, 0.25), want = 0.25 }, { got = Waves::controlledGain (-0.5, 0.5, 1.0), want = -0.25 }])
        exactRows ([{ got = Waves::controlledCutoff (1000.0, 0.0), want = 1.0 }, { got = Waves::controlledCutoff (1000.0, 0.5), want = 500.5 }, { got = Waves::controlledCutoff (1000.0, 1.0), want = 1000.0 }, { got = Waves::controlledCutoff (20000.0, 0.25), want = 5000.75 }])
        exactRows ([{ got = Waves::releaseGain (1.0, 4.0), want = 0.0 }, { got = Waves::releaseGain (0.5, 2.0), want = 0.0 }, { got = Waves::releaseGain (4.0, 4.0), want = 1.0 }, { got = Waves::releaseGain (5.0, 3.0), want = 2.0 }, { got = Waves::releaseGain (9.0, 5.0), want = 2.0 }])))
    test ("formant pitch shifting moves pitch and formants independently and refuses out-of-range ratios", \() => arithmetic (\() =>
        kept = formantLevels (formantConfig (1.5, 1.0))
        moved = formantLevels (formantConfig (1.5, 1.5))
        forEachList ([kept, moved], \levels => expect (levels.fault, ""))
        // Both land on the new pitch: 234.375 Hz harmonics sound, the old 156.25 Hz series and off-harmonics are gone.
        forEachList ([kept, moved], \levels => expect (levels.root > 1.0 && levels.kept > 10.0 && levels.raised > 10.0, true))
        forEachList ([kept, moved], \levels => expect (levels.old < 0.000001 && levels.between < 0.000001, true))
        // formant = 1 keeps the resonance at 1 kHz; formant = ratio carries it up to 1.5 kHz with the pitch.
        expect (kept.kept > kept.raised * 1.5, true)
        expect (moved.raised > moved.kept * 6.0, true)
        expect (kept.kept > moved.kept * 3.0 && moved.raised > kept.raised * 3.0, true)
        // Equal envelopes give a gain of exactly 1; silence is never amplified; gains stop at +24 dB.
        forEachList ([{ w = 0.3, c = 0.3, want = 1.0 }, { w = 5.0, c = 0.0, want = 1.0 }, { w = 100.0, c = 1.0, want = 16.0 }, { w = 1.0, c = 4.0, want = 0.25 }, { w = 2.0, c = 0.5, want = 4.0 }],
            \g => expect (SpectralMath::formantGain (g.w, g.c), g.want))
        expect (SpectralMath::envelopeRadius (1024.0, 16000.0), 10.0)
        forEachList ([{ r = 1.5, f = 0.25, ok = true }, { r = 1.5, f = 4.0, ok = true }, { r = 0.5, f = 2.0, ok = true }, { r = 1.5, f = 0.2, ok = false }, { r = 1.5, f = 4.5, ok = false }, { r = 0.2, f = 1.0, ok = false }, { r = 1.0, f = 0.0, ok = false }],
            \c => expect (configured (formantConfig (c.r, c.f)), c.ok))
        spectral = Components::spectral (7, 1024, 256, 6.0)
        expect (length (filterList (spectral.parameters, \p => p.key == "formant" && p.initial == 1.0 && p.minimum == 0.25 && p.maximum == 4.0)), 1)))
    test ("spectral morphing blends log magnitudes and cross-synthesises one sound's envelope onto another [SYNTH-SPECTRAL-MORPH]", \() => arithmetic (\() =>
        tones = { main = \n => formantTone (0.5, n), side = \n => formantTone (0.05, n) }
        // Blend walks the geometric path: 0.5 at 0, sqrt(0.5 x 0.05) = 0.158 halfway (a crossfade would give 0.275), 0.05 at 1.
        forEachList ([{ m = 1.0, s = 0.01, a = 0.5 }, { m = 0.2, s = 0.8, a = 0.5 }, { m = 0.4, s = 0.4, a = 0.3 }, { m = 0.9, s = 0.1, a = 0.1 }, { m = 0.05, s = 0.6, a = 0.8 }, { m = 0.3, s = 0.03, a = 0.66 }], blendLanded)
        // Envelope tilt rises monotonically with the amount, from the main vowel's own shape to the side's.
        tilts = mapList ([0.0, 0.25, 0.5, 0.75, 1.0], envelopeTilt)
        forEachList ([0, 1, 2, 3], \i => expect ((listGet tilts (satAdd i 1) ?: 0.0) > (listGet tilts i ?: 0.0) * 1.2, true))
        expect ((listGet tilts 0 ?: 9.0) < 0.2 && (listGet tilts 4 ?: 0.0) > 5.0, true)
        forEachList ([{ a = 0.0, want = 0.5 }, { a = 0.25, want = 0.2812 }, { a = 0.5, want = 0.1581 }, { a = 0.75, want = 0.0889 }, { a = 1.0, want = 0.05 }],
            \c => near (morphLevel (morphConfig (c.a, synth::Blend), tones, 500.0) / c.want, 1.0, 0.05))
        // Envelope: the main voice's harmonics (resonance 1 kHz) take on the side voice's resonance at 1.875 kHz.
        vowels = { main = formantVoice, side = \n => formantVoiceAt (1875.0, n) }
        own = { low = morphLevel (morphConfig (0.0, synth::Envelope), vowels, 937.5), high = morphLevel (morphConfig (0.0, synth::Envelope), vowels, 1875.0) }
        crossed = { low = morphLevel (morphConfig (1.0, synth::Envelope), vowels, 937.5), high = morphLevel (morphConfig (1.0, synth::Envelope), vowels, 1875.0) }
        expect (own.low > own.high * 5.0, true)
        expect (crossed.high > crossed.low * 5.0, true)
        // The harmonics stay the main voice's: no energy appears between them.
        forEachList ([0.0, 0.5, 1.0], \a => expect (morphLevel (morphConfig (a, synth::Envelope), vowels, 1015.625) < 0.000001, true))
        forEachList ([{ a = -0.1, ok = false }, { a = 1.1, ok = false }, { a = 0.0, ok = true }, { a = 1.0, ok = true }], \c => expect (configured (morphConfig (c.a, synth::Blend)), c.ok))
        forEachList ([{ a = 0.0, b = 0.0, t = 0.5, want = 0.0 }, { a = 0.5, b = 0.05, t = 0.0, want = 0.5 }, { a = 1.0, b = 4.0, t = 0.5, want = 2.0 }], \c => near (SpectralMath::logBlend (c.a, c.b, c.t), c.want, 0.0000001))
        forEachList ([{ w = 4.0, o = 1.0, t = 0.5, want = 2.0 }, { w = 4.0, o = 1.0, t = 0.0, want = 1.0 }, { w = 1.0, o = 0.0, t = 1.0, want = 1.0 }, { w = 1000.0, o = 1.0, t = 1.0, want = 16.0 }], \c => near (SpectralMath::envelopeMorph (c.w, c.o, c.t), c.want, 0.0000001))))
    test ("partial morphing glides every matched harmonic to the geometric pitch between two tones [SYNTH-SPECTRAL-MORPH]", \() => arithmetic (\() =>
        // Rising and falling glides, fifths and an octave, at five amounts: 0 and 1 reproduce their source tone.
        forEachList ([{ low = 220.0, high = 330.0, a = 0.0 }, { low = 220.0, high = 330.0, a = 0.25 }, { low = 220.0, high = 330.0, a = 0.5 }, { low = 220.0, high = 330.0, a = 0.75 }, { low = 220.0, high = 330.0, a = 1.0 },
            { low = 330.0, high = 220.0, a = 0.5 }, { low = 330.0, high = 220.0, a = 0.25 }, { low = 200.0, high = 400.0, a = 0.5 }, { low = 250.0, high = 375.0, a = 0.6 }, { low = 300.0, high = 200.0, a = 0.9 }], partialLanded)
        // Unequal partial counts: orphans fade by 1 - amount at their own pitch while the pairs glide.
        forEachList ([{ a = 0.0 }, { a = 0.25 }, { a = 0.4 }, { a = 0.5 }], orphansLanded)
        // Partial morphing is stateful: it cannot share a series analysis.
        expect (configured (synth::SpectralConfig(sampleRate = formantRate, size = 1024, hop = 256, transform = synth::SpectralSeries(steps = [synth::SpectralMorph(amount = 0.5, mode = synth::Partial)]), mix = 1.0)), false)
        expect (configured (synth::SpectralConfig(sampleRate = formantRate, size = 1024, hop = 256, transform = synth::SpectralSeries(steps = [synth::SpectralMorph(amount = 0.5, mode = synth::Blend)]), mix = 1.0)), true)
        forEachList ([{ a = 1.0, b = 2.0, c = 1.0, want = 0.0 }, { a = 0.0, b = 0.0, c = 0.0, want = 0.0 }, { a = 0.0, b = 1.0, c = 0.5, want = 0.1666666667 }, { a = 0.5, b = 1.0, c = 0.0, want = -0.1666666667 }, { a = 0.0, b = 1.0, c = 1.0, want = 0.5 }, { a = 1.0, b = 1.0, c = 0.0, want = -0.5 }, { a = -2.0, b = 0.0, c = -2.0, want = 0.0 }], \p => near (SpectralMath::peakOffset (p.a, p.b, p.c), p.want, 0.0000001))
        near (SpectralMath::logLevel 1.0, 0.000000001, 0.0000000001)))

// [SYNTH-DYNAMICS-LIMITER] The brick-wall limiter against sines, bursts and single impulses.
limitRate = 48000.0

limitSine (amplitude, count) = mapList (toList (range (0, count)), \i => amplitude * sin (6.283185307179586 * 997.0 * toFloat i / limitRate))

limitSpike (i, at, height) = match i == at
    true => height
    false => 0.0

limitImpulse (count, at, height) = mapList (toList (range (0, count)), \i => limitSpike (i, at, height))

limitHigher (high, value) = match abs value > high
    true => abs value
    false => high

limitPeak side = foldList (side, 0.0, limitHigher)

// Before the last clamp, every frame already sits inside the ceiling: the lookahead, not the clamp, did it.
limitUnclamped (left, right, gains, ceiling) = forEachList (toList (range (0, length left)), \i =>
    g = listGet gains i ?: 9.0
    expect (g > 0.0 && g <= 1.0, true)
    expect (abs (listGet left i ?: 0.0) * g <= ceiling * 1.000000001, true)
    expect (abs (listGet right i ?: 0.0) * g <= ceiling * 1.000000001, true))

limitChecked (left, right, c, gains) =
    expect (length gains, length left)
    limitUnclamped (left, right, gains, c.ceiling)
    out = Limiters::applied (left, gains, c.ceiling)
    expect (limitPeak out <= c.ceiling, true)
    expect (limitPeak out >= c.ceiling * 0.95, limitPeak left > c.ceiling)

limitCase (left, right, c) = match Limiters::gains (left, right, limitRate, c.ceiling, c.ms, c.release)
    Error _ => unexpected ()
    Success gains => limitChecked (left, right, c, gains)

// A signal under the ceiling passes bit-exact: every gain is exactly one.
limitTransparent (amplitude, c) = match Limiters::gains (limitSine (amplitude, 2400), limitSine (amplitude, 2400), limitRate, c.ceiling, c.ms, c.release)
    Error _ => unexpected ()
    Success gains => forEachList (gains, \g => expect (g, 1.0))

// One impulse: unity until the lookahead (and the oversampler's half width) opens, the exact need on the impulse,
// recovering after it.
limitImpulseGains (gains, block, c) =
    expect (listGet gains (1000 - block - 5) ?: 0.0, 1.0)
    near (listGet gains 1000 ?: 0.0, c.ceiling / 4.0, 0.000000001)
    expect ((listGet gains (1000 - intDiv block 2) ?: 0.0) < 1.0, true)
    expect ((listGet gains (1000 - intDiv block 2) ?: 0.0) > c.ceiling / 4.0, true)
    expect ((listGet gains (1001 + block) ?: 0.0) > (listGet gains 1000 ?: 1.0), true)
    expect ((listGet gains 5999 ?: 0.0) > (listGet gains (1001 + block) ?: 1.0), true)
    expect ((listGet gains 5999 ?: 0.0) > 0.99, c.release <= 0.01)

limitOneImpulse (c, block) = match Limiters::gains (limitImpulse (6000, 1000, 4.0), limitImpulse (6000, 0, 0.0), limitRate, c.ceiling, c.ms, c.release)
    Error _ => unexpected ()
    Success gains => limitImpulseGains (gains, block, c)

// A quarter-rate sine at 45 degrees: every sample is 0.707 of a true peak of 1, which only the oversampler sees.
limitBetween i = sin (1.5707963267948966 * toFloat i + 0.7853981633974483)

limitInterSample c = match Limiters::gains (mapList (toList (range (0, 4800)), limitBetween), mapList (toList (range (0, 4800)), limitBetween), limitRate, c.ceiling, c.ms, c.release)
    Error _ => unexpected ()
    Success gains => forEachList ([1200, 2400, 3600], \i => limitHeldUnder (listGet gains i ?: 9.0, c.ceiling))

// The held gain brings the true peak of 1 down to the ceiling within the oversampler's 1% accuracy.
limitHeldUnder (g, ceiling) =
    expect (g <= ceiling * 1.01, true)
    expect (g >= ceiling * 0.97, true)

limitWhy = "A limiter needs equal sides, a rate of 8 to 384 kHz, a ceiling above 0 up to 1, a lookahead of 0.1 to 20 ms and a release of 1 ms to 2 s."

limitRefusals () =
    one = limitSine (1.0, 64)
    refusedWith (Limiters::gains (one, limitSine (1.0, 63), limitRate, 0.89, 5.0, 0.1), limitWhy)
    forEachList ([{ rate = 4000.0, ceiling = 0.89, ms = 5.0, release = 0.1 }, { rate = 48000.0, ceiling = 0.0, ms = 5.0, release = 0.1 }, { rate = 48000.0, ceiling = 1.5, ms = 5.0, release = 0.1 }, { rate = 48000.0, ceiling = 0.89, ms = 0.05, release = 0.1 }, { rate = 48000.0, ceiling = 0.89, ms = 25.0, release = 0.1 }, { rate = 48000.0, ceiling = 0.89, ms = 5.0, release = 0.0 }, { rate = 48000.0, ceiling = 0.89, ms = 5.0, release = 3.0 }, { rate = 400000.0, ceiling = 0.89, ms = 5.0, release = 0.1 }], \r => refusedWith (Limiters::gains (one, one, r.rate, r.ceiling, r.ms, r.release), limitWhy))

limitSettings = [{ ceiling = 0.89, ms = 5.0, release = 0.05, block = 240 }, { ceiling = 0.5, ms = 1.5, release = 0.01, block = 72 }, { ceiling = 1.0, ms = 0.1, release = 0.2, block = 5 }, { ceiling = 0.25, ms = 20.0, release = 0.002, block = 960 }]

limitJourney () =
    forEachList (limitSettings, \c =>
        forEachList ([0.1, 0.9, 2.0, 8.0], \amplitude => limitCase (limitSine (amplitude, 4800), limitSine (amplitude * 0.5, 4800), c))
        limitCase (limitImpulse (4800, 2400, 3.0), limitSine (0.2, 4800), c)
        limitTransparent (c.ceiling * 0.99, c)
        limitOneImpulse (c, c.block)
        limitInterSample c)
    limitRefusals ()

// [DAW-ANALYSIS-SPECTRUM] The octave-band analyser against sines of known level and frequency.
spectrumTone (parts, i) = foldList (parts, 0.0, \(sum, p) => sum + p.amplitude * sin (6.283185307179586 * p.frequency * toFloat i / limitRate))

spectrumSignal (parts, count) = mapList (toList (range (0, count)), \i => spectrumTone (parts, i))

spectrumBand (bands, centre) = foldList (bands, synth::SpectrumBand(centre = 0.0, level = 999.0, peak = 999.0), \(found, band) => spectrumPick (found, band, centre))

spectrumPick (found, band, centre) = match band.centre == centre
    true => band
    false => found

// Each listed band reads its tone's level within 0.1 dB; every band two octaves from all tones reads under -60 dB.
spectrumChecked (bands, parts) =
    expect (length bands, 10)
    forEachList (parts, \p => near ((spectrumBand (bands, p.band)).level, p.level, 0.1))
    forEachList (parts, \p => near ((spectrumBand (bands, p.band)).peak, p.level, 0.1))
    forEachList (filterList (bands, \band => spectrumFar (parts, band.centre)), \band => expect (band.level < -60.0, true))

spectrumFar (parts, centre) = length (filterList (parts, \p => p.band > centre * 0.3 && p.band < centre * 3.0)) == 0

spectrumCase (parts, count) = match Spectra::bands (spectrumSignal (parts, count), limitRate, 4096, 2048)
    Error _ => unexpected ()
    Success bands => spectrumChecked (bands, parts)

spectrumWhy = "A spectrum needs a power-of-two frame of 64 to 4096, a hop of at least 1 and a rate of 8 to 384 kHz."

spectrumSilent bands = forEachList (bands, \band => expect ([band.level, band.peak], [-120.0, -120.0]))

// Sound in half the frames: the peak stays at the tone's level, the mean drops by 3 dB.
spectrumHalf i = match i < 24576
    true => sin (6.283185307179586 * 1000.0 * toFloat i / limitRate)
    false => 0.0

spectrumHalves bands =
    near ((spectrumBand (bands, 1000.0)).peak, 0.0, 0.1)
    near ((spectrumBand (bands, 1000.0)).level, -3.0103, 0.35)

spectrumJourney () =
    spectrumCase ([{ frequency = 1000.0, amplitude = 1.0, band = 1000.0, level = 0.0 }], 48000)
    spectrumCase ([{ frequency = 250.0, amplitude = 0.5, band = 250.0, level = -6.0206 }], 48000)
    spectrumCase ([{ frequency = 125.0, amplitude = 0.5, band = 125.0, level = -6.0206 }, { frequency = 4000.0, amplitude = 0.25, band = 4000.0, level = -12.0412 }], 48000)
    spectrumCase ([{ frequency = 2100.0, amplitude = 0.1, band = 2000.0, level = -20.0 }, { frequency = 9000.0, amplitude = 0.7, band = 8000.0, level = -3.098 }], 30000)
    succeeds (Spectra::bands (mapList (toList (range (0, 9000)), \_ => 0.0), limitRate, 2048, 512), spectrumSilent)
    succeeds (Spectra::bands ([], limitRate, 1024, 256), spectrumSilent)
    succeeds (Spectra::bands (mapList (toList (range (0, 49152)), spectrumHalf), limitRate, 4096, 4096), spectrumHalves)
    forEachList ([{ size = 100, hop = 256, rate = 48000.0 }, { size = 8192, hop = 256, rate = 48000.0 }, { size = 1024, hop = 0, rate = 48000.0 }, { size = 1024, hop = 256, rate = 4000.0 }], \r => refusedWith (Spectra::bands ([0.0], r.rate, r.size, r.hop), spectrumWhy))
