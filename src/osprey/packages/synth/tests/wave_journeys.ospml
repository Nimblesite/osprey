import synth::WaveImport
import synth::SampleResources
import synth::WaveMath
import synth::Waves
import synth::SpectralStreams
import synth::SpectralMath
import synth::Components
import synth::Timings

// [SYNTH-ADVANCED-GRAINS-IMPORT] Decoding and downmixing real WAV bytes into grain resources.
// [SYNTH-ADVANCED-GRAINS-IMPORT] Every refusal carries its own message; nothing fails silently.
// [MATH-CODE] The generated WaveMath/Waves oracles are checked against hand-computed IEEE754 results.

wavJoin parts = foldList (parts, [], \(joined, part) => listConcat (joined, part))

wavCharacter (text, at) = match byteAt text at
    Error _ => 0
    Success byte => byte

wavText text = mapList (toList (range (0, length text)), \at => wavCharacter (text, at))

wavWord16 value = [bitAnd value 255, bitAnd (shiftRight value 8) 255]

wavWord32 value = listConcat (wavWord16 value) [bitAnd (shiftRight value 16) 255, bitAnd (shiftRight value 24) 255]

wavHeader size = wavJoin [wavText "RIFF", wavWord32 size, wavText "WAVE"]

// An odd chunk body is stored with its required pad byte.
wavPadded body = match bitAnd (length body) 1
    1 => listAppend body 0
    _ => body

// A stored RIFF chunk: header, body, and the pad byte odd bodies require.
wavChunk (tag, body) = listConcat (wavJoin [wavText tag, wavWord32 (length body)], wavPadded body)

// A chunk written without its pad byte, to corrupt the stream on purpose.
wavUnpadded (tag, body) = listConcat (wavJoin [wavText tag, wavWord32 (length body)], body)

wavFormatBody (encoding, channels, rate, align, byteRate, bits) = wavJoin [wavWord16 encoding, wavWord16 channels, wavWord32 rate, wavWord32 byteRate, wavWord16 align, wavWord16 bits]

wavPack chunks =
    body = wavJoin chunks
    listConcat (wavHeader (satAdd (length body) 4), body)

wavFile (encoding, channels, rate, bits, data) = wavPack [wavChunk ("fmt ", wavFormatBody (encoding, channels, rate, satMul (shiftRight bits 3) channels, satMul rate (satMul (shiftRight bits 3) channels), bits)), wavChunk ("data", data)]

// The refusals below assert the exact user-facing message, not merely failure.
refusedWith (outcome, why) = match outcome
    Error actual => expect (synth::Faults::detail actual, why)
    Success _ => unexpected ()

// [SYNTH-ADVANCED-CORE-MODELS] The refusal's typed class as well as its exact message.
refusedAs (outcome, kind, why) = match outcome
    Error actual => expect ("${faultClass actual}: ${synth::Faults::detail actual}", "${kind}: ${why}")
    Success _ => unexpected ()

faultClass fault = match fault
    synth::InvalidConfiguration _ => "configuration"
    synth::ExhaustedCapacity _ => "capacity"
    synth::MissingResource _ => "resource"
    synth::IncompatibleLayout _ => "layout"
    synth::NumericalFailure _ => "numerical"

// One shared runner per assertion shape: rows carry the inputs and the expected value.
exactRows rows = forEachList (rows, \c => expect (c.got, c.want))

nearRows rows = forEachList (rows, \c => near (c.got, c.want, c.within))

wavStdBody () = wavFormatBody (1, 1, 48000, 2, 96000, 16)

wavMonoFmt () = wavChunk ("fmt ", wavStdBody ())

wavMonoData () = wavChunk ("data", [0, 64, 0, 128])

// [SYNTH-ADVANCED-SPECTRAL-FORMANT] A vowel-like voice: harmonics of 156.25 Hz under one resonance at 1 kHz.
formantRate = 16000.0

formantVoiceAt (centre, n) = foldList (toList (range (1, 40)), 0.0, \(sum, k) => sum + sin (tau * 156.25 * toFloat k * toFloat n / formantRate) / (1.0 + pow ((156.25 * toFloat k - centre) / 120.0, 2.0)))

formantVoice n = formantVoiceAt (1000.0, n)

formantTone (level, n) = level * sin (tau * 500.0 * toFloat n / formantRate)

// Every spectral journey below shares one 16 kHz rate, 1,024-sample window and 256-sample hop.
spectralConfig transform = synth::SpectralConfig(sampleRate = formantRate, size = 1024, hop = 256, transform = transform, mix = 1.0)

formantConfig (ratio, formant) = spectralConfig (synth::SpectralPitch(ratio = ratio, formant = formant))

formantStep (config, voices, carry, n) = match carry
    Error why => Error(message = why)
    Success run => match SpectralStreams::next (config, run.held, voices.main n, voices.side n)
        Error why => Error(message = why)
        Success step => Success(value = { held = step.next, samples = listAppend run.samples step.sample })

// 4,096 samples; the last 1,024 lie past the transform's 1,023-sample latency.
spectralRendered (config, voices) = spectralFor (config, voices, 4096)

spectralFor (config, voices, count) = foldList (toList (range (0, count)), Success(value = { held = SpectralStreams::initial config, samples = [] }), \(carry, n) => formantStep (config, voices, carry, n))

formantRendered config = spectralRendered (config, { main = formantVoice, side = \_ => 0.0 })

// One shared runner for every journey result: the rendered samples go to `consume`, a refusal is asserted exactly.
renderedHeld (rendered, consume) = match rendered
    Error why => expect (synth::Faults::detail why, "")
    Success run => consume run.samples

formantWindowed (samples, n) = (listGet samples n ?: 0.0) * (0.5 - 0.5 * cos (tau * toFloat (n - 3072) / 1024.0))

// Hann-windowed DFT magnitude of the final 1,024 samples at one frequency.
formantLevel (samples, frequency) =
    tail = toList (range (3072, 4096))
    re = foldList (tail, 0.0, \(sum, n) => sum + formantWindowed (samples, n) * cos (tau * frequency * toFloat n / formantRate))
    im = foldList (tail, 0.0, \(sum, n) => sum + formantWindowed (samples, n) * sin (tau * frequency * toFloat n / formantRate))
    sqrt (re * re + im * im)

formantLevels config = match formantRendered config
    Error why => { fault = synth::Faults::detail why, kept = 0.0, raised = 0.0, between = 0.0, old = 0.0, root = 0.0 }
    Success run => { fault = "", kept = formantLevel (run.samples, 937.5), raised = formantLevel (run.samples, 1406.25), between = formantLevel (run.samples, 1093.75), old = formantLevel (run.samples, 156.25), root = formantLevel (run.samples, 234.375) }

// [SYNTH-SPECTRAL-PITCH-EFFECT] A full-scale 500 Hz sine moved `semitones` and `cents` by the FFT shifter, 8,192 samples.
shiftedSine (semitones, cents) =
    ratio = SpectralMath::semitoneRatio (semitones, cents)
    config = spectralConfig (synth::SpectralPitch(ratio = ratio, formant = ratio))
    spectralFor (config, { main = \n => formantTone (1.0, n), side = \_ => 0.0 }, 8192)

// Upward zero crossings from frame 2,048 (past the 1,023-frame latency), each placed between frames by interpolation.
crossings samples = foldList (toList (range (2048, satSub (length samples) 1)), [], \(found, n) => crossed (found, listGet samples n ?: 0.0, listGet samples (satAdd n 1) ?: 0.0, n))

crossed (found, a, b, n) = match a < 0.0 && b >= 0.0
    true => listAppend found (toFloat n + a / (a - b))
    false => found

// Measured frequency over every whole cycle between the first and last crossing.
measured times = match listGet times 0
    Error _ => 0.0
    Success first => match listGet times (satSub (length times) 1)
        Error _ => 0.0
        Success last => toFloat (satSub (length times) 1) * formantRate / (last - first)

// The loudest sample of each 256-frame block from frame 2,048.
blockPeaks samples = mapList (toList (range (8, intDiv (length samples) 256)), \block => loudestIn (samples, satMul block 256, satMul (satAdd block 1) 256))

larger (a, b) = match a > b
    true => a
    false => b

smaller (a, b) = match a < b
    true => a
    false => b

decibels ratio = 20.0 * ln ratio / ln 10.0

// Within 1 cent of 500 Hz times the ratio, the level within 1 dB of full scale and at most 1 dB of ripple.
shiftHeld (c) = renderedHeld (shiftedSine (c.semitones, c.cents), \samples =>
    want = 500.0 * SpectralMath::semitoneRatio (c.semitones, c.cents)
    cents = 1200.0 * ln (measured (crossings samples) / want) / ln 2.0
    peaks = blockPeaks samples
    loudest = foldList (peaks, 0.0, larger)
    quietest = foldList (peaks, 1000.0, smaller)
    expect ("${c.semitones} st ${c.cents} c: ${abs cents < 1.0} ${abs (decibels loudest) <= 1.0} ${decibels (loudest / quietest) <= 1.0}", "${c.semitones} st ${c.cents} c: true true true"))

// [SYNTH-ADVANCED-CORE-RESOURCES] A 512-sample burst shifted an octave keeps sounding past size − 1 + hop after its last
// input and is exactly silent after 2 · (size − 1): the declared tail.
burst n = match n < 512
    true => formantTone (1.0, n)
    false => 0.0

loudestIn (samples, first, limit) = foldList (toList (range (first, limit)), 0.0, \(peak, n) => larger (peak, abs (listGet samples n ?: 0.0)))

tailHeld () = renderedHeld (spectralRendered (formantConfig (2.0, 2.0), { main = burst, side = \_ => 0.0 }), \samples =>
    expect (SpectralStreams::tail 1024, 2046)
    expect (loudestIn (samples, 1791, 2558) > 0.001, true)
    expect (loudestIn (samples, 2558, 4096) == 0.0, true)
    succeeds (Timings::tail (Components::spectral (7, 1024, 256, 6.0)), \held => expect (held, 2046.0)))

morphConfig (amount, mode) = spectralConfig (synth::SpectralMorph(amount = amount, mode = mode))

// The geometric path a morph walks between two pitches or levels; a glided morph's harmonics 1-3 land at level 1/k.
geometric (a, low, high) = exp ((1.0 - a) * ln low + a * ln high)

glided (samples, glide) = forEachList ([1.0, 2.0, 3.0], \k => near (formantLevel (samples, glide * k) / 256.0 * k, 1.0, 0.2))

// Output level at one frequency once the morph has settled, as a sine amplitude (Hann window gain 1/2, DFT N/2).
morphLevel (config, voices, frequency) = match spectralRendered (config, voices)
    Error _ => -1.0
    Success run => formantLevel (run.samples, frequency) / 256.0

// A harmonic tone: six partials falling as 1/k.
partialsTone (fundamental, count, n) = foldList (toList (range (1, satAdd count 1)), 0.0, \(sum, k) => sum + sin (tau * fundamental * toFloat k * toFloat n / formantRate) / toFloat k)

harmonicTone (fundamental, n) = partialsTone (fundamental, 6, n)

// Blend of two 500 Hz sines at levels m and s lands on the geometric path exp((1 - a) ln m + a ln s), within 5%.
blendLanded (c) = near (morphLevel (morphConfig (c.a, synth::Blend), { main = \n => formantTone (c.m, n), side = \n => formantTone (c.s, n) }, 500.0) / geometric (c.a, c.m, c.s), 1.0, 0.05)

// Measure both resonances and the gap between harmonics from the same rendered vowel.
envelopeLevels a = match spectralRendered (morphConfig (a, synth::Envelope), { main = formantVoice, side = \n => formantVoiceAt (1875.0, n) })
    Error why =>
        expect (synth::Faults::detail why, "a rendered vowel")
        { low = 1.0, high = 1.0 }
    Success run =>
        expect (formantLevel (run.samples, 1015.625) / 256.0 < 0.000001, true)
        { low = formantLevel (run.samples, 937.5), high = formantLevel (run.samples, 1875.0) }

// Six main harmonics against three side harmonics: three pairs glide, the main's harmonics 4-6 fade by 1 - a where they stand.
orphansLanded (c) = renderedHeld (spectralRendered (morphConfig (c.a, synth::Partial), { main = \n => partialsTone (220.0, 6, n), side = \n => partialsTone (330.0, 3, n) }), \samples =>
    glided (samples, geometric (c.a, 220.0, 330.0))
    forEachList ([4.0, 5.0, 6.0], \k => near (formantLevel (samples, 220.0 * k) / 256.0 * k / (1.0 - c.a), 1.0, 0.2)))

// One rendered Partial morph from a harmonic tone at `low` to one at `high`: harmonic k must land at k x the
// geometric glide with level 1/k (within 20%), and each source's own harmonics must sit 30 dB below it.
partialLanded (c) = renderedHeld (spectralRendered (morphConfig (c.a, synth::Partial), { main = \n => harmonicTone (c.low, n), side = \n => harmonicTone (c.high, n) }), \samples =>
    glide = geometric (c.a, c.low, c.high)
    glided (samples, glide)
    forEachList (filterList ([c.low, c.high], \f => abs (f - glide) > 25.0), \f => expect (formantLevel (samples, f) / 256.0 < 0.032, true)))

configured config = match SpectralStreams::configure config
    Error _ => false
    Success _ => true

// [SYNTH-SPECTRAL-MORPH] Morph acceptance runs at 48 kHz with a 4,096-sample window and a 1,024-sample hop.
morphRate = 48000.0

wideMorph (amount, mode) = synth::SpectralConfig(sampleRate = morphRate, size = 4096, hop = 1024, transform = synth::SpectralMorph(amount = amount, mode = mode), mix = 1.0)

wideTone (f, level, n) = level * sin (tau * f * toFloat n / morphRate)

// `count` harmonics of `f` at `level`, harmonic k at level / k.
wideHarmonics (f, level, count, n) = foldList (toList (range (1, satAdd count 1)), 0.0, \(sum, k) => sum + wideTone (f * toFloat k, level / toFloat k, n))

// Held at 0.5, or 0 until frame 8,192 and then a 0.5 s (24,000-frame) ramp to 1.
heldAmount _ = 0.5

rampAmount n = match n < 8192
    true => 0.0
    false => match n >= 32192
        true => 1.0
        false => toFloat (n - 8192) / 24000.0

wideStep (amountAt, mode, voices, carry, n) = match carry
    Error why => Error(message = why)
    Success run => match SpectralStreams::next (wideMorph (amountAt n, mode), run.held, voices.main n, voices.side n)
        Error why => Error(message = why)
        Success step => Success(value = { held = step.next, samples = listAppend run.samples step.sample })

wideRendered (amountAt, mode, voices, count) = foldList (toList (range (0, count)), Success(value = { held = SpectralStreams::initial (wideMorph (0.5, mode)), samples = [] }), \(carry, n) => wideStep (amountAt, mode, voices, carry, n))

// Each 1,024-frame hop's rms in dB, from hop `first` to the end.
hopLevels (samples, first) = mapList (toList (range (first, intDiv (length samples) 1024)), \hop =>
    start = satMul hop 1024
    energy = foldList (toList (range (start, satAdd start 1024)), 0.0, \(sum, n) => sum + pow (listGet samples n ?: 0.0, 2.0))
    20.0 * ln (sqrt (energy / 1024.0) + 0.000000001) / ln 10.0)

// Hann-windowed amplitude of one frequency over the last 4,096 samples (window gain 1/2, DFT N/2).
wideLevel (samples, frequency) =
    first = satSub (length samples) 4096
    frames = toList (range (first, length samples))
    windowed = \n => (listGet samples n ?: 0.0) * (0.5 - 0.5 * cos (tau * toFloat (n - first) / 4096.0))
    re = foldList (frames, 0.0, \(sum, n) => sum + windowed n * cos (tau * frequency * toFloat n / morphRate))
    im = foldList (frames, 0.0, \(sum, n) => sum + windowed n * sin (tau * frequency * toFloat n / morphRate))
    sqrt (re * re + im * im) / 1024.0

// A held morph keeps every hop's level within 0.5 dB of its mean, from hop 8: past the 4,095-frame latency and one
// full window.
heldSpread (mode, voices) = renderedHeld (wideRendered (heldAmount, mode, voices, 20480), \samples =>
    levels = hopLevels (samples, 8)
    mean = foldList (levels, 0.0, \(sum, level) => sum + level) / toFloat (length levels)
    expect (foldList (levels, 0.0, \(worst, level) => larger (worst, abs (level - mean))) <= 0.5, true))

// A 0.5 s ramp from 0 to 1: no hop-to-hop step strays more than 2 dB from the ramp's mean step; `drop` is the
// expected total change in dB, or 0 to skip that check.
rampSmooth (mode, voices, drop) = renderedHeld (wideRendered (rampAmount, mode, voices, 36864), \samples =>
    levels = hopLevels (samples, 8)
    last = satSub (length levels) 1
    total = (listGet levels last ?: 0.0) - (listGet levels 0 ?: 0.0)
    trend = total / toFloat last
    forEachList (toList (range (0, last)), \i => expect (abs ((listGet levels (satAdd i 1) ?: 0.0) - (listGet levels i ?: 0.0) - trend) <= 2.0, true))
    expect (drop == 0.0 || abs (total - drop) <= 1.0, true))

// Harmonic tones of 220 and 277 Hz with unequal partial counts at amount 0.25: three pairs glide to the geometric
// pitch, and the unmatched partials fade in place to 0.75 (main) or 0.25 (side) of their level within 1 dB.
orphansHeld (mainCount, sideCount, keep, orphanPitch) = renderedHeld (wideRendered (\_ => 0.25, synth::Partial, { main = \n => wideHarmonics (220.0, 0.25, mainCount, n), side = \n => wideHarmonics (277.0, 0.25, sideCount, n) }, 16384), \samples =>
    glide = exp (0.75 * ln 220.0 + 0.25 * ln 277.0)
    forEachList ([1.0, 2.0, 3.0], \k => near (wideLevel (samples, glide * k) * k / 0.25, 1.0, 0.2))
    forEachList ([4.0, 5.0, 6.0], \k => expect (abs (decibels (wideLevel (samples, orphanPitch * k) * k / 0.25 / keep)) <= 1.0, true)))

// [SYNTH-ADVANCED-CORE-RESOURCES] A sample resource from its five fields.
resourceOf (name, rate, channels, root, samples) = synth::SampleResource(name = name, sampleRate = rate, sourceChannels = channels, rootFrequency = root, samples = samples)

// No two of `hashes` collide.
allDistinct hashes = forEachList (toList (range (0, length hashes)), \i => forEachList (toList (range (satAdd i 1, length hashes)), \j => expect ((listGet hashes i ?: 0) == (listGet hashes j ?: 1), false)))

// [SYNTH-ADVANCED-CORE-RESOURCES] The kick every identity variant below edits, and its content hash.
kickSample () = resourceOf ("kick", 48000, 1, 60.0, [0.0, 0.5, -0.5, 1.0])

sampleHash r = (synth::Resources::sample r).hash

tableIdentity (name, size, count) = match synth::Wavetables::classic (size, count)
    Error why =>
        expect (synth::Faults::detail why, "a table")
        synth::ResourceIdentity(name = "", hash = 0, channels = 0, sampleRate = 0, frames = 0, version = 0)
    Success t => synth::Resources::table (name, t)

// Pin every sample word against direct harmonic synthesis on the current platform.
phasedTableIdentity () =
    indices = toList (range (0, 64))
    fundamental = mapList (indices, \i => synth::TableMath::harmonic (1.0, 1.0, 0.0, toFloat i / 64.0))
    full = mapList (indices, \i => (listGet fundamental i ?: 0.0) + synth::TableMath::harmonic (-0.25, 3.0, 0.125, toFloat i / 64.0))
    scale = 1.0 / foldList (full, 1.0, \(highest, v) => synth::TableMath::larger (highest, abs v))
    levels = [synth::TableLevel(harmonics = 3, samples = mapList (full, \v => v * scale)), synth::TableLevel(harmonics = 1, samples = mapList (fundamental, \v => v * scale))]
    reference = synth::Wavetable(size = 64, harmonics = 3, frames = [synth::TableFrame(levels = levels)])
    succeeds (synth::Wavetables::prepare (64, [synth::TableSpectrum(amplitudes = [1.0, 0.0, -0.25], phases = [0.0, 0.5, 0.125])]), \table => expect ((synth::Resources::table ("phased", table)).hash, (synth::Resources::table ("phased", reference)).hash))

identityJourney () =
    kick = kickSample ()
    id = synth::Resources::sample kick
    expect ("${id.name} ${id.channels} ${id.sampleRate} ${id.frames} ${id.version}", "kick 1 48000 4 1")
    expect (sampleHash kick, id.hash)
    // The name labels; it does not hash. Every word and every field of metadata does.
    expect (sampleHash (kick(name = "renamed")), id.hash)
    variants = [kick, kick(samples = [-1.0 * 0.0, 0.5, -0.5, 1.0]), kick(samples = [0.0, 0.5, -0.5, 0.9999999999999999]), kick(sampleRate = 44100), kick(sourceChannels = 2), kick(rootFrequency = 60.000000000001), kick(samples = [0.5, 0.0, -0.5, 1.0]), kick(samples = [0.0, 0.5, -0.5]), kick(samples = [0.0, 0.5, -0.5, 1.0, 0.0]), kick(samples = [])]
    allDistinct (mapList (variants, sampleHash))
    forEachList ([{ channels = 1, count = 6, frames = 6 }, { channels = 2, count = 6, frames = 3 }, { channels = 2, count = 7, frames = 3 }, { channels = 8, count = 64, frames = 8 }, { channels = 0, count = 5, frames = 5 }], \c => expect ((synth::Resources::sample (resourceOf ("pad", 48000, c.channels, 60.0, mapList (toList (range (0, c.count)), toFloat)))).frames, c.frames))
    expect ((synth::Resources::matches (id, id)) ?: id(hash = 0), id)
    forEachList ([kick(samples = [0.0, 0.5, -0.5, 0.75]), kick(sampleRate = 96000)], \changed => refusedAs (synth::Resources::matches (id, synth::Resources::sample changed), "resource", "The resource kick changed since the project saved it."))
    forEachList ([id(name = "snare"), id(version = 2), id(version = 0)], \saved => refusedAs (synth::Resources::matches (saved, id), "resource", "The saved resource ${saved.name} is missing or uses another identity version."))
    // Tables hash every frame and level; a table is one rate-independent channel of `size` samples.
    phasedTableIdentity ()
    wide = tableIdentity ("classic", 256, 32)
    expect ("${wide.name} ${wide.channels} ${wide.sampleRate} ${wide.frames} ${wide.version}", "classic 1 0 256 1")
    expect ((tableIdentity ("classic", 256, 32)).hash, wide.hash)
    allDistinct ([wide.hash, (tableIdentity ("classic", 256, 16)).hash, (tableIdentity ("classic", 512, 32)).hash, (tableIdentity ("classic", 128, 32)).hash, id.hash])

registerWaveJourneys () =
    test ("decoded WAV keeps every PCM width, channel layout and stereo downmix exact", \() => arithmetic (\() =>
        succeeds (WaveImport::decode (wavFile (1, 1, 48000, 16, [0, 64, 0, 128])), \wave =>
            sameSamples (wave.samples, [0.5, -1.0])
            expect (wave.sampleRate, 48000)
            expect (wave.channels, 1)
            expect (wave.frames, 2))
        forEachList ([{ bytes = wavFile (1, 1, 44100, 8, [0, 128, 255]), want = [-1.0, 0.0, 0.9921875], channels = 1, frames = 3 }, { bytes = wavFile (1, 1, 8000, 24, [0, 0, 128, 0, 0, 64, 255, 255, 127]), want = [-1.0, 0.5, 0.9999998807907104], channels = 1, frames = 3 },
            { bytes = wavFile (1, 1, 192000, 32, [0, 0, 0, 128, 255, 255, 255, 127]), want = [-1.0, 0.9999999995343387], channels = 1, frames = 2 }, { bytes = wavFile (3, 2, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 191, 0, 0, 128, 191, 0, 0, 128, 63]), want = [0.25, 0.0], channels = 2, frames = 2 },
            { bytes = wavFile (1, 2, 48000, 16, [0, 64, 0, 192, 255, 127, 0, 128]), want = [0.0, -0.0000152587890625], channels = 2, frames = 2 }],
            \held => succeeds (WaveImport::decode held.bytes, \wave =>
                succeeds (SampleResources::fromWave ("decoded", 60.0, wave), \resource => succeeds (SampleResources::mono resource, \mono => sameSamples (mono, held.want)))
                expect (wave.channels, held.channels)
                expect (wave.frames, held.frames)
                expect (wave.sampleRate > 0, true)
                expect (length wave.samples == satMul wave.frames wave.channels, true)))
        // An 18-byte format extension, a metadata chunk and odd-body padding all survive.
        succeeds (WaveImport::decode (wavPack [wavChunk ("fmt ", listConcat (wavStdBody ()) (wavWord16 0)), wavChunk ("LIST", [9, 8, 7]), wavMonoData ()]), \wave => sameSamples (wave.samples, [0.5, -1.0]))))
    test ("WAV import refuses corrupt sizes, headers, chunks, formats and out-of-range samples", \() => arithmetic (\() =>
        fmt = wavMonoFmt ()
        data = wavMonoData ()
        standard = wavStdBody ()
        forEachList ([{ why = "WAV file size must be between 12 bytes and 8 MiB.", bad = [[], wavText "RIFF"] }, { why = "Expected a complete little-endian RIFF/WAVE file.", bad = [wavJoin [wavText "RIFX", wavWord32 4, wavText "WAVE"], wavJoin [wavText "RIFF", wavWord32 4, wavText "WAVX"], wavJoin [wavText "RIFF", wavWord32 99, wavText "WAVE"]] },
            { why = "WAV input contains a value outside the byte range.", bad = [wavJoin [[999, 73, 70, 70], wavWord32 4, wavText "WAVE"], wavJoin [[-1, 73, 70, 70], wavWord32 4, wavText "WAVE"], listConcat (wavHeader 12) [999, 85, 78, 75, 4, 0, 0, 0]] },
            { why = "Truncated WAV chunk header or too many chunks (limit 1024).", bad = [listConcat (wavHeader 10) [74, 85, 78, 75, 0, 0], wavPack (mapList (toList (range (0, 1025)), \_ => wavChunk ("LIST", [])))] }, { why = "Truncated WAV chunk body or padding.", bad = [wavPack [fmt, wavJoin [wavText "data", wavWord32 100]], wavPack [fmt, wavUnpadded ("LIST", [1, 2, 3])]] },
            { why = "Duplicate or short WAV format chunk.", bad = [wavPack [fmt, fmt, data], wavPack [wavChunk ("fmt ", wavJoin [wavWord16 1, wavWord16 1, wavWord32 48000, wavWord32 96000, wavWord16 2, [16]]), data]] }, { why = "Duplicate WAV data chunk.", bad = [wavPack [fmt, data, data]] }, { why = "WAV requires one format chunk and one data chunk.", bad = [wavPack [fmt], wavPack [data]] },
            { why = "Truncated WAV format extension.", bad = [wavPack [wavChunk ("fmt ", listAppend (standard, 0)), data]] },
            { why = "Extended WAV formats are not supported by this importer.", bad = [wavPack [wavChunk ("fmt ", listConcat (standard, wavWord16 2)), data], wavPack [wavChunk ("fmt ", listConcat (standard, listAppend (wavWord16 0, 0))), data], wavPack [wavChunk ("fmt ", listConcat (standard, listAppend (wavWord16 2, 0))), data]] },
            { why = "WAV requires 2–1048576 complete sample frames.", bad = [wavFile (1, 1, 48000, 16, [0, 64]), wavFile (1, 1, 48000, 16, [0, 64, 0, 128, 0])] },
            { why = "WAV samples must be finite and within [-1, 1].", bad = [wavFile (3, 1, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 64]), wavFile (3, 1, 48000, 32, [0, 0, 128, 63, 0, 0, 192, 127]), wavFile (3, 2, 48000, 32, [0, 0, 128, 63, 0, 0, 0, 64, 0, 0, 128, 63, 0, 0, 0, 64])] }],
            \held => forEachList (held.bad, \bad => refusedWith (WaveImport::decode bad, held.why)))
        // Unsupported encodings and widths, three channels, rates outside 8–192 kHz, misaligned frames, wrong byte rate.
        forEachList ([wavFormatBody (1, 1, 48000, 1, 48000, 12), wavFormatBody (2, 1, 48000, 2, 96000, 16), wavFormatBody (3, 1, 48000, 2, 96000, 16), wavFormatBody (1, 3, 48000, 6, 288000, 16), wavFormatBody (1, 1, 7999, 2, 15998, 16), wavFormatBody (1, 1, 192001, 2, 384002, 16), wavFormatBody (1, 1, 48000, 3, 96000, 16), wavFormatBody (1, 1, 48000, 2, 48000, 16)],
            \body => refusedWith (WaveImport::decode (wavPack [wavChunk ("fmt ", body), wavMonoData ()]), "WAV requires PCM 8/16/24/32 or float32, mono/stereo, 8–192 kHz and consistent frame/byte rates."))))
    test ("sample resources validate metadata, prepare grains and transpose by root pitch", \() => arithmetic (\() =>
        kit = synth::SampleResource(name = "loop", sampleRate = 48000, sourceChannels = 2, rootFrequency = 261.6255653005986, samples = [0.5, -0.5, 0.25, -0.25])
        longName = join (mapList (toList (range (0, 256)), \_ => "x")) ""
        forEachList ([{ r = kit, want = true }, { r = kit(name = "x"), want = true }, { r = kit(name = longName), want = true }, { r = kit(sampleRate = 8000), want = true }, { r = kit(sampleRate = 192000), want = true },
            { r = kit(sourceChannels = 1), want = true }, { r = kit(rootFrequency = 1.0), want = true }, { r = kit(rootFrequency = 20000.0), want = true }, { r = kit(name = ""), want = false },
            { r = kit(name = join (mapList (toList (range (0, 257)), \_ => "x")) ""), want = false }, { r = kit(sampleRate = 7999), want = false }, { r = kit(sampleRate = 192001), want = false },
            { r = kit(sourceChannels = 0), want = false }, { r = kit(sourceChannels = 3), want = false }, { r = kit(rootFrequency = 0.99), want = false }, { r = kit(rootFrequency = 20000.1), want = false }],
            \held => expect (SampleResources::metadata held.r, held.want))
        succeeds (SampleResources::prepare kit, \prepared => expect (structuralEquals prepared kit, true))
        // kit(samples=...) variants fail inside grain preparation; the last fails metadata first.
        forEachList ([kit(samples = []), kit(samples = [0.5]), kit(samples = [0.5, 1.5])], \bad => refusedWith (SampleResources::prepare bad, "Grains require 2–1048576 finite normalised mono samples and capacity 1–256."))
        refusedWith (SampleResources::prepare (kit(sampleRate = 192001)), "Invalid sample resource name, sample rate, source channels or root frequency.")
        wave = synth::WaveSamples(sampleRate = 48000, channels = 2, frames = 2, samples = [0.25, -0.25, 0.75, -0.75])
        succeeds (SampleResources::fromWave ("loop", 60.0, wave), \resource =>
            expect (resource.name, "loop")
            expect (resource.sampleRate, 48000)
            expect (resource.sourceChannels, 2)
            near (resource.rootFrequency, 261.6255653005986, 0.000000001)
            sameSamples (resource.samples, [0.25, -0.25, 0.75, -0.75]))
        forEachList ([-0.5, 127.5], \root => refusedWith (SampleResources::fromWave ("loop", root, wave), "Invalid sample root pitch or decoded frame count."))
        forEachList ([{ bad = wave(frames = 3), why = "Invalid sample root pitch or decoded frame count." }, { bad = wave(samples = [2.0, -2.0, 0.25, -0.25]), why = "Grains require 2–1048576 finite normalised mono samples and capacity 1–256." }, { bad = wave(channels = 3), why = "Invalid sample resource name, sample rate, source channels or root frequency." }], \c => refusedWith (SampleResources::fromWave ("loop", 60.0, c.bad), c.why))
        succeeds (SampleResources::decodeWave ("loop", 60.0, wavFile (1, 1, 48000, 16, [0, 64, 0, 128])), \resource => sameSamples (resource.samples, [0.5, -1.0]))
        refusedAs (SampleResources::decodeWave ("loop", 60.0, wavText "RIFF"), "resource", "WAV file size must be between 12 bytes and 8 MiB.")
        succeeds (SampleResources::fromWave ("loop", 60.0, wave), \tuned =>
            forEachList ([{ note = 60.0, rate = 48000.0, want = 1.0 }, { note = 72.0, rate = 48000.0, want = 2.0 }, { note = 48.0, rate = 96000.0, want = 0.25 }, { note = 60.0, rate = 44100.0, want = 1.08843537414966 }],
                \held => succeeds (SampleResources::playbackRate (tuned, held.note, held.rate), \speed => near (speed, held.want, 0.000000001)))
            forEachList ([-1.0, 128.0], \note => refusedWith (SampleResources::playbackRate (tuned, note, 48000.0), "Invalid sample pitch or output rate."))
            forEachList ([7999.0, 384001.0], \rate => refusedWith (SampleResources::playbackRate (tuned, 60.0, rate), "Invalid sample pitch or output rate."))
            expect (SampleResources::metadata kit, true))
        refusedWith (SampleResources::playbackRate (kit(sampleRate = 192001), 60.0, 48000.0), "Invalid sample pitch or output rate.")
        succeeds (SampleResources::fromWave ("sub", 0.0, wave), \low => refusedAs (SampleResources::playbackRate (low, 127.0, 48000.0), "capacity", "The requested sample transposition exceeds the grain rate limit."))))
