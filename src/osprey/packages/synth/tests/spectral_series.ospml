import synth::SpectralFrames
import synth::SpectralStreams
import synth::Activities

// [SYNTH-ADVANCED-SPECTRAL-MODULES] A 64-point frame at 8 kHz has 125 Hz between bins.
seriesBin (at, i) = match i == at
    true => synth::Complex(re = 2.0, im = -1.0)
    false => synth::Complex(re = 0.0, im = 0.0)

seriesImpulse (at, indices) = mapList (indices, \i => seriesBin (at, i))

seriesOrderJourney () =
    indices = toList (range (0, 33))
    bins = seriesImpulse (2, indices)
    band = synth::SpectralBand(low = 250.0, high = 375.0)
    shift = synth::SpectralShift(bins = 3)
    config = synth::SpectralConfig(sampleRate = 8000.0, size = 64, hop = 16, transform = synth::SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    forEachList ([{ steps = [band, shift], at = 5 }, { steps = [shift, band], at = -1 }, { steps = [band, synth::SpectralShift(bins = -1)], at = 1 }], \row =>
        succeeds (SpectralFrames::apply (config(transform = synth::SpectralSeries(steps = row.steps)), bins, bins, held), \frame =>
            expect (structuralEquals (frame.bins, seriesImpulse (row.at, indices)), true)
            expect (structuralEquals (frame.memory, held.memory), true)))
    forEachList ([[], [synth::SpectralFreeze(held = true)], mapList (toList (range (0, 9)), \_ => band)], \steps =>
        refusedAs (SpectralFrames::apply (config(transform = synth::SpectralSeries(steps = steps)), bins, bins, held), "configuration", "A spectral series accepts 1-8 band, shift or morph steps only."))
    voices = { main = centerImpulse, side = \_ => 0.0 }
    morph = synth::SpectralMorph(amount = 1.0, mode = synth::Blend)
    forEachList ([band, morph], \step =>
        succeeds (spectralFor (config(transform = step), voices, 128), \direct =>
            succeeds (spectralFor (config(transform = synth::SpectralSeries(steps = [step])), voices, 128), \series =>
                expect (structuralEquals (direct.samples, series.samples), true))))

// A centered impulse has unit Hann weight and alternating real Fourier coefficients.
centerImpulse i = match i == 32
    true => 1.0
    false => 0.0

inspectionJourney () =
    config = synth::SpectralConfig(sampleRate = 8000.0, size = 64, hop = 16, transform = synth::SpectralPass, mix = 1.0)
    blank = SpectralStreams::initial config
    quiet = Activities::spectral blank
    expect (quiet.active, 0)
    expect (quiet.capacity, 33)
    expect (quiet.held, false)
    expect (quiet.energy, 0.0)
    frozen = config(transform = synth::SpectralFreeze(held = true))
    succeeds (spectralFor (frozen, { main = \_ => 0.0, side = \_ => 0.0 }, 2 * config.hop), \rendered =>
        captured = Activities::spectral rendered.held
        expect (captured.active, 2)
        expect (captured.held, true)
        expect (captured.energy, 0.0))
    succeeds (spectralFor (frozen, { main = \_ => 1.0, side = \_ => 0.5 }, 17), \before =>
        jumped = SpectralStreams::relocated (frozen, before.held)
        expect (structuralEquals (jumped.input, blank.input), true)
        expect (structuralEquals (jumped.side, blank.side), true)
        expect (structuralEquals (jumped.output, before.held.output), true)
        expect (structuralEquals (jumped.memory, before.held.memory), true)
        expect (structuralEquals (jumped.motion, before.held.motion), true)
        expect (jumped.countdown, config.hop)
        expect (jumped.captured, true))
    input = mapList (toList (range (0, 64)), centerImpulse)
    succeeds (SpectralStreams::view (config, blank(input = input), 2, 1984), \view =>
        expect (view.channel, 2)
        expect (view.position, 1984)
        expect (view.size, 64)
        expect (length view.bins, 33)
        forEachList (view.bins, \bin =>
            near (bin.frequency, toFloat bin.index * 125.0, 0.0)
            near (bin.magnitude, 1.0, 0.000000001)
            near (bin.re, cos (3.141592653589793 * toFloat bin.index), 0.000000001)
            near (bin.im, 0.0, 0.000000001)))
