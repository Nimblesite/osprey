import synth::SpectralFrames
import synth::SpectralStreams

// [SYNTH-ADVANCED-SPECTRAL-MODULES] A 64-point frame at 8 kHz has 125 Hz between bins.
seriesBin (at, i) = match i == at
    true => synth::Complex(re = 2.0, im = -1.0)
    false => synth::Complex(re = 0.0, im = 0.0)

seriesImpulse (at, indices) = mapList (indices, \i => seriesBin (at, i))

seriesOrderJourney () =
    indices = toList (range (0, 33))
    bins = seriesImpulse (2, indices)
    band = synth::SpectralBand(low = 250.0, high = 375.0)
    shift = synth::SpectralShift(bins = 3)
    config = synth::SpectralConfig(sampleRate = 8000.0, size = 64, hop = 16, transform = synth::SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    forEachList ([{ steps = [band, shift], at = 5 }, { steps = [shift, band], at = -1 }, { steps = [band, synth::SpectralShift(bins = -1)], at = 1 }], \row =>
        succeeds (SpectralFrames::apply (config(transform = synth::SpectralSeries(steps = row.steps)), bins, bins, held), \frame =>
            expect (structuralEquals (frame.bins, seriesImpulse (row.at, indices)), true)
            expect (structuralEquals (frame.memory, held.memory), true)))
    forEachList ([[], [synth::SpectralFreeze(held = true)], mapList (toList (range (0, 9)), \_ => band)], \steps =>
        refusedAs (SpectralFrames::apply (config(transform = synth::SpectralSeries(steps = steps)), bins, bins, held), "configuration", "A spectral series accepts 1-8 band, shift or morph steps only."))
