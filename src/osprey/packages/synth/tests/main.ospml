// [SYNTH-PCM-FLOAT] Independent character search checks every ASCII decoder boundary.
hexDigitCase code =
    character = fromCodePoint code ?: "invalid"
    match indexOf "0123456789ABCDEF" character
        Error _ => renderRefused (synth::PcmWords::read32 ("0${character}000000", 0))
        Success digit => match synth::PcmWords::read32 ("0${character}000000", 0)
            Error _ => unexpected ()
            Success word => expect (word, digit)

arithmetic work =
    handle Arith
        overflow _ _ _ wrapped =>
            expect ("overflow", "valid arithmetic")
            wrapped
        divideByZero _ _ =>
            expect ("division by zero", "valid arithmetic")
            0.0
        remainderByZero _ =>
            expect ("remainder by zero", "valid arithmetic")
            0
    work ()

import synth::Graphs
import synth::Observations
import synth::Voice

accepted outcome = match outcome
    synth::Valid graph => graph
    synth::Invalid _ =>
        expect (false, true)
        Graphs::empty

refused (outcome, expected) = match outcome
    synth::Invalid actual => expect (actual == expected, true)
    synth::Valid _ => unexpected ()

monoPort (name, rate, unit) = synth::Port(name = name, rate = rate, channels = 1, unit = unit)

audio = monoPort ("audio", synth::Audio, synth::Amplitude)

control = monoPort ("pitch", synth::Control, synth::Hertz)

missingPort () = synth::Port(name = "missing", rate = synth::Audio, channels = 0, unit = synth::Amplitude)

node (identity, processor, inputs, outputs) = synth::Node(identity = identity, processor = processor, inputs = inputs, outputs = outputs, parameters = [])

cable (source, destination) = synth::Cable(source = source, outlet = 0, destination = destination, inlet = 0)

// Rewiring whatever 1->2->3 chain onto the direct 1->3 cable.
bypass (graph) = accepted (Graphs::rewire (graph, cable (1, 3)))

valid (outcome, check) = match outcome
    synth::Valid value => check value
    synth::Invalid _ => unexpected ()

prepared (graph, count) = valid (Graphs::prepare graph, \plan => expect (length plan.order, count))

test ("route oscillator through gain to output, reject bad wiring and preserve the original patch", \() => arithmetic (\() =>
    source = node (1, synth::Oscillator, [control], [audio])
    nodes = added ([source, node (2, synth::Amplifier, [audio], [audio]), node (3, synth::Sink, [audio], [])], Graphs::empty)
    chain = wired (chainRoute (), nodes)
    prepared (chain, 3)
    expect (length nodes.cables, 0)
    refused (Graphs::add (chain, source), synth::DuplicateNode)
    bad = cable (1, 2)
    forEachList ([{ bad = cable (1, 3), why = synth::OccupiedInput }, { bad = cable (99, 2), why = synth::MissingNode }, { bad = cable (2, 1), why = synth::IncompatiblePorts }, { bad = bad(outlet = 7), why = synth::InvalidPort }], \r => refused (Graphs::connect (chain, r.bad), r.why))
    refused (Graphs::add (chain, node (4, synth::Delay(samples = 0), [audio], [audio])), synth::InvalidNode)
    corrupted = chain(nodes = listAppend chain.nodes source)
    refused (Graphs::prepare corrupted, synth::DuplicateNode)))

test ("feedback needs a delay; disconnected components and fan-out have deterministic scheduling", \() => arithmetic (\() =>
    a = node (1, synth::Amplifier, [audio], [audio])
    b = node (2, synth::Filter, [audio], [audio])
    graph = added ([a, b], Graphs::empty)
    looped = wired ([cable (1, 2), cable (2, 1)], graph)
    refused (Graphs::prepare looped, synth::Cycle)
    delayed = looped(nodes = [a, b(processor = synth::Delay(samples = 1))])
    valid (Graphs::prepare delayed, \plan =>
        expect (listGet plan.order 0 ?: -1, 2)
        expect (listGet plan.order 1 ?: -1, 1)
        expect (length plan.feedback, 1))
    prepared (graph, 2)))

observed snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    expect (Observations::parameter (10, "cutoff") ?: -1.0, 440.0)
    expect (Observations::parameter (20, "cutoff") ?: -1.0, 880.0)
    succeeds (Observations::component 10, \component => expect (component.activeVoices, 3))
    renderRefused (Observations::component 99)
    renderRefused (Observations::parameter (30, "cutoff"))

test ("Signals expose separate same-kind component instances without a UI framework", \() => arithmetic (\() =>
    snapshot = synth::Observation(revision = 4, samplePosition = 1024, parameters = [synth::ParameterValue(node = 10, key = "cutoff", value = 440.0), synth::ParameterValue(node = 20, key = "cutoff", value = 880.0)], components = [synth::ComponentState(node = 10, activeVoices = 3, peak = 0.8, rms = 0.2)])
    observed snapshot))

// [SYNTH-DSP] Numerical isolation is required: these paths must not need a host, UI or device.
import synth::Oscillators
import synth::Envelopes
import synth::Filters

near (actual, expected, tolerance) = expect (abs (actual - expected) <= tolerance, true)

unexpected () = expect (false, true)

oscillator (rate, frequency, waveform) = synth::OscillatorConfig(sampleRate = rate, frequency = frequency, pulseWidth = 0.5, waveform = waveform)

sampleAt (config, phase) = (Oscillators::next (config, synth::OscillatorState(phase = phase))).sample

oscRun (config, initialState, count) = foldList (toList (range (0, count)), initialState, \(held, _) => (Oscillators::next (config, held)).next)

oscCase (rate, frequency, waveform) =
    config = oscillator (rate, frequency, waveform)
    succeeds (Oscillators::configure config, \accepted =>
        whole = oscRun (accepted, Oscillators::initial, 512)
        split = oscRun (accepted, oscRun (accepted, Oscillators::initial, 31), 481)
        near (whole.phase, split.phase, 0.000000000001)
        forEachList (toList (range (0, 128)), \i =>
            value = (Oscillators::next (accepted, synth::OscillatorState(phase = toFloat i / 128.0))).sample
            expect (value >= -1.01 && value <= 1.01, true)))

invalidOscillator config = renderRefused (Oscillators::configure config)

validEnvelope config = succeeds (Envelopes::configure config, \_ => expect (true, true))

invalidEnvelope config = renderRefused (Envelopes::configure config)

invalidFilter config = renderRefused (Filters::configure config)

oscFrequencies rate = forEachList ([0.0, 55.0, 440.0, 7000.0], \frequency => forEachList ([synth::Sine, synth::Saw, synth::Pulse, synth::Triangle], \wave => oscCase (rate, frequency, wave)))

test ("oscillator state survives arbitrary block partitions at three rates and four waveforms", \() => arithmetic (\() =>
    forEachList ([44100.0, 48000.0, 96000.0], oscFrequencies)
    triangle = oscillator (48000.0, 440.0, synth::Triangle)
    sine = oscillator (48000.0, 440.0, synth::Sine)
    near (sampleAt (triangle, 0.25), 0.0, 0.000000001)
    expect (sampleAt (triangle, 0.5) > 0.98, true)
    near (sampleAt (sine, 0.25), 1.0, 0.000000000001)
    forEachList ([sine(sampleRate = 0.0), sine(frequency = -1.0), sine(frequency = 24000.0), sine(pulseWidth = 0.0), sine(pulseWidth = 1.0)], invalidOscillator)))

envRun (config, initialState, count) = foldList (toList (range (0, count)), initialState, \(held, _) => Envelopes::next (config, held))

levelOf (envelope) = envelope.level

envelopeCase rate =
    config = synth::EnvelopeConfig(sampleRate = rate, attack = 4.0 / rate, decay = 4.0 / rate, sustain = 0.5, release = 4.0 / rate)
    started = Envelopes::noteOn (Envelopes::initial ())
    attack = envRun (config, started, 4)
    sustain = envRun (config, attack, 4)
    near (attack.level, 1.0, 0.000000001)
    near (sustain.level, 0.5, 0.000000001)
    near (levelOf (Envelopes::next (config, sustain)), 0.5, 0.000000001)
    releasing = Envelopes::noteOff (config, sustain)
    near ((envRun (config, releasing, 4)).level, 0.0, 0.000000001)
    near ((Envelopes::noteOff (config, releasing)).releaseStep, releasing.releaseStep, 0.0)
    early = envRun (config, started, 2)
    near ((Envelopes::noteOn early).level, early.level, 0.0)
    near ((envRun (config, Envelopes::noteOff (config, early), 4)).level, 0.0, 0.000000001)

test ("ADSR reaches its stages, releases during attack, retriggers continuously and handles zero times", \() => arithmetic (\() =>
    forEachList ([44100.0, 48000.0, 96000.0], envelopeCase)
    instant = synth::EnvelopeConfig(sampleRate = 48000.0, attack = 0.0, decay = 0.0, sustain = 0.7, release = 0.0)
    attack = Envelopes::next (instant, Envelopes::noteOn (Envelopes::initial ()))
    near (attack.level, 1.0, 0.0)
    forEachList ([{ env = Envelopes::next (instant, attack), want = 0.7 }, { env = Envelopes::noteOff (instant, attack), want = 0.0 }], \r => near (levelOf r.env, r.want, 0.0))
    forEachList ([instant, instant(attack = 0.2)], validEnvelope)
    forEachList ([instant(sustain = -0.1), instant(sustain = 1.1), instant(attack = -1.0), instant(release = 4000.0), instant(sampleRate = 0.0)], invalidEnvelope)))

filterRun (coefficients, initialState, count, input) = foldList (toList (range (0, count)), initialState, \(held, _) => (Filters::next (coefficients, held, input)).next)

filterCase (rate, cutoff, resonance) =
    config = synth::FilterConfig(sampleRate = rate, cutoff = cutoff, resonance = resonance)
    succeeds (Filters::configure config, \c =>
        settled = filterRun (c, Filters::initial, 4096, 1.0)
        output = Filters::next (c, settled, 1.0)
        near (output.low, 1.0, 0.0001)
        near (output.high, 0.0, 0.0001)
        split = filterRun (c, filterRun (c, Filters::initial, 127, 1.0), 3969, 1.0)
        near (settled.integratorOne, split.integratorOne, 0.0)
        near (settled.integratorTwo, split.integratorTwo, 0.0)
        faded = filterRun (c, settled, 4096, 0.0)
        near (faded.integratorTwo, 0.0, 0.0001))

test ("state-variable filter preserves blocks, passes DC, rejects DC high-pass and decays after excitation", \() => arithmetic (\() =>
    forEachList ([44100.0, 48000.0, 96000.0], \rate => forEachList ([1000.0, 5000.0, 18000.0], \cutoff => filterCase (rate, cutoff, 0.7071067811865476)))
    base = synth::FilterConfig(sampleRate = 48000.0, cutoff = 1000.0, resonance = 0.7)
    forEachList ([base(cutoff = 0.0), base(cutoff = 24000.0), base(resonance = 0.0), base(resonance = 21.0), base(sampleRate = 0.0)], invalidFilter)))

import synth::Parameters

parameter key = synth::Parameter(key = key, label = "Cutoff", unit = synth::Hertz, minimum = 20.0, maximum = 20000.0, initial = 440.0, automatable = true)

readValue snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    Observations::parameter (1, "cutoff") ?: -1.0

test ("parameter edits publish applied Signals, reject stale revisions, and preserve independent values", \() => arithmetic (\() =>
    blank = node (1, synth::Filter, [audio], [audio])
    component = blank(parameters = [parameter "cutoff"])
    graph = accepted (Graphs::add (Graphs::empty, component))
    initial = Parameters::initial graph
    expect (readValue initial, 440.0)
    edit = synth::ParameterChange(node = 1, key = "cutoff", value = 880.0, revision = 0, samplePosition = 0)
    valid (Parameters::apply (graph, initial, edit), \next =>
        expect (readValue next, 880.0)
        expect (readValue initial, 440.0)
        expect (next.revision, 1)
        refused (Parameters::apply (graph, next, edit), synth::StaleRevision))
    refused (Parameters::apply (graph, initial, edit(value = 0.0)), synth::InvalidParameter)
    refused (Parameters::apply (graph, initial, edit(samplePosition = 1)), synth::InvalidFrame)
    refused (Parameters::apply (graph, initial, edit(key = "missing")), synth::MissingParameter)
    refused (Parameters::apply (graph, initial, edit(node = 9)), synth::MissingNode)
    refused (Parameters::apply (graph, initial(parameters = []), edit), synth::MissingParameter)))

test ("graph validation covers corrupt persisted metadata, missing endpoints, fan-out and explicit channel adapters", \() => arithmetic (\() =>
    source = node (1, synth::Oscillator, [], [audio])
    output = node (2, synth::Sink, [audio], [])
    graph = added ([source, output], Graphs::empty)
    third = added ([output(identity = 3)], graph)
    fan = wired ([cable (1, 2), cable (1, 3)], third)
    prepared (fan, 3)
    invalidInlet = cable (1, 2)
    forEachList ([{ bad = cable (1, 99), why = synth::MissingNode }, { bad = invalidInlet(inlet = 9), why = synth::InvalidPort }], \r => refused (Graphs::connect (graph, r.bad), r.why))
    refused (Graphs::prepare (graph(cables = [cable (1, 99)])), synth::MissingNode)
    invalidParameter = parameter "cutoff"
    forEachList ([{ bad = source(identity = -1), why = synth::InvalidNode }, { bad = source(outputs = [audio(channels = 0)]), why = synth::InvalidNode }, { bad = source(processor = synth::External(identifier = "")), why = synth::InvalidNode }, { bad = source(parameters = [parameter "cutoff", parameter "cutoff"]), why = synth::DuplicateParameter }, { bad = source(parameters = [invalidParameter(initial = -1.0)]), why = synth::InvalidParameter }], \r => refused (Graphs::add (Graphs::empty, r.bad), r.why))
    stereo = graph(nodes = [source, output(inputs = [audio(channels = 2)])])
    refused (Graphs::connect (stereo, cable (1, 2)), synth::IncompatiblePorts)
    tooMany = graph(nodes = mapList (toList (range (0, 256)), \identity => source(identity = identity)))
    refused (Graphs::add (tooMany, source(identity = 300)), synth::Capacity)
    crowded = graph(cables = mapList (toList (range (0, 2048)), \_ => cable (1, 2)))
    refused (Graphs::connect (crowded, cable (1, 2)), synth::Capacity)))

// The extracted reference voice is also exercised independently of Prism's UI dependencies.
referencePatch wave = synth::Patch(pitch = 220.0, sounding = true, filtered = true, wave = wave, cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.75)

referenceCase wave =
    p = referencePatch wave
    samples = Voice::samples p
    expect (length samples, Voice::rate)
    expect (Voice::peak samples > 0, true)
    expect (startsWith (Voice::wav samples) "52494646", true)
    forEachList ([p(sounding = false), p(audible = false), p(volume = 0.0)], \silent => near (Voice::sample (silent, 5), 0.0, 0.0))
    expect (Voice::describe p != Voice::describe (p(filtered = false)), true)
    expect (Voice::sample (p(filtered = false), 5) != Voice::sample (p, 5), true)

test ("extracted Prism synthesis has no UI dependency and retains pitch, wave, silence and WAV behaviour", \() => arithmetic (\() =>
    // [SYNTH-PCM-FLOAT] The RIFF size includes word padding; the data size counts only actual samples.
    forEachList ([{ values = [0, 128, 255], riff = "28000000", data = "030000000080FF00" }, { values = [0, 128], riff = "26000000", data = "020000000080" }, { values = [255], riff = "26000000", data = "01000000FF00" }, { values = [], riff = "24000000", data = "00000000" }], \c =>
        encoded = synth::WaveFiles::mono8 (8000, c.values)
        expect (take (drop encoded 8) 8, c.riff)
        expect (drop encoded 80, c.data))
    forEachList (["Sine", "Saw", "Square", "Triangle"], referenceCase)
    forEachList (["C3", "D3", "E3", "F3", "G3", "A3", "B3", "C#4"], \note => expect (Voice::frequency note > 100.0, true))
    near (Voice::frequency "A4", 440.0, 0.00000001)
    forEachList (["1/1", "1/2", "1/4", "1/8", "1/16"], \rate => expect (Voice::hertz rate > 0.0, true))
    near ((Envelopes::next (synth::EnvelopeConfig(sampleRate = 48000.0, attack = 0.0, decay = 0.0, sustain = 0.5, release = 0.0), Envelopes::initial ())).level, 0.0, 0.0)))

import synth::Components
import synth::Renderer
import synth::Repatch

planFor graph = match Graphs::prepare graph
    synth::Valid plan => plan
    synth::Invalid _ =>
        expect (false, true)
        synth::Prepared(graph = Graphs::empty, order = [], feedback = [])

rendered result = match result
    Success block => block
    Error why =>
        print why
        expect (false, true)
        synth::Rendered(states = [], samples = [], position = 0, meters = [])

renderRefused result = match result
    Success _ => unexpected ()
    Error _ => expect (true, true)

// [SYNTH-RENDER-BLOCKS] The switches the editor stores on a module, as one more parameter.
switched (n, key, high, value) = n(parameters = listAppend n.parameters (synth::Parameter(key = key, label = key, unit = synth::Ratio, minimum = 0.0, maximum = high, initial = value, automatable = true)))

disabled (n) = switched (n, "enabled", 1.0, 0.0)

// One 64-frame offline clip of `graph`'s output node 3.
clipOf graph = match synth::GraphClips::advance (graph, [], 64)
    Success action => clipReady3 action
    Error why => Error(message = why)

clipReady3 action = match action
    synth::ClipWaiting _ _ _ => Error(message = "A built-in graph asked for a plug-in.")
    synth::ClipReady clips => synth::ClipInputs::completed (clips, 3)

// A sine through a low-pass whose cutoff inlet an LFO drives.
switchedRender (oscillator, filter, lfo) = clipOf (built ([oscillator, filter, lfo, Components::output 3], [cable (1, 2), Components::route (4, 0, 2, 1), cable (2, 3)]))

clipSamples outcome = match outcome
    Success clip => clip.clipSamples
    Error why =>
        expect (why, "a rendered clip")
        []

switchedSamples (oscillator, filter, lfo) = clipSamples (switchedRender (oscillator, filter, lfo))

plainLowpass () = clipSamples (clipOf (sineFiltered (1000.0, 0.7)))

test ("module switches pick the waveform, bypass a module and modulate the filter cutoff", \() => arithmetic (\() =>
    sine = Components::sine (1, 440.0)
    filter = Components::modulatedLowpass (2, 1000.0, 0.7)
    lfo = Components::lfo (4, 2.0)
    shapes = mapList ([0.0, 1.0, 2.0, 3.0], \wave => switchedSamples (switched (sine, "waveform", 4.0, wave), filter, lfo))
    forEachList (shapes, \samples => expect (length samples, 64))
    expect (length (filterList (toList (range (1, 4)), \i => structuralEquals (listGet shapes i ?: [], listGet shapes 0 ?: []))), 0)
    renderRefused (switchedRender (switched (sine, "waveform", 4.0, 4.0), filter, lfo))
    modulated = switchedSamples (sine, filter, lfo)
    expect (structuralEquals (modulated, plainLowpass ()), false)
    expect (structuralEquals (switchedSamples (sine, filter, disabled lfo), plainLowpass ()), true)
    forEachList (toList (range (0, 64)), \i => near (listGet (switchedSamples (sine, disabled filter, lfo)) i ?: 9.0, sin (6.283185307179586 * 440.0 * toFloat i / 48000.0), 0.00000000001))
    expect (structuralEquals (switchedSamples (sine, switched (filter, "enabled", 1.0, 1.0), lfo), modulated), true)
    expect (structuralEquals (switchedSamples (disabled sine, filter, lfo), mapList (modulated, \_ => 0.0)), true)
    renderRefused (switchedRender (sine, switched (filter, "enabled", 2.0, 2.0), lfo))))

built (nodes, cables) = wired (cables, added (nodes, Graphs::empty))

added (nodes, graph) = foldList (nodes, graph, \(g, n) => accepted (Graphs::add (g, n)))

wired (cables, graph) = foldList (cables, graph, \(g, c) => accepted (Graphs::connect (g, c)))

// The usual oscillator-to-output route 1 -> 2 -> 3.
chainRoute () = [cable (1, 2), cable (2, 3)]

serial (nodes) = built (nodes, chainRoute ())

sineThrough (gain) = serial ([Components::sine (1, 440.0), Components::gain (2, gain), Components::output 3])

sineFiltered (cutoff, resonance) = serial ([Components::sine (1, 440.0), Components::lowpass (2, cutoff, resonance), Components::output 3])

sineChain () = sineThrough (0.25)

blockOf (graph, frames) = rendered (Renderer::block (planFor graph, 48000.0, Parameters::initial graph, rendered (Renderer::start graph), frames))

renderBlock (plan, parameters, prior, frames) = rendered (Renderer::block (plan, 48000.0, parameters, prior, frames))

running (graph) = { plan = planFor graph, parameters = Parameters::initial graph, start = rendered (Renderer::start graph) }

sameSamples (actual, expected) =
    expect (length actual, length expected)
    forEachList (toList (range (0, length expected)), \i => near (listGet actual i ?: -999.0, listGet expected i ?: -888.0, 0.00000000001))

energetic (samples, count) =
    expect (length samples, count)
    expect (foldList (samples, 0.0, \(sum, value) => sum + abs value) > 1.0, true)

// [SYNTH-ADVANCED-LEARNED] Independent, licensed evaluation data does not influence the fitted gain.
fitGainJourney (graph, samples) =
    source = synth::FitSource(identifier = "sine fixture", licence = "generated fixture", sampleRate = 48000)
    training = synth::FitReference(source = source, samples = samples)
    evaluation = synth::FitReference(source = source(identifier = "silent fixture"), samples = mapList (samples, \_ => 0.0))
    config = synth::FitConfig(parameters = [synth::FitParameter(node = 2, key = "gain", minimum = 0.0, maximum = 1.0)], seed = 17, evaluations = 1, tolerance = 0.0001)
    refusedWith (synth::FitReports::fit (graph, config, training, training), "Training and evaluation need distinct source identities and sample data.")
    succeeds (synth::FitReports::fit (graph, config, training, evaluation), \report =>
        expect (report.result.evaluations == 1 && report.evaluationLoss > report.result.best.loss, true)
        expect (structuralEquals (report.training, training.source) && structuralEquals (report.evaluation, evaluation.source), true)
        expect (structuralEquals (report.config, config), true))

test ("a routed oscillator and gain render exact continuous PCM across unequal blocks", \() => arithmetic (\() =>
    graph = sineChain ()
    kit = running graph
    whole = renderBlock (kit.plan, kit.parameters, kit.start, 128)
    expected = mapList (toList (range (0, 128)), \i => 0.25 * sin (6.283185307179586 * 440.0 * toFloat i / 48000.0))
    first = renderBlock (kit.plan, kit.parameters, kit.start, 31)
    second = renderBlock (kit.plan, kit.parameters, first, 97)
    sameSamples (whole.samples, listConcat first.samples second.samples)
    sameSamples (whole.samples, expected)
    expect (whole.position, 128)
    fitGainJourney (graph, whole.samples)
    metersObserved (Renderer::observed (kit.parameters, whole))
    empty = renderBlock (kit.plan, kit.parameters, whole, 0)
    expect (empty.position, 128)
    expect (length empty.samples, 0)
    renderRefused (Renderer::block (kit.plan, 0.0, kit.parameters, kit.start, 128))
    forEachList ([-1, 8193], \frames => renderRefused (Renderer::block (kit.plan, 48000.0, kit.parameters, kit.start, frames)))
    snapshot = kit.parameters
    renderRefused (Renderer::block (kit.plan, 48000.0, snapshot(parameters = []), kit.start, 1))))

test ("mixing, filtering and explicit two-sample feedback execute the compiled graph", \() => arithmetic (\() =>
    nodes = [Components::sine (1, 440.0), Components::mixer 2, Components::gain (3, 0.5), Components::delay (4, 2), Components::output 5]
    routes = [cable (1, 2), Components::route (4, 0, 2, 1), cable (2, 3), cable (3, 4), cable (3, 5)]
    graph = built (nodes, routes)
    output = blockOf (graph, 64)
    forEachList (toList (range (0, 64)), \i => feedbackExpected (output.samples, i))
    filterGraph = sineFiltered (1000.0, 0.707)
    filtered = blockOf (filterGraph, 64)
    energetic (filtered.samples, 64)
    forEachList ([Graphs::empty, built ([node (1, synth::External(identifier = "future-vst3"), [], [audio]), Components::output 2], [cable (1, 2)]), built ([Components::gain (1, 1.0), Components::output 2], [cable (1, 2)])], \unconnected => renderRefused (Renderer::start unconnected))))

feedbackExpected (samples, i) =
    previous = match i >= 2
        true => listGet samples (satSub i 2) ?: -999.0
        false => 0.0
    expected = 0.5 * (sin (6.283185307179586 * 440.0 * toFloat i / 48000.0) + previous)
    near (listGet samples i ?: -888.0, expected, 0.00000000001)

metersObserved snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    expect ((Observations::snapshot ()).samplePosition, 128)
    succeeds (Observations::component 3, \meter =>
        expect (meter.peak <= 0.25 && meter.peak > 0.24, true)
        expect (meter.rms > 0.1 && meter.rms < 0.25, true))

test ("sample-accurate automation applies before its frame, preserves ordering and rejects stale or out-of-block events", \() => arithmetic (\() =>
    graph = sineThrough (1.0)
    plan = planFor graph
    snapshot = Parameters::initial graph
    first = rendered (Renderer::start graph)
    mute = synth::ParameterChange(node = 2, key = "gain", value = 0.0, revision = 0, samplePosition = 17)
    restore = mute(value = 0.5, revision = 1, samplePosition = 31)
    succeeds (Renderer::automated (plan, 48000.0, snapshot, first, 64, [mute, restore]), \timeline =>
        expect (timeline.observation.revision == 2 && timeline.observation.samplePosition == 64, true)
        forEachList (toList (range (17, 31)), \i => near (listGet timeline.audio.samples i ?: -1.0, 0.0, 0.0))
        forEachList ([{ frame = 16, scale = 1.0 }, { frame = 31, scale = 0.5 }], \r => near (listGet timeline.audio.samples r.frame ?: -1.0, r.scale * sin (6.283185307179586 * 440.0 * toFloat r.frame / 48000.0), 0.00000000001)))
    forEachList ([[restore, mute], [mute(samplePosition = 64)], [mute, restore(revision = 0)]], \events => renderRefused (Renderer::automated (plan, 48000.0, snapshot, first, 64, events)))))

// [SYNTH-ADVANCED-CORE-PORTS] Same-frame events apply in their given order, and any block split gives the same audio.
splitAt (plan, snapshot, first, events, cut) = match Renderer::automated (plan, 48000.0, snapshot, first, cut, filterList (events, \e => e.samplePosition < cut))
    Error why => Error(message = why)
    Success head => synth::Outcomes::carried (Renderer::automated (plan, 48000.0, head.observation, head.audio, satSub 64 cut, filterList (events, \e => e.samplePosition >= cut)), \tail => Success(value = listConcat head.audio.samples tail.audio.samples))

test ("same-frame automation applies in order and every block split renders the same samples", \() => arithmetic (\() =>
    graph = sineThrough (1.0)
    plan = planFor graph
    snapshot = Parameters::initial graph
    first = rendered (Renderer::start graph)
    mute = synth::ParameterChange(node = 2, key = "gain", value = 0.0, revision = 0, samplePosition = 20)
    quiet = mute(value = 0.25, revision = 1)
    full = mute(value = 1.0, revision = 2, samplePosition = 40)
    events = [mute, quiet, full]
    succeeds (Renderer::automated (plan, 48000.0, snapshot, first, 64, events), \whole =>
        expect (length whole.audio.samples, 64)
        expect (whole.observation.revision, 3)
        // Both frame-20 edits land before frame 20; the later one (0.25) is what sounds.
        forEachList ([20, 21, 30, 39], \i => near (listGet whole.audio.samples i ?: -1.0, 0.25 * sin (6.283185307179586 * 440.0 * toFloat i / 48000.0), 0.00000000001))
        forEachList ([0, 19, 40, 63], \i => near (listGet whole.audio.samples i ?: -1.0, sin (6.283185307179586 * 440.0 * toFloat i / 48000.0), 0.00000000001))
        forEachList ([1, 7, 19, 20, 21, 33, 40, 41, 63], \cut => succeeds (splitAt (plan, snapshot, first, events, cut), \pieces => expect (structuralEquals (pieces, whole.audio.samples), true))))
    renderRefused (Renderer::automated (plan, 48000.0, snapshot, first, 64, [quiet, mute]))))

import synth::Performance

performanceCase (rate, instrument, amount) = forEachList (toList (range (0, 128)), \frame =>
    sample = Performance::wave (instrument, toFloat frame * 0.0078125, 740.0 / rate, amount, amount)
    expect (sample >= -1.000001 && sample <= 1.000001, true))

test ("performance timbres and metallic warp stay bounded across rates and control extremes", \() => arithmetic (\() =>
    forEachList ([8000.0, 44100.0, 48000.0, 96000.0], \rate => forEachList ([0, 1, 2, 3], \instrument => forEachList ([0.0, 0.5, 1.0], \amount => performanceCase (rate, instrument, amount))))
    near (Performance::wave (0, 0.25, 0.01, 0.0, 0.0), 1.0, 0.000000001)
    near (Performance::wave (0, 0.25, 0.01, 0.0, 1.0), -1.0, 0.000000001)))

import synth::Kinds

// [SYNTH-GRAPH-CHANNELS] Unlimited-channel journeys: split, join and route carry every channel exactly.
portOf (name, channels) = synth::Port(name = name, rate = synth::Audio, channels = channels, unit = synth::Amplitude)

channelSource (identity, channels) =
    base = Components::additive (identity, 220.0)
    base(outputs = [portOf ("audio", channels)])

sinkOf (identity, channels) =
    base = Components::output identity
    base(inputs = [portOf ("audio", channels)])

scaleOf index = (toFloat index + 1.0) * 0.05

// A distinct-channel chain: `count`-channel source -> split -> one gain per channel -> join.
channelChain (source, split, firstGain, join, count) =
    gains = mapList (toList (range (0, count)), \index => Components::gain (satAdd firstGain index, scaleOf index))
    listAppend (listConcat [channelSource (source, count), Components::split (split, count)] gains) (Components::join (join, count))

channelCables (source, split, firstGain, join, count) =
    fanOut = mapList (toList (range (0, count)), \index => Components::route (split, index, satAdd firstGain index, 0))
    fanIn = mapList (toList (range (0, count)), \index => Components::route (satAdd firstGain index, 0, join, index))
    listConcat (listConcat [cable (source, split)] fanOut) fanIn

clipsOf (graph, frames) = match synth::GraphClips::advance (graph, [], frames)
    Success action => match action
        synth::ClipReady clips => Success(value = clips)
        synth::ClipWaiting _ _ => Error(message = "A built-in graph asked for a plug-in.")
    Error why => Error(message = why)

clipFrom (clips, identity) = match synth::ClipInputs::completed (clips, identity)
    Success clip => clip
    Error why =>
        expect (why, "a rendered node clip")
        synth::NodeClip(clipNode = identity, clipChannels = 0, clipSamples = [], clipNotes = [])

channelOf (clip, frame, channel) = listGet clip.clipSamples (satAdd (satMul frame clip.clipChannels) channel) ?: 999.0

test ("an 8-channel graph splits, joins and route-reorders every 7.1 channel sample-for-sample", \() => arithmetic (\() =>
    frames = toList (range (0, 64))
    channels = toList (range (0, 8))
    succeeds (clipsOf (built (listConcat (channelChain (1, 2, 3, 11, 8)) [Components::routeChannels (12, 8, [7, 6, 5, 4, 3, 2, 1, 0]), sinkOf (13, 8)], listConcat (channelCables (1, 2, 3, 11, 8)) [cable (11, 12), cable (12, 13)]), 64), \clips =>
        source = clipFrom (clips, 1)
        split = clipFrom (clips, 2)
        join = clipFrom (clips, 11)
        route = clipFrom (clips, 12)
        gains = mapList (channels, \index => clipFrom (clips, satAdd 3 index))
        expect (source.clipChannels == 8 && length source.clipSamples == 512, true)
        expect (abs (channelOf (source, 5, 0)) > 0.000001, true)
        expect (split.clipChannels == 8 && structuralEquals (split.clipSamples, source.clipSamples), true)
        // Independent per-channel kernel state renders identical channels from identical parameters.
        forEachList (toList (range (1, 8)), \c => forEachList (frames, \f => expect (channelOf (source, f, c) == channelOf (source, f, 0), true)))
        forEachList (channels, \c =>
            gain = listGet gains c ?: clipFrom (clips, 0)
            expect (gain.clipChannels, 1)
            forEachList (frames, \f => near (channelOf (gain, f, 0), channelOf (source, f, c) * scaleOf c, 0.0)))
        expect (join.clipChannels == 8 && length join.clipSamples == 512, true)
        forEachList (channels, \c => forEachList (frames, \f => near (channelOf (join, f, c), channelOf (listGet gains c ?: clipFrom (clips, 0), f, 0), 0.0)))
        expect (route.clipChannels == 8 && length route.clipSamples == 512, true)
        forEachList (channels, \c => forEachList (frames, \f => near (channelOf (route, f, c), channelOf (listGet gains (satSub 7 c) ?: clipFrom (clips, 0), f, 0), 0.0)))
        sink = clipFrom (clips, 13)
        expect (sink.clipChannels == 8 && structuralEquals (sink.clipSamples, route.clipSamples), true))))

test ("a five-channel graph duplicates, silences and resizes channels through explicit route maps", \() => arithmetic (\() =>
    frames = toList (range (0, 64))
    nodes = listConcat (channelChain (1, 2, 3, 8, 5)) [Components::routeChannels (9, 5, [1, 1, -1, 4, 0, 0]), sinkOf (10, 6)]
    cables = listConcat (channelCables (1, 2, 3, 8, 5)) [cable (8, 9), cable (9, 10)]
    succeeds (clipsOf (built (nodes, cables), 64), \clips =>
        join = clipFrom (clips, 8)
        route = clipFrom (clips, 9)
        expect (join.clipChannels == 5 && length join.clipSamples == 320, true)
        expect (route.clipChannels == 6 && length route.clipSamples == 384, true)
        forEachList (frames, \f =>
            near (channelOf (route, f, 0), channelOf (join, f, 1), 0.0)
            near (channelOf (route, f, 1), channelOf (join, f, 1), 0.0)
            near (channelOf (route, f, 2), 0.0, 0.0)
            near (channelOf (route, f, 3), channelOf (join, f, 4), 0.0)
            near (channelOf (route, f, 4), channelOf (join, f, 0), 0.0)
            near (channelOf (route, f, 5), channelOf (join, f, 0), 0.0))
        forEachList (toList (range (0, 5)), \c => forEachList (frames, \f => near (channelOf (join, f, c), channelOf (clipFrom (clips, satAdd 3 c), f, 0), 0.0))))
    // The same five-channel join shrinks to three: duplicated, duplicated, silenced.
    succeeds (clipsOf (built (listConcat (channelChain (1, 2, 3, 8, 5)) [Components::routeChannels (9, 5, [4, 4, -1]), sinkOf (10, 3)], listConcat (channelCables (1, 2, 3, 8, 5)) [cable (8, 9), cable (9, 10)]), 64), \clips =>
        join = clipFrom (clips, 8)
        route = clipFrom (clips, 9)
        expect (route.clipChannels == 3 && length route.clipSamples == 192, true)
        forEachList (frames, \f =>
            near (channelOf (route, f, 0), channelOf (join, f, 4), 0.0)
            near (channelOf (route, f, 1), channelOf (join, f, 4), 0.0)
            near (channelOf (route, f, 2), 0.0, 0.0)))))

test ("channel maps out of range and mismatched channel cables are refused with typed faults", \() => arithmetic (\() =>
    forEachList ([[0, -2], [0, 5], [0, 1, 9]], \entries => refused (Graphs::add (Graphs::empty, Components::routeChannels (1, 5, entries)), synth::InvalidNode))
    refused (Graphs::add (Graphs::empty, Components::routeChannels (1, 4, [])), synth::InvalidNode)
    prepared (added ([Components::routeChannels (1, 2, [0, 1, -1, 0])], Graphs::empty), 1)
    refused (Graphs::connect (added ([Components::routeChannels (1, 8, [7, 6, 5, 4, 3, 2, 1, 0]), Components::gain (2, 1.0)], Graphs::empty), cable (1, 2)), synth::IncompatiblePorts)
    refused (Graphs::connect (added ([Components::stereo 1, Components::join (2, 2)], Graphs::empty), cable (1, 2)), synth::IncompatiblePorts)
    refused (Graphs::connect (added ([Components::join (1, 4), Components::output 2], Graphs::empty), cable (1, 2)), synth::IncompatiblePorts)
    // Stereo never widens to 5.1 implicitly: without a Route node the cable is refused.
    refused (Graphs::connect (added ([Components::stereo 1, sinkOf (2, 6)], Graphs::empty), cable (1, 2)), synth::IncompatiblePorts)
    expect (Kinds::kind synth::Split, "synth.split")
    expect (Kinds::kind synth::Join, "synth.join")
    expect (Kinds::kind (synth::Route(channelMap = [0, -1])), "synth.route")
    expect ((Kinds::version synth::Split) == 1 && (Kinds::keyFrequency (synth::Route(channelMap = [0]))) == false, true)))

registerHostedJourneys ()
registerWaveJourneys ()
registerClipJourneys ()
registerGrainJourneys ()

// [SYNTH-ADVANCED-CORE-MODELS] A graph output that is NaN, infinite or past 10^6 is an error, never published audio.
refusedOutput value = match synth::RenderInputs::sample (framed value, 4)
    Error why => expect (why, "Non-finite or excessive graph output.")
    Success _ => expect ("published ${value}", "refused")

framed value = synth::SampleFrame(states = [], values = [synth::NodeSample(identity = 4, value = value)])

test ("non-finite or runaway node output is refused, finite output up to the bound is published", \() => arithmetic (\() =>
    forEachList ([sqrt (-1.0), pow (10.0, 400.0), -1.0 * pow (10.0, 400.0), 1000000.5, -2000000.0], refusedOutput)
    forEachList ([0.0, -0.0, 0.5, -1.0, 1000000.0, -1000000.0, 0.000000000001], \value => succeeds (synth::RenderInputs::sample (framed value, 4), \got => expect (got == value, true)))
    renderRefused (synth::RenderInputs::sample (framed 0.5, 5))))

import synth::Descriptors

// [SYNTH-ADVANCED-CORE-PORTS] Every parameter of every component maps a 0–1 control onto its declared range and
// back: 0 is the minimum, 1 the maximum, the round trip returns the control, and the mapping only rises.
adapted () = [Components::sine (1, 440.0), Components::lowpass (2, 1000.0, 0.7), Components::modulatedLowpass (3, 1000.0, 0.7), Components::gain (4, 0.5), Components::delay (5, 480), Components::midiNote (6, 60.0, 0.8, 6000.0), Components::lfo (7, 2.0), Components::modulatedGain (8, 2, 0.5), Components::exciter (9, 1), Components::resonator (10, 440.0), Components::modalBank (11, 220.0, 1.0), Components::waveguide (12, 220.0, 2400), Components::fractionalDelay (13, 4.5, 64), Components::lossFilter (14, 0.99, 0.5), Components::allpass (15, 0.5), Components::additive (16, 220.0), Components::spectral (17, 1024, 256, 0.0), Components::shaper (18, 0.0, 2.0), Components::reverb (19, 2.0), Components::shifter (20, 100.0), Components::phaseOperator (21, 220.0, 0.0), Components::bowed (22, 220.0, 2400), Components::smoother (23, 0.01), Components::strikeComb (24, 220.0, 2400)]

controls () = [0.0, 0.001, 0.1, 0.25, 0.5, 0.75, 0.9, 0.999, 1.0]

closeEnough (got, want, scale) = expect (abs (got - want) <= 0.000000001 * (1.0 + abs scale), true)

adapter p =
    closeEnough (Descriptors::fromControl (p, 0.0), p.minimum, p.maximum)
    closeEnough (Descriptors::fromControl (p, 1.0), p.maximum, p.maximum)
    forEachList (controls (), \c => closeEnough (Descriptors::toControl (p, Descriptors::fromControl (p, c)), c, 1.0))
    forEachList (controls (), \c => expect (Descriptors::fromControl (p, c) >= p.minimum - 0.000000001 * (1.0 + abs p.minimum) && Descriptors::fromControl (p, c) <= p.maximum + 0.000000001 * (1.0 + abs p.maximum), true))
    forEachList (toList (range (1, length (controls ()))), \i => expect (Descriptors::fromControl (p, listGet (controls ()) i ?: 1.0) >= Descriptors::fromControl (p, listGet (controls ()) (satSub i 1) ?: 0.0), true))
    closeEnough (Descriptors::toControl (p, p.initial), Descriptors::toControl (p, Descriptors::fromControl (p, Descriptors::toControl (p, p.initial))), 1.0)

test ("every component parameter maps a 0-1 control onto its range and back, logarithmic for frequencies and times", \() => arithmetic (\() =>
    expect (length (adapted ()), 24)
    forEachList (adapted (), \n => forEachList (n.parameters, adapter))
    every = foldList (adapted (), [], \(all, n) => listConcat all n.parameters)
    expect (length (filterList (every, \p => Descriptors::scale p == synth::LogarithmicScale)) > 10, true)
    expect (length (filterList (every, \p => Descriptors::scale p == synth::LinearScale)) > 40, true)))

// [SYNTH-ADVANCED-CORE-PORTS] Every component declares each port's rate, channel count and unit coherently: audio
// carries amplitude on 1 or more channels, control inlets are one normalised channel, events are one channel of notes,
// and names are unique on each side.
coherent port = match port.rate
    synth::Audio => port.unit == synth::Amplitude && port.channels >= 1
    synth::Control => port.unit == synth::Normalised && port.channels == 1
    synth::Events => port.unit == synth::Notes && port.channels == 1

uniqueNames ports = length (filterList (ports, \p => length (filterList (ports, \q => q.name == p.name)) == 1)) == length ports

declared n =
    expect (length (filterList (listConcat n.inputs n.outputs, coherent)), length n.inputs + length n.outputs)
    expect (uniqueNames n.inputs, true)
    expect (uniqueNames n.outputs, true)
    expect (length n.outputs >= 1 || n.processor == synth::Sink, true)
    forEachList (listConcat n.inputs n.outputs, \p => expect (p.name != "", true))

test ("every component declares coherent port rates, channels, units and unique names", \() => arithmetic (\() =>
    nodes = listConcat (adapted ()) [Components::mixer 30, Components::output 31, Components::stereo 32, Components::downmix 33, Components::stereoOutput 34, Components::split (35, 6), Components::join (36, 4), Components::routeChannels (37, 2, [1, 0, -1])]
    expect (length nodes, 32)
    forEachList (nodes, declared)
    expect (length (filterList (nodes, \n => length (filterList (n.inputs, \p => p.rate == synth::Control)) > 0)), 2)
    expect (length (filterList (nodes, \n => length (filterList (n.outputs, \p => p.rate == synth::Events)) > 0)), 1)
    expect (length (filterList (nodes, \n => length (filterList (n.outputs, \p => p.rate == synth::Control)) > 0)), 1)
    expect (length (filterList (nodes, \n => length (filterList (n.outputs, \p => p.channels == 2)) > 0)) >= 2, true)))

// [SYNTH-ADVANCED-CORE-SIGNALS] A controller write is Pending until resolved, then Applied with the new revision or
// Rejected with its typed fault; only an applied write changes the audible snapshot.
import synth::Commands

appliedAt (receipt, revision) = match receipt.status
    synth::Applied at => expect (at, revision)
    _ => expect ("not applied", "applied")

rejectedWith (receipt, fault) = match receipt.status
    synth::Rejected why => expect (why, fault)
    _ => expect ("not rejected", "rejected")

stillPending (receipt, edit) = match receipt.status
    synth::Pending waiting => expect (waiting, edit)
    _ => expect ("not pending", "pending")

test ("controller writes stay pending until resolved, then apply with a revision or reject with a typed fault", \() => arithmetic (\() =>
    blank = node (1, synth::Filter, [audio], [audio])
    graph = accepted (Graphs::add (Graphs::empty, blank(parameters = [parameter "cutoff"])))
    initial = Parameters::initial graph
    edit = synth::ParameterChange(node = 1, key = "cutoff", value = 880.0, revision = 0, samplePosition = 0)
    waiting = Commands::pending (initial, edit)
    stillPending (waiting, edit)
    expect (readValue waiting.snapshot, 440.0)
    done = Commands::resolve (graph, waiting)
    appliedAt (done, 1)
    expect (readValue done.snapshot, 880.0)
    expect (done.snapshot.revision, 1)
    // Resolving an applied receipt changes nothing.
    again = Commands::resolve (graph, done)
    appliedAt (again, 1)
    expect (structuralEquals (again.snapshot, done.snapshot), true)
    // The same edit against the new snapshot is stale; the snapshot keeps the applied value.
    stale = Commands::resolve (graph, Commands::pending (done.snapshot, edit))
    rejectedWith (stale, synth::StaleRevision)
    expect (readValue stale.snapshot, 880.0)
    forEachList ([{ change = edit(value = 0.0), fault = synth::InvalidParameter }, { change = edit(samplePosition = 1), fault = synth::InvalidFrame }, { change = edit(key = "missing"), fault = synth::MissingParameter }, { change = edit(node = 9), fault = synth::MissingNode }], \c => rejectedWith (Commands::resolve (graph, Commands::pending (initial, c.change)), c.fault))
    expect (readValue (Commands::resolve (graph, Commands::pending (initial, edit(value = 0.0)))).snapshot, 440.0)
    // A rejected receipt stays rejected.
    rejectedWith (Commands::resolve (graph, stale), synth::StaleRevision)
    // Successive writes advance the revision one at a time.
    second = Commands::resolve (graph, Commands::pending (done.snapshot, edit(value = 1760.0, revision = 1)))
    appliedAt (second, 2)
    expect (readValue second.snapshot, 1760.0)))
