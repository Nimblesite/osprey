import synth::Components
import synth::Graphs
import synth::Lifecycles
import synth::Parameters
import synth::Patches
import synth::Renderer

// [SYNTH-HOST-MIDI-OSCILLATOR] Journey tests for connected MIDI oscillators, granular clips and layout validation.
// The instrument under test: a note generator wired to its oscillator's only event inlet.
midiOutlet () = synth::Port(name = "notes", rate = synth::Events, channels = 1, unit = synth::Notes)

midiOscillator () =
    plain = Components::sine (2, 440.0)
    plain(inputs = [midiOutlet ()])

midiInstrument (pitch, velocity, gate) = built ([Components::midiNote (1, pitch, velocity, gate), midiOscillator (), Components::output 3], [cable (1, 2), cable (2, 3)])

keyed (kind, offset, pitch, identity, velocity) = synth::HostNote(kind = kind, offset = offset, pitch = pitch, channel = 0, identity = identity, velocity = velocity)

eventClip notes = synth::NodeClip(clipNode = 1, clipChannels = 0, clipSamples = [], clipNotes = notes)

missingClip () = synth::NodeClip(clipNode = -1, clipChannels = 0, clipSamples = [], clipNotes = [])

// The success value of a render step, or `fallback` after a failed expectation.
renderedOr (outcome, fallback, use) = match outcome
    Error why =>
        expect (synth::Faults::detail why, "a rendered block")
        fallback
    Success value => use value

// The output node's clip among completed clips, or `fallback` after a failed expectation.
completedOr (clips, output, fallback, use) = renderedOr (synth::ClipInputs::completed (clips, output), fallback, use)

readyClip (output, ready) = match ready
    synth::ClipWaiting _ _ _ =>
        unexpected ()
        missingClip ()
    synth::ClipReady clips => completedOr (clips, output, missingClip (), \clip => clip)

outputClip (output, action) = renderedOr (action, missingClip (), \ready => readyClip (output, ready))

heldVoice (held, node, check) = match filterList (held.graphKernels, \bank => bank.kernelNode == node)
    [bank] => match bank.kernelMemory
        synth::MidiMemory voice => check voice
        _ => unexpected ()
    _ => unexpected ()

// One sample of a 48 kHz sine at gain and frequency, and the linear release gain ending at frame end.
tone (gain, frequency, i) = gain * sin (6.283185307179586 * frequency * toFloat i / 48000.0)

tail (end, i) = (end - toFloat i) / 239.0

// Frames from..until of samples match want at each frame index.
traced (samples, from, until, want) = forEachList (toList (range (from, until)), \i => near ((listGet samples i ?: 9.0), want i, 0.00000000001))

// One processor between a 440 Hz sine and the output.
through n = serial ([Components::sine (1, 440.0), n, Components::output 3])

// A plan whose schedule skips one node.
without (plan, identity) = plan(order = filterList (plan.order, \scheduled => scheduled != identity))

// The MIDI oscillator's block for these notes from a fresh voice, handed to check.
played (plan, fresh, notes, frames, check) = succeeds (synth::MidiOscillators::block (plan, [eventClip notes], midiOscillator (), fresh, frames), check)

// [SYNTH-RENDER-BLOCKS] Drive one graph through arbitrary block partitions, collecting the output clip.
failedJourney () = { runHeld = synth::GraphState(graphHosted = [], graphPosition = 0, graphKernels = []), runAudio = [] }

continuedBlock (output, journey, action) = match action
    synth::BlockWaiting _ _ =>
        unexpected ()
        failedJourney ()
    synth::BlockReady held clips => completedOr (clips, output, failedJourney (), \clip => { runHeld = held, runAudio = listConcat journey.runAudio clip.clipSamples })

continuedJourney (graph, output, journey, size) = renderedOr (synth::GraphClips::next (graph, journey.runHeld, size), failedJourney (), \action => continuedBlock (output, journey, action))

graphRun (graph, output, sizes, check) =
    journey = foldList (sizes, failedJourney (), \(prior, span) => continuedJourney (graph, output, prior, span))
    check journey.runHeld journey.runAudio

// [SYNTH-ADVANCED-GRAINS-INTEGRATION] One playable preset graph through the hosted GraphClips executor: finite,
// bounded, nonzero audio that survives 512-frame partitioning and repeats its exact state and samples.
presetHeard outcome =
    graph = accepted outcome
    output = 5
    expect (length (filterList (graph.cables, \wire => wire.source == 3 && wire.destination == 2 && wire.inlet == 1)), 1)
    whole = outputClip (output, synth::GraphClips::advance (graph, [], 1024))
    expect (whole.clipChannels == 1 && length whole.clipSamples == 1024, true)
    forEachList (whole.clipSamples, \sample => expect (sample == sample && abs sample <= 1.0, true))
    expect (foldList (whole.clipSamples, 0.0, \(energy, sample) => energy + abs sample) > 0.0, true)
    graphRun (graph, output, [512, 512], \clock audio =>
        sameSamples (audio, whole.clipSamples)
        graphRun (graph, output, [512, 512], \againClock againAudio =>
            expect (structuralEquals (againClock, clock) && structuralEquals (againAudio, audio), true)))
    whole.clipSamples

granularSource () = synth::SampleResource(name = "grain", sampleRate = 48000, sourceChannels = 1, rootFrequency = 440.0, samples = [0.5, -0.5, 0.25, -0.25])

// [SYNTH-ADVANCED-DELIVERY] A grain excites the physical body, then spectral processing and the LFO shape it.
combinedGrainJourney () =
    graph = accepted (Patches::combined ())
    kinds = mapList (graph.nodes, \n => synth::Kinds::kind n.processor)
    forEachList (["synth.grain-cloud", "synth.modal-bank", "synth.spectral", "synth.lfo"], \kind => expect (length (filterList (kinds, \k => k == kind)), 1))
    combinedHostBudget graph
    // Check every audible stage and the final sink after the spectral window fills.
    succeeds (clipsOf (graph, 1024), \clips =>
        forEachList ([0, 1, 2, 5, 7], \node =>
            samples = (clipFrom (clips, node)).clipSamples
            expect (foldList (samples, 0.0, \(peak, sample) => synth::TableMath::larger (peak, abs sample)) > 0.000001, true)
            expect (length (filterList (samples, \sample => sample >= -1.0 && sample <= 1.0)), length samples)))

// [SYNTH-ADVANCED-DELIVERY] The reverb's feedback network feeds the external processor.
combinedHostBudget graph =
    original = hostDescriptor ()
    descriptor = original(inputChannels = 1, outputChannels = 1, notes = false)
    valid (synth::Hosted::component (9, descriptor), \hosted => budgetedHost (graph, hosted))

budgetedHost (graph, hosted) =
    routed = built (listAppend graph.nodes hosted, listConcat (filterList (graph.cables, \c => c.destination != 7)) [cable (6, 9), cable (9, 7)])
    forEachList ([0, 32769], \frames => renderRefused (synth::GraphClips::start (routed, frames)))
    heavy = routed(nodes = listAppend routed.nodes (Components::delay (10, 1920000)))
    expect (synth::ClipLayouts::bounded (heavy, 1024), false)
    renderRefused (synth::GraphClips::start (heavy, 1024))
    match synth::GraphClips::start (routed, 1024)
        Error why => expect (synth::Faults::detail why, "combined graph reaches hosted effect")
        Success action => match action
            synth::BlockReady _ _ => unexpected ()
            synth::BlockWaiting block pending =>
                expect (pending.pendingNode, 9)
                expect (length block.samples, 1024)
                expect (length (filterList (block.samples, \s => abs s > 0.000001)) > 0, true)
                wet = synth::NodeClip(clipNode = 9, clipChannels = 1, clipSamples = block.samples, clipNotes = [])
                match synth::GraphClips::replied (pending, wet)
                    Error why => expect (synth::Faults::detail why, "combined graph resumed")
                    Success done => match done
                        synth::BlockWaiting _ _ => unexpected ()
                        synth::BlockReady held clips =>
                            expect (held.graphPosition, 1024)
                            // A running graph can resume only with exactly one state bank per DSP node.
                            forEachList ([[], listConcat held.graphKernels held.graphKernels], \banks =>
                                refusedWith (synth::GraphClips::next (routed, held(graphKernels = banks), 16), "The block needs one output, connected inputs and valid bounded buffers and state."))
                            sameSamples ((clipFrom (clips, 7)).clipSamples, wet.clipSamples)

granularNode () = Components::granular (1, granularSource (), 4, 7)

granularGraph () = built ([granularNode (), Components::stereoOutput 2], [cable (1, 2)])

// Register the clip scheduler, MIDI oscillator and granular journeys from the suite entry point.
// [SYNTH-ADVANCED-CORE-MODELS] A 440 Hz sine through a 0.25 gain and a 100-sample delay: a 200-frame tail at 48 kHz.
delayedSine () = built ([Components::sine (1, 440.0), Components::gain (2, 0.25), Components::delay (3, 100), Components::output 4], [cable (1, 2), cable (2, 3), cable (3, 4)])

// The instance a lifecycle step produced, or a disposed stand-in after a failed expectation.
lived outcome = renderedOr (outcome, synth::Instance(stage = synth::Disposed, rate = 48000.0, block = 1, plan = synth::Prepared(graph = Graphs::empty, order = [], feedback = []), audio = synth::Rendered(states = [], samples = [], position = 0, meters = [])), \one => one)

lifeMoved (one, transition) = lived (Lifecycles::next (one, transition))

lifePlayed (one, knobs, frames) = lived (Lifecycles::block (one, knobs, frames))

// Every transition and a render, refused with its exact message, leaving the instance as it was.
allRefused (one, knobs, stage) =
    forEachList ([{ t = synth::Activate, verb = "activate" }, { t = synth::Reset, verb = "reset" }, { t = synth::ReleaseTail, verb = "release" }, { t = synth::Dispose, verb = "dispose" }, { t = synth::Prepare(rate = 44100.0, block = 32), verb = "re-prepare" }], \c => refusedWith (Lifecycles::next (one, c.t), "Cannot ${c.verb} a ${stage} instance."))
    refusedWith (Lifecycles::block (one, knobs, 1), "Cannot render a ${stage} instance.")

// A releasing instance renders 64-frame blocks until its tail is spent: each block's frames and stage.
releaseBlocks (one, knobs) = foldList ([{ frames = 64, left = 136 }, { frames = 64, left = 72 }, { frames = 64, left = 8 }], { now = one, samples = [] }, \(run, c) =>
    next = lifePlayed (run.now, knobs, 64)
    expect (length next.audio.samples, c.frames)
    expect (next.stage, synth::Releasing(remaining = c.left))
    { now = next, samples = listConcat run.samples next.audio.samples })

// Lifecycle audio after the delay's onset reads as a pure sine: pitch at the probe's 48 kHz and level −12.04 dB.
sineHeard (label, samples, frequency) =
    steady = synth::Sequences::drop (samples, 128)
    inTune (label, steady, frequency, 0.5)
    within ("${label} level (dB)", decibelsAt (steady, frequency), -12.0412, 0.1)

// [SYNTH-HOST-GRAPH] A send can tap either the stereo bus or one of its split outlets.
stereoTapJourney () =
    graph = built ([Components::stereo 1, Components::split (2, 2)], [cable (1, 2)])
    stereo = synth::NodeClip(clipNode = 1, clipChannels = 2, clipSamples = [0.25, -0.5, 0.75, -1.0], clipNotes = [])
    // Track playback folds each stereo frame to mono before the track panner.
    stereoOutput = stereo(clipSamples = [1.0, -1.0, 0.25, 0.75])
    forEachList ([{ output = stereoOutput, mono = [0.0, 0.5] }, { output = stereo(clipChannels = 1), mono = stereo.clipSamples }, { output = stereo(clipSamples = []), mono = [] }], \row =>
        succeeds (synth::GraphClips::trackSamples row.output, \samples => sameSamples (samples, row.mono)))
    forEachList ([stereo(clipSamples = [0.25]), stereo(clipChannels = 3), stereo(clipChannels = 0)], \invalid => renderRefused (synth::GraphClips::trackSamples invalid))
    split = stereo(clipNode = 2)
    clips = [stereo, split]
    forEachList ([{ channel = 0, samples = [0.25, 0.75] }, { channel = 1, samples = [-0.5, -1.0] }], \side =>
        succeeds (synth::ClipInputs::tapped (graph, clips, 1, 0, side.channel), \got => sameSamples (got, side.samples))
        succeeds (synth::ClipInputs::tapped (graph, clips, 2, side.channel, 0), \got => sameSamples (got, side.samples)))
    forEachList ([{ source = 9, outlet = 0, channel = 0 }, { source = 2, outlet = 2, channel = 0 }, { source = 2, outlet = 0, channel = 1 }], \bad =>
        renderRefused (synth::ClipInputs::tapped (graph, clips, bad.source, bad.outlet, bad.channel)))
    forEachList ([[split, split], [], [split(clipSamples = [0.25])]], \invalid => renderRefused (synth::ClipInputs::tapped (graph, invalid, 2, 0, 0)))

registerClipJourneys () =
    audio = monoPort ("audio", synth::Audio, synth::Amplitude)
    test ("a wavetable clip carries oscillator phase across offline render blocks", \() => arithmetic (\() =>
        succeeds (synth::Wavetables::prepare (64, [synth::TableSpectrum(amplitudes = [1.0], phases = [0.0])]), \table =>
            oscillator = Components::wavetable (1, table, 440.0)
            graph = built ([oscillator, Components::output 2], [cable (1, 2)])
            whole = outputClip (2, synth::GraphClips::advance (graph, [], 128))
            expect (whole.clipChannels, 1)
            expect (length whole.clipSamples, 128)
            expect (foldList (whole.clipSamples, 0.0, \(total, sample) => total + sample * sample) > 0.0, true)
            graphRun (graph, 2, [17, 63, 48], \clock samples =>
                expect (clock.graphPosition, 128)
                sameSamples (samples, whole.clipSamples))
            invalid = graph(nodes = [oscillator(inputs = []), Components::output 2])
            renderRefused (synth::GraphClips::start (invalid, 128)))))
    test ("MIDI oscillator state validation rejects forged voices, capacity and malformed events", \() => arithmetic (\() =>
        graph = midiInstrument (69.0, 0.5, 8.0)
        expect (synth::MidiOscillators::connected (graph, midiOscillator ()), true)
        expect (synth::MidiOscillators::connected (built ([midiOscillator (), Components::output 3], [cable (2, 3)]), midiOscillator ()), false)
        expect (synth::MidiOscillators::connected (graph, Components::gain (2, 1.0)), false)
        fresh = synth::MidiOscillators::initial (midiOscillator ())
        expect (fresh.kernel.identity == 2 && fresh.kernel.phase == 0.0 && fresh.pitch == 0 && fresh.channel == 0, true)
        expect (fresh.noteIdentity == 0 && fresh.velocity == 0.0 && fresh.active == false, true)
        expect (fresh.releaseRemaining == 0 && fresh.releaseLength == 0, true)
        recast = fresh.kernel
        forEachList ([{ voice = fresh, admitted = true }, { voice = fresh(active = true), admitted = true }, { voice = fresh(releaseRemaining = 7, releaseLength = 240, velocity = 0.8), admitted = true },
            { voice = fresh(pitch = -1), admitted = false }, { voice = fresh(pitch = 128), admitted = false },
            { voice = fresh(channel = -1), admitted = false }, { voice = fresh(channel = 16), admitted = false },
            { voice = fresh(noteIdentity = -1), admitted = false }, { voice = fresh(noteIdentity = 2147483648), admitted = false },
            { voice = fresh(velocity = -0.1), admitted = false }, { voice = fresh(velocity = 1.1), admitted = false }, { voice = fresh(velocity = 0.5), admitted = false },
            { voice = fresh(active = true, releaseRemaining = 1), admitted = false }, { voice = fresh(active = true, releaseLength = 2), admitted = false },
            { voice = fresh(releaseRemaining = 1, releaseLength = 0), admitted = false }, { voice = fresh(releaseRemaining = 5, releaseLength = 2, velocity = 0.5), admitted = false },
            { voice = fresh(releaseRemaining = 240, releaseLength = 480001, velocity = 0.8), admitted = false }, { voice = fresh(releaseRemaining = 1, releaseLength = 1), admitted = false },
            { voice = fresh(kernel = recast(identity = 99)), admitted = false }, { voice = fresh(kernel = recast(phase = -0.1)), admitted = false }, { voice = fresh(kernel = recast(phase = 1.0)), admitted = false }], \r => expect (synth::MidiOscillators::valid (midiOscillator (), r.voice), r.admitted))
        expect (synth::MidiOscillators::valid (Components::gain (2, 1.0), fresh), false)
        plan = planFor graph
        forEachList ([
            { clips = [eventClip []], voice = fresh, frames = 0 }, { clips = [eventClip []], voice = fresh, frames = 32769 }, { clips = [eventClip []], voice = fresh(pitch = -1), frames = 4 }, { clips = [], voice = fresh, frames = 4 },
            { clips = [eventClip [keyed (1, 2, 69, 1, 0.5), keyed (1, 1, 69, 1, 0.5)]], voice = fresh, frames = 4 }, { clips = [eventClip [keyed (1, 4, 69, 1, 0.5)]], voice = fresh, frames = 4 },
            { clips = [eventClip [keyed (1, 0, 128, 1, 0.5)]], voice = fresh, frames = 4 }, { clips = [eventClip (mapList (toList (range (0, 1025)), \offset => keyed (1, offset, 69, 1, 0.5)))], voice = fresh, frames = 1025 }],
            \fault => renderRefused (synth::MidiOscillators::block (plan, fault.clips, midiOscillator (), fault.voice, fault.frames)))))
    test ("connected MIDI oscillators track pitch, velocity and the exact 240-frame release tail", \() => arithmetic (\() =>
        graph = midiInstrument (69.0, 0.5, 8.0)
        whole = outputClip (3, synth::GraphClips::advance (graph, [], 256))
        expect (whole.clipChannels == 1 && length whole.clipSamples == 256, true)
        traced (whole.clipSamples, 0, 8, \i => tone (0.5, 440.0, i))
        traced (whole.clipSamples, 8, 247, \i => tail (247.0, i) * tone (0.5, 440.0, i))
        forEachList (toList (range (247, 256)), \i => expect ((listGet whole.clipSamples i ?: 9.0), 0.0))
        forEachList ([[4, 4, 248], [8, 248], [1, 255], [128, 128]], \sizes => graphRun (graph, 3, sizes, \_clock audio => sameSamples (audio, whole.clipSamples)))
        graphRun (graph, 3, [128, 128], \clock _audio =>
            expect (clock.graphPosition, 256)
            heldVoice (clock, 2, \voice =>
                expect (voice.active == false && voice.pitch == 69 && voice.channel == 0 && voice.noteIdentity == 1, true)
                expect (voice.velocity == 0.0 && voice.releaseRemaining == 0 && voice.releaseLength == 0, true)
                expect (voice.kernel.identity, 2)
                near (voice.kernel.phase, 109120.0 / 48000.0 - 2.0, 0.000000001)))))
    test ("last-note priority ignores foreign note-offs, zero-velocity note-ons and re-attacks mid-release", \() => arithmetic (\() =>
        plan = planFor (midiInstrument (69.0, 0.5, 8.0))
        fresh = synth::MidiOscillators::initial (midiOscillator ())
        played (plan, fresh, [keyed (1, 0, 69, 1, 0.5), keyed (2, 4, 69, 1, 0.0), keyed (1, 8, 81, 9, 0.9)], 16, \rendered =>
            traced (rendered.kernelSamples, 0, 4, \i => tone (0.5, 440.0, i))
            traced (rendered.kernelSamples, 4, 8, \i => tail (243.0, i) * tone (0.5, 440.0, i))
            traced (rendered.kernelSamples, 8, 16, \i => 0.9 * sin (6.283185307179586 * (3520.0 + 880.0 * (toFloat i - 8.0)) / 48000.0))
            expect (rendered.heldKernel.active == true && rendered.heldKernel.pitch == 81 && rendered.heldKernel.noteIdentity == 9 && rendered.heldKernel.velocity == 0.9, true)
            expect (rendered.heldKernel.releaseRemaining == 0 && rendered.heldKernel.releaseLength == 0, true)
            near (rendered.heldKernel.kernel.phase, 0.22, 0.000000001))
        played (plan, fresh, [keyed (1, 0, 69, 1, 0.5), keyed (2, 3, 60, 2, 0.0), keyed (2, 5, 69, 3, 0.0)], 8, \held =>
            traced (held.kernelSamples, 0, 8, \i => tone (0.5, 440.0, i))
            expect (held.heldKernel.active == true && held.heldKernel.pitch == 69 && held.heldKernel.noteIdentity == 1 && held.heldKernel.velocity == 0.5, true))
        played (plan, fresh, [keyed (1, 0, 69, 1, 0.5), keyed (1, 2, 69, 1, 0.0)], 6, \released =>
            traced (released.kernelSamples, 0, 2, \i => tone (0.5, 440.0, i))
            traced (released.kernelSamples, 2, 6, \i => tail (241.0, i) * tone (0.5, 440.0, i))
            expect (released.heldKernel.active == false && released.heldKernel.releaseRemaining == 236 && released.heldKernel.releaseLength == 240, true))))
    test ("granular clouds retain deterministic stereo state across partitions and refuse forged memory", \() => arithmetic (\() =>
        expect (synth::ClipLayouts::supported (granularNode ()), true)
        whole = outputClip (2, synth::GraphClips::advance (granularGraph (), [], 512))
        expect (whole.clipChannels == 2 && length whole.clipSamples == 1024, true)
        forEachList (whole.clipSamples, \sample => expect (sample == sample && abs sample <= 1.0, true))
        expect (foldList (whole.clipSamples, 0.0, \(energy, sample) => energy + abs sample) > 0.0, true)
        graphRun (granularGraph (), 2, [256, 256], \clock audio =>
            expect (clock.graphPosition == 512 && length clock.graphKernels == 1, true)
            expect (length audio, 1024)
            graphRun (granularGraph (), 2, [256, 256], \againClock againAudio =>
                expect (structuralEquals (againClock, clock) && structuralEquals (againAudio, audio), true)))
        match synth::GraphClips::start (granularGraph (), 256)
            Error why => expect (synth::Faults::detail why, "a first granular block")
            Success first => match first
                synth::BlockWaiting _ _ => unexpected ()
                synth::BlockReady held clips =>
                    expect (held.graphPosition, 256)
                    expect (length held.graphKernels, 1)
                    match held.graphKernels
                        [bank] => match bank.kernelMemory
                            synth::GrainMemory _ => expect (bank.kernelNode, 1)
                            _ => unexpected ()
                        _ => unexpected ()
                    succeeds (synth::GraphClips::advance (granularGraph (), [], 256), \again => expect (structuralEquals (again, synth::ClipReady(clips = clips)), true))
        renderRefused (synth::GraphClips::advance (granularGraph (), [], 2049))
        channelForged = synth::NodeKernels(kernelNode = 1, kernelMemory = synth::ChannelMemory(channels = [synth::RenderInputs::initialState (granularNode ())]))
        renderRefused (synth::GraphClips::next (granularGraph (), synth::GraphState(graphHosted = [], graphPosition = 0, graphKernels = [channelForged]), 64))
        absentForged = synth::NodeKernels(kernelNode = 99, kernelMemory = synth::MidiMemory(voice = synth::MidiOscillators::initial (granularNode ())))
        renderRefused (synth::GraphClips::next (granularGraph (), synth::GraphState(graphHosted = [], graphPosition = 0, graphKernels = [absentForged]), 64))))
    test ("granular preset patches [SYNTH-ADVANCED-GRAINS-INTEGRATION] render finite, bounded, nonzero, deterministic and distinct audio", \() => arithmetic (\() =>
        cloud = presetHeard (Patches::grainCloud ())
        rhythm = presetHeard (Patches::rhythmicGrains ())
        frozen = presetHeard (Patches::frozenTexture ())
        expect (structuralEquals (cloud, rhythm), false)
        expect (structuralEquals (rhythm, frozen), false)
        expect (structuralEquals (cloud, frozen), false)
        combinedGrainJourney ()))
    test ("graph layouts and cached clips revalidate channel contracts at every edge", \() => arithmetic (\() =>
        graph = sineThrough (0.5)
        duplicated = Components::stereo 1
        expect (synth::ClipLayouts::supported (duplicated(outputs = [])), false)
        widened = Components::modulatedGain (1, 1, 1.0)
        expect (synth::ClipLayouts::supported (widened(inputs = [audio])), false)
        missingBus = hostNode (synth::Hosted::component (5, hostDescriptor ()))
        expect (synth::ClipLayouts::supported (missingBus(inputs = [audio, audio])), false)
        solo = hostDescriptor ()
        expect (synth::ClipLayouts::supported (hostNode (synth::Hosted::component (5, solo(notes = false)))), true)
        unplugged = Components::output 1
        renderRefused (synth::ClipLayouts::channels (unplugged(inputs = [])))
        headless = Components::gain (1, 1.0)
        renderRefused (synth::ClipLayouts::channels (headless(outputs = [])))
        expect (synth::ClipLayouts::connected (midiInstrument (69.0, 0.5, 8.0), midiOscillator ()), true)
        layoutJourney ()
        stereoTapJourney ()
        cached = nodeClipAt (1, [0.25, 0.25])
        expect (synth::ClipLayouts::validClip (graph, 2, cached), true)
        expect (synth::ClipLayouts::validClip (graph, 2, cached(clipNotes = [keyed (1, 0, 69, 1, 0.5)])), false)
        renderRefused (synth::ClipInputs::sourceChannel (graph, synth::Cable(source = 99, outlet = 0, destination = 2, inlet = 0), 0))
        renderRefused (synth::ClipInputs::routed (graph, [], 2, 0))
        renderRefused (synth::GraphClips::advance (graph, [synth::NodeClip(clipNode = 99, clipChannels = 1, clipSamples = [0.0, 0.0], clipNotes = [])], 2))
        badPitch = built ([Components::midiNote (1, 60.5, 0.8, 128.0), midiOscillator (), Components::output 3], [cable (1, 2), cable (2, 3)])
        forEachList ([[], [synth::NodeClip(clipNode = 1, clipChannels = 0, clipSamples = [], clipNotes = [])]], \clips => renderRefused (synth::GraphClips::advance (badPitch, clips, 2)))
        streaming = hostDescriptor ()
        wired = hostNode (synth::Hosted::component (2, streaming(inputChannels = 1, notes = false)))
        audioGraph = built ([Components::sine (1, 440.0), wired, Components::stereoOutput 3], [cable (1, 2), cable (2, 3)])
        succeeds (synth::ClipInputs::requestAt (audioGraph, [nodeClipAt (1, [0.25, 0.25])], wired, 0, 2), \request =>
            sameSamples (request.samples, [0.25, 0.25])
            expect (length request.notes, 0)
            pointValue (request, 0.25))
        renderRefused (synth::ClipInputs::requestAt (audioGraph, [], wired, 0, 2))
        notesOnly = hostNode (synth::Hosted::component (2, hostDescriptor ()))
        eventGraph = built ([Components::midiNote (1, 60.0, 0.8, 128.0), notesOnly, Components::stereoOutput 3], [cable (1, 2), cable (2, 3)])
        renderRefused (synth::ClipInputs::requestAt (eventGraph, [], notesOnly, 0, 64))
        quiet = hostDescriptor ()
        bare = hostNode (synth::Hosted::component (2, quiet(notes = false)))
        modulated = accepted (synth::HostModulation::connect (built ([Components::lfo (1, 2.0), bare, Components::stereoOutput 3], [cable (2, 3)]), 1, 0, 2, "vst:100"))
        renderRefused (synth::ClipInputs::requestAt (modulated, [], hostNode (Graphs::node (modulated, 2)), 0, 128))))
    test ("kernel and renderer faults stay explicit for bad modulation, ordering, snapshots and memory", \() => arithmetic (\() =>
        succeeds (synth::ClipKernels::render (planFor (sineThrough (0.5)), [nodeClipAt (1, [0.25, 0.25])], Components::gain (2, 0.5), 2, 1), \samples => sameSamples (samples, [0.125, 0.125]))
        forEachList ([
            { graph = built ([Components::sine (1, 440.0), Components::stereo 2, Components::stereoOutput 3], chainRoute ()), n = Components::stereo 2, copies = 2, clips = [nodeClipAt (1, [0.25, 0.25])] },
            { graph = through (Components::modulatedGain (2, 1, 1.0)), n = Components::modulatedGain (2, 1, 1.0), copies = 1, clips = [nodeClipAt (1, [0.25, 0.25])] },
            { graph = built ([Components::sine (1, 440.0), Components::mixer 2, Components::output 3], [cable (1, 2), Components::route (1, 0, 2, 1), cable (2, 3)]), n = Components::mixer 2, copies = 1, clips = [] },
            { graph = through (Components::gain (2, 8.0)), n = Components::gain (2, 8.0), copies = 1, clips = [nodeClipAt (1, [200000.0, 200000.0])] }],
            \fault => renderRefused (synth::ClipKernels::block (planFor fault.graph, fault.clips, fault.n, 2, mapList (toList (range (0, fault.copies)), \_ => synth::RenderInputs::initialState fault.n))))
        swept = built ([Components::sine (1, 440.0), Components::modulatedLowpass (2, 1000.0, 0.7), Components::lfo (4, 2.0), Components::output 3], [cable (1, 2), Components::route (4, 0, 2, 1), cable (2, 3)])
        forEachList ([[1.5, 1.5], [-0.5, -0.5]], \control => renderRefused (synth::GraphClips::advance (swept, [nodeClipAt (4, control)], 2)))
        delayedGraph = serial ([Components::sine (1, 440.0), Components::delay (2, 2), Components::output 3])
        delayedStart = rendered (Renderer::start delayedGraph)
        simple = sineThrough (0.5)
        simplePlan = planFor simple
        forEachList ([
            { graph = delayedGraph, plan = planFor delayedGraph, start = delayedStart(states = mapList (delayedStart.states, \s => s(delay = []))) },
            { graph = delayedGraph, plan = without (planFor delayedGraph, 1), start = delayedStart },
            { graph = simple, plan = without (simplePlan, 3), start = rendered (Renderer::start simple) },
            { graph = simple, plan = simplePlan(order = [2, 1, 3]), start = rendered (Renderer::start simple) },
            { graph = simple, plan = simplePlan(graph = simple(nodes = [Components::sine (1, 440.0)])), start = rendered (Renderer::start simple) }],
            \fault => renderRefused (Renderer::block (fault.plan, 48000.0, Parameters::initial fault.graph, fault.start, 1)))
        forEachList ([serial ([disabled (Components::sine (1, 440.0)), Components::gain (2, 1.0), Components::output 3]), serial ([switched (Components::sine (1, 440.0), "waveform", 3.0, 1.0), Components::gain (2, 1.0), Components::output 3]), built ([Components::sine (1, 440.0), disabled (Components::lowpass (2, 1000.0, 0.7)), Components::output 3], chainRoute ())], \switchedGraph =>
            plan = planFor switchedGraph
            snapshot = Parameters::initial switchedGraph
            renderRefused (Renderer::block (plan(order = [2, 1, 3]), 48000.0, snapshot(parameters = []), rendered (Renderer::start switchedGraph), 1)))))
    test ("a graph instance prepares, activates, renders, releases exactly its tail, resets, re-prepares at a new rate and disposes [SYNTH-ADVANCED-CORE-MODELS] [SYNTH-TEST-SPECTRUM]", \() => arithmetic (\() =>
        graph = delayedSine ()
        snapshot = Parameters::initial graph
        forEachList ([{ rate = 0.0, block = 64 }, { rate = 7999.0, block = 64 }, { rate = 384001.0, block = 64 }, { rate = 48000.0, block = 0 }, { rate = 48000.0, block = 8193 }, { rate = -48000.0, block = -1 }], \c => refusedAs (Lifecycles::prepared (graph, c.rate, c.block), "configuration", "A lifecycle needs a sample rate of 8,000 to 384,000 Hz and a block of 1 to 8,192 frames."))
        renderRefused (Lifecycles::prepared (Graphs::empty, 48000.0, 64))
        refusedAs (Lifecycles::prepared (built ([Components::sine (1, 440.0), Components::output 2, Components::output 3], [cable (1, 2), cable (1, 3)]), 48000.0, 64), "layout", "Reference rendering requires mono audio, one output and supported bounded processors.")
        ready = lived (Lifecycles::prepared (graph, 48000.0, 64))
        expect (ready.stage, synth::Ready)
        expect (ready.rate, 48000.0)
        expect (ready.block, 64)
        expect (ready.audio.position, 0)
        expect (Lifecycles::tail ready ?: -1, 200)
        refusedWith (Lifecycles::next (ready, synth::ReleaseTail), "Cannot release a ready instance.")
        refusedWith (Lifecycles::block (ready, snapshot, 1), "Cannot render a ready instance.")
        running = lifeMoved (ready, synth::Activate)
        expect (running.stage, synth::Running)
        refusedWith (Lifecycles::next (running, synth::Activate), "Cannot activate a running instance.")
        refusedWith (Lifecycles::next (running, synth::Prepare(rate = 96000.0, block = 64)), "Cannot re-prepare a running instance.")
        forEachList ([0, -1, 65, 8192, 9000], \frames => refusedWith (Lifecycles::block (running, snapshot, frames), "A block is 1 to the prepared 64 frames; a larger one needs re-preparation."))
        first = lifePlayed (running, snapshot, 64)
        second = lifePlayed (first, snapshot, 64)
        expect (second.stage, synth::Running)
        expect (second.audio.position, 128)
        releasing = lifeMoved (second, synth::ReleaseTail)
        expect (releasing.stage, synth::Releasing(remaining = 200))
        refusedWith (Lifecycles::next (releasing, synth::ReleaseTail), "Cannot release a releasing instance.")
        refusedWith (Lifecycles::next (releasing, synth::Activate), "Cannot activate a releasing instance.")
        refusedWith (Lifecycles::next (releasing, synth::Prepare(rate = 48000.0, block = 64)), "Cannot re-prepare a releasing instance.")
        tail = releaseBlocks (releasing, snapshot)
        last = lifePlayed (tail.now, snapshot, 64)
        expect (length last.audio.samples, 8)
        expect (last.stage, synth::Ready)
        expect (last.audio.position, 328)
        refusedWith (Lifecycles::block (last, snapshot, 1), "Cannot render a ready instance.")
        // Running, releasing and the tail together are exactly one uninterrupted 328-frame render.
        sameSamples (listConcat (listConcat (listConcat first.audio.samples second.audio.samples) tail.samples) last.audio.samples, (blockOf (graph, 328)).samples)
        again = lifePlayed (lifeMoved (last, synth::Activate), snapshot, 64)
        sameSamples (again.audio.samples, synth::Sequences::drop ((blockOf (graph, 392)).samples, 328))
        expect (again.audio.position, 392)
        // Reset from running, releasing or ready restarts silent at frame 0 and renders the opening again.
        forEachList ([again, lifeMoved (again, synth::ReleaseTail), last, ready], \live =>
            restarted = lifeMoved (live, synth::Reset)
            expect (restarted.stage, synth::Ready)
            expect (structuralEquals (restarted.audio, ready.audio), true)
            sameSamples ((lifePlayed (lifeMoved (restarted, synth::Activate), snapshot, 64)).audio.samples, first.audio.samples))
        // Re-preparing at a new rate starts silent and steps every phase at that rate.
        long = lived (Lifecycles::prepared (graph, 48000.0, 2048))
        heard48 = lifePlayed (lifeMoved (long, synth::Activate), snapshot, 2048)
        doubled = lifeMoved (lifeMoved (heard48, synth::Reset), synth::Prepare(rate = 96000.0, block = 2048))
        expect (doubled.rate, 96000.0)
        expect (doubled.stage, synth::Ready)
        expect (doubled.audio.position, 0)
        expect (Lifecycles::tail doubled ?: -1, 400)
        expect (Lifecycles::tail (lived (Lifecycles::prepared (graph, 44100.0, 64))) ?: -1, 184)
        heard96 = lifePlayed (lifeMoved (doubled, synth::Activate), snapshot, 2048)
        sameSamples (heard96.audio.samples, (rendered (Renderer::block (planFor graph, 96000.0, snapshot, rendered (Renderer::start graph), 2048))).samples)
        sineHeard ("48 kHz lifecycle", heard48.audio.samples, 440.0)
        // Twice the rate halves the phase step, so read at the 48 kHz probe rate the note sounds an octave down.
        sineHeard ("96 kHz lifecycle read at 48 kHz", heard96.audio.samples, 220.0)
        below ("96 kHz lifecycle at 440 Hz (dB)", decibelsAt (synth::Sequences::drop (heard96.audio.samples, 128), 440.0), -40.0)
        // Dispose from every live stage drops the state; nothing else is allowed afterwards.
        forEachList ([ready, running, releasing, tail.now], \live =>
            gone = lifeMoved (live, synth::Dispose)
            expect (gone.stage, synth::Disposed)
            expect (length gone.audio.states, 0)
            expect (length gone.audio.samples, 0)
            allRefused (gone, snapshot, "disposed"))))
