import synth::Components
import synth::Parameters
import synth::Renderer

// [SYNTH-SIGNALS] A moving playback cursor reads the gain and speed that take effect on that frame.
sampleControlJourney () =
    mono = grainResource (24000, 440.0, [1.0, 0.0, -1.0, 0.5])
    stereo = mono(sourceChannels = 2, samples = [1.0, 1.0, -0.5, 0.5, -1.0, -1.0, 0.75, 0.25])
    forEachList ([mono, stereo], \resource =>
        graph = built ([Components::samplePlayer (1, resource), Components::output 2], [cable (1, 2)])
        sameSamples ((blockOf (graph, 10)).samples, [1.0, 0.5, 0.0, -0.5, -1.0, -0.25, 0.5, 0.25, 0.0, 0.0])
        gain = synth::ParameterChange(node = 1, key = "gain", value = 0.5, revision = 0, samplePosition = 1)
        speed = gain(key = "rate", value = 2.0, revision = 1, samplePosition = 2)
        succeeds (Renderer::automated (planFor graph, 48000.0, Parameters::initial graph, rendered (Renderer::start graph), 8, [gain, speed]), \done =>
            sameSamples (done.audio.samples, [1.0, 0.25, 0.0, -0.5, 0.25, 0.0, 0.0, 0.0])
            expect (done.observation.revision, 2)
            expect (done.observation.samplePosition, 8)))

// The edits whose frame falls inside the block that starts at `from` and holds `count` frames.
owned (edits, from, count) = filterList (edits, \e => e.samplePosition >= from && e.samplePosition < satAdd from count)

// One partition played on from the prior one's audio state and observation, its samples appended.
continued (plan, rate, edits, prior, count) = synth::Outcomes::carried (prior, \run =>
    synth::Outcomes::carried (Renderer::automated (plan, rate, run.played.observation, run.played.audio, count, owned (edits, run.played.audio.position, count)), \next =>
        Success(value = { played = next, heard = listConcat run.heard next.audio.samples })))

// One rate's continuous block against every partition layout; the continuous samples are returned.
partitionedAt (run, rate) = match Renderer::automated (run.plan, rate, run.snapshot, run.start, 64, run.edits)
    Error why =>
        expect (synth::Faults::detail why, "a continuous 64-frame block")
        []
    Success whole =>
        expect (whole.observation.revision, 5)
        expect (whole.observation.samplePosition, 64)
        expect (whole.audio.position, 64)
        expect (absSum whole.audio.samples > 0.01, true)
        // The 17-frame delay keeps the first 17 frames silent.
        sameSamples (synth::Sequences::take (whole.audio.samples, 17), mapList (toList (range (0, 17)), \_ => 0.0))
        forEachList (run.layouts, \sizes =>
            expect (foldList (sizes, 0, \(sum, size) => satAdd sum size), 64)
            succeeds (foldList (sizes, Success(value = { played = synth::Timeline(audio = run.start, observation = run.snapshot), heard = [] }), \(prior, count) => continued (run.plan, rate, run.edits, prior, count)), \pieces =>
                sameSamples (pieces.heard, whole.audio.samples)
                sameStructure (pieces.played.audio.states, whole.audio.states)
                // Meters describe the last block alone; the revision, position and parameter values are the run's.
                sameStructure ({ r = pieces.played.observation.revision, p = pieces.played.observation.samplePosition, v = pieces.played.observation.parameters }, { r = 5, p = 64, v = whole.observation.parameters })))
        // An edit on a block's first frame belongs to that block; the block that ends just before it refuses it.
        forEachList (filterList (run.edits, \e => e.samplePosition > 1), \edit =>
            renderRefused (Renderer::automated (run.plan, rate, run.snapshot, run.start, edit.samplePosition, listConcat (owned (run.edits, 0, edit.samplePosition)) [edit])))
        whole.audio.samples

// [SYNTH-ADVANCED-VERIFY-CORRECTNESS] [SYNTH-RENDER-BLOCKS] Unequal and one-sample partitions play the samples,
// state and observation of one continuous block at 44.1, 48, 96 and 192 kHz, every edit on a block's first frame.
partitionJourney () =
    graph = built ([Components::sine (1, 440.0), Components::lowpass (2, 4000.0, 0.7), Components::gain (3, 0.8), Components::delay (4, 17), Components::output 5], [cable (1, 2), cable (2, 3), cable (3, 4), cable (4, 5)])
    cutoff = synth::ParameterChange(node = 2, key = "cutoff", value = 1200.0, revision = 0, samplePosition = 1)
    edits = [cutoff, cutoff(node = 3, key = "gain", value = 0.25, revision = 1, samplePosition = 7), cutoff(value = 9000.0, revision = 2, samplePosition = 8), cutoff(node = 3, key = "gain", value = 1.5, revision = 3, samplePosition = 39), cutoff(key = "resonance", value = 4.0, revision = 4, samplePosition = 63)]
    run = { plan = planFor graph, snapshot = Parameters::initial graph, start = rendered (Renderer::start graph), edits = edits, layouts = [[1, 6, 1, 31, 1, 23, 1], [64], [1, 63], [63, 1], [7, 1, 31, 1, 24], [8, 56]] }
    heard = mapList ([44100.0, 48000.0, 96000.0, 192000.0], \rate => partitionedAt (run, rate))
    // A higher rate steps every phase by a smaller fraction, so no two rates sound alike.
    forEachList ([{ a = 0, b = 1 }, { a = 1, b = 2 }, { a = 2, b = 3 }], \pair =>
        expect (structuralEquals (listGet heard pair.a ?: [], listGet heard pair.b ?: []), false))
