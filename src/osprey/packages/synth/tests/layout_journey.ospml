import synth::Components
import synth::ClipLayouts

// [SYNTH-HOST-GRAPH] The clip renderer uses one mono port per splitter outlet or joiner inlet.
layoutJourney () =
    stereo = Components::stereo 1
    down = Components::downmix 1
    split = Components::split (1, 2)
    joiner = Components::join (1, 2)
    route = Components::routeChannels (1, 2, [1, 0])
    sample = Components::samplePlayer (1, grainFlatSource ())
    forEachList ([stereo, down, split, joiner, route, sample, Components::exciter (1, 7), Components::phaseOperator (1, 440.0, 1.0), Components::bowed (1, 220.0, 512)], \n => expect (ClipLayouts::supported n, true))
    forEachList ([down(inputs = []), down(outputs = []), split(inputs = []), joiner(outputs = []), route(inputs = []), route(outputs = [])], \invalid => expect (ClipLayouts::supported invalid, false))
    forEachList ([Components::lfo (1, 1.0), Components::modulatedGain (1, 1, 0.5), hostNode (synth::Hosted::component (1, hostDescriptor ())), Components::midiNote (1, 60.0, 0.5, 8.0), stereo, Components::panner (1, 2, 0.5), split], \n => expect (ClipLayouts::requiresClips n, true))
    expect (ClipLayouts::requiresClips (Components::sine (1, 440.0)), false)
    graph = built ([sample, Components::output 2], [cable (1, 2)])
    expect (ClipLayouts::bounded (graph, 32768), true)
    expect (ClipLayouts::bounded (graph, 32769), false)
