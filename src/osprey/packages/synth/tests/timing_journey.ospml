import synth::Components
import synth::Timings

// [SYNTH-ADVANCED-CORE-RESOURCES] Measure host compensation in samples at the graph's 48 kHz rate.
timingCase (n, latency, tail) =
    succeeds (Timings::latency n, \samples => expect (samples, latency))
    succeeds (Timings::tail n, \samples => expect (samples, tail))

registerTimingJourney () = test ("component timing declares delay and decay in samples, tracks oversampling switches and rejects missing controls", \() => arithmetic (\() =>
    timingCase (Components::sine (1, 440.0), 0.0, 0.0)
    timingCase (Components::waveguide (1, 220.0, 512), 0.0, 144000.0)
    timingCase (Components::bowed (1, 220.0, 512), 0.0, 96000.0)
    timingCase (Components::resonator (1, 440.0), 0.0, 72000.0)
    timingCase (Components::modalBank (1, 220.0, 1.0), 0.0, 240000.0)
    timingCase (Components::reverb (1, 1.5), 0.0, 144000.0)
    timingCase (Components::smoother (1, 0.5), 0.0, 168000.0)
    timingCase (Components::additive (1, 440.0), 0.0, 28800000.0)
    timingCase (Components::delay (1, 64), 64.0, 64.0)
    timingCase (Components::fractionalDelay (1, 7.25, 32), 7.25, 7.25)
    phaseNode = Components::phaseOperator (1, 440.0, 0.0)
    timingCase (phaseNode, 0.0, 0.0)
    timingCase (grainSet (phaseNode, "oversample", 1.0), 7.5, 0.0)
    shaper = Components::shaper (1, 0.0, 2.0)
    over = grainSet (shaper, "oversample", 1.0)
    timingCase (shaper, 0.5, 0.0)
    timingCase (over, 15.5, 0.0)
    timingCase (grainSet (over, "antialias", 0.0), 0.0, 0.0)
    hall = Components::reverb (1, 1.0)
    refusedAs (Timings::latency (shaper(parameters = [])), "configuration", "The node lacks a timing parameter: oversample.")
    refusedAs (Timings::tail (hall(parameters = [])), "configuration", "The node lacks a timing parameter: decay.")))
