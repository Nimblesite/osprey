import synth::Components
import synth::GraphClips
import synth::GraphRebase

// [SYNTH-ADVANCED-CORE-PORTS] Keep a sounding oscillator while replacing the delay it feeds.
banksAt (held, identity) = filterList (held.graphKernels, \bank => bank.kernelNode == identity)

delayAfterEdit (held, identity, size) = match banksAt (held, identity)
    [bank] => match bank.kernelMemory
        synth::ChannelMemory channels => match channels
            [mono] => sameSamples (mono.delay, synth::Sequences::zeros size)
            _ => unexpected ()
        _ => unexpected ()
    _ => unexpected ()

rebaseRunning held =
    oscillator = Components::sine (1, 440.0)
    sink = Components::output 3
    before = banksAt (held, 1)
    expect (length before, 1)
    forEachList ([{ id = 2, size = 16 }, { id = 4, size = 8 }], \row =>
        graph = built ([oscillator, Components::delay (row.id, row.size), sink], [cable (1, row.id), cable (row.id, 3)])
        succeeds (GraphRebase::rebased (graph, held), \next =>
            expect (next.graphPosition, 64)
            sameStructure (banksAt (next, 1), before)
            delayAfterEdit (next, row.id, row.size)))
    cloud = Components::granular (4, grainFlatSource (), 4, 7)
    changed = built ([cloud, Components::stereoOutput 3], [cable (4, 3)])
    refusedAs (GraphRebase::rebased (changed, held), "configuration", "A grain cloud added to a running graph needs a restart (its clock starts at zero).")
    expect (length (banksAt (held, 2)), 1)

rebaseJourney () =
    graph = serial ([Components::sine (1, 440.0), Components::delay (2, 8), Components::output 3])
    succeeds (GraphClips::start (graph, 48000.0, 64), \step => checkRebaseBlock step)

checkRebaseBlock step = match step
    synth::BlockReady held _ => rebaseRunning held
    synth::BlockWaiting _ _ => unexpected ()

// [PRISM-ROUTING-VERIFY] [SYNTH-RENDER-BLOCKS] A parameter-only edit keeps the oscillator and filter banks and
// changes the sound; an unchanged rebase continues sample for sample; a routing change sounds different.
filtered cutoff = serial ([Components::sine (1, 440.0), Components::lowpass (2, cutoff, 0.7), Components::output 3])

readySamples step = match step
    synth::BlockReady _ clips => completedOr (clips, 3, [], \clip => clip.clipSamples)
    synth::BlockWaiting _ _ =>
        unexpected ()
        []

blockAudio (graph, held) = renderedOr (GraphClips::next (graph, held, 64), [], readySamples)

rebasedAudio (graph, held) = renderedOr (GraphRebase::rebased (graph, held), [], \next => blockAudio (graph, next))

startedAudio graph = renderedOr (GraphClips::start (graph, 48000.0, 64), [], readySamples)

editedFrom (held, first) =
    base = blockAudio (filtered 800.0, held)
    expect (length base, 64)
    expect (structuralEquals (base, first), false)
    sameSamples (rebasedAudio (filtered 800.0, held), base)
    forEachList ([200.0, 4000.0], \cutoff => succeeds (GraphRebase::rebased (filtered cutoff, held), \next =>
        forEachList ([1, 2], \identity => sameStructure (banksAt (next, identity), banksAt (held, identity)))
        edited = blockAudio (filtered cutoff, next)
        expect (length edited, 64)
        expect (structuralEquals (edited, base), false)
        expect (structuralEquals (edited, startedAudio (filtered cutoff)), false)))
    direct = built ([Components::sine (1, 440.0), Components::output 3], [cable (1, 3)])
    succeeds (GraphRebase::rebased (direct, held), \next =>
        expect (length (banksAt (next, 2)), 0)
        sameStructure (banksAt (next, 1), banksAt (held, 1))
        routed = blockAudio (direct, next)
        expect (length routed, 64)
        expect (structuralEquals (routed, base), false))

editAudio step = match step
    synth::BlockReady held clips => succeeds (synth::ClipInputs::completed (clips, 3), \first => editedFrom (held, first.clipSamples))
    synth::BlockWaiting _ _ => unexpected ()

editAudioJourney () = succeeds (GraphClips::start (filtered 800.0, 48000.0, 64), editAudio)
