import synth::Components
import synth::GrainMath
import synth::Grains
import synth::GrainWindows
import synth::GrainTimings
import synth::PitchMarks
import synth::GrainScheduler
import synth::GrainSpreads
import synth::GrainDistributions
import synth::GrainCapture
import synth::GrainClouds
import synth::GrainGraph

// [SYNTH-ADVANCED-GRAINS-WINDOWS] [SYNTH-ADVANCED-GRAINS-TIMING] [SYNTH-ADVANCED-GRAINS-SCHEDULING]
// [SYNTH-ADVANCED-GRAINS-DISTRIBUTIONS] [SYNTH-ADVANCED-GRAINS-INTEGRATION] Grain shapes, onset clocks,
// variation streams and the graph module refuse every invalid control with its own message.

grainControls window = synth::GrainControls(window = window, start = 1.0, rate = 1.0, duration = 8, amplitude = 0.5, pan = 0.0)

retunedParameter (key, value, p) = match p.key == key
    true => p(initial = value)
    false => p

// The granular node with one parameter's initial value replaced.
retuned (key, value) =
    n = granularNode ()
    n(parameters = mapList (n.parameters, \p => retunedParameter (key, value, p)))

wholeCounts () = "Grain timing requires whole output-sample counts."

timingModes () = "Grain timing must be 0 (periodic jitter) or 1 (bounded exponential)."

diverges outcome = refusedWith (outcome, "The grain player and scheduler clocks have diverged.")

// [SYNTH-ADVANCED-GRAINS-PLAYBACK] Opposite-polarity samples reveal a tail reading the wrong buffer.
overlapSources pool =
    controls = grainControls synth::HannWindow
    old = controls(start = 3.0, duration = 3, amplitude = 1.0, pan = -1.0)
    succeeds (Grains::trigger (pool, old), \first =>
        succeeds (Grains::replaceSource (first.pool, [-1.0, -1.0]), \swapped =>
            watched = Grains::observation swapped
            expect (watched.sourceFrames == 2 && watched.retiredFrames == 4 && watched.activeGrains == 1, true)
            forEachList (watched.voices, \voice => expect (voice.identity == 0 && voice.fromPreviousSource && voice.cursor == 3.0 && voice.sourceFrames == 4, true))
            refusedWith (Grains::replaceSource (swapped, [0.0, 0.0]), "The previous sample still has active grains.")
            succeeds (Grains::trigger (swapped, old(start = 0.0, pan = 1.0)), \second =>
                succeeds (Grains::block (second.pool, 3), \audio =>
                    near (listGet audio.left 1 ?: 0.0, 1.0, 0.000001)
                    near (listGet audio.right 1 ?: 0.0, -1.0, 0.000001)
                    expect (length audio.next.retiredSource, 0)
                    succeeds (Grains::replaceSource (audio.next, [0.0, 0.0]), \next =>
                        expect (next.nextIdentity == 2 && next.position == 3 && next.revision == 2, true))))))

// [SYNTH-ADVANCED-CORE-RESOURCES] The upper bound is exclusive; last-tap interpolation stays in the region.
regionJourney (pool, boundary, rate, start, expected, remaining) =
    controls = grainControls synth::HannWindow
    region = synth::GrainRegion(first = 1, limit = 3, boundary = boundary)
    succeeds (Grains::withRegion (pool, region), \chosen =>
        refusedWith (Grains::trigger (chosen, controls(start = 0.0)), "Invalid grain source, controls or revision.")
        succeeds (Grains::trigger (chosen, controls(start = start, rate = rate, pan = -1.0, amplitude = 1.0, duration = 3)), \admitted =>
            succeeds (Grains::block (admitted.pool, 2), \block =>
                near (listGet block.left 1 ?: 99.0, expected, 0.000001)
                expect (length block.next.voices, remaining))))

// [SYNTH-ADVANCED-GRAINS-SCHEDULING] Freeze and thaw share a bounded mono source with the normal player.
captureJourney writer =
    refusedWith (GrainCapture::write (writer, [0.0, floatFromBits 9218868437227405312]), "Capture samples must be finite and within [-1, 1].")
    refusedWith (GrainCapture::write (writer, []), "Invalid capture state, block size or sample clock.")
    refusedWith (GrainCapture::resource (writer, "capture", 60.0), "Freeze a valid capture before preparing a sample resource.")
    refusedWith (GrainCapture::freeze writer, "Freeze requires at least two captured frames.")
    succeeds (GrainCapture::write (writer, [0.0, 0.25]), \first =>
        succeeds (GrainCapture::write (first, [0.5, 0.75, 1.0]), \second =>
            succeeds (GrainCapture::freeze second, \frozen =>
                expect (structuralEquals (frozen.samples, [0.25, 0.5, 0.75, 1.0]) && frozen.written == 5, true)
                refusedWith (GrainCapture::write (frozen, [0.0]), "Resume capture before writing.")
                succeeds (GrainCapture::resource (frozen, "captured", 60.0), \resource =>
                    expect (resource.sampleRate == 24000 && resource.sourceChannels == 1, true)
                    expect (structuralEquals (resource.samples, frozen.samples), true))
                succeeds (GrainCapture::thaw frozen, \resumed =>
                    succeeds (GrainCapture::write (resumed, [-1.0, 0.0, 0.25, 0.5, 0.75]), \next =>
                        expect (next.written == 10 && structuralEquals (next.samples, [0.0, 0.25, 0.5, 0.75]), true)
                        expect (structuralEquals (frozen.samples, [0.25, 0.5, 0.75, 1.0]), true))))))

// Each upward crossing in an external monophonic reference owns exactly one absolute sample.
pitchMarkJourney () =
    succeeds (PitchMarks::prepare 27, \clock =>
        succeeds (PitchMarks::block (clock, [0.5, -0.5, 0.0, 0.0, 0.5, -0.5, 0.25]), \whole =>
            expect (structuralEquals (whole.positions, [29, 33]), true)
            succeeds (PitchMarks::block (clock, [0.5, -0.5]), \head =>
                succeeds (PitchMarks::block (head.next, [0.0, 0.0, 0.5, -0.5, 0.25]), \tail =>
                    expect (structuralEquals (listConcat head.positions tail.positions, whole.positions), true)
                    expect (structuralEquals (tail.next, whole.next), true))))
        refusedWith (PitchMarks::block (clock, [-0.5, 1.5]), "Pitch reference samples must be finite and normalised.")
        refusedWith (PitchMarks::block (clock, []), "Invalid pitch reference block or exhausted sample clock."))

sourceJourneys () =
    succeeds (GrainCapture::prepare (4, 24000), captureJourney)
    succeeds (Grains::prepare ([1.0, 1.0, 1.0, 1.0], 2), overlapSources)
    succeeds (Grains::prepare ([0.75, -1.0, 1.0, -0.5], 1), \pool =>
        regionJourney (pool, synth::LoopSource, 1.0, 1.5, 0.0, 1)
        regionJourney (pool, synth::OneShotSource, 1.0, 1.5, 1.0, 0)
        regionJourney (pool, synth::LoopSource, -1.0, 1.0, 1.0, 1)
        regionJourney (pool, synth::OneShotSource, -1.0, 1.0, 0.0, 0)
        regionJourney (pool, synth::OneShotSource, 0.0, 2.75, 1.0, 1))

registerGrainJourneys () =
    test ("grain windows and timing selectors decode exactly and refuse unsupported modes", \() => arithmetic (\() =>
        pitchMarkJourney ()
        // ASR over 11 frames: a 2-frame attack ramp, a held sustain, then a 3-frame release.
        forEachList ([{ age = 0, want = 0.0 }, { age = 1, want = 0.5 }, { age = 2, want = 1.0 }, { age = 5, want = 1.0 }, { age = 8, want = 2.0 / 3.0 }, { age = 10, want = 0.0 }], \c => near (GrainWindows::value (synth::AsrWindow(attack = 0.2, release = 0.3), c.age, 11), c.want, 0.000000000001))
        near (GrainWindows::value (synth::HannWindow, 5, 11), 1.0, 0.000000000001)
        forEachList ([{ shape = synth::AsrWindow(attack = 0.5, release = 0.5), ok = true }, { shape = synth::AsrWindow(attack = 0.6, release = 0.5), ok = false }, { shape = synth::AsrWindow(attack = 0.0, release = 0.5), ok = false }, { shape = synth::AsrWindow(attack = 1.0, release = 0.0), ok = false }, { shape = synth::HannWindow, ok = true }], \c => expect (GrainWindows::valid c.shape, c.ok))
        succeeds (GrainWindows::decode (1.0, 0.25, 0.25), \shape => expect (structuralEquals (shape, synth::AsrWindow(attack = 0.25, release = 0.25)), true))
        succeeds (GrainWindows::decode (0.0, 0.9, 0.9), \shape => expect (structuralEquals (shape, synth::HannWindow), true))
        refusedWith (GrainWindows::decode (1.0, 0.75, 0.5), "Grain attack and release must be positive fractions whose sum is at most one.")
        forEachList ([2.0, 0.5, -1.0], \mode => refusedWith (GrainWindows::decode (mode, 0.25, 0.25), "Grain window must be 0 (Hann) or 1 (ASR)."))
        forEachList ([{ timing = synth::ExponentialTiming(mean = 1.0, maximum = 1), ok = true }, { timing = synth::ExponentialTiming(mean = 0.5, maximum = 1), ok = false }, { timing = synth::ExponentialTiming(mean = 1.0, maximum = 0), ok = false }, { timing = synth::ExponentialTiming(mean = 1048577.0, maximum = 9), ok = false }, { timing = synth::PeriodicTiming(period = 4, jitter = 4), ok = false }], \c => expect (GrainTimings::valid c.timing, c.ok))
        expect (GrainTimings::interval (synth::ExponentialTiming(mean = 10.0, maximum = 100), 1073741824), 7.0)
        succeeds (GrainTimings::decode (1.0, 10, 0, 100), \timing => expect (structuralEquals (timing, synth::ExponentialTiming(mean = 10.0, maximum = 100)), true))
        succeeds (GrainTimings::decode (0.0, 4, 1, 0), \timing => expect (structuralEquals (timing, synth::PeriodicTiming(period = 4, jitter = 1)), true))
        refusedWith (GrainTimings::decode (1.0, 0, 0, 100), "Invalid grain timing distribution or bounds.")
        forEachList ([2.0, 0.25], \mode => refusedWith (GrainTimings::decode (mode, 4, 1, 9), timingModes ()))))
    test ("generated grain math clips, caps and wraps at every boundary", \() => arithmetic (\() =>
        forEachList ([{ got = GrainMath::exponentialInterval (10.0, 100.0, 1073741824.0), want = 7.0 }, { got = GrainMath::exponentialInterval (1000.0, 5.0, 1000000000.0), want = 5.0 }, { got = GrainMath::exponentialInterval (1.0, 10.0, 0.0), want = 1.0 }, { got = GrainMath::density (3.0, 0.0), want = 0.0 }, { got = GrainMath::density (3.0, 4.0), want = 0.75 }], \c => expect (c.got, c.want))
        forEachList ([{ got = GrainMath::spreadLow (0.5, 1.0, 0.0), want = 0.0 }, { got = GrainMath::spreadLow (5.0, 1.0, 0.0), want = 4.0 }, { got = GrainMath::spreadHigh (5.0, 1.0, 5.5), want = 5.5 }, { got = GrainMath::spreadHigh (5.0, 1.0, 10.0), want = 6.0 }, { got = GrainMath::wrapped (-0.0000000000000001, 4.0), want = 0.0 }, { got = GrainMath::wrapped (-1.0, 4.0), want = 3.0 }], \c => expect (c.got, c.want))
        near (GrainMath::asr (8.0, 11.0, 0.2, 0.3), 2.0 / 3.0, 0.000000000001)))
    test ("onset clocks follow the seeded exponential stream and refuse exhausted or invalid clocks", \() => arithmetic (\() =>
        forEachList ([{ at = -1, seed = 1 }, { at = 0, seed = 0 }], \c => refusedWith (GrainScheduler::prepare (c.at, synth::PeriodicTiming(period = 4, jitter = 0), c.seed), "Invalid grain clock, interval, jitter or seed."))
        succeeds (GrainScheduler::prepare (0, synth::ExponentialTiming(mean = 10.0, maximum = 100), 1), \clock => succeeds (GrainScheduler::block (clock, 64), \onsets =>
            expect (structuralEquals (onsets.positions, [0, 1, 2, 12, 35]), true)
            expect (onsets.next.position == 64 && onsets.next.nextOnset == 70 && onsets.next.seed == 2078669041, true)))
        succeeds (GrainScheduler::prepare (9223372036854775743, synth::PeriodicTiming(period = 1048576, jitter = 0), 1), \late => refusedWith (GrainScheduler::block (late, 64), "The grain scheduler exhausted its onset clock."))
        refusedWith (GrainScheduler::block (synth::GrainClock(position = 0, nextOnset = 0, timing = synth::PeriodicTiming(period = 4, jitter = 0), seed = 1), 2049), "Invalid grain scheduler state or block size.")
        controls = grainControls synth::HannWindow
        forEachList (GrainScheduler::events ([3, 9], controls), \event => expect (structuralEquals (event.controls, controls) && (event.position == 3 || event.position == 9), true))
        expect (length (GrainScheduler::events ([3, 9], controls)), 2)))
    test ("variation streams, spreads and clouds refuse forged seeds, bounds and diverged clocks", \() => arithmetic (\() =>
        forEachList ([0, 2147483647, -5], \seed => refusedWith (GrainDistributions::seeded seed, "Invalid grain variation seed."))
        controls = grainControls synth::HannWindow
        ranges = synth::GrainDistribution(minimum = controls, maximum = controls)
        succeeds (GrainDistributions::seeded 7, \seeds =>
            // Unordered positions, a one-sample source, and a minimum above its maximum.
            forEachList ([{ at = [5, 3], within = ranges, size = 16 }, { at = [1], within = ranges, size = 1 }, { at = [1], within = synth::GrainDistribution(minimum = controls(start = 2.0), maximum = controls), size = 16 }], \c => refusedWith (GrainDistributions::events (c.at, c.within, c.size, seeds), "Invalid grain distribution bounds, sample positions or random seeds."))
            succeeds (GrainDistributions::events ([], ranges, 16, seeds), \none => expect (length none.events == 0 && structuralEquals (none.next, seeds), true)))
        still = synth::GrainSpread(position = 0.0, rate = 0.0, duration = 0, amplitude = 0.0, pan = 0.0)
        forEachList ([{ size = 16, spread = still(position = -1.0) }, { size = 1, spread = still }], \c => refusedWith (GrainSpreads::around (controls, c.size, c.spread), "Invalid grain variation center or spread."))
        source = [0.5, -0.5, 0.25, -0.25]
        periodic = synth::PeriodicTiming(period = 4, jitter = 0)
        refusedWith (GrainClouds::prepare ([0.5], 4, periodic, 1, 7), "Grains require 2–1048576 finite normalised mono samples and capacity 1–256.")
        refusedWith (GrainClouds::prepare (source, 4, periodic, 0, 7), "Invalid grain clock, interval, jitter or seed.")
        refusedWith (GrainClouds::prepare (source, 4, periodic, 1, 0), "Invalid grain variation seed.")
        succeeds (GrainClouds::prepare (source, 4, periodic, 1, 7), \cloud =>
            succeeds (GrainClouds::block (cloud, controls(start = 0.0, duration = 3), 8), \played =>
                expect (length played.left == 8 && length played.right == 8, true)
                expect (played.next.pool.position == 8 && played.next.clock.position == 8, true)
                watched = GrainClouds::observation played.next
                expect (watched.nextOnset == 8 && watched.playback.samplePosition == 8 && structuralEquals (watched.timing, periodic), true))
            clock = cloud.clock
            diverged = cloud(clock = clock(position = 4))
            expect (diverged.clock.position, 4)
            diverges (GrainClouds::block (diverged, controls, 8))
            diverges (GrainClouds::variedBlock (diverged, ranges, 8)))))
    test ("the grain graph module decodes whole controls and refuses fractional, unknown or foreign settings", \() => arithmetic (\() =>
        forEachList ([{ key = "period", value = 2.5, why = wholeCounts () }, { key = "duration", value = 7.5, why = wholeCounts () }, { key = "variationSeed", value = 1.5, why = wholeCounts () }, { key = "timing", value = 2.0, why = timingModes () }, { key = "window", value = 2.0, why = "Grain window must be 0 (Hann) or 1 (ASR)." }], \c => refusedWith (GrainGraph::prepare (retuned (c.key, c.value)), c.why))
        refusedWith (GrainGraph::prepare (Components::gain (1, 1.0)), "The component is not a grain cloud.")
        refusedWith (GrainGraph::prepare (retuned ("boundary", 0.5)), "Grain boundary must be 0 (loop) or 1 (one-shot).")
        refusedWith (GrainGraph::prepare (retuned ("regionEnd", 0.0)), "Invalid grain pool or source region.")
        original = granularNode ()
        legacy = original(parameters = filterList (original.parameters, \p => p.key != "regionStart" && p.key != "regionEnd" && p.key != "boundary"))
        succeeds (GrainGraph::prepare legacy, \cloud => expect (cloud.pool.region.first == 0 && cloud.pool.region.limit == length cloud.pool.source && cloud.pool.region.boundary == synth::LoopSource, true))
        partial = original(parameters = filterList (original.parameters, \p => p.key != "regionEnd"))
        refusedWith (GrainGraph::prepare partial, "Incomplete grain source region.")
        succeeds (GrainGraph::prepare (granularNode ()), \cloud =>
            forEachList ([{ n = Components::gain (1, 1.0), at = 0, ok = false }, { n = granularNode (), at = 0, ok = true }, { n = granularNode (), at = 1, ok = false }], \c => expect (GrainGraph::compatible (c.n, cloud, c.at), c.ok))
            forEachList ([{ key = "durationSpread", value = 0.5, why = wholeCounts () }, { key = "timing", value = 3.0, why = timingModes () }], \c => refusedWith (GrainGraph::block (retuned (c.key, c.value), cloud, 8), c.why)))
        hollow = synth::GrainPool(source = [], region = synth::GrainRegion(first = 0, limit = 0, boundary = synth::LoopSource), retiredSource = [], retiredBefore = 0, capacity = 1, voices = [], revision = 0, position = 0, nextIdentity = 0)
        forEachList ([synth::GrainBlock(left = [], right = [], next = hollow), synth::GrainBlock(left = [0.5], right = [], next = hollow)], \block => refusedWith (GrainGraph::interleaved block, "Grain output channels have invalid lengths."))))
    test ("direct grain pools reject bad triggers, count a full pool and render ordered single-frame blocks", \() => arithmetic (\() =>
        sourceJourneys ()
        controls = grainControls synth::HannWindow
        succeeds (Grains::prepare ([0.5, -0.5, 0.25, -0.25], 1), \pool =>
            refusedWith (Grains::trigger (pool, controls(duration = 2)), "Invalid grain source, controls or revision.")
            succeeds (Grains::trigger (pool, controls), \first =>
                expect (first.accepted && length first.pool.voices == 1 && first.pool.revision == 1 && first.pool.nextIdentity == 1, true)
                succeeds (Grains::trigger (first.pool, controls), \full =>
                    expect (full.accepted, false)
                    expect (structuralEquals (full.pool.voices, first.pool.voices) && full.pool.revision == 2 && full.pool.nextIdentity == 1, true)
                    watched = Grains::observation full.pool
                    expect (watched.requestedGrains == 2 && watched.acceptedGrains == 1 && watched.rejectedGrains == 1 && watched.activeGrains == 1, true)
                    // The held grain starts at age 0, where the Hann window is exactly zero.
                    succeeds (Grains::next full.pool, \one => expect (one.left == 0.0 && one.right == 0.0 && one.next.position == 1 && length one.next.voices == 1, true))
                    succeeds (Grains::block (full.pool, 3), \three => expect (length three.left == 3 && three.next.position == 3, true))))
            refusedWith (Grains::next (pool(position = 9223372036854775807)), "Invalid grain pool or exhausted sample clock.")
            refusedWith (Grains::block (pool, 0), "Invalid grain block size, clock or event capacity.")
            refusedWith (Grains::scheduled (pool, 4, [synth::GrainEvent(position = 2, controls = controls), synth::GrainEvent(position = 1, controls = controls)]), "Grain events must be ordered and belong to this block's half-open sample interval.")
            refusedWith (Grains::scheduled (pool, 4, [synth::GrainEvent(position = 4, controls = controls)]), "Grain events must be ordered and belong to this block's half-open sample interval."))))
