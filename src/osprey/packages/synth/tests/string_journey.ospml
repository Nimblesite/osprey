import synth::StringVoices
import synth::Activities


// [SYNTH-ADVANCED-PHYSICAL-INSTRUMENTS] The string pool's public journey: preparation, plucking,
// release tails, explicit stealing, typed refusals and preservation of untouched voices.

poolTemplate () = synth::WaveguideConfig(sampleRate = 48000.0, frequency = 220.0, decay = 4.0, brightness = 0.5, dispersion = 0.1, pickup = 0.2, capacity = 512)

poolPluck () = synth::ExciterConfig(strength = 0.8, duration = 32, interval = 0, excitation = synth::ImpulseExcitation)

poolBrush () = synth::ExciterConfig(strength = 0.7, duration = 32, interval = 0, excitation = synth::NoiseExcitation(colour = 0.4))

// One rendering step; an engine refusal fails the journey instead of hiding in the render.
poolStep run = match StringVoices::next run.pool
    Error _ =>
        unexpected ()
        run
    Success step => { pool = step.next, samples = listAppend run.samples step.sample }

poolRendered (pool, count) = foldList (toList (range (0, count)), { pool = pool, samples = [] }, \(run, _) => poolStep run)

poolEnergy samples = foldList (samples, 0.0, \(total, sample) => total + abs sample)

heldNotes pool = mapList (filterList (pool.voices, \voice => voice.active), \voice => voice.note)

releasingNotes pool = mapList (filterList (pool.voices, \voice => voice.releasing), \voice => voice.note)

pluckField (pool, note, read) = mapList (filterList (pool.voices, \voice => voice.active && voice.note == note), read)

// Preparation and every typed refusal at the public boundary.
poolRejections () =
    template = poolTemplate ()
    pluck = poolPluck ()
    forEachList ([1, 16], \count => succeeds (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), count, 0.01), \pool => expect (length pool.voices, count)))
    forEachList ([0, 17], \count => refusedAs (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), count, 0.05), configurationText, "A string pool needs 1-16 voices and a release of 0.01-10 s."))
    forEachList ([0.005, 10.5], \release => refusedAs (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), 2, release), configurationText, "A string pool needs 1-16 voices and a release of 0.01-10 s."))
    forEachList ([template(sampleRate = 4000.0), template(capacity = 4)], \bad => refusedAs (StringVoices::prepare (bad, (poolPluck ()), 2, 0.05), "capacity", "Invalid waveguide controls, or the tuned loop does not fit its capacity."))
    refusedAs (StringVoices::prepare ((poolTemplate ()), pluck(strength = 1.5), 2, 0.05), configurationText, "Invalid exciter strength, duration, interval or colour.")
    succeeds (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), 3, 0.05), \pool =>
        forEachList ([{ note = -1, velocity = 0.5, seed = 7 }, { note = 128, velocity = 0.5, seed = 7 }, { note = 60, velocity = -0.1, seed = 7 }, { note = 60, velocity = 1.1, seed = 7 }, { note = 60, velocity = 0.5, seed = 0 }, { note = 60, velocity = 0.5, seed = 2147483647 }], \bad =>
            refusedAs (StringVoices::noteOn (pool, bad.note, bad.velocity, 220.0, bad.seed), configurationText, "Note, velocity (0-1) or seed is out of range."))
        // A pitch the prepared loop cannot hold is refused, never truncated.
        refusedAs (StringVoices::noteOn (pool, 60, 0.5, 10.0, 7), "capacity", "Invalid waveguide controls, or the tuned loop does not fit its capacity."))

// One voice sounds after the delay comes around, releases on note-off and frees itself once its
// release T60 has elapsed; notes nobody holds leave the pool untouched.
poolRelease () =
    succeeds (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), 1, 0.05), \pool =>
        expect (heldNotes pool, [])
        idleActivity = Activities::strings pool
        idlePanel (idleActivity, 1)
        idle = poolRendered (pool, 8)
        sameStructure (idle.samples, synth::Sequences::zeros 8)
        succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 2147483646), \held =>
            expect (heldNotes held, [60])
            sameStructure (pluckField (held, 60, \voice => voice.velocity), [0.8])
            sameStructure (pluckField (held, 60, \voice => voice.config.frequency), [220.0])
            ringing = poolRendered (held, 300)
            activity = Activities::strings ringing.pool
            expect (activity.active, 1)
            expect (activity.stolen, 0)
            expect (activity.energy > 0.0, true)
            expect (poolEnergy (synth::Sequences::drop (ringing.samples, 150)) > 0.001, true)
            sameStructure (StringVoices::noteOff (ringing.pool, 61), ringing.pool)
            tail = poolRendered (StringVoices::noteOff (ringing.pool, 60), 10)
            expect (heldNotes tail.pool, [60])
            expect (releasingNotes tail.pool, [60])
            gone = poolRendered (tail.pool, 2500)
            expect (heldNotes gone.pool, [])
            expect ((Activities::strings gone.pool).active, 0)
            expect ((poolStep { pool = gone.pool, samples = [] }).samples, [0.0])))

// Stealing is explicit and ordered: a free voice first, then the voice released longest ago,
// then the oldest held voice; bystanders keep their note, velocity and age.
poolStealing () =
    succeeds (StringVoices::prepare ((poolTemplate ()), (poolPluck ()), 2, 0.05), \pool =>
        succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 7), \first =>
            aged = poolRendered (first, 10)
            sameStructure (pluckField (aged.pool, 60, \voice => voice.age), [10])
            succeeds (StringVoices::noteOn (aged.pool, 62, 0.5, 246.9417, 11), \second =>
                expect (heldNotes second, [60, 62])
                expect (second.stolen, 0)
                succeeds (StringVoices::noteOn (second, 64, 0.9, 293.6648, 13), \stolen =>
                    expect (heldNotes stolen, [64, 62])
                    expect (stolen.stolen, 1)
                    sameStructure (pluckField (stolen, 62, \voice => voice.velocity), [0.5])
                    sameStructure (pluckField (stolen, 62, \voice => voice.age), [0])
                    // The released voice (62) is stolen before the held one (64).
                    succeeds (StringVoices::noteOn (StringVoices::noteOff (stolen, 62), 65, 0.7, 349.2282, 17), \again =>
                        expect (heldNotes again, [64, 65])
                        expect (releasingNotes again, [])
                        expect (again.stolen, 2)))))
        succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 7), \first =>
            succeeds (StringVoices::noteOn (first, 60, 0.6, 220.0, 19), \twin =>
                expect (heldNotes twin, [60, 60])
                both = poolRendered (StringVoices::noteOff (twin, 60), 5)
                expect (heldNotes both.pool, [60, 60])
                expect (releasingNotes both.pool, [60, 60])
                freed = poolRendered (StringVoices::noteOff (twin, 60), 2500)
                expect (heldNotes freed.pool, []))))

// The noise seed makes each pluck reproducible: equal seeds render identical output, unequal seeds differ.
poolSeeded () =
    succeeds (StringVoices::prepare ((poolTemplate ()), (poolBrush ()), 1, 0.05), \pool =>
        succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 991), \held =>
            succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 991), \again =>
                sameStructure ((poolRendered (held, 400)).samples, (poolRendered (again, 400)).samples))
            succeeds (StringVoices::noteOn (pool, 60, 0.8, 220.0, 992), \other =>
                expect (structuralEquals ((poolRendered (held, 400)).samples, (poolRendered (other, 400)).samples), false))))

registerStringJourney () =
    test ("a string pool prepares and plucks voices, frees released tails, steals explicitly, refuses invalid control and preserves untouched voices", \() => arithmetic (\() =>
        poolRejections ()
        poolRelease ()
        poolStealing ()
        poolSeeded ()))
