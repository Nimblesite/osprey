import synth::Meshes

// [SYNTH-ADVANCED-PHYSICAL-INSTRUMENTS] A corner impulse crosses one grid edge per frame.
meshImpulse config =
    silent = Meshes::initial config
    adjacent = config(pickX = 1)
    gain = 0.25 / (1.0 + 6.907755278982137 / 8000.0)
    succeeds (Meshes::next (config, silent, 1.0), \strike =>
        expect (strike.sample, 1.0)
        expect (structuralEquals (strike.next.previous, silent.current), true)
        succeeds (Meshes::next (adjacent, strike.next, 0.0), \east => near (east.sample, gain, 0.000000000001))
        succeeds (Meshes::next (config(pickY = 1), strike.next, 0.0), \south => near (south.sample, gain, 0.000000000001))
        succeeds (Meshes::next (adjacent(pickY = 1), strike.next, 0.0), \diagonal => expect (diagonal.sample, 0.0)))
    renderRefused (Meshes::next (config(width = 2, height = 3), silent, 0.0))

registerMeshJourney () = test ("a corner impulse reaches adjacent membrane pickups before the diagonal and invalid grids are refused", \() => arithmetic (\() =>
    config = synth::MeshConfig(sampleRate = 8000.0, width = 2, height = 2, courant = 0.5, decay = 1.0, exciteX = 0, exciteY = 0, pickX = 0, pickY = 0)
    forEachList ([config(width = 1), config(height = 33), config(courant = 0.71), config(pickX = 2)], \invalid => renderRefused (Meshes::configure invalid))
    succeeds (Meshes::configure config, meshImpulse)))
