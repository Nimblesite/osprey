import synth::Ffts

// [SYNTH-DSP-PROOFS-PRODUCTION] Three impulses exercise both strided halves, including a
// negative time offset modulo N. Their direct Fourier sum needs no FFT or twiddle table.
fftImpulse (index, size) = match index
    1 => 0.75
    4 => -0.5
    _ => match index == size - 3
        true => 0.25
        false => 0.0

fftImpulseBin (index, size) =
    angle = -tau * toFloat index / toFloat size
    { re = 0.75 * cos angle - 0.5 * cos (4.0 * angle) + 0.25 * cos (-3.0 * angle), im = 0.75 * sin angle - 0.5 * sin (4.0 * angle) + 0.25 * sin (-3.0 * angle) }

fftImpulseJourney size =
    indices = toList (range (0, size))
    samples = mapList (indices, \i => fftImpulse (i, size))
    count = satAdd (intDiv size 2) 1
    succeeds (Ffts::forward samples, \bins =>
        expect (length bins, count)
        forEachList (toList (range (0, count)), \k => reads (listGet bins k, \bin =>
            direct = fftImpulseBin (k, size)
            near (bin.re, direct.re, 0.000000000001)
            near (bin.im, direct.im, 0.000000000001)))
        succeeds (Ffts::inverse (bins, size), \restored =>
            expect (length restored, size)
            forEachList (indices, \i => reads (listGet restored i, \actual => near (actual, fftImpulse (i, size), 0.000000000001)))))
