import synth::Components
import synth::Descriptors
import synth::Envelopes
import synth::Filters
import synth::Grains
import synth::Graphs
import synth::Observations
import synth::Oscillators
import synth::Parameters
import synth::Performance
import synth::Renderer
import synth::Sequences
import synth::SpectralStreams
import synth::Timings
import synth::Voice

// [SYNTH-PCM-FLOAT] Independent character search checks every ASCII decoder boundary.
hexDigitCase code =
    character = fromCodePoint code ?: "invalid"
    match indexOf "0123456789ABCDEF" character
        Error _ => renderRefused (synth::PcmWords::read32 ("0${character}000000", 0))
        Success digit => match synth::PcmWords::read32 ("0${character}000000", 0)
            Error _ => unexpected ()
            Success word => expect (word, digit)

arithmetic work =
    handle Arith
        overflow _ _ _ wrapped =>
            expect ("overflow", "valid arithmetic")
            wrapped
        divideByZero _ _ =>
            expect ("division by zero", "valid arithmetic")
            0.0
        remainderByZero _ =>
            expect ("remainder by zero", "valid arithmetic")
            0
    work ()

accepted outcome = match outcome
    synth::Valid graph => graph
    synth::Invalid _ =>
        expect (false, true)
        Graphs::empty

refused (outcome, expected) = match outcome
    synth::Invalid actual => expect (actual == expected, true)
    synth::Valid _ => unexpected ()

monoPort (name, rate, unit) = synth::Port(name = name, rate = rate, channels = 1, unit = unit)

audioClipFixture (identity, channels, samples) = synth::NodeClip(clipNode = identity, clipChannels = channels, clipSamples = samples, clipNotes = [])

missingPort () = synth::Port(name = "missing", rate = synth::Audio, channels = 0, unit = synth::Amplitude)

node (identity, processor, inputs, outputs) = synth::Node(identity = identity, processor = processor, inputs = inputs, outputs = outputs, parameters = [])

cable (source, destination) = synth::Cable(source = source, outlet = 0, destination = destination, inlet = 0)

// Rewiring whatever 1->2->3 chain onto the direct 1->3 cable.
bypass (graph) = accepted (Graphs::rewire (graph, cable (1, 3)))

valid (outcome, check) = match outcome
    synth::Valid value => check value
    synth::Invalid _ => unexpected ()

prepared (graph, count) = valid (Graphs::prepare graph, \plan => expect (length plan.order, count))

observed snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    expect (Observations::parameter (10, "cutoff") ?: -1.0, 440.0)
    expect (Observations::parameter (20, "cutoff") ?: -1.0, 880.0)
    succeeds (Observations::component 10, \component => expect (component.activeVoices, 3))
    renderRefused (Observations::component 99)
    renderRefused (Observations::parameter (30, "cutoff"))

// [SYNTH-DSP] Numerical isolation is required: these paths must not need a host, UI or device.

near (actual, expected, tolerance) = expect (abs (actual - expected) <= tolerance, true)

sameStructure (actual, expected) = expect (structuralEquals (actual, expected), true)

unexpected () = expect (false, true)

tau = 6.283185307179586

pi = 3.141592653589793

rate = 48000.0

sineWave (frequency, i) = sin (tau * frequency * toFloat i / rate)

// The sine of `x` whole turns.
turn x = sin (tau * x)

sineAt (gain, frequency, i) = gain * sineWave (frequency, i)

absSum samples = foldList (samples, 0.0, \(sum, value) => sum + abs value)

oscillator (rate, frequency, waveform) = synth::OscillatorConfig(sampleRate = rate, frequency = frequency, pulseWidth = 0.5, waveform = waveform)

sampleAt (config, phase) = (Oscillators::next (config, synth::OscillatorState(phase = phase))).sample

oscRun (config, initialState, count) = foldList (toList (range (0, count)), initialState, \(held, _) => (Oscillators::next (config, held)).next)

oscCase (rate, frequency, waveform) =
    config = oscillator (rate, frequency, waveform)
    succeeds (Oscillators::configure config, \accepted =>
        whole = oscRun (accepted, Oscillators::initial, 512)
        split = oscRun (accepted, oscRun (accepted, Oscillators::initial, 31), 481)
        near (whole.phase, split.phase, 0.000000000001)
        forEachList (toList (range (0, 128)), \i =>
            value = (Oscillators::next (accepted, synth::OscillatorState(phase = toFloat i / 128.0))).sample
            expect (value >= -1.01 && value <= 1.01, true)))

invalidOscillator config = renderRefused (Oscillators::configure config)

validEnvelope config = succeeds (Envelopes::configure config, \_ => expect (true, true))

invalidEnvelope config = renderRefused (Envelopes::configure config)

invalidFilter config = renderRefused (Filters::configure config)

oscFrequencies rate = forEachList ([0.0, 55.0, 440.0, 7000.0], \frequency => forEachList ([synth::Sine, synth::Saw, synth::Pulse, synth::Triangle], \wave => oscCase (rate, frequency, wave)))

envRun (config, initialState, count) = foldList (toList (range (0, count)), initialState, \(held, _) => Envelopes::next (config, held))

levelOf (envelope) = envelope.level

envelopeCase rate =
    config = synth::EnvelopeConfig(sampleRate = rate, attack = 4.0 / rate, decay = 4.0 / rate, sustain = 0.5, release = 4.0 / rate)
    started = Envelopes::noteOn (Envelopes::initial ())
    attack = envRun (config, started, 4)
    sustain = envRun (config, attack, 4)
    near (attack.level, 1.0, 0.000000001)
    near (sustain.level, 0.5, 0.000000001)
    near (levelOf (Envelopes::next (config, sustain)), 0.5, 0.000000001)
    releasing = Envelopes::noteOff (config, sustain)
    near ((envRun (config, releasing, 4)).level, 0.0, 0.000000001)
    near ((Envelopes::noteOff (config, releasing)).releaseStep, releasing.releaseStep, 0.0)
    early = envRun (config, started, 2)
    near ((Envelopes::noteOn early).level, early.level, 0.0)
    near ((envRun (config, Envelopes::noteOff (config, early), 4)).level, 0.0, 0.000000001)

filterRun (coefficients, initialState, count, input) = foldList (toList (range (0, count)), initialState, \(held, _) => (Filters::next (coefficients, held, input)).next)

filterCase (rate, cutoff, resonance) =
    config = synth::FilterConfig(sampleRate = rate, cutoff = cutoff, resonance = resonance)
    succeeds (Filters::configure config, \c =>
        settled = filterRun (c, Filters::initial, 4096, 1.0)
        output = Filters::next (c, settled, 1.0)
        near (output.low, 1.0, 0.0001)
        near (output.high, 0.0, 0.0001)
        split = filterRun (c, filterRun (c, Filters::initial, 127, 1.0), 3969, 1.0)
        near (settled.integratorOne, split.integratorOne, 0.0)
        near (settled.integratorTwo, split.integratorTwo, 0.0)
        faded = filterRun (c, settled, 4096, 0.0)
        near (faded.integratorTwo, 0.0, 0.0001))

parameter key = synth::Parameter(key = key, label = "Cutoff", unit = synth::Hertz, minimum = 20.0, maximum = 20000.0, initial = 440.0, automatable = true)

readValue snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    Observations::parameter (1, "cutoff") ?: -1.0

// The extracted reference voice is also exercised independently of Prism's UI dependencies.
referencePatch wave = synth::Patch(pitch = 220.0, sounding = true, filtered = true, wave = wave, cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.75)

referenceCase wave =
    p = referencePatch wave
    samples = Voice::samples p
    expect (length samples, Voice::rate)
    expect (Voice::peak samples > 0, true)
    expect (startsWith (Voice::wav samples) "52494646", true)
    forEachList ([p(sounding = false), p(audible = false), p(volume = 0.0)], \silent => near (Voice::sample (silent, 5), 0.0, 0.0))
    expect (Voice::describe p != Voice::describe (p(filtered = false)), true)
    expect (Voice::sample (p(filtered = false), 5) != Voice::sample (p, 5), true)

planFor graph = match Graphs::prepare graph
    synth::Valid plan => plan
    synth::Invalid _ =>
        expect (false, true)
        synth::Prepared(graph = Graphs::empty, order = [], feedback = [])

rendered result = match result
    Success block => block
    Error why =>
        print (synth::Faults::detail why)
        expect (false, true)
        synth::Rendered(states = [], samples = [], position = 0, meters = [])

renderRefused result = match result
    Success _ => unexpected ()
    Error _ => expect (true, true)

// [SYNTH-RENDER-BLOCKS] The switches the editor stores on a module, as one more parameter.
switched (n, key, high, value) = n(parameters = listAppend n.parameters (synth::Parameter(key = key, label = key, unit = synth::Ratio, minimum = 0.0, maximum = high, initial = value, automatable = true)))

disabled (n) = switched (n, "enabled", 1.0, 0.0)

// One 64-frame offline clip of `graph`'s output node 3.
clipOf graph = match synth::GraphClips::advance (graph, [], 64)
    Success action => clipReady3 action
    Error why => Error(message = why)

clipReady3 action = match action
    synth::ClipWaiting _ _ _ => Error(message = synth::InvalidConfiguration(detail = "A built-in graph asked for a plug-in."))
    synth::ClipReady clips => synth::ClipInputs::completed (clips, 3)

// A sine through a low-pass whose cutoff inlet an LFO drives.
switchedRender (oscillator, filter, lfo) = clipOf (built ([oscillator, filter, lfo, Components::output 3], [cable (1, 2), Components::route (4, 0, 2, 1), cable (2, 3)]))

clipSamples outcome = match outcome
    Success clip => clip.clipSamples
    Error why =>
        expect (synth::Faults::detail why, "a rendered clip")
        []

switchedSamples (oscillator, filter, lfo) = clipSamples (switchedRender (oscillator, filter, lfo))

plainLowpass () = clipSamples (clipOf (sineFiltered (1000.0, 0.7)))

built (nodes, cables) = wired (cables, added (nodes, Graphs::empty))

added (nodes, graph) = foldList (nodes, graph, \(g, n) => accepted (Graphs::add (g, n)))

wired (cables, graph) = foldList (cables, graph, \(g, c) => accepted (Graphs::connect (g, c)))

// The usual oscillator-to-output route 1 -> 2 -> 3.
chainRoute () = [cable (1, 2), cable (2, 3)]

serial (nodes) = built (nodes, chainRoute ())

sineThrough (gain) = serial ([Components::sine (1, 440.0), Components::gain (2, gain), Components::output 3])

sineFiltered (cutoff, resonance) = serial ([Components::sine (1, 440.0), Components::lowpass (2, cutoff, resonance), Components::output 3])

sineChain () = sineThrough (0.25)

blockOf (graph, frames) = rendered (Renderer::block (planFor graph, rate, Parameters::initial graph, rendered (Renderer::start graph), frames))

renderBlock (plan, parameters, prior, frames) = rendered (Renderer::block (plan, rate, parameters, prior, frames))

running (graph) = { plan = planFor graph, parameters = Parameters::initial graph, start = rendered (Renderer::start graph) }

sameSamples (actual, expected) =
    expect (length actual, length expected)
    forEachList (toList (range (0, length expected)), \i => near (listGet actual i ?: -999.0, listGet expected i ?: -888.0, 0.00000000001))

energetic (samples, count) =
    expect (length samples, count)
    expect (absSum samples > 1.0, true)

// [SYNTH-ADVANCED-LEARNED] Independent, licensed evaluation data does not influence the fitted gain.
fitGainJourney (graph, samples) =
    source = synth::FitSource(identifier = "sine fixture", licence = "generated fixture", sampleRate = 48000)
    training = synth::FitReference(source = source, samples = samples)
    evaluation = synth::FitReference(source = source(identifier = "silent fixture"), samples = mapList (samples, \_ => 0.0))
    config = synth::FitConfig(parameters = [synth::FitParameter(node = 2, key = "gain", minimum = 0.0, maximum = 1.0)], seed = 17, evaluations = 1, tolerance = 0.0001)
    refusedWith (synth::FitReports::fit (graph, config, training, training), "Training and evaluation need distinct source identities and sample data.")
    forEachList ([source(licence = ""), source(identifier = ""), source(sampleRate = 44100)], \bad => refusedWith (synth::FitReports::fit (graph, config, training, evaluation(source = bad)), "Fit references need labelled, licensed, finite mono clips at 48 kHz and a supported FFT length."))
    succeeds (synth::FitReports::fit (graph, config, training, evaluation), \report =>
        expect (report.result.evaluations == 1 && report.evaluationLoss > report.result.best.loss, true)
        expect (structuralEquals (report.training, training.source) && structuralEquals (report.evaluation, evaluation.source), true)
        expect ("${report.algorithm} ${report.algorithmLicence}", "osprey-synth/log-spectrum-es-v1 MIT")
        sameStructure (report.config, config))

feedbackExpected (samples, i) =
    previous = match i >= 2
        true => listGet samples (satSub i 2) ?: -999.0
        false => 0.0
    expected = 0.5 * (sineWave (440.0, i) + previous)
    near (listGet samples i ?: -888.0, expected, 0.00000000001)

metersObserved snapshot =
    handle static Signal<synth::Observation>
        read => snapshot
    expect ((Observations::snapshot ()).samplePosition, 128)
    succeeds (Observations::component 3, \meter =>
        expect (meter.peak <= 0.25 && meter.peak > 0.24, true)
        expect (meter.rms > 0.1 && meter.rms < 0.25, true))

// [SYNTH-ADVANCED-CORE-PORTS] Same-frame events apply in their given order, and any block split gives the same audio.
splitAt (plan, snapshot, first, events, cut) = match Renderer::automated (plan, 48000.0, snapshot, first, cut, filterList (events, \e => e.samplePosition < cut))
    Error why => Error(message = why)
    Success head => synth::Outcomes::carried (Renderer::automated (plan, 48000.0, head.observation, head.audio, satSub 64 cut, filterList (events, \e => e.samplePosition >= cut)), \tail => Success(value = listConcat head.audio.samples tail.audio.samples))

performanceCase (rate, instrument, amount) = forEachList (toList (range (0, 128)), \frame =>
    sample = Performance::wave (instrument, toFloat frame * 0.0078125, 740.0 / rate, amount, amount)
    expect (sample >= -1.000001 && sample <= 1.000001, true))

// [SYNTH-GRAPH-CHANNELS] Unlimited-channel journeys: split, join and route carry every channel exactly.
portOf (name, channels) = synth::Port(name = name, rate = synth::Audio, channels = channels, unit = synth::Amplitude)

channelSource (identity, channels) =
    base = Components::additive (identity, 220.0)
    base(outputs = [portOf ("audio", channels)])

sinkOf (identity, channels) =
    base = Components::output identity
    base(inputs = [portOf ("audio", channels)])

scaleOf index = (toFloat index + 1.0) * 0.05

// [SYNTH-GRAPH-CHANNELS] The panner moves a mono note across the ordered outputs at constant power.
pannerJourney (width, pan) =
    nodes = [Components::sine (1, 440.0), Components::panner (2, width, pan), sinkOf (3, width)]
    succeeds (clipsOf (built (nodes, [cable (1, 2), cable (2, 3)]), 12), \clips =>
        dry = clipFrom (clips, 1)
        out = clipFrom (clips, 3)
        expect (out.clipChannels, width)
        forEachList (toList (range (1, 12)), \frame =>
            input = channelOf (dry, frame, 0)
            energy = foldList (toList (range (0, width)), 0.0, \(total, channel) =>
                sample = channelOf (out, frame, channel)
                total + sample * sample)
            near (energy, input * input, 0.000000000001)
            forEachList (toList (range (0, width)), \channel =>
                distance = abs (toFloat channel - (pan + 1.0) * 0.5 * toFloat (width - 1))
                match distance >= 1.0
                    true => near (channelOf (out, frame, channel), 0.0, 0.0)
                    false => near (channelOf (out, frame, channel), input * cos (1.5707963267948966 * distance), 0.000000000001))))

// A distinct-channel chain: `count`-channel source -> split -> one gain per channel -> join.
channelChain (source, split, firstGain, join, count) =
    gains = mapList (toList (range (0, count)), \index => Components::gain (satAdd firstGain index, scaleOf index))
    listAppend (listConcat [channelSource (source, count), Components::split (split, count)] gains) (Components::join (join, count))

channelCables (source, split, firstGain, join, count) =
    fanOut = mapList (toList (range (0, count)), \index => Components::route (split, index, satAdd firstGain index, 0))
    fanIn = mapList (toList (range (0, count)), \index => Components::route (satAdd firstGain index, 0, join, index))
    listConcat (listConcat [cable (source, split)] fanOut) fanIn

clipsOf (graph, frames) = match synth::GraphClips::advance (graph, [], frames)
    Success action => match action
        synth::ClipReady clips => Success(value = clips)
        synth::ClipWaiting _ _ => Error(message = synth::InvalidConfiguration(detail = "A built-in graph asked for a plug-in."))
    Error why => Error(message = why)

clipFrom (clips, identity) = match synth::ClipInputs::completed (clips, identity)
    Success clip => clip
    Error why =>
        expect (synth::Faults::detail why, "a rendered node clip")
        audioClipFixture (identity, 0, [])

channelOf (clip, frame, channel) = listGet clip.clipSamples (satAdd (satMul frame clip.clipChannels) channel) ?: 999.0

// [SYNTH-ADVANCED-CORE-MODELS] A graph output that is NaN, infinite or past 10^6 is an error, never published audio.
refusedOutput value = refusedAs (synth::RenderInputs::sample (framed value, 4), "numerical", "Non-finite or excessive graph output.")

framed value = synth::SampleFrame(states = [], values = [synth::NodeSample(identity = 4, value = value)])

// [SYNTH-ADVANCED-CORE-PORTS] Every parameter of every component maps a 0–1 control onto its declared range and
// back: 0 is the minimum, 1 the maximum, the round trip returns the control, and the mapping only rises.
adapted () = [Components::sine (1, 440.0), Components::lowpass (2, 1000.0, 0.7), Components::modulatedLowpass (3, 1000.0, 0.7), Components::gain (4, 0.5), Components::delay (5, 480), Components::midiNote (6, 60.0, 0.8, 6000.0), Components::lfo (7, 2.0), Components::modulatedGain (8, 2, 0.5), Components::exciter (9, 1), Components::resonator (10, 440.0), Components::modalBank (11, 220.0, 1.0), Components::waveguide (12, 220.0, 2400), Components::fractionalDelay (13, 4.5, 64), Components::lossFilter (14, 0.99, 0.5), Components::allpass (15, 0.5), Components::additive (16, 220.0), Components::spectral (17, 1024, 256, 0.0), Components::shaper (18, 0.0, 2.0), Components::reverb (19, 2.0), Components::shifter (20, 100.0), Components::phaseOperator (21, 220.0, 0.0), Components::bowed (22, 220.0, 2400), Components::smoother (23, 0.01), Components::strikeComb (24, 220.0, 2400)]

// [SYNTH-ADVANCED-CORE-MODELS] A stored processor has a stable name and version; keyboard tuning follows its kind.
storedProcessor (processor, name, version, pitched) =
    expect (synth::Kinds::kind processor, name)
    expect (synth::Kinds::version processor, version)
    expect (synth::Kinds::keyFrequency processor, pitched)
    expect (synth::Kinds::compatible (processor, name, version), true)
    expect (synth::Kinds::compatible (processor, name, version + 1), false)
    expect (synth::Kinds::compatible (processor, "other", version), false)

storedProcessors nodes =
    names = ["oscillator", "filter", "filter", "gain", "delay", "midi-notes", "lfo", "modulated-gain", "exciter", "resonator", "modal-bank", "waveguide", "fractional-delay", "loss-filter", "allpass", "additive", "spectral", "shaper", "fdn-reverb", "frequency-shifter", "phase-operator", "bowed-string", "smoother", "strike-comb", "mixer", "output", "stereo", "downmix", "output", "split", "join", "route"]
    expect (length nodes, length names)
    forEachList (toList (range (0, length names)), \i => reads (listGet names i, \name => reads (listGet nodes i, \n =>
        version = match name == "modal-bank" || name == "resonator"
            true => 2
            false => 1
        pitched = length (filterList (["oscillator", "resonator", "modal-bank", "waveguide", "additive", "phase-operator", "bowed-string", "strike-comb"], \kind => kind == name)) == 1
        storedProcessor (n.processor, "synth.${name}", version, pitched))))
    source = grainFlatSource ()
    storedProcessor (synth::SamplePlayer(resource = source), "synth.sample", 1, false)
    storedProcessor (synth::Granular(resource = source, capacity = 2, seed = 7), "synth.grain-cloud", 1, false)
    storedProcessor (synth::Panner, "synth.panner", 1, false)
    storedProcessor (synth::External(identifier = "vendor.module", latency = 80), "external:vendor.module", 1, false)
    succeeds (synth::Wavetables::prepare (64, [synth::TableSpectrum(amplitudes = [1.0], phases = [0.0])]), \table => storedProcessor (synth::TableOscillator(table = table), "synth.wavetable", 1, true))

controls () = [0.0, 0.001, 0.1, 0.25, 0.5, 0.75, 0.9, 0.999, 1.0]

closeEnough (got, want, scale) = expect (abs (got - want) <= 0.000000001 * (1.0 + abs scale), true)

adapter p =
    closeEnough (Descriptors::fromControl (p, 0.0), p.minimum, p.maximum)
    closeEnough (Descriptors::fromControl (p, 1.0), p.maximum, p.maximum)
    forEachList (controls (), \c => closeEnough (Descriptors::toControl (p, Descriptors::fromControl (p, c)), c, 1.0))
    forEachList (controls (), \c => expect (Descriptors::fromControl (p, c) >= p.minimum - 0.000000001 * (1.0 + abs p.minimum) && Descriptors::fromControl (p, c) <= p.maximum + 0.000000001 * (1.0 + abs p.maximum), true))
    forEachList (toList (range (1, length (controls ()))), \i => expect (Descriptors::fromControl (p, listGet (controls ()) i ?: 1.0) >= Descriptors::fromControl (p, listGet (controls ()) (satSub i 1) ?: 0.0), true))
    closeEnough (Descriptors::toControl (p, p.initial), Descriptors::toControl (p, Descriptors::fromControl (p, Descriptors::toControl (p, p.initial))), 1.0)

// [SYNTH-ADVANCED-CORE-PORTS] Every component declares each port's rate, channel count and unit coherently: audio
// carries amplitude on 1 or more channels, control inlets are one normalised channel, events are one channel of notes,
// and names are unique on each side.
coherent port = match port.rate
    synth::Audio => port.unit == synth::Amplitude && port.channels >= 1
    synth::Control => port.unit == synth::Normalised && port.channels == 1
    synth::Events => port.unit == synth::Notes && port.channels == 1

uniqueNames ports = length (filterList (ports, \p => length (filterList (ports, \q => q.name == p.name)) == 1)) == length ports

declared n =
    expect (length (filterList (listConcat n.inputs n.outputs, coherent)), length n.inputs + length n.outputs)
    expect (uniqueNames n.inputs, true)
    expect (uniqueNames n.outputs, true)
    expect (length n.outputs >= 1 || n.processor == synth::Sink, true)
    forEachList (listConcat n.inputs n.outputs, \p => expect (p.name != "", true))

// [SYNTH-ADVANCED-CORE-SIGNALS] A controller write is Pending until resolved, then Applied with the new revision or
// Rejected with its typed fault; only an applied write changes the audible snapshot.

appliedAt (receipt, revision) = match receipt.status
    synth::Applied at => expect (at, revision)
    _ => expect ("not applied", "applied")

rejectedWith (receipt, fault) = match receipt.status
    synth::Rejected why => expect (why, fault)
    _ => expect ("not rejected", "rejected")

stillPending (receipt, edit) = match receipt.status
    synth::Pending waiting => expect (waiting, edit)
    _ => expect ("not pending", "pending")

// [SYNTH-ADVANCED-GRAINS-PLAYBACK] One grain on a constant source shows its window: zero at both ends, the Hann peak
// or ASR sustain in the middle, a three-frame grain, silence after the grain ends, and the same audio for any block split.

flat () = mapList (toList (range (0, 64)), \_ => 1.0)

held (window, duration, pan) = synth::GrainControls(window = window, start = 10.0, rate = 0.0, duration = duration, amplitude = 1.0, pan = pan)

centre = 0.7071067811865476

oneGrain (controls, frames, check) = succeeds (Grains::prepare (flat (), 4), \pool => succeeds (Grains::trigger (pool, controls), \admitted => succeeds (Grains::block (admitted.pool, frames), check)))

frameAt (samples, index) = listGet samples index ?: -9.0

hann9 block =
    expect (length block.left, 16)
    near (frameAt (block.left, 0), 0.0, 0.0)
    near (frameAt (block.left, 8), 0.0, 0.0)
    near (frameAt (block.left, 4), centre, 0.000000000001)
    forEachList (toList (range (0, 9)), \k => near (frameAt (block.left, k), centre * (sin (pi * toFloat k / 8.0) * sin (pi * toFloat k / 8.0)), 0.000000000001))
    // cos and sin of π/4 differ in the last bit, so the centred sides agree to 1e-15, not bit for bit.
    forEachList (toList (range (0, 16)), \k => near (frameAt (block.left, k), frameAt (block.right, k), 0.000000000000001))
    forEachList (toList (range (9, 16)), \k => near (frameAt (block.left, k), 0.0, 0.0))
    expect (length block.next.voices, 0)

asr9 block =
    // 8 intervals: attack 2, sustain 4, release 2.
    forEachList ([{ k = 0, v = 0.0 }, { k = 1, v = 0.5 }, { k = 2, v = 1.0 }, { k = 4, v = 1.0 }, { k = 6, v = 1.0 }, { k = 7, v = 0.5 }, { k = 8, v = 0.0 }], \p => near (frameAt (block.left, p.k), centre * p.v, 0.000000000001))

short3 block =
    near (frameAt (block.left, 0), 0.0, 0.0)
    near (frameAt (block.left, 1), centre, 0.000000000001)
    near (frameAt (block.left, 2), 0.0, 0.0)
    expect (length block.next.voices, 0)

hardLeft block =
    near (frameAt (block.left, 4), 1.0, 0.000000000001)
    near (frameAt (block.right, 4), 0.0, 0.000000000001)

// Sixteen one-frame blocks render exactly the samples of one sixteen-frame block.
stepped (outcome, _) = match outcome
    Error why => Error(message = why)
    Success run => match Grains::block (run.pool, 1)
        Error why => Error(message = why)
        Success b => Success(value = { pool = b.next, left = listConcat run.left b.left, right = listConcat run.right b.right })

partitioned (controls, whole) = succeeds (Grains::prepare (flat (), 4), \pool => succeeds (Grains::trigger (pool, controls), \admitted =>
    succeeds (foldList (toList (range (0, 16)), Success(value = { pool = admitted.pool, left = [], right = [] }), stepped), \run =>
        sameStructure (run.left, whole.left)
        sameStructure (run.right, whole.right))))

// A later trigger with other controls (here silent, ASR, hard right) leaves a sounding grain's own settings alone.
retained whole = succeeds (Grains::prepare (flat (), 4), \pool => succeeds (Grains::trigger (pool, held (synth::HannWindow, 9, 0.0)), \first =>
    succeeds (Grains::block (first.pool, 4), \head => succeeds (Grains::trigger (head.next, synth::GrainControls(window = synth::AsrWindow(attack = 0.5, release = 0.5), start = 20.0, rate = 2.0, duration = 5, amplitude = 0.0, pan = 1.0)), \second =>
        succeeds (Grains::block (second.pool, 12), \tail => sameStructure (listConcat head.left tail.left, whole.left))))))

// [SYNTH-ADVANCED-SPECTRAL-PITCH] The pitch shifter is the phase-vocoder spectral node, preset and bounded.
shifterKeyed (found, p, key) = match p.key == key
    true => p.initial
    false => found

shifterValue (n, key) = foldList (n.parameters, -1.0, \(found, p) => shifterKeyed (found, p, key))

// A sine through a 64-point spectral shift of `bins` bins, rendered for one 64-frame clip.
shiftedBy bins =
    shift = Components::spectral (2, 64, 16, 3.0)
    clipOf (built ([Components::sine (1, 440.0), shift(parameters = mapList (shift.parameters, \p => shiftSet (p, bins))), Components::output 3], [cable (1, 2), cable (2, 3)]))

shiftSet (p, bins) = match p.key == "shift"
    true => p(initial = bins)
    false => p

renders outcome = match outcome
    Success _ => true
    Error why =>
        print "# ${synth::Faults::detail why}"
        false

// Adversarial review 2026-11-21 [SYNTH-ADVANCED-CORE-RESOURCES]: the spectral tail undercounted its decay, a fractional
// shift was truncated, the shift dial spanned ±2047 at every size and block accumulation was quadratic.
spectralSizes = [64, 128, 256, 512, 1024, 2048, 4096]

// Latency size − 1 and tail 2 · (size − 1), which outlasts latency plus a hop, for both spectral nodes at every size.
spectralTimed size =
    most = toFloat (satSub (intDiv size 2) 1)
    whole = toFloat (satSub size 1)
    forEachList ([Components::spectral (4, size, intDiv size 4, 3.0), Components::pitchShifter (5, size, 7.0, 25.0)], \n =>
        succeeds (Timings::latency n, \late => expect (late, whole))
        succeeds (Timings::tail n, \held => expect ("${held} ${held >= whole + toFloat (intDiv size 4)}", "${2.0 * whole} true")))
    expect (SpectralStreams::tail size, satMul 2 (satSub size 1))
    expect (SpectralStreams::latency size, satSub size 1)
    expect (length (filterList ((Components::spectral (2, size, intDiv size 4, 3.0)).parameters, \p => p.key == "shift" && p.minimum == 0.0 - most && p.maximum == most)), 1)

// At 64 points the dial's ends ±31 play, ±32 and the old ±2047 are refused, and no fraction is ever truncated.
shiftEdges () =
    forEachList ([31.0, -31.0, 30.0, 10.0, -3.0, 1.0, -1.0, 0.0], \bins => expect ("${bins}: ${playedBy (shiftedBy bins)}", "${bins}: plays"))
    forEachList ([31.0, -31.0, 0.0], \bins => expect (length ((accepted (shiftAdded bins)).nodes), 1))
    forEachList ([32.0, -32.0, 2047.0, -2047.0], \bins => refused (shiftAdded bins, synth::InvalidParameter))
    forEachList ([10.7, -0.5, 0.25, 0.999, -30.5, 0.000001, 30.0001, -0.0001, 1.5], \bins => expect ("${bins}: ${playedBy (shiftedBy bins)}", "${bins}: Spectral shift must be a whole number of bins."))

shiftAdded bins =
    shift = Components::spectral (2, 64, 16, 3.0)
    Graphs::add (Graphs::empty, shift(parameters = mapList (shift.parameters, \p => shiftSet (p, bins))))

playedBy outcome = match outcome
    Success _ => "plays"
    Error why => synth::Faults::detail why

// Flattening `blocks` blocks of `size` keeps every value in order; 2000 × 256 would take minutes if joining copied.
joinedHolds (blocks, size) =
    whole = Sequences::flattened (mapList (toList (range (0, blocks)), \b => mapList (toList (range (0, size)), \i => satAdd (satMul b size) i)))
    total = satMul blocks size
    expect (length whole, total)
    forEachList (filterList ([0, 1, intDiv total 2, satSub total 1], \i => i < total), \i => expect (listGet whole i ?: -1, i))

blocksJoined () =
    forEachList ([{ blocks = 1, size = 1 }, { blocks = 1, size = 7 }, { blocks = 7, size = 1 }, { blocks = 3, size = 5 }, { blocks = 300, size = 1024 }, { blocks = 2000, size = 256 }], \c => joinedHolds (c.blocks, c.size))
    expect (length (Sequences::joined ([9, 8], [])), 2)
    expect (listGet (Sequences::joined ([], [4, 5])) 1 ?: -1, 5)
    expect (listGet (Sequences::joined ([1, 2], [3, 4, 5])) 2 ?: -1, 3)
    floatsJoined ()

// Floats, strings and records flatten to their own values: a name-passed generic once punned floats as int bits.
floatsJoined () =
    floats = Sequences::flattened [[1.5, 2.0], [], [3.0], [-0.25, 0.000001, 48000.0]]
    expect (length floats, 6)
    forEachList ([{ at = 0, want = 1.5 }, { at = 1, want = 2.0 }, { at = 2, want = 3.0 }, { at = 3, want = -0.25 }, { at = 4, want = 0.000001 }, { at = 5, want = 48000.0 }], \c => expect (listGet floats c.at ?: 0.0, c.want))
    words = Sequences::flattened [["a", "bc"], ["d"]]
    expect (join (words, "|"), "a|bc|d")
    records = Sequences::flattened [[{ level = 0.5, name = "low" }], [{ level = 2.25, name = "high" }]]
    expect (length records, 2)
    expect (foldList (records, 0.0, \(sum, r) => sum + r.level), 2.75)
    expect (join (mapList (records, \r => r.name), ","), "low,high")
    appended = Sequences::joined ([0.125], [0.5, 0.75])
    expect (listGet appended 0 ?: 0.0, 0.125)
    expect (listGet appended 2 ?: 0.0, 0.75)
