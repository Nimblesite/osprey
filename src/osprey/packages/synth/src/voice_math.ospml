// Filter reference: Zavalishin, "The Art of VA Filter Design", trapezoidal SVF.
namespace synth

(** Reference voice and state-variable filter mathematics [SYNTH-VOICE] [SYNTH-DSP]. *)
module VoiceMath
    (** Half a turn in radians.
    # Examples
    ```osprey
    print "${VoiceMath::pi}"
    ```
    ```output
    3.141592653589793
    ```
    *)
    export pi = 3.141592653589793

    (** One turn in radians.
    # Examples
    ```osprey
    print "${VoiceMath::tau}"
    ```
    ```output
    6.283185307179586
    ```
    *)
    export tau = 6.283185307179586

    (** Prewarped integrator gain `tan (π fc / fs)`.
    # Examples
    ```osprey
    print "${VoiceMath::warped (12000.0, 48000.0)}"
    ```
    ```output
    0.9999999999999999
    ```
    *)
    export warped (cutoff, sampleRate) = floatDiv (sin (floatDiv (pi * cutoff, sampleRate)), cos (floatDiv (pi * cutoff, sampleRate)))

    (** Damping `k = 1 / Q`.
    # Examples
    ```osprey
    print "${VoiceMath::damping 0.5} ${VoiceMath::damping 2.0}"
    ```
    ```output
    2.0 0.5
    ```
    *)
    export damping resonance = floatDiv (1.0, resonance)

    (** First state-variable filter coefficient.
    # Examples
    ```osprey
    print "${VoiceMath::gainOne (1.0, 0.0)} ${VoiceMath::gainOne (1.0, 2.0)}"
    ```
    ```output
    0.5 0.25
    ```
    *)
    export gainOne (g, k) = floatDiv (1.0, 1.0 + g * (g + k))

    (** Second state-variable filter coefficient.
    # Examples
    ```osprey
    print "${VoiceMath::gainTwo (1.0, 2.0)} ${VoiceMath::gainTwo (2.0, 0.0)}"
    ```
    ```output
    0.25 0.4
    ```
    *)
    export gainTwo (g, k: float) = g * gainOne (g, k)

    (** Third state-variable filter coefficient.
    # Examples
    ```osprey
    print "${VoiceMath::gainThree (1.0, 2.0)} ${VoiceMath::gainThree (2.0, 0.0)}"
    ```
    ```output
    0.25 0.8
    ```
    *)
    export gainThree (g: float, k: float) = g * g * gainOne (g, k)

    (** Compute the band-pass response of the filter.
    # Examples
    ```osprey
    print "${VoiceMath::bandpass (0.5, 0.5, 0.25, 0.125, 0.5)}"
    ```
    ```output
    0.3125
    ```
    *)
    export bandpass (a1: float, a2, one, two, input) = a1 * one + a2 * (input - two)

    (** Compute the low-pass response of the filter.
    # Examples
    ```osprey
    print "${VoiceMath::lowpass (0.5, 0.5, 0.25, 0.125, 0.5)}"
    ```
    ```output
    0.4375
    ```
    *)
    export lowpass (a2: float, a3, one, two, input) = two + a2 * one + a3 * (input - two)

    (** Compute the high-pass response of the filter.
    # Examples
    ```osprey
    print "${VoiceMath::highpass (0.5, 0.5, 0.25, 0.125)}"
    ```
    ```output
    0.25
    ```
    *)
    export highpass (k: float, input, b, l) = input - k * b - l

    (** Trapezoidal integrator update `2 v − s`.
    # Examples
    ```osprey
    print "${VoiceMath::integrated (0.75, 0.25)}"
    ```
    ```output
    1.25
    ```
    *)
    export integrated (out, held) = 2.0 * out - held

    (** MIDI key number from octave, semitone and sharp offset.
    # Examples
    ```osprey
    print "${VoiceMath::midiKey (4, 9, 0)} ${VoiceMath::midiKey (4, 9, -1)}"
    ```
    ```output
    69.0 68.0
    ```
    *)
    export midiKey (octave, semitone, sharp) = 12.0 * (octave + 1.0) + semitone + sharp

    (** LFO-swept cutoff at sample `n`.
    # Examples
    ```osprey
    print "${VoiceMath::swept (1000.0, 1.0, 2.0, 2.0, 0, 48000.0)}"
    ```
    ```output
    1000.0
    ```
    *)
    export swept (cutoff, depth, octaves, lfo, n, rate) = cutoff * pow (2.0, depth * octaves * sin (floatDiv (tau * lfo * n, rate)))

    (** Two-pole Butterworth low-pass magnitude at `pitch`.
    # Examples
    ```osprey
    print "${VoiceMath::butterworth (1000.0, 1000.0)}"
    ```
    ```output
    0.7071067811865475
    ```
    *)
    export butterworth (pitch, cutoff) = floatDiv (1.0, sqrt (1.0 + pow (floatDiv (pitch, cutoff), 4.0)))

    (** Naive (aliasing) triangle and saw, as the reference voice draws them; `Waves` has the band-limited ones.
    # Examples
    ```osprey
    print "${VoiceMath::triangle 0.25} ${VoiceMath::triangle 0.5}"
    ```
    ```output
    0.0 1.0
    ```
    *)
    export triangle t = 1.0 - 4.0 * abs (t - 0.5)

    (** Evaluate the normalized sawtooth waveform.
    # Examples
    ```osprey
    print "${VoiceMath::saw 0.25} ${VoiceMath::saw 0.75}"
    ```
    ```output
    -0.5 0.5
    ```
    *)
    export saw t = 2.0 * t - 1.0

    (** A 0–1 cutoff knob swept exponentially from 20 Hz to 20 kHz.
    # Examples
    ```osprey
    print "${VoiceMath::knobCutoff 0.0} ${VoiceMath::knobCutoff 0.5} ${VoiceMath::knobCutoff 1.0}"
    ```
    ```output
    20.0 632.4555320336758 20000.0
    ```
    *)
    export knobCutoff amount = 20.0 * pow (1000.0, amount)
