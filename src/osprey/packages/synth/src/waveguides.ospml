// [SYNTH-ADVANCED-PHYSICAL-INSTRUMENTS] Single-delay-loop string: delay line, loss filter and allpass composed.
namespace synth

(** Karplus–Strong/Smith waveguide; the loop gain comes from a 60 dB decay time, so it cannot grow. *)
module Waveguides
    loss config = LossConfig(gain = PhysicalMath::decayGain (config.decay, config.sampleRate / config.frequency, config.sampleRate), brightness = config.brightness)

    (** The read delay that tunes the loop after the loss and low-frequency allpass delays.
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    print "${Waveguides::delay config} ${Waveguides::delay (config(frequency = 100.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export delay config = PhysicalMath::loopDelay (config.frequency, config.sampleRate, PhysicalMath::smoothing config.brightness, config.dispersion)

    valid config = config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && config.frequency >= 20.0 && config.frequency < config.sampleRate * 0.45 && config.decay >= 0.01 && config.decay <= 60.0 && config.brightness >= 0.0 && config.brightness <= 1.0 && config.dispersion >= -0.95 && config.dispersion <= 0.95 && config.pickup >= 0.0 && config.pickup <= 0.5 && config.capacity >= 4 && config.capacity <= 96000

    (** The tuned loop must fit the prepared line; re-prepare after a sample-rate change.
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    print "${Waveguides::configure config} ${Waveguides::configure (config(capacity = 3))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export configure config = match valid config && delay config >= 2.0 && delay config <= toFloat (config.capacity - 1)
        true => Success(value = config)
        false => Error(message = ExhaustedCapacity(detail = "Invalid waveguide controls, or the tuned loop does not fit its capacity."))

    (** Allocate the loop outside rendering.
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    print "${Waveguides::initial config}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export initial config = Outcomes::carried (DelayLines::prepare config.capacity, \line => Success(value = WaveguideState(line = line, loss = LossFilters::initial, dispersion = Allpasses::initial)))

    // A pickup at fraction p of the string is the comb `y[n] - y[n - pD]` (zero disables it).
    picked (pickup, tuning, line, read) = match pickup == 0.0
        true => Success(value = read)
        false => match DelayLines::tap (line, tuning * (1.0 - pickup))
            Error why => Error(message = why)
            Success earlier => Success(value = read - earlier)

    looped (attenuation, dispersion, held, input, read, output) =
        lost = LossFilters::next (attenuation, held.loss, read)
        dispersed = Allpasses::next (dispersion, held.dispersion, lost.sample)
        WaveguideSample(sample = output, next = WaveguideState(line = DelayLines::push (held.line, PhysicalMath::flushed (input + dispersed.sample)), loss = lost.next, dispersion = dispersed.next))

    (** One sample: excitation enters the loop; frequency edits keep the stored line (energy is re-tuned).
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    held = WaveguideState(line = DelayLine(samples = [0.0, 0.0, 0.0, 0.0]), loss = LossFilters::initial, dispersion = Allpasses::initial)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Waveguides::next (config, held, 1.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export next (config, held, input) = advance (delay config, config.pickup, loss config, config.dispersion, held, input)

    (** Derive fixed tuning and attenuation from a validated configuration.
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    print "${(Waveguides::coefficients config).tuning} ${(Waveguides::coefficients config).dispersion}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export coefficients config = GuideCoefficients(tuning = delay config, pickup = config.pickup, attenuation = loss config, dispersion = config.dispersion)

    (** Advance the feedback loop using the current tuning and attenuation.
    # Examples
    ```osprey
    held = WaveguideState(line = DelayLine(samples = [0.0, 0.0, 0.0, 0.0]), loss = LossFilters::initial, dispersion = Allpasses::initial)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Waveguides::advance (3.416666666666667, 0.0, LossConfig(gain = 0.999, brightness = 0.5), 0.5, held, 1.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export advance (tuning, pickup, attenuation, dispersion, held, input) = match DelayLines::tap (held.line, tuning)
        Error why => Error(message = why)
        Success read => Outcomes::carried (picked (pickup, tuning, held.line, read), \output => Success(value = looped (attenuation, dispersion, held, input, read, output)))

    (** Sample-rate change: tuning and T60 are recomputed from the new configuration, and the stored loop
        is resampled (linear) into the new capacity, so a sounding string keeps its pitch and decay.
    # Examples
    ```osprey
    config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    held = WaveguideState(line = DelayLine(samples = [0.0, 0.0, 0.0, 0.0]), loss = LossFilters::initial, dispersion = Allpasses::initial)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Waveguides::transferred (config, held, config(sampleRate = 96000.0)))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export transferred (from, held, to) = match configure to
        Error why => Error(message = why)
        Success accepted => Outcomes::carried (DelayLines::resampled (held.line, from.sampleRate, accepted.sampleRate, accepted.capacity), \line => Success(value = held(line = line)))

