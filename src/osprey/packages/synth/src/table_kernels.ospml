// [SYNTH-ADVANCED-TABLES] Graph adapters for wavetable and additive sources over the shared kernel state.
namespace synth


(** Sources read declared parameters each sample; state lives in the kernel's phase and storage. *)
module TableKernels
    tabled (table, frame, held, configured) =
        use config <- Outcomes::carried (configured)
        use step <- Outcomes::carried (Wavetables::next (table, config, WavetableState(phase = held.phase)))
        Success(value = RenderInputs::emitted (frame, held(phase = step.next.phase), step.sample))

    replaced (_base, control) = control

    scaled (base, control) = base * control

    pitched (base, control) = base * TableMath::octaveScale (control, 2.0)

    modulatedTable (rate, plan, frame, held, table, frequency, position, amplitude) =
        use place <- Outcomes::carried (RenderInputs::controlled (plan, frame, held.identity, 0, position, \(base, control) => replaced (base, control)))
        use level <- Outcomes::carried (RenderInputs::controlled (plan, frame, held.identity, 1, amplitude, \(base, control) => scaled (base, control)))
        use pitch <- Outcomes::carried (RenderInputs::controlled (plan, frame, held.identity, 2, frequency, \(base, control) => pitched (base, control)))
        use offset <- Outcomes::carried (RenderInputs::controlled (plan, frame, held.identity, 3, 0.0, \(base, control) => replaced (base, control)))
        tabled (table, frame, held, Wavetables::configure (WavetableConfig(sampleRate = rate, frequency = pitch, position = place, amplitude = level, phase = offset)))

    (** A wavetable source: phase is the cycle position. Optional inlets: `position` replaces the position,
        `amplitude` multiplies the level, `pitch` scales frequency by ±2 octaves (0.5 unchanged) and
        `phase` offsets the read point by 0–1 cycles.
    # Examples
    ```osprey
    held = KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)
    table = Wavetable(size = 4, harmonics = 1, frames = [TableFrame(levels = [TableLevel(harmonics = 1, samples = [0.0, 1.0, 0.0, -1.0])])])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => TableKernels::wavetable (48000.0, Prepared(graph = Graphs::empty, order = [], feedback = []), Parameters::initial Graphs::empty, SampleFrame(states = [], values = []), held, table))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export wavetable (rate, plan, snapshot, frame, held, table) =
        use frequency <- RenderInputs::bound (snapshot, held, "frequency")
        use position <- RenderInputs::bound (snapshot, held, "position")
        use amplitude <- RenderInputs::bound (snapshot, held, "amplitude")
        modulatedTable (rate, plan, frame, held, table, frequency, position, amplitude)

    // A positive interval restarts every partial envelope at that exact sample period.
    restarted (held, interval) = match interval > 0.0 && held.integratorOne + 1.0 >= interval
        true => 0.0
        false => held.integratorOne + 1.0

    played (frame, held, bank, coefficients) =
        use step <- Outcomes::carried (PartialBanks::withCoefficients (bank.config, coefficients, PartialState(phases = held.delay, age = held.phase)))
        interval = bank.interval
        cycle = restarted (held, interval)
        age = match cycle == 0.0 && interval > 0.0
            true => 0.0
            false => step.next.age
        Success(value = RenderInputs::emitted (frame, held(delay = step.next.phases, phase = age, integratorOne = cycle), step.sample))

    shaped (rate, frequency, count, tilt, parity, decay, damping, amplitude, inharmonicity, stretch) = PartialBanks::configure (PartialConfig(sampleRate = rate, frequency = frequency, count = count, tilt = tilt, parity = parity, decay = decay, damping = damping, amplitude = amplitude, layout = StiffLayout(inharmonicity = inharmonicity, stretch = stretch)))

    bank (interval, configured) = match interval >= 0.0 && interval <= 1048576.0
        false => Error(message = InvalidConfiguration(detail = "Retrigger interval must be 0 to 1048576 samples."))
        true => Outcomes::carried (configured, \config => Success(value = PartialSettings(interval = interval, config = config)))

    settings (rate, snapshot, identity) =
        use frequency <- RenderInputs::setting (snapshot, identity, "frequency")
        use count <- RenderInputs::setting (snapshot, identity, "partials")
        use tilt <- RenderInputs::setting (snapshot, identity, "tilt")
        use parity <- RenderInputs::setting (snapshot, identity, "parity")
        use decay <- RenderInputs::setting (snapshot, identity, "decay")
        use damping <- RenderInputs::setting (snapshot, identity, "damping")
        use amplitude <- RenderInputs::setting (snapshot, identity, "amplitude")
        use inharmonicity <- RenderInputs::setting (snapshot, identity, "inharmonicity")
        use stretch <- RenderInputs::setting (snapshot, identity, "stretch")
        use interval <- RenderInputs::setting (snapshot, identity, "interval")
        bank (interval, shaped (rate, frequency, count, tilt, parity, decay, damping, amplitude, inharmonicity, stretch))

    (** Prepare the additive bank when the block uses a fixed control snapshot.
    # Examples
    ```osprey
    print "${TableKernels::prepare (48000.0, Parameters::initial Graphs::empty, 1)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export prepare (rate, snapshot, identity) = match settings (rate, snapshot, identity)
        Error _ => DynamicPartials
        Success bank => match bank.config.layout
            StiffLayout stiffness stretch => FixedPartials(settings = bank, coefficients = PartialBanks::stiffCoefficients (bank.config, stiffness, stretch))
            _ => DynamicPartials

    (** An additive source: storage holds partial phases, phase the envelope age, integratorOne the retrigger clock.
    # Examples
    ```osprey
    held = KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => TableKernels::additive (48000.0, Parameters::initial Graphs::empty, SampleFrame(states = [], values = []), held))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export additive (rate, snapshot, frame, held) = Outcomes::carried (settings (rate, snapshot, held.identity), \bank => played (frame, held, bank, []))

    (** Fixed snapshots reuse the prepared bank; automation resolves settings at its exact sample.
    # Examples
    ```osprey
    held = KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => TableKernels::scheduled (48000.0, Parameters::initial Graphs::empty, SampleFrame(states = [], values = []), held, FixedPartials(settings = PartialSettings(interval = 0.0, config = PartialConfig(sampleRate = 48000.0, frequency = 220.0, count = 4.0, tilt = 1.0, parity = 0.0, decay = 1.0, damping = 0.0, amplitude = 0.5, layout = StiffLayout(inharmonicity = 0.0, stretch = 1.0))), coefficients = [])))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export scheduled (rate, snapshot, frame, held, prepared) = match prepared
        DynamicPartials => additive (rate, snapshot, frame, held)
        FixedPartials settings coefficients => played (frame, held, settings, coefficients)
