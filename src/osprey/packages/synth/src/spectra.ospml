// [DAW-ANALYSIS-SPECTRUM] Octave-band spectrum of a whole signal from Hann-windowed FFT frames.
namespace synth

(** Ten octave bands centred 31.25 Hz to 16 kHz. A frame of `size` samples starts every `hop`; each band's
    level is its mean power over every frame and its peak the loudest frame, both in dB where a full-scale sine
    reads 0. A signal shorter than one frame is read as one zero-padded frame. Formulas: spectral_math.ospml. *)
module Spectra
    (** The bands' centre frequencies in Hz, one octave apart.
    # Examples
    ```osprey
    print "${Spectra::centres}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export centres = [31.25, 62.5, 125.0, 250.0, 500.0, 1000.0, 2000.0, 4000.0, 8000.0, 16000.0]

    frame (samples, size, start) = mapList (toList (range (0, size)), \i => SpectralMath::windowedSample (listGet samples (satAdd start i) ?: 0.0, toFloat i, toFloat size))

    // One band's summed bin power in one frame.
    banded (powers, rate, size, centre) = foldList (toList (range (0, length powers)), 0.0, \(sum, k) => included (sum, listGet powers k ?: 0.0, SpectralMath::inOctave (SpectralMath::binFrequency (toFloat k, toFloat size, rate), centre)))

    included (sum, power, inside) = match inside
        true => sum + power
        false => sum

    // Every band's power in the frame starting at `start`.
    framed (samples, rate, size, start) = Outcomes::carried (Ffts::forward (frame (samples, size, start)), \bins =>
        powers = mapList (bins, \bin => SpectralMath::power (bin.re, bin.im))
        Success(value = mapList (centres, \centre => banded (powers, rate, size, centre))))

    starts (count, size, hop) = match count > size
        true => toList (range (0, satAdd (intDiv (satSub count size) hop) 1))
        false => [0]

    collected (samples, rate, size, hop) = foldList (starts (length samples, size, hop), Success(value = []), \(outcome, index) => Outcomes::carried (outcome, \done => Outcomes::carried (framed (samples, rate, size, satMul index hop), \bands => Success(value = listAppend done bands))))

    // Band `band` across frames: mean and loudest power, as levels.
    summary (frames, size, band, centre) =
        powers = mapList (frames, \bands => listGet bands band ?: 0.0)
        total = foldList (powers, 0.0, \(sum, power) => sum + power)
        SpectrumBand(centre = centre, level = SpectralMath::bandLevel (total, toFloat (length powers), toFloat size), peak = SpectralMath::bandLevel (foldList (powers, 0.0, \(high, value) => max high value), 1.0, toFloat size))

    valid (rate, size, hop) = Ffts::valid size && hop >= 1 && rate >= 8000.0 && rate <= 384000.0

    (** The octave-band spectrum of `samples` at `rate`, from `size`-point frames (64–4096, a power of two)
        every `hop` samples.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Spectra::bands ([], 48000.0, 100, 16))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export bands (samples, rate, size, hop) = match valid (rate, size, hop)
        false => Error(message = InvalidConfiguration(detail = "A spectrum needs a power-of-two frame of 64 to 4096, a hop of at least 1 and a rate of 8 to 384 kHz."))
        true => Outcomes::carried (collected (samples, rate, size, hop), \frames => Success(value = Sequences::mapIndexed (centres, \(band, centre) => summary (frames, size, band, centre))))
