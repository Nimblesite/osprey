// [SYNTH-HOST-MIDI] Sample-positioned note events for graph-connected instruments.
namespace synth

(** Deterministic MIDI note sources; no host, clock or UI dependency. *)
module MidiClips
    value (n, key) = match listGet (filterList (n.parameters, \p => p.key == key)) 0
        Error _ => Error(message = "The MIDI generator is missing a required parameter.")
        Success p => Success(value = p.initial)

    integer (value, low, high) = match value >= low && value <= high
        false => Error(message = "The MIDI generator parameter is outside its range.")
        true => match floatToInt value
            Error why => Error(message = why)
            Success count => match toFloat count == value
                false => Error(message = "MIDI pitch and gate frames must be whole numbers.")
                true => Success(value = count)

    events (identity, pitch, velocity, gate) =
        on = HostNote(kind = 1, offset = 0, pitch = pitch, channel = 0, identity = identity, velocity = velocity)
        [on, on(kind = 2, offset = gate, velocity = 0.0)]

    velocity (n, pitch, gate) = match value (n, "velocity")
        Error why => Error(message = why)
        Success strength => match strength >= 0.0 && strength <= 1.0
            false => Error(message = "MIDI velocity must be between zero and one.")
            true => Success(value = events (n.identity, pitch, strength, gate))

    whole (n, key, low, high) = match value (n, key)
        Error why => Error(message = why)
        Success number => integer (number, low, high)

    configured n = match whole (n, "pitch", 0.0, 127.0)
        Error why => Error(message = why)
        Success pitch => match whole (n, "gateFrames", 1.0, 65535.0)
            Error why => Error(message = why)
            Success gate => velocity (n, pitch, gate)

    (** Render a half-open sample window; partitioning cannot duplicate or drop a note-off. *)
    export window (n, first, count) = match n.processor == MidiNotes && n.identity >= 0 && n.identity <= 2147483647 && first >= 0 && count > 0 && first <= satSub 65536 count
        false => Error(message = "Invalid MIDI generator or sample window.")
        true => match configured n
            Error why => Error(message = why)
            Success notes => Success(value = mapList (filterList (notes, \note => note.offset >= first && note.offset < satAdd first count), \note => note(offset = satSub note.offset first)))
