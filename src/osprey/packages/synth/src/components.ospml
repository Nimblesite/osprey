// [SYNTH-GRAPH] UI-free factories: their descriptors can drive a UI but contain no widgets.
namespace synth

(** Composable reference components with named parameters and typed ports. *)
module Components
    port name = Port(name = name, rate = Audio, channels = 1, unit = Amplitude)

    parameter (key, label, unit, low, high, value) = Parameter(key = key, label = label, unit = unit, minimum = low, maximum = high, initial = value, automatable = true)

    node (identity, processor, inputs, outputs, parameters) = Node(identity = identity, processor = processor, inputs = inputs, outputs = outputs, parameters = parameters)

    (** Sine oscillator. Its frequency is a parameter, separate from its phase state. *)
    export sine (identity, frequency) = node (identity, Oscillator, [Port(name = "midi", rate = Events, channels = 1, unit = Notes)], [port "audio"], [parameter ("frequency", "Frequency", Hertz, 0.0, 19000.0, frequency), parameter ("releaseFrames", "MIDI release (frames at 48 kHz)", Ratio, 2.0, 480000.0, 240.0)])

    (** Stateful low-pass with cutoff in Hz and resonance expressed as Q. *)
    export lowpass (identity, cutoff, resonance) = node (identity, Filter, [port "audio"], [port "audio"], [parameter ("cutoff", "Cutoff", Hertz, 1.0, 19000.0, cutoff), parameter ("resonance", "Resonance (Q)", Ratio, 0.1, 20.0, resonance)])

    (** The optional normalized cutoff inlet scales the cutoff parameter; unplugged retains it. *)
    export modulatedLowpass (identity, cutoff, resonance) =
        base = lowpass (identity, cutoff, resonance)
        base(inputs = listAppend base.inputs (Port(name = "cutoff", rate = Control, channels = 1, unit = Normalised)))

    (** Linear gain; values above unity are explicit and may exceed output headroom. *)
    export gain (identity, level) = node (identity, Amplifier, [port "audio"], [port "audio"], [parameter ("gain", "Gain", Amplitude, 0.0, 8.0, level)])

    (** Two audio inputs are summed without implicit attenuation or clipping. *)
    export mixer identity = node (identity, Mixer, [port "first", port "second"], [port "audio"], [])

    (** A mono graph output. *)
    export output identity = node (identity, Sink, [port "audio"], [], [])

    (** Explicit sample delay; feedback scheduling reads it before writing the next sample. *)
    export delay (identity, count) = node (identity, Delay(samples = count), [port "audio"], [port "audio"], [])

    (** A note-on/off generator; gate length is an exact sample count at the render rate. *)
    export midiNote (identity, pitch, velocity, gateFrames) = node (identity, MidiNotes, [], [Port(name = "notes", rate = Events, channels = 1, unit = Notes)], [parameter ("pitch", "Pitch", Notes, 0.0, 127.0, pitch), parameter ("velocity", "Velocity", Normalised, 0.0, 1.0, velocity), parameter ("gateFrames", "Gate (frames)", Ratio, 1.0, 65535.0, gateFrames)])

    (** Explicit mono-to-stereo duplication; routing never changes channel counts implicitly. *)
    export stereo identity = node (identity, Stereo, [port "audio"], [Port(name = "audio", rate = Audio, channels = 2, unit = Amplitude)], [])

    (** A stereo graph output for native instruments and effects. *)
    export stereoOutput identity = node (identity, Sink, [Port(name = "audio", rate = Audio, channels = 2, unit = Amplitude)], [], [])

    control () = Port(name = "control", rate = Control, channels = 1, unit = Normalised)

    (** A normalized sine LFO, routed independently of any audio source. *)
    export lfo (identity, frequency) = node (identity, Lfo, [], [control ()], [parameter ("frequency", "Frequency", Hertz, 0.0, 20.0, frequency)])

    (** One control signal applies equally to every audio channel. *)
    export modulatedGain (identity, channels, level) =
        audio = Port(name = "audio", rate = Audio, channels = channels, unit = Amplitude)
        node (identity, ModulatedGain, [audio, control ()], [audio], [parameter ("gain", "Gain", Amplitude, 0.0, 8.0, level)])

    (** Stereo grain cloud with an immutable mono source; timing parameters are exact sample counts at 48 kHz. *)
    export granular (identity, resource, capacity, seed) = node (identity, Granular(resource = resource, capacity = capacity, seed = seed), [], [Port(name = "audio", rate = Audio, channels = 2, unit = Amplitude)], [parameter ("start", "Source position (samples)", Ratio, 0.0, toFloat (satSub (length resource.samples) 1), 0.0), parameter ("rate", "Playback rate", Ratio, -16.0, 16.0, WaveMath::playbackRate (toFloat resource.sampleRate, 48000.0, resource.rootFrequency, resource.rootFrequency)), parameter ("duration", "Grain length (frames)", Ratio, 3.0, 65536.0, 4800.0), parameter ("gain", "Grain gain", Amplitude, 0.0, 1.0, 0.15), parameter ("pan", "Pan", Ratio, -1.0, 1.0, 0.0), parameter ("period", "Onset interval / mean (frames)", Ratio, 1.0, 1048576.0, 2400.0), parameter ("jitter", "Timing jitter (frames)", Ratio, 0.0, 1048575.0, 600.0), parameter ("window", "Window (0 Hann, 1 ASR)", Ratio, 0.0, 1.0, 0.0), parameter ("attack", "Grain attack (fraction)", Ratio, 0.000001, 0.999999, 0.25), parameter ("release", "Grain release (fraction)", Ratio, 0.000001, 0.999999, 0.25), parameter ("timing", "Timing (0 jitter, 1 exponential)", Ratio, 0.0, 1.0, 0.0), parameter ("maximumGap", "Maximum exponential gap (frames)", Ratio, 1.0, 1048576.0, 9600.0), parameter ("positionSpread", "Position spread (samples)", Ratio, 0.0, toFloat (satSub (length resource.samples) 1), 0.0), parameter ("rateSpread", "Playback rate spread", Ratio, 0.0, 32.0, 0.0), parameter ("durationSpread", "Duration spread (frames)", Ratio, 0.0, 65533.0, 0.0), parameter ("gainSpread", "Gain spread", Ratio, 0.0, 1.0, 0.0), parameter ("panSpread", "Pan spread", Ratio, 0.0, 2.0, 0.0), parameter ("variationSeed", "Variation seed (restart)", Ratio, 1.0, 2147483646.0, toFloat seed)])

    (** One typed connection; graph validation checks both endpoints. *)
    export route (source, outlet, destination, inlet) = Cable(source = source, outlet = outlet, destination = destination, inlet = inlet)
