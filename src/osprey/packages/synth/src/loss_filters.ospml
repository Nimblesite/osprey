// [SYNTH-ADVANCED-PHYSICAL-PRIMITIVES] Frequency-dependent loop loss, independent of any delay line.
namespace synth

(** `gain * ((1 - s) x[n] + s x[n-1])` with `s = (1 - brightness) / 2`; its magnitude never exceeds `gain`. *)
module LossFilters
    (** Silent history.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        print "${LossFilters::initial.previous}"

    arithmetic example
    ```
    ```output
    0.0
    ```
    *)
    export initial = LossState(previous = 0.0)

    (** Gain is linear 0–1 so a feedback loop cannot gain energy; brightness is 0 (darkest) to 1 (flat).
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        print "${LossFilters::configure (LossConfig(gain = 0.9, brightness = 0.5))} ${LossFilters::configure (LossConfig(gain = 1.5, brightness = 0.5))}"

    arithmetic example
    ```
    ```output
    Success({ gain: 0.9, brightness: 0.5 }) Error(InvalidConfiguration { detail: "Loss gain and brightness must be between zero and one." })
    ```
    *)
    export configure config = match config.gain >= 0.0 && config.gain <= 1.0 && config.brightness >= 0.0 && config.brightness <= 1.0
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Loss gain and brightness must be between zero and one."))

    (** One step with an accepted configuration.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        config = LossConfig(gain = 0.5, brightness = 0.0)
        first = LossFilters::next (config, LossFilters::initial, 1.0)
        second = LossFilters::next (config, first.next, 0.0)
        print "${first.sample} ${second.sample}"

    arithmetic example
    ```
    ```output
    0.25 0.25
    ```
    *)
    export next (config, held, input) = LossSample(sample = PhysicalMath::loss (input, held.previous, config.gain, PhysicalMath::smoothing config.brightness), next = LossState(previous = input))
