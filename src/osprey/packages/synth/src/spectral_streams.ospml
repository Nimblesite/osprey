// [SYNTH-ADVANCED-SPECTRAL-CORE] Streaming STFT: Hann analysis, transformation, Hann synthesis, overlap-add.
namespace synth

(** Latency is `size - 1` samples; the dry path reads the same delayed sample, so `mix` is phase-aligned. *)
module SpectralStreams
    transformValid config = match config.transform
        SpectralPass => true
        SpectralFreeze _ => true
        SpectralBand low high => low >= 0.0 && low < high && high <= config.sampleRate * 0.5
        SpectralShift bins => bins > satSub 0 (intDiv config.size 2) && bins < intDiv config.size 2
        SpectralSmear amount => amount >= 0.0 && amount <= 0.999
        SpectralMorph amount _ => amount >= 0.0 && amount <= 1.0
        SpectralPitch ratio formant => ratio >= 0.25 && ratio <= 4.0 && formant >= 0.25 && formant <= 4.0
        SpectralSeries steps => SpectralFrames::compatible steps && length (filterList (steps, \step => transformValid (config(transform = step)))) == length steps

    (** Size 64–4,096 (power of two), hop size/4 or size/8, mix 0 (dry) to 1 (processed).
    # Examples
    ```osprey
    config = SpectralConfig(sampleRate = 48000.0, size = 64, hop = 16, transform = SpectralPass, mix = 1.0)
    print "${SpectralStreams::configure config} ${SpectralStreams::configure (config(hop = 60))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && Ffts::valid config.size && (config.hop == intDiv config.size 4 || config.hop == intDiv config.size 8) && config.mix >= 0.0 && config.mix <= 1.0 && transformValid config
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Invalid spectral rate, size, hop, mix or transformation range."))

    (** Algorithmic latency in samples of a transform of `size`, for aligning parallel routes.
    # Examples
    ```osprey
    print "${SpectralStreams::latency 256} ${SpectralStreams::latency 64}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export latency size = satSub size 1

    (** Tail in samples after input stops: the last frame holding the final input sample ends up to `size − 1`
        samples later and resynthesises a whole window, emitted over `size − 1` more; past `2 · (size − 1)` the
        output is exactly silent. Freeze keeps sounding until released.
    # Examples
    ```osprey
    print "${SpectralStreams::tail 64}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export tail size = satMul 2 (satSub size 1)

    silent config = mapList (toList (range (0, satAdd (intDiv config.size 2) 1)), \_ => Complex(re = 0.0, im = 0.0))

    (** Transport discontinuity policy: analysis buffers restart silent and the hop clock restarts, while the
        overlap-add output (the already-synthesised tail), a held freeze capture and synthesis phases continue,
        so a jump never clicks from discarded output; pitch-shift frequency estimates settle after one frame.
    # Examples
    ```osprey
    config = SpectralConfig(sampleRate = 48000.0, size = 64, hop = 16, transform = SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    moved = SpectralStreams::relocated (config, held(frames = 3))
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => moved.countdown)} ${arithmetic (\() => moved.frames)} ${arithmetic (\() => listLength moved.input)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export relocated (config, held) = held(input = Sequences::zeros config.size, side = Sequences::zeros config.size, countdown = config.hop)

    (** Silent buffers; the first frame completes after one hop.
    # Examples
    ```osprey
    config = SpectralConfig(sampleRate = 48000.0, size = 64, hop = 16, transform = SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => held.countdown)} ${arithmetic (\() => listLength held.output)} ${arithmetic (\() => listLength held.memory)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export initial config = SpectralState(input = Sequences::zeros config.size, side = Sequences::zeros config.size, output = Sequences::zeros config.size, memory = silent config, motion = silent config, countdown = config.hop, frames = 0, captured = false)

    windowed (samples, size) = Sequences::mapIndexed (samples, \(index, value) => value * SpectralMath::hann (toFloat index, toFloat size))

    // Only morphing analyses the side input; other transformations ignore it.
    sides (config, side) = match config.transform
        SpectralMorph _ _ => Ffts::forward (windowed (side, config.size))
        SpectralSeries steps => match length (filterList (steps, \step => morphing step)) == 0
            true => Success(value = [])
            false => Ffts::forward (windowed (side, config.size))
        _ => Success(value = [])

    morphing step = match step
        SpectralMorph _ _ => true
        _ => false

    overlapScale (size, hop) = 8.0 * hop / (3.0 * size)

    overlapped (sum, value, scale) = sum + value * scale

    synthesised (config, held, frame) = match Ffts::inverse (frame.bins, config.size)
        Error why => Error(message = why)
        Success samples =>
            scale = overlapScale (toFloat config.size, toFloat config.hop)
            added = Sequences::combined (held.output, windowed (samples, config.size), \(sum, value) => overlapped (sum, value, scale))
            Success(value = held(output = added, memory = frame.memory, motion = frame.motion, captured = frame.captured, frames = satAdd held.frames 1, countdown = config.hop))

    processed (config, held) = match Ffts::forward (windowed (held.input, config.size))
        Error why => Error(message = why)
        Success bins => match sides (config, held.side)
            Error why => Error(message = why)
            Success other => Outcomes::carried (SpectralFrames::apply (config, bins, other, held), \frame => synthesised (config, held, frame))

    framed (config, held) = match held.countdown <= 0
        true => processed (config, held)
        false => Success(value = held)

    valid (config, held) = length held.input == config.size && length held.side == config.size && length held.output == config.size && length held.memory == satAdd (intDiv config.size 2) 1 && length held.motion == length held.memory && held.countdown >= 1 && held.countdown <= config.hop

    emitted (config, held) = match held.output
        [] => Error(message = MissingResource(detail = "Spectral output buffer is empty."))
        [wet, ...rest] => match held.input
            [] => Error(message = MissingResource(detail = "Spectral input buffer is empty."))
            [dry, ..._older] => Success(value = SpectralSample(sample = Interpolation::linear (dry, wet, config.mix), next = held(output = listAppend rest 0.0)))

    (** One sample of main and side input; a frame is analysed and overlap-added every hop.
    # Examples
    ```osprey
    config = SpectralConfig(sampleRate = 48000.0, size = 64, hop = 16, transform = SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => SpectralStreams::next (config, held(countdown = 0), 0.0, 0.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export next (config, held, input, side) = match valid (config, held)
        false => Error(message = IncompatibleLayout(detail = "Spectral state does not match its configuration."))
        true => Outcomes::carried (framed (config, held(input = Sequences::shifted (held.input, input), side = Sequences::shifted (held.side, side), countdown = satSub held.countdown 1)), \advanced => emitted (config, advanced))

    bin (config, index, value) = SpectralBin(index = index, frequency = SpectralMath::binFrequency (toFloat index, toFloat config.size, config.sampleRate), magnitude = SpectralMath::magnitude (value.re, value.im), re = SpectralMath::unitRe (value.re, value.im), im = SpectralMath::unitIm (value.re, value.im))

    (** A typed snapshot of the current analysis window for observers: channel, the absolute sample
        position of its newest input, bin frequencies, magnitudes and unit phase phasors. Compute it off
        the audio thread; it allocates a transform.
    # Examples
    ```osprey
    config = SpectralConfig(sampleRate = 48000.0, size = 64, hop = 16, transform = SpectralPass, mix = 1.0)
    held = SpectralStreams::initial config
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => SpectralStreams::view (config, held(input = []), 0, 0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export view (config, held, channel, position) = Outcomes::carried (Ffts::forward (windowed (held.input, config.size)), \bins => Success(value = SpectralView(channel = channel, position = position, size = config.size, bins = Sequences::mapIndexed (bins, \(index, value) => bin (config, index, value)))))

