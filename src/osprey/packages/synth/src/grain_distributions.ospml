// [SYNTH-ADVANCED-GRAINS-DISTRIBUTIONS] Independent parameter streams compose with any onset scheduler.
namespace synth

(** Bounded uniform grain variations with separately retained random streams per parameter. *)
module GrainDistributions
    seedValues seeds = [seeds.position, seeds.rate, seeds.duration, seeds.amplitude, seeds.pan]

    seedsValid seeds = length (filterList (seedValues seeds, \s => s >= 1 && s <= 2147483646)) == 5

    rangesValid (size, ranges) =
        a = ranges.minimum
        b = ranges.maximum
        Grains::controls (size, a) && Grains::controls (size, b) && structuralEquals (a.window, b.window) && a.start <= b.start && a.rate <= b.rate && a.duration <= b.duration && a.amplitude <= b.amplitude && a.pan <= b.pan

    appendSeed (outcome, number) = match outcome
        Error why => Error(message = why)
        Success values => Outcomes::whole (number, \value => Success(value = listAppend values value))

    fromValues outcome = match outcome
        Error why => Error(message = why)
        Success values => match values
            [position, rate, duration, amplitude, pan] => Success(value = GrainSeeds(position = position, rate = rate, duration = duration, amplitude = amplitude, pan = pan))
            _ => Error(message = InvalidConfiguration(detail = "Incomplete grain random state."))

    advanced seeds = fromValues (foldList (seedValues seeds, Success(value = []), \(held, seed) => appendSeed (held, GrainMath::nextSeed (toFloat seed))))

    (** Deterministically initialise separately retained streams; offsets do not guarantee statistical independence.
    # Examples
    ```osprey
    print "${GrainDistributions::seeded 0} ${GrainDistributions::seeded 1}"
    ```
    ```output
    Error(InvalidConfiguration { detail: "Invalid grain variation seed." }) Success({ position: 1, rate: 104730, duration: 130364, amplitude: 155922, pan: 196614 })
    ```
    *)
    export seeded seed = match seed >= 1 && seed <= 2147483646
        false => Error(message = InvalidConfiguration(detail = "Invalid grain variation seed."))
        true => fromValues (foldList ([0.0, 104729.0, 130363.0, 155921.0, 196613.0], Success(value = []), \(held, offset) => appendSeed (held, GrainMath::streamSeed (toFloat seed, offset))))

    sampled (ranges, seeds) =
        a = ranges.minimum
        b = ranges.maximum
        Outcomes::whole ((GrainMath::discrete (toFloat a.duration, toFloat b.duration, toFloat seeds.duration)), \duration => Success(value = a(start = GrainMath::uniform (a.start, b.start, toFloat seeds.position), rate = GrainMath::uniform (a.rate, b.rate, toFloat seeds.rate), duration = duration, amplitude = GrainMath::uniform (a.amplitude, b.amplitude, toFloat seeds.amplitude), pan = GrainMath::uniform (a.pan, b.pan, toFloat seeds.pan))))

    event (ranges, outcome, position) = match outcome
        Error why => Error(message = why)
        Success held => match advanced held.next
            Error why => Error(message = why)
            Success seeds => Outcomes::carried (sampled (ranges, seeds), \controls => Success(value = GrainDistributedEvents(events = listPrepend held.events (GrainEvent(position = position, controls = controls)), next = seeds)))

    ordered (previous, position) = match previous >= 0 && position >= previous
        true => position
        false => -1

    (** Produce at most 2048 ordered events; retain seeds only when the subsequent render also succeeds. Empty batches consume no randomness.
    # Examples
    ```osprey
    controls = GrainControls(window = HannWindow, start = 0.0, rate = 1.0, duration = 4800, amplitude = 0.5, pan = 0.0)
    ranges = GrainDistribution(minimum = controls, maximum = controls)
    seeds = GrainSeeds(position = 1, rate = 1, duration = 1, amplitude = 1, pan = 1)
    print "${GrainDistributions::events ([3], ranges, 2, seeds)} ${GrainDistributions::events ([4, 0], ranges, 2, seeds)}"
    ```
    ```output
    Success({ events: [{ position: 3, controls: { window: HannWindow, start: 0.0, rate: 1.0, duration: 4800, amplitude: 0.5, pan: 0.0 } }], next: { position: 48271, rate: 48271, duration: 48271, amplitude: 48271, pan: 48271 } }) Error(InvalidConfiguration { detail: "Invalid grain distribution bounds, sample positions or random seeds." })
    ```
    *)
    export events (positions, ranges, size, seeds) = match size >= 2 && size <= 1048576 && rangesValid (size, ranges) && seedsValid seeds && length positions <= 2048 && foldList (positions, 0, ordered) >= 0
        false => Error(message = InvalidConfiguration(detail = "Invalid grain distribution bounds, sample positions or random seeds."))
        true => Outcomes::carried (foldList (positions, Success(value = GrainDistributedEvents(events = [], next = seeds)), \(held, position) => event (ranges, held, position)), \held => Success(value = held(events = listReverse held.events)))
