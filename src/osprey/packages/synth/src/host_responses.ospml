// [SYNTH-HOST-STREAM] Untrusted worker replies are checked before becoming graph audio.
namespace synth


(** Decode bounded worker audio and reject shape changes, invalid floats and trailing bytes. *)
module HostResponses
    sample (text, first, outcome, index) =
        use samples <- Outcomes::carried (outcome)
        use value <- Outcomes::carried (PcmWords::sample (text, satAdd first (satMul index 8)))
        Success(value = listAppend samples value)

    samples (text, first, count) = match first >= 0 && count >= 0 && satMul count 8 <= satSub (length text) first
        false => Error(message = MissingResource(detail = "Truncated worker audio buffer."))
        true => foldList (toList (range (0, count)), Success(value = []), \(outcome, index) => sample (text, first, outcome, index))

    block (text, channels, remaining, at, chunks, latency, frames) =
        use delay <- Outcomes::carried (PcmWords::read32 (text, satAdd at 8))
        match (latency == -1 || latency == delay) && delay <= 1920000
            false => Error(message = InvalidConfiguration(detail = "The worker changed latency or reported excessive latency."))
            true => Outcomes::carried (samples (text, satAdd at 16, satMul frames channels), \values => blocks (text, channels, satSub remaining frames, satAdd (satAdd at 16) (satMul (satMul frames channels) 8), listAppend chunks values, delay))

    count remaining = match remaining < 256
        true => remaining
        false => 256

    sameNotes (accepted, notes) = match accepted
        true => notes == 1
        false => notes == 0

    blocks (text, channels, remaining, at, chunks, latency) = match remaining == 0
        true => match at == length text
            false => Error(message = InvalidConfiguration(detail = "The worker returned trailing audio bytes."))
            true => Success(value = HostRendered(renderChannels = channels, renderFrames = intDiv (foldList (chunks, 0, \(count, values) => satAdd count (length values))) channels, renderLatency = latency, renderSamples = foldList (chunks, [], \(all, values) => listConcat all values)))
        false => Outcomes::carried (PcmWords::read32 (text, at), \frames =>
            match frames == count remaining
                false => Error(message = InvalidConfiguration(detail = "The worker returned an unexpected block size."))
                true => block (text, channels, remaining, at, chunks, latency, frames))

    handshake (text, layout, frames) =
        use inputs <- Outcomes::carried (PcmWords::read32 (text, 8))
        use outputs <- Outcomes::carried (PcmWords::read32 (text, 16))
        use notes <- Outcomes::carried (PcmWords::read32 (text, 24))
        match inputs == layout.inputChannels && outputs == layout.outputChannels && sameNotes (layout.acceptsNotes, notes)
            false => Error(message = IncompatibleLayout(detail = "The worker audio layout differs from the graph node."))
            true => blocks (text, outputs, frames, 32, [], -1)

    (** Verify the expected channel layout and exact requested frame count.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => HostResponses::clip ("", HostLayout(inputChannels = 1, outputChannels = 1, acceptsNotes = false), 4))} ${arithmetic (\() => HostResponses::clip ("4F535631", HostLayout(inputChannels = 1, outputChannels = 1, acceptsNotes = false), 4))}"
    ```
    ```output
    Error(InvalidConfiguration { detail: "Invalid worker audio header or clip size." }) Error(MissingResource { detail: "Truncated PCM word." })
    ```
    *)
    export clip (text, layout, frames) = match startsWith text "4F535631" && length text <= 4194304 && frames > 0 && layout.inputChannels >= 0 && layout.inputChannels <= 64 && layout.outputChannels >= 1 && layout.outputChannels <= 64 && satMul frames layout.outputChannels <= 65536
        false => Error(message = InvalidConfiguration(detail = "Invalid worker audio header or clip size."))
        true => handshake (text, layout, frames)
