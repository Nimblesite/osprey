// [SYNTH-RENDER] Reference graph execution shares kernels with standalone components.
namespace synth


(** Component dispatch shared by offline graph execution. *)
module RenderKernels
    sine (rate, snapshot, frame, held, waveform, shape) =
        use frequency <- Outcomes::carried (RenderInputs::parameter (snapshot, held.identity, "frequency"))
        use config <- Outcomes::carried (Oscillators::configure (OscillatorConfig(sampleRate = rate, frequency = frequency, pulseWidth = 0.5, waveform = waveform)))
        sample = Oscillators::next (config, OscillatorState(phase = held.phase))
        Success(value = RenderInputs::emitted (frame, held(phase = sample.next.phase), shape sample.sample))

    filtered (frame, held, coefficients, input) =
        sample = Filters::next (coefficients, FilterState(integratorOne = held.integratorOne, integratorTwo = held.integratorTwo), input)
        next = held(integratorOne = sample.next.integratorOne, integratorTwo = sample.next.integratorTwo)
        Success(value = RenderInputs::emitted (frame, next, sample.low))

    filterSettings (rate, snapshot, identity, cutoff) = RenderInputs::setting (snapshot, identity, "resonance", \resonance => Filters::configure (FilterConfig(sampleRate = rate, cutoff = cutoff, resonance = resonance)))

    prepareFilter (rate, snapshot, identity, cables) = match Seek::first (cables, \c => c.destination == identity && c.inlet == 1)
        Success _ => LiveFilter
        Error _ => match RenderInputs::setting (snapshot, identity, "cutoff", \cutoff => filterSettings (rate, snapshot, identity, cutoff))
            Error _ => LiveFilter
            Success c => FixedFilter(coefficients = c)

    lowpass (plan, rate, snapshot, frame, held, input, prepared) = match prepared
        FixedFilter c => filtered (frame, held, c, input)
        LiveFilter => Outcomes::carried (cutoff (plan, snapshot, frame, held.identity), \value =>
            Outcomes::carried (filterSettings (rate, snapshot, held.identity, value), \c => filtered (frame, held, c, input)))

    cutoff (plan, snapshot, frame, identity) = Outcomes::carried (RenderInputs::parameter (snapshot, identity, "cutoff"), \base => RenderInputs::controlledWith (plan, frame, identity, 1, base, \(value, control) => Waves::controlledCutoff (value, control), "Cutoff modulation must stay between zero and one."))

    // The gain setting of the plain and modulated gain nodes: linear 0–8.
    level (snapshot, held) =
        use value <- Outcomes::carried (RenderInputs::parameter (snapshot, held.identity, "gain"))
        match value >= 0.0 && value <= 8.0
            false => Error(message = InvalidConfiguration(detail = "Invalid gain."))
            true => Success(value = value)

    gain (snapshot, frame, held, input) = Outcomes::carried (level (snapshot, held), \amount => Success(value = RenderInputs::output (frame, held.identity, input * amount)))

    mixer (plan, snapshot, frame, held, first) =
        use second <- Outcomes::carried (RenderInputs::input (plan, frame, held.identity, 1))
        use a <- RenderInputs::bound (snapshot, held, "firstGain")
        use b <- RenderInputs::bound (snapshot, held, "secondGain")
        match a >= 0.0 && a <= 1.0 && b >= 0.0 && b <= 1.0
            false => Error(message = InvalidConfiguration(detail = "Mixer input gains must be between zero and one."))
            true => Success(value = RenderInputs::output (frame, held.identity, WaveMath::mixed (first, a, second, b)))

    controlled (plan, snapshot, frame, held, input) =
        use control <- Outcomes::carried (RenderInputs::input (plan, frame, held.identity, 1))
        match control >= 0.0 && control <= 1.0
            false => Error(message = InvalidConfiguration(detail = "Gain modulation must stay between zero and one."))
            true => Outcomes::carried (level (snapshot, held), \amount => Success(value = RenderInputs::output (frame, held.identity, Waves::controlledGain (input, amount, control))))

    passthrough (frame, held, input) = Success(value = RenderInputs::output (frame, held.identity, input))

    // [SYNTH-GRAPH-CHANNELS] Mono split, join and route are identity (or mapped silence); wider layouts
    // never reach this mono renderer because their ports fail its layout checks.
    monoRouted (entries, frame, held, input) = match listGet entries 0
        Error _ => Error(message = IncompatibleLayout(detail = "A channel route needs at least one output channel."))
        Success entry => match entry
            -1 => Success(value = RenderInputs::output (frame, held.identity, 0.0))
            _ => passthrough (frame, held, input)

    processor (plan, rate, snapshot, frame, held, scheduled, input) = match scheduled.node.processor
        ModulatedGain => controlled (plan, snapshot, frame, held, input)
        Filter => lowpass (plan, rate, snapshot, frame, held, input, scheduled.filter)
        Amplifier => gain (snapshot, frame, held, input)
        Mixer => mixer (plan, snapshot, frame, held, input)
        Sink => passthrough (frame, held, input)
        Split => passthrough (frame, held, input)
        Join => passthrough (frame, held, input)
        Panner => passthrough (frame, held, input)
        Route entries => monoRouted (entries, frame, held, input)
        Spectral size hop => SpectralKernels::process (plan, rate, snapshot, frame, held, size, hop, input, scheduled.spectrum)
        Shaper => EffectKernels::shaper (rate, snapshot, frame, held, input, scheduled.physical)
        Reverb => EffectKernels::reverb (rate, snapshot, frame, held, input)
        Shifter => EffectKernels::shifter (rate, snapshot, frame, held, input)
        _ => PhysicalKernels::process (rate, snapshot, frame, held, scheduled.node, input, scheduled.physical)

    playback (resource, rate, snapshot, frame, held) = match floatToInt (floor held.phase)
        Error _ => Error(message = InvalidConfiguration(detail = "Invalid sample cursor."))
        Success index => match SampleResources::monoAt (resource, index)
            Error _ => Success(value = RenderInputs::output (frame, held.identity, 0.0))
            Success left => Outcomes::carried (RenderInputs::parameter (snapshot, held.identity, "rate"), \speed =>
                right = SampleResources::monoAt (resource, satAdd index 1) ?: 0.0
                step = WaveMath::playbackRate (toFloat resource.sampleRate, rate, speed, 1.0)
                sample = Interpolation::linear (left, right, GrainMath::fraction held.phase)
                Outcomes::carried (RenderInputs::parameter (snapshot, held.identity, "gain"), \gain => Success(value = RenderInputs::emitted (frame, held(phase = GrainMath::summed (held.phase, step)), GrainMath::placed (sample, gain)))))

    selected (plan, rate, snapshot, frame, held, scheduled) =
        n = scheduled.node
        match n.processor
            Oscillator => Outcomes::carried (waveform (snapshot, scheduled), \wave => sine (rate, snapshot, frame, held, wave, \value => value))
            Lfo => sine (rate, snapshot, frame, held, Sine, Waves::unipolar)
            SamplePlayer resource => playback (resource, rate, snapshot, frame, held)
            Exciter _ => PhysicalKernels::excite (snapshot, frame, held, scheduled.physical)
            TableOscillator table => TableKernels::wavetable (rate, plan, snapshot, frame, held, table)
            Additive => TableKernels::scheduled (rate, snapshot, frame, held, scheduled.bank)
            PhaseOperator => OperatorKernels::process (plan, rate, snapshot, frame, held, scheduled.phase)
            Bowed capacity => PhysicalKernels::bowed (rate, snapshot, frame, held, capacity)
            Delay _ => match listGet held.delay 0
                Error _ => Error(message = Outcomes::indexOutOfBounds)
                Success previous => Success(value = RenderInputs::output (frame, held.identity, previous))
            _ => Outcomes::carried (RenderInputs::input (plan, frame, held.identity, 0), \input => processor (plan, rate, snapshot, frame, held, scheduled, input))

    declared (n, key) = match Seek::first (n.parameters, \p => p.key == key)
        Error _ => false
        Success _ => true

    physical (rate, snapshot, n, fixed) = match fixed
        false => LivePhysical
        true => match n.processor
            Modal => PhysicalKernels::prepareModal (rate, snapshot, n.identity)
            Exciter _ => PhysicalKernels::prepareExciter (snapshot, n.identity)
            Waveguide capacity => PhysicalKernels::prepare (rate, snapshot, n.identity, capacity)
            Shaper => EffectKernels::prepare (rate, snapshot, n.identity)
            _ => LivePhysical

    bankFor (n, rate, controls, fixed) = match fixed && (n.processor == Additive)
        true => TableKernels::prepare (rate, controls, n.identity)
        false => DynamicPartials

    // Kernel updates preserve the caller's state order throughout a block.
    stateSlot (states, identity, index) = match listGet states index
        Error _ => -1
        Success held => match held.identity == identity
            true => index
            false => stateSlot (states, identity, satAdd index 1)

    (** Resolve optional parameter declarations once for the scheduled node. *)
    export schedule (plan, identity, rate, snapshot, fixed, states) = match Graphs::node (plan.graph, identity)
        Invalid why => Invalid(fault = why)
        Valid n =>
            controls = match fixed
                true => snapshot(parameters = filterList (snapshot.parameters, \p => p.node == identity))
                false => snapshot
            phase = match fixed && (n.processor == PhaseOperator)
                true => OperatorKernels::prepare (rate, controls, identity)
                false => LiveOperator
            filter = match fixed && (n.processor == Filter)
                true => prepareFilter (rate, controls, identity, plan.graph.cables)
                false => LiveFilter
            Valid(value = { filter = filter, phase = phase, node = n, slot = stateSlot (states, identity, 0), physical = physical (rate, controls, n, fixed), spectrum = SpectralKernels::prepare (rate, controls, identity, n.processor, fixed), bank = bankFor (n, rate, controls, fixed), controls = controls, fixed = fixed, switchable = declared (n, "enabled"), selectableWave = n.processor == Oscillator && declared (n, "waveform") })

    (** Render one scheduled component or return its explicit fault. *)
    export step (plan, rate, snapshot, frame, identity) = resolved (plan, rate, snapshot, frame, schedule (plan, identity, rate, snapshot, false, frame.states))

    (** Run a scheduled component resolved for this block. *)
    export resolved (plan, rate, current, frame, component) = match component
        Invalid _ => Error(message = MissingResource(detail = "Render schedule names an absent component."))
        Valid scheduled =>
            snapshot = match scheduled.fixed
                true => scheduled.controls
                false => current
            match listGet frame.states scheduled.slot
                Error _ => Error(message = Outcomes::indexOutOfBounds)
                Success held => match scheduled.switchable
                    false => selected (plan, rate, snapshot, frame, held, scheduled)
                    true => Outcomes::carried (RenderInputs::parameter (snapshot, held.identity, "enabled"), \enabled =>
                        match enabled
                            1.0 => selected (plan, rate, snapshot, frame, held, scheduled)
                            0.0 => bypassed (plan, frame, held, scheduled.node)
                            _ => Error(message = InvalidConfiguration(detail = "Enabled must be zero or one.")))

    waveform (snapshot, scheduled) = match scheduled.selectableWave
        false => Success(value = Sine)
        true => Outcomes::carried (RenderInputs::parameter (snapshot, scheduled.node.identity, "waveform"), \value => Outcomes::chosen (value, [Sine, Triangle, Saw, Pulse], "Unknown oscillator waveform."))

    bypassed (plan, frame, held, n) = match n.processor
        Filter => Outcomes::carried (RenderInputs::input (plan, frame, held.identity, 0), \value => Success(value = RenderInputs::output (frame, held.identity, value)))
        Lfo => Success(value = RenderInputs::output (frame, held.identity, 1.0))
        _ => Success(value = RenderInputs::output (frame, held.identity, 0.0))
