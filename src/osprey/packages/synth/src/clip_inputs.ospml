// [SYNTH-HOST-GRAPH] Checked clip routing shares graph identities and port contracts.
namespace synth

(** Resolve rendered audio and event inputs without implicit conversions. *)
module ClipInputs
    (** Find exactly one completed source, never substitute silence for a missing cable. *)
    export completed (clips, identity) = match filterList (clips, \clip => clip.clipNode == identity)
        [clip] => Success(value = clip)
        _ => Error(message = MissingResource(detail = "A graph source has not rendered exactly once."))

    // A Split stores one interleaved clip. Consumers that ask for a complete inlet need just the wired outlet.
    splitOutlet (clip, outlet) = match outlet >= 0 && outlet < clip.clipChannels && length clip.clipSamples % clip.clipChannels == 0
        false => Error(message = IncompatibleLayout(detail = "The split outlet is outside its audio layout."))
        true => Outcomes::carried (filterIndexedChannel (clip, outlet), \samples => Success(value = clip(clipChannels = 1, clipSamples = samples)))

    (** Append a checked audio sample to an interleaved or extracted channel. *)
    export appended (values, outcome) = match outcome
        Error _ => Error(message = Outcomes::indexOutOfBounds)
        Success sample => Success(value = listAppend values sample)

    filterIndexedChannel (clip, outlet) = foldList (toList (range (0, intDiv (length clip.clipSamples) clip.clipChannels)), Success(value = []), \(result, frame) =>
        Outcomes::carried (result, \samples => appended (samples, listGet clip.clipSamples (satAdd (satMul frame clip.clipChannels) outlet))))

    fromOutlet (graph, source, outlet, clip) = match Graphs::node (graph, source)
        Invalid _ => Error(message = MissingResource(detail = "The routed source is missing."))
        Valid n => match n.processor
            Split => splitOutlet (clip, outlet)
            _ => Success(value = clip)

    audioOutlet port = port.rate == Audio && port.unit == Amplitude

    (** Resolve an actual audio outlet by node identity and port index. *)
    export audioPort (graph, identity, outlet) = match Graphs::node (graph, identity)
        Invalid _ => Error(message = MissingResource(detail = "The send source node is missing."))
        Valid n => match listGet n.outputs outlet
            Error _ => Error(message = MissingResource(detail = "The send source outlet is missing."))
            Success port => match audioOutlet port
                true => Success(value = port)
                false => Error(message = IncompatibleLayout(detail = "A bus send needs an audio outlet."))

    (** Read one channel of an internal audio outlet from a completed block, preserving its existing cables. *)
    export tapped (graph, clips, source, outlet, channel) = Outcomes::carried (audioPort (graph, source, outlet), \declared =>
        match channel >= 0 && channel < declared.channels
            false => Error(message = IncompatibleLayout(detail = "The channel is outside the selected outlet."))
            true => tapChannel (graph, clips, source, outlet, channel))

    tapChannel (graph, clips, source, outlet, channel) = Outcomes::carried (completed (clips, source), \clip =>
        Outcomes::carried (fromOutlet (graph, source, outlet, clip), \port =>
            match port.clipChannels == 1 && channel == 0
                true => Success(value = port.clipSamples)
                false => Outcomes::carried (splitOutlet (port, channel), \mono => Success(value = mono.clipSamples))))

    (** Resolve the cable feeding one declared inlet. *)
    export routed (graph, clips, identity, inlet) = match filterList (graph.cables, \c => c.destination == identity && c.inlet == inlet)
        [cable] => Outcomes::carried (completed (clips, cable.source), \clip => fromOutlet (graph, cable.source, cable.outlet, clip))
        _ => Error(message = InvalidConfiguration(detail = "Every graph input needs exactly one connected source."))

    (** Control signals broadcast across audio channels without changing audio cable widths; a split
        outlet carries exactly one channel of its interleaved clip, named by the outlet index. *)
    export sourceChannel (graph, cable, channel) = match Graphs::node (graph, cable.source)
        Invalid _ => Error(message = MissingResource(detail = "The routed source is missing."))
        Valid n => match listGet n.outputs cable.outlet
            Error _ => Error(message = Outcomes::indexOutOfBounds)
            Success port => match port.rate
                Control => Success(value = 0)
                Audio => match n.processor
                    Split => Success(value = cable.outlet)
                    _ => Success(value = channel)
                _ => Success(value = channel)

    channels ports = match ports
        [] => Success(value = 0)
        [port] => Success(value = port.channels)
        _ => Error(message = IncompatibleLayout(detail = "The VST host supports one audio bus per direction."))

    (** The worker must confirm these exact audio and MIDI bus counts. *)
    export layout n = match channels (filterList (n.inputs, \p => p.rate == Audio && p.unit == Amplitude))
        Error why => Error(message = why)
        Success inputs => match channels (filterList (n.outputs, \p => p.rate == Audio && p.unit == Amplitude))
            Error why => Error(message = why)
            Success outputs => Success(value = HostLayout(inputChannels = inputs, outputChannels = outputs, acceptsNotes = length (filterList (n.inputs, \p => p.rate == Events && p.unit == Notes)) == 1))

    matchingRate (n, rate, index) = match listGet n.inputs index
        Error _ => false
        Success port => port.rate == rate

    source (graph, clips, n, rate) = match listGet (filterList (toList (range (0, length n.inputs)), \index => matchingRate (n, rate, index))) 0
        Error _ => Error(message = Outcomes::indexOutOfBounds)
        Success inlet => routed (graph, clips, n.identity, inlet)

    (** The node's audio inlet samples, or empty when it has no audio inlet. *)
    audioInput (graph, clips, n) = inputSamples (graph, clips, n, Audio, \clip => clip.clipSamples)

    (** The node's note events, or empty when it has no event inlet. *)
    noteInput (graph, clips, n) = inputSamples (graph, clips, n, Events, \clip => clip.clipNotes)

    inputSamples (graph, clips, n, rate, read) = match length (filterList (n.inputs, \p => p.rate == rate)) == 0
        true => Success(value = [])
        false => Outcomes::carried (source (graph, clips, n, rate), \clip => Success(value = read clip))

    (** Assemble audio, events and current normalized controls into one bounded worker request. *)
    export requestAt (graph, clips, n, first, frames) = match audioInput (graph, clips, n)
        Error why => Error(message = why)
        Success samples => match noteInput (graph, clips, n)
            Error why => Error(message = why)
            Success notes => Outcomes::carried (HostModulation::window (graph, clips, n, first, frames), \parameters => Success(value = HostBlock(frames = frames, notes = notes, parameters = parameters, samples = samples)))

    (** A whole clip starts its event and automation clock at zero. *)
    export request (graph, clips, n, frames) = requestAt (graph, clips, n, 0, frames)
