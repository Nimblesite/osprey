// Wave Pulse Phase Modulation is taken verbatim from M. Smart, "Wave Pulse Phase Modulation:
// Hybridising Phase Modulation and Phase Distortion", DAFx25, Ancona, pp. 166–169, equations
// (1) and (3)–(9). Phase is the normalised ramp `φ ∈ [0, 1)` of equation (4).
namespace synth

(** Phase-shaping oscillator mathematics [SYNTH-ADVANCED-PHASE]. *)
module PhaseMath
    (** Equation (1): the inverted-cosine carrier driven by a shaped phase.
    # Examples
    ```osprey
    print "${PhaseMath::carrier 0.0} ${PhaseMath::carrier 0.5}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export carrier shaped = (-1.0) * cos (6.283185307179586 * shaped)

    (** Equation (5): the sinusoidal window `w(t) = sin(π t)`.
    # Examples
    ```osprey
    print "${PhaseMath::window 0.0} ${PhaseMath::window 0.5}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export window t = sin (3.141592653589793 * t)

    (** Equation (6): sine-windowed modified phase modulation.
    # Examples
    ```osprey
    print "${PhaseMath::windowedPhase (0.25, 0.5, 0.0)} ${PhaseMath::windowedPhase (0.0, 0.5, 2.0)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export windowedPhase (phase, index, ratio) = phase + window phase * index * sin (6.283185307179586 * ratio * phase)

    (** External phase modulation plus DX-style averaged self-feedback, in cycles.
    # Examples
    ```osprey
    print "${PhaseMath::modulated (0.5, 0.25, 0.5, 0.2, 0.4, 0.5)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export modulated (shaped, modulation, depth, previous, older, feedback) = shaped + depth * modulation + feedback * (previous + older) / 2.0

    (** Instantaneous frequency with linear through-zero FM; negative values run the phase backwards.
    # Examples
    ```osprey
    print "${PhaseMath::instantaneous (440.0, -1.0, 220.0)} ${PhaseMath::instantaneous (440.0, -2.0, 220.0)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export instantaneous (frequency: float, modulation, spread) = frequency + spread * modulation
