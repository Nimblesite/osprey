namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type PulseControls =
    index : float
    ratio : float
    offset : float

type PhaseShape =
    PlainPhase
    DistortedPhase
        breakpoint : float
    WindowedPhase
        index : float
        ratio : float
    WavePulsePhase
        breakpoint : float
        first : PulseControls
        second : PulseControls

type OperatorConfig =
    sampleRate : float
    frequency : float
    shape : PhaseShape
    depth : float
    spread : float
    feedback : float
    amplitude : float

type OperatorState =
    phase : float
    previous : float
    older : float
    sync : float

type OperatorSample =
    sample : float
    next : OperatorState

type OversampledOperator =
    operator : OperatorState
    down : List<float>

type OversampledOperatorSample =
    sample : float
    next : OversampledOperator

type OperatorControls =
    selector : float
    breakpoint : float
    first : PulseControls
    second : PulseControls
    frequency : float
    depth : float
    spread : float
    feedback : float
    amplitude : float
    oversample : float

type OperatorSchedule =
    LiveOperator
    FixedOperator
        config : OperatorConfig
        oversample : float

