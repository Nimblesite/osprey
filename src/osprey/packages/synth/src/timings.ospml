// [SYNTH-ADVANCED-CORE-RESOURCES] Declared algorithmic latency and tail length for every graph component.
namespace synth

(** Latency is the fixed delay a component adds between input and output; tail is how long it may keep
    sounding after its input stops (to −60 dB for decaying models). Both are in samples at the 48 kHz graph
    rate and read the node's current parameter values, so a host can align routes and dispose of tails. *)
module Timings
    (** The graph rendering rate these sample counts assume.
    # Examples
    ```osprey
    print "${Timings::rate}"
    ```
    ```output
    48000.0
    ```
    *)
    export rate = 48000.0

    value (n, key) = match Graphs::parameterNamed (n, key)
        Error _ => Error(message = InvalidConfiguration(detail = "The node lacks a timing parameter: ${key}."))
        Success p => Success(value = p.initial)

    scaled (n, key, factor) = match value (n, key)
        Error why => Error(message = why)
        Success amount => Success(value = amount * factor)

    switched (n, key, on) = match value (n, key)
        Error why => Error(message = why)
        Success flag => match flag >= 0.5
            true => Success(value = on)
            false => Success(value = 0.0)

    shaperLatency n = match switched (n, "oversample", toFloat Oversamplers::latency)
        Error why => Error(message = why)
        Success extra => switched (n, "antialias", 0.5 + extra)

    (** Fixed input-to-output delay in samples.
    # Examples
    ```osprey
    print "${Timings::latency (Components::delay (1, 64))} ${Timings::latency (Components::shaper (1, 0.0, 1.0))} ${Timings::latency (Components::gain (1, 1.0))}"
    ```
    ```output
    Success(64.0) Success(0.5) Success(0.0)
    ```
    *)
    export latency n = match n.processor
        Spectral size _ => Success(value = toFloat (SpectralStreams::latency size))
        Shaper => shaperLatency n
        PhaseOperator => switched (n, "oversample", 7.5)
        Delay count => Success(value = toFloat count)
        FractionalDelay _ => value (n, "delay")
        _ => Success(value = 0.0)

    (** Samples the component may keep sounding after its input stops; sources report their own decay.
    # Examples
    ```osprey
    print "${Timings::tail (Components::reverb (1, 2.5))} ${Timings::tail (Components::smoother (1, 0.01))} ${Timings::tail (Components::gain (1, 1.0))}"
    ```
    ```output
    Success(240000.0) Success(3360.0) Success(0.0)
    ```
    *)
    export tail n = match n.processor
        Waveguide _ => scaled (n, "decay", rate)
        Bowed _ => scaled (n, "decay", rate)
        Resonator => scaled (n, "decay", rate)
        Modal => scaled (n, "decay", 2.0 * rate)
        Reverb => scaled (n, "decay", 2.0 * rate)
        Additive => scaled (n, "decay", rate)
        Smoother => scaled (n, "time", 7.0 * rate)
        Spectral size _ => Success(value = toFloat (SpectralStreams::tail size))
        Delay count => Success(value = toFloat count)
        FractionalDelay _ => value (n, "delay")
        _ => Success(value = 0.0)
