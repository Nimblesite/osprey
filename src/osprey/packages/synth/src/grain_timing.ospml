// [SYNTH-ADVANCED-GRAINS-TIMING] Bounded inter-onset distributions share the scheduler's seeded stream.
namespace synth

(** Inter-onset policies; exponential mode is rounded and capped, not an exact Poisson process. *)
module GrainTimings
    (** Bounds limit onset density and gaps independently of the host block size. *)
    export valid timing = match timing
        PeriodicTiming period jitter => period >= 1 && period <= 1048576 && jitter >= 0 && jitter < period
        ExponentialTiming mean maximum => mean >= 1.0 && mean <= 1048576.0 && maximum >= 1 && maximum <= 1048576

    (** Called with a checked policy and a newly advanced Park–Miller seed. *)
    export interval (timing, seed) = match timing
        PeriodicTiming period jitter => GrainMath::interval (toFloat period, toFloat jitter, toFloat seed)
        ExponentialTiming mean maximum => GrainMath::exponentialInterval (mean, toFloat maximum, toFloat seed)

    (** Discrete graph timing selectors are exact; inactive settings do not alter the selected distribution. *)
    export decode (mode, period, jitter, maximum) = match mode
        0.0 => checked (PeriodicTiming(period = period, jitter = jitter))
        1.0 => checked (ExponentialTiming(mean = toFloat period, maximum = maximum))
        _ => Error(message = InvalidConfiguration(detail = "Grain timing must be 0 (periodic jitter) or 1 (bounded exponential)."))

    (** Accept `value` when `test` holds, reporting `failure` otherwise. *)
    export accepted (test, value, failure) = match test
        true => Success(value = value)
        false => Error(message = failure)

    checked timing = accepted (valid timing, timing, InvalidConfiguration(detail = "Invalid grain timing distribution or bounds."))
