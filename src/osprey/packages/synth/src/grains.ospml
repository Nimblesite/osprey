// [SYNTH-ADVANCED-GRAINS-PLAYBACK] Allocating reference kernel; no callback-safety claim.
namespace synth

(** Bounded sampled grains with explicit state, stereo placement and independent lifetime/pitch. *)
module Grains
    (** Refusal for an invalid prepared source or grain-pool capacity. *)
    export invalidSource () = Error(message = InvalidConfiguration(detail = "Grains require 2–1048576 finite normalised mono samples and capacity 1–256."))

    sourceSample value = value >= -1.0 && value <= 1.0

    sourceSize source = length source >= 2 && length source <= 1048576

    voiceSource (pool, voice) = match voice.identity < pool.retiredBefore
        true => pool.retiredSource
        false => pool.source

    fullRegion (source, boundary) = GrainRegion(first = 0, limit = length source, boundary = boundary)
    regionValid (size, region) = region.first >= 0 && region.first < region.limit && region.limit <= size
    inside (region, cursor) = cursor >= toFloat region.first && cursor < toFloat region.limit

    layout pool = regionValid (length pool.source, pool.region) && sourceSize pool.source && ((length pool.retiredSource == 0 && pool.retiredBefore == 0) || (sourceSize pool.retiredSource && pool.retiredBefore > 0)) && pool.retiredBefore >= 0 && pool.retiredBefore <= pool.nextIdentity && pool.capacity >= 1 && pool.capacity <= 256 && length pool.voices <= pool.capacity && pool.revision >= pool.nextIdentity && pool.position >= 0 && pool.nextIdentity >= 0 && ordered pool >= -1

    (** Validate playback controls against the actual source length, including finite bounds. *)
    export controls (size, c) = GrainWindows::valid c.window && c.start >= 0.0 && c.start < toFloat size && c.rate >= -16.0 && c.rate <= 16.0 && c.duration >= 3 && c.duration <= 65536 && c.amplitude >= 0.0 && c.amplitude <= 1.0 && c.pan >= -1.0 && c.pan <= 1.0

    voiceValid (size, voice) = regionValid (size, voice.region) && inside (voice.region, voice.cursor) && inside (voice.region, voice.controls.start) && controls (size, voice.controls) && voice.identity >= 0 && voice.age >= 0 && voice.age < voice.controls.duration

    // Pool order is preserved by rendering; strict monotonic IDs reject forged or duplicate voices.
    ordered pool = foldList (pool.voices, -1, \(previous, voice) =>
        match previous >= -1 && voice.identity > previous && voice.identity < pool.nextIdentity && voiceValid (length (voiceSource (pool, voice)), voice)
            true => voice.identity
            false => -2)

    (** Prepare a normalised mono source and a pool of 1–256 grains outside the audio callback. *)
    export prepare (source, capacity) =
        pool = GrainPool(region = fullRegion (source, LoopSource), source = source, retiredSource = [], retiredBefore = 0, capacity = capacity, voices = [], revision = 0, position = 0, nextIdentity = 0)
        match layout pool && length (filterList (source, sourceSample)) == length source
            true => Success(value = pool)
            false => invalidSource ()

    (** Select an absolute, half-open source region for future triggers. Existing voices retain theirs. *)
    export withRegion (pool, region) = match layout pool && regionValid (length pool.source, region)
        true => Success(value = pool(region = region))
        false => Error(message = InvalidConfiguration(detail = "Invalid grain pool or source region."))

    (** Prepare a new mono source off the audio thread. At most one retired buffer may drain. *)
    export replaceSource (pool, source) = match layout pool
        false => Error(message = InvalidConfiguration(detail = "Invalid grain pool."))
        true => match length pool.retiredSource > 0
            true => Error(message = InvalidConfiguration(detail = "The previous sample still has active grains."))
            false => match prepare (source, pool.capacity)
                Error why => Error(message = why)
                Success ready => match length pool.voices == 0
                    true => Success(value = pool(region = fullRegion (ready.source, pool.region.boundary), source = ready.source))
                    false => Success(value = pool(region = fullRegion (ready.source, pool.region.boundary), source = ready.source, retiredSource = pool.source, retiredBefore = pool.nextIdentity))

    (** A new grain sounds from the pool's current sample and reads the source from `settings.start`; zero rate holds it there.
        [SYNTH-ADVANCED-GRAINS-OVERLOAD] Reject-new policy: a full pool returns accepted=false and counted state, preserving every active grain. *)
    export trigger (pool, settings) = match layout pool && inside (pool.region, settings.start) && controls (length pool.source, settings) && pool.revision < 9223372036854775807 && pool.nextIdentity < 9223372036854775807
        false => Error(message = InvalidConfiguration(detail = "Invalid grain source, controls or revision."))
        true => match length pool.voices < pool.capacity
            false => Success(value = GrainAdmission(pool = pool(revision = satAdd pool.revision 1), accepted = false))
            true => Success(value = GrainAdmission(pool = pool(voices = listAppend pool.voices (GrainVoice(region = pool.region, identity = pool.nextIdentity, controls = settings, cursor = settings.start, age = 0)), revision = satAdd pool.revision 1, nextIdentity = satAdd pool.nextIdentity 1), accepted = true))

    interpolated (source, cursor, region) = Outcomes::whole (floor cursor, \index => tapped (source, cursor, region, index))

    tapped (source, cursor, region, index) = match listGet source index
        Error _ => Error(message = MissingResource(detail = "index out of bounds"))
        Success a =>
            following = match index == satSub region.limit 1
                true => match region.boundary
                    LoopSource => region.first
                    OneShotSource => index
                false => satAdd index 1
            match listGet source following
                Error _ => Error(message = MissingResource(detail = "index out of bounds"))
                Success b => match sourceSample a && sourceSample b
                    false => Error(message = NumericalFailure(detail = "A grain read a nonfinite or unnormalised source sample."))
                    true => Success(value = Interpolation::linear (a, b, GrainMath::fraction cursor))

    // Only reached from checked entry points; advancing preserves cursor/lifetime invariants.
    contribution (source, voice) = match interpolated (source, voice.cursor, voice.region)
        Error why => Error(message = why)
        Success sample =>
            c = voice.controls
            shaped = GrainMath::weighted (sample, c.amplitude, GrainWindows::value (c.window, voice.age, c.duration))
            next = voice(cursor = GrainMath::regionCursor (voice.cursor, c.rate, toFloat voice.region.first, toFloat voice.region.limit, voice.region.boundary == LoopSource), age = satAdd voice.age 1)
            Success(value = GrainContribution(left = GrainMath::placed (shaped, GrainMath::leftGain c.pan), right = GrainMath::placed (shaped, GrainMath::rightGain c.pan), next = next))

    mixed (outcome, voice) = match outcome
        Error why => Error(message = why)
        Success mix => match contribution (voiceSource (mix.next, voice), voice)
            Error why => Error(message = why)
            Success part =>
                held = mix.next
                voices = match part.next.age < part.next.controls.duration && inside (part.next.region, part.next.cursor)
                    true => listPrepend held.voices part.next
                    false => held.voices
                Success(value = GrainSample(left = GrainMath::summed (mix.left, part.left), right = GrainMath::summed (mix.right, part.right), next = held(voices = voices)))

    releaseRetired pool = match length pool.retiredSource == 0
        true => pool
        false => match listGet pool.voices 0
            Success first => match first.identity < pool.retiredBefore
                true => pool
                false => pool(retiredSource = [], retiredBefore = 0)
            Error _ => pool(retiredSource = [], retiredBefore = 0)

    // Private: layout/voice validity and available sample-clock capacity are established by the caller.
    advanced pool =
        initial = GrainSample(left = 0.0, right = 0.0, next = pool(voices = [], position = satAdd pool.position 1))
        match foldList (pool.voices, Success(value = initial), mixed)
            Error why => Error(message = why)
            Success rendered =>
                held = rendered.next
                Success(value = rendered(next = releaseRetired (held(voices = listReverse held.voices))))

    (** Render one sample with a periodic source and its latched window. Summed peaks can exceed unity; gain staging belongs to the caller. *)
    export next pool = match layout pool && pool.position < 9223372036854775807
        false => Error(message = ExhaustedCapacity(detail = "Invalid grain pool or exhausted sample clock."))
        true => advanced pool

    (** Render 1–2048 frames without changing grain scheduling at the block boundary. *)
    export block (pool, frames) = scheduled (pool, frames, [])

    observedVoice (pool, voice) = GrainVoiceObservation(identity = voice.identity, cursor = voice.cursor, age = voice.age, duration = voice.controls.duration, sourceFrames = length (voiceSource (pool, voice)), fromPreviousSource = voice.identity < pool.retiredBefore, region = voice.region)

    (** Coherent observer data from a completed render state; consumers publish it off the audio thread. *)
    export observation pool = GrainObservation(sourceFrames = length pool.source, retiredFrames = length pool.retiredSource, region = pool.region, voices = mapList (pool.voices, \voice => observedVoice (pool, voice)), revision = pool.revision, samplePosition = pool.position, activeGrains = length pool.voices, capacity = pool.capacity, requestedGrains = pool.revision, acceptedGrains = pool.nextIdentity, rejectedGrains = satSub pool.revision pool.nextIdentity, stolenGrains = 0, requestedPerFrame = GrainMath::density (toFloat pool.revision, toFloat pool.position), acceptedPerFrame = GrainMath::density (toFloat pool.nextIdentity, toFloat pool.position))

    (** Reactive observation has no dependency on a UI framework. *)
    export observe () = perform Signal<GrainObservation>.read ()

    orderedEvent (first, end, previous, event) = match previous >= 0 && event.position >= previous && event.position >= first && event.position < end
        true => event.position
        false => -1

    triggered pending = match pending.events
        [] => Success(value = pending)
        [event, ...remaining] => match event.position == pending.audio.next.position
            false => Success(value = pending)
            true => match trigger (pending.audio.next, event.controls)
                Error why => Error(message = why)
                Success admission =>
                    audio = pending.audio
                    triggered (pending(audio = audio(next = admission.pool), events = remaining))

    sample outcome = match outcome
        Error why => Error(message = why)
        Success pending => match triggered pending
            Error why => Error(message = why)
            Success ready => match advanced ready.audio.next
                Error why => Error(message = why)
                Success rendered =>
                    audio = ready.audio
                    Success(value = ready(audio = audio(left = listPrepend audio.left rendered.left, right = listPrepend audio.right rendered.right, next = rendered.next)))

    (** Events must be sorted, within [pool.position, pool.position + frames), and at most 2048. Equal positions preserve caller order. *)
    export scheduled (pool, frames, events) = match layout pool && frames >= 1 && frames <= 2048 && pool.position >= 0 && pool.position <= satSub 9223372036854775807 frames && length events <= 2048
        false => Error(message = InvalidConfiguration(detail = "Invalid grain block size, clock or event capacity."))
        true => match foldList (events, pool.position, \(previous, event) => orderedEvent (pool.position, satAdd pool.position frames, previous, event)) >= 0
            false => Error(message = InvalidConfiguration(detail = "Grain events must be ordered and belong to this block's half-open sample interval."))
            true =>
                initial = GrainTimelineState(audio = GrainBlock(left = [], right = [], next = pool), events = events)
                match foldList (toList (range (0, frames)), Success(value = initial), \(held, _) => sample held)
                    Error why => Error(message = why)
                    Success rendered =>
                        audio = rendered.audio
                        Success(value = audio(left = listReverse audio.left, right = listReverse audio.right))
