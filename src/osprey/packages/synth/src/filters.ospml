// [SYNTH-DSP] Trapezoidal state-variable filter, with explicit integrator memory.
// Reference: [SYNTH-RESEARCH-ANTIALIASING], Zavalishin's topology-preserving transforms.
namespace synth

(** Low, band and high outputs from one stateful filter step. *)
module Filters
    (** Zero initial energy. *)
    export initial = FilterState(integratorOne = 0.0, integratorTwo = 0.0)

    coefficients config =
        g = VoiceMath::warped (config.cutoff, config.sampleRate)
        k = VoiceMath::damping config.resonance
        FilterCoefficients(a1 = VoiceMath::gainOne (g, k), a2 = VoiceMath::gainTwo (g, k), a3 = VoiceMath::gainThree (g, k), k = k)

    (** Cutoff is positive and below 0.49 of sample rate; resonance is Q, not a normalised knob. *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && config.cutoff > 0.0 && config.cutoff < config.sampleRate * 0.49 && config.resonance >= 0.1 && config.resonance <= 20.0
        true => Success(value = coefficients config)
        false => Error(message = InvalidConfiguration(detail = "Invalid filter rate, cutoff or Q."))

    (** One reference sample with previously validated coefficients and finite input. *)
    export next (c, held, input) =
        band = VoiceMath::bandpass (c.a1, c.a2, held.integratorOne, held.integratorTwo, input)
        low = VoiceMath::lowpass (c.a2, c.a3, held.integratorOne, held.integratorTwo, input)
        FilterSample(low = low, band = band, high = VoiceMath::highpass (c.k, input, band, low), next = FilterState(integratorOne = VoiceMath::integrated (band, held.integratorOne), integratorTwo = VoiceMath::integrated (low, held.integratorTwo)))
