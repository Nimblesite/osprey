// [SYNTH-GRAPH-REPLACE] Prepare on the control thread; publish the complete result at a block boundary.
namespace synth

(** Transactional reference-engine graph replacement with explicit state migration. *)
module Repatch
    compatible (before, after) = structuralEquals (before.processor, after.processor) && structuralEquals (before.inputs, after.inputs) && structuralEquals (before.outputs, after.outputs)

    retained (previous, next, identity) = match Graphs::node (previous, identity)
        Invalid _ => false
        Valid before => match Graphs::node (next, identity)
            Invalid _ => false
            Valid after => compatible (before, after)

    migrated (previous, next, states, initial) = match retained (previous, next, initial.identity)
        false => Success(value = initial)
        true => match listGet (filterList (states, \s => s.identity == initial.identity)) 0
            Error _ => Error(message = "A surviving component has no DSP state.")
            Success held => Success(value = held)

    appendState (previous, next, states, result, initial) = match result
        Error why => Error(message = why)
        Success collected => match migrated (previous, next, states, initial)
            Error why => Error(message = why)
            Success held => Success(value = listAppend collected held)

    parameter (previous, next, snapshot, initial) = match retained (previous, next, initial.node)
        false => initial
        true => match listGet (filterList (snapshot.parameters, \p => p.node == initial.node && p.key == initial.key)) 0
            Error _ => initial
            Success held => held

    values (previous, next, snapshot) =
        defaults = Parameters::initial next
        defaults(revision = satAdd snapshot.revision 1, samplePosition = snapshot.samplePosition, parameters = mapList (defaults.parameters, \p => parameter (previous, next, snapshot, p)))

    validParameter (graph, snapshot, p) = match Parameters::apply (graph, snapshot, ParameterChange(node = p.node, key = p.key, value = p.value, revision = snapshot.revision, samplePosition = snapshot.samplePosition))
        Invalid _ => false
        Valid _ => true

    finish (previous, next, snapshot, audio, initial) =
        observation = values (previous, next, snapshot)
        match length (filterList (observation.parameters, \p => validParameter (next, observation, p))) == length observation.parameters
            false => Error(message = "A retained parameter is incompatible with its replacement descriptor.")
            true => match foldList (initial.states, Success(value = []), \(result, held) => appendState (previous, next, audio.states, result, held))
                Error why => Error(message = why)
                Success states => Success(value = Timeline(audio = initial(states = states, position = audio.position), observation = observation))

    (** Keep compatible components' phase/filter/delay state and parameter values; reset changed processors. No partial result escapes on rejection. *)
    export apply (previous, next, snapshot, audio) = match snapshot.samplePosition == audio.position && audio.position >= 0 && snapshot.revision >= 0 && snapshot.revision < 9223372036854775806
        false => Error(message = "Graph replacement requires a current block-boundary snapshot and an available revision.")
        true => match Graphs::prepare previous
            Invalid _ => Error(message = "The previous graph is invalid.")
            Valid _ => match Renderer::start next
                Error why => Error(message = why)
                Success initial => finish (previous, next, snapshot, audio, initial)
