// [SYNTH-RENDER] Checked inputs for the offline/reference graph renderer.
namespace synth

(** Checked lookups and state publication for the reference renderer. *)
module RenderInputs
    (** Resolve a scheduled component, refusing unknown identities.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    print "${RenderInputs::component (plan, 2)} ${RenderInputs::component (plan, 1)}"
    ```
    ```output
    Error(MissingResource { detail: "Render schedule names an absent component." }) Success({ identity: 1, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] })
    ```
    *)
    export component (plan, identity) = match Graphs::node (plan.graph, identity)
        Valid n => Success(value = n)
        Invalid _ => Error(message = MissingResource(detail = "Render schedule names an absent component."))

    (** Find persistent kernel state by identity.
    # Examples
    ```osprey
    frame = SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::held (frame, 1))} ${arithmetic (\() => RenderInputs::held (frame, 2))}"
    ```
    ```output
    Success({ identity: 1, phase: 0.0, integratorOne: 0.0, integratorTwo: 0.0, delay: [], memory: KernelIdle }) Error(MissingResource { detail: "index out of bounds" })
    ```
    *)
    export held (frame, identity) = match Seek::first (frame.states, \s => s.identity == identity)
        Error _ => Error(message = Outcomes::indexOutOfBounds)
        Success found => Success(value = found)

    (** Read a required parameter without substituting a fake value.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        snapshot = Parameters::initial (Graph(nodes = [Components::gain (1, 1.0)], cables = []))
        print "${RenderInputs::parameter (snapshot, 1, "gain")} ${RenderInputs::parameter (snapshot, 1, "cutoff")}"

    arithmetic example
    ```
    ```output
    @@TODO@@
    ```
    *)
    export parameter (snapshot, identity, key) = match Seek::first (snapshot.parameters, \p => p.node == identity && p.key == key)
        Success p => Success(value = p.value)
        Error _ => Error(message = MissingResource(detail = "Required render parameter is missing."))

    (** Read one declared parameter, then continue; a missing parameter stops with its error.
    # Examples
    ```osprey
    snapshot = Parameters::initial (Graph(nodes = [Components::gain (1, 1.0)], cables = []))
    held = KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::bound (snapshot, held, "gain", \value => Success(value = value * 2.0)))} ${arithmetic (\() => RenderInputs::bound (snapshot, held, "cutoff", \value => Success(value = value * 2.0)))}"
    ```
    ```output
    Success(2.0) Error(MissingResource { detail: "Required render parameter is missing." })
    ```
    *)
    export bound (snapshot, held, key, continue) = setting (snapshot, held.identity, key, continue)

    (** Resolve a parameter while preparing a node before its first sample.
    # Examples
    ```osprey
    snapshot = Parameters::initial (Graph(nodes = [Components::gain (1, 1.0)], cables = []))
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::setting (snapshot, 1, "gain", \value => Success(value = value + 1.0)))} ${arithmetic (\() => RenderInputs::setting (snapshot, 1, "cutoff", \value => Success(value = value + 1.0)))}"
    ```
    ```output
    Success(2.0) Error(MissingResource { detail: "Required render parameter is missing." })
    ```
    *)
    export setting<T> : (Observation, int, string, (float) -> Result<T, Fault>) -> Result<T, Fault>
    setting (snapshot, identity, key, continue) = Outcomes::carried (parameter (snapshot, identity, key), \value => continue value)

    connection (plan, identity, inlet) = Seek::first (plan.graph.cables, \c => c.destination == identity && c.inlet == inlet)

    fromCable (frame, cable) = match Seek::first (frame.values, \v => v.identity == cable.source)
        Error _ => Error(message = MissingResource(detail = "An input was read before its source was rendered."))
        Success value => Success(value = value.value)

    (** An optional normalised control inlet: unplugged keeps `base`; plugged values must lie in [0, 1] and are
        combined with `base` by the caller's declared rule.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [Cable(source = 1, outlet = 0, destination = 2, inlet = 0)]), order = [1, 2], feedback = [])
    rendered = SampleFrame(states = [], values = [NodeSample(identity = 1, value = 2.0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::controlled (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 2, 1, 0.5, \(base, control) => base * control))} ${arithmetic (\() => RenderInputs::controlled (plan, rendered, 2, 0, 0.5, \(base, control) => base * control))} ${arithmetic (\() => RenderInputs::controlled (plan, SampleFrame(states = [], values = [NodeSample(identity = 1, value = 0.25)]), 2, 0, 0.5, \(base, control) => base * control))}"
    ```
    ```output
    Success(0.5) Error(InvalidConfiguration { detail: "Control inputs must stay between zero and one." }) Success(0.125)
    ```
    *)
    export controlled (plan, frame, identity, inlet, base, combine) = controlledWith (plan, frame, identity, inlet, base, combine, "Control inputs must stay between zero and one.")

    (** Read an optional normalised control with the processor's error detail.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [Cable(source = 1, outlet = 0, destination = 2, inlet = 0)]), order = [1, 2], feedback = [])
    rendered = SampleFrame(states = [], values = [NodeSample(identity = 1, value = 2.0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::controlledWith (plan, rendered, 2, 0, 0.5, \(base, control) => base * control, "My detail."))}"
    ```
    ```output
    Error(InvalidConfiguration { detail: "My detail." })
    ```
    *)
    export controlledWith (plan, frame, identity, inlet, base, combine, detail) = match connection (plan, identity, inlet)
        Error _ => Success(value = base)
        Success cable => match fromCable (frame, cable)
            Error why => Error(message = why)
            Success control => match control >= 0.0 && control <= 1.0
                false => Error(message = InvalidConfiguration(detail = detail))
                true => Success(value = combine (base, control))

    (** An unplugged optional audio inlet is silent. A routed source must already be rendered.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [Cable(source = 1, outlet = 0, destination = 2, inlet = 0)]), order = [1, 2], feedback = [])
    rendered = SampleFrame(states = [], values = [NodeSample(identity = 1, value = 2.0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::optional (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 2, 1))} ${arithmetic (\() => RenderInputs::optional (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 2, 0))} ${arithmetic (\() => RenderInputs::optional (plan, rendered, 2, 0))}"
    ```
    ```output
    Success(0.0) Error(MissingResource { detail: "An input was read before its source was rendered." }) Success(2.0)
    ```
    *)
    export optional (plan, frame, identity, inlet) = match connection (plan, identity, inlet)
        Error _ => Success(value = 0.0)
        Success cable => fromCable (frame, cable)

    (** Resolve a routed mono input from an already rendered source.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [Cable(source = 1, outlet = 0, destination = 2, inlet = 0)]), order = [1, 2], feedback = [])
    rendered = SampleFrame(states = [], values = [NodeSample(identity = 1, value = 2.0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::input (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 2, 1))} ${arithmetic (\() => RenderInputs::input (plan, rendered, 2, 0))}"
    ```
    ```output
    Error(MissingResource { detail: "An audio input is not connected." }) Success(2.0)
    ```
    *)
    export input (plan, frame, identity, inlet) = match connection (plan, identity, inlet)
        Error _ => Error(message = MissingResource(detail = "An audio input is not connected."))
        Success cable => fromCable (frame, cable)

    (** Read one produced sample and reject invalid numeric output before publication.
    # Examples
    ```osprey
    frame = SampleFrame(states = [], values = [NodeSample(identity = 1, value = 0.5), NodeSample(identity = 2, value = floatDiv (0.0, 0.0))])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::sample (frame, 1))} ${arithmetic (\() => RenderInputs::sample (frame, 2))} ${arithmetic (\() => RenderInputs::sample (frame, 3))}"
    ```
    ```output
    Success(0.5) Error(NumericalFailure { detail: "Non-finite or excessive graph output." }) Error(MissingResource { detail: "index out of bounds" })
    ```
    *)
    export sample (frame, identity) = match Seek::first (frame.values, \v => v.identity == identity)
        Error _ => Error(message = Outcomes::indexOutOfBounds)
        Success output => match output.value == output.value && abs output.value <= 1000000.0
            false => Error(message = NumericalFailure(detail = "Non-finite or excessive graph output."))
            true => Success(value = output.value)

    replaced (next, held) = match held.identity == next.identity
        true => next
        false => held

    sampled (frame, identity, sample) = listAppend frame.values (NodeSample(identity = identity, value = sample))

    (** Publish the output of a node whose state is unchanged.
    # Examples
    ```osprey
    print "${RenderInputs::output (SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 1, 0.5)}"
    ```
    ```output
    { states: [{ identity: 1, phase: 0.0, integratorOne: 0.0, integratorTwo: 0.0, delay: [], memory: KernelIdle }], values: [{ identity: 1, value: 0.5 }] }
    ```
    *)
    export output (frame, identity, sample) = frame(values = sampled (frame, identity, sample))

    (** Publish one sample and its updated persistent state.
    # Examples
    ```osprey
    frame = SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = [])
    print "${RenderInputs::emitted (frame, KernelState(identity = 1, phase = 1.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle), 0.5)}"
    ```
    ```output
    { states: [{ identity: 1, phase: 1.0, integratorOne: 0.0, integratorTwo: 0.0, delay: [], memory: KernelIdle }], values: [{ identity: 1, value: 0.5 }] }
    ```
    *)
    export emitted (frame, next, sample) = frame(states = mapList (frame.states, \s => replaced (next, s)), values = sampled (frame, next.identity, sample))

    emptyState identity = KernelState(identity = identity, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)

    (** Persistent per-channel sample storage, counted against the graph's bounded delay budget.
    # Examples
    ```osprey
    print "${RenderInputs::storage (Delay 64)} ${RenderInputs::storage (Waveguide(capacity = 480))} ${RenderInputs::storage (Spectral(size = 256, hop = 64))} ${RenderInputs::storage Reverb} ${RenderInputs::storage Oscillator}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export storage processor = match processor
        Delay count => count
        Waveguide capacity => capacity
        FractionalDelay capacity => capacity
        Modal => 16
        Additive => PartialBanks::capacity
        Spectral size _ => SpectralKernels::storage size
        Shaper => EffectKernels::shaperStorage
        Reverb => Reverbs::graphStorage ()
        Shifter => EffectKernels::shifterStorage
        PhaseOperator => satAdd 1 Oversamplers::taps
        Bowed capacity => satMul capacity 2
        StrikeComb capacity => capacity
        _ => 0

    (** Allocate one kernel, also used by multichannel clip execution.
    # Examples
    ```osprey
    print "${RenderInputs::initialState (Components::delay (1, 4))} ${RenderInputs::initialState (Components::exciter (1, 7))}"
    ```
    ```output
    { identity: 1, phase: 0.0, integratorOne: 0.0, integratorTwo: 0.0, delay: [0.0, 0.0, 0.0, 0.0], memory: KernelIdle } { identity: 1, phase: 0.0, integratorOne: 7.0, integratorTwo: 0.0, delay: [], memory: KernelIdle }
    ```
    *)
    export initialState n =
        empty = emptyState n.identity
        match n.processor
            Spectral _ _ => empty
            Bowed _ => empty
            Modal => empty
            Shifter => empty
            Reverb => empty
            Exciter seed => empty(integratorOne = toFloat seed)
            _ => empty(delay = Sequences::zeros (storage n.processor))

    (** Allocate initial reference state after graph validation.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => RenderInputs::initial plan)}"
    ```
    ```output
    { states: [{ identity: 1, phase: 0.0, integratorOne: 0.0, integratorTwo: 0.0, delay: [], memory: KernelIdle }], samples: [], position: 0, meters: [] }
    ```
    *)
    export initial plan = Rendered(states = mapList (plan.graph.nodes, initialState), samples = [], position = 0, meters = [])
