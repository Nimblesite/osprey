// Implements [SYNTH-GRAPH]. Graph edits are pure; a rejected edit preserves the caller's graph.
namespace synth

(** Searching a list for one item. *)
module Seek
    (** The first item that `matches`, found without building a list of the matches: the renderer asks this for every node of every sample ([DAW-PERF-ROUND]).
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Seek::first ([1, 2, 3], \n => n > 1))} ${arithmetic (\() => Seek::first ([1], \n => n > 1))}"
    ```
    ```output
    Success(2) Error(MissingResource { detail: "No item matches." })
    ```
    *)
    export first<T> : (List<T>, (T) -> bool) -> Result<T, Fault>
    first (items, matches) = from (items, matches, 0)

    from<T> : (List<T>, (T) -> bool, int) -> Result<T, Fault>
    from (items, matches, index) = match listGet items index
        Error _ => Error(message = MissingResource(detail = "No item matches."))
        Success item => match matches item
            true => Success(value = item)
            false => from (items, matches, index + 1)

(** Immutable graph editing and checked scheduling before rendering begins. *)
module Graphs
    (** A graph with no components or routes.
    # Examples
    ```osprey
    print "${Graphs::empty}"
    ```
    ```output
    { nodes: [], cables: [] }
    ```
    *)
    export empty = Graph(nodes = [], cables = [])

    (** The parameter of node `n` keyed `key`, or the out-of-range error when it has none.
    # Examples
    ```osprey
    print "${Graphs::parameterNamed (Components::sine (1, 440.0), "frequency")} ${Graphs::parameterNamed (Components::sine (1, 440.0), "gain")}"
    ```
    ```output
    Success({ key: "frequency", label: "Frequency", unit: Hertz, minimum: 0.0, maximum: 19000.0, initial: 440.0, automatable: true }) Error({ index: 0, length: 0 })
    ```
    *)
    export parameterNamed (n, key) = listGet (filterList (n.parameters, \p => p.key == key)) 0

    (** Index each destination's upstream node IDs once for graph traversal.
    # Examples
    ```osprey
    sources = Graphs::inputSources [Cable(source = 1, outlet = 0, destination = 3, inlet = 0), Cable(source = 2, outlet = 0, destination = 3, inlet = 0)]
    print "${mapGet sources "3"} ${mapGet sources "1"}"
    ```
    ```output
    Success([2, 1]) Error(mapGet: key not found)
    ```
    *)
    export inputSources cables = foldList (cables, Map(), \(index, cable) =>
        key = toString cable.destination
        mapSet index key (listPrepend (mapGet index key ?: []) cable.source))

    visitInputs (inputs, pending, visited) = match pending
        [] => visited
        [identity, ...rest] =>
            key = toString identity
            match mapContains visited key
                true => visitInputs (inputs, rest, visited)
                false =>
                    next = foldList (mapGet inputs key ?: [], rest, \(held, source) => listPrepend held source)
                    visitInputs (inputs, next, mapSet visited key true)

    (** The given roots and every upstream node, including through delayed feedback.
    # Examples
    ```osprey
    visited = Graphs::inputAncestors ([Cable(source = 1, outlet = 0, destination = 2, inlet = 0), Cable(source = 2, outlet = 0, destination = 3, inlet = 0), Cable(source = 4, outlet = 0, destination = 3, inlet = 1)], [3])
    print "${mapContains visited "3"} ${mapContains visited "1"} ${mapContains visited "4"} ${mapContains visited "5"}"
    ```
    ```output
    true true true false
    ```
    *)
    export inputAncestors (cables, roots) = visitInputs (inputSources cables, roots, Map())

    (** Locate one component by stable identity.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::gain (2, 1.0)], cables = [])
    print "${Graphs::node (graph, 1)} ${Graphs::node (Graphs::empty, 1)}"
    ```
    ```output
    Invalid { fault: MissingNode } Invalid { fault: MissingNode }
    ```
    *)
    export node (graph, identity) = match listGet (filterList (graph.nodes, \n => n.identity == identity)) 0
        Success found => Valid(value = found)
        Error _ => Invalid(fault = MissingNode)

    // Parameter and ParameterValue both have keys; the closure needs the intended record.
    uniqueParameters (parameters : List<Parameter>) = all (parameters, \p => length (filterList (parameters, \other => other.key == p.key)) == 1)

    validParameter p = p.key != "" && p.minimum <= p.initial && p.initial <= p.maximum && abs p.minimum <= 1000000000000.0 && abs p.maximum <= 1000000000000.0

    (** The channel count the current graph engine can prepare for one port.
    # Examples
    ```osprey
    print "${Graphs::channelCount 2} ${Graphs::channelCount 0} ${Graphs::channelCount 65}"
    ```
    ```output
    true false false
    ```
    *)
    export channelCount count = count >= 1 && count <= 64

    validPort p = p.name != "" && channelCount p.channels

    all<T> : (List<T>, (T) -> bool) -> bool
    all (items, predicate) = foldList (items, true, \(ok, item) => ok && predicate item)

    processorValid processor = match processor
        SamplePlayer resource => match SampleResources::prepare resource
            Error _ => false
            Success _ => true
        Granular resource capacity seed => match SampleResources::prepare resource
            Error _ => false
            Success _ => capacity >= 1 && capacity <= 256 && seed >= 1 && seed <= 2147483646
        Delay count => count >= 1 && count <= 1920000
        Exciter seed => seed >= 1 && seed <= 2147483646
        Spectral size hop => Ffts::valid size && (hop == intDiv size 4 || hop == intDiv size 8)
        TableOscillator table => length table.frames >= 1 && length table.frames <= 64 && length (filterList (table.frames, \frame => length frame.levels >= 1 && length (filterList (frame.levels, \level => length level.samples == table.size)) == length frame.levels)) == length table.frames
        Waveguide capacity => capacity >= 4 && capacity <= 96000
        Bowed capacity => capacity >= 4 && capacity <= 96000
        StrikeComb capacity => capacity >= 2 && capacity <= 96000
        FractionalDelay capacity => capacity >= 2 && capacity <= 1920000
        External identity latency => identity != "" && latency >= 0 && latency <= 1920000
        _ => true

    validNode n = n.identity >= 0 && routed n && processorValid n.processor && all (n.inputs, validPort) && all (n.outputs, validPort)

    // [SYNTH-GRAPH-CHANNELS] Every map entry names an input channel or silence; anything else is invalid.
    routed n = match n.processor
        Route entries => match listGet n.inputs 0
            Error _ => false
            Success input => length (filterList (entries, \entry => entry >= -1 && entry < input.channels)) == length entries
        _ => true

    checkedNode n = match validNode n
        false => Invalid(fault = InvalidNode)
        true => match uniqueParameters n.parameters
            false => Invalid(fault = DuplicateParameter)
            true => match all (n.parameters, validParameter)
                false => Invalid(fault = InvalidParameter)
                true => Valid(value = n)

    inserted (graph : Graph, n) = match checkedNode n
        Invalid fault => Invalid(fault = fault)
        Valid _ => Valid(value = graph(nodes = listAppend graph.nodes n))

    (** Add a component with a unique, stable identity.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::add (Graphs::empty, Components::gain (2, 1.0)))} ${arithmetic (\() => Graphs::add (Graph(nodes = [Components::gain (2, 1.0)], cables = []), Components::gain (2, 1.0)))}"
    ```
    ```output
    Valid { value: { nodes: [{ identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [] } } Invalid { fault: DuplicateNode }
    ```
    *)
    export add (graph, n) = match node (graph, n.identity)
        Valid _ => Invalid(fault = DuplicateNode)
        Invalid _ => inserted (graph, n)

    port (ports, index) = match listGet ports index
        Error _ => Invalid(fault = InvalidPort)
        Success p => Valid(value = p)

    compatible (one, other) = one.rate == other.rate && one.channels == other.channels && one.unit == other.unit

    joinedPorts (source, destination, cable) = match port (source.outputs, cable.outlet)
        Invalid fault => Invalid(fault = fault)
        Valid out => match port (destination.inputs, cable.inlet)
            Invalid fault => Invalid(fault = fault)
            Valid input => match compatible (out, input)
                true => Valid(value = cable)
                false => Invalid(fault = IncompatiblePorts)

    checkedCable (graph, cable) = match node (graph, cable.source)
        Invalid fault => Invalid(fault = fault)
        Valid source => match node (graph, cable.destination)
            Invalid fault => Invalid(fault = fault)
            Valid destination => joinedPorts (source, destination, cable)

    occupied (graph, cable) = length (filterList (graph.cables, \c => c.destination == cable.destination && c.inlet == cable.inlet)) != 0

    (** Connect compatible typed ports, requiring explicit mixing for multiple sources.
    # Examples
    ```osprey
    chain = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [])
    print "${Graphs::connect (chain, Cable(source = 1, outlet = 0, destination = 2, inlet = 0))} ${Graphs::connect (chain, Cable(source = 1, outlet = 0, destination = 2, inlet = 1))} ${Graphs::connect (chain, Cable(source = 3, outlet = 0, destination = 2, inlet = 0))}"
    ```
    ```output
    Valid { value: { nodes: [{ identity: 1, processor: Oscillator, inputs: [], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "frequency", label: "Frequency", unit: Hertz, minimum: 0.0, maximum: 19000.0, initial: 440.0, automatable: true }] }, { identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [{ source: 1, outlet: 0, destination: 2, inlet: 0 }] } } Invalid { fault: InvalidPort } Invalid { fault: MissingNode }
    ```
    *)
    export connect (graph : Graph, cable) = match checkedCable (graph, cable)
        Invalid fault => Invalid(fault = fault)
        Valid _ => match occupied (graph, cable)
            true => Invalid(fault = OccupiedInput)
            false => Valid(value = graph(cables = listAppend graph.cables cable))

    // Explicit delay nodes publish old state first and consume incoming cables after the schedule.
    delayed processor = match processor
        Delay _ => true
        _ => false

    indexNode (outcome, n) = match outcome
        Invalid fault => Invalid(fault = fault)
        Valid nodes => match mapContains nodes (toString n.identity)
            true => Invalid(fault = DuplicateNode)
            false => match checkedNode n
                Invalid fault => Invalid(fault = fault)
                Valid component => Valid(value = mapSet nodes (toString n.identity) (RankedNode(component = component, ordinal = mapLength nodes)))

    linked (routes, cable, source, destination) =
        key = "${cable.destination}/${cable.inlet}"
        match mapContains routes.occupiedInlets key
            true => Invalid(fault = OccupiedInput)
            false =>
                next = routes(occupiedInlets = mapSet routes.occupiedInlets key true)
                match delayed destination.component.processor
                    true => Valid(value = next(delayedInputs = listPrepend next.delayedInputs cable))
                    false =>
                        downstream = mapGet routes.destinations (toString source.ordinal) ?: []
                        count = mapGet routes.dependencies (toString destination.ordinal) ?: 0
                        Valid(value = next(destinations = mapSet routes.destinations (toString source.ordinal) (listPrepend downstream destination.ordinal), dependencies = mapSet routes.dependencies (toString destination.ordinal) (satAdd count 1)))

    indexCable (nodes, outcome, cable) = match outcome
        Invalid fault => Invalid(fault = fault)
        Valid routes => match mapGet nodes (toString cable.source)
            Error _ => Invalid(fault = MissingNode)
            Success source => match mapGet nodes (toString cable.destination)
                Error _ => Invalid(fault = MissingNode)
                Success destination => match joinedPorts (source.component, destination.component, cable)
                    Invalid fault => Invalid(fault = fault)
                    Valid _ => linked (routes, cable, source, destination)

    // A leftist min-heap preserves the first ready node in declaration order, including after fan-in.
    depth heap = match heap
        NoReadyNode => 0
        ReadyNode _ height _ _ => height

    branch (ordinal, left, right) = match depth left >= depth right
        true => ReadyNode(ordinal = ordinal, depth = satAdd 1 (depth right), left = left, right = right)
        false => ReadyNode(ordinal = ordinal, depth = satAdd 1 (depth left), left = right, right = left)

    meld (one, other) = match one
        NoReadyNode => other
        ReadyNode first _ left right => match other
            NoReadyNode => one
            ReadyNode second _ lower upper => match first <= second
                true => branch (first, left, meld (right, other))
                false => branch (second, lower, meld (upper, one))

    enqueue (ready, ordinal) = meld (ready, ReadyNode(ordinal = ordinal, depth = 1, left = NoReadyNode, right = NoReadyNode))

    release (queue, ordinal) =
        count = satSub (mapGet queue.remainingInputs (toString ordinal) ?: 0) 1
        ready = match count == 0
            true => enqueue (queue.readyNodes, ordinal)
            false => queue.readyNodes
        queue(readyNodes = ready, remainingInputs = mapSet queue.remainingInputs (toString ordinal) count)

    schedule (graph, routes, queue, ordered) = match queue.readyNodes
        NoReadyNode => match length ordered == length graph.nodes
            false => Invalid(fault = Cycle)
            true => Valid(value = Prepared(graph = graph, order = listReverse ordered, feedback = listReverse routes.delayedInputs))
        ReadyNode ordinal _ left right => match listGet graph.nodes ordinal
            Error _ => Invalid(fault = MissingNode)
            Success n =>
                downstream = mapGet routes.destinations (toString ordinal) ?: []
                next = foldList (downstream, queue(readyNodes = meld (left, right)), release)
                schedule (graph, routes, next, listPrepend ordered n.identity)

    roots (routes, count) = foldList (toList (range (0, count)), NoReadyNode, \(heap, ordinal) =>
        match mapContains routes.dependencies (toString ordinal)
            true => heap
            false => enqueue (heap, ordinal))

    indexed graph = match foldList (graph.nodes, Valid(value = Map()), indexNode)
        Invalid fault => Invalid(fault = fault)
        Valid nodes =>
            emptyRoutes = RouteIndex(occupiedInlets = Map(), destinations = Map(), dependencies = Map(), delayedInputs = [])
            foldList (graph.cables, Valid(value = emptyRoutes), \(outcome, cable) => indexCable (nodes, outcome, cable))

    (** Validate every component and endpoint in a bulk graph edit before publication.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::checked (Graph(nodes = [Components::gain (-1, 1.0)], cables = [])))} ${arithmetic (\() => Graphs::checked (Graph(nodes = [Components::gain (2, 1.0)], cables = [])))}"
    ```
    ```output
    Invalid { fault: InvalidNode } Valid { value: { nodes: [{ identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [] } }
    ```
    *)
    export checked graph = match indexed graph
        Invalid fault => Invalid(fault = fault)
        Valid _ => Valid(value = graph)

    (** Revalidate stored records and schedule typed routes by their endpoints.
    # Examples
    ```osprey
    cycle = Graph(nodes = [Components::gain (2, 1.0), Components::gain (3, 1.0)], cables = [Cable(source = 2, outlet = 0, destination = 3, inlet = 0), Cable(source = 3, outlet = 0, destination = 2, inlet = 0)])
    chain = Graph(nodes = [Components::gain (2, 1.0), Components::gain (3, 1.0)], cables = [Cable(source = 2, outlet = 0, destination = 3, inlet = 0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::prepare cycle)} ${arithmetic (\() => Graphs::prepare chain)}"
    ```
    ```output
    Invalid { fault: Cycle } Valid { value: { graph: { nodes: [{ identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }, { identity: 3, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [{ source: 2, outlet: 0, destination: 3, inlet: 0 }] }, order: [2, 3], feedback: [] } }
    ```
    *)
    export prepare graph = match indexed graph
        Invalid fault => Invalid(fault = fault)
        Valid routes => schedule (graph, routes, ReadyQueue(readyNodes = roots (routes, length graph.nodes), remainingInputs = routes.dependencies), [])

    // [PRISM-ROUTING-DELIVERY] Publish only a completely validated replacement.
    edited graph = match prepare graph
        Invalid fault => Invalid(fault = fault)
        Valid prepared => Valid(value = prepared.graph)

    (** Remove a component and all incident routes; unknown identities are errors.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::gain (2, 1.0)], cables = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::remove (graph, 1))} ${arithmetic (\() => Graphs::remove (Graphs::empty, 1))}"
    ```
    ```output
    Invalid { fault: MissingNode } Invalid { fault: MissingNode }
    ```
    *)
    export remove (graph, identity) = match node (graph, identity)
        Invalid fault => Invalid(fault = fault)
        Valid _ => edited (graph(nodes = filterList (graph.nodes, \n => n.identity != identity), cables = filterList (graph.cables, \c => c.source != identity && c.destination != identity)))

    (** Remove an exact route, refusing stale cable selections.
    # Examples
    ```osprey
    cable = Cable(source = 1, outlet = 0, destination = 2, inlet = 0)
    wired = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [cable])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::disconnect (wired, cable))} ${arithmetic (\() => Graphs::disconnect (Graphs::empty, cable))}"
    ```
    ```output
    Valid { value: { nodes: [{ identity: 1, processor: Oscillator, inputs: [], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "frequency", label: "Frequency", unit: Hertz, minimum: 0.0, maximum: 19000.0, initial: 440.0, automatable: true }] }, { identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [] } } Invalid { fault: InvalidPort }
    ```
    *)
    export disconnect (graph, cable) = match length (filterList (graph.cables, \c => structuralEquals (c, cable))) == 0
        true => Invalid(fault = InvalidPort)
        false => edited (graph(cables = filterList (graph.cables, \c => structuralEquals (c, cable) == false)))

    (** Replace an inlet's route atomically, validating ports and cycles before publication.
    # Examples
    ```osprey
    chain = Graph(nodes = [Components::sine (1, 440.0), Components::gain (2, 1.0)], cables = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Graphs::rewire (chain, Cable(source = 1, outlet = 0, destination = 2, inlet = 0)))} ${arithmetic (\() => Graphs::rewire (chain, Cable(source = 1, outlet = 1, destination = 2, inlet = 0)))}"
    ```
    ```output
    Valid { value: { nodes: [{ identity: 1, processor: Oscillator, inputs: [], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "frequency", label: "Frequency", unit: Hertz, minimum: 0.0, maximum: 19000.0, initial: 440.0, automatable: true }] }, { identity: 2, processor: Amplifier, inputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], outputs: [{ name: "audio", rate: Audio, channels: 1, unit: Amplitude }], parameters: [{ key: "gain", label: "Gain", unit: Amplitude, minimum: 0.0, maximum: 8.0, initial: 1.0, automatable: true }] }], cables: [{ source: 1, outlet: 0, destination: 2, inlet: 0 }] } } Invalid { fault: InvalidPort }
    ```
    *)
    export rewire (graph, cable) =
        detached = graph(cables = filterList (graph.cables, \c => c.destination != cable.destination || c.inlet != cable.inlet))
        match connect (detached, cable)
            Invalid fault => Invalid(fault = fault)
            Valid connected => edited connected
