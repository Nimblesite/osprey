// [SYNTH-HOST-MIDI-OSCILLATOR] Connected MIDI owns pitch, velocity and gate at exact sample offsets.
namespace synth

(** Monophonic last-note-priority oscillator; unrelated note-offs never silence the current note. *)
module MidiOscillators
    (** Whether the oscillator has an explicit event route. *)
    export connected (graph, n) = n.processor == Oscillator && length (filterList (graph.cables, \c => c.destination == n.identity && c.inlet == 0)) == 1

    (** A fresh connected instrument is silent until its first note-on. *)
    export initial n = MidiVoice(kernel = RenderInputs::initialState n, pitch = 0, channel = 0, noteIdentity = 0, velocity = 0.0, active = false)

    (** Validate public retained voice state before consuming another block. *)
    export valid (n, voice) = n.processor == Oscillator && voice.kernel.identity == n.identity && voice.kernel.phase >= 0.0 && voice.kernel.phase < 1.0 && voice.pitch >= 0 && voice.pitch <= 127 && voice.channel >= 0 && voice.channel <= 15 && voice.noteIdentity >= 0 && voice.noteIdentity <= 2147483647 && voice.velocity >= 0.0 && voice.velocity <= 1.0

    event (voice, note) = match note.kind == 1 && note.velocity > 0.0
        true => voice(pitch = note.pitch, channel = note.channel, noteIdentity = note.identity, velocity = note.velocity, active = true)
        false => match note.pitch == voice.pitch && note.channel == voice.channel && note.identity == voice.noteIdentity
            true => voice(active = false, velocity = 0.0)
            false => voice

    parameter (voice, p) = match p.key == "frequency"
        true => p(initial = Waves::midiFrequency (toFloat voice.pitch))
        false => p

    rendered (plan, n, voice, samples) =
        snapshot = Parameters::initial (Graph(nodes = [n(parameters = mapList (n.parameters, \p => parameter (voice, p)))], cables = []))
        frame = SampleFrame(states = [voice.kernel], values = [])
        match RenderKernels::step (plan, 48000.0, snapshot, frame, n.identity)
            Error why => Error(message = why)
            Success next => match RenderInputs::held (next, n.identity)
                Error why => Error(message = why)
                Success kernel => match RenderInputs::sample (next, n.identity)
                    Error why => Error(message = why)
                    Success value => Success(value = ClipKernel(heldKernel = voice(kernel = kernel), kernelSamples = listPrepend samples (Waves::velocitySample (value, voice.velocity))))

    sample (plan, n, notes, outcome, index) = match outcome
        Error why => Error(message = why)
        Success held =>
            voice = foldList (filterList (notes, \note => note.offset == index), held.heldKernel, event)
            match voice.active
                false => Success(value = held(heldKernel = voice, kernelSamples = listPrepend held.kernelSamples 0.0))
                true => rendered (plan, n, voice, held.kernelSamples)

    ordered (notes, previous) = match notes
        [] => true
        [note, ...rest] => note.offset >= previous && ordered (rest, note.offset)

    (** Retain note ownership and oscillator phase across blocks; events at a boundary belong to the next block. *)
    export block (plan, clips, n, voice, frames) = match valid (n, voice) && frames >= 1 && frames <= 32768
        false => Error(message = "Invalid MIDI oscillator state or frame capacity.")
        true => match ClipInputs::routed (plan.graph, clips, n.identity, 0)
            Error why => Error(message = why)
            Success clip => match length clip.clipNotes <= 1024 && ordered (clip.clipNotes, 0) && length (filterList (clip.clipNotes, \note => HostPackets::validNote (frames, note))) == length clip.clipNotes
                false => Error(message = "Invalid or unordered MIDI oscillator events.")
                true => match foldList (toList (range (0, frames)), Success(value = ClipKernel(heldKernel = voice, kernelSamples = [])), \(held, index) => sample (plan, n, clip.clipNotes, held, index))
                    Error why => Error(message = why)
                    Success rendered => Success(value = rendered(kernelSamples = listReverse rendered.kernelSamples))
