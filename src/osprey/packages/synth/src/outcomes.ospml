namespace synth

(** The one Result chain the synth modules share: errors pass through unchanged. *)
module Outcomes
    (** The fault raised when a required resource index is outside its bounds.
    # Examples
    ```osprey
    detail = match Outcomes::indexOutOfBounds
        MissingResource message => message
        _ => "unexpected fault"
    print detail
    ```
    ```output
    index out of bounds
    ```
    *)
    export indexOutOfBounds = MissingResource(detail = "index out of bounds")

    (** An Error passes through; a Success payload continues into `step`.
    # Examples
    ```osprey
    print "${Outcomes::carried (Error(message = MissingResource(detail = "x")), \v => Success(value = v + 1.0))} ${Outcomes::carried (Success(value = 1.0), \v => Success(value = v + 1.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export carried (outcome, step) = match outcome
        Error why => Error(message = why)
        Success value => step value

    picked (options, index, message) = match listGet options index
        Error _ => Error(message = InvalidConfiguration(detail = message))
        Success option => Success(value = option)

    (** Decode a discrete graph control without truncating fractional settings.
    # Examples
    ```osprey
    print "${Outcomes::integer (2.0, "bad")} ${Outcomes::integer (2.5, "bad")}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export integer (selector, message) = match floatToInt selector
        Error _ => Error(message = InvalidConfiguration(detail = message))
        Success index => match toFloat index == selector
            false => Error(message = InvalidConfiguration(detail = message))
            true => Success(value = index)

    (** The option a whole-number selector names, starting at zero.
    # Examples
    ```osprey
    print "${Outcomes::chosen (1.0, ["a", "b"], "bad")} ${Outcomes::chosen (5.0, ["a", "b"], "bad")} ${Outcomes::chosen (0.5, ["a", "b"], "bad")}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export chosen (selector, options, message) = carried (integer (selector, message), \index => picked (options, index, message))

    (** `value` as a whole number into `step`; a nonfinite or out-of-range value is a numerical fault.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Outcomes::whole (3.0, \n => Success(value = n * 2)))} ${arithmetic (\() => Outcomes::whole (3.5, \n => Success(value = n)))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export whole (value, step) = match floatToInt value
        Error _ => Error(message = NumericalFailure(detail = "A whole-number value is not finite or is out of range."))
        Success number => step number
