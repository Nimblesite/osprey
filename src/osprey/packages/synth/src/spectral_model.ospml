namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type Complex =
    re : float
    im : float

type ComplexSplit =
    evens : List<Complex>
    odds : List<Complex>

type ComplexHalves =
    lower : List<Complex>
    upper : List<Complex>

type MorphMode =
    Blend
    Envelope
    Partial

type SpectralTransform =
    SpectralPass
    SpectralFreeze
        held : bool
    SpectralBand
        low : float
        high : float
    SpectralShift
        bins : int
    SpectralSmear
        amount : float
    SpectralMorph
        amount : float
        mode : MorphMode
    SpectralPitch
        ratio : float
        formant : float
    SpectralSeries
        steps : List<SpectralTransform>

type SpectralConfig =
    sampleRate : float
    size : int
    hop : int
    transform : SpectralTransform
    mix : float

type SpectralState =
    input : List<float>
    side : List<float>
    output : List<float>
    memory : List<Complex>
    motion : List<Complex>
    countdown : int
    frames : int
    captured : bool

type SpectralSample =
    sample : float
    next : SpectralState

type SpectralFrame =
    bins : List<Complex>
    memory : List<Complex>
    motion : List<Complex>
    captured : bool

type SpectralBin =
    index : int
    frequency : float
    magnitude : float
    re : float
    im : float

type SpectralView =
    channel : int
    position : int
    size : int
    bins : List<SpectralBin>

type PeakScan =
    latest : int
    owners : List<int>

type SpectrumBand =
    centre : float
    level : float
    peak : float

type SpectrumSchedule =
    LiveSpectrum
    FixedSpectrum
        config : SpectralConfig

