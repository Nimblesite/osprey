// [SYNTH-ADVANCED-NONLINEAR] 2× oversampled waveshaping with prepared half-band filters.
namespace synth

(** 31-tap Blackman half-band filters up and down; latency is 15 base-rate samples plus the shaper's. *)
module Oversamplers
    (** Filter length; odd so the centre tap is exact. *)
    export taps = 31

    (** Base-rate latency of the resampling filters. *)
    export latency = 15

    (** The 31 fixed half-band taps shared by the upsampler and decimator. *)
    export coefficients () = mapList (toList (range (0, taps)), \index => NonlinearMath::halfband (toFloat index, toFloat taps))

    zeros () = mapList (toList (range (0, taps)), \_ => 0.0)

    (** Silent shaper and filter histories. *)
    export initial () = OversampledState(shaper = Waveshapers::initial, up = zeros (), down = zeros ())

    accumulated (history, weights, index, sum) = match listGet weights index
        Error _ => sum
        Success tap => match listGet history index
            Error _ => sum
            Success sample => accumulated (history, weights, satAdd index 1, sum + sample * tap)

    (** Apply the half-band FIR from oldest to newest in the stored sample history. *)
    export filtered history = accumulated (history, coefficients (), 0, 0.0)

    // Run the shaper at twice the rate, telling it so: its 5 Hz DC blocker keeps its corner in real time.
    shapedPair (config, held, input, weights) =
        upFirst = Sequences::shifted (held.up, input)
        upSecond = Sequences::shifted (upFirst, 0.0)
        oversampled = config(sampleRate = config.sampleRate * 2.0)
        first = Waveshapers::next (oversampled, held.shaper, 2.0 * accumulated (upFirst, weights, 0, 0.0))
        second = Waveshapers::next (oversampled, first.next, 2.0 * accumulated (upSecond, weights, 0, 0.0))
        downed = Sequences::shifted (Sequences::shifted (held.down, first.sample), second.sample)
        OversampledSample(sample = accumulated (downed, weights, 0, 0.0), next = OversampledState(shaper = second.next, up = upSecond, down = downed))

    (** One base-rate sample; histories of the wrong length are an error rather than a guessed filter. *)
    export next (config, held, input) = prepared (config, held, input, coefficients ())

    (** Apply a prepared half-band filter to one base-rate sample. *)
    export prepared (config, held, input, weights) = match length weights == taps && length held.up == taps && length held.down == taps
        false => Error(message = IncompatibleLayout(detail = "Oversampler history does not match its filter."))
        true => Success(value = shapedPair (config, held, input, weights))
