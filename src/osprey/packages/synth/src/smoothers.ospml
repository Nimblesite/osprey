// [SYNTH-ADVANCED-CORE-PORTS] Reusable smoothing/slew with a declared response and continuous state.
namespace synth

(** One-pole: 63% of a step after `time` seconds. Linear: full scale (1.0) in `time` seconds, then exact. *)
module Smoothers
    (** Start at a value, so the first output does not jump.
    # Examples
    ```osprey
    print "${Smoothers::initial 0.25}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export initial value = SmootherState(value = value)

    (** Time 0.1 ms–10 s at 8–384 kHz.
    # Examples
    ```osprey
    config = SmootherConfig(sampleRate = 10.0, time = 1.0, linear = true)
    print "${Smoothers::configure config} ${Smoothers::configure (config(time = 0.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && config.time >= 0.0001 && config.time <= 10.0
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Smoothing time must be 0.1 ms to 10 s at a valid rate."))

    moved (config, held, target) = match config.linear
        true => PhysicalMath::slewed (held.value, target, config.time, config.sampleRate)
        false => held.value + PhysicalMath::smoothingCoefficient (config.time, config.sampleRate) * (target - held.value)

    (** One step toward `target`; the output is the new state.
    # Examples
    ```osprey
    config = SmootherConfig(sampleRate = 10.0, time = 1.0, linear = true)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Smoothers::next (config, Smoothers::initial 0.0, 1.0))} ${arithmetic (\() => Smoothers::next (config, Smoothers::initial 0.95, 1.0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export next (config, held, target) =
        value = moved (config, held, target)
        SmootherSample(sample = value, next = SmootherState(value = value))
