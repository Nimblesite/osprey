// [SYNTH-ADVANCED-CORE-MODELS] The render lifecycle: prepare, activate, render, reset, release with its tail, dispose.
namespace synth

import synth::RenderInputs
import synth::Renderer
import synth::Timings

(** A prepared instance is Ready; Activate makes it Running; ReleaseTail renders at most its declared tail and
    returns to Ready; Reset returns any live stage to Ready with silent state at position 0; Dispose ends it.
    Preparation fixes the sample rate and the largest block. Changing either re-prepares from Ready with
    silent state, because delay lengths and phase steps depend on the rate; a running or releasing run
    must be reset first. A refused transition is an error and the caller keeps its run. *)
module Lifecycles
    settled (rate, block) = rate >= 8000.0 && rate <= 384000.0 && block >= 1 && block <= 8192

    (** Prepare `graph` at a sample rate and largest block, Ready with silent state at position 0. *)
    export prepared (graph, rate, block) = match settled (rate, block)
        false => Error(message = InvalidConfiguration(detail = "A lifecycle needs a sample rate of 8,000 to 384,000 Hz and a block of 1 to 8,192 frames."))
        true => match Graphs::prepare graph
            Invalid _ => Error(message = InvalidConfiguration(detail = "The graph is invalid; inspect Graphs.prepare for the typed fault."))
            Valid plan => Outcomes::carried (Renderer::start graph, \audio => Success(value = Instance(stage = Ready, rate = rate, block = block, plan = plan, audio = audio)))

    named stage = match stage
        Ready => "ready"
        Running => "running"
        Releasing _ => "releasing"
        Disposed => "disposed"

    refused (run, action) = Error(message = InvalidConfiguration(detail = "Cannot ${action} a ${named run.stage} instance."))

    (** Apply one transition; anything the current stage does not allow is refused. *)
    export next (run, transition) = match transition
        Prepare rate block => reprepared (run, rate, block)
        Activate => activated run
        Reset => reset run
        ReleaseTail => released run
        Dispose => disposed run

    reprepared (run, rate, block) = match run.stage
        Ready => prepared (run.plan.graph, rate, block)
        _ => refused (run, "re-prepare")

    activated run = match run.stage
        Ready => Success(value = run(stage = Running))
        _ => refused (run, "activate")

    reset run = match run.stage
        Disposed => refused (run, "reset")
        _ => Success(value = run(stage = Ready, audio = RenderInputs::initial run.plan))

    released run = match run.stage
        Running => Outcomes::carried (tail run, \frames => Success(value = run(stage = Releasing(remaining = frames))))
        _ => refused (run, "release")

    disposed run = match run.stage
        Disposed => refused (run, "dispose")
        _ => Success(value = run(stage = Disposed, audio = Rendered(states = [], samples = [], position = run.audio.position, meters = [])))

    sounding (total, n) = Outcomes::carried (total, \sum => Outcomes::carried (Timings::tail n, \t => Outcomes::carried (Timings::latency n, \l => Success(value = sum + t + l))))

    (** Frames the release renders: every node's tail and latency summed, which bounds any route through it. *)
    export tail run = Outcomes::carried (foldList (run.plan.graph.nodes, Success(value = 0.0), sounding), \samples => Outcomes::whole (WaveMath::tailFrames (samples, run.rate), \frames => Success(value = frames)))

    played (run, after, snapshot, frames) = Outcomes::carried (Renderer::block (run.plan, run.rate, snapshot, run.audio, frames), \audio => Success(value = run(stage = after, audio = audio)))

    releasing (run, snapshot, count, remaining) =
        frames = match count < remaining
            true => count
            false => remaining
        played (run, afterRelease (remaining, frames), snapshot, frames)

    afterRelease (remaining, frames) = match frames == remaining
        true => Ready
        false => Releasing(remaining = satSub remaining frames)

    (** Render 1 to the prepared block of frames; zero-length blocks are refused. A releasing instance renders at most its remaining tail, then is Ready. *)
    export block (run, snapshot, count) = match count < 1 || count > run.block
        true => Error(message = InvalidConfiguration(detail = "A block is 1 to the prepared ${run.block} frames; a larger one needs re-preparation."))
        false => match run.stage
            Running => played (run, Running, snapshot, count)
            Releasing remaining => releasing (run, snapshot, count, remaining)
            _ => refused (run, "render")
