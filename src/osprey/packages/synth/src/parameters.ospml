// [SYNTH-SIGNALS] Commands apply at an explicit sample position; observers see applied state.
namespace synth

(** Validates component parameter changes before publishing a new immutable snapshot. *)
module Parameters
    values n = mapList (n.parameters, \p => ParameterValue(node = n.identity, key = p.key, value = p.initial))

    (** Initial applied values are the graph's declared defaults. *)
    export initial graph = Observation(revision = 0, samplePosition = 0, parameters = foldList (graph.nodes, [], \(all, n) => listConcat all (values n)), components = [])

    descriptor (graph, edit) = match Graphs::node (graph, edit.node)
        Invalid fault => Invalid(fault = fault)
        Valid n => match listGet (filterList (n.parameters, \p => p.key == edit.key)) 0
            Error _ => Invalid(fault = MissingParameter)
            Success p => Valid(value = p)

    (** Whether a value is inside the parameter’s inclusive bounds. *)
    export validValue (p, value) = value >= p.minimum && value <= p.maximum

    replaced (edit, p) = match p.node == edit.node && p.key == edit.key
        true => p(value = edit.value)
        false => p

    applied (snapshot, edit) = snapshot(revision = satAdd snapshot.revision 1, parameters = mapList (snapshot.parameters, \p => replaced (edit, p)))

    change (graph, snapshot, edit) = match descriptor (graph, edit)
        Invalid fault => Invalid(fault = fault)
        Valid p => match validValue (p, edit.value)
            false => Invalid(fault = InvalidParameter)
            true => match length (filterList (snapshot.parameters, \v => v.node == edit.node && v.key == edit.key)) == 1
                false => Invalid(fault = MissingParameter)
                true => Valid(value = applied (snapshot, edit))

    (** Called when an event reaches its sample position; stale UI edits cannot overwrite new values. *)
    export apply (graph, snapshot, edit) = match snapshot.revision != edit.revision || snapshot.revision == 9223372036854775807
        true => Invalid(fault = StaleRevision)
        false => match edit.samplePosition != snapshot.samplePosition || edit.samplePosition < 0
            true => Invalid(fault = InvalidFrame)
            false => change (graph, snapshot, edit)

(** [SYNTH-ADVANCED-LEARNED] Reproducible training and independent evaluation with the production graph fitter. *)
module FitReports
    labelled source = length source.identifier >= 1 && length source.identifier <= 256 && length source.licence >= 1 && length source.licence <= 256 && source.sampleRate == 48000

    valid reference = labelled reference.source && Ffts::valid (length reference.samples) && foldList (reference.samples, true, \(ok, sample) => ok && sample >= -1.0 && sample <= 1.0)

    distinct (training, evaluation) = training.source.identifier != evaluation.source.identifier && structuralEquals (training.samples, evaluation.samples) == false

    (** Fit on the training clip alone. Score the winning values on the separately labelled evaluation clip. *)
    export fit (graph, config, training, evaluation) = match valid training && valid evaluation
        false => Error(message = InvalidConfiguration(detail = "Fit references need labelled, licensed, finite mono clips at 48 kHz and a supported FFT length."))
        true => match distinct (training, evaluation)
            false => Error(message = InvalidConfiguration(detail = "Training and evaluation need distinct source identities and sample data."))
            true => Outcomes::carried (Fitting::fit (graph, config, training.samples), \result => report (graph, config, training.source, evaluation, result))

    report (graph, config, training, evaluation, result) = match Fitting::spectrum evaluation.samples
        Error why => Error(message = why)
        Success powers => Outcomes::carried (Fitting::evaluate (graph, config, powers, result.best.values), \heldOut => Success(value = FitReport(algorithm = "osprey-synth/log-spectrum-es-v1", algorithmLicence = "MIT", training = training, evaluation = evaluation.source, config = config, result = result, evaluationLoss = heldOut.loss)))
