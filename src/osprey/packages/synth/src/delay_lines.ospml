// [SYNTH-ADVANCED-PHYSICAL-PRIMITIVES] Fractional-delay storage shared by waveguides and graph nodes.
namespace synth

(** A fixed-capacity FIFO: the newest sample is last, so a one-sample delay reads the final element. *)
module DelayLines
    outsideLine = InvalidConfiguration(detail = "Delay read is outside the prepared line.")

    (** Allocate silent storage outside rendering; capacity is 2–1,920,000 samples.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        print "${DelayLines::prepare 4} ${DelayLines::prepare 1}"

    arithmetic example
    ```
    ```output
    Success({ samples: [0.0, 0.0, 0.0, 0.0] }) Error(InvalidConfiguration { detail: "Delay capacity must be 2 to 1920000 samples." })
    ```
    *)
    export prepare capacity = match capacity >= 2 && capacity <= 1920000
        true => Success(value = DelayLine(samples = Sequences::zeros capacity))
        false => Error(message = InvalidConfiguration(detail = "Delay capacity must be 2 to 1920000 samples."))

    (** Linear-interpolated read `delay` samples ago, 1 to capacity. Not bandlimited: modulated reads can alias.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        line = DelayLine(samples = [1.0, 2.0, 3.0, 4.0])
        print "${DelayLines::tap (line, 1.0)} ${DelayLines::tap (line, 1.5)} ${DelayLines::tap (line, 9.0)}"

    arithmetic example
    ```
    ```output
    Success(4.0) Success(3.5) Error(InvalidConfiguration { detail: "Delay read is outside the prepared line." })
    ```
    *)
    export tap (line, delay) =
        position = toFloat (length line.samples) - delay
        match delay >= 1.0 && delay <= toFloat (length line.samples) && position == position
            false => Error(message = outsideLine)
            true => match floatToInt (floor position)
                Error _ => Error(message = outsideLine)
                Success older => match listGet line.samples older
                    Error _ => Error(message = outsideLine)
                    Success a => Success(value = Interpolation::linear (a, listGet line.samples (satAdd older 1) ?: a, GrainMath::fraction position))

    (** Write the newest sample and discard the oldest, keeping capacity constant.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        line = DelayLines::push (DelayLine(samples = [1.0, 2.0, 3.0]), 4.0)
        print "${line.samples}"

    arithmetic example
    ```
    ```output
    [2.0, 3.0, 4.0]
    ```
    *)
    export push (line, sample) = match line.samples
        [] => line
        [_oldest, ...rest] => DelayLine(samples = listAppend rest sample)

    // Newest-first copy: the slot `age` samples ago (new rate) reads the old line at `age · ratio`.
    copied (line, ratio, age, remaining, done) = match remaining <= 0
        true => Success(value = done)
        false =>
            position = toFloat age * ratio
            match position > toFloat (length line.samples)
                true => copied (line, ratio, satAdd age 1, satSub remaining 1, listPrepend done 0.0)
                false => Outcomes::carried (tap (line, TableMath::larger (1.0, position)), \value => copied (line, ratio, satAdd age 1, satSub remaining 1, listPrepend done value))

    (** Transfer stored audio to a new rate and capacity: each new slot holds the old line read at the same
        time ago (linear interpolation); history older than the old line is silence, by definition.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0

    example () =
        line = DelayLine(samples = [1.0, 2.0, 3.0, 4.0])
        print "${DelayLines::resampled (line, 48000.0, 24000.0, 4)} ${DelayLines::resampled (line, 0.0, 24000.0, 4)}"

    arithmetic example
    ```
    ```output
    Success({ samples: [0.0, 0.0, 1.0, 3.0] }) Error(InvalidConfiguration { detail: "Resampling needs positive rates and a capacity of 2 to 1920000." })
    ```
    *)
    export resampled (line, oldRate, newRate, capacity) = match oldRate > 0.0 && newRate > 0.0 && capacity >= 2 && capacity <= 1920000
        false => Error(message = InvalidConfiguration(detail = "Resampling needs positive rates and a capacity of 2 to 1920000."))
        true => Outcomes::carried (copied (line, oldRate / newRate, 1, capacity, []), \samples => Success(value = DelayLine(samples = samples)))
