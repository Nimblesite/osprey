// [SYNTH-ADVANCED-DELIVERY] Reproducible example patches built only from public components and routes.
namespace synth

(** Each patch is an ordinary validated graph with visible routing and safe initial output levels. *)
module Patches
    added (outcome, n) = match outcome
        Valid graph => Graphs::add (graph, n)
        Invalid fault => Invalid(fault = fault)

    connected (outcome, cable) = match outcome
        Valid graph => Graphs::connect (graph, cable)
        Invalid fault => Invalid(fault = fault)

    (** Build a graph from nodes and routes, stopping at the first typed fault. *)
    export built (nodes, cables) = foldList (cables, foldList (nodes, Valid(value = Graphs::empty), added), connected)

    // Override declared initial values; unknown keys leave the node unchanged.
    set (n, values) = n(parameters = mapList (n.parameters, \p => foldList (values, p, \(current, pair) => valued (current, pair))))

    (** `n` with the named initial values replaced; the graph checks their ranges when the node is added. *)
    export adjusted (n, values) = set (n, values)

    valued (p, pair) = match p.key == pair.key
        true => p(initial = pair.value)
        false => p

    value (key, amount) = ParameterValue(node = 0, key = key, value = amount)

    chain identities = mapList (Sequences::drop (identities, 1), \identity => Components::route (satSub identity 1, 0, identity, 0))

    (** Noise-burst plucked string (A3) into a gentle reverb. *)
    export pluckedString () = built ([Components::exciter (0, 7), Components::waveguide (1, 220.0, 2400), Components::reverb (2, 2.0), Components::gain (3, 0.6), Components::output 4], chain [0, 1, 2, 3, 4])

    (** Struck bell modes, lightly saturated. *)
    export struckMetal () = built ([Components::exciter (0, 11), Components::modalBank (1, 330.0, 3.0), Components::shaper (2, 0.0, 1.5), Components::output 3], chain [0, 1, 2, 3])

    (** Mid-morph classic wavetable with 2,048-sample levels and 256 harmonics. *)
    export morphingTable () = match Wavetables::classic (2048, 256)
        Error _ => Invalid(fault = InvalidNode)
        Success table => built ([Components::wavetable (0, table, 110.0), Components::output 1], chain [0, 1])

    (** Stiff-string additive tone with decaying upper partials, retriggered every second. *)
    export inharmonicAdditive () = built ([set (Components::additive (0, 130.81), [value ("inharmonicity", 0.0004), value ("damping", 2.0), value ("decay", 3.0), value ("partials", 32.0), value ("interval", 48000.0)]), Components::output 1], chain [0, 1])

    (** Plucked string through the spectral freeze (transform 1). Hold starts released: raise it while the
        string sounds to capture that spectrum; a hold engaged from silence captures silence. *)
    export spectralFreeze () = built ([Components::exciter (0, 5), Components::waveguide (1, 196.0, 2400), set (Components::spectral (2, 1024, 256, 1.0), [value ("hold", 0.0)]), Components::gain (3, 0.5), Components::output 4], chain [0, 1, 2, 3, 4])

    (** Cross-synthesis: a bowed string's spectrum morphed halfway onto a stiff additive tone (side input). *)
    export crossSynthesis () = built ([Components::bowed (0, 196.0, 2400), set (Components::additive (1, 130.81), [value ("inharmonicity", 0.0004)]), set (Components::spectral (2, 1024, 256, 5.0), [value ("amount", 0.5)]), Components::gain (3, 0.6), Components::output 4], [Components::route (0, 0, 2, 0), Components::route (1, 0, 2, 1), Components::route (2, 0, 3, 0), Components::route (3, 0, 4, 0)])

    (** Spectral motion: a WPPM tone smeared over time, then shifted up three bins. *)
    export spectralMotion () = built ([Components::phaseOperator (0, 110.0, 3.0), set (Components::spectral (1, 1024, 256, 4.0), [value ("amount", 0.9)]), set (Components::spectral (2, 1024, 256, 3.0), [value ("shift", 3.0)]), Components::gain (3, 0.6), Components::output 4], chain [0, 1, 2, 3, 4])

    sineSource () = SampleResource(name = "One-cycle sine", sampleRate = 48000, sourceChannels = 1, rootFrequency = 46.875, samples = mapList (toList (range (0, 1024)), \index => Waves::sine (toFloat index / 1024.0)))

    (** A grain cloud at about 330 Hz (rate 7.04 × the 46.875 Hz source cycle), downmixed explicitly, ringing a
        band-pass resonator into the reverb (hosted executor, 2,048-frame grain blocks). *)
    export granularResonance () = built ([set (Components::granular (0, sineSource (), 16, 1), [value ("rate", 7.04), value ("gain", 0.3)]), Components::downmix 1, set (Components::resonator (2, 330.0), [value ("response", 0.0), value ("gain", 1.0), value ("decay", 0.5)]), Components::reverb (3, 3.0), Components::output 4], chain [0, 1, 2, 3, 4])

    (** Pitch-shifted feedback: a burst circulates through a +7 Hz shifter and a 50 ms delay at 0.7 gain, so
        each pass rises in frequency while decaying (needs the mono reference Renderer, which allows the cycle). *)
    export shiftedFeedback () = built ([Components::exciter (0, 9), Components::mixer 1, Components::shifter (2, 7.0), Components::gain (3, 0.7), Components::delay (4, 2400), Components::output 5], [Components::route (0, 0, 1, 0), Components::route (1, 0, 2, 0), Components::route (2, 0, 3, 0), Components::route (3, 0, 4, 0), Components::route (4, 0, 1, 1), Components::route (1, 0, 5, 0)])

    (** Frequency-shifted resonator feeding a frozen-capable reverb: an evolving inharmonic texture. *)
    export feedbackTexture () = built ([Components::exciter (0, 3), Components::resonator (1, 440.0), Components::shifter (2, 7.0), Components::reverb (3, 8.0), Components::output 4], chain [0, 1, 2, 3, 4])

    (** WPPM carrier phase-modulated by a second operator, through a soft clipper. *)
    export phaseNetwork () = built ([Components::phaseOperator (0, 220.0, 0.0), Components::phaseOperator (1, 110.0, 3.0), Components::shaper (2, 2.0, 1.2), Components::output 3], chain [0, 1, 2, 3])

    (** Physical, spectral, nonlinear and modulation families in one routed patch; the LFO route needs the
        hosted GraphClips executor (the mono reference Renderer rejects control ports). *)
    export combined () = built ([Components::exciter (0, 13), Components::modalBank (1, 220.0, 1.0), Components::spectral (2, 512, 128, 4.0), Components::shaper (3, 0.0, 2.0), Components::lfo (4, 0.3), Components::modulatedGain (5, 1, 0.5), Components::reverb (6, 4.0), Components::output 7], [Components::route (0, 0, 1, 0), Components::route (1, 0, 2, 0), Components::route (2, 0, 3, 0), Components::route (3, 0, 5, 0), Components::route (4, 0, 5, 1), Components::route (5, 0, 6, 0), Components::route (6, 0, 7, 0)])

    (** Macros for `phaseNetwork`: Brightness narrows the WPPM breakpoint and raises drive; Growl deepens the
        modulator's pulses; Motion raises phase-modulation depth from the first operator. *)
    export phaseNetworkMacros () = [Macro(name = "Brightness", targets = [MacroTarget(node = 1, key = "breakpoint", minimum = 0.5, maximum = 0.05, exponent = 1.0), MacroTarget(node = 2, key = "drive", minimum = 1.0, maximum = 4.0, exponent = 2.0)]), Macro(name = "Growl", targets = [MacroTarget(node = 1, key = "index", minimum = 0.0, maximum = 2.0, exponent = 1.5), MacroTarget(node = 1, key = "index2", minimum = 0.0, maximum = 1.5, exponent = 1.5)]), Macro(name = "Motion", targets = [MacroTarget(node = 1, key = "depth", minimum = 0.0, maximum = 0.6, exponent = 2.0)])]

