// [SYNTH-ADVANCED-CORE-SIGNALS] Activity snapshots for the advanced families, computed off the audio path.
namespace synth

(** Each snapshot reports what is sounding, capacity pressure and stored energy, so a UI can show real
    activity (not decorative waveforms). Hosts publish them through their Signal handler. *)
module Activities
    // Without the signature, inference takes the fold seed as polymorphic and settles on int.
    squared : List<float> -> float
    squared values = foldList (values, 0.0, \(sum, value) => sum + value * value)

    (** Sounding voices, voice capacity, voices stolen so far and summed loop energy.
    # Examples
    ```osprey
    pool = StringPool(voices = [], excitation = ExciterConfig(strength = 1.0, duration = 4, interval = 0, excitation = ImpulseExcitation), release = 0.1, stolen = 2)
    print "${Activities::strings pool}"
    ```
    ```output
    { active: 0, capacity: 0, stolen: 2, energy: 0.0, held: false }
    ```
    *)
    export strings (pool: StringPool) = Activity(active = length (filterList (pool.voices, \voice => voice.active)), capacity = length pool.voices, stolen = pool.stolen, energy = foldList (pool.voices, 0.0, \(sum, voice) => sum + squared voice.guide.line.samples), held = false)

    (** Ringing modes (energy above −120 dB), mode slots and total modal energy.
    # Examples
    ```osprey
    held = ModalState(modes = [ResonatorState(real = 0.5, imag = 0.0), ResonatorState(real = 0.0, imag = 0.0)])
    print "${Activities::modes held}"
    ```
    ```output
    { active: 1, capacity: 2, stolen: 0, energy: 0.25, held: false }
    ```
    *)
    export modes (held: ModalState) = Activity(active = length (filterList (held.modes, \m => m.real * m.real + m.imag * m.imag > 0.000000000001)), capacity = length held.modes, stolen = 0, energy = foldList (held.modes, 0.0, \(sum, m) => sum + m.real * m.real + m.imag * m.imag), held = false)

    (** Spectral frames processed, bins per frame, and whether a freeze capture is holding.
    # Examples
    ```osprey
    held = SpectralState(input = [], side = [], output = [0.5, 0.5], memory = [], motion = [], countdown = 0, frames = 3, captured = true)
    print "${Activities::spectral held}"
    ```
    ```output
    { active: 3, capacity: 0, stolen: 0, energy: 0.5, held: true }
    ```
    *)
    export spectral (held: SpectralState) = Activity(active = held.frames, capacity = length held.memory, stolen = 0, energy = squared held.output, held = held.captured)

    (** Energy stored in the reverb's feedback lines (whether frozen is a configuration fact).
    # Examples
    ```osprey
    held = ReverbState(lines = [DelayLine(samples = [0.5]), DelayLine(samples = [])], damped = [0.0], diffusers = [])
    print "${Activities::reverb held}"
    ```
    ```output
    { active: 2, capacity: 2, stolen: 0, energy: 0.25, held: false }
    ```
    *)
    export reverb (held: ReverbState) = Activity(active = length held.lines, capacity = length held.lines, stolen = 0, energy = foldList (held.lines, 0.0, \(sum, line) => sum + squared line.samples), held = false)
