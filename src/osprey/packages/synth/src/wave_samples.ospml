// [SYNTH-ADVANCED-GRAINS-IMPORT] Pure, allocating resource preparation; never call from rendering.
namespace synth

(** Bounded RIFF/WAVE PCM import. Samples retain their interleaved channel order. *)
module WaveImport
    part (bytes, at, outcome, index) = match outcome
        Error why => Error(message = why)
        Success bits => match listGet bytes (satAdd at index)
            Error _ => Error(message = MissingResource(detail = "Truncated WAV word."))
            Success byte => match byte >= 0 && byte <= 255
                false => Error(message = MissingResource(detail = "WAV input contains a value outside the byte range."))
                true => Success(value = bitOr bits (shiftLeft byte (satMul index 8)))

    word (bytes, at, count) = foldList (toList (range (0, count)), Success(value = 0), \(outcome, index) => part (bytes, at, outcome, index))

    field (bytes, start, outcome, pair) = match outcome
        Error why => Error(message = why)
        Success values => Outcomes::carried (word (bytes, satAdd start pair.offset, pair.width), \value => Success(value = listAppend values value))

    fields (bytes, start, layout) = foldList (layout, Success(value = []), \(outcome, pair) => field (bytes, start, outcome, pair))

    chunk (held, tag, start, size) = match tag
        544501094 => match held.formatStart < 0 && size >= 16
            false => Error(message = MissingResource(detail = "Duplicate or short WAV format chunk."))
            true => Success(value = held(formatStart = start, formatBytes = size))
        1635017060 => match held.dataStart < 0
            false => Error(message = MissingResource(detail = "Duplicate WAV data chunk."))
            true => Success(value = held(dataStart = start, dataBytes = size))
        _ => Success(value = held)

    chunks (bytes, at, held, remaining) = match at == length bytes
        true => Success(value = held)
        false => match remaining > 0 && at <= satSub (length bytes) 8
            false => Error(message = MissingResource(detail = "Truncated WAV chunk header or too many chunks (limit 1024)."))
            true => match fields (bytes, at, [WaveField(offset = 0, width = 4), WaveField(offset = 4, width = 4)])
                Error why => Error(message = why)
                Success values => match values
                    [tag, size] => nextChunk (bytes, satAdd at 8, held, remaining, tag, size)
                    _ => Error(message = MissingResource(detail = "Invalid WAV chunk fields."))

    nextChunk (bytes, start, held, remaining, tag, size) =
        end = satAdd start (satAdd size (bitAnd size 1))
        match end <= length bytes
            false => Error(message = MissingResource(detail = "Truncated WAV chunk body or padding."))
            true => Outcomes::carried (chunk (held, tag, start, size), \next => chunks (bytes, end, next, satSub remaining 1))

    extension (bytes, held) = match held.formatBytes == 16
        true => Success(value = true)
        false => match held.formatBytes >= 18
            false => Error(message = MissingResource(detail = "Truncated WAV format extension."))
            true => match word (bytes, satAdd held.formatStart 16, 2)
                Error why => Error(message = why)
                Success size => match size == 0 && held.formatBytes == 18
                    true => Success(value = true)
                    false => Error(message = MissingResource(detail = "Extended WAV formats are not supported by this importer."))

    format (bytes, held) = match held.formatStart >= 0 && held.dataStart >= 0
        false => Error(message = MissingResource(detail = "WAV requires one format chunk and one data chunk."))
        true => match extension (bytes, held)
            Error why => Error(message = why)
            Success _ => match fields (bytes, held.formatStart, [WaveField(offset = 0, width = 2), WaveField(offset = 2, width = 2), WaveField(offset = 4, width = 4), WaveField(offset = 8, width = 4), WaveField(offset = 12, width = 2), WaveField(offset = 14, width = 2)])
                Error why => Error(message = why)
                Success values => match values
                    [encoding, channels, rate, byteRate, align, bits] => checkedFormat (held, encoding, channels, rate, byteRate, align, bits)
                    _ => Error(message = MissingResource(detail = "Invalid WAV format fields."))

    checkedFormat (held, encoding, channels, rate, byteRate, align, bits) =
        supported = (encoding == 1 && (bits == 8 || bits == 16 || bits == 24 || bits == 32)) || (encoding == 3 && bits == 32)
        width = shiftRight bits 3
        match supported && (channels == 1 || channels == 2) && rate >= 8000 && rate <= 192000 && align == satMul width channels && byteRate == satMul rate align
            false => Error(message = MissingResource(detail = "WAV requires PCM 8/16/24/32 or float32, mono/stereo, 8–192 kHz and consistent frame/byte rates."))
            true =>
                frames = intDiv held.dataBytes align
                match frames >= 2 && frames <= 1048576 && satMul frames align == held.dataBytes
                    false => Error(message = MissingResource(detail = "WAV requires 2–1048576 complete sample frames."))
                    true => Success(value = WaveFormat(encoding = encoding, channels = channels, sampleRate = rate, sampleBytes = width, blockAlign = align, dataStart = held.dataStart, frames = frames))

    sample (bytes, fmt, at) = match word (bytes, at, fmt.sampleBytes)
        Error why => Error(message = why)
        Success bits =>
            signed = match bits >= 2147483648
                true => satSub bits 4294967296
                false => bits
            value = match fmt.encoding == 3
                true => toFloat (float32FromBits (toInt32 signed))
                false => WaveMath::pcm (toFloat bits, toFloat (satMul fmt.sampleBytes 8))
            match value >= -1.0 && value <= 1.0
                false => Error(message = MissingResource(detail = "WAV samples must be finite and within [-1, 1]."))
                true => Success(value = value)

    append (bytes, fmt, outcome, index) = match outcome
        Error why => Error(message = why)
        Success samples => Outcomes::carried (sample (bytes, fmt, satAdd fmt.dataStart (satMul index fmt.sampleBytes)), \value => Success(value = listPrepend samples value))

    decoded (bytes, fmt) = Outcomes::carried (foldList (toList (range (0, satMul fmt.frames fmt.channels)), Success(value = []), \(outcome, index) => append (bytes, fmt, outcome, index)), \samples => Success(value = WaveSamples(sampleRate = fmt.sampleRate, channels = fmt.channels, frames = fmt.frames, samples = listReverse samples)))

    body bytes = match chunks (bytes, 12, WaveChunks(formatStart = -1, formatBytes = 0, dataStart = -1, dataBytes = 0), 1024)
        Error why => Error(message = why)
        Success held => Outcomes::carried (format (bytes, held), \fmt => decoded (bytes, fmt))

    (** Check the RIFF/WAVE header against the file length, including for large exports read in parts. *)
    export header (bytes, total) = match fields (bytes, 0, [WaveField(offset = 0, width = 4), WaveField(offset = 4, width = 4), WaveField(offset = 8, width = 4)])
        Error why => Error(message = why)
        Success values => match values
            [riff, size, wave] => match riff == 1179011410 && wave == 1163280727 && size == satSub total 8
                false => Error(message = MissingResource(detail = "Expected a complete little-endian RIFF/WAVE file."))
                true => Success(value = size)
            _ => Error(message = MissingResource(detail = "Invalid WAV header."))

    (** Decode at most 8 MiB; preserve every source channel and the frame count. No resampling. *)
    export decode bytes = match length bytes >= 12 && length bytes <= 8388608
        false => Error(message = MissingResource(detail = "WAV file size must be between 12 bytes and 8 MiB."))
        true => match header (bytes, length bytes)
            Error why => Error(message = why)
            Success _ => body bytes
