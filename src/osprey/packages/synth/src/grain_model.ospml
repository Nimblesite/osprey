namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type GrainWindow =
    HannWindow
    AsrWindow
        attack : float
        release : float

type GrainControls =
    window : GrainWindow
    start : float
    rate : float
    duration : int
    amplitude : float
    pan : float

type GrainBoundary =
    LoopSource
    OneShotSource

type GrainRegion =
    first : int
    limit : int
    boundary : GrainBoundary

type GrainVoice =
    region : GrainRegion
    identity : int
    controls : GrainControls
    cursor : float
    age : int

type GrainPool =
    region : GrainRegion
    source : List<float>
    retiredSource : List<float>
    retiredBefore : int
    capacity : int
    voices : List<GrainVoice>
    revision : int
    position : int
    nextIdentity : int

type GrainAdmission =
    pool : GrainPool
    accepted : bool

type GrainVoiceObservation =
    identity : int
    cursor : float
    age : int
    duration : int
    sourceFrames : int
    fromPreviousSource : bool
    region : GrainRegion

type GrainObservation =
    sourceFrames : int
    retiredFrames : int
    region : GrainRegion
    voices : List<GrainVoiceObservation>
    revision : int
    samplePosition : int
    activeGrains : int
    capacity : int
    requestedGrains : int
    acceptedGrains : int
    rejectedGrains : int
    stolenGrains : int
    requestedPerFrame : float
    acceptedPerFrame : float

type GrainSample =
    left : float
    right : float
    next : GrainPool

type GrainContribution =
    left : float
    right : float
    next : GrainVoice

type GrainBlock =
    left : List<float>
    right : List<float>
    next : GrainPool

type GrainSeeds =
    position : int
    rate : int
    duration : int
    amplitude : int
    pan : int

type GrainSpread =
    position : float
    rate : float
    duration : int
    amplitude : float
    pan : float

type GrainDistribution =
    minimum : GrainControls
    maximum : GrainControls

type GrainDistributedEvents =
    events : List<GrainEvent>
    next : GrainSeeds

type GrainEvent =
    position : int
    controls : GrainControls

type GrainTimelineState =
    audio : GrainBlock
    events : List<GrainEvent>

type GrainTiming =
    PeriodicTiming
        period : int
        jitter : int
    ExponentialTiming
        mean : float
        maximum : int

type GrainClock =
    position : int
    nextOnset : int
    timing : GrainTiming
    seed : int

type GrainOnsets =
    positions : List<int>
    next : GrainClock

type GrainCloudState =
    sourceSamples : List<float>
    pool : GrainPool
    clock : GrainClock
    seeds : GrainSeeds

type GrainCloudBlock =
    left : List<float>
    right : List<float>
    next : GrainCloudState

type GrainCloudObservation =
    playback : GrainObservation
    timing : GrainTiming
    nextOnset : int

type GrainNodeControls =
    playback : GrainControls
    timing : GrainTiming

type MidiVoice K =
    kernel : K
    pitch : int
    channel : int
    noteIdentity : int
    velocity : float
    active : bool
    releaseRemaining : int
    releaseLength : int

type ProcessorMemory K =
    ChannelMemory
        channels : List<K>
    MidiMemory
        voice : MidiVoice<K>
    GrainMemory
        cloud : GrainCloudState

type GrainCaptureState =
    capacity : int
    sampleRate : int
    written : int
    samples : List<float>
    frozen : bool

type PitchMarkClock =
    position : int
    belowZero : bool

type PitchMarkBlock =
    positions : List<int>
    next : PitchMarkClock
