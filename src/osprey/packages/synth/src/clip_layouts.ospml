// [SYNTH-HOST-GRAPH] Reject unsupported buses before allocating or running any kernel.
namespace synth

(** Layout and resource limits for the offline multichannel graph executor. *)
module ClipLayouts
    audio ports = length (filterList (ports, \p => p.rate == Audio && p.unit == Amplitude)) == length ports

    notes ports = length (filterList (ports, \p => p.rate == Events && p.unit == Notes && p.channels == 1)) == length ports

    uniform (n, inputs, outputs) = match listGet (listConcat n.inputs n.outputs) 0
        Error _ => false
        Success first => length n.inputs == inputs && length n.outputs == outputs && audio (listConcat n.inputs n.outputs) && length (filterList (listConcat n.inputs n.outputs, \p => p.channels == first.channels)) == inputs + outputs

    monoTo (n, acceptsWidth) = match n.inputs
        [input] => match n.outputs
            [output] => input.channels == 1 && acceptsWidth output.channels && audio [input, output]
            _ => false
        _ => false

    downmix n = match n.inputs
        [input] => match n.outputs
            [output] => input.channels == 2 && output.channels == 1 && audio [input, output]
            _ => false
        _ => false

    (** One audio port fanned to `many` mono outlets of the same total width. *)
    linked (single, many) = audio [single] && audio many && length many == single.channels && length (filterList (many, \port => port.channels == 1)) == length many

    splitting n = match n.inputs
        [input] => linked (input, n.outputs)
        _ => false

    joining n = match n.outputs
        [output] => linked (output, n.inputs)
        _ => false

    mapped n = match n.processor
        Route entries => entries
        _ => []

    (** [SYNTH-GRAPH-CHANNELS] Route's map length fixes the output width; graph validation ranged its entries. *)
    routing n = match n.inputs
        [input] => match n.outputs
            [output] => audio [input, output] && length (mapped n) == output.channels && length (mapped n) >= 1
            _ => false
        _ => false

    modulation (n, port) = port.rate == Control && port.unit == Normalised && port.channels == 1 && length (filterList (n.parameters, \p => p.key == port.name && p.automatable && p.unit == Normalised && p.minimum == 0.0 && p.maximum == 1.0)) == 1 && length (filterList (n.inputs, \other => other.name == port.name)) == 1

    external n = match ClipInputs::layout n
        Error _ => false
        Success layout =>
            audioCount = length (filterList (n.inputs, \p => p.rate == Audio && p.unit == Amplitude))
            noteCount = length (filterList (n.inputs, \p => p.rate == Events && p.unit == Notes && p.channels == 1))
            controlCount = length (filterList (n.inputs, \port => modulation (n, port)))
            audioFirst = match n.inputs
                [] => true
                [first, ..._rest] => audioCount == 0 || first.rate == Audio
            audioCount <= 1 && noteCount <= 1 && audioCount + noteCount + controlCount == length n.inputs && length n.outputs == 1 && audio n.outputs && layout.outputChannels >= 1 && audioFirst

    (** A single-channel normalised control-rate port.
    # Examples
    ```osprey
    print "${ClipLayouts::control (Port(name = "cutoff", rate = Control, channels = 1, unit = Normalised))} ${ClipLayouts::control (Port(name = "audio", rate = Audio, channels = 1, unit = Amplitude))}"
    ```
    ```output
    true false
    ```
    *)
    export control port = port.rate == Control && port.unit == Normalised && port.channels == 1

    modulated n = match n.inputs
        [input, modulation] => match n.outputs
            [output] => audio [input, output] && input.channels == output.channels && control modulation
            _ => false
        _ => false

    lfo n = match n.outputs
        [output] => length n.inputs == 0 && control output
        _ => false

    cutoffPort n = match listGet n.inputs 1
        Error _ => false
        Success port => port.name == "cutoff"

    (** A block with events, control generators or multiple audio channels uses the clip scheduler.
    # Examples
    ```osprey
    print "${ClipLayouts::requiresClips (Components::stereo 1)} ${ClipLayouts::requiresClips (Components::gain (1, 1.0))}"
    ```
    ```output
    true false
    ```
    *)
    export requiresClips n = match n.processor
        Lfo => true
        ModulatedGain => true
        External _ _ => true
        MidiNotes | FormulaNotes _ => true
        Stereo => true
        Panner => true
        _ => length (filterList (listConcat n.inputs n.outputs, \p => p.channels != 1)) > 0

    (** Processor layouts are exact: no ignored extra ports or implicit channel conversion.
    # Examples
    ```osprey
    two = Node(identity = 1, processor = Mixer, inputs = [Port(name = "first", rate = Audio, channels = 1, unit = Amplitude)], outputs = [], parameters = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => ClipLayouts::supported (Components::mixer 1))} ${arithmetic (\() => ClipLayouts::supported (Components::output 1))} ${arithmetic (\() => ClipLayouts::supported (Components::downmix 1))} ${arithmetic (\() => ClipLayouts::supported two)}"
    ```
    ```output
    true true true false
    ```
    *)
    export supported n = match n.processor
        Granular _ _ _ => uniform (n, 0, 1) && length (filterList (n.outputs, \port => port.channels == 2)) == 1
        Lfo => lfo n
        SamplePlayer _ => uniform (n, 0, 1)
        Exciter _ => uniform (n, 0, 1)
        TableOscillator _ => length n.inputs == 4 && length (filterList (n.inputs, control)) == 4 && length n.outputs == 1 && audio n.outputs
        Additive => uniform (n, 0, 1)
        Spectral _ _ => uniform (n, 2, 1)
        PhaseOperator => uniform (n, 2, 1)
        Bowed _ => uniform (n, 0, 1)
        ModulatedGain => modulated n
        Filter => uniform (n, 1, 1) || (modulated n && cutoffPort n)
        MidiNotes | FormulaNotes _ => length n.inputs == 0 && length n.outputs == 1 && notes n.outputs
        Stereo => monoTo (n, \width => width == 2)
        Panner => monoTo (n, Graphs::channelCount)
        Split => splitting n
        Join => joining n
        Route _ => routing n
        Downmix => downmix n
        Oscillator => oscillator n
        Sink => uniform (n, 1, 0)
        Mixer => uniform (n, 2, 1)
        External _ _ => external n
        _ => uniform (n, 1, 1)

    oscillator n = length n.inputs <= 1 && notes n.inputs && length n.outputs == 1 && audio n.outputs && length (filterList (n.outputs, \p => p.channels == 1)) == 1

    (** Inputs that may stay unplugged: their parameters then apply unchanged.
    # Examples
    ```osprey
    cutoff = Port(name = "cutoff", rate = Control, channels = 1, unit = Normalised)
    print "${ClipLayouts::optional (Components::modulatedLowpass (1, 1000.0, 0.7), cutoff)} ${ClipLayouts::optional (Components::gain (1, 1.0), cutoff)}"
    ```
    ```output
    true false
    ```
    *)
    export optional (n, port) = match n.processor
        Oscillator => port.rate == Events
        External _ _ => port.rate == Control
        Filter => port.rate == Control && port.name == "cutoff"
        Spectral _ _ => port.name == "side"
        TableOscillator _ => port.rate == Control
        PhaseOperator => true
        _ => false

    (** Required inputs must be wired; unplugged optional controls retain their parameter.
    # Examples
    ```osprey
    n = Components::gain (1, 1.0)
    wired = Graph(nodes = [n], cables = [Cable(source = 2, outlet = 0, destination = 1, inlet = 0)])
    print "${ClipLayouts::connected (wired, n)} ${ClipLayouts::connected (Graphs::empty, n)}"
    ```
    ```output
    true false
    ```
    *)
    export connected (graph, n) = all (toList (range (0, length n.inputs)), \index =>
        match listGet n.inputs index
            Error _ => false
            Success port => optional (n, port) || length (filterList (graph.cables, \c => c.destination == n.identity && c.inlet == index)) == 1)

    all (items, predicate) = foldList (items, true, \(ok, item) => ok && predicate item)

    (** Sinks retain their input channel count in the completed output clip.
    # Examples
    ```osprey
    print "${ClipLayouts::channels (Components::output 1)} ${ClipLayouts::channels (Components::stereoOutput 1)} ${ClipLayouts::channels (Components::midiNote (1, 60.0, 0.8, 4800.0))} ${ClipLayouts::channels (Components::split (1, 3))}"
    ```
    ```output
    Success(1) Success(2) Success(0) Success(3)
    ```
    *)
    export channels n = match n.processor
        MidiNotes | FormulaNotes _ => Success(value = 0)
        Sink => match listGet n.inputs 0
            Error _ => Error(message = Outcomes::indexOutOfBounds)
            Success port => Success(value = port.channels)
        Split => Success(value = length n.outputs)
        _ => match listGet n.outputs 0
            Error _ => Error(message = Outcomes::indexOutOfBounds)
            Success port => Success(value = port.channels)

    delay n = match n.processor
        SamplePlayer resource => length resource.samples
        Granular resource _ _ => length resource.samples
        TableOscillator table => foldList (table.frames, 0, \(total, frame) => foldList (frame.levels, total, \(sum, level) => satAdd sum (length level.samples)))
        _ => match channels n
            Error _ => 1920001
            Success width => satMul (RenderInputs::storage n.processor) width

    // The executor holds one clip per node until the block completes (16M float64 samples = 128 MiB).
    cacheWidth (total, n) = match channels n
        Error _ => 16777217
        Success width => satAdd total width

    (** Bound all per-channel delay state before any buffer is allocated.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::output 1], cables = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => ClipLayouts::bounded (graph, 64))} ${arithmetic (\() => ClipLayouts::bounded (Graphs::empty, 32769))} ${arithmetic (\() => ClipLayouts::bounded (Graphs::empty, 0))}"
    ```
    ```output
    true false false
    ```
    *)
    export bounded (graph, frames) = frames > 0 && frames <= 32768 && satMul frames (foldList (graph.nodes, 0, cacheWidth)) <= 16777216 && SpectralKernels::affordable graph && foldList (graph.nodes, 0, \(total, n) => satAdd total (delay n)) <= 1920000 && length (filterList (graph.nodes, \n => supported n)) == length graph.nodes

    noteClip (n, first, frames, clip) = match Kinds::noteSource n.processor
        true => match MidiClips::timeline (n, first, frames)
            Error _ => false
            Success notes => structuralEquals (notes, clip.clipNotes)
        false => length clip.clipNotes == 0

    (** Revalidate public cached buffers before allowing them to feed another node.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::output 1], cables = [])
    clip = NodeClip(clipNode = 1, clipChannels = 1, clipSamples = [0.5, -0.5], clipNotes = [])
    print "${ClipLayouts::validClipAt (graph, 0, 2, clip)} ${ClipLayouts::validClipAt (graph, 0, 3, clip)}"
    ```
    ```output
    true false
    ```
    *)
    export validClipAt (graph, first, frames, clip) = match Graphs::node (graph, clip.clipNode)
        Invalid _ => false
        Valid n => match channels n
            Error _ => false
            Success count => clip.clipChannels == count && length clip.clipSamples == satMul frames count && length clip.clipSamples <= 65536 && length (filterList (clip.clipSamples, \sample => sample == sample && abs sample <= 1000000.0)) == length clip.clipSamples && noteClip (n, first, frames, clip)

    (** Whole-clip caches use the zero-origin event clock.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::output 1], cables = [])
    clip = NodeClip(clipNode = 1, clipChannels = 1, clipSamples = [0.5, -0.5], clipNotes = [])
    print "${ClipLayouts::validClip (graph, 2, clip)} ${ClipLayouts::validClip (Graphs::empty, 2, clip)}"
    ```
    ```output
    true false
    ```
    *)
    export validClip (graph, frames, clip) = validClipAt (graph, 0, frames, clip)
