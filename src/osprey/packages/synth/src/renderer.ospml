// [SYNTH-RENDER] Allocation-using, deterministic reference renderer. Not an audio callback backend.
namespace synth


(** Execute the prepared mono graph with explicit state across arbitrary block partitions. *)
module Renderer
    mono port = port.rate == Audio && port.channels == 1 && port.unit == Amplitude

    validPorts n = length (filterList (listConcat n.inputs n.outputs, \port => mono port || (n.processor == Oscillator && port.rate == Events && port.unit == Notes && port.channels == 1) || (ClipLayouts::control port && ClipLayouts::optional (n, port)))) == length n.inputs + length n.outputs

    layout n = match n.processor
        Oscillator => ClipLayouts::supported n
        Sink => length n.inputs == 1 && length n.outputs == 0
        Mixer => length n.inputs == 2 && length n.outputs == 1
        Filter => ClipLayouts::supported n
        External _ _ => false
        SamplePlayer _ => length n.inputs == 0 && length n.outputs == 1
        Exciter _ => length n.inputs == 0 && length n.outputs == 1
        TableOscillator _ => length n.inputs == 4 && length n.outputs == 1
        Additive => length n.inputs == 0 && length n.outputs == 1
        Spectral _ _ => length n.inputs == 2 && length n.outputs == 1
        PhaseOperator => length n.inputs == 2 && length n.outputs == 1
        Bowed _ => length n.inputs == 0 && length n.outputs == 1
        _ => length n.inputs == 1 && length n.outputs == 1

    validNode n = validPorts n && layout n

    outputs graph = filterList (graph.nodes, \n => n.processor == Sink)

    delaySize n = RenderInputs::storage n.processor

    midiCable (graph, c) = match Graphs::node (graph, c.destination)
        Valid n => n.processor == Oscillator
        Invalid _ => true

    supported plan = SpectralKernels::affordable plan.graph && length (filterList (plan.graph.cables, \c => midiCable (plan.graph, c))) == 0 && length (filterList (plan.graph.nodes, validNode)) == length plan.graph.nodes && length (outputs plan.graph) == 1 && length (filterList (plan.graph.nodes, \n => ClipLayouts::connected (plan.graph, n))) == length plan.graph.nodes && foldList (plan.graph.nodes, 0, \(total, n) => satAdd total (delaySize n)) <= 1920000

    (** Validate a graph for the renderer, reporting `failure` when `Graphs.prepare` rejects it.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::validated (Graphs::empty, InvalidConfiguration(detail = "bad"), \p => Success(value = p.order)))} ${arithmetic (\() => Renderer::validated (Graph(nodes = [Components::gain (-1, 1.0)], cables = []), InvalidConfiguration(detail = "bad"), \p => Success(value = p.order)))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export validated (graph, failure, continue) = match Graphs::prepare graph
        Invalid _ => Error(message = failure)
        Valid plan => continue plan

    (** Prepare and allocate reference state. Unknown layouts and external plug-ins are explicit errors.
    # Examples
    ```osprey
    graph = Graph(nodes = [Components::sine (1, 440.0), Components::output 2], cables = [Cable(source = 1, outlet = 0, destination = 2, inlet = 0)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::start graph)} ${arithmetic (\() => Renderer::start (Graph(nodes = [Components::gain (1, 1.0)], cables = [])))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export start graph =
        use plan <- validated (graph, InvalidConfiguration(detail = "The graph is invalid; inspect Graphs.prepare for the typed fault."))
        match supported plan
            false => Error(message = IncompatibleLayout(detail = "Reference rendering requires mono audio, one output and supported bounded processors."))
            true => Success(value = RenderInputs::initial plan)

    scheduledNodes (plan, rate, snapshot, fixed, states) = mapList (plan.order, \identity => RenderKernels::schedule (plan, identity, rate, snapshot, fixed, states))

    nextNode (plan, rate, snapshot, outcome, component) = Outcomes::carried (outcome, \frame => RenderKernels::resolved (plan, rate, snapshot, frame, component))

    (** Write a delay after its output has been read for the current sample. *)
    delayed (frame, held, input) = match held.delay
        [] => Error(message = MissingResource(detail = "Delay state is empty."))
        [_head, ...tail] =>
            next = held(delay = listAppend tail input)
            Success(value = frame(states = mapList (frame.states, \s => replace (next, s))))

    replace (next, current) = match next.identity == current.identity
        true => next
        false => current

    (** Commit one routed delay input after the corresponding output sample.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::writeDelay (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 2, 0))} ${arithmetic (\() => Renderer::writeDelay (plan, SampleFrame(states = [KernelState(identity = 1, phase = 0.0, integratorOne = 0.0, integratorTwo = 0.0, delay = [], memory = KernelIdle)], values = []), 1, 0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export writeDelay (plan, frame, identity, inlet) = match RenderInputs::input (plan, frame, identity, inlet)
        Error why => Error(message = why)
        Success input => Outcomes::carried (RenderInputs::held (frame, identity), \held => delayed (frame, held, input))

    nextDelay (plan, outcome, cable) = Outcomes::carried (outcome, \frame => writeDelay (plan, frame, cable.destination, cable.inlet))

    meter (previous, value) = Meter(identity = value.identity, peak = max previous.peak (abs value.value), energy = previous.energy + value.value * value.value, count = satAdd previous.count 1)

    measured (meters, value) = match Seek::first (meters, \m => m.identity == value.identity)
        Error _ => listAppend meters (Meter(identity = value.identity, peak = abs value.value, energy = value.value * value.value, count = 1))
        Success previous => mapList (meters, \m => updatedMeter (previous, value, m))

    updatedMeter (previous, value, m) = match m.identity == value.identity
        true => meter (previous, value)
        false => m

    metered (meters, values) = foldList (values, meters, measured)

    (** Publish reference-rendered meters and position through the consumer's next Signal snapshot.
    # Examples
    ```osprey
    snapshot = Observation(revision = 0, samplePosition = 0, parameters = [], components = [])
    rendered = Rendered(states = [], samples = [], position = 480, meters = [Meter(identity = 1, peak = 0.5, energy = 0.5, count = 2)])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::observed (snapshot, rendered))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export observed (snapshot, rendered) = snapshot(samplePosition = rendered.position, components = mapList (rendered.meters, \m => ComponentState(node = m.identity, activeVoices = 0, peak = m.peak, rms = sqrt (m.energy / toFloat m.count))))

    finished (plan, rendered, frame) = match listGet (outputs plan.graph) 0
        Error _ => Error(message = Outcomes::indexOutOfBounds)
        Success sink => Outcomes::carried (RenderInputs::sample (frame, sink.identity), \output => Success(value = Rendered(states = frame.states, samples = listAppend rendered.samples output, position = satAdd rendered.position 1, meters = metered (rendered.meters, frame.values))))

    evaluated (plan, nodes, rate, snapshot, rendered) =
        initial = SampleFrame(states = rendered.states, values = [])
        scheduled = foldList (nodes, Success(value = initial), \(outcome, component) => nextNode (plan, rate, snapshot, outcome, component))
        foldList (plan.feedback, scheduled, \(outcome, cable) => nextDelay (plan, outcome, cable))

    sample (plan, nodes, rate, snapshot, rendered) = Outcomes::carried (evaluated (plan, nodes, rate, snapshot, rendered), \frame => finished (plan, rendered, frame))

    captured (plan, nodes, rate, snapshot, progress, accept) = Outcomes::carried (evaluated (plan, nodes, rate, snapshot, progress.audio), \frame =>
        audio = progress.audio
        Outcomes::carried (accept (progress.observation, frame), \seen => Success(value = progress(audio = audio(states = frame.states, position = satAdd progress.audio.position 1), observation = seen))))

    (** Fold selected node outputs from the same reference-rendered frames, including delayed feedback.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    progress = Timeline(audio = Rendered(states = [], samples = [], position = 0, meters = []), observation = Observation(revision = 0, samplePosition = 0, parameters = [], components = []))
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::capture (plan, 48000.0, Observation(revision = 0, samplePosition = 0, parameters = [], components = []), progress, 1, \(seen, f) => seen))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export capture (plan, rate, snapshot, progress, count, accept) = match validBlock (rate, progress.audio, count) && supported plan
        false => Error(message = InvalidConfiguration(detail = "Invalid render rate, block size, position or layout."))
        true =>
            nodes = scheduledNodes (plan, rate, snapshot, true, progress.audio.states)
            foldList (toList (range (0, count)), Success(value = progress), \(outcome, _) => Outcomes::carried (outcome, \current => captured (plan, nodes, rate, snapshot, current, accept)))

    nextSample (plan, nodes, rate, snapshot, outcome) = Outcomes::carried (outcome, \rendered => sample (plan, nodes, rate, snapshot, rendered))

    validBlock (rate, rendered, count) = rate >= 8000.0 && rate <= 384000.0 && count >= 0 && count <= 8192 && rendered.position >= 0 && rendered.position <= satSub 9223372036854775807 count

    (** Render a bounded block; returns only this block's samples and the next persistent state.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::block (plan, 4000.0, Observation(revision = 0, samplePosition = 0, parameters = [], components = []), Rendered(states = [], samples = [], position = 0, meters = []), 1))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export block (plan, rate, snapshot, rendered, count) = match validBlock (rate, rendered, count) && supported plan
        false => Error(message = InvalidConfiguration(detail = "Invalid render rate, block size, position or layout."))
        true =>
            nodes = scheduledNodes (plan, rate, snapshot, true, rendered.states)
            foldList (toList (range (0, count)), Success(value = rendered(samples = [], meters = [])), \(outcome, _) => nextSample (plan, nodes, rate, snapshot, outcome))

    ordered (events, previous, stop) = match events
        [] => true
        [event, ...tail] => event.samplePosition >= previous && event.samplePosition < stop && ordered (tail, event.samplePosition, stop)

    edit (graph, outcome, command) = match outcome
        Error why => Error(message = why)
        Success snapshot => match Parameters::apply (graph, snapshot, command)
            Invalid _ => Error(message = InvalidConfiguration(detail = "Automation parameter, revision or sample position was rejected."))
            Valid next => Success(value = next)

    automatedSample (plan, nodes, rate, events, timeline) =
        current = timeline.observation
        now = current(samplePosition = timeline.audio.position)
        due = filterList (events, \event => event.samplePosition == timeline.audio.position)
        match foldList (due, Success(value = now), \(outcome, command) => edit (plan.graph, outcome, command))
            Error why => Error(message = why)
            Success snapshot => Outcomes::carried (sample (plan, nodes, rate, snapshot, timeline.audio), \audio => Success(value = Timeline(audio = audio, observation = snapshot)))

    nextAutomated (plan, nodes, rate, events, outcome) = Outcomes::carried (outcome, \timeline => automatedSample (plan, nodes, rate, events, timeline))

    publish outcome = Outcomes::carried (outcome, \timeline => Success(value = timeline(observation = observed (timeline.observation, timeline.audio))))

    (** Apply ordered absolute-frame parameter events before their exact sample, preserving same-frame order.
    # Examples
    ```osprey
    plan = Prepared(graph = Graph(nodes = [Components::gain (1, 1.0)], cables = []), order = [1], feedback = [])
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Renderer::automated (plan, 48000.0, Observation(revision = 0, samplePosition = 0, parameters = [], components = []), Rendered(states = [], samples = [], position = 0, meters = []), 1, []))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export automated (plan, rate, snapshot, rendered, count, events) = match validBlock (rate, rendered, count) && supported plan && length events <= 1024 && ordered (events, rendered.position, satAdd rendered.position count)
        false => Error(message = InvalidConfiguration(detail = "Invalid automation block, ordering or event capacity."))
        true =>
            nodes = scheduledNodes (plan, rate, snapshot, false, rendered.states)
            initial = Timeline(audio = rendered(samples = [], meters = []), observation = snapshot)
            publish (foldList (toList (range (0, count)), Success(value = initial), \(outcome, _) => nextAutomated (plan, nodes, rate, events, outcome)))
