// Periodic Hann analysis and synthesis windows with hop `size / 4` or `size / 8` sum to the
// constant `3 size / (8 hop)`, so overlap-add reconstruction scales by its reciprocal
// (Allen and Rabiner; Smith, *Spectral Audio Signal Processing*).
namespace synth

(** Short-time Fourier analysis and resynthesis mathematics [SYNTH-ADVANCED-SPECTRAL]. *)
module SpectralMath
    (** Periodic Hann window value at `index` of `size`.
    # Examples
    ```osprey
    print "${SpectralMath::hann (0.0, 8.0)} ${SpectralMath::hann (4.0, 8.0)}"
    ```
    ```output
    0.0 1.0
    ```
    *)
    export hann (index, size) = 0.5 - 0.5 * cos (floatDiv (6.283185307179586 * index, size))

    (** FFT twiddle angle for bin `index` of a transform of `size`; `sign` is -1 forward, +1 inverse.
    # Examples
    ```osprey
    print "${SpectralMath::twiddle (-1.0, 2.0, 8.0)}"
    ```
    ```output
    -1.5707963267948966
    ```
    *)
    export twiddle (sign, index, size) = floatDiv (sign * 6.283185307179586 * index, size)

    (** Complex product components.
    # Examples
    ```osprey
    print "${SpectralMath::productRe (1.0, 2.0, 3.0, 4.0)}"
    ```
    ```output
    -5.0
    ```
    *)
    export productRe (ar: float, ai, br, bi) = ar * br - ai * bi

    (** Imaginary component of a complex product.
    # Examples
    ```osprey
    print "${SpectralMath::productIm (1.0, 2.0, 3.0, 4.0)}"
    ```
    ```output
    10.0
    ```
    *)
    export productIm (ar: float, ai, br, bi) = ar * bi + ai * br

    (** Squared modulus of a complex value.
    # Examples
    ```osprey
    print "${SpectralMath::power (3.0, 4.0)}"
    ```
    ```output
    25.0
    ```
    *)
    export power (re: float, im) = re * re + im * im

    (** Magnitude of a complex value.
    # Examples
    ```osprey
    print "${SpectralMath::magnitude (0.0, 0.0)} ${SpectralMath::magnitude (-0.0, 0.0)}"
    ```
    ```output
    0.0 0.0
    ```
    *)
    export magnitude (re, im: float) = pow (power (re, im), 0.5)

    (** One component of a unit vector, with its silence fallback. *)
    unitised (part, m, silent) = match m <= 0.0
        true => silent
        false => floatDiv (part, m)

    (** Unit-vector components; silence maps to phase zero.
    # Examples
    ```osprey
    print "${SpectralMath::unitRe (0.0, 0.0)} ${SpectralMath::unitRe (0.0, 2.0)}"
    ```
    ```output
    1.0 0.0
    ```
    *)
    export unitRe (re, im) = unitised (re, magnitude (re, im), 1.0)

    (** Imaginary component of the unit phase vector.
    # Examples
    ```osprey
    print "${SpectralMath::unitIm (0.0, 0.0)} ${SpectralMath::unitIm (2.0, 0.0)}"
    ```
    ```output
    0.0 0.0
    ```
    *)
    export unitIm (re, im) = unitised (im, magnitude (re, im), 0.0)

    (** Centre frequency of bin `index`.
    # Examples
    ```osprey
    print "${SpectralMath::binFrequency (1.0, 8.0, 48000.0)}"
    ```
    ```output
    6000.0
    ```
    *)
    export binFrequency (index, size, sampleRate) = floatDiv (index * sampleRate, size)

    (** Expected phase advance of a bin-centred sinusoid over one hop.
    # Examples
    ```osprey
    print "${SpectralMath::hopAdvance (1.0, 2, 8.0)}"
    ```
    ```output
    1.5707963267948966
    ```
    *)
    export hopAdvance (index, hop, size) = floatDiv (6.283185307179586 * index * hop, size)

    (** Band-pass gain with linear one-bin-wide edges around `low` and `high` hertz.
    # Examples
    ```osprey
    print "${SpectralMath::bandGain (100.0, 1000.0, 2000.0, 100.0)} ${SpectralMath::bandGain (950.0, 1000.0, 2000.0, 100.0)} ${SpectralMath::bandGain (1000.0, 1000.0, 2000.0, 100.0)} ${SpectralMath::bandGain (2050.0, 1000.0, 2000.0, 100.0)}"
    ```
    ```output
    0.0 0.5 1.0 0.5
    ```
    *)
    export bandGain (frequency, low, high, width) = match frequency < low - width || frequency > high + width
        true => 0.0
        false => match frequency < low
            true => floatDiv (frequency - (low - width), width)
            false => match frequency > high
                true => floatDiv (high + width - frequency, width)
                false => 1.0

    (** Phase angle of a complex value.
    # Examples
    ```osprey
    print "${SpectralMath::angle (1.0, 0.0)} ${SpectralMath::angle (-1.0, 0.0)}"
    ```
    ```output
    0.0 3.141592653589793
    ```
    *)
    export angle (re, im) = atan2 (im, re)

    (** Wrap an angle into [−π, π).
    # Examples
    ```osprey
    print "${SpectralMath::principal 0.0} ${SpectralMath::principal 4.0}"
    ```
    ```output
    0.0 -2.2831853071795862
    ```
    *)
    export principal value = value - 6.283185307179586 * floor ((value + 3.141592653589793) / 6.283185307179586)

    (** Phase-vocoder instantaneous frequency of bin `index`, in bins, from its phase advance over one hop.
    # Examples
    ```osprey
    print "${SpectralMath::trueBin (2.0, 1.0, 1.0, 2, 8.0)}"
    ```
    ```output
    0.0
    ```
    *)
    export trueBin (index, phase, previous, hop, size) = index + floatDiv (principal (phase - previous - floatDiv (6.283185307179586 * index * hop, size)) * size, 6.283185307179586 * hop)

    (** Synthesis phase advance for a component at `bin` (fractional) over one hop.
    # Examples
    ```osprey
    print "${SpectralMath::binAdvance (1.5, 2, 8.0)}"
    ```
    ```output
    2.356194490192345
    ```
    *)
    export binAdvance (bin, hop, size) = floatDiv (6.283185307179586 * bin * hop, size)

    (** Rectangular components of `level · e ^ (i·phase)`: resynthesis from magnitude and phase.
    # Examples
    ```osprey
    print "${SpectralMath::polarRe (0.5, 0.0)} ${SpectralMath::polarRe (0.5, 3.141592653589793)}"
    ```
    ```output
    0.5 -0.5
    ```
    *)
    export polarRe (level, phase) = level * cos phase

    (** Imaginary component reconstructed from magnitude and phase.
    # Examples
    ```osprey
    print "${SpectralMath::polarIm (0.5, 0.0)} ${SpectralMath::polarIm (0.5, 1.5707963267948966)}"
    ```
    ```output
    0.0 0.5
    ```
    *)
    export polarIm (level, phase) = level * sin phase

    (** Nearest integer with ties rounded up: the output bin of the pitch map `round (k · ratio)`.
    # Examples
    ```osprey
    print "${SpectralMath::nearest 2.4} ${SpectralMath::nearest 2.5} ${SpectralMath::nearest (-2.5)}"
    ```
    ```output
    2.0 3.0 -2.0
    ```
    *)
    export nearest value = floor (value + 0.5)

    (** Spectral-envelope radius in bins: about 150 Hz.
    # Examples
    ```osprey
    print "${SpectralMath::envelopeRadius (1024.0, 48000.0)}"
    ```
    ```output
    4.0
    ```
    *)
    export envelopeRadius (size, sampleRate) = ceil (floatDiv (150.0 * size, sampleRate))

    (** Formant gain: wanted over current envelope, 1 where the envelope is silent, at most 16 (+24 dB).
    # Examples
    ```osprey
    print "${SpectralMath::formantGain (1.0, 0.0)} ${SpectralMath::formantGain (1.0, 4.0)} ${SpectralMath::formantGain (100.0, 4.0)}"
    ```
    ```output
    1.0 0.25 16.0
    ```
    *)
    export formantGain (wanted, current) = match current <= 0.000000001
        true => 1.0
        false => match floatDiv (wanted, current) > 16.0
            true => 16.0
            false => floatDiv (wanted, current)

    (** Log-magnitude interpolation: the geometric path between two levels, so halfway sounds halfway.
    # Examples
    ```osprey
    print "${SpectralMath::logBlend (-0.000000001, 1.0, 0.0)}"
    ```
    ```output
    -1e-09
    ```
    *)
    export logBlend (a, b, amount) = exp ((1.0 - amount) * ln (a + 0.000000001) + amount * ln (b + 0.000000001)) - 0.000000001

    (** Blend's phase-donor weight on the side input ([SYNTH-SPECTRAL-MORPH]): 0 to amount 0.4, 1 from 0.6 and
    linear between, scaled by the two levels so a silent input never donates its phase.
    # Examples
    ```osprey
    print "${SpectralMath::donorWeight (1.0, 1.0, 0.3)} ${SpectralMath::donorWeight (1.0, 1.0, 0.5)} ${SpectralMath::donorWeight (1.0, 0.0, 0.7)}"
    ```
    ```output
    0.0 0.4999999999999999 1.0
    ```
    *)
    export donorWeight (main, side, amount) =
        crossed = match amount <= 0.4
            true => 0.0
            false => match amount >= 0.6
                true => 1.0
                false => (amount - 0.4) / 0.2
        weighted = crossed * side
        match weighted + (1.0 - crossed) * main <= 0.000000001
            true => crossed
            false => floatDiv (weighted, weighted + (1.0 - crossed) * main)

    (** The phase `weight` of the way from `from` to `to` along the shorter arc.
    # Examples
    ```osprey
    print "${SpectralMath::arcPhase (0.0, 3.0, 0.5)} ${SpectralMath::arcPhase (3.0, -3.0, 0.5)}"
    ```
    ```output
    1.5 3.141592653589793
    ```
    *)
    export arcPhase (from, to, weight) = from + weight * principal (to - from)

    (** Cross-synthesis gain `(wanted / own) ^ amount`, 1 where the own envelope is silent, at most 16.
    # Examples
    ```osprey
    print "${SpectralMath::envelopeMorph (1.0, 0.0, 0.5)} ${SpectralMath::envelopeMorph (100.0, 4.0, 0.0)}"
    ```
    ```output
    1.0 1.0
    ```
    *)
    export envelopeMorph (wanted, own, amount) = pow (formantGain (wanted, own), amount)

    (** Natural-log level of a magnitude, floored at 1e-9.
    # Examples
    ```osprey
    print "${SpectralMath::logLevel (-0.000000001)}"
    ```
    ```output
    -inf
    ```
    *)
    export logLevel m = ln (m + 0.000000001)

    (** Parabolic peak offset in bins from three neighbouring log levels (Smith and Serra, 1987).
    # Examples
    ```osprey
    print "${SpectralMath::peakOffset (0.0, 1.0, 0.0)} ${SpectralMath::peakOffset (0.5, 1.0, 0.0)}"
    ```
    ```output
    -0.0 -0.16666666666666666
    ```
    *)
    export peakOffset (a, b, c) = match a - 2.0 * b + c == 0.0
        true => 0.0
        false => floatDiv (0.5 * (a - c), a - 2.0 * b + c)

    (** A Hann lobe bin's phase: the centre's phase plus π per bin of offset.
    # Examples
    ```osprey
    print "${SpectralMath::lobePhase (0.0, 0.0)} ${SpectralMath::lobePhase (0.0, 1.0)}"
    ```
    ```output
    0.0 -3.141592653589793
    ```
    *)
    export lobePhase (centre, offset) = principal (centre + 3.141592653589793 * offset)

    (** Whole bins a peak region moves so its lobe lands nearest the peak's true `frequency` (in bins) times `ratio`.
    # Examples
    ```osprey
    print "${SpectralMath::peakShift (10.0, 1.5)} ${SpectralMath::peakShift (10.0, 1.0)}"
    ```
    ```output
    5.0 0.0
    ```
    *)
    export peakShift (frequency, ratio) = nearest (frequency * ratio - frequency)

    (** Pitch ratio of a shift by `semitones` plus `cents` hundredths of a semitone: 2 ^ ((semitones + cents / 100) / 12).
    # Examples
    ```osprey
    print "${SpectralMath::semitoneRatio (0.0, 0.0)}"
    ```
    ```output
    1.0
    ```
    *)
    export semitoneRatio (semitones, cents) = pow (2.0, (semitones + cents / 100.0) / 12.0)

    (** Formant ratio of a pitch shift by `ratio`: 1 with `keep` on holds the formants still, otherwise they move with it.
    # Examples
    ```osprey
    print "${SpectralMath::formantRatio (1.0, 1.5)} ${SpectralMath::formantRatio (0.0, 1.5)}"
    ```
    ```output
    1.0 1.5
    ```
    *)
    export formantRatio (keep, ratio) = match keep >= 0.5
        true => 1.0
        false => ratio

    (** Identity phase locking: a bin near a moved peak keeps its analysed phase offset from that peak.
    # Examples
    ```osprey
    print "${SpectralMath::lockedPhase (1.0, 1.0, 1.0)} ${SpectralMath::lockedPhase (3.0, 3.0, 0.0)}"
    ```
    ```output
    1.0 -0.28318530717958623
    ```
    *)
    export lockedPhase (peakPhase, phase, peakAnalysis) = principal (peakPhase + phase - peakAnalysis)

    (** One analysis sample: the input under a Hann window of `size`.
    # Examples
    ```osprey
    print "${SpectralMath::windowedSample (1.0, 0.0, 8.0)} ${SpectralMath::windowedSample (1.0, 4.0, 8.0)}"
    ```
    ```output
    0.0 1.0
    ```
    *)
    export windowedSample (sample, index, size) = sample * hann (index, size)

    (** Whether `frequency` falls in the octave band around `centre`: from centre / √2 up to centre · √2.
    # Examples
    ```osprey
    print "${SpectralMath::inOctave (1000.0, 1000.0)} ${SpectralMath::inOctave (1500.0, 1000.0)} ${SpectralMath::inOctave (700.0, 1000.0)}"
    ```
    ```output
    true false false
    ```
    *)
    export inOctave (frequency, centre) = frequency >= centre * 0.7071067811865476 && frequency < centre * 1.4142135623730951

    (** Band level in dB of one-sided Hann power `energy` summed over `frames` frames of `size` points, where a full-scale sine reads 0 dB (its one-sided power per frame is 3 · size² / 32); floored at −120 dB.
    # Examples
    ```osprey
    print "${SpectralMath::bandLevel (0.0, 1, 64)} ${SpectralMath::bandLevel (384.0, 1, 64)}"
    ```
    ```output
    -120.0 0.0
    ```
    *)
    export bandLevel (energy, frames, size) =
        ratio = floatDiv (energy * 32.0, 3.0 * size * size * frames)
        match ratio < 0.000000000001
            true => -120.0
            false => 4.342944819032518 * ln ratio
