// [SYNTH-VOICE] Pure synthesis extracted from Prism: no UI or platform dependencies.
namespace synth

(** Pure reference voice rendering retained from Prism. *)
module Voice
    (** Samples per second.
    # Examples
    ```osprey
    print "${Voice::rate}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export rate = 11025

    choose (condition, yes, no) = match condition
        true => yes
        false => no

    semitone note = match take note 1
        "C" => 0
        "D" => 2
        "E" => 4
        "F" => 5
        "G" => 7
        "B" => 11
        _ => 9

    (** A key's pitch in equal temperament from its name, as the keyboard sets `note`: "A3" is 220 Hz, "C#4" is 277.18 Hz.
    # Examples
    ```osprey
    print "${Voice::frequency "A4"}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export frequency note =
        sharp = contains note "#"
        octave = parseFloat (drop note (choose (sharp, 2, 1))) ?: 3.0
        Waves::midiFrequency (VoiceMath::midiKey (octave, toFloat (semitone note), choose (sharp, 1.0, 0.0)))

    (** How many octaves the LFO sweeps the cutoff each way at full depth.
    # Examples
    ```osprey
    print "${Voice::octaves}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export octaves = 2.0

    (** An LFO rate as a note length at 120 bpm, in hertz: a quarter note is 2 Hz.
    # Examples
    ```osprey
    print "${Voice::hertz "1/8"} ${Voice::hertz "x"}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export hertz rate = match rate
        "1/1" => 0.5
        "1/2" => 1.0
        "1/8" => 4.0
        "1/16" => 8.0
        _ => 2.0

    (** A patch written out, so two patches compare by what they sound like.
    # Examples
    ```osprey
    p = Patch(pitch = 440.0, sounding = true, filtered = false, wave = "Saw", cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.8)
    print "${Voice::describe p}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export describe p = "${toString p.pitch} ${toString p.sounding} ${toString p.filtered} ${p.wave} ${toString p.cutoff} ${toString p.depth} ${toString p.lfo} ${toString p.audible} ${toString p.volume}"

    (** Whether a patch makes no sound at all.
    # Examples
    ```osprey
    p = Patch(pitch = 440.0, sounding = true, filtered = false, wave = "Saw", cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.8)
    print "${Voice::silent (p(volume = 0.0))} ${Voice::silent p}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export silent p = p.sounding == false || p.audible == false || p.volume <= 0.0

    // The cutoff at sample `n`, swept by the LFO.
    swept (p, n) = VoiceMath::swept (p.cutoff, p.depth, octaves, p.lfo, toFloat n, toFloat rate)

    // A two-pole Butterworth low-pass's gain at the key's pitch.
    passed (p, n) = choose (p.filtered, VoiceMath::butterworth (p.pitch, swept (p, n)), 1.0)

    (** The wave from -1 to 1 at `turns` cycles, as the Oscillator draws it.
    # Examples
    ```osprey
    print "${Voice::shaped ("Sine", 0.0)} ${Voice::shaped ("Square", 0.25)} ${Voice::shaped ("Square", 0.75)} ${Voice::shaped ("Saw", 0.0)} ${Voice::shaped ("Triangle", 0.0)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export shaped (wave, turns) =
        t = Waves::wrap turns
        match wave
            "Triangle" => VoiceMath::triangle t
            "Saw" => VoiceMath::saw t
            "Square" => choose (t < 0.5, 1.0, -1.0)
            _ => Waves::sine t

    (** Sample `n` from -1 to 1.
    # Examples
    ```osprey
    p = Patch(pitch = 440.0, sounding = true, filtered = false, wave = "Saw", cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.8)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Voice::sample (p, 0))} ${arithmetic (\() => Voice::sample (p(volume = 0.0), 0))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export sample (p, n) = choose (silent p, 0.0, p.volume * passed (p, n) * shaped (p.wave, p.pitch * toFloat n / toFloat rate))

    (** One second of the patch as unsigned 8-bit samples centred on 128.
    # Examples
    ```osprey
    p = Patch(pitch = 440.0, sounding = true, filtered = false, wave = "Saw", cutoff = 1000.0, depth = 0.5, lfo = 2.0, audible = true, volume = 0.8)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => listLength (Voice::samples p))} ${arithmetic (\() => Voice::peak (Voice::samples p))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export samples p = mapList (toList (range (0, rate)), \n => satAdd 128 (floatToInt (round (sample (p, n) * 100.0)) ?: 0))

    (** The largest distance of any sample from silence.
    # Examples
    ```osprey
    print "${Voice::peak [128, 130, 120]} ${Voice::peak []}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export peak values = foldList (values, 0, \(most, v) => choose (abs (v - 128) > most, abs (v - 128), most))

    (** The samples as a mono 8-bit PCM WAV file, in hex.
    # Examples
    ```osprey
    print "${Voice::wav [128, 130]}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export wav values = WaveFiles::mono8 (rate, values)
