// [SYNTH-HOST-MODULATION] Parameter routes remain ordinary typed graph cables.
namespace synth

(** Attach normalized control streams and produce bounded native automation points. *)
module HostModulation
    parameter (n, key) = match filterList (n.parameters, \p => p.key == key && p.automatable && p.unit == Normalised && p.minimum == 0.0 && p.maximum == 1.0)
        [p] => Valid(value = p)
        _ => Invalid(fault = InvalidParameter)

    named (n, key, at) = match listGet n.inputs at
        Error _ => false
        Success port => port.name == key

    index (n, key) = listGet (filterList (toList (range (0, length n.inputs)), \at => named (n, key, at))) 0

    replaced (next, old) = match old.identity == next.identity
        true => next
        false => old

    wired (graph, source, outlet, n, key) = match index (n, key)
        Success inlet => Graphs::rewire (graph, Components::route (source, outlet, n.identity, inlet))
        Error _ =>
            port = Port(name = key, rate = Control, channels = 1, unit = Normalised)
            next = n(inputs = listAppend n.inputs port)
            expanded = graph(nodes = mapList (graph.nodes, \old => replaced (next, old)))
            Graphs::rewire (expanded, Components::route (source, outlet, n.identity, length n.inputs))

    (** Add or replace a control cable transactionally; a rejected source leaves the graph unchanged. *)
    export connect (graph, source, outlet, destination, key) = match Graphs::node (graph, destination)
        Invalid fault => Invalid(fault = fault)
        Valid n => match n.processor
            External _ => match parameter (n, key)
                Invalid fault => Invalid(fault = fault)
                Valid _ => wired (graph, source, outlet, n, key)
            _ => Invalid(fault = InvalidNode)

    binding (graph, n, key) = match index (n, key)
        Error _ => []
        Success inlet => filterList (graph.cables, \c => c.destination == n.identity && c.inlet == inlet)

    value (clips, cable, offset) = match ClipInputs::completed (clips, cable.source)
        Error why => Error(message = why)
        Success clip => match clip.clipChannels == 1
            false => Error(message = "A parameter modulator must have one control channel.")
            true => listGet clip.clipSamples offset

    point (values, p, offset, number) = match startsWith p.key "vst:" && number >= 0.0 && number <= 1.0 && length values < 1024
        false => Error(message = "Invalid or excessive VST parameter automation.")
        true => match parseInt (drop p.key 4)
            Error why => Error(message = why)
            Success identity => match identity >= 0 && identity <= 4294967295
                false => Error(message = "VST parameter identity is outside its native range.")
                true => Success(value = listAppend values (HostParameter(identity = identity, offset = offset, value = number)))

    sampled (graph, clips, n, offset, outcome, p) = match outcome
        Error why => Error(message = why)
        Success values => match binding (graph, n, p.key)
            [] => match offset == 0
                true => point (values, p, offset, p.initial)
                false => Success(value = values)
            [cable] => match value (clips, cable, offset)
                Error why => Error(message = why)
                Success number => point (values, p, offset, number)
            _ => Error(message = "A parameter has more than one modulation source.")

    frame (graph, clips, n, outcome, offset) = foldList (filterList (n.parameters, \p => p.automatable), outcome, \(values, p) => sampled (graph, clips, n, offset, values, p))

    (** Emit a stable 128-frame automation grid, with defaults once and exact event offsets. *)
    export points (graph, clips, n, frames) = match frames > 0 && frames <= 32768
        false => Error(message = "Invalid automation clip length.")
        true => foldList (toList (range (0, intDiv (satAdd frames 127) 128)), Success(value = []), \(outcome, index) => frame (graph, clips, n, outcome, satMul index 128))
