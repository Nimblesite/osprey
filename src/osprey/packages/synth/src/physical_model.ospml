namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type Excitation =
    ImpulseExcitation
    NoiseExcitation
        colour : float

type ExciterConfig =
    strength : float
    duration : int
    interval : int
    excitation : Excitation

type ExciterState =
    age : float
    seed : float
    smoothed : float

type ExciterSample =
    sample : float
    next : ExciterState

type ResonatorScale =
    PeakScale
    ImpulseScale

type ResonatorConfig =
    sampleRate : float
    frequency : float
    decay : float
    gain : float
    scale : ResonatorScale

type ResonatorCoefficients =
    input : float
    cosine : float
    sine : float

type ResonatorState =
    real : float
    imag : float

type ResonatorSample =
    sample : float
    next : ResonatorState

type ModeSet =
    HarmonicModes
    BarModes
    MembraneModes
    BellModes

type ModalConfig =
    sampleRate : float
    frequency : float
    decay : float
    brightness : float
    strike : float
    count : int
    modes : ModeSet

type ModalBank =
    modes : List<ResonatorCoefficients>

type ModalState =
    modes : List<ResonatorState>

type ModalSample =
    sample : float
    next : ModalState

type DelayLine =
    samples : List<float>

type LossConfig =
    gain : float
    brightness : float

type LossState =
    previous : float

type LossSample =
    sample : float
    next : LossState

type AllpassState =
    input : float
    output : float

type AllpassSample =
    sample : float
    next : AllpassState

type WaveguideConfig =
    sampleRate : float
    frequency : float
    decay : float
    brightness : float
    dispersion : float
    pickup : float
    capacity : int

type WaveguideState =
    line : DelayLine
    loss : LossState
    dispersion : AllpassState

type WaveguideSample =
    sample : float
    next : WaveguideState

type ShaperCurve =
    TanhCurve
    HardCurve
    CubicCurve
    FoldCurve

type ShaperConfig =
    sampleRate : float
    curve : ShaperCurve
    drive : float
    bias : float
    level : float
    antialias : bool

type ShaperState =
    previous : float
    blockerInput : float
    blockerOutput : float

type ShaperSample =
    sample : float
    next : ShaperState

type OversampledState =
    shaper : ShaperState
    up : List<float>
    down : List<float>

type OversampledSample =
    sample : float
    next : OversampledState

type ReverbConfig =
    sampleRate : float
    size : float
    decay : float
    damping : float
    diffusion : float
    mix : float
    freeze : bool

type ReverbState =
    lines : List<DelayLine>
    damped : List<float>
    diffusers : List<DelayLine>

type DiffuserSample =
    sample : float
    lines : List<DelayLine>

type ReverbSample =
    sample : float
    next : ReverbState

type ShifterConfig =
    sampleRate : float
    shift : float
    ring : bool
    mix : float

type HilbertSection =
    input : float
    older : float
    output : float
    oldest : float

type ShifterState =
    first : List<HilbertSection>
    second : List<HilbertSection>
    delayed : float
    phase : float

type ShifterSample =
    sample : float
    next : ShifterState

type StringVoice =
    note : int
    velocity : float
    config : WaveguideConfig
    guide : WaveguideState
    exciter : ExciterState
    active : bool
    releasing : bool
    age : int
    released : int

type StringPool =
    voices : List<StringVoice>
    excitation : ExciterConfig
    release : float
    stolen : int

type StringPoolSample =
    sample : float
    next : StringPool

type SmootherConfig =
    sampleRate : float
    time : float
    linear : bool

type SmootherState =
    value : float

