// [SYNTH-ADVANCED-PHYSICAL-INSTRUMENTS] Finite-difference membrane: a separate, bounded, explicitly stable model.
namespace synth

(** Explicit 5-point scheme for the damped 2-D wave equation with fixed (zero) edges. Stability requires
    the Courant number λ ≤ 1/√2 (checked); loss σ ≥ 0 only removes energy. Grids are 2–32 points per side.
    Discretisation is coarse: mode ratios approach the ideal membrane only as the grid grows (dispersion). *)
module Meshes
    (** λ in (0, 0.7071], decay 0.01–60 s, excitation and pickup points inside the grid.
    # Examples
    ```osprey
    config = MeshConfig(sampleRate = 48000.0, width = 2, height = 2, courant = 0.5, decay = 1.0, exciteX = 0, exciteY = 0, pickX = 1, pickY = 1)
    print "${Meshes::configure config} ${Meshes::configure (config(courant = 0.9))}"
    ```
    ```output
    Success({ sampleRate: 48000.0, width: 2, height: 2, courant: 0.5, decay: 1.0, exciteX: 0, exciteY: 0, pickX: 1, pickY: 1 }) Error(InvalidConfiguration { detail: "Invalid mesh size, Courant number (must be <= 1/sqrt 2), decay or point." })
    ```
    *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && config.width >= 2 && config.width <= 32 && config.height >= 2 && config.height <= 32 && config.courant > 0.0 && config.courant <= 0.7071 && config.decay >= 0.01 && config.decay <= 60.0 && config.exciteX >= 0 && config.exciteX < config.width && config.exciteY >= 0 && config.exciteY < config.height && config.pickX >= 0 && config.pickX < config.width && config.pickY >= 0 && config.pickY < config.height
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Invalid mesh size, Courant number (must be <= 1/sqrt 2), decay or point."))

    zeros (width, height) = mapList (toList (range (0, height)), \_ => Sequences::zeros width)

    (** Silent membrane.
    # Examples
    ```osprey
    config = MeshConfig(sampleRate = 48000.0, width = 2, height = 2, courant = 0.5, decay = 1.0, exciteX = 0, exciteY = 0, pickX = 1, pickY = 1)
    print "${Meshes::initial config}"
    ```
    ```output
    { current: [[0.0, 0.0], [0.0, 0.0]], previous: [[0.0, 0.0], [0.0, 0.0]] }
    ```
    *)
    export initial config = MeshState(current = zeros (config.width, config.height), previous = zeros (config.width, config.height))

    (** The lowest mode in hertz for this grid and Courant number.
    # Examples
    ```osprey
    print "${Meshes::fundamental (MeshConfig(sampleRate = 48000.0, width = 2, height = 2, courant = 0.5, decay = 1.0, exciteX = 0, exciteY = 0, pickX = 1, pickY = 1))}"
    ```
    ```output
    5656.85424949238
    ```
    *)
    export fundamental config = PhysicalMath::meshFundamental (toFloat config.width, toFloat config.height, config.courant, config.sampleRate)

    silentRow row = mapList (row, \_ => 0.0)

    // Neighbours along a row: fixed edges read zero, by definition of the boundary condition.
    lefts row = listConcat [0.0] (Sequences::take (row, satSub (length row) 1))

    rights row = listAppend (Sequences::drop (row, 1)) 0.0

    excitation (config, x, y, input) = match x == config.exciteX && y == config.exciteY
        true => input
        false => 0.0

    // Direct recursion: a generic combine over record pairs with a captured float miscompiles today.
    advanced (config, rows, olds, laplacians, loss, x, y, input, done) = match rows
        [] => done
        [u, ...us] => match olds
            [] => done
            [p, ...ps] => match laplacians
                [] => done
                [l, ...ls] => advanced (config, us, ps, ls, loss, satAdd x 1, y, input, listAppend done (PhysicalMath::flushed (PhysicalMath::meshStep (u, p, l, config.courant, loss) + excitation (config, x, y, input))))

    // The excitation sum otherwise leaves `y`/`input` ambiguous to inference.
    rowStep : (MeshConfig, List<float>, List<float>, List<float>, List<float>, int, float) -> List<float>
    rowStep (config, above, row, below, previous, y, input) =
        loss = PhysicalMath::meshLoss (config.decay, config.sampleRate)
        sides = Sequences::combined (lefts row, rights row, \(l, r) => l + r)
        vertical = Sequences::combined (above, below, \(a, b) => a + b)
        neighbours = Sequences::combined (sides, vertical, \(h, v) => h + v)
        laplacian = Sequences::combined (neighbours, row, \(n, u) => n - 4.0 * u)
        advanced (config, row, previous, laplacian, loss, 0, y, input, [])

    stepped (config, rows, previous, above, y, input, done) = match rows
        [] => done
        [row, ...rest] => match previous
            [] => done
            [old, ...olds] =>
                below = match rest
                    [] => silentRow row
                    [next, ..._more] => next
                stepped (config, rest, olds, row, satAdd y 1, input, listAppend done (rowStep (config, above, row, below, old, y, input)))

    picked (config, rows) = foldList (Sequences::mapIndexed (rows, \(y, row) => pickRow (config, y, row)), 0.0, \(sum, value) => sum + value)

    pickRow (config, y, row) = match y == config.pickY
        true => foldList (Sequences::mapIndexed (row, \(x, value) => pickValue (config, x, value)), 0.0, \(sum, value) => sum + value)
        false => 0.0

    pickValue (config, x, value) = match x == config.pickX
        true => value
        false => 0.0

    (** One sample: `input` is added at the excitation point; the output is the pickup point's displacement.
    # Examples
    ```osprey
    config = MeshConfig(sampleRate = 48000.0, width = 2, height = 2, courant = 0.5, decay = 1.0, exciteX = 0, exciteY = 0, pickX = 1, pickY = 1)
    print "${Meshes::next (config, MeshState(current = [], previous = []), 1.0)} ${Meshes::next (config(height = 0), MeshState(current = [], previous = []), 1.0)}"
    ```
    ```output
    Error(IncompatibleLayout { detail: "Mesh state does not match its configuration." }) Error(MissingResource { detail: "Mesh state is empty." })
    ```
    *)
    export next (config, held, input) = match length held.current == config.height && length held.previous == config.height
        false => Error(message = IncompatibleLayout(detail = "Mesh state does not match its configuration."))
        true => match held.current
            [] => Error(message = MissingResource(detail = "Mesh state is empty."))
            [first, ..._rows] =>
                next = stepped (config, held.current, held.previous, silentRow first, 0, input, [])
                Success(value = MeshSample(sample = picked (config, next), next = MeshState(current = next, previous = held.current)))
