// [SYNTH-ADVANCED-PHYSICAL-INSTRUMENTS] Polyphonic waveguide strings with release tails and explicit stealing.
namespace synth

(** Up to 16 voices. Note-on takes a free voice, else steals the longest-released voice, else the oldest
    held one (counted in `stolen`); a stolen voice's line is cleared, which can click. Note-off shortens the
    voice's decay to `release` seconds and frees it once that T60 has elapsed. *)
module StringVoices
    silent (template, line) = StringVoice(note = -1, velocity = 0.0, config = template, guide = line, exciter = Exciters::initial 1, active = false, releasing = false, age = 0, released = 0)

    (** Allocate every voice's line outside rendering, using one template for capacity and timbre.
    # Examples
    ```osprey
    template = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4)
    excitation = ExciterConfig(strength = 0.8, duration = 96, interval = 0, excitation = ImpulseExcitation)
    print "${StringVoices::prepare (template, excitation, 0, 0.1)} ${StringVoices::prepare (template, excitation(strength = 2.0), 1, 0.1)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export prepare (template, excitation, count, release) = match count >= 1 && count <= 16 && release >= 0.01 && release <= 10.0
        false => Error(message = InvalidConfiguration(detail = "A string pool needs 1-16 voices and a release of 0.01-10 s."))
        true => match Waveguides::configure template
            Error why => Error(message = why)
            Success accepted => match Exciters::configure excitation
                Error why => Error(message = why)
                Success burst => Outcomes::carried (Waveguides::initial accepted, \line => Success(value = StringPool(voices = mapList (toList (range (0, count)), \_ => silent (accepted, line)), excitation = burst, release = release, stolen = 0)))

    // Victim order: an inactive voice, else the voice released longest ago, else the oldest held voice.
    rank voice = match voice.active
        false => 3000000000
        true => match voice.releasing
            true => satAdd 1000000000 voice.released
            false => voice.age

    higher (best, candidate) = match candidate.re > best.re
        true => candidate
        false => best

    // Each voice becomes (rank, index); the highest rank is the victim's index.
    victim (pool: StringPool) = (foldList (Sequences::mapIndexed (pool.voices, \(index, voice) => Complex(re = toFloat (rank voice), im = toFloat index)), Complex(re = -1.0, im = -1.0), \(best, candidate) => higher (best, candidate))).im

    cleared voice = voice(guide = WaveguideState(line = DelayLine(samples = mapList (voice.guide.line.samples, \_ => 0.0)), loss = LossFilters::initial, dispersion = Allpasses::initial))

    started (voice, note, velocity, frequency, seed) =
        restarted = match voice.active
            true => cleared voice
            false => voice
        restarted(note = note, velocity = velocity, config = tuned (voice.config, frequency), exciter = Exciters::initial seed, active = true, releasing = false, age = 0, released = 0)

    replace (pool, index, voice, note, velocity, frequency, seed) = Outcomes::carried (Waveguides::configure (tuned (voice.config, frequency)), \_ => Success(value = pool(voices = Sequences::mapIndexed (pool.voices, \(slot, held) => replacedAt (slot, index, held, note, velocity, frequency, seed)), stolen = stolenCount (pool, index))))

    (** Start `note` (MIDI pitch) at `frequency` Hz; the noise seed makes each pluck reproducible.
    # Examples
    ```osprey
    pool = StringPool(voices = [], excitation = ExciterConfig(strength = 0.8, duration = 96, interval = 0, excitation = ImpulseExcitation), release = 0.1, stolen = 0)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => StringVoices::noteOn (pool, 60, 0.8, 440.0, 1))} ${arithmetic (\() => StringVoices::noteOn (pool, 200, 0.8, 440.0, 1))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export noteOn (pool, note, velocity, frequency, seed) = match velocity >= 0.0 && velocity <= 1.0 && seed >= 1 && seed <= 2147483646 && note >= 0 && note <= 127
        false => Error(message = InvalidConfiguration(detail = "Note, velocity (0-1) or seed is out of range."))
        true => match floatToInt (victim pool)
            Error _ => Error(message = MissingResource(detail = "The string pool is empty."))
            Success index => match listGet pool.voices index
                Error _ => Error(message = MissingResource(detail = "The string pool is empty."))
                Success voice => replace (pool, index, voice, note, velocity, frequency, seed)

    replacedAt (slot, index, voice, note, velocity, frequency, seed) = match slot == index
        true => started (voice, note, velocity, frequency, seed)
        false => voice

    stolenCount (pool, index) = match listGet pool.voices index
        Success voice => match voice.active
            true => satAdd pool.stolen 1
            false => pool.stolen
        Error _ => pool.stolen

    released (voice, note) = match voice.active && !voice.releasing && voice.note == note
        true => voice(releasing = true, released = 0)
        false => voice

    (** Release every held voice playing `note`; their tails continue until the release T60 elapses.
    # Examples
    ```osprey
    pool = StringPool(voices = [StringVoice(note = 60, velocity = 0.8, config = WaveguideConfig(sampleRate = 48000.0, frequency = 12000.0, decay = 1.0, brightness = 0.5, dispersion = 0.5, pickup = 0.0, capacity = 4), guide = WaveguideState(line = DelayLine(samples = [0.0, 0.0, 0.0, 0.0]), loss = LossFilters::initial, dispersion = Allpasses::initial), exciter = Exciters::initial 1, active = true, releasing = false, age = 0, released = 0)], excitation = ExciterConfig(strength = 0.8, duration = 96, interval = 0, excitation = ImpulseExcitation), release = 0.1, stolen = 0)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => StringVoices::noteOff (pool, 60))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export noteOff (pool, note) = pool(voices = mapList (pool.voices, \voice => released (voice, note)))

    tuned (config, frequency) = config(frequency = frequency)

    decayed (config, release) = config(decay = release)

    louder (config, velocity) = config(strength = config.strength * velocity)

    releaseStep voice = match voice.releasing
        true => 1
        false => 0

    pooled (pool, voice) = pool(voices = listAppend pool.voices voice)

    appended (mixed, voice, sample) = StringPoolSample(sample = mixed.sample + sample, next = pooled (mixed.next, voice))

    // Held voices decay at the template T60; released voices at the release T60.
    decaying (pool, voice) = match voice.releasing
        true => decayed (voice.config, pool.release)
        false => voice.config

    excited (pool, voice) =
        Exciters::next (louder (pool.excitation, voice.velocity), voice.exciter)

    finished (pool, voice) = voice.releasing && toFloat voice.released > pool.release * voice.config.sampleRate

    voiced (pool, outcome, voice) = match outcome
        Error why => Error(message = why)
        Success mixed => match voice.active
            false => Success(value = appended (mixed, voice, 0.0))
            true =>
                burst = excited (pool, voice)
                match Waveguides::next (decaying (pool, voice), voice.guide, burst.sample)
                    Error why => Error(message = why)
                    Success step =>
                        advanced = voice(guide = step.next, exciter = burst.next, age = satAdd voice.age 1, released = satAdd voice.released (releaseStep voice))
                        Success(value = appended (mixed, advanced(active = !finished (pool, advanced)), step.sample))

    (** One sample: active voices sum without normalisation, so reserve headroom for chords.
    # Examples
    ```osprey
    pool = StringPool(voices = [], excitation = ExciterConfig(strength = 0.8, duration = 96, interval = 0, excitation = ImpulseExcitation), release = 0.1, stolen = 0)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => StringVoices::next pool)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export next pool = foldList (pool.voices, Success(value = StringPoolSample(sample = 0.0, next = pool(voices = []))), \(outcome, voice) => voiced (pool, outcome, voice))

