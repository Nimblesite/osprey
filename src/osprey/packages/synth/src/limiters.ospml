// [SYNTH-DYNAMICS-LIMITER] Brick-wall lookahead limiter over a whole stereo buffer, both sides linked.
namespace synth

(** Each frame needs the gain that brings its louder side to `ceiling`. The lowest need across the next `lookahead`
    frames is held (a running block minimum, linear in the length), taken at once downward and released upward,
    then averaged over the lookahead, so the gain reaches each peak's need exactly as the peak arrives and never
    overshoots. Peaks are true peaks: each side is also read four times oversampled (ITU-R BS.1770-4), so a
    peak between samples counts. A last clamp keeps every sample inside the ceiling. Formulas: dynamics_math.ospml. *)
module Limiters
    phases = 4

    taps = 8

    // The oversampling prototype: one row of `taps` coefficients per phase.
    prototype () = mapList (toList (range (0, phases)), \phase => mapList (toList (range (0, taps)), \i => DynamicsMath::oversampleTap (DynamicsMath::tapPosition (toFloat i, toFloat phase, toFloat phases), toFloat taps, toFloat phases)))

    // One phase's value near frame `index`, from the taps centred on it.
    between (side, row, index) = foldList (toList (range (0, taps)), 0.0, \(sum, i) => DynamicsMath::accumulated (sum, listGet row i ?: 0.0, listGet side (satSub (satAdd index (intDiv taps 2)) i) ?: 0.0))

    // The true peak of one side around frame `index`: the sample and every oversampled phase.
    around (rows, side, index, peak) = foldList (rows, DynamicsMath::truePeak (peak, listGet side index ?: 0.0), \(high, row) => DynamicsMath::truePeak (high, between (side, row, index)))

    needs (left, right, ceiling) =
        rows = prototype ()
        mapList (toList (range (0, length left)), \index => DynamicsMath::required (around (rows, right, index, around (rows, left, index, 0.0)), ceiling))

    // The newest gain is the lower of `value` and the one before it, unless `restart` opens a new block.
    carried (gains, restart, value) = match restart
        true => listPrepend gains value
        false => listPrepend gains (DynamicsMath::held (listGet gains 0 ?: 1.0, value))

    // The lowest need from each block's start up to each frame.
    leading (wanted, block) = listReverse (foldList (toList (range (0, length wanted)), [], \(gains, index) => carried (gains, index % block == 0, listGet wanted index ?: 1.0)))

    // The lowest need from each frame to its block's end (built back to front, so it reads in order).
    trailing (wanted, block) =
        last = length wanted - 1
        foldList (listReverse (toList (range (0, length wanted))), [], \(gains, index) => carried (gains, index == last || (index + 1) % block == 0, listGet wanted index ?: 1.0))

    // The lowest need over frames `index` to `index + block - 1`, from at most two blocks.
    windowed (front, back, block, index) =
        reach = match index + block - 1 < length front
            true => index + block - 1
            false => length front - 1
        match intDiv reach block == intDiv index block
            true => listGet back index ?: 1.0
            false => DynamicsMath::held (listGet back index ?: 1.0, listGet front reach ?: 1.0)

    held (wanted, block) =
        front = leading (wanted, block)
        back = trailing (wanted, block)
        mapList (toList (range (0, length wanted)), \index => windowed (front, back, block, index))

    rise (gains, release, target) = listPrepend gains (DynamicsMath::released (listGet gains 0 ?: 1.0, target, release))

    released (holding, release) = listReverse (foldList (holding, [], \(gains, target) => rise (gains, release, target)))

    // The release curve averaged over the last `block` frames.
    // Before the buffer starts, the history holds the first frame's gain, which no later need undercuts.
    leaving (curve, block, index) = match index >= block
        true => listGet curve (index - block) ?: 1.0
        false => listGet curve 0 ?: 1.0

    smooth (curve, block, gains, index) = listPrepend gains (DynamicsMath::averaged (listGet gains 0 ?: (listGet curve 0 ?: 1.0), listGet curve index ?: 1.0, leaving (curve, block, index), toFloat block))

    averaged (curve, block, count) = listReverse (foldList (toList (range (0, count)), [], \(gains, index) => smooth (curve, block, gains, index)))

    shaped (left, right, ceiling, block, release) =
        curve = released (held (needs (left, right, ceiling), block), release)
        averaged (curve, block, length left)

    valid (left, right, rate, ceiling, milliseconds, release) = length left == length right && rate >= 8000.0 && rate <= 384000.0 && ceiling > 0.0 && ceiling <= 1.0 && milliseconds >= 0.1 && milliseconds <= 20.0 && release >= 0.001 && release <= 2.0

    (** One linked gain per frame for `left` and `right` at `rate`: `ceiling` 0–1 linear, lookahead 0.1–20 ms,
        release 1 ms–2 s.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Limiters::gains ([1.0], [2.0], 48000.0, 1.0, 5.0, 0.1))} ${arithmetic (\() => Limiters::gains ([1.0], [], 48000.0, 1.0, 5.0, 0.1))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export gains (left, right, rate, ceiling, milliseconds, release) = match valid (left, right, rate, ceiling, milliseconds, release)
        false => Error(message = InvalidConfiguration(detail = "A limiter needs equal sides, a rate of 8 to 384 kHz, a ceiling above 0 up to 1, a lookahead of 0.1 to 20 ms and a release of 1 ms to 2 s."))
        true => Outcomes::whole ((DynamicsMath::lookahead (milliseconds, rate)), \block => Success(value = shaped (left, right, ceiling, block, DynamicsMath::coefficient (release, rate))))

    (** One side through the gains, clamped to `ceiling`.
    # Examples
    ```osprey
    print "${Limiters::applied ([2.0, -2.0], [0.5, 1.0], 0.95)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export applied (side, gains, ceiling) = mapList (toList (range (0, length side)), \index => DynamicsMath::limitedSample (listGet side index ?: 0.0, listGet gains index ?: 1.0, ceiling))
