// [SYNTH-ADVANCED-PHYSICAL-PRIMITIVES] First-order allpass dispersion: unity magnitude, frequency-dependent delay.
namespace synth

(** Dispersion stretches upper partials; coefficients are bounded to |a| <= 0.95 for stability margin. *)
module Allpasses
    (** Silent history. *)
    export initial = AllpassState(input = 0.0, output = 0.0)

    (** Accept a coefficient with a stability margin. *)
    export configure coefficient = match coefficient >= -0.95 && coefficient <= 0.95
        true => Success(value = coefficient)
        false => Error(message = InvalidConfiguration(detail = "Allpass coefficient must be between -0.95 and 0.95."))

    (** One step with an accepted coefficient. *)
    export next (coefficient, held, input) =
        value = coefficient * input + held.input - coefficient * held.output
        AllpassSample(sample = value, next = AllpassState(input = input, output = value))
