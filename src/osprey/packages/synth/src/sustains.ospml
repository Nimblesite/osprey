// [SYNTH-ARRANGEMENT-SUSTAIN] A recording's final moment held by the phase-vocoder freeze and replayed at any pitch.
namespace synth

(** The source is analysed to its end, its last spectrum is captured, and the held spectrum then plays
    with every bin advancing at its measured frequency. `voiced` reads that hold at a speed ratio, so the
    same captured sound returns at other pitches (4/3 is a fourth up), with its own rise, hold and fade.
    The first 4,096 held frames still carry the overlap-add tail of the real recording and are skipped. *)
module Sustains
    skipped = 4096

    stream (rate, held) = SpectralConfig(sampleRate = rate, size = 4096, hop = 1024, transform = SpectralFreeze(held = held), mix = 1.0)

    heard (rate, run, input) = match run.fault == ""
        false => run
        true => match SpectralStreams::next (stream (rate, false), run.held, input, 0.0)
            Error why => run(fault = why)
            Success step => run(held = step.next)

    sung (rate, run) = match run.fault == ""
        false => run
        true => match SpectralStreams::next (stream (rate, true), run.held, 0.0, 0.0)
            Error why => run(fault = why)
            Success step => NoteRun(held = step.next, samples = listAppend run.samples step.sample, fault = "")

    held (rate, source, count) =
        analysed = foldList (source, NoteRun(held = SpectralStreams::initial (stream (rate, false)), samples = [], fault = ""), \(run, input) => heard (rate, run, input))
        NoteRenders::finished (foldList (toList (range (0, count)), analysed, \(run, _frame) => sung (rate, run)))

    (** `source` is mono audio (at least 4,096 samples) ending at the moment to hold; the result is
        `seconds` (0.1–120) of the held sound at full level. *)
    export frozen (rate, source, seconds) = match length source >= 4096 && seconds >= 0.1 && seconds <= 120.0
        false => Error(message = "A sustain needs 4096 source samples and 0.1 to 120 seconds.")
        true => match SpectralStreams::configure (stream (rate, true))
            Error why => Error(message = why)
            Success _ => match floatToInt (ArrangeMath::secondFrames (seconds, rate))
                Error _ => Error(message = "The sustain length is not finite.")
                Success count => held (rate, source, count)

    lasting glow = glow.rise + glow.hold + glow.fade

    valid glow = glow.start >= 0.0 && glow.ratio >= 0.25 && glow.ratio <= 4.0 && glow.rise >= 0.01 && glow.rise <= 60.0 && glow.hold >= 0.0 && glow.hold <= 60.0 && glow.fade >= 0.01 && glow.fade <= 60.0

    (** Seconds of held sound that these appearances read, including the skipped start. *)
    export needed (rate, glows) = foldList (glows, 0.0, longest) + (toFloat skipped + 2.0) / rate

    longest (most, glow) = TableMath::larger (most, lasting glow * glow.ratio)

    level (rate, glow, frame) = ArrangeMath::gated (toFloat frame, ArrangeMath::secondFrames (glow.rise + glow.hold, rate), glow.rise * rate, glow.fade * rate)

    // Linear interpolation is not bandlimited: raising the pitch folds content above the new Nyquist.
    read (raw, glow, frame) =
        position = ArrangeMath::readAt (toFloat frame, glow.ratio, toFloat skipped)
        match floatToInt (floor position)
            Error _ => 0.0
            Success lower => GrainMath::interpolated (listGet raw lower ?: 0.0, listGet raw (satAdd lower 1) ?: 0.0, GrainMath::fraction position)

    sounded (rate, raw, glow, count) = mapList (toList (range (0, count)), \frame => read (raw, glow, frame) * level (rate, glow, frame))

    (** One appearance of the held sound: ratio 0.25–4, rise 0.01–60 s, hold 0–60 s, fade 0.01–60 s. The
        hold must be long enough (`needed`, within one frame of rounding), otherwise this is an error. *)
    export voiced (rate, raw, glow) = match valid glow && toFloat (length raw) + 1.0 >= needed (rate, [glow]) * rate
        false => Error(message = "A sustain appearance has controls out of range or reads past the held sound.")
        true => match floatToInt (ArrangeMath::secondFrames (lasting glow, rate))
            Error _ => Error(message = "The sustain length is not finite.")
            Success count => Success(value = sounded (rate, raw, glow, count))
