namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type Rate =
    Audio
    Control
    Events

type Unit =
    Amplitude
    Hertz
    Seconds
    Normalised
    Ratio
    Notes

type Port =
    name : string
    rate : Rate
    channels : int
    unit : Unit

type Parameter =
    key : string
    label : string
    unit : Unit
    minimum : float
    maximum : float
    initial : float
    automatable : bool

type TableLevel =
    harmonics : int
    samples : List<float>

type TableFrame =
    levels : List<TableLevel>

type Wavetable =
    size : int
    harmonics : int
    frames : List<TableFrame>

type SampleResource =
    name : string
    sampleRate : int
    sourceChannels : int
    rootFrequency : float
    samples : List<float>

type Processor =
    SamplePlayer
        resource : SampleResource
    Granular
        resource : SampleResource
        capacity : int
        seed : int
    Exciter
        seed : int
    Resonator
    Modal
    Waveguide
        capacity : int
    FractionalDelay
        capacity : int
    LossFilter
    Allpass
    TableOscillator
        table : Wavetable
    Additive
    Spectral
        size : int
        hop : int
    Shaper
    Reverb
    Shifter
    PhaseOperator
    Bowed
        capacity : int
    Smoother
    StrikeComb
        capacity : int
    Downmix
    Lfo
    ModulatedGain
    MidiNotes
    FormulaNotes
        formula : string
    Stereo
    Panner
    Split
    Join
    Route
        channelMap : List<int>
    Oscillator
    Filter
    Amplifier
    Mixer
    Sink
    Delay
        samples : int
    External
        identifier : string
        latency : int

type Node =
    identity : int
    processor : Processor
    inputs : List<Port>
    outputs : List<Port>
    parameters : List<Parameter>

type Cable =
    source : int
    outlet : int
    destination : int
    inlet : int

type Graph =
    nodes : List<Node>
    cables : List<Cable>

type Prepared =
    graph : Graph
    order : List<int>
    feedback : List<Cable>

type RankedNode =
    component : Node
    ordinal : int

type RouteIndex Inlets Fanout Counts =
    occupiedInlets : Inlets
    destinations : Fanout
    dependencies : Counts
    delayedInputs : List<Cable>

type ReadyNodes =
    NoReadyNode
    ReadyNode
        ordinal : int
        depth : int
        left : ReadyNodes
        right : ReadyNodes

type ReadyQueue Counts =
    readyNodes : ReadyNodes
    remainingInputs : Counts

type GraphFault =
    DuplicateNode
    MissingNode
    InvalidNode
    InvalidPort
    IncompatiblePorts
    OccupiedInput
    DuplicateParameter
    InvalidParameter
    Cycle
    MissingParameter
    StaleRevision
    InvalidFrame

type Checked T =
    Valid
        value : T
    Invalid
        fault : GraphFault

type ParameterValue =
    node : int
    key : string
    value : float

type ComponentState =
    node : int
    activeVoices : int
    peak : float
    rms : float

type Observation =
    revision : int
    samplePosition : int
    parameters : List<ParameterValue>
    components : List<ComponentState>

type ParameterChange =
    node : int
    key : string
    value : float
    revision : int
    samplePosition : int

type SnapshotSlot =
    latest : Observation
    published : int
    delivered : int

type SlotRead =
    observation : Observation
    coalesced : int
    next : SnapshotSlot

type CommandStatus =
    Pending
        edit : ParameterChange
    Applied
        revision : int
    Rejected
        fault : GraphFault

type CommandReceipt =
    status : CommandStatus
    snapshot : Observation

type MacroTarget =
    node : int
    key : string
    minimum : float
    maximum : float
    exponent : float

type Macro =
    name : string
    targets : List<MacroTarget>

type SavedNode =
    identity : int
    kind : string
    version : int
    settings : List<int>
    resource : string
    values : List<ParameterValue>
    inputs : int

type PatchDocument =
    format : int
    nodes : List<SavedNode>
    cables : List<Cable>
    macros : List<Macro>

type NamedResource =
    name : string
    sample : SampleResource

type NamedTable =
    name : string
    table : Wavetable

type PatchResources =
    samples : List<NamedResource>
    tables : List<NamedTable>

type ResourceIdentity =
    name : string
    hash : int
    channels : int
    sampleRate : int
    frames : int
    version : int

type PathLatency =
    latencyNode : int
    arrival : int

type Alignment =
    alignedGraph : Graph
    arrivals : List<PathLatency>
    lastDelay : int
    reservedSamples : int
