type Timeline T =
    audio : Rendered
    observation : T

type Stage =
    Ready
    Running
    Releasing
        remaining : int
    Disposed

type Transition =
    Prepare
        rate : float
        block : int
    Activate
    Reset
    ReleaseTail
    Dispose

type Instance P =
    stage : Stage
    rate : float
    block : int
    plan : P
    audio : Rendered
