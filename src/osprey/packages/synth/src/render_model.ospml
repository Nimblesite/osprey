namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type KernelMemory =
    KernelIdle
    SpectralRunning
        stream : synth::SpectralState
    BowRunning
        bow : synth::BowState
    ReverbRunning
        reverb : synth::ReverbState
    ModalRunning
        settings : synth::ModalConfig
        bank : synth::ModalBank
        resonators : synth::ModalState
    ShifterRunning
        shifter : synth::ShifterState

type KernelState =
    identity : int
    phase : float
    integratorOne : float
    integratorTwo : float
    delay : List<float>
    memory : KernelMemory

type NodeSample =
    identity : int
    value : float

type SampleFrame =
    states : List<KernelState>
    values : List<NodeSample>

type Meter =
    identity : int
    peak : float
    energy : float
    count : int

type Rendered =
    states : List<KernelState>
    samples : List<float>
    position : int
