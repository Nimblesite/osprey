namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type KernelState =
    identity : int
    phase : float
    integratorOne : float
    integratorTwo : float
    delay : List<float>

type NodeSample =
    identity : int
    value : float

type SampleFrame =
    states : List<KernelState>
