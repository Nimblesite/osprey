// [SYNTH-ARRANGEMENT-ROUTING] One note played through a routed graph of components.
namespace synth

(** A routing names components, their settings and the cables between them. Each note builds that graph
    with its own values (a setting can follow the note's frequency or velocity), renders it through the
    reference `Renderer`, and shapes the result with a linear attack and release around the note's gate.
    Sizes are in samples: a waveguide, bowed string, strike comb or delay needs room for its lowest pitch. *)
module PatchVoices
    hertz note = Waves::midiFrequency (toFloat note.pitch)

    resolved (note, setting) = match setting.follow
        Constant => setting.value
        Pitched => setting.value * hertz note
        Struck => setting.value * note.velocity

    sources (item, table) = match item.component
        "exciter" => Success(value = Components::exciter (item.identity, item.seed))
        "sine" => Success(value = Components::sine (item.identity, 440.0))
        "wavetable" => Success(value = Components::wavetable (item.identity, table, 220.0))
        "additive" => Success(value = Components::additive (item.identity, 220.0))
        "operator" => Success(value = Components::phaseOperator (item.identity, 220.0, 0.0))
        "bowed" => Success(value = Components::bowed (item.identity, 220.0, item.size))
        "lfo" => Success(value = Components::lfo (item.identity, 1.0))
        other => Error(message = "Unknown module \"${other}\".")

    resonant (item, table) = match item.component
        "resonator" => Success(value = Components::resonator (item.identity, 440.0))
        "modal" => Success(value = Components::modalBank (item.identity, 440.0, 3.0))
        "waveguide" => Success(value = Components::waveguide (item.identity, 220.0, item.size))
        "strikeComb" => Success(value = Components::strikeComb (item.identity, 220.0, item.size))
        "fractionalDelay" => Success(value = Components::fractionalDelay (item.identity, 1.0, item.size))
        "lossFilter" => Success(value = Components::lossFilter (item.identity, 0.99, 0.5))
        "allpass" => Success(value = Components::allpass (item.identity, 0.5))
        "lowpass" => Success(value = Components::lowpass (item.identity, 1000.0, 0.7))
        _ => sources (item, table)

    effects (item, table) = match item.component
        "shaper" => Success(value = Components::shaper (item.identity, 0.0, 1.5))
        "shifter" => Success(value = Components::shifter (item.identity, 0.0))
        "spectral" => Success(value = Components::spectral (item.identity, item.size, intDiv item.size 4, 0.0))
        "reverb" => Success(value = Components::reverb (item.identity, 2.0))
        "smoother" => Success(value = Components::smoother (item.identity, 0.01))
        _ => resonant (item, table)

    made (item, table) = match item.component
        "gain" => Success(value = Components::gain (item.identity, 1.0))
        "modulatedGain" => Success(value = Components::modulatedGain (item.identity, 1, 1.0))
        "mixer" => Success(value = Components::mixer item.identity)
        "delay" => Success(value = Components::delay (item.identity, item.size))
        "output" => Success(value = Components::output item.identity)
        _ => effects (item, table)

    known (n, setting) = length (filterList (n.parameters, \p => p.key == setting.key)) == 1

    placed (note, item, n) = match length (filterList (item.settings, \setting => known (n, setting))) == length item.settings
        false => Error(message = "Module \"${item.component}\" has no such setting.")
        true => Success(value = Patches::adjusted (n, mapList (item.settings, \setting => ParameterValue(node = item.identity, key = setting.key, value = resolved (note, setting)))))

    nodeAdded (note, table, outcome, item) = match outcome
        Error why => Error(message = why)
        Success nodes => match made (item, table)
            Error why => Error(message = why)
            Success n => match placed (note, item, n)
                Error why => Error(message = why)
                Success tuned => Success(value = listAppend nodes tuned)

    cabled routing = mapList (routing.cables, \cable => Components::route (cable.source, cable.outlet, cable.destination, cable.inlet))

    block (plan, graph, rate, run, count) = match run.fault == ""
        false => run
        true => match Renderer::block (plan, rate, Parameters::initial graph, run.held, count)
            Error why => run(fault = why)
            Success next => NoteRun(held = next, samples = listConcat run.samples next.samples, fault = "")

    // Whole 8,192-frame blocks, then the remainder.
    counts total = listAppend (mapList (toList (range (0, intDiv total 8192)), \_ => 8192)) (satSub total (satMul (intDiv total 8192) 8192))

    heard (samples, frame) = match listGet samples frame
        Error _ => 0.0
        Success value => value

    shaped (samples, noteSpan: NoteSpan, routing: Routing, rate) = mapList (toList (range (0, length samples)), \frame => heard (samples, frame) * ArrangeMath::gated (toFloat frame, noteSpan.gate, routing.attack * rate, routing.release * rate))

    finished run = match run.fault == ""
        true => Success(value = run.samples)
        false => Error(message = run.fault)

    played (graph, plan, noteSpan, routing, rate) = match Renderer::start graph
        Error why => Error(message = why)
        Success initial => match finished (foldList (counts noteSpan.total, NoteRun(held = initial, samples = [], fault = ""), \(run, count) => block (plan, graph, rate, run, count)))
            Error why => Error(message = why)
            Success samples => Success(value = shaped (samples, noteSpan, routing, rate))

    routed (nodes, noteSpan, routing, rate) = match Patches::built (nodes, cabled routing)
        Invalid fault => Error(message = "The routing is not a valid graph: ${fault}.")
        Valid graph => match Graphs::prepare graph
            Invalid fault => Error(message = "The routing cannot be scheduled: ${fault}.")
            Valid plan => played (graph, plan, noteSpan, routing, rate)

    (** Render one note through the routing: attack and release are 0.001–10 s. *)
    export render (note, noteSpan, rate, routing) = match routing.attack >= 0.001 && routing.attack <= 10.0 && routing.release >= 0.001 && routing.release <= 10.0
        false => Error(message = "A routing's attack and release must be 0.001 to 10 s.")
        true => match Wavetables::classic (1024, 128)
            Error why => Error(message = why)
            Success table => match foldList (routing.nodes, Success(value = []), \(outcome, item) => nodeAdded (note, table, outcome, item))
                Error why => Error(message = why)
                Success nodes => routed (nodes, noteSpan, routing, rate)
