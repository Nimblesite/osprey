// [SYNTH-ADVANCED-GRAINS-INTEGRATION] The shared graph scheduler invokes the same grain-cloud engine.
namespace synth

(** Parameter decoding and persistent stereo graph execution for sampled grain clouds. *)
module GrainGraph
    integer value = Outcomes::whole (value, \count => exact (count, value))

    exact (count, value) = match toFloat count == value
        true => Success(value = count)
        false => Error(message = InvalidConfiguration(detail = "Grain timing requires whole output-sample counts."))

    parameter (n, outcome, key) =
        use values <- Outcomes::carried (outcome)
        match Graphs::parameterNamed (n, key)
            Error _ => Error(message = Outcomes::indexOutOfBounds)
            Success p => Success(value = listAppend values p.initial)

    timed (playback, period, jitter, mode, maximum) =
        use interval <- Outcomes::carried (integer period)
        use spread <- Outcomes::carried (integer jitter)
        use limit <- Outcomes::carried (integer maximum)
        use timing <- Outcomes::carried (GrainTimings::decode (mode, interval, spread, limit))
        Success(value = GrainNodeControls(playback = playback, timing = timing))

    configuration n =
        use values <- Outcomes::carried (foldList (["start", "rate", "duration", "gain", "pan", "period", "jitter", "window", "attack", "release", "timing", "maximumGap"], Success(value = []), \(outcome, key) => parameter (n, outcome, key)))
        match values
            [start, rate, duration, gain, pan, period, jitter, mode, attack, release, timing, maximum] =>
                use lifetime <- Outcomes::carried (integer duration)
                use shape <- Outcomes::carried (GrainWindows::decode (mode, attack, release))
                timed (GrainControls(window = shape, start = start, rate = rate, duration = lifetime, amplitude = gain, pan = pan), period, jitter, timing, maximum)
            _ => Error(message = InvalidConfiguration(detail = "Incomplete grain module controls."))

    variationSeed n =
        use values <- Outcomes::carried (parameter (n, Success(value = []), "variationSeed"))
        match values
            [seed] => integer seed
            _ => Error(message = MissingResource(detail = "Missing grain variation seed."))

    distribution (n, controls, size) =
        use values <- Outcomes::carried (foldList (["positionSpread", "rateSpread", "durationSpread", "gainSpread", "panSpread"], Success(value = []), \(held, key) => parameter (n, held, key)))
        match values
            [position, rate, duration, amplitude, pan] => Outcomes::carried (integer duration, \frames => GrainSpreads::around (controls, size, GrainSpread(position = position, rate = rate, duration = frames, amplitude = amplitude, pan = pan)))
            _ => Error(message = InvalidConfiguration(detail = "Incomplete grain spread controls."))

    bounds (first, limit, boundary) =
        use lo <- Outcomes::carried (integer first)
        use hi <- Outcomes::carried (integer limit)
        Outcomes::chosen (boundary, [GrainRegion(first = lo, limit = hi, boundary = LoopSource), GrainRegion(first = lo, limit = hi, boundary = OneShotSource)], "Grain boundary must be 0 (loop) or 1 (one-shot).")

    region (n, size) = match length (filterList (n.parameters, \p => p.key == "regionStart" || p.key == "regionEnd" || p.key == "boundary"))
        0 => Success(value = GrainRegion(first = 0, limit = size, boundary = LoopSource))
        3 => Outcomes::carried (foldList (["regionStart", "regionEnd", "boundary"], Success(value = []), \(held, key) => parameter (n, held, key)), \values =>
            match values
                [first, limit, boundary] => bounds (first, limit, boundary)
                _ => Error(message = InvalidConfiguration(detail = "Incomplete grain source region.")))
        _ => Error(message = InvalidConfiguration(detail = "Incomplete grain source region."))

    withRegion (n, cloud) =
        use selected <- Outcomes::carried (region (n, length cloud.pool.source))
        match structuralEquals (selected, cloud.pool.region)
            true => Success(value = cloud)
            false => Outcomes::carried (Grains::withRegion (cloud.pool, selected), \pool => Success(value = cloud(pool = pool)))

    (** Prepare an instance only at the graph origin; later blocks must supply its retained memory.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => GrainGraph::prepare (Components::sine (1, 440.0)))}"
    ```
    ```output
    Error(MissingResource { detail: "The component is not a grain cloud." })
    ```
    *)
    export prepare n = match n.processor
        Granular resource capacity seed =>
            use controls <- Outcomes::carried (configuration n)
            match SampleResources::metadata resource
                false => Error(message = InvalidConfiguration(detail = "Invalid grain sample metadata."))
                true =>
                    use randomSeed <- Outcomes::carried (variationSeed n)
                    use samples <- Outcomes::carried (SampleResources::mono resource)
                    use cloud <- Outcomes::carried (GrainClouds::prepare (samples, capacity, controls.timing, seed, randomSeed))
                    withRegion (n, cloud(sourceSamples = resource.samples))
        _ => Error(message = MissingResource(detail = "The component is not a grain cloud."))

    (** Reject memory from a different resource, pool capacity or graph sample position.
    # Examples
    ```osprey
    cloud = GrainCloudState(sourceSamples = [0.0, 0.5], pool = GrainPool(region = GrainRegion(first = 0, limit = 2, boundary = LoopSource), source = [0.0, 0.5], retiredSource = [], retiredBefore = 0, capacity = 8, voices = [], revision = 0, position = 0, nextIdentity = 0), clock = GrainClock(position = 0, nextOnset = 0, timing = PeriodicTiming(period = 2400, jitter = 0), seed = 1), seeds = GrainSeeds(position = 1, rate = 1, duration = 1, amplitude = 1, pan = 1))
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => GrainGraph::compatible (Components::sine (1, 440.0), cloud, 0))} ${arithmetic (\() => GrainGraph::compatible (Components::granular (1, SampleResource(name = "voice", sampleRate = 48000, sourceChannels = 1, rootFrequency = 220.0, samples = [0.0, 0.5]), 8, 7), cloud, 1))}"
    ```
    ```output
    false false
    ```
    *)
    export compatible (n, cloud, position) = match n.processor
        Granular resource capacity _ => SampleResources::metadata resource && structuralEquals (resource.samples, cloud.sourceSamples) && SampleResources::frames resource == length cloud.pool.source && capacity == cloud.pool.capacity && cloud.pool.position == position && cloud.clock.position == position
        _ => false

    (** Apply graph controls to newly emitted grains; surviving grains retain their own envelopes and cursors.
    # Examples
    ```osprey
    cloud = GrainCloudState(sourceSamples = [0.0, 0.5], pool = GrainPool(region = GrainRegion(first = 0, limit = 2, boundary = LoopSource), source = [0.0, 0.5], retiredSource = [], retiredBefore = 0, capacity = 8, voices = [], revision = 0, position = 0, nextIdentity = 0), clock = GrainClock(position = 0, nextOnset = 0, timing = PeriodicTiming(period = 2400, jitter = 0), seed = 1), seeds = GrainSeeds(position = 1, rate = 1, duration = 1, amplitude = 1, pan = 1))
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => GrainGraph::block (Components::sine (1, 440.0), cloud, 16))}"
    ```
    ```output
    Error(MissingResource { detail: "index out of bounds" })
    ```
    *)
    export block (n, cloud, frames) = Outcomes::carried (withRegion (n, cloud), \selected => audio (n, selected, frames))

    audio (n, cloud, frames) =
        use controls <- Outcomes::carried (configuration n)
        use ranges <- Outcomes::carried (distribution (n, controls.playback, length cloud.pool.source))
        match ranges.minimum.start >= toFloat cloud.pool.region.first && ranges.maximum.start < toFloat cloud.pool.region.limit
            false => Error(message = InvalidConfiguration(detail = "Grain start positions and spread must stay inside the selected region."))
            true =>
                clock = cloud.clock
                GrainClouds::variedBlock (cloud(clock = clock(timing = controls.timing)), ranges, frames)

    interleave (block, outcome, index) =
        use samples <- Outcomes::carried (outcome)
        match listGet block.left index
            Error _ => Error(message = Outcomes::indexOutOfBounds)
            Success left => match listGet block.right index
                Error _ => Error(message = Outcomes::indexOutOfBounds)
                Success right => Success(value = listPrepend (listPrepend samples left) right)

    (** Interleave actual left/right output for the common graph/device transport.
    # Examples
    ```osprey
    cloud = GrainCloudState(sourceSamples = [0.0, 0.5], pool = GrainPool(region = GrainRegion(first = 0, limit = 2, boundary = LoopSource), source = [0.0, 0.5], retiredSource = [], retiredBefore = 0, capacity = 8, voices = [], revision = 0, position = 0, nextIdentity = 0), clock = GrainClock(position = 0, nextOnset = 0, timing = PeriodicTiming(period = 2400, jitter = 0), seed = 1), seeds = GrainSeeds(position = 1, rate = 1, duration = 1, amplitude = 1, pan = 1))
    print "${GrainGraph::interleaved (GrainCloudBlock(left = [0.5, -0.5], right = [0.25, -0.25], next = cloud))} ${GrainGraph::interleaved (GrainCloudBlock(left = [], right = [], next = cloud))}"
    ```
    ```output
    Success([0.5, 0.25, -0.5, -0.25]) Error(IncompatibleLayout { detail: "Grain output channels have invalid lengths." })
    ```
    *)
    export interleaved block = match length block.left == length block.right && length block.left >= 1 && length block.left <= 2048
        false => Error(message = IncompatibleLayout(detail = "Grain output channels have invalid lengths."))
        true => Outcomes::carried (foldList (toList (range (0, length block.left)), Success(value = []), \(outcome, index) => interleave (block, outcome, index)), \samples => Success(value = listReverse samples))
