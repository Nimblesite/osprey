// [SYNTH-PERFORMANCE] UI-free bounded timbres for a preallocated host voice bank; the
// timbres themselves are mathematics: waves.ospml.
namespace synth

(** Phase-continuous performance kernels with normalized tone and ring-modulation controls. *)
module Performance
    timbre (instrument, phase, step, tone) = match instrument
        1 => Waves::bass (phase, step, tone)
        2 => Waves::hollow (phase, step, tone)
        3 => Waves::modulated (phase, tone)
        _ => Waves::glass (phase, step, tone)

    (** Ring modulation fades from the dry timbre to inharmonic metallic sidebands.
        Hosts supply a normalized phase, sub-Nyquist phase step and controls in [0, 1].
    # Examples
    ```osprey
    print "${Performance::wave (1, 0.0, 0.01, 0.5, 0.0)} ${Performance::wave (99, 0.0, 0.01, 0.5, 0.0)}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export wave (instrument, phase, step, tone, warp) = Waves::ring (timbre (instrument, phase, step, tone), phase, warp)
