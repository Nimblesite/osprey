// [SYNTH-ADVANCED-GRAINS-SCHEDULING] Scheduling is independent of source playback and UI.
namespace synth

(** Deterministic periodic, jittered or bounded exponential inter-onset scheduling. *)
module GrainScheduler
    valid clock = clock.position >= 0 && clock.nextOnset >= clock.position && GrainTimings::valid clock.timing && clock.seed >= 1 && clock.seed <= 2147483646

    (** Starts with an onset at position. Recreating the clock with the same seed resets the sequence.
    # Examples
    ```osprey
    print "${GrainScheduler::prepare (0, PeriodicTiming(period = 2400, jitter = 0), 1)} ${GrainScheduler::prepare (0, PeriodicTiming(period = 10, jitter = 10), 1)}"
    ```
    ```output
    Success({ position: 0, nextOnset: 0, timing: PeriodicTiming { period: 2400, jitter: 0 }, seed: 1 }) Error(InvalidConfiguration { detail: "Invalid grain clock, interval, jitter or seed." })
    ```
    *)
    export prepare (position, timing, seed) =
        clock = GrainClock(position = position, nextOnset = position, timing = timing, seed = seed)
        GrainTimings::accepted (valid clock, clock, InvalidConfiguration(detail = "Invalid grain clock, interval, jitter or seed."))

    continued (held, end) = match held.next.nextOnset >= end
        true =>
            clock = held.next
            Success(value = held(positions = listReverse held.positions, next = clock(position = end)))
        false => Outcomes::whole (GrainMath::nextSeed (toFloat held.next.seed), \seed => Outcomes::whole (GrainTimings::interval (held.next.timing, seed), \interval => onset (held, end, seed, interval)))

    onset (held, end, seed, interval) = match interval >= 1 && held.next.nextOnset <= satSub 9223372036854775807 interval
        false => Error(message = ExhaustedCapacity(detail = "The grain scheduler exhausted its onset clock."))
        true =>
            clock = held.next
            continued (held(positions = listPrepend held.positions clock.nextOnset, next = clock(nextOnset = satAdd clock.nextOnset interval, seed = seed)), end)

    (** Returns absolute onsets in [position, position + frames); at most one onset per sample. Retain the returned clock.
    # Examples
    ```osprey
    clock = GrainClock(position = 0, nextOnset = 0, timing = PeriodicTiming(period = 2, jitter = 0), seed = 1)
    print "${GrainScheduler::block (clock, 5)} ${GrainScheduler::block (clock, 0)}"
    ```
    ```output
    Success({ positions: [0, 2, 4], next: { position: 5, nextOnset: 6, timing: PeriodicTiming { period: 2, jitter: 0 }, seed: 1291394886 } }) Error(InvalidConfiguration { detail: "Invalid grain scheduler state or block size." })
    ```
    *)
    export block (clock, frames) = match valid clock && frames >= 1 && frames <= 2048 && clock.position <= satSub 9223372036854775807 frames
        false => Error(message = InvalidConfiguration(detail = "Invalid grain scheduler state or block size."))
        true => continued (GrainOnsets(positions = [], next = clock), satAdd clock.position frames)

    (** Map onsets to playback controls, or construct GrainEvents individually for independent distributions.
    # Examples
    ```osprey
    controls = GrainControls(window = HannWindow, start = 0.0, rate = 1.0, duration = 4800, amplitude = 0.5, pan = 0.0)
    print "${GrainScheduler::events ([3, 9], controls)}"
    ```
    ```output
    [{ position: 3, controls: { window: HannWindow, start: 0.0, rate: 1.0, duration: 4800, amplitude: 0.5, pan: 0.0 } }, { position: 9, controls: { window: HannWindow, start: 0.0, rate: 1.0, duration: 4800, amplitude: 0.5, pan: 0.0 } }]
    ```
    *)
    export events (positions, controls) = mapList (positions, \position => GrainEvent(position = position, controls = controls))

(** [SYNTH-ADVANCED-GRAINS-SCHEDULING] Causal pitch marks from a separate bipolar reference with one rising zero crossing per cycle. *)
module PitchMarks
    (** Start without a preceding negative sample; an initial nonnegative sample does not invent an onset.
    # Examples
    ```osprey
    print "${PitchMarks::prepare 0} ${PitchMarks::prepare (-1)}"
    ```
    ```output
    Success({ position: 0, belowZero: false }) Error(InvalidConfiguration { detail: "Invalid pitch reference sample position." })
    ```
    *)
    export prepare position = match position >= 0
        true => Success(value = PitchMarkClock(position = position, belowZero = false))
        false => Error(message = InvalidConfiguration(detail = "Invalid pitch reference sample position."))

    collect (outcome, sample) = match outcome
        Error why => Error(message = why)
        Success held => match sample >= -1.0 && sample <= 1.0
            false => Error(message = NumericalFailure(detail = "Pitch reference samples must be finite and normalised."))
            true =>
                clock = held.next
                positions = match clock.belowZero && sample >= 0.0
                    true => listPrepend held.positions clock.position
                    false => held.positions
                Success(value = PitchMarkBlock(positions = positions, next = PitchMarkClock(position = satAdd clock.position 1, belowZero = sample < 0.0)))

    (** Return absolute offsets for GrainScheduler.events. The first nonnegative sample owns a crossing, without lookahead.
    # Examples
    ```osprey
    clock = PitchMarkClock(position = 0, belowZero = false)
    print "${PitchMarks::block (clock, [-0.5, 0.5, -0.5, 0.5])} ${PitchMarks::block (clock, [])}"
    ```
    ```output
    Success({ positions: [1, 3], next: { position: 4, belowZero: false } }) Error(ExhaustedCapacity { detail: "Invalid pitch reference block or exhausted sample clock." })
    ```
    *)
    export block (clock, samples) = match length samples >= 1 && length samples <= 2048 && clock.position >= 0 && clock.position <= satSub 9223372036854775807 (length samples)
        false => Error(message = ExhaustedCapacity(detail = "Invalid pitch reference block or exhausted sample clock."))
        true => Outcomes::carried (foldList (samples, Success(value = PitchMarkBlock(positions = [], next = clock)), collect), \held => Success(value = held(positions = listReverse held.positions)))
