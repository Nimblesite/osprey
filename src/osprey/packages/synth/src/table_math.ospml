// Tables are built from harmonic spectra, so each mip level is exactly bandlimited to its
// harmonic count; reading between samples is linear interpolation, whose residual error is
// documented in the package README. Stiff-string inharmonicity follows Fletcher's
// `n * sqrt(1 + B n^2)`.
namespace synth

(** Wavetable and additive synthesis mathematics [SYNTH-ADVANCED-TABLES]. *)
module TableMath
    (** One harmonic of a periodic table at normalised `position` in `[0, 1)`. *)
    export harmonic (amplitude, number, phase, position) = amplitude * sin (6.283185307179586 * (number * position + phase))

    (** The highest whole harmonic below `0.45` of the sample rate at this fundamental. *)
    export harmonicLimit (frequency, sampleRate) = match abs frequency <= 0.0
        true => 1048576.0
        false => floor (floatDiv (0.45 * sampleRate, abs frequency))

    (** Partial gain near the upper limit: 1 below 0.4 of the rate, 0 from 0.45. *)
    export nyquistFade (frequency, sampleRate) =
        edge = floatDiv (abs frequency, sampleRate)
        match edge >= 0.45
            true => 0.0
            false => match edge <= 0.4
                true => 1.0
                false => (0.45 - edge) / 0.05

    (** A fractional partial count: partial `index` (from zero) fades in continuously. *)
    export countGain (count, index) = match count - index >= 1.0
        true => 1.0
        false => match count - index <= 0.0
            true => 0.0
            false => count - index

    (** Stiff-string ratio of 1-based partial `number`, with an optional stretch exponent. *)
    export stiffRatio (number, inharmonicity, stretch) = pow (number, stretch) * pow (1.0 + inharmonicity * number * number, 0.5)

    (** Spectral tilt: amplitude `number ^ -slope`. *)
    export tilt (number, slope) = pow (number, (-1.0) * slope)

    (** Odd/even balance: +1 removes even partials, -1 removes odd partials, 0 keeps both. *)
    export parity (number, balance) =
        even = 0.5 + 0.5 * cos (3.141592653589793 * number)
        match balance >= 0.0
            true => 1.0 - balance * even
            false => 1.0 + balance * (1.0 - even)

    (** Partial `number` reaches -60 dB after `decay / (1 + damping (number - 1))` seconds. *)
    export partialDecay (age, decay, damping, number, sampleRate) = pow (10.0, floatDiv ((-3.0) * age * (1.0 + damping * (number - 1.0)), decay * sampleRate))

    (** Peak-safe normalisation: divide by the summed gains only when they exceed one. *)
    export normalised (sum, gains, amplitude) = match gains <= 1.0
        true => amplitude * sum
        false => floatDiv (amplitude * sum, gains)

    (** Sine of a normalised phase. *)
    export sinePhase phase = sin (6.283185307179586 * phase)

    (** Classic spectra; even harmonics vanish exactly for square and triangle. *)
    export sineAmplitude number = match number == 1.0
        true => 1.0
        false => 0.0

    (** Fourier coefficient of a sawtooth partial. *)
    export sawAmplitude number = floatDiv (0.6366197723675814, number)

    (** Fourier coefficient of a square-wave partial. *)
    export squareAmplitude number = floatDiv (0.6366197723675814 * (1.0 - cos (3.141592653589793 * number)), number)

    (** Fourier coefficient of a triangle-wave partial. *)
    export triangleAmplitude number = floatDiv (0.8105694691387022 * cos (1.5707963267948966 * (number - 1.0)), number * number)

    (** Absolute value, used for peak and gain sums. *)
    export magnitude (value: float) = abs value

    (** Return the larger input. *)
    export larger (one: float, other) = match one > other
        true => one
        false => other

    (** Exponential pitch control: a normalised control maps to ±`octaves` around the base (0.5 = unchanged). *)
    export octaveScale (control, octaves) = pow (2.0, octaves * (2.0 * control - 1.0))
