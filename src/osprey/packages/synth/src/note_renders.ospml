// [SYNTH-ARRANGEMENT] One piano-roll note rendered by one advanced instrument, offline.
namespace synth

(** Each note renders into its own mono buffer. Plucked and bowed strings and operators sound for their gate
    plus a release; bells, mallets and drums are struck once and ring for their decay whatever the gate; a
    patch instrument plays the note through its own routed graph (`PatchVoices`).
    Every instrument's controls are checked by its own module, so a bad note is an explicit error. *)
module NoteRenders
    hertz note = Waves::midiFrequency (toFloat note.pitch)

    // Seconds of sound after the gate (sustained instruments) or in total (struck instruments).
    ring instrument = match instrument
        PluckInstrument _ _ => 0.3
        BowInstrument _ _ _ => 0.45
        BellInstrument decay _ => decay
        MalletInstrument decay _ => decay
        OperatorInstrument tone => tone.release
        DrumInstrument hit => hit.decay
        PatchInstrument routing => routing.release

    struck instrument = match instrument
        PluckInstrument _ _ => false
        BowInstrument _ _ _ => false
        OperatorInstrument _ => false
        PatchInstrument _ => false
        _ => true

    held (gate, instrument) = match struck instrument
        true => 0.0
        false => gate

    (** Gate and total frames for a note; the total is 1–960,000 frames. *)
    export span (note, tempo, rate, instrument) =
        gate = ArrangeMath::beatFrames (note.length, tempo, rate)
        match floatToInt (held (gate, instrument) + ArrangeMath::secondFrames (ring instrument, rate))
            Error _ => Error(message = "A note has a non-finite length.")
            Success total => match total >= 1 && total <= 960000
                false => Error(message = "A note must last 1 to 960000 frames including its ring.")
                true => Success(value = NoteSpan(gate = gate, total = total))

    (** A finished run's samples, or its fault as an error. *)
    export finished run = match run.fault == ""
        true => Success(value = run.samples)
        false => Error(message = run.fault)

    frames noteSpan = toList (range (0, noteSpan.total))

    // Run plumbing shared by every instrument: one appended sample, one faulted step, one folded note.
    ran (run, held, sample) = NoteRun(held = held, samples = listAppend run.samples sample, fault = "")

    stepped (run, next) = match run.fault == ""
        false => run
        true => match next
            Error why => run(fault = why)
            Success step => ran (run, step.next, step.sample)

    folded (noteSpan, held, step) = finished (foldList (frames noteSpan, NoteRun(held = held, samples = [], fault = ""), step))

    // Loop storage sized to the note's own period.
    loop (rate, note) = match floatToInt (ceil (rate / hertz note) + 8.0)
        Error _ => Error(message = "A note has a non-finite pitch.")
        Success capacity => Success(value = capacity)

    // Releasing a string damps it to a short decay instead of cutting it.
    damped (frame, gate, decay) = match toFloat frame >= gate
        true => 0.12
        false => decay

    string (note, noteSpan, rate, capacity, brightness, decay, frame) = WaveguideConfig(sampleRate = rate, frequency = hertz note, decay = damped (frame, noteSpan.gate, decay), brightness = brightness, dispersion = 0.0, pickup = 0.13, capacity = capacity)

    pick (note, capacity) = ExciterConfig(strength = note.velocity, duration = capacity, interval = 0, excitation = NoiseExcitation(colour = 0.7 * (1.0 - note.velocity)))

    pluckStep (note, noteSpan, rate, capacity, brightness, decay, run, frame) = match run.fault == ""
        false => run
        true =>
            burst = Exciters::next (pick (note, capacity), run.held.other)
            match Waveguides::next (string (note, noteSpan, rate, capacity, brightness, decay, frame), run.held.one, burst.sample)
                Error why => run(fault = why)
                Success step => ran (run, VoicePair(one = step.next, other = burst.next), step.sample)

    plucked (note, noteSpan, rate, capacity, brightness, decay) = match Waveguides::configure (string (note, noteSpan, rate, capacity, brightness, decay, 0))
        Error why => Error(message = why)
        Success config => match Waveguides::initial config
            Error why => Error(message = why)
            Success guide => match Exciters::configure (pick (note, capacity))
                Error why => Error(message = why)
                Success _ => folded (noteSpan, VoicePair(one = guide, other = Exciters::initial (satAdd note.pitch 1)), \(run, frame) => pluckStep (note, noteSpan, rate, capacity, brightness, decay, run, frame))

    bow (note, noteSpan, rate, capacity, pressure, brightness, depth, age) = BowConfig(sampleRate = rate, frequency = ArrangeMath::vibrato (hertz note, age, depth, rate), decay = 0.6, brightness = brightness, position = 0.12, pressure = pressure, velocity = 0.3 * note.velocity * ArrangeMath::gated (age, noteSpan.gate, 0.08 * rate, 0.1 * rate), capacity = capacity)

    bowed (note, noteSpan, rate, capacity, pressure, brightness, depth) = match BowedStrings::configure (bow (note, noteSpan, rate, capacity, pressure, brightness, depth, 0.0))
        Error why => Error(message = why)
        Success config => match depth >= 0.0 && depth <= 0.02
            false => Error(message = "Bow vibrato depth must be 0 to 0.02.")
            true => match BowedStrings::initial config
                Error why => Error(message = why)
                Success string => folded (noteSpan, string, \(run, frame) => stepped (run, BowedStrings::next (bow (note, noteSpan, rate, capacity, pressure, brightness, depth, toFloat frame), run.held)))

    impulse (strength, frame) = match frame == 0
        true => strength
        false => 0.0

    modal (note, noteSpan, rate, decay, brightness, modes) = match ModalBanks::configure (ModalConfig(sampleRate = rate, frequency = hertz note, decay = decay, brightness = brightness, strike = 0.37, count = 8, modes = modes))
        Error why => Error(message = why)
        Success bank => folded (noteSpan, ModalBanks::initial bank, \(run, frame) => stepped (run, ModalBanks::next (bank, run.held, impulse (note.velocity, frame))))

    voice (note, noteSpan, rate, tone, cents, age) = OperatorConfig(sampleRate = rate, frequency = ArrangeMath::detuned (hertz note, cents), shape = DistortedPhase(breakpoint = ArrangeMath::bloomed (tone.breakpoint, age, tone.bloom, rate)), depth = 0.0, spread = 0.0, feedback = tone.feedback, amplitude = 0.5 * note.velocity * ArrangeMath::gated (age, noteSpan.gate, tone.attack * rate, tone.release * rate))

    operatorStep (note, noteSpan, rate, tone, run, frame) =
        one = PhaseOperators::next (voice (note, noteSpan, rate, tone, tone.detune, toFloat frame), run.held.one, 0.0, 0.0)
        other = PhaseOperators::next (voice (note, noteSpan, rate, tone, 0.0 - tone.detune, toFloat frame), run.held.other, 0.0, 0.0)
        ran (run, VoicePair(one = one.next, other = other.next), one.sample + other.sample)

    toneValid tone = tone.attack >= 0.001 && tone.attack <= 10.0 && tone.release >= 0.001 && tone.release <= 10.0 && tone.bloom >= 0.001 && tone.bloom <= 10.0 && abs tone.detune <= 100.0

    operated (note, noteSpan, rate, tone) = match toneValid tone
        false => Error(message = "Operator attack, release and bloom must be 0.001 to 10 s and detune within 100 cents.")
        true => match PhaseOperators::configure (voice (note, noteSpan, rate, tone, abs tone.detune, 0.0))
            Error why => Error(message = why)
            Success _ => folded (noteSpan, VoicePair(one = PhaseOperators::initial, other = PhaseOperators::initial), \(run, frame) => operatorStep (note, noteSpan, rate, tone, run, frame))

    body (note, rate, hit, age) = OperatorConfig(sampleRate = rate, frequency = ArrangeMath::swept (hertz note, hit.sweep, age, rate), shape = PlainPhase, depth = 0.0, spread = 0.0, feedback = 0.0, amplitude = note.velocity * (1.0 - hit.noise) * ArrangeMath::ringing (age, hit.decay, rate))

    rattle (note, noteSpan, hit) = ExciterConfig(strength = note.velocity * hit.noise, duration = noteSpan.total, interval = 0, excitation = NoiseExcitation(colour = hit.colour))

    drumStep (note, noteSpan, rate, hit, run, frame) =
        tone = PhaseOperators::next (body (note, rate, hit, toFloat frame), run.held.one, 0.0, 0.0)
        burst = Exciters::next (rattle (note, noteSpan, hit), run.held.other)
        ran (run, VoicePair(one = tone.next, other = burst.next), tone.sample + burst.sample)

    drummed (note, noteSpan, rate, hit) = match hit.noise >= 0.0 && hit.noise <= 1.0 && hit.sweep >= 0.0 && hit.sweep <= 8.0 && hit.decay >= 0.01 && hit.decay <= 1.0
        false => Error(message = "Drum noise must be 0 to 1, sweep 0 to 8 and decay 0.01 to 1 s.")
        true => match PhaseOperators::configure (body (note, rate, hit, 0.0))
            Error why => Error(message = why)
            Success _ => match Exciters::configure (rattle (note, noteSpan, hit))
                Error why => Error(message = why)
                Success _ => folded (noteSpan, VoicePair(one = PhaseOperators::initial, other = Exciters::initial (satAdd note.pitch 1)), \(run, frame) => drumStep (note, noteSpan, rate, hit, run, frame))

    stringed (note, noteSpan, rate, instrument) = match loop (rate, note)
        Error why => Error(message = why)
        Success capacity => match instrument
            PluckInstrument brightness decay => plucked (note, noteSpan, rate, capacity, brightness, decay)
            BowInstrument pressure brightness depth => bowed (note, noteSpan, rate, capacity, pressure, brightness, depth)
            _ => Error(message = "Not a string instrument.")

    voiced (note, noteSpan, rate, instrument) = match instrument
        BellInstrument decay brightness => modal (note, noteSpan, rate, decay, brightness, BellModes)
        MalletInstrument decay brightness => modal (note, noteSpan, rate, decay, brightness, BarModes)
        OperatorInstrument tone => operated (note, noteSpan, rate, tone)
        DrumInstrument hit => drummed (note, noteSpan, rate, hit)
        PatchInstrument routing => PatchVoices::render (note, noteSpan, rate, routing)
        _ => stringed (note, noteSpan, rate, instrument)

    (** Render one note: pitch 0–127 (MIDI), velocity 0–1, positive length in beats. *)
    export render (note, tempo, rate, instrument) = match note.pitch >= 0 && note.pitch <= 127 && note.velocity >= 0.0 && note.velocity <= 1.0 && note.length > 0.0 && tempo >= 20.0 && tempo <= 400.0
        false => Error(message = "A note needs pitch 0 to 127, velocity 0 to 1, a positive length and a tempo of 20 to 400.")
        true => match span (note, tempo, rate, instrument)
            Error why => Error(message = why)
            Success noteSpan => voiced (note, noteSpan, rate, instrument)
