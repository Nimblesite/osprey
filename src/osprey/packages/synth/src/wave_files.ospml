// [SYNTH-PCM-FLOAT] Pure file encoding, independent of devices, UI and operating systems.
namespace synth

(** RIFF/WAVE encoding for reference previews and high-resolution rendered audio. *)
module WaveFiles
    (** The 8-bit reference preview shares byte/header primitives with float output.
    # Examples
    ```osprey
    print "${WaveFiles::mono8 (8000, [128, 130])}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export mono8 (rate, values) =
        count = length values
        odd = bitAnd count 1
        pad = match odd == 1
            true => "00"
            false => ""
        "52494646${PcmWords::le32 (satAdd (satAdd count odd) 36)}57415645666D7420${PcmWords::le32 16}${PcmWords::le16 1}${PcmWords::le16 1}${PcmWords::le32 rate}${PcmWords::le32 rate}${PcmWords::le16 1}${PcmWords::le16 8}64617461${PcmWords::le32 count}${join (mapList (values, PcmWords::byte)) ""}${pad}"

    finite value = value == value && abs value <= 1000000.0

    // IEEE float WAVEFORMATEX includes cbSize=0 and a fact chunk with sample count.
    floatHeader (rate, channels, count) = "52494646${PcmWords::le32 (satAdd 50 (satMul count 4))}57415645666D7420${PcmWords::le32 18}${PcmWords::le16 3}${PcmWords::le16 channels}${PcmWords::le32 rate}${PcmWords::le32 (satMul (satMul rate channels) 4)}${PcmWords::le16 (satMul channels 4)}${PcmWords::le16 32}${PcmWords::le16 0}66616374${PcmWords::le32 4}${PcmWords::le32 (intDiv count channels)}64617461${PcmWords::le32 (satMul count 4)}"

    (** Interleaved IEEE float32 WAV; channel alignment and all sample values are checked.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => WaveFiles::interleaved (48000, 1, [0.0]))} ${arithmetic (\() => WaveFiles::interleaved (4000, 1, [0.0]))} ${arithmetic (\() => WaveFiles::interleaved (48000, 2, [0.0]))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export interleaved (rate, channels, samples) = match rate >= 8000 && rate <= 384000 && channels >= 1 && channels <= 64 && length samples <= 1920000
        false => Error(message = MissingResource(detail = "Invalid WAV rate, channel count or sample count."))
        true => match satMul (intDiv (length samples) channels) channels == length samples && length (filterList (samples, finite)) == length samples
            false => Error(message = MissingResource(detail = "Invalid WAV channel alignment or non-finite/excessive sample."))
            true => Success(value = "${floatHeader (rate, channels, length samples)}${join (mapList (samples, PcmWords::float32)) ""}")

    (** Mono IEEE float32 WAV in hex, using the same interleaved encoder.
    # Examples
    ```osprey
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => WaveFiles::monoFloat (48000, [1.0]))}"
    ```
    ```output
    @@TODO@@
    ```
    *)
    export monoFloat (rate, samples) = interleaved (rate, 1, samples)
