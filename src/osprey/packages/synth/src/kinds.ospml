// [SYNTH-ADVANCED-CORE-MODELS] Stable component kinds and versions for patches, hosts and observers.
namespace synth

(** A kind names the algorithm, not the instance: instances are told apart by node identity and never
    share DSP state. A version increases whenever a kind's rendered output for the same parameters changes,
    so stored patches can detect and reject (or migrate) an incompatible module. *)
module Kinds
    (** Whether the module's frequency control tunes a pitched voice from the keyboard. *)
    export keyFrequency processor = match processor
        Oscillator => true
        TableOscillator _ => true
        Additive => true
        PhaseOperator => true
        Waveguide _ => true
        Bowed _ => true
        StrikeComb _ => true
        Resonator => true
        Modal => true
        _ => false

    (** The stable kind identifier of a processor. *)
    export kind processor = match processor
        SamplePlayer _ => "synth.sample"
        Granular _ _ _ => "synth.grain-cloud"
        Exciter _ => "synth.exciter"
        Resonator => "synth.resonator"
        Modal => "synth.modal-bank"
        Waveguide _ => "synth.waveguide"
        FractionalDelay _ => "synth.fractional-delay"
        LossFilter => "synth.loss-filter"
        Allpass => "synth.allpass"
        TableOscillator _ => "synth.wavetable"
        Additive => "synth.additive"
        Spectral _ _ => "synth.spectral"
        Shaper => "synth.shaper"
        Reverb => "synth.fdn-reverb"
        Shifter => "synth.frequency-shifter"
        PhaseOperator => "synth.phase-operator"
        Bowed _ => "synth.bowed-string"
        Smoother => "synth.smoother"
        StrikeComb _ => "synth.strike-comb"
        Lfo => "synth.lfo"
        ModulatedGain => "synth.modulated-gain"
        MidiNotes => "synth.midi-notes"
        Stereo => "synth.stereo"
        Panner => "synth.panner"
        Split => "synth.split"
        Join => "synth.join"
        Route _ => "synth.route"
        Downmix => "synth.downmix"
        Oscillator => "synth.oscillator"
        Filter => "synth.filter"
        Amplifier => "synth.gain"
        Mixer => "synth.mixer"
        Sink => "synth.output"
        Delay _ => "synth.delay"
        External identifier _ => "external:${identifier}"

    (** The algorithm version: 2 where output changed since the kind was introduced (coupled resonators
        and modal banks; spectral transforms returning typed results did not change output). *)
    export version processor = match processor
        Resonator => 2
        Modal => 2
        _ => 1

    (** Whether a stored kind/version pair can be loaded into this processor without changing its sound. *)
    export compatible (processor, storedKind, storedVersion) = kind processor == storedKind && version processor == storedVersion
