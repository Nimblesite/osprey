namespace synth

// Generated from typeDiagram [CONV-OSPREY].
type HostNote =
    kind : int
    offset : int
    pitch : int
    channel : int
    identity : int
    velocity : float

type HostParameter =
    identity : int
    offset : int
    value : float

type HostBlock =
    frames : int
    notes : List<HostNote>
    parameters : List<HostParameter>
    samples : List<float>

type HostLayout =
    inputChannels : int
    outputChannels : int
    acceptsNotes : bool

type HostControl =
    identity : int
    name : string
    initial : float
    automatable : bool

type HostDescriptor =
    latency : int
    identifier : string
    name : string
    inputChannels : int
    outputChannels : int
    notes : bool
    controls : List<HostControl>

type HostRendered =
    renderChannels : int
    renderFrames : int
    renderLatency : int
    renderSamples : List<float>

type NodeClip =
    clipNode : int
    clipChannels : int
    clipSamples : List<float>
    clipNotes : List<HostNote>

type ClipAction =
    ClipReady
        clips : List<NodeClip>
    ClipWaiting
        node : int
        request : HostBlock
        clips : List<NodeClip>

type ClipKernel K =
    heldKernel : K
    kernelSamples : List<float>

type NodeKernels K =
    kernelNode : int
    kernelMemory : K

type ParameterStamp =
    stampKey : string
    stampValue : float

type HostedStamp =
    stampNode : int
    stampControls : List<ParameterStamp>

type GraphState K =
    graphPosition : int
    graphHosted : List<HostedStamp>
    graphKernels : List<NodeKernels<K>>

type GraphPending G K =
    pendingGraph : G
    pendingState : GraphState<K>
    pendingClips : List<NodeClip>
    pendingFrames : int
    pendingNode : int

type BlockAction G K =
    BlockReady
        held : GraphState<K>
        clips : List<NodeClip>
    BlockWaiting
        request : HostBlock
        pending : GraphPending<G, K>
