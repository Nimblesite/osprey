// [SYNTH-ADVANCED-NONLINEAR] Single-sideband frequency shifting and ring modulation.
namespace synth

(** A polyphase IIR Hilbert pair (Niemitalo) gives ~90° separation from about 20 Hz to 0.47 of the rate;
    shifting moves every partial by the same hertz, so harmonic sounds become inharmonic. *)
module Shifters
    firstCoefficients = [0.6923878, 0.9360654322959, 0.9882295226860, 0.9987488452737]

    secondCoefficients = [0.4021921162426, 0.8561710882420, 0.9722909545651, 0.9952884791278]

    silentSection = HilbertSection(input = 0.0, older = 0.0, output = 0.0, oldest = 0.0)

    (** Silent allpass chains at carrier phase zero. *)
    export initial = ShifterState(first = [silentSection, silentSection, silentSection, silentSection], second = [silentSection, silentSection, silentSection, silentSection], delayed = 0.0, phase = 0.0)

    (** Shift −5,000–5,000 Hz (negative shifts down), ring selects plain multiplication, mix 0–1. *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 384000.0 && config.shift >= -5000.0 && config.shift <= 5000.0 && config.mix >= 0.0 && config.mix <= 1.0
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Invalid shifter rate, shift or mix."))

    // Section memory: input = x[n-1], older = x[n-2], output = y[n-1], oldest = y[n-2].
    section (coefficient, held, input) =
        value = NonlinearMath::hilbert (coefficient, input, held.older, held.oldest)
        HilbertSection(input = input, older = held.input, output = value, oldest = held.output)

    run (sections, coefficients, input, done) = match sections
        [] => done
        [held, ...rest] => match coefficients
            [] => done
            [coefficient, ...others] =>
                stepped = section (coefficient, held, input)
                run (rest, others, stepped.output, listAppend done stepped)

    last (sections, fallback) = foldList (sections, fallback, \(_value, s) => s.output)

    (** One sample: the in-phase path is delayed one sample to align with the quadrature path. *)
    export next (config, held, input) = match length held.first == 4 && length held.second == 4
        false => Error(message = IncompatibleLayout(detail = "Shifter state does not have two four-section chains."))
        true =>
            first = run (held.first, firstCoefficients, input, [])
            second = run (held.second, secondCoefficients, input, [])
            quadrature = last (second, 0.0)
            wet = match config.ring
                true => input * Waves::sine held.phase
                false => NonlinearMath::shifted (held.delayed, quadrature, held.phase)
            Success(value = ShifterSample(sample = Interpolation::linear (input, wet, config.mix), next = ShifterState(first = first, second = second, delayed = last (first, 0.0), phase = Waves::wrap (held.phase + config.shift / config.sampleRate))))
