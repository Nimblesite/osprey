// [SYNTH-ADVANCED-NONLINEAR] Four-line feedback-delay-network reverb with explicit stability and freeze policies.
namespace synth

(** Householder feedback (lossless) × per-line T60 gains (< 1) × one-pole damping (≤ 1) is always stable.
    Freeze sets every gain to one, bypasses damping and mutes the input, so stored energy is conserved. *)
module Reverbs
    // Mutually prime base lengths in samples at 48 kHz; size scales them.
    lengths = [1123, 1543, 1867, 2251]

    diffuserLengths = [142, 379]

    (** Size 0.25–2, decay 0.1–60 s, damping 0–0.95, diffusion 0–0.9, mix 0–1. *)
    export configure config = match config.sampleRate >= 8000.0 && config.sampleRate <= 192000.0 && config.size >= 0.25 && config.size <= 2.0 && config.decay >= 0.1 && config.decay <= 60.0 && config.damping >= 0.0 && config.damping <= 0.95 && config.diffusion >= 0.0 && config.diffusion <= 0.9 && config.mix >= 0.0 && config.mix <= 1.0
        true => Success(value = config)
        false => Error(message = "Invalid reverb rate, size, decay, damping, diffusion or mix.")

    scale config = config.size * config.sampleRate / 48000.0

    sized (config, outcome, length) = match outcome
        Error why => Error(message = why)
        Success built => match floatToInt (ceil (toFloat length * 2.0 * config.sampleRate / 48000.0) + 2.0)
            Error _ => Error(message = "Reverb line length is not finite.")
            Success count => Success(value = listAppend built count)

    (** Line capacities in samples (four feedback lines, then two diffusers), fixed per sample rate. *)
    export capacities config = foldList (listConcat lengths diffuserLengths, Success(value = []), \(outcome, length) => sized (config, outcome, length))

    prepared (outcome, count) = match outcome
        Error why => Error(message = why)
        Success built => match DelayLines::prepare count
            Error why => Error(message = why)
            Success line => Success(value = listAppend built line)

    (** Kernel storage at the 48 kHz graph rate: every line plus four damping states. *)
    export graphStorage () = foldList (listConcat lengths diffuserLengths, 4, \(total, length) => satAdd total (satAdd (satMul length 2) 2))

    (** Allocate lines for the largest size at this rate, so size edits never reallocate. *)
    export initial config = match capacities config
        Error why => Error(message = why)
        Success sizes => match foldList (sizes, Success(value = []), \(outcome, count) => prepared (outcome, count))
            Error why => Error(message = why)
            Success built => Success(value = ReverbState(lines = Sequences::take (built, 4), damped = [0.0, 0.0, 0.0, 0.0], diffusers = Sequences::drop (built, 4)))

    // Series Schroeder allpasses decorrelate the input before it enters the network.
    diffuse (config, held, input) = Diffusers::next (held.diffusers, mapList (diffuserLengths, \length => toFloat length * scale config), config.diffusion, input)

    tapped (config, remaining, sizes, done) = match remaining
        [] => Success(value = done)
        [line, ...rest] => match sizes
            [] => Error(message = "Reverb line lengths do not match.")
            [length, ...others] => match DelayLines::tap (line, toFloat length * scale config)
                Error why => Error(message = why)
                Success value => tapped (config, rest, others, listAppend done value)

    reads (config, held) = tapped (config, held.lines, lengths, [])

    gain (config, length) = match config.freeze
        true => 1.0
        false => PhysicalMath::decayGain (config.decay, toFloat length * scale config, config.sampleRate)

    damping config = match config.freeze
        true => 0.0
        false => config.damping

    injected (config, input) = match config.freeze
        true => 0.0
        false => 0.5 * input

    // Alternating output signs keep the Householder network's common mode from cancelling.
    output values = foldList (Sequences::mapIndexed (values, \(index, value) => value * (1.0 - 2.0 * toFloat (index % 2))), 0.0, \(sum, value) => sum + value) * 0.5

    networked (config, held, input, values, diffused) =
        damped = Sequences::combined (values, held.damped, \(value, previous) => NonlinearMath::damp (value, previous, damping config))
        products = Sequences::combined (damped, lengths, \(value, length) => value * gain (config, length))
        written = Sequences::combined (held.lines, FeedbackMatrices::householder products, \(line, value) => DelayLines::push (line, PhysicalMath::flushed (injected (config, diffused.sample) + value)))
        ReverbSample(sample = SpectralMath::blend (input, output values, config.mix), next = ReverbState(lines = written, damped = damped, diffusers = diffused.lines))

    (** One sample with an accepted configuration and a state from `initial` at the same rate. *)
    export next (config, held, input) = match length held.lines == 4 && length held.damped == 4 && length held.diffusers == 2
        false => Error(message = "Reverb state does not have four lines and two diffusers.")
        true => match diffuse (config, held, input)
            Error why => Error(message = why)
            Success diffused => match reads (config, held)
                Error why => Error(message = why)
                Success values => Success(value = networked (config, held, input, values, diffused))
