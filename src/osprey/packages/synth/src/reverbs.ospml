// [SYNTH-ADVANCED-NONLINEAR] Four-line feedback-delay-network reverb with explicit stability and freeze policies.
namespace synth

(** Householder feedback (lossless) × per-line T60 gains (< 1) × one-pole damping (≤ 1) is always stable.
    Freeze sets every gain to one, bypasses damping and mutes the input, so stored energy is conserved. *)
module Reverbs
    // Mutually prime base lengths in samples at 48 kHz; size scales them.
    lengths = [1123, 1543, 1867, 2251]

    diffuserLengths = [142, 379]

    within (low, value, high) = value >= low && value <= high

    (** Size 0.25–2, decay 0.1–60 s, damping 0–0.95, diffusion 0–0.9, mix 0–1.
    # Examples
    ```osprey
    config = ReverbConfig(sampleRate = 48000.0, size = 1.0, decay = 2.5, damping = 0.3, diffusion = 0.6, mix = 0.35, freeze = false)
    print "${Reverbs::configure config} ${Reverbs::configure (config(size = 3.0))}"
    ```
    ```output
    Success({ sampleRate: 48000.0, size: 1.0, decay: 2.5, damping: 0.3, diffusion: 0.6, mix: 0.35, freeze: false }) Error(InvalidConfiguration { detail: "Invalid reverb rate, size, decay, damping, diffusion or mix." })
    ```
    *)
    export configure config = match within (8000.0, config.sampleRate, 192000.0) && within (0.25, config.size, 2.0) && within (0.1, config.decay, 60.0) && within (0.0, config.damping, 0.95) && within (0.0, config.diffusion, 0.9) && within (0.0, config.mix, 1.0)
        true => Success(value = config)
        false => Error(message = InvalidConfiguration(detail = "Invalid reverb rate, size, decay, damping, diffusion or mix."))

    scale config = config.size * config.sampleRate / 48000.0

    stretched (config, length) = toFloat length * scale config

    // Folds items onto a growing Success list; an Error outcome is carried unchanged.
    collected (items, step) = foldList (items, Success(value = []), step)

    // One feedback line's capacity: twice its base length at this rate, plus two guard samples.
    capacity (config, built, length) = match floatToInt (ceil (toFloat length * 2.0 * config.sampleRate / 48000.0) + 2.0)
        Error _ => Error(message = NumericalFailure(detail = "Reverb line length is not finite."))
        Success count => Success(value = listAppend built count)

    sized (config, outcome, length) = Outcomes::carried (outcome, \built => capacity (config, built, length))

    (** Line capacities in samples (four feedback lines, then two diffusers), fixed per sample rate.
    # Examples
    ```osprey
    config = ReverbConfig(sampleRate = 48000.0, size = 1.0, decay = 2.5, damping = 0.3, diffusion = 0.6, mix = 0.35, freeze = false)
    print "${Reverbs::capacities config}"
    ```
    ```output
    Success([2248, 3088, 3736, 4504, 286, 760])
    ```
    *)
    export capacities config = collected (listConcat lengths diffuserLengths, \(outcome, length) => sized (config, outcome, length))

    prepared (outcome, count) = Outcomes::carried (outcome, \built => Outcomes::carried (DelayLines::prepare count, \line => Success(value = listAppend built line)))

    (** Kernel storage at the 48 kHz graph rate: every line plus four damping states.
    # Examples
    ```osprey
    print "${Reverbs::graphStorage ()}"
    ```
    ```output
    14626
    ```
    *)
    export graphStorage () = foldList (listConcat lengths diffuserLengths, 4, \(total, length) => satAdd total (satAdd (satMul length 2) 2))

    (** Allocate lines for the largest size at this rate, so size edits never reallocate.
    # Examples
    ```osprey
    config = ReverbConfig(sampleRate = 48000.0, size = 1.0, decay = 2.5, damping = 0.3, diffusion = 0.6, mix = 0.35, freeze = false)
    print "${listLength ((Reverbs::initial config ?: ReverbState(lines = [], damped = [], diffusers = [])).lines)}"
    ```
    ```output
    4
    ```
    *)
    export initial config = Outcomes::carried (capacities config, \sizes => Outcomes::carried (collected (sizes, prepared), \built => Success(value = ReverbState(lines = Sequences::take (built, 4), damped = [0.0, 0.0, 0.0, 0.0], diffusers = Sequences::drop (built, 4)))))

    // Series Schroeder allpasses decorrelate the input before it enters the network.
    diffuse (config, held, input) = Diffusers::next (held.diffusers, mapList (diffuserLengths, \length => stretched (config, length)), config.diffusion, input)

    tapped (config, remaining, sizes, done) = match remaining
        [] => Success(value = done)
        [line, ...rest] => match sizes
            [] => Error(message = IncompatibleLayout(detail = "Reverb line lengths do not match."))
            [length, ...others] => Outcomes::carried (DelayLines::tap (line, stretched (config, length)), \value => tapped (config, rest, others, listAppend done value))

    reads (config, held) = tapped (config, held.lines, lengths, [])

    gain (config, length) = match config.freeze
        true => 1.0
        false => PhysicalMath::decayGain (config.decay, stretched (config, length), config.sampleRate)

    damping config = match config.freeze
        true => 0.0
        false => config.damping

    injected (config, input) = match config.freeze
        true => 0.0
        false => 0.5 * input

    // Alternating output signs keep the Householder network's common mode from cancelling.
    output values = foldList (Sequences::mapIndexed (values, \(index, value) => value * (1.0 - 2.0 * toFloat (index % 2))), 0.0, \(sum, value) => sum + value) * 0.5

    networked (config, held, input, values, diffused) =
        damped = Sequences::combined (values, held.damped, \(value, previous) => NonlinearMath::damp (value, previous, damping config))
        products = Sequences::combined (damped, lengths, \(value, length) => value * gain (config, length))
        written = Sequences::combined (held.lines, FeedbackMatrices::householder products, \(line, value) => DelayLines::push (line, PhysicalMath::flushed (injected (config, diffused.sample) + value)))
        ReverbSample(sample = Interpolation::linear (input, output values, config.mix), next = ReverbState(lines = written, damped = damped, diffusers = diffused.lines))

    (** One sample with an accepted configuration and a state from `initial` at the same rate.
    # Examples
    ```osprey
    config = ReverbConfig(sampleRate = 48000.0, size = 1.0, decay = 2.5, damping = 0.3, diffusion = 0.6, mix = 0.35, freeze = false)
    arithmetic = handler Arith
        overflow _ _ _ wrapped => wrapped
        divideByZero _ _ => 0.0
        remainderByZero _ => 0
    print "${arithmetic (\() => Reverbs::next (config, ReverbState(lines = [], damped = [], diffusers = []), 0.0))}"
    ```
    ```output
    Error(IncompatibleLayout { detail: "Reverb state does not have four lines and two diffusers." })
    ```
    *)
    export next (config, held, input) = match length held.lines == 4 && length held.damped == 4 && length held.diffusers == 2
        false => Error(message = IncompatibleLayout(detail = "Reverb state does not have four lines and two diffusers."))
        true => Outcomes::carried (diffuse (config, held, input), \diffused => Outcomes::carried (reads (config, held), \values => Success(value = networked (config, held, input, values, diffused))))
