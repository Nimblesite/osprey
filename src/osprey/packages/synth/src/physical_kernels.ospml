// [SYNTH-ADVANCED-PHYSICAL-INTEGRATION] Graph adapters: physical primitives over the shared kernel state.
namespace synth

import synth::RenderInputs

(** Each adapter reads its declared parameters, runs the standalone module and stores its state. *)
module PhysicalKernels
    // Publishes one produced sample with its updated kernel state.
    published (frame, next, sample) = Success(value = RenderInputs::emitted (frame, next, sample))

    excitation (kind, colour) = Outcomes::chosen (kind, [ImpulseExcitation, NoiseExcitation(colour = colour)], "Excitation must be 0 (impulse) or 1 (noise).")

    exciterConfig (strength, duration, interval, kind, colour) = match excitation (kind, colour)
        Error why => Error(message = why)
        Success shape => match floatToInt duration
            Error _ => Error(message = InvalidConfiguration(detail = "Exciter duration must be a whole number of samples."))
            Success frames => match floatToInt interval
                Error _ => Error(message = InvalidConfiguration(detail = "Exciter interval must be a whole number of samples."))
                Success every => Exciters::configure (ExciterConfig(strength = strength, duration = frames, interval = every, excitation = shape))

    excitationSettings (snapshot, identity) = RenderInputs::setting (snapshot, identity, "strength", \strength => RenderInputs::setting (snapshot, identity, "duration", \duration => RenderInputs::setting (snapshot, identity, "interval", \interval => RenderInputs::setting (snapshot, identity, "excitation", \kind => RenderInputs::setting (snapshot, identity, "colour", \colour => exciterConfig (strength, duration, interval, kind, colour))))))

    (** Resolve the burst controls once when there are no automation events in this block. *)
    export prepareExciter (snapshot, identity) = match excitationSettings (snapshot, identity)
        Success config => FixedExciter(config = config)
        Error _ => LivePhysical

    excited (frame, held, config) =
        step = Exciters::next (config, ExciterState(age = held.phase, seed = held.integratorOne, smoothed = held.integratorTwo))
        published (frame, held(phase = step.next.age, integratorOne = step.next.seed, integratorTwo = step.next.smoothed), step.sample)

    (** Advance one burst sample, retaining its age, noise seed and colour filter. *)
    export excite (snapshot, frame, held, prepared) = match prepared
        FixedExciter config => excited (frame, held, config)
        _ => Outcomes::carried (excitationSettings (snapshot, held.identity), \config => excited (frame, held, config))

    rang (frame, held, step) = published (frame, held(integratorOne = step.next.real, integratorTwo = step.next.imag), step.sample)

    resonated (frame, held, input, configured) = Outcomes::carried (configured, \c => rang (frame, held, Resonators::next (c, ResonatorState(real = held.integratorOne, imag = held.integratorTwo), input)))

    scaled selector = Outcomes::chosen (selector, [PeakScale, ImpulseScale], "Response must be 0 (peak, band-pass) or 1 (impulse, struck).")

    responded (rate, frame, held, input, frequency, decay, gain, selector) = Outcomes::carried (scaled selector, \scale => resonated (frame, held, input, Resonators::configure (ResonatorConfig(sampleRate = rate, frequency = frequency, decay = decay, gain = gain, scale = scale))))

    resonator (rate, snapshot, frame, held, input) = RenderInputs::bound (snapshot, held, "frequency", \frequency => RenderInputs::bound (snapshot, held, "decay", \decay => RenderInputs::bound (snapshot, held, "gain", \gain => RenderInputs::bound (snapshot, held, "response", \selector => responded (rate, frame, held, input, frequency, decay, gain, selector)))))

    body selector = Outcomes::chosen (selector, [HarmonicModes, BarModes, MembraneModes, BellModes], "Body must be 0 string, 1 bar, 2 membrane or 3 bell.")

    playedBank (frame, held, input, config, bank, resonators) =
        Outcomes::carried (ModalBanks::next (bank, resonators, input), \step => published (frame, held(memory = ModalRunning(settings = config, bank = bank, resonators = step.next)), step.sample))

    modal (frame, held, input, config) = match held.memory
        KernelIdle => Outcomes::carried (ModalBanks::configure config, \bank => playedBank (frame, held, input, config, bank, ModalBanks::initial bank))
        ModalRunning previous bank resonators => match structuralEquals (previous, config)
            true => playedBank (frame, held, input, config, bank, resonators)
            false => Outcomes::carried (ModalBanks::configure config, \changed => playedBank (frame, held, input, config, changed, resonators))
        _ => Error(message = IncompatibleLayout(detail = "Modal bank requires resonator state."))

    bodied (selector, count, shape) = match body selector
        Error why => Error(message = why)
        Success modes => match floatToInt count
            Error _ => Error(message = InvalidConfiguration(detail = "Mode count must be a whole number."))
            Success whole => Success(value = shape (modes, whole))

    modalSettings (rate, snapshot, identity) = RenderInputs::setting (snapshot, identity, "body", \selector => RenderInputs::setting (snapshot, identity, "modes", \count => RenderInputs::setting (snapshot, identity, "frequency", \frequency => RenderInputs::setting (snapshot, identity, "decay", \decay => RenderInputs::setting (snapshot, identity, "brightness", \brightness => RenderInputs::setting (snapshot, identity, "strike", \strike => bodied (selector, count, \(modes, whole) => ModalConfig(sampleRate = rate, frequency = frequency, decay = decay, brightness = brightness, strike = strike, count = whole, modes = modes))))))))

    (** Resolve constant modal controls once per block, retaining the running resonator state. *)
    export prepareModal (rate, snapshot, identity) = match modalSettings (rate, snapshot, identity)
        Error _ => LivePhysical
        Success config => FixedModal(config = config)

    modalBank (rate, snapshot, frame, held, input, prepared) = match prepared
        FixedModal config => modal (frame, held, input, config)
        _ => Outcomes::carried (modalSettings (rate, snapshot, held.identity), \config => modal (frame, held, input, config))

    guideSettings (rate, snapshot, identity, capacity) = RenderInputs::setting (snapshot, identity, "frequency", \frequency => RenderInputs::setting (snapshot, identity, "decay", \decay => RenderInputs::setting (snapshot, identity, "brightness", \brightness => RenderInputs::setting (snapshot, identity, "dispersion", \dispersion => RenderInputs::setting (snapshot, identity, "pickup", \pickup => Waveguides::configure (WaveguideConfig(sampleRate = rate, frequency = frequency, decay = decay, brightness = brightness, dispersion = dispersion, pickup = pickup, capacity = capacity)))))))

    (** Prepare physical string tuning for a fixed snapshot. *)
    export prepare (rate, snapshot, identity, capacity) = match guideSettings (rate, snapshot, identity, capacity)
        Success config => FixedGuide(coefficients = Waveguides::coefficients config)
        Error _ => LivePhysical

    waveguide (rate, snapshot, frame, held, input, capacity, prepared) =
        voice = WaveguideState(line = DelayLine(samples = held.delay), loss = LossState(previous = held.integratorOne), dispersion = AllpassState(input = held.integratorTwo, output = held.phase))
        result = match prepared
            FixedGuide c => Waveguides::advance (c.tuning, c.pickup, c.attenuation, c.dispersion, voice, input)
            _ => Outcomes::carried (guideSettings (rate, snapshot, held.identity, capacity), \config => Waveguides::next (config, voice, input))
        Outcomes::carried (result, \step => published (frame, held(delay = step.next.line.samples, integratorOne = step.next.loss.previous, integratorTwo = step.next.dispersion.input, phase = step.next.dispersion.output), step.sample))

    delayed (frame, held, input, delay) = Outcomes::carried (DelayLines::tap (DelayLine(samples = held.delay), delay), \read => published (frame, held(delay = (DelayLines::push (DelayLine(samples = held.delay), input)).samples), read))

    fractional (snapshot, frame, held, input) = RenderInputs::bound (snapshot, held, "delay", \delay => delayed (frame, held, input, delay))

    filtered (frame, held, step) = published (frame, held(integratorOne = step.next.previous), step.sample)

    lost (frame, held, input, configured) = Outcomes::carried (configured, \config => filtered (frame, held, LossFilters::next (config, LossState(previous = held.integratorOne), input)))

    loss (snapshot, frame, held, input) = RenderInputs::bound (snapshot, held, "gain", \gain => RenderInputs::bound (snapshot, held, "brightness", \brightness => lost (frame, held, input, LossFilters::configure (LossConfig(gain = gain, brightness = brightness)))))

    phased (frame, held, step) = published (frame, held(integratorOne = step.next.input, integratorTwo = step.next.output), step.sample)

    allpassed (frame, held, input, configured) = Outcomes::carried (configured, \coefficient => phased (frame, held, Allpasses::next (coefficient, AllpassState(input = held.integratorOne, output = held.integratorTwo), input)))

    allpass (snapshot, frame, held, input) = RenderInputs::bound (snapshot, held, "coefficient", \value => allpassed (frame, held, input, Allpasses::configure value))

    (** Process one routed input sample; non-physical processors are an explicit error. *)
    export process (rate, snapshot, frame, held, n, input, guide) = match n.processor
        Resonator => resonator (rate, snapshot, frame, held, input)
        Modal => modalBank (rate, snapshot, frame, held, input, guide)
        Waveguide capacity => waveguide (rate, snapshot, frame, held, input, capacity, guide)
        FractionalDelay _ => fractional (snapshot, frame, held, input)
        LossFilter => loss (snapshot, frame, held, input)
        Allpass => allpass (snapshot, frame, held, input)
        Smoother => smoother (rate, snapshot, frame, held, input)
        StrikeComb capacity => strike (rate, snapshot, frame, held, input, capacity)
        _ => Error(message = InvalidConfiguration(detail = "Unsupported processor in the reference audio renderer."))

    eased (frame, held, step) = published (frame, held(integratorOne = step.next.value), step.sample)

    smoothed (rate, frame, held, input, time, mode) = Outcomes::carried (Smoothers::configure (SmootherConfig(sampleRate = rate, time = time, linear = mode >= 0.5)), \config => eased (frame, held, Smoothers::next (config, SmootherState(value = held.integratorOne), input)))

    smoother (rate, snapshot, frame, held, input) = RenderInputs::bound (snapshot, held, "time", \time => RenderInputs::bound (snapshot, held, "linear", \mode => smoothed (rate, frame, held, input, time, mode)))

    bowMemory (held, config) = match held.memory
        KernelIdle => BowedStrings::initial config
        BowRunning bow => Success(value = bow)
        _ => Error(message = IncompatibleLayout(detail = "Bowed string requires its two delay lines."))

    bowedStep (frame, held, configured) = match configured
        Error why => Error(message = why)
        Success config => Outcomes::carried (bowMemory (held, config), \bow => Outcomes::carried (BowedStrings::next (config, bow), \step => published (frame, held(memory = BowRunning(bow = step.next)), step.sample)))

    (** The neck and bridge keep their independent delay lines across samples. *)
    export bowed (rate, snapshot, frame, held, capacity) = RenderInputs::bound (snapshot, held, "frequency", \frequency => RenderInputs::bound (snapshot, held, "decay", \decay => RenderInputs::bound (snapshot, held, "brightness", \brightness => RenderInputs::bound (snapshot, held, "position", \position => RenderInputs::bound (snapshot, held, "pressure", \pressure => RenderInputs::bound (snapshot, held, "velocity", \velocity => bowedStep (frame, held, BowedStrings::configure (BowConfig(sampleRate = rate, frequency = frequency, decay = decay, brightness = brightness, position = position, pressure = pressure, velocity = velocity, capacity = capacity)))))))))

    struck (frame, held, input, configured) = match configured
        Error why => Error(message = why)
        Success config => Outcomes::carried (StrikeCombs::next (config, DelayLine(samples = held.delay), input), \step => published (frame, held(delay = step.next.samples), step.sample))

    strike (rate, snapshot, frame, held, input, capacity) = RenderInputs::bound (snapshot, held, "frequency", \frequency => RenderInputs::bound (snapshot, held, "position", \position => struck (frame, held, input, StrikeCombs::configure (StrikeConfig(sampleRate = rate, frequency = frequency, position = position, capacity = capacity)))))
