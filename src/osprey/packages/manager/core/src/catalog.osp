namespace registry;
import registry::Canonical
import registry::Identity
import registry::Json
import registry::Names
import registry::Order
import registry::Release

/// The catalog the folder-registry server builds from one root: every served
/// release in canonical order, lookup by digest and by package key, and the
/// canonical JSON views the API serves. Implements the endpoints of
/// [PACKAGE-FOLDER-REGISTRY] and the public-read views of [PACKAGE-API].
module Catalog {
    let unknownRelease = "catalog.unknown-release"
    let unknownPackage = "catalog.unknown-package"
    let okStatus = "ok"

    fn strings(items) = Json::Arr { items: mapList(items, Json::str) }
    fn text(members) = Canonical::serialize(Json::obj(members))

    fn missingId() = Identity::ReleaseId { key: Names::Key { scope: "", name: "" }, epoch: 0, ordinal: 0, digest: "" }
    fn missingServed() = Release::Served { id: missingId(), files: [] }
    fn servedAt(served, i) = listGet(served, i) ?: missingServed()

    fn servedDigest(s) = Identity::digestOf(Release::idOf(s))
    fn servedKey(s) = Identity::keyOf(Release::idOf(s))

    /// The `{"digest","epoch","ordinal"}` summary of one release.
    fn releaseMembers(id: Identity::ReleaseId) = [
        Json::member("digest", Json::str(id.digest)),
        Json::member("epoch", Json::num(id.epoch)),
        Json::member("ordinal", Json::num(id.ordinal))
    ]

    fn releaseValue(s) = Json::obj(releaseMembers(Release::idOf(s)))

    fn ordered(served) = {
        let idAt = fn(i) => Release::idOf(servedAt(served, i))
        mapList(Order::permutation(length(served), fn(i, j) => Identity::compare(idAt(i), idAt(j))), fn(i) => servedAt(served, i))
    }

    /// The catalog over one registry root: `served` ordered by key
    /// (`Names::compare`), then epoch, then ordinal; refusals as given.
    /// Implements [PACKAGE-FOLDER-REGISTRY].
    export fn of(served, refused) = Release::Catalog { served: ordered(served), refused: refused }

    /// The release whose digest is `digest`, or `"catalog.unknown-release"`.
    export fn byDigest(catalog, digest) = foldList(Release::servedOf(catalog), Error { message: unknownRelease }, fn(found, s) => match found {
        Success => found
        Error => if servedDigest(s) == digest { Success { value: s } } else { found }
    })

    /// Every release of one package key, in catalog order.
    export fn releasesOf(catalog, scope, name) = filterList(Release::servedOf(catalog), fn(s) => inPackage(s, scope, name))

    fn inPackage(s, scope, name) = {
        let key = servedKey(s)
        key.scope == scope && key.name == name
    }

    /// `{"refused":N,"releases":N,"status":"ok"}`. Implements [PACKAGE-API].
    export fn healthJson(catalog) = text([
        Json::member("refused", Json::num(length(Release::refusedOf(catalog)))),
        Json::member("releases", Json::num(length(Release::servedOf(catalog)))),
        Json::member("status", Json::str(okStatus))
    ])

    /// The distinct package keys of `served`, in canonical order.
    fn keysInOrder(served) = {
        let none: List<string> = []
        foldList(served, none, fn(seen, s) => {
            let display = Names::display(servedKey(s))
            if listContains(seen, display) { seen } else { listAppend(seen, display) }
        })
    }

    fn releasesFor(served, display) = filterList(served, fn(s) => Names::display(servedKey(s)) == display)

    fn packageValue(served, display) = Json::obj([
        Json::member("key", Json::str(display)),
        Json::member("releases", Json::arr(mapList(releasesFor(served, display), releaseValue)))
    ])

    /// `{"packages":[{"key":"@s/n","releases":[{"digest","epoch","ordinal"}]}]}`
    /// with keys in canonical order. Implements [PACKAGE-FOLDER-REGISTRY].
    export fn packagesJson(catalog) = {
        let served = Release::servedOf(catalog)
        text([Json::member("packages", Json::arr(mapList(keysInOrder(served), fn(d) => packageValue(served, d))))])
    }

    fn keyText(scope, name) = Names::display(Names::Key { scope: scope, name: name })

    /// `{"key":"@scope/name","releases":[{"digest","epoch","ordinal"}]}` for
    /// one package, or `"catalog.unknown-package"`. Implements
    /// [PACKAGE-FOLDER-REGISTRY].
    export fn packageJson(catalog, scope, name) = {
        let releases = releasesOf(catalog, scope, name)
        match isEmpty(releases) {
            true => Error { message: unknownPackage }
            false => text([
                Json::member("key", Json::str(keyText(scope, name))),
                Json::member("releases", Json::arr(mapList(releases, releaseValue)))
            ])
        }
    }

    fn pathOf(file) = file.relPath

    /// `{"digest","epoch","files":["path",…],"key","ordinal"}` of one served
    /// release, `files` in stored (path-sorted) order. Implements
    /// [PACKAGE-FOLDER-REGISTRY].
    export fn releaseJson(served) = text(listConcat(releaseMembers(Release::idOf(served)), [
        Json::member("files", strings(mapList(served.files, pathOf))),
        Json::member("key", Json::str(Names::display(Identity::keyOf(Release::idOf(served)))))
    ]))
}
