namespace registry;
import registry::Checked
import registry::Governance
import registry::Maybe

/// Administrator handover [PACKAGE-OWNERSHIP-ADMIN] as pure transitions: one
/// live proposal per package, a 24-hour hold, the recipient's fresh
/// acceptance, guarded atomic completion, and evidence retained for every
/// other outcome. No transition can produce a period with zero or two
/// administrators: each returns a whole registry whose package rows keep
/// exactly one admin reference, moved only by `finalizeHandover`.
module GovernanceHandover {
    let holdHours = 24
    let acceptanceWindowHours = 168

    /// The current administrator proposes one handover: their fresh proof,
    /// the exact current authority epoch, an active human same-org recipient
    /// other than themselves, and no live proposal already on the package.
    /// A proposal is only a proposal: it grants no rights and the admin
    /// reference does not move.
    export fn proposeHandover(registry, id, transferId, proposed, proof, now) =
        Checked::andThen(Governance::packageOf(registry, id), fn(pkg: Governance::Package) =>
            Checked::andThen(Governance::writable(pkg), fn(_) =>
                Checked::andThen(noLiveProposal(registry, id), fn(_) =>
                    Checked::andThen(recipient(registry, pkg, proposed), fn(_) =>
                        Checked::andThen(Governance::requireAdmin(registry, pkg, proof,
                            Governance::proposalStatement(pkg.key, pkg.authorityEpoch, pkg.admin, proposed)), fn(_) =>
                            Success { value: registry { transfers: listAppend(registry.transfers,
                                Governance::Transfer { id: transferId, package: id, current: pkg.admin, proposed: proposed,
                                    expectedEpoch: pkg.authorityEpoch, notBefore: now + holdHours,
                                    expiresAt: now + holdHours + acceptanceWindowHours,
                                    acceptance: Maybe::none(), status: Governance::Pending }) } })))))

    /// The proposed recipient's fresh acceptance [PACKAGE-OWNERSHIP-ADMIN],
    /// bound to this exact proposal by statement, membership and ceremony.
    /// Acceptance is still not administration: only the package's admin
    /// reference decides who administers.
    export fn acceptHandover(registry, transferId, proof) =
        Checked::andThen(Governance::transferOf(registry, transferId), fn(t: Governance::Transfer) =>
            Checked::andThen(liveTransfer(t), fn(_) =>
                Checked::andThen(Governance::membershipOf(registry, t.proposed), fn(m: Governance::Membership) =>
                    Checked::andThen(Governance::principalOf(registry, m.principal), fn(p: Governance::Principal) =>
                        Checked::andThen(liveAcceptingHuman(p, proof), fn(_) =>
                            Checked::andThen(Governance::packageOf(registry, t.package), fn(pkg: Governance::Package) =>
                                Checked::andThen(Governance::requireProof(proof, m.principal, t.proposed,
                                    Governance::handoverAcceptanceStatement(t.id, pkg.key, t.expectedEpoch, t.current, t.proposed)), fn(_) =>
                                    Success { value: Governance::replaceTransfer(registry,
                                        t { acceptance: Maybe::some(proof), status: Governance::Accepted }) })))))))

    /// Guarded atomic completion [PACKAGE-OWNERSHIP-ADMIN]: one update moves
    /// the single admin reference, increments the package authority epoch,
    /// revokes every grant — the outgoing admin's included — and completes
    /// the proposal. The new admin's permission set is afterwards their own
    /// explicit decisions; nothing is inherited. `decidedAt` is the
    /// handler's trusted clock [PACKAGE-HOSTED-BOUNDARY] and must land in the
    /// hold window; the expected admin and epoch must both still match, so a
    /// stale proposal can never replace a newer admin.
    export fn finalizeHandover(registry, transferId, decidedAt) =
        Checked::andThen(Governance::transferOf(registry, transferId), fn(t: Governance::Transfer) =>
            Checked::andThen(acceptedTransfer(t), fn(_) =>
                Checked::andThen(withinHold(t, decidedAt), fn(_) =>
                    Checked::andThen(Governance::packageOf(registry, t.package), fn(pkg: Governance::Package) =>
                        Checked::andThen(stillCurrent(t, pkg), fn(_) =>
                            Checked::andThen(Governance::writable(pkg), fn(_) =>
                                Success { value: completed(registry, pkg, t) })))))) 

    /// The current administrator cancels a live proposal; the evidence row stays.
    export fn cancelHandover(registry, transferId, proof) =
        Checked::andThen(Governance::transferOf(registry, transferId), fn(t: Governance::Transfer) =>
            Checked::andThen(liveTransfer(t), fn(_) =>
                Checked::andThen(Governance::packageOf(registry, t.package), fn(pkg: Governance::Package) =>
                    Checked::andThen(Governance::requireAdmin(registry, pkg, proof,
                        Governance::cancelStatement(transferId)), fn(_) =>
                        Success { value: Governance::replaceTransfer(registry, t { status: Governance::Cancelled }) }))))

    /// The intended recipient declines a live proposal; the evidence row stays.
    export fn declineHandover(registry, transferId, proof) =
        Checked::andThen(Governance::transferOf(registry, transferId), fn(t: Governance::Transfer) =>
            Checked::andThen(liveTransfer(t), fn(_) =>
                Checked::andThen(recipientPrincipal(registry, t.proposed), fn(actor) =>
                    Checked::andThen(Governance::requireProof(proof, actor, t.proposed,
                        Governance::declineStatement(transferId)), fn(_) =>
                        Success { value: Governance::replaceTransfer(registry, t { status: Governance::Declined }) }))))

    /// Mark a live proposal expired once its window has passed; the row
    /// stays as evidence and can never replace a newer admin.
    export fn expireHandover(registry, transferId, now) =
        Checked::andThen(Governance::transferOf(registry, transferId), fn(t: Governance::Transfer) =>
            Checked::andThen(liveTransfer(t), fn(_) =>
                match now > t.expiresAt {
                    true => Success { value: Governance::replaceTransfer(registry, t { status: Governance::Expired }) }
                    false => Error { message: "governance.transfer.not-expired" }
                }))

    /// The canonical 24-hour hold of [PACKAGE-OWNERSHIP-ADMIN].
    export fn hold() = holdHours

    fn recipientPrincipal(registry, id) =
        Checked::andThen(Governance::membershipOf(registry, id), fn(m: Governance::Membership) =>
            Checked::andThen(Governance::activeMemberOf(m), fn(_) =>
                Checked::andThen(Governance::principalOf(registry, m.principal), fn(p: Governance::Principal) =>
                    Checked::andThen(Governance::livePrincipal(p), fn(_) =>
                        Checked::andThen(Governance::humanPrincipal(p), fn(_) => Success { value: p.id })))))

    fn noLiveProposal(registry, id) = Governance::unique(id, Maybe::isPresent(Governance::liveTransferFor(registry, id)), "governance.transfer.pending-exists")

    fn recipient(registry, pkg: Governance::Package, proposed) = match proposed == pkg.admin {
        true => Error { message: "governance.recipient.self" }
        false => Checked::andThen(Governance::membershipOf(registry, proposed), fn(m: Governance::Membership) =>
            Checked::andThen(Governance::activeMemberOf(m), fn(_) =>
                Checked::andThen(Governance::sameOrgMember(m, pkg.org), fn(_) => Governance::humanMemberOf(registry, m))))
    }

    fn liveAcceptingHuman(p: Governance::Principal, proof) =
        Checked::andThen(Governance::livePrincipal(p), fn(_) =>
            Checked::andThen(Governance::humanPrincipal(p), fn(_) => Governance::requireHumanCeremony(proof)))

    fn liveTransfer(t: Governance::Transfer) = requiredTransfer(t, Governance::isLiveTransfer(t), "governance.transfer.not-pending")

    fn acceptedTransfer(t: Governance::Transfer) = requiredTransfer(t, Governance::isAcceptedTransfer(t), "governance.transfer.acceptance-missing")

    /// `t` when the proposal passes `flag`, else the refusal `code`.
    fn requiredTransfer(t: Governance::Transfer, flag, code) = if flag { Success { value: t } } else { Error { message: code } }

    fn withinHold(t: Governance::Transfer, decidedAt) = match decidedAt < t.notBefore {
        true => Error { message: "governance.transfer.hold" }
        false => match decidedAt > t.expiresAt {
            true => Error { message: "governance.transfer.expired" }
            false => Success { value: t }
        }
    }

    fn stillCurrent(t: Governance::Transfer, pkg: Governance::Package) = match pkg.admin == t.current {
        false => Error { message: "governance.transfer.stale-admin" }
        true => match pkg.authorityEpoch == t.expectedEpoch {
            false => Error { message: "governance.transfer.stale-epoch" }
            true => Success { value: t }
        }
    }

    fn completed(registry, pkg: Governance::Package, t: Governance::Transfer) = {
        let handedOver = Governance::replacePackage(registry,
            pkg { admin: t.proposed, authorityEpoch: pkg.authorityEpoch + 1 })
        let revoked = Governance::revokeGrantsOf(handedOver, t.package)
        Governance::replaceTransfer(revoked, t { status: Governance::Completed })
    }
}
