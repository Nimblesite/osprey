namespace registry;

/// One arithmetic policy for every registry program: an integer overflow or a
/// zero remainder is an integrity fault. It aborts the whole run through the
/// `Fatal` control effect instead of supplying a value, so a fault can never
/// pass as a wrong digest, ordinal or byte length.
module Policy {
    export effect Fatal {
        control abort: fn(string) -> int
    }

    let faultStatus = 70

    fn bailOut(message) = {
        print("Bail out! ${message}")
        faultStatus
    }

    /// Run `body` under the fatal policy and answer its status, or the fault status.
    export fn guarded(body) = {
        let fatal = handler Fatal {
            abort message => bailOut(message)
        }
        let arithmetic = handler Arith {
            overflow op lhs rhs _ => perform Fatal.abort("integer overflow: ${lhs} ${op} ${rhs}")
            remainderByZero lhs => perform Fatal.abort("remainder by zero: ${lhs} % 0")
        }
        fatal(fn() => arithmetic(body))
    }
}
