namespace registry;
import registry::Order

/// The ASCII relative POSIX path grammar of a canonical source tree: segments
/// of `[A-Za-z0-9._-]{1,128}` that are neither `.` nor `..`, at most 1,024
/// bytes in all, no absolute paths, backslashes, controls, trailing
/// separators, case-fold collisions or Windows device stems. Also the exact
/// control paths the digest projection excludes.
/// Implements [PACKAGE-SOURCE-CANONICAL].
module Paths {
    let maxPath = 1024
    let maxSegment = 128
    let devices = ["CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"]
    let excludedFiles = ["osprey.lock", "osprey.local.toml", "osprey.local.lock"]
    let statePrefix = ".osprey/"
    let manifestName = "osprey.toml"
    let legalStems = ["license", "copying", "notice", "authors", "third_party_notices"]
    let legalSuffixes = ["", ".txt", ".md"]

    fn alpha(b) = (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
    fn digit(b) = b >= 48 && b <= 57
    fn segmentByte(b) = alpha(b) || digit(b) || b == 46 || b == 95 || b == 45
    fn allSegmentBytes(s) = fold(range(0, byteLength(s)), true, fn(ok, i) => ok && segmentByte(byteAt(s, i) ?: 0))
    fn hasByte(s, p) = fold(range(0, byteLength(s)), false, fn(found, i) => found || p(byteAt(s, i) ?: 0))

    fn stem(segment) = match indexOf(segment, ".") {
        Success { value } => take(segment, value)
        Error => segment
    }

    fn deviceStem(segment) = listContains(devices, toUpperCase(stem(segment)))

    fn segmentCode(segment) = if segment == "" { "path.empty-segment" }
        else if segment == "." || segment == ".." { "path.dot-segment" }
        else if byteLength(segment) > maxSegment { "path.segment-length" }
        else if !allSegmentBytes(segment) { "path.segment-chars" }
        else if deviceStem(segment) { "path.device-stem" }
        else { "" }

    fn firstSegmentCode(segments) = foldList(segments, "", fn(code, segment) => if code == "" { segmentCode(segment) } else { code })

    fn shapeCode(path) = if path == "" { "path.empty" }
        else if startsWith(path, "/") { "path.absolute" }
        else if hasByte(path, fn(b) => b == 92) { "path.backslash" }
        else if hasByte(path, fn(b) => b < 32 || b == 127) { "path.control" }
        else if hasByte(path, fn(b) => b >= 128) { "path.non-ascii" }
        else if endsWith(path, "/") { "path.trailing-separator" }
        else if byteLength(path) > maxPath { "path.length" }
        else { firstSegmentCode(split(path, "/") ?: [path]) }

    /// The path itself when it satisfies the grammar, else its first reason code.
    export fn validate(path) = match shapeCode(path) {
        "" => Success { value: path }
        code => Error { message: code }
    }

    /// Lowercase ASCII fold used for collision detection.
    export fn foldCase(path) = toLowerCase(path)

    /// Sorted unique paths, rejecting exact duplicates and case-fold collisions.
    export fn canonicalSet(paths) = match Order::canonicalSet(paths) {
        Error => Error { message: "path.duplicate" }
        Success { value } => match Order::canonicalSet(mapList(value, foldCase)) {
            Success => Success { value: value }
            Error => Error { message: "path.case-collision" }
        }
    }

    /// True for the root control files and `.osprey/` state the digest excludes.
    export fn excluded(path) = listContains(excludedFiles, path) || startsWith(path, statePrefix)

    /// Generated tooling state is never publication input, even inside a source root.
    export fn generatedCache(path) = foldList(split(path, "/") ?: [path], false, fn(found, part) =>
        found || listContains([".deslop", ".osprey", ".git", "__pycache__"], toLowerCase(part)))

    fn legalDocument(path) = foldList(legalStems, false, fn(found, stem) => found
        || foldList(legalSuffixes, false, fn(matched, suffix) => matched || path == "${stem}${suffix}"))

    /// Retain supplied documents; never infer licenses from API references.
    /// Implements [PACKAGE-LICENSE-DISTRIBUTION].
    export fn publicationMetadata(path) = {
        let folded = foldCase(path)
        path == manifestName || legalDocument(folded) || startsWith(folded, "licenses/")
    }
}
