namespace registry;

/// SPDX license expressions as `[package].license` accepts them: license
/// identifiers (`Apache-2.0`, `MIT`, `GPL-3.0-or-later`, `LicenseRef-x`) with
/// an optional `+`, joined by `AND` / `OR` / `WITH` and grouped by
/// parentheses. The grammar is checked exactly; the identifier list is not
/// pinned here, so the registry's policy bundle decides acceptability.
/// Implements the license rule of [PACKAGE-MANIFEST].
module Spdx {
    let maxBytes = 256
    let operators = ["AND", "OR", "WITH"]

    fn idByte(b) = (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 46 || b == 45 || b == 43
    fn identifier(token) = byteLength(token) >= 1 && fold(range(0, byteLength(token)), true, fn(ok, i) => ok && idByte(byteAt(token, i) ?: 0))
        && !startsWith(token, "+") && (indexOf(drop(token, 0), "+") ?: byteLength(token)) >= wrapSub(byteLength(token), 1)

    fn spaced(text) = replace(replace(text, "(", " ( ") ?: text, ")", " ) ") ?: text

    fn tokens(text) = words(spaced(text))

    /// Walk tokens with (depth, expectOperand); -1 depth marks a failure.
    fn step(walk, token) = {
        let depth = listGet(walk, 0) ?: -1
        let expectOperand = (listGet(walk, 1) ?: 0) == 1
        if depth < 0 { walk }
        else if token == "(" { if expectOperand { [depth + 1, 1] } else { [-1, 0] } }
        else if token == ")" { if !expectOperand && depth > 0 { [depth - 1, 0] } else { [-1, 0] } }
        else if listContains(operators, token) { if !expectOperand { [depth, 1] } else { [-1, 0] } }
        else if identifier(token) { if expectOperand { [depth, 0] } else { [-1, 0] } }
        else { [-1, 0] }
    }

    /// The expression itself when well-formed, else `manifest.license`.
    export fn validate(text) = {
        let final = foldList(tokens(text), [0, 1], step)
        let ok = byteLength(text) <= maxBytes && (listGet(final, 0) ?: -1) == 0 && (listGet(final, 1) ?: 1) == 0
        if ok { Success { value: text } } else { Error { message: "manifest.license" } }
    }
}
