namespace registry;

/// The hosted governance domain: organizations, memberships, the single
/// package administrator, explicit per-package grants, authority epochs,
/// handover holds and freeze status, as pure typed transitions with stable
/// reason codes. Implements [PACKAGE-OWNERSHIP-MODEL], [PACKAGE-OWNERSHIP-ADMIN],
/// [PACKAGE-OWNERSHIP-PERMISSIONS] and [PACKAGE-OWNERSHIP-MAINTENANCE].
///
/// No cryptography lives here and none is imitated. Boundary authority
/// arrives only as `Proof` — the already-verified result of the host's
/// WebAuthn (human) or ephemeral DSSE (workflow) ceremony
/// ([PACKAGE-HOSTED-AUTH]). A transition re-checks the proof's actor,
/// membership, ceremony and exact canonical statement; supplied scope,
/// role or user text is never authority.
module Governance {
    /// Opaque stable id of a principal, a human or a workflow: never a handle or an email.
    export type PrincipalId = string
    /// Opaque stable id of an organization; its handle is a separate field.
    export type OrgId = string
    /// Opaque stable id of one principal's enrollment in one organization.
    export type MembershipId = string

    /// Whether an actor is a person or an automation such as CI.
    export type PrincipalKind = Human | Workflow
    /// Whether an actor may act now or is suspended; suspension freezes its administered packages at once.
    export type PrincipalState = PrincipalActive | Suspended
    /// One actor: its stable id, its kind and its lifecycle status.
    export type Principal = { id: PrincipalId, kind: PrincipalKind, status: PrincipalState }

    /// One organization: its id, its unique handle and the authority epoch its decisions are checked against.
    export type Organization = { id: OrgId, orgHandle: string, governanceEpoch: int }

    /// Whether a member governs the organization (custodian) or only belongs to it.
    export type MembershipRole = Custodian | Member
    /// Whether an enrollment is live or was revoked; a revoked row stays as evidence and is never reactivated.
    export type MembershipState = MemberActive | Revoked
    /// One principal's enrollment in one organization: its role, its state and the authority epoch its grants are captured at.
    export type Membership = { id: MembershipId, org: OrgId, principal: PrincipalId, role: MembershipRole, status: MembershipState, authorityEpoch: int }

    /// The grantable capabilities [PACKAGE-OWNERSHIP-PERMISSIONS]. There is
    /// no `admin`, no wildcard and no bundle: the administrator seat is the
    /// package row, not a permission.
    export type Permission = PublishRelease | YankRelease | EditMetadata | ManageMaintenance | ManageSecurity
    /// Whether a grant is live or was revoked; a revoked row stays as audit evidence.
    export type GrantState = GrantActive | GrantRevoked
    /// One explicit permission: the grantor gives one membership one permission on one package, bound to both authority epochs and an optional expiry.
    export type Grant = { id: string, package: string, membership: MembershipId, permission: Permission, grantor: MembershipId, packageEpoch: int, memberEpoch: int, expiresAt: Maybe::Maybe<int>, status: GrantState }

    /// The lifecycle of a package, from a draft with no accepted release to a tombstone whose key stays taken.
    export type PackageState = Draft | Active | WriteFrozen | Deprecated | Tombstoned
    /// One package: its id, canonical key, owning organization, single administrator membership, lifecycle status and authority epoch.
    export type Package = { id: string, key: Names::Key, org: OrgId, admin: MembershipId, status: PackageState, authorityEpoch: int }

    /// How a proof was signed: a person's WebAuthn ceremony or a workflow's ephemeral DSSE key.
    export type Ceremony = WebAuthn | EphemeralDsse
    /// The host's verdict on a proof: verified, or rejected with the reason.
    export type Verification = HostVerified | Rejected { reason: string }
    /// The already-verified proof of one decision: who signed which canonical statement, through which ceremony.
    export type Proof = { ceremony: Ceremony, actor: PrincipalId, membership: MembershipId, statement: string, verification: Verification }

    /// Where an administrator handover proposal stands; only pending and accepted proposals are live.
    export type TransferState = Pending | Accepted | Completed | Cancelled | Declined | Expired
    /// One administrator handover proposal: the package, the outgoing and proposed administrators, the epoch it expects, its hold window, the acceptance proof and its status.
    export type Transfer = { id: string, package: string, current: MembershipId, proposed: MembershipId, expectedEpoch: int, notBefore: int, expiresAt: int, acceptance: Maybe::Maybe<Proof>, status: TransferState }

    /// The whole governance world as row lists; every transition takes one and answers another.
    export type Registry = { principals: List<Principal>, organizations: List<Organization>, memberships: List<Membership>, packages: List<Package>, grants: List<Grant>, transfers: List<Transfer> }


    fn firstWhere(list, predicate) = foldList(list, Maybe::none(), fn(found, item) =>
        match Maybe::isPresent(found) {
            true => found
            false => if predicate(item) { Maybe::some(item) } else { found }
        })

    fn found(maybe, code) = Maybe::fold(maybe, Error { message: code }, fn(value) => Success { value: value })

    /// The row of `entries` matching `predicate`, or `code`.
    fn lookup(entries, predicate, code) = found(firstWhere(entries, predicate), code)

    /// `id` when nothing of its kind is already present, else `code`: the
    /// uniqueness guard of organization handles and live transfer proposals.
    export fn unique(id, present, code) = match present {
        true => Error { message: code }
        false => Success { value: id }
    }

    /// The row of `entries` whose `id` is `id`, or `code`. Every governance
    /// row carries the same `id` field (issue #273), so one lookup serves all.
    fn byId(entries, id, code) = lookup(entries, fn(row) => row.id == id, code)

    /// The principal with id `id`, or `governance.principal.missing`.
    export fn principalOf(registry, id) = byId(registry.principals, id, "governance.principal.missing")
    /// The organization with id `id`, or `governance.organization.missing`.
    export fn organizationOf(registry, id) = byId(registry.organizations, id, "governance.organization.missing")
    /// The membership with id `id`, or `governance.membership.missing`.
    export fn membershipOf(registry, id) = byId(registry.memberships, id, "governance.membership.missing")
    /// The package with id `id`, or `governance.package.missing`.
    export fn packageOf(registry, id) = byId(registry.packages, id, "governance.package.missing")
    /// The handover proposal with id `id`, or `governance.transfer.missing`.
    export fn transferOf(registry, id) = byId(registry.transfers, id, "governance.transfer.missing")
    /// The grant with id `id`, or `governance.grant.missing`.
    export fn grantOf(registry, id) = byId(registry.grants, id, "governance.grant.missing")

    /// The organization's package row for one leaf name, in any lifecycle
    /// status: tombstones keep occupying their key [PACKAGE-NAMES-NO-SITTING].
    export fn packageByName(registry, org, name) = firstWhere(registry.packages, fn(p: Package) => p.org == org && p.key.name == name)
    /// The organization whose handle is `orgHandle`, if any.
    export fn organizationByHandle(registry, orgHandle) = firstWhere(registry.organizations, fn(o: Organization) => o.orgHandle == orgHandle)

    /// Whether the membership is active rather than revoked.
    export fn isActive(membership: Membership) = membership.status == MemberActive

    /// Whether the member holds the custodian role.
    export fn isCustodian(membership: Membership) = membership.role == Custodian

    /// Whether the actor is a person rather than a workflow.
    export fn isHuman(principal: Principal) = principal.kind == Human

    /// Whether the actor is active rather than suspended.
    export fn isLive(principal: Principal) = principal.status == PrincipalActive

    /// A proposal that has not concluded: it still occupies the package's
    /// one live slot [PACKAGE-OWNERSHIP-ADMIN].
    export fn isLiveTransfer(transfer: Transfer) = transfer.status == Pending || transfer.status == Accepted

    /// A proposal the recipient has already accepted.
    export fn isAcceptedTransfer(transfer: Transfer) = transfer.status == Accepted

    /// A package that has not seen its first accepted release.
    export fn isDraft(pkg: Package) = pkg.status == Draft

    /// Whether the grant is active rather than revoked; expiry is checked separately against the clock.
    export fn isActiveGrant(grant: Grant) = grant.status == GrantActive

    /// The canonical hyphenated spelling of a permission, as statements and the API write it.
    export fn permissionName(permission) = match permission {
        PublishRelease => "publish-release"
        YankRelease => "yank-release"
        EditMetadata => "edit-metadata"
        ManageMaintenance => "manage-maintenance"
        ManageSecurity => "manage-security"
    }

    /// Permission equality by canonical name.
    export fn samePermission(a, b) = permissionName(a) == permissionName(b)

    /// `value` when `flag` holds, else the refusal `code`: the one guard
    /// step every transition chains with `use`.
    /// # Examples
    /// ```osprey
    /// let kept = required(true, 7, "governance.example.refused")
    /// let refused = required(false, 7, "governance.example.refused")
    /// ```
    export fn required(flag, value, code) = if flag { Success { value: value } } else { Error { message: code } }

    /// The membership when it is active, else `governance.membership.inactive`.
    export fn activeMemberOf(membership: Membership) = required(isActive(membership), membership, "governance.membership.inactive")

    /// The membership when it belongs to `org`, else `governance.membership.other-org`.
    export fn sameOrgMember(membership: Membership, org) = required(membership.org == org, membership, "governance.membership.other-org")

    /// The principal when it is a person, else `governance.principal.workflow`.
    export fn humanPrincipal(principal: Principal) = required(isHuman(principal), principal, "governance.principal.workflow")

    /// The principal when it is active, else `governance.principal.suspended`.
    export fn livePrincipal(principal: Principal) = required(isLive(principal), principal, "governance.principal.suspended")

    /// The principal when it is both active and a person; the suspension refusal is reported first.
    export fn liveHuman(principal: Principal) = andThen(livePrincipal(principal), fn(p) => humanPrincipal(p))

    /// The active membership with id `id`, or its missing or inactive refusal.
    export fn activeMembershipOf(registry, id) = andThen(membershipOf(registry, id), fn(m) => activeMemberOf(m))

    /// The live human principal behind a membership: the actor every
    /// organizational decision is signed by.
    export fn humanMemberOf(registry, m: Membership) = andThen(principalOf(registry, m.principal), fn(p) => humanPrincipal(p))

    /// Package writes need a writable lifecycle status
    /// [PACKAGE-OWNERSHIP-MAINTENANCE]; each refusal names its status.
    export fn writable(pkg: Package) = match pkg.status {
        Draft | Active => Success { value: pkg }
        _ => Error { message: refusalCode(pkg.status) }
    }

    /// The package with id `id` when its status allows writes, or its missing or status refusal.
    export fn writablePackage(registry, id) = andThen(packageOf(registry, id), fn(pkg) => writable(pkg))

    /// Operational authorization needs an active package: a draft has no
    /// releases, and frozen, deprecated and tombstoned packages refuse
    /// operations with their own reason codes.
    export fn operational(pkg: Package) = match pkg.status {
        Active => Success { value: pkg }
        _ => Error { message: refusalCode(pkg.status) }
    }

    /// The reason code of a lifecycle status that refuses a write; both
    /// callers above match every status they admit before asking.
    fn refusalCode(status) = match status {
        WriteFrozen => "governance.package.frozen"
        Deprecated => "governance.package.deprecated"
        Tombstoned => "governance.package.tombstoned"
        _ => "governance.package.draft"
    }

    /// Demand one exact verified proof: the host ceremony accepted it, it
    /// was performed by `membership`/`actor`, and it signs exactly
    /// `statement`. A refused proof, another actor or another statement is
    /// never authority.
    export fn requireProof(proof, actor, membership, statement) = match proof.verification {
        Rejected { reason } => Error { message: "governance.proof.rejected:${reason}" }
        HostVerified => match proof.membership == membership {
            false => Error { message: "governance.proof.wrong-membership" }
            true => match proof.actor == actor {
                false => Error { message: "governance.proof.wrong-actor" }
                true => match proof.statement == statement {
                    false => Error { message: "governance.proof.statement-mismatch" }
                    true => Success { value: proof }
                }
            }
        }
    }

    /// Human control acts are signed through WebAuthn; a workflow DSSE proof
    /// is never organizational authority [PACKAGE-OWNERSHIP-PERMISSIONS].
    export fn requireHumanCeremony(proof) = match proof.ceremony {
        WebAuthn => Success { value: proof }
        EphemeralDsse => Error { message: "governance.proof.ceremony" }
    }

    /// The exact current package administrator's fresh human proof for
    /// `statement` [PACKAGE-OWNERSHIP-ADMIN]: an active human membership that
    /// is exactly the package's single admin reference. Custodians, members,
    /// other organizations' admins and workflows all fail here.
    export fn requireAdmin(registry, pkg: Package, proof, statement) = match proof.membership == pkg.admin {
        false => Error { message: "governance.admin.not-current" }
        true => {
            use m <- andThen(membershipOf(registry, proof.membership))
            use _ <- andThen(activeMemberOf(m))
            use p <- andThen(principalOf(registry, m.principal))
            use _ <- andThen(livePrincipal(p))
            use _ <- andThen(humanPrincipal(p))
            use _ <- andThen(requireHumanCeremony(proof))
            requireProof(proof, m.principal, m.id, statement)
        }
    }

    /// The canonical statements every proof signs. A statement binds the
    /// whole decision — identities, epochs, permission and expiry — so a
    /// proof for one decision can never authorize another.
    export fn organizationStatement(id, orgHandle, founder) = "create-organization|${id}|@${orgHandle}|first-custodian:${founder}"
    /// The statement a custodian grant signs: the organization and the membership promoted.
    export fn custodianStatement(org, target) = "grant-custodianship|org:${org}|to:${target}"
    /// The statement a revocation signs: the organization and the membership revoked.
    export fn revocationStatement(org, target) = "revoke-membership|org:${org}|membership:${target}"
    /// The statement an invitation signs: the organization, the invited principal and the new membership.
    export fn invitationStatement(org, principal, membership) = "invite-member|org:${org}|principal:${principal}|membership:${membership}"
    /// The statement a membership acceptance signs: the organization, the principal and the membership.
    export fn membershipAcceptanceStatement(org, principal, membership) = "accept-membership|org:${org}|principal:${principal}|membership:${membership}"
    /// The statement a package creation signs: the package id, its canonical key and the nominated administrator.
    export fn creationStatement(id, key: Names::Key, admin) = "create-package|${id}|${Names::display(key)}|admin:${admin}"
    /// The statement a grant signs: key, package epoch, recipient membership, permission and expiry (0 when none).
    export fn grantStatement(key: Names::Key, epoch, to, permission, expiresAt) = "grant|${Names::display(key)}|epoch:${epoch}|to:${to}|${permissionName(permission)}|expires:${Maybe::orElse(expiresAt, 0)}"
    /// The statement a grant revocation signs: key, package epoch and the grant revoked.
    export fn revokeGrantStatement(key: Names::Key, epoch, grant) = "revoke-grant|${Names::display(key)}|epoch:${epoch}|grant:${grant}"
    /// The statement revoking every grant of a package signs: key and package epoch.
    export fn revokeAllStatement(key: Names::Key, epoch) = "revoke-grants|${Names::display(key)}|epoch:${epoch}"
    /// The statement a grant renewal signs: key, package epoch, recipient membership, permission and the new expiry (0 when none).
    export fn renewalStatement(key: Names::Key, epoch, to, permission, expiresAt) = "renew-grant|${Names::display(key)}|epoch:${epoch}|to:${to}|${permissionName(permission)}|expires:${Maybe::orElse(expiresAt, 0)}"
    /// The statement deprecating a package signs: key and package epoch.
    export fn deprecateStatement(key: Names::Key, epoch) = "deprecate|${Names::display(key)}|epoch:${epoch}"
    /// The statement tombstoning a package signs: key and package epoch.
    export fn tombstoneStatement(key: Names::Key, epoch) = "tombstone|${Names::display(key)}|epoch:${epoch}"
    /// The statement a handover proposal signs: key, package epoch, outgoing and proposed administrators.
    export fn proposalStatement(key: Names::Key, epoch, current, proposed) = "handover-propose|${Names::display(key)}|epoch:${epoch}|from:${current}|to:${proposed}"
    /// The statement a handover acceptance signs: proposal id, key, package epoch, outgoing and proposed administrators.
    export fn handoverAcceptanceStatement(id, key: Names::Key, epoch, current, proposed) = "handover-accept|${id}|${Names::display(key)}|epoch:${epoch}|from:${current}|to:${proposed}"
    /// The statement cancelling handover proposal `id` signs.
    export fn cancelStatement(id) = "handover-cancel|${id}"
    /// The statement declining handover proposal `id` signs.
    export fn declineStatement(id) = "handover-decline|${id}"

    /// `rows` with `updated` in place of the row of the same id; a missing id changes nothing.
    fn swapped(rows, updated) = mapList(rows, fn(row) => if row.id == updated.id { updated } else { row })

    /// Replace one row in place; historical evidence rows are never deleted.
    export fn replaceMembership(registry, updated: Membership) = registry { memberships: swapped(registry.memberships, updated) }
    /// The registry with `updated` in place of the package of the same id; a missing id changes nothing.
    export fn replacePackage(registry, updated: Package) = registry { packages: swapped(registry.packages, updated) }
    /// The registry with `updated` in place of the grant of the same id; a missing id changes nothing.
    export fn replaceGrant(registry, updated: Grant) = registry { grants: swapped(registry.grants, updated) }
    /// The registry with `updated` in place of the handover proposal of the same id; a missing id changes nothing.
    export fn replaceTransfer(registry, updated: Transfer) = registry { transfers: swapped(registry.transfers, updated) }

    /// Revoke every grant row of one package, the outgoing administrator's
    /// included [PACKAGE-OWNERSHIP-ADMIN]; the rows stay as audit evidence.
    export fn revokeGrantsOf(registry, id) = registry { grants: mapList(registry.grants, fn(g: Grant) => if g.package == id { g { status: GrantRevoked } } else { g }) }

    /// The live (pending or accepted) handover proposal of one package, if any.
    export fn liveTransferFor(registry, id) = firstWhere(registry.transfers, fn(t) => t.package == id && isLiveTransfer(t))
}
