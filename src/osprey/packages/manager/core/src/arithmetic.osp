namespace registry;
import registry::Policy

/// Canonical integer arithmetic for scores: unsigned basis points where
/// 10,000 is 100.00, round-half-up division, bounded ramps, ratios, weighted
/// means and percentiles. Floating point never appears. A domain violation
/// (negative numerator, non-positive divisor, inverted ramp) is a programming
/// fault and aborts through `Policy::Fatal` instead of yielding a number.
/// Implements [PACKAGE-EVIDENCE-ARITHMETIC].
module Arithmetic {
    export type Weighted = { weight: int, value: int }

    let full = 10000
    let hundredths = 100
    let dayMilliseconds = 86400000

    fn fault(code) = perform Policy::Fatal.abort(code)

    /// `floor((n + floor(d / 2)) / d)` for `n >= 0` and `d > 0`.
    export fn roundDiv(n, d) = if n < 0 || d <= 0 { fault("arith.round-div-domain") }
        else { intDiv(n + intDiv(d, 2), d) }

    /// `sign(n) * roundDiv(abs(n), d)`.
    export fn signedRoundDiv(n, d) = if n < 0 { 0 - roundDiv(0 - n, d) } else { roundDiv(n, d) }

    /// `min(hi, max(lo, x))`.
    export fn clamp(x, lo, hi) = if x < lo { lo } else if x > hi { hi } else { x }

    /// 0 at or below `bad`, 10,000 at or above `good`, linear between; needs `good > bad`.
    export fn higher(x, bad, good) = if good <= bad { fault("arith.higher-domain") }
        else if x <= bad { 0 }
        else if x >= good { full }
        else { roundDiv(full * (x - bad), good - bad) }

    /// `10,000 - higher(x, good, bad)`; needs `bad > good`.
    export fn lower(x, good, bad) = full - higher(x, good, bad)

    /// `min(10,000, roundDiv(10,000 * n, d))`.
    export fn ratio(n, d) = clamp(roundDiv(full * n, d), 0, full)

    /// `roundDiv(sum(weight * value), sum(weight))` over a non-empty list.
    export fn weighted(values) = {
        let numerator = foldList(values, 0, fn(acc, v) => acc + v.weight * v.value)
        let denominator = foldList(values, 0, fn(acc, v) => acc + v.weight)
        roundDiv(numerator, denominator)
    }

    /// Zero-based index `ceil(p * count / 100) - 1` of percentile `p` in `count` items.
    export fn percentileIndex(p, count) = if count <= 0 || p <= 0 || p > 100 { fault("arith.percentile-domain") }
        else { intDiv(p * count + 99, 100) - 1 }

    /// The `p`th percentile of durations sorted ascending; `Error` when empty.
    /// `listSort` rather than `Order::sortBy`: a second instantiation of that
    /// generic sort inside this namespace trips issue #278 today.
    export fn percentile(p, durations) = match length(durations) {
        0 => Error { message: "evidence.unknown" }
        count => listGet(listSort(durations), percentileIndex(p, count))
    }

    /// Whole days in a non-negative millisecond duration, rounded up.
    export fn ceilDays(milliseconds) = if milliseconds < 0 { fault("arith.duration-domain") }
        else { intDiv(milliseconds + dayMilliseconds - 1, dayMilliseconds) }

    fn twoDigits(n) = if n < 10 { "0${n}" } else { "${n}" }

    /// `WW.FF` for basis points.
    export fn display(score) = "${intDiv(score, hundredths)}.${twoDigits(score % hundredths)}"

    /// The basis-point scale.
    export fn fullScale() = full
}
