namespace registry;

/// Byte sequences are `List<int>` with every element in 0..255. Osprey strings
/// end at their first NUL byte, so binary envelopes never travel as strings.
/// Implements the `u32be`/`u64be`/hex encodings of [PACKAGE-SOURCE-CANONICAL]
/// and the digest spelling of [PACKAGE-TYPE-INVARIANTS].
module Bytes {
    let hexDigits = "0123456789abcdef"
    let byteRange = 256
    let wordRange = 4294967296
    let runWindow = 256

    fn at(s, i) = match byteAt(s, i) {
        Success { value } => value
        Error => 0
    }

    /// The raw bytes of a string, in order. `at` matches instead of using `?:`
    /// because `?:` inside a million-iteration pipeline crashes the runtime
    /// today (probe `runtime.default-operator-pipeline` in `src/osprey/packages/manager/blockers`).
    export fn ofString(s) = range(0, byteLength(s)) |> map(fn(i) => at(s, i)) |> toList

    fn windowEnd(text, i) = if i + runWindow < byteLength(text) { i + runWindow } else { byteLength(text) }

    /// The end of the run of bytes of `text` satisfying `keep` that starts at
    /// `i`, looking at most 256 bytes ahead. Recursive scanners consume one
    /// run per call, so a long string costs a stack frame per window rather
    /// than per byte: Osprey does not guarantee tail calls, and per-byte
    /// recursion overflows the stack near 6,000 bytes.
    export fn runEnd(text, i, keep) = fold(range(i, windowEnd(text, i)), i, fn(end, k) =>
        if end == k && keep(at(text, k)) { k + 1 } else { end })

    /// Four big-endian bytes of a value in 0..2^32-1.
    export fn u32be(n) = [
        intDiv(n, 16777216) % byteRange,
        intDiv(n, 65536) % byteRange,
        intDiv(n, 256) % byteRange,
        n % byteRange
    ]

    /// Eight big-endian bytes of a non-negative value.
    export fn u64be(n) = listConcat(u32be(intDiv(n, wordRange)), u32be(n % wordRange))

    fn hexDigit(nibble) = substring(hexDigits, nibble, nibble + 1) ?: ""

    /// `text` up to its first `separator`, or all of it when there is none.
    export fn before(text, separator) = match indexOf(text, separator) {
        Success { value } => take(text, value)
        Error => text
    }

    /// Two lowercase hex digits of one byte.
    export fn hexByte(b) = hexDigit(intDiv(b, 16) % 16) + hexDigit(b % 16)

    /// Lowercase hex of a byte sequence.
    export fn hex(bytes) = join(mapList(bytes, hexByte), "")

    fn hexValue(b) = if b >= 48 && b <= 57 { b - 48 } else if b >= 97 && b <= 102 { b - 87 } else { 0 }

    fn hexPair(hex, i) = hexValue(at(hex, 2 * i)) * 16 + hexValue(at(hex, 2 * i + 1))

    /// The bytes of lowercase hex text; a non-hex digit reads as zero, so
    /// callers validate untrusted hex first (`Digests::parse`).
    export fn fromHex(hex) = range(0, intDiv(byteLength(hex), 2)) |> map(fn(i) => hexPair(hex, i)) |> toList

    fn lowerHexDigit(b) = (b >= 48 && b <= 57) || (b >= 97 && b <= 102)

    /// True when every byte of `text` from `from` up to `to` is a lowercase
    /// hex digit, the spelling of digests and UUIDs ([PACKAGE-TYPE-INVARIANTS]).
    export fn lowerHexBetween(text, from, to) = fold(range(from, to), true, fn(ok, i) => ok && lowerHexDigit(at(text, i)))

    /// Concatenation of several byte sequences, in order.
    export fn concatAll(parts) = foldList(parts, [], fn(acc, part) => listConcat(acc, part))

    let upperA = 65
    let upperZ = 90
    let lowerA = 97
    let lowerZ = 122
    let digit0 = 48
    let digit9 = 57

    /// ASCII `A`-`Z` or `a`-`z`.
    export fn isLetter(b) = (b >= upperA && b <= upperZ) || (b >= lowerA && b <= lowerZ)

    /// ASCII `0`-`9`.
    export fn isDigit(b) = b >= digit0 && b <= digit9

    /// ASCII letter or digit.
    export fn isAlnum(b) = isLetter(b) || isDigit(b)

    /// ASCII `a`-`z`.
    export fn isLower(b) = b >= lowerA && b <= lowerZ

    /// ASCII lowercase letter or digit: the unadorned identifier byte.
    export fn isLowerDigit(b) = isLower(b) || isDigit(b)

    /// The punctuation bytes the identifier rules of the manifests, paths,
    /// paths inside a registry release and database references admit.
    export let plus = 43
    export let hyphen = 45
    export let dot = 46
    export let slash = 47
    export let underscore = 95
    export let tilde = 126

    /// ASCII letter or digit, or one of the punctuation bytes `extra`.
    export fn isAlnumIn(b, extra) = isAlnum(b) || listContains(extra, b)

    /// ASCII lowercase letter or digit, or one of the punctuation bytes `extra`.
    export fn isLowerDigitIn(b, extra) = isLowerDigit(b) || listContains(extra, b)

    /// True when every byte of `text` satisfies `ok` (the empty text does).
    export fn everyByte(text, ok) = fold(range(0, byteLength(text)), true, fn(good, i) => good && ok(at(text, i)))

    /// True when any byte of `text` satisfies `ok` (the empty text does not).
    export fn anyByte(text, ok) = fold(range(0, byteLength(text)), false, fn(found, i) => found || ok(at(text, i)))

    /// One pass of a substitution: the text written so far and the index just
    /// after the last replaced byte.
    export type Substitution = { out: string, start: int }

    /// `text` from byte `from` up to `to`.
    export fn between(text, from, to) = take(drop(text, from), to - from)

    fn substitutedAt(text, replace, acc: Substitution, i) = match replace(at(text, i)) {
        "" => acc
        replacement => Substitution { out: acc.out + between(text, acc.start, i) + replacement, start: i + 1 }
    }

    /// `text` with every byte `replace` answers for substituted, in one pass;
    /// `replace` answers `""` for the bytes kept verbatim.
    export fn substitute(text, replace) = {
        let scanned = fold(range(0, byteLength(text)), Substitution { out: "", start: 0 }, fn(acc, i) => substitutedAt(text, replace, acc, i))
        scanned.out + between(text, scanned.start, byteLength(text))
    }

    /// True when every element is a byte.
    export fn wellFormed(bytes) = foldList(bytes, true, fn(ok, b) => ok && b >= 0 && b < byteRange)
}
