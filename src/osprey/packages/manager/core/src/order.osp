namespace registry;

/// Canonical ordering and set-like list rules shared by every serialized form:
/// unsigned byte order for strings, stable sorting, and duplicate detection.
/// Implements the list rules of [PACKAGE-TYPE-INVARIANTS].
///
/// Every export is monomorphic. An exported generic function is instantiated
/// at one type per program when it is called from another file (the cross-file
/// form of issue #277), so the sorts here return a permutation of indexes and
/// each caller gathers its own elements.
module Order {
    let indexWidth = 10

    /// Unsigned lexicographic byte comparison: negative, zero or positive.
    /// Annotated so the export stays at `string` (issue #277).
    export fn compareStrings(a: string, b: string) = if a == b { 0 } else if a < b { -1 } else { 1 }

    /// Integer comparison: negative, zero or positive.
    export fn compareInts(a: int, b: int) = if a == b { 0 } else if a < b { -1 } else { 1 }

    /// The first non-zero comparison, so tuple orders compose.
    export fn thenCompare(first, next) = if first == 0 { next } else { first }

    fn intSlice(xs, from, to) = range(from, to) |> map(fn(i) => listGet(xs, i) ?: 0) |> toList

    fn mergeStep(left, right, less, out) = {
        let l = listGet(left, 0) ?: 0
        let r = listGet(right, 0) ?: 0
        match less(l, r) {
            true => merge(intSlice(left, 1, length(left)), right, less, listAppend(out, l))
            false => merge(left, intSlice(right, 1, length(right)), less, listAppend(out, r))
        }
    }

    fn merge(left, right, less, out) = match isEmpty(left) || isEmpty(right) {
        true => listConcat(listConcat(out, left), right)
        false => mergeStep(left, right, less, out)
    }

    fn sortIndexes(idx, less) = match length(idx) < 2 {
        true => idx
        false => {
            let mid = intDiv(length(idx), 2)
            merge(sortIndexes(intSlice(idx, 0, mid), less), sortIndexes(intSlice(idx, mid, length(idx)), less), less, [])
        }
    }

    /// The stable sorting permutation of `count` elements under
    /// `compare(i, j)`, a comparison of the elements at indexes `i` and `j`
    /// returning negative, zero or positive.
    export fn permutation(count, compare) = sortIndexes(range(0, count) |> toList, fn(i, j) => compare(i, j) <= 0)

    /// A non-negative integer as a fixed-width decimal key: byte order of
    /// keys is numeric order for values below 10^10.
    export fn intKey(i) = (repeat("0", indexWidth - byteLength("${i}")) ?: "") + "${i}"

    fn tagged(keys) = range(0, length(keys)) |> map(fn(i) => (listGet(keys, i) ?: "") + " " + intKey(i)) |> toList

    fn tagIndex(tag) = parseInt(drop(tag, byteLength(tag) - indexWidth)) ?: 0

    /// The stable sorting permutation of `keys` by unsigned bytes. Keys must
    /// hold only bytes above space. Built on the builtin `listSort`.
    export fn sortedIndexes(keys) = mapList(listSort(tagged(keys)), tagIndex)

    /// True when every adjacent pair of a sorted string list is strictly ascending.
    export fn strictlyAscending(sorted) = fold(range(1, length(sorted)), true, fn(ok, i) =>
        ok && compareStrings(listGet(sorted, wrapSub(i, 1)) ?: "", listGet(sorted, i) ?: "") < 0)

    /// Sorted and duplicate-free, or `"list.duplicate"`, for a set of strings.
    export fn canonicalSet(xs) = {
        let sorted = listSort(xs)
        match strictlyAscending(sorted) {
            true => Success { value: sorted }
            false => Error { message: "list.duplicate" }
        }
    }
}
