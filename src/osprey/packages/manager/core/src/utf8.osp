namespace registry;

/// UTF-8 well-formedness over a string's bytes: correct lead/continuation
/// shapes, no overlongs, no surrogates, nothing above U+10FFFF, and the
/// optional control-character ban that summaries and documentation need.
/// Implements the text rules of [PACKAGE-PUBLISH] and [PACKAGE-DISCOVERY-INTENT].
module Utf8 {
    fn at(s, i) = byteAt(s, i) ?: -1
    fn continuation(b) = b >= 128 && b <= 191

    /// Expected sequence length from a lead byte, or 0 when it cannot lead.
    fn width(b) = if b >= 0 && b <= 127 { 1 }
        else if b >= 194 && b <= 223 { 2 }
        else if b >= 224 && b <= 239 { 3 }
        else if b >= 240 && b <= 244 { 4 }
        else { 0 }

    fn secondOk(lead, second) = continuation(second)
        && !(lead == 224 && second < 160)
        && !(lead == 237 && second > 159)
        && !(lead == 240 && second < 144)
        && !(lead == 244 && second > 143)

    fn tailOk(s, i, w) = if w == 1 { true }
        else { secondOk(at(s, i), at(s, i + 1)) && (w < 3 || continuation(at(s, i + 2))) && (w < 4 || continuation(at(s, i + 3))) }

    fn step(s, i, w) = w > 0 && i + w <= byteLength(s) && tailOk(s, i, w) && scan(s, i + w)

    fn scan(s, i) = i >= byteLength(s) || step(s, i, width(at(s, i)))

    /// True when every byte sequence is well-formed UTF-8.
    export fn wellFormed(s) = scan(s, 0)

    /// True when no byte is a C0 control or DEL; NUL cannot occur in a string.
    export fn noControls(s) = fold(range(0, byteLength(s)), true, fn(ok, i) => ok && at(s, i) >= 32 && at(s, i) != 127)
}
