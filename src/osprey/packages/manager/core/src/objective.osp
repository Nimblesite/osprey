namespace registry;
import registry::Arithmetic
import registry::Identity
import registry::Names
import registry::Order

/// The resolver's lexicographic objective: per-candidate signed integer cost
/// facts and the graph tuple `(sum V, sum D, sum U, sum E, changedIdentities,
/// nonRootPackageCount + systemInputCount, sum L)`, minimized component by
/// component, with the canonical package and system tie-breaks. Every
/// time-dependent term is evaluated at the signed catalog `asOf`.
/// Implements the cost facts of [PACKAGE-RESOLUTION].
module Objective {
    export type Cost = { vulnerability: int, overdue: int, unknown: int, evidence: int, changed: int, size: int, lag: int }
    export type Advisory = { severityWeight: int, reachabilityFactor: int, overdueMilliseconds: int }
    export type SystemTuple = { capability: string, provider: string, revision: int, digest: string }

    let scale = 10000
    let maxOverdueDays = 3650

    /// `roundDiv(severityWeight * reachabilityFactor, 10,000)` for one advisory.
    export fn advisoryCost(advisory) = Arithmetic::roundDiv(advisory.severityWeight * advisory.reachabilityFactor, scale)

    /// `V(r)`: the sum over non-blocking advisories.
    export fn vulnerability(advisories) = foldList(advisories, 0, fn(acc, a) => acc + advisoryCost(a))

    /// `(overdueMilliseconds + 86,399,999) div 86,400,000`, capped at 3,650 days.
    export fn overdueDays(milliseconds) = Arithmetic::clamp(Arithmetic::ceilDays(milliseconds), 0, maxOverdueDays)

    /// `D(r)`: each advisory's cost times its capped overdue days.
    export fn overdue(advisories) = foldList(advisories, 0, fn(acc, a) => acc + advisoryCost(a) * overdueDays(a.overdueMilliseconds))

    /// `L(r) = M - ordinal` for the greatest eligible ordinal `M`.
    export fn lag(greatestOrdinal, ordinal) = greatestOrdinal - ordinal

    /// The cost of a fixed local node: every component zero.
    export fn zero() = Cost { vulnerability: 0, overdue: 0, unknown: 0, evidence: 0, changed: 0, size: 0, lag: 0 }

    /// Component-wise sum of two graph costs.
    export fn add(a, b) = Cost {
        vulnerability: a.vulnerability + b.vulnerability,
        overdue: a.overdue + b.overdue,
        unknown: a.unknown + b.unknown,
        evidence: a.evidence + b.evidence,
        changed: a.changed + b.changed,
        size: a.size + b.size,
        lag: a.lag + b.lag
    }

    /// Lexicographic order of the objective tuple: smaller is better.
    export fn compare(a, b) = Order::thenCompare(Order::compareInts(a.vulnerability, b.vulnerability),
        Order::thenCompare(Order::compareInts(a.overdue, b.overdue),
            Order::thenCompare(Order::compareInts(a.unknown, b.unknown),
                Order::thenCompare(Order::compareInts(a.evidence, b.evidence),
                    Order::thenCompare(Order::compareInts(a.changed, b.changed),
                        Order::thenCompare(Order::compareInts(a.size, b.size), Order::compareInts(a.lag, b.lag)))))))

    // `ReleaseId` and `SystemTuple` share `digest`; issue #273 needs the receivers spelled out.
    /// Tie-break for package nodes: `(key, epoch, ordinal DESC, digest)`.
    export fn comparePackageTie(a: Identity::ReleaseId, b: Identity::ReleaseId) = Order::thenCompare(Names::compare(a.key, b.key),
        Order::thenCompare(Order::compareInts(a.epoch, b.epoch),
            Order::thenCompare(Order::compareInts(b.ordinal, a.ordinal), Order::compareStrings(a.digest, b.digest))))

    /// Tie-break for system inputs: `(capability, provider, revision, digest)`.
    export fn compareSystemTie(a: SystemTuple, b: SystemTuple) = Order::thenCompare(Order::compareStrings(a.capability, b.capability),
        Order::thenCompare(Order::compareStrings(a.provider, b.provider),
            Order::thenCompare(Order::compareInts(a.revision, b.revision), Order::compareStrings(a.digest, b.digest))))
}
