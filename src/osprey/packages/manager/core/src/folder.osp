namespace registry;
import registry::Release
import registry::Source

/// Groups the files found under a folder-registry root into release
/// directories `@scope/name/<epoch>.<ordinal>`. Pure: the walk itself is a
/// host effect. Implements the catalog walk of [PACKAGE-FOLDER-REGISTRY].
module Folder {
    /// A release directory and its files, relative to that directory, sorted.
    export type Pending = { releaseDir: string, relPaths: List<string> }

    /// Every release directory to assemble and every one refused before reading.
    export type Plan = { pending: List<Pending>, refused: List<Release::Refused> }

    let releaseDepth = 3
    let straySegments = "release-path.segments"


    fn segmentsOf(path) = split(path, "/") ?: [path]

    /// The release directory holding `path`, or `""` for a file outside one.
    export fn releaseDirOf(path) = {
        let parts = segmentsOf(path)
        if length(parts) <= releaseDepth { "" }
        else { join(range(0, releaseDepth) |> map(fn(i) => listGet(parts, i) ?: "") |> toList, "/") }
    }

    /// `path` relative to its release directory.
    export fn withinRelease(path) = drop(path, byteLength(releaseDirOf(path)) + 1)

    fn refusal(path, code) = {
        let dir = releaseDirOf(path)
        Release::Refused { dir: if dir == "" { path } else { dir }, code: code }
    }

    fn refusals(regular, executable, special) = listConcat(listConcat(
        mapList(filterList(regular, fn(p) => releaseDirOf(p) == ""), fn(p) => refusal(p, straySegments)),
        mapList(executable, fn(p) => refusal(p, Source::kindCode("executable")))),
        mapList(special, fn(p) => refusal(p, Source::kindCode("special"))))

    // `Release::Refused` and `Pending` both carry a directory; the receiver is
    // annotated for issue #273.
    fn refusedDir(r: Release::Refused) = r.dir

    fn filesIn(groups, dir) = match mapGet(groups, dir) {
        Success { value } => value
        Error => {
            // Typed: an untyped `[]` here, or `mapGet(m, k) ?: []`, fails
            // codegen ("match arms disagree on type") today.
            let none: List<string> = []
            none
        }
    }

    fn grouped(paths) = foldList(paths, Map(), fn(m, p) => mapSet(m, releaseDirOf(p), listAppend(filesIn(m, releaseDirOf(p)), withinRelease(p))))

    fn pendingOf(groups, dirs) = mapList(dirs, fn(d) => Pending { releaseDir: d, relPaths: listSort(filesIn(groups, d)) })

    /// The plan for one walk: regular files grouped by release directory,
    /// minus every directory holding an executable, special or stray entry.
    export fn plan(regular, executable, special) = {
        let refused = refusals(regular, executable, special)
        let blocked = mapList(refused, refusedDir)
        let inside = filterList(regular, fn(p) => releaseDirOf(p) != "" && !listContains(blocked, releaseDirOf(p)))
        let groups = grouped(inside)
        Plan { pending: pendingOf(groups, listSort(mapKeys(groups))), refused: refused }
    }
}
