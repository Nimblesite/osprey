namespace registry;
import registry::SatClauses
import registry::SatSearch

/// The complete, deterministic propositional core under [PACKAGE-RESOLUTION]:
/// a CDCL solver whose models and refutations the package resolver treats as
/// ground truth. Variables are ints 1..variableCount; a literal is `v` for
/// positive and `-v` for negative; a formula is a list of clauses. Identical
/// input always yields an identical outcome byte for byte.
module Sat {
    /// `Satisfiable` carries the canonical model: one literal per variable
    /// 1..n in ascending variable order. `Unsatisfiable` carries `core`, the
    /// ascending 0-based indexes of input clauses behind the final conflict
    /// (plus assumption references, see `assume`), and `learned`, the proof
    /// trace of derived clauses in order, each spelled with literals sorted
    /// by absolute value.
    export type Outcome = Satisfiable { model: List<int> } | Unsatisfiable { core: List<int>, learned: List<List<int>> }

    fn solveOn(vars, clauses, assumptions) = match SatClauses::wellFormed(vars, listConcat(clauses, [assumptions])) {
        false => Error { message: "sat.bad-literal" }
        true => match SatSearch::search(vars, clauses, assumptions) {
            SatSearch::Sat { model } => Success { value: Satisfiable { model: model } }
            SatSearch::Unsat { core, learned } => Success { value: Unsatisfiable { core: core, learned: learned } }
        }
    }

    /// Decide `clauses` over variables 1..variableCount. An input clause with
    /// no literals is not an error: the formula is immediately unsatisfiable
    /// with that clause alone as the core.
    export fn solve(variableCount, clauses) = solveOn(variableCount, clauses, [])

    /// Decide `clauses` with each assumption literal forced true before the
    /// search, as permanent level-0 units. When the outcome is
    /// unsatisfiable, the core may reference assumption `i` as the negative
    /// index `-(i+1)` alongside input clause indexes; replaying the core
    /// means taking those input clauses and the referenced assumptions.
    export fn assume(variableCount, clauses, assumptions) = solveOn(variableCount, clauses, assumptions)

    /// Oracle: every clause has a true literal under the model, the check a
    /// resolver or test applies to a returned model.
    export fn check(model, clauses) = SatClauses::satisfiedBy(model, clauses)
}
