namespace hosted_tests;
import registry::Policy
import registry_host::Native

/// Request admission and native listener isolation [PACKAGE-HOSTED-EDGE].
fn suites() = {
    HeaderTests::run()
    CookieTests::run()
    OriginTests::run()
    RequestTests::run()
    ListenerTests::run()
    0
}

fn main() = Policy::guarded(fn() => Native::process()(suites))
