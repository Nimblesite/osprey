namespace registry_auth_tests;
import registry::Bytes
import registry::Hmac

/// HMAC-SHA256 against the RFC 4231 vector, and GitHub webhook signatures
/// over the exact raw body and algorithm.
module WebhookTests {
    fn vector() = check("RFC 4231 HMAC-SHA256 case one", "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7", Bytes::hex(Hmac::sha256(mapList(range(0, 20) |> toList, fn(_i) => 11), Bytes::ofString("Hi There"))))

    fn signed() = {
        let signingSecret = "fixture-secret"
        let revokedBody = "{\"action\":\"revoked\"}"
        let digestHeader = "sha256=" + Bytes::hex(Hmac::sha256(Bytes::ofString(signingSecret), Bytes::ofString(revokedBody)))
        checkAll("GitHub signature covers exact raw body and exact algorithm", [
                Hmac::github(signingSecret, revokedBody, digestHeader),
                !Hmac::github("other-secret", revokedBody, digestHeader),
                !Hmac::github(signingSecret, "{\"action\":\"revoked\"}\n", digestHeader),
                !Hmac::github(signingSecret, revokedBody, "sha1=" + drop(digestHeader, 7)),
                !Hmac::github("", revokedBody, digestHeader),
                !Hmac::github(signingSecret, revokedBody, "sha256=not-hex")
        ])
    }

    /// Known-answer cryptography and byte-exact webhook signature checks.
    export fn run() = {
        test("auth: HMAC SHA256 standard vector", vector)
        test("auth: raw GitHub webhook signature", signed)
    }
}
