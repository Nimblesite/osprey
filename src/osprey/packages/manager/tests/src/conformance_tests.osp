namespace registry_tests;
import registry::Conformance
import registry::Capabilities
import registry_host::Host
import registry_host::Native

/// The language gate over the checked-in tree. Directory listing is a blocked
/// capability (`files.directory`), so the live walk goes through the native
/// `Process` handler; the classification itself is tested without it.
module ConformanceTests {
    let roots = "src/osprey/packages/manager src/toolchain/schemas"

    fn classification() = checkAll("only Osprey source and declarative inputs pass", [
        length(Conformance::violations(["src/osprey/packages/manager/core/src/names.osp", "src/osprey/packages/manager/x.ospml", "src/toolchain/schemas/package-registry.td"])) == 0,
        length(Conformance::violations(["src/osprey/packages/manager/core/osprey.toml", "src/osprey/packages/manager/tests/fixtures/manifest.json", "src/osprey/packages/manager/README.md", "src/osprey/packages/manager/sample-registry/@demo/pyadd/1.1/uv.lock"])) == 0,
        length(Conformance::violations(["src/osprey/packages/manager/supabase/migrations/schema.yaml", "src/osprey/packages/manager/ops/terraform/api.tf", "src/osprey/packages/manager/ops/terraform/.terraform.lock.hcl"])) == 0,
        join(Conformance::violations(["src/osprey/packages/manager/host/shim.c", "src/osprey/packages/manager/cli/launch.sh", "src/osprey/packages/manager/web/app.js", "src/osprey/packages/manager/ops/migrate.py", "src/osprey/packages/manager/core/src/lib.rs", "src/osprey/packages/manager/web/index.html"]), ",") == "src/osprey/packages/manager/host/shim.c,src/osprey/packages/manager/cli/launch.sh,src/osprey/packages/manager/web/app.js,src/osprey/packages/manager/ops/migrate.py,src/osprey/packages/manager/core/src/lib.rs,src/osprey/packages/manager/web/index.html",
        join(Conformance::violations(["src/osprey/packages/manager/tests/golden.ospx", "src/osprey/packages/manager/Makefile", "src/osprey/packages/manager/core/src/notes"]), ",") == "src/osprey/packages/manager/tests/golden.ospx,src/osprey/packages/manager/Makefile,src/osprey/packages/manager/core/src/notes"
    ])

    /// Delivered word primitives must not be reported as missing. Implements [PACKAGE-CONFORMANCE].
    fn bitwiseInventory() = checkAll("word builtins agree with the doctor inventory", [
        bitAnd(12, 10) == 8,
        bitXor(12, 10) == 6,
        shiftRightLogical(-16, 2) == 4611686018427387900,
        !contains(join(mapList(Capabilities::blocked(), fn(cap) => cap.id), ","), "int.bitwise")
    ])

    fn listed() = {
        let run = perform Host::Process.run("find ${roots} -type f -not -path '*/.osprey/*'")
        if run.status == 0 { filterList(lines(run.stdout), fn(line) => line != "") } else { [] }
    }

    fn checkedInTree() = {
        let files = listed()
        let violations = Conformance::violations(files)
        checkAll("the checked-in package system contains no non-Osprey executable source", [
            length(files) > 10,
            length(violations) == 0,
            join(violations, ",") == ""
        ])
    }

    export fn run() = {
        test("conformance: available word builtins are not blocked", bitwiseInventory)
        test("conformance: classification", classification)
        test("conformance: checked-in tree", fn() => Native::process()(checkedInTree))
    }
}
