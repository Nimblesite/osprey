namespace registry_tests;

/// Spec 0031 references the canonical model. The website build checks the
/// rendered typeDiagram against that file byte for byte. [PACKAGE-TYPES]
module SchemaTests {
    fn modelReference() = {
        let spec = readFile("docs/specs/ecosystem/0031-PackageDomainModel.md") ?: ""
        checkAll("spec references the canonical package model once", [
            contains(spec, "(../../../src/toolchain/schemas/package-registry.td)"),
            length(split(spec, "<!-- registry-model -->") ?: []) == 2,
            !contains(spec, "```typediagram")
        ])
    }

    /// Check the source of the website's model projection.
    export fn run() = test("schema: spec references canonical model", modelReference)
}
