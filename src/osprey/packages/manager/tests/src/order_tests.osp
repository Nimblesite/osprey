namespace registry_tests;
import registry::SetOrder
import registry_tests::Fixtures

/// Every list order and duplicate rule of spec 0031, one fixture row per
/// sorted, swapped and same-key case. Implements the list rules of
/// [PACKAGE-TYPE-INVARIANTS].
module OrderTests {
    fn verdict(c) = SetOrder::listCode(Fixtures::textOf(c, "element"), Fixtures::textOf(c, "field"), Fixtures::itemsOf(c, "items"))

    fn caseHolds(c) = verdict(c) == Fixtures::textOf(c, "code")

    fn cases() = Fixtures::loadItems("order/lists.json", "cases")

    fn caseTest(c) = test("order: ${Fixtures::textOf(c, "why")}", fn() => check(Fixtures::textOf(c, "why"), Fixtures::textOf(c, "code"), verdict(c)))

    /// One test per order vector.
    export fn run() = forEachList(cases(), caseTest)
}
