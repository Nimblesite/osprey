namespace registry_tests;
import registry::Bytes
import registry::Sha256
import registry::Digests
import registry::Canonical
import registry::Merkle
import registry::Dsse
import registry::Json
import registry_tests::Fixtures

/// Primary-specification vectors — FIPS 180-4 SHA-256, RFC 8785 JCS, DSSE
/// PAE with the spec 0030 WebAuthn challenge and EnvelopeDigest, digest
/// algorithm agility, and RFC 9162 Merkle inclusion/consistency proofs —
/// read from src/osprey/packages/manager/tests/fixtures/vectors and asserted against the core
/// helpers. Every golden was computed independently of the code under test.
module VectorTests {

    fn shaCases() = {
        let fx = Fixtures::load("vectors/sha256.json")
        Fixtures::report("sha256 FIPS 180-4 vectors", Fixtures::itemsOf(fx, "cases"), fn(c) =>
            Sha256::ofString(Fixtures::textOf(c, "text")) == Fixtures::textOf(c, "sha256"))
    }

    fn parseOk(t) = match Digests::parse(t) {
        Success { value } => value == t
        Error => false
    }

    fn parseCode(c) = match Digests::parse(Fixtures::textOf(c, "text")) {
        Error { message } => message == Fixtures::textOf(c, "code")
        Success => false
    }

    fn agilityCases() = {
        let fx = Fixtures::load("vectors/digest-agility.json")
        Fixtures::report("digest agility accepted", Fixtures::textsOf(fx, "valid"), parseOk)
        Fixtures::report("digest agility rejected", Fixtures::itemsOf(fx, "invalid"), parseCode)
    }

    /// The successful `result`'s value equals the case's text at `key`.
    fn equalsText(result, c, key) = match result {
        Success { value } => value == Fixtures::textOf(c, key)
        Error => false
    }

    fn canonOk(c) = equalsText(Canonical::canonicalize(Fixtures::textOf(c, "input")), c, "canonical")

    fn canonRejected(c) = match Canonical::canonicalize(Fixtures::textOf(c, "input")) {
        Error { message } => startsWith(message, Fixtures::textOf(c, "code"))
        Success => false
    }

    fn canonCases() = {
        let fx = Fixtures::load("vectors/rfc8785.json")
        Fixtures::report("rfc8785 canonical form", Fixtures::itemsOf(fx, "cases"), canonOk)
        Fixtures::report("rfc8785 rejected inputs", Fixtures::itemsOf(fx, "rejected"), canonRejected)
    }

    fn paeOk(c) = Bytes::hex(Dsse::pae(Fixtures::textOf(c, "type"), Bytes::fromHex(Fixtures::textOf(c, "payloadHex")))) == Fixtures::textOf(c, "paeHex")

    fn intentPae(intent) = Bytes::hex(Dsse::pae(Fixtures::textOf(intent, "payloadType"), Bytes::ofString(Fixtures::textOf(intent, "payloadCanonical")))) == Fixtures::textOf(intent, "paeHex")

    fn intentCanonical(intent) = equalsText(Canonical::canonicalize(Fixtures::textOf(intent, "payloadInput")), intent, "payloadCanonical")

    fn intentChallenge(intent) = Dsse::webAuthnChallenge(Bytes::fromHex(Fixtures::textOf(intent, "paeHex"))) == Fixtures::textOf(intent, "challenge")

    fn intentEnvelope(intent) = Dsse::envelopeDigest(Bytes::ofString(Fixtures::textOf(intent, "envelopeCanonical"))) == Fixtures::textOf(intent, "envelopeDigest")

    fn dsseCases() = {
        let fx = Fixtures::load("vectors/dsse.json")
        let intent = Fixtures::field(fx, "releaseIntent")
        Fixtures::report("dsse PAE bytes", Fixtures::itemsOf(fx, "pae"), paeOk)
        checkAll("dsse release intent detached forms", [
            intentPae(intent),
            intentCanonical(intent),
            intentChallenge(intent),
            intentEnvelope(intent)
        ])
    }

    fn merkleLeaves() = mapList(Fixtures::loadTexts("vectors/merkle.json", "leaves"), Bytes::fromHex)

    fn merkleRoots() = Fixtures::loadTexts("vectors/merkle.json", "roots")

    fn rootAt(size) = listGet(merkleRoots(), size) ?: ""

    fn firstLeaves(leaves, n) = range(0, n) |> map(fn(i) => listGet(leaves, i) ?: []) |> toList

    fn rootMatches(i) = Bytes::hex(Merkle::root(firstLeaves(merkleLeaves(), i))) == rootAt(i)

    fn hexProof(c) = mapList(Fixtures::textsOf(c, "proof"), Bytes::fromHex)

    fn hexes(hashes) = join(mapList(hashes, Bytes::hex), ",")

    fn inclusionOk(c) = {
        let index = Fixtures::numberOf(c, "index")
        let size = Fixtures::numberOf(c, "size")
        let proof = hexProof(c)
        let leaf = Merkle::leafHash(listGet(merkleLeaves(), index) ?: [])
        match Merkle::verifyInclusion(index, size, leaf, proof, Bytes::fromHex(rootAt(size))) {
            true => hexes(Merkle::inclusionProof(index, firstLeaves(merkleLeaves(), size))) == hexes(proof)
            false => false
        }
    }

    fn consistencyOk(c) = {
        let first = Fixtures::numberOf(c, "first")
        let second = Fixtures::numberOf(c, "second")
        let proof = hexProof(c)
        let verified = Merkle::verifyConsistency(first, second, Bytes::fromHex(rootAt(first)), Bytes::fromHex(rootAt(second)), proof)
        match verified {
            true => hexes(Merkle::consistencyProof(first, firstLeaves(merkleLeaves(), second))) == hexes(proof)
            false => false
        }
    }

    fn negativeRoot(c, size) = match Json::get(c, "root") {
        Success { value } => rootAt(Fixtures::number(value))
        Error => rootAt(size)
    }

    fn inclusionRejected(c) = {
        let index = Fixtures::numberOf(c, "index")
        let size = Fixtures::numberOf(c, "size")
        let leaf = Merkle::leafHash(listGet(merkleLeaves(), index) ?: [])
        !Merkle::verifyInclusion(index, size, leaf, hexProof(c), Bytes::fromHex(negativeRoot(c, size)))
    }

    fn consistencyRejected(c) = {
        let first = Fixtures::numberOf(c, "first")
        let second = Fixtures::numberOf(c, "second")
        let proof = hexProof(c)
        match Fixtures::textOf(c, "label") == "swapped roots" {
            true => !Merkle::verifyConsistency(first, second, Bytes::fromHex(rootAt(second)), Bytes::fromHex(rootAt(first)), proof)
            false => !Merkle::verifyConsistency(first, second, Bytes::fromHex(rootAt(first)), Bytes::fromHex(rootAt(second)), proof)
        }
    }

    fn merkleCases(kind, run) = Fixtures::report("merkle ${kind}", foldList(Fixtures::loadItems("vectors/merkle.json", "negative"), [],
        fn(acc, c) => if Fixtures::textOf(c, "kind") == kind { listAppend(acc, c) } else { acc }), run)

    /// Every primary-specification vector group, in one run.
    export fn run() = {
        let fx = Fixtures::load("vectors/merkle.json")
        test("vector: sha256", shaCases)
        test("vector: digest agility", agilityCases)
        test("vector: rfc8785", canonCases)
        test("vector: dsse", dsseCases)
        test("vector: merkle roots", fn() => Fixtures::report("merkle roots 0..8", range(0, 9) |> toList, rootMatches))
        test("vector: merkle inclusion", fn() => Fixtures::report("merkle inclusion proofs", Fixtures::itemsOf(fx, "inclusion"), inclusionOk))
        test("vector: merkle consistency", fn() => Fixtures::report("merkle consistency proofs", Fixtures::itemsOf(fx, "consistency"), consistencyOk))
        test("vector: merkle rejection", fn() => {
            merkleCases("inclusion", inclusionRejected)
            merkleCases("consistency", consistencyRejected)
        })
    }
}
