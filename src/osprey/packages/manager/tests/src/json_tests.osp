namespace registry_tests;
import registry::Canonical
import registry::Json

/// Strict RFC 8259 parsing and RFC 8785 canonical serialization: reason codes
/// at exact byte offsets, UTF-16 key ordering, escaping and idempotence.
/// Implements [PACKAGE-PUBLISH] and [PACKAGE-TYPE-INVARIANTS].
module JsonTests {
    fn cp(n) = fromCodePoint(n) ?: ""

    /// "code@offset" of the first parse problem, or "ok".
    fn problem(text) = match Json::parse(text) {
        Success => "ok"
        Error { message } => message
    }

    /// Canonical serialization of the parse, or the described problem.
    fn canon(text) = match Json::parse(text) {
        Success { value } => Canonical::serialize(value) ?: "?"
        Error { message } => Json::describe(message)
    }

    fn ser(v) = Canonical::serialize(v) ?: "?"

    /// `canonicalize` rendered as one string, success or failure.
    fn done(text) = match Canonical::canonicalize(text) {
        Success { value } => value
        Error { message } => message
    }

    fn found(text, key) = match Json::parse(text) {
        Error { message } => Json::describe(message)
        Success { value } => match Json::get(value, key) {
            Error { message } => message
            Success { value } => Canonical::serialize(value) ?: "?"
        }
    }

    fn nested(n) = {
        let opens = repeat("[", n) ?: ""
        let closes = repeat("]", n) ?: ""
        opens + "0" + closes
    }

    fn dupMembers() = [
        Json::Member { key: "a", value: Json::Num { value: 1 } },
        Json::Member { key: "a", value: Json::Num { value: 2 } }
    ]

    fn values() = checkAll("scalars, containers, whitespace and escapes decode", [
        canon(" \t\r\nnull\n ") == "null",
        canon("true") == "true",
        canon("false") == "false",
        canon("0") == "0",
        canon("-1") == "-1",
        canon("\"\"") == "\"\"",
        canon("\"a\"") == "\"a\"",
        canon("\"a\\tb\"") == "\"a\\tb\"",
        canon("\"\\/\\\"\\\\\"") == "\"" + "/" + "\\\"" + "\\\\" + "\"",
        canon("[]") == "[]",
        canon("[ ]") == "[]",
        canon("[1, 2,3]") == "[1,2,3]",
        canon("{}") == "{}",
        canon("{ \"a\" : 1 }") == "{\"a\":1}",
        canon("[[[]]]") == "[[[]]]",
        canon("{\"a\":[1,{\"b\":null,\"c\":true},\"x\"],\"d\":[]}") == "{\"a\":[1,{\"b\":null,\"c\":true},\"x\"],\"d\":[]}",
        canon("\"\\u0041\\u00e9\\ud83d\\ude00\"") == "\"Aé😀\""
    ])

    fn integers() = checkAll("64-bit integer edges stay in range", [
        canon("0") == "0",
        canon("9223372036854775807") == "9223372036854775807",
        canon("-9223372036854775808") == "-9223372036854775808",
        problem("9223372036854775808") == "json.integer-range@0",
        problem("-9223372036854775809") == "json.integer-range@0",
        problem("99999999999999999999") == "json.integer-range@0"
    ])

    fn shapes() = checkAll("non-integer numbers report at the number start", [
        problem("1.5") == "json.non-integer@0",
        problem("1e3") == "json.non-integer@0",
        problem("1E3") == "json.non-integer@0",
        problem("01") == "json.non-integer@0",
        problem("-0") == "json.non-integer@0",
        problem("-01") == "json.non-integer@0",
        problem("[1.0]") == "json.non-integer@1",
        problem("0.0") == "json.non-integer@0"
    ])

    fn problems() = checkAll("structural problems carry exact byte offsets", [
        problem("") == "json.unexpected-end@0",
        problem("   ") == "json.unexpected-end@3",
        problem("[1,") == "json.unexpected-end@3",
        problem("{\"a\"") == "json.unexpected-end@4",
        problem("\"abc") == "json.unexpected-end@4",
        problem("\"ab\\uD8") == "json.unexpected-end@7",
        problem("tru") == "json.unexpected-end@3",
        problem("-") == "json.unexpected-end@1",
        problem("x") == "json.unexpected-token@0",
        problem("{1:2}") == "json.unexpected-token@1",
        problem("[1 2]") == "json.unexpected-token@3",
        problem("{\"a\" 1}") == "json.unexpected-token@5",
        problem("[1,]") == "json.unexpected-token@3",
        problem("{\"a\":1,}") == "json.unexpected-token@7",
        problem("nullx") == "json.trailing-text@4",
        problem("1 x") == "json.trailing-text@2",
        problem("{}[]") == "json.trailing-text@2",
        problem("{\"a\":1,\"a\":2}") == "json.duplicate-key@7"
    ])

    fn depth() = checkAll("nesting is capped at 64 containers", [
        canon(nested(64)) == nested(64),
        problem(nested(65)) == "json.depth@64"
    ])

    fn strings() = checkAll("string content problems carry exact offsets", [
        problem("\"a" + cp(1) + "b\"") == "json.control-character@2",
        problem("\"\\u0000\"") == "json.control-character@1",
        problem("\"a\\qb\"") == "json.bad-escape@2",
        problem("\"a\\u12x4\"") == "json.bad-escape@2",
        problem("\"a\\uzz\"") == "json.bad-escape@2",
        problem("\"\\uD800\"") == "json.bad-surrogate@1",
        problem("\"\\uDC00\"") == "json.bad-surrogate@1",
        problem("\"\\uDC00\\uD800\"") == "json.bad-surrogate@1",
        problem("\"\\uD800x\"") == "json.bad-surrogate@1",
        problem("\"\\uD800\\u0041\"") == "json.bad-surrogate@1",
        problem("\"\\uD800\\uD800\"") == "json.bad-surrogate@1",
        problem("\"\\uD800\\uD\"") == "json.bad-escape@1",
        problem("\"\\ud83d\\ude00\"") == "ok"
    ])

    /// `substring` slices bytes, so mid-codepoint cuts are raw invalid UTF-8.
    fn utf8() = {
        let lone = substring("é", 1, 2) ?: ""
        let truncated = substring("é", 0, 1) ?: ""
        checkAll("invalid UTF-8 in string content", [
            problem("\"" + lone + "\"") == "json.utf8@1",
            problem("\"" + truncated + "\"") == "json.utf8@1",
            problem("\"ok" + lone + "\"") == "json.utf8@3"
        ])
    }

    fn escaping() = {
        // RFC 8785 3.2.2.2: short escapes where named, \u00xx for the rest of
        // the C0 range, every other code point literal UTF-8.
        let input = cp(1) + cp(8) + cp(9) + cp(10) + cp(12) + cp(13) + cp(31) + "\"" + "\\" + "/" + cp(233) + cp(128512)
        let body = join(["\\u0001", "\\b", "\\t", "\\n", "\\f", "\\r", "\\u001f", "\\\"", "\\\\", "/" + cp(233) + cp(128512)], "")
        checkAll("string escaping per RFC 8785 3.2.2.2", [
            ser(Json::Str { text: input }) == "\"" + body + "\"",
            ser(Json::Str { text: cp(8232) + cp(8233) }) == "\"" + cp(8232) + cp(8233) + "\""
        ])
    }

    fn ordering() = {
        // RFC 8785 Appendix B ordering by UTF-16 code unit: "" < U+0001 < "1"
        // < "10" < "2" < "A" < "a" < U+0080 < U+20AC < U+10300 < U+FF5E. The
        // astral key U+10300 widens to units U+D800,U+DF00 and U+D800 is a
        // single unit below U+FF5E, so it sorts BEFORE the fullwidth tilde.
        let members = [
            Json::Member { key: cp(65374), value: Json::Num { value: 11 } },
            Json::Member { key: "a", value: Json::Num { value: 7 } },
            Json::Member { key: cp(8364), value: Json::Num { value: 9 } },
            Json::Member { key: "1", value: Json::Num { value: 3 } },
            Json::Member { key: cp(66304), value: Json::Num { value: 10 } },
            Json::Member { key: cp(1), value: Json::Num { value: 2 } },
            Json::Member { key: "", value: Json::Num { value: 1 } },
            Json::Member { key: "10", value: Json::Num { value: 4 } },
            Json::Member { key: "2", value: Json::Num { value: 5 } },
            Json::Member { key: "A", value: Json::Num { value: 6 } },
            Json::Member { key: cp(128), value: Json::Num { value: 8 } }
        ]
        let expected = "{\"\":1,\"\\u0001\":2,\"1\":3,\"10\":4,\"2\":5,\"A\":6,\"a\":7,\"" + cp(128) + "\":8,\"" + cp(8364) + "\":9,\"" + cp(66304) + "\":10,\"" + cp(65374) + "\":11}"
        check("RFC 8785 Appendix B key ordering", expected, ser(Json::Obj { members: members }))
    }

    fn refusesDuplicates(value) = match Canonical::serialize(value) {
        Success => false
        Error { message } => message == "canonical.duplicate-key"
    }

    fn roundTrip() = {
        let text = "{ \"b\" : 1, \"a\" : [2, { \"d\" : null, \"c\" : true }] }"
        let once = canon(text)
        checkAll("sorting, duplicate keys and idempotence", [
            once == "{\"a\":[2,{\"c\":true,\"d\":null}],\"b\":1}",
            canon(once) == once,
            done(once) == once,
            refusesDuplicates(Json::Obj { members: dupMembers() }),
            refusesDuplicates(Json::Arr { items: [Json::Obj { members: dupMembers() }] }),
            done("01") == "json.non-integer at byte 0",
            done("{\"a\":1,\"a\":2}") == "json.duplicate-key at byte 7"
        ])
    }

    fn lookups() = checkAll("member lookup and problem description", [
        found("{\"a\":1}", "a") == "1",
        found("{\"a\":{\"b\":2}}", "a") == "{\"b\":2}",
        found("{\"a\":1}", "b") == "json.missing-key",
        found("[1]", "a") == "json.not-an-object",
        found("null", "a") == "json.not-an-object",
        Json::describe("json.depth@12") == "json.depth at byte 12",
        Json::problemCode("json.non-integer@3") == "json.non-integer",
        Json::problemOffset("json.non-integer@3") == 3,
        Json::problemCode("json.missing-key") == "json.missing-key",
        Json::problemOffset("json.missing-key") == -1
    ])

    let longRun = 100000

    fn longText() = repeat("a", longRun) ?: ""

    fn parsedLength(text) = match Json::parse(text) {
        Success { value } => match value {
            Json::Str { text } => byteLength(text)
            _ => -1
        }
        Error => -1
    }

    fn canonicalLength(text) = byteLength(Canonical::serialize(Json::Str { text: text }) ?: "")

    /// Strings and whitespace far longer than one stack frame per byte
    /// allows: a scanner that recursed per byte overflowed near 6,000 bytes.
    fn longInputs() = checkAll("long strings parse and render", [
        parsedLength("\"" + longText() + "\"") == longRun,
        parsedLength((repeat(" ", longRun) ?: "") + "\"x\"" + (repeat("\n", longRun) ?: "")) == 1,
        parsedLength("\"" + longText() + "\\n" + longText() + "\"") == 2 * longRun + 1,
        parsedLength("\"" + (repeat("é", longRun) ?: "") + "\"") == 2 * longRun,
        parsedLength("\"" + (repeat("\\n", longRun) ?: "") + "\"") == longRun,
        problem("\"" + (repeat("\\n", longRun) ?: "") + "\\q\"") == "json.bad-escape@${2 * longRun + 1}",
        canonicalLength(longText()) == longRun + 2,
        canonicalLength(repeat("\n", longRun) ?: "") == 2 * longRun + 2,
        canonicalLength(repeat("é", longRun) ?: "") == 2 * longRun + 2,
        canonicalLength(longText() + "\n" + longText()) == 2 * longRun + 4
    ])

    export fn run() = {
        test("json: values and whitespace", values)
        test("json: integer edges", integers)
        test("json: number shapes", shapes)
        test("json: problems and offsets", problems)
        test("json: nesting depth", depth)
        test("json: string escapes", strings)
        test("json: utf8 validation", utf8)
        test("json: member lookup", lookups)
        test("canonical: escaping", escaping)
        test("canonical: key ordering", ordering)
        test("canonical: duplicates and idempotence", roundTrip)
        test("json: 100,000-byte strings and whitespace", longInputs)
    }
}
