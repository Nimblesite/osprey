namespace registry_tests;
import registry::Arithmetic
import registry::Objective
import registry::Identity
import registry::Names
import registry::Order
import registry::Policy

/// [PACKAGE-EVIDENCE-ARITHMETIC] formulas and the [PACKAGE-RESOLUTION] cost tuple.
module ArithmeticTests {
    fn w(weight, value) = Arithmetic::Weighted { weight: weight, value: value }

    /// A domain violation aborts; here the abort is caught and reported as -1.
    fn faults(body) = {
        let catcher = handler Policy::Fatal {
            abort _message => -1
        }
        catcher(body)
    }

    fn rounding() = checkAll("round-half-up division and signed form", [
        structuralEquals([Arithmetic::roundDiv(7, 2), Arithmetic::roundDiv(5, 2)], [4, 3]),
        structuralEquals([Arithmetic::roundDiv(4, 3), Arithmetic::roundDiv(0, 3)], [1, 0]),
        structuralEquals([Arithmetic::roundDiv(10000 * 1, 3), Arithmetic::roundDiv(10000 * 2, 3)], [3333, 6667]),
        Arithmetic::signedRoundDiv(-7, 2) == -4,
        Arithmetic::signedRoundDiv(7, 2) == 4,
        Arithmetic::signedRoundDiv(0, 9) == 0,
        faults(fn() => Arithmetic::roundDiv(-1, 2)) == -1,
        faults(fn() => Arithmetic::roundDiv(1, 0)) == -1
    ])

    fn ramps() = checkAll("clamp, higher, lower and ratio", [
        structuralEquals([Arithmetic::clamp(5, 0, 10), Arithmetic::clamp(-5, 0, 10)], [5, 0]),
        structuralEquals([Arithmetic::clamp(15, 0, 10), Arithmetic::higher(0, 0, 100)], [10, 0]),
        structuralEquals([Arithmetic::higher(100, 0, 100), Arithmetic::higher(150, 0, 100)], [10000, 10000]),
        structuralEquals([Arithmetic::higher(50, 0, 100), Arithmetic::higher(1, 0, 3)], [5000, 3333]),
        structuralEquals([Arithmetic::higher(-5, 0, 100), Arithmetic::lower(0, 0, 100)], [0, 10000]),
        structuralEquals([Arithmetic::lower(100, 0, 100), Arithmetic::lower(25, 0, 100)], [0, 7500]),
        faults(fn() => Arithmetic::higher(1, 5, 5)) == -1,
        faults(fn() => Arithmetic::lower(1, 5, 5)) == -1,
        structuralEquals([Arithmetic::ratio(1, 4), Arithmetic::ratio(5, 4), Arithmetic::ratio(0, 4)], [2500, 10000, 0]),
        Arithmetic::ratio(1, 3) == 3333
    ])

    fn aggregates() = checkAll("weighted means, percentiles, days and display", [
        Arithmetic::weighted([w(1, 100), w(3, 200)]) == 175,
        structuralEquals([Arithmetic::weighted([w(2, 5), w(2, 6)]), Arithmetic::weighted([w(1, 7)])], [6, 7]),
        structuralEquals([Arithmetic::percentileIndex(50, 1), Arithmetic::percentileIndex(50, 2)], [0, 0]),
        structuralEquals([Arithmetic::percentileIndex(50, 3), Arithmetic::percentileIndex(50, 4)], [1, 1]),
        structuralEquals([Arithmetic::percentileIndex(90, 10), Arithmetic::percentileIndex(90, 11)], [8, 9]),
        Arithmetic::percentileIndex(100, 5) == 4,
        (Arithmetic::percentile(50, [30, 10, 20]) ?: -1) == 20,
        (Arithmetic::percentile(90, [5, 4, 3, 2, 1, 6, 7, 8, 9, 10]) ?: -1) == 9,
        (Arithmetic::percentile(50, []) ?: -1) == -1,
        structuralEquals([Arithmetic::ceilDays(0), Arithmetic::ceilDays(1), Arithmetic::ceilDays(86400000)], [0, 1, 1]),
        Arithmetic::ceilDays(86400001) == 2,
        structuralEquals([Arithmetic::display(0), Arithmetic::display(5)], ["0.00", "0.05"]),
        structuralEquals([Arithmetic::display(1234), Arithmetic::display(10000)], ["12.34", "100.00"]),
        Arithmetic::fullScale() == 10000
    ])

    fn advisory(severity, reach, ms) = Objective::Advisory { severityWeight: severity, reachabilityFactor: reach, overdueMilliseconds: ms }
    fn cost(v, d, u, e, c, s, l) = Objective::Cost { vulnerability: v, overdue: d, unknown: u, evidence: e, changed: c, size: s, lag: l }
    fn id(scope, ordinal, digest) = Identity::ReleaseId { key: Names::Key { scope: scope, name: "p" }, epoch: 1, ordinal: ordinal, digest: digest }

    fn costs() = checkAll("per-candidate cost facts", [
        Objective::advisoryCost(advisory(7000, 5000, 0)) == 3500,
        Objective::advisoryCost(advisory(1, 1, 0)) == 0,
        Objective::vulnerability([advisory(7000, 5000, 0), advisory(10000, 10000, 0)]) == 13500,
        structuralEquals([Objective::vulnerability([]), Objective::overdueDays(0)], [0, 0]),
        structuralEquals([Objective::overdueDays(1), Objective::overdueDays(86400000 * 4000)], [1, 3650]),
        Objective::overdue([advisory(10000, 10000, 86400000 * 2 + 1)]) == 30000,
        Objective::overdue([advisory(10000, 10000, 0), advisory(7000, 5000, 86400000)]) == 3500,
        structuralEquals([Objective::lag(42, 40), Objective::lag(42, 42)], [2, 0])
    ])

    fn ordering() = checkAll("lexicographic tuple and canonical tie-breaks", [
        Objective::compare(cost(0, 0, 0, 0, 0, 0, 0), cost(0, 0, 0, 0, 0, 0, 0)) == 0,
        Objective::compare(cost(0, 9, 9, 9, 9, 9, 9), cost(1, 0, 0, 0, 0, 0, 0)) < 0,
        Objective::compare(cost(1, 0, 9, 9, 9, 9, 9), cost(1, 1, 0, 0, 0, 0, 0)) < 0,
        Objective::compare(cost(1, 1, 0, 9, 9, 9, 9), cost(1, 1, 1, 0, 0, 0, 0)) < 0,
        Objective::compare(cost(1, 1, 1, 0, 9, 9, 9), cost(1, 1, 1, 1, 0, 0, 0)) < 0,
        Objective::compare(cost(1, 1, 1, 1, 0, 9, 9), cost(1, 1, 1, 1, 1, 0, 0)) < 0,
        Objective::compare(cost(1, 1, 1, 1, 1, 0, 9), cost(1, 1, 1, 1, 1, 1, 0)) < 0,
        Objective::compare(cost(1, 1, 1, 1, 1, 1, 0), cost(1, 1, 1, 1, 1, 1, 1)) < 0,
        Objective::compare(cost(2, 0, 0, 0, 0, 0, 0), cost(1, 9, 9, 9, 9, 9, 9)) > 0,
        Objective::add(cost(1, 2, 3, 4, 5, 6, 7), cost(1, 1, 1, 1, 1, 1, 1)).lag == 8,
        Objective::add(Objective::zero(), cost(1, 2, 3, 4, 5, 6, 7)).vulnerability == 1,
        Objective::comparePackageTie(id("a", 9, "sha256:aa"), id("a", 3, "sha256:aa")) < 0,
        Objective::comparePackageTie(id("a", 3, "sha256:aa"), id("a", 3, "sha256:ab")) < 0,
        Objective::comparePackageTie(id("a", 1, "sha256:zz"), id("b", 9, "sha256:aa")) < 0,
        Objective::compareSystemTie(sys("sqlite/c-api", "homebrew", 1, "sha256:a"), sys("sqlite/c-api", "homebrew", 2, "sha256:a")) < 0,
        Objective::compareSystemTie(sys("sqlite/c-api", "apt", 9, "sha256:a"), sys("sqlite/c-api", "homebrew", 1, "sha256:a")) < 0,
        Objective::compareSystemTie(sys("a", "x", 1, "sha256:b"), sys("a", "x", 1, "sha256:a")) > 0
    ])

    fn sys(capability, provider, revision, digest) = Objective::SystemTuple { capability: capability, provider: provider, revision: revision, digest: digest }

    export fn run() = {
        test("arithmetic: rounding", rounding)
        test("arithmetic: ramps", ramps)
        test("arithmetic: aggregates", aggregates)
        test("objective: cost facts", costs)
        test("objective: ordering", ordering)
    }
}
