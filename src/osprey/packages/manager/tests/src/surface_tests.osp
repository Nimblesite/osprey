namespace registry_tests;
import registry::Release
import registry::ReleaseFiles
import registry::Surface
import registry_tests::Fixtures

/// The capability surface scan of [PACKAGE-CAPABILITY-CONFINEMENT]: the
/// builtin-to-capability table equals the fixture, whole identifiers match
/// while comments and string literals do not, every `http*`/`websocket*`
/// name is `io/network`, a declaration counts like a call, non-source files
/// are skipped, and `[system.*]` capabilities join the set canonically.
module SurfaceTests {
    fn file(path, content) = Release::File { relPath: path, content: content }

    fn pair(n: Surface::Named) = "${n.builtin}=${n.capability}"

    /// The surface of `text` is exactly `capabilities`.
    fn surfaceOf(text, capabilities) = structuralEquals(Surface::ofText(text), capabilities)

    /// The surface of `files` is exactly `capabilities`.
    fn surfaceOfFiles(files, capabilities) = structuralEquals(Surface::ofFiles(files), capabilities)

    /// The surface and pinned systems of `files` are exactly `capabilities`.
    fn surfaceOfRelease(files, systems, capabilities) = structuralEquals(Surface::ofRelease(files, systems), capabilities)

    /// The declared builtin names of `text` are exactly `names`.
    fn declares(text, names) = structuralEquals(Surface::declaredBuiltins(text), names)

    /// `files` declare a builtin name.
    fn declaresShadow(files) = Surface::shadowsBuiltin(files)

    /// `files` declare no builtin name.
    fn declaresNoShadow(files) = !Surface::shadowsBuiltin(files)

    fn fixturePairs() = mapList(Fixtures::loadItems("capabilities/builtins.json", "builtins"), fn(v) =>
        "${Fixtures::textOf(v, "builtin")}=${Fixtures::textOf(v, "capability")}")

    fn tableMatchesFixture() = checkAll("the builtin table is the capabilities fixture", [
        structuralEquals(listSort(mapList(Surface::table(), pair)), listSort(fixturePairs())),
        length(Surface::table()) == length(fixturePairs())
    ])

    fn scans() = checkAll("whole identifiers outside comments and strings", [
        surfaceOf("fn main() = readFile(\"x\")", ["io/files"]),
        surfaceOf("fn readFileX() = 1\nlet x = myreadFile\n", []),
        surfaceOf("// readFile in a comment\nfn f() = 1\n", []),
        surfaceOf("fn f() = \"readFile \\\" writeFile\"\n", []),
        surfaceOf("fn f() = \"a\" + input()\n", ["io/terminal"]),
        surfaceOf("fn readFile(p) = 1\n", ["io/files"]),
        surfaceOf("httpFetchLater(1)\nwebsocketOpen(2)\n", ["io/network"]),
        surfaceOf("spawnProcess(\"ls\")\nwriteFile(\"a\", \"b\")\nreadFile(\"a\")\n", ["io/files", "io/process"]),
        surfaceOf("let entries = listDir(\".\")\n", ["io/files"]),
        surfaceOf("kindOf(\"a\")\n", ["io/files"]),
        surfaceOf("makeDir(\"d\")\n", ["io/files"]),
        surfaceOf("x / y // readFile\nz\n", []),
        surfaceOf("", [])
    ])

    fn trees() = checkAll("source files are scanned, other files are not, systems join canonically", [
        surfaceOfFiles([file("src/a.osp", "input()"), file("README.md", "readFile"), file("src/m.py", "# osprey: flavor=python\nwriteFile(1)")], ["io/files", "io/terminal"]),
        surfaceOfRelease([file("src/a.osp", "input()")], ["zlib", "io/terminal"], ["io/terminal", "zlib"]),
        surfaceOfRelease([file("src/a.osp", "fn pure() = 1")], [], [])
    ])

    fn interpolations() = {
        let call = "$" + "{readFile(path)}"
        checkAll("executable strings cannot hide ambient calls", [
            surfaceOf("fn load(path) = \"" + call + "\"", ["io/files"]),
            surfaceOf("fn load(path) = \"\\" + call + "\"", ["io/files"]),
            surfaceOf("load path = \"" + call + "\"", ["io/files"]),
            surfaceOf("# osprey: flavor=python\ndef load(path):\n    return f\"{readFile(path)}\"", ["io/files"]),
            surfaceOf("# osprey: flavor=python\ndef load(path):\n    return f'{readFile(path)}'", ["io/files"]),
            surfaceOf("fn load() = \"" + "$" + "{readFile(\"path\")}\" + input()", ["io/files", "io/terminal"]),
            surfaceOf("# osprey: flavor=python\n# a comment with an unmatched \"\ntermReadKey()", ["io/terminal"]),
            surfaceOf("termCols() + termRows() + termReadKey()", ["io/terminal"])
        ])
    }

    fn flavorFiles() = checkAll("source paths select each flavor's comment and identifier rules", [
        surfaceOfFiles([file("src/a.ospml", "(* readFile is commented out *)\nmain () = print \"done\"")], []),
        surfaceOfFiles([file("src/a.ospml", "(* outer (* extern puts -> int *) readFile *)\nmain () = print \"done\"")], []),
        surfaceOfFiles([file("src/a.ospml", "readFileé = 1\nmain () = print readFileé")], []),
        surfaceOfFiles([file("src/a.py", "# osprey: flavor=python\nreadFileé = 1\nprint(readFileé)")], []),
        surfaceOfFiles([file("src/a.py", "# osprey: flavor=python\nreadFileﻴ = 1\nprint(readFileﻴ)")], []),
        declaresNoShadow([file("src/a.py", "# osprey: flavor=python\nreadFileé = 1\nprint(readFileé)")]),
        declaresNoShadow([file("src/a.ospml", "(* fn readFile(p) = p *)\nmain () = print \"done\"")]),
        declaresNoShadow([file("src/a.ospml", "readFileé = 1\nmain () = print readFileé")])
    ])

    fn pythonTokens() = checkAll("Python token separators and formatted prefixes retain capabilities", [
        surfaceOfFiles([file("src/a.py", "def load(p):\n    return readFile" + (fromCodePoint(8203) ?: "") + "(p)")], ["io/files"]),
        surfaceOfFiles([file("src/a.py", "def load():\n    return input" + (fromCodePoint(8288) ?: "") + "()")], ["io/terminal"]),
        declaresShadow([file("src/a.py", "def" + (fromCodePoint(8288) ?: "") + "readFile(p):\n    return p")]),
        surfaceOfFiles([file("src/a.py", "@" + (fromCodePoint(8203) ?: "") + "extern\ndef puts(text: str) -> int: ...")], ["io/unknown"]),
        surfaceOfFiles([file("src/a.py", "def load(p):\n    return uf\"{readFile(p)}\"")], ["io/files"]),
        surfaceOfFiles([file("src/a.py", "def load(p):\n    return fu\"{readFile(p)}\"")], ["io/files"]),
        surfaceOfFiles([file("src/a.py", "def load(p):\n    return urf\"{readFile(p)}\"")], ["io/files"]),
        surfaceOfFiles([file("src/a.py", "value = u\"readFile(p)\"")], []),
        surfaceOfFiles([file("src/a.py", "value = uf\"{{readFile(p)}}\"")], []),
        surfaceOfFiles([file("src/a.py", "value = \"readFile" + (fromCodePoint(8203) ?: "") + "(p)\"")], []),
        surfaceOfFiles([file("src/a.py", "# readFile note\ninput()")], ["io/terminal"]),
        surfaceOfFiles([file("src/a.py", "x = 'readFile'")], []),
        surfaceOfFiles([file("src/a.py", "@extern\ndef puts(text: str) -> int: ...")], ["io/unknown"]),
        surfaceOfFiles([file("src/a.py", "# osprey: flavor=python\ndef load(path):\n    return" + (fromCodePoint(65279) ?: "") + "readFile(path)")], ["io/files"])
    ])

    /// A builtin's name declared with `fn`, `let` or `mut` is a shadowing
    /// declaration; a call is not, and the release rules refuse a tree that declares one.
    fn shadowing() = checkAll("declared builtin names are found and refused at publication", [
        declares("fn readFile(p) = 1\nlet input = 2\nmut httpGet = 3\n", ["httpGet", "input", "readFile"]),
        declares("fn load(p) = readFile(p)\nlet x = input()\n", []),
        declares("// fn readFile\nfn f() = \"let input\"\n", []),
        declaresNoShadow([file("src/a.osp", "fn load(p) = readFile(p)\n")]),
        declaresShadow([file("src/a.osp", "fn readFile(p) = 1\n")]),
        match ReleaseFiles::assemble("@a/b/1.1", [file("osprey.toml", "[project]\nname = \"b\"\n"), file("src/a.osp", "fn writeFile(p, c) = 0\n")]) {
            Error { message } => message == "source.shadowed-builtin"
            Success => false
        }
    ])

    fn sampleFile(release, path) = file(path, readFile("src/osprey/packages/manager/sample-registry/${release}/${path}") ?: "<missing>")

    fn unknownBuiltin() = checkAll("unclassified terminal operations block publication", [
        surfaceOf("termUnclassified()", ["io/unknown"]),
        surfaceOf("extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("extern puts (text: string) -> int", ["io/unknown"]),
        surfaceOf("extern // declaration continues\nfn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("# osprey: flavor=python\n@extern\ndef puts(text: str) -> int: ...", ["io/unknown"]),
        surfaceOf("# osprey: flavor=python\n@ extern\ndef puts(text: str) -> int: ...", ["io/unknown"]),
        surfaceOf("// extern fn puts\nfn text() = \"extern\"", []),
        surfaceOf("let external = 1", []),
        surfaceOf("# osprey: flavor=python\nextern = 1\ndef external():\n    return extern", []),
        match ReleaseFiles::assemble("@a/b/1.1", [file("src/a.osp", "fn main() = termUnclassified()")]) {
            Error { message } => message == "source.unclassified-builtin"
            Success => false
        }
    ])

    fn nativeNames() = checkAll("contextual extern identifiers do not declare native functions", [
        surfaceOf("fn main() = {\nlet extern = 1\nprint(\"$" + "{extern}\")\n}", []),
        surfaceOf("fn extern(x) = x\nfn main() = print(extern(1))", []),
        surfaceOf("let extern = fn(x) => x\nprint(extern(1))", []),
        surfaceOf("let extern = 1\nlet value = extern\nfn main() = print(value)", []),
        surfaceOf("let extern = 1\nlet value =\nextern\nfn main() = print(value)", [])
    ])

    fn nativeBoundaries() = checkAll("native declarations remain visible across statement boundaries", [
        surfaceOf("let text = \"ok\"\nextern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("let extern = 1\nextern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("module Foreign {\nexport extern fn puts(text: string) -> int\n}", ["io/unknown"]),
        surfaceOf("extern\n// declaration continues\nfn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("namespace prefix; module Empty {} extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("namespace prefix; signature Api {} extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("type Record = { value: int } extern fn puts(text: string) -> int", ["io/unknown"])
    ])

    fn nativeWhitespace() = checkAll("native declarations use the compiler's whitespace rules", [
        surfaceOf((fromCodePoint(65279) ?: "") + "extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf((fromCodePoint(12) ?: "") + "extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("extern" + (fromCodePoint(12) ?: "") + "fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf((fromCodePoint(11) ?: "") + "extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("let number = 1\rextern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("namespace prefix; extern fn puts(text: string) -> int", ["io/unknown"]),
        surfaceOf("// comment\rextern fn puts(text: string) -> int", ["io/unknown"])
    ])

    fn sampleSurface(case) = {
        let release = Fixtures::textOf(case, "release")
        let files = mapList(Fixtures::textsOf(case, "files"), fn(p) => sampleFile(release, p))
        surfaceOfRelease(files, [], Fixtures::textsOf(case, "surface"))
    }

    /// Every sample-registry release has the surface the fixture records.
    fn sampleSurfaces() = {
        let cases = Fixtures::loadItems("capabilities/sample-surfaces.json", "cases")
        Fixtures::report("sample-registry surfaces", cases, sampleSurface)
    }

    /// Every surface test.
    export fn run() = {
        test("surface: table equals the fixture", tableMatchesFixture)
        test("surface: identifier scan", scans)
        test("surface: executable interpolations and terminal input", interpolations)
        test("surface: source file flavors", flavorFiles)
        test("surface: Python token boundaries", pythonTokens)
        test("surface: trees and system capabilities", trees)
        test("surface: shadowed builtin names", shadowing)
        test("surface: unclassified ambient builtins", unknownBuiltin)
        test("surface: contextual native identifiers", nativeNames)
        test("surface: native declaration boundaries", nativeBoundaries)
        test("surface: native declaration whitespace", nativeWhitespace)
        test("surface: sample-registry goldens", sampleSurfaces)
    }
}
