namespace registry_tests;
import registry::Json
import registry::Names
import registry::Identity
import registry::Paths
import registry::Source
import registry::Digests
import registry::Bytes
import registry::Png
import registry_tests::Fixtures

/// The declarative fixtures under src/osprey/packages/manager/tests/fixtures, read through the
/// Osprey JSON parser and asserted case by case. A fixture is the normative
/// table; code here only interprets it. Each case is reported with the input
/// so a failure names the exact row.
module FixtureTests {
    fn names() = {
        let fx = Fixtures::load("names.json")
        Fixtures::report("names valid", Fixtures::textsOf(fx, "valid"), fn(t) => Fixtures::code(Names::parse(t)) == "")
        Fixtures::report("names invalid", Fixtures::itemsOf(fx, "invalid"), fn(c) => Fixtures::code(Names::parse(Fixtures::textOf(c, "text"))) == Fixtures::textOf(c, "code"))
    }

    fn releaseIds() = {
        let fx = Fixtures::load("release-ids.json")
        Fixtures::report("release ids valid", Fixtures::textsOf(fx, "valid"), fn(t) => match Identity::parse(t) {
            Success { value } => Identity::display(value) == t
            Error => false
        })
        Fixtures::report("release ids invalid", Fixtures::itemsOf(fx, "invalid"), fn(c) => Fixtures::code(Identity::parse(Fixtures::textOf(c, "text"))) == Fixtures::textOf(c, "code"))
    }

    fn pathRows() = {
        let fx = Fixtures::load("paths.json")
        Fixtures::report("paths valid", Fixtures::textsOf(fx, "valid"), fn(p) => Fixtures::code(Paths::validate(p)) == "")
        Fixtures::report("paths invalid", Fixtures::itemsOf(fx, "invalid"), fn(c) => Fixtures::code(Paths::validate(Fixtures::textOf(c, "path"))) == Fixtures::textOf(c, "code"))
        Fixtures::report("path collisions", Fixtures::itemsOf(fx, "collisions"), fn(c) => Fixtures::code(Paths::canonicalSet(Fixtures::textsOf(c, "paths"))) == Fixtures::textOf(c, "code"))
        Fixtures::report("excluded paths", Fixtures::textsOf(fx, "excluded"), Paths::excluded)
        Fixtures::report("included paths", Fixtures::textsOf(fx, "included"), fn(p) => !Paths::excluded(p))
    }

    fn treeRows() = {
        let fx = Fixtures::load("paths.json")
        Fixtures::report("forbidden kinds", Fixtures::itemsOf(fx, "forbiddenKinds"), fn(c) => Source::kindCode(Fixtures::textOf(c, "kind")) == Fixtures::textOf(c, "code"))
        expectTrue(Source::lfsPointer(Fixtures::text(Fixtures::field(Fixtures::field(fx, "lfsPointer"), "content"))))
        Fixtures::report("submission limits", Fixtures::items(Fixtures::field(Fixtures::field(fx, "limits"), "cases")), fn(c) =>
            Source::limitCode(Fixtures::numberOf(c, "fileCount"), Fixtures::numberOf(c, "totalBytes"), Fixtures::numberOf(c, "assetBytes")) == Fixtures::textOf(c, "code"))
    }

    fn entryOf(file) = Source::entryOf(Fixtures::textOf(file, "path"), Bytes::ofString(Fixtures::textOf(file, "content")))

    fn fileDigestsMatch(fx) = foldList(Fixtures::itemsOf(fx, "files"), true, fn(ok, file) => ok && Bytes::hex(entryOf(file).digest) == Fixtures::textOf(file, "sha256"))

    fn tampered(fx, entries) = {
        let sub = Fixtures::field(fx, "digestSubstitution")
        let fakeDigest = Bytes::fromHex(Fixtures::textOf(sub, "sha256"))
        let replaced = mapList(entries, fn(e: Source::Entry) => if e.path == Fixtures::textOf(sub, "path") { Source::Entry { path: e.path, byteLength: e.byteLength, digest: fakeDigest } } else { e })
        (Source::digest(replaced) ?: "") == Fixtures::textOf(sub, "sourceDigest")
    }

    fn tree(name) = {
        let fx = Fixtures::load("source/${name}.json")
        let entries = mapList(Fixtures::itemsOf(fx, "files"), entryOf)
        let envelope = Source::envelope(entries) ?: []
        checkAll("source tree ${name}", [
            fileDigestsMatch(fx),
            length(envelope) == Fixtures::numberOf(fx, "envelopeLength"),
            Bytes::hex(envelope) == Fixtures::textOf(fx, "envelopeHex"),
            (Source::digest(entries) ?: "") == Fixtures::textOf(fx, "sourceDigest"),
            match Json::get(fx, "digestSubstitution") {
                Success => tampered(fx, entries)
                Error => true
            }
        ])
    }

    fn domainHashes() = {
        let fx = Fixtures::load("digests.json")
        Fixtures::report("H(d, x) cases", Fixtures::itemsOf(fx, "cases"), fn(c) => Digests::hashText(Fixtures::textOf(c, "domain"), Fixtures::textOf(c, "payload")) == Fixtures::textOf(c, "digest"))
    }

    fn confusables() = {
        let fx = Fixtures::load("malicious/confusables.json")
        Fixtures::report("confusable names", Fixtures::itemsOf(fx, "names"), fn(c) => Fixtures::code(Names::parse(Fixtures::textOf(c, "text"))) == Fixtures::textOf(c, "code"))
        Fixtures::report("confusable lookalikes are valid names", Fixtures::itemsOf(fx, "names"), fn(c) => Fixtures::code(Names::parse(Fixtures::textOf(c, "lookalike"))) == "")
        Fixtures::report("confusable paths", Fixtures::itemsOf(fx, "paths"), fn(c) => Fixtures::code(Paths::validate(Fixtures::textOf(c, "path"))) == Fixtures::textOf(c, "code"))
    }

    /// The structural verdict a case expects: `structure` when the full
    /// verdict needs inflation, else `code`.
    fn structureExpected(c) = match Json::get(c, "structure") {
        Success { value } => Fixtures::text(value)
        Error => Fixtures::textOf(c, "code")
    }

    fn pngCaseHolds(c) = {
        let bytes = Bytes::fromHex(Fixtures::textOf(c, "hex"))
        length(bytes) == Fixtures::numberOf(c, "byteLength") && Png::structureCode(bytes) == structureExpected(c)
    }

    fn pngBombs() = Fixtures::report("png structure and bombs", Fixtures::loadItems("malicious/png-bombs.json", "cases"), pngCaseHolds)

    export fn run() = {
        test("fixtures: names", names)
        test("fixtures: release ids", releaseIds)
        test("fixtures: paths", pathRows)
        test("fixtures: tree rules", treeRows)
        test("fixtures: empty tree", fn() => tree("empty-tree"))
        test("fixtures: minimal tree", fn() => tree("minimal-tree"))
        test("fixtures: ordered tree", fn() => tree("ordered-tree"))
        test("fixtures: python tree", fn() => tree("python-tree"))
        test("fixtures: domain hashes", domainHashes)
        test("fixtures: unicode confusables", confusables)
        test("fixtures: png decompression bombs", pngBombs)
    }
}
