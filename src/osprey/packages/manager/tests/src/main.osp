namespace registry_tests;
import registry::Policy

/// The suites over the shared core, the host and the API.
fn behaviourSuites() = {
    BytesTests::run()
    NamesTests::run()
    SchemaTests::run()
    IdentityTests::run()
    PathsTests::run()
    JsonTests::run()
    ConformanceTests::run()
    SurfaceTests::run()
    Sha256Tests::run()
    ArithmeticTests::run()
    ReleasePathTests::run()
    BundleTests::run()
    CatalogTests::run()
    RouterTests::run()
}

/// The suites that interpret the declarative fixtures.
fn fixtureSuites() = {
    FixtureTests::run()
    SchemaCheckTests::run()
    CanonicalFixtureTests::run()
    VectorTests::run()
    GraphTests::run()
    TufTests::run()
    OrderTests::run()
    LoaderTests::run()
}

/// Every registry suite, in one process, under one arithmetic policy.
fn suites() = {
    behaviourSuites()
    fixtureSuites()
    0
}

fn main() = Policy::guarded(suites)
