namespace registry_tests;
import registry::JsonRead
import registry::Json
import registry::TypeDiagram
import registry::SchemaCheck

/// The typeDiagram schema validator, exercised through the declarative
/// fixtures under src/osprey/packages/manager/tests/fixtures/schema and .../time. `SchemaCheck`
/// pins the JSON encoding rules of [PACKAGE-TYPE-INVARIANTS] against the
/// canonical src/toolchain/schemas/package-registry.td, which is parsed once per test.
module SchemaCheckTests {
    /// The label of the parse checks the validator cases share.
    let diagramParses = "typeDiagram parses"
    /// The located refusal of a schema document that is no JSON.
    let nonIntegerAt = "json.non-integer@0"

    let schemaPath = "src/toolchain/schemas/package-registry.td"

    fn isAlias(decl) = match decl {
        TypeDiagram::Alias { _ } => true
        _ => false
    }

    fn isStruct(decl) = match decl {
        TypeDiagram::Struct { _ } => true
        _ => false
    }

    fn isUnion(decl) = match decl {
        TypeDiagram::Union { _ } => true
        _ => false
    }

    fn nameResolves(model, name) = match TypeDiagram::lookup(model, name) {
        Success => true
        Error => false
    }

    fn everyNameResolves(model) = foldList(declaredNames, true, fn(ok, name) => ok && nameResolves(model, name))

    let declaredNames = [
        "ScopeName", "PackageName", "CommitId", "Digest", "RelativePath", "LocalPath",
        "CompatibilityEpoch", "ReleaseOrdinal", "PrincipalId", "PackageKey", "SourceRef",
        "RepositoryBinding", "CredentialProof", "EnvelopeProof", "AuthorizationProof",
        "SignedRepositoryBinding", "ReleaseId", "CompatibilityClaim", "ReleaseIntent",
        "SignedReleaseIntent", "ReleaseChallenge", "SignedReleaseChallenge",
        "PublicationAuthorization", "SignedPublicationAuthorization", "ReleaseState",
        "ActivationState", "ReleaseStatus", "DependencyRequirement", "DependencyGrant", "SystemRequirement",
        "PackageAssetKind", "PackageAssetRole", "PackageAsset", "DependencyEdge",
        "PackageDiscoveryMetadata", "SourceFlavor", "PublishedPackageMetadata",
        "PackageManifest", "DependencySelectionRef", "ModulePlanEntry",
        "ModuleGraphProjection", "CompilerInvocationProjection", "TestPlanEntry",
        "TestPlanProjection", "OutputArtifactKind", "OutputArtifact", "OutputLayoutProjection",
        "BuildPlan", "ReleaseIdentityEnvelope", "Release", "LocalOverride",
        "DevelopmentOverlay", "ProviderCatalogEntry", "LockedSystemInput",
        "LockedBuildEnvironment", "ResolutionContext", "TufRoleState", "LogCheckpoint",
        "MerkleInclusionProof", "MerkleConsistencyProof", "WitnessReceipt",
        "VerificationBundle", "VerificationStatus", "LockedRoot", "DevelopmentRoot",
        "LockedReleasePackage", "LockedDevelopmentPackage", "DevelopmentBuildInput",
        "DevelopmentBuildReceipt", "SignedDevelopmentBuildReceipt", "ResolutionDecision",
        "ResolutionProof", "DependencySelectionRoot", "ReleaseDependencySelection",
        "ReleaseLockfile", "DevelopmentLockfile", "DevelopmentStateGeneration",
        "WorkspaceTransaction", "ScanVerdict", "Evidence", "MaintenanceAssessment",
        "DiscoveryAssessment", "ReleaseAssessment",
        "AuthorityEpoch",
        "PrincipalKind", "HumanPrincipalKind", "PrincipalState", "OrganizationState", "OrganizationRole",
        "AccessState", "ActiveMembershipState", "OrganizationRecoveryAuthority", "RegistryPackageState", "PackagePermission",
        "AdminTransferState", "InvitationState", "MaintenanceReportState", "RegistryPrincipal",
        "PublicCatalogRelease", "PublicCatalogEntry", "PublicCatalogPage", "PendingLogin", "RegistryAuthBinding", "Organization", "OrganizationMembership", "RegistryPackage",
        "PackagePermissionGrant", "PackageAdminTransfer", "OrganizationInvitation",
        "PackageMaintenanceReport", "GovernanceEventKind", "GovernanceEvent"
    ]

    fn modelLoads() = {
        let result = TypeDiagram::parse(readFile(schemaPath) ?: "")
        match result {
            Success { value } => checkAll("schema model declares every type exactly once", [
                    structuralEquals([length(value.decls), length(filterList(value.decls, isAlias))], [112, 10]),
                    length(filterList(value.decls, isStruct)) == 75,
                    length(filterList(value.decls, isUnion)) == 27,
                    everyNameResolves(value)
            ])
            Error { message } => check(diagramParses, "ok", message)
        }
    }

    fn validated(model, typeName, value) = match SchemaCheck::validate(model, typeName, value) {
        Success => true
        Error => false
    }

    fn rejectionOk(model, case) = match SchemaCheck::validate(model, Fixtures::textOf(case, "type"), JsonRead::field(case, "value")) {
        Error { message } => message == "${Fixtures::textOf(case, "code")} at ${Fixtures::textOf(case, "at")}"
        Success => false
    }

    fn accepts() = {
        let result = TypeDiagram::parse(readFile(schemaPath) ?: "")
        match result {
            Success { value } => {
                let fx = Fixtures::load("schema/accepts.json")
                Fixtures::report("schema accepts", Fixtures::itemsOf(fx, "cases"), fn(c) => validated(value, Fixtures::textOf(c, "type"), JsonRead::field(c, "value")))
            }
            Error { message } => check(diagramParses, "ok", message)
        }
    }

    fn rejections() = {
        let result = TypeDiagram::parse(readFile(schemaPath) ?: "")
        match result {
            Success { value } => {
                let fx = Fixtures::load("schema/rejections.json")
                Fixtures::report("schema rejections", Fixtures::itemsOf(fx, "cases"), fn(c) => rejectionOk(value, c))
            }
            Error { message } => check(diagramParses, "ok", message)
        }
    }

    fn datetimes() = {
        let fx = Fixtures::load("time/datetimes.json")
        Fixtures::report("datetimes valid", Fixtures::itemsOf(fx, "valid"), fn(c) => SchemaCheck::dateTimeCode(Fixtures::textOf(c, "text")) == "")
        Fixtures::report("datetimes invalid", Fixtures::itemsOf(fx, "invalid"), fn(c) => SchemaCheck::dateTimeCode(Fixtures::textOf(c, "text")) == "schema.datetime")
    }

    fn floatProblem(text) = match Json::parse(text) {
        Error { message } => message
        Success => "ok"
    }

    fn floats() = checkAll("non-integer numbers are parse-level rejections", [
            structuralEquals([floatProblem("1.5"), floatProblem("1e3")], [nonIntegerAt, nonIntegerAt]),
            floatProblem("0.0") == nonIntegerAt
    ])

    fn declarationCount(text) = match TypeDiagram::parse(text) {
        Success { value } => length(value.decls)
        Error => -1
    }

    fn tokenizerBounds() = checkAll("tokenization has bounded stack depth", [
            declarationCount((repeat(" ", 100000) ?: "") + "typeDiagram alias A = String") == 1,
            declarationCount("typeDiagram alias " + (repeat("a", 100000) ?: "") + " = String") == 1,
            declarationCount("typeDiagram type Box{items:List<Option<String>>}") == 1,
            declarationCount("typeDiagram\n# type Pretend { }\nalias A = String # hidden\ntype B { value: A }") == 2
    ])

    /// Every schema-check case, run from the shared registry test entry.
    export fn run() = {
        test("schema-check: model declarations", modelLoads)
        test("schema-check: accepted values", accepts)
        test("schema-check: rejected values", rejections)
        test("schema-check: datetime grammar", datetimes)
        test("schema-check: floats are parse-level", floats)
        test("schema-check: long whitespace and identifiers", tokenizerBounds)
    }
}
