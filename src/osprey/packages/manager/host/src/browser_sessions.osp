namespace registry_host;
import registry::Bytes
import registry::Digests

/// Database half of [PACKAGE-HOSTED-AUTH]. The API sends only hashed browser cookies
/// and encrypted provider tokens. The identity parameters come from provider verification.
module BrowserSessions {
    let invalidIdentity = "auth.session-identity"
    fn binding(issuer, subject, github) = "b.issuer=${issuer} AND b.auth_subject=${subject} AND b.provider_subject=${github}"
    let eligibility = "b.provider='github' AND b.state='active' AND p.kind='human' AND p.state='active'"
    let live = "s.revoked_at IS NULL AND s.started_at<=statement_timestamp() AND s.started_at>statement_timestamp()-interval '12 hours' AND s.last_used_at<=clock_timestamp() AND s.last_used_at>statement_timestamp()-interval '30 minutes'"
    let samePrincipal = "p.id=s.principal_id AND p.credential_epoch=s.credential_epoch AND b.principal_id=s.principal_id"
    let principal = "registry.auth_bindings b JOIN registry.principals p ON p.id=b.principal_id"
    fn claims(cookie) = "s.cookie_digest=${cookie} AND b.id=s.binding_id AND " + samePrincipal + " AND " + eligibility + " AND " + live

    fn insert(cookie, issuer, subject, github, envelope) = "INSERT INTO registry.browser_sessions(id,cookie_digest,binding_id,principal_id,credential_epoch,token_envelope,started_at,last_used_at) SELECT gen_random_uuid(),${cookie},b.id,p.id,p.credential_epoch,${envelope},statement_timestamp(),statement_timestamp() FROM " + principal + " WHERE " + eligibility + " AND " + binding(issuer, subject, github) + " RETURNING id"

    /// Issue only for an approved and active binding, never by email or provider username.
    export fn issue() = insert("$1", "$2", "$3", "$4", "$5")

    fn validIdentity(issuer, subject, github) = startsWith(issuer, "https://") && endsWith(issuer, "/auth/v1")
        && byteLength(issuer) <= 320 && Bytes::canonicalUuid(subject)
        && byteLength(github) > 0 && byteLength(github) <= 32 && !startsWith(github, "0") && Bytes::everyByte(github, Bytes::isDigit)

    fn boundInsert(values, envelope) = {
        let query = insert(Database::decoded(1), Database::decoded(2), Database::decoded(3) + "::uuid", Database::decoded(4), Database::decoded(5))
        Success { value: Database::sessionIssueScript(values, query, listAppend(values, envelope)) }
    }

    /// Bind values through the extended protocol before an authenticated session exists.
    export fn issueScript(cookie, issuer, subject, github, envelope) = match Digests::parse(cookie) {
        Error { message } => Error { message: message }
        Success => if !validIdentity(issuer, subject, github) || byteLength(envelope) < 1 || byteLength(envelope) > 65536 {
            Error { message: invalidIdentity }
        } else { boundInsert([cookie, issuer, subject, github], envelope) }
    }

    export fn save(cookie, issuer, subject, github, envelope) =
        andThen(issueScript(cookie, issuer, subject, github, envelope), Database::issueSession)

    /// Get the envelope for provider verification. A lookup never extends inactivity.
    export fn lookup() = "SELECT s.token_envelope FROM registry.browser_sessions s," + principal + " WHERE " + claims("$1")

    fn revalidated(cookie, issuer, subject, provider) = "UPDATE registry.browser_sessions s SET last_used_at=GREATEST(s.last_used_at,statement_timestamp()) FROM " + principal
        + " WHERE " + claims(cookie)
        + " AND " + binding(issuer, subject, provider) + " RETURNING s.id,s.principal_id,s.credential_epoch"

    /// Recheck the verified provider identity and revocation in the update that accepts the session.
    export fn touch() = revalidated("$1", "$2", "$3", "$4")

    /// Reading a cookie-scoped encrypted envelope does not authenticate the browser or extend inactivity.
    export fn readScript(cookie) = andThen(Digests::parse(cookie), fn(_) => Success { value: Database::sessionRuntimeScript(
        [cookie, "", "", ""], "SELECT token_envelope FROM registry.browser_sessions WHERE cookie_digest=" + Database::decoded(1), [cookie]) })

    export fn touchScript(cookie, issuer, subject, github) = andThen(Digests::parse(cookie), fn(_) =>
        if validIdentity(issuer, subject, github) { verifiedScript([cookie, issuer, subject, github]) }
        else { Error { message: invalidIdentity } })

    fn verifiedScript(scope) = Success { value: Database::sessionRuntimeScript(scope,
        revalidated(Database::decoded(1), Database::decoded(2), Database::decoded(3) + "::uuid", Database::decoded(4)), scope) }

    export fn read(cookie) = andThen(readScript(cookie), Database::sessionRuntime)

    export fn revalidate(cookie, issuer, subject, github) = andThen(touchScript(cookie, issuer, subject, github), Database::sessionRuntime)

    fn refreshPredicate() = claims(Database::decoded(1))
        + " AND " + binding(Database::decoded(2), Database::decoded(3) + "::uuid", Database::decoded(4))
        + " AND 'sha256:' || encode(sha256(convert_to(s.token_envelope,'UTF8')), 'hex')=" + Database::decoded(5)

    fn refreshScript(scope, args, update, fence, receipt) = Success { value: Database::sessionRuntimeScript(scope,
        "UPDATE registry.browser_sessions s SET " + update + " FROM " + principal + " WHERE " + refreshPredicate()
        + " AND " + fence + " RETURNING " + receipt, listConcat(scope, args)) }

    fn eligibleRefresh(cookie, issuer, subject, github, previous, work) = andThen(Digests::parse(cookie), fn(_) =>
        andThen(Digests::parse(previous), fn(_) => if validIdentity(issuer, subject, github) { work([cookie, issuer, subject, github]) }
            else { Error { message: invalidIdentity } }))

    /// Claim a token generation before rotating it at the provider.
    export fn claimRefreshScript(cookie, issuer, subject, github, previous) = eligibleRefresh(cookie, issuer, subject, github, previous, fn(scope) =>
        refreshScript(scope, [previous], "refresh_id=gen_random_uuid(),refresh_started_at=statement_timestamp()",
            "(s.refresh_started_at IS NULL OR s.refresh_started_at<=statement_timestamp()-interval '45 seconds')", "s.refresh_id"))

    /// Accept a replacement only from the current claim, before expiry and while the binding stays live.
    export fn finishRefreshScript(cookie, issuer, subject, github, previous, claim, envelope) =
        if !Bytes::canonicalUuid(claim) || byteLength(envelope) < 1 || byteLength(envelope) > 49152 { Error { message: "auth.refresh-storage" } }
        else { eligibleRefresh(cookie, issuer, subject, github, previous, fn(scope) =>
            refreshScript(scope, [previous, claim, envelope], "token_envelope=" + Database::decoded(7) + ",refresh_id=NULL,refresh_started_at=NULL",
                "s.refresh_id=" + Database::decoded(6) + "::uuid AND s.refresh_started_at>statement_timestamp()-interval '45 seconds'", "s.id")) }

    export fn claimRefresh(cookie, issuer, subject, github, previous) =
        andThen(claimRefreshScript(cookie, issuer, subject, github, previous), Database::sessionRuntime)

    export fn finishRefresh(cookie, issuer, subject, github, previous, claim, envelope) =
        andThen(finishRefreshScript(cookie, issuer, subject, github, previous, claim, envelope), Database::sessionRuntime)

    fn markRevoked(cookie) = "UPDATE registry.browser_sessions SET revoked_at=GREATEST(last_used_at,statement_timestamp()),token_envelope=NULL WHERE cookie_digest=${cookie} AND revoked_at IS NULL RETURNING id"

    export fn revoke() = markRevoked("$1")

    /// Logout remains possible if the binding or provider is unavailable.
    export fn revokeScript(cookie) = andThen(Digests::parse(cookie), fn(_) =>
        Success { value: Database::sessionRevokeScript(cookie, markRevoked(Database::decoded(1))) })

    export fn logout(cookie) = andThen(revokeScript(cookie), Database::sessionRevoker)
}
