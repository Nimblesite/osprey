namespace registry;
import registry::Checked
import registry::Json
import registry::Canonical
import registry::Digests
import registry::Domains
import registry::Maybe
import registry::ManifestModel

/// The canonical JSON projection of a manifest and its `manifestDigest`.
/// Records become objects, unions one-member objects, absent options vanish.
/// Implements the JSON encoding and `H("osprey.manifest.v1", manifest)` of
/// [PACKAGE-TYPE-INVARIANTS].
module ManifestJson {
    fn strings(items) = Json::Arr { items: mapList(items, Json::str) }
    fn variant(name, payload) = Json::obj([Json::member(name, payload)])
    fn empty() = Json::obj([])

    /// The `{name, scope}` object of a package key.
    export fn key(k) = Json::obj([Json::member("name", Json::str(k.name)), Json::member("scope", Json::str(k.scope))])

    // `requirementJson` avoids shadowing the `requirement` field bound by the
    // edge patterns below (a bound value is not a function).
    export fn requirementJson(r) = Json::obj([Json::member("epoch", Json::num(r.epoch)), Json::member("minimumOrdinal", Json::num(r.minimumOrdinal)), Json::member("package", key(r.package))])

    /// One Runtime/Build/Test edge as its one-member union object.
    export fn edge(e) = match e {
        ManifestModel::Runtime { requirement } => variant("Runtime", Json::obj([Json::member("requirement", requirementJson(requirement))]))
        ManifestModel::Build { requirement } => variant("Build", Json::obj([Json::member("requirement", requirementJson(requirement))]))
        ManifestModel::Test { requirement } => variant("Test", Json::obj([Json::member("requirement", requirementJson(requirement))]))
    }

    /// An edge list as the `dependencies` array the lock and the manifest share.
    export fn dependenciesJson(edges) = Json::arr(mapList(edges, edge))

    fn system(s) = Json::obj([Json::member("capability", Json::str(s.capability)), Json::member("minimumRevision", Json::num(s.minimumRevision))])

    fn grant(g: ManifestModel::Grant) = Json::obj([Json::member("capabilities", strings(g.capabilities)), Json::member("package", key(g.package))])

    // `kindJson` avoids shadowing the `kind` field bound by the role patterns below.
    fn kindJson(k) = variant(ManifestModel::kindName(k), empty())

    fn role(r) = match r {
        ManifestModel::Documentation { kind } => variant("Documentation", Json::obj([Json::member("kind", kindJson(kind))]))
        ManifestModel::RuntimeData { kind, requiredCapability } => variant("RuntimeData", Json::obj([Json::member("kind", kindJson(kind)), Json::member("requiredCapability", Json::str(requiredCapability))]))
    }

    fn asset(a: ManifestModel::Asset) = Json::obj([Json::member("byteLength", Json::num(a.byteLength)), Json::member("digest", Json::str(a.digest)), Json::member("path", Json::str(a.path)), Json::member("role", role(a.role))])

    fn discovery(d) = Json::obj([Json::member("keywords", strings(d.keywords)), Json::member("summary", Json::str(d.summary))])

    fn publication(p: ManifestModel::Publication) = Json::obj([Json::member("discovery", discovery(p.discovery)), Json::member("licenseExpression", Json::str(p.licenseExpression)), Json::member("package", key(p.package))])

    fn flavor(f) = variant(ManifestModel::flavorName(f), empty())

    fn optional(name, maybe, encode) = Maybe::fold(maybe, [], fn(value) => [Json::member(name, encode(value))])

    fn required(m: ManifestModel::Manifest) = [
        Json::member("allowWildcardImports", Json::Bool { flag: m.allowWildcardImports }),
        Json::member("assets", Json::Arr { items: mapList(m.assets, asset) }),
        Json::member("dependencies", Json::Arr { items: mapList(m.dependencies, edge) }),
        Json::member("grants", Json::Arr { items: mapList(m.grants, grant) }),
        Json::member("projectName", Json::str(m.projectName)),
        Json::member("sourceRoots", strings(m.sourceRoots)),
        Json::member("systemRequirements", Json::Arr { items: mapList(m.systemRequirements, system) }),
        Json::member("testRoots", strings(m.testRoots)),
        Json::member("pythonSources", strings(m.pythonSources))
    ]

    fn optionals(m: ManifestModel::Manifest) = listConcat(listConcat(listConcat(
        optional("defaultNamespace", m.defaultNamespace, Json::str),
        optional("entry", m.entry, Json::str)),
        optional("flavor", m.flavor, flavor)),
        optional("publication", m.publication, publication))

    /// The JSON value; member order is irrelevant because serialization sorts.
    export fn toJson(manifest) = Json::obj(listConcat(required(manifest), optionals(manifest)))

    /// The RFC 8785 bytes of the manifest.
    export fn canonical(manifest) = Canonical::serialize(toJson(manifest))

    /// `H("osprey.manifest.v1", manifest)`.
    export fn digest(manifest) = Checked::andThen(canonical(manifest), fn(value) => Success { value: Digests::hashText(Domains::manifestDomain(), value) })
}
