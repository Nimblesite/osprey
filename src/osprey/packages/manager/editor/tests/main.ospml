namespace registry_editor

// Drives the package editor through the typed host event boundary every host
// calls ([NATIVE-SHM-EVENT]): controls are found by their labels, rows by
// their keys, completions use the tickets the surface issued, and every read
// is the typed store, the rendered rows, or the typed requests of the last
// step. The CLI and registry fixtures arrive as completion text, as they do
// from a real host.

import ui::Doc
import ui::Hosting
import ui::Lists
import ui::LowerLeaves
import ui::Runtime
import uitest::Drive
import uitest::Views

workspace = "file:///work/app"
loopback = "http://127.0.0.1:8787"
hosted = "https://registry.example.test"
unverified = "No findings recorded; audit status unverified"
cve = "CVE-2026-0002: unsafe native call"

// ---- the host fixtures: the CLI and registry output as completion text ----

catalogItem (key, epoch, ordinal, findings) = JsonObject [
    Doc::str ("key", key),
    JsonMember "releases" (JsonArray (listPrepend [] (JsonObject [Doc::num ("epoch", epoch), Doc::num ("ordinal", ordinal)]))),
    JsonMember "findings" (Doc::strings findings),
]

catalogDoc () = JsonObject [JsonMember "packages" (JsonArray ([
    catalogItem ("@demo/report", 1, 1, []),
    catalogItem ("@demo/new", 2, 0, []),
    catalogItem ("@demo/risky", 2, 3, [cve]),
]))]

packageJson (key, version, direct, present, dependencies, dependents, findings) = JsonObject [
    Doc::str ("key", key),
    Doc::str ("version", version),
    Doc::str ("digest", "sha256:${key}"),
    Doc::bit ("direct", direct),
    Doc::bit ("present", present),
    JsonMember "dependencies" (Doc::strings dependencies),
    JsonMember "dependents" (Doc::strings dependents),
    JsonMember "findings" (Doc::strings findings),
]

graphDoc findings = JsonObject [
    Doc::str ("project", workspace),
    JsonMember "direct" (Doc::strings (["@demo/report"])),
    JsonMember "packages" (JsonArray ([
        packageJson ("@demo/report", "e1.r1", true, true, ["@demo/base"], [], []),
        packageJson ("@demo/base", "e1.r0", false, true, [], ["@demo/report"], [cve]),
        packageJson ("@demo/ghost", "e1.r2", false, false, [], [], []),
    ])),
    JsonMember "findings" (Doc::strings findings),
]

graphResult findings = Doc::write (JsonObject [
    JsonMember "lines" (JsonArray ([JsonString (Doc::write (graphDoc findings))])),
    Doc::num ("status", 0),
])

// ---- driving the surface ----

fresh () = Drive::idle (App::program (), Store::create ("", ""))

// The editor is launched with the workspace URI and registry URL as arguments.
started registry = Runtime::guarded (\() => Drive::launched (fresh (), "vscode", [workspace, registry]))

walkOf d = Runtime::guarded (\() => ui::Surfaces::seen (d.drivenSurface, d.drivenProgram))

// The regions the program draws, as the boundary lowered them, and one region walked alone.
regionsOf d = Runtime::guarded (\() => (App::program ()).programRender (storeOf d, storeOf d, [], []))

regionNode (d, key) = match Lists::find (regionsOf d, \region => region.snapshotKey == key)
    Error _ => ui::Spacer
    Success region => region.snapshotValue

regionWalk (d, key) = Runtime::guarded (\() => ui::Views::drawn (ui::Lower::view (ui::Styling(styleTheme = (App::program ()).programTheme (storeOf d), styleDark = false, styleRegions = regionsOf d), regionNode (d, key))))

styled walk = uitest::Read::seen (walk, [])

// The control of `kind` labelled `label`, as a host reaches it: a button or tab is a press, a field an entry.
controlOf (walk, kind, label) = match Lists::find (walk.walkRows, \row => row.placedKind == kind && row.placedWords == label)
    Error _ => 0 - 1
    Success row => row.placedAction

deliver (d, found, words) = match found < 0
    true =>
        print "# no control ${words}"
        d
    false => Runtime::guarded (\() => Drive::sent (d, ui::Touch(touchNow = d.drivenNow, touchKind = Hosting::control, touchOrdinal = found, touchWords = words, touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = false, touchShift = false)))

press (d, label) = deliver (d, controlOf (walkOf d, ui::Views::press, label), "")

chooseTyped (d, label, words) = deliver (d, controlOf (walkOf d, ui::Views::press, label), words)

completedWith (d, ticket, ok, text) = Runtime::guarded (\() => Drive::completed (d, ticket, ok, text))

// The fit that carries a row's key, and the press layered over that row's cell.
rowFit (d, key) = Lists::find ((walkOf d).walkFits, \fit => fit.fittedAs.hint == key)

isRowPress (parent, row) = match row.placedParent == parent && row.placedAction >= 0
    true => Success(value = row)
    false => Error(message = "no press in the row")

kept (found, next) = match found
    Error _ => next
    Success _ => found

rowPress (d, key) = match rowFit (d, key)
    Error _ => Error(message = "no row ${key}")
    Success fit => foldList ((walkOf d).walkRows, Error(message = "no row ${key}"), \(found, row) => kept (found, isRowPress (fit.fittedRow, row)))

// Choosing a row delivers its key through the press layered over its cell.
pick (d, key) = match rowPress (d, key)
    Error problem =>
        print "# ${problem}"
        d
    Success row => deliver (d, row.placedAction, key)

// ---- reading the last step ----

storeOf d = d.drivenSurface.surfaceSession.sessionStore

ticketsOf d = d.drivenSurface.surfaceAsked

ticketAt (d, index) = match listGet (ticketsOf d) index
    Success request => request.ticket
    Error _ => ""

stdinText (header) = match header.headerName == "stdin"
    true => header.headerValue
    false => ""

stdinOf request = match request.capability
    ui::HostCall _ _ arguments _ _ _ => join (filterList (mapList (arguments, \header => stdinText (header)), \value => value != "")) ""
    _ => ""

requestCount d = length (ticketsOf d)

problemsOf d = d.drivenSurface.surfaceProblem

// What one region shows, as the host that region's tree was sent reads it.
regionTexts (d, key) = Views::texts (styled (regionWalk (d, key)))

showsIn (d, key, part) = expect (contains (regionTexts (d, key)) part, true)

hidesIn (d, key, part) = expect (contains (regionTexts (d, key)) part, false)

// A pair's value: the wording beside its label inside the pair's line.
isPairValue (parent, label, row) = match row.placedParent == parent && row.placedKind == ui::Views::label && row.placedWords != "" && row.placedWords != label
    true => Success(value = row.placedWords)
    false => Error(message = "not the value")

pairValue (walk, label) = match Lists::find (walk.walkRows, \row => row.placedWords == label)
    Error _ => ""
    Success named => match foldList (walk.walkRows, Error(message = "none"), \(found, row) => kept (found, isPairValue (named.placedParent, label, row)))
        Success value => value
        Error _ => ""

expectEvidence (d, key, cases) = forEachList (cases, \c => expect (pairValue (regionWalk (d, key), c.label), c.want))

themeOf d = (App::program ()).programTheme (storeOf d)

toneInk (d, name) = LowerLeaves::inkNamed (themeOf d, false, name)

// A control's ink and enabled state, read from the region that drew it.
regionControl (d, key, label) = uitest::Views::control (styled (regionWalk (d, key)), label)

inkOf (d, key, label) = (regionControl (d, key, label)).controlInk

hasTone (d, key, name) = Lists::any ((regionWalk (d, key)).walkRows, \row => row.placedLook.ink == toneInk (d, name))

// ---- control flows ----

cataloguedIn (d) = completedWith (d, ticketAt (d, 0), true, Doc::write (catalogDoc ()))

graphIn (d, result) = completedWith (cataloguedIn (d), ticketAt (d, 1), true, result)

completeBoth (d, findings) = graphIn (d, graphResult findings)

chosenIn (d, key) = pick (chooseTyped (d, "Browse registry", "browse"), key)

catalogDetail (registry, key) = chosenIn (completeBoth (started registry, []), key)

expectDetailButton (d, label, want) = expect ((regionControl (d, "details", label)).controlEnabled, want)

expectNoRequest d = expect (requestCount d, 0)

expectNotice (d, part) = expect (contains (storeOf d).packageNotice part, true)

askAdd d = press (d, "Add to project")

awaitingConfirmation (d, ask, mode) =
    asked = press (d, ask)
    expectNoRequest asked
    expect ((storeOf asked).packageConfirming, mode)
    asked

oneRequest (d, want) =
    expect (requestCount d, 1)
    match listGet (ticketsOf d) 0
        Success request => expect (contains (stdinOf request) want, true)
        Error _ => expect (true, false)

confirmRemove (d, key) = oneRequest (press (d, "Confirm remove ${key}"), "remove ${key}")

missingFooter () =
    after = completeBoth (started loopback, ["tree.no-lock"])
    hidesIn (after, "packages", "installed ·")
    showsIn (after, "packages", "Installed counts unavailable")

installedCounts () =
    after = completeBoth (started loopback, [])
    expectEvidence (after, "root", [
        { label = "Installed", want = "2" },
        { label = "Direct", want = "1" },
        { label = "Missing", want = "1" },
    ])
    hidesIn (after, "packages", "@demo/ghost")
    showsIn (after, "root", "@demo/ghost · missing from disk")
    showsIn (after, "root", workspace)
    expect (inkOf (after, "root", "Audit unverified"), toneInk (after, "caution"))

emptyFindings () =
    chosen = catalogDetail (loopback, "@demo/new")
    expect (inkOf (chosen, "details", unverified), toneInk (chosen, "caution"))
    showsIn (chosen, "details", unverified)
    showsIn (chosen, "details", "requires explicit confirmation")
    hidesIn (chosen, "details", "Audited")
    expect (hasTone (chosen, "details", "good"), false)
    expectDetailButton (chosen, "Add to project", true)

missingDirect () =
    first = started loopback
    graph = JsonObject [Doc::str ("project", workspace), JsonMember "direct" (Doc::strings ["@demo/ghost"]), JsonMember "findings" (Doc::strings []), JsonMember "packages" (JsonArray [packageJson ("@demo/ghost", "e1.r2", true, false, [], [], ["verify.missing"])])]
    report = Doc::write (JsonObject [Doc::num ("status", 0), JsonMember "lines" (Doc::strings [Doc::write graph])])
    ready = graphIn (first, report)
    chosen = pick (ready, "@demo/ghost")
    showsIn (chosen, "details", "verify.missing")
    expect (inkOf (chosen, "details", "Missing from disk"), toneInk (chosen, "caution"))
    expectDetailButton (chosen, "Remove dependency", true)
    confirmRemove (press (chosen, "Remove dependency"), "@demo/ghost")

recordedFindings () =
    chosen = catalogDetail (loopback, "@demo/risky")
    showsIn (chosen, "details", cve)
    expect (inkOf (chosen, "details", "1 findings"), toneInk (chosen, "danger"))
    expectDetailButton (chosen, "Add to project", false)

unverifiedAdd () =
    first = started loopback
    catalogued = cataloguedIn (first)
    // While the graph is still outstanding the frame offers no add control at all, so pending work blocks the add.
    expect (Views::shows (catalogued.drivenSeen, "Add to project"), false)
    expect ((storeOf catalogued).packagePending, true)
    expect ((storeOf catalogued).packageConfirming, "")
    expectNoRequest catalogued
    expect (problemsOf catalogued, "")
    resolved = completedWith (catalogued, ticketAt (first, 1), true, graphResult [])
    chosen = chosenIn (resolved, "@demo/new")
    asked = awaitingConfirmation (chosen, "Add to project", "add")
    showsIn (asked, "details", "Confirm add @demo/new")
    expectDetailButton (asked, "Confirm add @demo/new", true)

confirmedAdd () =
    first = started loopback
    chosen = chosenIn (completeBoth (first, []), "@demo/new")
    confirmed = press (askAdd chosen, "Confirm add @demo/new")
    oneRequest (confirmed, "add @demo/new")
    expect (contains (ticketAt (confirmed, 0)) "package/add:2", true)
    before = storeOf confirmed
    stale = completedWith (confirmed, ticketAt (first, 0), true, "{\"packages\":[]}")
    expect (structuralEquals (storeOf stale) before, true)
    expect (problemsOf stale, "")
    expectNotice (stale, "add @demo/new")

hostedAdd () =
    chosen = catalogDetail (hosted, "@demo/new")
    expectDetailButton (chosen, "Add to project", false)
    refused = askAdd chosen
    expectNoRequest refused
    expect ((storeOf refused).packageFault, true)
    expectNotice (refused, "installation is disabled")
    showsIn (refused, "root", "installation is disabled")
    expect ((storeOf refused).packageConfirming, "")

removeDirect () =
    chosen = pick (completeBoth (started loopback, []), "@demo/report")
    asked = awaitingConfirmation (chosen, "Remove dependency", "remove")
    showsIn (asked, "details", "Removing @demo/report")
    showsIn (asked, "details", workspace)
    confirmRemove (asked, "@demo/report")

securityFindings () =
    after = completeBoth (started loopback, [cve])
    chosen = pick (after, "@demo/base")
    showsIn (chosen, "details", cve)
    expect (hasTone (chosen, "details", "danger"), true)
    showsIn (after, "root", "Workspace security findings")
    showsIn (after, "root", cve)

unavailableData () =
    first = started loopback
    expectEvidence (first, "root", [{ label = "Installed", want = "" }])
    showsIn (first, "root", workspace)
    failed = completedWith (first, ticketAt (first, 1), false, "Package executable is missing")
    expectEvidence (failed, "root", [{ label = "Installed", want = "" }, { label = "Catalog", want = "" }])
    showsIn (failed, "root", "Package data unavailable")
    showsIn (failed, "root", workspace)

verifiedFetch () =
    selected = catalogDetail (loopback, "@demo/new")
    asked = askAdd selected
    confirmed = press (asked, "Confirm add @demo/new")
    report = "{\"lines\":[],\"status\":0}"
    added = completedWith (confirmed, ticketAt (confirmed, 0), true, report)
    oneRequest (added, "--json fetch --registry")
    expect ((storeOf added).packagePending, true)
    fetched = completedWith (added, ticketAt (added, 0), true, report)
    expect (requestCount fetched, 2)
    failed = completedWith (added, ticketAt (added, 0), true, "{\"lines\":[\"Digest mismatch\"],\"status\":1}")
    expectNoRequest failed
    expect ((storeOf failed).packagePending, false)
    expect ((storeOf failed).packageFault, true)
    showsIn (failed, "root", "Digest mismatch")
    expect (pairValue (regionWalk (failed, "root"), "Installed"), "")

exactTests [
    { name = "missing workspace graph never reports zero installed in the package footer", work = missingFooter },
    { name = "installed counts only present entries while missing lock entries warn", work = installedCounts },
    { name = "empty findings read as unverified caution and never as an audit", work = emptyFindings },
    { name = "missing direct dependencies can be inspected and removed without hiding findings", work = missingDirect },
    { name = "recorded findings are visible danger warnings that block adding", work = recordedFindings },
    { name = "a local unverified add needs explicit confirmation and pending work blocks it", work = unverifiedAdd },
    { name = "confirming a local add issues one change request and stale completions are ignored", work = confirmedAdd },
    { name = "hosted unverified installs are blocked with a visible warning", work = hostedAdd },
    { name = "removing a direct dependency warns and names the project before confirming", work = removeDirect },
    { name = "installed and workspace security findings stay visible", work = securityFindings },
    { name = "unavailable package data hides counts and keeps the selected project", work = unavailableData },
    { name = "add waits for verified fetch before refreshing installed packages", work = verifiedFetch }
]


