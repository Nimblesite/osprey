namespace registry_editor

// Drives the real App.start/App.dispatch entry points. Control events use the
// ordinal and revision the runtime issued in the previous envelope, and
// completions use the tickets it issued, never fabricated identifiers.

import ui::Doc
import ui::Lists

workspace = "file:///work/app"
loopback = "http://127.0.0.1:8787"
hosted = "https://registry.example.test"
unverified = "No findings recorded; audit status unverified"
cve = "CVE-2026-0002: unsafe native call"

quote value = match jsonQuote value
    Success text => text
    Error _ => "null"

launchContext (project, registry) = JsonObject [
    Doc::num ("now", 1),
    Doc::num ("offset", 0),
    Doc::str ("platform", "vscode"),
    Doc::str ("home", "/work"),
    JsonMember "arguments" (Doc::strings ([project, registry])),
]

itemsOf (doc, key) = Doc::items (Doc::field (doc, key))

branchOf (doc, key) = mapList (itemsOf (doc, key), \item => Doc::field (item, "child"))

kids doc = listConcat (itemsOf (doc, "children")) (listConcat (itemsOf (doc, "panes")) (listConcat (itemsOf (doc, "toolbar")) (listConcat (itemsOf (doc, "items")) (listConcat (branchOf (doc, "tabs")) (listConcat (branchOf (doc, "rows")) (mapList (filterList (["body", "pane", "aside", "child"], \key => Doc::has (doc, key)), \key => Doc::field (doc, key))))))))

findNode : (Json, (Json) -> bool) -> Result<Json, Error>
findNode (doc, matches) = match matches doc
    true => Success(value = doc)
    false => findIn (kids doc, matches)

nextFound (found, node, matches) = match found
    Success _ => found
    Error _ => findNode (node, matches)

findIn (nodes, matches) = foldList (nodes, Error(message = "not found"), \(found, node) => nextFound (found, node, matches))

patchOf (envelope, region) = Lists::find (Doc::items (Doc::field (envelope, "patches")), \item => Doc::text (item, "key") == region)

revisionOf (envelope, region) = match patchOf (envelope, region)
    Success patch => Doc::number (patch, "revision")
    Error _ => 0

nodeOf (envelope, region) = match patchOf (envelope, region)
    Success patch => Doc::field (patch, "node")
    Error _ => JsonNull

controlAt (envelope, region, matches) = match patchOf (envelope, region)
    Error _ => Error(message = "region ${region} was not patched")
    Success patch => findNode (Doc::field (patch, "node"), matches)

controlOf (envelope, region, kind, label) = controlAt (envelope, region, \doc => Doc::text (doc, "kind") == kind && Doc::text (doc, "label") == label)

fieldOf (result, key) = match result
    Success node => Doc::text (node, key)
    Error _ => ""

ordinalOf result = match result
    Success node => Doc::number (node, "event")
    Error _ => 0 - 1

buttonEnabled (envelope, region, label) = match controlOf (envelope, region, "button", label)
    Success node => Doc::flag (node, "enabled")
    Error _ => false

badgeTone (envelope, region, label) = fieldOf (controlOf (envelope, region, "badge", label), "tone")

evidenceValue (envelope, region, label) = fieldOf (controlOf (envelope, region, "pair", label), "value")

hasTone (envelope, region, tone) = match controlAt (envelope, region, \doc => Doc::text (doc, "tone") == tone)
    Success _ => true
    Error _ => false

rowsNode (envelope, region, key) = controlAt (envelope, region, \doc => Doc::text (doc, "kind") == "rows" && Lists::any (mapList (itemsOf (doc, "rows"), \item => Doc::text (item, "key")), \item => item == key))

eventAt (envelope, region, ordinal, value) = "{\"kind\":\"ui\",\"region\":${quote region},\"revision\":${revisionOf (envelope, region)},\"ordinal\":${ordinal},\"value\":${value},\"now\":7}"

stateOf envelope = Doc::field (Doc::parse (Doc::text (envelope, "state")), "store")

requestCount envelope = length (Doc::items (Doc::field (envelope, "requests")))

ticketAt (envelope, index) = Doc::text (listGet (Doc::items (Doc::field (envelope, "requests"))) index ?: JsonNull, "ticket")

requestText (envelope, index) = Doc::write (listGet (Doc::items (Doc::field (envelope, "requests"))) index ?: JsonNull)

problemsOf envelope = join (Doc::texts (envelope, "diagnostics")) ";"

// Runs of reads that only their literals distinguish are tables: each case names
// the control and the value it must read.
expectShows (envelope, region, parts) = expect (containsAll (Doc::write (nodeOf (envelope, region))) parts, true)

expectHides (envelope, region, parts) = expect (containsNone (Doc::write (nodeOf (envelope, region))) parts, true)

expectEvidence (envelope, region, cases) = forEachList (cases, \c => expect (evidenceValue (envelope, region, c.label), c.want))

pick (envelope, region, key) = post (envelope, eventAt (envelope, region, ordinalOf (rowsNode (envelope, region, key)), quote key))

tap (envelope, region, label) = post (envelope, eventAt (envelope, region, ordinalOf (controlOf (envelope, region, "button", label)), "null"))

completed (ticket, result) = "{\"kind\":\"completed\",\"ticket\":${quote ticket},\"ok\":true,\"result\":${quote result},\"now\":9}"

catalogItem (key, epoch, ordinal, findings) = JsonObject [
    Doc::str ("key", key),
    JsonMember "releases" (JsonArray (listPrepend [] (JsonObject [Doc::num ("epoch", epoch), Doc::num ("ordinal", ordinal)]))),
    JsonMember "findings" (Doc::strings findings),
]

catalogDoc () = JsonObject [JsonMember "packages" (JsonArray ([
    catalogItem ("@demo/report", 1, 1, []),
    catalogItem ("@demo/new", 2, 0, []),
    catalogItem ("@demo/risky", 2, 3, [cve]),
]))]

packageJson (key, version, direct, present, dependencies, dependents, findings) = JsonObject [
    Doc::str ("key", key),
    Doc::str ("version", version),
    Doc::str ("digest", "sha256:${key}"),
    Doc::bit ("direct", direct),
    Doc::bit ("present", present),
    JsonMember "dependencies" (Doc::strings dependencies),
    JsonMember "dependents" (Doc::strings dependents),
    JsonMember "findings" (Doc::strings findings),
]

graphDoc findings = JsonObject [
    Doc::str ("project", workspace),
    JsonMember "direct" (Doc::strings (["@demo/report"])),
    JsonMember "packages" (JsonArray ([
        packageJson ("@demo/report", "e1.r1", true, true, ["@demo/base"], [], []),
        packageJson ("@demo/base", "e1.r0", false, true, [], ["@demo/report"], [cve]),
        packageJson ("@demo/ghost", "e1.r2", false, false, [], [], []),
    ])),
    JsonMember "findings" (Doc::strings findings),
]

graphResult findings = Doc::write (JsonObject [
    JsonMember "lines" (JsonArray ([JsonString (Doc::write (graphDoc findings))])),
    Doc::num ("status", 0),
])

startEnvelope registry = Doc::parse (App::start (Doc::write (launchContext (workspace, registry))))

post (envelope, event) = Doc::parse (App::dispatch (Doc::text (envelope, "state"), event))

completeBoth (envelope, findings) = graphIn (envelope, graphResult findings)

completedOn (envelope, result) = post (envelope, completedIn (envelope, 0, result))

cataloguedIn envelope = completedOn (envelope, Doc::write (catalogDoc ()))

graphIn (envelope, result) = post (cataloguedIn envelope, completedIn (envelope, 1, result))

completedIn (source, index, result) = completed (ticketAt (source, index), result)

// Control flows: reaching a package panel, asking for a change, confirming it.
// Each ladder of taps and the request it must issue is one call.
chosenIn (envelope, key) = pick (post (envelope, eventAt (envelope, "packages", ordinalOf (controlAt (envelope, "packages", \doc => Doc::text (doc, "kind") == "tabs")), quote "browse")), "packages", key)

catalogDetail (registry, key) = chosenIn (completeBoth (startEnvelope registry, []), key)

expectDetailButton (result, label, want) = expect (buttonEnabled (result, "details", label), want)

expectNoRequest result = expect (requestCount result, 0)

expectNotice (result, part) = expect (contains (Doc::text (stateOf result, "notice")) part, true)

askAdd result = tap (result, "details", "Add to project")

awaitingConfirmation (result, ask, mode) =
    asked = tap (result, "details", ask)
    expectNoRequest asked
    expect (Doc::text (stateOf asked, "confirming"), mode)
    asked

oneRequest (result, want) =
    expect (requestCount result, 1)
    expect (contains (requestText (result, 0)) want, true)

confirmRemove (result, key) = oneRequest (tap (result, "details", "Confirm remove ${key}"), "remove ${key}")

missingFooter () =
    after = completeBoth (startEnvelope loopback, ["tree.no-lock"])
    expectHides (after, "packages", ["installed ·"])
    expectShows (after, "packages", ["Installed counts unavailable"])

installedCounts () =
    after = completeBoth (startEnvelope loopback, [])
    expectEvidence (after, "root", [
        { label = "Installed", want = "2" },
        { label = "Direct", want = "1" },
        { label = "Missing", want = "1" },
    ])
    expectHides (after, "packages", ["@demo/ghost"])
    expectShows (after, "root", ["@demo/ghost · missing from disk", workspace])
    expect (badgeTone (after, "root", "Audit unverified"), "caution")

emptyFindings () =
    chosen = catalogDetail (loopback, "@demo/new")
    expect (badgeTone (chosen, "details", unverified), "caution")
    expectShows (chosen, "details", [unverified, "requires explicit confirmation"])
    expectHides (chosen, "details", ["Audited"])
    expect (hasTone (chosen, "details", "good"), false)
    expectDetailButton (chosen, "Add to project", true)

missingDirect () =
    first = startEnvelope loopback
    graph = JsonObject [Doc::str ("project", workspace), JsonMember "direct" (Doc::strings ["@demo/ghost"]), JsonMember "findings" (Doc::strings []), JsonMember "packages" (JsonArray [packageJson ("@demo/ghost", "e1.r2", true, false, [], [], ["verify.missing"])])]
    report = Doc::write (JsonObject [Doc::num ("status", 0), JsonMember "lines" (Doc::strings [Doc::write graph])])
    ready = graphIn (first, report)
    chosen = pick (ready, "root", "@demo/ghost")
    expectShows (chosen, "details", ["verify.missing"])
    expect (badgeTone (chosen, "details", "Missing from disk"), "caution")
    expectDetailButton (chosen, "Remove dependency", true)
    confirmRemove (tap (chosen, "details", "Remove dependency"), "@demo/ghost")

recordedFindings () =
    chosen = catalogDetail (loopback, "@demo/risky")
    expectShows (chosen, "details", [cve])
    expect (badgeTone (chosen, "details", "1 findings"), "danger")
    expectDetailButton (chosen, "Add to project", false)

unverifiedAdd () =
    first = startEnvelope loopback
    chosen = chosenIn (cataloguedIn first, "@demo/new")
    blocked = askAdd (chosen)
    expect (Doc::flag (stateOf blocked, "pending"), true)
    expect (Doc::text (stateOf blocked, "confirming"), "")
    expectNoRequest blocked
    expect (problemsOf blocked, "")
    resolved = post (chosen, completedIn (first, 1, graphResult []))
    asked = awaitingConfirmation (resolved, "Add to project", "add")
    expectShows (asked, "details", ["Confirm add @demo/new"])
    expectDetailButton (asked, "Confirm add @demo/new", true)

confirmedAdd () =
    first = startEnvelope loopback
    chosen = chosenIn (completeBoth (first, []), "@demo/new")
    confirmed = tap (askAdd (chosen), "details", "Confirm add @demo/new")
    oneRequest (confirmed, "add @demo/new")
    expect (contains (ticketAt (confirmed, 0)) "package/add:2", true)
    stale = post (confirmed, completedIn (first, 0, "{\"packages\":[]}"))
    expect (join (mapList (Doc::items (Doc::field (stale, "patches")), \item => Doc::text (item, "key"))) ",", "")
    expect (problemsOf stale, "")
    expectNotice (stale, "add @demo/new")

hostedAdd () =
    chosen = catalogDetail (hosted, "@demo/new")
    expectDetailButton (chosen, "Add to project", false)
    refused = askAdd (chosen)
    expectNoRequest refused
    expect (Doc::flag (stateOf refused, "fault"), true)
    expectNotice (refused, "installation is disabled")
    expectShows (refused, "root", ["installation is disabled"])
    expect (Doc::text (stateOf refused, "confirming"), "")

removeDirect () =
    chosen = pick (completeBoth (startEnvelope loopback, []), "packages", "@demo/report")
    asked = awaitingConfirmation (chosen, "Remove dependency", "remove")
    expectShows (asked, "details", ["Removing @demo/report", workspace])
    confirmRemove (asked, "@demo/report")

securityFindings () =
    after = completeBoth (startEnvelope loopback, [cve])
    chosen = pick (after, "packages", "@demo/base")
    expectShows (chosen, "details", [cve])
    expect (hasTone (chosen, "details", "danger"), true)
    expectShows (after, "root", ["Workspace security findings", cve])

unavailableData () =
    first = startEnvelope loopback
    expectEvidence (first, "root", [{ label = "Installed", want = "" }])
    expectShows (first, "root", [workspace])
    failure = "{\"kind\":\"completed\",\"ticket\":${quote (ticketAt (first, 1))},\"ok\":false,\"error\":\"Package executable is missing\",\"now\":9}"
    failed = post (first, failure)
    expectEvidence (failed, "root", [{ label = "Installed", want = "" }, { label = "Catalog", want = "" }])
    expectShows (failed, "root", ["Package data unavailable", workspace])

verifiedFetch () =
    selected = catalogDetail (loopback, "@demo/new")
    asked = askAdd (selected)
    confirmed = tap (asked, "details", "Confirm add @demo/new")
    report = "{\"lines\":[],\"status\":0}"
    added = completedOn (confirmed, report)
    oneRequest (added, "--json fetch --registry")
    expect (Doc::flag (stateOf added, "pending"), true)
    fetched = completedOn (added, report)
    expect (requestCount fetched, 2)
    failed = post (added, completed (ticketAt (added, 0), "{\"lines\":[\"Digest mismatch\"],\"status\":1}"))
    expectNoRequest failed
    expect (Doc::flag (stateOf failed, "pending"), false)
    expect (Doc::flag (stateOf failed, "fault"), true)
    expectShows (failed, "root", ["Digest mismatch"])
    expect (evidenceValue (failed, "root", "Installed"), "")

exactTests [
    { name = "missing workspace graph never reports zero installed in the package footer", work = missingFooter },
    { name = "installed counts only present entries while missing lock entries warn", work = installedCounts },
    { name = "empty findings read as unverified caution and never as an audit", work = emptyFindings },
    { name = "missing direct dependencies can be inspected and removed without hiding findings", work = missingDirect },
    { name = "recorded findings are visible danger warnings that block adding", work = recordedFindings },
    { name = "a local unverified add needs explicit confirmation and pending work blocks it", work = unverifiedAdd },
    { name = "confirming a local add issues one change request and stale completions are ignored", work = confirmedAdd },
    { name = "hosted unverified installs are blocked with a visible warning", work = hostedAdd },
    { name = "removing a direct dependency warns and names the project before confirming", work = removeDirect },
    { name = "installed and workspace security findings stay visible", work = securityFindings },
    { name = "unavailable package data hides counts and keeps the selected project", work = unavailableData },
    { name = "add waits for verified fetch before refreshing installed packages", work = verifiedFetch }
]
