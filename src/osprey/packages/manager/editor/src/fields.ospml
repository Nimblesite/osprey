namespace registry_editor
import ui::Doc

// The editor reads every command and registry document through these typed
// readers, so a missing or mistyped member names the document and the member
// in one message and no call site restates the shape check.

module Fields
    missing (label, key) = Error(message = "${label} is missing ${key}")

    /// Member `key` decoded by `decode`; `kind` names the JSON type it needs.
    reader (doc, key, label, decode, kind) = match jsonField doc key
        Error _ => missing (label, key)
        Success value => match decode value
            Error _ => Error(message = "${label} has a non-${kind} ${key}")
            Success found => Success(value = found)

    /// The text of member `key`, or `<label> is missing/has a non-string <key>`.
    export stringField (doc, key, label) = reader (doc, key, label, \value => jsonText value, "string")

    /// The integer of member `key`, or `<label> is missing/has a non-integer <key>`.
    export intField (doc, key, label) = reader (doc, key, label, \value => jsonInt value, "integer")

    /// The flag of member `key`, or `<label> is missing/has a non-boolean <key>`.
    export boolField (doc, key, label) = reader (doc, key, label, \value => jsonBool value, "boolean")
