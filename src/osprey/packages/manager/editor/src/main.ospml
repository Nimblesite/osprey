namespace app

import ui::Runtime
import ui::Views
import registry_editor::App
import registry_editor::Store

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<registry_editor::PackageState, registry_editor::Action> => Unit

initial () = Store::create ("", "")
program () = App::program ()

platform work =
    Runtime::guarded (\() => Views::shared work)
