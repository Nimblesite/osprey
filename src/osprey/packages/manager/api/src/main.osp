namespace registry_api;
import registry::Policy
import registry_host::Host
import registry_host::Native
import registry_api::Config
import registry_api::Server

/// `osprey-registry`: serve the folder registry named by `registry-server.json`
/// in the working directory. Implements [PACKAGE-FOLDER-REGISTRY].
fn run() = match Config::load() {
    Success { value } => Server::serve(value)
    Error { message } => {
        perform Host::Console.line("error: ${message}")
        1
    }
}

fn session() = Native::session(run)

fn main() = print("status: ${Policy::guarded(session)}")
