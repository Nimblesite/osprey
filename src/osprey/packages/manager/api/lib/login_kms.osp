namespace registry_api;
import registry::Bytes
import registry::Canonical
import registry::Dsse
import registry::Json
import registry::JsonRead

/// Cloud KMS protection for the server-held OAuth verifier and session tokens.
module LoginKms {
    let unavailable = "auth.encryption-unavailable"

    fn component(s) = byteLength(s) > 0 && byteLength(s) <= 63 && Bytes::everyByte(s, fn(b) =>
        Bytes::isAlnumIn(b, [Bytes::hyphen, Bytes::underscore]))

    export fn validKey(key) = match split(key, "/") {
        Success { value } => length(value) == 8
            && (listGet(value, 0) ?: "") == "projects" && (listGet(value, 2) ?: "") == "locations"
            && (listGet(value, 4) ?: "") == "keyRings" && (listGet(value, 6) ?: "") == "cryptoKeys"
            && foldList([1, 3, 5, 7], true, fn(ok, index) => ok && component(listGet(value, index) ?: ""))
        Error => false
    }

    fn b64(text) = Dsse::base64(Bytes::ofString(text))

    fn json(limit, reply: Supabase::Reply) = if reply.status == 200 && byteLength(reply.body) <= limit {
        match Json::parse(reply.body) {
            Success { value } => Success { value: value }
            Error => Error { message: unavailable }
        }
    } else { Error { message: unavailable } }

    fn field(doc, key) = JsonRead::text(JsonRead::field(doc, key))

    fn token(doc) = {
        let value = field(doc, "access_token")
        if field(doc, "token_type") == "Bearer" && byteLength(value) > 0 && byteLength(value) <= 4096
            && Bytes::everyByte(value, fn(b) => Bytes::isAlnumIn(b, [Bytes::dot, Bytes::hyphen, Bytes::underscore])) {
            Success { value: value }
        } else { Error { message: unavailable } }
    }

    fn envelopeOk(limit, value) = byteLength(value) > 0 && byteLength(value) <= limit && Bytes::everyByte(value, fn(b) => Bytes::isAlnumIn(b, [43, 47, 61]))

    fn ciphertext(limit, doc) = {
        let value = field(doc, "ciphertext")
        if envelopeOk(limit, value) {
            Success { value: value }
        } else { Error { message: unavailable } }
    }

    fn credentials() = andThen(perform Supabase::Provider.request("GET", "http://metadata.google.internal",
        "/computeMetadata/v1/instance/service-accounts/default/token", "Metadata-Flavor: Google", ""), fn(reply) => andThen(json(8192, reply), token))

    fn request(key, operation, token, body, limit, read) = andThen(perform Supabase::Provider.request("POST", "https://cloudkms.googleapis.com",
        "/v1/${key}:${operation}", "Authorization: Bearer ${token}\r\nContent-Type: application/json", body), fn(reply) => andThen(json(limit, reply), read))

    fn submit(key, operation, body, limit, read) = andThen(credentials(), fn(token) => request(key, operation, token, body, limit, read))

    fn payload(aad, verifier) = Canonical::serialize(Json::obj([
        Json::member("additionalAuthenticatedData", Json::str(b64(aad))),
        Json::member("plaintext", Json::str(b64(verifier)))
    ]))

    fn encrypt(key, aad, text, limit) = if validKey(key) && byteLength(aad) <= 1024 {
        andThen(payload(aad, text), fn(body) => submit(key, "encrypt", body, limit + 1024, fn(doc) => ciphertext(limit, doc)))
    } else { Error { message: unavailable } }

    export fn seal(key, aad, verifier) = if OAuth::challengeCode(verifier) == "" { encrypt(key, aad, verifier, 4096) }
    else { Error { message: unavailable } }

    fn tokens(session: Supabase::Session) = Canonical::serialize(Json::obj([
        Json::member("accessToken", Json::str(session.accessToken)),
        Json::member("refreshToken", Json::str(session.refreshToken))
    ]))

    /// Persist only a bounded KMS envelope. The database never receives these tokens.
    export fn sealSession(key, aad, session) = andThen(tokens(session), fn(text) =>
        if byteLength(text) > 32768 { Error { message: unavailable } } else { encrypt(key, aad, text, 49152) })
    fn plaintext(doc) = {
        let encoded = field(doc, "plaintext")
        if byteLength(encoded) != 60 || !endsWith(encoded, "==") { Error { message: unavailable } }
        else { verifierOf(encoded) }
    }

    fn ascii(bytes, encoded) = if Dsse::base64(bytes) == encoded && foldList(bytes, true, fn(ok, b) => ok && b > 0 && b < 128) {
        Success { value: join(mapList(bytes, fn(b) => fromCodePoint(b) ?: ""), "") }
    } else { Error { message: unavailable } }

    fn unpadded(encoded) = {
        let text = Bytes::before(encoded, "=")
        replace(replace(text, "+", "-") ?: text, "/", "_") ?: text
    }

    fn decodedText(encoded) = match Dsse::decodeBase64Url(unpadded(encoded)) {
        Error => Error { message: unavailable }
        Success { value } => ascii(value, encoded)
    }

    fn verifierOf(encoded) = andThen(decodedText(encoded), fn(clear) =>
        if OAuth::challengeCode(clear) == "" { Success { value: clear } } else { Error { message: unavailable } })

    fn decryptPayload(aad, envelope) = Canonical::serialize(Json::obj([
        Json::member("additionalAuthenticatedData", Json::str(b64(aad))),
        Json::member("ciphertext", Json::str(envelope))
    ]))

    /// KMS authenticates the callback and both browser-bound digests before disclosing the verifier.
    export fn unseal(key, aad, envelope) = if validKey(key) && envelopeOk(4096, envelope) && byteLength(aad) <= 1024 {
        andThen(decryptPayload(aad, envelope), fn(body) => submit(key, "decrypt", body, 8192, plaintext))
    } else { Error { message: unavailable } }

    fn accessToken(doc) = {
        let token = field(doc, "accessToken")
        if token == "" || byteLength(token) > 16384 || !Bytes::everyByte(token, fn(b) => b > 32 && b < 127) {
            Error { message: unavailable }
        } else { Success { value: token } }
    }

    fn openedSession(doc) = andThen(decodedText(field(doc, "plaintext")), fn(clear) =>
        if byteLength(clear) > 32768 { Error { message: unavailable } }
        else { andThen(Json::parse(clear), accessToken) })

    /// Open a cookie-bound envelope for access-token revalidation on the API host.
    export fn openSession(key, aad, envelope) = if validKey(key) && envelopeOk(49152, envelope) && byteLength(aad) <= 1024 {
        andThen(decryptPayload(aad, envelope), fn(body) => submit(key, "decrypt", body, 50176, openedSession))
    } else { Error { message: unavailable } }
}
