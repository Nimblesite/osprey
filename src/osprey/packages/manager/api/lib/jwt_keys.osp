namespace registry_api;
import registry::Bytes
import registry::Dsse
import registry::JsonRead
import registry_host::Host

/// JWA verification keys and signatures, encoded for the platform OpenSSL verifier.
/// The process receives only public material and a SHA-256 digest, never the JWT.
module JwtKeys {
    let invalid = "auth.jwt-key"
    let ecSpki = "3059301306072a8648ce3d020106082a8648ce3d03010703420004"
    let rsaAlgorithm = "300d06092a864886f70d0101010500"

    fn field(doc, name) = JsonRead::text(JsonRead::field(doc, name))

    fn value(doc, name) = Dsse::decodeBase64Url(field(doc, name))

    fn span(bytes, start, count) = range(start, start + count) |> map(fn(i) => listGet(bytes, i) ?: 0) |> toList

    fn tlv(tag, bytes) = {
        let size = length(bytes)
        let sizeField = if size < 128 { [size] } else if size < 256 { [129, size] } else { [130, intDiv(size, 256), size % 256] }
        Bytes::concatAll([[tag], sizeField, bytes])
    }

    fn leading(bytes) = listGet(bytes, 0) ?: 0

    fn integer(bytes) = {
        let start = fold(range(0, length(bytes) - 1), 0, fn(i, n) => if n == i && (listGet(bytes, n) ?: 0) == 0 { n + 1 } else { i })
        let magnitude = span(bytes, start, length(bytes) - start)
        tlv(2, if leading(magnitude) >= 128 { listPrepend(magnitude, 0) } else { magnitude })
    }

    fn ecPoint(key) = andThen(value(key, "x"), fn(x) => andThen(value(key, "y"), fn(y) =>
        if length(x) == 32 && length(y) == 32 { Success { value: Bytes::concatAll([Bytes::fromHex(ecSpki), x, y]) } }
        else { Error { message: invalid } }))

    fn rsaSpki(n, e) = {
        let publicKey = tlv(48, listConcat(integer(n), integer(e)))
        tlv(48, listConcat(Bytes::fromHex(rsaAlgorithm), tlv(3, listPrepend(publicKey, 0))))
    }

    fn rsaPublic(key) = andThen(value(key, "n"), fn(n) => andThen(value(key, "e"), fn(e) =>
        if (length(n) != 256 && length(n) != 384 && length(n) != 512) || leading(n) < 128 || length(e) == 0 || length(e) > 4 || leading(e) == 0 {
            Error { message: invalid }
        } else { Success { value: rsaSpki(n, e) } }))

    fn publicKey(algorithm, key) = if algorithm == "ES256" && field(key, "kty") == "EC" && field(key, "crv") == "P-256" { ecPoint(key) }
    else if algorithm == "RS256" && field(key, "kty") == "RSA" { rsaPublic(key) }
    else { Error { message: invalid } }

    fn signatureDer(algorithm, bytes) = if algorithm == "ES256" && length(bytes) == 64 {
        Success { value: tlv(48, listConcat(integer(span(bytes, 0, 32)), integer(span(bytes, 32, 32)))) }
    } else if algorithm == "RS256" && (length(bytes) == 256 || length(bytes) == 384 || length(bytes) == 512) {
        Success { value: bytes }
    } else { Error { message: "auth.jwt-signature" } }

    fn put(file, bytes) = "printf '%s' " + Host::shellWord(Dsse::base64(bytes)) + " | openssl base64 -d -A > \"$dir/${file}\""

    fn command(algorithm, key, signed, digest) = {
        let execute = "openssl pkeyutl -verify -pubin -keyform DER -inkey \"$dir/key\" -sigfile \"$dir/sig\" -in \"$dir/hash\" -pkeyopt digest:sha256"
        let options = if algorithm == "RS256" { " -pkeyopt rsa_padding_mode:pkcs1" } else { "" }
        let setup = "umask 077; dir=$(mktemp -d /tmp/osprey-registry-jwt.XXXXXXXX) || exit 1; trap 'rm -f -- \"$dir/key\" \"$dir/sig\" \"$dir/hash\"; rmdir -- \"$dir\"' EXIT; "
        setup + put("key", key) + " && " + put("sig", signed) + " && " + put("hash", digest) + " && " + execute + options
    }

    fn quiet(_pid, _stream, _text) = {}

    fn run(source) = match spawnProcess(source, quiet) {
        Error => Error { message: "auth.jwt-verifier" }
        Success { value } => {
            let status = awaitProcess(value)
            let _released = cleanupProcess(value)
            if status == 0 { Success { value: true } } else { Error { message: "auth.jwt-signature" } }
        }
    }

    /// Verify the exact JWS input digest with P-256 or PKCS#1 v1.5.
    export fn verify(algorithm, key, signed, digest) = andThen(publicKey(algorithm, key), fn(der) =>
        andThen(signatureDer(algorithm, signed), fn(encoded) => run(command(algorithm, der, encoded, digest))))
}
