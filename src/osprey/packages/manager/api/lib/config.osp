namespace registry_api;
import registry::Checked
import registry::Json
import registry_host::Host

/// The server configuration: one JSON file in the working directory, because
/// Osprey has no argv or environment builtin yet. Implements "Operation" of
/// [PACKAGE-FOLDER-REGISTRY].
module Config {
    export type Settings = { root: string, address: string, port: int }

    let fileName = "registry-server.json"
    let maxPort = 65535

    /// The configuration file's name, relative to the working directory.
    export fn path() = fileName

    fn text(document, field) = match Json::textAt(document, field) {
        Success { value } => Success { value: value }
        Error => Error { message: "config.${field}" }
    }

    fn port(document) = match Json::intAt(document, "port") {
        Success { value } => if value > 0 && value <= maxPort { Success { value: value } } else { Error { message: "config.port" } }
        Error => Error { message: "config.port" }
    }

    fn withPort(document, root, address) = Checked::andThen(port(document), fn(value) => Success { value: Settings { root: root, address: address, port: value } })

    fn withAddress(document, root) = Checked::andThen(text(document, "address"), fn(value) => withPort(document, root, value))

    fn settingsOf(document) = Checked::andThen(text(document, "root"), fn(value) => withAddress(document, value))

    /// Settings from configuration text, or a `config.*` / `json.*` code.
    export fn parse(source) = Checked::andThen(Checked::mapError(Json::parse(source), Json::describe), settingsOf)

    /// Settings read through `Host::Files`, or the reason they are unusable.
    export fn load() = Checked::andThen(Checked::mapError(perform Host::Files.read(fileName), fn(message) => "config.unreadable: ${fileName}: ${message}"), parse)
}
