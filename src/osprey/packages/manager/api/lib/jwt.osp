namespace registry_api;
import registry::Bytes
import registry::Dsse
import registry::Json
import registry::JsonRead
import registry::Sha256

/// Supabase access-token verification for [PACKAGE-HOSTED-AUTH]. The JWT
/// supplies only a key ID and permitted algorithm. The issuer and JWKS
/// endpoint come from deployment configuration.
module Jwt {
    let invalid = "auth.jwt-invalid"
    let audience = "authenticated"
    let clockSkew = 30
    let tokenLife = 600
    let refreshWindow = 1800
    export let expired = "auth.jwt-expired"

    fn field(doc, name) = JsonRead::text(JsonRead::field(doc, name))

    fn has(doc, name) = match Json::get(doc, name) { Success => true Error => false }

    fn digit(bytes, index) = (listGet(bytes, index) ?: 0) % 64

    fn unicode(bytes, index) = {
        let first = listGet(bytes, index) ?: 0
        let one = digit(bytes, index + 1)
        let two = digit(bytes, index + 2)
        let three = digit(bytes, index + 3)
        if first > 0 && first < 128 { first }
        else if first >= 194 && first <= 223 { (first - 192) * 64 + one }
        else if first >= 224 && first <= 239 { (first - 224) * 4096 + one * 64 + two }
        else if first >= 240 && first <= 244 { (first - 240) * 262144 + one * 4096 + two * 64 + three }
        else { -1 }
    }

    fn json(bytes) = {
        let decoded = range(0, length(bytes)) |> map(fn(i) => fromCodePoint(unicode(bytes, i)) ?: "") |> toList
        let text = join(decoded, "")
        if structuralEquals(Bytes::ofString(text), bytes) { Json::parse(text) }
        else { Error { message: invalid } }
    }

    fn section(text) = andThen(Dsse::decodeBase64Url(text), json)

    fn keyId(ident) = byteLength(ident) > 0 && byteLength(ident) <= 128
        && Bytes::everyByte(ident, fn(b) => Bytes::isAlnumIn(b, [Bytes::hyphen, Bytes::underscore, Bytes::dot]))

    fn validHeader(header) = {
        let alg = field(header, "alg")
        (alg == "ES256" || alg == "RS256") && keyId(field(header, "kid"))
            && !foldList(["crit", "b64", "jku", "jwk", "x5u", "x5c"], false, fn(found, name) => found || has(header, name))
    }

    fn keyFor(header, doc) = {
        let ident = field(header, "kid")
        let keys = JsonRead::items(JsonRead::field(doc, "keys"))
        let selected = filterList(keys, fn(key) => field(key, "kid") == ident)
        let key = listGet(selected, 0) ?: Json::Null
        if length(selected) != 1 || length(keys) > 32 || field(key, "alg") != field(header, "alg")
            || (has(key, "use") && field(key, "use") != "sig")
            || (has(key, "key_ops") && !listContains(JsonRead::texts(JsonRead::field(key, "key_ops")), "verify")) {
            Error { message: "auth.jwt-key" }
        } else { Success { value: key } }
    }

    fn fetchKey(config, header) = andThen(perform Supabase::Provider.request("GET", config.supabaseOrigin,
        "/auth/v1/.well-known/jwks.json", "", ""), fn(reply) =>
            if reply.status != 200 || byteLength(reply.body) > 65536 { Error { message: "auth.jwt-key" } }
            else { andThen(Json::parse(reply.body), fn(doc) => keyFor(header, doc)) })

    fn beforeWindow(doc, now) = match Json::get(doc, "nbf") {
        Error => true
        Success { value } => {
            let date = JsonRead::number(value)
            date > 0 && date <= now + clockSkew
        }
    }

    fn claims(config, now, doc) = {
        let subject = field(doc, "sub")
        let aud = JsonRead::field(doc, "aud")
        let starts = JsonRead::number(JsonRead::field(doc, "iat"))
        let expires = JsonRead::number(JsonRead::field(doc, "exp"))
        if !Bytes::canonicalUuid(subject) || field(doc, "iss") != config.supabaseOrigin + "/auth/v1"
            || (JsonRead::text(aud) != audience && !structuralEquals(JsonRead::texts(aud), [audience]))
            || starts < 1 || starts > now + clockSkew || expires <= now - clockSkew - refreshWindow || expires <= starts
            || expires - starts > tokenLife || !beforeWindow(doc, now) { Error { message: invalid } }
        else { Success { value: subject } }
    }

    fn verifyParts(config, now, encodedHeader, encodedClaims, encodedSignature) = andThen(section(encodedHeader), fn(header) =>
        if !validHeader(header) || encodedSignature == "" { Error { message: invalid } }
        else { andThen(section(encodedClaims), fn(doc) => checked(config, now, header, doc, encodedHeader + "." + encodedClaims, encodedSignature)) })

    fn checked(config, now, header, doc, signingInput, encodedSignature) = andThen(claims(config, now, doc), fn(subject) =>
        andThen(Dsse::decodeBase64Url(encodedSignature), fn(signed) => andThen(fetchKey(config, header), fn(key) =>
            andThen(JwtKeys::verify(field(header, "alg"), key, signed, Sha256::digest(Bytes::ofString(signingInput))),
                fn(_) => if JsonRead::number(JsonRead::field(doc, "exp")) <= now - clockSkew { Error { message: expired } }
                    else { Success { value: subject } }))))

    /// Each verification obtains one fresh key set, so a rotated key needs no stale local cache.
    export fn verify(config, now, token) = if OAuth::configCode(config) != "" || now <= 0 || now > 253402300799 || byteLength(token) > 16384 {
        Error { message: invalid }
    } else { match split(token, ".") {
        Success { value } => if length(value) != 3 { Error { message: invalid } }
            else { verifyParts(config, now, listGet(value, 0) ?: "", listGet(value, 1) ?: "", listGet(value, 2) ?: "") }
        Error => Error { message: invalid }
    } }

    /// The signed subject must match the immutable identity returned by Supabase /user.
    export fn verifySession(config, now, session: Supabase::Session) = andThen(verify(config, now, session.accessToken), fn(subject) =>
        if subject == session.identity.authSubject { Success { value: session } }
        else { Error { message: "auth.jwt-subject" } })
}
