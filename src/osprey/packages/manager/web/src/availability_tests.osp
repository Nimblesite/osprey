namespace registry_web;
import registry_web::Availability
import registry_web::WebFixtures

/// The per-organization name check: scoped answers only, never a global
/// claim, with hostile leaf names escaped
/// ([PACKAGE-NAMES-NO-SITTING]).
module AvailabilityTests {
    /// The same leaf name is taken in one organization and free in the
    /// other, and each answer names its own organization.
    fn scopedAnswers() = checkAll("web: availability scoped per org", [
        WebFixtures::showing(Availability::render("atlas", "util", true),
            fn(html) => contains(html, "already taken within @atlas") && contains(html, "scoped to @atlas only")),
        WebFixtures::showing(Availability::render("border", "util", false),
            fn(html) => contains(html, "available under @border") && contains(html, "scoped to @border only"))
    ])

    /// No rendering may claim anything about the leaf name globally.
    fn neverGlobal() = WebFixtures::showsExpecting("web: availability never global",
        Availability::render("atlas", "util", true), "no global claim")

    fn hostileLeaf() = WebFixtures::shows("web: availability escapes hostile leaf",
        Availability::render("atlas", "<b>owned</b>", false),
        fn(html) => contains(html, "&lt;b&gt;owned&lt;/b&gt;") && !contains(html, "<b>owned</b>"))

    /// The suite.
    export fn run() = {
        test("web: availability scoped per org", scopedAnswers)
        test("web: availability never global", neverGlobal)
        test("web: availability escapes hostile leaf", hostileLeaf)
    }
}
