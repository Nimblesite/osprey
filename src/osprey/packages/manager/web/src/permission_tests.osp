namespace registry_web;

/// The organization/permission surfaces: the single administrator seat,
/// explicit grants only, and the admin-without-publish warning the website
/// must show before every mutation surface
/// ([PACKAGE-OWNERSHIP-ADMIN], [PACKAGE-OWNERSHIP-PERMISSIONS]).
module PermissionTests {
    let adminOnlyCode = "web.permissions.admin-only"

    /// The control screen for `member` over `ledger`, at the fixture clock.
    fn controlScreen(member, ledger) = Permissions::render(WebFixtures::warnedAtlasUtil(), member, ledger, WebFixtures::now())

    /// The administrator holds only edit-metadata: the control screen
    /// shows the ledger and explicitly denies implied publication.
    fn adminWithoutPublish() = WebFixtures::showsTexts("web: admin without publish warned",
        controlScreen(WebFixtures::adminWithoutPublish(), WebFixtures::atlasGrantLedger()),
        ["Package administrator: mem-admin-atlas", "edit-metadata", "publish-release",
            "administration alone does not authorize publication"], [])

    /// With the explicit grant, the warning is gone.
    fn adminWithPublish() = WebFixtures::showsTexts("web: admin with publish not warned",
        controlScreen(WebFixtures::adminWithPublish(), WebFixtures::atlasGrantLedger()),
        ["Package administrator: mem-admin-atlas", "publish-release"], ["administration alone does not authorize publication"])

    /// The package page carries the same context and warning for members.
    fn packageViewShowsAccess() = WebFixtures::showsTexts("web: package page shows access context",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::adminWithoutPublish(), WebFixtures::now()),
        ["Package administrator: mem-admin-atlas", "Your effective permissions: edit-metadata",
            "administration alone does not authorize publication"], [])

    /// A publisher sees their own effective permission, and no implied
    /// admin powers.
    fn publisherSeesOwnGrant() = WebFixtures::showsTexts("web: publisher sees own grant",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::publisher(), WebFixtures::now()),
        ["Your effective permissions: publish-release"], ["administration alone does not authorize publication"])

    /// Anonymous visitors get the public projection only: no seat, no
    /// grants, no permission panel at all.
    fn anonymousSeesNoAccess() = WebFixtures::showsTexts("web: anonymous sees no access",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::anonymous(), WebFixtures::now()),
        ["@atlas/util", "OSA-2026-0001"], ["Package administrator", "Your effective permissions"])

    /// The control screen is admin-only: a publisher, an outsider and an
    /// anonymous visitor all get the hidden screen.
    fn controlScreenAdminOnly() = checkAll("web: control screen admin only", [
        WebFixtures::hiddenFor(controlScreen(WebFixtures::publisher(), WebFixtures::atlasGrantLedger()), adminOnlyCode),
        WebFixtures::hiddenFor(controlScreen(WebFixtures::outsider(), WebFixtures::atlasGrantLedger()), adminOnlyCode),
        WebFixtures::hiddenFor(controlScreen(WebFixtures::anonymous(), WebFixtures::atlasGrantLedger()), adminOnlyCode)
    ])

    /// A member of another organization never sees this package's access
    /// context on the package page.
    fn outsiderSeesNoAccess() = WebFixtures::showsTexts("web: outsider sees no access context",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::outsider(), WebFixtures::now()), ["@atlas/util", "OSA-2026-0001"], ["Organization and permissions", "Package administrator", "Your effective permissions"])

    /// The grant table escapes hostile membership ids.
    fn hostileLedger() = WebFixtures::showsTexts("web: hostile ledger escaped",
        controlScreen(WebFixtures::adminWithoutPublish(), WebFixtures::hostileGrantLedger()),
        ["&lt;td&gt;injected&lt;/td&gt;"], ["<td>injected</td>"])

    /// A grant to a different user or package must never appear as the viewer's publishing authority.
    fn scopedPublisher() = {
        let base = WebFixtures::adminWithoutPublish()
        let ledger = WebFixtures::atlasGrantLedger()
        let pub = WebFixtures::publisherGrant()
        let admin = pub { membership: "mem-admin-atlas" }
        let mixed = base { grants: [pub, admin { package: "other-package" }, admin { packageEpoch: 2 }, admin { memberEpoch: 2 }] }
        WebFixtures::showsTexts("web: publisher delegation is scoped", controlScreen(mixed, ledger),
            ["Publishers", "mem-pub-1", "administration alone does not authorize publication"], [])
    }

    /// The suite.
    export fn run() = {
        test("web: delegated publisher scope", scopedPublisher)
        test("web: admin without publish warned", adminWithoutPublish)
        test("web: admin with publish not warned", adminWithPublish)
        test("web: package page shows access context", packageViewShowsAccess)
        test("web: publisher sees own grant", publisherSeesOwnGrant)
        test("web: anonymous sees no access", anonymousSeesNoAccess)
        test("web: control screen admin only", controlScreenAdminOnly)
        test("web: outsider sees no access context", outsiderSeesNoAccess)
        test("web: hostile ledger escaped", hostileLedger)
    }
}
