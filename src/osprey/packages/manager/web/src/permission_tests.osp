namespace registry_web;
import registry_web::PackageView
import registry_web::Permissions
import registry_web::WebFixtures

/// The organization/permission surfaces: the single administrator seat,
/// explicit grants only, and the admin-without-publish warning the website
/// must show before every mutation surface
/// ([PACKAGE-OWNERSHIP-ADMIN], [PACKAGE-OWNERSHIP-PERMISSIONS]).
module PermissionTests {
    let adminOnlyCode = "web.permissions.admin-only"

    /// The administrator holds only edit-metadata: the control screen
    /// shows the ledger and explicitly denies implied publication.
    fn adminWithoutPublish() = WebFixtures::shows("web: admin without publish warned",
        Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::adminWithoutPublish(), WebFixtures::atlasGrantLedger(), WebFixtures::now()),
        fn(html) => contains(html, "Package administrator: mem-admin-atlas") &&
            contains(html, "edit-metadata") &&
            contains(html, "publish-release") &&
            contains(html, "administration alone does not authorize publication"))

    /// With the explicit grant, the warning is gone.
    fn adminWithPublish() = WebFixtures::showsExpecting("web: admin with publish not warned",
        Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::adminWithPublish(), WebFixtures::atlasGrantLedger(), WebFixtures::now()),
        "no admin-publish warning")

    /// The package page carries the same context and warning for members.
    fn packageViewShowsAccess() = WebFixtures::shows("web: package page shows access context",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::adminWithoutPublish(), WebFixtures::now()),
        fn(html) => contains(html, "Package administrator: mem-admin-atlas") &&
            contains(html, "Your effective permissions: edit-metadata") &&
            contains(html, "administration alone does not authorize publication"))

    /// A publisher sees their own effective permission, and no implied
    /// admin powers.
    fn publisherSeesOwnGrant() = WebFixtures::shows("web: publisher sees own grant",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::publisher(), WebFixtures::now()),
        fn(html) => contains(html, "Your effective permissions: publish-release") &&
            !contains(html, "administration alone does not authorize publication"))

    /// Anonymous visitors get the public projection only: no seat, no
    /// grants, no permission panel at all.
    fn anonymousSeesNoAccess() = WebFixtures::shows("web: anonymous sees no access",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::anonymous(), WebFixtures::now()),
        fn(html) => !contains(html, "Package administrator") &&
            !contains(html, "Your effective permissions") &&
            contains(html, "@atlas/util") &&
            contains(html, "OSA-2026-0001"))

    /// The control screen is admin-only: a publisher, an outsider and an
    /// anonymous visitor all get the hidden screen.
    fn controlScreenAdminOnly() = checkAll("web: control screen admin only", [
        WebFixtures::hiddenFor(Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::publisher(), WebFixtures::atlasGrantLedger(), WebFixtures::now()), adminOnlyCode),
        WebFixtures::hiddenFor(Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::outsider(), WebFixtures::atlasGrantLedger(), WebFixtures::now()), adminOnlyCode),
        WebFixtures::hiddenFor(Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::anonymous(), WebFixtures::atlasGrantLedger(), WebFixtures::now()), adminOnlyCode)
    ])

    /// A member of another organization never sees this package's access
    /// context on the package page.
    fn outsiderSeesNoAccess() = WebFixtures::showsExpecting("web: outsider sees no access context",
        PackageView::render(WebFixtures::warnedAtlasUtil(), WebFixtures::outsider(), WebFixtures::now()), "no access context")

    /// The grant table escapes hostile membership ids.
    fn hostileLedger() = WebFixtures::shows("web: hostile ledger escaped",
        Permissions::render(WebFixtures::warnedAtlasUtil(), WebFixtures::adminWithoutPublish(), WebFixtures::hostileGrantLedger(), WebFixtures::now()),
        fn(html) => contains(html, "&lt;td&gt;injected&lt;/td&gt;") && !contains(html, "<td>injected</td>"))

    /// The suite.
    export fn run() = {
        test("web: admin without publish warned", adminWithoutPublish)
        test("web: admin with publish not warned", adminWithPublish)
        test("web: package page shows access context", packageViewShowsAccess)
        test("web: publisher sees own grant", publisherSeesOwnGrant)
        test("web: anonymous sees no access", anonymousSeesNoAccess)
        test("web: control screen admin only", controlScreenAdminOnly)
        test("web: outsider sees no access context", outsiderSeesNoAccess)
        test("web: hostile ledger escaped", hostileLedger)
    }
}
