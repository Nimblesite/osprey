namespace registry_web;
import registry_web::Browse
import registry_web::PackageView
import registry_web::WebFixtures

/// The org-scoped browse screen: organization identity beside every
/// result, warnings surfaced, same leaf names across organizations kept
/// distinct, and the whole screen hidden when security evidence is
/// unavailable. Implements [PACKAGE-NAMES-NO-SITTING] and
/// [PACKAGE-OWNERSHIP-MAINTENANCE] for the listing surface.
module BrowseTests {
    fn catalog() = [WebFixtures::warnedAtlasUtil(), WebFixtures::warnedBorderUtil(), WebFixtures::cleanAtlasUtil()]

    fn orgBesideEveryResult() = WebFixtures::shows("web: browse shows org identity", Browse::render(catalog(), ""),
        fn(html) => contains(html, "@atlas/util") &&
            contains(html, "Organization: @atlas") &&
            contains(html, "@border/util") &&
            contains(html, "Organization: @border"))

    /// No false negatives: each warning, and each explicit no-warnings
    /// statement, is present in the rendered listing.
    fn warningsSurface() = WebFixtures::shows("web: browse surfaces warnings", Browse::render(catalog(), ""),
        fn(html) => contains(html, "OSA-2026-0001") &&
            contains(html, "executes code") &&
            contains(html, "OSB-2026-0007") &&
            contains(html, "No known security warnings."))

    /// Two organizations may share one leaf name; each result keeps its own
    /// identity and its own warnings.
    fn sameLeafAcrossOrgs() = WebFixtures::shows("web: browse keeps same leaf names distinct", Browse::render(catalog(), ""),
        fn(html) => contains(html, "id=\"-atlas-util-h\"") &&
            contains(html, "id=\"-border-util-h\"") &&
            contains(html, "@atlas/util") &&
            contains(html, "@border/util"))

    /// One package without evidence hides the entire screen, naming the
    /// package and the reason — never a partial listing.
    fn missingEvidenceHidesAll() = WebFixtures::hides("web: browse hides all when evidence unavailable",
        Browse::render(listAppend(catalog(), WebFixtures::orphanWithoutEvidence()), ""),
        fn(reason) => startsWith(reason, "web.evidence-unavailable") &&
            contains(reason, "@atlas/orphan") &&
            contains(reason, "registry.status-service-unreachable"))

    fn queryFilters() = WebFixtures::shows("web: browse query filters", Browse::render(catalog(), "border"),
        fn(html) => contains(html, "@border/util") && !contains(html, "@atlas/util"))

    /// The package page hides for the same reason, per package.
    fn packagePageHidesWithoutEvidence() = WebFixtures::hidesExpecting("web: package page hides when evidence unavailable",
        PackageView::render(WebFixtures::orphanWithoutEvidence(), WebFixtures::anonymous(), WebFixtures::now()), "web.evidence-unavailable...")

    /// The suite.
    export fn run() = {
        test("web: browse shows org identity", orgBesideEveryResult)
        test("web: browse surfaces warnings", warningsSurface)
        test("web: browse keeps same leaf names distinct", sameLeafAcrossOrgs)
        test("web: browse hides all when evidence unavailable", missingEvidenceHidesAll)
        test("web: browse query filters", queryFilters)
        test("web: package page hides when evidence unavailable", packagePageHidesWithoutEvidence)
    }
}
