namespace registry_web;
import registry_web::Publications
import registry_web::WebFixtures

/// The publication monitor: pending, rejected and quarantined intents each
/// labelled with their reasons, member-only, and hidden entirely when any
/// entry's security evidence is unavailable
/// ([PACKAGE-HOSTED-ROUTES]).
module PublicationTests {
    fn board() = [WebFixtures::pendingPublication(), WebFixtures::rejectedPublication(), WebFixtures::quarantinedPublication()]

    /// Every status is distinguishable and carries its reason.
    fn statusesAndReasons() = WebFixtures::shows("web: publication statuses and reasons",
        Publications::render(board(), WebFixtures::publisher()),
        fn(html) => contains(html, "Pending: awaiting WebAuthn assertion for the frozen source digest") &&
            contains(html, "Rejected: proof.statement-mismatch") &&
            contains(html, "authority epoch stale: 0 != 1") &&
            contains(html, "Quarantined: source verification quarantined") &&
            contains(html, "Actor: prin-pub-1"))

    /// A pending intent is labelled a proposal, never an accepted release.
    fn proposalNotRelease() = WebFixtures::showsExpecting("web: pending labelled proposal",
        Publications::render(board(), WebFixtures::publisher()), "proposal label present")

    /// Same leaf name under two organizations: both boards render their own
    /// package identity.
    fn sameLeafDistinctBoards() = WebFixtures::shows("web: same leaf distinct boards",
        Publications::render([WebFixtures::pendingPublication(), WebFixtures::quarantinedPublication()], WebFixtures::publisher()),
        fn(html) => contains(html, "@atlas/util") && contains(html, "@border/util"))

    /// One entry without evidence hides the entire screen with its reason.
    fn missingEvidenceHidesAll() = WebFixtures::hides("web: publications hide when evidence unavailable",
        Publications::render(listAppend(board(), WebFixtures::publicationWithoutEvidence()), WebFixtures::publisher()),
        fn(reason) => startsWith(reason, "web.evidence-unavailable") &&
            contains(reason, "@atlas/util") &&
            contains(reason, "registry.evidence-pending"))

    /// Anonymous visitors get no publication information at all.
    fn anonymousHidden() = WebFixtures::hidesExpecting("web: publications member only",
        Publications::render(board(), WebFixtures::anonymous()), "web.publications.member-only")

    /// Hostile reasons and actors are escaped.
    fn hostileStrings() = WebFixtures::shows("web: hostile publication strings escaped",
        Publications::render([WebFixtures::hostilePublication()], WebFixtures::publisher()),
        fn(html) => contains(html, "&lt;/article&gt;&lt;script&gt;alert(1)&lt;/script&gt;") &&
            !contains(html, "<script>") &&
            contains(html, "Actor: prin-&#39;-(1)"))

    /// The suite.
    export fn run() = {
        test("web: publication statuses and reasons", statusesAndReasons)
        test("web: pending labelled proposal", proposalNotRelease)
        test("web: same leaf distinct boards", sameLeafDistinctBoards)
        test("web: publications hide when evidence unavailable", missingEvidenceHidesAll)
        test("web: publications member only", anonymousHidden)
        test("web: hostile publication strings escaped", hostileStrings)
    }
}
