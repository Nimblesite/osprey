namespace registry_web;

/// Landing page available before the hosted catalog has verified public evidence.
fn landing() = {
    let guide = Shell::guideUrl()
    let hero = "<div class=\"prose-hero\"><div><h1>Osprey<br>Packages</h1><p>Pin source packages by digest and build them offline. Start with a local registry while public publishing is in development.</p><a class=\"prose-action\" href=\"${guide}\">Use the package manager</a></div><div class=\"prose-art\" aria-hidden=\"true\"><div class=\"prose-stack\"><i></i><i></i><i></i></div></div></div>"
    let editor = "<article><h2>In the editor</h2><p>Browse your local catalog, inspect a dependency and add it to your project in VS Code.</p><a href=\"${guide}#editor\">Open the editor guide</a></article>"
    let cli = "<article><h2>At the terminal</h2><p>Lock exact releases, fetch their source and verify the installed tree before compiling.</p><a href=\"${guide}#commands\">Read the command reference</a></article>"
    let publishers = "<section id=\"publishers\"><h2>Publishers</h2><p>In the hosted registry design, an organization owns each package. Its administrator chooses which users can publish releases and can revoke each grant separately.</p><a href=\"/publishing/\">How publishing permissions work</a></section>"
    Shell::withEscapedTitle("Osprey Packages", "<main>${hero}<div class=\"prose-resources\">${editor}${cli}</div>${publishers}</main>")
}

fn main() = print(match trim(input()) {
    "guide" => Guides::packages()
    "publishing" => Guides::publishers()
    _ => landing()
})
