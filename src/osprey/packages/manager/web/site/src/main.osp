namespace registry_web;

// Implements [PACKAGE-HOSTED-ROUTES-CATALOG]. Hosted pages require verified evidence.
fn catalog(local, entries) = {
    let notice = if local { "<p>Local folder registry · Audit unverified</p>" } else { "<p role=\"status\">The public catalog is unavailable.</p>" }
    let disabled = if local { "" } else { " disabled" }
    let form = "<form role=\"search\" method=\"get\" action=\"/\"><label for=\"q\">Search packages</label><div class=\"prose-search\"><input id=\"q\" name=\"q\" type=\"search\" placeholder=\"Package name or description\"${disabled}><button${disabled}>Search</button></div></form>"
    let behavior = if local { "<script src=\"/filter.1ae1cf977c5e.js\" defer></script>" } else { "" }
    Shell::withEscapedTitle("Osprey Packages", "<main><h1>Packages</h1>${form}<section><h2>Browse packages</h2>${notice}<div id=\"results\">${entries}</div></section></main>${behavior}")
}

fn upload() = Shell::withEscapedTitle("Upload a package · Osprey Packages", "<main><h1>Upload a package</h1><p role=\"status\">Public uploads are unavailable.</p><a href=\"/\">Browse packages</a></main>")

fn escaped(s) = {
    let amp = replace(s, "&", "&amp;") ?: s
    let lt = replace(amp, "<", "&lt;") ?: amp
    replace(lt, ">", "&gt;") ?: lt
}

// Build inputs come from the local registry. The builder validates URL components.
fn localPackage(mode) = {
    let key = trim(input())
    let summary = escaped(trim(input()))
    let url = "/packages/${key}/"
    let releases = if mode == "row" { "" } else { trim(input()) }
    if mode == "row" {
        "<article class=\"prose-package\"><h3><a href=\"${url}\">${key}</a></h3><p>${summary}</p></article>"
    } else {
        Shell::withEscapedTitle("${key} · Osprey Packages", "<main><h1>${key}</h1><p>${summary}</p><section><h2>Releases</h2><p>Local folder registry · Audit unverified</p>${releases}</section></main>")
    }
}

fn main() = print(match trim(input()) {
    "guide" => Guides::packages()
    "publishing" => Guides::publishers()
    "upload" => upload()
    "local" => catalog(true, input())
    "row" => localPackage("row")
    "package" => localPackage("package")
    "release" => {
        let version = trim(input())
        let digest = trim(input())
        "<p><a download href=\"/sources/${digest}.json\">Download ${version}</a> · <code>${digest}</code></p>"
    }
    _ => catalog(false, "")
})
