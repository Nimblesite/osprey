namespace registry_web;
import registry::PublicCatalog

/// Render only a complete public projection delivered by the hosted registry [PACKAGE-HOSTED-ROUTES-CATALOG].
module HostedCatalog {
    fn warningList(item) = {
        let warnings = match PublicCatalog::field(item, "warnings") { JsonArray(values) => mapList(values, fn(v) => jsonText(v) ?: "") _ => [] }
        if isEmpty(warnings) { "<p>No known security warnings.</p>" } else {
            "<ul aria-label=\"Security warnings\">" + join(mapList(warnings, fn(w) => "<li>" + Shell::escape(w) + "</li>"), "") + "</ul>"
        }
    }
    fn card(item) = {
        let key = PublicCatalog::text(item, "key")
        let summary = Shell::escape(PublicCatalog::text(item, "summary"))
        "<article class=\"prose-package\"><h3><a href=\"/packages/${key}/\">${key}</a></h3><p>${summary}</p>" + warningList(item) + "</article>"
    }
    fn matches(item, terms) = {
        let text = toLowerCase(PublicCatalog::text(item, "key") + " " + PublicCatalog::text(item, "summary"))
        foldList(terms, true, fn(ok, term) => ok && contains(text, term))
    }
    fn browse(items, query) = {
        let terms = split(toLowerCase(query), " ") ?: []
        let found = filterList(items, fn(item) => matches(item, terms))
        if isEmpty(found) { "<p>No matching packages.</p>" } else { join(mapList(found, card), "") }
    }
    fn release(item) = {
        let epoch = PublicCatalog::number(item, "epoch")
        let ordinal = PublicCatalog::number(item, "ordinal")
        let digest = PublicCatalog::text(item, "digest")
        "<article class=\"prose-release\"><h3>e${epoch}.r${ordinal}</h3><code>${digest}</code></article>"
    }
    fn detail(item, path) = {
        let key = PublicCatalog::text(item, "key")
        let summary = Shell::escape(PublicCatalog::text(item, "summary"))
        let releases = match PublicCatalog::field(item, "releases") { JsonArray(items) => join(mapList(items, release), "") _ => "" }
        if PublicCatalog::validEntry(item) && path == "/packages/" + key + "/" {
            "<header class=\"prose-cover\"><a href=\"/\">← Packages</a><h1>${key}</h1><p>${summary}</p></header><div class=\"prose-columns\"><section class=\"prose-releases\"><h2>Releases</h2>${releases}</section><aside class=\"prose-facts\"><h2>Security warnings</h2>" + warningList(item) + "</aside></div>"
        } else { "" }
    }
    export fn render(path, query, body) = if path == "/" {
        match PublicCatalog::decode(body) { Success { value } => browse(value, query) Error => "" }
    } else {
        match jsonDecode(body) { Success { value } => detail(value, path) Error => "" }
    }
}
