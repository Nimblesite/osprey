namespace registry_web;
import registry::PublicCatalog
import registry::Bytes

/// Render only a complete public projection delivered by the hosted registry [PACKAGE-HOSTED-ROUTES-CATALOG].
module HostedCatalog {
    fn warningList(item) = {
        let warnings = match PublicCatalog::field(item, "warnings") { JsonArray(values) => mapList(values, fn(v) => jsonText(v) ?: "") _ => [] }
        if isEmpty(warnings) { "<p>No known security warnings.</p>" } else {
            "<ul aria-label=\"Security warnings\">" + join(mapList(warnings, fn(w) => "<li>" + Shell::escape(w) + "</li>"), "") + "</ul>"
        }
    }
    fn latestRelease(item) = foldList(releaseItems(item), JsonNull, fn(latest, value) =>
        if newer(value, latest) { value } else { latest })

    fn newer(value, latest) = {
        let epoch = PublicCatalog::number(value, "epoch")
        let previous = PublicCatalog::number(latest, "epoch")
        epoch > previous || (epoch == previous && PublicCatalog::number(value, "ordinal") > PublicCatalog::number(latest, "ordinal"))
    }

    fn version(item) = "e${PublicCatalog::number(item, "epoch")}.r${PublicCatalog::number(item, "ordinal")}"

    fn card(item) = {
        let key = PublicCatalog::text(item, "key")
        let summary = Shell::escape(PublicCatalog::text(item, "summary"))
        "<article class=\"prose-package\"><h3><a href=\"/packages/${key}/\">${key}</a></h3><p>${summary}</p>" + Shell::licenseBadge(PublicCatalog::text(latestRelease(item), "licenseExpression")) + warningList(item) + "</article>"
    }
    fn matches(item, terms) = {
        let text = toLowerCase(PublicCatalog::text(item, "key") + " " + PublicCatalog::text(item, "summary"))
        foldList(terms, true, fn(ok, term) => ok && contains(text, term))
    }
    fn browse(items, query) = {
        let terms = split(toLowerCase(query), " ") ?: []
        let found = filterList(items, fn(item) => matches(item, terms))
        if isEmpty(found) { "<p>No matching packages.</p>" } else { join(mapList(found, card), "") }
    }
    fn publisherLink(release) = {
        let id = PublicCatalog::text(release, "publisherId")
        let name = Shell::escape(PublicCatalog::text(release, "publisherName"))
        "<a href=\"/publishers/${id}/\">${name}</a>"
    }
    fn download(content, digest, label) = if content == "" { "" } else {
        "<a class=\"prose-download\" href=\"${content}/v1/releases/${digest}/source\">Download ${label}</a>"
    }

    fn release(item, content) = {
        let digest = PublicCatalog::text(item, "digest")
        let label = version(item)
        let action = download(content, digest, label)
        "<article class=\"prose-release\" id=\"${label}\"><h3>${label}</h3>${action}<p>${Shell::licenseBadge(PublicCatalog::text(item, "licenseExpression"))}</p><p>Published by ${publisherLink(item)}</p><code>${digest}</code>${Shell::notices(label, PublicCatalog::notices(item))}</article>"
    }
    fn detail(item, path, content) = {
        let key = PublicCatalog::text(item, "key")
        let summary = Shell::escape(PublicCatalog::text(item, "summary"))
        let releases = join(mapList(releaseItems(item), fn(item) => release(item, content)), "")
        if PublicCatalog::validEntry(item) && path == "/packages/" + key + "/" {
            "<header class=\"prose-cover\"><a href=\"/\">← Packages</a><h1>${key}</h1><p>${summary}</p></header><div class=\"prose-columns\"><section class=\"prose-releases\"><h2>Releases</h2>${releases}</section><aside class=\"prose-facts\"><h2>Package details</h2>" + metadata(latestRelease(item)) + "<h2>Security warnings</h2>" + warningList(item) + "<h2>Tags</h2>" + Shell::keywordChips(PublicCatalog::keywords(item)) + "</aside></div>"
        } else { "" }
    }
    fn metadata(latest) = {
        let license = Shell::licenseBadge(PublicCatalog::text(latest, "licenseExpression"))
        let notices = if isEmpty(PublicCatalog::notices(latest)) { "" } else {
            Shell::metadataField("Attribution", Shell::noticeLink(version(latest)))
        }
        "<dl>" + Shell::metadataField("License", license) + notices + "</dl>"
    }

    fn releaseItems(item) = match PublicCatalog::field(item, "releases") {
        JsonArray(items) => items
        _ => []
    }

    fn credit(key, release) = {
        let epoch = PublicCatalog::number(release, "epoch")
        let ordinal = PublicCatalog::number(release, "ordinal")
        "<li><a href=\"/packages/${key}/#e${epoch}.r${ordinal}\">${key} e${epoch}.r${ordinal}</a></li>"
    }

    fn publisher(items, path) = {
        let first = listGet(items, 0) ?: JsonNull
        let release = listGet(releaseItems(first), 0) ?: JsonNull
        let id = PublicCatalog::text(release, "publisherId")
        if id == "" || path != "/publishers/${id}/" { "" }
        else { publisherProfile(items, PublicCatalog::text(release, "publisherName")) }
    }

    fn publisherProfile(items, name) = {
        let display = Shell::escape(name)
        let packages = join(mapList(items, fn(item) => {
            let key = PublicCatalog::text(item, "key")
            card(item) + "<ul class=\"prose-credits\">" + join(mapList(releaseItems(item), fn(release) => credit(key, release)), "") + "</ul>"
        }), "")
        "<header class=\"prose-publisher\"><a href=\"/\">← Packages</a><h1>${display}</h1></header><section><h2>Published releases</h2>${packages}</section>"
    }

    fn directory(title, contents) = "<header class=\"prose-cover\"><a href=\"/\">← Packages</a><h1>${title}</h1></header><section>${contents}</section>"

    fn tags(items) = foldList(items, [], fn(seen, item) => foldList(PublicCatalog::keywords(item), seen,
        fn(tags, tag) => if listContains(tags, tag) { tags } else { listAppend(tags, tag) }))

    fn tagBrowse(items, path) = if path == "/tags/" { directory("Tags", Shell::keywordChips(listSort(tags(items)))) }
    else { tagPackages(items, path) }

    fn tagPackages(items, path) = {
        let key = Bytes::before(drop(path, byteLength("/tags/")), "/")
        let found = filterList(items, fn(item) => listContains(PublicCatalog::keywords(item), key))
        if path != "/tags/${key}/" || isEmpty(found) { directory("Tag not found", "") }
        else { directory(key, "<div id=\"results\">" + join(mapList(found, card), "") + "</div>") }
    }

    fn publishers(items) = mapValues(foldList(items, Map(), fn(seen, item) => foldList(releaseItems(item), seen, fn(index, release) => {
        let id = PublicCatalog::text(release, "publisherId")
        if (mapGet(index, id) ?: "") != "" { index } else { mapSet(index, id, publisherLink(release)) }
    })))

    fn publisherDirectory(items) = directory("Publishers", "<ul class=\"prose-credits\">" +
        join(mapList(publishers(items), fn(link) => "<li>" + link + "</li>"), "") + "</ul>")

    fn browseDirectory(items, path) = if startsWith(path, "/tags/") { tagBrowse(items, path) }
    else if path == "/publishers/" { publisherDirectory(items) } else { publisher(items, path) }

    export fn render(path, query, body, content) = if path == "/" {
        match PublicCatalog::decode(body) { Success { value } => browse(value, query) Error => "" }
    } else if startsWith(path, "/tags/") || startsWith(path, "/publishers/") {
        match PublicCatalog::decode(body) { Success { value } => browseDirectory(value, path) Error => "" }
    } else {
        match jsonDecode(body) { Success { value } => detail(value, path, content) Error => "" }
    }
}
