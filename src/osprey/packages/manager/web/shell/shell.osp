namespace registry_web;

/// Shared presentation for the static site and registry screens.
module Shell {
    export let minimumTagPackages = 5
    /// Links for already validated manifest keywords.
    export fn keywordChips(words) = if isEmpty(words) { "None" } else {
        join(mapList(words, fn(word) => "<a class=\"prose-chip\" href=\"/tags/${word}/\">${word}</a>"), "")
    }

    export fn escape(text) = replace(replace(replace(text, "&", "&amp;") ?: "", "<", "&lt;") ?: "", ">", "&gt;") ?: ""

    export fn metadataField(label, value) = "<div><dt>${label}</dt><dd>${value}</dd></div>"

    export fn licenseBadge(expression) = "<span class=\"prose-license\" aria-label=\"License\">${escape(expression)}</span>"

    fn documentName(item) = escape(jsonText(jsonField(item, "path") ?: JsonNull) ?: "")

    fn documentText(item) = {
        let text = escape(jsonText(jsonField(item, "text") ?: JsonNull) ?: "")
        replace(text, "\n", "&#10;") ?: text
    }

    fn licenseDocument(item) = "<h4>${documentName(item)}</h4><pre>${documentText(item)}</pre>"

    export fn releaseLicense(expression, items) = if isEmpty(items) { licenseBadge(expression) } else {
        "<details class=\"prose-notice prose-notices\"><summary>${licenseBadge(expression)} Read license</summary>${join(mapList(items, licenseDocument), "")}</details>"
    }

    export fn licenseLink(expression, href) = "<a class=\"prose-license\" href=\"${href}\" aria-label=\"Read license\">${escape(expression)}</a>"

    fn notice(item) = {
        "<details class=\"prose-notice\"><summary>${documentName(item)}</summary><pre>${documentText(item)}</pre></details>"
    }

    export fn noticeLink(version) = "<a href=\"#${version}-notices\">Notices and attribution</a>"

    export fn notices(version, items) = if isEmpty(items) { "" } else {
        "<section class=\"prose-notices\" id=\"${version}-notices\"><h4>Notices and attribution</h4>${join(mapList(items, notice), "")}</section>"
    }

    fn navigation() = {
        let upload = "<a href=\"/upload/\">Upload a package</a>"
        "<nav class=\"prose-desktop-nav\" aria-label=\"Primary\">${upload}</nav><details class=\"prose-mobile-menu\"><summary>Menu</summary><nav aria-label=\"Primary\"><a href=\"/\">Browse packages</a><a href=\"/publishers/\">By publisher</a><a href=\"/tags/\">By tag</a>${upload}</nav></details>"
    }

    /// Shell for an already escaped title or a trusted text literal.
    export fn withEscapedTitle(title, body) = join([
        "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>",
        title, "</title><link rel=\"icon\" type=\"image/svg+xml\" href=\"/registry-mark.svg?v=b3839fb6decc\"><link rel=\"stylesheet\" href=\"/registry.f402d991df99.css\"></head><body>",
        "<header class=\"prose-bar\"><a class=\"prose-brand\" href=\"/\"><img src=\"/registry-mark.svg?v=b3839fb6decc\" width=\"36\" height=\"36\" alt=\"\">Osprey Packages</a>", navigation(), "</header>", body, "</body></html>"], "")
}
