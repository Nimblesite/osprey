namespace registry_tests;
import registry::Governance
import registry::GovernanceTransitions
import registry::Maybe
import registry_tests::Fixture

/// Organization enrollment, custodian quorum, membership revocation, rejoin
/// and suspension [PACKAGE-OWNERSHIP-MODEL]: governance roles are never
/// package authority, an organization never loses its last custodian, and a
/// departed member's identity never returns with their old grants.
module MembershipTests {
    fn enroll(world, id, orgHandle, founder, founderMembership, proof) =
        GovernanceTransitions::enrollOrganization(world, id, orgHandle, founder, founderMembership, proof)

    fn enrollOk(world, id, orgHandle, founder, founderMembership) =
        enroll(world, id, orgHandle, founder, founderMembership,
            Fixture::verified(founder, founderMembership,
                Governance::organizationStatement(id, orgHandle, founderMembership)))

    fn enrollCode(world, id, orgHandle, founder, founderMembership) =
        Fixture::code(enrollOk(world, id, orgHandle, founder, founderMembership))

    fn organizationEnrollment() = {
        let world = Fixture::world()
        let heron = enrolledWorld()
        checkAll("enrollment records the organization and its first custodian atomically", [
            enrollCode(world, "o-heron", "heron", "p-alice", "m-alice2") == "",
            length(heron.organizations) == 3,
            enrollCode(heron, "o-heron2", "heron", "p-bob", "m-bob2") == "governance.organization.duplicate-handle",
            enrollCode(world, "o-heron3", "Heron", "p-alice", "m-alice3") == "name.scope.chars",
            enrollCode(world, "o-heron4", "heron", "p-bot", "m-bot2") == "governance.principal.workflow",
            enrollCode(world, "o-heron5", "heron", "p-nobody", "m-x") == "governance.principal.missing",
            Fixture::code(enroll(world, "o-heron6", "heron", "p-alice", "m-alice6",
                Fixture::refused("p-alice", "m-alice6", Governance::organizationStatement("o-heron6", "heron", "m-alice6")))) == "governance.proof.rejected:ceremony-failed"
        ])
    }

    fn enrolledWorld() = match enrollOk(Fixture::world(), "o-heron", "heron", "p-alice", "m-alice2") {
        Success { value } => value
        Error => Fixture::world()
    }

    fn firstCustodianRecorded() = {
        let heron = enrolledWorld()
        checkAll("creation records the organization and its first accepted custodian together", [
            structuralEquals([length(heron.organizations), length(heron.memberships)], [3, 8]),
            Governance::isCustodian(match Governance::membershipOf(heron, "m-alice2") {
                Success { value } => value
                Error => Governance::Membership { id: "", org: "", principal: "", role: Governance::Member, status: Governance::Revoked, authorityEpoch: 0 }
            })
        ])
    }

    fn elevate(world, org, target, proofA, proofB) =
        GovernanceTransitions::grantCustodianship(world, org, target, proofA, proofB)

    fn elevateCode(world, org, target, proofA, proofB) =
        Fixture::code(elevate(world, org, target, proofA, proofB))

    fn aliceAndErin(world, org, target) = {
        let statement = Governance::custodianStatement(org, target)
        [Fixture::verified("p-alice", "m-alice", statement), Fixture::verified("p-erin", "m-erin", statement)]
    }

    fn custodianQuorum() = {
        let world = Fixture::world()
        let proofs = aliceAndErin(world, "o-finch", "m-bob")
        let bobProof = Fixture::verified("p-bob", "m-bob", Governance::custodianStatement("o-finch", "m-bob"))
        let daveProof = Fixture::verified("p-dave", "m-dave", Governance::custodianStatement("o-finch", "m-bob"))
        let aliceProof = listGet(proofs, 0) ?: bobProof
        let erinProof = listGet(proofs, 1) ?: bobProof
        let elevated = Fixture::orKeep(world, fn(w) => elevate(w, "o-finch", "m-bob", aliceProof, erinProof))
        checkAll("custodianship needs two distinct existing custodians' fresh proofs", [
            elevateCode(world, "o-finch", "m-bob", aliceProof, erinProof) == "",
            elevateCode(world, "o-finch", "m-bob", aliceProof, aliceProof) == "governance.custodian.quorum",
            elevateCode(world, "o-finch", "m-bob", bobProof, erinProof) == "governance.custodian.required",
            elevateCode(world, "o-finch", "m-bob", daveProof, erinProof) == "governance.custodian.required",
            elevateCode(world, "o-finch", "m-bot", aliceProof, erinProof) == "governance.principal.workflow",
            elevateCode(world, "o-wren", "m-bob", aliceProof, erinProof) == "governance.membership.other-org",
            authorityEpochOf(elevated, "m-bob") == 2
        ])
    }

    fn revoke(world, target, proof) = GovernanceTransitions::revokeMembership(world, target, proof)

    fn revocationStatement(org, target) = Governance::revocationStatement(org, target)

    /// `actor` names one fixture row, whose principal `p-<actor>` signs the
    /// revocation of `target` in `org` with membership `m-<actor>`.
    fn revokeAs(world, actor, org, target) =
        revoke(world, target, Fixture::verified("p-" + actor, "m-" + actor, revocationStatement(org, target)))

    fn revokeCode(world, actor, org, target) = Fixture::code(revokeAs(world, actor, org, target))

    /// The world after finch's second custodian departs: the starting point of
    /// every last-custodian scenario below.
    fn erinRevoked(world) = Fixture::orKeep(world, fn(w) => revokeAs(w, "alice", "o-finch", "m-erin"))

    fn custodianRevocation() = {
        let world = Fixture::world()
        let erinGone = erinRevoked(world)
        checkAll("revocation is a custodian's signed decision with structural guards", [
            revokeCode(world, "alice", "o-finch", "m-erin") == "",
            revokeCode(world, "bob", "o-finch", "m-carol") == "governance.custodian.required",
            revokeCode(world, "dave", "o-finch", "m-carol") == "governance.custodian.required",
            Fixture::code(revoke(world, "m-carol", Fixture::verified("p-alice", "m-alice", "other-statement"))) == "governance.proof.statement-mismatch",
            revokeCode(erinGone, "erin", "o-finch", "m-alice") == "governance.custodian.required",
            // [PACKAGE-OWNERSHIP-MODEL] "Organization governance belongs to accepted
            // members marked `custodian`": a custodian of another organization
            // holds no signing authority here, so the refusal is the custodian
            // guard's, never a target-org report.
            revokeCode(erinGone, "dave", "o-wren", "m-alice") == "governance.custodian.required",
            revokeCode(world, "alice", "o-finch", "m-nobody") == "governance.membership.missing"
        ])
    }

    /// The last accepted custodian cannot be revoked, and an administrator
    /// membership cannot be removed while it still administers
    /// [PACKAGE-OWNERSHIP-ADMIN].
    fn lastCustodianAndAdministrators() = {
        let world = Fixture::world()
        let erinGone = erinRevoked(world)
        checkAll("the last custodian and administering members are protected", [
            revokeCode(erinGone, "erin", "o-finch", "m-alice") == "governance.custodian.required",
            Fixture::code(revoke(erinGone, "m-alice", Fixture::refused("p-erin", "m-erin", revocationStatement("o-finch", "m-alice")))) == "governance.custodian.required",
            // [PACKAGE-OWNERSHIP-MODEL] "No organization can lose its last
            // accepted custodian": the only remaining custodian signing her own
            // revocation still hits that guard, after her proof is accepted.
            revokeCode(erinGone, "alice", "o-finch", "m-alice") == "governance.org.last-custodian",
            revokeCode(world, "erin", "o-finch", "m-alice") == "governance.membership.administers-package",
            revokeCode(world, "dave", "o-wren", "m-dave") == "governance.org.last-custodian",
            revokeCode(world, "carol", "o-finch", "m-carol") == "governance.custodian.required"
        ])
    }

    fn rejoin(world, principal, membership) = {
        let invitation = Fixture::verified("p-alice", "m-alice",
            Governance::invitationStatement("o-finch", principal, membership))
        let acceptance = Fixture::verified(principal, membership,
            Governance::membershipAcceptanceStatement("o-finch", principal, membership))
        GovernanceTransitions::acceptMembership(world, "o-finch", principal, membership, invitation, acceptance)
    }

    fn rejoinCode(world, principal, membership) = Fixture::code(rejoin(world, principal, membership))

    /// The authority epoch recorded for one membership, 0 once it is gone.
    fn authorityEpochOf(world, id) = match Governance::membershipOf(world, id) {
        Success { value } => value.authorityEpoch
        Error => 0
    }

    /// Every authorization check in this module asks the same package at the
    /// same moment.
    fn authorizeCode(world, membership, permission) =
        Fixture::code(GovernanceTransitions::authorize(world, "pkg-f1", membership, permission, 100))

    /// Departure and rejoin [PACKAGE-OWNERSHIP-PERMISSIONS]: a rejoin is a
    /// new membership id; the revoked row and its grants are never reactivated.
    fn rejoinCreatesNewIdentity() = {
        let world = Fixture::world()
        let granted = Fixture::grantOn(world, "pkg-f1", "g-carol", "m-carol", Governance::ManageSecurity, Maybe::some(200), 100)
        let departed = Fixture::orKeep(granted, fn(w) => revokeAs(w, "alice", "o-finch", "m-carol"))
        let rejoined = Fixture::orKeep(departed, fn(w) => rejoin(w, "p-carol", "m-carol2"))
        checkAll("rejoin is a fresh membership and revives nothing", [
            rejoinCode(departed, "p-carol", "m-carol2") == "",
            rejoinCode(rejoined, "p-carol", "m-carol3") == "governance.membership.already-active",
            rejoinCode(rejoined, "p-bob", "m-bob9") == "governance.membership.already-active",
            authorizeCode(granted, "m-carol", Governance::ManageSecurity) == "",
            authorizeCode(departed, "m-carol", Governance::ManageSecurity) == "governance.membership.inactive",
            authorizeCode(rejoined, "m-carol", Governance::ManageSecurity) == "governance.membership.inactive",
            authorizeCode(rejoined, "m-carol2", Governance::ManageSecurity) == "governance.permission.missing",
            authorityEpochOf(rejoined, "m-carol") == 2
        ])
    }

    /// The world after `principal` is suspended; a failed suspension keeps it.
    fn suspended(world, principal) =
        Fixture::orKeep(world, fn(w) => GovernanceTransitions::suspendPrincipal(w, principal))

    /// Suspension freezes administered packages immediately without breaking
    /// the admin reference [PACKAGE-OWNERSHIP-ADMIN].
    fn suspensionFreezesWrites() = {
        let world = Fixture::world()
        let granted = Fixture::grantOn(world, "pkg-f1", "g-bob", "m-bob", Governance::YankRelease, Maybe::some(200), 100)
        let bobSuspended = suspended(granted, "p-bob")
        let aliceSuspended = suspended(world, "p-alice")
        checkAll("principal suspension denies immediately and freezes administered packages", [
            Fixture::code(GovernanceTransitions::suspendPrincipal(world, "p-nobody")) == "governance.principal.missing",
            authorizeCode(bobSuspended, "m-bob", Governance::YankRelease) == "governance.principal.suspended",
            authorizeCode(bobSuspended, "m-carol", Governance::YankRelease) == "governance.permission.missing",
            authorizeCode(aliceSuspended, "m-carol", Governance::YankRelease) == "governance.package.frozen",
            match Governance::packageOf(aliceSuspended, "pkg-f1") {
                Success { value } => value.admin == "m-alice"
                Error => false
            },
            Fixture::code(GovernanceTransitions::grantPermission(aliceSuspended, "pkg-f1", "g-x",
                Fixture::verified("p-alice", "m-alice", "s"), "m-carol", Governance::EditMetadata, Maybe::some(200), 100)) == "governance.package.frozen"
        ])
    }

    export fn run() = {
        test("governance membership: enrollment", organizationEnrollment)
        test("governance membership: first custodian recorded", firstCustodianRecorded)
        test("governance membership: custodian quorum", custodianQuorum)
        test("governance membership: revocation guards", custodianRevocation)
        test("governance membership: last custodian and administrators", lastCustodianAndAdministrators)
        test("governance membership: rejoin creates a new identity", rejoinCreatesNewIdentity)
        test("governance membership: suspension freezes writes", suspensionFreezesWrites)
    }
}
