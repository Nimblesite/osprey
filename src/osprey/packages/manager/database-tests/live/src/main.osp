namespace registry_live_tests;
import registry_api::HostedService
import registry::Policy
import registry::Bundle
import registry::Release
import registry::ReleaseFiles
import registry_host::Database
import registry_host::BrowserSessions
import registry_host::LoginFlow
import registry_host::Host
import registry_host::Native

/// Two organizations own the same leaf name. Two people in the first organization
/// hold independent publisher grants. Each case runs inside a rolled-back transaction.
fn seed() = join([
    "INSERT INTO principals (id,kind,state,credential_epoch,created_at) SELECT md5('person'||i)::uuid,'human','active',1,now() FROM generate_series(1,3) i;",
    "INSERT INTO organizations (id,handle,display_name,state,governance_epoch,created_at) SELECT md5('org'||i)::uuid,'org-'||i,'Org '||i,'active',1,now() FROM generate_series(1,2) i;",
    "INSERT INTO memberships (id,organization_id,principal_id,role,principal_kind,state,authority_epoch,accepted_at) SELECT md5('member'||i)::uuid,md5('org'||(CASE WHEN i=3 THEN 2 ELSE 1 END))::uuid,md5('person'||i)::uuid,'member','human','active',1,now() FROM generate_series(1,3) i;",
    "INSERT INTO packages (id,organization_id,name,admin_membership_id,admin_membership_state,admin_principal_kind,authority_epoch,state,created_at) SELECT md5('package'||i)::uuid,md5('org'||i)::uuid,'audio',md5('member'||(CASE WHEN i=2 THEN 3 ELSE 1 END))::uuid,'active','human',1,'active',now() FROM generate_series(1,2) i;",
    "INSERT INTO package_permissions (id,organization_id,package_id,membership_id,permission,state,granted_by_membership_id,authority_epoch,membership_authority_epoch,granted_at) SELECT md5('grant'||i)::uuid,md5('org1')::uuid,md5('package1')::uuid,md5('member'||i)::uuid,'publish-release','active',md5('member1')::uuid,1,1,now() FROM generate_series(1,2) i;"
], "\n")

let fixtureClient = "psql -XqAt --no-password -p 18873 -U registry_check -d postgres -v ON_ERROR_STOP=1 -v VERBOSITY=verbose -c "

fn onFixture(command) = perform Host::Process.run("case \"$PGHOST\" in /tmp/osprey-registry.*) " + command + ";; *) exit 1;; esac")

fn execute(sql) = {
    let tx = "BEGIN; SET LOCAL search_path TO registry, pg_catalog; " + seed() + sql + "; ROLLBACK;"
    onFixture(fixtureClient + Host::shellWord(tx))
}

fn answer(sql, expected) = {
    let run = execute(sql)
    run.status == 0 && trim(run.stdout) == expected
}

fn refused(sql, sqlState) = {
    let run = execute(sql)
    run.status != 0 && contains(run.stderr, "ERROR:  " + sqlState + ":")
}

/// [PACKAGE-OWNERSHIP-DATABASE] [PACKAGE-NAMES-NO-SITTING]
fn constraints() = checkAll("ownership constraints on real PostgreSQL", [
    answer("SELECT count(*) FROM packages WHERE name='audio'", "2"),
    refused("UPDATE packages SET organization_id=md5('org1')::uuid,admin_membership_id=md5('member1')::uuid WHERE id=md5('package2')::uuid", "23505"),
    refused("UPDATE package_permissions SET membership_id=md5('member3')::uuid WHERE id=md5('grant2')::uuid", "23503"),
    refused("UPDATE package_permissions SET membership_authority_epoch=0 WHERE id=md5('grant2')::uuid", "23514"),
    refused("UPDATE package_permissions SET membership_authority_epoch=NULL WHERE id=md5('grant2')::uuid", "23502"),
    answer("UPDATE package_permissions SET state='revoked' WHERE id=md5('grant2')::uuid; SELECT membership_id=md5('member1')::uuid FROM package_permissions WHERE state='active'", "t")
])

fn restricted(statement) = "CREATE ROLE registry_fixture_reader NOSUPERUSER NOBYPASSRLS; GRANT USAGE ON SCHEMA registry TO registry_fixture_reader; GRANT SELECT, INSERT ON organizations TO registry_fixture_reader; SET LOCAL ROLE registry_fixture_reader; " + statement

/// [PACKAGE-OWNERSHIP-RLS] The table privileges are real and RLS independently denies access.
fn bootstrap() = checkAll("bootstrap RLS hides rows and rejects writes", [
    answer(restricted("SELECT count(*) FROM organizations"), "0"),
    refused(restricted("INSERT INTO organizations(id,handle,display_name,state,governance_epoch,created_at) VALUES(gen_random_uuid(),'third-org','Third','active',1,now())"), "42501")
])

/// Login starts and claims use database time and a single destructive read [PACKAGE-HOSTED-AUTH].
fn loginFlow() = {
    let flowState = "'sha256:' || repeat('a',64)"
    let browser = "'sha256:' || repeat('b',64)"
    let other = "'sha256:' || repeat('c',64)"
    let save = "EXECUTE start_flow(${flowState},${browser},'fixture-envelope');"
    let claim = "EXECUTE claim_flow(${flowState},${browser});"
    let prepare = "PREPARE start_flow(text,text,text) AS " + LoginFlow::store() + "; PREPARE claim_flow(text,text) AS " + LoginFlow::claim() + ";"
    checkAll("pending login is browser-bound, expires, and can be consumed once", [
        answer(prepare + save + "EXECUTE claim_flow(${flowState},${other}); EXECUTE claim_flow(${other},${browser}); SELECT count(*) FROM pending_logins;" + claim + claim + "SELECT count(*) FROM pending_logins", "1\nfixture-envelope\n0"),
        answer(prepare + save + "UPDATE registry.pending_logins SET created_at=statement_timestamp()-interval '10 minutes';" + claim, ""),
        refused(prepare + save + save, "23505"),
        refused(prepare + "EXECUTE start_flow('bad',${browser},'fixture-envelope');", "23514"),
        answer(prepare + save + "CREATE ROLE login_fixture_reader NOSUPERUSER NOBYPASSRLS; GRANT USAGE ON SCHEMA registry TO login_fixture_reader; GRANT SELECT,DELETE ON pending_logins TO login_fixture_reader; SET LOCAL registry.login_state = ''; SET LOCAL registry.login_browser = ''; SET LOCAL ROLE login_fixture_reader;" + claim + "RESET ROLE;" + claim, "fixture-envelope")
    ])
}

/// Separate connections race for one committed row. The winner keeps its row lock until commit.
fn simultaneousCallbacks() = {
    let keys = "'sha256:' || repeat('d',64),'sha256:' || repeat('e',64)"
    let start = "PREPARE start_flow(text,text,text) AS " + LoginFlow::store() + "; EXECUTE start_flow(${keys},'fixture-envelope');"
    let consume = "BEGIN; PREPARE claim_flow(text,text) AS " + LoginFlow::claim() + "; EXECUTE claim_flow(${keys}); SELECT pg_sleep(0.2); COMMIT;"
    let client = fixtureClient + Host::shellWord(consume)
    let result = onFixture(fixtureClient + Host::shellWord(start) + " && { " + client + " & first=$!; " + client + " & second=$!; wait \"$first\" && wait \"$second\"; }")
    checkAll("exactly one concurrent callback receives the verifier", [result.status == 0, trim(result.stdout) == "fixture-envelope"])
}

/// The hosted reader distinguishes an attested empty catalog from missing or expired evidence.
fn publicCatalog() = {
    let read = Database::catalogSelect
    let insert = "INSERT INTO registry.public_catalog VALUES (1,statement_timestamp(),statement_timestamp()+interval '5 minutes','{\"packages\":[]}');"
    checkAll("public catalog signed evidence lifetime", [
        answer(read, ""), answer(insert + read, "{\"packages\":[]}"),
        answer(insert + "UPDATE public_catalog SET verified_at=now()-interval '2 hours',expires_at=now()-interval '1 hour';" + read, ""),
        refused("INSERT INTO registry.public_catalog VALUES (1,now(),now()+interval '25 hours','{}')", "23514")
    ])
}

let catalogRow = "{\"packages\":[{\"key\":\"@atlas/net\",\"keywords\":[\"networking\",\"web\"],\"releases\":[{\"digest\":\"sha256:6f1de2d789fe080c782b2f56bd289fde94a4fb05201b137f4267784ac16c4975\",\"epoch\":1,\"licenseExpression\":\"MIT\",\"notices\":[{\"path\":\"NOTICE.md\",\"text\":\"Adapted from Atlas upstream.\\nCopyright Atlas.\"}],\"ordinal\":1,\"publisherId\":\"11111111-1111-4111-8111-111111111111\",\"publisherName\":\"Atlas Engineering\"},{\"digest\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"epoch\":1,\"licenseExpression\":\"Apache-2.0\",\"notices\":[],\"ordinal\":2,\"publisherId\":\"22222222-2222-4222-8222-222222222222\",\"publisherName\":\"Atlas Labs\"}],\"summary\":\"HTTP tools\",\"warnings\":[\"Network access\"]},{\"key\":\"@atlas/render\",\"keywords\":[\"graphics\"],\"releases\":[{\"digest\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"epoch\":1,\"licenseExpression\":\"MIT\",\"notices\":[{\"path\":\"NOTICE.md\",\"text\":\"Adapted from Atlas upstream.\\nCopyright Atlas.\"}],\"ordinal\":1,\"publisherId\":\"11111111-1111-4111-8111-111111111111\",\"publisherName\":\"Atlas Engineering\"}],\"summary\":\"Image tools\",\"warnings\":[]}]}"

let fixtureDigest = "sha256:6f1de2d789fe080c782b2f56bd289fde94a4fb05201b137f4267784ac16c4975"

fn fixtureSource(digest) = if digest == fixtureDigest {
    andThen(ReleaseFiles::assemble("@atlas/net/1.1", [
        Release::File { relPath: "src/main.osp", content: "fn main() = 0\n" },
        Release::File { relPath: "osprey.toml", content: "key = ledger\n" }
    ]), Bundle::encode)
} else { Success { value: "{}" } }

fn fixtureCatalog() = {
    let result = onFixture("printf '%s' " + Host::shellWord(Database::catalogScript()) + " | psql -XqAt -v ON_ERROR_STOP=1 -U registry_catalog_reader")
    if result.status == 0 { Success { value: trim(result.stdout) } } else { Error { message: "database.transaction-failed" } }
}

fn catalogFailure(detail) = {
    print(detail)
    Error { message: "unexpected catalog response" }
}

fn catalogRequest(port) = andThen(httpCreateClient("http://127.0.0.1:${port}", 5000), fn(client) => {
    let observed = match httpGetResponse(client, "/v1/packages", "X-Edge-Secret: fixture-edge-secret-at-least-32-bytes") {
        Success { value } => {
            let valid = httpResponseStatus(value) == 200 && (httpResponseBody(value) ?: "") == catalogRow
            let _released = httpResponseFree(value)
            valid
        }
        Error => false
    }
    let _closed = httpCloseClient(client)
    let browser = onFixture("if [ \"$REGISTRY_BROWSER_CHECK\" = 1 ]; then node scripts/packages/test-registry-preview.cjs --database-catalog ${port}; fi")
    if observed && browser.status == 0 { Success { value: 0 } } else { catalogFailure(browser.stderr) }
})

fn catalogListener() = {
    let setup = "CREATE ROLE registry_catalog_reader LOGIN; GRANT USAGE ON SCHEMA registry TO registry_catalog_reader; GRANT SELECT ON registry.public_catalog TO registry_catalog_reader; INSERT INTO registry.public_catalog VALUES(1,now(),now()+interval '10 minutes','${catalogRow}')"
    let created = onFixture(fixtureClient + Host::shellWord(setup))
    let config = "{\"apiHost\":\"api.example.test\",\"websiteOrigin\":\"https://packages.example.test\",\"edgeSecret\":\"fixture-edge-secret-at-least-32-bytes\"}"
    let port = 20000 + random() % 15000
    let served = andThen(HostedService::config(config), fn(policy) => HostedService::withListeners(policy { allowedHost: "127.0.0.1" }, "content.example.test", "127.0.0.1", port, port + 1, fixtureCatalog, fixtureSource, fn() => catalogRequest(port)))
    checkAll("restricted PostgreSQL login behind public HTTP ingress", [created.status == 0, (served ?: -1) == 0])
}

let sessionSetup = "INSERT INTO auth_bindings(id,principal_id,issuer,provider,provider_subject,auth_subject,state,verified_at) VALUES (md5('binding')::uuid,md5('person1')::uuid,'https://supabase.example.test/auth/v1','github','421',md5('subject')::uuid,'active',now());"
let sessionCookie = "'sha256:' || repeat('1',64)"
let sessionIssuer = "'https://supabase.example.test/auth/v1'"
let sessionIdentity = "md5('subject')::uuid,'421'"

fn sessionStatement(name, types, sql) = "PREPARE ${name}(${types}) AS ${sql};"

fn sessionSql() = join([
    sessionSetup,
    sessionStatement("issue", "text,text,uuid,text,text", BrowserSessions::issue),
    sessionStatement("lookup", "text", BrowserSessions::lookup),
    sessionStatement("touch", "text,text,uuid,text", BrowserSessions::touch),
    sessionStatement("revoke", "text", BrowserSessions::revoke)
], "")

fn sessionIssue(issuer, identity) = "EXECUTE issue(${sessionCookie},${issuer},${identity},'encrypted-provider-token');"
let lookup = "EXECUTE lookup(${sessionCookie});"
fn issued() = sessionIssue(sessionIssuer, sessionIdentity)

fn competingBinding() = "INSERT INTO auth_bindings(id,principal_id,issuer,provider,provider_subject,auth_subject,state,verified_at) SELECT md5('other-binding')::uuid,md5('person2')::uuid,issuer,provider,'999',auth_subject,'active',now() FROM auth_bindings;"

fn stableSessionChecks() = checkAll("live session checks exact provider binding and erases tokens on logout", [
    refused(sessionSetup + competingBinding(), "23505"),
    answer(sessionSql() + sessionIssue("'https://foreign.example.test/auth/v1'", sessionIdentity) + lookup, ""),
    answer(sessionSql() + sessionIssue(sessionIssuer, "md5('other')::uuid,'421'") + sessionIssue(sessionIssuer, "md5('subject')::uuid,'422'") + lookup, ""),
    sessionRun("EXECUTE touch(${sessionCookie},${sessionIssuer},md5('other')::uuid,'421');" + lookup, 2, "encrypted-provider-token"),
    sessionRun("EXECUTE touch(${sessionCookie},${sessionIssuer},${sessionIdentity});" + lookup, 3, "encrypted-provider-token"),
    sessionRun("EXECUTE revoke(${sessionCookie}); EXECUTE revoke(${sessionCookie}); " + lookup + "SELECT token_envelope IS NULL FROM browser_sessions;", 3, "t")
])

fn sessionRun(suffix, expectedLines, expected) = {
    let result = execute(sessionSql() + issued() + suffix)
    let output = trim(result.stdout)
    result.status == 0 && length(split(output, "\n") ?: []) == expectedLines && endsWith(output, expected)
}

fn sessionDenied(mutation) = {
    let result = execute(sessionSql() + issued() + mutation + lookup + "EXECUTE touch(${sessionCookie},${sessionIssuer},${sessionIdentity}); SELECT 'checked';")
    result.status == 0 && length(split(trim(result.stdout), "\n") ?: []) == 2 && endsWith(trim(result.stdout), "checked")
}

fn sessionLifetimeChecks() = checkAll("old, suspended, revoked and rotated sessions fail closed", [
    sessionDenied("UPDATE browser_sessions SET started_at=now()-interval '60 minutes',last_used_at=now()-interval '30 minutes';"),
    sessionDenied("UPDATE browser_sessions SET started_at=now()-interval '12 hours';"),
    sessionDenied("UPDATE auth_bindings SET state='revoked';"),
    sessionDenied("UPDATE principals SET credential_epoch=2;"),
    sessionDenied("UPDATE principals SET state='suspended';"),
    sessionDenied("UPDATE auth_bindings SET principal_id=md5('person2')::uuid;"),
    sessionDenied("CREATE ROLE session_outsider NOSUPERUSER NOBYPASSRLS; GRANT USAGE ON SCHEMA registry TO session_outsider; GRANT SELECT,UPDATE ON browser_sessions,auth_bindings,principals TO session_outsider; SET LOCAL ROLE session_outsider;")
])

let roleSetup = "CREATE ROLE registry_login_runtime LOGIN NOSUPERUSER NOBYPASSRLS; GRANT USAGE ON SCHEMA registry TO registry_login_runtime; GRANT INSERT(state_digest,browser_digest,verifier_envelope,created_at), SELECT(state_digest,browser_digest,verifier_envelope,created_at), DELETE ON registry.pending_logins TO registry_login_runtime;"
let loginClient = "psql -XqAt --no-password -U registry_login_runtime -v ON_ERROR_STOP=1"

fn loginRun(script) = match script {
    Success { value } => onFixture("printf '%s' " + Host::shellWord(value) + " | " + loginClient)
    Error { message } => Host::Run { status: 1, stdout: "", stderr: message }
}

fn countWithScope(flowState, browser) = Database::loginScript(flowState, browser,
    "SELECT count(*) FROM registry.pending_logins WHERE state_digest <> " + Database::decoded(1),
    ["sha256:" + (repeat("0",64) ?: "")])

fn restrictedLoginJourney() = {
    let initialized = onFixture(fixtureClient + Host::shellWord(roleSetup))
    let flowState = "sha256:" + (repeat("a",64) ?: "")
    let opener = "sha256:" + (repeat("b",64) ?: "")
    let stranger = "sha256:" + (repeat("c",64) ?: "")
    let envelope = "sealed-fixture-envelope"
    let wrote = loginRun(LoginFlow::storeScript(flowState, opener, envelope))
    let scoped = loginRun(Success { value: countWithScope(flowState, opener) })
    let hidden = loginRun(Success { value: countWithScope(flowState, stranger) })
    let mismatch = loginRun(LoginFlow::claimScript(flowState, stranger))
    let consumed = loginRun(LoginFlow::claimScript(flowState, opener))
    let replay = loginRun(LoginFlow::claimScript(flowState, opener))
    checkAll("actual pre-authentication connection consumes only the scoped verifier", [
        initialized.status == 0, wrote.status == 0,
        scoped.status == 0 && trim(scoped.stdout) == "1",
        hidden.status == 0 && trim(hidden.stdout) == "0",
        mismatch.status == 0 && trim(mismatch.stdout) == "",
        consumed.status == 0 && trim(consumed.stdout) == envelope,
        replay.status == 0 && trim(replay.stdout) == ""
    ])
}

fn suites() = {
    test("restricted pre-authentication connection", restrictedLoginJourney)
    test("live browser session identity and logout", stableSessionChecks)
    test("live browser session expiry and revocation", sessionLifetimeChecks)
    test("browser sessions start closed", fn() => checkAll("browser sessions use forced row security", [answer("SELECT relrowsecurity AND relforcerowsecurity FROM pg_class WHERE oid = 'registry.browser_sessions'::regclass", "t")]))
    test("verified public catalog", publicCatalog)
    test("PostgreSQL-backed hosted API", catalogListener)
    test("publisher delegation storage", constraints)
    test("private schema bootstrap", bootstrap)
    test("pending GitHub login", loginFlow)
    test("concurrent GitHub callbacks", simultaneousCallbacks)
    0
}

fn main() = Policy::guarded(fn() => Native::process()(suites))
