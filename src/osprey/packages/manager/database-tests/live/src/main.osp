fn fixtureBrowserBinding() = "INSERT INTO registry.principals(id,kind,state,credential_epoch,created_at) VALUES (md5('hosted-browser')::uuid,'human','active',1,now()); INSERT INTO registry.auth_bindings(id,principal_id,issuer,provider,provider_subject,auth_subject,state,verified_at) VALUES (md5('hosted-binding')::uuid,md5('hosted-browser')::uuid,'${fixtureOAuth.supabaseOrigin}/auth/v1','github','421','${fixtureBrowserSubject}','active',now());"

/// A Cloud KMS `operation` (encrypt or decrypt) on `key` from the fixture service account, carrying the bound AAD.
fn kmsCall(method, base, path, headers, body, key, operation) = method == "POST" && base == fixtureKmsOrigin
    && path == "/v1/${key}:${operation}" && headers == fixtureKmsHeaders && startsWith(body, aadField)

fn kmsFixture() = handler Supabase::Provider {
    request method base path headers body =>
        if method == "GET" && base == "http://metadata.google.internal"
            && path == "/computeMetadata/v1/instance/service-accounts/default/token" && headers == "Metadata-Flavor: Google" && body == "" {
            Success { value: Supabase::Reply { status: 200, body: "{\"access_token\":\"fixture-access\",\"token_type\":\"Bearer\"}" } }
        } else if kmsCall(method, base, path, headers, body, kmsKey, "encrypt") && contains(body, ",\"plaintext\":\"") {
            Success { value: Supabase::Reply { status: 200, body: "{\"ciphertext\":\"${fixtureCiphertext}\"}" } }
        } else if kmsCall(method, base, path, headers, body, kmsKey, "decrypt") && contains(body, ",\"ciphertext\":\"${fixtureCiphertext}\"") {
            Success { value: Supabase::Reply { status: 200, body: "{\"plaintext\":\"ZEJqZnRKZVo0Q1ZQLW1COTJLMjd1aGJVSlUxcDFyX3dXMWdGV0ZPRWpYaw==\"}" } }
        } else if kmsCall(method, base, path, headers, body, sessionKmsKey, "encrypt") {
            sessionKmsReply(body, "plaintext", "ciphertext", sessionPlaintext, rotatedPlaintext, sessionCiphertext, rotatedCiphertext)
        } else if kmsCall(method, base, path, headers, body, sessionKmsKey, "decrypt") {
            sessionKmsReply(body, "ciphertext", "plaintext", sessionCiphertext, rotatedCiphertext, sessionPlaintext, rotatedPlaintext)
        } else if method == "POST" && base == fixtureOAuth.supabaseOrigin && path == "/auth/v1/token?grant_type=pkce"
            && body == "{\"auth_code\":\"fixture-callback-code\",\"code_verifier\":\"dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk\"}" {
            Success { value: Supabase::Reply { status: 200, body: "{\"access_token\":\"fixture-provider-access\",\"refresh_token\":\"fixture-provider-refresh\",\"expires_in\":600}" } }
        } else if method == "POST" && base == fixtureOAuth.supabaseOrigin && path == "/auth/v1/token?grant_type=refresh_token"
            && body == "{\"refresh_token\":\"fixture-provider-refresh\"}" {
            Success { value: Supabase::Reply { status: 200, body: "{\"access_token\":\"fixture-provider-rotated\",\"refresh_token\":\"fixture-provider-next\",\"expires_in\":600}" } }
        } else if method == "GET" && base == fixtureOAuth.supabaseOrigin && path == "/auth/v1/user"
            && listContains(["apikey: sb_publishable_fixture\r\nAuthorization: Bearer fixture-provider-access", "apikey: sb_publishable_fixture\r\nAuthorization: Bearer fixture-provider-rotated"], headers) {
            Success { value: Supabase::Reply { status: 200, body: "{\"id\":\"${fixtureBrowserSubject}\",\"identities\":[{\"provider\":\"github\",\"id\":\"421\",\"user_id\":\"${fixtureBrowserSubject}\"}]}" } }
        } else { Error { message: "fixture.unexpected-encryption-request" } }
}
fn sessionKmsReply(body, input, output, oldIn, newIn, oldOut, newOut) = {
    let payload = if endsWith(body, ",\"${input}\":\"${oldIn}\"}") { oldOut }
        else if endsWith(body, ",\"${input}\":\"${newIn}\"}") { newOut } else { "" }
    if payload == "" { Error { message: "fixture.unexpected-envelope" } }
    else { Success { value: Supabase::Reply { status: 200, body: "{\"${output}\":\"${payload}\"}" } } }
}

fn storedLogin(flowState, browser, envelope) = {
    let result = loginRun(LoginFlow::storeScript(flowState, browser, envelope))
    if result.status == 0 { Success { value: "" } } else { Error { message: "fixture.login-store-failed" } }
}
fn openLogin() = kmsFixture()(fn() => HostedLogin::start(fixtureOAuth, fn(aad, verifier) => LoginKms::seal(kmsKey, aad, verifier), storedLogin))
fn claimLogin(flowState, browser) = {
    let claimed = loginRun(LoginFlow::claimScript(flowState, browser))
    if claimed.status == 0 { Success { value: trim(claimed.stdout) } }
    else { Error { message: "fixture.login-claim-failed" } }
}

fn storeBrowser(digest, issuer, subject, github, envelope) = andThen(BrowserSessions::issueScript(digest, issuer, subject, github, envelope), fn(script) => {
    let result = fixtureScript(issuerClient, script)
    if result.status == 0 { Success { value: trim(result.stdout) } } else { Error { message: "fixture.session-storage" } }
})
fn loginCallback(path, headers) = kmsFixture()(fn() => andThen(HostedLogin::callback(fixtureOAuth, path, headers,
    claimLogin, fn(aad, envelope) => LoginKms::unseal(kmsKey, aad, envelope)), fn(identity) =>
        HostedLogin::issue(fixtureOAuth, identity, fn(aad, session) => LoginKms::sealSession(sessionKmsKey, aad, session), storeBrowser)))

fn browserRuntime(role, script) = andThen(script, fn(value) => {
    let result = fixtureScript("psql -XqAt --no-password -U ${role} -v ON_ERROR_STOP=1", value)
    if result.status == 0 { Success { value: trim(result.stdout) } } else { Error { message: "fixture.session-runtime" } }
})
fn readBrowser(token) = kmsFixture()(fn() => HostedLogin::readSession(fixtureOAuth, token,
    fn(digest) => browserRuntime(runtimeRole, BrowserSessions::readScript(digest)), fn(aad, envelope) => LoginKms::openSession(sessionKmsKey, aad, envelope),
    fixtureCredentials, fn(digest, issuer, subject, github) =>
        browserRuntime(runtimeRole, BrowserSessions::touchScript(digest, issuer, subject, github))))
fn reserveOnce(digest, issuer, subject, github, previous) = {
    let script = BrowserSessions::claimRefreshScript(digest, issuer, subject, github, previous)
    andThen(browserRuntime(runtimeRole, script), fn(claim) => andThen(browserRuntime(runtimeRole, script), fn(replayed) =>
        if replayed == "" && Bytes::canonicalUuid(claim) { Success { value: claim } } else { Error { message: "fixture.refresh-not-exclusive" } }))
}
fn finishOnce(cookie, issuer, subject, github, previous, claim, replacement) = andThen(browserRuntime(runtimeRole,
    BrowserSessions::finishRefreshScript(cookie, issuer, subject, github, previous, fixtureBrowserSubject, replacement)), fn(stale) =>
        if stale == "" { browserRuntime(runtimeRole, BrowserSessions::finishRefreshScript(cookie, issuer, subject, github, previous, claim, replacement)) }
        else { Error { message: "fixture.stale-refresh-accepted" } })
fn fixtureCredentials(digest, envelope, credentials) = if envelope == sessionCiphertext {
    HostedLogin::refreshSession(fixtureOAuth, digest, envelope, credentials, reserveOnce,
        finishOnce,
        fn(context, fresh) => LoginKms::sealSession(sessionKmsKey, context, fresh), fn(fresh) => Success { value: fresh })
} else { Supabase::verify(fixtureOAuth, credentials.accessToken) }
fn browserSession(method, token) = if method == "POST" {
    browserRuntime(revokerRole, BrowserSessions::revokeScript(HostedLogin::sessionDigest(token)))
} else { readBrowser(token) }
fn callbackBody(client, path, headers, status) = match httpGetResponse(client, path, headers) {
    Error => ""
    Success { value } => {
        let body = httpResponseBody(value) ?: ""
        let safe = httpResponseStatus(value) == status && !contains(body, "fixture-provider-")
            && (httpResponseHeader(value, cacheControl) ?: "") == "no-store"
            && (httpResponseHeader(value, "referrer-policy") ?: "") == "no-referrer"
            && (status != 403 || (httpResponseHeader(value, "set-cookie") ?: "") == HostedLogin::expiredCookie)
        let _released = httpResponseFree(value)
        if safe { body } else { "" }
    }
}
fn rawSessionCookie(cookie) = drop(Bytes::before(cookie, ";"), byteLength(HostedLogin::sessionCookieName) + 1)
fn sessionExists(cookie) = {
    let raw = rawSessionCookie(cookie)
    let digest = HostedLogin::sessionDigest(raw)
    let found = onFixture(fixtureClient + Host::shellWord("SELECT token_envelope FROM registry.browser_sessions WHERE cookie_digest='${digest}'"))
    startsWith(cookie, HostedLogin::sessionCookieName + "=") && OAuth::challengeCode(raw) == ""
        && endsWith(cookie, "; Path=/; Max-Age=43200; Secure; HttpOnly; SameSite=Lax") && found.status == 0 && trim(found.stdout) == sessionCiphertext
}

fn sessionReply(client, headers, status, marker) = match httpGetResponse(client, "/v1/auth/session", headers) {
    Error => false
    Success { value } => {
        let body = httpResponseBody(value) ?: ""
        let ok = httpResponseStatus(value) == status && contains(body, marker) && !contains(body, "fixture-provider-")
            && (httpResponseHeader(value, cacheControl) ?: "") == "no-store"
        let _released = httpResponseFree(value)
        ok
    }
}

fn sessionJourney(client, browser, cookie) = {
    let edge = Bytes::before(browser, "\r\nCookie:")
    let origin = "\r\nOrigin: " + fixtureOAuth.websiteOrigin
    let request = edge + origin + "\r\nCookie: "
    let signed = request + Bytes::before(cookie, ";")
    let active = sessionReply(client, signed, 200, "\"authenticated\":true") && sessionReply(client, signed, 200, "\"authenticated\":true")
    let unknown = sessionReply(client, request + "${HostedLogin::sessionCookieName}=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 401, HostedLogin::sessionRequired)
    let suspended = setFixturePrincipal("suspended")
    let denied = sessionReply(client, signed, 401, HostedLogin::sessionRequired)
    let revoked = logoutJourney(client, signed, cookie)
    let restored = setFixturePrincipal("active")
    active && unknown && suspended && denied && revoked && restored && sessionReply(client, signed, 401, HostedLogin::sessionRequired)
}

fn logoutStatus(client, headers, status) = match httpPostResponse(client, "/v1/auth/logout", "", headers) {
    Error => false
    Success { value } => {
        let cleared = (httpResponseHeader(value, "set-cookie") ?: "") == "__Host-registry=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"
        let ok = httpResponseStatus(value) == status && cleared == (status == 204)
        let _released = httpResponseFree(value)
        ok
    }
}
fn logoutJourney(client, signed, cookie) = {
    let raw = rawSessionCookie(cookie)
    let csrf = Digests::hashText("registry.browser.session.csrf.v1", raw)
    let valid = signed + "\r\nX-Csrf-Token: " + csrf
    let ended = logoutStatus(client, signed, 403) && logoutStatus(client, signed + "\r\nX-Csrf-Token: wrong", 403)
        && logoutStatus(client, replace(valid, fixtureOAuth.websiteOrigin, "https://untrusted.example.test") ?: "", 403)
        && logoutStatus(client, valid, 204) && logoutStatus(client, valid, 204)
    let stored = onFixture(fixtureClient + Host::shellWord("SELECT revoked_at IS NOT NULL AND token_envelope IS NULL AND NOT has_column_privilege('${revokerRole}','registry.browser_sessions','token_envelope','SELECT') FROM registry.browser_sessions WHERE cookie_digest='${HostedLogin::sessionDigest(raw)}'"))
    ended && stored.status == 0 && trim(stored.stdout) == "t"
}

fn setFixturePrincipal(status) = {
    let changed = onFixture(fixtureClient + Host::shellWord("UPDATE registry.principals SET state='${status}' WHERE id=md5('hosted-browser')::uuid"))
    changed.status == 0
}
fn successfulCallback(client, path, browser) = match httpGetResponse(client, path, browser) {
    Error => false
    Success { value } => {
        let cookie = httpResponseHeader(value, "set-cookie") ?: ""
        let safe = httpResponseStatus(value) == 303 && (httpResponseBody(value) ?: "") == ""
            && (httpResponseHeader(value, "location") ?: "") == fixtureOAuth.websiteOrigin + "/upload/"
            && (httpResponseHeader(value, "referrer-policy") ?: "") == "no-referrer" && (httpResponseHeader(value, cacheControl) ?: "") == "no-store"
        let _released = httpResponseFree(value)
        safe && sessionExists(cookie) && sessionJourney(client, browser, cookie)
    }
}
fn callbackSequence(client, edge, cookie, approved) = {
    let path = OAuth::callbackPath + "?code=fixture-callback-code"
    let cookieHeader = edge + "\r\nCookie: "
    let browser = cookieHeader + Bytes::before(cookie, ";")
    let otherBrowser = cookieHeader + Bytes::before(cookie, ".") + ".AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    let absent = callbackBody(client, path, edge, 401)
    let smuggled = callbackBody(client, path + "&code=second", browser, 401)
    let mismatched = callbackBody(client, path, otherBrowser, 401)
    let ok = if approved { successfulCallback(client, path, browser) }
        else { contains(callbackBody(client, path, browser, 403), HostedLogin::unapproved) }
    let replay = callbackBody(client, path, browser, 401)
    contains(absent, HostedLogin::refused) && contains(smuggled, HostedLogin::refused) && contains(mismatched, HostedLogin::refused)
        && ok && contains(replay, HostedLogin::refused)
}
fn expectLogin(client, edge, approved) = match httpGetResponse(client, HostedLogin::startPath, edge) {
    Error => false
    Success { value } => {
        let location = httpResponseHeader(value, "location") ?: ""
        let cookie = httpResponseHeader(value, "set-cookie") ?: ""
        let valid = httpResponseStatus(value) == 303 && startsWith(location, fixtureOAuth.supabaseOrigin + "/auth/v1/authorize?")
            && endsWith(cookie, "; Path=/; Max-Age=600; Secure; HttpOnly; SameSite=Lax")
            && contains(location, "redirect_to=" + OAuth::component(fixtureOAuth.callback) + "&")
            && !contains(location, fixtureCiphertext) && (httpResponseHeader(value, cacheControl) ?: "") == "no-store"
        let _released = httpResponseFree(value)
        valid && callbackSequence(client, edge, cookie, approved)
    }
}

fn suites() = {
    test("restricted pre-authentication connection", restrictedLoginJourney)
    test("live browser session identity and logout", stableSessionChecks)
    test("restricted browser session issuance", restrictedSessionIssue)
    test("session issuer libpq connection", sessionIssuerConnection)
    test("live browser session expiry and revocation", sessionLifetimeChecks)
    test("browser sessions start closed", fn() => checkAll("browser sessions use forced row security", [answer("SELECT relrowsecurity AND relforcerowsecurity FROM pg_class WHERE oid = 'registry.browser_sessions'::regclass", "t")]))
    test("verified public catalog", publicCatalog)
    test("PostgreSQL-backed hosted API", catalogListener)
    test("publisher delegation storage", constraints)
    test("private schema bootstrap", bootstrap)
    test("pending GitHub login", loginFlow)
    test("concurrent GitHub callbacks", simultaneousCallbacks)
    0
}

fn main() = Policy::guarded(fn() => Native::process()(suites))
