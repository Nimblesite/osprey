namespace registry_tests;
import registry::Policy

/// The suites over the package frontend (`src/osprey/packages/manager/cli/lib`), assembled apart
/// from `src/osprey/packages/manager/tests` so the frontend can depend on the manifest parser
/// without that program paying the parser's type-check cost (plan 0020,
/// Phase 1).
fn suites() = {
    DispatchTests::run()
    FetchTests::run()
    LockfileTests::run()
    InstallTests::run()
    VerifyTests::run()
    BuildTests::run()
    LockTests::run()
    TransactionTests::run()
    OverlayTests::run()
    PublishTests::run()
    PythonTests::run()
    TreeTests::run()
    TreeGraphTests::run()
    ReportsTests::run()
    0
}

fn main() = Policy::guarded(suites)
