namespace registry_tests;
import registry_tests::Fixture
import registry_tests::RegistryFixture
import registry::Identity
import registry::Release

/// The `lock` command against the fixture registry: a two-package registry
/// resolves to the exact lock bytes and `+` lines, a second run prints `=`, a
/// raised floor prints `~`, and every hardening refusal
/// (`lock.release-replaced`, `lock.release-vanished` with and without
/// `--accept-removals`, a current lock that does not decode),
/// `lock.invalid-manifest` and an Explain outcome are asserted by name.
/// Implements [PACKAGE-FOLDER-REGISTRY] and [PACKAGE-HARDENING] C3/C5.
module LockTests {
    let removalsHint = "(rerun with --accept-removals to drop it from the lock)"

    fn one() = RegistryFixture::one()
    fn one2() = RegistryFixture::one2()
    fn two() = RegistryFixture::two()
    fn three() = RegistryFixture::three()
    fn compact(s) = RegistryFixture::compact(s)
    fn rootManifest(floor) = RegistryFixture::rootManifest(floor)
    fn previousLock(a, b) = RegistryFixture::previousLock(a, b)

    fn lockOf(a) = RegistryFixture::writtenTo(a, RegistryFixture::lockPath)

    fn runLock(reads, served, extra) = RegistryFixture::run(reads, RegistryFixture::websOf(served), listConcat(["lock", "--project", RegistryFixture::project], extra))

    fn lockOver(reads, served) = runLock(reads, served, [])

    fn pair() = [one(), two()]

    /// `<prefix> <release>` for every package of `pkgs`.
    fn marked(prefix, pkgs) = mapList(pkgs, fn(p) => "${prefix} ${compact(p)}")

    /// A run of `lock` over `served`, read beside `rootText`'s manifest.
    fn readsRun(rootText, served) = lockOver(RegistryFixture::reads(rootText, served), served)

    /// A first lock run over `served` with no previous lock.
    fn freshRun(served) = readsRun(rootManifest(1), served)

    /// A run of `lock` over `served` beside the previous lock at `floor`.
    fn priorRun(floor, served) = lockOver(priorReads(floor, served), served)

    /// A current lock over `@demo/one` e1.r1 read beside `served`.
    fn priorReads(floor, served) = RegistryFixture::readsWithLock(rootManifest(floor), previousLock(one(), two()), served)

    fn lockedReads(served) = priorReads(1, served)

    fn lockedRun(served) = priorRun(1, served)

    /// A run beside a lock that still names a dropped `@demo/three` e1.r3.
    fn threePriorReads(served) = RegistryFixture::readsWithLock(rootManifest(1), RegistryFixture::previousLockWithThree(), served)

    /// `a`'s line `index` is `name` and nothing was written to the lock.
    fn pieceAndNoLock(a, index, name) = structuralEquals([RegistryFixture::lineOf(a, index), lockOf(a)], [name, ""])

    /// The checks a run that resolves `locked` at `floor`, printing `lines`, must pass.
    fn resolves(name, a, floor, locked, lines) = checkAll(name, [
        RegistryFixture::accepted(a),
        lockOf(a) == RegistryFixture::expectedLock(rootManifest(floor), locked, two()),
        structuralEquals(RegistryFixture::linesOf(a), lines)
    ])

    /// The checks an accepted run that prints `lines` must pass.
    fn acceptedLines(name, a, lines) = checkAll(name, [
        RegistryFixture::accepted(a),
        structuralEquals(RegistryFixture::linesOf(a), lines)
    ])

    /// The checks a refusal that prints `lines` and writes no lock must pass.
    fn refuses(name, a, lines) = checkAll(name, [
        RegistryFixture::statusOf(a) == 1,
        structuralEquals(RegistryFixture::linesOf(a), lines),
        lockOf(a) == ""
    ])

    /// The two source kinds every surface case loops over.
    fn sourceKinds() = [RegistryFixture::io(), RegistryFixture::interpolatedIo()]

    /// The first run: two packages resolved, exact lock bytes, `+` lines.
    fn firstRun() = resolves("a two-package registry resolves to the exact lock bytes and + lines", freshRun(pair()), 1, one(), marked("+", pair()))

    /// A second run with the same lock prints only `=` lines.
    fn secondRun() = acceptedLines("a second run prints only = lines", lockedRun(pair()), marked("=", pair()))

    /// A raised floor selects the newer release of one and prints `~`.
    fn changedFloor() =
        resolves("a raised floor prints ~ for the changed release", priorRun(2, [one(), one2(), two()]), 2, one2(), listConcat(marked("~", [one2()]), marked("=", [two()])))

    fn reserved(s) = Release::Served { id: Identity::ReleaseId { key: Fixture::idOf(s).key, epoch: Fixture::idOf(s).epoch, ordinal: Fixture::idOf(s).ordinal, digest: RegistryFixture::otherDigest }, files: Fixture::filesOf(s) }

    /// A release the listing re-serves under a new digest is a refusal.
    fn releaseReplaced() = refuses("a re-served digest is lock.release-replaced and writes nothing", lockedRun([reserved(one()), two()]), ["lock.release-replaced @demo/one e1.r1 ${Fixture::digestOf(one())} ${RegistryFixture::otherDigest}"])

    /// A dropped locked release is a refusal that names the flag.
    fn releaseVanished() = refuses("a vanished release is lock.release-vanished, names --accept-removals and writes nothing", lockOver(threePriorReads(pair()), pair()), ["lock.release-vanished ${compact(three())} ${removalsHint}"])

    /// With --accept-removals the vanished release is a warning and a `-` line,
    /// and the lock is rewritten without it.
    fn releaseVanishedAccepted() = {
        let lines = listConcat(["lock.release-vanished ${compact(three())}"], listConcat(marked("=", pair()), marked("-", [three()])))
        resolves("--accept-removals warns and removes the vanished release", runLock(threePriorReads(pair()), pair(), ["--accept-removals"]), 1, one(), lines)
    }

    /// A current lock that does not decode is refused, never overwritten.
    fn corruptLock() = {
        let served = pair()
        let a = lockOver(RegistryFixture::readsWithLock(rootManifest(1), "{\"format\":7}", served), served)
        checkAll("a current lock that does not decode is its lock.* code and writes nothing", [
            RegistryFixture::statusOf(a) == 1,
            startsWith(RegistryFixture::lineOf(a, 0), "lock."),
            lockOf(a) == ""
        ])
    }

    /// A candidate whose manifest is rejected is a warning and is excluded;
    /// the resolver then explains the missing package.
    fn invalidManifest() = {
        let served = [RegistryFixture::badOne(), two()]
        let a = freshRun(served)
        checkAll("an invalid candidate manifest is lock.invalid-manifest, excluded and explained", [
            RegistryFixture::statusOf(a) == 1,
            startsWith(RegistryFixture::lineOf(a, 0), "lock.invalid-manifest ${compact(RegistryFixture::badOne())} manifest.project.name at "),
            RegistryFixture::lineOf(a, 1) == "resolution.missing-package",
            pieceAndNoLock(a, 2, "@demo/one")
        ])
    }

    /// A release whose surface the root does not grant is not a candidate.
    fn ungrantedSource(source) = {
        let served = [source]
        let a = freshRun(served)
        let b = readsRun(manifestText("app") + "\n[dependencies]\n\"@demo/io\" = { epoch = 1, min_release = 1 }\n", served)
        checkAll("an ungranted io/files surface is resolution.capability and writes nothing", [
            RegistryFixture::reported(b, 1, "resolution.capability"),
            pieceAndNoLock(b, 1, "@demo/io"),
            RegistryFixture::statusOf(a) == 1
        ])
    }

    fn ungrantedSurface() = forEachList(sourceKinds(), fn(s) => ungrantedSource(s))

    fn manifestText(name) = RegistryFixture::manifestText(name)

    /// With the grant the release is locked and its surface is pinned.
    fn grantedSource(source) = {
        let served = [source]
        let rootText = RegistryFixture::rootManifestGranting("io", ["io/files"])
        let a = readsRun(rootText, served)
        checkAll("a granted surface is locked and pinned", [
            RegistryFixture::accepted(a),
            lockOf(a) == RegistryFixture::expectedLockOf(rootText, [RegistryFixture::pkgWith(source, [], ["io/files"])]),
            structuralEquals(RegistryFixture::linesOf(a), ["+ ${compact(source)}"])
        ])
    }

    fn grantedSurface() = forEachList(sourceKinds(), fn(s) => grantedSource(s))

    /// An unknown word is the usage report.
    fn usage() = {
        let a = RegistryFixture::run([], [], ["lock", "--bogus"])
        checkAll("an unknown word is lock.usage", [RegistryFixture::reported(a, 2, "lock.usage")])
    }

    /// Every lock test.
    export fn run() = {
        test("lock: two-package registry resolves with exact bytes and + lines", firstRun)
        test("lock: a second run prints = lines", secondRun)
        test("lock: a raised floor prints ~", changedFloor)
        test("lock: a re-served digest is refused", releaseReplaced)
        test("lock: a vanished release is refused and names the flag", releaseVanished)
        test("lock: --accept-removals warns and drops", releaseVanishedAccepted)
        test("lock: a corrupt current lock is refused", corruptLock)
        test("lock: an invalid candidate manifest is excluded", invalidManifest)
        test("lock: an ungranted surface is refused", ungrantedSurface)
        test("lock: a granted surface is pinned", grantedSurface)
        test("lock: usage", usage)
    }
}
