namespace registry_cli;
import registry::Bytes
import registry::Canonical
import registry::Json

/// What a command answers: a process status and the lines to show. Rendering
/// stays outside the command so tests inspect the same value a terminal gets.
module Reports {
    export type Report = { status: int, lines: List<string> }

    let ok = 0
    let failureStatus = 1
    let usageError = 2

    /// A successful report.
    export fn success(lines) = Report { status: ok, lines: lines }

    /// A command that could not do what was asked.
    export fn failure(lines) = Report { status: failureStatus, lines: lines }

    /// Verification output projected into editor finding codes.
    export fn findings(report: Report) = if report.status == ok { [] } else { report.lines }

    /// A report for a command line the frontend cannot act on.
    export fn usage(lines) = Report { status: usageError, lines: lines }

    /// The usage report of the command that owns `code`: the code line, then
    /// the command's own usage lines.
    export fn usageFor(code, text) = usage(listPrepend(text, code))

    /// `onSuccess` of a valid result, else the failure report naming its message.
    export fn checked(result, onSuccess) = match result {
        Error { message } => failure([message])
        Success { value } => onSuccess(value)
    }

    /// `onSuccess` of a valid result, else the failure naming `code` and the message.
    export fn checkedWith(result, code, onSuccess) = match result {
        Error { message } => failure(["${code} ${message}"])
        Success { value } => onSuccess(value)
    }

    /// One line per entry of `label: value`.
    export fn field(label, value) = "${label}: ${value}"


    /// The report as one canonical JSON line, `{"lines":[…],"status":N}`, for
    /// editors and automation ([PACKAGE-API]): the very value the terminal
    /// rendering shows, so there is no second semantic API to keep in step.
    export fn json(report: Report) = Canonical::serialize(Json::Obj { members: [
        Json::member("lines", Json::Arr { items: mapList(report.lines, fn(text) => Json::Str { text: text }) }),
        Json::member("status", Json::Num { value: report.status })
    ] }) ?: "{}"

    let replacement = "?"
    let space = 32
    let delete = 127

    fn control(b) = b < space || b == delete

    fn printableByte(b) = if control(b) { replacement } else { "" }

    /// `line` with every byte below 0x20 and the byte 0x7F replaced by `?`, so
    /// a registry- or lock-supplied string cannot carry a terminal escape
    /// sequence to the console ([PACKAGE-HARDENING] C7). Every line the
    /// frontend prints passes through here.
    export fn printable(line) = Bytes::substitute(line, printableByte)
}
