namespace registry_cli;
import registry_host::Host
import registry_cli::Reports
import registry_cli::Flags
import registry_cli::Fetch
import registry_cli::Project
import registry_cli::Overlay
import registry_cli::Lock

/// Resolve before changing the manifest or overlay for `add`, `remove`,
/// `update --breaking` and `use` ([PACKAGE-API], [PACKAGE-LOCAL-OVERRIDE]):
/// `lock` reads the proposed text through an effect handler. Only after
/// resolution succeeds are the manifest and lock written. A reported lock
/// write failure restores both prior file snapshots; the writes are not crash-atomic.
module Transaction {
    /// Where and how to relock: registry, project, the vanished-release
    /// policy, whether the current lock's choices are sticky (`fresh` drops
    /// them so `update` moves to the newest releases), and whether the
    /// development lock is the target (`local`).
    export type Settings = { base: string, project: string, acceptRemovals: bool, fresh: bool, local: bool }

    /// Settings from the parsed command line: `--registry`, `--project`, the
    /// vanished-release policy, sticky-or-fresh choices, and the lock target.
    export fn settingsOf(parsed, acceptRemovals, fresh, local) = Settings {
        base: Flags::given(parsed, Fetch::registryFlag, Fetch::defaultRegistry),
        project: Flags::project(parsed),
        acceptRemovals: acceptRemovals,
        fresh: fresh,
        local: local
    }

    /// Settings for the release lock, with nothing dropped from the current choices.
    export fn releaseSettings(parsed) = settingsOf(parsed, false, false, false)

    // `Settings` shares `base` and `project` with other records; issue #273
    // needs the receiver's record spelled out.
    /// The registry the relock reads.
    export fn baseOf(s: Settings) = s.base
    /// The project the relock writes.
    export fn projectOf(s: Settings) = s.project

    let restoreCode = "transaction.restore"

    /// Relock without touching any file; `update` without `--breaking`.
    export fn relock(s: Settings) = Lock::relock(s.base, s.project, s.fresh, s.acceptRemovals, s.local)

    fn restored(path, previous, locked) = match Host::restore(path, previous) {
        Error { message } => Reports::failure(listAppend(Reports::linesOf(locked), "${restoreCode} ${message}"))
        Success => locked
    }

    fn lockPath(s: Settings) = if s.local { Project::localLockPathAt(s.project) } else { Project::lockPathAt(s.project) }

    fn writtenAfter(path, text, target, content) = match perform Host::Files.write(path, text) {
        Error { message } => Error { message: message }
        Success => perform Host::Files.write(target, content)
    }

    fn commitPrepared(target, path, previous, previousLock, text, prefix, resolve) = {
        mut changed = false
        let staged = handler Host::Files {
            exists requested => if requested == path { Success { value: true } } else { perform Host::Files.exists(requested) }
            remove requested => perform Host::Files.remove(requested)
            read requested => if requested == path { Success { value: text } } else { perform Host::Files.read(requested) }
            write requested content => {
                changed = changed || requested == target
                if requested != target { perform Host::Files.write(requested, content) } else { writtenAfter(path, text, requested, content) }
            }
        }
        let locked = staged(resolve)
        if Reports::statusOf(locked) == 0 { Reports::success(listConcat(prefix, Reports::linesOf(locked))) }
        else if changed { restored(target, previousLock, restored(path, previous, locked)) } else { locked }
    }

    fn commitAt(target, path, previous, text, prefix, resolve) = Reports::checked(Host::snapshot(target), fn(value) => commitPrepared(target, path, previous, value, text, prefix, resolve))

    /// Resolve with proposed manifest `text`; on success `prefix` heads the
    /// lock delta. A reported lock-write failure restores `previous`.
    export fn commit(s, previous, text, prefix) = commitAt(lockPath(s), Project::manifestPathAt(projectOf(s)), Host::Snapshot { present: true, text: previous }, text, prefix, fn() => relock(s))

    /// The same for the overlay `osprey.local.toml` and the development lock.
    export fn commitOverlay(s, text, prefix) = Reports::checked(Host::snapshot(Overlay::pathAt(projectOf(s))), fn(value) => commitAt(lockPath(s), Overlay::pathAt(projectOf(s)), value, text, prefix, fn() => relock(s)))

    /// An unpublished local Add resolves its overlay before writing the new
    /// root dependency. The nested overlay transaction supplies the lock.
    export fn commitLocalManifest(project, previous, text, prefix, resolve) = commitAt(Project::localLockPathAt(project), Project::manifestPathAt(project), Host::Snapshot { present: true, text: previous }, text, prefix, resolve)

}
