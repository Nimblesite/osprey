namespace registry_cli;
import registry_host::Host
import registry_cli::Flags
import registry_cli::Reports
import registry_cli::Project
import registry_cli::Fetch
import registry_cli::Listing
import registry_cli::ManifestEdit
import registry_cli::Transaction
import registry_cli::Use
import registry::Identity
import registry::Maybe
import registry::Names

/// `osprey-pkg add <key-or-path> [--epoch N] [--registry <base-url>] [--project <dir>]`.
/// `add @scope/name` chooses the key's newest epoch (or the lineage `--epoch N`
/// names) and the newest ordinal in it as the floor, writes the dependency
/// line under `[dependencies]`, and relocks; exact digests go only
/// to the lock ([PACKAGE-API], plan 0020 Phase 4). `add <path>` takes the key
/// from the checkout's `[package]`, writes the dependency with the published
/// baseline's ordinal as the floor (zero and epoch 1 when nothing is
/// published, so the dependency is development-only), relocks the release
/// lock when a baseline exists, then maps the checkout in the overlay and
/// relocks the development lock ([PACKAGE-LOCAL-OVERRIDE]); a failure writes
/// back the manifest and the release lock. A key already declared is
/// `add.exists`; a key or epoch the registry does not list is the listing's code.
module Add {
    let usageCode = "add.usage"
    let existsCode = "add.exists"
    let restoreCode = "add.restore"
    let epochFlag = "--epoch"
    let usageText = ["usage: osprey-pkg add <@scope/name | path> [--epoch N] [--registry <base-url>] [--project <dir>]"]

    /// The key to add, the `--epoch` word ("" for the newest) and the relock settings.
    type Request = { key: Names::Key, epochWord: string, settings: Transaction::Settings }

    // Shared field names need typed receivers (issue #273).
    fn keyOf(req: Request) = req.key
    fn settingsIn(req: Request) = req.settings
    fn epochWordOf(req: Request) = req.epochWord

    fn parsedEpoch(word) = match parseInt(word) {
        Success { value } => if value > 0 { Success { value: value } } else { Error { message: usageCode } }
        Error => Error { message: usageCode }
    }

    fn chosenEpoch(req, listing) = if epochWordOf(req) == "" { Listing::newestEpoch(listing, keyOf(req)) } else { parsedEpoch(epochWordOf(req)) }

    // ---- add @scope/name ----

    fn committed(req, text, epoch, floor) = Transaction::commit(settingsIn(req), text,
        ManifestEdit::withEdge(text, ManifestEdit::edgeLine(keyOf(req), epoch, floor)),
        ["added ${Names::display(keyOf(req))} e${epoch}.r${floor}"])

    fn withEpoch(req, text, listing, epoch) = Reports::checked(Listing::newestOrdinal(listing, keyOf(req), epoch), fn(value) => committed(req, text, epoch, value))

    fn withListing(req, text, listing) = match chosenEpoch(req, listing) {
        Error { message } => if message == usageCode { Reports::usageFor(usageCode, usageText) } else { Reports::failure([message]) }
        Success { value } => withEpoch(req, text, listing, value)
    }

    fn withText(req, text) = Reports::checked(Listing::fetch(Transaction::baseOf(settingsIn(req))), fn(value) => withListing(req, text, value))

    /// `next` when the manifest does not already declare `req`'s key.
    fn undeclared(req, text, next) = if ManifestEdit::hasEdge(text, keyOf(req)) { Reports::failure(["${existsCode} ${Names::display(keyOf(req))}"]) } else { next() }

    fn declared(req, text) = undeclared(req, text, fn() => withText(req, text))

    fn withRequest(req) = Reports::checked(Project::manifestTextAt(Transaction::projectOf(settingsIn(req))), fn(value) => declared(req, value))

    fn requestOf(parsed, key) = Request { key: key, epochWord: Flags::given(parsed, epochFlag, ""), settings: Transaction::releaseSettings(parsed) }

    fn withKey(key, parsed) = withRequest(requestOf(parsed, key))

    // ---- add <path> ([PACKAGE-LOCAL-OVERRIDE]) ----

    /// The published baseline of the checkout's key: the newest release of the
    /// epoch in force, none when nothing is published.
    fn baselineFor(req, listing) = match chosenEpoch(req, listing) {
        Error => Maybe::none()
        Success { value } => Listing::newestIn(listing, keyOf(req), value)
    }

    fn epochFor(req, baseline) = Maybe::fold(baseline,
        if epochWordOf(req) == "" { Success { value: 1 } } else { parsedEpoch(epochWordOf(req)) },
        fn(id) => Success { value: Identity::epochOf(id) })
    fn floorFor(baseline) = Maybe::fold(baseline, 0, Identity::ordinalOf)

    fn withRestoreNote(report, result) = match result {
        Error { message } => Reports::failure(listAppend(Reports::linesOf(report), "${restoreCode} ${message}"))
        Success => report
    }

    /// Write back the manifest and the release lock after a failed development relock.
    fn restored(req, previousText, previousLock, report) = {
        let s = settingsIn(req)
        let manifest = perform Host::Files.write(Project::manifestPathAt(Transaction::projectOf(s)), previousText)
        let lock = Host::restore(Project::lockPathAt(Transaction::projectOf(s)), previousLock)
        withRestoreNote(withRestoreNote(report, manifest), lock)
    }

    /// Map the checkout and relock the development lock; a failure undoes the manifest and release lock.
    /// The overlay mapping and development relock of `add <path>`.
    fn mappedTo(req, path) = Use::mapLocal(Transaction::baseOf(settingsIn(req)), Transaction::projectOf(settingsIn(req)), keyOf(req), path, epochWordOf(req))

    fn mappedLocal(req, path, previousText, previousLock, released) = {
        let local = mappedTo(req, path)
        if Reports::statusOf(local) == 0 { Reports::success(listConcat(Reports::linesOf(released), Reports::linesOf(local))) } else { restored(req, previousText, previousLock, local) }
    }

    fn declaredPublishedWith(req, path, text, line, note, previousLock) = {
        let released = Transaction::commit(settingsIn(req), text, ManifestEdit::withEdge(text, line), note)
        if Reports::statusOf(released) == 0 { mappedLocal(req, path, text, previousLock, released) } else { released }
    }

    fn declaredPublished(req, path, text, line, note) = Reports::checked(Host::snapshot(Project::lockPathAt(Transaction::projectOf(settingsIn(req)))), fn(value) => declaredPublishedWith(req, path, text, line, note, value))

    /// Published keys retain their release baseline; an unpublished key's
    /// proposed manifest is visible only to development resolution until commit.
    fn declaredLocalAt(req, path, text, baseline, epoch) = {
        let s = settingsIn(req)
        let line = ManifestEdit::edgeLine(keyOf(req), epoch, floorFor(baseline))
        let note = ["added ${Names::display(keyOf(req))} e${epoch}.r${floorFor(baseline)} from ${path}"]
        if Maybe::isPresent(baseline) { declaredPublished(req, path, text, line, note) } else {
            Transaction::commitLocalManifest(Transaction::projectOf(s), text, ManifestEdit::withEdge(text, line),
                listAppend(note, "development-only: nothing published for this key"),
                fn() => mappedTo(req, path))
        }
    }

    fn declaredLocal(req, path, text, baseline) = match epochFor(req, baseline) {
        Error => Reports::usageFor(usageCode, usageText)
        Success { value } => declaredLocalAt(req, path, text, baseline, value)
    }

    fn withLocalListing(req, path, text) = Reports::checked(Listing::fetch(Transaction::baseOf(settingsIn(req))), fn(value) => declaredLocal(req, path, text, baselineFor(req, value)))

    fn declaredPath(req, path, text) = undeclared(req, text, fn() => withLocalListing(req, path, text))

    fn withLocalKey(parsed, path, key) = {
        let req = requestOf(parsed, key)
        Reports::checked(Project::manifestTextAt(Transaction::projectOf(settingsIn(req))), fn(value) => declaredPath(req, path, value))
    }

    fn withPath(parsed, path) = Reports::checked(Use::localKey(Flags::project(parsed), path), fn(value) => withLocalKey(parsed, path, value))

    fn withWord(parsed, word) = if startsWith(word, "@") {
        match Names::parse(word) {
            Error => Reports::usageFor(usageCode, usageText)
            Success { value } => withKey(value, parsed)
        }
    } else { withPath(parsed, word) }

    fn routed(parsed, word) = if word == "" || startsWith(word, "--") { Reports::usageFor(usageCode, usageText) } else { withWord(parsed, word) }

    /// The whole command: the key or path word first, then the flags.
    export fn run(args) = Flags::dispatch(Flags::tail(args), [epochFlag, Fetch::registryFlag, Flags::projectFlag], [], usageCode, usageText,
        fn(parsed) => routed(parsed, listGet(args, 0) ?: ""))
}
