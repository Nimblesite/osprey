namespace registry_cli;
import registry::Checked
import registry_host::Host
import registry_cli::Project
import registry_cli::Lockfile
import registry_cli::Verify
import registry_cli::Reports
import registry::Canonical
import registry::Identity
import registry::Json
import registry::ManifestModel
import registry::Names

/// `tree --graph`: the editor projection of the locked package graph as one
/// canonical JSON value ([PACKAGE-API]). Direct edges come from the manifest,
/// packages and edges from the folder lock; the locked graph is never inferred
/// from installed directory names. Presence and findings come from the same
/// offline verification `verify` runs, so a missing tree is `present: false`
/// with `verify.missing`, and altered bytes stay present with `verify.digest`.
/// A missing lock is an explicit not-locked graph (`tree.no-lock`) so a new
/// project with no dependencies still has a graph; a corrupt lock is an error.
module TreeGraph {
    let notLockedCode = "tree.no-lock"
    let missingCode = "verify.missing"
    let localUnreadableCode = "lock.local-unreadable"

    type Finding = { code: string, detail: string }

    fn bool(flag) = Json::Bool { flag: flag }
    fn textList(texts) = Json::arr(mapList(texts, Json::str))

    // Shared field names need typed receivers (issue #273).
    fn keyOf(id: Identity::ReleaseId) = id.key
    fn reqKey(edge) = ManifestModel::requirementOf(edge).package
    fn nameOf(m: ManifestModel::Manifest) = m.projectName
    fn depsOf(m: ManifestModel::Manifest) = m.dependencies

    fn versionOf(id: Identity::ReleaseId) = "e${id.epoch}.r${id.ordinal}"
    fn directKeys(manifest) = Names::distinct(mapList(depsOf(manifest), reqKey))
    fn edgeKeys(edges) = Names::distinct(mapList(edges, reqKey))

    fn findingOf(line) = match indexOf(line, " ") {
        Success { value } => Finding { code: take(line, value), detail: drop(line, value + 1) }
        Error => Finding { code: line, detail: "" }
    }

    fn codeOf(f: Finding) = f.code
    fn detailOf(f: Finding) = f.detail
    fn codeIn(line) = codeOf(findingOf(line))
    fn detailIn(line) = detailOf(findingOf(line))

    fn distinctTexts(texts) = foldList(texts, [], fn(acc, text) => if listContains(acc, text) { acc } else { listAppend(acc, text) })
    fn codesOf(lines) = distinctTexts(mapList(lines, codeIn))

    fn packageLines(lines, keyText) = filterList(lines, fn(line) => detailIn(line) == keyText)
    fn packageFindings(lines, keyText) = codesOf(packageLines(lines, keyText))

    fn presentOf(lines, keyText) = !foldList(lines, false, fn(found, line) =>
        found || (codeIn(line) == missingCode && detailIn(line) == keyText))

    fn isPackageKey(packages, text) = foldList(packages, false, fn(found, p: Lockfile::Package) =>
        found || Names::display(keyOf(Lockfile::releaseOf(p))) == text)

    fn globalLines(lines, packages) = filterList(lines, fn(line) => !isPackageKey(packages, detailIn(line)))

    fn dependentsOf(packages, key) = Names::distinct(foldList(packages, [], fn(acc, p: Lockfile::Package) =>
        if !Names::same(keyOf(Lockfile::releaseOf(p)), key) && Names::includes(edgeKeys(Lockfile::edgesOf(p)), key) {
            listAppend(acc, keyOf(Lockfile::releaseOf(p)))
        } else { acc }))

    // A local checkout replaces the release's bytes ([PACKAGE-LOCAL-OVERRIDE]), so
    // the editor must be able to tell them apart. Absent for a release, keeping a
    // graph with no overrides byte-identical to one from before local checkouts.
    fn overrideMembers(overrides, key) = match Lockfile::overrideFor(overrides, key) {
        Success { value } => [Json::member("override", Json::str(overridePath(value)))]
        Error => []
    }

    fn overridePath(o: Lockfile::Override) = o.path

    fn localLock(project) = Checked::andThen(Project::readLocalLockAt(project), fn(value) => Success { value: Lockfile::overridesOf(value) })

    /// The development lock's overrides; a missing one has none, and an unreadable
    /// one is a finding rather than a graph that looks free of overrides.
    fn localOverrides(project) = Checked::andThen(perform Host::Files.exists(Project::localLockPathAt(project)), fn(value) => if value { localLock(project) } else { Success { value: [] } })

    fn packageValue(lines, direct, packages, overrides, pkg: Lockfile::Package) = {
        let id = Lockfile::releaseOf(pkg)
        let keyText = Names::display(keyOf(id))
        Json::obj(listConcat(overrideMembers(overrides, keyOf(id)), [
            Json::member("key", Json::str(keyText)),
            Json::member("version", Json::str(versionOf(id))),
            Json::member("digest", Json::str(id.digest)),
            Json::member("direct", bool(Names::includes(direct, keyOf(id)))),
            Json::member("dependencies", textList(mapList(edgeKeys(Lockfile::edgesOf(pkg)), Names::display))),
            Json::member("dependents", textList(mapList(dependentsOf(packages, keyOf(id)), Names::display))),
            Json::member("findings", textList(packageFindings(lines, keyText))),
            Json::member("present", bool(presentOf(lines, keyText)))
        ]))
    }

    fn packagesValue(lines, direct, packages, overrides) = Json::arr(mapList(packages, fn(p: Lockfile::Package) => packageValue(lines, direct, packages, overrides, p)))

    fn graphValue(manifest, lock, lines, overrides, localFindings) = {
        let direct = directKeys(manifest)
        let packages = Lockfile::packagesOf(lock)
        Json::obj([
            Json::member("project", Json::str(nameOf(manifest))),
            Json::member("direct", textList(mapList(direct, Names::display))),
            Json::member("packages", packagesValue(lines, direct, packages, overrides)),
            Json::member("findings", textList(listConcat(codesOf(globalLines(lines, packages)), localFindings)))
        ])
    }

    fn notLockedValue(manifest) = Json::obj([
        Json::member("project", Json::str(nameOf(manifest))),
        Json::member("direct", textList(mapList(directKeys(manifest), Names::display))),
        Json::member("packages", Json::arr([])),
        Json::member("findings", textList([notLockedCode]))
    ])

    fn serialized(value) = match Canonical::serialize(value) {
        Success { value } => Reports::success([value])
        Error { message } => Reports::failure([message])
    }

    fn withLock(project, manifest, lock) = {
        let lines = Reports::findings(Verify::verifyReleaseAt(project))
        match localOverrides(project) {
            Success { value } => serialized(graphValue(manifest, lock, lines, value, []))
            Error => serialized(graphValue(manifest, lock, lines, [], [localUnreadableCode]))
        }
    }

    fn withLockText(project, manifest, text) = Reports::checked(Lockfile::decode(text), fn(value) => withLock(project, manifest, value))

    fn withManifest(project, manifest) = match perform Host::Files.read(Project::lockPathAt(project)) {
        Error => serialized(notLockedValue(manifest))
        Success { value } => withLockText(project, manifest, value)
    }

    /// The graph of the project at `project` as one canonical JSON report line.
    export fn reportAt(project) = Reports::checked(Project::readAt(project), fn(value) => withManifest(project, value))
}
