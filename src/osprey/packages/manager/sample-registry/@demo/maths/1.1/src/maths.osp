namespace demo_maths;

/// Integer helpers served by the sample folder registry.
module Maths {
    /// `n` squared.
    export fn square(n) = n * n

    /// `n` limited to the closed range from `low` to `high`.
    export fn clampTo(n, low, high) = if n < low { low } else if n > high { high } else { n }
}
