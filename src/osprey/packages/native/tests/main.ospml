    expectRequests (filesystemRequestCases ())))
// [UI-EFFECTS]: the complete ask rows retain the ticket and every requested argument.
test ("desktop requests preserve picker export and cancellation payloads", \() => ui::Runtime::guarded (\() =>
    expectRequests (desktopRequestCases ())))
// [UI-EFFECTS-PROCESS]: the four long-lived process capabilities send their handles, bounds, arguments and merged environment.
test ("process capabilities send their handles bounds arguments and environment", \() => ui::Runtime::guarded (\() =>
    expectRequests (processRequestCases ())))

// One role's wording over the probe theme, checked against the role's own scale and weight.
roleDrawn role =
    wording = Lower::view (AdditionCases::styled false, Ui::styled ("sample", role, ui::Primary))
    expect ((AdditionCases::lookOf wording).points, LowerLeaves::rolePoints role)
    expect ((AdditionCases::lookOf wording).heft, LowerLeaves::roleHeft role)

// [UI-COMPONENTS]: every semantic text role keeps its type scale and weight.
test ("semantic text roles preserve every size and weight", \() => ui::Runtime::guarded (\() =>
    roles = [ui::Display, ui::Large, ui::Title, ui::Heading, ui::Lead, ui::Headline, ui::Body, ui::Callout, ui::Caption, ui::Eyebrow, ui::Mono]
    expect (join (mapList (roles, \role => "${LowerLeaves::rolePoints role}/${LowerLeaves::roleHeft role}")) ",", "34.0/600,28.0/600,20.0/600,16.0/600,15.0/400,13.0/600,13.0/400,12.0/400,11.0/400,11.0/600,12.0/400")
    forEachList (roles, \role => roleDrawn (role))))
// [UI-EFFECTS]: host extensions send the same bounded ask rows.
test ("host capabilities preserve namespace operation arguments and bounds", \() => ui::Runtime::guarded (\() =>
    request = ui::HostCall(hostNamespace = "vscode", hostOperation = "workspace.snapshot", hostArguments = [ui::Header(headerName = "workspace", headerValue = "file:///app")], hostTimeout = 1000, hostLimit = 4096, hostSlice = "workspace")
    expect (Requests::kind request, "host-call")
    expect (rowsOf (Requests::ask ("host:1", request)), "0/11/host:1;1/0/vscode;2/0/workspace.snapshot;3/0/workspace;3/0/file:///app;4/1000/;5/4096/;6/0/workspace")))
// [UI-COMPONENTS-CONTEXT-MENU]: menu commands use the same issued bindings.
test ("context menus bind actions after their content controls", \() => ui::Runtime::guarded (\() =>
    built = Ui::contextMenu (Ui::button ("Select", "package", Increment), [Ui::button ("Remove", "delete", Load)])
    walked = drawnOf built
    binds (walked, 2)
    expect (pressWords walked, "Select,Remove")
    expect (pressActions walked, "0,1")))

// Runs a registered case's body with integer faults resolved, so arithmetic in a view or a package helper never escapes it.
protected work = \() => ui::Runtime::guarded work

testCases [
    { name = "a scene's shapes cross as flat typed rows", work = protected sceneCaseASceneEncodesItsPrimitivesAsFlat },
    { name = "colours pack as RRGGBBAA", work = protected sceneCaseColoursPackAsRrggbbaa },
    { name = "a path sends its steps, outline, paint and transform", work = protected sceneCaseAPathEncodesItsStepsOutlinePaint },
    { name = "a scene binding delivers keys and pointer positions in scene units", work = protected sceneCaseASceneBindingDeliversKeysAndPointer },
    { name = "a frame event delivers its elapsed seconds and patches nothing when ignored", work = protected sceneCaseAFrameEventDeliversItsElapsedSeconds },
    { name = "an animate request carries its on flag", work = protected sceneCaseAnAnimateRequestCarriesItsOnFlag },
    { name = "every symbol encodes as a distinct host-neutral name", work = protected sceneCaseEverySymbolEncodesAsADistinctHost },
    { name = "labels, icons, badges, empty states, buttons, tabs and rows send their symbol names", work = protected sceneCaseLabelsIconsBadgesEmptyStatesButtonsTabs },
    { name = "a pair sends its label and value without a binding", work = protected sceneCaseAPairEncodesItsLabelAndValue },
    { name = "platforms decode to the union and encode back to their names", work = protected sceneCasePlatformsDecodeToTheUnionAndEncode },
    { name = "a launch context carries a linux or windows platform", work = protected sceneCaseAStartContextCarriesALinuxOr },
    { name = "product-specific work is a host call with its namespace and arguments", work = protected sceneCaseProductSpecificWorkIsAHostCall },
    { name = "a scene's shapes all cross as rows in drawing order", work = protected sceneCaseASceneRowsCarryEveryShapeInDrawingOrder },
    { name = "a scene an unnamed slot holds draws nothing", work = protected sceneCaseAnUnnamedSlotDrawsNoScene },
    { name = "shape rows read back every field a host import takes", work = protected sceneCaseShapeRowsReadBackEveryFieldA },
    { name = "an open surface keeps its store in its session", work = protected sceneCaseAnOpenSurfaceKeepsItsStoreIn },
    { name = "a refused event leaves the surface whole and still answering", work = protected sceneCaseARefusedEventLeavesTheSurfaceWhole },
    { name = "scenes draw from every container in lowering's order", work = protected sceneCaseScenesDrawFromEveryContainerInOrder },
    { name = "a strip carries its points as rows after its head", work = protected sceneCaseAStripCarriesItsPointsAsRows },
    { name = "a surface delivers completions, phases and frames and refuses unknown kinds", work = protected sceneCaseASurfaceDeliversCompletionsPhasesAnd },
    { name = "an idle surface holds only its store", work = protected sceneCaseAnIdleSurfaceHoldsOnlyItsStore },
    { name = "toggles and pickers deliver their own value kinds", work = protected sceneCaseTogglesAndPickersDeliverTheirOwnValue },
    { name = "progress, swatches, alerts, prominent buttons and leading asides lower", work = protected sceneCaseProgressSwatchesAlertsProminentButtonsAndLeading },
    { name = "a meter clamps its amount into a total of at least one", work = protected sceneCaseAMeterSendsItsAmountClampedInto },
    { name = "an editor binds text then cursor after earlier controls and preserves its marks", work = protected AdditionCases::editorEncoding },
    { name = "a cursor binding delivers placed offsets and clamps negatives", work = protected AdditionCases::cursorValues },
    { name = "a board names its host slice and binds strokes before its lasso", work = protected AdditionCases::boardEncoding },
    { name = "a board stroke keeps two ordered points with their width and time", work = protected AdditionCases::strokeDecoding },
    { name = "empty negative and widthless strokes are refused with the exact diagnostic", work = protected AdditionCases::strokeRefusals },
    { name = "a lasso delivers stroke indices and refuses negative indices", work = protected AdditionCases::lassoValues },
    { name = "a recognition request names its stroke slices and output limit", work = protected AdditionCases::recognitionEncoding },
    { name = "message routing delivers placed stroked and lassoed values to their handlers", work = protected AdditionCases::messageRouting },
    { name = "board themes name the board and chalk tokens", work = protected AdditionCases::boardTokens },
    { name = "mathematics decodes back to the tree it encodes across every constructor", work = protected AdditionCases::mathRoundTrip },
    { name = "mathematics decoding refuses unknown kinds missing children non-arrays and non-objects", work = protected AdditionCases::mathRefusals },
    { name = "image and video lower as leaves with their media fields and no ordinal", work = protected AdditionCases::mediaEncoding }
]
test ("presentation frames explicitly disable viewport sizing by default", \() => ui::Runtime::guarded (\() =>
    style = Frames::plain
    expect (style.frameViewportHeightInset, 0 - 1)
    expect (style.frameScrollY, false)
    expect (style.frameSelectionGroup, false)
    walked = drawnOf (Ui::framed (Frames::plain, Ui::button ("Continue", "", Increment)))
    expect ((fitAt (walked, 0)).share, 0.0)
    binds (walked, 1)))

test ("presentation frames preserve exact dimensions and inner control provenance", \() => ui::Runtime::guarded (\() =>
    base = Frames::plain
    style = base(frameName = "solution-column", frameWidth = 430, frameHeight = 440, frameViewportHeightInset = 270, frameScrollY = true, frameTop = 34, frameRight = 30, frameBottom = 30, frameLeft = 30, frameGap = 24, frameFill = "canvas", frameFont = "serif", frameTextSize = 27, frameItalic = true, frameHug = true, frameAlign = "center", frameCross = "end", frameControlHeight = 40, frameControlPadding = 12, frameMathScale = 1.08, frameLineHeight = 34.72, frameTracking = -0.6, frameQuietControls = true, frameFadeBackdrop = true, frameTrailingSymbols = true, frameSelectionGroup = true, frameShadow = "floating", frameSymbolSize = 13)
    walked = drawnOf (Ui::framed (style, Ui::button ("Continue", "", Increment)))
    fit = fitAt (walked, 0)
    look = (rowAt (walked, 0)).placedLook
    expect (style.frameWidth, 430)
    expect (style.frameHeight, 440)
    expect (style.frameLeft, 30)
    expect (style.frameTextSize, 27)
    expect (style.frameSymbolSize, 13)
    expect (fit.wide, 430.0)
    expect (fit.tall, 440.0)
    // A hugging frame keeps its natural share; a serif face is not fixed-width.
    expect (fit.share, 0.0)
    expect (fit.traits, 0)
    expect (look.inset, 34.0)
    expect (look.gap, 24.0)
    expect (look.points, 27.0)
    AdditionCases::frameTypography style
    binds (walked, 1)
    expect (actionAt (walked, 1), 0)))

test ("scoped themes and dialogs retain their inner controls and dismissal provenance", \() => ui::Runtime::guarded (\() =>
    local = ui::Theme(tokens = [ui::Token(tokenName = "canvas", tokenLight = "#202723", tokenDark = "#202723")], spacing = [8], feedback = 140, settle = 240)
    walked = drawnOf (Ui::themed (local, Ui::dialog ("Review transcription", Ui::button ("Insert", "", Increment), Load)))
    binds (walked, 2)
    expect (kindAt (walked, 0), Views::sheet)
    expect (wordsAt (walked, 1), "Review transcription")
    expect (pressWords walked, "Insert")
    expect (pressActions walked, "1")
    // The dismissal binds before the body the dialog shows.
    expect (actionAt (walked, 0), 0)
    // A scoped theme's own text ink is the ink its subtree is drawn in.
    inked = ui::Theme(tokens = [ui::Token(tokenName = "text", tokenLight = "#202723", tokenDark = "#202723")], spacing = [8], feedback = 140, settle = 240)
    scoped = Lower::view (paletteStyling (), Ui::themed (inked, Ui::text "Scoped"))
    expect ((AdditionCases::lookOf scoped).ink, Views::colour "#202723")))

// A text-only node fixes no action type, so the styling names the probe's.
paletteStyling : Unit -> ui::Styling<Act>
paletteStyling () = ui::Styling(styleTheme = Probes::palette (), styleDark = false, styleRegions = [])

richDocument : ui::Node<Act>
richDocument = Ui::rich ([Ui::run ("For all ", "", false), Ui::run ("p", "sourceType", true)], ui::Lead)
test ("inline text keeps its emphasis and source colours without bindings", \() => ui::Runtime::guarded (\() =>
    line = Lower::view (ui::Styling(styleTheme = Probes::palette (), styleDark = false, styleRegions = []), richDocument)
    expect (AdditionCases::kindOf line, "across")
    expect (AdditionCases::countOf line, 2)
    plain = AdditionCases::itemOf (line, 0)
    variable = AdditionCases::itemOf (line, 1)
    // Each run is a fitted wording: its fit carries the run's emphasis.
    expect (AdditionCases::kindOf plain, "fitted")
    expect (AdditionCases::textOf (AdditionCases::innerOf plain), "For all ")
    expect ((AdditionCases::fitOf plain).traits, 0)
    expect (AdditionCases::textOf (AdditionCases::innerOf variable), "p")
    expect ((AdditionCases::fitOf variable).traits, Views::slanted)
    walked = drawnOf richDocument
    binds (walked, 0)
    spaced = drawnOf (Ui::column [ui::Spacer, Ui::button ("Continue", "", Increment)])
    expect (kindAt (spaced, 1), Views::gap)
    expect (length spaced.walkRows, 3)
    binds (spaced, 1)))

