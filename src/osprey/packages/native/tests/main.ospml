type Ranked =
    name : string
    rank : int
// [UI-COMPONENTS-MATH]: each layout variant preserves its semantic children.
mathSamples () = [
    { layout = ui::Sym "x", encoded = "{\"kind\":\"sym\",\"text\":\"x\"}" }, { layout = ui::Num "2", encoded = "{\"kind\":\"num\",\"text\":\"2\"}" },
    { layout = ui::Seq [], encoded = "{\"kind\":\"seq\",\"items\":[]}" }, { layout = ui::Sup (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sup\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" },
    { layout = ui::Sub (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sub\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" }, { layout = ui::Frac (ui::Num "2") (ui::Sym "x"), encoded = "{\"kind\":\"frac\",\"top\":{\"kind\":\"num\",\"text\":\"2\"},\"bottom\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Root (ui::Sym "x"), encoded = "{\"kind\":\"root\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" }, { layout = ui::Binder "∀" [ui::Sym "x"] (ui::Sym "x"), encoded = "{\"kind\":\"binder\",\"symbol\":\"∀\",\"names\":[{\"kind\":\"sym\",\"text\":\"x\"}],\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Op "=" (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"op\",\"symbol\":\"=\",\"left\":{\"kind\":\"sym\",\"text\":\"x\"},\"right\":{\"kind\":\"num\",\"text\":\"2\"}}" }, { layout = ui::Paren (ui::Sym "x"), encoded = "{\"kind\":\"paren\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Big "∑" (ui::Num "0") (ui::Sym "n") (ui::Sym "x"), encoded = "{\"kind\":\"big\",\"symbol\":\"∑\",\"lower\":{\"kind\":\"num\",\"text\":\"0\"},\"upper\":{\"kind\":\"sym\",\"text\":\"n\"},\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
]
test ("mathematics encodes every layout variant without flattening", \() => ui::Runtime::guarded (\() =>
    forEachList (mathSamples (), \sample => expect (Doc::write (Maths::encode sample.layout), sample.encoded))))
test ("mathematics keeps accessibility text and consumes no control ordinal", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (Ui::column [Ui::button ("Before", "", Increment), Maths::typeset (ui::Seq [ui::Sym "α", ui::Sym "<", ui::Num "2"], "α < 2 \"quoted\"\n"), Ui::button ("After", "", Load)])
    binds (walked, 2)
    expect (kindAt (walked, 2), Views::label)
    expect (wordsAt (walked, 2), "α < 2 \"quoted\"\n")
    expect (actionAt (walked, 2), Views::none)
    expect (actionAt (walked, 1), 0)
    expect (actionAt (walked, 3), 1)))

tree () = Ui::column [
    Ui::text "Title \"quoted\"\n",
    Ui::button ("Go", "play", Increment),
    Ui::section ("S", "", [ui::Field(label = "Q", value = "", prompt = "", secure = false, multiline = false, commit = ui::OnSubmit, bind = Typed)]),
    ui::Picker(label = "P", choices = [Ui::choice ("a", "A")], selected = "a", bind = Load),
]

// `walked` binds exactly `count` controls.
binds (walked, count) = expect (length walked.walkBound, count)

// The control numbers of every press row, in drawing order.
pressActions walked = join (mapList (filterList (walked.walkRows, \r => r.placedKind == Views::press), \r => "${r.placedAction}")) ","

// Every row that delivers a binding, as `kind@control number`, in drawing order.
acting walked = join (mapList (filterList (walked.walkRows, \r => r.placedAction >= 0), \r => "${r.placedKind}@${r.placedAction}")) ","

// The words of every press row, in drawing order.
pressWords walked = join (mapList (filterList (walked.walkRows, \r => r.placedKind == Views::press), \r => r.placedWords)) ","

// What `words` mean to `binding`, spelt as the message kind and its value, or the refusal.
said (binding, words) = match Surfaces::told (binding, words)
    Error problem => problem
    Success message => routed message

// [UI-COMPONENTS]: a disclosure binds before the controls it reveals.
revealed () = Ui::layer [Ui::disclosure ("Limits", true, Load, [Ui::label ("Scope", "info"), ui::Spacer, Ui::button ("Go", "play", Increment)]), Ui::slot "alert"]
test ("a disclosure takes its ordinal before the controls it reveals", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (revealed ())
    binds (walked, 2)
    expect (kindAt (walked, 1), Views::column)
    expect (pressWords walked, "Limits,Go")
    expect (pressActions walked, "0,1")))
test ("a screen's toolbar controls take ordinals before its children", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (Ui::screen ("T", "", [Ui::field ("F", "", "p", Typed)], [Ui::button ("Go", "play", Increment)]))
    binds (walked, 2)
    // The toolbar's field is an entry bound first; the child's button is a press bound second.
    expect (acting walked, "4@0,3@1")
    expect (pressWords walked, "Go")))
// [UI-COMPONENTS]: an aside's pane binds before its column; rows carry their symbol and group.
inspected () = Ui::aside (Ui::rows ([Ui::entry ("a", "star", "Recent", Ui::text "A")], "a", Load), ui::Trailing, Ui::column [Ui::icon "info", ui::Divider, Ui::button ("Go", "play", Increment)], 420, Typed)
test ("an aside's pane takes ordinals before its column and rows keep their symbol and group", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (inspected ())
    // The row's selection binds first, the splitter between the columns second, the column's button third.
    expect (pressActions walked, "0,2")
    expect (wordsAt (walked, 2), "Recent")
    expect (hintAt (walked, 5), "star")
    // The trailing pane draws before the column: its heading sits in the pane, the icon in the column.
    expect ((rowAt (walked, 2)).placedParent, 1)
    expect ((rowAt (walked, 12)).placedParent, 11)
    binds (walked, 3)))
// [UI-COMPONENTS-SPLITTER]: the splitter between an aside's pane and its column is drawn between them, carries the
// column's width and limits, and binds in drawing order: after the pane's controls, before the column's.
test ("an aside's splitter carries the column width and its limits and binds between the columns", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (inspected ())
    binds (walked, 3)
    fitting = filterList (walked.walkFits, \f => f.fittedAs.wide > 0.0)
    wide = join (mapList (fitting, \f => "${f.fittedRow}:${f.fittedAs.wide}")) ","
    expect (wide, "8:6.0,11:420.0")
    expect (kindAt (walked, 10), Views::canvas)
    expect (actionAt (walked, 10), 1)
    expect (Splitters::least, 260)
    expect (Splitters::most, 640)
    expect (Splitters::keep, 340)))

resized value =
    delivered = match Surfaces::told (ui::SizeInput(action = Typed), value)
        Success message => message
        Error _ => ui::Act(act = Load)
    routed delivered
// [UI-COMPONENTS-SPLITTER]: a dragged width reaches the application only within the splitter's limits, and only as a whole number of points.
test ("a splitter delivers its dragged width clamped to its limits", \() => ui::Runtime::guarded (\() =>
    expect (resized "420", "integer typed:420")
    expect (resized "9000", "integer typed:640")
    expect (resized "10", "integer typed:260")
    expect (resized "-50", "integer typed:260")
    expect (resized "wide", "integer typed:260")
    expect (resized "", "integer typed:260")))
// [UI-COMPONENTS]: a link names its web destination and binds nothing; the host opens it in the browser.
test ("a link carries its label and web address and takes no ordinal", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (Ui::column [Ui::link ("Osprey guide", "https://example.test/guide"), Ui::button ("Go", "play", Increment)])
    expect (wordsAt (walked, 1), "Osprey guide")
    expect (hintAt (walked, 1), "https://example.test/guide")
    expect (actionAt (walked, 1), Views::none)
    binds (walked, 1)
    expect (actionAt (walked, 2), 0)))
test ("controls take depth-first ordinals in drawing order", \() => ui::Runtime::guarded (\() =>
    expect (length (drawnOf (tree ())).walkBound, 3)))
test ("a drawn region keeps its components and text intact", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (tree ())
    expect (wordsAt (walked, 1), "Title \"quoted\"\n")
    expect (kindAt (walked, 3), Views::column)
    expect (rowsRead (walked, "words", [4, 6]), "S|Q")
    expect (kindAt (walked, 7), Views::entry)
    expect (traitsAt (walked, 7), Views::onCommit)
    expect (hintAt (walked, 8), "P")
    expect (kindAt (walked, 8), Views::picker)
    expect (hintAt (walked, 9), "a")
    expect (traitsAt (walked, 9), Views::chosen)))
test ("a control carries the ordinal of its binding", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (tree ())
    expect (actionAt (walked, 2), 0)
    expect (actionAt (walked, 6), Views::none)
    expect (rowsRead (walked, "action", [7, 8]), "1|2")
    expect (actionAt (walked, 9), Views::none)))
test ("opening draws every region once with the theme", \() => ui::Runtime::guarded (\() =>
    first = Probes::started ()
    expect (length first.surfaceBound, 5)
    expect (join (mapList ((Probes::palette ()).spacing, \s => "${s}")) ",", "4,8")
    expect ((Probes::palette ()).feedback, 120)
    expect ((Probes::palette ()).settle, 220)
    expect (named "canvas", "#FFFFFF")
    expect (nightNamed "canvas", "#000000")
    expect (first.surfaceSession.sessionContext.platform, "linux")
    seen = Probes::seen first
    expect (join (mapList (seen.walkRows, \r => r.placedWords)) "|", "|Count 0|Go|Go|||Note|linux|Load|Load")))
test ("a tap delivers and the next frame shows the changed count", \() => ui::Runtime::guarded (\() =>
    second = Probes::tapped (Probes::started (), 0)
    expect (Probes::problem second, "")
    expect ((Probes::stored second).counter.tally, 1)
    seen = Probes::seen second
    expect (join (mapList (seen.walkRows, \r => r.placedWords)) "|", "|Count 1|Go|||Note|linux|Load|Load")))
test ("text input reaches update through its binding and sends its slice", \() => ui::Runtime::guarded (\() =>
    second = Probes::posted (Probes::started (), 2, "hello")
    expect (Probes::problem second, "")
    expect ((Probes::stored second).note.memo, "hello")
    expect (Probes::written second, "echo=hello")
    expect (wordsAt (Probes::seen second, 7), "hello")
    third = Probes::tapped (second, 0)
    expect (Probes::problem third, "")))
// The typed host events a host sends that must all be refused, with the reason each is given.
refusalHeld () = Probes::tapped (Probes::started (), 0)
refusalCases () = [
    { touch = touchOf (Hosting::control, 9, "", false), reason = "Unknown control 9" },
    { touch = touchOf (Hosting::control, 0 - 1, "", false), reason = "Unknown control -1" },
    { touch = touchOf (99, 0, "", false), reason = "Unknown event kind 99" },
    { touch = framedAfter (0.0 - 0.5), reason = "Invalid frame elapsed time" },
]
// A display frame `elapsed` seconds after the last, at clock 5.
framedAfter elapsed = ui::Touch(touchNow = 5, touchKind = Hosting::frame, touchOrdinal = 0, touchWords = "", touchDetail = "", touchX = elapsed, touchY = 0.0, touchDown = false, touchShift = false)
// A host event of `kind` for control `ordinal` carrying `words`, at clock 5.
touchOf (kind, ordinal, words, down) = ui::Touch(touchNow = 5, touchKind = kind, touchOrdinal = ordinal, touchWords = words, touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = down, touchShift = false)
// [UI-EVENTS]: unknown and mismatched events change no store and leave no request behind.
// A refused event: it names its reason, asks nothing and changes no store.
refusedClean (held, touch, reason) =
    refused = Probes::sent (held, touch)
    expect (Probes::problem refused, reason)
    expect (Probes::asked refused, "")
    expect ((Probes::stored refused).counter.tally, 1)

test ("unknown and mismatched events are rejected without change", \() => ui::Runtime::guarded (\() =>
    held = refusalHeld ()
    forEachList (refusalCases (), \probe => refusedClean (held, probe.touch, probe.reason))
    expect (said (ui::StrokeInput(action = Load), "1,2"), "A board control was sent a value of the wrong kind")
    expect (said (ui::LassoInput(action = Load), "0"), "A lasso control was sent a value of the wrong kind")
    expect (said (ui::SceneInput(action = Load), ""), "A scene control was sent a value of the wrong kind")))
// [UI-EVENTS]: a control's number follows the frame that drew it, so a withdrawn control is never delivered by its old number.
test ("a control keeps its meaning while ordinals shift across frames", \() => ui::Runtime::guarded (\() =>
    first = Probes::started ()
    // At count 0 the Go buttons are [Increment, Load]; the host taps control 0.
    counted = Probes::tapped (first, 0)
    expect (Probes::problem counted, "")
    expect ((Probes::stored counted).counter.tally, 1)
    expect (length counted.surfaceBound, 4)
    // At count 1 only [Load] is drawn, so control 0 now means Load and asks the host.
    loaded = Probes::tapped (counted, 0)
    expect (Probes::problem loaded, "")
    expect (Probes::tickets loaded, "load:1")
    expect ((Probes::stored loaded).counter.tally, 1)
    // The note field shifted from control 2 to control 1, and its edits still arrive.
    noted = Probes::posted (counted, 1, "hello")
    expect ((Probes::stored noted).note.memo, "hello")))
// [UI-EVENTS]: a control that no frame drew refuses without change, and the session still answers its own controls.
test ("a control that is gone refuses without change", \() => ui::Runtime::guarded (\() =>
    first = Probes::started ()
    gone = Probes::tapped (Probes::tapped (first, 0), 0)
    refused = Probes::posted (gone, 9, "")
    expect (Probes::problem refused, "Unknown control 9")
    expect (Probes::asked refused, "")
    expect ((Probes::stored refused).counter.tally, 1)
    intact = Probes::tapped (refused, 0)
    expect (Probes::problem intact, "")
    expect (Probes::asked intact, "store-read")
    expect ((Probes::stored intact).counter.tally, 1)))
// [UI-EVENTS]: a refused event leaves the store whole and still answering.
test ("every refusal leaves the session whole", \() => ui::Runtime::guarded (\() =>
    first = Probes::started ()
    forEachList ([9, 0 - 1, 9], \ordinal => expect (Probes::problem (Probes::posted (first, ordinal, "")), "Unknown control ${ordinal}"))
    expect (Probes::problem (Probes::framed (first, 0.0 - 1.0)), "Invalid frame elapsed time")
    after = Probes::tapped (first, 0)
    expect (Probes::problem after, "")
    expect ((Probes::stored after).counter.tally, 1)))
// [UI-EVENTS]: a delivered edit runs update on the current session, never on an earlier frame's.
test ("a delivered edit updates the current state", \() => ui::Runtime::guarded (\() =>
    first = Probes::started ()
    typedIn = Probes::posted (first, 2, "hello")
    counted = Probes::tapped (typedIn, 0)
    edited = Probes::posted (counted, 1, "world")
    expect (Probes::problem edited, "")
    expect ((Probes::stored edited).note.memo, "world")
    expect (Probes::written edited, "echo=world")
    // The carried-over tally proves the earlier frame was not restored.
    expect ((Probes::stored edited).counter.tally, 1)))
test ("capability requests carry tickets and completions return to update", \() => ui::Runtime::guarded (\() =>
    asked = Probes::tapped (Probes::started (), 3)
    expect (Probes::asked asked, "store-read")
    expect (Probes::tickets asked, "load:1")
    done = Probes::finished (asked, "load:1", true, "from disk")
    expect (Probes::problem done, "")
    expect ((Probes::stored done).note.memo, "from disk")))
test ("malformed events are diagnosed, never guessed", \() => ui::Runtime::guarded (\() =>
    odd = Probes::sent (Probes::started (), touchOf (99, 0, "", false))
    expect (Probes::problem odd, "Unknown event kind 99")
    bad = Probes::framed (Probes::started (), 0.0 - 1.0)
    expect (Probes::problem bad, "Invalid frame elapsed time")
    // An appearance change redraws the same store in the other appearance.
    night = Probes::sent (Probes::started (), ui::Touch(touchNow = 5, touchKind = Hosting::appearance, touchOrdinal = 0, touchWords = "", touchDetail = "", touchX = 0.0, touchY = 0.0, touchDown = true, touchShift = false))
    expect (Probes::problem night, "")
    expect (night.surfaceDark, true)))
test ("contrast follows WCAG relative luminance", \() => ui::Runtime::guarded (\() =>
    expect (Contrast::ratio ("#000000", "#FFFFFF") > 20.99, true)
    expect (Contrast::ratio ("#777777", "#777777") < 1.0001, true)))
test ("sorting is stable and lists stay total", \() => ui::Runtime::guarded (\() =>
    pairs = [Ranked(name = "b", rank = 1), Ranked(name = "a", rank = 2), Ranked(name = "b", rank = 3)]
    sorted = Lists::sortBy (pairs, \(x, y) => x.name < y.name)
    expect (join (mapList (sorted, \pair => "${pair.name}${pair.rank}")) ",", "a2,b1,b3")
    expect (Lists::distinct ["a", "b", "a"], false)
    expect (Lists::position (["a", "b", "b"], \item => item == "b"), 1)
    expect (Lists::position (["a"], \item => item == "z"), 0 - 1)))
// [UI-COMPONENTS] [UI-EVENTS]: tabs bind as choices before the page they show; segments carry their tones.
tabbed () = Ui::column [
    ui::Tabs(tabs = [Ui::tab ("one", "One", "1.circle", Ui::button ("Go", "play", Increment)), Ui::tab ("two", "Two", "2.circle", Ui::caption "Second")], selected = "two", bind = Load),
    ui::Segments(tones = [ui::Good, ui::Danger], label = "2 states"),
]
test ("tabs bind before the page they show, and segments carry their tones", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (tabbed ())
    binds (walked, 2)
    expect (pressWords walked, "One,Two")
    expect (pressActions walked, "0,1")
    expect (rowsRead (walked, "hint", [3, 4]), "one|two")
    expect (traitsAt (walked, 3), 0)
    expect (traitsAt (walked, 4), Views::chosen)
    // The chosen tab's page is the only one drawn.
    expect (wordsAt (walked, 5), "Second")
    segments = AdditionCases::segmentsDrawn (ui::Segments(tones = [ui::Good, ui::Danger], label = "2 states"))
    expect (join (mapList ([AdditionCases::itemOf (segments, 0), AdditionCases::itemOf (segments, 1)], \box => "${(AdditionCases::lookOf (AdditionCases::innerOf box)).fill}")) ",", "305420031,3424789247")))
// [UI-COMPONENTS]: every constructor lowers as the component it names, with its role, tone, axis and enabled state.
built () = Ui::split [Ui::row [Ui::styled ("H", ui::Heading, ui::Accent), Ui::pair ("Label", "Value"), Ui::badge ("Partial", "info", ui::Caution), Ui::empty ("inbox", "Nothing", "Why"), Ui::action ("Stop", "stop", ui::Destructive, false, Load), Ui::toggle ("AI", true, Typed), Ui::picker ("Model", [Ui::choice ("a", "A")], "a", Load), Ui::rows ([Ui::item ("k", Ui::text "cell")], "k", Load)]]
test ("every constructor lowers as the component it names", \() => ui::Runtime::guarded (\() =>
    walked = drawnOf (built ())
    styling = ui::Styling(styleTheme = AdditionCases::lowerTheme (), styleDark = false, styleRegions = [])
    row = AdditionCases::innerOf (AdditionCases::itemOf (Lower::view (styling, built ()), 0))
    parts = mapList (toList (range (0, 8)), \i => AdditionCases::itemOf (row, i))
    heading = listGet parts 0 ?: AdditionCases::nothingView ()
    pair = listGet parts 1 ?: AdditionCases::nothingView ()
    badge = AdditionCases::innerOf (listGet parts 2 ?: AdditionCases::nothingView ())
    empty = AdditionCases::innerOf (listGet parts 3 ?: AdditionCases::nothingView ())
    stop = AdditionCases::innerOf (listGet parts 4 ?: AdditionCases::nothingView ())
    toggle = listGet parts 5 ?: AdditionCases::nothingView ()
    picker = AdditionCases::innerOf (listGet parts 6 ?: AdditionCases::nothingView ())
    rows = listGet parts 7 ?: AdditionCases::nothingView ()
    expect (AdditionCases::kindOf heading, "wording")
    expect ((AdditionCases::lookOf heading).points, 16.0)
    expect ((AdditionCases::lookOf heading).heft, 600)
    expect ((AdditionCases::lookOf heading).ink, 6728447)
    expect (AdditionCases::kindOf pair, "across")
    expect (AdditionCases::countOf pair, 3)
    expect (AdditionCases::textOf badge, "Partial")
    expect ((AdditionCases::lookOf badge).corner, 999.0)
    expect ((AdditionCases::fitOf (listGet parts 3 ?: AdditionCases::nothingView ())).traits, Views::centred)
    expect (AdditionCases::countOf empty, 3)
    expect (AdditionCases::textOf stop, "Stop")
    expect ((AdditionCases::fitOf (listGet parts 4 ?: AdditionCases::nothingView ())).traits, Views::disabled)
    expect (AdditionCases::kindOf toggle, "switch")
    expect (AdditionCases::switchWordsOf toggle, "AI")
    // A switch's state is its own `on`; the walk turns it into the chosen flag.
    expect (AdditionCases::switchOnOf toggle, true)
    expect (AdditionCases::kindOf picker, "choosing")
    expect (AdditionCases::countOf picker, 1)
    expect ((AdditionCases::optionKeyOf (AdditionCases::itemOf (picker, 0))), "a")
    expect (AdditionCases::kindOf rows, "column")
    expect ((AdditionCases::fitOf (AdditionCases::itemOf (rows, 0))).hint, "k")
    binds (walked, 4)))

// The walked rows as the view tree they came from, for the case helpers to read.
walkedAsView () = ui::Column(columnLook = Views::plain, columnItems = [])

// [UI-EFFECTS]: a run and an HTTP request send their bounds, headers and the slices their output lands in.
runRequest plist = Requests::ask ("ps", ui::Run(executable = "/bin/ps", arguments = ["-axo", "pid="], timeout = 10000, outputLimit = 8000000, plist = plist, runSlice = "work/run"))
test ("run and http requests send their bounds, headers and slices", \() => ui::Runtime::guarded (\() =>
    expect (rowsOf (runRequest false), "0/1/ps;1/0//bin/ps;2/0/-axo;2/0/pid=;3/10000/;4/8000000/;5/0/;6/0/work/run")
    expect (rowsOf (runRequest true), "0/1/ps;1/0//bin/ps;2/0/-axo;2/0/pid=;3/10000/;4/8000000/;5/1/;6/0/work/run")
    http = Requests::ask ("kev", ui::Http(method = "GET", url = "https://example.test/feed", headers = [ui::Header(headerName = "Accept", headerValue = "application/json")], body = "", responseLimit = 1000, deadline = 30000, httpSlice = "work/http"))
    expect (rowsOf http, "0/10/kev;1/0/GET;2/0/https://example.test/feed;3/0/Accept;3/0/application/json;4/0/;5/1000/;6/30000/;7/0/work/http")
    write = Requests::write ("echo", "text")
    expect ("${write.sliceKey}=${write.sliceText}", "echo=text")))

named key = match Themes::named (Probes::palette (), key)
    Success token => token.tokenLight
    Error _ => "none"

// The dark value the palette's `key` token carries, or `none` when the theme names none.
nightNamed key = match Themes::named (Probes::palette (), key)
    Success token => token.tokenDark
    Error _ => "none"
// [UI-SIGNALS] [UI-THEME]: documents, lists and themes read totally, and a host-held slice counts as changed only when written.
test ("documents, lists, themes and slice writes are read totally", \() => ui::Runtime::guarded (\() =>
    doc = Doc::parse "{\"a\":1,\"b\":null}"
    expectPresence (doc, [{ name = "b", value = true }, { name = "c", value = false }])
    expect (length (Doc::members doc), 2)
    expect (length (Doc::members JsonNull), 0)
    expect (Lists::all ([2, 4], \n => n > 1), true)
    expect (Lists::all ([2, 0], \n => n > 1), false)
    expect (join (Lists::flatten [["a"], [], ["b", "c"]]) "", "abc")
    expect (named "canvas", "#FFFFFF")
    expect (named "ink", "none")
    expect (join (Signals::written ([Requests::write ("echo", "x")], "echo", ["Memo"])) ",", "Memo")
    expect (length (Signals::written ([], "echo", ["Memo"])), 0)))

// One ask row as `field/number/text`, so a table can hold the exact rows a request sends.
rowOf row = "${row.askedField}/${row.askedNumber}/${row.askedText}"

// The ask rows of `request`, `;`-separated, exactly as the shared frame carries them.
rowsOf request = join (mapList (Requests::rows request, \row => rowOf row)) ";"

// A capability beside the exact ask rows its request sends.
expectRequests (cases) = forEachList (cases, \probe => expect (rowsOf (Requests::ask ("job:7", probe.capability)), probe.encoded))

filesystemRequestCases () = [
    { capability = ui::Fingerprint(file = "a.txt", fileLimit = 64), encoded = "0/5/job:7;1/0/a.txt;2/64/" }, { capability = ui::ReadPropertyLists(plists = ["app.plist"], plistKeys = ["CFBundleName"], plistSuffixes = [".plist"], plistLimit = 128, plistSlice = "prefs"), encoded = "0/3/job:7;1/0/app.plist;2/0/CFBundleName;3/0/.plist;4/128/;5/0/prefs" },
    { capability = ui::ListDirectories(directories = ["/tmp", "/Users/me"], entryLimit = 12, listSlice = "listing"), encoded = "0/2/job:7;1/0//tmp;1/0//Users/me;2/12/;3/0/listing" }, { capability = ui::ReadTexts(texts = ["a.txt", "b.txt"], textLimit = 256, textSlice = "text"), encoded = "0/4/job:7;1/0/a.txt;1/0/b.txt;2/256/;3/0/text" },
    { capability = ui::StoreWrite(writeName = "note.txt", writeSlice = "draft"), encoded = "0/7/job:7;1/0/note.txt;2/0/draft" }, { capability = ui::StoreList(folder = "notes"), encoded = "0/8/job:7;1/0/notes" },
    { capability = ui::StoreDelete(deleteName = "old.txt"), encoded = "0/9/job:7;1/0/old.txt" }, { capability = ui::MeasureFolders(measureFolders = ["C:\\Users", "/home/me"], measureLimit = 5000, measureDeadline = 60000, measureSlice = "measured"), encoded = "0/16/job:7;1/0/C:\\Users;1/0//home/me;2/5000/;3/60000/;4/0/measured" },
]

desktopRequestCases () = [
    { capability = ui::OpenSettings(pane = "privacy"), encoded = "0/18/job:7;1/0/privacy" }, { capability = ui::RunningApplications, encoded = "0/12/job:7" },
    { capability = ui::ChooseFile(types = ["txt", "md"], chosenLimit = 2, chosenSlice = "picked"), encoded = "0/13/job:7;1/0/txt;1/0/md;2/2/;3/0/picked" }, { capability = ui::ChooseFolder, encoded = "0/14/job:7" },
    { capability = ui::SaveFile(suggested = "report.txt", exportSlice = "export"), encoded = "0/15/job:7;1/0/report.txt;2/0/export" }, { capability = ui::Reveal(revealPath = "/tmp/report.txt"), encoded = "0/17/job:7;1/0//tmp/report.txt" },
    { capability = ui::Cancel(cancelled = "old:7"), encoded = "0/19/job:7;1/0/old:7" },
