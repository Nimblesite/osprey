type Ranked =
    name : string
    rank : int
// [UI-COMPONENTS-MATH]: each layout variant preserves its semantic children.
mathSamples () = [
    { layout = ui::Sym "x", encoded = "{\"kind\":\"sym\",\"text\":\"x\"}" }, { layout = ui::Num "2", encoded = "{\"kind\":\"num\",\"text\":\"2\"}" },
    { layout = ui::Seq [], encoded = "{\"kind\":\"seq\",\"items\":[]}" }, { layout = ui::Sup (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sup\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" },
    { layout = ui::Sub (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"sub\",\"base\":{\"kind\":\"sym\",\"text\":\"x\"},\"script\":{\"kind\":\"num\",\"text\":\"2\"}}" }, { layout = ui::Frac (ui::Num "2") (ui::Sym "x"), encoded = "{\"kind\":\"frac\",\"top\":{\"kind\":\"num\",\"text\":\"2\"},\"bottom\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Root (ui::Sym "x"), encoded = "{\"kind\":\"root\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" }, { layout = ui::Binder "∀" [ui::Sym "x"] (ui::Sym "x"), encoded = "{\"kind\":\"binder\",\"symbol\":\"∀\",\"names\":[{\"kind\":\"sym\",\"text\":\"x\"}],\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Op "=" (ui::Sym "x") (ui::Num "2"), encoded = "{\"kind\":\"op\",\"symbol\":\"=\",\"left\":{\"kind\":\"sym\",\"text\":\"x\"},\"right\":{\"kind\":\"num\",\"text\":\"2\"}}" }, { layout = ui::Paren (ui::Sym "x"), encoded = "{\"kind\":\"paren\",\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
    { layout = ui::Big "∑" (ui::Num "0") (ui::Sym "n") (ui::Sym "x"), encoded = "{\"kind\":\"big\",\"symbol\":\"∑\",\"lower\":{\"kind\":\"num\",\"text\":\"0\"},\"upper\":{\"kind\":\"sym\",\"text\":\"n\"},\"body\":{\"kind\":\"sym\",\"text\":\"x\"}}" },
]
test ("mathematics encodes every layout variant without flattening", \() =>
    forEachList (mathSamples (), \sample => expect (Doc::write (Maths::encode sample.layout), sample.encoded)))
test ("mathematics keeps accessibility text and consumes no control ordinal", \() =>
    walked = Encode::walk ([], Ui::column [Ui::button ("Before", "", Increment), Maths::typeset (ui::Seq [ui::Sym "α", ui::Sym "<", ui::Num "2"], "α < 2 \"quoted\"\n"), Ui::button ("After", "", Load)])
    children = Doc::items (Doc::field ((firstNode walked), "children"))
    maths = listGet children 1 ?: JsonNull
    expectTexts (maths, [{ name = "kind", value = "math" }, { name = "spoken", value = "α < 2 \"quoted\"\n" }])
    expect (Doc::text (Doc::field (maths, "math"), "kind"), "seq")
    expect (length (Doc::items (Doc::field (Doc::field (maths, "math"), "items"))), 3)
    expect (Doc::has (maths, "event"), false)
    expect (Doc::number (listGet children 2 ?: JsonNull, "event"), 1)
    binds (walked, 2))

tree () = Ui::column [
    Ui::text "Title \"quoted\"\n",
    Ui::button ("Go", "play", Increment),
    Ui::section ("S", "", [ui::Field(label = "Q", value = "", prompt = "", secure = false, multiline = false, commit = ui::OnSubmit, bind = Typed)]),
    ui::Picker(label = "P", choices = [Ui::choice ("a", "A")], selected = "a", bind = Load),
]

encoded () = jsonEncode (firstNode (Encode::walk ([], tree ()))) ?: ""

kindAt doc path = jsonText (jsonField (jsonIndex (jsonField doc "children" ?: JsonNull) path ?: JsonNull) "kind" ?: JsonNull) ?: "missing"

// The single node `walked` encodes.
firstNode walked = listGet walked.nodes 0 ?: JsonNull

// The `index`th item of `doc`'s `key` list, or null when the list is shorter.
itemAt (doc, key, index) = jsonIndex (jsonField doc key ?: JsonNull) index ?: JsonNull

// The first item of `doc`'s `key` list, or null when the list is empty or absent.
firstOf (doc, key) = listGet (Doc::items (Doc::field (doc, key))) 0 ?: JsonNull

// How many items `doc`'s `key` list holds; zero when it is absent.
countOf (doc, key) = length (Doc::items (Doc::field (doc, key)))

// A control's ordinal, or -1 when it declares none.
eventOf doc = jsonInt (jsonField doc "event" ?: JsonNull) ?: 0 - 1

// The `index`th of `parts`, or null when the list is shorter.
partOf (parts, index) = listGet parts index ?: JsonNull

// The `index`th item of the `key` list of the node `walked` encodes.
nodeChild (walked, key, index) = itemAt ((firstNode walked), key, index)

// `walked` binds exactly `count` controls.
binds (walked, count) = expect (length walked.bindings, count)

// A refused envelope: it names `reason`, patches no region and leaves no requests behind.
refusedClean (envelope, reason) =
    expect (contains (Probes::problems envelope) reason, true)
    expect (Probes::keys envelope, "")
    expect (countOf (envelope, "patches"), 0)

// Posting `event` to `session` is refused for `reason` and changes nothing.
refusedEvent (session, event, reason) = refusedClean (Probes::post (session, event), reason)

// The `key` text of the first child of the node of `session`'s first patch.
patchedText (session, key) = Doc::text (firstOf (Doc::field (firstOf (session, "patches"), "node"), "children"), key)

// Posting to `session` an edit of `value` to the control `region` drew at `revision`, which the session recalls.
editFrom (session, region, revision, ordinal, value) = Probes::post (session, Probes::edit (region, revision, ordinal, value))

// An edit posted to `session` against an earlier revision is refused for `reason` and changes nothing.
refusedEdit (session, region, revision, ordinal, value, reason) = refusedClean (editFrom (session, region, revision, ordinal, value), reason)

// A host tap of `region`'s `ordinal` control at `revision`, posted to `session`.
postedTap (session, region, revision, ordinal) = Probes::post (session, Probes::tap (region, revision, ordinal))

// A settled edit of the root as first drawn, posted to `session`.
rootEdit (session, ordinal) = editFrom (session, "root", 1, ordinal, "null")

// `envelope` reports no problem.
problemFree envelope = expect (Probes::problems envelope, "")

// `session`'s store tallies one.
tallyOne session = expect (Doc::number (Probes::stored session, "tally"), 1)

// The session after the host taps the root's first control on a fresh start.
tappedStart () = postedTap (Probes::started (), "root", 1, 0)

// `doc` marks its scroll position and selection group as `flag`.
scrollAndSelection (doc, flag) =
    expectFlags (doc, [{ name = "scrollY", value = flag }, { name = "selectionGroup", value = flag }])

// `session` reports no problem and leaves one load ticket.
servedLoad session =
    problemFree session
    expect (Doc::text (firstOf (session, "requests"), "ticket"), "load:1")

// `session` refreshes only `region` and patches its `key` text to `text`.
refreshedTo (session, region, key, text) =
    expect (Probes::keys session, region)
    expect (patchedText (session, key), text)
// [UI-COMPONENTS]: a disclosure binds before the controls it reveals.
revealed () = Ui::layer [Ui::disclosure ("Limits", false, Load, [Ui::label ("Scope", "info"), ui::Spacer, Ui::button ("Go", "play", Increment)]), Ui::slot "alert"]
test ("a disclosure takes its ordinal before the controls it reveals", \() =>
    walked = Encode::walk ([], revealed ())
    disclosure = nodeChild (walked, "children", 0)
    binds (walked, 2)
    expect (kindAt (firstNode walked) 0, "disclosure")
    expect (join (mapList ([disclosure, itemAt (disclosure, "children", 2)], \child => "${eventOf child}")) ",", "0,1"))
// [UI-EVENTS]: a screen's toolbar controls are bound before its children.
test ("a screen's toolbar controls take ordinals before its children", \() =>
    walked = Encode::walk ([], Ui::screen ("T", "", [Ui::field ("F", "", "p", Typed)], [Ui::button ("Go", "play", Increment)]))
    expect (join (mapList ([nodeChild (walked, "toolbar", 0), nodeChild (walked, "children", 0)], \child => "${eventOf child}")) ",", "0,1"))
// [UI-COMPONENTS]: an aside's pane binds before its column; rows carry their symbol and group.
inspected () = Ui::aside (Ui::rows ([Ui::entry ("a", "star", "Recent", Ui::text "A")], "a", Load), ui::Trailing, Ui::column [Ui::icon "info", ui::Divider, Ui::button ("Go", "play", Increment)], 420, Typed)
test ("an aside's pane takes ordinals before its column and rows keep their symbol and group", \() =>
    walked = Encode::walk ([], inspected ())
    pane = jsonField (firstNode walked) "pane" ?: JsonNull
    row = itemAt (pane, "rows", 0)
    expect (jsonText (jsonField (firstNode walked) "side" ?: JsonNull) ?: "", "trailing")
    expect (join (mapList ([pane, itemAt (Doc::field ((firstNode walked), "aside"), "children", 2)], \child => "${eventOf child}")) ",", "0,1")
    expectTexts (row, [{ name = "symbol", value = "star" }, { name = "group", value = "Recent" }]))
// [UI-COMPONENTS-SPLITTER]: the splitter between an aside's pane and its column carries the column's width and
// limits, and binds after both columns so their controls keep their ordinals.
test ("an aside's splitter carries the column width and its limits and binds after both columns", \() =>
    walked = Encode::walk ([], inspected ())
    binds (walked, 3)
    expectNumbers ((firstNode walked), [{ name = "width", value = 420 }, { name = "least", value = Splitters::least }, { name = "most", value = Splitters::most }, { name = "keep", value = Splitters::keep }, { name = "event", value = 2 }]))

resized value = Messages::route (Events::bind (ui::SizeInput(action = Typed), value) ?: ui::Act(act = Load), \_ => 0 - 1, \(_, _) => 0 - 2, \(_, _) => 0 - 3, \(_, points) => points, \(_, _) => 0 - 4, \_ => 0 - 5, \(_, _) => 0 - 6, \(_, _) => 0 - 7, \_ => 0 - 8, \(_, _) => 0 - 9)
// [UI-COMPONENTS-SPLITTER]: a dragged width reaches the application only within the splitter's limits, and only as a whole number of points.
test ("a splitter delivers its dragged width clamped to its limits", \() =>
    expect (resized (JsonInt 420), 420)
    expect (resized (JsonInt 9000), Splitters::most)
    expect (resized (JsonInt 10), Splitters::least)
    expect (resized (JsonInt (0 - 50)), Splitters::least)
    expect (resized (JsonString "wide"), 0 - 1)
    expect (resized JsonNull, 0 - 1))
// [UI-COMPONENTS]: a link names its web destination and binds nothing; the host opens it in the browser.
test ("a link carries its label and web address and takes no ordinal", \() =>
    walked = Encode::walk ([], Ui::column [Ui::link ("Osprey guide", "https://example.test/guide"), Ui::button ("Go", "play", Increment)])
    link = nodeChild (walked, "children", 0)
    expect (kindAt (firstNode walked) 0, "link")
    expectTexts (link, [{ name = "label", value = "Osprey guide" }, { name = "url", value = "https://example.test/guide" }])
    expect (eventOf link, 0 - 1)
    binds (walked, 1)
    expect (eventOf (nodeChild (walked, "children", 1)), 0))
test ("controls take depth-first ordinals in drawing order", \() =>
    expect (length (Encode::walk ([], tree ())).bindings, 3))
test ("an encoded region decodes with its components and text intact", \() =>
    doc = jsonDecode (encoded ()) ?: JsonNull
    expect (kindAt doc 2, "section")
    expect (jsonText (jsonField (jsonIndex (jsonField doc "children" ?: JsonNull) 0 ?: JsonNull) "text" ?: JsonNull) ?: "missing", "Title \"quoted\"\n"))
test ("a control carries the ordinal of its binding", \() =>
    doc = jsonDecode (encoded ()) ?: JsonNull
    expect (eventOf (itemAt (doc, "children", 3)), 2))
test ("start sends every region once with the theme", \() =>
    first = Probes::started ()
    expect (Probes::keys first, "root,note")
    expect (Doc::number (first, "version"), 1)
    expect (Doc::text (Doc::field (first, "theme"), "feedback") == "", true)
    expect (Doc::number (Doc::field (first, "theme"), "settle"), 220))
test ("a tap refreshes only the region whose signal changed", \() =>
    second = tappedStart ()
    problemFree second
    refreshedTo (second, "root", "text", "Count 1"))
test ("text input reaches update through its binding and patches its own region", \() =>
    second = Probes::post (Probes::started (), Probes::typed (1, "hello"))
    expect (Probes::keys second, "note")
    expect ("${Doc::text (firstOf (second, "slices"), "key")}=${Doc::text (firstOf (second, "slices"), "text")}", "echo=hello")
    third = postedTap (second, "root", 1, 0)
    expect (Probes::keys third, "root"))
// The events a host sends a settled session that must all be refused, with the reason each is given.
refusalCases session = [
    { sent = Probes::tap ("root", 1, 0), reason = "Stale control" },
    { sent = Probes::tap ("root", 2, 9), reason = "Unknown control" },
    { sent = "{\"kind\":\"ui\",\"region\":\"note\",\"revision\":1,\"ordinal\":1,\"value\":\"x\",\"now\":6}", reason = "wrong kind" },
    { sent = Probes::tap ("missing", 1, 0), reason = "Stale control" },
]
// [UI-EVENTS]: stale, unknown and mismatched events change no region and leave no request behind.
test ("stale, unknown and mismatched events are rejected without change", \() =>
    second = tappedStart ()
    forEachList (refusalCases second, \probe => refusedEvent (second, probe.sent, probe.reason)))
// [UI-EVENTS]: a trusted-host edit resolves the control the prior state meant through its typed binding, not its stale ordinal.
test ("an edit from prior state keeps its meaning when ordinals shift", \() =>
    first = Probes::started ()
    // At count 0 the Go buttons are [Increment, Load]; the host taps ordinal 0.
    counted = rootEdit (first, 0)
    problemFree counted
    refreshedTo (counted, "root", "text", "Count 1")
    // At count 1 the buttons are [Load]; the host's ordinal 0 (Increment in prior) still means Increment, but it is withdrawn now.
    shifted = rootEdit (counted, 0)
    expect (Probes::keys shifted, "")
    tallyOne counted
    // Prior ordinal 1 (Load) still means Load even though it now sits at ordinal 0.
    servedLoad (rootEdit (counted, 1)))
// [UI-EVENTS]: identical-looking controls are told apart by their typed actions; a withdrawn action refuses.
test ("an edit whose typed action is gone or ambiguous refuses without change", \() =>
    first = Probes::started ()
    // Prior ordinal 1 is Load; the note region draws two identical Load buttons.
    refusedEdit (first, "note", 1, 1, "null", "More than one")
    // At count 1 only Load is drawn; the withdrawn Increment (prior ordinal 0) refuses instead of dispatching Load.
    gone = rootEdit (rootEdit (first, 0), 0)
    refusedClean (gone, "no longer exists")
    // The refusal changed nothing: the current session still answers its own controls.
    intact = postedTap (gone, "root", 2, 0)
    servedLoad intact
    tallyOne intact)
// [UI-EVENTS]: an edit is refused when its original revision, region or ordinal cannot be recovered from the prior state.
// The host edits whose original control the prior state cannot name, with the reason each is given.
editedAt () = [
    { region = "root", revision = 9, ordinal = 0, value = "null", reason = "Stale control" },
    { region = "gone", revision = 1, ordinal = 0, value = "null", reason = "Stale control" },
    { region = "root", revision = 1, ordinal = 9, value = "null", reason = "Unknown control" },
]
test ("an edit with an impossible original refuses without change", \() =>
    first = Probes::started ()
    forEachList (editedAt (), \probe => refusedEdit (first, probe.region, probe.revision, probe.ordinal, probe.value, probe.reason))
    refusedEvent (first, Probes::edit ("root", 0, 0, "null"), "Stale control")
    wrongKind = editFrom (first, "note", 1, 0, "7")
    refusedClean (wrongKind, "wrong kind")
    expect (countOf (wrongKind, "requests"), 0)
    // Every refusal left the session whole.
    after = postedTap (first, "root", 1, 0)
    problemFree after
    tallyOne after)
// [UI-EVENTS]: a resolved edit runs update on the current session, never on the prior state.
test ("a resolved edit updates the current state", \() =>
    first = Probes::started ()
    typed = Probes::post (first, Probes::typed (1, "hello"))
    counted = postedTap (typed, "root", 1, 0)
    edited = editFrom (counted, "note", 1, 0, "\"world\"")
    problemFree edited
    expect (Doc::text (Probes::stored edited, "memo"), "world")
    expect (Doc::text (Probes::stored typed, "memo"), "hello")
    // The carried-over tally proves the prior state was not restored.
    expect (Doc::number (Probes::stored edited, "tally"), 1))
test ("capability requests carry tickets and completions return to update", \() =>
    asked = postedTap (Probes::started (), "note", 1, 1)
    expectTexts (firstOf (asked, "requests"), [{ name = "ticket", value = "load:1" }, { name = "kind", value = "store-read" }])
    done = Probes::post (asked, "{\"kind\":\"completed\",\"ticket\":\"load:1\",\"ok\":true,\"result\":\"from disk\",\"now\":9}")
    expect (Probes::keys done, "note")
    expect (patchedText (done, "value"), "from disk"))
test ("malformed events are diagnosed, never guessed", \() =>
    bad = Probes::post (Probes::started (), "{not json")
    expect (Probes::problems bad, "The host sent an event that is not JSON")
    odd = Probes::post (Probes::started (), "{\"kind\":\"telepathy\",\"now\":1}")
    expect (Probes::problems odd, "Unknown event kind: telepathy"))
test ("contrast follows WCAG relative luminance", \() =>
    expect (Contrast::ratio ("#000000", "#FFFFFF") > 20.99, true)
    expect (Contrast::ratio ("#777777", "#777777") < 1.0001, true))
test ("sorting is stable and lists stay total", \() =>
    pairs = [Ranked(name = "b", rank = 1), Ranked(name = "a", rank = 2), Ranked(name = "b", rank = 3)]
    sorted = Lists::sortBy (pairs, \(x, y) => x.name < y.name)
    expect (join (mapList (sorted, \pair => "${pair.name}${pair.rank}")) ",", "a2,b1,b3")
    expect (Lists::distinct ["a", "b", "a"], false)
    expect (Lists::position (["a", "b", "b"], \item => item == "b"), 1)
    expect (Lists::position (["a"], \item => item == "z"), 0 - 1))
// [UI-COMPONENTS] [UI-EVENTS]: tabs encode their pages and bind as one choice after the pages' controls; segments carry their tones.
tabbed () = Ui::column [
    ui::Tabs(tabs = [Ui::tab ("one", "One", "1.circle", Ui::button ("Go", "play", Increment)), Ui::tab ("two", "Two", "2.circle", Ui::caption "Second")], selected = "two", bind = Load),
    ui::Segments(tones = [ui::Good, ui::Danger], label = "2 states"),
]
test ("tabs carry their pages and bind after the pages' controls, and segments carry their tones", \() =>
    walked = Encode::walk ([], tabbed ())
    tabs = nodeChild (walked, "children", 0)
    second = itemAt (tabs, "tabs", 1)
    segments = nodeChild (walked, "children", 1)
    binds (walked, 2)
    expectTexts (tabs, [{ name = "kind", value = "tabs" }, { name = "selected", value = "two" }])
    expect (Doc::number (tabs, "event"), 1)
    expectTexts (second, [{ name = "label", value = "Two" }, { name = "symbol", value = "2.circle" }])
    expectTexts (Doc::field (second, "child"), [{ name = "text", value = "Second" }, { name = "role", value = "caption" }])
    expect (join (Doc::texts (segments, "tones")) ",", "good,danger")
    expect (Doc::text (segments, "label"), "2 states"))
// [UI-COMPONENTS]: every constructor encodes as the component it names, with its role, tone, axis and enabled state.
built () = Ui::split [Ui::row [Ui::styled ("H", ui::Heading, ui::Accent), Ui::pair ("Label", "Value"), Ui::badge ("Partial", "info", ui::Caution), Ui::empty ("inbox", "Nothing", "Why"), Ui::action ("Stop", "stop", ui::Destructive, false, Load), Ui::toggle ("AI", true, Typed), Ui::picker ("Model", [Ui::choice ("a", "A")], "a", Load), Ui::rows ([Ui::item ("k", Ui::text "cell")], "k", Load)]]
test ("every constructor encodes as the component it names", \() =>
    doc = firstNode (Encode::walk ([], built ()))
    row = itemAt (doc, "children", 0)
    parts = Doc::items (Doc::field (row, "children"))
    expect (Doc::text (doc, "kind"), "split")
    expect (Doc::text (row, "axis"), "horizontal")
    expect (join (mapList (parts, \child => Doc::text (child, "kind"))) ",", "text,pair,badge,empty,button,toggle,picker,rows")
    expectTexts (partOf (parts, 0), [{ name = "role", value = "heading" }, { name = "tone", value = "accent" }])
    expect (Doc::text (partOf (parts, 2), "tone"), "caution")
    expect (Doc::text (partOf (parts, 3), "detail"), "Why")
    expect (Doc::text (partOf (parts, 4), "role"), "destructive")
    expect (Doc::flag (partOf (parts, 4), "enabled"), false)
    expect (Doc::flag (partOf (parts, 5), "on"), true)
    expect (Doc::text (firstOf (partOf (parts, 7), "rows"), "key"), "k"))
// [UI-EFFECTS]: a run and an HTTP request encode their bounds, headers and the slices their output lands in.
runRequest plist = Requests::encode (Requests::ask ("ps", ui::Run(executable = "/bin/ps", arguments = ["-axo", "pid="], timeout = 10000, outputLimit = 8000000, plist = plist, runSlice = "work/run")))
test ("run and http requests encode their bounds, headers and slices", \() =>
    run = runRequest false
    expectTexts (run, [{ name = "ticket", value = "ps" }, { name = "kind", value = "run" }, { name = "slice", value = "work/run" }])
    expect (join (Doc::texts (run, "arguments")) " ", "-axo pid=")
    expectNumbers (run, [{ name = "timeout", value = 10000 }, { name = "limit", value = 8000000 }])
    expect (Doc::flag (run, "plist"), false)
    expect (Doc::has (run, "plist"), true)
    expect (Doc::flag (runRequest true, "plist"), true)
    expect (Doc::has (runRequest true, "plist"), true)
    http = Requests::encode (Requests::ask ("kev", ui::Http(method = "GET", url = "https://example.test/feed", headers = [ui::Header(headerName = "Accept", headerValue = "application/json")], body = "", responseLimit = 1000, deadline = 30000, httpSlice = "work/http")))
    header = firstOf (http, "headers")
    expectTexts (http, [{ name = "method", value = "GET" }, { name = "slice", value = "work/http" }])
    expect ("${Doc::text (header, "name")}: ${Doc::text (header, "value")}", "Accept: application/json")
    expectNumbers (http, [{ name = "limit", value = 1000 }, { name = "timeout", value = 30000 }])
    write = Requests::write ("echo", "text")
    expect ("${write.sliceKey}=${write.sliceText}", "echo=text"))

named key = match Themes::named (Probes::palette (), key)
    Success token => token.tokenLight
    Error _ => "none"
// [UI-SIGNALS] [UI-THEME]: documents, lists and themes read totally, and a host-held slice counts as changed only when written.
test ("documents, lists, themes and slice writes are read totally", \() =>
    doc = Doc::parse "{\"a\":1,\"b\":null}"
    expectPresence (doc, [{ name = "b", value = true }, { name = "c", value = false }])
    expect (length (Doc::members doc), 2)
    expect (length (Doc::members JsonNull), 0)
    expect (Lists::all ([2, 4], \n => n > 1), true)
    expect (Lists::all ([2, 0], \n => n > 1), false)
    expect (join (Lists::flatten [["a"], [], ["b", "c"]]) "", "abc")
    expect (named "canvas", "#FFFFFF")
    expect (named "ink", "none")
    expect (join (Signals::written ([Requests::write ("echo", "x")], "echo", ["Memo"])) ",", "Memo")
    expect (length (Signals::written ([], "echo", ["Memo"])), 0))

requestText capability = jsonEncode (Requests::encode (Requests::ask ("job:7", capability))) ?: "encode failed"

// A capability beside the complete host payload its request encodes to: the ticket and every requested argument.
expectRequests (cases) = forEachList (cases, \probe => expect (requestText probe.capability, probe.encoded))

filesystemRequestCases () = [
    { capability = ui::Fingerprint(file = "a.txt", fileLimit = 64), encoded = "{\"ticket\":\"job:7\",\"kind\":\"fingerprint\",\"path\":\"a.txt\",\"limit\":64}" }, { capability = ui::ReadPropertyLists(plists = ["app.plist"], plistKeys = ["CFBundleName"], plistSuffixes = [".plist"], plistLimit = 128, plistSlice = "prefs"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"read-plists\",\"paths\":[\"app.plist\"],\"keys\":[\"CFBundleName\"],\"suffixes\":[\".plist\"],\"limit\":128,\"slice\":\"prefs\"}" },
    { capability = ui::ListDirectories(directories = ["/tmp", "/Users/me"], entryLimit = 12, listSlice = "listing"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"list-directories\",\"paths\":[\"/tmp\",\"/Users/me\"],\"limit\":12,\"slice\":\"listing\"}" }, { capability = ui::ReadTexts(texts = ["a.txt", "b.txt"], textLimit = 256, textSlice = "text"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"read-texts\",\"paths\":[\"a.txt\",\"b.txt\"],\"limit\":256,\"slice\":\"text\"}" },
    { capability = ui::StoreWrite(writeName = "note.txt", writeSlice = "draft"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"store-write\",\"name\":\"note.txt\",\"slice\":\"draft\"}" }, { capability = ui::StoreList(folder = "notes"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"store-list\",\"name\":\"notes\"}" },
    { capability = ui::StoreDelete(deleteName = "old.txt"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"store-delete\",\"name\":\"old.txt\"}" }, { capability = ui::MeasureFolders(measureFolders = ["C:\\Users", "/home/me"], measureLimit = 5000, measureDeadline = 60000, measureSlice = "measured"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"measure-folders\",\"folders\":[\"C:\\\\Users\",\"/home/me\"],\"limit\":5000,\"timeout\":60000,\"slice\":\"measured\"}" },
]

desktopRequestCases () = [
    { capability = ui::OpenSettings(pane = "privacy"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"open-settings\",\"pane\":\"privacy\"}" }, { capability = ui::RunningApplications, encoded = "{\"ticket\":\"job:7\",\"kind\":\"running-applications\"}" },
    { capability = ui::ChooseFile(types = ["txt", "md"], chosenLimit = 2, chosenSlice = "picked"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"choose-file\",\"types\":[\"txt\",\"md\"],\"limit\":2,\"slice\":\"picked\"}" }, { capability = ui::ChooseFolder, encoded = "{\"ticket\":\"job:7\",\"kind\":\"choose-folder\"}" },
    { capability = ui::SaveFile(suggested = "report.txt", exportSlice = "export"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"save-file\",\"name\":\"report.txt\",\"slice\":\"export\"}" }, { capability = ui::Reveal(revealPath = "/tmp/report.txt"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"reveal\",\"path\":\"/tmp/report.txt\"}" },
    { capability = ui::Cancel(cancelled = "old:7"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"cancel\",\"target\":\"old:7\"}" },
]

processRequestCases () = [
    { capability = ui::ProcessStart(processCommand = "npx", processArguments = ["-y", "filesystem"], processEnv = [ui::EnvVar(envName = "TOKEN", envValue = "s"), ui::EnvVar(envName = "DEBUG", envValue = "1")], processHandle = "fs"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"process-start\",\"command\":\"npx\",\"arguments\":[\"-y\",\"filesystem\"],\"env\":[{\"name\":\"TOKEN\",\"value\":\"s\"},{\"name\":\"DEBUG\",\"value\":\"1\"}],\"name\":\"fs\"}" }, { capability = ui::ProcessStart(processCommand = "/usr/bin/env", processArguments = [], processEnv = [], processHandle = "plain"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"process-start\",\"command\":\"/usr/bin/env\",\"arguments\":[],\"env\":[],\"name\":\"plain\"}" },
    { capability = ui::ProcessWrite(writeHandle = "fs", writeBytes = "ping"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"process-write\",\"name\":\"fs\",\"input\":\"ping\"}" }, { capability = ui::ProcessRead(readHandle = "fs", readBytesLimit = 1, readDeadline = 0), encoded = "{\"ticket\":\"job:7\",\"kind\":\"process-read\",\"name\":\"fs\",\"limit\":1,\"timeout\":0}" },
    { capability = ui::ProcessStop(stopHandle = "fs"), encoded = "{\"ticket\":\"job:7\",\"kind\":\"process-stop\",\"name\":\"fs\"}" },
]
// [UI-EFFECTS]: the complete host payload retains the ticket and every requested argument.
test ("filesystem and store requests preserve paths bounds and slices", \() =>
    expectRequests (filesystemRequestCases ()))
// [UI-EFFECTS]: the complete host payload retains the ticket and every requested argument.
test ("desktop requests preserve picker export and cancellation payloads", \() =>
    expectRequests (desktopRequestCases ()))
// [UI-EFFECTS-PROCESS]: the four long-lived process capabilities encode their handles, bounds, arguments and merged environment.
test ("process capabilities encode their handles bounds arguments and environment", \() =>
    expectRequests (processRequestCases ()))

roleText role =
    doc = firstNode (Encode::walk ([], Ui::column [ui::Text(content = "sample", role = role, tone = ui::Primary), Ui::button ("Go", "play", Increment)]))
    Doc::text (listGet (Doc::items (Doc::field (doc, "children"))) 0 ?: JsonNull, "role")
// [UI-COMPONENTS]: every semantic text role keeps its protocol spelling.
test ("semantic text roles preserve every protocol spelling", \() =>
    roles = [ui::Display, ui::Large, ui::Title, ui::Heading, ui::Lead, ui::Headline, ui::Body, ui::Callout, ui::Caption, ui::Eyebrow, ui::Mono]
    expect (join (mapList (roles, roleText)) ",", "display,large,title,heading,lead,headline,body,callout,caption,eyebrow,mono"))
// [UI-EFFECTS]: host extensions retain the same bounded request envelope.
test ("host capabilities preserve namespace operation arguments and bounds", \() =>
    request = ui::HostCall(hostNamespace = "vscode", hostOperation = "workspace.snapshot", hostArguments = JsonObject [Doc::str ("workspace", "file:///app")], hostTimeout = 1000, hostLimit = 4096, hostSlice = "workspace")
    doc = Requests::encode (Requests::ask ("host:1", request))
    expectTexts (doc, [{ name = "kind", value = "host-call" }, { name = "namespace", value = "vscode" }, { name = "operation", value = "workspace.snapshot" }, { name = "slice", value = "workspace" }])
    expectNumbers (doc, [{ name = "timeout", value = 1000 }, { name = "limit", value = 4096 }])
    expect (Doc::text (Doc::field (doc, "arguments"), "workspace"), "file:///app"))
// [UI-COMPONENTS-CONTEXT-MENU]: menu commands use the same issued binding IDs.
test ("context menus bind actions after their content controls", \() =>
    built = Ui::contextMenu (Ui::button ("Select", "package", Increment), [Ui::button ("Remove", "delete", Load)])
    walked = Encode::walk ([], built)
    item = firstOf ((firstNode walked), "items")
    expect (Doc::text ((firstNode walked), "kind"), "context-menu")
    expect (Doc::number (Doc::field ((firstNode walked), "body"), "event"), 0)
    expect (Doc::number (item, "event"), 1)
    binds (walked, 2))

mut streamedTrace = ""

(** Hands each session the framework returns to the list below. *)
effect Hold
    hold : ui::Session<Probe> => Unit

// Every session a test has reached, so an envelope can name the one it left by position.
mut sessions = [Runtime::idle (Probe(counter = Tally(tally = 0), note = Memo(memo = "")))]

// The envelope of `done`, tagged with where its session is held.
tagged done =
    place = length sessions
    perform Hold.hold done.residentSession
    Doc::parse "{\"session\":${place},${substring (done.residentEnvelope, 1, length done.residentEnvelope) ?: ""}"

held work =
    handle Hold
        hold session => sessions := listConcat sessions [session]
    handle ui::SceneStream
        shape _ => 0
    tagged (work ())

// The session `envelope` left.
sessionOf envelope = listGet sessions (Doc::number (envelope, "session")) ?: Runtime::idle (Probe(counter = Tally(tally = 0), note = Memo(memo = "")))

streamedFrom node =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive}@${Streams::depth primitive};"
    Streams::split node

begun () =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive};"
    Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"linux\"}", initial, regions, theme)

proceeded (session, event) =
    handle ui::SceneStream
        shape primitive => streamedTrace := "${streamedTrace}${Streams::code primitive};"
    Runtime::proceed (session, event, update, regions)

testCases [
    { name = "a scene encodes its primitives as flat typed arrays", work = sceneCaseASceneEncodesItsPrimitivesAsFlat },
    { name = "colours pack as RRGGBBAA", work = sceneCaseColoursPackAsRrggbbaa },
    { name = "a path encodes its steps, outline, paint and transform", work = sceneCaseAPathEncodesItsStepsOutlinePaint },
    { name = "a scene binding delivers keys and pointer positions in scene units", work = sceneCaseASceneBindingDeliversKeysAndPointer },
    { name = "a frame event delivers its elapsed seconds and patches nothing when ignored", work = sceneCaseAFrameEventDeliversItsElapsedSeconds },
    { name = "an animate request carries its on flag", work = sceneCaseAnAnimateRequestCarriesItsOnFlag },
    { name = "every symbol encodes as a distinct host-neutral name", work = sceneCaseEverySymbolEncodesAsADistinctHost },
    { name = "labels, icons, badges, empty states, buttons, tabs and rows send their symbol names", work = sceneCaseLabelsIconsBadgesEmptyStatesButtonsTabs },
    { name = "a pair encodes its label and value without a binding", work = sceneCaseAPairEncodesItsLabelAndValue },
    { name = "platforms decode to the union and encode back to their names", work = sceneCasePlatformsDecodeToTheUnionAndEncode },
    { name = "a start context carries a linux or windows platform", work = sceneCaseAStartContextCarriesALinuxOr },
    { name = "product-specific work is a host call with its namespace and arguments", work = sceneCaseProductSpecificWorkIsAHostCall },
    { name = "a split scene streams its fixed-size primitives in order and keeps the rest", work = sceneCaseASplitSceneStreamsItsFixedSize },
    { name = "an enveloped scene reports nothing streamed", work = sceneCaseAnEnvelopedSceneReportsNothingStreamed },
    { name = "streamed primitives read back every field a host import takes", work = sceneCaseStreamedPrimitivesReadBackEveryFieldA },
    { name = "a resident session keeps its store out of the envelope", work = sceneCaseAResidentSessionKeepsItsStoreOut },
    { name = "a resident session refuses stale taps and recalls earlier edits", work = sceneCaseAResidentSessionRefusesStaleControlsAnd },
    { name = "a split streams scenes from every container in the encoder's order", work = sceneCaseASplitStreamsScenesFromEveryContainer },
    { name = "primitives that do not stream read back zero fields", work = sceneCasePrimitivesThatDoNotStreamReadBack },
    { name = "a resident session delivers completions, phases and frames and refuses malformed text", work = sceneCaseAResidentSessionDeliversCompletionsPhasesAnd },
    { name = "an idle session holds only its store", work = sceneCaseAnIdleSessionHoldsOnlyItsStore },
    { name = "toggles and pickers deliver their own value kinds and refuse others", work = sceneCaseTogglesAndPickersDeliverTheirOwnValue },
    { name = "progress, swatches, alerts, prominent buttons and leading asides encode", work = sceneCaseProgressSwatchesAlertsProminentButtonsAndLeading },
    { name = "a meter sends its amount clamped into a total of at least one", work = sceneCaseAMeterSendsItsAmountClampedInto },
    { name = "an editor binds text then cursor after earlier controls and preserves its marks", work = AdditionCases::editorEncoding },
    { name = "a cursor binding delivers placed offsets, clamps negatives and refuses text", work = AdditionCases::cursorValues },
    { name = "a board names its host slice and binds strokes before its lasso", work = AdditionCases::boardEncoding },
    { name = "a board stroke decodes two ordered points with their width and time", work = AdditionCases::strokeDecoding },
    { name = "empty negative and non-pair stroke points are refused with the exact diagnostic", work = AdditionCases::strokeRefusals },
    { name = "a lasso delivers stroke indices and refuses strings and negative indices", work = AdditionCases::lassoValues },
    { name = "a recognition request names its stroke slices and output limit", work = AdditionCases::recognitionEncoding },
    { name = "message routing delivers placed stroked and lassoed values to their handlers", work = AdditionCases::messageRouting },
    { name = "board themes name the board and chalk tokens", work = AdditionCases::boardTokens },
    { name = "mathematics decodes back to the tree it encodes across every constructor", work = AdditionCases::mathRoundTrip },
    { name = "mathematics decoding refuses unknown kinds missing children non-arrays and non-objects", work = AdditionCases::mathRefusals },
    { name = "image and video encode as leaves with their media fields and no ordinal", work = AdditionCases::mediaEncoding }
]
test ("presentation frames explicitly disable viewport sizing by default", \() =>
    style = Doc::field (firstNode (Encode::walk ([], Ui::framed (plain, Ui::button ("Continue", "", Increment)))), "style")
    expect (Doc::has (style, "viewportHeightInset"), true)
    expect (Doc::number (style, "viewportHeightInset"), -1)
    expectPresence (style, [{ name = "scrollY", value = true }, { name = "selectionGroup", value = true }])
    scrollAndSelection (style, false))

test ("presentation frames preserve exact dimensions and inner control provenance", \() =>
    style = plain(frameName = "solution-column", frameWidth = 430, frameHeight = 440, frameViewportHeightInset = 270, frameScrollY = true, frameTop = 34, frameRight = 30, frameBottom = 30, frameLeft = 30, frameGap = 24, frameFill = "canvas", frameFont = "serif", frameTextSize = 27, frameItalic = true, frameHug = true, frameAlign = "center", frameCross = "end", frameControlHeight = 40, frameControlPadding = 12, frameMathScale = 1.08, frameLineHeight = 34.72, frameTracking = -0.6, frameQuietControls = true, frameFadeBackdrop = true, frameTrailingSymbols = true, frameSelectionGroup = true, frameShadow = "floating", frameSymbolSize = 13)
    walked = Encode::walk ([], Ui::framed (style, Ui::button ("Continue", "", Increment)))
    encoded = firstNode walked
    geometry = Doc::field (encoded, "style")
    expect (Doc::text (encoded, "kind"), "framed")
    expectNumbers (geometry, [{ name = "width", value = 430 }, { name = "height", value = 440 }, { name = "viewportHeightInset", value = 270 }, { name = "left", value = 30 }, { name = "gap", value = 24 }, { name = "symbolSize", value = 13 }])
    scrollAndSelection (geometry, true)
    expect (Doc::text (geometry, "fill"), "canvas")
    expect (Doc::has (geometry, "symbolSize"), true)
    AdditionCases::frameTypography geometry
    binds (walked, 1)
    expect (Doc::number (Doc::field (encoded, "body"), "event"), 0))

test ("scoped themes and dialogs retain their inner controls and dismissal provenance", \() =>
    theme = ui::Theme(tokens = [ui::Token(tokenName = "canvas", tokenLight = "#202723", tokenDark = "#202723")], spacing = [8], feedback = 140, settle = 240)
    walked = Encode::walk ([], Ui::themed (theme, Ui::dialog ("Review transcription", Ui::button ("Insert", "", Increment), Load)))
    scoped = firstNode walked
    dialog = Doc::field (scoped, "body")
    expect (Doc::text (scoped, "kind"), "themed")
    expectTexts (dialog, [{ name = "kind", value = "dialog" }, { name = "title", value = "Review transcription" }])
    expect (Doc::number (dialog, "event"), 0)
    expect (Doc::number (Doc::field (dialog, "body"), "event"), 1)
    expect (length walked.bindings, 2))

richDocument : ui::Node<Act>
richDocument = Ui::rich ([Ui::run ("For all ", "", false), Ui::run ("p", "sourceType", true)], ui::Lead)
test ("inline text retains mathematical emphasis and semantic source colours without bindings", \() =>
    walked = Encode::walk ([], richDocument)
    variable = listGet (Doc::items (Doc::field ((firstNode walked), "runs"))) 1 ?: JsonNull
    expect (Doc::text ((firstNode walked), "kind"), "rich-text")
    expectTexts (variable, [{ name = "text", value = "p" }, { name = "ink", value = "sourceType" }])
    expect (Doc::flag (variable, "italic"), true)
    binds (walked, 0)
    spaced = Encode::walk ([], Ui::column [ui::Spacer, Ui::button ("Continue", "", Increment)])
    expect (Doc::text (firstOf ((firstNode spaced), "children"), "kind"), "spacer")
    expect (length (Doc::items (Doc::field ((firstNode spaced), "children"))), 2)
    binds (spaced, 1))

