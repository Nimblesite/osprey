// Real machine documents driven without their applications: the native package
// owns loading, settling, rendering, pointer geometry and accessibility.
namespace uitests

import ui::Canvases
import ui::Doc
import ui::MachineDocs
import ui::Machines
import ui::Runtime
import ui::Templates
import ui::Values

realMachine path = match MachineDocs::load (readFile path ?: "")
    Success machine => machine
    Error problem =>
        expect ("${path} loads: ${problem}", "${path} loads")
        MachineDocs::faulty problem

signalMachine () = realMachine "src/osprey/packages/signal_flow/signal_flow.machine.json"

playerMachine () = realMachine "src/osprey/examples/casting/player.machine.json"

realSkinned (machine, skin) = nativeFeed (machine, "skin", skin)

realPointer (machine, point, down) = Canvases::pointer (machine, point.nativeX, point.nativeY, down)

realTap (machine, label) = Canvases::act (machine, label, 0.5)

// `machine`'s volume reads `wanted` within float tolerance.
volumeIs (machine, wanted) = expect (abs (Machines::number (machine, "volume") - wanted) < 0.000001, true)

// `machine` with the pointer down (or up) at `body` moved by `dx`, `dy`.
pressedFrom (machine, body, dx, dy, down) = realPointer (machine, NativePoint(nativeX = body.nativeX + dx, nativeY = body.nativeY + dy), down)

// Dragging `label`'s slider from `from` to `to`: it slides while held, stops on release and reads `to` throughout.
dragSlider (machine, label, from, to) =
    pressed = realPointer (machine, nativePoint (nativeElement (machine, label), from), true)
    expect (Canvases::sliding pressed, true)
    high = nativePoint (nativeElement (pressed, label), to)
    sliding = realPointer (pressed, high, true)
    volumeIs (sliding, to)
    released = realPointer (sliding, high, false)
    expect (Canvases::sliding released, false)
    volumeIs (released, to)

// Each probe reads its `key` of its `at` and must equal its `value`.
probesHold (read, probes) = forEachList (probes, \probe => expect (read (probe.at, probe.key), probe.value))

realDocumentSkins () =
    initial = signalMachine ()
    expect (Machines::text (initial, "skin"), "topology")
    expect (Machines::current (initial, "commands"), "idle")
    expect (nativeLabels initial, "Skin: Topology|Bypass Policy|Bypass Client|Bypass Gateway|Bypass Service|Bypass Telemetry|Policy Threshold|Gateway Rate limit|Inspector: Bypass Gateway|Inspector: Rate limit|Select Policy|Select Client|Select Gateway|Select Service|Select Telemetry")
    expectRead (\name => nativeLetters (initial, name), [{ name = "70%", value = true }, { name = "0 r/s", value = true }])
    topology = realSkinned (initial, "topology")
    notation = realSkinned (initial, "notation")
    paper = realSkinned (initial, "paper")
    prism = realSkinned (initial, "prism")
    forEachList ([topology, notation, paper, prism], \machine =>
        expectRendered machine
        expect (length (Canvases::semantics machine) > 10, true))
    probesHold (nativeLetters, [{ at = notation, key = "0.70", value = true }, { at = paper, key = "Transform", value = true }, { at = prism, key = "2.5 kHz", value = true }, { at = prism, key = "-24.0", value = true }])

realCanvasEdits () =
    prism = realSkinned (signalMachine (), "prism")
    bypassed = realTap (prism, "Bypass Filter")
    enabled = realTap (bypassed, "Enable Filter")
    lowered = Canvases::act (enabled, "Filter Cutoff", 0.25)
    opened = realTap (lowered, "LFO Rate: 1/4")
    chosen = realTap (opened, "1/16")
    outside = Canvases::released (realTap (chosen, "Oscillator Wave: Sine"), 1400.0, 700.0)
    body = nativePoint (nativeElement (outside, "Select Filter"), 0.5)
    pressed = pressedFrom (outside, body, 0.0, 0.0, true)
    near = pressedFrom (pressed, body, 2.0, 1.0, true)
    moved = pressedFrom (near, body, 100.0, 50.0, true)
    dropped = pressedFrom (moved, body, 100.0, 50.0, false)
    hovered = realPointer (dropped, body, false)
    probesHold (Machines::flag, [{ at = bypassed, key = "processOn", value = false }, { at = enabled, key = "processOn", value = true }])
    probesHold (Machines::number, [{ at = lowered, key = "process", value = 0.25 }, { at = near, key = "processX", value = 0.0 }, { at = moved, key = "processX", value = 100.0 }, { at = moved, key = "processY", value = 50.0 }])
    expect (nativeValue (lowered, "Filter Cutoff"), 0.25)
    probesHold (Machines::current, [{ at = opened, key = "menu", value = "rates" }, { at = chosen, key = "menu", value = "closed" }, { at = outside, key = "menu", value = "closed" }])
    probesHold (Machines::text, [{ at = chosen, key = "rate", value = "1/16" }, { at = outside, key = "wave", value = "Sine" }, { at = dropped, key = "selected", value = "process" }])
    expect (nativeRole (opened, "1/16"), "menuitem")
    expectRead (\machine => Canvases::holding machine, [{ name = pressed, value = true }, { name = dropped, value = false }])
    expect (Canvases::sliding pressed, false)
    expect (Doc::write (MachineDocs::snapshot hovered), Doc::write (MachineDocs::snapshot dropped))

// The machine's first scene's own size, in scene units, which a host fits into its region.
sceneSize machine = match listGet (nativeScenes machine) 0
    Success scene => "${scene.sketchWidth}x${scene.sketchHeight}"
    Error _ => "none"

realCanvasRoomAndSliders () =
    prism = realSkinned (signalMachine (), "prism")
    grown = Canvases::viewed (prism, 1936.0, 1128.0)
    shrunk = Canvases::viewed (grown, 1000.0, 600.0)
    probesHold (Machines::number, [{ at = grown, key = "viewWidth", value = 1936.0 }, { at = grown, key = "viewHeight", value = 1128.0 }, { at = grown, key = "spareWidth", value = 400.0 }, { at = grown, key = "spareHeight", value = 300.0 }, { at = shrunk, key = "spareWidth", value = 0.0 }, { at = shrunk, key = "spareHeight", value = 0.0 }])
    // A host fits the scene's own size into its region, so room spared must not grow it: a window that
    // later got shorter would fit the grown size and be told the same spare room for ever.
    expect (sceneSize grown, "1536.0x828.0")
    expect (sceneSize (prism), sceneSize grown)
    dragSlider (shrunk, "Master Level", 0.1, 0.9)

realPlayerJourney () =
    player = playerMachine ()
    expect (nativeLabels player, "Appearance: Sherbet Signal|Receiver: none|Play|Open file…")
    expect (nativeLetters (player, "Looking for TVs…"), true)
    forEachList (["sherbet", "midnight", "poolside"], \skin => expectRendered (realSkinned (player, skin)))
    native = realSkinned (player, "midnight")
    expectRead (\name => nativeShows (native, name), [{ name = "Looking for TVs…", value = true }, { name = "Choose an audio file", value = true }])
    ready = Machines::feed (native, [
        Machines::fact ("receiver", Values::text "192.168.1.20:8009"), Machines::fact ("receiverName", Values::text "Living Room TV"),
        Machines::fact ("file", Values::text "/music/demo.mp3"), Machines::fact ("title", Values::text "A very long track name that will not fit on one line at all.mp3"),
    ])
    connecting = Machines::pull (ready, ui::Fire(fireName = "play"), Values::none ())
    fed = Machines::feed (Machines::taken connecting, [
        Machines::fact ("player", Values::text "PLAYING"), Machines::fact ("position", Values::number 50.0),
        Machines::fact ("duration", Values::number 200.0), Machines::fact ("volume", Values::number 0.5), Machines::fact ("rate", Values::number 1.5),
    ])
    canvas = realSkinned (fed, "sherbet")
    rates = realTap (canvas, "Speed: 1.5×")
    receivers = realTap (canvas, "Receiver: Living Room TV")
    probesHold (Machines::current, [{ at = ready, key = "receivers", value = "found" }, { at = connecting, key = "playback", value = "connecting" }, { at = fed, key = "playback", value = "playing" }, { at = receivers, key = "menu", value = "receivers" }])
    expect (length (Machines::requests connecting) > 0, true)
    expect (length (Machines::requests fed), 0)
    expect (nativeLabels rates, "0.75×|1×|1.25×|1.5×|2×|Appearance: Sherbet Signal|Receiver: Living Room TV|Speed: 1.5×|Pause|Stop|Open file…|Position|Volume")
    probesHold (nativeShows, [{ at = fed, key = "00:50", value = true }, { at = fed, key = "03:20", value = true }, { at = fed, key = "Volume 50%", value = true }, { at = fed, key = "1.5×", value = true }, { at = fed, key = "A very long track name that will not fit on one line at all.mp3", value = true }])
    probesHold (nativeLetters, [{ at = canvas, key = "A very long track name that w…", value = true }, { at = canvas, key = "00:50", value = true }, { at = canvas, key = "03:20", value = true }])

realDocumentCases () = Runtime::guarded (\() =>
    realDocumentSkins ()
    realCanvasEdits ()
    realCanvasRoomAndSliders ()
    realPlayerJourney ())
