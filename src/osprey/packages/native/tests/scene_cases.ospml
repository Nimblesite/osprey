// The `at`th value of `entry`, or null when it is missing.
cell (entry, at) = jsonIndex entry at ?: JsonNull
// The `at`th value of the `index`th entry of `entries` as a number, or -1 when either is missing.
numberAt (entries, index, at) = jsonInt (cell (listGet entries index ?: JsonNull, at)) ?: 0 - 1
// An entry's type code.
codeAt (shapes, index) = numberAt (shapes, index, 0)
// The `key` entries of `doc`, its shapes, and the `key` text of the `index`th of `parts`.
itemsOf (doc, key) = Doc::items (Doc::field (doc, key))
shapesOf scene = itemsOf (scene, "shapes")
fieldAt (parts, index, key) = Doc::text (listGet parts index ?: JsonNull, key)
// The type codes of the first `count` of `shapes`, joined with a comma, and one write assertion per
// `{ at = …, want = … }` of `entry`.
codesOf (shapes, count) = joined (indices count, \index => "${codeAt (shapes, index)}")
expectWrites (entry, wanted) = forEachList (wanted, \one => expect (Doc::write (cell (entry, one.at)), one.want))
// Asserts `f` gives each of `wants` for `inputs`, `probes` pass `probe`, and `shapes` codes are `want`.
holds (f, inputs, wants) = expect (answersHold (f, inputs, wants), true)
checked (probes, probe) = expect (forEachList (probes, probe), true)
codesAre (shapes, want) = expect (codesOf (shapes, length shapes), want)
// One refusal `message` per entry of `inputs`, and the parts of the `container` walked from scratch.
refusals (inputs, message) = mapList (inputs, \_ => message)
partsOf container = itemsOf (firstNode (Encode::walk ([], container)), "children")
// `show` rendered for each entry of `list`, the results joined by `sep`, and `items` by commas.
joinedBy (sep, list, show) = join (mapList (list, show)) sep
joined (list, show) = joinedBy (",", list, show)
commaed items = joinedBy (",", items, \item => item)

// [UI-SCENE]: a scene encodes flat, a type code first, sprites by atlas index, glyph text inline.
(** a scene encodes its primitives as flat typed arrays. *)
// The integers `0` to `count - 1`, in order.
indices count = range (0, count) |> fold [] (\(out, index) => listAppend out index)
sceneCaseASceneEncodesItsPrimitivesAsFlat () =
    drawn = [Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, Scenes::rgb (255, 0, 0), 0), Scenes::disc (5.0, 6.0, 7.0, Scenes::rgba (0, 0, 255, 128), 1), Scenes::strip ([0.0, 0.0, 10.0, 10.0], Scenes::rgb (0, 255, 0), 2.0, 1), Scenes::sprite (1, 8.0, 9.0, 2.0, 2.0, 0.0, Scenes::rgb (255, 255, 255), 2), Scenes::glyphs ("Score 3", 1.0, 1.0, 12.0, Scenes::rgb (0, 0, 0), 3)]
    walked = Encode::walk ([], Ui::column [Ui::button ("Pause", "pause", Load), Ui::scene (320.0, 200.0, ["bird", "hawk"], drawn, Typed)])
    doc = listGet walked.nodes 0 ?: JsonNull
    scene = jsonIndex (jsonField doc "children" ?: JsonNull) 1 ?: JsonNull
    shapes = shapesOf scene
    expect ("${Doc::text (scene, "kind")} ${commaed (Doc::texts (scene, "atlas"))}", "scene bird,hawk")
    expectDecimals (scene, [{ name = "width", value = 320.0 }, { name = "height", value = 200.0 }, { name = "zoom", value = 1.0 }])
    zoomed = firstNode (Encode::walk ([], Ui::zoomed (0.75, 1536.0, 828.0, [], drawn, Typed)))
    expectDecimals (zoomed, [{ name = "zoom", value = 0.75 }, { name = "width", value = 1536.0 }])
    expect (length shapes, 5)
    codesAre (shapes, "0,1,2,3,4")
    expect (joined (shapes, \shape => "${length (Doc::items shape)}"), "8,6,9,9,7")
    forEachList ([{ index = 0, at = 6, want = Scenes::rgb (255, 0, 0) }, { index = 2, at = 1, want = 2 }, { index = 3, at = 1, want = 1 }], \one => expect (numberAt (shapes, one.index, one.at), one.want))
    expect (jsonText (jsonIndex (listGet shapes 4 ?: JsonNull) 1 ?: JsonNull) ?: "", "Score 3")
    expect ("${Doc::number (scene, "event")} ${length walked.bindings}", "1 2")
(** colours pack as RRGGBBAA. *)
sceneCaseColoursPackAsRrggbbaa () =
    expect (joined ([Scenes::rgba (1, 2, 3, 4), Scenes::rgb (255, 255, 255)], \shade => "${shade}"), "16909060,4294967295")
// `message` routed arm by arm: every arm but the scene input spells its own marker.
sceneRouted (message, input) = Messages::route (message, \_ => "tap", \(_, _) => "text", \(_, _) => "flag", \(_, _) => "size", \(_, _) => "done", \_ => "phase", \(_, _) => "stroke", \(_, _) => "lasso", \_ => "frame", input)
controlled value = sceneRouted (Events::bind (ui::SceneInput(action = Typed), value) ?: ui::Act(act = Load), \(_, input) => Inputs::route (input, \(name, down) => "key ${name} ${down}", \(x, y, down, shift) => "pointer ${x} ${y} ${down} ${shift}", \(w, h) => "viewed ${w} ${h}"))

// [UI-SCENE]: a path carries its steps, outline, paint and transform in its builder's order.
(** a path encodes its steps, outline, paint and transform. *)
sceneCaseAPathEncodesItsStepsOutlinePaint () =
    steps = [ui::MoveTo(toX = 1.0, toY = 2.0), ui::LineTo(toX = 3.0, toY = 4.0), ui::CurveTo(toX = 5.0, toY = 6.0, ctrlX = 7.0, ctrlY = 8.0), ui::CubicTo(toX = 1.0, toY = 1.0, ctrlAX = 2.0, ctrlAY = 2.0, ctrlBX = 3.0, ctrlBY = 3.0), ui::ArcTo(radiusX = 30.0, radiusY = 30.0, rotation = 0.0, large = false, sweep = true, toX = 9.0, toY = 9.0), ui::Polygon(corners = [0.0, 0.0, 4.0, 0.0, 4.0, 4.0], closed = false), ui::Close]
    gradient = ui::Linear(angle = 180.0, from = Scenes::hex (16436245, 1.0), fromAt = 0.7, to = ui::Hsl(hue = 0.0, saturation = 1.0, lightness = 0.5, opacity = 1.0), toAt = 1.0, oklab = true)
    drawn = [Scenes::path (steps, ui::Fill, gradient, 0), Scenes::moved ([ui::MoveTo(toX = 0.0, toY = 0.0)], ui::Line(width = 1.0, dashes = [4.0, 2.0], bevel = true), ui::Solid(tint = Scenes::hex (16711680, 0.5)), 10.0, 200.0, 0.9, 1)]
    walked = Encode::walk ([], Ui::canvas (drawn, Typed))
    scene = listGet walked.nodes 0 ?: JsonNull
    shapes = shapesOf scene
    filled = listGet shapes 0 ?: JsonNull
    expect ("${Doc::decimal (scene, "width")} ${codeAt (shapes, 0)}", "0.0 5")
    encodedSteps = Doc::items (jsonIndex filled 1 ?: JsonNull)
    expect (codesOf (encodedSteps, 7), "0,1,2,3,4,5,6")
    expect (Doc::write (listGet encodedSteps 4 ?: JsonNull), "[4,30.0,30.0,0.0,0,1,9.0,9.0]")
    expectWrites (filled, [{ at = 2, want = "[0]" }, { at = 4, want = "[]" }])
    paint = cell (filled, 3)
    expect (jsonInt (cell (paint, 0)) ?: 0, 1)
    expectWrites (paint, [{ at = 4, want = "[1,0.0,1.0,0.5,1.0]" }])
    stroked = listGet shapes 1 ?: JsonNull
    expectWrites (stroked, [{ at = 2, want = "[1,1.0,1,4.0,2.0]" }, { at = 3, want = "[0,[0,1.0,0.0,0.0,0.5]]" }, { at = 4, want = "[10.0,200.0,0.9]" }])
(** a scene binding delivers keys, pointer positions and its region's size in scene units. *)
sceneCaseASceneBindingDeliversKeysAndPointer () =
    holds (controlled, [JsonObject [Doc::str ("key", "ArrowLeft"), Doc::bit ("down", true)], JsonObject [JsonMember "x" (JsonFloat 12.5), JsonMember "y" (JsonInt 3), Doc::bit ("down", false)], JsonObject [JsonMember "x" (JsonFloat 1.0), JsonMember "y" (JsonFloat 2.0), Doc::bit ("down", true), Doc::bit ("shift", true)], JsonObject [JsonMember "width" (JsonFloat 1536.0), JsonMember "height" (JsonInt 1008)], JsonObject [JsonMember "width" (JsonFloat 0.5), JsonMember "height" (JsonFloat 2.25), Doc::bit ("down", true)], JsonString "left"], ["key ArrowLeft true", "pointer 12.5 3.0 false false", "pointer 1.0 2.0 true true", "viewed 1536.0 1008.0", "viewed 0.5 2.25", "tap"])
    refused = [JsonObject [], JsonObject [Doc::str ("key", "ArrowLeft")], JsonObject [Doc::num ("key", 1), Doc::bit ("down", true)], JsonObject [Doc::num ("x", 1), Doc::bit ("down", true)], JsonObject [Doc::num ("x", 1), Doc::num ("y", 2), Doc::str ("down", "false")], JsonObject [Doc::num ("x", 1), Doc::num ("y", 2), Doc::bit ("down", true), Doc::str ("shift", "false")], JsonObject [Doc::num ("width", 4)], JsonObject [Doc::str ("width", "wide"), Doc::num ("height", 2)]]
    holds (\value => boundAs (ui::SceneInput(action = Typed), value), refused, refusals (refused, "A scene control sent a value of the wrong kind"))
framed : ui::Message<Act> -> float
framed message = Messages::route (message, \_ => 0.0 - 1.0, \(_, _) => 0.0 - 2.0, \(_, _) => 0.0 - 3.0, \(_, _) => 0.0 - 4.0, \(_, _) => 0.0 - 5.0, \_ => 0.0 - 6.0, \(_, _) => 0.0 - 7.0, \(_, _) => 0.0 - 8.0, \elapsed => elapsed, \(_, _) => 0.0 - 9.0)

// [UI-SCENE]: a frame event reaches `update` as the seconds since the previous frame.
eventRefusal source = match Events::decode source
    Error problem => problem
    Success _ => "accepted"
(** a frame event delivers its elapsed seconds and patches nothing when ignored. *)
sceneCaseAFrameEventDeliversItsElapsedSeconds () =
    expect (framed (ui::Frame(elapsed = 0.016)), 0.016)
    forEachList (["{\"kind\":\"frame\"}", "{\"kind\":\"frame\",\"elapsed\":\"slow\"}", "{\"kind\":\"frame\",\"elapsed\":-1}"], \source =>
        expect (eventRefusal source, "Invalid frame elapsed time"))
    started = Probes::started ()
    after = Probes::post (started, "{\"kind\":\"frame\",\"now\":9,\"elapsed\":0.016}")
    expect (Probes::problems after, "")
    expect (Probes::keys after, "")

// [UI-SCENE]
(** an animate request carries its on flag. *)
sceneCaseAnAnimateRequestCarriesItsOnFlag () =
    doc = Requests::encode (Requests::ask ("clock:1", ui::Animate(animated = true)))
    expectTexts (doc, [{ name = "kind", value = "animate" }, { name = "ticket", value = "clock:1" }])
    expect (Doc::flag (doc, "on"), true)
occurrences (names, name) = length (range (0, length names) |> fold [] (\(found, index) => Pick::either ((listGet names index ?: "") == name, listAppend found index, found)))
symbols () = [ui::NoSymbol, ui::Add, ui::Delete, ui::Dismiss, ui::Check, ui::Warning, ui::Info, ui::Question, ui::Search, ui::Settings, ui::Star, ui::Play, ui::Pause, ui::Stop, ui::Refresh, ui::Folder, ui::Document, ui::Package, ui::Inbox, ui::Globe, ui::External, ui::Lock, ui::Shield, ui::Branch, ui::Tag, ui::Clock, ui::Person, ui::Cursor, ui::Chevron]

// [UI-COMPONENTS-SYMBOLS]
(** every symbol encodes as a distinct host-neutral name. *)
sceneCaseEverySymbolEncodesAsADistinctHost () =
    names = mapList (symbols (), \symbol => Symbols::name symbol)
    expect (commaed names, ",add,delete,dismiss,check,warning,info,question,search,settings,star,play,pause,stop,refresh,folder,document,package,inbox,globe,external,lock,shield,branch,tag,clock,person,cursor,chevron")
    expect (Lists::any (names, \name => occurrences (names, name) != 1), false)

// [UI-COMPONENTS-SYMBOLS]
(** labels, icons, badges, empty states, buttons, tabs and rows send their symbol names. *)
sceneCaseLabelsIconsBadgesEmptyStatesButtonsTabs () =
    parts = partsOf (Ui::column [Ui::label ("L", "folder"), Ui::icon "globe", Ui::badge ("B", "shield", ui::Good), Ui::empty ("search", "E", "D"), Ui::button ("Go", "refresh", Increment), ui::Tabs(tabs = [Ui::tab ("t", "T", "clock", Ui::text "page")], selected = "t", bind = Load), Ui::rows ([Ui::item ("plain", Ui::text "p"), Ui::entry ("led", "person", "G", Ui::text "q")], "plain", Load)])
    expect (joined ([0, 1, 2, 3, 4], \index => fieldAt (parts, index, "symbol")), "folder,globe,shield,search,refresh")
    expect (fieldAt (itemsOf (listGet parts 5 ?: JsonNull, "tabs"), 0, "symbol"), "clock")
    expect (joined (itemsOf (listGet parts 6 ?: JsonNull, "rows"), \row => Doc::text (row, "symbol")), ",person")

// [UI-COMPONENTS]
(** a pair encodes its label and value without a binding. *)
sceneCaseAPairEncodesItsLabelAndValue () =
    walked = Encode::walk ([], Ui::column [Ui::pair ("Digest", "sha256:ab"), Ui::button ("Go", "play", Increment)])
    parts = itemsOf (listGet walked.nodes 0 ?: JsonNull, "children")
    doc = listGet parts 0 ?: JsonNull
    expect ("${Doc::text (doc, "kind")} ${Doc::text (doc, "label")}=${Doc::text (doc, "value")}", "pair Digest=sha256:ab")
    expect (Doc::has (doc, "event"), false)
    expect ("${Doc::number (listGet parts 1 ?: JsonNull, "event")} ${length walked.bindings}", "0 1")
// A platform's `linux` marker and the host name it carries, when it knows another.
platformPair text = match Symbols::platform text
    ui::Linux => "true "
    ui::OtherPlatform name => "false ${name}"
    _ => "false "

// [UI-CONTEXT-PLATFORM]
(** platforms decode to the union and encode back to their names. *)
sceneCasePlatformsDecodeToTheUnionAndEncode () =
    expect (joined (["macos", "ios", "linux", "windows", "android", "web", "vscode", ""], \text => Symbols::platformText (Symbols::platform text)), "macos,ios,linux,windows,android,web,vscode,")
    expect (joined (["linux", "haiku", "windows"], platformPair), "true ,false haiku,false ")
// The start-context JSON a host posts for its `platform` and `home` directory.
startContext (platform, home) = "{\"now\":5,\"offset\":0,\"platform\":\"${platform}\",\"home\":\"${home}\",\"arguments\":[]}"

// [UI-CONTEXT-PLATFORM]
(** a start context carries a linux or windows platform. *)
sceneCaseAStartContextCarriesALinuxOr () =
    checked ([{ platform = "linux", home = "/home/me" }, { platform = "windows", home = "C:/Users/me" }], \probe => expect ((Runtime::context (Doc::parse (startContext (probe.platform, probe.home)))).platform, probe.platform))

// [UI-EFFECTS]
(** product-specific work is a host call with its namespace and arguments. *)
sceneCaseProductSpecificWorkIsAHostCall () =
    expect (requestText (ui::HostCall(hostNamespace = "probe", hostOperation = "read-config", hostArguments = JsonObject [JsonMember "paths" (Doc::strings ["app.toml"])], hostTimeout = 500, hostLimit = 128, hostSlice = "prefs")), "{\"ticket\":\"job:7\",\"kind\":\"host-call\",\"namespace\":\"probe\",\"operation\":\"read-config\",\"arguments\":{\"paths\":[\"app.toml\"]},\"timeout\":500,\"limit\":128,\"slice\":\"prefs\"}")
streamScene () = Ui::column [Ui::button ("Pause", "pause", Load), Ui::scene (320.0, 200.0, ["bird"], [Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, Scenes::rgb (255, 0, 0), 1), Scenes::strip ([0.0, 0.0, 10.0, 10.0], Scenes::rgb (0, 255, 0), 2.0, 1), Scenes::disc (5.0, 6.0, 7.0, Scenes::rgb (0, 0, 255), 2), Scenes::glyphs ("Score 3", 1.0, 1.0, 12.0, Scenes::rgb (0, 0, 0), 3), Scenes::sprite (1, 8.0, 9.0, 2.0, 2.0, 0.25, Scenes::rgb (255, 255, 255), 4)], Typed)]

// [UI-SCENE-STREAM]
(** a split scene streams its fixed-size primitives in order and keeps the rest. *)
sceneCaseASplitSceneStreamsItsFixedSize () =
    walked = walkStreamed (streamScene ())
    expect (streamedTrace, "0@1;1@2;3@4;")
    scene = itemAt (listGet walked.nodes 0 ?: JsonNull, "children", 1)
    shapes = shapesOf scene
    expect ("${Doc::number (scene, "streamed")} ${Doc::number (scene, "event")} ${length walked.bindings}", "3 1 2")
    codesAre (shapes, "2,4")

// [UI-SCENE-STREAM]
(** an enveloped scene reports nothing streamed. *)
sceneCaseAnEnvelopedSceneReportsNothingStreamed () =
    scene = itemAt (firstNode (Encode::walk ([], streamScene ())), "children", 1)
    expect ("${Doc::number (scene, "streamed")} ${length (shapesOf scene)}", "0 5")
// The nodes `container` walks to with its primitives streamed out, and a primitive's values as host text.
walkStreamed container = Encode::walk ([], streamedFrom container)
valuesOf (primitive, count) = joinedBy (" ", indices count, \index => "${Streams::value (primitive, index)}")
tailFields primitive = "${Streams::colour primitive} ${Streams::depth primitive} ${Streams::index primitive}"
streamedFields primitive = "${Streams::code primitive} ${Streams::index primitive} ${valuesOf (primitive, 5)} ${tailFields primitive}"
// The keys, problems and state a session's envelope carries, and its store's tally and note.
envelopeOf session = Doc::parse session.residentEnvelope
keysOf session = Probes::keys (envelopeOf session)
problemsOf session = Probes::problems (envelopeOf session)
stateOf session = Doc::text (envelopeOf session, "state")
tallyOf envelope = envelope.residentSession.sessionStore.counter.tally
memoOf envelope = envelope.residentSession.sessionStore.note.memo
// The session a tap on the probe's `root` control delivers.
afterTap session = proceeded (session, Probes::tap ("root", 1, 0))
// Asserts `session` refused a change: its envelope names `problem`, its tally stands at one.
expectKept (session, problem) =
    expect (contains (problemsOf session) problem, true)
    expect (tallyOf session, 1)

// [UI-SCENE-STREAM]
(** streamed primitives read back every field a host import takes. *)
sceneCaseStreamedPrimitivesReadBackEveryFieldA () =
    holds (streamedFields, [Scenes::rect (1.0, 2.0, 3.0, 4.0, 0.5, 7, 1), Scenes::disc (5.0, 6.0, 7.0, 8, 2), Scenes::sprite (3, 8.0, 9.0, 2.0, 1.0, 0.25, 9, 4)], ["0 0 1.0 2.0 3.0 4.0 0.5 7 1", "1 0 5.0 6.0 7.0 0.0 0.0 8 2", "3 3 8.0 9.0 2.0 1.0 0.25 9 4"])
    expect (Streams::streamed (Scenes::glyphs ("x", 0.0, 0.0, 1.0, 0, 0)), false)

// [UI-RESIDENT]
(** a resident session keeps its store out of the envelope. *)
sceneCaseAResidentSessionKeepsItsStoreOut () =
    first = begun ()
    tapped = afterTap first.residentSession
    expect (commaed [stateOf first, keysOf first, first.residentSession.sessionContext.platform], "resident,root,note,linux")
    expect (commaed [keysOf tapped, "${tallyOf tapped}", stateOf tapped], "root,1,resident")

// [UI-RESIDENT]
(** a resident session refuses stale controls and prior-state edits without change. *)
sceneCaseAResidentSessionRefusesStaleControlsAnd () =
    first = begun ()
    moved = afterTap first.residentSession
    stale = afterTap moved.residentSession
    expect (keysOf stale, "")
    expectKept (stale, "Stale control")
    edited = proceeded (moved.residentSession, Probes::edit ("\"resident\"", "root", 1, 0, "null"))
    expectKept (edited, "keeps no prior state")
// One scene holding a single disc at `layer`, so the stream's order names the container it was found in.
dot layer = Ui::scene (10.0, 10.0, [], [Scenes::disc (1.0, 1.0, 1.0, 0, layer)], Typed)
everyContainer () = Ui::split [
    Ui::screen ("T", "", [dot 1], [ui::Section(title = "S", footer = "", children = [dot 2])]),
    Ui::layer [Ui::contextMenu (dot 3, [dot 4]), Ui::aside (dot 5, ui::Leading, dot 6, 300, Typed)],
    ui::Tabs(tabs = [Ui::tab ("t", "T", "tag", dot 7)], selected = "t", bind = Load),
    Ui::rows ([Ui::entry ("r", "star", "", dot 8)], "r", Load),
    Ui::disclosure ("D", true, Load, [dot 9]),
]

// [UI-SCENE-STREAM]: every container is walked in the encoder's order.
(** a split streams scenes from every container in the encoder's order. *)
sceneCaseASplitStreamsScenesFromEveryContainer () =
    walked = walkStreamed (everyContainer ())
    expect (length walked.nodes, 1)
    expect (contains streamedTrace "1@1;1@2;1@3;1@4;1@5;1@6;1@7;1@8;1@9;", true)

// [UI-SCENE-STREAM]
(** primitives that do not stream read back zero fields. *)
sceneCasePrimitivesThatDoNotStreamReadBack () =
    strip = Scenes::strip ([0.0, 0.0, 1.0, 1.0], 9, 1.0, 4)
    expect ("${valuesOf (strip, 1)} ${tailFields strip}", "0.0 0 0 0")
    expect (Streams::streamed strip, false)

// [UI-RESIDENT]: completions, phases and frames reach `update` in a resident session.
(** a resident session delivers completions, phases and frames and refuses malformed text. *)
sceneCaseAResidentSessionDeliversCompletionsPhasesAnd () =
    first = begun ()
    done = proceeded (first.residentSession, "{\"kind\":\"completed\",\"ticket\":\"load:1\",\"ok\":true,\"result\":\"saved\",\"now\":7}")
    expect (memoOf done, "saved")
    phased = proceeded (done.residentSession, "{\"kind\":\"lifecycle\",\"phase\":\"active\",\"now\":8}")
    expect (problemsOf phased, "")
    framed = proceeded (phased.residentSession, "{\"kind\":\"frame\",\"now\":9,\"elapsed\":0.5}")
    expect (framed.residentSession.sessionContext.now, 9)
    broken = proceeded (framed.residentSession, "not json")
    expect (contains (problemsOf broken) "not JSON", true)
    expect (memoOf broken, "saved")

// [UI-RESIDENT]
(** an idle session holds only its store. *)
sceneCaseAnIdleSessionHoldsOnlyItsStore () =
    held = Runtime::idle 3
    expect ("${held.sessionStore} ${length held.sessionFrames} ${held.sessionContext.now}", "3 0 0")
routed : ui::Message<Act> -> string
routed message = Messages::route (message, \_ => "tap", \(_, text) => "text ${text}", \(_, on) => "flag ${on}", \(_, width) => "size ${width}", \(ticket, _) => "done ${ticket}", \phase => "phase ${phase}", \(_, _) => "stroke", \(_, _) => "lasso", \_ => "frame", \(_, _) => "input")
boundAs (binding, value) = match Events::bind (binding, value)
    Success delivered => routed delivered
    Error problem => problem

// [UI-EVENTS]
(** toggles and pickers deliver their own value kinds and refuse others. *)
sceneCaseTogglesAndPickersDeliverTheirOwnValue () =
    checked ([{ binding = ui::FlagInput(action = Typed), value = JsonBool true, want = "flag true" }, { binding = ui::FlagInput(action = Typed), value = JsonString "on", want = "A toggle control sent a value of the wrong kind" }, { binding = ui::ChoiceInput(action = Load), value = JsonString "b", want = "text b" }, { binding = ui::ChoiceInput(action = Load), value = JsonInt 1, want = "A choice control sent a value of the wrong kind" }], \probe => expect (boundAs (probe.binding, probe.value), probe.want))
    expect (routed (ui::Phase(phase = "active")), "phase active")

// [UI-COMPONENTS]
(** progress, swatches, alerts, prominent buttons and leading asides encode. *)
sceneCaseProgressSwatchesAlertsProminentButtonsAndLeading () =
    parts = partsOf (Ui::column [ui::Progress(label = "P", detail = "d"), ui::Swatch(name = "S", light = "#fff", dark = "#000"), ui::Alert(title = "A", message = "m", visible = true, dismiss = Load), Ui::action ("Go", "play", ui::Prominent, true, Increment), Ui::aside (Ui::text "p", ui::Leading, Ui::text "c", 300, Typed)])
    expect (joined (parts, \part => Doc::text (part, "kind")), "progress,swatch,alert,button,aside")
    forEachList ([{ at = 3, name = "role", want = "prominent" }, { at = 4, name = "side", want = "leading" }], \one => expect (fieldAt (parts, one.at, one.name), one.want))
// Pinned to the suite's action union: the encoder is instantiated at one action type (#278).
meterAt (amount, total) =
    walked = Encode::walk ([], Ui::column [Ui::meter ("Used", amount, total, ui::Caution), Ui::button ("Go", "play", Increment)])
    jsonEncode (listGet (itemsOf (listGet walked.nodes 0 ?: JsonNull, "children")) 0 ?: JsonNull) ?: "encode failed"

// [UI-COMPONENTS-METER]
(** a meter sends its amount clamped into a total of at least one. *)
sceneCaseAMeterSendsItsAmountClampedInto () =
    checked ([{ amount = 30, total = 120, want = "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":30,\"total\":120,\"tone\":\"caution\"}" }, { amount = 500, total = 120, want = "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":120,\"total\":120,\"tone\":\"caution\"}" }, { amount = 0 - 4, total = 120, want = "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":0,\"total\":120,\"tone\":\"caution\"}" }, { amount = 3, total = 0, want = "{\"kind\":\"meter\",\"label\":\"Used\",\"value\":1,\"total\":1,\"tone\":\"caution\"}" }], \probe => expect (meterAt (probe.amount, probe.total), probe.want))