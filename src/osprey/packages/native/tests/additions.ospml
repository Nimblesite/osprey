        expect ((lookOf (innerOf (itemOf (list, 0)))).points, 28.0)
        expect (textOf (itemOf (list, 1)), "Nothing here")
        expect ((lookOf (itemOf (list, 1))).points, 20.0)
        expect ((lookOf (itemOf (list, 1))).heft, 600)
        expect (textOf (itemOf (list, 2)), "Add something first")
        expect ((lookOf (itemOf (list, 2))).ink, 1146447615)
