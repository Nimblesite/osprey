        first = itemOf (segments, 0)
        expect ((fitOf first).share, 1.0)
        expect ((fitOf first).tall, 4.0)
        expect ((lookOf (innerOf first)).fill, 305420031)
        expect ((lookOf (innerOf (itemOf (segments, 1)))).fill, 3424789247)
