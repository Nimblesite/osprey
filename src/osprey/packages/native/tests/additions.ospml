        expect ((lookOf (innerOf (itemOf (nightSwatch, 0)))).fill, 4025479167)

    (** [NATIVE-SHM-LOWER] Media, editors, boards and scenes lower fitted and bind in the JSON encoder's order. *)
    export lowerMediaCase () =
        image = Lower::view (styled false, ui::Image(imageSource = "a.png", imageAlt = "A map", imageWidth = 320, imageHeight = 200))
        expect (kindOf image, "fitted")
        expect ((fitOf image).wide, 320.0)
        expect ((fitOf image).tall, 200.0)
        expect ((fitOf image).hint, "A map")
        expect (textOf (innerOf image), "a.png")
        video = Lower::view (styled false, ui::Video(videoSource = "v.mp4", videoPoster = "p.png", videoCaptions = "", videoAlt = "A talk", videoSeconds = 90))
        expect ((fitOf video).hint, "A talk")
        expect (textOf (innerOf video), "p.png")
        spoken = Lower::view (styled false, ui::Typeset(math = ui::Sym "x", spoken = "x equals two"))
        expect (kindOf spoken, "wording")
        expect (textOf spoken, "x equals two")
        expect ((lookOf spoken).points, 13.0)
        editor = Lower::view (styled false, Editors::editor ("Proof", "one", 3, [], Typed, Load))
        expect (kindOf editor, "fitted")
        expect ((fitOf editor).hint, "Proof")
        stack = innerOf editor
        expect (kindOf stack, "layered")
        expect (countOf stack, 2)
        writing = itemOf (stack, 0)
        expect (kindOf writing, "writing")
        expect (textOf writing, "one")
        expect (structuralEquals (typingAction writing) (ui::TextInput(action = Typed)), true)
        caret = itemOf (stack, 1)
        expect (kindOf caret, "canvas")
        expect (structuralEquals (canvasAction caret) (ui::PlaceInput(action = Load)), true)
        board = Lower::view (styled false, Boards::interactive ("board", 2, true, "background", true, Increment, Typed, Load))
        expect (kindOf board, "layered")
        expect (countOf board, 3)
        expect ((lookOf board).fill, 4042322175)
        expect ((lookOf board).ink, 573785343)
        expect (structuralEquals (canvasAction (itemOf (board, 0))) (ui::StrokeInput(action = Increment)), true)
        expect (structuralEquals (canvasAction (itemOf (board, 1))) (ui::LassoInput(action = Typed)), true)
        expect (structuralEquals (canvasAction (itemOf (board, 2))) (ui::TextInput(action = Load)), true)
        still = Lower::view (styled false, Boards::board ("board", 2, true, Increment, Typed))
        expect (countOf still, 2)
        zoomed = Lower::view (styled false, Ui::zoomed (2.0, 100.0, 50.0, [], [], Typed))
        expect (kindOf zoomed, "fitted")
        expect ((fitOf zoomed).wide, 200.0)
        expect ((fitOf zoomed).tall, 100.0)
        expect (structuralEquals (canvasAction (innerOf zoomed)) (ui::SceneInput(action = Typed)), true)
        fitted = Lower::view (styled false, Ui::zoomed (0.0, 100.0, 50.0, [], [], Typed))
        expect ((fitOf fitted).share, 1.0)
        expect ((fitOf fitted).wide, 0.0)
