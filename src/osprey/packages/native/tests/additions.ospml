    (** [NATIVE-SHM-LOWER] Frames lower with their authored size, surface and line; scoped themes re-ink their subtree. *)
    export lowerFramesCase () =
        base = ui::Frames::plain
        style = base(frameWidth = 430, frameHeight = 240, frameTop = 14, frameRadius = 12, frameGap = 6, frameFill = "background", frameLine = "secondary", frameGrow = true, frameFont = "mono", frameTextSize = 20)
        framed = Lower::view (styled true, Ui::framed (style, Ui::text "Inner"))
        expect (kindOf framed, "fitted")
        expect ((fitOf framed).wide, 430.0)
        expect ((fitOf framed).tall, 240.0)
        expect ((fitOf framed).share, 1.0)
        expect ((fitOf framed).traits, Views::fixedWidth)
        expect ((fitOf framed).edge, 2578103295)
        card = innerOf framed
        expect (kindOf card, "column")
        expect ((lookOf card).fill, 269488383)
        expect ((lookOf card).corner, 12.0)
        expect ((lookOf card).gap, 6.0)
        expect ((lookOf card).inset, 14.0)
        expect ((lookOf card).points, 20.0)
        expect (countOf card, 1)
        local = ui::Theme(tokens = [ui::Token(tokenName = "text", tokenLight = "#000000", tokenDark = "#FFFFFF")], spacing = [4, 10, 16], feedback = 140, settle = 240)
        scoped = Lower::view (styled true, Ui::themed (local, Ui::text "Scoped"))
        expect (kindOf scoped, "wording")
        expect (textOf scoped, "Scoped")
        expect ((lookOf scoped).ink, 4294967295)

    (** [NATIVE-SHM-LOWER] Dialogs and alerts lower to sheets that dismiss with a tap; menus show their body first. *)
    export lowerOverlaysCase () =
        dialog = Lower::view (styled false, Ui::dialog ("Review", Ui::button ("Insert", "", Increment), Load))
        expect (kindOf dialog, "sheet")
        expect ((lookOf dialog).fill, 4042322175)
        expect ((lookOf dialog).corner, 12.0)
        expect ((lookOf dialog).inset, 16.0)
        expect (countOf dialog, 2)
        expect (structuralEquals (sheetDismissOf dialog) (ui::Tap(action = Load)), true)
        expect (textOf (itemOf (dialog, 0)), "Review")
        expect ((lookOf (itemOf (dialog, 0))).points, 20.0)
        insert = itemOf (dialog, 1)
        expect (kindOf insert, "fitted")
        expect (textOf (innerOf insert), "Insert")
        expect (structuralEquals (pressAction (innerOf insert)) (ui::Tap(action = Increment)), true)
        shown = Lower::view (styled false, ui::Alert(title = "Empty", message = "Nothing left", visible = true, dismiss = Typed))
        expect (countOf shown, 2)
        expect (structuralEquals (sheetDismissOf shown) (ui::Tap(action = Typed)), true)
        hidden = Lower::view (styled false, ui::Alert(title = "Empty", message = "Nothing left", visible = false, dismiss = Typed))
        expect (countOf hidden, 0)
        expect (structuralEquals (sheetDismissOf hidden) (ui::Tap(action = Typed)), true)
        menu = Lower::view (styled false, Ui::contextMenu (Ui::text "Body", [Ui::button ("Copy", "", Increment)]))
        expect (kindOf menu, "menu")
        expect (countOf menu, 2)
        expect (textOf (itemOf (menu, 0)), "Body")

    (** [NATIVE-SHM-LOWER] Asides order by side, fix their column's width and drag through a size input on a rule. *)
    export lowerAsideCase () =
        trailing = Lower::view (styled false, Ui::aside (Ui::text "Pane", ui::Trailing, Ui::text "Column", 420, Typed))
        expect (kindOf trailing, "across")
        expect (countOf trailing, 3)
        expect ((fitOf (itemOf (trailing, 0))).share, 1.0)
        splitter = itemOf (trailing, 1)
        expect ((fitOf splitter).wide, 6.0)
        rule = itemOf (innerOf splitter, 0)
        expect (kindOf rule, "rule")
        expect ((lookOf rule).points, 1.0)
        drag = itemOf (innerOf splitter, 1)
        expect (kindOf drag, "canvas")
        expect (structuralEquals (canvasAction drag) (ui::SizeInput(action = Typed)), true)
        expect ((fitOf (itemOf (trailing, 2))).wide, 420.0)
        expect (textOf (innerOf (itemOf (trailing, 2))), "Column")
        leading = Lower::view (styled false, Ui::aside (Ui::text "Pane", ui::Leading, Ui::text "Column", 300, Typed))
        expect ((fitOf (itemOf (leading, 0))).wide, 300.0)
        expect (textOf (innerOf (itemOf (leading, 0))), "Column")

    (** [NATIVE-SHM-LOWER] Tabs lower to presses that deliver choices; the chosen tab is filled, heavier and shows its page. *)
    tabsSample () = [Ui::tab ("one", "First", "star", Ui::text "Page one"), Ui::tab ("two", "Second", "", Ui::button ("Go", "", Increment))]

    (** [NATIVE-SHM-LOWER] Tabs lower to presses that deliver choices; the chosen tab is filled, heavier and shows its page. *)
    export lowerTabsCase () =
        lowered = Lower::view (styled false, ui::Tabs(tabs = tabsSample (), selected = "two", bind = Typed))
        expect (kindOf lowered, "column")
        expect (countOf lowered, 2)
        bar = itemOf (lowered, 0)
        expect (kindOf bar, "across")
        expect (countOf bar, 2)
        first = itemOf (bar, 0)
        expect ((fitOf first).hint, "one")
        expect ((fitOf first).traits, 0)
        expect (textOf (innerOf first), "star First")
        expect ((lookOf (innerOf first)).fill, 0)
        expect ((lookOf (innerOf first)).heft, 400)
        expect (structuralEquals (pressAction (innerOf first)) (ui::ChoiceInput(action = Typed)), true)
        chosen = itemOf (bar, 1)
        expect ((fitOf chosen).hint, "two")
        expect ((fitOf chosen).traits, Views::chosen)
        expect (textOf (innerOf chosen), "Second")
        expect ((lookOf (innerOf chosen)).heft, 600)
        expect ((lookOf (innerOf chosen)).fill, 439041050)
        expect (structuralEquals (pressAction (innerOf chosen)) (ui::ChoiceInput(action = Typed)), true)
        page = itemOf (lowered, 1)
        expect (kindOf page, "fitted")
        expect (textOf (innerOf page), "Go")
        unknown = Lower::view (styled false, ui::Tabs(tabs = tabsSample (), selected = "nine", bind = Typed))
        expect (countOf unknown, 1)

    (** [NATIVE-SHM-LOWER] Rows lower to presses that deliver choices; groups gain headings and the selected row is washed. *)
    rowsSample () = [Ui::entry ("a", "star", "Recent", Ui::text "Alpha"), Ui::entry ("b", "", "Recent", Ui::text "Beta"), Ui::item ("c", Ui::text "Gamma")]

    (** [NATIVE-SHM-LOWER] Rows lower to presses that deliver choices; groups gain headings and the selected row is washed. *)
    export lowerRowsCase () =
        lowered = Lower::view (styled true, ui::Rows(rows = rowsSample (), selected = "b", bind = Load))
        expect (kindOf lowered, "column")
        expect ((lookOf lowered).gap, 2.0)
        expect (countOf lowered, 4)
        expect (textOf (itemOf (lowered, 0)), "Recent")
        expect ((lookOf (itemOf (lowered, 0))).heft, 600)
        first = itemOf (lowered, 1)
        expect ((fitOf first).hint, "a")
        expect ((fitOf first).traits, 0)
        stack = innerOf first
        expect (kindOf stack, "layered")
        expect (countOf stack, 2)
        cell = itemOf (stack, 0)
        expect (kindOf cell, "across")
        expect (countOf cell, 2)
        expect (textOf (itemOf (cell, 0)), "star")
        expect ((lookOf (itemOf (cell, 0))).points, 12.0)
        rest = itemOf (stack, 1)
        expect (kindOf rest, "press")
        expect ((lookOf rest).fill, 0)
        expect (structuralEquals (pressAction rest) (ui::ChoiceInput(action = Load)), true)
        picked = itemOf (lowered, 2)
        expect ((fitOf picked).traits, Views::chosen)
        pickedPress = itemOf (innerOf picked, 1)
        expect ((lookOf pickedPress).fill, 3386435354)
        expect (structuralEquals (pressAction pickedPress) (ui::ChoiceInput(action = Load)), true)
        last = itemOf (lowered, 3)
        expect ((fitOf last).hint, "c")
        expect (textOf (itemOf (innerOf last, 0)), "Gamma")

    (** [NATIVE-SHM-LOWER] Slots lower the region they name; an unknown key lowers to an empty column. *)
    export lowerSlotCase () =
        region = Keyed::region ([], "side", [], \() => Ui::styled ("Region text", ui::Title, ui::Good))
        light = styled false
        withRegions = light(styleRegions = [region])
        filled = Lower::view (withRegions, Ui::slot "side")
        expect (kindOf filled, "wording")
        expect (textOf filled, "Region text")
        expect ((lookOf filled).points, 20.0)
        expect ((lookOf filled).ink, 305420031)
        missing = Lower::view (withRegions, Ui::slot "missing")
        expect (kindOf missing, "column")
        expect (countOf missing, 0)

    (** [NATIVE-SHM-LOWER] Buttons take their role's ink and fill, keep the host's metrics and disable through their fit. *)
    export lowerButtonsCase () =
        prominent = Lower::view (styled false, Ui::action ("Bake", "play", ui::Prominent, true, Increment))
        expect (kindOf prominent, "fitted")
        expect ((fitOf prominent).tall, 28.0)
        expect ((fitOf prominent).traits, 0)
        expect (textOf (innerOf prominent), "play Bake")
        expect ((lookOf (innerOf prominent)).ink, 4294967295)
        expect ((lookOf (innerOf prominent)).fill, 6728447)
        expect ((lookOf (innerOf prominent)).inset, 12.0)
        expect ((lookOf (innerOf prominent)).corner, 8.0)
        expect ((lookOf (innerOf prominent)).points, 13.0)
        expect (structuralEquals (pressAction (innerOf prominent)) (ui::Tap(action = Increment)), true)
        dark = Lower::view (styled true, Ui::action ("Bake", "play", ui::Prominent, true, Increment))
        expect ((lookOf (innerOf dark)).ink, 2241535)
        expect ((lookOf (innerOf dark)).fill, 1724710911)
        plain = Lower::view (styled false, Ui::button ("Keep", "", Increment))
        expect ((lookOf (innerOf plain)).ink, 439041279)
        expect ((lookOf (innerOf plain)).fill, 439041042)
        destructive = Lower::view (styled false, Ui::action ("Remove", "", ui::Destructive, true, Load))
        expect ((lookOf (innerOf destructive)).ink, 3424789247)
        expect ((lookOf (innerOf destructive)).fill, 439041042)
        disabled = Lower::view (styled false, Ui::action ("Stop", "", ui::Plain, false, Load))
        expect ((fitOf disabled).traits, Views::disabled)
        expect (textOf (innerOf disabled), "Stop")
        expect ((lookOf (innerOf disabled)).heft, 400)

    (** [NATIVE-SHM-LOWER] Fields lower to typing or writing with prompt hints, secret and submit traits and their label above. *)
    export lowerFieldsCase () =
        field = Lower::view (styled false, ui::Field(label = "Name", value = "Ada", prompt = "Your name", secure = true, multiline = false, commit = ui::OnSubmit, bind = Typed))
        expect (kindOf field, "column")
        expect ((lookOf field).gap, 4.0)
        expect (countOf field, 2)
        expect (textOf (itemOf (field, 0)), "Name")
        expect ((lookOf (itemOf (field, 0))).points, 11.0)
        expect ((lookOf (itemOf (field, 0))).ink, 1146447615)
        entry = itemOf (field, 1)
        expect ((fitOf entry).hint, "Your name")
        expect ((fitOf entry).traits, 68)
        expect (kindOf (innerOf entry), "typing")
        expect (textOf (innerOf entry), "Ada")
        expect ((lookOf (innerOf entry)).points, 13.0)
        expect ((lookOf (innerOf entry)).corner, 6.0)
        expect (structuralEquals (typingAction (innerOf entry)) (ui::TextInput(action = Typed)), true)
        notes = Lower::view (styled false, Ui::multiline ("Notes", "Two lines", "Add", Typed))
        expect (kindOf notes, "fitted")
        expect ((fitOf notes).traits, 0)
        expect ((fitOf notes).hint, "Add")
        expect (kindOf (innerOf notes), "writing")
        expect (textOf (innerOf notes), "Two lines")
        expect (structuralEquals (typingAction (innerOf notes)) (ui::TextInput(action = Typed)), true)
        toggle = Lower::view (styled false, Ui::toggle ("Nightly", true, Load))
        expect (kindOf toggle, "switch")
        expect (switchWordsOf toggle, "Nightly")
        expect (switchOnOf toggle, true)
        expect ((lookOf toggle).points, 13.0)
        expect (structuralEquals (switchFlagOf toggle) (ui::FlagInput(action = Load)), true)

    (** [NATIVE-SHM-LOWER] Pickers choose through options; disclosures deliver their flag and reveal their children when open. *)
    export lowerPickersCase () =
        choices = [Ui::choice ("a", "Alpha"), Ui::choice ("b", "Beta")]
        picker = Lower::view (styled false, ui::Picker(label = "Sort", choices = choices, selected = "b", bind = Load))
        expect (kindOf picker, "fitted")
        expect ((fitOf picker).hint, "Sort")
        menu = innerOf picker
        expect (kindOf menu, "choosing")
        expect (textOf menu, "Beta")
        expect ((lookOf menu).ink, 1146447615)
        expect (countOf menu, 2)
        expect (structuralEquals (choosingAction menu) (ui::ChoiceInput(action = Load)), true)
        beta = itemOf (menu, 1)
        expect (kindOf beta, "option")
        expect (textOf beta, "Beta")
        expect (optionKeyOf beta, "b")
        expect (optionChosenOf beta, true)
        expect ((lookOf beta).points, 13.0)
        alpha = itemOf (menu, 0)
        expect (optionKeyOf alpha, "a")
        expect (optionChosenOf alpha, false)
        closed = Lower::view (styled false, Ui::disclosure ("Limits", false, Load, [Ui::text "Scope"]))
        expect (kindOf closed, "column")
        expect (countOf closed, 1)
        title = innerOf (itemOf (closed, 0))
        expect (textOf title, "Limits")
        expect ((lookOf title).ink, 1146447615)
        expect (structuralEquals (pressAction title) (ui::FlagInput(action = Load)), true)
        open = Lower::view (styled false, Ui::disclosure ("Limits", true, Load, [Ui::text "Scope"]))
        expect (countOf open, 2)
        expect (textOf (itemOf (open, 1)), "Scope")

    (** [NATIVE-SHM-LOWER] Pairs, badges, labels, icons, links, spacers and dividers lower as quiet leaves with concrete colour. *)
