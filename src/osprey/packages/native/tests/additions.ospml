        expect ((lookOf pickedPress).fill, 3386435354)
        expect (structuralEquals (pressAction pickedPress) (ui::ChoiceInput(action = Load)), true)
        last = itemOf (lowered, 3)
        expect ((fitOf last).hint, "c")
        expect (textOf (itemOf (innerOf last, 0)), "Gamma")

    (** [NATIVE-SHM-LOWER] Slots lower the region they name; an unknown key lowers to an empty column. *)
    export lowerSlotCase () =
        region = Keyed::region ([], "side", [], \() => Ui::styled ("Region text", ui::Title, ui::Good))
        light = styled false
        withRegions = light(styleRegions = [region])
        filled = Lower::view (withRegions, Ui::slot "side")
        expect (kindOf filled, "wording")
        expect (textOf filled, "Region text")
        expect ((lookOf filled).points, 20.0)
        expect ((lookOf filled).ink, 305420031)
        missing = Lower::view (withRegions, Ui::slot "missing")
        expect (kindOf missing, "column")
        expect (countOf missing, 0)

    (** [NATIVE-SHM-LOWER] Buttons take their role's ink and fill, keep the host's metrics and disable through their fit. *)
    export lowerButtonsCase () =
        prominent = Lower::view (styled false, Ui::action ("Bake", "play", ui::Prominent, true, Increment))
        expect (kindOf prominent, "fitted")
        expect ((fitOf prominent).tall, 28.0)
        expect ((fitOf prominent).traits, 0)
        expect (textOf (innerOf prominent), "Bake")
        expect ((fitOf prominent).hint, "play")
        expect ((lookOf (innerOf prominent)).ink, 4294967295)
        expect ((lookOf (innerOf prominent)).fill, 6728447)
        expect ((lookOf (innerOf prominent)).inset, 12.0)
        expect ((lookOf (innerOf prominent)).corner, 8.0)
        expect ((lookOf (innerOf prominent)).points, 13.0)
        expect (structuralEquals (pressAction (innerOf prominent)) (ui::Tap(action = Increment)), true)
        dark = Lower::view (styled true, Ui::action ("Bake", "play", ui::Prominent, true, Increment))
        expect ((lookOf (innerOf dark)).ink, 2241535)
        expect ((lookOf (innerOf dark)).fill, 1724710911)
        plain = Lower::view (styled false, Ui::button ("Keep", "", Increment))
        expect ((lookOf (innerOf plain)).ink, 439041279)
        expect ((lookOf (innerOf plain)).fill, 439041042)
        destructive = Lower::view (styled false, Ui::action ("Remove", "", ui::Destructive, true, Load))
        expect ((lookOf (innerOf destructive)).ink, 3424789247)
        expect ((lookOf (innerOf destructive)).fill, 439041042)
        disabled = Lower::view (styled false, Ui::action ("Stop", "", ui::Plain, false, Load))
        expect ((fitOf disabled).traits, Views::disabled)
        expect (textOf (innerOf disabled), "Stop")
        expect ((lookOf (innerOf disabled)).heft, 400)

    (** [NATIVE-SHM-LOWER] Fields lower to typing or writing with prompt hints, secret and submit traits and their label above. *)
    export lowerFieldsCase () =
        field = Lower::view (styled false, ui::Field(label = "Name", value = "Ada", prompt = "Your name", secure = true, multiline = false, commit = ui::OnSubmit, bind = Typed))
        expect (kindOf field, "column")
        expect ((lookOf field).gap, 4.0)
        expect (countOf field, 2)
        expect (textOf (itemOf (field, 0)), "Name")
        expect ((lookOf (itemOf (field, 0))).points, 11.0)
        expect ((lookOf (itemOf (field, 0))).ink, 1146447615)
        entry = itemOf (field, 1)
        expect ((fitOf entry).hint, "Your name")
        expect ((fitOf entry).traits, 68)
        expect (kindOf (innerOf entry), "typing")
        expect (textOf (innerOf entry), "Ada")
        expect ((lookOf (innerOf entry)).points, 13.0)
        expect ((lookOf (innerOf entry)).corner, 6.0)
        expect (structuralEquals (typingAction (innerOf entry)) (ui::TextInput(action = Typed)), true)
        notes = Lower::view (styled false, Ui::multiline ("Notes", "Two lines", "Add", Typed))
        expect (kindOf notes, "fitted")
        expect ((fitOf notes).traits, 0)
        expect ((fitOf notes).hint, "Add")
        expect (kindOf (innerOf notes), "writing")
        expect (textOf (innerOf notes), "Two lines")
        expect (structuralEquals (typingAction (innerOf notes)) (ui::TextInput(action = Typed)), true)
        toggle = Lower::view (styled false, Ui::toggle ("Nightly", true, Load))
        expect (kindOf toggle, "switch")
        expect (switchWordsOf toggle, "Nightly")
        expect (switchOnOf toggle, true)
        expect ((lookOf toggle).points, 13.0)
        expect (structuralEquals (switchFlagOf toggle) (ui::FlagInput(action = Load)), true)

    (** [NATIVE-SHM-LOWER] Pickers choose through options; disclosures deliver their flag and reveal their children when open. *)
    export lowerPickersCase () =
        choices = [Ui::choice ("a", "Alpha"), Ui::choice ("b", "Beta")]
        picker = Lower::view (styled false, ui::Picker(label = "Sort", choices = choices, selected = "b", bind = Load))
        expect (kindOf picker, "fitted")
        expect ((fitOf picker).hint, "Sort")
        menu = innerOf picker
        expect (kindOf menu, "choosing")
        expect (textOf menu, "Beta")
        expect ((lookOf menu).ink, 1146447615)
        expect (countOf menu, 2)
        expect (structuralEquals (choosingAction menu) (ui::ChoiceInput(action = Load)), true)
        beta = itemOf (menu, 1)
        expect (kindOf beta, "option")
        expect (textOf beta, "Beta")
        expect (optionKeyOf beta, "b")
        expect (optionChosenOf beta, true)
        expect ((lookOf beta).points, 13.0)
        alpha = itemOf (menu, 0)
        expect (optionKeyOf alpha, "a")
        expect (optionChosenOf alpha, false)
        closed = Lower::view (styled false, Ui::disclosure ("Limits", false, Load, [Ui::text "Scope"]))
        expect (kindOf closed, "column")
        expect (countOf closed, 1)
        title = innerOf (itemOf (closed, 0))
        expect (textOf title, "Limits")
        expect ((lookOf title).ink, 1146447615)
        expect (structuralEquals (pressAction title) (ui::FlagInput(action = Load)), true)
        open = Lower::view (styled false, Ui::disclosure ("Limits", true, Load, [Ui::text "Scope"]))
        expect (countOf open, 2)
        expect (textOf (itemOf (open, 1)), "Scope")

    (** [NATIVE-SHM-LOWER] Pairs, badges, labels, icons, links, spacers and dividers lower as quiet leaves with concrete colour. *)
