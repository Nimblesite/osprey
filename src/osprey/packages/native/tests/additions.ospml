        expect (countOf split, 2)
        expect ((fitOf (itemOf (split, 1))).share, 1.0)
        layered = Lower::view (styled false, Ui::layer [Ui::text "Back", Ui::text "Front"])
        expect (kindOf layered, "layered")
        expect (countOf layered, 2)

    (** [NATIVE-SHM-LOWER] Sections card on the background token; screens stack a titled toolbar over scrolling children. *)
