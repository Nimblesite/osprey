        expect ((lookOf (itemOf (section, 0))).ink, 1146447615)
        expect (textOf (itemOf (section, 2)), "Feeds four")
        expect ((lookOf (itemOf (section, 2))).ink, 1146447615)
        screen = Lower::view (styled false, Ui::screen ("Kitchen", "Spring", [Ui::button ("Bake", "", Increment)], [Ui::text "Steps"]))
