        expect ((lookOf (innerOf filled)).corner, 999.0)
        track = itemOf (bars, 1)
        expect ((fitOf track).share, 1.0)
        expect ((lookOf (innerOf track)).fill, 6728233)
        swatch = Lower::view (styled false, ui::Swatch(name = "Ink", light = "#101010", dark = "#EFEFEF"))
        expect (kindOf swatch, "across")
        expect (countOf swatch, 2)
