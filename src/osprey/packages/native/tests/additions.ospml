        expect (textOf (itemOf (list, 0)), "tray")
        expect ((lookOf (itemOf (list, 0))).points, 28.0)
        expect (textOf (itemOf (list, 1)), "Nothing here")
        expect ((lookOf (itemOf (list, 1))).points, 20.0)
        expect ((lookOf (itemOf (list, 1))).heft, 600)
        expect (textOf (itemOf (list, 2)), "Add something first")
        expect ((lookOf (itemOf (list, 2))).ink, 1146447615)
        progress = Lower::view (styled false, ui::Progress(label = "Loading", detail = "3 of 9"))
        expect (kindOf progress, "column")
        expect (countOf progress, 2)
        expect (textOf (itemOf (progress, 1)), "3 of 9")
        expect ((lookOf (itemOf (progress, 1))).points, 12.0)
        meter = Lower::view (styled false, Ui::meter ("Disk", 3, 4, ui::Accent))
        expect (countOf meter, 2)
        expect (textOf (itemOf (meter, 0)), "Disk")
        expect ((lookOf (itemOf (meter, 0))).ink, 1146447615)
