// Machine documents end to end: load the typed document once, then drive its
// canvas through accessibility, pointer and native-control use cases, reading
// the view rows and scene rows a host is sent.
namespace uitests

import ui::Canvases
import ui::Doc
import ui::Lists
import ui::MachineDocs
import ui::Machines
import ui::Runtime
import ui::Tell
import ui::Tellings
import ui::Templates
import ui::Values


type NativePoint =
    nativeX : float
    nativeY : float

nativeLoaded work = match MachineDocs::load (readFile "src/osprey/packages/native/tests/fixture.machine.json" ?: "")
    Success machine => work machine
    Error problem => expect ("fixture loads: ${problem}", "fixture loads")

withNativeFixture work = Runtime::guarded (\() => nativeLoaded work)

// A Fire-acted node drawn as the rows of one root region. Monomorphic at the machine's action union: the telling walk is instantiated at one action type (Nimblesite/osprey#278).
fireDrawn : ui::Node<ui::Lever> -> ui::Walk<ui::Binding<ui::Lever>>
fireDrawn node = Tellings::alone node

// A Fire-acted node's one told record, as Tell walks it.
fireTold : ui::Node<ui::Lever> -> ui::Told
fireTold node = Tell::first (Tell::walk ([], node))

// The machine's view told as one root region's rows: the rows, fits, scenes and bindings a host reads ([NATIVE-SHM-NODES]).
nativeTree machine = fireDrawn (Templates::view machine)

// A machine renders rows in its chosen skin and reports no fault.
expectRendered machine =
    expect (length (nativeTree machine).walkRows > 0, true)
    expect (machine.machineFault, "")

nativeLabels machine = join (mapList (Canvases::semantics machine, \e => e.accessLabel)) "|"

nativeElement (machine, label) = match Lists::find (Canvases::semantics machine, nativeLabelled label)
    Success element => element
    Error _ => ui::Accessible(accessRole = ui::Unannounced, accessLabel = "", accessLeft = 0.0, accessTop = 0.0, accessWidth = 0.0, accessHeight = 0.0, accessValue = 0.0, accessMin = 0.0, accessMax = 0.0, accessSelected = false, accessMovable = false)

// Whether `e` is the element announcing `label`.
nativeLabelled label = \e => e.accessLabel == label

nativeOffered (machine, label) = Lists::any (Canvases::semantics machine, nativeLabelled label)

nativeRole (machine, label) = Canvases::roleName (nativeElement (machine, label)).accessRole

nativeValue (machine, label) = (nativeElement (machine, label)).accessValue

// Whether a listener is announced as the current choice of the input its lever sets.
nativeSelected (machine, label) = (nativeElement (machine, label)).accessSelected

nativePoint (element, fraction) = NativePoint(nativeX = element.accessLeft + element.accessWidth * fraction, nativeY = element.accessTop + element.accessHeight / 2.0)

nativeReleaseAt (machine, label, fraction) =
    point = nativePoint (nativeElement (machine, label), fraction)
    released = Canvases::released (machine, point.nativeX, point.nativeY)
    expect (nativeValue (released, label), fraction)
    released

// Whether the view shows `text`: as any told row's words — a label, text, title, prompt, symbol or key.
nativeShows (machine, text) =
    walked = nativeTree machine
    Lists::any (walked.walkRows, \row => row.placedWords == text)

// The label of the choice `selected` names among `choices`, or "".
chosenStep (selected, found, item) = match memberText (insideTold item, "key") == selected
    true => memberText (insideTold item, "label")
    false => found

chosenLabel (choices, selected) = foldList (choices, "", \(found, item) => chosenStep (selected, found, item))

// The words of the view's first picker: the label of the option its selected key names.
nativeChosen machine = match Lists::find (controlsOf (fireTold (Templates::view machine)), \told => memberText (insideTold told, "kind") == "picker")
    Success picker => chosenLabel (memberItems (insideTold picker, "choices"), memberText (insideTold picker, "selected"))
    Error _ => ""

// The text of a lettering or glyphs shape.
shapeText shape = match shape
    ui::Lettering text _ _ _ _ _ _ _ => text
    ui::Glyphs text _ _ _ _ _ => text
    _ => ""

// Whether a shape letters or glyphs text.
shapeLetters shape = match shape
    ui::Lettering _ _ _ _ _ _ _ _ => true
    ui::Glyphs _ _ _ _ _ => true
    _ => false

// The texts the machine's scenes letter, in drawing order.
nativeLettered machine = Lists::flatten (mapList ((nativeTree machine).walkSketches, \drawn => mapList (filterList (drawn.sketchedAs.sketchShapes, shapeLetters), shapeText)))

// Whether the machine's scenes letter `text`.
nativeLetters (machine, text) = Lists::any (nativeLettered machine, \lettered => lettered == text)

// The machine's scenes: their sizes, shapes and accessibility trees, in drawing order.
nativeScenes machine = mapList ((nativeTree machine).walkSketches, \drawn => drawn.sketchedAs)

nativeFeed (machine, name, text) = Machines::feed (machine, [Machines::fact (name, Values::text text)])

nativeLever binding = match binding
    ui::Tap lever => lever
    ui::TextInput lever => lever
    ui::FlagInput lever => lever
    ui::ChoiceInput lever => lever
    _ => ui::Fire(fireName = "")

// The lever bound to `walked`'s `index`th control.
nativeBound (walked, index) = nativeLever (listGet walked.walkBound index ?: ui::Tap(action = ui::Fire(fireName = "")))

// The state after `act` sets `label`'s slider to `fraction`, checked to read back as that fraction.
slidTo (machine, label, fraction) =
    slid = Canvases::act (machine, label, fraction)
    expect (nativeValue (slid, label), fraction)
    slid

machineCaseCanvasUseCase () = withNativeFixture (\fresh =>
    expect (nativeLabels fresh, "Menu|Press|Level")
    expectVia (nativeOffered, fresh, [{ name = "Menu", value = true }, { name = "Dismiss", value = false }])
    expectRead (\name => nativeRole (fresh, name), [{ name = "Menu", value = "popup" }, { name = "Press", value = "button" }, { name = "Level", value = "slider" }, { name = "Missing", value = "none" }])
    expect (nativeValue (fresh, "Level"), 0.25)
    expectVia (nativeLetters, fresh, [{ name = "Hello", value = true }])
    slider = nativeElement (fresh, "Level")
    start = nativePoint (slider, 0.0)
    middle = nativePoint (slider, 0.5)
    end = nativePoint (slider, 1.0)
    // The slider's three stops run left to right at one height.
    expect (join (mapList ([start, middle, end], \point => "${point.nativeX},${point.nativeY}")) ";", "20.0,315.0;120.0,315.0;220.0,315.0")
    pressed = Canvases::act (fresh, "Press", 0.5)
    expectVia (nativeLetters, pressed, [{ name = "Pressed", value = true }, { name = "Hello", value = false }])
    full = foldList ([0.0, 0.5, 1.0], pressed, \(before, fraction) => slidTo (before, "Level", fraction))
    released = nativeReleaseAt (full, "Level", 0.75)
    opened = Canvases::act (released, "Menu", 0.5)
    expect (nativeLabels opened, "One|Two|Three|Menu|Press|Level")
    expect (nativeOffered (opened, "Dismiss"), false)
    expect (nativeRole (opened, "One"), "menuitem")
    expectVia (nativeLetters, opened, [{ name = "One", value = true }, { name = "Two", value = true }, { name = "Three", value = true }])
    expectVia (nativeSelected, opened, [{ name = "One", value = false }, { name = "Two", value = false }, { name = "Three", value = false }, { name = "Menu", value = false }, { name = "Press", value = false }, { name = "Level", value = false }])
    dismissed = Canvases::released (opened, 5.0, 5.0)
    expect (nativeLabels dismissed, "Menu|Press|Level")
    reopened = Canvases::act (dismissed, "Menu", 0.5)
    option = nativePoint (nativeElement (reopened, "Two"), 0.5)
    held = Canvases::pointer (reopened, option.nativeX, option.nativeY, true)
    forEachList ([{ name = "selected", down = false, chosen = true, x = option.nativeX, y = option.nativeY }, { name = "level", down = false, chosen = false, x = option.nativeX, y = option.nativeY }, { name = "selected", down = true, chosen = false, x = option.nativeX, y = option.nativeY }, { name = "selected", down = false, chosen = false, x = 5.0, y = 5.0 }], \probe => expect (Canvases::chooses (held, probe.name, probe.x, probe.y, probe.down), probe.chosen))
    chosen = Canvases::act (reopened, "Two", 0.5)
    expect (nativeLabels chosen, "Menu|Press|Level")
    expect (nativeLetters (chosen, "Choice two"), true)
    againOpened = Canvases::act (chosen, "Menu", 0.5)
    expectVia (nativeSelected, againOpened, [{ name = "Two", value = true }, { name = "One", value = false }, { name = "Three", value = false }, { name = "Menu", value = false }])
    expect (nativeSelected (chosen, "Menu"), false)
    // The scene's accessibility tree carries the chosen item with its bounds, read as typed records.
    access = Lists::find (Lists::flatten (mapList (nativeScenes againOpened, \scene => scene.sketchAccess)), \e => e.accessLabel == "Two") ?: ui::Accessible(accessRole = ui::Unannounced, accessLabel = "", accessLeft = 0.0, accessTop = 0.0, accessWidth = 0.0, accessHeight = 0.0, accessValue = 0.0, accessMin = 0.0, accessMax = 0.0, accessSelected = false, accessMovable = false)
    expect ("${Canvases::roleName access.accessRole}/${access.accessLeft},${access.accessTop},${access.accessWidth},${access.accessHeight}/${access.accessValue}/${access.accessMin},${access.accessMax}/${access.accessSelected}/${access.accessMovable}", "menuitem/20.0,190.0,200.0,40.0/0.0/0.0,0.0/true/false")
    again = foldList (["Updated", "Second input"], chosen, \(before, text) => nativeFeed (before, "caption", text))
    expectVia (nativeLetters, again, [{ name = "Second input", value = true }, { name = "Updated", value = false }, { name = "Pressed", value = false }])
    expect (nativeValue (again, "Level"), 0.75)
    unchanged = Canvases::act (again, "Missing", 0.5)
    expect (structuralEquals (MachineDocs::snapshot unchanged, MachineDocs::snapshot again), true))

machineCaseNativeViews () = withNativeFixture (\fresh =>
    native = Machines::feed (fresh, [Machines::fact ("skin", Values::text "plain"), Machines::fact ("caption", Values::text "Native"), Machines::fact ("selected", Values::text "two")])
    walked = nativeTree native
    expect (length walked.walkBound, 2)
    expectVia (nativeShows, native, [{ name = "Native", value = true }, { name = "Native action", value = true }, { name = "Pick", value = true }, { name = "Missing", value = false }])
    pressed = Machines::pull (native, nativeBound (walked, 0), Values::none ())
    expect (Machines::text (pressed, "caption"), "Pressed")
    chosen = Machines::pull (pressed, nativeBound (walked, 1), Values::text "three")
    expect (Machines::text (chosen, "selected"), "three")
    // A picker draws every option; the one it shows as chosen is its own words.
    expect (nativeChosen native, "Two")
    expect (nativeChosen chosen, "Three")
    expect (length (Machines::choicesOf (chosen, "choices")), 3)
    expectRead (\name => Machines::textual (chosen, name), [{ name = "caption", value = true }, { name = "level", value = false }])
    expectRead (\name => Machines::number (chosen, name), [{ name = "level", value = 0.25 }, { name = "caption", value = 0.0 }])
    expect (Machines::flag (chosen, "missing"), false)
    expectRead (\name => Machines::text (chosen, name), [{ name = "level", value = "0.25" }, { name = "toggleMenu", value = "false" }, { name = "choices", value = "" }])
    expectRead (\name => Machines::current (chosen, name), [{ name = "menu", value = "closed" }, { name = "missing", value = "" }]))

machineCaseBrokenDocuments () = Runtime::guarded (\() =>
    refused = match MachineDocs::load "not json"
        Success _ => "loaded"
        Error problem => problem
    expect (refused, "the machine document is not JSON")
    broken = "{\"schema\":2,\"inputs\":{\"a\":{\"type\":\"colour\"},\"b\":{\"type\":\"number\",\"value\":\"x\"}},\"layers\":[{\"name\":\"l\",\"initial\":\"gone\",\"states\":{\"s\":{}},\"transitions\":[{\"from\":\"q\",\"to\":\"s\"}]}],\"view\":{\"kind\":\"button\",\"colour\":\"red\",\"on\":{\"fire\":\"nope\"},\"children\":[{\"kind\":\"widget\"}]}}"
    expect (join (MachineDocs::problems (Doc::parse broken)) "\n", join ["schema: expected 1", "inputs.a.type: expected one of bool, number, text, trigger, list", "inputs.b.value: not a number", "layers[0].initial: no state named \"gone\"", "layers[0].transitions[0].from: no state named \"q\"", "view.colour: not a member of button", "view.on: no input named \"nope\"", "view.children[0].kind: no node kind \"widget\""] "\n")
    faulty = MachineDocs::faulty "boom"
    expect (faulty.machineFault, "boom")
    expect (nativeShows (faulty, "This interface could not load"), true)
    expect (Doc::text (MachineDocs::snapshot faulty, "fault"), "boom")
    expect (MachineDocs::folder "C:\\Program Files\\Osprey\\app\\demo.machine.json", "C:/Program Files/Osprey/app")
    expect (MachineDocs::folder "/opt/osprey/demo.machine.json", "/opt/osprey")
    expect (MachineDocs::folder "demo.machine.json", ""))
