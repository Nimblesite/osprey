// Implements [UI-COMPONENTS-MATH]: typeset mathematics as a typed layout
// tree the host draws with a mathematics face. Applications never write TeX,
// MathML or HTML; the browser and VS Code hosts render the tree as MathML and
// a native host lays it out itself.
namespace ui

// `Seq` is spec 0051's `Row`: `Row` already names the framework's selectable row.
(** A mathematics layout tree: glyphs, sequences, scripts, fractions, radicals, binders, spaced operators, fences and big operators. *)
type Math = Sym string | Num string | Seq (List<Math>) | Sup Math Math | Sub Math Math | Frac Math Math | Root Math | Binder string (List<Math>) Math | Op string Math Math | Paren Math | Big string Math Math Math

(** Typesets a mathematics tree, and encodes and decodes it for documents ([UI-COMPONENTS-MATH]). *)
module Maths
    (** Typeset mathematics: the host lays out `math` with a mathematics face and exposes `spoken` to assistive technology. *)
    export typeset<A> : (Math, string) -> Node<A>
    typeset (tree, text) = Typeset(math = tree, spoken = text)

    // A node of `name`'s kind: its `kind` first, then its members.
    kind name members = JsonObject (listPrepend members (Doc::str ("kind", name)))

    pair (name, first, firstKey, second, secondKey) = kind name [JsonMember firstKey (encode first), JsonMember secondKey (encode second)]

    many items = JsonArray (mapList (items, \item => encode item))

    (** The document form of `tree`, as lessons store it: one object per node, named by `kind`, children nested in order. *)
    export encode tree = match tree
        Sym text => kind "sym" [Doc::str ("text", text)]
        Num text => kind "num" [Doc::str ("text", text)]
        Seq items => kind "seq" [JsonMember "items" (many items)]
        Sup base script => pair ("sup", base, "base", script, "script")
        Sub base script => pair ("sub", base, "base", script, "script")
        Frac top bottom => pair ("frac", top, "top", bottom, "bottom")
        Root body => kind "root" [JsonMember "body" (encode body)]
        Binder symbol names body => kind "binder" [Doc::str ("symbol", symbol), JsonMember "names" (many names), JsonMember "body" (encode body)]
        Op symbol left right => kind "op" [Doc::str ("symbol", symbol), JsonMember "left" (encode left), JsonMember "right" (encode right)]
        Paren body => kind "paren" [JsonMember "body" (encode body)]
        Big symbol lower upper body => kind "big" [Doc::str ("symbol", symbol), JsonMember "lower" (encode lower), JsonMember "upper" (encode upper), JsonMember "body" (encode body)]

    // The named member's text, refusing a missing member or a non-string value.
    stringAt (name, doc, key) = match jsonField doc key
        Error _ => Error(message = "a math node of kind `${name}` is missing its `${key}`")
        Success value => match jsonText value
            Error _ => Error(message = "a math node of kind `${name}` has a non-string `${key}`")
            Success text => Success(value = text)

    // The named member decoded as a child tree.
    child (name, doc, key) = match jsonField doc key
        Error _ => Error(message = "a math node of kind `${name}` is missing its child `${key}`")
        Success value => decode value

    // The named member as an array of child trees.
    arrayAt (name, doc, key) = match jsonField doc key
        Error _ => Error(message = "a math node of kind `${name}` is missing its `${key}`")
        Success value => match value
            JsonArray items => decodeAll items
            _ => Error(message = "a math node of kind `${name}` has a non-array `${key}`")

    // Propagate the first decoding error without evaluating later fields.
    then<T, U> : (Result<T, Error>, (T) -> Result<U, Error>) -> Result<U, Error> !e
    then (result, next) = match result
        Error problem => Error(message = problem)
        Success value => next value

    // Decodes every element; the first error is the result.
    decodeStep (trees, item) = then (trees, \kept => then (decode item, \tree => Success(value = listAppend kept tree)))

    decodeAll items = foldList (items, Success(value = []), decodeStep)

    symOrNum name text = match name
        "sym" => Sym text
        _ => Num text

    textLeaf (name, doc) = then (stringAt (name, doc, "text"), \text => Success(value = symOrNum name text))

    pairTree name first second = match name
        "sup" => Sup first second
        "sub" => Sub first second
        _ => Frac first second

    pairNode (name, firstKey, secondKey, doc) = then (child (name, doc, firstKey), \first => then (child (name, doc, secondKey), \second => Success(value = pairTree name first second)))

    bodyTree name body = match name
        "root" => Root body
        _ => Paren body

    bodyNode (name, doc) = then (child (name, doc, "body"), \body => Success(value = bodyTree name body))

    seqNode doc = then (arrayAt ("seq", doc, "items"), \items => Success(value = Seq items))

    binderNode doc = then (stringAt ("binder", doc, "symbol"), \symbol => then (arrayAt ("binder", doc, "names"), \names => then (child ("binder", doc, "body"), \body => Success(value = Binder symbol names body))))

    opNode doc = then (stringAt ("op", doc, "symbol"), \symbol => then (child ("op", doc, "left"), \left => then (child ("op", doc, "right"), \right => Success(value = Op symbol left right))))

    bigNode doc = then (stringAt ("big", doc, "symbol"), \symbol => then (child ("big", doc, "lower"), \lower => then (child ("big", doc, "upper"), \upper => then (child ("big", doc, "body"), \body => Success(value = Big symbol lower upper body)))))

    (** The inverse of `encode`: the mathematics tree its document form names, or an error naming an unknown kind, a missing child, a non-object node or a non-string text or symbol ([UI-COMPONENTS-MATH]). *)
    export decode doc = match doc
        JsonObject _ => match jsonField doc "kind"
            Error _ => Error(message = "a math node is missing its kind")
            Success value => match jsonText value
                Error _ => Error(message = "a math node is missing its kind")
                Success name => match name
                    "sym" => textLeaf ("sym", doc)
                    "num" => textLeaf ("num", doc)
                    "seq" => seqNode doc
                    "sup" => pairNode ("sup", "base", "script", doc)
                    "sub" => pairNode ("sub", "base", "script", doc)
                    "frac" => pairNode ("frac", "top", "bottom", doc)
                    "root" => bodyNode ("root", doc)
                    "binder" => binderNode doc
                    "op" => opNode doc
                    "paren" => bodyNode ("paren", doc)
                    "big" => bigNode doc
                    other => Error(message = "a math node has the unknown kind `${other}`")
        _ => Error(message = "a math node must be an object")
