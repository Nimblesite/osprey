// Implements [UI-EFFECTS]: platform work is a typed, bounded request. Bulk
// results land in host-held slices named by the request, so large outputs
// never travel back through an event.
namespace ui

(** One HTTP request header. *)
type Header =
    headerName : string
    headerValue : string

(** One environment variable a process inherits, merged over the environment the host already has ([UI-EFFECTS-PROCESS]). *)
type EnvVar =
    envName : string
    envValue : string

(** A bounded, mechanical operation only the host can perform: every one states its limits, and its result returns as a completion ([UI-EFFECTS]). `Recognise` sends the strokes the host holds under `strokeSlices` to its handwriting service, as points, and completes with their text, at most `recogniseLimit` bytes, or with an error naming `Unsupported` on a host without one ([UI-EFFECTS-RECOGNISE]). `MeasureFolders` measures each folder's children to the bottom within an entry limit and a deadline, by the same rules on every host ([UI-EFFECTS-MEASURE]). `ProcessStart`, `ProcessWrite`, `ProcessRead` and `ProcessStop` run one long-lived child process by an application-chosen handle, every request bounded by a limit and a deadline, for MCP stdio servers ([UI-EFFECTS-PROCESS]). Work only one host or product can do, such as reading one operating system's settings, is a `HostCall` in a namespace that host answers. `Animate` turns the host's frame clock on or off: while it runs, every display refresh reaches `update` as a `Frame` ([UI-SCENE]). *)
type Capability =
    Run
        executable : string
        arguments : List<string>
        timeout : int
        outputLimit : int
        plist : bool
        runSlice : string
    ListDirectories
        directories : List<string>
        entryLimit : int
        listSlice : string
    ReadPropertyLists
        plists : List<string>
        plistKeys : List<string>
        plistSuffixes : List<string>
        plistLimit : int
        plistSlice : string
    ReadTexts
        texts : List<string>
        textLimit : int
        textSlice : string
    Fingerprint
        file : string
        fileLimit : int
    StoreRead
        readName : string
        readLimit : int
        readSlice : string
    StoreWrite
        writeName : string
        writeSlice : string
    StoreList
        folder : string
    StoreDelete
        deleteName : string
    Http
        method : string
        url : string
        headers : List<Header>
        body : string
        responseLimit : int
        deadline : int
        httpSlice : string
    HostCall
        hostNamespace : string
        hostOperation : string
        hostArguments : List<Header>
        hostTimeout : int
        hostLimit : int
        hostSlice : string
    RunningApplications
    ChooseFile
        types : List<string>
        chosenLimit : int
        chosenSlice : string
    ChooseFolder
    SaveFile
        suggested : string
        exportSlice : string
    MeasureFolders
        measureFolders : List<string>
        measureLimit : int
        measureDeadline : int
        measureSlice : string
    Reveal
        revealPath : string
    OpenSettings
        pane : string
    Cancel
        cancelled : string
    Recognise
        strokeSlices : List<string>
        recogniseLimit : int
    Animate
        animated : bool
    ProcessStart
        processCommand : string
        processArguments : List<string>
        processEnv : List<EnvVar>
        processHandle : string
    ProcessWrite
        writeHandle : string
        writeBytes : string
    ProcessRead
        readHandle : string
        readBytesLimit : int
        readDeadline : int
    ProcessStop
        stopHandle : string

(** A capability with the ticket its completion will carry. Put a generation in the ticket to recognise stale completions. *)
type Request =
    ticket : string
    capability : Capability

(** Text the host holds under `sliceKey` for later fetches, so large slices need not travel in the opaque state. *)
type SliceWrite =
    sliceKey : string
    sliceText : string

(** One field of an ask on its way to the shared frame, as `native.td`'s `AskRow` lays it out ([NATIVE-SHM-ASK]). *)
type Asked =
    askedField : int
    askedNumber : int
    askedText : string

(** Builds capability requests and host slice writes, and writes them into the shared frame as ask rows ([UI-EFFECTS], [NATIVE-SHM-ASK]). *)
module Requests
    (** The capability code of a slice write's first row; every capability's code is its position in `Capability`, counted from 1. *)
    export sliceCode = 100

    text (field, words) = Asked(askedField = field, askedNumber = 0, askedText = words)

    whole (field, number) = Asked(askedField = field, askedNumber = number, askedText = "")

    flag (field, on) = whole (field, Pick::either (on, 1, 0))

    texts (field, items) = mapList (items, \item => text (field, item))

    pairs (field, items) = Lists::flatten (mapList (items, \item => [text (field, item.headerName), text (field, item.headerValue)]))

    envs (field, items) = Lists::flatten (mapList (items, \item => [text (field, item.envName), text (field, item.envValue)]))

    // The first row names the capability by its code and carries the ticket; the arguments follow.
    asks (code, ticket, arguments) = listConcat [Asked(askedField = 0, askedNumber = code, askedText = ticket)] arguments

    // A capability's rows, each argument numbered by its position in the constructor.
    fields (ticket, capability) = match capability
        Run executable arguments timeout limit plist slice => asks (1, ticket, listConcat [text (1, executable)] (listConcat (texts (2, arguments)) [whole (3, timeout), whole (4, limit), flag (5, plist), text (6, slice)]))
        ListDirectories paths limit slice => asks (2, ticket, listConcat (texts (1, paths)) [whole (2, limit), text (3, slice)])
        ReadPropertyLists paths keys suffixes limit slice => asks (3, ticket, listConcat (texts (1, paths)) (listConcat (texts (2, keys)) (listConcat (texts (3, suffixes)) [whole (4, limit), text (5, slice)])))
        ReadTexts paths limit slice => asks (4, ticket, listConcat (texts (1, paths)) [whole (2, limit), text (3, slice)])
        Fingerprint path limit => asks (5, ticket, [text (1, path), whole (2, limit)])
        StoreRead name limit slice => asks (6, ticket, [text (1, name), whole (2, limit), text (3, slice)])
        StoreWrite name slice => asks (7, ticket, [text (1, name), text (2, slice)])
        StoreList name => asks (8, ticket, [text (1, name)])
        StoreDelete name => asks (9, ticket, [text (1, name)])
        Http method url headers body limit deadline slice => asks (10, ticket, listConcat [text (1, method), text (2, url)] (listConcat (pairs (3, headers)) [text (4, body), whole (5, limit), whole (6, deadline), text (7, slice)]))
        HostCall space operation arguments timeout limit slice => asks (11, ticket, listConcat [text (1, space), text (2, operation)] (listConcat (pairs (3, arguments)) [whole (4, timeout), whole (5, limit), text (6, slice)]))
        RunningApplications => asks (12, ticket, [])
        ChooseFile types limit slice => asks (13, ticket, listConcat (texts (1, types)) [whole (2, limit), text (3, slice)])
        ChooseFolder => asks (14, ticket, [])
        SaveFile name slice => asks (15, ticket, [text (1, name), text (2, slice)])
        MeasureFolders folders limit deadline slice => asks (16, ticket, listConcat (texts (1, folders)) [whole (2, limit), whole (3, deadline), text (4, slice)])
        Reveal path => asks (17, ticket, [text (1, path)])
        OpenSettings pane => asks (18, ticket, [text (1, pane)])
        Cancel target => asks (19, ticket, [text (1, target)])
        Recognise slices limit => asks (20, ticket, listConcat (texts (1, slices)) [whole (2, limit)])
        Animate on => asks (21, ticket, [flag (1, on)])
        ProcessStart command arguments env name => asks (22, ticket, listConcat [text (1, command)] (listConcat (texts (2, arguments)) (listConcat (envs (3, env)) [text (4, name)])))
        ProcessWrite name input => asks (23, ticket, [text (1, name), text (2, input)])
        ProcessRead name limit deadline => asks (24, ticket, [text (1, name), whole (2, limit), whole (3, deadline)])
        ProcessStop name => asks (25, ticket, [text (1, name)])

    kinds = ["run", "list-directories", "read-plists", "read-texts", "fingerprint", "store-read", "store-write", "store-list", "store-delete", "http", "host-call", "running-applications", "choose-file", "choose-folder", "save-file", "measure-folders", "reveal", "open-settings", "cancel", "recognise", "animate", "process-start", "process-write", "process-read", "process-stop"]

    (** The name of `capability`'s kind, as logs and tests spell it: `choose-file`, `store-read` and so on. *)
    export kind capability = listGet kinds ((listGet (fields ("", capability)) 0 ?: Asked(askedField = 0, askedNumber = 0, askedText = "")).askedNumber - 1) ?: ""

    (** The ask rows of `request`: a first row with its capability code and ticket, then its arguments. *)
    export rows request = fields (request.ticket, request.capability)

    (** The ask rows of a slice write: its key, then its text. *)
    export slice write = [Asked(askedField = 0, askedNumber = sliceCode, askedText = write.sliceKey), text (1, write.sliceText)]

    (** Sends `requests` and `writes` to the host beside the view, slice writes first so a request finds the text it names. *)
    export post : (List<Request>, List<SliceWrite>) -> Unit ![ViewStream | e]
    post (requests, writes) = forEachList (listConcat (Lists::flatten (mapList (writes, slice))) (Lists::flatten (mapList (requests, rows))), \row => perform ViewStream.ask row)

    (** A request for `capability` whose completion returns to `update` under `ticket`. *)
    export ask (ticket, capability) = Request(ticket = ticket, capability = capability)

    (** A host-held slice write: the host keeps `text` under `key` until it is written again. *)
    export write (key, text) = SliceWrite(sliceKey = key, sliceText = text)
