// Implements [UI-EFFECTS]: platform work is a typed, bounded request. Bulk
// results land in host-held slices named by the request, so large outputs
// never travel back through an event.
namespace ui

(** One HTTP request header. *)
type Header =
    headerName : string
    headerValue : string

(** One environment variable a process inherits, merged over the environment the host already has ([UI-EFFECTS-PROCESS]). *)
type EnvVar =
    envName : string
    envValue : string

(** A bounded, mechanical operation only the host can perform: every one states its limits, and its result returns as a completion ([UI-EFFECTS]). `Recognise` sends the strokes the host holds under `strokeSlices` to its handwriting service, as points, and completes with their text, at most `recogniseLimit` bytes, or with an error naming `Unsupported` on a host without one ([UI-EFFECTS-RECOGNISE]). `MeasureFolders` measures each folder's children to the bottom within an entry limit and a deadline, by the same rules on every host ([UI-EFFECTS-MEASURE]). `ProcessStart`, `ProcessWrite`, `ProcessRead` and `ProcessStop` run one long-lived child process by an application-chosen handle, every request bounded by a limit and a deadline, for MCP stdio servers ([UI-EFFECTS-PROCESS]). Work only one host or product can do, such as reading one operating system's settings, is a `HostCall` in a namespace that host answers. `Animate` turns the host's frame clock on or off: while it runs, every display refresh reaches `update` as a `Frame` ([UI-SCENE]). *)
type Capability =
    Run
        executable : string
        arguments : List<string>
        timeout : int
        outputLimit : int
        plist : bool
        runSlice : string
    ListDirectories
        directories : List<string>
        entryLimit : int
        listSlice : string
    ReadPropertyLists
        plists : List<string>
        plistKeys : List<string>
        plistSuffixes : List<string>
        plistLimit : int
        plistSlice : string
    ReadTexts
        texts : List<string>
        textLimit : int
        textSlice : string
    Fingerprint
        file : string
        fileLimit : int
    StoreRead
        readName : string
        readLimit : int
        readSlice : string
    StoreWrite
        writeName : string
        writeSlice : string
    StoreList
        folder : string
    StoreDelete
        deleteName : string
    Http
        method : string
        url : string
        headers : List<Header>
        body : string
        responseLimit : int
        deadline : int
        httpSlice : string
    HostCall
        hostNamespace : string
        hostOperation : string
        hostArguments : Json
        hostTimeout : int
        hostLimit : int
        hostSlice : string
    RunningApplications
    ChooseFile
        types : List<string>
        chosenLimit : int
        chosenSlice : string
    ChooseFolder
    SaveFile
        suggested : string
        exportSlice : string
    MeasureFolders
        measureFolders : List<string>
        measureLimit : int
        measureDeadline : int
        measureSlice : string
    Reveal
        revealPath : string
    OpenSettings
        pane : string
    Cancel
        cancelled : string
    Recognise
        strokeSlices : List<string>
        recogniseLimit : int
    Animate
        animated : bool
    ProcessStart
        processCommand : string
        processArguments : List<string>
        processEnv : List<EnvVar>
        processHandle : string
    ProcessWrite
        writeHandle : string
        writeBytes : string
    ProcessRead
        readHandle : string
        readBytesLimit : int
        readDeadline : int
    ProcessStop
        stopHandle : string

(** A capability with the ticket its completion will carry. Put a generation in the ticket to recognise stale completions. *)
type Request =
    ticket : string
    capability : Capability

(** Text the host holds under `sliceKey` for later fetches, so large slices need not travel in the opaque state. *)
type SliceWrite =
    sliceKey : string
    sliceText : string

(** Builds capability requests and host slice writes, and encodes requests for the protocol ([UI-EFFECTS]). *)
module Requests
    strings key values = JsonMember key (Doc::strings values)

    header item = JsonObject [Encode::str "name" item.headerName, Encode::str "value" item.headerValue]

    envVar item = JsonObject [Encode::str "name" item.envName, Encode::str "value" item.envValue]

    run executable arguments timeout limit plist slice = [Encode::str "kind" "run", Encode::str "executable" executable, strings "arguments" arguments, Encode::num "timeout" timeout, Encode::num "limit" limit, Doc::bit ("plist", plist), Encode::str "slice" slice]

    http method url headers body limit deadline slice = [Encode::str "kind" "http", Encode::str "method" method, Encode::str "url" url, JsonMember "headers" (JsonArray (mapList (headers, \item => header item))), Encode::str "body" body, Encode::num "limit" limit, Encode::num "timeout" deadline, Encode::str "slice" slice]

    // A capability's members: its `kind` first, then its arguments.
    kind name members = listPrepend members (Encode::str "kind" name)

    // Arguments followed by the output bound and the slice the output lands in.
    capped (members, limit, slice) = listConcat members [Encode::num "limit" limit, Encode::str "slice" slice]

    members capability = match capability
        Run executable arguments timeout limit plist slice => run executable arguments timeout limit plist slice
        ListDirectories paths limit slice => capped (kind "list-directories" [strings "paths" paths], limit, slice)
        ReadPropertyLists paths keys suffixes limit slice => capped (kind "read-plists" [strings "paths" paths, strings "keys" keys, strings "suffixes" suffixes], limit, slice)
        ReadTexts paths limit slice => capped (kind "read-texts" [strings "paths" paths], limit, slice)
        Fingerprint path limit => kind "fingerprint" [Encode::str "path" path, Encode::num "limit" limit]
        StoreRead name limit slice => capped (kind "store-read" [Encode::str "name" name], limit, slice)
        StoreWrite name slice => kind "store-write" [Encode::str "name" name, Encode::str "slice" slice]
        StoreList name => kind "store-list" [Encode::str "name" name]
        StoreDelete name => kind "store-delete" [Encode::str "name" name]
        Http method url headers body limit deadline slice => http method url headers body limit deadline slice
        HostCall space operation arguments timeout limit slice => kind "host-call" [Encode::str "namespace" space, Encode::str "operation" operation, JsonMember "arguments" arguments, Encode::num "timeout" timeout, Encode::num "limit" limit, Encode::str "slice" slice]
        RunningApplications => kind "running-applications" []
        ChooseFile types limit slice => capped (kind "choose-file" [strings "types" types], limit, slice)
        ChooseFolder => kind "choose-folder" []
        SaveFile name slice => kind "save-file" [Encode::str "name" name, Encode::str "slice" slice]
        MeasureFolders folders limit deadline slice => kind "measure-folders" [strings "folders" folders, Encode::num "limit" limit, Encode::num "timeout" deadline, Encode::str "slice" slice]
        Reveal path => kind "reveal" [Encode::str "path" path]
        OpenSettings pane => kind "open-settings" [Encode::str "pane" pane]
        Cancel target => kind "cancel" [Encode::str "target" target]
        Recognise slices limit => kind "recognise" [strings "slices" slices, Encode::num "limit" limit]
        Animate on => kind "animate" [Doc::bit ("on", on)]
        ProcessStart command arguments env name => kind "process-start" [Encode::str "command" command, strings "arguments" arguments, JsonMember "env" (JsonArray (mapList (env, \item => envVar item))), Encode::str "name" name]
        ProcessWrite name input => kind "process-write" [Encode::str "name" name, Encode::str "input" input]
        ProcessRead name limit deadline => kind "process-read" [Encode::str "name" name, Encode::num "limit" limit, Encode::num "timeout" deadline]
        ProcessStop name => kind "process-stop" [Encode::str "name" name]

    (** The protocol form of `request`: its ticket beside the capability's kind and arguments. *)
    export encode request = JsonObject (listPrepend (members request.capability) (Encode::str "ticket" request.ticket))

    (** A request for `capability` whose completion returns to `update` under `ticket`. *)
    export ask (ticket, capability) = Request(ticket = ticket, capability = capability)

    (** A host-held slice write: the host keeps `text` under `key` until it is written again. *)
    export write (key, text) = SliceWrite(sliceKey = key, sliceText = text)
