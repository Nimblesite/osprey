// Implements [UI-STORE]: an application's store changes only through its `update`, one step at a
// time. A step names the next store, the capabilities it asks of the host and the host slices it
// writes; `Surfaces` keeps the session in the library and draws each step ([NATIVE-SHM-BOUNDARY]).
namespace ui

(** What an update returns: the next store, the capabilities it asks for and the host slices it writes. *)
type Step S =
    stepStore : S
    requests : List<Request>
    writes : List<SliceWrite>

(** What a library keeps between host calls: the host facts and the store. *)
type Session S =
    sessionContext : Context
    sessionStore : S

(** Builds steps and host facts for an application's `init` and `update` ([UI-STORE]). *)
module Runtime
    (** A step that changes the store to `store` and asks for nothing. *)
    export step<S> : S -> Step<S>
    step store = Step(stepStore = store, requests = [], writes = [])

    (** A step that changes the store to `store` and asks the host for `requests`. *)
    export asking<S> : (S, List<Request>) -> Step<S>
    asking (store, requests) = Step(stepStore = store, requests = requests, writes = [])

    (** The host facts a boundary passes at launch: the clock in seconds, the zone offset, the platform's name, the home folder and the launch arguments. *)
    export host (now, offset, platform, home, arguments) = Context(now = now, offset = offset, platform = platform, home = home, arguments = arguments, hostDark = false)

    (** Runs `work` with integer faults resolved for an application's C boundary: an overflow keeps the wrapped result and a division by zero its dividend. Interface arithmetic is counters, clocks and coordinates, none near the limits. *)
    export guarded work =
        handle Arith
            overflow _ _ _ wrapped => wrapped
            divideByZero _ dividend => dividend
            remainderByZero _ => 0
        work ()
