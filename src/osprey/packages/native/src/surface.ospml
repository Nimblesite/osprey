// Implements [NATIVE-SHM-BOUNDARY]: an application built from `Node` regions crosses the bridge
// with no JSON in either direction. `Surfaces::open` and `Surfaces::event` run the application's
// own `init`, `update` and `render`, lower the root region to view rows the host reads in place
// ([NATIVE-SHM-LOWER], [NATIVE-SHM-VIEW]) and keep the session in the library. An event is the
// number of a control and its words; the binding it names decides what the words mean.
namespace ui

(** A session drawn as shared view rows: the session itself, the bindings its controls deliver in control order, and what the last step asked of the host. *)
type Surface S A =
    surfaceSession : Session<S>
    surfaceBound : List<Binding<A>>
    surfaceAsked : List<Request>
    surfaceWrites : List<SliceWrite>

(** How a surface is drawn: the theme and whether the dark appearance is showing. *)
type Dress =
    dressTheme : Theme
    dressDark : bool

(** Opens and advances a `Surface` ([NATIVE-SHM-BOUNDARY]). *)
module Surfaces
    (** The region every surface draws; other regions appear where it names them with a `Slot`. *)
    export rootKey = "root"

    // Draws the root region and answers the bindings its controls deliver. Every region is rebuilt
    // for each view, so a `Slot` always finds the node it names.
    draw<A> : (Dress, List<KeyedSnapshot<Node<A>>>) -> List<Binding<A>> ![ViewStream, SceneStream | e]
    draw (dress, regions) = match Lists::find (regions, \region => region.snapshotKey == rootKey)
        Error _ => []
        Success root => Views::render (Lower::view (Styling(styleTheme = dress.dressTheme, styleDark = dress.dressDark, styleRegions = regions), Streams::split root.snapshotValue))

    surface<S, A> : (Context, Step<S>, List<Binding<A>>) -> Surface<S, A>
    surface (host, step, bound) = Surface(surfaceSession = Session(sessionContext = host, sessionStore = step.stepStore, sessionFrames = [], sessionPast = []), surfaceBound = bound, surfaceAsked = step.requests, surfaceWrites = step.writes)

    (** The first view for the host facts `host`: runs `init`, draws the root region into the shared frame and answers the surface to keep. *)
    export open<S, A> : (Context, (Context) -> Step<S>, (S, S, List<SignalFrame>, List<SliceWrite>) -> List<KeyedSnapshot<Node<A>>>, Dress) -> Surface<S, A> ![ViewStream, SceneStream | e]
    open (host, init, render, dress) =
        first = init host
        surface (host, first, draw (dress, render (first.stepStore, first.stepStore, [], first.writes)))

    (** The next view after `message` at the clock reading `now`: runs `update`, draws the root region and answers the surface to keep. *)
    export deliver<S, A> : (Surface<S, A>, int, Message<A>, (Context, S, Message<A>) -> Step<S>, (S, S, List<SignalFrame>, List<SliceWrite>) -> List<KeyedSnapshot<Node<A>>>, Dress) -> Surface<S, A> ![ViewStream, SceneStream | e]
    deliver (held, now, message, update, render, dress) =
        before = held.surfaceSession
        host = before.sessionContext
        clocked = host(now = now)
        next = update (clocked, before.sessionStore, message)
        surface (clocked, next, draw (dress, render (before.sessionStore, next.stepStore, [], next.writes)))

    whole (words, absent) = parseInt words ?: absent

    (** The typed message `words` means to `binding`: a tap ignores them, a switch reads `true`, a splitter and a caret read a whole number. Strokes, lassos and scene input are refused here: they arrive through their own typed exports, never as text. *)
    export told<A> : (Binding<A>, string) -> Result<Message<A>, Error>
    told (binding, words) = match binding
        Tap action => Success(value = Act(act = action))
        TextInput action => Success(value = Entered(entry = action, entered = words))
        FlagInput action => Success(value = Switched(toggle = action, switched = words == "true"))
        ChoiceInput action => Success(value = Chose(chooser = action, chosen = words))
        SizeInput action => Success(value = Resized(resizer = action, resized = Splitters::clamp (whole (words, Splitters::least))))
        PlaceInput action => Success(value = Placed(placer = action, placed = lifted (whole (words, 0))))
        StrokeInput _ => Error(message = "A stroke does not arrive as text")
        LassoInput _ => Error(message = "A lasso does not arrive as text")
        SceneInput _ => Error(message = "Scene input does not arrive as text")

    lifted offset = match offset < 0
        true => 0
        false => offset

    (** The message the control numbered `ordinal` delivers with `words`, or an error when the view drew no such control: a host can only name a binding the application issued. *)
    export meant<S, A> : (Surface<S, A>, int, string) -> Result<Message<A>, Error>
    meant (held, ordinal, words) = match listGet held.surfaceBound ordinal
        Error _ => Error(message = "Unknown control ${ordinal}")
        Success binding => told (binding, words)
