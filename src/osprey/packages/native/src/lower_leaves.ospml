// Implements [NATIVE-SHM-LOWER]: the style tables and leaf lowering a semantic node
// takes when it becomes a primitive view ([NATIVE-SHM-VIEW]). The tables carry the
// metrics the native hosts drew before the shared frame existed, so what they drew is
// preserved; every colour is the application's own theme token, resolved for the
// appearance that is showing.
namespace ui

import ui::Views
import ui::Themes
import ui::Pick

(** The style tables and leaf lowering a semantic node takes when it becomes a primitive view ([NATIVE-SHM-LOWER]). *)
module LowerLeaves
    (** The points of a text role: the type scale the native hosts drew. *)
    export rolePoints role = match role
        Display => 34.0
        Large => 28.0
        Title => 20.0
        Heading => 16.0
        Lead => 15.0
        Headline => bodyPoints
        Body => bodyPoints
        Callout => 12.0
        Caption => captionPoints
        Eyebrow => captionPoints
        Mono => 12.0

    (** The heft of a text role: the roles the hosts set semibold stay at 600, the rest at 400. *)
    export roleHeft role = match role
        Display => 600
        Large => 600
        Title => 600
        Heading => 600
        Headline => 600
        Eyebrow => 600
        Lead => 400
        Body => 400
        Callout => 400
        Caption => 400
        Mono => 400

    (** The theme token a tone draws in: the primary tone is the theme's text ink. *)
    export toneToken tone = match tone
        Primary => "text"
        Secondary => "secondary"
        Accent => "accent"
        Good => "good"
        Caution => "caution"
        Danger => "danger"

    (** The body text size in points. *)
    export bodyPoints = 13.0

    (** The caption text size in points. *)
    export captionPoints = 11.0

    (** The alpha of a resting wash: a plain button's seven-percent tint of the theme's ink. *)
    export faint = 18

    (** The alpha of a chosen wash: a selected row or tab's ten-percent tint. *)
    export picked = 26

    (** The alpha of a badge's wash: its tone at fourteen percent. *)
    export tint = 36

    (** The alpha of a meter track's wash: its tone at sixteen percent. *)
    export track = 41

    (** A corner radius past any control's height: a capsule. *)
    export capsule = 999.0

    // The colour the showing appearance gives the token `name`, or none when the theme names none.
    shaded (theme, dark, name) = match Themes::named (theme, name)
        Success token => Views::colour (Pick::either (dark, token.tokenDark, token.tokenLight))
        Error _ => 0

    (** The ink of the token `name`: a theme without it falls back to its `primary` token, then draws none. *)
    export inkNamed (theme, dark, name) = match shaded (theme, dark, name)
        0 => shaded (theme, dark, "primary")
        ink => ink

    (** The fill of the token `name`: a theme without it fills nothing. *)
    export fillNamed (theme, dark, name) = shaded (theme, dark, name)

    (** The ink a tone draws in. *)
    export inkTone (theme, dark, tone) = inkNamed (theme, dark, toneToken tone)

    (** `base` at the alpha byte `alpha`: a translucent wash of an opaque colour. *)
    export wash (base, alpha) = satAdd (satMul (intDiv base 256) 256) alpha

    (** The gap a stack gives its children: step one of the theme's spacing scale, eight when it names none. *)
    export spaced theme = toFloat (listGet theme.spacing 1 ?: 8)

    (** A container's look: no colour of its own, `gap` of space between its children. *)
    export carrier gap = Look(ink = 0, fill = 0, points = 0.0, inset = 0.0, gap = gap, corner = 0.0, heft = 400)

    (** A wording's look: `points` and `heft` in the ink of `tone`, for the labels a container draws. *)
    export sized (theme, dark, points, heft, tone) = Look(ink = inkTone (theme, dark, tone), fill = 0, points = points, inset = 0.0, gap = 0.0, corner = 0.0, heft = heft)

    (** `view` led by the icon `symbol` names, which a host draws from its own symbol set; an empty name draws none. *)
    export iconed<A> : (string, View<Binding<A>>) -> View<Binding<A>>
    iconed (symbol, view) = match symbol == ""
        true => view
        false => Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = symbol), fitted = view)

    // A fit that adds only `traits` to what it wraps.
    traitFit traits = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = traits, edge = 0, hint = "")

    // A wording in its role's size and heft, in its tone's ink.
    spoken<A> : (Theme, bool, TextRole, Tone, string) -> View<Binding<A>>
    spoken (theme, dark, role, tone, content) = Wording(wordsLook = sized (theme, dark, rolePoints role, roleHeft role, tone), wordsText = content)

    (** Text as a wording: mono text is fixed-width and an eyebrow is shouted in small heavy caps. *)
    export wording<A> : (Theme, bool, string, TextRole, Tone) -> View<Binding<A>>
    wording (theme, dark, content, role, tone) = match role
        Mono => Fitted(fit = traitFit (Views::fixedWidth), fitted = spoken (theme, dark, role, tone, content))
        Eyebrow => Wording(wordsLook = sized (theme, dark, captionPoints, 600, tone), wordsText = toUpperCase content)
        _ => spoken (theme, dark, role, tone, content)

    codeTrait emphasis = match emphasis
        "code" => Views::fixedWidth
        _ => 0

    runTraits (italic, emphasis) = satAdd (Pick::either (italic, Views::slanted, 0)) (codeTrait emphasis)

    runHeft (role, emphasis) = match emphasis
        "strong" => 600
        _ => roleHeft role

    runPoints (role, emphasis) = match emphasis
        "code" => (rolePoints role) - 1.0
        _ => rolePoints role

    runInk (theme, dark, name) = match name == ""
        true => inkTone (theme, dark, Primary)
        false => inkNamed (theme, dark, name)

    // One rich text run: its own ink, `strong` heavier, `code` fixed-width and a point smaller, italics slanted.
    runViewed<A> : (Theme, bool, TextRole, TextRun) -> View<Binding<A>>
    runViewed (theme, dark, role, run) = Fitted(fit = traitFit (runTraits (run.runItalic, run.runEmphasis)), fitted = Wording(wordsLook = Look(ink = runInk (theme, dark, run.runInk), fill = 0, points = runPoints (role, run.runEmphasis), inset = 0.0, gap = 0.0, corner = 0.0, heft = runHeft (role, run.runEmphasis)), wordsText = run.runText))

    (** Rich text as a line of wordings, one per run, each carrying its own emphasis and ink. *)
    export rich<A> : (Theme, bool, List<TextRun>, TextRole) -> View<Binding<A>>
    rich (theme, dark, runs, role) = Across(acrossLook = carrier 0.0, acrossItems = mapList (runs, \run => runViewed (theme, dark, role, run)))

    (** A setting and its value on one line: the label in the secondary ink, a flexible gap between. *)
    export pair<A> : (Theme, bool, string, string) -> View<Binding<A>>
    pair (theme, dark, label, value) = Across(acrossLook = carrier 8.0, acrossItems = [
        Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Secondary), wordsText = label),
        Gap,
        Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Primary), wordsText = value)])

    (** A badge: its tone's ink on a capsule of the same tone washed to fourteen percent, symbol beside label. *)
    export badge<A> : (Theme, bool, string, string, Tone) -> View<Binding<A>>
    badge (theme, dark, label, symbol, tone) =
        inked = inkTone (theme, dark, tone)
        iconed (symbol, Wording(wordsLook = Look(ink = inked, fill = wash (inked, tint), points = captionPoints, inset = 4.0, gap = 0.0, corner = capsule, heft = 500), wordsText = label))

    (** Text led by a symbol, both in the primary ink. *)
    export label<A> : (Theme, bool, string, string) -> View<Binding<A>>
    label (theme, dark, content, symbol) = iconed (symbol, Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Primary), wordsText = content))

    (** A large decorative symbol. *)
    export icon<A> : (Theme, bool, string) -> View<Binding<A>>
    icon (theme, dark, symbol) = iconed (symbol, Wording(wordsLook = sized (theme, dark, 14.0, 400, Primary), wordsText = ""))

    (** A web link: the accent ink, its address carried as the fit hint. The host opens the address itself, so unlike every other control it binds nothing — the view vocabulary has no action-less press, and inventing one would take an action the node does not carry. *)
    export link<A> : (Theme, bool, string, string) -> View<Binding<A>>
    link (theme, dark, label, address) = Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = address), fitted = Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Accent), wordsText = label))

    (** A hairline rule in the secondary ink. *)
    export divider<A> : (Theme, bool) -> View<Binding<A>>
    divider (theme, dark) = Rule(ruleLook = Look(ink = inkTone (theme, dark, Secondary), fill = 0, points = 1.0, inset = 0.0, gap = 0.0, corner = 0.0, heft = 400))

    (** A filled box: an empty wording that carries only its fill, `tall` points high with `share` of the free space. *)
    export box<A> : (float, float, int, float) -> View<Binding<A>>
    box (share, tall, fill, corner) = Fitted(fit = Fit(wide = 0.0, tall = tall, share = share, traits = 0, edge = 0, hint = ""), fitted = Wording(wordsLook = Look(ink = 0, fill = fill, points = 0.0, inset = 0.0, gap = 0.0, corner = corner, heft = 400), wordsText = ""))

    (** One filled box per tone, equal shares of the line. *)
    export segments<A> : (Theme, bool, List<Tone>) -> View<Binding<A>>
    segments (theme, dark, tones) = Across(acrossLook = carrier 1.0, acrossItems = mapList (tones, \tone => box (1.0, 4.0, inkTone (theme, dark, tone), 2.0)))

    (** An empty state, centred: its symbol large, its title titled, its detail explained in the secondary ink. *)
    export empty<A> : (Theme, bool, string, string, string) -> View<Binding<A>>
    empty (theme, dark, symbol, title, detail) = Fitted(fit = traitFit (Views::centred), fitted = Column(columnLook = carrier 8.0, columnItems = [
        iconed (symbol, Wording(wordsLook = sized (theme, dark, rolePoints Large, 400, Primary), wordsText = "")),
        Wording(wordsLook = sized (theme, dark, rolePoints Title, 600, Primary), wordsText = title),
        Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Secondary), wordsText = detail)]))

    (** Work in progress: its label read in the primary ink, its detail quieter in the secondary. *)
    export progress<A> : (Theme, bool, string, string) -> View<Binding<A>>
    progress (theme, dark, label, detail) = Column(columnLook = carrier 2.0, columnItems = [
        Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Primary), wordsText = label),
        Wording(wordsLook = sized (theme, dark, 12.0, 400, Secondary), wordsText = detail)])

    (** A meter: its label above a capsule filled to `amount` of `total` in its tone, the rest the tone washed to sixteen percent. *)
    export meter<A> : (Theme, bool, string, int, int, Tone) -> View<Binding<A>>
    meter (theme, dark, label, amount, total, tone) =
        whole = Pick::either (total < 1, 1, total)
        filled = Pick::either (amount < 0, 0, Pick::either (amount > whole, whole, amount))
        inked = inkTone (theme, dark, tone)
        Column(columnLook = carrier 5.0, columnItems = [
            Wording(wordsLook = sized (theme, dark, 12.0, 400, Secondary), wordsText = label),
            Across(acrossLook = carrier 0.0, acrossItems = [
                box (toFloat filled, 4.0, inked, capsule),
                box (toFloat (satSub whole filled), 4.0, wash (inked, track), capsule)])])

    (** A colour swatch: its box filled with the pair's own value for the showing appearance, its name beside it. *)
    export swatch<A> : (Theme, bool, string, string, string) -> View<Binding<A>>
    swatch (theme, night, name, lightHex, darkHex) = Across(acrossLook = carrier 8.0, acrossItems = [
        Fitted(fit = Fit(wide = 16.0, tall = 16.0, share = 0.0, traits = 0, edge = 0, hint = ""), fitted = Wording(wordsLook = Look(ink = 0, fill = Views::colour (Pick::either (night, darkHex, lightHex)), points = 0.0, inset = 0.0, gap = 0.0, corner = 4.0, heft = 400), wordsText = "")),
        Wording(wordsLook = sized (theme, night, bodyPoints, 400, Primary), wordsText = name)])

    (** Mathematics as the words a person hears read out. *)
    export typeset<A> : (Theme, bool, string) -> View<Binding<A>>
    typeset (theme, dark, spoken) = Wording(wordsLook = sized (theme, dark, bodyPoints, 400, Primary), wordsText = spoken)

    (** A picture fitted to its authored size, its alternative text carried as the fit hint. *)
    export image<A> : (string, string, int, int) -> View<Binding<A>>
    image (source, alt, width, height) = Fitted(fit = Fit(wide = toFloat width, tall = toFloat height, share = 0.0, traits = 0, edge = 0, hint = alt), fitted = Picture(pictureLook = carrier 0.0, pictureSource = source))

    (** A video's poster as a picture, its alternative text carried as the fit hint. *)
    export video<A> : (string, string) -> View<Binding<A>>
    video (poster, alt) = Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = alt), fitted = Picture(pictureLook = carrier 0.0, pictureSource = poster))
