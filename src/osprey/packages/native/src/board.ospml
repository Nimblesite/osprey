// Implements [UI-COMPONENTS-BOARD]: a writable board whose strokes the host
// holds, and the strokes and lassos it delivers.
namespace ui

(** One point of a stroke, in board points from the board's top-left corner. *)
type Point =
    pointX : int
    pointY : int

(** One finished stroke: its points in order, its width in points and the host clock in milliseconds when it ended ([UI-COMPONENTS-BOARD]). *)
type Stroke =
    strokePoints : List<Point>
    strokeWidth : int
    strokeAt : int

(** Typed constructors for writable boards ([UI-COMPONENTS-BOARD]). *)
module Boards
    (** A writable board drawing the `count` strokes the host holds in the slices `slice:0` to `slice:<count - 1>`, each a stroke the host keeps; each finished stroke is delivered once to `stroke`, and a lasso, offered only when `lassoing`, delivers the indices of the strokes it encloses to `lasso`. *)
    export board<A> : (string, int, bool, A, A) -> Node<A>
    board (slice, count, lassoing, stroke, lasso) = illustrated (slice, count, lassoing, "", stroke, lasso)

    (** A drawing board with an explicitly supplied reference image behind the retained strokes. *)
    export illustrated<A> : (string, int, bool, string, A, A) -> Node<A>
    illustrated (slice, count, lassoing, backdrop, stroke, lasso) = Board(boardSlice = slice, strokeCount = count, lassoEnabled = lassoing, boardBackdrop = backdrop, boardPanning = false, boardPanBinding = false, boardPan = stroke, stroke = stroke, lasso = lasso)

    (** A board camera drag reports its final absolute offsets to `pan` as `x,y`. *)
    export interactive<A> : (string, int, bool, string, bool, A, A, A) -> Node<A>
    interactive (slice, count, lassoing, backdrop, panning, stroke, lasso, pan) = Board(boardSlice = slice, strokeCount = count, lassoEnabled = lassoing, boardBackdrop = backdrop, boardPanning = panning, boardPanBinding = true, boardPan = pan, stroke = stroke, lasso = lasso)

(** Checks the board's strokes and lassos as a host delivers them ([UI-COMPONENTS-BOARD]); a malformed one is refused, never guessed. *)
module Strokes
    malformed = "A board control sent a malformed stroke"

    (** The stroke a host finished: its points, width and clock; an error when it has no points, a negative point, a width below one or a negative clock. *)
    export checked (points, width, at) = match Lists::any (points, \p => p.pointX < 0 || p.pointY < 0) || isEmpty points || width < 1 || at < 0
        true => Error(message = malformed)
        false => Success(value = Stroke(strokePoints = points, strokeWidth = width, strokeAt = at))

    (** The `Stroked` message for a stroke delivered to `action`. *)
    export bind (action, points, width, at) = match checked (points, width, at)
        Success stroke => Success(value = Stroked(stroker = action, stroked = stroke))
        Error problem => Error(message = problem)

    (** The `Lassoed` message for the stroke indices delivered to `action`; a negative index is refused. *)
    export lasso (action, indices) = match Lists::any (indices, \at => at < 0)
        true => Error(message = "A board control sent a lasso that is not a list of strokes")
        false => Success(value = Lassoed(lassoer = action, lassoed = indices))
