// Implements [NATIVE-SHM-LOWER]: the pure lowering of a semantic `Node<A>` tree into the
// primitive `View<Binding<A>>` the shared frame carries ([NATIVE-SHM-VIEW]). Every colour,
// size and space is decided here from the application's theme, so a host applies them and
// holds no style of its own. Each control delivers the `Binding` its node names, in drawing
// order, so a host event names a control by its number ([UI-EVENTS]).
namespace ui

import ui::Views
import ui::Lists
import ui::LowerLeaves

(** What lowering needs: the theme, whether the dark appearance is showing, and the regions a `Slot` may name. *)
type Styling A =
    styleTheme : Theme
    styleDark : bool
    styleRegions : List<KeyedSnapshot<Node<A>>>

(** Lowers a semantic node tree into primitive controls, every style value decided from the theme ([NATIVE-SHM-LOWER]). *)
module Lower
    // Metrics the native hosts drew, carried over unchanged: control heights, insets and corner radii in points.
    controlTall = 28.0
    pressInset = 12.0
    pressCorner = 8.0
    fieldInset = 6.0
    fieldCorner = 6.0
    fieldGap = 4.0
    sheetInset = 16.0
    sheetGap = 12.0
    sheetCorner = 12.0
    cardInset = 8.0
    cardGap = 8.0
    cardCorner = 8.0
    headGap = 2.0
    barGap = 6.0
    screenGap = 12.0
    rowGap = 2.0
    tabGap = 8.0
    symbolPoints = 12.0
    hairline = 1.0
    splitterWide = 6.0
    discloseGap = 6.0
    sharing = Fit(wide = 0.0, tall = 0.0, share = 1.0, traits = 0, edge = 0, hint = "")

    (** Lowers `node` and everything it contains; exhaustive, so a new component cannot lower by accident as something else. *)
    export view<A> : (Styling<A>, Node<A>) -> View<Binding<A>>
    view (styling, node) = match node
        Text content role tone => LowerLeaves::wording (styling.styleTheme, styling.styleDark, content, role, tone)
        RichText runs role => LowerLeaves::rich (styling.styleTheme, styling.styleDark, runs, role)
        Stack axis children => stacked (styling, axis, children)
        Section title footer children => sectioned (styling, title, footer, children)
        Screen title subtitle toolbar children => screened (styling, title, subtitle, toolbar, children)
        Split panes => Across(acrossLook = LowerLeaves::carrier 0.0, acrossItems = mapList (panes, \pane => paneView (styling, pane)))
        Layer children => Layered(layeredLook = LowerLeaves::carrier 0.0, layeredItems = lowered (styling, children))
        Framed style content => framedView (styling, style, content)
        Themed theme content => themedView (styling, theme, content)
        Dialog title body dismiss => dialogView (styling, title, body, dismiss)
        ContextMenu body actions => menuView (styling, body, actions)
        Aside side aside pane extent _ _ _ resize => asideView (styling, side, aside, pane, extent, resize)
        Tabs entries selected bind => tabsView (styling, entries, selected, bind)
        Slot key => slotView (styling, key)
        Pair label value => LowerLeaves::pair (styling.styleTheme, styling.styleDark, label, value)
        Badge label symbol tone => LowerLeaves::badge (styling.styleTheme, styling.styleDark, label, symbol, tone)
        Label label symbol => LowerLeaves::label (styling.styleTheme, styling.styleDark, label, symbol)
        Icon symbol => LowerLeaves::icon (styling.styleTheme, styling.styleDark, symbol)
        Link label address => LowerLeaves::link (styling.styleTheme, styling.styleDark, label, address)
        Spacer => Gap
        Divider => LowerLeaves::divider (styling.styleTheme, styling.styleDark)
        Segments tones _ => LowerLeaves::segments (styling.styleTheme, styling.styleDark, tones)
        Empty symbol title detail => LowerLeaves::empty (styling.styleTheme, styling.styleDark, symbol, title, detail)
        Progress label detail => LowerLeaves::progress (styling.styleTheme, styling.styleDark, label, detail)
        Meter label amount total tone => LowerLeaves::meter (styling.styleTheme, styling.styleDark, label, amount, total, tone)
        Swatch name light dark => LowerLeaves::swatch (styling.styleTheme, styling.styleDark, name, light, dark)
        Rows entries selected bind => rowsView (styling, entries, selected, bind)
        Button label symbol role enabled action => buttonView (styling, label, symbol, role, enabled, action)
        Field label value prompt secure multiline commit bind => fieldView (styling, label, value, prompt, secure, multiline, commit, bind)
        Toggle label on bind => Switch(switchLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::bodyPoints, 400, Primary), switchWords = label, switchOn = on, switchAction = FlagInput(action = bind))
        Picker label choices selected bind => pickerView (styling, label, choices, selected, bind)
        Disclosure title expanded bind children => disclosureView (styling, title, expanded, bind, children)
        Alert title message visible dismiss => alertView (styling, title, message, visible, dismiss)
        Typeset _ spoken => LowerLeaves::typeset (styling.styleTheme, styling.styleDark, spoken)
        Image source alt width height => LowerLeaves::image (source, alt, width, height)
        Video _ poster _ alt _ => LowerLeaves::video (poster, alt)
        Editor label value _ _ _ _ edit place => editorView (styling, label, value, edit, place)
        Board _ _ _ backdrop _ panBound pan stroke lasso => boardView (styling, backdrop, panBound, pan, stroke, lasso)
        Scene width height zoom atlas primitives play access => sceneView (Sketch(sketchWidth = width, sketchHeight = height, sketchZoom = zoom, sketchAtlas = atlas, sketchShapes = primitives, sketchAccess = access), play)

    lowered<A> : (Styling<A>, List<Node<A>>) -> List<View<Binding<A>>>
    lowered (styling, children) = mapList (children, \child => view (styling, child))

    // A context menu: its body shown, its actions held behind the menu gesture.
    menuView<A> : (Styling<A>, Node<A>, List<Node<A>>) -> View<Binding<A>>
    menuView (styling, body, actions) = Menu(menuLook = LowerLeaves::carrier 0.0, menuItems = listConcat [view (styling, body)] (lowered (styling, actions)))

    // One pane of a split: an equal share of the line.
    paneView<A> : (Styling<A>, Node<A>) -> View<Binding<A>>
    paneView (styling, pane) = Fitted(fit = sharing, fitted = view (styling, pane))

    // A scoped theme lowers its content with the theme the subtree inherits.
    themedView<A> : (Styling<A>, Theme, Node<A>) -> View<Binding<A>>
    themedView (styling, theme, content) = view (styling(styleTheme = theme), content)

    stacked<A> : (Styling<A>, Axis, List<Node<A>>) -> View<Binding<A>>
    stacked (styling, axis, children) = match axis
        Vertical => Column(columnLook = LowerLeaves::carrier (LowerLeaves::spaced styling.styleTheme), columnItems = lowered (styling, children))
        Horizontal => Across(acrossLook = LowerLeaves::carrier (LowerLeaves::spaced styling.styleTheme), acrossItems = lowered (styling, children))

    // `words` spoken in `look` above `items` when it is not empty.
    headed<A> : (string, Look, List<View<Binding<A>>>) -> List<View<Binding<A>>>
    headed (words, look, items) = match words == ""
        true => items
        false => listPrepend items (Wording(wordsLook = look, wordsText = words))

    // `words` spoken in `look` below `items` when it is not empty.
    footed<A> : (string, Look, List<View<Binding<A>>>) -> List<View<Binding<A>>>
    footed (words, look, items) = match words == ""
        true => items
        false => listAppend items (Wording(wordsLook = look, wordsText = words))

    sectioned<A> : (Styling<A>, string, string, List<Node<A>>) -> View<Binding<A>>
    sectioned (styling, title, footer, children) = Column(columnLook = Look(ink = 0, fill = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, "background"), points = 0.0, inset = cardInset, gap = cardGap, corner = cardCorner, heft = 400), columnItems = footed (footer, LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::captionPoints, 400, Secondary), headed (title, LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::captionPoints, 600, Secondary), lowered (styling, children))))

    screened<A> : (Styling<A>, string, string, List<Node<A>>, List<Node<A>>) -> View<Binding<A>>
    screened (styling, title, subtitle, toolbar, children) =
        heading = Column(columnLook = LowerLeaves::carrier headGap, columnItems = footed (subtitle, LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::bodyPoints, 400, Secondary), headed (title, LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::rolePoints Title, 600, Primary), [])))
        bar = Across(acrossLook = LowerLeaves::carrier barGap, acrossItems = listConcat (listConcat [heading] (lowered (styling, toolbar))) [Gap])
        Column(columnLook = LowerLeaves::carrier screenGap, columnItems = [bar, Scrolling(scrollLook = LowerLeaves::carrier (LowerLeaves::spaced styling.styleTheme), scrollItems = lowered (styling, children))])

    framedView<A> : (Styling<A>, FrameStyle, Node<A>) -> View<Binding<A>>
    framedView (styling, style, content) = Fitted(fit = frameFit (styling, style), fitted = Column(columnLook = frameLook (styling, style), columnItems = [view (styling, content)]))

    // A frame's dimensions and line: its authored size, its growth, and its line token as a border colour.
    frameFit (styling, style) = Fit(wide = toFloat style.frameWidth, tall = toFloat style.frameHeight, share = Pick::either (style.frameGrow, 1.0, 0.0), traits = Pick::either (style.frameFont == "mono", Views::fixedWidth, 0), edge = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, style.frameLine), hint = "")

    // A frame's surface: its fill token, radius, gap and top inset, and its authored text size.
    frameLook (styling, style) = Look(ink = 0, fill = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, style.frameFill), points = toFloat style.frameTextSize, inset = toFloat style.frameTop, gap = toFloat style.frameGap, corner = toFloat style.frameRadius, heft = 400)

    // A floating surface: the theme's background token with breathing room.
    sheetLook (styling) = Look(ink = 0, fill = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, "background"), points = 0.0, inset = sheetInset, gap = sheetGap, corner = sheetCorner, heft = 400)

    dialogView<A> : (Styling<A>, string, Node<A>, A) -> View<Binding<A>>
    dialogView (styling, title, body, dismiss) = Sheet(sheetLook = sheetLook (styling), sheetItems = listConcat [Wording(wordsLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::rolePoints Title, 600, Primary), wordsText = title)] [view (styling, body)], sheetDismiss = Tap(action = dismiss))

    // The wordings an alert shows: its title titled, its message quieter.
    alerted<A> : (Styling<A>, string, string) -> List<View<Binding<A>>>
    alerted (styling, title, message) = [
        Wording(wordsLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::rolePoints Title, 600, Primary), wordsText = title),
        Wording(wordsLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::bodyPoints, 400, Secondary), wordsText = message)]

    alertView<A> : (Styling<A>, string, string, bool, A) -> View<Binding<A>>
    alertView (styling, title, message, visible, dismiss) = Sheet(sheetLook = sheetLook (styling), sheetItems = shown (styling, title, message, visible), sheetDismiss = Tap(action = dismiss))

    // The wordings an alert shows while it is visible; hidden, it shows none, but its dismissal stays bound either way, as the encoder binds it.
    shown<A> : (Styling<A>, string, string, bool) -> List<View<Binding<A>>>
    shown (styling, title, message, visible) = match visible
        true => alerted (styling, title, message)
        false => []

    // The splitter between an aside and its pane: a hairline rule the host drags; a drag delivers the column's new width.
    splitter<A> : (Styling<A>, A) -> View<Binding<A>>
    splitter (styling, resize) = Fitted(fit = Fit(wide = splitterWide, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = ""), fitted = Layered(layeredLook = LowerLeaves::carrier 0.0, layeredItems = [
        Rule(ruleLook = Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Secondary), fill = 0, points = hairline, inset = 0.0, gap = 0.0, corner = 0.0, heft = 400)),
        Canvas(canvasLook = Views::plain, canvasAction = SizeInput(action = resize))]))

    asideView<A> : (Styling<A>, Side, Node<A>, Node<A>, int, A) -> View<Binding<A>>
    asideView (styling, side, aside, pane, extent, resize) =
        column = Fitted(fit = Fit(wide = toFloat extent, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = ""), fitted = view (styling, aside))
        content = Fitted(fit = sharing, fitted = view (styling, pane))
        match side
            Leading => Across(acrossLook = LowerLeaves::carrier 0.0, acrossItems = [column, splitter (styling, resize), content])
            Trailing => Across(acrossLook = LowerLeaves::carrier 0.0, acrossItems = [content, splitter (styling, resize), column])

    tabsView<A> : (Styling<A>, List<Tab<A>>, string, A) -> View<Binding<A>>
    tabsView (styling, entries, selected, bind) = Column(columnLook = LowerLeaves::carrier tabGap, columnItems = listConcat [Across(acrossLook = LowerLeaves::carrier barGap, acrossItems = tabRow (styling, entries, selected, bind, 0))] (pageOf (styling, entries, selected)))

    tabRow<A> : (Styling<A>, List<Tab<A>>, string, A, int) -> List<View<Binding<A>>>
    tabRow (styling, entries, selected, bind, index) = match listGet entries index
        Error _ => []
        Success tab => listConcat [tabView (styling, tab, selected, bind)] (tabRow (styling, entries, selected, bind, satAdd index 1))

    // The selected tab's page, or nothing when the chosen tab is unknown.
    pageOf<A> : (Styling<A>, List<Tab<A>>, string) -> List<View<Binding<A>>>
    pageOf (styling, entries, selected) = match Lists::find (entries, \tab => tab.tabKey == selected)
        Error _ => []
        Success tab => [view (styling, tab.page)]

    tabView<A> : (Styling<A>, Tab<A>, string, A) -> View<Binding<A>>
    tabView (styling, tab, selected, bind) =
        picked = tab.tabKey == selected
        Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = Pick::either (picked, Views::chosen, 0), edge = 0, hint = tab.tabKey), fitted = Press(pressLook = tabPress (styling, picked), pressWords = tab.tabLabel, pressAction = ChoiceInput(action = bind)))

    // A tab's press: the chosen tab is heavier on a ten-percent wash of the theme's ink.
    tabPress (styling, picked) = match picked
        true => Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), fill = LowerLeaves::wash (LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), LowerLeaves::picked), points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 600)
        false => Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), fill = 0, points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 400)

    rowsView<A> : (Styling<A>, List<Row<A>>, string, A) -> View<Binding<A>>
    rowsView (styling, entries, selected, bind) = Column(columnLook = LowerLeaves::carrier rowGap, columnItems = rowList (styling, entries, selected, bind, 0, ""))

    rowList<A> : (Styling<A>, List<Row<A>>, string, A, int, string) -> List<View<Binding<A>>>
    rowList (styling, entries, selected, bind, index, lastGroup) = match listGet entries index
        Error _ => []
        Success row => listConcat (listConcat (groupHeading (styling, row.rowGroup, lastGroup)) [rowView (styling, row, selected, bind)]) (rowList (styling, entries, selected, bind, satAdd index 1, row.rowGroup))

    // A group's heading, when the row opens a group the row before it did not belong to.
    groupHeading<A> : (Styling<A>, string, string) -> List<View<Binding<A>>>
    groupHeading (styling, group, lastGroup) = match group == "" || group == lastGroup
        true => []
        false => [Wording(wordsLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::captionPoints, 600, Secondary), wordsText = group)]

    rowView<A> : (Styling<A>, Row<A>, string, A) -> View<Binding<A>>
    rowView (styling, row, selected, bind) =
        picked = row.rowKey == selected
        Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = Pick::either (picked, Views::chosen, 0), edge = 0, hint = row.rowKey), fitted = Layered(layeredLook = LowerLeaves::carrier 0.0, layeredItems = [rowBody (styling, row), Press(pressLook = rowPress (styling, picked), pressWords = "", pressAction = ChoiceInput(action = bind))]))

    rowBody<A> : (Styling<A>, Row<A>) -> View<Binding<A>>
    rowBody (styling, row) = match row.rowSymbol == ""
        true => view (styling, row.cell)
        false => Across(acrossLook = LowerLeaves::carrier 8.0, acrossItems = [Wording(wordsLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, symbolPoints, 400, Secondary), wordsText = row.rowSymbol), view (styling, row.cell)])

    // A row's press: the selected row carries a ten-percent wash of the theme's ink; a resting row fills nothing.
    rowPress (styling, picked) = match picked
        true => Look(ink = 0, fill = LowerLeaves::wash (LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), LowerLeaves::picked), points = 0.0, inset = 0.0, gap = 0.0, corner = pressCorner, heft = 400)
        false => Look(ink = 0, fill = 0, points = 0.0, inset = 0.0, gap = 0.0, corner = pressCorner, heft = 400)

    slotView<A> : (Styling<A>, string) -> View<Binding<A>>
    slotView (styling, key) = match Lists::find (styling.styleRegions, \region => region.snapshotKey == key)
        Error _ => Column(columnLook = LowerLeaves::carrier 0.0, columnItems = [])
        Success region => view (styling, region.snapshotValue)

    buttonView<A> : (Styling<A>, string, string, ButtonRole, bool, A) -> View<Binding<A>>
    buttonView (styling, label, symbol, role, enabled, action) = Fitted(fit = Fit(wide = 0.0, tall = controlTall, share = 0.0, traits = Pick::either (enabled, 0, Views::disabled), edge = 0, hint = symbol), fitted = Press(pressLook = buttonLook (styling, role), pressWords = label, pressAction = Tap(action = action)))

    // A prominent or filled button's surface: the accent fill under its own ink.
    pressedLook (styling, inkName, fillName) = Look(ink = LowerLeaves::inkNamed (styling.styleTheme, styling.styleDark, inkName), fill = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, fillName), points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 400)

    // A button's surface by role: prominent and filled sit on the accent, destructive warns in its own ink, plain rests on a wash.
    buttonLook (styling, role) = match role
        Prominent => pressedLook (styling, "onAccent", "accent")
        Filled => pressedLook (styling, "onAccent", "accent")
        Destructive => Look(ink = LowerLeaves::inkNamed (styling.styleTheme, styling.styleDark, "danger"), fill = LowerLeaves::wash (LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), LowerLeaves::faint), points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 400)
        Plain => Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), fill = LowerLeaves::wash (LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), LowerLeaves::faint), points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 400)

    fieldView<A> : (Styling<A>, string, string, string, bool, bool, Commit, A) -> View<Binding<A>>
    fieldView (styling, label, value, prompt, secure, multiline, commit, bind) = match multiline
        true => Fitted(fit = fieldFit (prompt, secure, commit), fitted = Writing(writingLook = fieldLook (styling), writingText = value, writingAction = TextInput(action = bind)))
        false => Column(columnLook = LowerLeaves::carrier fieldGap, columnItems = headed (label, LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::captionPoints, 400, Secondary), [Fitted(fit = fieldFit (prompt, secure, commit), fitted = Typing(typingLook = fieldLook (styling), typingText = value, typingAction = TextInput(action = bind)))]))

    // A field's fit: its prompt as the hint, secret text hidden, and submitting fields committing on return only.
    fieldFit (prompt, secure, commit) = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = satAdd (Pick::either (secure, Views::secret, 0)) (commitTrait (commit)), edge = 0, hint = prompt)

    commitTrait commit = match commit
        OnSubmit => Views::onCommit
        OnEdit => 0

    fieldLook (styling) = Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Primary), fill = 0, points = LowerLeaves::bodyPoints, inset = fieldInset, gap = 0.0, corner = fieldCorner, heft = 400)

    pickerView<A> : (Styling<A>, string, List<Choice>, string, A) -> View<Binding<A>>
    pickerView (styling, label, choices, selected, bind) = Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = label), fitted = Choosing(choosingLook = Look(ink = LowerLeaves::inkTone (styling.styleTheme, styling.styleDark, Secondary), fill = 0, points = LowerLeaves::bodyPoints, inset = pressInset, gap = 0.0, corner = pressCorner, heft = 400), choosingWords = chosenLabel (choices, selected), choosingOptions = mapList (choices, \choice => Option(optionLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::bodyPoints, 400, Primary), optionWords = choice.choiceLabel, optionKey = choice.choiceKey, optionChosen = choice.choiceKey == selected)), choosingAction = ChoiceInput(action = bind)))

    // The label of the chosen choice, or the raw key when it names none.
    chosenLabel (choices, selected) = match Lists::find (choices, \choice => choice.choiceKey == selected)
        Success choice => choice.choiceLabel
        Error _ => selected

    disclosureView<A> : (Styling<A>, string, bool, A, List<Node<A>>) -> View<Binding<A>>
    disclosureView (styling, title, expanded, bind, children) = Column(columnLook = LowerLeaves::carrier discloseGap, columnItems = listConcat [Fitted(fit = Fit(wide = 0.0, tall = controlTall, share = 0.0, traits = 0, edge = 0, hint = ""), fitted = Press(pressLook = LowerLeaves::sized (styling.styleTheme, styling.styleDark, LowerLeaves::bodyPoints, 400, Secondary), pressWords = title, pressAction = FlagInput(action = bind)))] (revealed (styling, expanded, children)))

    // The children an expanded disclosure reveals; a closed one shows none.
    revealed<A> : (Styling<A>, bool, List<Node<A>>) -> List<View<Binding<A>>>
    revealed (styling, expanded, children) = match expanded
        true => lowered (styling, children)
        false => []

    editorView<A> : (Styling<A>, string, string, A, A) -> View<Binding<A>>
    editorView (styling, label, value, edit, place) = Fitted(fit = Fit(wide = 0.0, tall = 0.0, share = 0.0, traits = 0, edge = 0, hint = label), fitted = Layered(layeredLook = LowerLeaves::carrier 0.0, layeredItems = [
        Writing(writingLook = fieldLook (styling), writingText = value, writingAction = TextInput(action = edit)),
        Canvas(canvasLook = Views::plain, canvasAction = PlaceInput(action = place))]))

    boardView<A> : (Styling<A>, string, bool, A, A, A) -> View<Binding<A>>
    boardView (styling, backdrop, panBound, pan, stroke, lasso) = Layered(layeredLook = boardLook (styling, backdrop), layeredItems = listConcat [
        Canvas(canvasLook = boardLook (styling, backdrop), canvasAction = StrokeInput(action = stroke)),
        Canvas(canvasLook = Views::plain, canvasAction = LassoInput(action = lasso))] (panned (panBound, pan)))

    // A panning board's camera binding, third after its strokes and lasso, as the encoder issues it.
    panned<A> : (bool, A) -> List<View<Binding<A>>>
    panned (panBound, pan) = match panBound
        true => [Canvas(canvasLook = Views::plain, canvasAction = TextInput(action = pan))]
        false => []

    // A board's surface: its backdrop token under its chalk ink ([UI-THEME-BOARD]).
    boardLook (styling, backdrop) = Look(ink = LowerLeaves::inkNamed (styling.styleTheme, styling.styleDark, "chalk"), fill = LowerLeaves::fillNamed (styling.styleTheme, styling.styleDark, backdrop), points = 0.0, inset = 0.0, gap = 0.0, corner = 0.0, heft = 400)

    // A scene is a canvas that streams its sketch beside its row ([NATIVE-SHM-SCENE]).
    sceneView<A> : (Sketch, A) -> View<Binding<A>>
    sceneView (content, play) = Fitted(fit = sceneFit (content.sketchWidth, content.sketchHeight, content.sketchZoom), fitted = Drawing(drawingLook = LowerLeaves::carrier 0.0, drawingSketch = content, drawingAction = SceneInput(action = play)))

    // A scene's extent: a positive zoom fixes its pixels, one unit to `zoom` of them; a zero zoom fits the region whole.
    sceneFit (width, height, zoom) = match zoom > 0.0
        true => Fit(wide = width * zoom, tall = height * zoom, share = 0.0, traits = 0, edge = 0, hint = "")
        false => Fit(wide = 0.0, tall = 0.0, share = 1.0, traits = 0, edge = 0, hint = "")
