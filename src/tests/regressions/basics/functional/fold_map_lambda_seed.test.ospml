(** A fold seeded with an empty `Map()` and stepped by an inline lambda learns
    the map's value type only from the lambda body. The lambda's accumulator
    parameter used to arrive untagged, so `mapGet(m, p) ?: []` read the stored
    list as an integer word and codegen rejected the `?:` ("match arms disagree
    on type"). Implements [BUILTIN-LIST-FOLD] and [PATTERN-RESULT-DEFAULT]. *)
grouped paths = foldList paths (Map ()) (\(m, p) => mapSet m p (listAppend (mapGet m p ?: []) p))

inline = foldList ["x", "y", "x"] (Map ()) (\(m, p) => mapSet m p (listAppend (mapGet m p ?: ["seen"]) p))
joined = foldList ["a", "b", "a"] (Map ()) (\(m, p) => mapSet m p "${mapGet m p ?: ""}${p}")

print (join (mapGet (grouped ["a", "b", "a"]) "a" ?: []) ",")
print (join (mapGet inline "x" ?: []) ",")
print (mapGet joined "a" ?: "")
