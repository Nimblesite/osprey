/// A `Result` whose payload is a list literal is a heap aggregate the literal
/// escapes into, so `Success { value: [] }` stores the runtime list layout. A
/// fold seeded with it and stepped by a named function used to read the flat
/// literal as a runtime list and segfault. Implements [BUILTIN-LIST-FOLD] and
/// [BUILTIN-LIST-APPEND].

fn step(acc, line) = match acc {
    Success { value } => match line == "" {
        true => Error { message: "blank line" }
        false => Success { value: listAppend(value, line) }
    }
    Error { message } => Error { message: message }
}

fn shown(parsed) = match parsed {
    Success { value } => "${toString(length(value))}:${join(value, ",")}"
    Error { message } => message
}

/// Nested Results must preserve the record payload while accumulating a list.
type FoldEntry = { key: string }
fn makeEntry(ok) = match ok {
    true => Success { value: FoldEntry { key: "ok" } }
    false => Error { message: "no" }
}
fn appendEntry(pending, request) = match pending {
    Error { message } => Error { message: message }
    Success { values } => match request {
        Error { message } => Error { message: message }
        Success { item } => Success { value: listAppend(values, item) }
    }
}
fn entryCount(items) = match foldList(items, Success { value: [] }, appendEntry) {
    Error { message } => message
    Success { entries } => "${listLength(entries)}"
}

print("${shown(foldList(["a", "b", "c"], Success { value: [] }, step))}\n${shown(foldList(["x"], Success { value: ["seed"] }, step))}\n${shown(foldList(["a", "", "c"], Success { value: [] }, step))}\n${entryCount([makeEntry(true)])}|${entryCount([makeEntry(false)])}")
