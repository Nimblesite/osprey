// #278: A mutually recursive generic group is generalized together.

namespace demo

type Tree T =
    Leaf
        item : T
    Node
        kids : List<Tree<T>>

module Walk
    kid<T> : (List<T>, List<Tree<T>>, int) -> List<T>
    kid (out, kids, index) = listConcat out (all (listGet kids index ?: Node(kids = [])))

    export all<T> : Tree<T> -> List<T>
    all tree = match tree
        Leaf item => [item]
        Node kids => range (0, length kids) |> fold [] (\(out, index) => kid (out, kids, index))

print "${length (Walk::all (Node(kids = [Leaf(item = 1), Leaf(item = 2)])))} ${join (Walk::all (Leaf(item = "x"))) ","}"
