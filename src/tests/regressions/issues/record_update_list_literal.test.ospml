// #293: A record update whose value is a list literal of records keeps its items.

type Item =
    name : string
    size : int

type Box =
    items : List<Item>
    note : string

shown box = match listGet box.items 0
    Success item => "${item.name}:${item.size}"
    Error _ => "none"

store box = box(items = [Item(name = "notes", size = 3)])

test ("an inline record in a list literal in a record update", \() =>
    expect (shown (store (Box(items = [], note = ""))), "notes:3"))
