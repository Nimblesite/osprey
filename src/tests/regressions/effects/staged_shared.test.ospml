(** Exact-value tests record any arithmetic fault as a failed assertion. *)
exactArithmetic work =
    handle Arith
        overflow op _ _ wrapped =>
            check "unexpected arithmetic overflow" "none" op
            wrapped
        divideByZero op _ =>
            check "unexpected zero divisor" "none" op
            0.0
        remainderByZero _ =>
            expectFalse true
            0
    work ()

// [STAGE-POLY] [STAGE-POLY-ERASURE] [STAGE-COMPAT] The same higher-order
// definition serves static Scale and dynamic Audit in one program. Source
// contracts are validated before specialization; the residual program is
// checked again. Both flavors share the same golden.

static effect Scale
    (** Compile-time scale factor. Rewritten away; never reaches the runtime. *)
    by : Unit => int

effect Audit
    (** Runtime note, dispatched through the handler stack as it always has been. *)
    control note : string => Unit

(** The shared definition. No annotation names a stage, a row or a type. *)
twice f x = f (f x)

scaled n = n * perform Scale.by () 

counted n =
    perform Audit.note "n=${n}"
    n + 1 

(** Static instantiation: the row is empty after discharge, so this call is
    GPU-legal and leaves no handler registration behind ([STAGE-RESIDUE]). *)
staticTotal =
    exactArithmetic (\() =>
        handle static Scale
            by => 3
        twice scaled 2)

mut trail = ""

(** Dynamic instantiation of the SAME `twice`, in the same program. *)
dynamicTotal =
    exactArithmetic (\() =>
        handle Audit
            note message =>
                trail := "${trail}[${message}]"
                resume ()
        twice counted 0)


test "one unannotated function serves both stages in one program" (\() => exactArithmetic ((\() => checkAll "stage polymorphism" [
    staticTotal == 18,
    dynamicTotal == 2,
    trail == "[n=0][n=1]"
])))

static effect Live T
    read : Unit => T
liveLabel () =
    value = perform Live<int>.read ()
    perform Audit.note "live=${value};"
    "live=${value}"
fiberLabel () = await (spawn (liveLabel ()))
reactiveFibersAndContinuations () =
    mut log = ""
    handle Audit
        note message =>
            log := "${log}${message}"
            resume ()
    first =
        handle static Live<int>
            read => 3
        signalSnapshot fiberLabel
    idle =
        handle static Live<int>
            read => 99
        signalRefresh first [] fiberLabel
    next =
        handle static Live<int>
            read => 7
        signalRefresh idle (signalDependencies liveLabel) fiberLabel
    checkAll "reactive rebuild crosses fibers and deep resume" [
        first.value == "live=3", idle.value == "live=3", next.value == "live=7",
        first.revision == 1, idle.revision == 1, next.revision == 2,
        log == "live=3;live=7;"
    ]
test "reactive rebuilds compose static signals with fibers and continuations" reactiveFibersAndContinuations
