test "division by zero 001" (\() => verify ((\() => (37 / 0)), -0.5, "zero(/,37.0);"))
test "remainder by zero 001" (\() => verify ((\() => (37 % 0)), 0, "remainder(37);"))
test "division by zero 002" (\() => verify ((\() => (74 / 0)), -0.5, "zero(/,74.0);"))
test "remainder by zero 002" (\() => verify ((\() => (74 % 0)), 0, "remainder(74);"))
test "division by zero 003" (\() => verify ((\() => (111 / 0)), -0.5, "zero(/,111.0);"))
test "remainder by zero 003" (\() => verify ((\() => (111 % 0)), 0, "remainder(111);"))
test "division by zero 004" (\() => verify ((\() => (148 / 0)), -0.5, "zero(/,148.0);"))
test "remainder by zero 004" (\() => verify ((\() => (148 % 0)), 0, "remainder(148);"))
