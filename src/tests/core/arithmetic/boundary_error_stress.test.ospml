// Every original case now checks both the value and the complete ordered fault payloads.

(** Boundary operands cross a function call so runtime dispatch is exercised. *)
runtimeValue n = n
negateValue n = -n

verify (work, expected, wantedFaults) =
    mut faults = ""
    handle Arith
        overflow op lhs rhs wrapped =>
            faults := faults + "overflow(${op},${lhs},${rhs},${wrapped});"
            wrapped
        divideByZero op lhs =>
            faults := faults + "zero(${op},${lhs});"
            -0.5
        remainderByZero lhs =>
            faults := faults + "remainder(${lhs});"
            0
    expect (work ()) expected
    expect faults wantedFaults

test "maximum minus delta 001" (\() => verify ((\() => ((runtimeValue (9223372036854775807)) - 1)), 9223372036854775806, ""))
test "maximum restored after subtraction 001" (\() => verify ((\() => (((runtimeValue (9223372036854775807)) - 1) + 1)), 9223372036854775807, ""))
test "maximum intermediate then overflow 001" (\() => verify ((\() => ((((runtimeValue (9223372036854775807)) - 1) + 1) + 1)), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
test "minimum plus delta 001" (\() => verify ((\() => (((0 - (runtimeValue (9223372036854775807))) - 1) + 1)), -9223372036854775807, ""))
test "maximum minus delta 002" (\() => verify ((\() => ((runtimeValue (9223372036854775807)) - 2)), 9223372036854775805, ""))
test "maximum restored after subtraction 002" (\() => verify ((\() => (((runtimeValue (9223372036854775807)) - 2) + 2)), 9223372036854775807, ""))
test "maximum intermediate then overflow 002" (\() => verify ((\() => ((((runtimeValue (9223372036854775807)) - 2) + 2) + 1)), -9223372036854775808, "overflow(+,9223372036854775807,1,-9223372036854775808);"))
