test "remainder by zero 005" (\() => verify ((\() => (185 % 0)), 0, "remainder(185);"))
test "division by zero 006" (\() => verify ((\() => (6.5 / 0.0)), -0.5, "zero(/,6.5);"))
test "remainder by zero 006" (\() => verify ((\() => (6.5 % 0.0)), -0.5, "zero(%,6.5);"))
test "division by zero 007" (\() => verify ((\() => (7.5 / 0.0)), -0.5, "zero(/,7.5);"))
test "remainder by zero 007" (\() => verify ((\() => (7.5 % 0.0)), -0.5, "zero(%,7.5);"))
