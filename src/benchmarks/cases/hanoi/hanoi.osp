// Towers of Hanoi — count moves via exponential double recursion. hanoi(n)=2^n-1.
fn add(a, b) = a + b
fn sub(a, b) = a - b
fn hanoi(n, acc) = match n {
    0 => acc
    _ => hanoi(sub(n, 1), add(hanoi(sub(n, 1), acc), 1))
}
fn main() = {
    handle Arith { overflow _ _ _ wrapped => {
            print("unexpected integer overflow")
            wrapped
        } }
    print("${hanoi(25, 0)}")
}
