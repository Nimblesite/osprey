// ML-flavor twin of binarytrees.osp: every fallible arithmetic site runs under
// the same explicit Arith policy as the Default flavor ([FLAVOR-IR-EQUIV]).

type Tree = Leaf | Node Tree Tree

make d = match d
    0 => Node Leaf Leaf
    _ => Node (make (d - 1)) (make (d - 1))

check t = match t
    Leaf => 0
    Node l r => 1 + check l + check r

main () =
    mut fault = ""
    handle Arith
        overflow op _ _ wrapped =>
            fault := op
            wrapped
    answer = range 0 1200 |> fold 0 (\(acc, _) => acc + check (make 13))
    rendered = match fault == ""
        true => "${answer}"
        false => "arithmetic fault ${fault}"
    print rendered
