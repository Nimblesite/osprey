namespace registry;
import registry::Checked
import registry::TomlLexer
import registry::Toml
import registry::TomlTree
import registry::TomlValues

/// Statements of the TOML subset: `[table]` and `[[array-of-tables]]`
/// headers, key/value lines, and the document loop that folds them into a
/// root table. Fails are located reason codes from `Toml::fail`. Implements
/// [PACKAGE-MANIFEST].
module TomlParser {
    type Step = { doc: TomlTree::Doc, at: TomlLexer::Cursor }

    /// The span of a table header is the `[` itself, so a manifest error
    /// names the header's line and column rather than the key after it.
    fn headerSegs(segs, start) = mapList(segs, fn(s) => TomlValues::KeySeg { name: s.name, span: Toml::spanOf(start) })

    // -- statements ---------------------------------------------------------

    fn expectClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == TomlValues::byteRBracket {
            true => Success { value: TomlLexer::advance(c1) }
            false => Error { message: Toml::fail(c1, "toml.unexpected-token") }
        }
    }

    fn expectDoubleClose(c) = {
        let c1 = TomlLexer::skipSpaces(c)
        match TomlLexer::cur(c1) == TomlValues::byteRBracket && TomlLexer::peek(c1, 1) == TomlValues::byteRBracket {
            true => Success { value: TomlLexer::advance(TomlLexer::advance(c1)) }
            false => Error { message: Toml::fail(c1, "toml.unexpected-token") }
        }
    }

    fn parseStatement(doc, c) = match TomlLexer::cur(c) == TomlValues::byteLBracket {
        true => parseHeader(doc, c)
        false => parseKeyValue(doc, c)
    }

    fn parseHeader(doc, c) = {
        let c1 = TomlLexer::advance(c)
        match TomlLexer::cur(c1) == TomlValues::byteLBracket {
            true => parseArrayHeader(doc, TomlLexer::advance(c1), c)
            false => parseTableHeader(doc, c1, c)
        }
    }

    fn parseTableHeader(doc, c, start) = Checked::andThen(TomlValues::parseKeyPath(c), fn(value) => tableHeaderClose(doc, value, start))

    fn tableHeaderClose(doc, path, start) = Checked::andThen(expectClose(path.at), fn(value) => tableHeaderTail(doc, path, value, start))

    fn tableHeaderTail(doc, path, close, start) = Checked::andThen(TomlLexer::skipLineTail(close), fn(value) => tableHeaderDefine(doc, path, value, start))

    fn tableHeaderDefine(doc, path, tail, start) = {
        let segs = headerSegs(path.segs, start)
        Checked::andThen(TomlTree::defineTable(doc, segs), fn(value) => Success { value: Step { doc: value, at: tail } })
    }

    fn parseArrayHeader(doc, c, start) = Checked::andThen(TomlValues::parseKeyPath(c), fn(value) => arrayHeaderClose(doc, value, start))

    fn arrayHeaderClose(doc, path, start) = Checked::andThen(expectDoubleClose(path.at), fn(value) => arrayHeaderTail(doc, path, value, start))

    fn arrayHeaderTail(doc, path, close, start) = Checked::andThen(TomlLexer::skipLineTail(close), fn(value) => arrayHeaderDefine(doc, path, value, start))

    fn arrayHeaderDefine(doc, path, tail, start) = {
        let segs = headerSegs(path.segs, start)
        Checked::andThen(TomlTree::defineArrayTable(doc, segs), fn(value) => Success { value: Step { doc: value, at: tail } })
    }

    fn parseKeyValue(doc, c) = Checked::andThen(TomlValues::parseKeyPath(c), fn(value) => kvEquals(doc, value))

    fn kvEquals(doc, path) = Checked::andThen(TomlValues::expectEquals(path.at), fn(value) => kvValue(doc, path, value))

    fn kvValue(doc, path, eq) = {
        let c1 = TomlLexer::skipSpaces(eq)
        match TomlValues::missingValueAt(c1) {
            true => Error { message: Toml::fail(c1, "toml.expected-value") }
            false => Checked::andThen(TomlValues::parseValue(c1), fn(value) => kvTail(doc, path, value))
        }
    }

    fn kvTail(doc, path, v) = Checked::andThen(TomlLexer::skipLineTail(v.at), fn(value) => kvInsert(doc, path, v.value, value))

    fn kvInsert(doc, path, val, tail) = Checked::andThen(TomlTree::insertAtFocus(doc, path.segs, val), fn(value) => Success { value: Step { doc: value, at: tail } })

    fn parseDocument(doc, c) = {
        let c1 = TomlLexer::skipTrivia(c)
        match TomlLexer::eof(c1) {
            true => Success { value: doc.root }
            false => Checked::andThen(parseStatement(doc, c1), fn(value) => parseDocument(value.doc, value.at))
        }
    }

    /// Parse a TOML document into its root table, or the first problem.
    export fn parse(text) -> Result<Toml::Value, Toml::Problem> = parseDocument(TomlTree::emptyDoc, TomlLexer::start(text))
}
