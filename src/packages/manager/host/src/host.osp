namespace registry_host;

/// The host boundary of the package system. Commands perform these effects;
/// `Native` answers them with the operating system and tests answer them with
/// fixtures. Handlers carry no policy. Implements [PACKAGE-ARCHITECTURE].
module Host {
    /// One finished child process.
    export type Run = { status: int, stdout: string, stderr: string }

    /// `text` as one single-quoted shell word. Every path or name a handler
    /// or a command places in a shell command goes through here, so no
    /// manifest, lock or command-line string reaches the shell unquoted
    /// ([PACKAGE-HARDENING] C6).
    export fn shellWord(text) = "'" + (replace(text, "'", "'\\''") ?: text) + "'"

    /// Whole-file reads and writes; failures carry the OS reason.
    export effect Files {
        read: fn(string) -> Result<string, string>
        write: fn(string, string) -> Result<int, string>
        exists: fn(string) -> Result<bool, string>
        remove: fn(string) -> Result<int, string>
    }

    export type Snapshot = { present: bool, text: string }

    /// Preserve absence separately from a readable empty file; unreadable
    /// existing files refuse the mutation instead of becoming empty snapshots.
    export fn snapshot(path) = match perform Files.exists(path) {
        Error { message } => Error { message: message }
        Success { value } => if !value { Success { value: Snapshot { present: false, text: "" } } } else {
            match perform Files.read(path) {
                Error { message } => Error { message: message }
                Success { value } => Success { value: Snapshot { present: true, text: value } }
            }
        }
    }

    export fn restore(path, previous: Snapshot) = if previous.present { perform Files.write(path, previous.text) } else { perform Files.remove(path) }

    /// Every non-directory entry under a root, by path relative to it:
    /// single-link regular files, single-link executable files, and anything else (hard links, symlinks,
    /// devices, sockets, fifos), each sorted by unsigned bytes.
    export type Walk = { regular: List<string>, executable: List<string>, special: List<string> }

    /// Directory walks and `mkdir -p`; failures carry the OS reason. Implements the catalog
    /// walk of [PACKAGE-FOLDER-REGISTRY].
    export effect Tree {
        walk: fn(string) -> Result<Walk, string>
        ensure: fn(string) -> Result<int, string>
    }

    /// One HTTP response: status, strong ETag or `""`, and body text.
    export type Reply = { status: int, etag: string, body: string }

    /// HTTP GET against a base URL such as `http://127.0.0.1:8787`; a
    /// transport failure carries `http.transport` and the reason.
    export effect Web {
        get: fn(string, string) -> Result<Reply, string>
    }

    /// Run one shell command to completion and capture its streams.
    export effect Process {
        run: fn(string) -> Run
    }

    /// Terminal output, one line at a time.
    export effect Console {
        line: fn(string) -> Unit
    }
}
