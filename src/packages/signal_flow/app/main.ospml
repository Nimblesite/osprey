// The signal-flow editor's C boundary for the GPUI host ([GPUI-HOST-BOUNDARY],
// [UI-RESIDENT]). The session stays in this library between calls and canvas
// primitives go to the host one call at a time ([UI-SCENE-STREAM]).

import ui::Runtime
import signalflow::App
import ui::Streams

extern native_slice (key : string) -> string

extern native_shape (code : int) (index : int) (a : float) (b : float) (c : float) (d : float) (e : float) (tint : int) (layer : int) -> int

(** Hands the session the framework returned to the cell below. *)
effect Keep
    keep : ui::Session<signalflow::Store> => Unit

mut live = Runtime::idle (signalflow::Flow::store (ui::MachineDocs::faulty ""))

mut streamed = 0

// [UI-SCENE-STREAM] Each streamed rect, disc or sprite goes straight to the host.
shipped primitive = Streams::transmit (primitive, native_shape)

keeping (done : ui::Resident<signalflow::Store>) =
    perform Keep.keep done.residentSession
    done.residentEnvelope

hosted work =
    handle Keep
        keep session => live := session
    handle ui::Slices
        fetch key => native_slice key
    handle ui::SceneStream
        shape primitive => streamed := shipped primitive
    Runtime::guarded (\() => keeping (work ()))

start source = hosted (\() => Runtime::begin (source, App::initial, App::regions, App::theme ("")))

dispatch (_saved : string, event) = hosted (\() => Runtime::proceed (live, event, App::update, App::regions))
