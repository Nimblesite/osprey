// The live-attach fixture's ML twin [PROF-ATTACH-ENDPOINT]: the same program
// as live_attach.osp, so the live profiler is proven on both flavors. It burns
// CPU in `spin` far longer than any test runs, and each leaf formats its
// argument, so some of the time is spent in the C runtime's own frames.
add a b = a + b
sub a b = a - b
leaf n = length (toString n)

spin n = match n
    0 => 0
    1 => leaf n
    _ => add (spin (sub n 1)) (spin (sub n 2))

main () =
    handle Arith
        overflow _ _ _ wrapped => wrapped
    print "${spin 48}"
