{
  "compilerOptions": {
    "module": "es2020",
    "moduleResolution": "bundler",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "outDir": "out/webview",
    "rootDir": "client/src/osprey-ui",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["client/src/osprey-ui/webview/**/*.ts", "client/src/osprey-ui/generated/**/*.ts"]
}
