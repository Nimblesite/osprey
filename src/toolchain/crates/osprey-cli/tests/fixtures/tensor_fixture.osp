// Reads transformer.safetensors beside this file; `@FIXTURE@` is replaced
// with the absolute path by tensor_fixture.rs before the program runs.
fn at(b, i) = gpuGet(b, i) ?: toFloat32(0.0)
fn four(b) = "${at(b, 0)} ${at(b, 1)} ${at(b, 2)} ${at(b, 3)}"
fn outcome(r) = match r {
    Success { value } => four(value)
    Error { message } => message
}
fn main() = match gpuLoadTensor("@FIXTURE@", "w") {
    Success { value } => {
        let w = value
        match gpuLoadTensor("@FIXTURE@", "h.1.b") {
            Success { value } => {
                let bias = value
                match gpuLoad("@FIXTURE@", 124, 4) {
                    Success { value } => {
                        let raw = value
                        match gpuMatMul(w, w, 2, 2, 2) {
                            Success { value } => print("w ${four(w)}\nbias ${gpuGet(bias, 0) ?: toFloat16(0.0)} ${gpuGet(bias, 1) ?: toFloat16(0.0)}\nmissing ${outcome(gpuLoadTensor("@FIXTURE@", "h.11.b"))}\nraw ${four(raw)}\nsquare ${four(value)}")
                            Error { message } => print(message)
                        }
                    }
                    Error { message } => print(message)
                }
            }
            Error { message } => print(message)
        }
    }
    Error { message } => print(message)
}
