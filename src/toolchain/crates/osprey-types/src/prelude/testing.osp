//! The policy test programs install around exact-value work. Every program
//! that names it gets this file compiled beside it, so no test declares its
//! own copy; a program that declares its own `exactArithmetic` keeps it.
//! Installing it is still explicit and by name ([ARITH-TOTAL]): it is never
//! ambient. Implements [TESTING-ARITH-POLICY].

/// Runs `work` and records any arithmetic fault in it as a failed assertion
/// that names the operator, so an exact-value test cannot pass on a wrapped
/// or substituted value.
fn exactArithmetic(work) = {
    handle Arith {
        overflow op _ _ wrapped => {
            check("unexpected arithmetic overflow", "none", op)
            wrapped
        }
        divideByZero op _ => {
            check("unexpected zero divisor", "none", op)
            0.0
        }
        remainderByZero _ => {
            expectFalse(true)
            0
        }
    }
    work()
}

/// Runs `work` on the value of a successful GPU operation; a failed one fails
/// the case with its reason before the consumer runs. [FAILURE-EXPLICIT]
fn withBuffer(result, work) = match result {
    Success { value } => work(value)
    Error { message } => check("GPU operation", "success", toString(message))
}

/// Whether a successful GPU operation's value satisfies `predicate`; a failed
/// one fails the case with its reason and the predicate. [FAILURE-EXPLICIT]
fn gpuSatisfies(result, predicate) = match result {
    Success { value } => predicate(value)
    Error { message } => {
        check("GPU operation", "success", toString(message))
        false
    }
}

/// Runs `work` on the indices `0..n` on the GPU, or fails the case.
fn withIndices(n, work) = withBuffer(gpuIota(n), work)

/// The reason `gpuIota(n)` fails, or the length it unexpectedly produced.
fn iotaError(n) = match gpuIota(n) {
    Success { value } => "unexpected success ${gpuLength(value)}"
    Error { message } => toString(message)
}

/// Whether `text` contains every one of `parts`; true for no parts.
fn containsAll(text, parts) = foldList(parts, true, fn(found, part) => found && contains(text, part))

/// Whether `text` contains none of `parts`; true for no parts.
fn containsNone(text, parts) = foldList(parts, true, fn(absent, part) => absent && !contains(text, part))
