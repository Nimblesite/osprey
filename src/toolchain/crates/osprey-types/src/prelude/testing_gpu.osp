//! The GPU helpers test programs share. A unit of its own: these match on the
//! built-in `Success`, so a program that declares its own `Success` variant and
//! names only the arithmetic policy must not receive them. Implements
//! [TESTING-ARITH-POLICY].

/// Fails the case with the reason a GPU operation reported. [FAILURE-EXPLICIT]
fn gpuFailed(message) = check("GPU operation", "success", toString(message))

/// Runs `work` on the value of a successful GPU operation; a failed one fails
/// the case with its reason before the consumer runs. [FAILURE-EXPLICIT]
fn withBuffer(result, work) = match result {
    Success { value } => work(value)
    Error { message } => gpuFailed(message)
}

/// Whether a successful GPU operation's value satisfies `predicate`; a failed
/// one fails the case with its reason and the predicate. [FAILURE-EXPLICIT]
fn gpuSatisfies(result, predicate) = match result {
    Success { value } => predicate(value)
    Error { message } => {
        gpuFailed(message)
        false
    }
}

/// Whether a successful GPU operation's value equals `expected`; a failed one
/// fails the case with its reason. [FAILURE-EXPLICIT]
fn gpuEquals(result, expected) = gpuSatisfies(result, fn(value) => value == expected)

/// Whether a successful GPU operation's buffer holds `expected` elements; a
/// failed one fails the case with its reason. [FAILURE-EXPLICIT]
fn gpuLengthIs(result, expected) = gpuSatisfies(result, fn(buffer) => gpuLength(buffer) == expected)

/// Runs `work` on the indices `0..n` on the GPU, or fails the case.
fn withIndices(n, work) = withBuffer(gpuIota(n), work)

/// The reason `gpuIota(n)` fails, or the length it unexpectedly produced.
fn iotaError(n) = match gpuIota(n) {
    Success { value } => "unexpected success ${gpuLength(value)}"
    Error { message } => toString(message)
}

/// Whether `buffer` holds `expected` elements.
fn lengthIs(buffer, expected) = gpuLength(buffer) == expected

/// Whether element `index` of `buffer` is `expected`; an out-of-bounds read
/// compares `fallback` instead, so a missing element fails unless it is meant to.
fn elementIs(buffer, index, fallback, expected) = (gpuGet(buffer, index) ?: fallback) == expected

/// Whether uploading an empty list yields an empty buffer.
fn emptyUploads() = gpuSatisfies(toGpu([]), fn(empty: GpuBuffer<int>) => lengthIs(empty, 0))

/// The reason a bounds-checked GPU read reports for an index past the end.
fn oobMessage() = "gpuGet: index out of bounds"

/// Whether element `indices[k]` of `buffer` is `expected[k]` for every k, each
/// read compared as `elementIs` compares it.
fn elementsAt(buffer, fallback, indices, expected) = match indices {
    [] => true
    [index, ...rest] => match expected {
        [] => false
        [head, ...tail] => elementIs(buffer, index, fallback, head) && elementsAt(buffer, fallback, rest, tail)
    }
}

/// Whether `buffer` holds `expected` from `index` on, element by element, each
/// read compared as `elementIs` compares it.
fn elementsFrom(buffer, index, fallback, expected) = match expected {
    [] => true
    [head, ...tail] => elementIs(buffer, index, fallback, head) && elementsFrom(buffer, index + 1, fallback, tail)
}

/// The sum step GPU folds and scans share: `a + x` over whatever numeric width
/// the buffer carries.
fn addF(a, x) = a + x

/// Whether a host list holds `expected` elements.
fn listLengthIs(values, expected) = listLength(values) == expected

/// Whether element `index` of a host list is `expected`, comparing `fallback`
/// when the index misses.
fn listHolds(values, index, fallback, expected) = (listGet(values, index) ?: fallback) == expected

/// Whether folding `buffer` from `seed` with `addF` totals `expected`.
fn floatSumsTo(buffer, seed, expected) = gpuSatisfies(gpuFold(buffer, seed, addF), fn(total) => total == expected)
