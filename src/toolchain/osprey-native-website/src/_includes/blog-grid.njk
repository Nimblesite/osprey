{% macro blogGrid(posts) %}
<div class="blog-grid">
  {% for post in posts %}
  <article class="blog-card">
    {% if post.data.image %}
    <a href="{{ post.url }}" class="blog-card-media" tabindex="-1" aria-hidden="true">
      <img src="{{ post.data.image }}" alt="" width="{{ post.data.imageWidth or 1164 }}" height="{{ post.data.imageHeight or 741 }}" loading="lazy">
    </a>
    {% endif %}
    <div class="blog-card-body">
      <div class="blog-card-meta">
        <span class="blog-category">{{ post.data.category or "Engineering" }}</span>
        <time datetime="{{ post.date | isoDate }}" class="prose-meta">{{ post.date | readableDate }}</time>
      </div>
      <h3 class="prose-h3 blog-card-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h3>
      <p class="blog-card-excerpt">{{ post.data.excerpt or post.data.description }}</p>
      <p class="blog-card-footer">
        {% if post.data.readingTime %}{{ post.data.readingTime }} min read &middot; {% endif %}
        <a href="{{ post.url }}" aria-label="Read {{ post.data.title }}">Read article &rarr;</a>
      </p>
    </div>
  </article>
  {% endfor %}
</div>
{% endmacro %}
