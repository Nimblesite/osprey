<!-- BAND 3: CODE BESIDE APP — SYNTAX FLAVORS & SIGNALS -->
<section id="flavors" class="prose-section prose-section-alt">
  <div class="site-container">
    <div class="prose-grid-2">
      <div>
        <p class="prose-eyebrow prose-eyebrow-signal">Write in Your Syntax &middot; Compiler-Derived Signals</p>
        <h2 class="prose-h2">Write in Python, TypeScript, ML, or Osprey &mdash; one native binary.</h2>
        <p class="prose-lead">
          Reactivity is built into the compiler: <code>Signal&lt;T&gt;</code> and <code>Keyed::region</code> derive every view's
          dependencies automatically &mdash; no hooks, no dependency arrays, no virtual DOM diffing.
        </p>
        <ul class="prose-list">
          <li><strong>Four syntax flavors today:</strong> Default Osprey (<code>.osp</code>), ML (<code>.ospml</code>), Python flavor, and TypeScript flavor share one Hindley-Milner type checker and LLVM AOT compiler.</li>
          <li><strong>Coming soon:</strong> <strong>Dart flavor</strong> is on the roadmap for Flutter teams, with <strong>Kotlin flavor</strong> under consideration.</li>
          <li><strong>Zero-serialization bridge:</strong> every update writes fixed-width <code>ViewRow</code> (152 B) and <code>SceneShape</code> (88 B) rows into lease-checked shared memory defined by <code>native.td</code>.</li>
        </ul>
      </div>

      <div class="code-window" data-tabs>
        <div class="tablist" focusgroup="tablist nomemory" role="tablist" aria-label="Osprey Native syntax flavors">
          <button type="button" role="tab" class="tab-btn" id="tab-default" aria-selected="true" focusgroupstart>Default (.osp)</button>
          <button type="button" role="tab" class="tab-btn" id="tab-ml" aria-selected="false">ML (.ospml)</button>
          <button type="button" role="tab" class="tab-btn" id="tab-python" aria-selected="false">Python</button>
          <button type="button" role="tab" class="tab-btn" id="tab-ts" aria-selected="false">TypeScript</button>
          <button type="button" role="tab" class="tab-btn" id="tab-roadmap" aria-selected="false">Dart &amp; Kotlin</button>
        </div>

        <div class="tabpanels-stack">
          <div role="tabpanel" aria-labelledby="tab-default" tabindex="0">
            <div class="tabpanel-inner">
              <p class="code-meta-bar">Default Osprey (.osp) &middot; compiler-derived signals &amp; exhaustive actions</p>
<pre><code>type Action = SelectAccount(int) | Refresh

fn accountRegion(frames, changed) =
    Keyed::region(frames, "accounts", changed, || =&gt; {
        let accounts = perform Signal&lt;Accounts&gt;.read()
        ui::Rows(rowsItems = mapList(accounts.items, renderRow))
    })

fn update(ctx, store, msg) = match msg {
    SelectAccount(id) =&gt; Step::store(store(selected = id))
    Refresh =&gt; Step::ask(store, Capability::fetchAccounts)
}</code></pre>
            </div>
          </div>

          <div role="tabpanel" aria-labelledby="tab-ml" hidden="until-found">
            <div class="tabpanel-inner">
              <p class="code-meta-bar">ML Flavor (.ospml) &middot; minimal brackets, identical AST &amp; native binary</p>
<pre><code>type Action = SelectAccount int | Refresh

accountRegion (frames, changed) =
    Keyed::region (frames, "accounts", changed, \() =&gt;
        accounts = perform Signal&lt;Accounts&gt;.read ()
        ui::Rows (rowsItems = mapList (accounts.items, renderRow)))

update (ctx, store, msg) = match msg
    SelectAccount id =&gt; Step::store (store(selected = id))
    Refresh =&gt; Step::ask (store, Capability::fetchAccounts)</code></pre>
            </div>
          </div>

          <div role="tabpanel" aria-labelledby="tab-python" hidden="until-found">
            <div class="tabpanel-inner">
              <p class="code-meta-bar">Python Flavor &middot; starts with # osprey: flavor=python (LLVM AOT, not CPython)</p>
<pre><code># osprey: flavor=python
def account_region(frames, changed):
    def render():
        accounts = perform(Signal[Accounts].read())
        return ui.Rows(rowsItems=mapList(accounts.items, render_row))
    return Keyed.region(frames, "accounts", changed, render)

def update(ctx, store, msg):
    match msg:
        case SelectAccount(id):
            return Step.store(store(selected=id))
        case Refresh():
            return Step.ask(store, Capability.fetchAccounts)</code></pre>
            </div>
          </div>

          <div role="tabpanel" aria-labelledby="tab-ts" hidden="until-found">
            <div class="tabpanel-inner">
              <p class="code-meta-bar">TypeScript Flavor &middot; compiled AOT to native code (no Hermes / Node)</p>
<pre><code>// osprey: flavor=typescript
function accountRegion(frames, changed) {
    return Keyed.region(frames, "accounts", changed, () =&gt; {
        const accounts = perform Signal&lt;Accounts&gt;.read();
        return ui.Rows({ rowsItems: mapList(accounts.items, renderRow) });
    });
}

function update(ctx, store, msg) {
    if (msg.kind == "Refresh") return Step.ask(store, Capability.fetchAccounts);
    return Step.store(store({ selected: msg.id }));
}</code></pre>
            </div>
          </div>

          <div role="tabpanel" aria-labelledby="tab-roadmap" hidden="until-found">
            <div class="tabpanel-inner roadmap-panel">
              <div class="roadmap-item">
                <h3>Dart Flavor &mdash; Coming Soon</h3>
                <p>Built for Flutter teams who want familiar Dart syntax with Osprey's type inference, algebraic effects, and choice of real native controls or FerroUI GPU canvas.</p>
              </div>
              <div class="roadmap-item">
                <h3>Kotlin Flavor &mdash; Under Consideration</h3>
                <p>Under evaluation for Kotlin &amp; CMP developers who want genuine SwiftUI/WinUI controls without JVM desktop overhead.</p>
              </div>
              <p class="code-meta-bar" style="padding: 0;">Syntax flavors share Osprey's compiler and packages; they do not run raw CPython, npm, pub.dev, or Maven packages unchanged.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

