    <div class="cmp-highlights reveal-on-scroll">
      <h3 class="prose-h3">Where Osprey Native pulls ahead of Compose Multiplatform (CMP)</h3>
      <div class="prose-grid-3" style="margin-block-start: 1.25rem;">
        <article class="prose-card cmp-card">
          <div class="cmp-icon" aria-hidden="true">
