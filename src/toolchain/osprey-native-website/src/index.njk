        <div role="tabpanel" aria-labelledby="tab-default" tabindex="0">
          <div class="tabpanel-inner">
            <p class="prose-meta">Default Osprey (.osp) &mdash; brace-delimited, full type inference, exhaustive action matching.</p>
<pre><code>type Act = Add | Take | Clear

fn update(store, action) = match action {
    Add =&gt; store(count = satAdd(store.count, 1))
    Take =&gt; store(count = max(0, satSub(store.count, 1)))
    Clear =&gt; store(count = 0)
}

fn view(store) = ui::Column(
    columnItems = [
        ui::Wording(wordsText = "Count: ${store.count}"),
        ui::Press(pressWords = "Add one", pressAction = Add),
    ]
)</code></pre>
          </div>
        </div>

        <div role="tabpanel" aria-labelledby="tab-ml" hidden="until-found">
          <div class="tabpanel-inner">
            <p class="prose-meta">ML Flavor (.ospml) &mdash; indentation-significant, minimal brackets, identical AST &amp; binary.</p>
<pre><code>type Act = Add | Take | Clear

update (store, action) = match action
    Add =&gt; store(count = satAdd store.count 1)
    Take =&gt; store(count = max (0, satSub store.count 1))
    Clear =&gt; store(count = 0)

view store = ui::Column(columnItems = [
    ui::Wording(wordsText = "Count: ${store.count}"),
    ui::Press(pressWords = "Add one", pressAction = Add),
])</code></pre>
          </div>
        </div>

        <div role="tabpanel" aria-labelledby="tab-python" hidden="until-found">
          <div class="tabpanel-inner">
            <p class="prose-meta">Python Flavor &mdash; starts with <code># osprey: flavor=python</code>; static types &amp; LLVM AOT, not CPython.</p>
<pre><code># osprey: flavor=python
def update(store, action):
    match action:
        case Add():
            return store(count=satAdd(store.count, 1))
        case Take():
            return store(count=max(0, satSub(store.count, 1)))
        case Clear():
            return store(count=0)

def view(store):
    return ui.Column(columnItems=[
        ui.Wording(wordsText=f"Count: {store.count}"),
        ui.Press(pressWords="Add one", pressAction=Add()),
    ])</code></pre>
          </div>
        </div>

        <div role="tabpanel" aria-labelledby="tab-ts" hidden="until-found">
          <div class="tabpanel-inner">
            <p class="prose-meta">TypeScript Flavor &mdash; familiar JS/TS surface compiled ahead of time to native machine code (no Node/Hermes).</p>
<pre><code>// osprey: flavor=typescript
function update(store, action) {
    if (action == Add) return store({ count: satAdd(store.count, 1) });
    if (action == Take) return store({ count: max(0, satSub(store.count, 1)) });
    return store({ count: 0 });
}

function view(store) {
    return ui.Column({ columnItems: [
        ui.Wording({ wordsText: `Count: ${store.count}` }),
        ui.Press({ pressWords: "Add one", pressAction: Add }),
    ]});
}</code></pre>
          </div>
        </div>

        <div role="tabpanel" aria-labelledby="tab-roadmap" hidden="until-found">
          <div class="tabpanel-inner">
            <div class="prose-grid-2">
              <div class="prose-card prose-card-canvas">
                <span class="badge badge-canvas">&#9733; Coming Soon</span>
                <h3 class="prose-h3">Dart Flavor</h3>
                <p class="prose-body">
                  Designed for Flutter teams who want familiar Dart-style syntax with Osprey's Hindley-Milner type safety,
                  algebraic effects, and the freedom to render either native controls or FerroUI GPU canvas.
                </p>
              </div>
              <div class="prose-card prose-card-native">
                <span class="badge badge-native">&#9675; Under Consideration</span>
                <h3 class="prose-h3">Kotlin Flavor</h3>
                <p class="prose-body">
                  Under evaluation for Kotlin &amp; CMP developers who want native SwiftUI/WinUI controls without JVM desktop
                  overhead, while keeping familiar expression-oriented syntax.
                </p>
              </div>
            </div>
            <p class="prose-meta">
              Note: Syntax flavors share Osprey's compiler and standard packages; they do not execute unmodified CPython, npm, pub.dev, or Maven packages.
            </p>
          </div>
        </div>
