            <td>Opt-in <code>Semantics</code> widgets</td>
            <td>Opt-in accessibility props per view</td>
            <td>Opt-in semantics modifiers per composable</td>
          </tr>
          <tr>
            <th scope="row">Automated UI testing</th>
            <td class="col-osprey"><span class="cell-chip">&#10003; Headless &amp; Fast</span><br><code>@osprey/uitest</code> by accessible label + algebraic effect mocks (no window/simulator)</td>
            <td>Widget tests + <code>integration_test</code></td>
            <td>Jest + Detox / Appium</td>
            <td>Compose UI test rules (JVM / platform runner)</td>
          </tr>
        </tbody>
      </table>
