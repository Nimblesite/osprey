// Plan 0037: the per-frame cost of the framework on its own, without a host. A flock of `count`
// birds moves once per frame event delivered through the typed boundary every host calls
// ([NATIVE-SHM-EVENT]); each frame runs `update`, lowers the region and writes a scene of `count`
// sprites as rows ([NATIVE-SHM-SCENE]). The rows are counted here instead of being sealed for a host.
namespace bench

import ui::Ui
import ui::Keyed
import ui::Runtime
import ui::Messages
import ui::Scenes
import ui::Surfaces
import ui::Hosting
import ui::Streams

type Bird =
    bx : float
    by : float
    vx : float
    vy : float

type Flock =
    birds : List<Bird>
    frame : int

type Store =
    flock : Flock

type Act = Play

count = 5000

frames = 120

white () = Scenes::rgb (255, 255, 255)

// A grid of 100 columns; saturating integer arithmetic raises no effect.
bird i = Bird(bx = toFloat (satSub i (satMul (intDiv i 100) 100)) * 3.2, by = toFloat (intDiv i 100) * 4.0, vx = 1.0, vy = 0.5)

wrap (value, limit) = match value > limit
    true => value - limit
    false => value

move (b, elapsed) = Bird(bx = wrap (b.bx + b.vx * elapsed * 60.0, 320.0), by = wrap (b.by + b.vy * elapsed * 60.0, 200.0), vx = b.vx, vy = b.vy)

flockSlice () = perform Signal<Flock>.read ()

frameJson value = JsonInt value.frame

fieldView () = Ui::zoomed (0.0, 320.0, 200.0, ["bird"], mapList ((flockSlice ()).birds, \b => Scenes::sprite (0, b.bx, b.by, 2.0, 2.0, atan2 b.vy b.vx, white (), 0)), Play)

regions (before, store, frames, _) =
    handle static Signal<Flock>
        read => store.flock
    changed = signalChanges before.flock store.flock frameJson (signalDependencies flockSlice)
    [Keyed::region (frames, Surfaces::rootKey, changed, fieldView)]

init _ = Runtime::step (Store(flock = Flock(birds = range (0, count) |> fold [] (\(out, i) => listAppend out (bird i)), frame = 0)))

advanced (store, elapsed) = Runtime::step (Store(flock = Flock(birds = mapList (store.flock.birds, \b => move (b, elapsed)), frame = satAdd store.flock.frame 1)))

update (_, store, message) = Messages::route (message, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \elapsed => advanced (store, elapsed), \(_, _) => Runtime::step store)

theme = ui::Theme(tokens = [], spacing = [4, 8], feedback = 120, settle = 220)

program () = ui::Program(programInit = init, programUpdate = update, programRender = regions, programTheme = \_ => theme)

tick () = ui::Touch(touchNow = 2, touchKind = Hosting::frame, touchOrdinal = 0, touchWords = "", touchDetail = "", touchX = 0.0083, touchY = 0.0, touchDown = false, touchShift = false)

// The rows each frame writes, counted instead of sealed for a host.
mut rows = 0

counted work =
    handle ui::ViewStream
        place _ => rows := satAdd rows 1
        size _ => 0
        sketch drawn => rows := satAdd rows (satAdd (length drawn.sketchedAs.sketchShapes) (Streams::write (drawn.sketchedRow, drawn.sketchedAs)))
        ask _ => 0
    work ()

run () =
    first = Surfaces::open (Surfaces::idle (Store(flock = Flock(birds = [], frame = 0))), program (), Runtime::host (1, 0, "macos", "", []), false)
    last = range (0, frames) |> fold first (\(held, _) => Hosting::event (held, program (), tick ()))
    length last.surfaceSession.sessionStore.flock.birds

main () =
    birds = Runtime::guarded (\() => counted run)
    print "frames ${frames} birds ${birds} rows ${rows}"
    0
