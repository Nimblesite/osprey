namespace app

import ui::Runtime
import ui::Views
import probe::App

extern native_slice (key : string) -> string

(** Retains the application-specific surface between host calls. *)
effect Keep
    keep : ui::Surface<probe::Store, probe::Act> => Unit

initial () = App::make 0 ""
program () = App::program ()

platform work =
    handle ui::Slices
        fetch key => native_slice key
    Runtime::guarded (\() => Views::shared work)
