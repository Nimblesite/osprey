// Sum of decimal digit-sums over 1..N — integer division (n/10) and modulo in recursion.
import bench::Bench::{guarded, add, modp}
fn div10(n) = intDiv(n, 10)

fn digsum(n) = match (n < 10) {
    true  => n
    false => add(modp(n, 10), digsum(div10(n)))
}
fn step(acc, i) = add(acc, digsum(i))
fn main() = guarded(|| => print("${range(1, 2000001) |> fold(0, step)}"))
