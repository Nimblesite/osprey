# quicksort — build a persistent List<int> of pseudo-random values and sort it
# with the naive first-element-pivot quicksort: two recursive passes split the
# tail around the pivot, both halves are sorted and the results are joined.
# The checksum weights every sorted element by its rank, so a wrong ORDER —
# not only a wrong multiset — changes the answer. Repeated K times with
# rolling seeds.
#
# Modes via the first stdin line: "0"/empty -> fixed seed (deterministic,
# oracle-checked); "1" -> cryptographically-secure random seed (/dev/urandom).
import sys


class List:
    pass


class Nil(List):
    pass


class Cons(List):
    head: int
    tail: List


NIL: List = Nil()


def fold(items, start, step):
    acc = start
    for item in items:
        acc = step(acc, item)
    return acc


def add(a, b):
    return a + b


def mul(a, b):
    return a * b


def modp(a, b):
    return a % b


def r1(x):
    return modp(mul(x, 16807), 2147483647)


def hash_at(seed, i):
    return r1(r1(add(seed, i)))


def add_m(a, b):
    return modp(add(a, b), 1000000007)


def rand_seed():
    with open("/dev/urandom", "rb") as source:
        return add(modp(fold(source.read(4), 0, lambda acc, c: add(mul(acc, 256), int(c))), 2147483646), 1)


def seed_of(s):
    token = s.strip()
    return rand_seed() if token.lstrip("-").isdigit() and int(token) != 0 else 1


def build_list(s) -> List:
    return fold(range(1999, -1, -1), NIL, lambda acc, i: Cons(modp(hash_at(s, i), 100000), acc))


def concat(xs: List, ys: List) -> List:
    match xs:
        case Cons(head=head, tail=tail):
            return Cons(head, concat(tail, ys))
        case _:
            return ys


def below(pivot, xs: List) -> List:
    match xs:
        case Cons(head=head, tail=tail):
            return Cons(head, below(pivot, tail)) if head < pivot else below(pivot, tail)
        case _:
            return NIL


def at_least(pivot, xs: List) -> List:
    match xs:
        case Cons(head=head, tail=tail):
            return at_least(pivot, tail) if head < pivot else Cons(head, at_least(pivot, tail))
        case _:
            return NIL


def quicksort(xs: List) -> List:
    match xs:
        case Cons(head=pivot, tail=rest):
            return concat(quicksort(below(pivot, rest)), Cons(pivot, quicksort(at_least(pivot, rest))))
        case _:
            return NIL


def weigh(xs: List, rank) -> int:
    match xs:
        case Cons(head=head, tail=tail):
            return add_m(mul(head, rank), weigh(tail, add(rank, 1)))
        case _:
            return 0


def run_one(s):
    return weigh(quicksort(build_list(s)), 1)


seed = seed_of(sys.stdin.readline())
print(f"{fold(range(0, 8), 0, lambda acc, t: add_m(acc, run_one(add(seed, mul(t, 131)))))}")
