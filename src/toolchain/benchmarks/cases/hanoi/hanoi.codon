# Towers of Hanoi — count moves via exponential double recursion. hanoi(n)=2^n-1.
def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def hanoi(n, acc):
    match n:
        case 0:
            return acc
        case _:
            return hanoi(sub(n, 1), add(hanoi(sub(n, 1), acc), 1))


print(f"{hanoi(25, 0)}")
