# Sum of modular exponentiation: sum of i^20 mod P for i in 1..N, naive repeated multiply.
def fold(items, start, step):
    acc = start
    for item in items:
        acc = step(acc, item)
    return acc


def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def mul(a, b):
    return a * b


def mod_(a, b):
    return a % b


def powmod(base, e, acc):
    match e:
        case 0:
            return acc
        case _:
            return powmod(base, sub(e, 1), mod_(mul(acc, base), 1000000007))


def step(acc, i):
    return mod_(add(acc, powmod(i, 20, 1)), 1000000007)


print(f"{fold(range(1, 1000000), 0, step)}")
