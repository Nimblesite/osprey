// Sum of modular exponentiation: sum of i^20 mod P for i in 1..N, naive repeated multiply.
import bench::Bench::{guarded, add, sub, mul, modp}
fn powmod(base, e, acc) = match e {
    0 => acc
    _ => powmod(base, sub(e, 1), modp(mul(acc, base), 1000000007))
}
fn step(acc, i) = modp(add(acc, powmod(i, 20, 1)), 1000000007)
fn main() = guarded(|| => print("${range(1, 1000000) |> fold(0, step)}"))
