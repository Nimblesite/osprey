# Binomial coefficient via naive (un-memoised) Pascal recursion C(n,k)=C(n-1,k-1)+C(n-1,k).
def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def binom(n, k):
    match k:
        case 0:
            return 1
        case _:
            match k == n:
                case True:
                    return 1
                case _:
                    return add(binom(sub(n, 1), sub(k, 1)), binom(sub(n, 1), k))


print(f"{binom(27, 13)}")
