# mergesort — build a persistent List<int> of pseudo-random values and sort it
# with the naive top-down merge sort: deal the list into two halves by
# alternating elements, sort each half and merge the two sorted results.
# The checksum weights every sorted element by its rank, so a wrong ORDER —
# not only a wrong multiset — changes the answer. Repeated K times with
# rolling seeds.
#
# Modes via the first stdin line: "0"/empty -> fixed seed (deterministic,
# oracle-checked); "1" -> cryptographically-secure random seed (/dev/urandom).
import sys


class List:
    pass


class Nil(List):
    pass


class Cons(List):
    head: int
    tail: List


NIL: List = Nil()


def fold(items, start, step):
    acc = start
    for item in items:
        acc = step(acc, item)
    return acc


def add(a, b):
    return a + b


def mul(a, b):
    return a * b


def modp(a, b):
    return a % b


def r1(x):
    return modp(mul(x, 16807), 2147483647)


def hash_at(seed, i):
    return r1(r1(add(seed, i)))


def add_m(a, b):
    return modp(add(a, b), 1000000007)


def rand_seed():
    with open("/dev/urandom", "rb") as source:
        return add(modp(fold(source.read(4), 0, lambda acc, c: add(mul(acc, 256), int(c))), 2147483646), 1)


def seed_of(s):
    token = s.strip()
    return rand_seed() if token.lstrip("-").isdigit() and int(token) != 0 else 1


def build_list(s) -> List:
    return fold(range(1999, -1, -1), NIL, lambda acc, i: Cons(modp(hash_at(s, i), 100000), acc))


def evens(xs: List) -> List:
    match xs:
        case Cons(head=head, tail=tail):
            return Cons(head, odds(tail))
        case _:
            return NIL


def odds(xs: List) -> List:
    match xs:
        case Cons(head=head, tail=tail):
            return evens(tail)
        case _:
            return NIL


def merge(left: List, right: List) -> List:
    match left:
        case Cons(head=l, tail=ls):
            match right:
                case Cons(head=r, tail=rs):
                    return Cons(r, merge(left, rs)) if r < l else Cons(l, merge(ls, right))
                case _:
                    return left
        case _:
            return right


def mergesort(xs: List) -> List:
    match xs:
        case Cons(head=only, tail=Nil()):
            return Cons(only, NIL)
        case Cons(head=_, tail=_):
            return merge(mergesort(evens(xs)), mergesort(odds(xs)))
        case _:
            return NIL


def weigh(xs: List, rank) -> int:
    match xs:
        case Cons(head=head, tail=tail):
            return add_m(mul(head, rank), weigh(tail, add(rank, 1)))
        case _:
            return 0


def run_one(s):
    return weigh(mergesort(build_list(s)), 1)


seed = seed_of(sys.stdin.readline())
print(f"{fold(range(0, 8), 0, lambda acc, t: add_m(acc, run_one(add(seed, mul(t, 131)))))}")
