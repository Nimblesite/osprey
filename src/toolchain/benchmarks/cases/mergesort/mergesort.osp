// mergesort — build a persistent List<int> of pseudo-random values and sort it
// with the naive top-down merge sort: deal the list into two halves by
// alternating elements, sort each half and merge the two sorted results.
// The checksum weights every sorted element by its rank, so a wrong ORDER —
// not only a wrong multiset — changes the answer. Repeated K times with
// rolling seeds.
//
// Modes via the first stdin line: "0"/empty -> fixed seed (deterministic,
// oracle-checked); "1" -> cryptographically-secure random seed (randomBelow).
import bench::Bench::{guarded, add, mul, addM, seedOf, buildList, weigh}
fn evens(xs) = match xs {
    [] => []
    [head, ...tail] => listPrepend(odds(tail), head)
}
fn odds(xs) = match xs {
    [] => []
    [_, ...tail] => evens(tail)
}
fn merge(left, right) = match left {
    [] => right
    [l, ...ls] => match right {
        [] => left
        [r, ...rs] => match r < l {
            true => listPrepend(merge(left, rs), r)
            false => listPrepend(merge(ls, right), l)
        }
    }
}
fn mergesort(xs) = match xs {
    [] => []
    [only] => [only]
    _ => merge(mergesort(evens(xs)), mergesort(odds(xs)))
}
fn runOne(s) = weigh(mergesort(buildList(s, 2000, 100000)), 1)
fn main() = guarded(|| => {
    let seed = seedOf(input())
    print("${range(0, 8) |> fold(0, |acc, t| => addM(acc, runOne(add(seed, mul(t, 131)))))}")
})
