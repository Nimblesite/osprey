// textstats — draw a pseudo-random token stream and fold per-token string
// metrics (length + substring search + prefix test) into a checksum.
// Non-integer data type: String, exercising the immutable string builtins
// (length / contains / startsWith) in a hot loop.
//
// Modes via the first stdin line: "0"/empty -> fixed seed (deterministic,
// oracle-checked); "1" -> cryptographically-secure random seed (randomBelow).
import bench::Bench::{guarded, add, modp, hashAt, seedOf, word}
fn score(w) = add(add(length(w),
    match contains(w, "o") { true => 7  false => 0 }),
    match startsWith(w, "t") { true => 3  false => 0 })
fn main() = guarded(|| => {
    let seed = seedOf(input())
    print("${range(0, 200000) |> fold(0, |acc, i| => add(acc, score(word(modp(hashAt(seed, i), 8)))))}")
})
