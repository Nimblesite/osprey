// Ackermann–Péter function — deep, non-tail mutual self-recursion.
import bench::Bench::{guarded, add, sub}

fn ack(m, n) = match m {
    0 => add(n, 1)
    _ => match n {
        0 => ack(sub(m, 1), 1)
        _ => ack(sub(m, 1), ack(m, sub(n, 1)))
    }
}

fn main() = guarded(|| => print("${ack(3, 10)}"))
