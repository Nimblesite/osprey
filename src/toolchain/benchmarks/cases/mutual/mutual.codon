# Mutually-recursive isEven/isOdd applied across a range — classic mutual recursion.
def fold(items, start, step):
    acc = start
    for item in items:
        acc = step(acc, item)
    return acc


def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def mod_(a, b):
    return a % b


def is_even(n):
    match n:
        case 0:
            return True
        case _:
            return is_odd(sub(n, 1))


def is_odd(n):
    match n:
        case 0:
            return False
        case _:
            return is_even(sub(n, 1))


def step(acc, i):
    match is_even(mod_(i, 1000)):
        case True:
            return add(acc, 1)
        case _:
            return acc


print(f"{fold(range(1, 130000), 0, step)}")
