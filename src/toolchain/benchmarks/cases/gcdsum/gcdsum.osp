// Sum of gcd(i, K) for i in 1..N — Euclidean-algorithm recursion (modulo heavy).
import bench::Bench::{guarded, add, modp}

fn gcd(a, b) = match b {
    0 => a
    _ => gcd(b, modp(a, b))
}
fn step(acc, i) = add(acc, gcd(i, 1234567))

fn main() = guarded(|| => print("${range(1, 2000000) |> fold(0, step)}"))
