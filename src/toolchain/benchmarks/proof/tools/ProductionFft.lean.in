/- [SYNTH-DSP-PROOFS] The marked declarations are emitted by the Osprey
   frontend from ffts.ospml. Scalar primitives are unconstrained, so the
   theorem also holds for rounding arithmetic with these operations. -/
import Synthesis

namespace ProductionFft

structure Bin (α : Type) where
  re : α
  im : α

structure Halves (α : Type) where
  lower : List (Bin α)
  upper : List (Bin α)

structure Ops (α : Type) where
  plus : α → α → α
  times : α → α → α
  unitRe : α → α → α
  unitIm : α → α → α
  minus : α → α → α
  cos : α → α
  sin : α → α
  twiddle : α → α → α → α
  productRe : α → α → α → α → α
  productIm : α → α → α → α → α
  literal : Nat → α
  toFloat : Nat → α
  satAdd : Nat → Nat → Nat

-- INSERT PRODUCTION BODIES

/-- Smith's radix-two butterfly in bin order. The reference accepts already
    paired bins, independently of how the implementation traverses its lists. -/
def butterfly (ops : Ops α) (e o : Bin α) (angle : α) : Bin α × Bin α :=
  let c := ops.cos angle
  let s := ops.sin angle
  let re := ops.productRe o.re o.im c s
  let im := ops.productIm o.re o.im c s
  (⟨ops.plus e.re re, ops.plus e.im im⟩, ⟨ops.minus e.re re, ops.minus e.im im⟩)

def butterflies (ops : Ops α) (size : Nat) (sign : α) (index : Nat) :
    List (Bin α × Bin α) → List (Bin α × Bin α)
  | [] => []
  | (e,o) :: rest =>
    butterfly ops e o (ops.twiddle sign (ops.toFloat index) (ops.toFloat size)) ::
      butterflies ops size sign (ops.satAdd index 1) rest

theorem combinedCorrect (ops : Ops α) (even odd : List (Bin α)) (index size : Nat) (sign : α) :
    combined ops even odd index size sign =
      let bins := butterflies ops size sign index (even.zip odd)
      ⟨bins.map Prod.fst, bins.map Prod.snd⟩ := by
  induction even generalizing index odd with
  | nil => cases odd <;> rfl
  | cons e es ih =>
    cases odd with
    | nil => rfl
    | cons o os =>
      simp only [combined, List.zip, List.zipWith, butterflies, List.map]
      rw [ih]
      rfl

/-- The fused four-sample base case preserves the four output positions of
    the two radix-two stages, including their separate floating twiddles. -/
theorem quartetCorrect (ops : Ops α) (a b c d : Bin α) (sign : α) :
    quartet ops a b c d sign =
      let zero := ops.twiddle sign (ops.literal 0) (ops.literal 2)
      let quarter := ops.twiddle sign (ops.literal 1) (ops.literal 4)
      let even := butterfly ops a c zero
      let odd := butterfly ops b d zero
      let lo := butterfly ops even.1 odd.1 zero
      let hi := butterfly ops even.2 odd.2 quarter
      [lo.1, hi.1, lo.2, hi.2] := rfl

theorem conjugateComponents (ops : Ops α) (z : Bin α) :
    conjugate ops z = ⟨z.re, ops.minus (ops.literal 0) z.im⟩ := rfl

/-- Ffts.inverse mirrors interior bins with this operation. Applying it twice
    recovers the bin whenever subtraction from zero is involutive. -/
theorem conjugateTwice (ops : Ops α) (z : Bin α)
    (involution : ∀ x, ops.minus (ops.literal 0) (ops.minus (ops.literal 0) x) = x) :
    conjugate ops (conjugate ops z) = z := by
  cases z with
  | mk re im => exact congrArg (Bin.mk re) (involution im)

/-- Apply Smith A.1 directly to the production combine. When the incoming
    halves are the two subtransform bins and the twiddle implements the root
    multiplication, its outputs are the two full-size DFT polynomials. -/
theorem combinedDftBins (ops : Ops α) (mul : Bin α → Bin α → Bin α) (neg : Bin α → Bin α)
    (zero z : Bin α) (index size : Nat) (sign : α) (frame : List (Bin α × Bin α))
    (plusZero : ∀ x, added ops x zero = x) (timesZero : ∀ x, mul x zero = zero)
    (assoc : ∀ a b c, added ops (added ops a b) c = added ops a (added ops b c))
    (comm : ∀ a b, added ops a b = added ops b a)
    (mulAssoc : ∀ a b c, mul (mul a b) c = mul a (mul b c))
    (dist : ∀ a b c, mul a (added ops b c) = added ops (mul a b) (mul a c))
    (negSquare : ∀ a, mul (neg a) (neg a) = mul a a)
    (negMul : ∀ a b, mul (neg a) b = neg (mul a b))
    (subtract : ∀ a b, subtracted ops a b = added ops a (neg b))
    (rotation : ∀ x, rotated ops x (ops.twiddle sign (ops.toFloat index) (ops.toFloat size)) = mul z x) :
    let even := Synthesis.bin (added ops) mul zero (mul z z) Prod.fst frame
    let odd := Synthesis.bin (added ops) mul zero (mul z z) Prod.snd frame
    combined ops [even] [odd] index size sign =
      ⟨[Synthesis.pairedBin (added ops) mul zero z frame],
       [Synthesis.pairedBin (added ops) mul zero (neg z) frame]⟩ := by
  dsimp only
  rw [Synthesis.radixTwoSplit (added ops) mul zero z plusZero timesZero assoc comm mulAssoc dist,
      Synthesis.radixTwoUpper (added ops) mul neg zero z plusZero timesZero assoc comm mulAssoc dist negSquare negMul]
  have step (e o : Bin α) : combined ops [e] [o] index size sign =
      ⟨[added ops e (mul z o)], [added ops e (neg (mul z o))]⟩ := by
    rw [← rotation o, ← subtract]
    rfl
  exact step _ _

/-- Component order and multiplication in the production gain stage. -/
theorem scaledComponents (ops : Ops α) (x : Bin α) (gain : α) :
    scaled ops x gain = ⟨ops.times x.re gain, ops.times x.im gain⟩ := rfl

/-- DFT homogeneity for the production complex sum, product and gain.
    Distribute gain over the sum and move it through each twiddle product. -/
theorem scaledDftBin (ops : Ops α) (zero gain : α) (root : Bin α)
    (samples : ι → Bin α) (xs : List ι) (timesZero : ops.times zero gain = zero)
    (dist : ∀ a b, ops.times (ops.plus a b) gain =
      ops.plus (ops.times a gain) (ops.times b gain))
    (realProduct : ∀ a b c d, ops.times (ops.productRe a b c d) gain =
      ops.productRe a b (ops.times c gain) (ops.times d gain))
    (imagProduct : ∀ a b c d, ops.times (ops.productIm a b c d) gain =
      ops.productIm a b (ops.times c gain) (ops.times d gain)) :
    scaled ops (Synthesis.bin (added ops) (turned ops) ⟨zero, zero⟩ root samples xs) gain =
      Synthesis.bin (added ops) (turned ops) ⟨zero, zero⟩ root (fun i => scaled ops (samples i) gain) xs := by
  have distribute (a b : Bin α) :
      scaled ops (added ops a b) gain = added ops (scaled ops a gain) (scaled ops b gain) := by
    unfold scaled added
    rw [dist, dist]
  have rotateScale (x : Bin α) : scaled ops (turned ops root x) gain = turned ops root (scaled ops x gain) := by
    unfold scaled turned
    rw [realProduct, imagProduct]
  induction xs with
  | nil => change Bin.mk (ops.times zero gain) (ops.times zero gain) = _
           rw [timesZero]
           rfl
  | cons i rest ih =>
    change scaled ops (added ops (samples i) (turned ops root _)) gain = added ops _ (turned ops root _)
    rw [distribute, rotateScale, ih]

/-- The frame's measured rotation is the normalized product of the current bin
    with the conjugate of its predecessor. -/
theorem rotationConjugate (ops : Ops α) (current previous : Bin α) :
    rotation ops current previous =
      let delta := turned ops current (conjugate ops previous)
      ⟨ops.unitRe delta.re delta.im, ops.unitIm delta.re delta.im⟩ := rfl

end ProductionFft
