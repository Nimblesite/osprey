/- [SYNTH-DSP-PROOFS] The marked declarations are emitted by the Osprey
   frontend from ffts.ospml. Scalar primitives are unconstrained, so the
   theorem also holds for rounding arithmetic with these operations. -/
import Synthesis

namespace ProductionFft

structure Harmonic (α : Type) where
  amplitude : α
  number : Nat
  phase : α

def foldList (xs : List α) (initial : β) (step : β → α → β) := xs.foldl step initial

structure Bin (α : Type) where
  re : α
  im : α

structure Halves (α : Type) where
  lower : List (Bin α)
  upper : List (Bin α)

structure Strike (α : Type) where
  position : α
  sampleRate : α
  frequency : α

structure LineSample (α history : Type) where
  sample : α
  next : history

structure AllpassState (α : Type) where
  input : α
  output : α

structure AllpassSample (α : Type) where
  sample : α
  next : AllpassState α

inductive Curve where
  | TanhCurve | HardCurve | CubicCurve | FoldCurve

structure Shaper where
  antialias : Bool
  curve : Curve

structure Pulse (α : Type) where
  index : α
  ratio : α
  offset : α

inductive PhaseShape (α : Type) where
  | PlainPhase
  | WindowedPhase (index ratio : α)
  | DistortedPhase (d : α)
  | WavePulsePhase (d : α) (first second : Pulse α)

inductive Envelope (α : Type) where
  | HannWindow
  | AsrWindow (attack release : α)

structure Ops (α : Type) where
  History : Type
  Fault : Type
  push : History → α → History
  tap : History → α → Except Fault α
  tau : α
  window : α → α
  windowedPhase : α → α → α → α
  half : α
  epsilon : α
  abs : α → α
  less : α → α → Bool
  atMost : α → α → Bool
  atLeast : α → α → Bool
  asr : α → α → α → α → α
  equal : α → α → Bool
  tanh : α → α
  hard : α → α
  cubic : α → α
  fold : α → α
  tanhIntegral : α → α
  hardIntegral : α → α
  cubicIntegral : α → α
  foldIntegral : α → α
  ieeeDivide : α → α → α
  divide : α → α → α
  plus : α → α → α
  times : α → α → α
  unitRe : α → α → α
  unitIm : α → α → α
  minus : α → α → α
  cos : α → α
  sin : α → α
  literal : Nat → α
  toFloat : Nat → α
  satAdd : Nat → Nat → Nat

-- INSERT PRODUCTION BODIES

open Ffts SpectralFrames StrikeCombs

/-- Complex multiplication and signed twiddle angle from the shipped spectral math module. -/
theorem rotationArithmetic (ops : Ops α) (v : Bin α) (sign k size : α) :
    let angle := ops.ieeeDivide (ops.times (ops.times sign ops.tau) k) size
    rotated ops v (SpectralMath.twiddle ops sign k size) =
      ⟨ops.minus (ops.times v.re (ops.cos angle)) (ops.times v.im (ops.sin angle)),
       ops.plus (ops.times v.re (ops.sin angle)) (ops.times v.im (ops.cos angle))⟩ := rfl

/-- Smith's radix-two butterfly in bin order. The reference accepts already
    paired bins, independently of how the implementation traverses its lists. -/
def butterfly (ops : Ops α) (e o : Bin α) (angle : α) : Bin α × Bin α :=
  let c := ops.cos angle
  let s := ops.sin angle
  let re := SpectralMath.productRe ops o.re o.im c s
  let im := SpectralMath.productIm ops o.re o.im c s
  (⟨ops.plus e.re re, ops.plus e.im im⟩, ⟨ops.minus e.re re, ops.minus e.im im⟩)

def butterflies (ops : Ops α) (size : Nat) (sign : α) (index : Nat) :
    List (Bin α × Bin α) → List (Bin α × Bin α)
  | [] => []
  | (e,o) :: rest =>
    butterfly ops e o (SpectralMath.twiddle ops sign (ops.toFloat index) (ops.toFloat size)) ::
      butterflies ops size sign (ops.satAdd index 1) rest

theorem combinedCorrect (ops : Ops α) (even odd : List (Bin α)) (index size : Nat) (sign : α) :
    combined ops even odd index size sign =
      let bins := butterflies ops size sign index (even.zip odd)
      ⟨bins.map Prod.fst, bins.map Prod.snd⟩ := by
  induction even generalizing index odd with
  | nil => cases odd <;> rfl
  | cons e es ih =>
    cases odd with
    | nil => rfl
    | cons o os =>
      simp only [combined, List.zip, List.zipWith, butterflies, List.map]
      rw [ih]
      rfl

/-- The fused four-sample base case preserves the four output positions of
    the two radix-two stages, including their separate floating twiddles. -/
theorem quartetCorrect (ops : Ops α) (a b c d : Bin α) (sign : α) :
    quartet ops a b c d sign =
      let zero := SpectralMath.twiddle ops sign (ops.literal 0) (ops.literal 2)
      let quarter := SpectralMath.twiddle ops sign (ops.literal 1) (ops.literal 4)
      let even := butterfly ops a c zero
      let odd := butterfly ops b d zero
      let lo := butterfly ops even.1 odd.1 zero
      let hi := butterfly ops even.2 odd.2 quarter
      [lo.1, hi.1, lo.2, hi.2] := rfl

theorem conjugateComponents (ops : Ops α) (z : Bin α) :
    conjugate ops z = ⟨z.re, ops.minus (ops.literal 0) z.im⟩ := rfl

/-- Ffts.inverse mirrors interior bins with this operation. Applying it twice
    recovers the bin whenever subtraction from zero is involutive. -/
theorem conjugateTwice (ops : Ops α) (z : Bin α)
    (involution : ∀ x, ops.minus (ops.literal 0) (ops.minus (ops.literal 0) x) = x) :
    conjugate ops (conjugate ops z) = z := by
  cases z with
  | mk re im => exact congrArg (Bin.mk re) (involution im)

/-- Apply Smith A.1 directly to the production combine. When the incoming
    halves are the two subtransform bins and the twiddle implements the root
    multiplication, its outputs are the two full-size DFT polynomials. -/
theorem combinedDftBins (ops : Ops α) (mul : Bin α → Bin α → Bin α) (neg : Bin α → Bin α)
    (zero z : Bin α) (index size : Nat) (sign : α) (frame : List (Bin α × Bin α))
    (plusZero : ∀ x, added ops x zero = x) (timesZero : ∀ x, mul x zero = zero)
    (assoc : ∀ a b c, added ops (added ops a b) c = added ops a (added ops b c))
    (comm : ∀ a b, added ops a b = added ops b a)
    (mulAssoc : ∀ a b c, mul (mul a b) c = mul a (mul b c))
    (dist : ∀ a b c, mul a (added ops b c) = added ops (mul a b) (mul a c))
    (negSquare : ∀ a, mul (neg a) (neg a) = mul a a)
    (negMul : ∀ a b, mul (neg a) b = neg (mul a b))
    (subtract : ∀ a b, subtracted ops a b = added ops a (neg b))
    (rotation : ∀ x, rotated ops x (SpectralMath.twiddle ops sign (ops.toFloat index) (ops.toFloat size)) = mul z x) :
    let even := Synthesis.bin (added ops) mul zero (mul z z) Prod.fst frame
    let odd := Synthesis.bin (added ops) mul zero (mul z z) Prod.snd frame
    combined ops [even] [odd] index size sign =
      ⟨[Synthesis.pairedBin (added ops) mul zero z frame],
       [Synthesis.pairedBin (added ops) mul zero (neg z) frame]⟩ := by
  dsimp only
  rw [Synthesis.radixTwoSplit (added ops) mul zero z plusZero timesZero assoc comm mulAssoc dist,
      Synthesis.radixTwoUpper (added ops) mul neg zero z plusZero timesZero assoc comm mulAssoc dist negSquare negMul]
  have step (e o : Bin α) : combined ops [e] [o] index size sign =
      ⟨[added ops e (mul z o)], [added ops e (neg (mul z o))]⟩ := by
    rw [← rotation o, ← subtract]
    rfl
  exact step _ _

/-- Component order and multiplication in the production gain stage. -/
theorem scaledComponents (ops : Ops α) (x : Bin α) (gain : α) :
    scaled ops x gain = ⟨ops.times x.re gain, ops.times x.im gain⟩ := rfl

/-- DFT homogeneity for the production complex sum, product and gain.
    Distribute gain over the sum and move it through each twiddle product. -/
theorem scaledDftBin (ops : Ops α) (zero gain : α) (root : Bin α)
    (samples : ι → Bin α) (xs : List ι) (timesZero : ops.times zero gain = zero)
    (dist : ∀ a b, ops.times (ops.plus a b) gain =
      ops.plus (ops.times a gain) (ops.times b gain))
    (realProduct : ∀ a b c d, ops.times (SpectralMath.productRe ops a b c d) gain =
      SpectralMath.productRe ops a b (ops.times c gain) (ops.times d gain))
    (imagProduct : ∀ a b c d, ops.times (SpectralMath.productIm ops a b c d) gain =
      SpectralMath.productIm ops a b (ops.times c gain) (ops.times d gain)) :
    scaled ops (Synthesis.bin (added ops) (turned ops) ⟨zero, zero⟩ root samples xs) gain =
      Synthesis.bin (added ops) (turned ops) ⟨zero, zero⟩ root (fun i => scaled ops (samples i) gain) xs := by
  have distribute (a b : Bin α) :
      scaled ops (added ops a b) gain = added ops (scaled ops a gain) (scaled ops b gain) := by
    unfold scaled added
    rw [dist, dist]
  have rotateScale (x : Bin α) : scaled ops (turned ops root x) gain = turned ops root (scaled ops x gain) := by
    unfold scaled turned
    rw [realProduct, imagProduct]
  induction xs with
  | nil => change Bin.mk (ops.times zero gain) (ops.times zero gain) = _
           rw [timesZero]
           rfl
  | cons i rest ih =>
    change scaled ops (added ops (samples i) (turned ops root _)) gain = added ops _ (turned ops root _)
    rw [distribute, rotateScale, ih]

/-- The frame's measured rotation is the normalized product of the current bin
    with the conjugate of its predecessor. -/
theorem rotationConjugate (ops : Ops α) (current previous : Bin α) :
    rotation ops current previous =
      let delta := turned ops current (conjugate ops previous)
      ⟨ops.unitRe delta.re delta.im, ops.unitIm delta.re delta.im⟩ := rfl

/-- The strike comb returns the difference and the newly pushed history on a
    successful delay read, or propagates the precise delay error. -/
theorem strikeDifference (ops : Ops α) (cfg : Strike α) (held : ops.History) (input : α) :
    next ops cfg held input =
      let line := ops.push held input
      let d := ops.divide (ops.times cfg.position cfg.sampleRate) cfg.frequency
      match ops.tap line (ops.plus d (ops.literal 1)) with
      | .error why => .error why
      | .ok older => .ok ⟨ops.minus input older, line⟩ := rfl

/-- A periodic component whose delayed sample equals the excitation is
    cancelled. The successful read must use the newly pushed history and the
    strike-position delay, including the one-sample read convention. -/
theorem strikePeriodicNull (ops : Ops α) (cfg : Strike α) (held : ops.History) (input : α)
    (repeats : ops.tap (ops.push held input)
      (ops.plus (ops.divide (ops.times cfg.position cfg.sampleRate) cfg.frequency) (ops.literal 1)) =
      .ok input) (selfSub : ops.minus input input = ops.literal 0) :
    next ops cfg held input = .ok ⟨ops.literal 0, ops.push held input⟩ := by
  rw [strikeDifference]
  dsimp only
  rw [repeats]
  exact congrArg (fun x => Except.ok (LineSample.mk x (ops.push held input))) selfSub

/-- The handwritten sample update computes Smith's first-order difference
    equation and carries precisely the current input and output to the next step. -/
theorem allpassStateStep (ops : Ops α) (a input : α) (held : AllpassState α) :
    Allpasses.next ops a held input =
      let y := ops.minus (ops.plus (ops.times a input) held.input) (ops.times a held.output)
      ⟨y, ⟨input, y⟩⟩ := rfl

theorem allpassFactoredStep (ops : Ops α) (a x : α) (held : AllpassState α)
    (dist : ∀ u v w, ops.times u (ops.minus v w) = ops.minus (ops.times u v) (ops.times u w))
    (moveSub : ∀ u v w, ops.minus (ops.plus u v) w = ops.plus (ops.minus u w) v) :
    (Allpasses.next ops a held x).sample =
      ops.plus (ops.times a (ops.minus x held.output)) held.input :=
  Synthesis.allpassRecurrence _ _ _ a x held.input held.output dist moveSub

/-- Substitute one-sample delayed phasors q*x and q*y into the production
    recurrence, then collect output terms to derive Smith (5.2). -/
theorem allpassTransfer (ops : Ops α) (one a q x y : α)
    (response : (Allpasses.next ops a ⟨ops.times q x, ops.times q y⟩ x).sample = y)
    (unit : ∀ v, ops.times one v = v)
    (assoc : ∀ u v w, ops.times (ops.times u v) w = ops.times u (ops.times v w))
    (dist : ∀ u v w, ops.times (ops.plus u v) w = ops.plus (ops.times u w) (ops.times v w))
    (cancel : ∀ u v, ops.plus (ops.minus u v) v = u) :
    ops.times (ops.plus one (ops.times a q)) y = ops.times (ops.plus a q) x := by
  calc
    _ = ops.plus y (ops.times a (ops.times q y)) := by rw [dist, unit, assoc]
    _ = ops.plus (ops.times a x) (ops.times q x) :=
      (congrArg (fun v => ops.plus v (ops.times a (ops.times q y))) response.symm).trans (cancel _ _)
    _ = _ := (dist _ _ _).symm

/-- At a unit-circle frequency, (5.2) and the conjugate symmetry of its
    numerator and denominator give equal input and output magnitudes. -/
theorem allpassSteadyMagnitude {β : Type} (ops : Ops α) (conj : α → α) (norm : α → β)
    (multiply : β → β → β) (zero : β) (one a q x y : α)
    (response : (Allpasses.next ops a ⟨ops.times q x, ops.times q y⟩ x).sample = y)
    (realCoeff : conj a = a) (conjOne : conj one = one)
    (conjAdd : ∀ u v, conj (ops.plus u v) = ops.plus (conj u) (conj v))
    (conjMul : ∀ u v, conj (ops.times u v) = ops.times (conj u) (conj v))
    (normConj : ∀ v, norm (conj v) = norm v)
    (unitRotation : ∀ v, norm (ops.times v q) = norm v) (circle : ops.times (conj q) q = one)
    (unitL : ∀ v, ops.times one v = v) (unitR : ∀ v, ops.times v one = v)
    (assoc : ∀ u v w, ops.times (ops.times u v) w = ops.times u (ops.times v w))
    (dist : ∀ u v w, ops.times (ops.plus u v) w = ops.plus (ops.times u w) (ops.times v w))
    (swap : ∀ u v, ops.plus u v = ops.plus v u)
    (restore : ∀ u v, ops.plus (ops.minus u v) v = u)
    (normMul : ∀ u v, norm (ops.times u v) = multiply (norm u) (norm v))
    (denom : norm (ops.plus one (ops.times a q)) ≠ zero)
    (cancel : ∀ k u v, k ≠ zero → multiply k u = multiply k v → u = v) :
    norm y = norm x := by
  have magnitude := Synthesis.allpassMagnitude ops.plus ops.times conj norm one a q realCoeff
    conjOne conjAdd conjMul normConj unitRotation circle unitL unitR assoc dist swap
  have transfer := congrArg norm (allpassTransfer ops one a q x y response unitL assoc dist restore)
  rw [normMul, normMul, magnitude] at transfer
  exact cancel _ _ _ denom transfer

/-- Disabled ADAA applies the selected transfer curve to the current sample. -/
theorem shaperBypass (ops : Ops α) (shape : Curve) (x previous : α) :
    Waveshapers.shaped ops ⟨false, shape⟩ x previous = Waveshapers.curve ops shape x := rfl

/-- In the cancellation region the selected transfer curve is evaluated at the midpoint. -/
theorem shaperMidpoint (ops : Ops α) (shape : Curve) (x previous : α)
    (nearby : ops.less (ops.abs (ops.minus x previous)) ops.epsilon = true) :
    Waveshapers.shaped ops ⟨true, shape⟩ x previous =
      Waveshapers.curve ops shape (ops.times ops.half (ops.plus x previous)) := by
  unfold Waveshapers.shaped
  dsimp only
  rw [nearby]

theorem shaperQuotient (ops : Ops α) (shape : Curve) (x previous : α)
    (separated : ops.less (ops.abs (ops.minus x previous)) ops.epsilon = false) :
    Waveshapers.shaped ops ⟨true, shape⟩ x previous =
      ops.divide (ops.minus (Waveshapers.integral ops shape x) (Waveshapers.integral ops shape previous)) (ops.minus x previous) := by
  unfold Waveshapers.shaped
  dsimp only
  rw [separated]

/-- Apply Parker et al. (8)–(9) to the production quotient branch. -/
theorem shaperIntervalAverage (ops : Ops α) (shape : Curve) (x previous zero : α)
    (area : α → α → α) (distinct : ops.minus x previous ≠ zero)
    (separated : ops.less (ops.abs (ops.minus x previous)) ops.epsilon = false)
    (fundamental : ∀ a b, area a b = ops.minus (Waveshapers.integral ops shape b) (Waveshapers.integral ops shape a))
    (reverse : ∀ a b u v, ops.minus u v ≠ zero → ops.divide (ops.minus b a) (ops.minus v u) = ops.divide (ops.minus a b) (ops.minus u v)) :
    Waveshapers.shaped ops ⟨true, shape⟩ x previous = ops.divide (area x previous) (ops.minus previous x) :=
  (shaperQuotient ops shape x previous separated).trans
    (Synthesis.antiderivativeAverage _ _ area _ x previous zero distinct fundamental reverse).symm

/-- Curve and primitive dispatch remain paired for each supported shape. -/
theorem shaperCurvePair (ops : Ops α) (shape : Curve) (x : α) :
    (Waveshapers.curve ops shape x, Waveshapers.integral ops shape x) = (match shape with
      | .TanhCurve => (ops.tanh x, ops.tanhIntegral x)
      | .HardCurve => (ops.hard x, ops.hardIntegral x)
      | .CubicCurve => (ops.cubic x, ops.cubicIntegral x)
      | .FoldCurve => (ops.fold x, ops.foldIntegral x)) := by cases shape <;> rfl

theorem shaperPrimitiveOffset (ops : Ops α) (shape : Curve) (x prev c : α)
    (separated : ops.less (ops.abs (ops.minus x prev)) ops.epsilon = false)
    (cancel : ∀ a b k, ops.minus (ops.plus a k) (ops.plus b k) = ops.minus a b) :
    ops.divide (ops.minus (ops.plus (Waveshapers.integral ops shape x) c)
                          (ops.plus (Waveshapers.integral ops shape prev) c)) (ops.minus x prev) =
      Waveshapers.shaped ops ⟨true, shape⟩ x prev :=
  (Synthesis.antiderivativeOffset _ _ _ _ x prev c cancel).trans
    (shaperQuotient ops shape x prev separated).symm

theorem shaperConstantSegment (ops : Ops α) (shape : Curve) (x prev gain c zero : α)
    (separated : ops.less (ops.abs (ops.minus x prev)) ops.epsilon = false)
    (distinct : ops.minus x prev ≠ zero)
    (atX : Waveshapers.integral ops shape x = ops.plus (ops.times gain x) c)
    (atPrev : Waveshapers.integral ops shape prev = ops.plus (ops.times gain prev) c)
    (shift : ∀ a b k, ops.minus (ops.plus a k) (ops.plus b k) = ops.minus a b)
    (dist : ∀ a b k, ops.minus (ops.times k a) (ops.times k b) = ops.times k (ops.minus a b))
    (cancel : ∀ k a, a ≠ zero → ops.divide (ops.times k a) a = k) :
    Waveshapers.shaped ops ⟨true, shape⟩ x prev = gain := by
  rw [shaperQuotient ops shape x prev separated, atX, atPrev]
  exact Synthesis.antiderivativeConstantCurve _ _ _ _ x prev gain c zero distinct shift dist cancel

/-- The selected endpoint is returned without a floating multiply or add. -/
theorem interpolationEndpoints (ops : Ops α) (a b : α)
    (atZero : ops.equal (ops.literal 0) (ops.literal 0) = true)
    (distinct : ops.equal (ops.literal 1) (ops.literal 0) = false)
    (atOne : ops.equal (ops.literal 1) (ops.literal 1) = true) :
    Interpolation.linear ops a b (ops.literal 0) = a ∧ Interpolation.linear ops a b (ops.literal 1) = b := by
  constructor
  · unfold Interpolation.linear
    rw [atZero]
  · unfold Interpolation.linear
    rw [distinct, atOne]

theorem interpolationInterior (ops : Ops α) (a b t : α)
    (nonzero : ops.equal t (ops.literal 0) = false) (nonunit : ops.equal t (ops.literal 1) = false) :
    Interpolation.linear ops a b t = ops.plus a (ops.times (ops.minus b a) t) := by
  unfold Interpolation.linear
  rw [nonzero, nonunit]

theorem interpolationWeights (ops : Ops α) (a b t : α)
    (nonzero : ops.equal t (ops.literal 0) = false) (nonunit : ops.equal t (ops.literal 1) = false)
    (rightSub : ∀ x y z, ops.times (ops.minus x y) z = ops.minus (ops.times x z) (ops.times y z))
    (unit : ∀ x, ops.times (ops.literal 1) x = x) (comm : ∀ x y, ops.times x y = ops.times y x)
    (moveSub : ∀ x y z, ops.plus (ops.minus x y) z = ops.plus x (ops.minus z y)) :
    Interpolation.linear ops a b t = ops.plus (ops.times (ops.minus (ops.literal 1) t) a) (ops.times t b) :=
  (interpolationInterior ops a b t nonzero nonunit).trans
    (Synthesis.interpolatorFactor _ _ _ _ a b t rightSub unit comm moveSub).symm

theorem interpolationConstant (ops : Ops α) (a t : α)
    (selfSub : ∀ x, ops.minus x x = ops.literal 0)
    (zeroTimes : ∀ x, ops.times (ops.literal 0) x = ops.literal 0)
    (plusZero : ∀ x, ops.plus x (ops.literal 0) = x) :
    Interpolation.linear ops a a t = a := by
  unfold Interpolation.linear
  cases ops.equal t (ops.literal 0) <;> cases ops.equal t (ops.literal 1) <;> first
    | rfl
    | exact Synthesis.interpolatorConstant _ _ _ _ a t selfSub zeroTimes plusZero

/-- Smart (7)–(9). With both indices zero, the production oscillator takes
    exactly the phase-distortion path at every position, including the breakpoint. -/
theorem wavePulseZeroIndices (ops : Ops α) (phase d r₁ r₂ p₁ p₂ : α)
    (timesZero : ∀ x, ops.times x (ops.literal 0) = ops.literal 0)
    (zeroTimes : ∀ x, ops.times (ops.literal 0) x = ops.literal 0)
    (plusZero : ∀ x, ops.plus x (ops.literal 0) = x) :
    PhaseOperators.shaped ops (.WavePulsePhase d ⟨ops.literal 0, r₁, p₁⟩ ⟨ops.literal 0, r₂, p₂⟩) phase =
    PhaseOperators.shaped ops (.DistortedPhase d) phase := by
  unfold PhaseOperators.shaped PhaseOperators.pulse
  dsimp only
  cases ops.less phase d <;> dsimp only <;> rw [timesZero, zeroTimes, plusZero]

/-- Smart (8). A pulse uses the index, ratio and offset of its own controls. -/
theorem phasePulse (ops : Ops α) (t : α) (p : Pulse α) :
    PhaseOperators.pulse ops t p = ops.times (ops.times (ops.window t) p.index)
      (ops.sin (ops.times ops.tau (ops.plus (ops.times p.ratio t) p.offset))) := rfl

/-- Smart (7) and (9). Each segment contributes its own pulse on a local ramp. -/
theorem wavePulseSegments (ops : Ops α) (phase d : α) (first second : Pulse α) :
    PhaseOperators.shaped ops (.WavePulsePhase d first second) phase =
      match ops.less phase d with
      | true => ops.plus (ops.divide phase (ops.times (ops.literal 2) d))
                         (PhaseOperators.pulse ops (ops.divide phase d) first)
      | false =>
        let remaining := ops.minus (ops.literal 1) d
        let elapsed := ops.minus phase d
        ops.plus (ops.plus ops.half (ops.divide elapsed (ops.times (ops.literal 2) remaining)))
                 (PhaseOperators.pulse ops (ops.divide elapsed remaining) second) := by
  unfold PhaseOperators.shaped PhaseOperators.basePhase
  dsimp only
  cases ops.less phase d <;> rfl

/-- First and last grain samples have exactly zero amplitude, regardless of
    the rounding of the cosine implementation. -/
theorem grainHannEndpoints (ops : Ops α) (first last duration : Nat)
    (firstGuard : ops.atMost (ops.toFloat first) (ops.literal 0) = true)
    (lastGuard : ops.atLeast (ops.toFloat last) (ops.minus (ops.toFloat duration) (ops.literal 1)) = true) :
    GrainWindows.value ops .HannWindow first duration = ops.literal 0 ∧
    GrainWindows.value ops .HannWindow last duration = ops.literal 0 := by
  unfold GrainWindows.value GrainWindows.hann
  dsimp only
  constructor
  · rw [firstGuard]; rfl
  · rw [lastGuard]; cases ops.atMost (ops.toFloat last) (ops.literal 0) <;> rfl

theorem grainHannInterior (ops : Ops α) (age duration : Nat)
    (started : ops.atMost (ops.toFloat age) (ops.literal 0) = false)
    (unfinished : ops.atLeast (ops.toFloat age) (ops.minus (ops.toFloat duration) (ops.literal 1)) = false) :
    GrainWindows.value ops .HannWindow age duration =
      ops.minus ops.half (ops.times ops.half (ops.cos (ops.divide
        (ops.times ops.tau (ops.toFloat age)) (ops.minus (ops.toFloat duration) (ops.literal 1))))) := by
  unfold GrainWindows.value GrainWindows.hann
  dsimp only
  rw [started, unfinished]
  rfl

/-- In the supported integer range the cast of n+1 minus one is exactly
    the cast of n. Specialize the guard result to the actual sample indices. -/
theorem grainHannBoundarySamples (ops : Ops α) (n : Nat)
    (zeroCast : ops.toFloat 0 = ops.literal 0)
    (exactLast : ops.minus (ops.toFloat (n+1)) (ops.literal 1) = ops.toFloat n)
    (leRefl : ∀ x, ops.atMost x x = true) (geRefl : ∀ x, ops.atLeast x x = true) :
    GrainWindows.value ops .HannWindow 0 (n+1) = ops.literal 0 ∧
    GrainWindows.value ops .HannWindow n (n+1) = ops.literal 0 := by
  apply grainHannEndpoints
  · rw [zeroCast, leRefl]
  · rw [exactLast, geRefl]

end ProductionFft
