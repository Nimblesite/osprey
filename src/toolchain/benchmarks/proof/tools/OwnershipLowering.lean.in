/- [MEM-OWNERSHIP-STATIC-VERIFICATION] Translation validation of the native
   compiler's emitted scalar grow and conditional grow paths. Registers identify
   allocations; each append returns a fresh root. Contents model the C helper's
   persistent-list contract. Stack slots hold raw pointers and expire on return.
   The reflector resolves predecessor-selected phi operands and preserves free(null)
   for verification against the compiled drop guard. A load's value is checked here. -/
namespace OwnershipLowering

def immediateDropReturn (isNull : Bool) : Bool :=
-- NULL DROP

theorem compiledFreeNull : immediateDropReturn true = true := by rfl

inductive Instr where
  | reserve (slot : Nat)
  | store (slot : Nat) (reg : Option Nat)
  | load (slot : Nat) (expected : Option Nat)
  | append (src dst : Nat)
  | free (reg : Option Nat)
  | ret (reg : Nat)

def emitted : List Instr :=
-- EMITTED BODY

def conditional (enabled : Bool) : List Instr := if enabled then
-- ENABLED BODY
else
-- DISABLED BODY

structure Machine (α : Type) where
  heap : List (Nat × List α)
  slots : List (Nat × Option Nat)

def execute (element : α) (s : Machine α) : List Instr → Option (List α)
  -- Reflection assigns a slot id at its unique alloca and checks dominance
  -- before each access. LLVM alloca alone leaves the contents uninitialized.
  | .reserve _ :: rest => execute element s rest
  | .store slot reg :: rest => execute element {s with slots := (slot, reg) :: s.slots} rest
  | .load slot expected :: rest =>
    if s.slots.lookup slot == some expected then execute element s rest else none
  | .append src dst :: rest => do
    let xs ← s.heap.lookup src
    if (s.heap.lookup dst).isSome then none else
      execute element {s with heap := (dst, xs ++ [element]) :: s.heap} rest
  | .free none :: rest => if immediateDropReturn true then execute element s rest else none
  | .free (some reg) :: rest =>
    if (s.heap.lookup reg).isSome then
      execute element {s with heap := s.heap.filter (fun entry => entry.1 != reg)} rest
    else none
  | [.ret reg] =>
    match s.heap with
    | [(owner, result)] => if owner == reg then some result else none
    | _ => none
  | _ => none

/-- Every input produces the source result and returns its only surviving root.
    A stale read, invalid free or extra surviving allocation yields none. -/
theorem compiledGrow (xs : List α) (x : α) :
    execute x ⟨[(0, xs)], []⟩ emitted = some (xs ++ [x]) := by rfl

theorem compiledGrowWhen (xs : List α) (x : α) (enabled : Bool) :
    execute x ⟨[(0, xs)], []⟩ (conditional enabled) =
      some (if enabled then xs ++ [x] else xs) := by cases enabled <;> rfl

/- Each fork represents an arbitrary incoming edge or return site of the
   compiled C helper. Allocation denotes the external tagged allocator. The
   result concerns address origin on a defined, normally returning execution.
   Allocator correctness and survival of that allocation are separate. -/
inductive Origin where
  | allocated
  | nullResult
  | other
  | fork (left right : Origin)

def allocatorOrigin (allowNull : Bool) (pick : Nat → Bool) (depth : Nat) : Origin → Bool
  | .allocated => true
  | .nullResult => allowNull
  | .other => false
  | .fork a b => if pick depth then allocatorOrigin allowNull pick (depth+1) a
                  else allocatorOrigin allowNull pick (depth+1) b

inductive Allocated (allowNull : Bool) : Origin → Prop where
  | leaf : Allocated allowNull .allocated
  | nullResult : allowNull = true → Allocated allowNull .nullResult
  | fork : Allocated allowNull left → Allocated allowNull right → Allocated allowNull (.fork left right)

theorem allocatedPath {allowNull : Bool} (pick : Nat → Bool) (depth : Nat) (h : Allocated allowNull root) :
    allocatorOrigin allowNull pick depth root = true := by
  induction h generalizing depth with
  | leaf => rfl
  | nullResult h => exact h
  | fork _ _ left right =>
    unfold allocatorOrigin
    split
    · exact left _
    · exact right _

def appendReturns : Origin :=
-- APPEND RETURNS
def prependReturns : Origin :=
-- PREPEND RETURNS
def mapSetReturns : Origin :=
-- MAP SET RETURNS

theorem runtimeRootOrigins (pick : Nat → Bool) :
    allocatorOrigin false pick 0 appendReturns = true ∧
    allocatorOrigin false pick 0 prependReturns = true ∧
    allocatorOrigin false pick 0 mapSetReturns = true := by
  refine ⟨allocatedPath pick 0 ?_, allocatedPath pick 0 ?_, allocatedPath pick 0 ?_⟩ <;>
    repeat constructor

def stringRenderReturns : Origin :=
-- STRING RENDER RETURNS

theorem renderedStringOrigin (pick : Nat → Bool) :
    allocatorOrigin true pick 0 stringRenderReturns = true := by
  apply allocatedPath
  repeat constructor

inductive StringOp where
  | concat | take | drop | substring | to_upper | to_lower | trim_start | trim_end
  | trim | reverse | replace | «repeat» | pad_start | pad_end | from_codepoint

def stringOpReturns : StringOp → Origin
-- STRING OP RETURNS

theorem stringResultOrigins (op : StringOp) (pick : Nat → Bool) :
    allocatorOrigin true pick 0 (stringOpReturns op) = true := by
  apply allocatedPath
  cases op <;> repeat constructor

end OwnershipLowering
