// The tensor dialect GPT-2 is written in. `gpt2::Model` performs `Tensor`
// operations and never names a buffer type; `Cpu::onLists` (cpu.osp) answers
// every operation with host list code and `Gpu::onGpu` (gpu.osp) with the GPU
// surface. The handler a program installs decides where the arithmetic runs,
// with host runs checked exactly against examples/gpt2/reference.py in the same
// accumulation order. Device transcendental differences use the README's bounds.
// Implements [STAGE-BACKEND], [GPU-DEVICE].

namespace gpt2;

module Backends {
    /// The kernels a model hands its handler: an index to its element, and two
    /// elements to one.
    export type Kernel = fn(int) -> float
    export type Combine = fn(float, float) -> float

    /// The operations a model needs: build a buffer from an index function,
    /// read and measure one, combine two, reduce one, find the first index
    /// holding a value, multiply two matrices, lift a host list, load a tensor
    /// from a safetensors file, and say which interpretation is answering. `B`
    /// is the representation the handler picks.
    export static effect Tensor<B> {
        build: fn(int, Kernel) -> B
        get: fn(B, int) -> float
        length: fn(B) -> int
        zipWith: fn(B, B, Combine) -> B
        reduce: fn(B, float, Combine) -> float
        indexOf: fn(B, float) -> int
        matMul: fn(B, B, int, int, int) -> B
        fromList: fn(List<float>) -> B
        load: fn(string, string) -> B
        device: fn() -> string
    }

    /// `indexOf`'s two steps under both handlers: element i names itself when
    /// it holds x and the length n otherwise, and the smallest name wins, so
    /// the answer is the first index holding x or n when none does.
    export fn hit(v, x, i, n) = match v == x { true => i  false => n }
    export fn minI(a, i) = match i < a { true => i  false => a }

    /// An arithmetic fault ends the run: its arm answers the whole region.
    effect Fault {
        control halt: fn(string) -> int
    }

    /// Runs `work` under GPT-2's arithmetic policy: Success with its value, or
    /// Error naming the first fault. A fault is a bug in the model, never a value
    /// to substitute — a fabricated 0.0 is indistinguishable from a real logit —
    /// so it stops the run, as a device kernel's fault does [GPU-DEVICE-FAULT].
    export fn strictly(work) = {
        handle Fault { halt fault => Error { message: fault } }
        handle Arith {
            overflow op l r _ => perform Fault.halt("integer overflow: ${l} ${op} ${r}")
            divideByZero op l => toFloat(perform Fault.halt("division by zero: ${l} ${op} 0"))
            remainderByZero l => perform Fault.halt("remainder by zero: ${l} % 0")
        }
        Success { value: work() }
    }

    /// Runs `work` under the handler `name` selects. An unknown name runs
    /// nothing, so a mistyped backend never silently lands on the GPU surface.
    export fn under(name, work) = match name {
        "gpu" => Gpu::onGpu(work)
        "lists" => Cpu::onLists(work)
        _ => print("unknown backend `${name}`: choose gpu or lists")
    }
}
