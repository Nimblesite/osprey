// Flock's keyed regions, scene primitives and semantic theme ([UI-SCENE], [UI-REGIONS]).
namespace flock

import ui::Ui
import ui::Keyed
import ui::Scenes
import flock::Simulation

(** The scene, HUD, settings and theme for Flock. *)
module View
    worldSlice () = perform Signal<World>.read ()

    settingsSlice () = perform Signal<Settings>.read ()

    scoresSlice () = perform Signal<Scores>.read ()

    meadowColour () = Scenes::rgb (24, 44, 33)

    penColour () = Scenes::rgba (92, 211, 146, 46)

    fenceColour () = Scenes::rgb (196, 160, 104)

    birdColour () = Scenes::rgb (176, 214, 255)

    hawkColour () = Scenes::rgb (255, 107, 107)

    hawkHalo () = Scenes::rgba (255, 107, 107, 48)

    playerColour () = Scenes::rgb (92, 211, 146)

    playerHalo () = Scenes::rgba (92, 211, 146, 40)

    labelColour () = Scenes::rgba (230, 240, 232, 200)

    // Depth layers: 0 ground, 1 markings, 2 birds, 3 hawks and the dog, 4 text.
    birdShape b = Scenes::disc (b.birdX, b.birdY, 1.3, birdColour (), 2)

    hawkShapes hawk = [Scenes::disc (hawk.hawkX, hawk.hawkY, 5.0, hawkHalo (), 3), Scenes::disc (hawk.hawkX, hawk.hawkY, 2.4, hawkColour (), 3)]

    // The herding radius (forty units, as in Simulation::herd) drawn as a 24-segment ring.
    ringPoint (player, out, i) =
        turn = toFloat i * 0.261799
        listConcat out [player.playerX + cos turn * 40.0, player.playerY + sin turn * 40.0]

    ring player = range (0, 25) |> fold [] (\(out, i) => ringPoint (player, out, i))

    dogShapes player = [Scenes::strip (ring player, playerHalo (), 0.6, 1), Scenes::disc (player.playerX, player.playerY, 4.5, playerHalo (), 3), Scenes::disc (player.playerX, player.playerY, 2.2, playerColour (), 3)]

    ground () = [Scenes::rect (160.0, 100.0, 320.0, 200.0, 0.0, meadowColour (), 0), Scenes::rect (305.0, 100.0, 30.0, 200.0, 0.0, penColour (), 0), Scenes::strip ([290.0, 0.0, 290.0, 200.0], fenceColour (), 1.2, 1), Scenes::glyphs ("PEN", 294.0, 4.0, 7.0, labelColour (), 4)]

    // Ground, birds, hawks and the dog share one flat primitive list ordered by depth.
    sceneShapes world = listConcat (ground ()) (listConcat (mapList (world.birds, birdShape)) (listConcat (foldList (world.hawks, [], \(out, hawk) => listConcat out (hawkShapes hawk))) (dogShapes world.player)))

    (** The 320 by 200 field; every primitive is drawn, so no atlas is needed. *)
    export field () = Ui::scene (320.0, 200.0, [], sceneShapes (worldSlice ()), Play)

    pauseLabel paused = match paused
        true => "Resume"
        false => "Pause"

    pauseItem paused = match paused
        true => [Ui::styled ("Paused", ui::Title, ui::Caution)]
        false => []

    // Pause is visible in the HUD as well as stopping the simulation clock.
    hudItems (world, settings) = listConcat [Ui::badge ("Round ${world.roundNumber}", ui::Play, ui::Accent), Ui::badge ("Score ${world.scoreValue}", ui::Star, ui::Good), Ui::badge ("Flock ${length world.birds}", ui::Inbox, ui::Primary), Ui::badge ("FPS ${world.fps}", ui::Settings, ui::Secondary), Ui::button (pauseLabel settings.paused, ui::NoSymbol, TogglePause)] (pauseItem settings.paused)

    (** Status badges and the pause control, refreshed with world or settings. *)
    export hud () = Ui::row (hudItems (worldSlice (), settingsSlice ()))

    bestText best = match length best == 0
        true => "No rounds finished yet"
        false => "Best rounds: ${join (mapList (best, \score => "${score}")) "  "}"

    (** One compact bar: flock size and the persisted top-five scores. *)
    export panel () =
        settings = settingsSlice ()
        Ui::row [Ui::picker ("Flock size", [Ui::choice ("1000", "1000"), Ui::choice ("2000", "2000"), Ui::choice ("5000", "5000"), Ui::choice ("10000", "10000")], "${settings.flockSize}", SizeChosen), Ui::styled (bestText (scoresSlice ()).best, ui::Caption, ui::Secondary)]

    (** The stable region hierarchy; it reads no application signal. *)
    export root () = Ui::column [Ui::slot "hud", Ui::slot "field", Ui::slot "panel"]

    (** Rebuilds only regions whose world, settings or scores signals changed. *)
    export regions (before, store, frames, _) =
        handle static Signal<World>
            read => store.world
        handle static Signal<Settings>
            read => store.settings
        handle static Signal<Scores>
            read => store.scores
        changed = listConcat (signalChanges before.world store.world Simulation::worldStamp (signalDependencies worldSlice)) (listConcat (signalChanges before.settings store.settings Simulation::settingsJson (signalDependencies settingsSlice)) (signalChanges before.scores store.scores Simulation::scoresDocument (signalDependencies scoresSlice)))
        [Keyed::region (frames, "field", changed, field), Keyed::region (frames, "hud", changed, hud), Keyed::region (frames, "panel", changed, panel), Keyed::region (frames, "root", changed, root)]

    token (name, light, dark) = ui::Token(tokenName = name, tokenLight = light, tokenDark = dark)

    (** Flock's light/dark semantic colours, spacing and motion durations. *)
    export theme () = ui::Theme(tokens = [token ("accent", "#2F6FED", "#7FA7FF"), token ("caution", "#B86E00", "#FFB454"), token ("good", "#1E7F4F", "#5CD392"), token ("danger", "#C62828", "#FF6B6B"), token ("background", "#F4F6FA", "#14161B"), token ("text", "#111111", "#EEEEEE")], spacing = [4, 8, 12, 20, 28, 36], feedback = 120, settle = 220)
