// The painting port's application callbacks and message routing ([UI-STORE], [UI-SCENE]).
namespace painting

import ui::Runtime
import ui::Messages
import ui::Inputs
import painting::Drawing
import painting::View

(** The application exported through the painting port's two-function C boundary. *)
module App
    (** An empty sketch with solid strokes; nothing is requested. *)
    export initial _ = Runtime::step (Drawing::initialStore ())

    tapped (store, action) = match action
        ToggleDash => Drawing::toggleDash store
        Clear => Drawing::clear store
        Draw => Runtime::step store

    controlled (store, action, input) = match action
        Draw => Inputs::route (input, \(_, _) => Runtime::step store, \(x, y, down, shift) => Drawing::pointer (store, x, y, down, shift))
        _ => Runtime::step store

    (** Routes every framework message the port uses; the rest leave the store as it is. *)
    export update (_, store, message) = Messages::route (message, \action => tapped (store, action), \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \_ => Runtime::step store, \(action, input) => controlled (store, action, input))

    (** Refreshes the canvas, header and root regions. *)
    export regions (before, after, frames, writes) = View::regions (before, after, frames, writes)

    (** Serializes the store. *)
    export save store = Drawing::save store

    (** Restores the store. *)
    export restore doc = Drawing::restore doc

    (** The white theme. *)
    export theme () = View::theme ()
