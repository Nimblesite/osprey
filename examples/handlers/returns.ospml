// Record faults for the entire report and reject it at the publication boundary.
printExact work =
    mut fault = ""
    handle Arith
        overflow op lhs _ _ =>
            fault := "overflow in ${op}"
            lhs
        divideByZero op lhs =>
            fault := "zero divisor in ${op}"
            lhs
        remainderByZero lhs =>
            fault := "zero remainder divisor"
            lhs
    report = work ()
    output = match fault
        "" => report
        _ => "REJECTED: ${fault}"
    print output

effect ValueAsk
    value : Unit => int
effect ControlAsk
    control value : Unit => int
valueWork () = (perform ValueAsk.value () + 1) 
controlWork () = (perform ControlAsk.value () + 1) 
prefix = "done="
replace = handler ValueAsk
    value => 41
    return n => "${prefix}${n}"
around = handler ControlAsk
    value => "${resume 41}!"
    return n => "${prefix}${n}"
stop = handler ControlAsk
    value => "stopped"
    return n => "${prefix}${n}"
report () =
    "${replace valueWork}\n${around controlWork}\n${stop controlWork}"

printExact report
