namespace proof

import proof::Terms

(** What a constant is. A definition unfolds; an axiom and a theorem do not. *)
type Body = Axiom | Definition Term | Theorem Term

(** One constant of the environment, with its universe parameters. *)
type Decl =
    name : string
    params : List<string>
    ty : Term
    body : Body

(** The environment of [PROOF-KERNEL-THEORY]: constants by name, in
    declaration order. *)
type Env =
    decls : Map<string, Decl>
    order : List<string>

(** Building and reading the environment. *)
module Environment
    (** No constants. *)
    export empty () = Env(decls = Map(), order = [])

    (** The declaration named, if any. *)
    export find (env, name) = mapGet (env.decls, name)

    (** The environment with `decl` added; a name already taken is an error,
        so a theorem can never be shadowed. *)
    export add (env, decl) = match mapContains (env.decls, decl.name)
        true => Error(message = "constant `${decl.name}` is already declared")
        false => Success(value = Env(decls = mapSet (env.decls, decl.name, decl), order = listAppend (env.order, decl.name)))

    (** The value a definition unfolds to, if `name` is a definition. *)
    export unfold (env, name) = match find (env, name)
        Success decl => unfoldBody decl.body
        Error message => Error(message = message)

    unfoldBody body = match body
        Definition value => Success(value = value)
        Theorem value => Error(message = "theorems are opaque")
        Axiom => Error(message = "axioms do not unfold")
