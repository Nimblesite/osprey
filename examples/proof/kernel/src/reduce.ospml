namespace proof

import proof::Levels
import proof::Terms
import proof::Environment
import proof::Naturals
import proof::Infer
import proof::Surface
import proof::Numeric

(** Reduction and definitional equality of [PROOF-KERNEL-THEORY]: β, δ, ζ
    and ι/K to weak head normal form, and η in the comparison.
    Typed comparison also checks proof irrelevance under its binder
    context, followed by η for checked non-recursive structures. *)
module Reduce
    (** Weak head normal form under `env`. *)
    export whnf (env, term) = match term
        App head arg => numericApp (env, head, arg, Numeric::step (env, term))
        Let name ty value body => whnf (env, Terms::instantiate (body, value))
        Const name levels => whnfConst (env, term, name, levels)
        Proj family index target => projection (env, term, family, index, Terms::spine (whnf (env, target)))
        NatLit value => naturalHead value
        other => other

    numericApp (env, head, arg, reduced) = match reduced
        NumericReduced value => whnf (env, value)
        NoNumericRule => whnfApp (env, whnf (env, head), arg)

    (** A literal exposes just one constructor, keeping arbitrary values
        compact while allowing the ordinary checked Nat recursor to fire. *)
    naturalHead (value) = match Naturals::predecessor value
        Success previous => App (Const "Nat.succ" []) (NatLit previous)
        Error _ => Const "Nat.zero" []

    (** A checked projection reduces only at its own constructor's field.
        Implements [PROOF-KERNEL-THEORY]. *)
    projection (env, term, family, index, spine) = match spine.spineHead
        Const name levels => projectionFound (env, term, family, index, spine.spineArgs, Environment::find (env, name))
        other => term

    projectionFound (env, term, family, index, args, found) = match found
        Success decl => projectionBody (env, term, family, index, args, decl.body)
        Error _ => term

    projectionBody (env, term, family, index, args, body) = match body
        Constructor ctor => projectionField (env, term, args, satAdd ctor.ctorParams index, ctor.ctorFamily == family && index >= 0 && index < ctor.ctorFields && listLength args == satAdd ctor.ctorParams ctor.ctorFields)
        other => term

    projectionField (env, term, args, at, valid) = match valid
        true => match listGet (args, at)
            Success field => whnf (env, field)
            Error _ => term
        false => term

    whnfApp (env, head, arg) = match head
        Lam name domain body => whnf (env, Terms::instantiate (body, arg))
        other => iota (env, App other arg)

    (** ι: a recursor applied through its major premise, when the major
        premise reduces to a constructor applied to the family's
        parameters and all its fields, steps to the rule's right-hand side
        applied to the parameters, motive and minor premises, the
        constructor's fields, and whatever followed the major premise. *)
    iota (env, term) = iotaSpine (env, term, Terms::spine term)

    iotaSpine (env, term, spine) = match spine.spineHead
        Const name levels => iotaConst (env, term, spine, Environment::find (env, name), levels)
        other => term

    iotaConst (env, term, spine, found, levels) = match found
        Success decl => iotaDecl (env, term, spine, decl, levels)
        Error _ => term

    iotaDecl (env, term, spine, decl, levels) = match decl.body
        Recursor elim => iotaMajor (env, term, spine, decl, elim, levels, satAdd (satAdd elim.elimParams 1) (satAdd elim.elimMinors elim.elimIndices))
        Quotient kind => quotient (env, term, spine.spineArgs, kind)
        other => term

    (** Quotient computation uses checked primitive tags, never names alone.
        Lift respects its relation by type; induction's motive is Prop-only.
        Both preserve applications after the quotient argument. *)
    quotient (env, term, args, kind) = match kind
        QuotLift => quotientMajor (env, term, args, 5)
        QuotInd => quotientMajor (env, term, args, 4)
        other => term

    quotientMajor (env, term, args, at) = match listGet (args, at)
        Success major => quotientHead (env, term, args, at, Terms::spine (whnf (env, major)))
        Error _ => term

    quotientHead (env, term, args, at, major) = match major.spineHead
        Const name levels => match Environment::find (env, name)
            Success decl => quotientBody (env, term, args, at, major.spineArgs, decl.body)
            Error _ => term
        other => term

    quotientBody (env, term, args, at, parts, body) = match body
        Quotient kind => match kind
            QuotCtor => quotientReady (env, term, args, at, parts)
            other => term
        other => term

    quotientReady (env, term, args, at, parts) = match listLength parts == 3 && sameIndices (env, Terms::prefix (args, 2), Terms::prefix (parts, 2))
        false => term
        true => match listGet (args, 3)
            Success function => match listGet (parts, 2)
                Success representative => whnf (env, Terms::apps (App function representative, Terms::suffix (args, satAdd at 1)))
                Error _ => term
            Error _ => term

    iotaMajor (env, term, spine, decl, elim, levels, at) = match listGet (spine.spineArgs, at)
        Success major => iotaCtor (env, term, spine, decl, elim, levels, at, Terms::spine (whnf (env, major)))
        Error _ => term

    iotaCtor (env, term, spine, decl, elim, levels, at, major) = match major.spineHead
        Const name ctorLevels => iotaRule (env, term, spine, decl, elim, levels, at, major, filterList (elim.elimRules, \rule => rule.ruleCtor == name))
        other => iotaK (env, term, spine, decl, elim, levels, at)

    iotaRule (env, term, spine, decl, elim, levels, at, major, found) = match found
        [rule] => iotaFire (env, term, spine, decl, elim, levels, at, major, rule)
        other => iotaK (env, term, spine, decl, elim, levels, at)

    iotaFire (env, term, spine, decl, elim, levels, at, major, rule) = match listLength major.spineArgs == satAdd elim.elimParams rule.ruleFields
        true => iotaStep (env, term, spine, elim, at, major, Environment::instantiated (decl, rule.ruleRhs, levels))
        false => term

    iotaStep (env, term, spine, elim, at, major, rhs) = match rhs
        Success body => whnf (env, Terms::apps (Terms::apps (Terms::apps (body, Terms::prefix (spine.spineArgs, satAdd (satAdd elim.elimParams 1) elim.elimMinors)), Terms::suffix (major.spineArgs, elim.elimParams)), Terms::suffix (spine.spineArgs, satAdd at 1)))
        Error _ => term

    (** K uses only a checked subsingleton recursor with no constructor
        fields, and only when its supplied indices match that constructor.
        Implements [PROOF-KERNEL-THEORY]. *)
    iotaK (env, term, spine, decl, elim, levels, at) = match elim.elimK
        false => term
        true => match elim.elimRules
            [rule] => kRule (env, term, spine, decl, elim, levels, at, rule)
            other => term

    kRule (env, term, spine, decl, elim, levels, at, rule) = match rule.ruleFields == 0
        false => term
        true => match Environment::find (env, rule.ruleCtor)
            Success ctor => kConstructor (env, term, spine, decl, elim, levels, at, rule, ctor, ctor.body)
            Error _ => term

    kConstructor (env, term, spine, decl, elim, levels, at, rule, ctor, body) = match body
        Constructor info => match info.ctorFields == 0 && info.ctorParams == elim.elimParams && info.ctorFamily == elim.elimFamily
            true => kCandidate (env, term, spine, decl, elim, levels, at, rule, ctor)
            false => term
        other => term

    kCandidate (env, term, spine, decl, elim, levels, at, rule, ctor) =
        ctorLevels = mapList (ctor.params, \name => Levels::instantiate (Param name, decl.params, levels))
        parameters = Terms::prefix (spine.spineArgs, elim.elimParams)
        candidate = Spine(spineHead = Const ctor.name ctorLevels, spineArgs = parameters)
        match Environment::instantiated (ctor, ctor.ty, ctorLevels)
            Success ty => kTyped (env, term, spine, decl, elim, levels, at, rule, candidate, appliedType (ty, parameters))
            Error _ => term

    appliedType (ty, args) = match args
        [] => Success(value = ty)
        [arg, ...rest] => match ty
            Pi name domain body => appliedType (Terms::instantiate (body, arg), rest)
            other => Error(message = "constructor parameters do not match its type")

    kTyped (env, term, spine, decl, elim, levels, at, rule, candidate, result) = match result
        Success ty => match kIndices (env, spine.spineArgs, elim, Terms::spine ty)
            true => iotaFire (env, term, spine, decl, elim, levels, at, candidate, rule)
            false => term
        Error _ => term

    kIndices (env, args, elim, result) = match result.spineHead
        Const name levels => name == elim.elimFamily && listLength result.spineArgs == satAdd elim.elimParams elim.elimIndices && sameIndices (env, Terms::suffix (result.spineArgs, elim.elimParams), Terms::prefix (Terms::suffix (args, satAdd (satAdd elim.elimParams 1) elim.elimMinors), elim.elimIndices))
        other => false

    sameIndices (env, left, right) = match left
        [] => isEmpty right
        [first, ...rest] => match right
            [other, ...more] => defeq (env, first, other) && sameIndices (env, rest, more)
            other => false

    whnfConst (env, term, name, levels) = match Environment::unfold (env, name, levels)
        Success value => whnf (env, value)
        Error message => term

    (** Lean's recursor-major structure eta needs the binder context: a
        checked structure-valued major becomes its constructor applied to
        projections before ordinary iota. Implements [PROOF-KERNEL-THEORY]. *)
    contextual (env, context, term) = contextualHead (env, context, whnf (env, term))

    contextualHead (env, context, term) = match term
        App _ _ => contextualSpine (env, context, term, Terms::spine term)
        Proj family index target => contextualStep (env, context, term, projection (env, term, family, index, Terms::spine (contextual (env, context, target))))
        other => term

    contextualSpine (env, context, term, spine) = match spine.spineHead
        Const name levels => match Environment::find (env, name)
            Success decl => contextualBody (env, context, term, spine, decl, levels, decl.body)
            Error _ => term
        other => term

    contextualBody (env, context, term, spine, decl, levels, body) = match body
        Recursor elim => match listGet (spine.spineArgs, satAdd (satAdd elim.elimParams 1) (satAdd elim.elimMinors elim.elimIndices))
            Success major => contextualMajor (env, context, term, spine, decl, levels, elim, major, Infer::infer (env, context, major))
            Error _ => term
        other => term

    contextualMajor (env, context, term, spine, decl, levels, elim, major, inferred) = match inferred
        Success ty => contextualSort (env, context, term, spine, decl, levels, elim, major, ty, Infer::sort (env, context, ty))
        Error _ => term

    contextualSort (env, context, term, spine, decl, levels, elim, major, ty, sorted) = match sorted
        Error _ => term
        Success level => match (Levels::equal level Zero)
            true => term
            false => contextualType (env, context, term, spine, decl, levels, elim, major, ty, Terms::spine (whnf (env, ty)))

    contextualType (env, context, term, spine, decl, levels, elim, major, ty, target) = match target.spineHead
        Const name universes => match name == elim.elimFamily && elim.elimIndices == 0 && listLength target.spineArgs == elim.elimParams
            false => term
            true => match Environment::find (env, name)
                Success family => contextualFamily (env, context, term, spine, decl, levels, elim, major, ty, target, universes, family.body)
                Error _ => term
        other => term

    contextualFamily (env, context, term, spine, decl, levels, elim, major, ty, target, universes, body) = match body
        TypeFormer family => match family.familyParams == elim.elimParams && family.familyIndices == 0 && !family.familyRecursive && !family.familyReflexive
            false => term
            true => match family.familyCtors
                [name] => match Environment::find (env, name)
                    Success ctor => contextualConstructor (env, context, term, spine, decl, levels, elim, major, ty, target, universes, ctor, ctor.body)
                    Error _ => term
                other => term
        other => term

    contextualConstructor (env, context, term, spine, decl, levels, elim, major, ty, target, universes, ctor, body) = match body
        Constructor info => match info.ctorFamily == elim.elimFamily && info.ctorParams == elim.elimParams && info.ctorFields >= 0
            true => contextualCandidate (env, context, term, spine, decl, levels, elim, ty, Terms::apps (Const ctor.name universes, listConcat (target.spineArgs, etaFields (elim.elimFamily, major, info.ctorFields, 0))))
            false => term
        other => term

    etaFields (family, major, count, index) = match index >= count
        true => []
        false => listPrepend (etaFields (family, major, count, satAdd index 1), Proj family index major)

    contextualCandidate (env, context, term, spine, decl, levels, elim, ty, candidate) = match Infer::check (env, context, candidate, ty)
        Error _ => term
        Success _ => match Infer::infer (env, context, term)
            Error _ => term
            Success _ => contextualStep (env, context, term, iotaCtor (env, term, spine, decl, elim, levels, satAdd (satAdd elim.elimParams 1) (satAdd elim.elimMinors elim.elimIndices), Terms::spine candidate))

    contextualStep (env, context, term, next) = match Terms::equal (term, next)
        true => term
        false => contextual (env, context, next)

    (** Definitional equality without a context: both sides to weak head
        normal form, then structural comparison with η for lambdas. *)
    export defeq (env, left, right) = conversion (env, [], left, right, false)

    (** Typed definitional equality: the structural comparison runs first,
        and typed proof equality is consulted only for an unsettled node.
        Direct mutual recursion avoids recursive callback specialization. Implements [PROOF-KERNEL-THEORY]. *)
    export conversion (env, context, left, right, proofs) = match structural (env, context, left, right, proofs)
        true => true
        false => (proofs && Infer::proofEqual (env, context, left, right)) || structureEta (env, context, left, right, proofs) || structureEta (env, context, right, left, proofs)

    (** Structure η derives projections only from checked constructor and
        family metadata, and compares well-typed terms of the same type.
        Implements [PROOF-KERNEL-THEORY]. *)
    structureEta (env, context, other, constructed, proofs) = structureHead (env, context, other, constructed, proofs, Terms::spine (contextual (env, context, constructed)))

    structureHead (env, context, other, constructed, proofs, spine) = match spine.spineHead
        Const name levels => match Environment::find (env, name)
            Success decl => structureConstructor (env, context, other, constructed, proofs, spine.spineArgs, decl.name, decl.body)
            Error _ => false
        otherHead => false

    structureConstructor (env, context, other, constructed, proofs, args, name, body) = match body
        Constructor ctor => match ctor.ctorParams >= 0 && ctor.ctorFields >= 0 && listLength args == satAdd ctor.ctorParams ctor.ctorFields
            false => false
            true => match Environment::find (env, ctor.ctorFamily)
                Success family => structureFamily (env, context, other, constructed, proofs, args, name, ctor, family.body)
                Error _ => false
        otherBody => false

    structureFamily (env, context, other, constructed, proofs, args, name, ctor, body) = match body
        TypeFormer family => match family.familyCtors
            [only] => only == name && family.familyParams == ctor.ctorParams && family.familyIndices == 0 && !family.familyRecursive && !family.familyReflexive && structureTypes (env, context, other, constructed, proofs, ctor.ctorFamily, Terms::suffix (args, ctor.ctorParams))
            otherCtors => false
        otherBody => false

    structureTypes (env, context, other, constructed, proofs, family, fields) = match Infer::infer (env, context, other)
        Error _ => false
        Success expected => match Infer::infer (env, context, constructed)
            Error _ => false
            Success found => conversion (env, context, found, expected, proofs) && structureFields (env, context, other, proofs, family, fields, 0)

    structureFields (env, context, other, proofs, family, fields, index) = match fields
        [] => true
        [field, ...rest] => structureProjection (env, context, field, Proj family index other, proofs) && structureFields (env, context, other, proofs, family, rest, satAdd index 1)

    structureProjection (env, context, field, projected, proofs) = match Infer::infer (env, context, projected)
        Success ty => conversion (env, context, field, projected, proofs)
        Error _ => false

    structural (env, context, left, right, proofs) = match left
        NatLit value => naturalEqual (env, context, value, right, proofs)
        other => ordinaryEqual (env, context, left, right, proofs)

    naturalEqual (env, context, value, right, proofs) = match right
        NatLit other => Naturals::equal (value, other)
        other => ordinaryEqual (env, context, NatLit value, right, proofs)

    ordinaryEqual (env, context, left, right, proofs) = match Terms::equal (left, right)
        true => true
        false => normal (env, context, contextual (env, context, left), contextual (env, context, right), proofs)

    normal (env, context, left, right, proofs) = match left
        Sort u => sortEq (u, right)
        BVar i => varEq (i, right)
        Const a la => constEq (a, la, right)
        App f a => appEq (env, context, f, a, right, proofs)
        Lam x a f => lamEq (env, context, x, a, f, right, proofs)
        Pi x a f => piEq (env, context, x, a, f, right, proofs)
        Let x t v b => false
        Proj family index target => projectionEq (env, context, family, index, target, right, proofs)
        NatLit value => naturalEqual (env, context, value, right, proofs)

    projectionEq (env, context, family, index, target, right, proofs) = match right
        Proj other field value => family == other && index == field && conversion (env, context, target, value, proofs)
        Lam name domain body => eta (env, context, name, domain, body, Proj family index target, proofs)
        other => false

    sortEq (u, right) = match right
        Sort v => Levels::equal u v
        other => false

    varEq (i, right) = match right
        BVar j => i == j
        other => false

    constEq (a, la, right) = match right
        Const b lb => a == b && Terms::equalLevels (la, lb)
        other => false

    appEq (env, context, f, a, right, proofs) = match right
        App g b => conversion (env, context, f, g, proofs) && conversion (env, context, a, b, proofs)
        Lam y domain body => eta (env, context, y, domain, body, App f a, proofs)
        other => false

    lamEq (env, context, name, domain, body, right, proofs) = match right
        Lam other otherDomain otherBody => conversion (env, context, domain, otherDomain, proofs) && underBinder (env, context, name, domain, body, otherBody, proofs)
        other => eta (env, context, name, domain, body, other, proofs)

    piEq (env, context, name, domain, body, right, proofs) = match right
        Pi other otherDomain otherBody => conversion (env, context, domain, otherDomain, proofs) && underBinder (env, context, name, domain, body, otherBody, proofs)
        other => false

    (** Compare two bodies under one more binder of the given type. *)
    underBinder (env, context, name, domain, left, right, proofs) = conversion (env, listPrepend (context, Binder(name = name, ty = domain)), left, right, proofs)

    (** η: `fun x => body` equals `other` when `body` equals `other x`. *)
    eta (env, context, name, domain, body, other, proofs) = underBinder (env, context, name, domain, body, App (Terms::shift (other, 0, 1)) (BVar 0), proofs)
