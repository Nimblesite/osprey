namespace proof

import proof::Levels
import proof::Terms
import proof::Environment

(** The three tables of a `lean4export` NDJSON file: dotted names, universe
    levels and expressions, each numbered in its own space. Map keys are
    strings because that is the one key the builtin maps take. *)
type Tables =
    names : Map<string, string>
    levels : Map<string, Level>
    exprs : Map<string, Term>

(** The reader's state: the tables so far, the declarations in file order,
    and the number of the line being read, `1` being the meta header. *)
type Reading =
    tables : Tables
    decls : List<Decl>
    line : int

(** Reader for `lean4export`'s NDJSON format 3.1.0 — the one code that
    parses Lean's format ([PROOF-EXPORT]). Every line is one JSON object:
    the `meta` header, an `in` name, an `il` level, an `ie` expression or
    a declaration. Name 0 is the anonymous root and level 0 is `Zero`; an
    item only ever refers to indices its table already defines, and each
    index is defined once (`freshIn`). The reader
    adds nothing to the theory: every declaration arrives as the kernel's
    own `Decl`, and the kinds M3 will bring — inductives, constructors,
    recursors and quotients — are refused with the line kind named. *)
module Export
    (** Every declaration in the file, in file order. *)
    export read source = unfolded (foldList (lines source, Success(value = started ()), \(reading, text) => stepped (reading, text)))

    started () = Reading(tables = Tables(names = Map(), levels = Map(), exprs = Map()), decls = [], line = 1)

    unfolded (reading) = match reading
        Success final => Success(value = final.decls)
        Error message => Error(message = message)

    stepped (reading, text) = match reading
        Error message => Error(message = message)
        Success current => steppedAt (current, text)

    (** Line 1 is the meta header; every later line is one item. *)
    steppedAt (current, text) = match current.line
        1 => metaLine (current, text)
        number => itemLine (counted (current), number, text)

    counted (current) = Reading(tables = current.tables, decls = current.decls, line = satAdd current.line 1)

    wrapped (number, outcome) = match outcome
        Success reading => Success(value = reading)
        Error reason => Error(message = "line ${toString number}: ${reason}")

    (** The header must name format version 3.1.0, whatever the exporter. *)
    metaLine (current, text) = wrapped (1, metaVersion (counted (current), jsonDecode text))

    metaVersion (next, outcome) = upon (outcome, \json => upon (fieldIn (json, "meta"), \meta => upon (fieldIn (meta, "format"), \format => upon (textIn (format, "version"), \version => versionOk (next, version)))))

    versionOk (next, version) = match version == "3.1.0"
        true => Success(value = next)
        false => Error(message = "unsupported format version ${version}")

    itemLine (next, number, text) = match text == ""
        true => Success(value = next)
        false => wrapped (number, routed (next, jsonDecode text))

    (** A line is a name, a level, an expression or a declaration. *)
    routed (reading, outcome) = upon (outcome, \json => routedName (reading, json))

    routedName (reading, json) = match hasField (json, "in")
        true => nameLine (reading, json)
        false => routedLevel (reading, json)

    routedLevel (reading, json) = match hasField (json, "il")
        true => levelLine (reading, json)
        false => routedExpr (reading, json)

    routedExpr (reading, json) = match hasField (json, "ie")
        true => exprLine (reading, json)
        false => declLine (reading, json)

    (** JSON access: every accessor names the member it cannot read, and
        `upon` runs the next step only on success. *)
    upon (outcome, next) = match outcome
        Success value => next value
        Error message => Error(message = message)

    fieldIn (json, name) = match jsonField (json, name)
        Success value => Success(value = value)
        Error _ => Error(message = "no ${name}")

    hasField (json, name) = match jsonField (json, name)
        Success _ => true
        Error _ => false

    textIn (json, name) = upon (fieldIn (json, name), \value => textAs (value, name))

    textAs (value, name) = match jsonText value
        Success text => Success(value = text)
        Error _ => Error(message = "${name} is not a string")

    intIn (json, name) = upon (fieldIn (json, name), \value => intAs (value, name))

    intAs (value, name) = match jsonInt value
        Success number => Success(value = number)
        Error _ => Error(message = "${name} is not an integer")

    arrayIn (json, name) = upon (fieldIn (json, name), \value => arrayAs (value, name))

    arrayAs (value, name) = match value
        JsonArray items => Success(value = items)
        other => Error(message = "${name} is not an array")

    (** The line's kind: the one member besides its index member. *)
    kindOf (json, skip) = match json
        JsonObject members => kindScan (members, skip)
        other => Error(message = "not an object")

    kindScan (members, skip) = match members
        [] => Error(message = "no kind")
        [first, ...rest] => kindPick (first, rest, skip)

    kindPick (first, rest, skip) = match first
        JsonMember name value => kindNamed (name, rest, skip)
        other => Error(message = "no kind")

    kindNamed (name, rest, skip) = match name == skip
        true => kindScan (rest, skip)
        false => Success(value = name)

    (** A kind the format defines but the kernel does not read, or no kind
        the reader knows: refused either way, with the kind named. *)
    refused (json, skip, kinds) = upon (kindOf (json, skip), \kind => refusal (kind, listContains (kinds, kind)))

    refusal (kind, known) = match known
        true => Error(message = "unsupported: ${kind}")
        false => Error(message = "unknown item: ${kind}")

    (** Name 0 is the anonymous root and prints as the empty prefix. *)
    nameOf (tables, index) = match index == 0
        true => Success(value = "")
        false => namedEntry (tables, index)

    namedEntry (tables, index) = match mapGet (tables.names, toString index)
        Success name => Success(value = name)
        Error _ => Error(message = "unknown name ${toString index}")

    (** Level 0 is `Zero`. *)
    levelOf (tables, index) = match index == 0
        true => Success(value = Zero)
        false => leveledEntry (tables, index)

    leveledEntry (tables, index) = match mapGet (tables.levels, toString index)
        Success level => Success(value = level)
        Error _ => Error(message = "unknown level ${toString index}")

    exprOf (tables, index) = match mapGet (tables.exprs, toString index)
        Success term => Success(value = term)
        Error _ => Error(message = "unknown expr ${toString index}")

    (** Every index is defined once: an index already in its table, or
        below the table's first free index (name 0 is the anonymous root,
        level 0 is `Zero`, no index is negative), is refused rather than
        overwritten, so no later item can rebind what an earlier one used. *)
    freshIn (table, index, first, kind) = match index < first
        true => Error(message = "${kind} ${toString index} is reserved")
        false => unusedIn (table, index, kind)

    unusedIn (table, index, kind) = match mapContains (table, toString index)
        true => Error(message = "${kind} ${toString index} is already defined")
        false => Success(value = index)

    setTables (reading, tables) = Reading(tables = tables, decls = reading.decls, line = reading.line)

    setName (reading, index, name) = setTables (reading, Tables(names = mapSet (reading.tables.names, toString index, name), levels = reading.tables.levels, exprs = reading.tables.exprs))

    setLevel (reading, index, level) = setTables (reading, Tables(names = reading.tables.names, levels = mapSet (reading.tables.levels, toString index, level), exprs = reading.tables.exprs))

    setExpr (reading, index, term) = setTables (reading, Tables(names = reading.tables.names, levels = reading.tables.levels, exprs = mapSet (reading.tables.exprs, toString index, term)))

    addDecl (reading, decl) = Reading(tables = reading.tables, decls = listAppend (reading.decls, decl), line = reading.line)

    (** Names print as dotted with the anonymous root omitted. *)
    dotted (prefix, leaf) = match prefix
        "" => leaf
        other => "${other}.${leaf}"

    (** A name is `str` or `num`; both name their dotted prefix by index. *)
    nameLine (reading, json) = upon (intIn (json, "in"), \index => upon (freshIn (reading.tables.names, index, 1, "name"), \fresh => nameForm (reading, json, fresh)))

    nameForm (reading, json, index) = match hasField (json, "str")
        true => nameStr (reading, json, index)
        false => nameNum (reading, json, index)

    nameStr (reading, json, index) = upon (fieldIn (json, "str"), \str => upon (intIn (str, "pre"), \parent => upon (textIn (str, "str"), \leaf => nameDone (reading, index, parent, leaf))))

    (** A `num` leaf is rendered in the table's one spelling. *)
    nameNum (reading, json, index) = upon (fieldIn (json, "num"), \num => upon (intIn (num, "pre"), \parent => upon (intIn (num, "i"), \value => nameDone (reading, index, parent, toString value))))

    nameDone (reading, index, parent, leaf) = upon (nameOf (reading.tables, parent), \prefix => Success(value = setName (reading, index, dotted (prefix, leaf))))

    (** A level is `succ`, `max`, `imax` or `param`. *)
    levelLine (reading, json) = upon (intIn (json, "il"), \index => upon (freshIn (reading.tables.levels, index, 1, "level"), \fresh => levelForm (reading, json, fresh)))

    levelForm (reading, json, index) = match hasField (json, "succ")
        true => levelSucc (reading, json, index)
        false => levelPair (reading, json, index)

    levelSucc (reading, json, index) = upon (intIn (json, "succ"), \ref => upon (levelOf (reading.tables, ref), \level => Success(value = setLevel (reading, index, Succ level))))

    levelPair (reading, json, index) = match hasField (json, "max")
        true => paired (reading, json, index, "max", false)
        false => levelIMax (reading, json, index)

    levelIMax (reading, json, index) = match hasField (json, "imax")
        true => paired (reading, json, index, "imax", true)
        false => levelParam (reading, json, index)

    (** `max` and `imax` carry their two sides as one two-element array. *)
    paired (reading, json, index, key, imax) = upon (arrayIn (json, key), \sides => upon (sideOf (sides, key, 0), \left => upon (sideOf (sides, key, 1), \right => pairedDone (reading, index, imax, left, right))))

    sideOf (sides, key, at) = upon (sideAt (sides, at, key), \value => intAs (value, "${key} side"))

    sideAt (sides, at, key) = match listGet (sides, at)
        Success value => Success(value = value)
        Error _ => Error(message = "${key} needs two sides")

    pairedDone (reading, index, imax, left, right) = upon (levelOf (reading.tables, left), \first => upon (levelOf (reading.tables, right), \second => Success(value = setLevel (reading, index, combined (imax, first, second)))))

    combined (imax, first, second) = match imax
        true => IMax first second
        false => Max first second

    (** A parameter level names its parameter through the name table. *)
    levelParam (reading, json, index) = match hasField (json, "param")
        true => paramLevel (reading, json, index)
        false => refused (json, "il", [])

    paramLevel (reading, json, index) = upon (intIn (json, "param"), \ref => upon (nameOf (reading.tables, ref), \name => Success(value = setLevel (reading, index, Param name))))

    (** An expression is one of the M0 forms; anything else is refused. *)
    exprLine (reading, json) = upon (intIn (json, "ie"), \index => upon (freshIn (reading.tables.exprs, index, 0, "expr"), \fresh => exprForm (reading, json, fresh)))

    exprForm (reading, json, index) = match hasField (json, "sort")
        true => sorted (reading, json, index)
        false => exprBvar (reading, json, index)

    exprBvar (reading, json, index) = match hasField (json, "bvar")
        true => varred (reading, json, index)
        false => exprConst (reading, json, index)

    exprConst (reading, json, index) = match hasField (json, "const")
        true => consted (reading, json, index)
        false => exprApp (reading, json, index)

    exprApp (reading, json, index) = match hasField (json, "app")
        true => applied (reading, json, index)
        false => exprLam (reading, json, index)

    exprLam (reading, json, index) = match hasField (json, "lam")
        true => lammed (reading, json, index)
        false => exprForall (reading, json, index)

    exprForall (reading, json, index) = match hasField (json, "forallE")
        true => foralled (reading, json, index)
        false => exprLet (reading, json, index)

    (** `letE`, the literal, projection, free-variable, metavariable and
        metadata kinds M3 or later needs, or nothing the reader knows:
        refused with the kind named. *)
    exprLet (reading, json, index) = match hasField (json, "letE")
        true => letted (reading, json, index)
        false => refused (json, "ie", ["mdata", "proj", "natVal", "strVal", "fvar", "mvar"])

    sorted (reading, json, index) = upon (intIn (json, "sort"), \ref => upon (levelOf (reading.tables, ref), \level => Success(value = setExpr (reading, index, Sort level))))

    varred (reading, json, index) = upon (intIn (json, "bvar"), \depth => Success(value = setExpr (reading, index, BVar depth)))

    (** A constant names its head and carries its level arguments. *)
    consted (reading, json, index) = upon (fieldIn (json, "const"), \c => upon (intIn (c, "name"), \ref => upon (nameOf (reading.tables, ref), \name => upon (arrayIn (c, "us"), \items => upon (levelList (reading.tables, items), \levels => Success(value = setExpr (reading, index, Const name levels)))))))

    (** Every element of a level-argument list, in order. *)
    levelList (tables, items) = match items
        [] => Success(value = [])
        [first, ...rest] => upon (intAs (first, "level argument"), \ref => upon (levelOf (tables, ref), \level => upon (levelList (tables, rest), \levels => Success(value = listPrepend (levels, level)))))

    applied (reading, json, index) = upon (fieldIn (json, "app"), \a => upon (intIn (a, "fn"), \head => upon (intIn (a, "arg"), \arg => upon (exprOf (reading.tables, head), \caller => upon (exprOf (reading.tables, arg), \value => Success(value = setExpr (reading, index, App caller value)))))))

    (** `lam` and `forallE` differ only in the constructor; `binderInfo`
        is validated and dropped, and the name is kept for printing. *)
    lammed (reading, json, index) = upon (fieldIn (json, "lam"), \node => bound (reading, index, node, true))

    foralled (reading, json, index) = upon (fieldIn (json, "forallE"), \node => bound (reading, index, node, false))

    bound (reading, index, binder, lambda) = upon (textIn (binder, "binderInfo"), \info => boundInfo (reading, index, binder, lambda, info))

    boundInfo (reading, index, binder, lambda, info) = match listContains (["default", "implicit", "strictImplicit", "instImplicit"], info)
        true => boundName (reading, index, binder, lambda)
        false => Error(message = "bad binderInfo ${info}")

    boundName (reading, index, binder, lambda) = upon (intIn (binder, "name"), \ref => upon (nameOf (reading.tables, ref), \name => upon (intIn (binder, "type"), \ty => upon (exprOf (reading.tables, ty), \domain => upon (intIn (binder, "body"), \body => upon (exprOf (reading.tables, body), \inner => Success(value = setExpr (reading, index, boundForm (lambda, name, domain, inner)))))))))

    boundForm (lambda, name, domain, inner) = match lambda
        true => Lam name domain inner
        false => Pi name domain inner

    (** A let carries name, type, value and body; `nondep` is a hint and
        is dropped. *)
    letted (reading, json, index) = upon (fieldIn (json, "letE"), \letE => upon (intIn (letE, "name"), \nref => upon (nameOf (reading.tables, nref), \name => upon (intIn (letE, "type"), \tref => upon (exprOf (reading.tables, tref), \domain => upon (intIn (letE, "value"), \vref => upon (exprOf (reading.tables, vref), \value => letBody (reading, index, letE, name, domain, value))))))))

    letBody (reading, index, letE, name, domain, value) = upon (intIn (letE, "body"), \bref => upon (exprOf (reading.tables, bref), \inner => Success(value = setExpr (reading, index, Let name domain value inner))))

    (** A declaration line names one constant: `thm`, `def` and `axiom`
        are the M1 forms, everything else is refused. *)
    declLine (reading, json) = match hasField (json, "thm")
        true => theoremed (reading, json)
        false => declDef (reading, json)

    declDef (reading, json) = match hasField (json, "def")
        true => defined (reading, json)
        false => declAxiom (reading, json)

    declAxiom (reading, json) = match hasField (json, "axiom")
        true => axiomed (reading, json)
        false => refused (json, "", ["inductive", "quot", "opaque"])

    theoremed (reading, json) = upon (fieldIn (json, "thm"), \thm => upon (declName (reading, thm), \name => upon (paramsOf (reading.tables, thm), \params => upon (typedOf (reading, thm), \ty => upon (intIn (thm, "value"), \vref => upon (exprOf (reading.tables, vref), \value => Success(value = addDecl (reading, Decl(name = name, params = params, ty = ty, body = Theorem value)))))))))

    defined (reading, json) = upon (fieldIn (json, "def"), \defn => upon (declName (reading, defn), \name => upon (paramsOf (reading.tables, defn), \params => upon (typedOf (reading, defn), \ty => upon (intIn (defn, "value"), \vref => upon (exprOf (reading.tables, vref), \value => Success(value = addDecl (reading, Decl(name = name, params = params, ty = ty, body = Definition value)))))))))

    axiomed (reading, json) = upon (fieldIn (json, "axiom"), \ax => upon (declName (reading, ax), \name => upon (paramsOf (reading.tables, ax), \params => upon (typedOf (reading, ax), \ty => Success(value = addDecl (reading, Decl(name = name, params = params, ty = ty, body = Axiom)))))))

    (** A declaration's name and statement, through the two tables. *)
    declName (reading, json) = upon (intIn (json, "name"), \ref => nameOf (reading.tables, ref))

    typedOf (reading, json) = upon (intIn (json, "type"), \ref => exprOf (reading.tables, ref))

    (** The universe parameters of a declaration, in file order: an array
        of name-table indices. *)
    paramsOf (tables, json) = upon (arrayIn (json, "levelParams"), \items => nameList (tables, items))

    nameList (tables, items) = match items
        [] => Success(value = [])
        [first, ...rest] => upon (intAs (first, "level parameter"), \index => upon (nameOf (tables, index), \name => upon (nameList (tables, rest), \names => Success(value = listPrepend (names, name)))))
