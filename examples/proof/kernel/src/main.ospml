namespace proof

import proof::Levels
import proof::Terms
import proof::Environment
import proof::Infer
import proof::Surface

// M0 of plan 0041: the kernel checks `fun (p : Prop) (h : p) => h` against
// `∀ (p : Prop), p → p` and prints `checked: id_imp`; a wrong proof of the
// same statement, and a statement that is not a type, are rejected with
// the kernel's reason.

prop () = Sort Zero

(** `∀ (p : Prop), p → p` *)
idType () = Pi "p" (prop ()) (Pi "h" (BVar 0) (BVar 1))

(** `fun (p : Prop) (h : p) => h` *)
idProof () = Lam "p" (prop ()) (Lam "h" (BVar 0) (BVar 0))

(** `fun (p : Prop) (h : p) => p`: a term of the wrong type. *)
badProof () = Lam "p" (prop ()) (Lam "h" (BVar 0) (BVar 1))

(** Add `name : ty := value` as a theorem: the statement must be a type and
    the proof must have it. *)
theorem (env, name, ty, value) = match Infer::sort (env, [], ty)
    Success level => proved (env, name, ty, value)
    Error message => Error(message = message)

proved (env, name, ty, value) = match Infer::check (env, [], value, ty)
    Success checked => Environment::add (env, Decl(name = name, params = [], ty = ty, body = Theorem value))
    Error message => Error(message = message)

report (name, outcome) = match outcome
    Success env => print "checked: ${name}"
    Error message => print "rejected: ${name}: ${message}"

(** M2: the same theorem typed on the proof surface, elaborated directly. *)
typed (env, text) = match Surface::theorem text
    Success parsed => theorem (env, parsed.theoremName, parsed.statement, parsed.proof)
    Error message => Error(message = message)

surfaceReport (env, text) = match Surface::theorem text
    Success parsed => report (parsed.theoremName, typed (env, text))
    Error message => print "rejected: ${message}"

main () =
    env = Environment::empty ()
    report ("id_imp", theorem (env, "id_imp", idType (), idProof ()))
    report ("id_imp_bad", theorem (env, "id_imp_bad", idType (), badProof ()))
    report ("not_a_type", theorem (env, "not_a_type", idProof (), idProof ()))
    surfaceReport (env, "theorem id_imp_typed (p : Prop) (h : p) : p := h")
    surfaceReport (env, "theorem imp_trans (p q r : Prop) (f : p → q) (g : q → r) : p → r := fun (x : p) => g (f x)")
    surfaceReport (env, "theorem forall_typed : ∀ (p : Prop), p → p := fun (p : Prop) (h : p) => h")
    surfaceReport (env, "theorem wrong_typed (p q : Prop) (h : p) : q := h")
