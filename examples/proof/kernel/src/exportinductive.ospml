namespace proof

import proof::Environment
import proof::ExportJson

(** Reading the `inductive` line of [PROOF-EXPORT]: one line carries a whole
    group — its type formers, its constructors and its recursors, one per
    family plus the auxiliary recursors a nested family's lowering gives
    the group. The reader records exactly what the line claims, through the
    same three tables every other declaration uses, and checks nothing
    about the theory: the block's claims — including how many families,
    constructors and recursors the group holds, each recursor's motive
    count, and the whole group's inventory — are re-derived and compared
    by `Inductive::add` ([PROOF-KERNEL-THEORY]). The shapes the reader
    itself refuses are refused with the line number every other reader
    error carries: an unsafe declaration, a group with no family or no
    recursor, and any member the format does not define. *)
module ExportInductive
    (** The block the line states, or why it cannot be read. *)
    export blocked (tables, json) = ExportJson::upon (ExportJson::fieldIn (json, "inductive"), \group => ExportJson::upon (strict (group, groupMembers (), "inductive"), \known => grouped (tables, group)))

    grouped (tables, group) = ExportJson::upon (ExportJson::arrayIn (group, "types"), \types => ExportJson::upon (nonEmpty (types, "type"), \families => ExportJson::upon (ExportJson::arrayIn (group, "ctors"), \ctors => ExportJson::upon (ExportJson::arrayIn (group, "recs"), \recs => ExportJson::upon (nonEmpty (recs, "recursor"), \eliminators => groupedAs (tables, families, ctors, eliminators))))))

    groupedAs (tables, families, ctors, eliminators) = ExportJson::upon (eachFormer (tables, families, []), \formers => ExportJson::upon (eachCtor (tables, ctors, []), \ctorDecls => ExportJson::upon (eachRec (tables, eliminators, []), \recDecls => Success(value = Block(formers = formers, ctors = ctorDecls, recursors = recDecls)))))

    (** A member list that must hold at least one entry. *)
    nonEmpty (items, what) = match items
        [] => Error(message = "no ${what}")
        [first, ...rest] => Success(value = items)

    eachFormer (tables, items, done) = match items
        [] => Success(value = done)
        [first, ...rest] => ExportJson::upon (formerOf (tables, first), \decl => ExportJson::upon (eachFormer (tables, rest, done), \more => Success(value = listPrepend (more, decl))))

    eachCtor (tables, items, done) = match items
        [] => Success(value = done)
        [first, ...rest] => ExportJson::upon (constructorOf (tables, first), \decl => ExportJson::upon (eachCtor (tables, rest, done), \more => Success(value = listPrepend (more, decl))))

    eachRec (tables, items, done) = match items
        [] => Success(value = done)
        [first, ...rest] => ExportJson::upon (recursorOf (tables, first), \decl => ExportJson::upon (eachRec (tables, rest, done), \more => Success(value = listPrepend (more, decl))))

    formerOf (tables, json) = ExportJson::upon (strict (json, typeMembers (), "type"), \known => ExportJson::upon (clean (json), \safe => ExportJson::upon (familyOf (tables, json), \family => ExportJson::upon (declared (tables, json, TypeFormer family), \decl => Success(value = decl)))))

    familyOf (tables, json) = ExportJson::upon (ExportJson::intIn (json, "numParams"), \params => ExportJson::upon (ExportJson::intIn (json, "numIndices"), \indices => familyFlags (tables, json, params, indices)))

    familyFlags (tables, json, params, indices) = ExportJson::upon (ExportJson::boolIn (json, "isRec"), \recursive => ExportJson::upon (ExportJson::boolIn (json, "isReflexive"), \reflexive => ExportJson::upon (ExportJson::intIn (json, "numNested"), \nested => ExportJson::upon (allOf (tables, json), \all => ExportJson::upon (ctorNames (tables, json), \ctors => Success(value = Family(familyParams = params, familyIndices = indices, familyCtors = ctors, familyRecursive = recursive, familyReflexive = reflexive, familyAll = all, familyNested = nested)))))))

    (** The group inventory a member claims: the `all` name list itself. *)
    allOf (tables, json) = ExportJson::upon (ExportJson::arrayIn (json, "all"), \items => ExportJson::nameList (tables, items, "group member"))

    ctorNames (tables, json) = ExportJson::upon (ExportJson::arrayIn (json, "ctors"), \items => ExportJson::nameList (tables, items, "constructor"))

    constructorOf (tables, json) = ExportJson::upon (strict (json, ctorMembers (), "constructor"), \known => ExportJson::upon (clean (json), \safe => ExportJson::upon (ctorOf (tables, json), \ctor => ExportJson::upon (declared (tables, json, Constructor ctor), \decl => Success(value = decl)))))

    ctorOf (tables, json) = ExportJson::upon (ExportJson::intIn (json, "induct"), \family => ExportJson::upon (ExportJson::nameOf (tables, family), \familyName => ExportJson::upon (ExportJson::intIn (json, "cidx"), \index => ExportJson::upon (ExportJson::intIn (json, "numParams"), \params => ExportJson::upon (ExportJson::intIn (json, "numFields"), \fields => Success(value = Ctor(ctorFamily = familyName, ctorIndex = index, ctorParams = params, ctorFields = fields)))))))

    recursorOf (tables, json) = ExportJson::upon (strict (json, recMembers (), "recursor"), \known => ExportJson::upon (clean (json), \safe => ExportJson::upon (ExportJson::intIn (json, "numMotives"), \motives => ExportJson::upon (elimOf (tables, json), \elim => ExportJson::upon (declared (tables, json, Recursor elim), \decl => Success(value = decl))))))

    elimOf (tables, json) = ExportJson::upon (ExportJson::declName (tables, json), \name => ExportJson::upon (allOf (tables, json), \all => ExportJson::upon (ExportJson::intIn (json, "numParams"), \params => ExportJson::upon (ExportJson::intIn (json, "numIndices"), \indices => ExportJson::upon (ExportJson::intIn (json, "numMinors"), \minors => ExportJson::upon (ExportJson::intIn (json, "numMotives"), \motives => ExportJson::upon (rulesOf (tables, json), \rules => ExportJson::upon (ExportJson::boolIn (json, "k"), \k => Success(value = Eliminator(elimFamily = eliminatorFamily (name, all), elimAll = all, elimMotives = motives, elimParams = params, elimIndices = indices, elimMinors = minors, elimRules = rules, elimK = k))))))))))

    (** The family a recursor's claim names as its own: the group member
        its name extends, or the first member. *)
    eliminatorFamily (name, all) = prefixed (all, name, all)

    prefixed (names, name, fallback) = match names
        [] => match listGet (fallback, 0)
            Success first => first
            Error _ => name
        [first, ...rest] => match startsWith (name, "${first}.")
            true => first
            false => prefixed (rest, name, fallback)

    rulesOf (tables, json) = ExportJson::upon (ExportJson::arrayIn (json, "rules"), \items => eachRule (tables, items))

    eachRule (tables, items) = match items
        [] => Success(value = [])
        [first, ...rest] => ExportJson::upon (ruleOf (tables, first), \rule => ExportJson::upon (eachRule (tables, rest), \rules => Success(value = listPrepend (rules, rule))))

    ruleOf (tables, json) = ExportJson::upon (strict (json, ruleMembers (), "rule"), \known => ExportJson::upon (ExportJson::intIn (json, "ctor"), \ref => ExportJson::upon (ExportJson::nameOf (tables, ref), \name => ExportJson::upon (ExportJson::intIn (json, "nfields"), \fields => ExportJson::upon (ExportJson::intIn (json, "rhs"), \rhs => ExportJson::upon (ExportJson::exprOf (tables, rhs), \term => Success(value = Rule(ruleCtor = name, ruleFields = fields, ruleRhs = term))))))))

    (** A block member's name, universe parameters and type, read exactly
        like a theorem's. *)
    declared (tables, json, body) = ExportJson::upon (ExportJson::declName (tables, json), \name => ExportJson::upon (ExportJson::paramsOf (tables, json), \params => ExportJson::upon (ExportJson::typedOf (tables, json), \ty => Success(value = Decl(name = name, params = params, ty = ty, body = body)))))

    clean (json) = ExportJson::upon (ExportJson::boolIn (json, "isUnsafe"), \unsafe => unsafely (unsafe))

    unsafely (unsafe) = match unsafe
        true => Error(message = "unsupported: unsafe declaration")
        false => Success(value = true)

    (** `json` carries only the members `allowed`: one the format does not
        define is refused, never dropped. *)
    strict (json, allowed, kind) = match json
        JsonObject members => scanned (members, allowed, kind)
        other => Error(message = "not an object")

    scanned (members, allowed, kind) = match members
        [] => Success(value = true)
        [first, ...rest] => ExportJson::upon (knownMember (first, allowed, kind), \ok => scanned (rest, allowed, kind))

    knownMember (member, allowed, kind) = match member
        JsonMember name value => matchedMember (name, allowed, kind)
        other => Error(message = "not a member")

    matchedMember (name, allowed, kind) = match listContains (allowed, name)
        true => Success(value = true)
        false => Error(message = "unknown ${kind} member `${name}`")

    groupMembers () = ["ctors", "recs", "types"]

    typeMembers () = ["all", "ctors", "isRec", "isReflexive", "isUnsafe", "levelParams", "name", "numIndices", "numNested", "numParams", "type"]

    ctorMembers () = ["cidx", "induct", "isUnsafe", "levelParams", "name", "numFields", "numParams", "type"]

    recMembers () = ["all", "isUnsafe", "k", "levelParams", "name", "numIndices", "numMinors", "numMotives", "numParams", "rules", "type"]

    ruleMembers () = ["ctor", "nfields", "rhs"]
