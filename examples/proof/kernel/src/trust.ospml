namespace proof

import proof::Terms
import proof::Environment

(** Per-root trust reporting ([PROOF-KERNEL-AXIOMS]): the assumptions one
    declaration actually rests on, not every axiom the checked file happens to
    contain. The closure walks the declaration's statement and value, the
    metadata an inductive family, constructor or recursor carries, projection
    families and the checked `Nat` family a literal implies, so an assumption
    is reported once and only when that root reaches it. Shared dependency
    analysis retains each proof's own axiom list. *)
type TrustWalk =
    trustSeen : Map<string, bool>
    trustPending : List<string>
    trustAxioms : Map<string, bool>

module Trust
    (** Compute every root's assumptions in one validated reverse-dependency
        inventory. Each axiom is propagated once, while `env.order` supplies
        both root coverage and each result's axiom order. *)
    export allAxioms env = upon (reverseDependents env, \dependents => foldList (env.order, Success(value = emptyRoots env), \(progress, name) => propagateRoot (env, dependents, name, progress)))

    emptyRoots env = foldList (env.order, Map(), \(roots, name) => mapSet (roots, name, []))

    reverseDependents env = foldList (env.order, Success(value = emptyRoots env), \(progress, name) => reverseDeclaration (env, name, progress))

    reverseDeclaration (env, name, progress) = upon (progress, \graph => upon (Environment::find (env, name), \decl => foldList (declarationRefs decl, Success(value = graph), \(outcome, ref) => reverseReference (env, decl.name, ref, outcome))))

    reverseReference (env, dependent, ref, progress) = upon (progress, \graph => reverseKnown (env, dependent, ref, graph))

    reverseKnown (env, dependent, ref, graph) = match Environment::find (env, ref)
        Error _ => Error(message = "unknown dependency `${ref}`")
        Success _ => upon (mapGet (graph, ref), \roots => Success(value = mapSet (graph, ref, listAppend (roots, dependent))))

    propagateRoot (env, graph, name, progress) = upon (progress, \roots => upon (Environment::find (env, name), \decl => propagateBody (env, graph, name, roots, decl.body)))

    propagateBody (env, graph, name, roots, body) = match body
        Axiom => propagateAxiom (env, graph, name, roots)
        other => Success(value = roots)

    propagateAxiom (env, graph, name, roots) = upon (reverseWalk (env, graph, name), \walk => foldList (env.order, Success(value = roots), \(progress, root) => addReached (progress, root, name, walk.trustSeen)))

    reverseWalk (env, graph, name) = converged (foldList (env.order, Success(value = starting name), \(progress, _entry) => reverseStep (graph, progress)))

    reverseStep (graph, progress) = advance (progress, \(walk, next) => upon (mapGet (graph, next), \refs => Success(value = foldList (refs, walk, enqueue))))

    addReached (progress, root, axiom, seen) = upon (progress, \roots => upon (mapGet (roots, root), \names => Success(value = mapSet (roots, root, reached (names, seen, root, axiom)))))

    reached (names, seen, root, axiom) = match mapContains (seen, root)
        true => listAppend (names, axiom)
        false => names

    upon (outcome, next) = match outcome
        Success value => next value
        Error message => Error(message = message)

    (** Enqueue each name once, then process at most the environment size
        plus one item. A checked environment's declaration order contains
        every name; the extra step diagnoses an unresolved dependency.
        Explicit folds keep graph depth off the native/WASM call stack. *)
    export axioms (env, name) = finished (env, step (env, foldList (env.order, Success(value = starting name), \(progress, _entry) => step (env, progress))))

    starting name = TrustWalk(trustSeen = mapSet (Map(), name, true), trustPending = [name], trustAxioms = Map())

    step (env, progress) = advance (progress, \(walk, next) => expanded (env, walk, Environment::find (env, next), next))

    advance (progress, expand) = match progress
        Error message => Error(message = message)
        Success walk => match walk.trustPending
            [] => Success(value = walk)
            [next, ...rest] => expand (walk(trustPending = rest), next)

    expanded (env, walk, found, name) = match found
        Error _ => Error(message = "unknown dependency `${name}`")
        Success decl => Success(value = foldList (declarationRefs decl, marked (walk, decl), \(queued, ref) => enqueue (queued, ref)))

    marked (walk, decl) = match decl.body
        Axiom => walk(trustAxioms = mapSet (walk.trustAxioms, decl.name, true))
        other => walk

    enqueue (walk, name) = match mapContains (walk.trustSeen, name)
        true => walk
        false => walk(trustSeen = mapSet (walk.trustSeen, name, true), trustPending = listAppend (walk.trustPending, name))

    finished (env, progress) = upon (converged progress, \walk => Success(value = filterList (env.order, \name => mapContains (walk.trustAxioms, name))))

    converged progress = match progress
        Error message => Error(message = message)
        Success walk => match isEmpty walk.trustPending
            true => Success(value = walk)
            false => Error(message = "dependency traversal exceeds declaration inventory")

    (** Every constant `decl` names: its statement first, then its body. An
        axiom names itself, so the constants its statement names come with it. *)
    declarationRefs (decl) = listConcat (Terms::constants decl.ty, bodyRefs (decl.name, decl.body))

    bodyRefs (name, body) = match body
        Axiom => [name]
        Definition value => Terms::constants value
        Theorem value => Terms::constants value
        Opaque value => Terms::constants value
        Quotient kind => quotientRefs kind
        TypeFormer family => family.familyCtors
        Constructor ctor => [ctor.ctorFamily]
        Recursor elim => elimRefs elim

    (** A quotient primitive stands on the equality it is derived from. *)
    quotientRefs (kind) = listPrepend (["Eq", "Eq.refl"], primitive kind)

    primitive (kind) = match kind
        QuotType => "Quot"
        QuotCtor => "Quot.mk"
        QuotLift => "Quot.lift"
        QuotInd => "Quot.ind"

    (** A recursor names its family, and every rule its constructor and the
        term that rule computes to — metadata no declaration term carries. *)
    elimRefs (elim) = listPrepend (ruleRefs elim.elimRules, elim.elimFamily)

    ruleRefs (rules) = foldList (rules, [], \(refs, rule) => listConcat (refs, listPrepend (Terms::constants rule.ruleRhs, rule.ruleCtor)))

    (** The axioms as the batch entry prints them: `none` for no assumptions;
        ambiguous nonempty entries are JSON-quoted before joining with `, `. *)
    export described (outcome) = match outcome
        Success names => listed names
        Error message => Error(message = message)

    listed (names) = match names
        [] => Success(value = "none")
        [first, ...rest] => foldList (rest, ledgerName first, \(text, name) => joinedNames (text, ledgerName name))

    ledgerName name = match name == "" || name == "none" || separates (name, ",") || separates (name, "\"")
        true => jsonQuote name
        false => Success(value = name)

    separates (name, token) = match indexOf (name, token)
        Success _ => true
        Error _ => false

    joinedNames (left, right) = match left
        Error message => Error(message = message)
        Success text => match right
            Error message => Error(message = message)
            Success name => Success(value = "${text}, ${name}")
