namespace proof

import proof::Levels
import proof::Terms
import proof::Environment
import proof::Reduce

(** Type inference and checking of [PROOF-KERNEL-THEORY]. The context is
    the list of binders entered (`Binder`: name and type, the type as it was
    when the binder was entered), innermost first. Every failure is a
    message that opens with its kind (`type mismatch`, `not a type`,
    `not a function`, `unbound variable`, `unknown constant`) and then names
    the terms, printed with the binder names in scope; the kind is what a
    caller may branch on, the rendering is for people. *)
module Infer
    (** The type of `term` in `env` under `context`. *)
    export infer (env, context, term) = match term
        Sort level => Success(value = Sort (Succ level))
        BVar index => variable (context, index)
        Const name levels => constant (env, name, levels)
        App head arg => application (env, context, head, arg)
        Lam name domain body => lambda (env, context, name, domain, body)
        Pi name domain body => pi (env, context, name, domain, body)
        Let name ty value body => letIn (env, context, ty, value, body)

    (** Check that `term` has type `expected`. *)
    export check (env, context, term, expected) = match infer (env, context, term)
        Success found => matches (env, context, term, found, expected)
        Error message => Error(message = message)

    matches (env, context, term, found, expected) = match Reduce::defeq (env, found, expected)
        true => Success(value = expected)
        false => Error(message = "type mismatch: `${Terms::show (term, names context)}` has type `${Terms::show (found, names context)}` but `${Terms::show (expected, names context)}` was expected")

    (** The binder names in scope, innermost first, as `Terms::show` wants. *)
    names context = match context
        [] => []
        [first, ...rest] => listPrepend (names rest, first.name)

    variable (context, index) = match listGet (context, index)
        Success binder => Success(value = Terms::shift (binder.ty, 0, satAdd index 1))
        Error message => Error(message = "unbound variable #${toString index}")

    constant (env, name, levels) = match Environment::find (env, name)
        Success decl => Environment::instantiated (decl, decl.ty, levels)
        Error message => Error(message = "unknown constant `${name}`")

    application (env, context, head, arg) = match infer (env, context, head)
        Success headType => applyTo (env, context, Reduce::whnf (env, headType), head, arg)
        Error message => Error(message = message)

    applyTo (env, context, headType, head, arg) = match headType
        Pi name domain body => applyArg (env, context, domain, body, arg)
        other => Error(message = "not a function: `${Terms::show (head, names context)}` is applied but has type `${Terms::show (other, names context)}`")

    applyArg (env, context, domain, body, arg) = match check (env, context, arg, domain)
        Success ty => Success(value = Terms::instantiate (body, arg))
        Error message => Error(message = message)

    lambda (env, context, name, domain, body) = match sort (env, context, domain)
        Success level => lambdaBody (env, context, name, domain, body)
        Error message => Error(message = message)

    lambdaBody (env, context, name, domain, body) = match infer (env, listPrepend (context, Binder(name = name, ty = domain)), body)
        Success bodyType => Success(value = Pi name domain bodyType)
        Error message => Error(message = message)

    pi (env, context, name, domain, body) = match sort (env, context, domain)
        Success u => piBody (env, context, name, domain, body, u)
        Error message => Error(message = message)

    piBody (env, context, name, domain, body, u) = match sort (env, listPrepend (context, Binder(name = name, ty = domain)), body)
        Success v => Success(value = Sort (IMax u v))
        Error message => Error(message = message)

    letIn (env, context, ty, value, body) = match check (env, context, value, ty)
        Success checked => infer (env, context, Terms::instantiate (body, value))
        Error message => Error(message = message)

    (** The universe level of a type, or an error when `term` is not a type. *)
    export sort (env, context, term) = match infer (env, context, term)
        Success ty => sortOf (context, term, Reduce::whnf (env, ty))
        Error message => Error(message = message)

    sortOf (context, term, ty) = match ty
        Sort level => Success(value = level)
        other => Error(message = "not a type: `${Terms::show (term, names context)}` has type `${Terms::show (other, names context)}`")
