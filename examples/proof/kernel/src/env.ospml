namespace proof

import proof::Terms

(** What a constant is. A definition unfolds; an axiom, a theorem and an
    opaque do not. A type former, a constructor and a recursor come only from an
    inductive declaration the kernel has checked ([PROOF-KERNEL-THEORY]);
    a recursor reduces by its rules (ι). *)
type QuotKind = QuotType | QuotCtor | QuotLift | QuotInd

type Body = Axiom | Definition Term | Theorem Term | Opaque Term | Quotient QuotKind | TypeFormer Family | Constructor Ctor | Recursor Eliminator

(** An inductive type former: how many of its arguments are parameters
    (fixed across constructors) and indices, its constructors in order,
    whether a constructor takes a family of its group itself (recursive)
    or a function into one (reflexive), the whole group's families in
    declaration order, and how many auxiliary families a nested
    declaration's lowering created. Field names are prefixed because the
    checker resolves a field shared by two records to one of them. *)
type Family =
    familyParams : int
    familyIndices : int
    familyCtors : List<string>
    familyRecursive : bool
    familyReflexive : bool
    familyAll : List<string>
    familyNested : int

(** A constructor: its family, its position there, and how many of its
    arguments are the family's parameters and how many are its fields. *)
type Ctor =
    ctorFamily : string
    ctorIndex : int
    ctorParams : int
    ctorFields : int

(** One ι rule: a recursor applied to `ruleCtor`'s `ruleFields` fields
    reduces to `ruleRhs` applied to the parameters, motive, minor
    premises and fields. *)
type Rule =
    ruleCtor : string
    ruleFields : int
    ruleRhs : Term

(** A recursor: the family it eliminates — an auxiliary recursor of a
    nested group names the declaration's first family — the whole
    group's families in order, and how many motives, parameters, minor
    premises and indices place its major premise, its rules in
    constructor order, and whether it supports K (a one-family `Prop`
    group with one constructor and no fields). *)
type Eliminator =
    elimFamily : string
    elimAll : List<string>
    elimMotives : int
    elimParams : int
    elimIndices : int
    elimMinors : int
    elimRules : List<Rule>
    elimK : bool

(** An inductive declaration as an export states it: its type formers,
    its constructors and its recursors — one per family, plus the
    auxiliary recursors a nested family's lowering gives the group — each
    with the facts the export claims. The kernel derives every one of
    them again and refuses the block unless they agree ([PROOF-EXPORT]). *)
type Block =
    formers : List<Decl>
    ctors : List<Decl>
    recursors : List<Decl>

(** One item of an export: a single constant or an inductive block. *)
type Item = Single Decl | Group Block

(** One constant of the environment, with its universe parameters. *)
type Decl =
    name : string
    params : List<string>
    ty : Term
    body : Body

(** The environment of [PROOF-KERNEL-THEORY]: constants by name, in
    declaration order. *)
type Env =
    decls : Map<string, Decl>
    order : List<string>

(** Building and reading the environment. *)
module Environment
    (** No constants. *)
    export empty () = Env(decls = Map(), order = [])

    (** The declaration named, if any. *)
    export find (env, name) = mapGet (env.decls, name)

    (** The environment with `decl` added. A name already taken is an error,
        so a theorem can never be shadowed; a universe parameter used but
        not declared, or declared twice, is an error, so instantiation is
        total. *)
    export add (env, decl) = match mapContains (env.decls, decl.name)
        true => Error(message = "constant `${decl.name}` is already declared")
        false => addScoped (env, decl)

    addScoped (env, decl) = match distinct decl.params && Terms::declared (decl.ty, decl.params) && bodyDeclared (decl.body, decl.params)
        true => Success(value = Env(decls = mapSet (env.decls, decl.name, decl), order = listAppend (env.order, decl.name)))
        false => Error(message = "constant `${decl.name}` uses a universe parameter it does not declare, or declares one twice")

    bodyDeclared (body, params) = match body
        Definition value => Terms::declared (value, params)
        Theorem value => Terms::declared (value, params)
        Opaque value => Terms::declared (value, params)
        Recursor elim => foldList (elim.elimRules, true, \(ok, rule) => ok && Terms::declared (rule.ruleRhs, params))
        other => true

    export distinct names = match names
        [] => true
        [first, ...rest] => !(listContains (rest, first)) && distinct rest

    (** The value `name` applied to the universe arguments `levels` unfolds
        to, if `name` is a definition taking that many arguments. *)
    export unfold (env, name, levels) = match find (env, name)
        Success decl => unfoldBody (decl, levels)
        Error message => Error(message = message)

    unfoldBody (decl, levels) = match decl.body
        Definition value => instantiated (decl, value, levels)
        Theorem value => Error(message = "theorems are opaque")
        Opaque value => Error(message = "opaque declarations do not unfold")
        Quotient kind => Error(message = "quotient primitives do not unfold")
        Axiom => Error(message = "axioms do not unfold")
        other => Error(message = "inductive constants do not unfold")

    (** `term` under `decl`'s parameters set to `levels`, which must be as
        many as the declaration takes. *)
    export instantiated (decl, term, levels) = match listLength levels == listLength decl.params
        true => Success(value = Terms::instantiateLevels (term, decl.params, levels))
        false => Error(message = "`${decl.name}` takes ${toString (listLength decl.params)} universe arguments but ${toString (listLength levels)} were given")

(** Structural declaration comparison shared by export validation and
    numeric/notation identity guards. Rendered names never decide equality.
    Implements [PROOF-KERNEL-THEORY]. *)
module DeclarationBodies
    export equal (left, right) = matched (left, right, true)

    export metadata (left, right) = matched (left, right, false)

    matched (left, right, values) = match right
        Definition value => match left
            Definition actual => Terms::equal (actual, value)
            other => false
        TypeFormer info => match left
            TypeFormer actual => formers (actual, info)
            other => false
        Constructor info => match left
            Constructor actual => ctors (actual, info)
            other => false
        Recursor elim => match left
            Recursor actual => eliminators (actual, elim, values)
            other => false
        other => false

    formers (left, right) = left.familyParams == right.familyParams && left.familyIndices == right.familyIndices && sameNames (left.familyCtors, right.familyCtors) && left.familyRecursive == right.familyRecursive && left.familyReflexive == right.familyReflexive && sameNames (left.familyAll, right.familyAll) && left.familyNested == right.familyNested

    ctors (left, right) = left.ctorFamily == right.ctorFamily && left.ctorIndex == right.ctorIndex && left.ctorParams == right.ctorParams && left.ctorFields == right.ctorFields

    eliminators (left, right, values) = left.elimFamily == right.elimFamily && left.elimParams == right.elimParams && left.elimIndices == right.elimIndices && left.elimMinors == right.elimMinors && left.elimMotives == right.elimMotives && sameNames (left.elimAll, right.elimAll) && left.elimK == right.elimK && rules (left.elimRules, right.elimRules, values)

    rules (left, right, values) = match left
        [] => isEmpty right
        [a, ...rest] => match right
            [b, ...more] => a.ruleCtor == b.ruleCtor && a.ruleFields == b.ruleFields && (!values || Terms::equal (a.ruleRhs, b.ruleRhs)) && rules (rest, more, values)
            other => false

    (** Every fact of an inductive constant but its terms, as text. *)
    export showBody (body) = match body
        TypeFormer family => showFamily family
        Constructor ctor => "constructor ${toString ctor.ctorIndex} of ${ctor.ctorFamily}, ${toString ctor.ctorParams} parameters, ${toString ctor.ctorFields} fields"
        Recursor elim => "recursor of ${elim.elimFamily}, ${toString elim.elimParams} parameters, ${toString elim.elimIndices} indices, ${toString elim.elimMinors} minors, K ${toString elim.elimK}, rules [${joined (ruleNames elim.elimRules)}], motives ${toString elim.elimMotives}, all [${joined elim.elimAll}]"
        other => "not an inductive constant"

    ruleNames (rules) = mapList (rules, \rule => "${rule.ruleCtor}/${toString rule.ruleFields}")

    showFamily (family) = "${toString family.familyParams} parameters, ${toString family.familyIndices} indices, constructors [${joined family.familyCtors}], recursive ${toString family.familyRecursive}, reflexive ${toString family.familyReflexive}, all [${joined family.familyAll}], nested ${toString family.familyNested}"

    (** Names as one comma-separated list, for a refusal diagnostic. *)
    export joined (names) = match names
        [] => ""
        [first, ...rest] => foldList (rest, first, \(text, name) => "${text}, ${name}")

    (** Whether two name lists are equal position by position. *)
    export sameNames (left, right) = match left
        [] => isEmpty right
        [first, ...rest] => sameNamesHead (first, rest, right)

    sameNamesHead (first, rest, right) = match right
        [] => false
        [other, ...more] => first == other && sameNames (rest, more)
