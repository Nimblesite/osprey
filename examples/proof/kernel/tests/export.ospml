namespace prooftests

import proof::Export
import proof::Checked
import proof::Environment
import proof::Fixtures
import proof::Terms
import proof::Trust
import prooftests::Shapes
import proof
    Axiom
    Definition
    Theorem
    Single
    Group
    Pi
    Sort
    Zero
    Const
    App
    BVar
    Succ
import prooftests::Support

(** Reading `lean4export` NDJSON 3.1.0 files into kernel declarations
    ([PROOF-EXPORT]): the recorded M1 theorem survives the trip with its
    statement and proof, the wrong proof of the same statement reads as
    itself, and a file the reader must refuse names its line and kind. *)
module ExportTests

    (** Runs the export-reader cases; the testing built-ins report the TAP lines. *)
    export run () =
        boundaries ()
        identities ()
        test ("an export reads as one theorem with its statement and proof", \() =>
            expect (described (Export::read (Fixtures::idImp ())), "id_imp | (∀ (p : Prop), (p → p)) | (fun (x._@.IdImp.4195544489._hygCtx._hyg.10 : Prop) => (fun (h : x._@.IdImp.4195544489._hygCtx._hyg.10) => h))"))

        test ("the embedded export is the recorded text: 24 lines, meta first, thm last", \() =>
            expect (shape (Fixtures::idImp ()), "24 | meta | thm"))

        test ("an export that declares nothing is not a check of id_imp", \() =>
            expect (Support::messageOf (Checked::exportedDeclaring (Environment::empty (), "", "id_imp")), "the export declares no `id_imp`"))

        test ("the recorded export declares id_imp", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), Fixtures::idImp (), "id_imp")), "declared"))

        test ("the recorded inductive export checks and_swap eq_symm and iff_refl", \() =>
            expect (foldList (["and_swap", "eq_symm", "iff_refl"], "", \(text, name) => "${text}${declaredOutcome (Checked::exportedDeclaring (Environment::empty (), Fixtures::andSwap (), name))};"), "declared;declared;declared;"))

        test ("and_swap is the intended universally quantified conjunction swap", \() =>
            expect (Shapes::shapeOf (Shapes::statementOf (Fixtures::andSwap (), "and_swap"), Pi "p" (Sort Zero) (Pi "q" (Sort Zero) (Pi "h" (Terms::apps (Const "And" [], [BVar 1, BVar 0])) (Terms::apps (Const "And" [], [BVar 1, BVar 2]))))), "equal"))

        test ("the actual Lean Nat.add_comm export checks from an empty environment", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), Fixtures::natAddComm (), "Nat.add_comm")), "declared"))

        test ("a genuine Lean nested List tree checks from an empty environment", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), nestedTree (), "NestedTree.node_nil")), "declared"))

        (** Genuine mutual (`Tree`/`Forest`), nested (`NestedArray` over
            `Array`/`List`) and indexed mutual (`IndexedTree`/`Forest`/
            `Branch`) recursor computations exported from Lean 4.25 with no
            axioms; the kernel does not accept these yet, so this stays RED
            until mutual and nested inductives are supported. *)
        test ("the genuine mutual, nested and indexed recursor theorems check axiom-free from an empty environment", \() =>
            expect (checkedRecursorRoots (Checked::exported (Environment::empty (), recursorCases ())), "declared;declared;declared;declared;declared;declared;declared;declared;")
            expect (axioms (Export::read (recursorCases ())), "0"))

        test ("the actual Lean HAdd recursor consumes identity type annotations", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), haddExport (), "HAdd.rec")), "declared"))

        test ("Nat.add_comm states addition commutativity over all natural numbers", \() =>
            expect (Shapes::shapeOf (Shapes::statementOf (Fixtures::natAddComm (), "Nat.add_comm"), natCommutativity ()), "equal"))

        test ("the false arithmetic statement n plus m equals m is rejected", \() =>
            expect (Shapes::shapeOf (Shapes::statementOf (Fixtures::natAddCommWrong (), "Nat.add_comm"), natWrongStatement ()), "equal")
            expect (Shapes::kindOf (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), Fixtures::natAddCommWrong (), "Nat.add_comm"))), "type mismatch"))

        test ("the recorded Nat.add_comm dependency closure contains no axioms", \() =>
            expect (axioms (Export::read (Fixtures::natAddComm ())), "0"))

        test ("a format version the kernel does not read is refused with its version", \() =>
            expect (Support::messageOf (Export::read (versioned ("2.0.0") ?: "")), "line 1: unsupported format version 2.0.0"))

        test ("a malformed quotient primitive is refused with its required fields", \() =>
            expect (Support::messageOf (Export::read (line ("{\"quot\":{}}"))), "line 2: quotient declaration needs exactly kind, levelParams, name and type"))

        test ("a malformed inductive declaration still refuses missing types", \() =>
            expect (Support::messageOf (Export::read (line ("{\"inductive\":{}}"))), "line 2: no types"))

        test ("an unknown declaration kind is refused with its kind", \() =>
            expect (Support::messageOf (Export::read (line ("{\"ind\":{}}"))), "line 2: unknown item: ind"))

        test ("an unknown expression kind is refused with its kind", \() =>
            expect (Support::messageOf (Export::read (line ("{\"ie\":3,\"fvar\":0}"))), "line 2: unsupported: fvar"))

        test ("a dangling reference names its line", \() =>
            expect (Support::messageOf (Export::read (line ("{\"ie\":0,\"sort\":4}"))), "line 2: unknown level 4"))

        test ("hygienic names render dotted, the anonymous root omitted", \() =>
            expect (described (Export::read (hygienic ())), "hygienic | (∀ (a._@._internal._hyg.0 : Prop), a._@._internal._hyg.0) | (fun (a._@._internal._hyg.0 : Prop) => a._@._internal._hyg.0)"))

        test ("the wrong proof of the same statement reads as itself", \() =>
            expect (described (Export::read (Fixtures::idImpBad ())), "id_imp | (∀ (p : Prop), (p → p)) | (fun (x._@.IdImp.4195544489._hygCtx._hyg.10 : Prop) => (fun (h : x._@.IdImp.4195544489._hygCtx._hyg.10) => x._@.IdImp.4195544489._hygCtx._hyg.10))"))

    export boundaries () =
        test ("numeric name components cannot be negative", \() =>
            expect (Support::messageOf (Export::read (line ("{\"in\":1,\"num\":{\"pre\":0,\"i\":-1}}"))), "line 2: numeric name components must be nonnegative"))
        test ("out-of-range numeric names remain an explicit decoder refusal", \() =>
            expect (readFailureContains ("{\"in\":1,\"num\":{\"pre\":0,\"i\":9223372036854775808}}", "integer outside the 64-bit range"), true))
        test ("NUL in a name remains an explicit decoder refusal", \() =>
            expect (readFailureContains ("{\"in\":1,\"str\":{\"pre\":0,\"str\":\"a\\u0000b\"}}", "invalid character or escape in string"), true))
        test ("unsafe axioms are refused before declarations enter the kernel", \() =>
            expect (boundaryMessage ("\"isUnsafe\":false", "\"isUnsafe\":true"), "line 8: unsafe declarations are refused"))
        test ("unsafe theorem flags are refused", \() =>
            expect (boundaryMessage ("\"thm\":{", "\"thm\":{\"isUnsafe\":true,"), "line 10: unsafe declarations are refused"))
        test ("unsafe definition safety is refused", \() =>
            expect (boundaryMessage ("\"thm\":{", "\"def\":{\"safety\":\"unsafe\","), "line 10: unsafe declarations are refused"))
        test ("declarations cannot use the anonymous name root", \() =>
            expect (boundaryMessage ("\"name\":1,\"type\":0", "\"name\":0,\"type\":0"), "line 8: name 0 is the anonymous root, not a declaration name"))
        forEachList (["max", "imax"], \key => test ("${key} refuses silently discarded extra universe operands", \() =>
            expect (Support::messageOf (Export::read (line ("{\"il\":1,\"${key}\":[0,0,0]}"))), "line 2: ${key} needs two sides")))
        test ("safe declaration flags keep the actual control checkable", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), boundaryExport (), "t")), "declared")
            expect (checkedVariant ("\"isUnsafe\":false,", ""), "declared")
            expect (checkedVariant ("\"thm\":{", "\"def\":{"), "declared")
            expect (checkedVariant ("\"thm\":{", "\"def\":{\"safety\":\"safe\","), "declared"))

    checkedVariant (before, after) = match replace (boundaryExport (), before, after)
        Error message => "fixture error: ${message}"
        Success source => declaredOutcome (Checked::exportedDeclaring (Environment::empty (), source, "t"))

    boundaryMessage (before, after) = Support::messageOf (Export::read (replace (boundaryExport (), before, after) ?: ""))

    readFailureContains (text, expected) = match indexOf (Support::messageOf (Export::read (line text)), expected)
        Success _ => true
        Error _ => false

    boundaryExport () = metaLine () + "\n" + "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"bad\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"pf\"}}\n{\"in\":3,\"str\":{\"pre\":0,\"str\":\"t\"}}\n{\"ie\":0,\"sort\":0}\n{\"ie\":1,\"const\":{\"name\":1,\"us\":[]}}\n{\"ie\":2,\"const\":{\"name\":2,\"us\":[]}}\n{\"axiom\":{\"isUnsafe\":false,\"levelParams\":[],\"name\":1,\"type\":0}}\n{\"axiom\":{\"isUnsafe\":false,\"levelParams\":[],\"name\":2,\"type\":1}}\n{\"thm\":{\"all\":[3],\"levelParams\":[],\"name\":3,\"type\":1,\"value\":2}}"

    export identities () =
        test ("an undeclared single-component dotted proof name cannot alias a namespace", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (3, 3), "t")), "unknown constant `\"A.B\"`"))

        test ("an undeclared numeric-string proof name cannot alias a numeric name", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (5, 5), "t")), "unknown constant `\"5\"`"))

        test ("distinct name components retain their own valid proof declarations", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (4, 3), "t")), "declared")
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (6, 5), "t")), "declared")
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (3, 2), "t")), "declared")
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), identityExport (5, 4), "t")), "declared"))

        test ("namespace and quoted names and numeric and string names coexist without shadowing", \() =>
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), coexist (3, 4, 3), "t")), "declared")
            expect (declaredOutcome (Checked::exportedDeclaring (Environment::empty (), coexist (5, 6, 5), "t")), "declared"))

    coexist (first, second, proof) = replace (identityExport (first, proof), "{\"thm\":", "{\"axiom\":{\"name\":${toString second},\"type\":1,\"levelParams\":[],\"isUnsafe\":false}}\n{\"thm\":") ?: ""

    identityExport (declaration, proof) = "${metaLine ()}\n${identityRows ()}\n{\"axiom\":{\"name\":${toString declaration},\"type\":1,\"levelParams\":[],\"isUnsafe\":false}}\n{\"thm\":{\"name\":7,\"type\":1,\"value\":${toString proof},\"levelParams\":[],\"all\":[]}}"

    identityRows () = "{\"in\":1,\"str\":{\"pre\":0,\"str\":\"P\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"A\"}}\n{\"in\":3,\"str\":{\"pre\":2,\"str\":\"B\"}}\n{\"in\":4,\"str\":{\"pre\":0,\"str\":\"A.B\"}}\n{\"in\":5,\"num\":{\"pre\":0,\"i\":5}}\n{\"in\":6,\"str\":{\"pre\":0,\"str\":\"5\"}}\n{\"in\":7,\"str\":{\"pre\":0,\"str\":\"t\"}}\n{\"ie\":0,\"sort\":0}\n{\"ie\":1,\"const\":{\"name\":1,\"us\":[]}}\n{\"ie\":2,\"const\":{\"name\":3,\"us\":[]}}\n{\"ie\":3,\"const\":{\"name\":4,\"us\":[]}}\n{\"ie\":4,\"const\":{\"name\":5,\"us\":[]}}\n{\"ie\":5,\"const\":{\"name\":6,\"us\":[]}}\n{\"axiom\":{\"name\":1,\"type\":0,\"levelParams\":[],\"isUnsafe\":false}}"

    (** One declaration rendered as `name | statement | proof`; anything
        else reads as its own failure, never as a pass. *)
    checkedRecursorRoots outcome = match outcome
        Error message => message
        Success env => foldList (recursorRoots (), "", \(text, name) => "${text}${checkedRecursorRoot (env, name)};")

    recursorRoots () = ["Tree.leaf_nodes", "Tree.node_nodes", "Forest.nil_nodes", "Forest.cons_nodes", "NestedArray.node_empty_nodes", "NestedArray.node_one_nodes", "IndexedTree.reflexive_count", "IndexedTree.indexed_count"]

    checkedRecursorRoot (env, name) = match Environment::find (env, name)
        Error message => message
        Success decl => match decl.body
            Theorem _ => match Trust::described (Trust::axioms (env, name))
                Success names => match names == "none"
                    true => "declared"
                    false => "unexpected axioms: ${names}"
                Error message => message
            other => "${name} is not a theorem"

    described (outcome) = match outcome
        Success items => sole (items)
        Error message => "error: ${message}"

    sole (items) = match length items == 1
        true => match listGet (items, 0)
            Success item => itemised (item)
            Error message => "error: ${message}"
        false => "expected one declaration, found ${toString (length items)}"

    itemised (item) = match item
        Single decl => "${decl.name} | ${Terms::show (decl.ty, [])} | ${bodied (decl.body)}"
        Group block => "block of ${blockName (block.formers)}"

    blockName (formers) = match formers
        [first, ...rest] => first.name
        [] => "?"

    bodied (body) = match body
        Theorem value => Terms::show (value, [])
        Definition value => "definition ${Terms::show (value, [])}"
        Axiom => "axiom"
        other => "inductive constant"

    (** The recorded export's `meta` line, reused so every case starts from
        the one header the reader accepts. *)
    metaLine () = listGet (lines (Fixtures::idImp ()), 0) ?: ""

    natCommutativity () = Pi "n" (Const "Nat" []) (Pi "m" (Const "Nat" []) (Terms::apps (Const "Eq" [Succ Zero], [Const "Nat" [], natSum (BVar 1, BVar 0), natSum (BVar 0, BVar 1)])))

    natWrongStatement () = Pi "n" (Const "Nat" []) (Pi "m" (Const "Nat" []) (Terms::apps (Const "Eq" [Succ Zero], [Const "Nat" [], natSum (BVar 1, BVar 0), BVar 0])))

    haddExport () = match indexOf (Fixtures::natAddComm (), "{\"in\":33,\"str\":{\"pre\":24,\"str\":\"hAdd\"}}")
        Success at => take (Fixtures::natAddComm (), at)
        Error _ => "missing HAdd export boundary"

    natSum (left, right) = Terms::apps (Const "HAdd.hAdd" [Zero, Zero, Zero], [Const "Nat" [], Const "Nat" [], Const "Nat" [], App (App (Const "instHAdd" [Zero]) (Const "Nat" [])) (Const "instAddNat" []), left, right])

    axioms (outcome) = match outcome
        Success items => toString (foldList (Shapes::declarations items, 0, \(count, decl) => satAdd count (axiomCount decl.body)))
        Error message => message

    axiomCount (body) = match body
        Axiom => 1
        other => 0

    declaredOutcome (outcome) = match outcome
        Success env => "declared"
        Error message => message

    (** The recorded export with the format version renamed; the unused
    binder of `p → p` prints as an arrow, so the hygienic name of the
    implication's binder never shows in the statement. *)
    versioned (version) = replace (Fixtures::idImp (), "\"format\":{\"version\":\"3.1.0\"}", "\"format\":{\"version\":\"${version}\"}")

    (** The meta line followed by one JSON line. *)
    line (text) = "${metaLine ()}\n${text}"

    (** A one-theorem export whose only binder name is the hygienic chain
        `a._@._internal._hyg.0`: five name entries, then `Prop`, a variable,
        the proof `fun x => x`, the statement `∀ x : Prop, x`, the theorem. *)
    hygienic () = line ("{\"in\":1,\"str\":{\"pre\":0,\"str\":\"hygienic\"}}\n{\"in\":2,\"str\":{\"pre\":0,\"str\":\"a\"}}\n{\"in\":3,\"str\":{\"pre\":2,\"str\":\"_@\"}}\n{\"in\":4,\"str\":{\"pre\":3,\"str\":\"_internal\"}}\n{\"in\":5,\"str\":{\"pre\":4,\"str\":\"_hyg\"}}\n{\"in\":6,\"num\":{\"i\":0,\"pre\":5}}\n{\"ie\":0,\"sort\":0}\n{\"ie\":1,\"bvar\":0}\n{\"ie\":2,\"lam\":{\"binderInfo\":\"default\",\"body\":1,\"name\":6,\"type\":0}}\n{\"ie\":3,\"forallE\":{\"binderInfo\":\"default\",\"body\":1,\"name\":6,\"type\":0}}\n{\"thm\":{\"all\":[1],\"levelParams\":[],\"name\":1,\"type\":3,\"value\":2}}\n")

    (** The embedded export's shape: its line count, and its first and last
        lines named by their leading key. A mismatch prints the real lines,
        so a broken embedding can never read as a pass. *)
    shape (text) = match keyed (first text, "meta") && keyed (last text, "thm")
        true => "${toString (length (lines text))} | meta | thm"
        false => "${toString (length (lines text))} | ${first text} | ${last text}"

    first (text) = listGet (lines text, 0) ?: ""

    last (text) = listGet (lines text, satSub (length (lines text)) 1) ?: ""

    keyed (text, key) = startsWith (text, "{\"${key}\":")

    // Exact Lean 4.25 nested List export; Implements [PROOF-KERNEL-THEORY].
    // SHA-256 e74496f0b264c5d70d92b6c7f343cd8658f7a941b82ca1b7696809707a89ae90.
