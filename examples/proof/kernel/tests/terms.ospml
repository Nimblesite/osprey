namespace prooftests

import proof::Terms
import proof
    Zero
    Succ
    Param
    Sort
    BVar
    Const
    App
    Lam
    Pi
import prooftests::Support

(** Shifting, substitution, occurrence and printing of de Bruijn terms. *)
module TermsTests
    closed () = Sort (Succ Zero)

    export run () =
        test ("shift raises only indices at or above the cutoff", \() =>
            expect (Support::render (Terms::shift (BVar 0, 0, 1)), "#1")
            expect (Support::render (Terms::shift (BVar 1, 1, 2)), "#3")
            expect (Support::render (Terms::shift (BVar 0, 1, 2)), "#0"))

        test ("shift below a binder leaves the bound index alone", \() =>
            expect (Support::render (Terms::shift (Lam "x" (Sort Zero) (BVar 0), 0, 1)), "(fun (x : Prop) => x)")
            expect (Support::render (Terms::shift (Lam "x" (Sort Zero) (BVar 1), 0, 1)), "(fun (x : Prop) => #2)"))

        test ("substituting index zero lowers the indices above it", \() =>
            expect (Support::render (Terms::instantiate (App (BVar 0) (BVar 1), closed ())), "(Type #0)")
            expect (Terms::equal (Terms::instantiate (App (BVar 0) (BVar 1), closed ()), App (closed ()) (BVar 0)), true))

        test ("instantiate under a lambda lifts the replacement past the binder", \() =>
            expect (Support::render (Terms::instantiate (Lam "y" (Sort Zero) (BVar 1), BVar 9)), "(fun (y : Prop) => #10)"))

        test ("mentions sees a free variable through a binder only", \() =>
            expect (Terms::mentions (Lam "x" (Sort Zero) (BVar 1), 0), true)
            expect (Terms::mentions (Lam "x" (Sort Zero) (BVar 0), 0), false))

        test ("show prints the id type, Prop and Type", \() =>
            expect (Support::render (Support::idType ()), "(∀ (p : Prop), (p → p))")
            expect (Support::render (Sort Zero), "Prop")
            expect (Support::render (Sort (Succ Zero)), "Type")
            expect (Support::render (Sort (Succ (Succ Zero))), "Sort 2"))

        test ("equal is structural: repeated binder names do not merge distinct indices", \() =>
            expect (Terms::equal (Lam "x" (Sort Zero) (Lam "x" (Sort Zero) (BVar 0)), Lam "x" (Sort Zero) (Lam "x" (Sort Zero) (BVar 1))), false)
            expect (Terms::equal (Lam "x" (Sort Zero) (Lam "x" (Sort Zero) (BVar 0)), Lam "a" (Sort Zero) (Lam "b" (Sort Zero) (BVar 0))), true))

        test ("equal compares every universe argument of a constant", \() =>
            expect (Terms::equal (Const "F" [Zero], Const "F" [Succ Zero]), false)
            expect (Terms::equal (Const "F" [Zero], Const "F" []), false)
            expect (Terms::equal (Const "F" [Succ Zero], Const "F" [Succ (Zero)]), true)
            expect (Terms::equal (Sort (Param "u"), Sort (Param "v")), false))

        test ("equal distinguishes lambda from pi over the same binder", \() =>
            expect (Terms::equal (Lam "x" (Sort Zero) (BVar 0), Pi "x" (Sort Zero) (BVar 0)), false))

        test ("instantiateLevels reaches sorts and constants under binders", \() =>
            expect (Support::render (Terms::instantiateLevels (Pi "x" (Sort (Param "u")) (App (Const "F" [Param "u"]) (BVar 0)), ["u"], [Succ Zero])), "(∀ (x : Type), (F.{1} x))")
            expect (Terms::declared (Const "F" [Param "u"], ["u"]), true)
            expect (Terms::declared (Lam "x" (Sort (Param "v")) (BVar 0), ["u"]), false))

        test ("show prints the universe arguments of a constant", \() =>
            expect (Support::render (Const "F" [Zero, Param "u"]), "F.{0, u}"))
