{
  "steps": [
    {"wait": "Settings"},
    {"invoke": "Settings"},
    {"invoke": "MCP servers"},
    {"wait": "local"},
    {"wait": ".mcp.json"},
    {"shot": "30-mcp-project-off"},
    {"invoke": "Add"},
    {"wait": "Enter a server name."},
    {"type": ["Name", "demo"]},
    {"type": ["Command", "python3"]},
    {"type": ["Arguments", "@SERVER@\n--pid-file\n@DEMO_PID@"]},
    {"type": ["Environment", "MCP_TEST_WORD=zephyr-word\nSECRET_ENV=env-only-secret"]},
    {"invoke": "Add"},
    {"wait": "Connected"},
    {"gone": "env-only-secret"},
    {"shot": "31-mcp-connected"},
    {"invoke": "demo tools"},
    {"wait": "The word only this server knows."},
    {"shot": "32-mcp-tools"},
    {"invoke": "Close"},
    {"type": ["Message", "Is the project server running?\n"]},
    {"wait": "Not running."},
    {"type": ["Message", "What is the word?\n"]},
    {"wait": "The word is in."},
    {"shot": "33-mcp-tool-calls"},
    {"type": ["Message", "Now break it\n"]},
    {"wait": "It died."},
    {"invoke": "Settings"},
    {"wait": "exited. Press Reconnect"},
    {"shot": "34-mcp-failed"},
    {"invoke": "Reconnect demo"},
    {"gone": "exited. Press Reconnect"},
    {"wait": "Connected"},
    {"type": ["JSON config", "{\"mcpServers\": {\"web\": {\"url\": \"http://127.0.0.1:@WEB_PORT@/mcp\", \"headers\": {\"Authorization\": \"Bearer hdr-secret-token\"}}, \"sse\": {\"url\": \"http://127.0.0.1:@SSE_PORT@/mcp\"}}}"]},
    {"invoke": "Paste JSON"},
    {"wait": "http://127.0.0.1:@WEB_PORT@/mcp"},
    {"gone": "hdr-secret-token"},
    {"toggle": "local"},
    {"sleep": "2"},
    {"shot": "35-mcp-all-on"},
    {"invoke": "Close"},
    {"type": ["Message", "Use the web servers\n"]},
    {"wait": "Web done."},
    {"invoke": "Settings"},
    {"invoke": "Remove demo"},
    {"gone": "Remove demo"},
    {"invoke": "Close"},
    {"type": ["Message", "Is it gone?\n"]},
    {"wait": "Gone."},
    {"shot": "36-mcp-inspector"}
  ]
}
