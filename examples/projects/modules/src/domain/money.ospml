// domain/money — PURE money arithmetic and formatting. [MODULES-SIGNATURE]
//
// `Money : MoneyApi` is a signature-ascribed module: the signature is its
// complete public surface, so nothing inside carries an `export` marker and
// nothing beyond the signature can leak. Every function is a pure expression —
// Amount is a private record; Cents is a public int alias. The native server
// and Wasm client use the same explicit conversions without floating-point drift.

namespace bank

signature MoneyApi
    type Cents = int
    type Amount
    fromCents : Cents -> Amount
    toCents : Amount -> Cents
    show : Amount -> string
    positive : Amount -> bool

module Money : MoneyApi
    type Cents = int
    type Amount =
        cents : Cents

    fromCents cents = Amount(cents = cents)
    toCents amount = amount.cents

    (** "$4,250.05" — cents are zero-padded via the two-digit remainder and
        dollars are thousands-grouped by recursion. `/` is float division, so
        this runs on `intDiv` and `%` by nonzero literals: total, never faulting. *)
    pennies c =
        remainder = c % 100
        match remainder < 10
            true => "0${remainder}"
            false => "${remainder}"

    triple n = match n < 10
        true => "00${n}"
        false => match n < 100
            true => "0${n}"
            false => "${n}"

    group dollars = match dollars < 1000
        true => "${dollars}"
        false =>
            next = intDiv dollars 1000
            remainder = dollars % 1000
            "${group next},${triple remainder}"

    show amount =
        cents = toCents amount
        dollars = intDiv cents 100
        // Divide before negating: both parts fit even when cents is INT64_MIN.
        match cents < 0
            true => "-$${group (wrapSub 0 dollars)}.${pennies (wrapSub 0 (cents % 100))}"
            false => "$${group dollars}.${pennies cents}"

    positive amount = toCents amount > 0
