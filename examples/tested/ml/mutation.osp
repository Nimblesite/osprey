// Default-flavor twin of mutation.ospml. The mutable counter is owned by the
// Counter handler: callers can change it only by performing `add`. ML
// `name := e` and Default `name = e` lower to the same assignment node, so the
// handler-owned mutation remains byte-identical across flavors.

effect Counter { add: fn(int) -> Unit }

mut counter = 0
handle Counter
    add amount => {
        counter = counter + amount
    }
in {
    perform Counter.add(1)
    perform Counter.add(41)
    print("counter = ${counter}")
}
