// `=` binds an immutable name; `mut` marks a handler-owned cell; `:=` mutates it
// only inside the Counter handler. Callers change the counter through `perform`.

effect Counter
    add : int => Unit

mut counter = 0
handle Counter
    add amount =>
        counter := counter + amount
in
    perform Counter.add 1
    perform Counter.add 41
    print "counter = ${counter}"
