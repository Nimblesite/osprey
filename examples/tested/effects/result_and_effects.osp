// SUPERPOWER: Result and effects COMPOSE — and that composition beats try/catch.
//
// A `Result<T, E>` says only "this value might be absent, here's why." It does
// NOT decide what to do next — that recovery POLICY belongs somewhere else.
// The bridge: when a helper's arithmetic yields `Error { message }`, it does not
// abort — it `perform`s `Rescue.onErr(message)`, handing the ORIGINAL error text
// up to a single handler. The handler is a PURE TAIL-RESUME handler: no arm ever
// writes `resume`, so every arm's value is substituted right back at the perform
// site and the pipeline ALWAYS CONTINUES to the very next line.
//
// Why try/catch cannot do this: a `catch` unwinds the stack, so the failed
// expression is DEAD — you cannot patch that one value and resume where you were.
// To keep going you must wrap every single operation in its own try/catch, and
// the recovery constant is then scattered across all those catch blocks. Here the
// FIVE-STEP pipeline divides by zero TWICE and overflows a checked-add ONCE, yet
// every healthy step still lands in the final total, because each failure is
// patched IN PLACE. The policy — the substituted default and the running count —
// lives in ONE tail-resume handler that owns its own mutable state.

effect Rescue {
    onErr: fn(string) -> int
}

// When recovery fires, we substitute this named default and keep computing.
let RESCUED_DEFAULT = 100

// --- Result-producing helpers. Each MATCHES on Success/Error; on Error it hands
// --- the message string to the handler and uses whatever int comes back. ---

// intDiv gives Result<int, MathError>; 10/0 => Error(division by zero).
fn divRescue(a, b) !Rescue = match intDiv(a: a, b: b) {
    Success { value } => value
    Error { message } => perform Rescue.onErr(message)
}

// % is the zero-checked remainder: 7 % 0 => Error(division by zero).
fn modRescue(a, b) !Rescue = match a % b {
    Success { value } => value
    Error { message } => perform Rescue.onErr(message)
}

// checkedAdd is overflow-checked: MAX_INT + 1 => Error(integer overflow).
fn addRescue(a, b) !Rescue = match checkedAdd(a: a, b: b) {
    Success { value } => value
    Error { message } => perform Rescue.onErr(message)
}

// The pipeline runs straight through. Some steps fail; NONE of them abort it.
fn pipeline() -> int !Rescue = {
    let a = divRescue(a: 10, b: 0)
    print("  step a  intDiv 10 / 0   -> ${toString(a)}")
    let b = divRescue(a: 20, b: 4)
    print("  step b  intDiv 20 / 4   -> ${toString(b)}")
    let c = modRescue(a: 7, b: 0)
    print("  step c  7 % 0           -> ${toString(c)}")
    let d = modRescue(a: 17, b: 5)
    print("  step d  17 % 5          -> ${toString(d)}")
    let e = addRescue(a: 9223372036854775807, b: 1)
    print("  step e  MAX + 1         -> ${toString(e)}")
    let f = addRescue(a: 100, b: 23)
    print("  step f  100 + 23        -> ${toString(f)}")
    a + b + c + d + e + f
}

print("=== Result -> effect rescue pipeline ===")

// PURE TAIL-RESUME handler owning mutable state: no `resume` anywhere, so each
// failed step is substituted with RESCUED_DEFAULT and the performer continues.
mut rescues = 0
let total = handle Rescue
    onErr message => {
        rescues = rescues + 1
        print("  RESCUE #${toString(rescues)}: original error \"${message}\" -> using ${toString(RESCUED_DEFAULT)}")
        RESCUED_DEFAULT
    }
in pipeline()

print("rescued ${toString(rescues)} failing step(s); healthy + rescued total = ${toString(total)}")

// --- Contrast: the `?:` Result-default operator is the LOCAL, policy-free tool.
// --- No handler, no continuation, no counting — just a fixed fallback right here.
// --- Same error channel, but the decision cannot be centralized or observed. ---
let localOk  = (10 % 3) ?: -1
let localBad = (10 % 0) ?: -1
print("local ?: default  10 % 3 -> ${toString(localOk)}   10 % 0 -> ${toString(localBad)}")

// And the raw float `/` divide-by-zero Result, shown as a value (no rescue).
print("raw 10 / 0 as a value = ${toString(10 / 0)}")
print("=== pipeline complete ===")
