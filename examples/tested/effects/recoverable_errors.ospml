// Same direct value-substitution handlers as the Default-flavor twin.
effect Recover
    overdraw : (int, int) => int

drawOrder requested available = match requested > available
    true => perform Recover.overdraw requested available
    false => requested

fulfill orders stock = match orders
    [] => stock
    [requested, ...rest] =>
        drawn = drawOrder requested stock
        remaining = stock - drawn
        print "  order ${requested}: from ${stock} in stock -> took ${drawn}, ${remaining} left"
        fulfill rest remaining

start = 20
batch = listAppend (listAppend (listAppend (listAppend (listAppend (List ()) 6) 30) 5) 8) 40

mut skipCount = 0
mut skipReason = ""
print "=== POLICY A: SKIP (substitute 0, preserve stock) ==="
skipFinal =
    handle Recover
        overdraw requested available =>
            skipCount := skipCount + 1
            skipReason := skipReason + "skipped ${requested} (only ${available} left); "
            0
    in fulfill batch start
skipFilled = start - skipFinal
print "SKIP done: recovered ${skipCount} orders, fulfilled ${skipFilled} units, ${skipFinal} left in stock\nSKIP log: [${skipReason}]"

mut capCount = 0
mut capReason = ""
print "=== POLICY B: CAP (substitute available, drain to fit) ==="
capFinal =
    handle Recover
        overdraw requested available =>
            capCount := capCount + 1
            capReason := capReason + "capped ${requested} to ${available}; "
            available
    in fulfill batch start
capFilled = start - capFinal
print "CAP done: recovered ${capCount} orders, fulfilled ${capFilled} units, ${capFinal} left in stock\nCAP log: [${capReason}]"

mut happyCount = 0
happyBatch = listAppend (listAppend (listAppend (listAppend (List ()) 3) 5) 2) 4
print "=== HAPPY PATH: SKIP handler, no over-draws ==="
happyFinal =
    handle Recover
        overdraw requested available =>
            happyCount := happyCount + 1
            0
    in fulfill happyBatch start
happyFilled = start - happyFinal
print "HAPPY done: recovered ${happyCount} orders, fulfilled ${happyFilled} units, ${happyFinal} left in stock\n=== all three batches completed ==="
