// Feature omnibus — ML-flavor twin. Same canonical AST as the Default flavor,
// so byte-identical LLVM IR: inline unions, equational clauses, positional
// payloads, `_` parameters, `?:`, layout `match`, interpolation, generics,
// lambdas + pipe, collections, and string builtins.

type Pri = Low | Med | High

priWeight Low = 1
priWeight Med = 5
priWeight High = 9

type Color = Red | Green | Blue

colorName Red = "red"
colorName Green = "green"
colorName Blue = "blue"

type Wrapped = Wrapped int

wrapped = Wrapped 42
wrappedValue = match wrapped
    (Wrapped n) => n

// Forward reference: callerOfLater is defined here, calleeLater below.
callerOfLater _ = calleeLater 10
print "=== omnibus ==="

// --- Union pattern match ---
print (priWeight High)
print (priWeight Med)
print (priWeight Low)
print "${colorName Green} wrapped ${wrappedValue}"

// --- Plain addition + division Result auto-unwrap in interpolation ---
age = 25
print "next ${age + 1} half ${age / 2}"
f = 1.5
print f

// --- Result on error path ---
match parseInt "oops"
    Success value => print "got ${value}"
    Error message => print "parseInt rejected oops"
parsed = parseInt "123" ?: 0
print "parsed ${parsed}"

// --- Bools from comparison + string concat ---
print (5 == 5)
print (5 == 6)
print ("hi" + " " + "world")

// --- Forward function call ---
print "forward call -> ${callerOfLater 0}"

// --- Lambda + pipe + chained pipe ---
r = 5 |> (\x => x + 100) |> (\x => x * 2)
print (toString r)
single = 7 |> \x => x * 3
print (toString single)

// --- Handler-owned mutable integer counter ---
effect Counter
    increment : Unit => Unit
mut counter = 0
handle Counter
    increment =>
        counter := counter + 1
in
    perform Counter.increment ()
    perform Counter.increment ()
    perform Counter.increment ()
print "counter ${toString counter}"

// --- Persistent List<T> + Map<K,V> ---
xs = listAppend (listAppend (listAppend (List ()) 10) 20) 30
ys = listAppend (List ()) 99
print "list len ${toString (listLength (xs + ys))}"
print "contains 20 ${toString (listContains xs 20)}"

m = mapSet (mapSet (Map ()) "a" 1) "b" 2
print "map len ${toString (mapLength m)}"
print "map has a ${toString (mapContains m "a")}"

// --- List literal + index returning Result ---
scores = [85, 92, 78]
match scores[1]
    Success value => print "scores[1] ${value}"
    Error message => print "oob"

// --- Map literal + lookup ---
prices = ["apple" => 2, "banana" => 3]
match prices["banana"]
    Success value => print "banana ${value}"
    Error message => print "missing"

// --- String builtins ---
s = "  Hello  "
print (trim s)
print (toUpperCase s)
print (toString (length s))

print "=== omnibus done ==="
0

calleeLater n = n * 4
