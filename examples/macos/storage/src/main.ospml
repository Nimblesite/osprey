// Implements [IOS-TARGET-MACOS], [IOS-HOST-IMPORTS] and [MOBILE-REACTIVE-HOST]:
// the Swift host measures the disk and answers these C functions; every
// screen it draws comes from `start` and `dispatch`.
namespace storage

import bank::Json
import storage::Disk
import storage::Browse
import storage::View

extern storage_volume (path : string) (measure : string) -> int
extern storage_volume_name (path : string) -> string
extern storage_scan (folder : string) -> int
extern storage_entry_path (index : int) -> string
extern storage_entry_bytes (index : int) -> int
extern storage_entry_visible (index : int) -> int
extern storage_entry_hidden (index : int) -> bool
extern storage_entry_folder (index : int) -> bool
extern storage_entry_link (index : int) -> bool
extern storage_entry_guarded (index : int) -> bool
extern storage_unreadable -> int
extern storage_photos_status -> string
extern storage_photos_items -> int
extern storage_photos_bytes -> int
extern storage_photos_cloud -> int
extern storage_photos_kind_items (kind : string) -> int
extern storage_photos_kind_bytes (kind : string) -> int

entry index = Entry(path = storage_entry_path index, bytes = storage_entry_bytes index, visible = storage_entry_visible index, hidden = storage_entry_hidden index, folder = storage_entry_folder index, guarded = storage_entry_guarded index, link = storage_entry_link index)

(** `bytes` in decimal units, published to the host from the entry source,
    which is what crosses the C boundary ([IOS-HOST-ABI]). *)
formatBytes bytes = Disk::formatBytes bytes

(** `count` with thousands separators, for the host. *)
formatCount count = Disk::formatCount count

(** The whole percent `part` is of `whole`, for the host; 0 for an empty whole. *)
percent (part, whole) = Disk::percent (part, whole)

photoKind name = PhotoKind(name = name, items = storage_photos_kind_items name, bytes = storage_photos_kind_bytes name)

photoKinds () =
    names = Disk::photoKinds ()
    range (0, length names) |> fold [] (\(kinds, index) => listAppend kinds (photoKind (listGet names index ?: "")))

listed count = Listing(entries = range 0 count |> map entry |> toList, blocked = storage_unreadable (), measured = count >= 0)

screen model =
    handle Disk::Facts
        volume path => Volume(name = storage_volume_name path, total = storage_volume path "total", available = storage_volume path "available", important = storage_volume path "important")
        listing folder => listed (storage_scan folder)
        photos => Photos(status = storage_photos_status (), items = storage_photos_items (), bytes = storage_photos_bytes (), cloud = storage_photos_cloud (), kinds = photoKinds ())
    View::render model

envelope step = Json::obj (Json::strField "model" (Browse::encode step.model) + "," + Json::rawField "commands" step.commands + "," + Json::rawField "ui" (screen step.model))

(** The first screen on `platform` (`macos` or `ios`) for a person whose home is `home`, with its walk requested; `full` says whether the Mac granted Full Disk Access. *)
start (home, platform, full) = envelope (Browse::start home platform full)

(** The next screen after one host event, given the browser the last screen returned. *)
dispatch (model, event) = envelope (Browse::dispatch (Browse::decode model) event)
