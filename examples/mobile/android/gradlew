#!/usr/bin/env bash
# Use Gradle 8.7 unless the caller explicitly overrides it with GRADLE_BIN.
set -euo pipefail
if [[ -n ${GRADLE_BIN:-} ]]; then exec "$GRADLE_BIN" "$@"; fi
gradle_user_home="${GRADLE_USER_HOME:-$HOME/.gradle}"
cache="$gradle_user_home/osprey-distributions"
if [[ -x "$cache/gradle-8.7/bin/gradle" ]]; then exec "$cache/gradle-8.7/bin/gradle" "$@"; fi
for candidate in "$gradle_user_home"/wrapper/dists/gradle-8.7-*/**/gradle-8.7/bin/gradle; do
    if [[ -x "$candidate" ]]; then exec "$candidate" "$@"; fi
done
mkdir -p "$cache"
if [[ ! -x "$cache/gradle-8.7/bin/gradle" ]]; then
    curl --fail --location --retry 2 https://services.gradle.org/distributions/gradle-8.7-bin.zip -o "$cache/gradle-8.7-bin.zip"
    curl --fail --location --retry 2 https://services.gradle.org/distributions/gradle-8.7-bin.zip.sha256 -o "$cache/gradle-8.7-bin.zip.sha256"
    expected=$(cat "$cache/gradle-8.7-bin.zip.sha256")
    actual=$(shasum -a 256 "$cache/gradle-8.7-bin.zip")
    [[ ${actual%% *} == "$expected" ]] || { echo 'Gradle checksum mismatch' >&2; exit 1; }
    unzip -q "$cache/gradle-8.7-bin.zip" -d "$cache"
fi
exec "$cache/gradle-8.7/bin/gradle" "$@"
