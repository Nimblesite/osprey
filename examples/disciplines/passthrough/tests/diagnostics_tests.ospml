namespace passthrough

import passthrough::Diagnostics

(** One stderr line of the compiler's `--check` becomes one protocol
    diagnostic: positioned when the `path:line:col:` prefix is present,
    unpositioned otherwise, and nothing for lines that are not diagnostics. *)
module DiagnosticsTests
    export run () =
        test ("a path:line:col line becomes a positioned diagnostic", \() =>
            expect (Diagnostics::diagnosticOf ("/tmp/s.ospml:5:8: type mismatch: cannot unify int with string"),
                "{\"code\":\"check\",\"severity\":\"error\",\"line\":5,\"column\":8,\"message\":\"type mismatch: cannot unify int with string\"}"))

        test ("a line with a colon but no position carries nulls", \() =>
            expect (Diagnostics::diagnosticOf ("/tmp/s.ospml: unknown identifier `double`"),
                "{\"code\":\"check\",\"severity\":\"error\",\"line\":null,\"column\":null,\"message\":\"unknown identifier `double`\"}"))

        test ("colons inside the message survive the prefix parse", \() =>
            expect (Diagnostics::diagnosticOf ("/a:1:2: expected ':' at byte 3"),
                "{\"code\":\"check\",\"severity\":\"error\",\"line\":1,\"column\":2,\"message\":\"expected ':' at byte 3\"}"))

        test ("a line that is not a diagnostic is dropped", \() =>
            expect (Diagnostics::diagnosticOf ("2 warnings (undocumented-export)"), ""))

        test ("an empty line is dropped", \() =>
            expect (Diagnostics::diagnosticOf (""), ""))

        test ("whole stderr becomes one JSON array in order", \() =>
            expect (Diagnostics::parse ("/a:1:2: first\n\n2 errors (type)\n/b:3:4: second\n"),
                "[{\"code\":\"check\",\"severity\":\"error\",\"line\":1,\"column\":2,\"message\":\"first\"},{\"code\":\"check\",\"severity\":\"error\",\"line\":3,\"column\":4,\"message\":\"second\"}]"))

        test ("empty stderr is an empty array", \() =>
            expect (Diagnostics::parse ("\n\n"), "[]"))
