namespace passthrough

import passthrough::Source

helpersImport = ("Helpers::Ops", "signature Ops\n    double : (int) -> int\n")

(** Replacing member-selection imports of the module with the extern stubs of
    their signatures, so one file alone carries what `--signature` must infer. *)
module SourceTests
    export run () =
        test ("a member-selection import becomes the stubbed externs in place", \() =>
            expect (Source::transform ("namespace Count\n\nmodule Ops\n    import Helpers::Ops\n        double\n\n    export twice n = double (double n)\n", [helpersImport]),
                "namespace Count\n\nmodule Ops\n    extern double (p0 : int) -> int\n\n    export twice n = double (double n)\n"))

        test ("an aliased member keeps its alias in the stub", \() =>
            expect (Source::transform ("module M\n    import Helpers::Ops\n        double as d\n    export f x = d x\n", [helpersImport]),
                "module M\n    extern d (p0 : int) -> int\n    export f x = d x\n"))

        test ("a whole-target import is refused with the reason", \() =>
            expect (Source::transform ("namespace C\n\nimport Helpers::Ops\n", [helpersImport]),
                "Error(passthrough cannot stub the whole-target import `Helpers::Ops`: only member-selection imports are stubbed)"))

        test ("an import with no arriving signature is refused with the reason", \() =>
            expect (Source::transform ("import Other::M\n    f\n", [helpersImport]),
                "Error(passthrough received no signature for the import `Other::M`)"))

        test ("a module with no imports is returned unchanged", \() =>
            expect (Source::transform ("namespace Count\n\nmodule Ops\n    export twice n = n * 2\n", []),
                "namespace Count\n\nmodule Ops\n    export twice n = n * 2\n"))

        test ("blank lines after the import block survive", \() =>
            expect (Source::transform ("module M\n    import Helpers::Ops\n        double\n\n    export f x = x\n", [helpersImport]),
                "module M\n    extern double (p0 : int) -> int\n\n    export f x = x\n"))

        test ("a file-scope import is replaced at its own indentation", \() =>
            expect (Source::transform ("namespace N\nimport Helpers::Ops\n    double\n\nm x = double x\n", [helpersImport]),
                "namespace N\nextern double (p0 : int) -> int\n\nm x = double x\n"))
