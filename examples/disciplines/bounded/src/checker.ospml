//! The `bounded` reference type discipline of [TYPES-DISCIPLINE-REFERENCE]
//! (spec 0050): `// @bound n in 0..100` above a function bounds one `int`
//! parameter, every call site inside the module is checked against it by
//! interval arithmetic, and the module is erased to plain `int` for the HM
//! pipeline. The README names the subset this deliberately small checker
//! does not read.
//!
//! The compiler builds one file, `<compiler> <checker> --compile`, so the
//! interval arithmetic, the annotation scan, the erasure and the protocol all
//! live here. The top-level statement is the checker's entry point; the same
//! file is a source of this package's test project, which is why the entry is
//! a module function invoked at the top level instead of a namespace `main`
//! (a namespace-level `main` is legal only in the project's selected entry).

namespace bounded

(** The header comment a discipline marker is written with. *)
markerPrefix = "// osprey: types="

(** What an accepted module is rewritten to: the identity discipline. *)
hmMarker = "// osprey: types=hm"

(** The comment that opens a bound annotation. *)
annotationPrefix = "// @bound "

(** The separator between a parameter and its interval. *)
annotationJoin = " in "

(** The separator between an interval's two endpoints. *)
rangeJoin = ".."

(** The keyword a declaration line may open with. *)
exportPrefix = "export "

(** The protocol version this checker speaks; the compiler refuses another, so
    an answer to a request too broken to carry a version says this. *)
protocolVersion = 2

(** The protocol's only diagnostic severity: a violation is an error. *)
severityError = "error"

(** The answer when a well-formed document cannot be encoded: still a
    rejection, so standard output is never empty. *)
fallback = "{\"version\":1,\"result\":\"rejected\",\"diagnostics\":[{\"code\":\"internal\",\"severity\":\"error\",\"message\":\"the checker could not encode its answer\"}]}"

(** An argument the checker cannot bound. *)
codeUnknown = "unknown"

(** An argument whose interval leaves the parameter's declared bound. *)
codeRange = "out-of-range"

(** The erased module did not pass the compiler. *)
codeCheck = "check"

(** The checker itself could not answer. *)
codeInternal = "internal"

(** The characters a function, parameter or identifier is spelled with. *)
identifierCharacters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

(** An inclusive integer interval, the values a bounded argument may take. *)
type Bound =
    lo : int
    hi : int

(** What interval arithmetic established about one argument, if anything. *)
type Interval = Known Bound | Unknown

(** One `// @bound <param> in <lo>..<hi>` line, before its function is known. *)
type Annotation =
    param : string
    bound : Bound

(** The name, indentation, column and parameters read off a declaration line. *)
type Header =
    name : string
    indent : int
    at : int
    params : List<string>

(** A declaration line the scan could read. *)
type MaybeHeader = IsHeader Header | NotHeader

(** A parsed function definition and the bounds its annotations gave it. *)
type Definition =
    header : Header
    line : int
    bounds : Map<string, Bound>

(** The definition a call line sits in, if the scan found one. *)
type Found = Located Definition | NotFound

(** One line of the module, numbered from one, with its indentation. *)
type Line =
    number : int
    indent : int
    text : string

(** One rejected call site, before the compiler prefixes the discipline name. *)
type Problem =
    code : string
    line : int
    column : int
    message : string

(** Everything one module's annotations said. *)
type Readings =
    definitions : List<Definition>
    annotations : List<int>

(** The index of the operator a compound argument splits at. *)
type Split = SplitAt int | NotSplit

(** The text inside a fully parenthesised argument. *)
type Inner = Enclosed string | Bare

(** Where the operators of an argument were last seen at depth zero. *)
type Scan =
    plusMinus : int
    star : int

(** The corner products of a multiplication that did not overflow. *)
type Corners = Present List<int> | Missing

(** A parsed annotation line. *)
type MaybeAnnotation = IsAnnotation Annotation | NotAnnotation

(** A call argument with its position in the argument list. *)
type Indexed =
    at : int
    text : string

(** One request line of the checker protocol, decoded. *)
type Request =
    version : int
    path : string
    source : string
    cache : string
    compiler : string

(** A decoded request, or a line that is not one. *)
type Decoded = Parsed Request | NotRequest

(** The compiler's answer, or its refusal, for the erased module. *)
type Outcome = Signed string | Unsigned string

(** Inclusive integer intervals, each operation refusing to invent a bound. *)
module Bounds
    (** The interval of one integer literal. *)
    export literal n = Bound(lo = n, hi = n)

    (** Whether `inner` lies entirely inside `outer`, endpoints included. *)
    export covers (outer, inner) = inner.lo >= outer.lo && inner.hi <= outer.hi

    (** The interval as the diagnostics and the tests spell it. *)
    export written (bound) = "[" + toString bound.lo + ", " + toString bound.hi + "]"

    (** The interval of `a + b`, or none when an endpoint overflows. *)
    export add (a, b) = span (checkedAdd (a.lo, b.lo), checkedAdd (a.hi, b.hi))

    (** The interval of `a - b`, or none when an endpoint overflows. *)
    export subtract (a, b) = span (checkedSub (a.lo, b.hi), checkedSub (a.hi, b.lo))

    (** The interval of `a * b`, the hull of its four corner products. *)
    export multiply (a, b) =
        corners = [
            checkedMul (a.lo, b.lo),
            checkedMul (a.lo, b.hi),
            checkedMul (a.hi, b.lo),
            checkedMul (a.hi, b.hi)]
        match numbers corners
            Present products => Known (Bound(lo = lowest products, hi = highest products))
            Missing => Unknown

    span (low, high) = match low
        Success bottom => match high
            Success top => Known (Bound(lo = bottom, hi = top))
            Error _ => Unknown
        Error _ => Unknown

    numbers (results) = foldList (results, Present [], absorb)

    absorb (found, result) = match found
        Present values => match result
            Success value => Present (listAppend (values, value))
            Error _ => Missing
        Missing => Missing

    lowest (values) = foldList (values, head (values), lowerOf)

    highest (values) = foldList (values, head (values), higherOf)

    lowerOf (low, value) = match value < low
        true => value
        false => low

    higherOf (high, value) = match value > high
        true => value
        false => high

    head (values) = match values
        [] => 0
        [first, ...rest] => first

(** Single characters of a source line, as the textual scan sees them. *)
module Chars
    (** The character at `index`, or `""` past the end of the line. *)
    export at (text, index) = substring (text, index, index + 1) ?: ""

    (** Whether `char` is one character of an identifier or a number. *)
    export identifier char = match isEmpty char
        true => false
        false => contains (identifierCharacters, char)

    (** Whether `char` is a space or a tab. *)
    export blank char = char == " " || char == "\t"

    (** The index of the first character from `index` that is not blank. *)
    export spaced (text, index) = match blank (at (text, index))
        true => spaced (text, index + 1)
        false => index

    (** The column the line's first non-blank character sits at. *)
    export indent text = spaced (text, 0)

(** The interval of one call argument, read as the text it is written as. *)
module Intervals
    (** The interval of `text`, relative to the caller's parameter bounds. *)
    export at (bounds, text) = intervalOf (bounds, trim text)

    intervalOf (bounds, text) = match enclosed text
        Enclosed inner => intervalOf (bounds, trim inner)
        Bare => leaf (bounds, text)

    leaf (bounds, text) = match parseInt text
        Success number => Known (Bounds::literal number)
        Error _ => match mapGet (bounds, text)
            Success bound => Known bound
            Error _ => compound (bounds, text)

    compound (bounds, text) = match lastOperator text
        SplitAt index => combine (bounds, index, text)
        NotSplit => Unknown

    enclosed text = match startsWith text "(" && matching (text, 0, 0) == length text - 1
        true => Enclosed (substring (text, 1, length text - 1) ?: text)
        false => Bare

    combine (bounds, index, text) =
        left = at (bounds, substring (text, 0, index) ?: "")
        right = at (bounds, substring (text, index + 1, length text) ?: "")
        match Chars::at (text, index)
            "+" => summed (left, right)
            "-" => subtracted (left, right)
            _ => multiplied (left, right)

    summed (left, right) = paired (left, right, Bounds::add)

    subtracted (left, right) = paired (left, right, Bounds::subtract)

    multiplied (left, right) = paired (left, right, Bounds::multiply)

    paired (left, right, operation) = match left
        Known first => match right
            Known second => operation (first, second)
            Unknown => Unknown
        Unknown => Unknown

    (** The index closing the parenthesis opened at `index`, or `-1`. *)
    export matching (text, index, depth) = match index >= length text
        true => -1
        false => match Chars::at (text, index)
            "(" => matching (text, index + 1, depth + 1)
            ")" => closed (text, index, depth)
            _ => matching (text, index + 1, depth)

    closed (text, index, depth) = match depth == 1
        true => index
        false => matching (text, index + 1, depth - 1)

    lastOperator text = choose (scan (text, 0, 0, Scan(plusMinus = -1, star = -1)))

    choose (seen) = match seen.plusMinus >= 0
        true => SplitAt seen.plusMinus
        false => match seen.star >= 0
            true => SplitAt seen.star
            false => NotSplit

    scan (text, index, depth, seen) = match index >= length text
        true => seen
        false => read (text, index, depth, seen, Chars::at (text, index))

    read (text, index, depth, seen, char) = match char
        "(" => scan (text, index + 1, depth + 1, seen)
        ")" => scan (text, index + 1, depth - 1, seen)
        "+" => noticed (text, index, depth, seen, seen(plusMinus = index))
        "-" => noticed (text, index, depth, seen, signed (text, index, seen))
        "*" => noticed (text, index, depth, seen, seen(star = index))
        _ => scan (text, index + 1, depth, seen)

    noticed (text, index, depth, seen, updated) = match depth == 0
        true => scan (text, index + 1, depth, updated)
        false => scan (text, index + 1, depth, seen)

    signed (text, index, seen) = match binary (text, index - 1)
        true => seen(plusMinus = index)
        false => seen

    binary (text, index) = match index < 0
        true => false
        false => match Chars::at (text, index)
            "," => false
            "(" => false
            "+" => false
            "-" => false
            "*" => false
            char => match Chars::blank char
                true => binary (text, index - 1)
                false => true

(** The comma separated argument list of one call, at the call's own depth. *)
module Arguments
    (** The arguments of the text between a call's parentheses. *)
    export at text = match isEmpty (trim text)
        true => []
        false => cut (text, 0, 0, 0, [])

    cut (text, index, depth, start, parts) = match index >= length text
        true => listAppend (parts, trim (substring (text, start, length text) ?: ""))
        false => step (text, index, depth, start, parts, Chars::at (text, index))

    step (text, index, depth, start, parts, char) = match char
        "(" => cut (text, index + 1, depth + 1, start, parts)
        ")" => cut (text, index + 1, depth - 1, start, parts)
        "," => division (text, index, depth, start, parts)
        _ => cut (text, index + 1, depth, start, parts)

    division (text, index, depth, start, parts) = match depth == 0
        true => cut (text, index + 1, depth, index + 1, listAppend (parts, trim (substring (text, start, index) ?: "")))
        false => cut (text, index + 1, depth, start, parts)

(** Reading `// @bound` annotations and the definition lines they precede. *)
module Annotations
    (** The annotation on `text`, when the line is one. *)
    export of text = match startsWith (trim text) annotationPrefix
        true => parse (drop (trim text, length annotationPrefix))
        false => NotAnnotation

    (** The function declaration on `text`, when the line is one. *)
    export definitionOf text = declared (Chars::indent text, drop (text, Chars::indent text))

    (** Every definition of the module and the lines that annotated them. *)
    export collect source = gathered (lines source, 1, [], [], [])

    parse (text) = match split (text, annotationJoin)
        Success parts => withInterval parts
        Error _ => NotAnnotation

    withInterval (parts) = match parts
        [param, range] => ranged (param, range)
        _ => NotAnnotation

    ranged (param, range) = match split (range, rangeJoin)
        Success bounds => withNumbers (param, bounds)
        Error _ => NotAnnotation

    withNumbers (param, bounds) = match bounds
        [lo, hi] => measured (param, lo, hi)
        _ => NotAnnotation

    measured (param, lo, hi) = match parseInt (trim lo)
        Error _ => NotAnnotation
        Success low => match parseInt (trim hi)
            Error _ => NotAnnotation
            Success high => formed (param, Bound(lo = low, hi = high))

    formed (param, bound) = match isEmpty (trim param) || bound.lo > bound.hi
        true => NotAnnotation
        false => IsAnnotation (Annotation(param = trim param, bound = bound))

    declared (indent, leading) = match startsWith leading exportPrefix
        true => headered (indent, indent + length exportPrefix, drop (leading, length exportPrefix))
        false => headered (indent, indent, leading)

    headered (indent, at, body) = described (indent, at, body, word (body, 0))

    described (indent, at, body, name) = match isEmpty name
        true => NotHeader
        false => shaped (Header(name = name, indent = indent, at = at, params = []), trimStart (drop (body, length name)))

    shaped (header, rest) = match startsWith rest "("
        true => flat (header, rest)
        false => curried (header, rest)

    flat (header, rest) = closed (header, rest, Intervals::matching (rest, 0, 0))

    closed (header, rest, close) = match close < 0
        true => NotHeader
        false => assigned (header(params = Arguments::at (substring (rest, 1, close) ?: "")), drop (rest, close + 1))

    curried (header, rest) = match indexOf rest "="
        Error _ => NotHeader
        Success position => withParameters (header, words (substring (rest, 0, position) ?: ""), rest)

    withParameters (header, params, rest) = match isEmpty params
        true => NotHeader
        false => assigned (header(params = params), rest)

    assigned (header, rest) = match contains rest "="
        true => IsHeader header
        false => NotHeader

    word (text, index) = match Chars::identifier (Chars::at (text, index))
        true => Chars::at (text, index) + word (text, index + 1)
        false => ""

    gathered (lines, number, pending, definitions, marks) = match lines
        [] => Readings(definitions = definitions, annotations = marks)
        [text, ...rest] => annotated (text, rest, number, pending, definitions, marks)

    annotated (text, rest, number, pending, definitions, marks) = match definitionOf text
        IsHeader header => gathered (rest, number + 1, [], listAppend (definitions, defined (header, number, pending)), marks)
        NotHeader => comment (text, rest, number, pending, definitions, marks)

    comment (text, rest, number, pending, definitions, marks) = match of text
        IsAnnotation annotation => gathered (rest, number + 1, listAppend (pending, annotation), definitions, listAppend (marks, number))
        NotAnnotation => gathered (rest, number + 1, pending, definitions, marks)

    defined (header, number, pending) =
        Definition(header = header, line = number, bounds = boundMap pending)

    boundMap (annotations) = foldList (annotations, [=>], addBound)

    addBound (bounds, annotation) = mapSet (bounds, annotation.param, annotation.bound)

(** Every call site of one module checked against the bounds it declares. *)
module Calls
    (** The call sites `definitions` cannot accept, in source order. *)
    export violations (definitions, source) =
        bounded = filterList (definitions, hasBound)
        gathered (definitions, bounded, numbered (lines source, 1), [])

    hasBound definition = !isEmpty definition.bounds

    numbered (lines, number) = match lines
        [] => []
        [text, ...rest] => listPrepend (numbered (rest, number + 1), Line(number = number, indent = Chars::indent text, text = text))

    gathered (definitions, bounded, lines, found) = match lines
        [] => found
        [line, ...rest] => gathered (definitions, bounded, rest, listConcat (found, onLine (definitions, bounded, line)))

    onLine (definitions, bounded, line) = foldList (bounded, [], \(found, called) => listConcat (found, ofCall (definitions, line, called)))

    ofCall (definitions, line, called) =
        caller = callerOf (definitions, line)
        positions = occurrences (line.text, called.header.name, skipped (definitions, line, called))
        foldList (positions, [], \(found, position) => listConcat (found, atPosition (line, position, called, caller)))

    callerOf (definitions, line) = match onLineNumber (definitions, line.number)
        Located definition => definition
        NotFound => enclosing (definitions, line)

    onLineNumber (definitions, number) = foldList (definitions, NotFound, \(found, definition) => sameLine (found, definition, number))

    sameLine (found, definition, number) = match definition.line == number
        true => Located definition
        false => found

    enclosing (definitions, line) = foldList (definitions, none (), \(best, definition) => deeper (best, definition, line))

    deeper (best, candidate, line) = match candidate.line < line.number && candidate.header.indent < line.indent
        true => candidate
        false => best

    none () = Definition(header = Header(name = "", indent = -1, at = 0, params = []), line = 0, bounds = [=>])

    skipped (definitions, line, called) = match onLineNumber (definitions, line.number)
        Located definition => declarationName (definition.header, called.header.name)
        NotFound => 0

    declarationName (header, name) = match header.name == name
        true => header.at + length name
        false => 0

    occurrences (text, name, from) = match indexOf (drop (text, from), name)
        Error _ => []
        Success offset => visit (text, name, from + offset)

    visit (text, name, position) = match wholeWord (text, name, position)
        true => listPrepend (occurrences (text, name, position + length name), position)
        false => occurrences (text, name, position + 1)

    wholeWord (text, name, position) =
        edgeBefore (text, position) && edgeAfter (text, position + length name)

    edgeBefore (text, position) = match position <= 0
        true => true
        false => !Chars::identifier (Chars::at (text, position - 1))

    edgeAfter (text, end) = match end >= length text
        true => true
        false => !Chars::identifier (Chars::at (text, end))

    atPosition (line, position, called, caller) =
        head = Chars::spaced (line.text, position + length called.header.name)
        match Chars::at (line.text, head)
            "(" => parenthesised (line, position, called, caller, head)
            _ => juxtaposed (line, position, called, caller, head)

    parenthesised (line, position, called, caller, open) =
        closed (line, position, called, caller, open, Intervals::matching (line.text, open, 0))

    closed (line, position, called, caller, open, close) = match close < 0
        true => [arity (called, line, position, [])]
        false => judged (line, position, called, caller, Arguments::at (substring (line.text, open + 1, close) ?: ""))

    judged (line, position, called, caller, args) = match listLength args == listLength called.header.params
        true => argumentChecks (line, position, called, caller, args)
        false => [arity (called, line, position, args)]

    argumentChecks (line, position, called, caller, args) =
        indexed = index (args, 0)
        foldList (indexed, [], \(found, one) => listConcat (found, checkArgument (line, position, called, caller, one)))

    juxtaposed (line, position, called, caller, head) = match listLength called.header.params == 1
        true => argumentChecks (line, position, called, caller, [atom (line.text, head)])
        false => [arity (called, line, position, [atom (line.text, head)])]

    atom (text, from) = match Chars::at (text, from) == "-"
        true => "-" + token (text, from + 1, "")
        false => token (text, from, "")

    token (text, index, acc) = match Chars::identifier (Chars::at (text, index))
        true => token (text, index + 1, acc + Chars::at (text, index))
        false => acc

    index (args, from) = match args
        [] => []
        [text, ...rest] => listPrepend (index (rest, from + 1), Indexed(at = from, text = text))

    checkArgument (line, position, called, caller, one) = match listGet (called.header.params, one.at)
        Error _ => []
        Success param => match mapGet (called.bounds, param)
            Error _ => []
            Success bound => compare (line, position, called, caller, param, bound, Intervals::at (caller.bounds, one.text), one.text)

    compare (line, position, called, caller, param, bound, interval, one) = match interval
        Unknown => [unknownArgument (line, position, called, one)]
        Known actual => match Bounds::covers (bound, actual)
            true => []
            false => [rangeArgument (line, position, called, param, bound, actual)]

    unknownArgument (line, position, called, text) =
        Problem(code = codeUnknown, line = line.number, column = position,
            message = "argument `" + text + "` to `" + called.header.name + "` has no bound")

    rangeArgument (line, position, called, param, bound, actual) =
        Problem(code = codeRange, line = line.number, column = position,
            message = "argument `" + param + "` to `" + called.header.name + "` is in " + Bounds::written actual + ", outside " + Bounds::written bound)

    arity (called, line, position, args) =
        Problem(code = codeUnknown, line = line.number, column = position,
            message = "call to `" + called.header.name + "` passes " + toString (listLength args) + " arguments where it bounds " + toString (listLength called.header.params) + " parameters")

(** The erased module of [TYPES-DISCIPLINE-SEAM]: the source the HM pipeline
    receives in place of the disciplined module. *)
module Erasure
    (** `source` without its annotation lines, marked as the identity discipline. *)
    export of (source, marks) = join (kept (lines source, marks, 1, []), "\n") + "\n"

    kept (lines, marks, number, acc) = match lines
        [] => acc
        [text, ...rest] => match listContains (marks, number)
            true => kept (rest, marks, number + 1, acc)
            false => kept (rest, marks, number + 1, listAppend (acc, rewritten text))

    rewritten (text) = match startsWith (trim text) markerPrefix
        true => indented (Chars::indent text) + hmMarker
        false => text

    indented (count) = repeat (" ", count) ?: ""

(** The one JSON line [TYPES-DISCIPLINE-PROTOCOL] answers with. *)
module Replies
    (** An accepted module with its export signature and its erased source. *)
    export accepted (version, sig, erased) = encoded (JsonObject [
        versionJson version,
        member ("result", JsonString "accepted"),
        member ("signature", JsonString sig),
        member ("erased", erasedJson erased),
        member ("diagnostics", JsonArray [])])

    (** One rejected call site or more. *)
    export rejected (version, problems) = encoded (JsonObject [
        versionJson version,
        member ("result", JsonString "rejected"),
        member ("diagnostics", JsonArray (mapList (problems, described)))])

    (** A rejection with no source line: a failure of the checker itself. *)
    export failure (version, code, message) =
        rejected (version, [Problem(code = code, line = 0, column = 0, message = message)])

    encoded (document) = jsonEncode document ?: fallback

    erasedJson (source) = JsonObject [member ("flavor", JsonString "ml"), member ("source", JsonString source)]

    described (problem) = match problem.line == 0
        true => JsonObject [codeJson problem, severity (), member ("message", JsonString problem.message)]
        false => JsonObject [codeJson problem, severity (), member ("line", JsonInt problem.line), member ("column", JsonInt problem.column), member ("message", JsonString problem.message)]

    codeJson (problem) = member ("code", JsonString problem.code)

    severity () = member ("severity", JsonString severityError)

    versionJson (version) = member ("version", JsonInt version)

    member (name, value) = JsonMember(name, value)

(** The export signature of the erased module, from the compiler that will
    check it: an erased module must satisfy the signature it was given. *)
module Signature
    (** The compiler's signature for `erased`, or the diagnostic it refused it with. *)
    export of (request, erased) = match writeFile (modulePath request, erased)
        Error message => Unsigned ("writeFile: " + message)
        Success _ => compiled request

    modulePath (request) = request.cache + "/bounded-" + stem request.path

    signaturePath (request) = modulePath request + ".signature"

    stderrPath (request) = modulePath request + ".stderr"

    compiled (request) = match spawnProcess (command request, ignoreEvent)
        Error message => Unsigned ("spawnProcess: " + message)
        Success process => awaited (request, process)

    command (request) = quote request.compiler + " " + quote (modulePath request) + " --signature > " + quote (signaturePath request) + " 2> " + quote (stderrPath request)

    awaited (request, process) =
        code = awaitProcess process
        cleanupProcess process
        verdict (code, readFile (signaturePath request) ?: "", readFile (stderrPath request) ?: "")

    verdict (code, sig, reported) = match code == 0 && !isEmpty (trim sig)
        true => Signed sig
        false => Unsigned (reportedText reported)

    reportedText (reported) = match isEmpty (trim reported)
        true => "the compiler wrote no diagnostic"
        false => trim reported

    stem (path) = afterLast (path, 0, 0)

    afterLast (path, index, start) = match index >= length path
        true => substring (path, start, length path) ?: "module"
        false => stepped (path, index, start, Chars::at (path, index))

    stepped (path, index, start, char) = match char == "/"
        true => afterLast (path, index + 1, index + 1)
        false => afterLast (path, index + 1, start)

    quote (text) = "'" + escaped text + "'"

    escaped (text) = replace (text, "'", "'\\''") ?: text

    ignoreEvent (id, kind, data) = cleanupProcess 0

(** The checker program of [TYPES-DISCIPLINE-PROTOCOL]. *)
module Checker
    (** Answer the one request line [TYPES-DISCIPLINE-PROTOCOL] writes to
        standard input. With no line at all — somebody running the built
        checker by hand — the program prints nothing and exits cleanly. *)
    export run () =
        handle Arith
            overflow _ _ _ wrapped => wrapped
            divideByZero _ _ => 0.0
            remainderByZero _ => 0
        line = input ()
        match isEmpty line
            true => nothing ()
            false => print (answer line)

    nothing () = cleanupProcess 0

    answer (line) = match decoded line
        Parsed request => inspect request
        NotRequest => Replies::failure (protocolVersion, codeInternal, "the request line is not one JSON object of the checker protocol")

    decoded (line) = match jsonDecode line
        Error _ => NotRequest
        Success document => requestOf document

    requestOf (document) =
        version = jsonInt (field (document, "version")) ?: 0
        source = textIn (document, "module", "source")
        cache = textIn (document, "options", "cache_dir")
        compiler = textIn (document, "options", "compiler")
        match version > 0 && !isEmpty source && !isEmpty cache && !isEmpty compiler
            true => Parsed (Request(version = version, path = textIn (document, "module", "path"), source = source, cache = cache, compiler = compiler))
            false => NotRequest

    textIn (document, section, key) = jsonText (field (field (document, section), key)) ?: ""

    field (json, name) = jsonField (json, name) ?: JsonNull

    inspect (request) =
        readings = Annotations::collect request.source
        problems = Calls::violations (readings.definitions, request.source)
        match problems
            [] => accept (request, readings)
            _ => Replies::rejected (request.version, problems)

    accept (request, readings) =
        erased = Erasure::of (request.source, readings.annotations)
        match Signature::of (request, erased)
            Signed sig => Replies::accepted (request.version, sig, erased)
            Unsigned message => Replies::failure (request.version, codeCheck, "the erased module did not pass the compiler: " + message)

Checker::run ()
