// The casting player end to end ([UI-MACHINE], [UI-MACHINE-TEST], [CAST-DESIGN-STATE]): the real
// machine document, the real adapter and the real @osprey/chromecast port, driven through the
// framework's resident start/dispatch boundary with host-shaped events, against an in-memory Cast
// device: a handler for the port's `Wire` effect that reads every frame the sender writes and
// answers as a Default Media Receiver does, so nothing touches the network.

import ui::Doc
import ui::Runtime
import casting::App
import chromecast::Protocol

// ---- the device ----

(** The in-memory device: bytes queued for the sender, the message types it heard, its last read's status, its player and whether it can be reached. *)
type Fake =
    fakeInbox : string
    fakeSaid : string
    fakeOut : string
    fakeRead : int
    fakePosition : float
    fakeVolume : float
    fakeRate : float
    fakePlaying : string
    fakeReason : string
    fakeReachable : bool

(** What the test last saw: the envelope, the root region's node and revision, the host clock and the browse text the host returns. *)
type Sight =
    sightEnvelope : Json
    sightRoot : Json
    sightRevision : int
    sightNow : int
    sightBrowse : string

(** Changes the bench: the device, the sight and the kept session; only these arms write the cells. *)
effect Bench
    rig : Fake => Unit
    see : Sight => Unit
    keep : ui::Session<casting::Store> => Unit

fresh () = Fake(fakeInbox = "", fakeSaid = "", fakeOut = "", fakeRead = 0, fakePosition = 0.0, fakeVolume = 1.0, fakeRate = 1.0, fakePlaying = "IDLE", fakeReason = "", fakeReachable = true)

browse = "Living\\032Room\\032TV._googlecast._tcp SRV 0 0 8009 living-room.local. ;\nLiving\\032Room\\032TV._googlecast._tcp TXT \"id=1\" \"fn=Living Room TV\"\nKitchen._googlecast._tcp SRV 0 0 8009 kitchen.local. ;\nKitchen._googlecast._tcp TXT \"fn=Kitchen\"\n"

mut fake = fresh ()
mut sight = Sight(sightEnvelope = JsonNull, sightRoot = JsonNull, sightRevision = 0, sightNow = 1, sightBrowse = browse)
mut live = Runtime::idle (casting::Link::store (ui::Machines::faulty ""))

framed (ns, json) = Protocol::frame ("receiver-0", ns, json)

queued (f, hex) = f(fakeInbox = "${f.fakeInbox}${hex}")

idleReason f = match f.fakeReason == ""
    true => ""
    false => ",\"idleReason\":\"${f.fakeReason}\""

mediaStatus f = "{\"type\":\"MEDIA_STATUS\",\"requestId\":0,\"status\":[{\"mediaSessionId\":1,\"playerState\":\"${f.fakePlaying}\"${idleReason f},\"currentTime\":${toString f.fakePosition},\"playbackRate\":${toString f.fakeRate},\"supportedMediaCommands\":15,\"media\":{\"duration\":200.0}}]}"

receiverStatus f = "{\"type\":\"RECEIVER_STATUS\",\"requestId\":1,\"status\":{\"applications\":[{\"appId\":\"CC1AD845\",\"sessionId\":\"S-1\",\"transportId\":\"web-7\"}],\"volume\":{\"level\":${toString f.fakeVolume},\"muted\":false}}}"

// The device moves to `next` and reports its media status.
becomes (f, next) =
    moved = f(fakePlaying = next)
    queued (moved, framed ("media", mediaStatus moved))

answer (f, kind, doc) = match kind
    "LAUNCH" => queued (f, framed ("receiver", receiverStatus f))
    "LOAD" => becomes (becomes (f, "BUFFERING"), "PLAYING")
    "PAUSE" => becomes (f, "PAUSED")
    "PLAY" => becomes (f, "PLAYING")
    "SEEK" => becomes (f(fakePosition = Doc::decimal (doc, "currentTime")), f.fakePlaying)
    "SET_PLAYBACK_RATE" => becomes (f(fakeRate = Doc::decimal (doc, "playbackRate")), f.fakePlaying)
    "SET_VOLUME" =>
        turned = f(fakeVolume = Doc::decimal (Doc::field (doc, "volume"), "level"))
        queued (turned, framed ("receiver", receiverStatus turned))
    "STOP" => becomes (f(fakeReason = "CANCELLED"), "IDLE")
    "PING" => queued (f, framed ("tp.heartbeat", "{\"type\":\"PONG\"}"))
    _ => f

// The device hears one frame the sender wrote and queues its answer.
heard (f, hex) =
    doc = Doc::parse (Protocol::parse (drop hex 8)).payload
    kind = Doc::text (doc, "type")
    answer (f(fakeSaid = "${f.fakeSaid}${kind} "), kind, doc)

// The device hands over `count` queued bytes, or times out when fewer are queued.
taken (f, count) = match length f.fakeInbox >= count * 2
    true => f(fakeOut = take f.fakeInbox (count * 2), fakeInbox = drop f.fakeInbox (count * 2), fakeRead = 0)
    false => f(fakeOut = "", fakeRead = 1)

dialed f = match f.fakeReachable
    true => 7
    false => 0 - 4

// Every `Wire` operation is answered by the device in the `fake` cell.
onDevice work =
    handle chromecast::Wire::Wire
        dial _ _ _ => dialed fake
        write _ hex =>
            fake := heard (fake, hex)
            0
        read _ count _ =>
            fake := taken (fake, count)
            fake.fakeOut
        status _ => fake.fakeRead
        close _ => 0
        route _ => "192.168.1.20"
        serve _ _ _ => 5123
        unserve _ => 0
    work ()

(** The message types the sender wrote, space-separated, in order. *)
heardTypes () = fake.fakeSaid

reset () =
    perform Bench.rig (fresh ())
    perform Bench.see (sight(sightBrowse = browse, sightRoot = JsonNull, sightRevision = 0))

unplug () = perform Bench.rig (fake(fakeReachable = false))

finishTrack () = perform Bench.rig (becomes (fake(fakeReason = "FINISHED", fakePosition = 200.0), "IDLE"))

browsing text = perform Bench.see (sight(sightBrowse = text))

// ---- the session ----

latest (s, patch) = match Doc::text (patch, "key") == "root"
    true => s(sightRoot = Doc::field (patch, "node"), sightRevision = Doc::number (patch, "revision"))
    false => s

kept (resident : ui::Resident<casting::Store>) =
    perform Bench.keep resident.residentSession
    envelope = Doc::parse resident.residentEnvelope
    perform Bench.see (foldList (Doc::items (Doc::field (envelope, "patches")), sight(sightEnvelope = envelope, sightNow = sight.sightNow + 1), \(s, patch) => latest (s, patch)))

// Every host-side effect a session needs: the Cast device, host-held slices and the scene stream.
hosted work =
    handle ui::Slices
        fetch _ => sight.sightBrowse
    handle ui::SceneStream
        shape _ => 0
    onDevice work

(** Runs one test body on the bench, whose arms are the only writers of the cells. *)
bench work =
    handle Bench
        rig f => fake := f
        see s => sight := s
        keep session => live := session
    casting::Link::guarded work

started () =
    reset ()
    hosted (\() => kept (Runtime::begin ("{\"now\":1,\"offset\":0,\"platform\":\"macos\",\"arguments\":[\"--skin\",\"midnight\"]}", App::initial, App::regions, App::theme ())))

post event = hosted (\() => kept (Runtime::proceed (live, event, App::update, App::regions)))

// ---- reading the rendered view ----

walked (out, doc) = match doc
    JsonObject members => foldList (members, listAppend out doc, \(acc, m) => member (acc, m))
    JsonArray items => foldList (items, out, \(acc, item) => walked (acc, item))
    _ => out

member (acc, m) = match m
    JsonMember _ value => walked (acc, value)
    _ => acc

nodes () = walked ([], sight.sightRoot)

labelled label = filterList (nodes (), \n => Doc::text (n, "label") == label || Doc::text (n, "text") == label || Doc::text (n, "title") == label)

texts () = join (filterList (mapList (nodes (), \n => "${Doc::text (n, "label")}${Doc::text (n, "text")}${Doc::text (n, "title")}"), \t => t != "")) "|"

shows label = match length (labelled label) > 0
    true => true
    false =>
        print "# not shown: ${label}; the view shows ${texts ()}"
        false

control label = listGet (labelled label) 0 ?: JsonNull

ordinal label = Doc::number (control label, "event")

enabledOf label = Doc::flag (control label, "enabled")

requested kind = length (filterList (walked ([], Doc::field (sight.sightEnvelope, "requests")), \r => Doc::text (r, "kind") == kind)) > 0

// ---- host events ----

stamp () = toString sight.sightNow

press label = post "{\"kind\":\"ui\",\"region\":\"root\",\"revision\":${toString sight.sightRevision},\"ordinal\":${toString (ordinal label)},\"value\":null,\"now\":${stamp ()}}"

choose (label, key) = post "{\"kind\":\"ui\",\"region\":\"root\",\"revision\":${toString sight.sightRevision},\"ordinal\":${toString (ordinal label)},\"value\":\"${key}\",\"now\":${stamp ()}}"

complete (ticket, result) = post "{\"kind\":\"completed\",\"ticket\":\"${ticket}\",\"ok\":true,\"result\":${result},\"now\":${stamp ()}}"

frame seconds = post "{\"kind\":\"frame\",\"elapsed\":${seconds},\"now\":${stamp ()}}"

discovered () = complete ("discover", "{\"status\":0,\"stderr\":\"\"}")

picked path = complete ("choose", "{\"path\":\"${path}\",\"cancelled\":false}")

test ("a whole cast: find TVs, open a file, play, pause, seek, change volume and speed, stop and replay", \() => bench (\() =>
    started ()
    expect (shows "Looking for TVs…", true)
    expect (shows "Choose an audio file", true)
    expect (requested "run", true)
    expect (requested "animate", true)
    discovered ()
    expect (shows "Receiver", true)
    expect (Doc::text (control "Receiver", "selected"), "Living Room TV")
    expect (length (Doc::items (Doc::field (control "Receiver", "choices"))), 2)
    expect (enabledOf "Play", false)
    press "Open file…"
    expect (requested "choose-file", true)
    picked "/music/Sunroom.mp3"
    expect (shows "Sunroom", true)
    expect (enabledOf "Play", true)
    press "Play"
    expect (heardTypes (), "CONNECT LAUNCH ")
    expect (shows "Connecting to Living Room TV…", true)
    frame "0.2"
    expect (heardTypes (), "CONNECT LAUNCH CONNECT LOAD ")
    frame "0.2"
    expect (shows "Playing on Living Room TV", true)
    expect (shows "Pause", true)
    expect (shows "03:20", true)
    expect (enabledOf "Back 10 seconds", true)
    press "Pause"
    frame "0.2"
    expect (shows "Paused", true)
    expect (shows "Resume", true)
    press "Resume"
    frame "0.2"
    expect (shows "Playing on Living Room TV", true)
    press "Forward 10 seconds"
    frame "0.2"
    expect (shows "00:10", true)
    choose ("Volume 100%", "0.5")
    frame "0.2"
    expect (shows "Volume 50%", true)
    choose ("Speed", "1.5")
    frame "0.2"
    expect (Doc::text (control "Speed", "selected"), "1.5")
    expect (heardTypes (), "CONNECT LAUNCH CONNECT LOAD PAUSE PLAY SEEK SET_VOLUME SET_PLAYBACK_RATE ")
    press "Stop"
    frame "0.2"
    expect (shows "Finished", true)
    expect (shows "Play", true)
    press "Play"
    frame "0.2"
    frame "0.2"
    expect (shows "Playing on Living Room TV", true)
    finishTrack ()
    frame "0.2"
    expect (shows "Finished", true)))

test ("skins change the palette, never the controls", \() => bench (\() =>
    started ()
    discovered ()
    choose ("Skin", "midnight")
    expect (Doc::text (control "Skin", "selected"), "midnight")
    expect (shows "Open file…", true)
    choose ("Skin", "poolside")
    expect (Doc::text (control "Skin", "selected"), "poolside")))

test ("no TVs found offers another search, and an unreachable TV shows why", \() => bench (\() =>
    started ()
    browsing ""
    discovered ()
    expect (shows "No TVs found", true)
    browsing browse
    press "Search again"
    expect (shows "Looking for TVs…", true)
    discovered ()
    picked "/music/Sunroom.mp3"
    unplug ()
    press "Play"
    expect (shows "living-room.local:8009: connection refused or timed out", true)
    expect (shows "Play", true)
    expect (length (filterList (nodes (), \n => Doc::text (n, "tone") == "danger")), 1)))
