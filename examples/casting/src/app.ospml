// The casting player's application callbacks ([UI-MACHINE], [UI-STORE]): the
// interface is examples/casting/player.machine.json, rendered by
// `ui::Templates`; this module routes framework messages to the machine and
// the adapter.
namespace casting

import ui::Runtime
import ui::Requests
import ui::Messages
import ui::Machines
import ui::Templates
import ui::Keyed
import casting::Link

(** The application exported through the two-function C boundary. *)
module App
    (** The document the interface is read from: `--machine <path>` among the launch arguments, else the repository copy. *)
    export documentPath arguments =
        at = ui::Lists::position (arguments, \a => a == "--machine")
        ui::Pick::either (at >= 0, listGet arguments (satAdd at 1) ?: "", "examples/casting/player.machine.json")

    (** The store from a machine document's text: a refused document shows its problems in place of the player. *)
    export loaded source = match Machines::load source
        Success machine => Link::store machine
        Error problem => Link::store (Machines::faulty problem)

    (** Loads the document, starts the frame clock and answers the requests of the initial states. *)
    export initial context =
        first = Link::settled (loaded (readFile (documentPath context.arguments) ?: ""))
        Runtime::asking (first.stepStore, listAppend first.requests (Requests::ask ("clock", ui::Animate(animated = true))))

    (** Routes every framework message: controls pull the machine's levers, completions and frames go to the adapter. *)
    export update (_, store, message) = Messages::route (message, \lever => Link::pulled (store, lever, JsonNull), \(lever, text) => Link::pulled (store, lever, JsonString text), \(lever, on) => Link::pulled (store, lever, JsonBool on), \(_, _) => Runtime::step store, \(ticket, outcome) => Link::completed (store, ticket, outcome), \_ => Runtime::step store, \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \seconds => Link::ticked (store, seconds), \(_, _) => Runtime::step store)

    screenSlice () = perform Signal<Screen>.read ()

    (** The whole player: the machine's view in its chosen skin. *)
    export root () = Templates::view (screenSlice ()).screenMachine

    (** Rebuilds the player whenever the machine changes. *)
    export regions (before, store, frames, _) =
        handle static Signal<Screen>
            read => store.screen
        changed = signalChanges before.screen store.screen (\s => Machines::encode s.screenMachine) (signalDependencies screenSlice)
        [Keyed::region (frames, "root", changed, root)]

    (** The first skin's colours; a skin change re-themes the view in place. *)
    export theme () = Templates::theme (Machines::faulty "")
