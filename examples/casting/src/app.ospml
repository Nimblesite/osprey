// The casting player's application callbacks ([UI-MACHINE], [UI-STORE]): the
// interface is examples/casting/player.machine.json, rendered by
// `ui::Templates`; this module routes framework messages to the machine and
// the adapter.
namespace casting

import ui::Runtime
import ui::Requests
import ui::Messages
import ui::MachineDocs
import ui::Values
import ui::Templates
import ui::Keyed
import casting::Link

(** The application exported through the two-function C boundary. *)
module App
    // The launch argument after `flag`, or `otherwise`.
    after (arguments, flag, otherwise) =
        at = ui::Lists::position (arguments, \a => a == flag)
        ui::Pick::either (at >= 0, listGet arguments (satAdd at 1) ?: otherwise, otherwise)

    (** The document the interface is read from: `--machine <path>` among the launch arguments, else the repository copy. *)
    export documentPath arguments = after (arguments, "--machine", "examples/casting/player.machine.json")

    // An MP3 the app was opened with: `--open <path>`, or a bare path ending in .mp3, as Finder passes one.
    opened arguments = after (arguments, "--open", (listGet (filterList (arguments, \a => endsWith (toLowerCase a) ".mp3")) 0) ?: "")

    (** The store from a machine document's text: a refused document shows its problems in place of the player. *)
    export loaded source = match MachineDocs::load source
        Success machine => Link::store machine
        Error problem => Link::store (MachineDocs::faulty problem)

    // The folder the document sits in, where its canvas artwork lives.
    folder path =
        parts = split path "/" ?: [path]
        join (ui::Lists::slice (parts, 0, satSub (length parts) 1)) "/"

    (** Loads the document, applies `--skin` and an opened MP3, starts the frame clock and answers the initial states' requests. *)
    export initial context =
        path = documentPath context.arguments
        launched = Link::launched (loaded (readFile path ?: ""), folder path, after (context.arguments, "--skin", ""), opened context.arguments)
        first = Link::settled launched
        Runtime::asking (first.stepStore, listAppend first.requests (Requests::ask ("clock", ui::Animate(animated = true))))

    (** Routes every framework message: controls pull the machine's levers, completions and frames go to the adapter. *)
    export update (_, store, message) = Messages::route (message, \lever => Link::pulled (store, lever, Values::none ()), \(lever, text) => Link::pulled (store, lever, Values::text text), \(lever, on) => Link::pulled (store, lever, Values::flag on), \(_, _) => Runtime::step store, \(ticket, outcome) => Link::completed (store, ticket, outcome), \phase => Link::phased (store, phase), \(_, _) => Runtime::step store, \(_, _) => Runtime::step store, \seconds => Link::ticked (store, seconds), \(_, input) => Link::pointed (store, input))

    screenSlice () = perform Signal<Screen>.read ()

    (** The whole player: the machine's view in its chosen skin. *)
    export root () = Templates::view (screenSlice ()).screenMachine

    (** Rebuilds the player whenever the machine changes. *)
    export regions (before, store, frames, _) =
        handle static Signal<Screen>
            read => store.screen
        changed = signalChanges before.screen store.screen (\s => MachineDocs::snapshot s.screenMachine) (signalDependencies screenSlice)
        [Keyed::region (frames, "root", changed, root)]

    (** The first skin's colours; a skin change re-themes the view in place. *)
    export theme () = Templates::theme (MachineDocs::faulty "")
