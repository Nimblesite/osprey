{
  "schema": 1,
  "name": "casting-player",
  "inputs": {
    "skin": { "type": "text", "value": "sherbet" },
    "skins": { "type": "list", "value": [
      { "key": "sherbet", "label": "Sherbet Signal" },
      { "key": "midnight", "label": "Midnight Mint" },
      { "key": "poolside", "label": "Poolside Pop" }
    ] },
    "receivers": { "type": "list" },
    "receiver": { "type": "text" },
    "searched": { "type": "bool" },
    "file": { "type": "text" },
    "title": { "type": "text" },
    "player": { "type": "text" },
    "connected": { "type": "bool" },
    "position": { "type": "number" },
    "duration": { "type": "number" },
    "volume": { "type": "number", "value": 1 },
    "rate": { "type": "number", "value": 1 },
    "canPause": { "type": "bool" },
    "canSeek": { "type": "bool" },
    "ended": { "type": "text" },
    "error": { "type": "text" },
    "spin": { "type": "number" },
    "skip": { "type": "number" },
    "wantVolume": { "type": "text", "value": "1" },
    "volumes": { "type": "list", "value": [
      { "key": "0", "label": "Muted" }, { "key": "0.25", "label": "25%" }, { "key": "0.5", "label": "50%" },
      { "key": "0.75", "label": "75%" }, { "key": "1", "label": "100%" }
    ] },
    "wantRate": { "type": "text", "value": "1" },
    "rates": { "type": "list", "value": [
      { "key": "0.75", "label": "0.75×" }, { "key": "1", "label": "1×" }, { "key": "1.25", "label": "1.25×" },
      { "key": "1.5", "label": "1.5×" }, { "key": "2", "label": "2×" }
    ] },
    "open": { "type": "trigger" },
    "refresh": { "type": "trigger" },
    "play": { "type": "trigger" },
    "pause": { "type": "trigger" },
    "resume": { "type": "trigger" },
    "stop": { "type": "trigger" },
    "seek": { "type": "trigger" },
    "chooseVolume": { "type": "trigger" },
    "chooseRate": { "type": "trigger" }
  },
  "layers": [
    {
      "name": "receivers",
      "initial": "searching",
      "states": {
        "searching": { "enter": [{ "request": "cast.discover" }] },
        "found": {},
        "none": {}
      },
      "transitions": [
        { "from": "searching", "to": "found", "when": { "input": "receiver", "ne": "" } },
        { "from": "searching", "to": "none", "when": { "all": [{ "input": "searched", "eq": true }, { "input": "receiver", "eq": "" }] } },
        { "from": "*", "to": "searching", "when": { "fired": "refresh" } }
      ]
    },
    {
      "name": "playback",
      "initial": "stopped",
      "states": {
        "stopped": {},
        "connecting": { "enter": [{ "request": "cast.start", "with": ["file", "receiver"] }] },
        "playing": {},
        "paused": {},
        "ended": { "enter": [{ "request": "cast.finished" }] },
        "failed": {}
      },
      "transitions": [
        { "from": "*", "to": "connecting", "when": { "all": [{ "fired": "play" }, { "input": "file", "ne": "" }, { "input": "receiver", "ne": "" }, { "state": "playback", "in": ["stopped", "ended", "failed"] }] } },
        { "from": "*", "to": "failed", "when": { "input": "error", "ne": "" } },
        { "from": "connecting", "to": "playing", "when": { "any": [{ "input": "player", "eq": "PLAYING" }, { "input": "player", "eq": "BUFFERING" }] } },
        { "from": "playing", "to": "paused", "when": { "input": "player", "eq": "PAUSED" } },
        { "from": "paused", "to": "playing", "when": { "input": "player", "eq": "PLAYING" } },
        { "from": "*", "to": "ended", "when": { "all": [{ "input": "ended", "ne": "" }, { "state": "playback", "in": ["connecting", "playing", "paused"] }] } }
      ]
    },
    {
      "name": "commands",
      "initial": "idle",
      "states": {
        "idle": {},
        "opening": { "enter": [{ "request": "cast.choose" }] },
        "pausing": { "enter": [{ "request": "cast.pause" }] },
        "resuming": { "enter": [{ "request": "cast.resume" }] },
        "stopping": { "enter": [{ "request": "cast.stop" }] },
        "seeking": { "enter": [{ "request": "cast.seek", "with": ["position", "skip"] }] },
        "turning": { "enter": [{ "request": "cast.volume", "with": ["wantVolume"] }] },
        "pacing": { "enter": [{ "request": "cast.rate", "with": ["wantRate"] }] }
      },
      "transitions": [
        { "from": "idle", "to": "opening", "when": { "fired": "open" } },
        { "from": "idle", "to": "pausing", "when": { "fired": "pause" } },
        { "from": "idle", "to": "resuming", "when": { "fired": "resume" } },
        { "from": "idle", "to": "stopping", "when": { "fired": "stop" } },
        { "from": "idle", "to": "seeking", "when": { "fired": "seek" } },
        { "from": "idle", "to": "turning", "when": { "fired": "chooseVolume" } },
        { "from": "idle", "to": "pacing", "when": { "fired": "chooseRate" } },
        { "from": "*", "to": "idle" }
      ]
    }
  ],
  "view": {
    "kind": "framed", "padding": 24, "gap": 16, "fill": "background", "ink": "text", "grow": true, "cross": "center",
    "children": [
      {
        "kind": "scene", "width": 320, "height": 180,
        "shapes": [
          { "shape": "disc", "x": 160, "y": 90, "radius": 84, "colour": "@decor1", "depth": 0 },
          { "x": 160, "y": 90, "w": 150, "h": 46, "angle": "{{spin}}", "turn": 0, "colour": "@decor2", "alpha": 0.8, "depth": 1 },
          { "x": 160, "y": 90, "w": 150, "h": 46, "angle": "{{spin}}", "turn": 1.0471975512, "colour": "@decor3", "alpha": 0.8, "depth": 1 },
          { "x": 160, "y": 90, "w": 150, "h": 46, "angle": "{{spin}}", "turn": 2.0943951024, "colour": "@decor1", "alpha": 0.6, "depth": 1 },
          { "shape": "disc", "x": 160, "y": 90, "radius": 18, "colour": "@decor2", "depth": 2 },
          { "shape": "disc", "x": 160, "y": 90, "radius": 4, "colour": "#FFFFFF", "depth": 3 }
        ]
      },
      { "kind": "text", "text": "{{title}}", "role": "title", "when": { "input": "file", "ne": "" } },
      { "kind": "empty", "symbol": "music", "text": "Choose an audio file", "detail": "Open an MP3 to cast it to a TV.", "when": { "input": "file", "eq": "" } },
      { "kind": "progress", "text": "Connecting to {{receiver}}…", "detail": "", "when": { "state": "playback", "in": ["connecting"] } },
      { "kind": "badge", "text": "Playing on {{receiver}}", "symbol": "play", "tone": "accent", "when": { "state": "playback", "in": ["playing"] } },
      { "kind": "badge", "text": "Paused", "symbol": "pause", "tone": "secondary", "when": { "state": "playback", "in": ["paused"] } },
      { "kind": "badge", "text": "Finished", "symbol": "check", "tone": "good", "when": { "state": "playback", "in": ["ended"] } },
      { "kind": "text", "text": "{{error}}", "role": "callout", "tone": "danger", "when": { "state": "playback", "in": ["failed"] } },
      {
        "kind": "stack", "axis": "horizontal",
        "children": [
          { "kind": "progress", "text": "Looking for TVs…", "detail": "", "when": { "state": "receivers", "in": ["searching"] } },
          { "kind": "picker", "text": "Receiver", "choices": "receivers", "selected": "{{receiver}}", "on": { "set": "receiver" }, "when": { "state": "receivers", "in": ["found"] } },
          { "kind": "text", "text": "No TVs found", "role": "callout", "tone": "caution", "when": { "state": "receivers", "in": ["none"] } },
          { "kind": "button", "text": "Search again", "symbol": "refresh", "on": { "set": "searched", "value": false, "fire": "refresh" }, "when": { "state": "receivers", "in": ["found", "none"] } }
        ]
      },
      {
        "kind": "stack", "axis": "horizontal", "when": { "state": "playback", "in": ["playing", "paused"] },
        "children": [
          { "kind": "text", "text": "{{position|clock}}", "role": "caption", "tone": "secondary" },
          { "kind": "meter", "text": "Position", "amount": "{{position}}", "total": "{{duration}}", "tone": "accent" },
          { "kind": "text", "text": "{{duration|clock}}", "role": "caption", "tone": "secondary" }
        ]
      },
      {
        "kind": "stack", "axis": "horizontal",
        "children": [
          { "kind": "button", "text": "Back 10 seconds", "symbol": "skip-back", "on": { "set": "skip", "value": -10, "fire": "seek" }, "enabled": { "input": "canSeek", "eq": true }, "when": { "state": "playback", "in": ["playing", "paused"] } },
          { "kind": "button", "text": "Play", "symbol": "play", "role": "prominent", "on": { "set": "error", "value": "", "fire": "play" }, "enabled": { "all": [{ "input": "file", "ne": "" }, { "input": "receiver", "ne": "" }] }, "when": { "state": "playback", "in": ["stopped", "ended", "failed"] } },
          { "kind": "button", "text": "Pause", "symbol": "pause", "role": "prominent", "on": { "fire": "pause" }, "enabled": { "input": "canPause", "eq": true }, "when": { "state": "playback", "in": ["playing"] } },
          { "kind": "button", "text": "Resume", "symbol": "play", "role": "prominent", "on": { "fire": "resume" }, "when": { "state": "playback", "in": ["paused"] } },
          { "kind": "button", "text": "Stop", "symbol": "stop", "on": { "fire": "stop" }, "when": { "state": "playback", "in": ["playing", "paused"] } },
          { "kind": "button", "text": "Forward 10 seconds", "symbol": "skip-forward", "on": { "set": "skip", "value": 10, "fire": "seek" }, "enabled": { "input": "canSeek", "eq": true }, "when": { "state": "playback", "in": ["playing", "paused"] } }
        ]
      },
      {
        "kind": "stack", "axis": "horizontal",
        "children": [
          { "kind": "picker", "text": "Volume {{volume|percent}}%", "choices": "volumes", "selected": "{{wantVolume}}", "on": { "set": "wantVolume", "fire": "chooseVolume" }, "when": { "state": "playback", "in": ["playing", "paused"] } },
          { "kind": "picker", "text": "Speed", "choices": "rates", "selected": "{{wantRate}}", "on": { "set": "wantRate", "fire": "chooseRate" }, "when": { "state": "playback", "in": ["playing", "paused"] } },
          { "kind": "button", "text": "Open file…", "symbol": "folder", "on": { "fire": "open" } }
        ]
      },
      { "kind": "picker", "text": "Skin", "choices": "skins", "selected": "{{skin}}", "on": { "set": "skin" } }
    ]
  },
  "skins": {
    "sherbet": { "name": "Sherbet Signal", "motion": "disc", "tokens": {
      "background": "#FFF8EF", "text": "#252333", "secondary": "#625968", "accent": "#A83D22",
      "good": "#2E7D4F", "caution": "#9A5B00", "danger": "#B3261E",
      "decor1": "#FFAA86", "decor2": "#D8C3EF", "decor3": "#FFE4A1" } },
    "midnight": { "name": "Midnight Mint", "motion": "disc", "tokens": {
      "background": "#10192B", "text": "#F4F7FF", "secondary": "#BAC6D9", "accent": "#A8EED4",
      "good": "#7FE0B0", "caution": "#FFC97A", "danger": "#FF8A80",
      "decor1": "#B4A5FF", "decor2": "#70B9C4", "decor3": "#A8EED4" } },
    "poolside": { "name": "Poolside Pop", "motion": "disc", "tokens": {
      "background": "#D9EEFF", "text": "#102958", "secondary": "#36557A", "accent": "#174EC6",
      "good": "#1E6B45", "caution": "#8A5300", "danger": "#B3261E",
      "decor1": "#FF7828", "decor2": "#FFD44F", "decor3": "#174EC6" } }
  }
}
