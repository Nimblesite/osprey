<?xml version="1.0" encoding="utf-8"?>
<!-- The GPUI casting host as a NativeActivity: no Java code, one shared
     library, the same view code as desktop ([CAST-MOBILE-GPUI]). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ospreylang.casting.gpui">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
  <application android:label="Casting" android:hasCode="false">
    <activity android:name="android.app.NativeActivity"
        android:label="Casting"
        android:exported="true"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode">
      <meta-data android:name="android.app.lib_name" android:value="osprey_gpui"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
