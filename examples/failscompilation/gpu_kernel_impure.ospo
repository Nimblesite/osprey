// [GPU-KERNEL-PURE], [STAGE-GPU-LEGAL]: a kernel that performs a DYNAMIC effect
// is rejected even when a handler surrounds the combinator call — handlers make
// effects dischargeable on the host, but a kernel body cannot leave the device
// to reach one. A static effect is answered before the kernel runs and stays
// legal, which is why the message names the residual row rather than purity.
effect Log {
    write: fn(string) -> Unit
}

fn loud(x) = {
    perform Log.write("saw")
    x
}

fn main() = {
    let n = handle Log
        write m => print(m)
    in toGpu([1, 2]) |> gpuMap(loud) |> gpuLength()
    print(n)
}
