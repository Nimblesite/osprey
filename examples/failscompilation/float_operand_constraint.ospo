// osprey: flavor=default
// [FLOAT-OPERANDS] Invalid calls must fail before code generation.
fn scale(x) = x * 1.5
fn divide(left, right) = left / right
let badScale = scale("text")
let badDivision = {
    handle Arith { divideByZero _ _ => 0.0 }
    divide(true, "text")
}

let absolute = abs
let badAbsolute = absolute("text")
