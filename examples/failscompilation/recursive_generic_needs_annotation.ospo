// A recursive function whose signature is not fully inferred cannot be
// specialised by inlining (the self-call would name a definition that is
// never emitted), so codegen fails closed and asks for annotations.
fn walk(xs, n) = match n {
    0 => 0
    _ => (walk(xs, (n - 1) ?: 0) + (listGet(xs, n) ?: 0)) ?: 0
}

fn main() = print("sum=${walk([5, 6, 7], 2)}")
