// [EFFECTS-RESUME] A continuation is single-shot; the second resume aborts.

effect Choose {
    pick: fn() -> int
}

fn both() -> int !Choose = {
    let x = perform Choose.pick()
    x + 1
}

let total = handle Choose
    pick => {
        let a = resume(10)
        let b = resume(20)
        a + b
    }
in both()
print("total=" + toString(total))
