// [STAGE-STATIC-FINITE] Discharge is a rewrite, so it must terminate. Two
// static handlers whose arms perform EACH OTHER's effect would be a rewrite
// that never reaches a normal form. Arms execute outside their own activation
// ([EFFECTS-STATIC-DISCHARGE]), so the outer arm cannot see the inner region
// and the cycle is cut at scoping: `Pong.back` is unhandled at program entry.
// The pass still runs on a finite fuel budget as a defensive guard.
static effect Ping {
    /// Answered by performing `Pong.back`.
    go: fn() -> int
}

static effect Pong {
    /// Answered by performing `Ping.go`, closing the cycle.
    back: fn() -> int
}

fn main() = {
    handle static Ping {
        go => perform Pong.back()
    }
    handle static Pong {
        back => perform Ping.go()
    }
    print("${perform Ping.go()}")
}
