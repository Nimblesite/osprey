{
  "name": "osprey",
  "displayName": "Osprey",
  "description": "Osprey: a safe, elegant, fast functional language with algebraic effects, inferred types and three syntax flavors. Language server, debugger, tests, profiler and bug hunting.",
  "version": "0.0.0-dev",
  "publisher": "nimblesite",
  "preview": true,
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1b3a5b",
    "theme": "dark"
  },
  "homepage": "https://ospreylang.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nimblesite/osprey.git"
  },
  "bugs": {
    "url": "https://github.com/Nimblesite/osprey/issues"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "osprey",
    "functional",
    "programming",
    "language",
    "algebraic effects",
    "effect handlers",
    "type inference",
    "llvm",
    "webassembly"
  ],
  "main": "./out/client/src/extension.js",
  "activationEvents": [
    "onDebugResolve:osprey",
    "workspaceContains:**/*.test.osp",
    "workspaceContains:**/*.test.ospml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "osprey",
        "aliases": [
          "Osprey",
          "osprey",
          "Osprey Language",
          "osp"
        ],
        "extensions": [
          ".osp"
        ],
        "filenames": [],
        "filenamePatterns": [
          "*.osp"
        ],
        "configuration": "./language-configuration/language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      },
      {
        "id": "osprey-ml",
        "aliases": [
          "Osprey ML",
          "osprey-ml"
        ],
        "extensions": [
          ".ospml"
        ],
        "filenames": [],
        "filenamePatterns": [
          "*.ospml"
        ],
        "configuration": "./language-configuration-ml.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "configurationDefaults": {
      "[osprey]": {
        "editor.defaultFormatter": "nimblesite.osprey"
      },
      "[osprey-ml]": {
        "editor.defaultFormatter": "nimblesite.osprey"
      }
    },
    "grammars": [
      {
        "language": "osprey",
        "scopeName": "source.osprey",
        "path": "./syntaxes/osprey.tmGrammar.json"
      },
      {
        "language": "osprey-ml",
        "scopeName": "source.osprey-ml",
        "path": "./syntaxes/osprey-ml.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "osprey",
        "path": "./snippets/osprey.json"
      },
      {
        "language": "osprey-ml",
        "path": "./snippets/osprey-ml.json"
      }
    ],
    "commands": [
      {
        "command": "osprey.workbench.open",
        "title": "Osprey: Open Workbench"
      },
      {
        "command": "osprey.packages.open",
        "title": "Manage Packages",
        "category": "Osprey",
        "icon": "$(package)"
      },
      {
        "command": "osprey.compile",
        "title": "Compile Osprey File",
        "category": "Osprey"
      },
      {
        "command": "osprey.run",
        "title": "Compile and Run Osprey File",
        "category": "Osprey"
      },
      {
        "command": "osprey.debug",
        "title": "Debug Osprey File",
        "category": "Osprey"
      },
      {
        "command": "osprey.hunt",
        "title": "Hunt for Bugs",
        "category": "Osprey",
        "icon": "$(bug)"
      },
      {
        "command": "osprey.setLanguage",
        "title": "Set Language to Osprey",
        "category": "Osprey"
      },
      {
        "command": "osprey.profileCurrentFile",
        "title": "Profile Current File",
        "category": "Osprey"
      },
      {
        "command": "osprey.profiler.openLast",
        "title": "Show Last Profile",
        "category": "Osprey"
      },
      {
        "command": "osprey.showTestDocumentation",
        "title": "Show Test Documentation",
        "category": "Osprey",
        "icon": "$(book)"
      },
      {
        "command": "osprey.packages.add",
        "title": "Add Package",
        "category": "Osprey",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "osprey.packages.remove",
        "title": "Remove Package",
        "category": "Osprey",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "osprey.packages.startLocalRegistry",
        "title": "Start Local Package Registry",
        "category": "Osprey",
        "icon": "$(server-process)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "osprey.packages.stopLocalRegistry",
        "title": "Stop Local Package Registry",
        "category": "Osprey",
        "icon": "$(debug-stop)"
      },
      {
        "command": "osprey.profiler.profileStart",
        "title": "Start Profiling",
        "category": "Osprey",
        "icon": "$(flame)"
      },
      {
        "command": "osprey.profiler.profileStop",
        "title": "Stop Profiling",
        "category": "Osprey",
        "icon": "$(debug-stop)"
      },
      {
        "command": "osprey.profiler.profileSnapshot",
        "title": "Take Profile Snapshot",
        "category": "Osprey",
        "icon": "$(device-camera)"
      },
      {
        "command": "osprey.profiler.profileAttachToDebug",
        "title": "Profile Debug Session",
        "category": "Osprey",
        "icon": "$(debug-alt)"
      },
      {
        "command": "osprey.profiler.profileShowResults",
        "title": "Show Profile Results",
        "category": "Osprey",
        "icon": "$(flame)"
      },
      {
        "command": "osprey.profiler.inspectVariable",
        "title": "Inspect Variable in Profiler",
        "category": "Osprey",
        "icon": "$(graph)"
      },
      {
        "command": "osprey.profiler.inspectVariableType",
        "title": "Inspect Variable Type",
        "category": "Osprey",
        "icon": "$(symbol-parameter)"
      },
      {
        "command": "osprey.profiler.watchVariable",
        "title": "Add Variable to Watch",
        "category": "Osprey",
        "icon": "$(eye)"
      },
      {
        "command": "osprey.profiler.refreshProcesses",
        "title": "Refresh Processes",
        "category": "Osprey",
        "icon": "$(refresh)"
      },
      {
        "command": "osprey.profiler.sortProcesses",
        "title": "Sort Processes",
        "category": "Osprey",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "osprey.profiler.groupProcesses",
        "title": "Group Processes",
        "category": "Osprey",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "osprey.profiler.filterProcesses",
        "title": "Filter Processes",
        "category": "Osprey",
        "icon": "$(filter)"
      },
      {
        "command": "osprey.profiler.profileCurrentFileCpu",
        "title": "Run & Profile CPU (Current File)",
        "category": "Osprey",
        "icon": "$(flame)"
      },
      {
        "command": "osprey.profiler.profileProcess",
        "title": "Profile CPU",
        "category": "Osprey",
        "icon": "$(flame)"
      },
      {
        "command": "osprey.profiler.copyProcessPid",
        "title": "Copy PID",
        "category": "Osprey"
      },
      {
        "command": "osprey.profiler.revealProcessScript",
        "title": "Reveal Entry in Editor",
        "category": "Osprey"
      },
      {
        "command": "osprey.profiler.killProcess",
        "title": "Kill Process",
        "category": "Osprey",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.compile",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.run",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.debug",
          "group": "navigation@3"
        },
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.profileCurrentFile",
          "group": "navigation@4"
        },
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.showTestDocumentation",
          "group": "navigation@5"
        },
        {
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml",
          "command": "osprey.hunt",
          "group": "navigation@6"
        }
      ],
      "commandPalette": [
        {
          "command": "osprey.compile",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.run",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.debug",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.profileCurrentFile",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.showTestDocumentation",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.hunt",
          "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
        },
        {
          "command": "osprey.profiler.profileProcess",
          "when": "false"
        },
        {
          "command": "osprey.profiler.copyProcessPid",
          "when": "false"
        },
        {
          "command": "osprey.profiler.revealProcessScript",
          "when": "false"
        },
        {
          "command": "osprey.profiler.killProcess",
          "when": "false"
        }
      ],
      "testing/item/context": [
        {
          "command": "osprey.showTestDocumentation",
          "group": "osprey@1"
        }
      ],
      "debug/variables/context": [
        {
          "command": "osprey.profiler.inspectVariable",
          "when": "debugType == osprey",
          "group": "inline@10"
        }
      ],
      "debug/watch/context": [
        {
          "command": "osprey.profiler.inspectVariable",
          "when": "debugType == osprey",
          "group": "inline@10"
        }
      ],
      "view/title": [
        {
          "command": "osprey.packages.open",
          "when": "view == ospreyDebugView || view == osprey.profiler.processes",
          "group": "navigation@0"
        },
        {
          "command": "osprey.profiler.profileCurrentFileCpu",
          "when": "view == osprey.profiler.processes && !osprey.profiler.cpuBusy",
          "group": "navigation@1"
        },
        {
          "command": "osprey.profiler.profileStop",
          "when": "view == osprey.profiler.processes && osprey.profiler.profiling",
          "group": "navigation@1"
        },
        {
          "command": "osprey.profiler.refreshProcesses",
          "when": "view == osprey.profiler.processes",
          "group": "navigation@3"
        },
        {
          "command": "osprey.profiler.sortProcesses",
          "when": "view == osprey.profiler.processes",
          "group": "1_order@1"
        },
        {
          "command": "osprey.profiler.groupProcesses",
          "when": "view == osprey.profiler.processes",
          "group": "1_order@2"
        },
        {
          "command": "osprey.profiler.filterProcesses",
          "when": "view == osprey.profiler.processes",
          "group": "1_order@3"
        }
      ],
      "view/item/context": [
        {
          "command": "osprey.profiler.profileStop",
          "when": "view == osprey.profiler.processes && viewItem == processProfiling",
          "group": "inline@0"
        },
        {
          "command": "osprey.profiler.profileProcess",
          "when": "view == osprey.profiler.processes && viewItem =~ /^process/ && !osprey.profiler.cpuBusy",
          "group": "inline@1"
        },
        {
          "command": "osprey.profiler.profileStop",
          "when": "view == osprey.profiler.processes && viewItem == processProfiling",
          "group": "1_profile@0"
        },
        {
          "command": "osprey.profiler.profileProcess",
          "when": "view == osprey.profiler.processes && viewItem =~ /^process/ && !osprey.profiler.cpuBusy",
          "group": "1_profile@1"
        },
        {
          "command": "osprey.profiler.copyProcessPid",
          "when": "view == osprey.profiler.processes && viewItem =~ /^(process|blockedProcess)/",
          "group": "9_copy@1"
        },
        {
          "command": "osprey.profiler.revealProcessScript",
          "when": "view == osprey.profiler.processes && viewItem =~ /^(process|blockedProcess)/",
          "group": "9_copy@2"
        },
        {
          "command": "osprey.profiler.killProcess",
          "when": "view == osprey.profiler.processes && viewItem =~ /^(process|blockedProcess)/",
          "group": "9_danger@1"
        }
      ],
      "explorer/context": [
        {
          "command": "osprey.packages.open",
          "when": "resourceFilename == osprey.toml",
          "group": "osprey@1"
        },
        {
          "command": "osprey.packages.startLocalRegistry",
          "when": "resourceFilename == osprey.toml",
          "group": "osprey@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "osprey.compile",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
      },
      {
        "command": "osprey.debug",
        "key": "f5",
        "when": "resourceLangId == osprey || resourceLangId == osprey-ml"
      },
      {
        "command": "osprey.profiler.profileStart",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "osprey.profiler.profileStop",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p"
      }
    ],
    "breakpoints": [
      {
        "language": "osprey"
      },
      {
        "language": "osprey-ml"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ospreyDebug",
          "title": "Osprey Debug",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "ospreyDebug": [
        {
          "id": "ospreyDebugView",
          "name": "Program",
          "icon": "icon.png",
          "contextualTitle": "Osprey Debug"
        },
        {
          "id": "osprey.profiler.processes",
          "name": "Processes",
          "icon": "$(pulse)"
        }
      ]
    },
    "debuggers": [
      {
        "type": "osprey",
        "label": "Osprey",
        "languages": [
          "osprey",
          "osprey-ml"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to an Osprey source file.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "description": "Command-line arguments passed to the debugged program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugged program.",
                "default": "${fileDirname}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debugged program.",
                "default": {}
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at program entry before running user code.",
                "default": false
              },
              "debugOutput": {
                "type": "string",
                "description": "Optional output path for the compiled native debug binary."
              },
              "compilerPath": {
                "type": "string",
                "description": "Optional compiler executable for this launch. Defaults to the extension's configured compiler."
              },
              "preserveArtifacts": {
                "type": "boolean",
                "default": false,
                "description": "Keep the generated LLVM IR beside the debug binary, along with native debug symbols."
              },
              "lldbDapPath": {
                "type": "string",
                "description": "Optional lldb-dap executable path. Defaults to osprey.debug.lldbDapPath or lldb-dap on PATH."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole",
                "description": "Program input/output destination. Terminal modes require LLDB-DAP 21 or newer; the Debug Console does not provide stdin."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "osprey",
            "request": "launch",
            "name": "Debug Osprey File",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Osprey Language Server",
      "properties": {
        "osprey.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Osprey language server"
        },
        "osprey.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Osprey compiler (if not in PATH)"
        },
        "osprey.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable diagnostic messages"
        },
        "osprey.hunt.maxTime": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Seconds KLEE explores a program when you run Osprey: Hunt for Bugs. Longer budgets finish more paths."
        },
        "osprey.server.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Osprey compiler executable. Leave empty to use the version-matched compiler bundled with this extension (falling back to `osprey` on PATH)."
        },
        "osprey.debug.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "Path to lldb-dap. Leave empty to use `lldb-dap` on PATH."
        },
        "osprey.profiler.inlineHeat": {
          "type": "boolean",
          "default": true,
          "description": "After profiling, show inline per-line heat annotations (NN.N% · M samples) and overview-ruler marks in the profiled source files."
        },
        "osprey.packages.registry": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "scope": "resource",
          "description": "Package registry API origin. HTTPS is required except for loopback development."
        },
        "osprey.packages.localRegistry.serverPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to osprey-registry, the local package registry server. Defaults to the server bundled with this extension."
        },
        "osprey.packages.localRegistry.root": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Folder registry the local server serves (@scope/name/<epoch>.<ordinal>/ releases). Defaults to the bundled snapshot of the Osprey repository's packages."
        },
        "osprey.packages.frontendPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to osprey-pkg. Defaults to the client bundled with this extension."
        },
        "osprey.packages.appPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to a compiled package workspace WASM application. Empty uses the bundled application."
        },
        "osprey.profiler.sampleRate": {
          "type": "number",
          "default": 100,
          "description": "Sampling rate in Hz for CPU profiling (1-1000)."
        },
        "osprey.profiler.includeNative": {
          "type": "boolean",
          "default": false,
          "description": "Include native frames in profile results."
        },
        "osprey.profiler.lineThreshold": {
          "type": "number",
          "default": 1,
          "description": "Minimum percentage of total samples for a line to appear as a hotspot (0.1-100)."
        },
        "osprey.profiler.functionThreshold": {
          "type": "number",
          "default": 2,
          "description": "Minimum percentage of total samples for a function to appear as a hotspot (0.1-100)."
        },
        "osprey.profiler.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 20,
          "description": "Maximum number of profiling diagnostics per file."
        },
        "osprey.profiler.showInlineHeatMap": {
          "type": "boolean",
          "default": true,
          "description": "Show inline heat map decorations for hot lines after profiling."
        },
        "osprey.profiler.profileOnLaunch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start CPU profiling when a debug session launches."
        },
        "osprey.profiler.processRefreshMs": {
          "type": "number",
          "default": 2000,
          "minimum": 250,
          "description": "Poll interval (ms) for refreshing the Processes panel while it is visible."
        },
        "osprey.profiler.preset": {
          "type": "string",
          "enum": [
            "default",
            "quick",
            "detailed",
            "longRunning"
          ],
          "enumDescriptions": [
            "Use the sampleRate / includeNative settings",
            "Short burst: 10 seconds at 100 Hz, for quick hotspot checks",
            "Thorough: 60 seconds at 200 Hz, higher-fidelity data",
            "No time limit at 50 Hz, for long-running servers and batch jobs"
          ],
          "default": "default",
          "description": "Profiling preset that configures sample rate and duration."
        },
        "osprey.profiler.palette": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": "Override profiler colors: critical, hot, warm, memory, memoryHot, memoryWarm, memoryCool, leak, success."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "osprey.profiler.processes",
        "contents": "Connecting to the Osprey language server…",
        "when": "osprey.profiler.serverState != running && osprey.profiler.serverState != stopped"
      },
      {
        "view": "osprey.profiler.processes",
        "contents": "The Osprey language server is not running.",
        "when": "osprey.profiler.serverState == stopped"
      },
      {
        "view": "osprey.profiler.processes",
        "contents": "Loading processes…\n[Run & Profile CPU (Current File)](command:osprey.profiler.profileCurrentFileCpu)",
        "when": "osprey.profiler.serverState == running && osprey.profiler.processesState == loading"
      },
      {
        "view": "osprey.profiler.processes",
        "contents": "Couldn't load the process list.\n[Run & Profile CPU (Current File)](command:osprey.profiler.profileCurrentFileCpu)",
        "when": "osprey.profiler.serverState == running && osprey.profiler.processesState == error"
      },
      {
        "view": "osprey.profiler.processes",
        "contents": "No processes running.\n[Run & Profile CPU (Current File)](command:osprey.profiler.profileCurrentFileCpu)",
        "when": "osprey.profiler.serverState == running && osprey.profiler.processesState == loaded"
      }
    ]
  },
  "dependencies": {
    "@nimblesite/lsp-profiler-ui": "^0.4.0",
    "@nimblesite/shipwright-vscode": "^0.11.0",
    "@preact/signals-core": "^1.14.4",
