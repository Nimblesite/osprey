# Each .claude/skills/<name> is a link to .agents/skills/<name>, a directory;
# Git for Windows makes it a directory link. A clone made without symlink support has text files there:
# with Developer Mode on, node scripts/link-skills.mjs makes real links and sets core.symlinks=true for that clone.
.claude/skills/* symlink=dir
